// The lexer of Smith, written in Smith, following bootstrap/src/lexer.rs. It
// is changed from what knowledge/ teaches only where the compiler cannot build
// that. Each such place is marked GAP, and says which roadmap issue will remove
// it. The tests of bootstrap hold it to the Rust lexer.

use std.ascii (is_digit, is_hex_digit, is_letter)

struct Pos {
  line: Nat
  col: Nat
}

// GAP 3 (#190): a str cannot be made from bytes, so text is kept as bytes.
// GAP 1 (#258): a type that contains itself is not built, so the pieces of an
// interpolated string and the tokens of its expressions are one flat run:
// interp_open, then text and tokens in order, then interp_close.
// GAP 4 (#190): a keyword and a punctuation are the number of their place in
// a table.
enum Tok {
  ident: List[u8]
  keyword: Nat
  number: List[u8]
  string: List[u8]
  interp_open
  text: List[u8]
  interp_close
  punct: Nat
  newline
  eof
}

struct Token {
  tok: Tok
  pos: Pos
}

// GAP 3 (#190): an error is a number for what is wrong and the bytes it names.
struct LexError {
  pos: Pos
  code: u64
  why: u64
  detail: List[u8]
}

struct Lexer {
  src: List[u8]
  at: Nat
  pos: Pos
  tokens: List[Token]
  errors: List[LexError]
  line_has_token: bool
  keywords: List[List[u8]]
  puncts: List[List[u8]]
}

// The errors, by number.
// 1 a carriage return           2 not valid UTF-8
// 3 a comment not on its line   4 a string with no closing quote
// 5 a } that closes nothing     6 unknown escape in a string
// 7 a character with no close   8 a character with no quotes
// 9 unknown escape in a char    10 a character that holds more than one
// 11 unexpected character       12 not a number

fn keyword_table() -> List[List[u8]] ! alloc {
  [['a', 'n', 'd'], ['a', 's'], ['b', 'r', 'e', 'a', 'k'], ['d', 'e', 'r', 'i', 'v', 'e'],
   ['e', 'f', 'f', 'e', 'c', 't'], ['e', 'l', 's', 'e'], ['e', 'n', 's', 'u', 'r', 'e', 's'],
   ['e', 'n', 'u', 'm'], ['f', 'n'], ['f', 'o', 'r'], ['f', 'o', 'r', 'e', 'i', 'g', 'n'],
   ['i', 'f'], ['i', 'm', 'p', 'l'], ['i', 'n'], ['l', 'o', 'o', 'p'],
   ['m', 'a', 't', 'c', 'h'], ['n', 'o', 't'], ['o', 'r'], ['o', 'u', 't'], ['p', 'u', 'b'],
   ['r', 'e', 'q', 'u', 'i', 'r', 'e', 's'], ['r', 'e', 't', 'u', 'r', 'n'],
   ['s', 't', 'r', 'u', 'c', 't'], ['t', 'a', 'k', 'e'], ['t', 'r', 'a', 'i', 't'], ['t', 'r', 'y'],
   ['u', 's', 'e'],
   ['v', 'a', 'r'], ['w', 'i', 't', 'h'], ['w', 'i', 't', 'h', 'o', 'u', 't']]
}

fn punctuation_table() -> List[List[u8]] ! alloc {
  [['.', '.'], ['-', '>'], ['+', '='], ['-', '='], ['*', '='], ['/', '='], ['=', '='],
   ['!', '='], ['<', '='], ['>', '='], ['('], [')'], ['['], [']'], ['{'], ['}'], [','],
   [':'], ['.'], ['='], ['<'], ['>'], ['+'], ['-'], ['*'], ['/'], ['@'], ['^'], ['!'], ['|', '>']]
}

// ---- bytes ----

fn byte_at(src: List[u8], i: Nat) -> Option[u8] {
  if i < src.size { .some(src[i]) } else { .none }
}

// The byte after the one at `i`, if there is one.
fn byte_after(src: List[u8], i: Nat) -> Option[u8] {
  if i < src.size {
    if i + 1 < src.size { .some(src[i + 1]) } else { .none }
  } else {
    .none
  }
}

// A byte that starts a name: std.ascii's letters are a-z and A-Z only.
fn is_name_start(b: u8) -> bool { b == '_' or is_letter(b) }

fn is_word_byte(b: u8) -> bool { is_name_start(b) or is_digit(b) }

// A byte that continues a character and does not start one.
fn is_continuation(b: u8) -> bool { b >= 0x80 and b <= 0xBF }

fn slice(src: List[u8], from: Nat, to: Nat) -> List[u8] ! alloc {
  var bytes: List[u8] = []
  loop i in from..to {
    if i < src.size { bytes = push(bytes, src[i]) }
  }
  bytes
}

fn has_string(tokens: List[Token], from: Nat) -> bool {
  var found = false
  loop i in from..tokens.size {
    match tokens[i].tok {
      .string(b) { found = true }
      .interp_open { found = true }
      other { }
    }
  }
  found
}

fn last_code(errors: List[LexError]) -> u64 {
  if errors.size == 0 { 0 } else { errors[errors.size - 1].code }
}

fn append(a: take List[u8], b: List[u8]) -> List[u8] ! alloc {
  var all = a
  loop i in 0..b.size { all = push(all, b[i]) }
  all
}

fn same_bytes(a: List[u8], b: List[u8]) -> bool {
  var same = a.size == b.size
  loop i in 0..a.size {
    if same and i < b.size and a[i] != b[i] { same = false }
  }
  same
}

fn index_of(text: List[u8], target: u8) -> Option[Nat] {
  var found: Option[Nat] = .none
  loop i in 0..text.size {
    if found == .none and text[i] == target { found = .some(i) }
  }
  found
}

// ---- UTF-8 ----

// Whether a byte may be the second of a character that starts with `lead`.
fn second_ok(lead: u8, b: u8) -> bool {
  if lead == 0xE0 {
    b >= 0xA0 and b <= 0xBF
  } else if lead == 0xED {
    b >= 0x80 and b <= 0x9F
  } else if lead == 0xF0 {
    b >= 0x90 and b <= 0xBF
  } else if lead == 0xF4 {
    b >= 0x80 and b <= 0x8F
  } else {
    is_continuation(b)
  }
}

// How many bytes the character that starts at `i` has, as the lead byte says.
fn wanted(lead: u8) -> Nat {
  if lead < 0x80 {
    1
  } else if lead >= 0xC2 and lead <= 0xDF {
    2
  } else if lead >= 0xE0 and lead <= 0xEF {
    3
  } else if lead >= 0xF0 and lead <= 0xF4 {
    4
  } else {
    0
  }
}

// How many bytes at `i` are valid, up to the length of the character. This is
// what `utf8_chunks` calls the longest piece of a character that is valid so
// far, and the character is whole when it is as long as `wanted` says.
fn valid_prefix(src: List[u8], i: Nat) -> n: Nat
  requires i < src.size
  ensures n <= 4 and n <= src.size - i
{
  lead = src[i]
  need = wanted(lead)
  if need >= 2 and 1 < src.size - i and second_ok(lead, src[i + 1]) {
    if need >= 3 and 2 < src.size - i and is_continuation(src[i + 2]) {
      if need >= 4 and 3 < src.size - i and is_continuation(src[i + 3]) { 4 } else { 3 }
    } else {
      2
    }
  } else {
    1
  }
}

fn advance(pos: Pos, b: u8) -> Pos {
  if b == '\n' {
    Pos(line: saturating_add(pos.line, 1), col: 1)
  } else if is_continuation(b) {
    pos
  } else {
    Pos(line: pos.line, col: saturating_add(pos.col, 1))
  }
}

fn text_errors(src: List[u8]) -> List[LexError] ! alloc {
  var errors: List[LexError] = []
  var pos = Pos(line: 1, col: 1)
  var i: Nat = 0
  loop round in 0..src.size {
    if i < src.size {
      b = src[i]
      have = valid_prefix(src, i)
      if have == wanted(b) {
        if b == 13 {
          errors = push(errors, LexError(pos: pos, code: 1, why: 0, detail: []))
        }
        pos = advance(pos, b)
        i = i + have
      } else {
        errors = push(errors, LexError(pos: pos, code: 2, why: 0, detail: []))
        pos = Pos(line: pos.line, col: saturating_add(pos.col, 1))
        i = i + have
      }
    }
  }
  errors
}

// ---- tokens so far ----

fn error_at(lx: take Lexer, pos: Pos, code: u64, why: u64, detail: take List[u8]) -> Lexer ! alloc {
  var next = lx
  next.errors = push(next.errors, LexError(pos: pos, code: code, why: why, detail: detail))
  next
}

fn is_newline(tok: Tok) -> bool {
  match tok {
    .newline { true }
    other { false }
  }
}

fn push_token(lx: take Lexer, tok: take Tok, pos: Pos) -> Lexer ! alloc {
  var next = lx
  next.line_has_token = not is_newline(tok)
  next.tokens = push(next.tokens, Token(tok: tok, pos: pos))
  next
}

fn bump(lx: take Lexer) -> Lexer {
  if lx.at < lx.src.size {
    b = lx.src[lx.at]
    after = lx.at + 1
    var next = lx
    next.at = after
    next.pos = advance(next.pos, b)
    next
  } else {
    lx
  }
}

// Reads the whole character that starts here, however many bytes it has.
fn bump_char(lx: take Lexer) -> Lexer {
  var next = bump(lx)
  loop round in 0..4 {
    match byte_at(next.src, next.at) {
      .some(b) { if is_continuation(b) { next = bump(next) } }
      .none { }
    }
  }
  next
}

fn take_while_word(lx: take Lexer) -> Lexer {
  rounds = lx.src.size
  var next = lx
  loop round in 0..rounds {
    match byte_at(next.src, next.at) {
      .some(b) { if is_word_byte(b) { next = bump(next) } else { break } }
      .none { break }
    }
  }
  next
}

fn word(lx: take Lexer, start: Pos) -> Lexer ! alloc {
  from = lx.at
  next = take_while_word(lx)
  name = slice(next.src, from, next.at)
  var found: Option[Nat] = .none
  loop k in 0..next.keywords.size {
    if same_bytes(next.keywords[k], name) { found = .some(k) }
  }
  tok: Tok = match found {
    .some(k) { .keyword(k) }
    .none { .ident(name) }
  }
  push_token(next, tok, start)
}

fn comment(lx: take Lexer, start: Pos) -> Lexer ! alloc {
  var next = if lx.line_has_token { error_at(lx, start, 3, 0, []) } else { lx }
  rounds = next.src.size
  loop round in 0..rounds {
    match byte_at(next.src, next.at) {
      .some(b) { if b == '\n' { break } else { next = bump(next) } }
      .none { break }
    }
  }
  next
}

// ---- numbers ----

// Why a run of digits is not written as the lexical rules say, or 0 when it
// is: at least one digit, and an `_` only between two digits. The reasons are
// 1 no digit, 2 an `_` not between two digits, and 3 a byte that is no digit
// of the base, which `bad` then holds.
fn digits(text: List[u8], base: u8) -> (u64, u8) {
  var why: u64 = 0
  var bad: u8 = 0
  var previous: u8 = 0
  if text.size == 0 { why = 1 }
  loop i in 0..text.size {
    c = text[i]
    if why == 0 {
      if c == '_' {
        if i == 0 or previous == '_' { why = 2 }
      } else {
        valid = if base == 16 {
          is_hex_digit(c)
        } else if base == 2 {
          c == '0' or c == '1'
        } else {
          is_digit(c)
        }
        if not valid {
          why = 3
          bad = c
        }
      }
      previous = c
    }
  }
  if why == 0 and previous == '_' { why = 2 }
  (why, bad)
}

// The base is 16, 2, or 10, and the reason is as `digits` gives it.
struct Problem {
  base: u64
  why: u64
  bad: u8
}

fn problem_of(base: u64, found: (u64, u8)) -> Problem {
  (why, bad) = found
  Problem(base: base, why: why, bad: bad)
}

fn first_problem(a: Problem, b: Problem) -> Problem {
  if a.why != 0 { a } else { b }
}

fn check_number(text: List[u8]) -> Problem ! alloc {
  none = Problem(base: 10, why: 0, bad: 0)
  if text.size >= 2 and text[0] == '0' and text[1] == 'x' {
    problem_of(16, digits(slice(text, 2, text.size), 16))
  } else if text.size >= 2 and text[0] == '0' and text[1] == 'b' {
    problem_of(2, digits(slice(text, 2, text.size), 2))
  } else {
    mantissa_end = match index_of(text, 'e') {
      .some(at) {
        match index_of(text, 'E') {
          .some(other) { if other < at { other } else { at } }
          .none { at }
        }
      }
      .none {
        match index_of(text, 'E') {
          .some(other) { other }
          .none { text.size }
        }
      }
    }
    mantissa = slice(text, 0, mantissa_end)
    whole_end = match index_of(mantissa, '.') {
      .some(at) { at }
      .none { mantissa.size }
    }
    first = problem_of(10, digits(slice(mantissa, 0, whole_end), 10))
    second = if whole_end < mantissa.size {
      problem_of(10, digits(slice(mantissa, whole_end + 1, mantissa.size), 10))
    } else {
      none
    }
    third = if mantissa_end < text.size {
      var from = mantissa_end + 1
      loop i in from..text.size {
        if i == from and (text[i] == '+' or text[i] == '-') { from = from + 1 }
      }
      problem_of(10, digits(slice(text, from, text.size), 10))
    } else {
      none
    }
    first_problem(first, first_problem(second, third))
  }
}

fn number(lx: take Lexer, start: Pos) -> Lexer ! alloc {
  from = lx.at
  var next = take_while_word(lx)
  if byte_at(next.src, next.at) == .some('.') {
    match byte_after(next.src, next.at) {
      .some(d) { if is_digit(d) { next = take_while_word(bump(next)) } }
      .none { }
    }
  }
  // The sign of an exponent belongs to the number.
  so_far = slice(next.src, from, next.at)
  last = if so_far.size > 0 { so_far[so_far.size - 1] } else { 0 }
  is_hex = so_far.size >= 2 and so_far[0] == '0' and so_far[1] == 'x'
  if (last == 'e' or last == 'E') and not is_hex {
    match byte_at(next.src, next.at) {
      .some(sign) {
        if sign == '+' or sign == '-' {
          match byte_after(next.src, next.at) {
            .some(d) { if is_digit(d) { next = take_while_word(bump(next)) } }
            .none { }
          }
        }
      }
      .none { }
    }
  }
  text = slice(next.src, from, next.at)
  p = check_number(text)
  checked = if p.why == 0 {
    next
  } else {
    // the reason is 100 times the base of the number, ten times the reason
    // and the byte that is not a digit
    detail = push(push(slice(next.src, from, next.at), 0), p.bad)
    error_at(next, start, 12, wrapping_add(wrapping_mul(p.base, 10), p.why), detail)
  }
  push_token(checked, .number(text), start)
}

// ---- characters ----

fn close_character(lx: take Lexer, start: Pos, text: take List[u8], ok: bool) -> Lexer ! alloc {
  if byte_at(lx.src, lx.at) == .some('\'') {
    closed = bump(lx)
    if ok { push_token(closed, .number(push(text, '\'')), start) } else { closed }
  } else {
    error_at(lx, start, 10, 0, [])
  }
}

// Where the character that starts at `at` ends, which is where `bump_char`
// would leave a lexer that was there.
fn char_end(src: List[u8], at: Nat) -> Nat {
  var i = at
  if i < src.size { i = i + 1 }
  loop round in 0..4 {
    match byte_at(src, i) {
      .some(b) { if is_continuation(b) { i = saturating_add(i, 1) } }
      .none { }
    }
  }
  i
}

fn escape_error(lx: take Lexer, at: Pos, code: u64) -> Lexer ! alloc {
  // what follows the backslash, or nothing
  match byte_at(lx.src, lx.at) {
    .none { error_at(lx, at, code, 1, []) }
    .some(c) {
      if c == '\n' {
        error_at(lx, at, code, 1, [])
      } else {
        detail = slice(lx.src, lx.at, char_end(lx.src, lx.at))
        error_at(lx, at, code, 2, detail)
      }
    }
  }
}

fn character(lx: take Lexer, start: Pos) -> Lexer ! alloc {
  opened = bump(lx)
  at = opened.pos
  text: List[u8] = ['\'']
  match byte_at(opened.src, opened.at) {
    .none { error_at(opened, start, 7, 0, []) }
    .some(c) {
      if c == '\n' {
        error_at(opened, start, 7, 0, [])
      } else if c == '\'' {
        error_at(bump(opened), start, 8, 0, [])
      } else if c == '\\' {
        escaped = bump(opened)
        match byte_at(escaped.src, escaped.at) {
          .some(e) {
            if e == '\'' or e == '\\' or e == 'n' or e == 't' {
              close_character(bump(escaped), start, push(push(text, '\\'), e), true)
            } else if e == '\n' {
              close_character(escape_error(escaped, at, 9), start, text, false)
            } else {
              wrong = escape_error(escaped, at, 9)
              close_character(bump_char(wrong), start, text, false)
            }
          }
          .none { close_character(escape_error(escaped, at, 9), start, text, false) }
        }
      } else {
        from = opened.at
        after = bump_char(opened)
        bytes = append(text, slice(after.src, from, after.at))
        close_character(after, start, bytes, true)
      }
    }
  }
}

// ---- punctuation ----

fn starts_with(src: List[u8], at: Nat, p: List[u8]) -> bool {
  if at <= src.size and p.size <= src.size - at {
    var same = true
    loop i in 0..p.size {
      if src[at + i] != p[i] { same = false }
    }
    same
  } else {
    false
  }
}

fn punct(lx: take Lexer, start: Pos) -> Lexer ! alloc {
  var found: Option[Nat] = .none
  loop k in 0..lx.puncts.size {
    if starts_with(lx.src, lx.at, lx.puncts[k]) {
      found = .some(k)
      break
    }
  }
  match found {
    .none {
      from = lx.at
      after = bump_char(lx)
      detail = slice(after.src, from, after.at)
      error_at(after, start, 11, 0, detail)
    }
    .some(k) {
      var next = lx
      if k < next.puncts.size {
        width = next.puncts[k].size
        loop i in 0..width { next = bump(next) }
      }
      push_token(next, .punct(k), start)
    }
  }
}

// ---- strings ----

// GAP 2 (no roadmap issue yet, as #189 does not cover functions that call one
// another): `token`, `string`, and `expression` call one another, which is
// recursion, and recursion is not built. A string in an expression in a
// string in an expression is read as deep as three copies of the functions
// go, and below that a quote is read as the unexpected character it would be
// outside a string.

// Reads what starts with `c`, which is not a line break: a space, a
// comment, or a token.
fn token3(lx: take Lexer, start: Pos, c: u8) -> Lexer ! alloc {
  if c == ' ' or c == '\t' {
    bump(lx)
  } else if c == '/' and byte_after(lx.src, lx.at) == .some('/') {
    comment(lx, start)
  } else if c == '\'' {
    character(lx, start)
  } else if is_name_start(c) {
    word(lx, start)
  } else if is_digit(c) {
    number(lx, start)
  } else {
    punct(lx, start)
  }
}

// Reads a string literal. Each mistake inside it is reported, and the string
// still becomes a token, so that the rest of the line is read.
fn string2(lx: take Lexer, start: Pos) -> Lexer ! alloc {
  rounds = lx.src.size
  var next = bump(lx)
  var value: List[u8] = []
  var interpolated = false
  loop round in 0..rounds {
    at = next.pos
    match byte_at(next.src, next.at) {
      .none {
        next = error_at(next, start, 4, 0, [])
        break
      }
      .some(c) {
        if c == '\n' {
          next = error_at(next, start, 4, 0, [])
          break
        } else if c == '"' {
          next = bump(next)
          break
        } else if c == '{' {
          next = bump(next)
          if not interpolated {
            next = push_token(next, .interp_open, start)
            interpolated = true
          }
          if value.size > 0 { next = push_token(next, .text(value), start) }
          value = []
          (after, closed) = expression2(next, start)
          next = after
          if not closed { break }
        } else if c == '}' {
          next = error_at(bump(next), at, 5, 0, [])
        } else if c == '\\' {
          next = bump(next)
          match byte_at(next.src, next.at) {
            .some(e) {
              if e == '"' or e == '\\' or e == '{' or e == '}' or e == 'n' or e == 't' {
                next = bump(next)
                decoded: u8 = if e == 'n' { '\n' } else if e == 't' { '\t' } else { e }
                value = push(value, decoded)
              } else if e == '\n' {
                next = escape_error(next, at, 6)
                break
              } else {
                next = bump_char(escape_error(next, at, 6))
              }
            }
            .none {
              next = escape_error(next, at, 6)
              break
            }
          }
        } else {
          next = bump(next)
          value = push(value, c)
        }
      }
    }
  }
  if not interpolated {
    push_token(next, .string(value), start)
  } else {
    var done = next
    if value.size > 0 { done = push_token(done, .text(value), start) }
    push_token(done, .interp_close, start)
  }
}

// Reads the tokens of an expression in a string, from after its `{`
// through the `}` that closes it, and whether it was closed.
fn expression2(lx: take Lexer, start: Pos) -> (Lexer, bool) ! alloc {
  mark = lx.tokens.size
  rounds = lx.src.size
  var next = lx
  var depth: Nat = 0
  var closed = false
  loop round in 0..rounds {
    at = next.pos
    match byte_at(next.src, next.at) {
      .none { break }
      .some(c) {
        if c == '\n' {
          break
        } else if c == '}' and depth == 0 {
          next = push_token(bump(next), .punct(15), at)
          closed = true
          break
        } else {
          if c == '{' { depth = saturating_add(depth, 1) }
          if c == '}' { depth = saturating_sub(depth, 1) }
          next = token3(next, at, c)
        }
      }
    }
  }
  // A string in the braces that the line ends inside is the one without its
  // quote, and it has reported that already.
  inner = has_string(next.tokens, mark) and last_code(next.errors) == 4
  if closed {
    (next, true)
  } else if inner {
    (next, false)
  } else {
    (error_at(next, start, 4, 0, []), false)
  }
}


// Reads what starts with `c`, which is not a line break: a space, a
// comment, or a token.
fn token2(lx: take Lexer, start: Pos, c: u8) -> Lexer ! alloc {
  if c == ' ' or c == '\t' {
    bump(lx)
  } else if c == '/' and byte_after(lx.src, lx.at) == .some('/') {
    comment(lx, start)
  } else if c == '"' {
    string2(lx, start)
  } else if c == '\'' {
    character(lx, start)
  } else if is_name_start(c) {
    word(lx, start)
  } else if is_digit(c) {
    number(lx, start)
  } else {
    punct(lx, start)
  }
}

// Reads a string literal. Each mistake inside it is reported, and the string
// still becomes a token, so that the rest of the line is read.
fn string1(lx: take Lexer, start: Pos) -> Lexer ! alloc {
  rounds = lx.src.size
  var next = bump(lx)
  var value: List[u8] = []
  var interpolated = false
  loop round in 0..rounds {
    at = next.pos
    match byte_at(next.src, next.at) {
      .none {
        next = error_at(next, start, 4, 0, [])
        break
      }
      .some(c) {
        if c == '\n' {
          next = error_at(next, start, 4, 0, [])
          break
        } else if c == '"' {
          next = bump(next)
          break
        } else if c == '{' {
          next = bump(next)
          if not interpolated {
            next = push_token(next, .interp_open, start)
            interpolated = true
          }
          if value.size > 0 { next = push_token(next, .text(value), start) }
          value = []
          (after, closed) = expression1(next, start)
          next = after
          if not closed { break }
        } else if c == '}' {
          next = error_at(bump(next), at, 5, 0, [])
        } else if c == '\\' {
          next = bump(next)
          match byte_at(next.src, next.at) {
            .some(e) {
              if e == '"' or e == '\\' or e == '{' or e == '}' or e == 'n' or e == 't' {
                next = bump(next)
                decoded: u8 = if e == 'n' { '\n' } else if e == 't' { '\t' } else { e }
                value = push(value, decoded)
              } else if e == '\n' {
                next = escape_error(next, at, 6)
                break
              } else {
                next = bump_char(escape_error(next, at, 6))
              }
            }
            .none {
              next = escape_error(next, at, 6)
              break
            }
          }
        } else {
          next = bump(next)
          value = push(value, c)
        }
      }
    }
  }
  if not interpolated {
    push_token(next, .string(value), start)
  } else {
    var done = next
    if value.size > 0 { done = push_token(done, .text(value), start) }
    push_token(done, .interp_close, start)
  }
}

// Reads the tokens of an expression in a string, from after its `{`
// through the `}` that closes it, and whether it was closed.
fn expression1(lx: take Lexer, start: Pos) -> (Lexer, bool) ! alloc {
  mark = lx.tokens.size
  rounds = lx.src.size
  var next = lx
  var depth: Nat = 0
  var closed = false
  loop round in 0..rounds {
    at = next.pos
    match byte_at(next.src, next.at) {
      .none { break }
      .some(c) {
        if c == '\n' {
          break
        } else if c == '}' and depth == 0 {
          next = push_token(bump(next), .punct(15), at)
          closed = true
          break
        } else {
          if c == '{' { depth = saturating_add(depth, 1) }
          if c == '}' { depth = saturating_sub(depth, 1) }
          next = token2(next, at, c)
        }
      }
    }
  }
  // A string in the braces that the line ends inside is the one without its
  // quote, and it has reported that already.
  inner = has_string(next.tokens, mark) and last_code(next.errors) == 4
  if closed {
    (next, true)
  } else if inner {
    (next, false)
  } else {
    (error_at(next, start, 4, 0, []), false)
  }
}


// Reads what starts with `c`, which is not a line break: a space, a
// comment, or a token.
fn token1(lx: take Lexer, start: Pos, c: u8) -> Lexer ! alloc {
  if c == ' ' or c == '\t' {
    bump(lx)
  } else if c == '/' and byte_after(lx.src, lx.at) == .some('/') {
    comment(lx, start)
  } else if c == '"' {
    string1(lx, start)
  } else if c == '\'' {
    character(lx, start)
  } else if is_name_start(c) {
    word(lx, start)
  } else if is_digit(c) {
    number(lx, start)
  } else {
    punct(lx, start)
  }
}

