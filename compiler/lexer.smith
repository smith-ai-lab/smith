// Reads the tokens of an expression in a string, from after its `{`
// through the `}` that closes it, and whether it was closed.
fn expression0(lx: take Lexer, start: Pos) -> (Lexer, bool) ! alloc {
  mark = lx.tokens.size
  rounds = lx.src.size
  var next = lx
  var depth: Nat = 0
  var closed = false
  loop round in 0..rounds {
    at = next.pos
    match byte_at(next.src, next.at) {
      .none { break }
      .some(c) {
        if c == '\n' {
          break
        } else if c == '}' and depth == 0 {
          next = push_token(bump(next), .punct(15), at)
          closed = true
          break
        } else {
          if c == '{' { depth = saturating_add(depth, 1) }
          if c == '}' { depth = saturating_sub(depth, 1) }
          next = token1(next, at, c)
        }
      }
    }
  }
  // A string in the braces that the line ends inside is the one without its
  // quote, and it has reported that already.
  inner = has_string(next.tokens, mark) and last_code(next.errors) == 4
  if closed {
    (next, true)
  } else if inner {
    (next, false)
  } else {
    (error_at(next, start, 4, 0, []), false)
  }
}


// Reads what starts with `c`, which is not a line break: a space, a
// comment, or a token.
fn token0(lx: take Lexer, start: Pos, c: u8) -> Lexer ! alloc {
  if c == ' ' or c == '\t' {
    bump(lx)
  } else if c == '/' and byte_after(lx.src, lx.at) == .some('/') {
    comment(lx, start)
  } else if c == '"' {
    string0(lx, start)
  } else if c == '\'' {
    character(lx, start)
  } else if is_name_start(c) {
    word(lx, start)
  } else if is_digit(c) {
    number(lx, start)
  } else {
    punct(lx, start)
  }
}

fn run(lx: take Lexer) -> Lexer ! alloc {
  rounds = lx.src.size
  var next = lx
  loop round in 0..rounds {
    match byte_at(next.src, next.at) {
      .none { break }
      .some(c) {
        start = next.pos
        if c == '\n' {
          next = push_token(bump(next), .newline, start)
        } else {
          next = token0(next, start, c)
        }
      }
    }
  }
  eof = next.pos
  push_token(next, .eof, eof)
}

// 29 is the place of `|>` in the table of punctuation.
fn is_pipe(tok: Tok) -> bool {
  match tok {
    .punct(k) { k == 29 }
    other { false }
  }
}

// Whether a `|>` stands after a line break.
fn has_break_before_pipe(tokens: List[Token]) -> bool {
  var found = false
  loop i in 1..tokens.size {
    if is_pipe(tokens[i].tok) and is_newline(tokens[i - 1].tok) { found = true }
  }
  found
}

// The token as a new one, since a list does not give away what it holds.
fn copy_tok(tok: Tok) -> Tok ! alloc {
  match tok {
    .ident(b) { .ident(slice(b, 0, b.size)) }
    .keyword(k) { .keyword(k) }
    .number(b) { .number(slice(b, 0, b.size)) }
    .string(b) { .string(slice(b, 0, b.size)) }
    .interp_open { .interp_open }
    .text(b) { .text(slice(b, 0, b.size)) }
    .interp_close { .interp_close }
    .punct(k) { .punct(k) }
    .newline { .newline }
    .eof { .eof }
  }
}

// The tokens without the line breaks that stand in front of a `|>`, which
// goes on from the line before.
fn without_breaks_before_pipes(tokens: List[Token]) -> List[Token] ! alloc {
  var kept: List[Token] = []
  var breaks: List[Pos] = []
  loop i in 0..tokens.size {
    if is_newline(tokens[i].tok) {
      breaks = push(breaks, tokens[i].pos)
    } else {
      if not is_pipe(tokens[i].tok) {
        loop k in 0..breaks.size { kept = push(kept, Token(tok: .newline, pos: breaks[k])) }
      }
      breaks = []
      kept = push(kept, Token(tok: copy_tok(tokens[i].tok), pos: tokens[i].pos))
    }
  }
  kept
}

// Splits a file into tokens. The last token is always `eof`.
fn lex(src: take List[u8]) -> Result[List[Token], List[LexError]] ! alloc {
  bad = text_errors(src)
  if bad.size > 0 {
    .err(bad)
  } else {
    lx = Lexer(src: src, at: 0, pos: Pos(line: 1, col: 1), tokens: [], errors: [],
               line_has_token: false, keywords: keyword_table(), puncts: punctuation_table())
    done = run(lx)
    if done.errors.size > 0 {
      .err(done.errors)
    } else if has_break_before_pipe(done.tokens) {
      .ok(without_breaks_before_pipes(done.tokens))
    } else {
      .ok(done.tokens)
    }
  }
}

fn main() ! console, alloc {
  match lex(['f', 'n', ' ', 'm', '\n']) {
    .ok(tokens) { print("{tokens.size}") }
    .err(errors) { print("errors") }
  }
}
