// `smith build frontend-coverage` (#1730): how much of the tree smith's own front end already handles.
//
//   frontend_coverage run SMITH ROOT SCRATCH   every .smith file git tracks under ROOT is copied to SCRATCH and fixed
//                                              there with `SMITH lint --fix` (all of them, so a module a file imports
//                                              is fixed before the file is compiled), then compiled with
//                                              `SMITH cc --front-end=new` from the folder of its project (the nearest
//                                              folder with a build.c, build.smith or main.smith, else the repo) with
//                                              the roots `src` (the project folder itself) and `lib` (the standard
//                                              library); the results go to standard output as a table (see summarize)
//   frontend_coverage run SMITH ROOT SCRATCH FILES
//                                              the same for only the files named in FILES (paths relative to ROOT,
//                                              separated by commas) and every module they import, transitively (#2309);
//                                              each is fixed and compiled exactly as in a full run, so its rows are the
//                                              rows of a full run
//   frontend_coverage chain RESULTS ROOT FILES  reads the table of a filtered run and prints, for each file in it, its
//                                              stage and first error, and under it `imports <module>: <stage>: <first
//                                              error>` for every import that fails: the chain that blocks it
//   frontend_coverage summarize RESULTS [SMITH]
//                                              reads a table and prints one line per file, then the summary; with
//                                              SMITH, the summary names the smith that was measured
//
// The table has one line per diagnostic, or one per passing file: `path TAB stage TAB message TAB position`. The stage
// is `pass`, or the stage that failed: `fixer` (`smith lint --fix`), `parse`, `check`, `emit` or `write` (the front
// end's own, SMITH_FRONT_STAGE). The message is the error without its `file:line:column: error:` prefix; the position
// is `line:column` (absent when the line has none). A file that fails has one line for every error its stage reported
// (#1922), the lines of a file next to each other, so the first error cannot hide the next.
//
// The summary: files passed out of total, the failed files per stage, then the causes: a diagnostic's message with
// its names (`...`) and numbers replaced by `<name>` and `<n>`, the biggest first, each with its occurrences, its
// files, the files it stops first (their first diagnostic) and up to 3 example locations, the cause that stops most
// files first; then 20 `frontend-cause:` lines for the CI log. A parse error is the only one of its file (the parser
// stops at the first, parser recovery is not counted here): the summary says how many files are stopped there. The real
// files are never changed: only the copies are.
//
// The fixer's work is cached (#2309) in `SCRATCH/../fixed/<hash>`: the fixed text of a file, keyed by the file, every
// module it imports transitively (the fixer checks against them), the tracked C headers and the smith that fixes. A
// file that fails to fix is never cached. A cache entry never changes a result.
module main;

import std::console;
import std::env;
import std::files;
import std::format;
import std::mem;
import std::process;
import <stdlib.h>;
import <unistd.h>;

constexpr Usize files_max = 4096;
constexpr Usize entries_max = 262144;
constexpr Usize groups_max = 2048;
constexpr Usize examples_max = 3;
constexpr Usize causes_listed = 20;
constexpr Usize path_size = 256;
constexpr Usize message_size = 240;
constexpr Usize stage_size = 16;
constexpr Usize position_size = 24;

struct Entry {
    char path[path_size];
    char stage[stage_size];
    char message[message_size];
    char position[position_size];
};

struct Group {
    char message[message_size];
    Usize count;
    Usize files;
    Usize last_file;
    Usize stopped;
    Usize appeared;
    Usize examples[examples_max];
};

static struct Entry entries[entries_max];
static Usize entry_count = 0;
// Rows that did not fit in the table: any makes the run an error, never a smaller count (#2264).
static Usize entries_dropped = 0;
static struct Group groups[groups_max];
static Usize group_count = 0;

// Copies the text up to a newline, a tab or the end of `size - 1` bytes into `out`, and ends it.
static void copy_text(char out[:], const char text[:]) {
    Usize i = 0;
    while (i + 1 < countof(out) && i < countof(text) && text[i] != '\n' && text[i] != '\t') {
        out[i] = text[i];
        i += 1;
    }
    out[i] = '\0';
}

static Bool same(const char a[:], const char b[:]) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// The length of a terminated text in a buffer.
static Usize length_of(const char text[:]) {
    Usize n = 0;
    while (n < countof(text) && text[n] != '\0')
        n += 1;
    return n;
}

// A C string as a slice.
static typeof(const char[:]) view_of(const char *text) {
    Usize n = 0;
    while (text[n] != '\0')
        n += 1;
    return text[0:n];
}

// A buffer's text as a slice.
static typeof(const char[:]) text_of(const char buffer[:]) {
    return buffer[0:length_of(buffer)];
}

// Adds a result to the table. A table that is full counts the row in entries_dropped, and run fails on it (#2264: a
// full table once dropped every file after the 700th without a word).
static void add_entry(const char path[:], const char stage[:], const char message[:], const char position[:]) {
    if (entry_count == entries_max) {
        entries_dropped += 1;
        return;
    }
    struct Entry *entry = &entries[entry_count];
    copy_text(entry->path[0:path_size], path);
    copy_text(entry->stage[0:stage_size], stage);
    copy_text(entry->message[0:message_size], message);
    copy_text(entry->position[0:position_size], position);
    entry_count += 1;
}

// The first position of `byte` in `text` from `from`, or the length of the text.
static Usize find(const char text[:], char byte, Usize from) {
    Usize i = from;
    while (i < countof(text) && text[i] != byte)
        i += 1;
    return i;
}

// Reads `path TAB stage TAB message` lines. Returns false when the file cannot be read.
static Bool read_table(const char file[:]) {
    files::BytesResult loaded = files::read_file(file);
    if (loaded == .error) return false;
    typeof(char[:]) text = mem::view(loaded.ok, char);
    defer mem::free(loaded.ok.data);
    Usize at = 0;
    while (at < countof(text)) {
        Usize end = find(text, '\n', at);
        Usize first = find(text, '\t', at);
        if (first < end) {
            Usize second = find(text, '\t', first + 1);
            Usize message = second < end ? second + 1 : end;
            Usize third = find(text, '\t', message);
            Usize position = third < end ? third + 1 : end;
            add_entry(text[at:first], text[first + 1:second < end ? second : end],
                      text[message:third < end ? third : end], text[position:end]);
        }
        at = end + 1;
    }
    return true;
}

static Bool is_pass(const struct Entry *entry) {
    return same(text_of(entry->stage[0:stage_size]), "pass");
}

// Whether entry `i` is the first line of its file (the lines of a file are next to each other).
static Bool starts_file(Usize i) {
    return i == 0 || !same(text_of(entries[i - 1].path[0:path_size]), text_of(entries[i].path[0:path_size]));
}

static Bool is_digit(char c) {
    return c >= '0' && c <= '9';
}

// The cause of a message (#1922): the names between backticks become `<name>` and each number `<n>`, so the same
// failure in two places is one cause. Stops at the end of `out`.
static void cause_of(char out[:], const char message[:]) {
    Usize o = 0;
    Usize i = 0;
    while (i < countof(message) && o + 8 < countof(out)) {
        if (message[i] == '`') {
            Usize close = i + 1;
            while (close < countof(message) && message[close] != '`')
                close += 1;
            if (close < countof(message)) {
                const char *name = "`<name>`";
                for (Usize k = 0; k < 8; k++)
                    out[o + k] = name[k];
                o += 8;
                i = close + 1;
                continue;
            }
        }
        if (is_digit(message[i])) {
            while (i < countof(message) && is_digit(message[i])) {
                i += 1;
            }
            out[o] = '<';
            out[o + 1] = 'n';
            out[o + 2] = '>';
            o += 3;
            continue;
        }
        out[o] = message[i];
        o += 1;
        i += 1;
    }
    out[o] = '\0';
}

// The group of `cause`, made when it is the first of its kind.
static struct Group *group_of(const char cause[:]) {
    for (Usize i = 0; i < group_count; i++) {
        if (same(text_of(groups[i].message[0:message_size]), cause)) return &groups[i];
    }
    if (group_count == groups_max) return &groups[groups_max - 1];
    struct Group *made = &groups[group_count];
    copy_text(made->message[0:message_size], cause);
    made->count = 0;
    made->files = 0;
    made->last_file = 0;
    made->stopped = 0;
    made->appeared = group_count;
    group_count += 1;
    return made;
}

// Every diagnostic of a failed file counts, in the group of its cause; `file` numbers the files from 1.
static void group_failures() {
    Usize file = 0;
    for (Usize i = 0; i < entry_count; i++) {
        if (starts_file(i)) file += 1;
        if (is_pass(&entries[i])) continue;
        char cause[message_size];
        cause_of(cause[0:message_size], text_of(entries[i].message[0:message_size]));
        struct Group *group = group_of(text_of(cause[0:message_size]));
        if (group->count < examples_max) group->examples[group->count] = i;
        group->count += 1;
        // the first diagnostic of a file is what stops it (#2247)
        if (starts_file(i)) group->stopped += 1;
        if (group->last_file != file) {
            group->last_file = file;
            group->files += 1;
        }
    }
}

// Whether group `a` ranks below group `b`: fewer files stopped at it (#2247), then fewer files, then fewer
// occurrences, then it appeared later.
static Bool ranks_below(const struct Group *a, const struct Group *b) {
    if (a->stopped != b->stopped) return a->stopped < b->stopped;
    if (a->files != b->files) return a->files < b->files;
    if (a->count != b->count) return a->count < b->count;
    return a->appeared > b->appeared;
}

// Groups in order: the most files stopped first, then the ordering of ranks_below (an insertion sort of a few hundred).
static void sort_groups() {
    for (Usize i = 1; i < group_count; i++) {
        struct Group moved = groups[i];
        Usize at = i;
        while (at > 0 && ranks_below(&groups[at - 1], &moved)) {
            groups[at] = groups[at - 1];
            at -= 1;
        }
        groups[at] = moved;
    }
}

// A stage's number of failures, over the stages in the order a file meets them.
static const char *const stage_names[_] = {"fixer", "parse", "check", "emit", "write"};

static void print_stages() {
    for (Usize s = 0; s < countof(stage_names); s++) {
        Usize count = 0;
        for (Usize i = 0; i < entry_count; i++) {
            if (starts_file(i) && same(text_of(entries[i].stage[0:stage_size]), view_of(stage_names[s]))) count += 1;
        }
        console::print("  failed at ", format::left(stage_names[s], 6), " ", count, "\n");
    }
}

// What a program printed, as text, and its exit status (128 and the signal when killed, 127 when it did not start).
// `output` is the standard output then the standard error; the memory is the caller's to free with release.
struct Ran {
    I32 status;
    char text[:];
    char *owned_out;
    char *owned_err;
};

static struct Ran run_program(const char *const argv[:]) {
    process::OutputResult done = process::run(argv);
    if (done == .error) return (struct Ran){.status = 127, .text = ""};
    struct Ran ran = {};
    ran.status = done.ok.exit.signal != 0 ? 128 + (I32)done.ok.exit.signal : (I32)done.ok.exit.status;
    // The front end and the fixer write their diagnostics to the error stream; a tool with none has them on the output.
    ran.text = mem::view(done.ok.output, char);
    if (countof(done.ok.errors) > 0) ran.text = mem::view(done.ok.errors, char);
    ran.owned_out = (char *)done.ok.output.data;
    ran.owned_err = (char *)done.ok.errors.data;
    return ran;
}

// Gives the memory of a run back.
static void release(struct Ran *ran) {
    if (ran->owned_out != nullptr) mem::free(ran->owned_out);
    if (ran->owned_err != nullptr) mem::free(ran->owned_err);
    *ran = (struct Ran){};
}

// The first line of `SMITH version`: which smith was measured. Empty when it does not run.
static void print_measured(const char *smith) {
    const char *const argv[_] = {smith, "version"};
    struct Ran ran = run_program(argv[0:2]);
    Usize end = find(ran.text, '\n', 0);
    if (ran.status == 0) {
        console::print("frontend-coverage: measured ", ran.text[0:end], "\n");
    } else {
        console::print("frontend-coverage: measured a smith whose version is unknown\n");
    }
    release(&ran);
}

// The causes table: occurrences, files, the cause, and up to 3 places (`path:line:column`, or the file alone).
static void print_causes() {
    Usize diagnostics = 0;
    for (Usize g = 0; g < group_count; g++)
        diagnostics += groups[g].count;
    console::print("\nfailures by cause (", group_count, " causes, ", diagnostics, " diagnostics):\n");
    console::print("  first  count  files  cause\n");
    for (Usize g = 0; g < group_count; g++) {
        console::print(format::pad(groups[g].stopped, 7), format::pad(groups[g].count, 7),
                       format::pad(groups[g].files, 7), "  ", (const char *)groups[g].message, "\n");
        Usize shown = groups[g].count < examples_max ? groups[g].count : examples_max;
        for (Usize e = 0; e < shown; e++) {
            const struct Entry *at = &entries[groups[g].examples[e]];
            if (at->position[0] != '\0') {
                console::print("                e.g. ", (const char *)at->path, ":", (const char *)at->position, "\n");
            } else {
                console::print("                e.g. ", (const char *)at->path, "\n");
            }
        }
    }
}

// One fixed line per cause for the top 20, for the CI log: `frontend-cause: <first> <files> <count> <cause>`.
static void print_cause_lines() {
    Usize shown = group_count < causes_listed ? group_count : causes_listed;
    for (Usize g = 0; g < shown; g++) {
        console::print("frontend-cause: ", groups[g].stopped, " ", groups[g].files, " ", groups[g].count, " ",
                       (const char *)groups[g].message, "\n");
    }
}

static I32 summarize(const char file[:], const char *smith) {
    if (!read_table(file)) {
        console::print_error("frontend_coverage: cannot read ", file, "\n");
        return 1;
    }
    Usize passed = 0;
    Usize files = 0;
    for (Usize i = 0; i < entry_count; i++) {
        const char *path = entries[i].path;
        if (starts_file(i)) files += 1;
        if (is_pass(&entries[i])) {
            passed += 1;
            console::print("pass  ", path, "\n");
        } else if (entries[i].position[0] != '\0') {
            console::print("FAIL  ", path, ":", (const char *)entries[i].position, " [", (const char *)entries[i].stage,
                           "] ", (const char *)entries[i].message, "\n");
        } else {
            console::print("FAIL  ", path, " [", (const char *)entries[i].stage, "] ", (const char *)entries[i].message,
                           "\n");
        }
    }
    group_failures();
    sort_groups();
    console::print("\n");
    if (smith != nullptr) print_measured(smith);
    console::print("frontend-coverage: ", passed, " of ", files, " files pass\n");
    print_stages();
    print_causes();
    console::print("\n");
    print_cause_lines();
    return 0;
}

// ------------------------------------------------------------------------------------------------------------ run

static char tree[files_max][path_size];
static Usize tree_count = 0;

constexpr Usize projects_max = 256;

// The folders of the projects of the tree (a build.c, build.smith or main.smith, not the library's own); the first
// is the repository itself (the empty folder).
static char projects[projects_max][path_size];
static Bool linked_source[projects_max];
static Usize project_count = 1;

// Whether `path` is a .smith file (the others in the tree are C headers that only get copied).
static Bool is_smith(const char *path) {
    typeof(const char[:]) text = view_of(path);
    return countof(text) > 6 && same(text[countof(text) - 6:countof(text)], ".smith");
}

// The folder of the real tree: its `.smith/include` holds the headers smith writes for the libraries (<smith/test.h>)
// and its `include` the headers of smith's own runtime.
static const char *include_root = nullptr;

// The tracked .smith files of `root` and the C headers beside them (a file imports them), one per line.
static Bool list_tree(const char *root) {
    const char *const argv[_] = {"git", "-C", root, "ls-files", "*.smith", "*.h"};
    process::OutputResult done = process::run(argv[0:6]);
    if (done == .error || done.ok.exit.status != 0) return false;
    typeof(char[:]) text = mem::view(done.ok.output, char);
    defer mem::free(done.ok.output.data);
    if (done.ok.errors.data != nullptr) mem::free(done.ok.errors.data);
    Usize at = 0;
    while (at < countof(text)) {
        // a tree beyond files_max is an error, not a smaller tree (#2264)
        if (tree_count == files_max) return false;
        Usize end = find(text, '\n', at);
        if (end == at) break;
        copy_text(tree[tree_count][0:path_size], text[at:end]);
        tree_count += 1;
        at = end + 1;
    }
    return true;
}

// The folders of the projects: every tracked build.c, build.smith and main.smith outside lib/ (a fixture with only a
// main.smith is a project too), other than the repository's own.
static void list_projects(const char *root) {
    const char *const argv[_] = {"git", "-C", root, "ls-files", "*build.c", "*build.smith", "*main.smith"};
    process::OutputResult done = process::run(argv[0:7]);
    if (done == .error || done.ok.exit.status != 0) return;
    typeof(char[:]) text = mem::view(done.ok.output, char);
    defer mem::free(done.ok.output.data);
    if (done.ok.errors.data != nullptr) mem::free(done.ok.errors.data);
    projects[0][0] = '\0';
    Usize at = 0;
    while (at < countof(text) && project_count < projects_max) {
        Usize end = find(text, '\n', at);
        typeof(const char[:]) line = text[at:end];
        Usize slash = countof(line);
        while (slash > 0 && line[slash - 1] != '/')
            slash -= 1;
        // `tests/f/build.c` is the project `tests/f`; `build.c` alone is the repository; a file of lib/ is a module.
        // The list is sorted, so a folder with two of the files is listed twice in a row.
        Bool library = countof(line) >= 4 && same(line[0:4], "lib/");
        Bool again = project_count > 1 && same(text_of(projects[project_count - 1][0:path_size]), line[0:slash - 1]);
        if (slash > 1 && !library && !again) {
            copy_text(projects[project_count][0:path_size], line[0:slash - 1]);
            project_count += 1;
        }
        at = end + 1;
    }
}

// The project of a file: the longest project folder that holds it (0, the repository, when none does).
static Usize project_of(const char path[:]) {
    Usize best = 0;
    Usize best_length = 0;
    for (Usize i = 1; i < project_count; i++) {
        typeof(const char[:]) folder = text_of(projects[i][0:path_size]);
        if (countof(folder) + 1 < countof(path) && countof(folder) > best_length &&
            same(path[0:countof(folder)], folder) && path[countof(folder)] == '/') {
            best = i;
            best_length = countof(folder);
        }
    }
    return best;
}

// Gives each project the two roots the front end looks under, from the folder of the project: `lib` is the library of
// the copied tree (unless the project has its own), and `src` is the project folder itself (unless it has a src
// folder).
static void link_roots(const char *scratch) {
    for (Usize i = 0; i < project_count; i++) {
        char folder[path_size * 2];
        char link[path_size * 2 + 8];
        char library[path_size * 2];
        typeof(const char[:]) name = text_of(projects[i][0:path_size]);
        format::Written made = format::to(folder, sizeof folder, scratch, countof(name) > 0 ? "/" : "", name);
        (void)format::to(link, sizeof link, (const char *)folder, "/src");
        // a link left by an earlier run is made again, so that the names in the results do not depend on it (#2309)
        (void)c::unlink(link);
        if (!files::exists(view_of(link))) {
            linked_source[i] = c::symlink(".", link) == 0;
        }
        if (i == 0) continue;
        (void)format::to(link, sizeof link, (const char *)folder, "/lib");
        (void)format::to(library, sizeof library, scratch, "/lib");
        if (!files::exists(view_of(link))) (void)c::symlink(library, link);
        (void)made;
    }
}

// Makes `root` and the folders of `path` below it: every prefix, the ones that exist are left as they are.
static void make_folders(const char *root, const char *path) {
    char folder[path_size * 2];
    format::Written made = format::to(folder, sizeof folder, root, "/", path);
    for (Usize i = 1; i < made.length; i++) {
        if (folder[i] != '/') continue;
        folder[i] = '\0';
        (void)files::make_folder(folder[0:i]);
        folder[i] = '/';
    }
}

// Copies each file to the scratch tree, never touching the original. Returns false at the first file that fails.
static Bool copy_tree(const char *root, const char *scratch) {
    for (Usize i = 0; i < tree_count; i++) {
        char from[path_size * 2];
        char to[path_size * 2];
        format::Written a = format::to(from, sizeof from, root, "/", (const char *)tree[i]);
        format::Written b = format::to(to, sizeof to, scratch, "/", (const char *)tree[i]);
        make_folders(scratch, tree[i]);
        files::BytesResult loaded = files::read_file(from[0:a.length]);
        if (loaded == .error) return false;
        defer mem::free(loaded.ok.data);
        files::CountResult written = files::write_file(to[0:b.length], loaded.ok, files::Replace);
        if (written == .error) return false;
    }
    return true;
}

// The first position of `needle` in `text`, or the length of the text.
static Usize find_text(const char text[:], const char needle[:]) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        if (same(text[i:i + countof(needle)], needle)) return i;
    }
    return countof(text);
}

// The stage the front end named in a compile's output (`path: stage: check`), `parse` when it named none.
static void stage_named(const char output[:], char stage[:]) {
    copy_text(stage, "parse");
    Usize named = find_text(output, ": stage: ");
    if (named < countof(output)) copy_text(stage, output[named + 9:countof(output)]);
}

// The `line:column` before an `: error:` at `error` in `line`: the text after the last-but-one colon of what comes
// before it. Empty when the line has no such position.
static typeof(const char[:]) position_of(const char line[:], Usize error) {
    Usize colons = 0;
    Usize at = error;
    while (at > 0 && colons < 2) {
        at -= 1;
        if (line[at] == ':') colons += 1;
    }
    if (colons < 2) return line[0:0];
    return line[at + 1:error];
}

// Every error of a compile's output, as an entry each: `a.smith:3:7: error: message` is `message` at `3:7`. Output
// with no `error:` line (a crash, a missing tool) is one entry with the text as it stands. Returns how many.
static Usize record_errors(const char *path, const char output[:], const char stage[:], I32 status) {
    Usize made = 0;
    Usize at = 0;
    while (at < countof(output)) {
        Usize end = find(output, '\n', at);
        typeof(const char[:]) line = output[at:end];
        Usize error = find_text(line, ": error: ");
        if (error < countof(line)) {
            char message[message_size];
            copy_text(message[0:message_size], line[error + 9:countof(line)]);
            add_entry(view_of(path), stage, message[0:message_size], position_of(line, error));
            made += 1;
        }
        at = end + 1;
    }
    if (made == 0) {
        char message[message_size];
        char shown[message_size];
        // a compile that died (killed by the memory cap, a signal, no output) names its status as its cause (#2264)
        (void)format::to(shown, sizeof shown, "compile ended with status ", status, status > 128 ? " (signal)" : "",
                         countof(output) > 0 ? ": " : "", output[0:countof(output) < 120 ? countof(output) : 120]);
        copy_text(message[0:message_size], text_of(shown[0:message_size]));
        add_entry(view_of(path), stage, message[0:message_size], "");
        made = 1;
    }
    return made;
}

// The fixer on the copy of one file (the process is in the scratch tree). Records a failure.
static void fix(const char *smith, const char *path) {
    char message[message_size];
    const char *const fix[_] = {smith, "lint", "--fix", path};
    struct Ran fixed = run_program(fix[0:4]);
    if (fixed.status != 0) {
        copy_text(message[0:message_size], fixed.text);
        add_entry(view_of(path), "fixer", message[0:message_size], "");
    }
    release(&fixed);
}

// The new front end on one fixed file, from the folder of its project. Records the result.
static void measure(const char *smith, const char *scratch, const char *path) {
    char stage[stage_size];
    Usize project = project_of(view_of(path));
    typeof(const char[:]) folder = text_of(projects[project][0:path_size]);
    typeof(const char[:]) inside = view_of(path)[countof(folder) > 0 ? countof(folder) + 1 : 0:countof(view_of(path))];
    char name[path_size + 8];
    // A file under the project's own src folder is named from there; any other is named below the `src` link.
    Bool real_src = countof(inside) > 4 && same(inside[0:4], "src/");
    (void)format::to(name, sizeof name, linked_source[project] && !real_src ? "src/" : "", inside);
    char home[path_size * 2];
    (void)format::to(home, sizeof home, scratch, countof(folder) > 0 ? "/" : "", folder);
    if (c::chdir(home) != 0) {
        add_entry(view_of(path), "parse", "cannot enter the project folder", "");
        return;
    }
    char object[path_size + 12];
    (void)format::to(object, sizeof object, (const char *)name, ".o");
    char include[path_size * 2];
    (void)format::to(include, sizeof include, "-I", include_root, "/.smith/include");
    char own[path_size * 2];
    (void)format::to(own, sizeof own, "-I", include_root, "/include");
    // The address space of one compile is capped (6 GB): two files of front/ make the front end grow to 13 GB
    // before it fails, which killed the 16 GB hosted runner (#2254); a file over the cap fails alone, as `parse` does.
    const char *const compile[_] = {"/bin/sh",
                                    "-c",
                                    "ulimit -v 6291456; exec \"$@\"",
                                    "sh",
                                    smith,
                                    "cc",
                                    "--front-end=new",
                                    (const char *)include,
                                    (const char *)own,
                                    "-c",
                                    name,
                                    "-o",
                                    object};
    struct Ran compiled = run_program(compile[0:13]);
    if (compiled.status == 0) {
        add_entry(view_of(path), "pass", "", "");
    } else {
        stage_named(compiled.text, stage[0:stage_size]);
        (void)record_errors(path, compiled.text, text_of(stage[0:stage_size]), compiled.status);
    }
    release(&compiled);
}

// ---------------------------------------------------------------------------------------- imports, hashes and cache

constexpr Usize imports_max = 64;
constexpr U64 fnv_prime = 1099511628211ULL;

struct Hash {
    U64 a;
    U64 b;
};

static struct Hash hash_start() {
    return (struct Hash){.a = 14695981039346656037ULL, .b = 0x9E3779B97F4A7C15ULL};
}

static struct Hash hash_bytes(struct Hash h, const char text[:]) {
    for (Usize i = 0; i < countof(text); i++) {
        h.a = (h.a ^ (U64)(U8)text[i]) * fnv_prime;
        h.b = (h.b + (U64)(U8)text[i] + 1) * fnv_prime;
    }
    return h;
}

static struct Hash hash_number(struct Hash h, U64 value) {
    for (Usize i = 0; i < 8; i++) {
        h.a = (h.a ^ ((value >> (i * 8)) & 255)) * fnv_prime;
        h.b = (h.b + ((value >> (i * 8)) & 255) + 1) * fnv_prime;
    }
    return h;
}

static struct Hash own_hash[files_max];
static Usize import_list[files_max][imports_max];
static Usize import_count[files_max];
static Bool wanted[files_max];
static Usize queue[files_max];
static struct Hash headers_hash;
static struct Hash smith_hash;

// The index in the tree of `path`, or tree_count.
static Usize tree_find(const char path[:]) {
    for (Usize i = 0; i < tree_count; i++) {
        if (same(text_of(tree[i][0:path_size]), path)) return i;
    }
    return tree_count;
}

// The file the module `name` (`std.math` or `std::math`) of file `file` is: under the project's source folder, else
// under its own or the tree's `lib`, as `load_module` looks (front/compile.smith). tree_count when none holds it.
static Usize resolve_import(Usize file, const char name[:]) {
    char inside[path_size];
    Usize n = 0;
    for (Usize i = 0; i < countof(name) && n + 2 < path_size; i++) {
        if (name[i] == ':' && i + 1 < countof(name) && name[i + 1] == ':') i += 1;
        inside[n] = name[i] == ':' || name[i] == '.' ? '/' : name[i];
        n += 1;
    }
    inside[n] = '\0';
    Usize project = project_of(text_of(tree[file][0:path_size]));
    const char *const middles[_] = {"src/", "", "lib/", "lib/", ""};
    for (Usize r = 0; r < 5; r++) {
        // then the tree's own library, and the folder of the file itself
        const char *folder = r == 3 ? "" : (const char *)projects[project];
        if (r == 2 && folder[0] == '\0') continue;
        char own[path_size];
        if (r == 4) {
            Usize slash = length_of(tree[file][0:path_size]);
            while (slash > 0 && tree[file][slash - 1] != '/')
                slash -= 1;
            if (slash == 0) continue;
            copy_text(own[0:path_size], text_of(tree[file][0:slash - 1]));
            folder = own;
        }
        char candidate[path_size * 2];
        format::Written w = format::to(candidate, sizeof candidate, folder, folder[0] != '\0' ? "/" : "", middles[r],
                                       (const char *)inside, ".smith");
        Usize found = tree_find(candidate[0:w.length]);
        if (found != tree_count) return found;
    }
    return tree_count;
}

static Bool name_char(char c) {
    return c == '_' || c == ':' || c == '.' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || is_digit(c);
}

// The module a line imports: the name after `import` (`from X import` and `pub import` too), empty for a C header.
static typeof(const char[:]) imported_by(const char line[:]) {
    Usize at = 0;
    if (countof(line) > 4 && same(line[0:4], "pub ")) at = 4;
    if (countof(line) > at + 5 && same(line[at:at + 5], "from ")) {
        at += 5;
    } else if (countof(line) > at + 7 && same(line[at:at + 7], "import ")) {
        at += 7;
    } else {
        return line[0:0];
    }
    Usize end = at;
    while (end < countof(line) && name_char(line[end]))
        end += 1;
    return line[at:end];
}

static void add_import(Usize file, Usize found) {
    if (found == tree_count || found == file || import_count[file] == imports_max) return;
    for (Usize k = 0; k < import_count[file]; k++) {
        if (import_list[file][k] == found) return;
    }
    import_list[file][import_count[file]] = found;
    import_count[file] += 1;
}

// The hash of file `i` of the real tree and the files it imports, from its text.
static Bool index_file(const char *root, Usize i) {
    char from[path_size * 2];
    format::Written a = format::to(from, sizeof from, root, "/", (const char *)tree[i]);
    files::BytesResult loaded = files::read_file(from[0:a.length]);
    if (loaded == .error) return false;
    defer mem::free(loaded.ok.data);
    typeof(char[:]) text = mem::view(loaded.ok, char);
    own_hash[i] = hash_bytes(hash_bytes(hash_start(), text_of(tree[i][0:path_size])), text);
    if (!is_smith(tree[i])) return true;
    Usize at = 0;
    while (at < countof(text)) {
        Usize end = find(text, '\n', at);
        typeof(const char[:]) name = imported_by(text[at:end]);
        if (countof(name) > 0) add_import(i, resolve_import(i, name));
        at = end + 1;
    }
    return true;
}

// Hashes every tracked file and the imports of every .smith file, once.
static Bool index_tree(const char *root) {
    struct Hash headers = hash_start();
    for (Usize i = 0; i < tree_count; i++) {
        import_count[i] = 0;
        if (!index_file(root, i)) return false;
        if (!is_smith(tree[i])) headers = hash_number(hash_number(headers, own_hash[i].a), own_hash[i].b);
    }
    headers_hash = headers;
    return true;
}

// Marks `first` and everything it imports transitively in `wanted`; the order of `queue` is the order of discovery.
// Returns how many are marked.
static Usize mark_closure(Usize first, Usize count) {
    if (wanted[first]) return count;
    wanted[first] = true;
    queue[count] = first;
    Usize head = count;
    count += 1;
    while (head < count) {
        Usize at = queue[head];
        head += 1;
        for (Usize k = 0; k < import_count[at]; k++) {
            Usize next = import_list[at][k];
            if (wanted[next]) continue;
            wanted[next] = true;
            queue[count] = next;
            count += 1;
        }
    }
    return count;
}

// The cache key of the fix of file `i`: the smith, the C headers, the file's path, and each file it imports, directly
// or not, added so that the order does not matter.
static struct Hash fix_key(Usize i) {
    static Bool seen[files_max];
    static Usize stack[files_max];
    for (Usize k = 0; k < tree_count; k++)
        seen[k] = false;
    U64 sum_a = 0;
    U64 sum_b = 0;
    Usize top = 1;
    stack[0] = i;
    seen[i] = true;
    while (top > 0) {
        top -= 1;
        Usize at = stack[top];
        sum_a += own_hash[at].a;
        sum_b ^= own_hash[at].b;
        for (Usize k = 0; k < import_count[at]; k++) {
            Usize next = import_list[at][k];
            if (seen[next]) continue;
            seen[next] = true;
            stack[top] = next;
            top += 1;
        }
    }
    // the file itself, apart from the sum: two files of an import cycle have the same closure (#2309)
    struct Hash h = hash_number(hash_number(smith_hash, own_hash[i].a), own_hash[i].b);
    h = hash_number(hash_number(h, headers_hash.a), headers_hash.b);
    return hash_number(hash_number(h, sum_a), sum_b);
}

static void hex_of(char out[:], struct Hash h) {
    const char *digits = "0123456789abcdef";
    for (Usize i = 0; i < 16; i++) {
        out[i] = digits[(h.a >> (60 - i * 4)) & 15];
        out[16 + i] = digits[(h.b >> (60 - i * 4)) & 15];
    }
    out[32] = '\0';
}

static Usize cache_hits = 0;
static Usize cache_misses = 0;
static const char *cache_folder = nullptr;

// Fixes the copy of file `i` (the process is in the scratch tree) with the fixer, or with a cache entry made by a
// fixer that read the same files. Records a failure. A file that fails to fix is never cached.
static void fix_cached(const char *smith, Usize i) {
    char name[33];
    char entry[path_size * 2];
    hex_of(name[0:33], fix_key(i));
    format::Written e = format::to(entry, sizeof entry, cache_folder, "/", (const char *)name);
    files::BytesResult cached = files::read_file(entry[0:e.length]);
    if (cached != .error) {
        defer mem::free(cached.ok.data);
        char to[path_size];
        copy_text(to[0:path_size], text_of(tree[i][0:path_size]));
        files::CountResult put = files::write_file(view_of(to), cached.ok, files::Replace);
        if (put != .error) {
            cache_hits += 1;
            return;
        }
    }
    cache_misses += 1;
    Usize before = entry_count;
    fix(smith, tree[i]);
    if (entry_count != before) return;
    files::BytesResult fixed = files::read_file(text_of(tree[i][0:path_size]));
    if (fixed == .error) return;
    defer mem::free(fixed.ok.data);
    (void)files::write_file(entry[0:e.length], fixed.ok, files::Replace);
}

// The hash of the smith that fixes: its file.
static Bool hash_smith(const char *smith) {
    files::BytesResult loaded = files::read_file(view_of(smith));
    if (loaded == .error) return false;
    defer mem::free(loaded.ok.data);
    typeof(char[:]) text = mem::view(loaded.ok, char);
    smith_hash = hash_bytes(hash_start(), text);
    return true;
}

// Marks the files named in `list` (separated by commas) and what they import. Returns how many are marked, or 0 when
// a name is not a tracked file.
static Usize mark_files(const char list[:]) {
    Usize count = 0;
    Usize at = 0;
    while (at < countof(list)) {
        Usize end = find(list, ',', at);
        Usize found = tree_find(list[at:end]);
        if (found == tree_count || !is_smith(tree[found])) {
            console::print_error("frontend_coverage: error: ", list[at:end], " is not a tracked .smith file\n");
            return 0;
        }
        count = mark_closure(found, count);
        at = end + 1;
    }
    return count;
}

// The count must be the file list: one group of rows per tracked .smith file, none dropped, none missing. A mismatch is
// an error (exit 1), never a smaller total (#2264).
static I32 check_total(Bool all) {
    Usize expected = 0;
    for (Usize i = 0; i < tree_count; i++) {
        if (is_smith(tree[i]) && (all || wanted[i])) expected += 1;
    }
    Usize measured = 0;
    for (Usize i = 0; i < entry_count; i++) {
        if (starts_file(i)) measured += 1;
    }
    if (entries_dropped > 0) {
        console::print_error("frontend_coverage: error: the table is full, ", entries_dropped, " rows were dropped\n");
        return 1;
    }
    if (measured != expected) {
        console::print_error("frontend_coverage: error: ", measured, " files measured, ", expected,
                             " tracked .smith files\n");
        return 1;
    }
    return 0;
}

static I32 run(const char *smith, const char *root, const char *scratch, const char list[:]) {
    include_root = root;
    if (!list_tree(root)) {
        console::print_error("frontend_coverage: cannot list the files of ", root, "\n");
        return 1;
    }
    if (!copy_tree(root, scratch)) {
        console::print_error("frontend_coverage: cannot copy the files to ", scratch, "\n");
        return 1;
    }
    list_projects(root);
    char folder[path_size * 2];
    (void)format::to(folder, sizeof folder, scratch, "/../fixed");
    cache_folder = folder;
    (void)files::make_folder(view_of(folder));
    if (!hash_smith(smith) || !index_tree(root)) {
        console::print_error("frontend_coverage: cannot read the smith or the files of ", root, "\n");
        return 1;
    }
    // With a list, only these files and what they import (transitively) are measured.
    Bool all = countof(list) == 0;
    if (!all && mark_files(list) == 0) return 2;
    (void)c::setenv("SMITH_FRONT_STAGE", "1", 1);
    if (c::chdir(scratch) != 0) return 1;
    // All the fixes first: a file imports modules that must already be in the new syntax when it is compiled.
    Bool fixed[files_max];
    for (Usize i = 0; i < tree_count; i++) {
        fixed[i] = false;
        if (!is_smith(tree[i]) || (!all && !wanted[i])) continue;
        Usize before = entry_count;
        fix_cached(smith, i);
        fixed[i] = entry_count == before;
    }
    console::print_error("frontend_coverage: fixer cache: ", cache_hits, " files reused, ", cache_misses, " fixed\n");
    link_roots(scratch);
    for (Usize i = 0; i < tree_count; i++) {
        if (fixed[i]) measure(smith, scratch, tree[i]);
    }
    for (Usize i = 0; i < entry_count; i++) {
        console::print((const char *)entries[i].path, "\t", (const char *)entries[i].stage, "\t",
                       (const char *)entries[i].message, "\t", (const char *)entries[i].position, "\n");
    }
    return check_total(all);
}

// ------------------------------------------------------------------------------------------------------------ chain

// The first entry of the file `path`, or entry_count.
static Usize first_entry(const char path[:]) {
    for (Usize i = 0; i < entry_count; i++) {
        if (starts_file(i) && same(text_of(entries[i].path[0:path_size]), path)) return i;
    }
    return entry_count;
}

// `path`'s stage and first error on one line: `pass`, or `[stage] message` (with the position when it has one).
static void print_result(Usize at) {
    if (at == entry_count) {
        console::print("not measured\n");
    } else if (is_pass(&entries[at])) {
        console::print("pass\n");
    } else if (entries[at].position[0] != '\0') {
        console::print("[", (const char *)entries[at].stage, "] ", (const char *)entries[at].position, " ",
                       (const char *)entries[at].message, "\n");
    } else {
        console::print("[", (const char *)entries[at].stage, "] ", (const char *)entries[at].message, "\n");
    }
}

// The module a path is: `lib/std/mem.smith` is `std.mem`; any other path is printed as it is.
static void print_module(const char path[:]) {
    Bool library = countof(path) > 4 && same(path[0:4], "lib/");
    Usize from = library ? 4 : 0;
    Usize to = countof(path) > 6 ? countof(path) - 6 : countof(path);
    for (Usize i = from; i < to; i++) {
        if (library && path[i] == '/') {
            console::print(".");
        } else {
            console::print(path[i:i + 1]);
        }
    }
}

// The line of each file of the chain (the files named, then what they import) and under it every import that fails
// (#2309): `imports std.optimize: [check] 3:1 message`. A file that passes and was not named is left out.
static I32 chain(const char results[:], const char *root, const char list[:]) {
    include_root = root;
    if (!read_table(results) || !list_tree(root)) return 1;
    list_projects(root);
    if (!index_tree(root)) return 1;
    Usize count = mark_files(list);
    if (count == 0) return 2;
    Usize passed = 0;
    for (Usize q = 0; q < count; q++) {
        Usize at = first_entry(text_of(tree[queue[q]][0:path_size]));
        Bool named = q == 0 || at == entry_count || !is_pass(&entries[at]);
        if (at != entry_count && is_pass(&entries[at])) passed += 1;
        if (!named) continue;
        console::print((const char *)tree[queue[q]], ": ");
        print_result(at);
        for (Usize k = 0; k < import_count[queue[q]]; k++) {
            Usize dep = import_list[queue[q]][k];
            Usize found = first_entry(text_of(tree[dep][0:path_size]));
            if (found != entry_count && is_pass(&entries[found])) continue;
            console::print("    imports ");
            print_module(text_of(tree[dep][0:path_size]));
            console::print(": ");
            print_result(found);
        }
    }
    console::print("frontend-coverage: ", passed, " of ", count,
                   " files pass (the files named and what they import)\n");
    return 0;
}

I32 main(Str args[:]) {
    if (countof(args) == 5 && same(args[1], "run")) return run(args[2].data, args[3].data, args[4].data, args[4][0:0]);
    if (countof(args) == 6 && same(args[1], "run")) return run(args[2].data, args[3].data, args[4].data, args[5]);
    if (countof(args) == 5 && same(args[1], "chain")) return chain(args[2], args[3].data, args[4]);
    if (countof(args) == 3 && same(args[1], "summarize")) return summarize(args[2], nullptr);
    if (countof(args) == 4 && same(args[1], "summarize")) return summarize(args[2], args[3].data);
    console::print_error(
        "usage: frontend_coverage run SMITH ROOT SCRATCH [FILES] | frontend_coverage chain RESULTS ROOT FILES | "
        "frontend_coverage summarize RESULTS [SMITH]\n");
    return 2;
}
