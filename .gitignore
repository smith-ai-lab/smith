/include/smith/result.h
/include/smith/slice.h
/include/smith/task.h
/include/smith/ascii.h
/include/smith/test.h
/include/smith/text.h
/include/smith/random.body
# The protocol code scripts/protocol.c writes from schemas/ (knowledge/protocol-generation.md), which `smith build` puts in
# .smith/protocol/; these paths guard a copy put back where it used to be committed.
/runtime/protocol/dap.c
/runtime/protocol/dap.h
/runtime/protocol/mcp.c
/runtime/protocol/mcp.h
/tests/protocol/test_protocol_dap.c
/tests/protocol/test_protocol_mcp.c
# The tree-sitter parser (`smith build` generates it from tree-sitter/grammar.js).
/tree-sitter/src/
# Profiles of a run under coverage are generated files, never committed (tests/generated_files_test.smith).
*.profraw
*.profdata
