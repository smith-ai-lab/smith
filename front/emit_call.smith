// front::emit_call: calls, `return;` and function prototypes for the emitter (B3a, #1112). The protocol is at the top
// of front/emit.smith.
//
// A call `f(a, b)` names a function of the module or a prototype in it. The callee's key is its path joined by `::`
// (`geometry::area`); it is found among the module's functions (`e->functions`, bodies) or among the module's
// prototypes (a `Decl.function` with no body, found in the tree). The arguments are evaluated left to right, each with
// the parameter's type as its hint; their number and types must be the parameters' exactly (no conversions yet).
// A prototype is NOT added to `e->functions`: pass 3 walks that table in step with the functions that have bodies, so a
// prototype in it would shift every body after it. It is declared in the LLVM module, and a call finds it again in the
// tree. A prototype's symbol is the module's path and its name, like any function (`front::test::cube`); a name
// written with `::` (`geometry::area`) is the symbol itself, which is how a prototype stands for a function of another
// module.
//
// Named arguments (`connect(host = x, retry = true)`) fill the parameter of that name, by position until the first
// named one (the checker's `argument_slot`); they are evaluated in the order written and passed in parameter order. A
// call of a name that is a record of the module builds a value of it, `Point(1, y = 2)`: positional fields in order,
// then named ones in any order, a field left out zero; the value starts as `LLVMConstNull` and each field is inserted
// in the order written.
//
// `Void` is a type of its own here (an LLVM `void`, kind `integer`, zero bits, named `Void`): a call of a function
// that returns it pushes one value of that type, so an expression statement drops it like any other.
module front::emit_call;

import front::ast;
import front::emit_builtin as builtin;
import front::emit_control as control;
import front::emit_lambda as lambdas;
import front::emit_match as matching;
import front::emit_memory;
import front::emit_recursion as recursion;
import front::emit_state as state;
import front::emit_stream as streams;
import front::types;
import std::arena;
import std::format;
import std::mem;
import <llvm-c/Core.h>;

typedef ast::ExprRef ArgumentList[:];

export struct Signature;

// A function as a call sees it. `params` is the callee's own when `owned` is false, else it is allocated.
export struct Signature {
    c::LLVMValueRef function;
    c::LLVMTypeRef type;
    state::Ty result;
    state::Ty params[:];
    Bool owned;
    Bool variadic; // a C function's `...`: arguments past `params` are passed after C's default promotions
};

export typedef Result(Signature, state::Error) SignatureResult;

static Bool is_void(state::Ty ty) {
    return c::LLVMGetTypeKind(ty.llvm) == c::LLVMVoidTypeKind;
}

static void release(Signature sig) {
    if (sig.owned) mem::free(sig.params.data);
}

// The type a type expression says, with `Void` for the result of a function that returns nothing (the hook of
// front::emit's `type_of`, which cannot be imported from here).
static state::TyResult type_for(state::Emitter *e, const ast::TypeExpr *t) {
    return state::type_of(e, t);
}

// The path joined by `::`, in the allocator in force.
static Str join(ast::Path path) {
    Str key = state::msg(format::push(path.segments[0].text));
    for (Usize i = 1; i < countof(path.segments); i++) {
        Str longer = state::msg(format::push(key, "::", path.segments[i].text));
        state::free_text(key);
        key = longer;
    }
    return key;
}

// The LLVM name of a prototype: the module's path and the name, or the name itself when it holds a `::`.
static Str symbol_for(state::Emitter *e, Str name) {
    Str symbol = state::msg(format::push(name));
    for (Usize i = 0; i + 1 < countof(name); i++) {
        if (name[i] == ':' && name[i + 1] == ':') return symbol;
    }
    for (Usize i = countof(e->tree->name.segments); i > 0; i--) {
        Str longer = state::msg(format::push(e->tree->name.segments[i - 1].text, "::", symbol));
        state::free_text(symbol);
        symbol = longer;
    }
    return symbol;
}

static SignatureResult signature_failed(state::Status status) {
    if (status == .error) {
        return {.error = status.error};
    }
    state::Error none = {};
    return {.error = none};
}

// The types of a function declaration (its function type too), or why it is not emitted.
static SignatureResult signature(state::Emitter *e, const ast::Decl *d) {
    if (d->kind != .function) {
        return signature_failed(state::fail("not a function", d->span));
    }
    ast::Param source[:] = d->kind.function.params;
    const ast::TypeExpr *result_type = d->kind.function.result;
    Bool variadic = d->kind.function.variadic;
    Usize count = countof(source);
    if (count > 64) return signature_failed(state::not_emitted("more than 64 parameters", d->span));
    for (Usize i = 0; i < count; i++) {
        if (source[i].is_constexpr || source[i].is_rest)
            return signature_failed(state::not_emitted("constexpr or rest parameter", source[i].span));
    }
    state::Ty all[:] = mem::alloc_slice(state::Ty, count + 1);
    c::LLVMTypeRef parameter_types[64];
    for (Usize i = 0; i < count; i++) {
        state::TyResult made = type_for(e, source[i].type);
        if (made == .error) {
            mem::free(all.data);
            return {.error = made.error};
        }
        if (is_void(made.ok)) {
            mem::free(all.data);
            return signature_failed(state::fail("a parameter cannot be Void", source[i].span));
        }
        all[i] = made.ok;
        parameter_types[i] = state::abi_type(e, made.ok);
    }
    state::Ty none = {.kind = {.integer = {}}, .llvm = c::LLVMVoidTypeInContext(e->context), .name = "Void"};
    state::TyResult made_result = {.ok = none};
    if (result_type != nullptr) made_result = type_for(e, result_type);
    if (made_result == .error) {
        mem::free(all.data);
        return {.error = made_result.error};
    }
    Signature sig = {.result = made_result.ok, .params = all[0:count], .owned = true, .variadic = variadic};
    sig.type = c::LLVMFunctionType(made_result.ok.llvm, parameter_types, (U32)count, variadic ? 1 : 0);
    return sig;
}

// A function of a C header (#1762), `c::printf`: its type is the checker's (the header's own names are typedefs the
// emitter has no declaration for), and its symbol is its C name. Declared when the first call needs it.
static SignatureResult c_function(state::Emitter *e, const ast::Decl *d) {
    if (d->kind != .function) return signature_failed(state::fail("not a function", d->span));
    Str name = d->kind.function.name;
    const types::Symbol *symbol =
        types::lookup_as(&e->options.checked->scopes, state::msg(format::push("c::", name)), false);
    if (symbol != nullptr && symbol->kind == .type_name) { // a struct of the same name: the function is `name()`
        symbol = types::lookup(&e->options.checked->scopes, state::msg(format::push("c::", name, "()")));
    }
    if (symbol == nullptr || symbol->type->kind != .function) {
        return signature_failed(state::fail("not a C function", d->span));
    }
    types::TypeRef type = symbol->type;
    Usize count = countof(types::slots_of(type).items);
    if (count > 64) {
        return signature_failed(state::not_emitted("more than 64 parameters", d->span));
    }
    state::Ty all[:] = mem::alloc_slice(state::Ty, count + 1);
    c::LLVMTypeRef llvm_types[64];
    for (Usize i = 0; i < count; i++) {
        // A function pointer of C is the bare `ptr`, not a `fn` value's `{ code, context }`.
        types::TypeRef held = types::slots_of(type).items[i].type;
        state::TyResult made =
            held->kind == .fn_value ? lambdas::pointer_from_checked(e, held) : state::type_of_checked(e, held, d->span);
        if (made == .error) {
            mem::free(all.data);
            return {.error = made.error};
        }
        all[i] = made.ok;
        llvm_types[i] = made.ok.llvm;
    }
    state::TyResult made_result = state::type_of_checked(e, types::element_of(type), d->span);
    if (made_result == .error) {
        mem::free(all.data);
        return {.error = made_result.error};
    }
    Signature sig = {
        .result = made_result.ok, .params = all[0:count], .owned = true, .variadic = types::is_variadic(type)};
    sig.type = c::LLVMFunctionType(made_result.ok.llvm, llvm_types, (U32)count, types::is_variadic(type) ? 1 : 0);
    char *label = state::cstr(name);
    sig.function = c::LLVMGetNamedFunction(e->module, label);
    if (sig.function == nullptr) sig.function = c::LLVMAddFunction(e->module, label, sig.type);
    mem::free(label);
    return sig;
}

// The prototype of a function of an imported module, declared when the first call needs it (#1714): an external
// function named by `key`, the symbol the module's own object defines.
// `geom::vec::` for the key `geom::vec::dot`: the text up to and including the last `::`.
static Str module_prefix(Str key) {
    for (Usize i = countof(key); i >= 2; i--) {
        if (key[i - 1] == ':' && key[i - 2] == ':') return key[0:i];
    }
    return "";
}

static SignatureResult imported_function(state::Emitter *e, Str key, const ast::Decl *d) {
    if (d->from_c) return c_function(e, d);
    e->import_scope = module_prefix(key);
    SignatureResult made = signature(e, d);
    e->import_scope = "";
    if (made == .error) {
        state::Error located = made.error;
        if (countof(located.module) == 0) located.module = module_prefix(key);
        return {.error = located};
    }
    Signature sig = made.ok;
    Str own = state::c_name_of(d); // `@c_name("__enzyme_autodiff")`: the symbol is the C name, not the module's path
    Str named = key;
    if (d->is_extern && d->kind == .function) named = d->kind.function.name; // an extern's symbol is its own name
    char *label = state::cstr(countof(own) > 0 ? own : named);
    sig.function = c::LLVMGetNamedFunction(e->module, label);
    if (sig.function == nullptr) sig.function = c::LLVMAddFunction(e->module, label, sig.type);
    mem::free(label);
    return sig;
}

static Bool is_c_path(ast::Path path) {
    return countof(path.segments) == 2 && state::same_text(path.segments[0].text, "c");
}

// `c::name` where `name` is a function a header declared.
static Bool c_callee(state::Emitter *e, const ast::Expr *callee, const ast::Decl **found, Str *symbol) {
    Str full = "";
    if (callee->kind == .name && countof(callee->kind.name.path.segments) == 1) {
        // `abs` after `from c <stdlib.h> import abs`: the checker bound the header's `c::abs` under the bare name
        state::Local local = {};
        Str bare = callee->kind.name.path.segments[0].text;
        const types::Symbol *alias = types::lookup(&e->options.checked->scopes, bare);
        if (alias == nullptr || alias->kind != .function_symbol || alias->decl == nullptr) return false;
        if (alias->decl->kind != .function || !alias->decl->from_c || state::find_local(e, bare, &local)) return false;
        full = state::msg(format::push("c::", alias->decl->kind.function.name));
    } else if (callee->kind == .name) {
        full = join(callee->kind.name.path);
    } else if (callee->kind ==
                   .member) { // `stdio.name` after `import c <stdio.h>` (#1678), unless a local hides the binding
        state::Local local = {};
        Str name = types::c_member_name_in(e->options.checked, callee, e->instance_scope); // an instance: its module's
        if (countof(name) == 0 || state::find_local(e, types::c_member_base(callee), &local)) return false;
        full = state::msg(format::push("c::", name)); // an owned copy, as `join` makes
    } else {
        return false;
    }
    const types::Symbol *target = types::lookup_as(&e->options.checked->scopes, full, false);
    if (target != nullptr && target->kind == .type_name) { // a struct of the same name: the function is `name()`
        Str tagged = state::msg(format::push(full, "()"));
        target = types::lookup(&e->options.checked->scopes, tagged);
        state::free_text(tagged);
    }
    if (target == nullptr || target->kind != .function_symbol || target->decl->kind != .function) {
        state::free_text(full);
        return false;
    }
    *found = target->decl;
    *symbol = full;
    return true;
}

// The function of an imported module a callee names: `m.sin`, `r.math.sin` (a module imported by another), or `sin`
// after `let sin = m.sin`. The checker has declared each under its module's path (`lib::math::sin`), which is also the
// symbol the module's object defines. Returns false for any other callee.
static Bool imported_callee(state::Emitter *e, const ast::Expr *callee, const ast::Decl **found, Str *symbol) {
    if (e->options.checked == nullptr) return false;
    types::Names names = {};
    if (callee->kind == .name && is_c_path(callee->kind.name.path)) {
        return c_callee(e, callee, found, symbol);
    }
    if (callee->kind == .name && countof(callee->kind.name.path.segments) == 1 && c_callee(e, callee, found, symbol))
        return true;
    if (callee->kind == .member && c_callee(e, callee, found, symbol)) return true;
    if (callee->kind == .member) {
        names = types::member_names(callee);
    } else if (callee->kind == .name && countof(callee->kind.name.path.segments) == 1) {
        for (Usize i = 0; i < countof(e->tree->decls); i++) {
            const ast::Decl *d = e->tree->decls[i];
            if (d->kind != .variable || !d->kind.variable.is_new || d->kind.variable.init == nullptr) continue;
            if (!state::same_text(d->kind.variable.name, callee->kind.name.path.segments[0].text)) continue;
            if (d->kind.variable.init->kind == .member) names = types::member_names(d->kind.variable.init);
        }
    }
    if (names.count < 2 && countof(e->instance_scope) > 0 && callee->kind == .name &&
        countof(callee->kind.name.path.segments) == 1) {
        Str own = state::msg(format::push(e->instance_scope, callee->kind.name.path.segments[0].text));
        const types::Symbol *sibling = types::lookup(&e->options.checked->scopes, own);
        if (sibling != nullptr && sibling->kind == .function_symbol && sibling->decl->kind == .function) {
            *found = sibling->decl; // a function of the module the generic comes from
            *symbol = own;
            return true;
        }
    }
    if (names.count < 2) return false;
    const types::Scopes *scopes = &e->options.checked->scopes;
    Str prefix = "";
    for (Usize i = 0; i + 1 < names.count; i++) {
        const types::Symbol *module = types::lookup(scopes, state::msg(format::push(prefix, names.items[i])));
        // `contract.trusted()` in the body of `mem.copy`'s instance: an import of the module the generic comes from
        if (module == nullptr && i == 0 && countof(e->instance_scope) > 0)
            module = types::lookup(scopes, state::msg(format::push(e->instance_scope, names.items[i])));
        if (module == nullptr || module->kind != .module_name || module->decl->kind != .import_module) return false;
        prefix = state::msg(format::push(join(module->decl->kind.import_module.path), "::"));
    }
    Str full = state::msg(format::push(prefix, names.items[names.count - 1]));
    const types::Symbol *target = types::lookup(scopes, full);
    if (target == nullptr || target->kind != .function_symbol || target->decl->kind != .function) return false;
    *found = target->decl;
    *symbol = full;
    return true;
}

// The call a method call `x.f(a)` stands for, `f(x, a)`, which the checker recorded (#1795); `x` itself for any other
// call.
static const ast::Expr *method_form(state::Emitter *e, const ast::Expr *x) {
    if (e->options.checked == nullptr) return x;
    // A call may be rewritten more than once: `inner(0, rest...)` becomes `inner(0, rest.0, rest.1)`, which becomes
    // `inner(0, (rest.0, rest.1))` with the pack gathered.
    for (Usize step = 0; step < 8; step++) {
        const ast::Expr *made = types::method_of(e->options.checked, x);
        if (made == nullptr || made == x) break;
        x = made;
    }
    return x;
}

// The function of the type's module a method call `x.f(a)` names, when `f` is not one of the current module: the
// symbol `lib::list::f`, found as the checker found it. Returns false for a function of this module.
static Bool method_callee(state::Emitter *e, const ast::Expr *x, const ast::Decl **found, Str *symbol) {
    if (x->kind != .call) return false;
    const ast::Expr *callee = x->kind.call.callee;
    if (callee->kind != .member) return false;
    types::TypeRef t = types::type_of(e->options.checked, callee->kind.member.base);
    if (t == nullptr) return false;
    if (t->kind == .pointer) t = types::element_of(t);
    if (t->kind != .record) return false;
    Str type_name = types::name_of(t);
    Usize cut = 0;
    for (Usize i = countof(type_name); i >= 2; i--) {
        if (type_name[i - 1] == ':' && type_name[i - 2] == ':') {
            cut = i;
            break;
        }
    }
    if (cut == 0) return false;
    Str full = state::msg(format::push(type_name[0:cut], callee->kind.member.name));
    const types::Symbol *target = types::lookup(&e->options.checked->scopes, full);
    if (target == nullptr || target->kind != .function_symbol || target->decl->kind != .function) return false;
    *found = target->decl;
    *symbol = full;
    return true;
}

// `imported_callee` for a call that may be a method call.
static Bool call_target(state::Emitter *e, const ast::Expr *x, const ast::Decl **found, Str *symbol) {
    if (x->kind != .call) return false;
    const ast::Expr *callee = x->kind.call.callee;
    const ast::Expr *made = method_form(e, x);
    if (made == x) return imported_callee(e, callee, found, symbol);
    if (method_callee(e, x, found, symbol)) return true;
    // A call the checker rewrote for a spread (`f(a, rest...)` is `f(a, rest.0, rest.1)`) is no method call: its callee
    // is the function of a header or of an imported module, as written.
    return made->kind == .call && imported_callee(e, made->kind.call.callee, found, symbol);
}

// The instance of a generic function that `x` calls, or null.
// The name of an instance's function: `pick.i32`.
static Str instance_key(const types::Instance *instance) {
    return state::instance_name(instance);
}

static const types::Instance *instance_call(state::Emitter *e, const ast::Expr *x) {
    if (e->options.checked == nullptr) return nullptr;
    // A generic's body is one tree whatever its instances: ask for the call as the instance being emitted records it.
    Usize outer = types::max_instances;
    for (Usize i = 0; e->instance != nullptr && i < e->options.checked->instance_count; i++) {
        if (&e->options.checked->instances[i] == e->instance) outer = i;
    }
    Usize at = types::instance_called_in(e->options.checked, x, outer);
    if (at >= e->options.checked->instance_count) at = types::instance_called(e->options.checked, x);
    if (at >= e->options.checked->instance_count) return nullptr;
    return &e->options.checked->instances[at];
}

// The arguments of a call of an instance: those of the runtime parameters, the type and constant arguments left out.
static ArgumentList runtime_arguments(const types::Instance *instance, ast::ExprRef args[:]) {
    ArgumentList kept = {};
    if (instance->template->kind != .function) return args;
    ast::Param params[:] = instance->template->kind.function.params;
    kept = mem::realloc(kept, countof(args));
    Usize count = 0;
    for (Usize i = 0; i < countof(args) && i < countof(params); i++) {
        if (types::is_compile_time(&params[i])) {
            continue;
        }
        kept[count] = args[i];
        count += 1;
    }
    return kept[0:count];
}

// What a call names when it calls an instance of a generic function: the instance, its key and the runtime arguments;
// or, for any other call, the imported function `call_target` finds (and null).
static const types::Instance *callee_of(state::Emitter *e, const ast::Expr *written, ast::ExprRef args[:],
                                        ArgumentList *runtime, const ast::Decl **imported, Str *key, Bool *found) {
    const types::Instance *instance = instance_call(e, written);
    if (instance == nullptr) instance = instance_call(e, method_form(e, written)); // a call the checker rewrote (#1985)
    *found = false;
    if (instance == nullptr) {
        *found = call_target(e, written, imported, key);
        return nullptr;
    }
    *runtime = runtime_arguments(instance, args);
    *key = instance_key(instance);
    return instance;
}

// The symbol of a prototype of this module: its `@c_name`, else the module's path and its name.
static Str prototype_symbol(state::Emitter *e, const ast::Decl *d, Str name) {
    Str own = state::c_name_of(d);
    if (countof(own) > 0) return state::msg(format::push(own));
    if (d->is_extern) return state::msg(format::push(name)); // an extern's symbol is its own name
    return symbol_for(e, name);
}

// The key up to its first `.`: the function an instance key belongs to (`order::smallest` of `order::smallest.i32`).
static Str function_part(Str key) {
    for (Usize i = 0; i < countof(key); i++) {
        if (key[i] == '.') return key[0:i];
    }
    return key;
}

// What the message of an unknown function adds to the key looked for: the keys of the instances the module has of the
// same function, so a mismatch is read at once. A note when there are none.
static Str same_function_instances(state::Emitter *e, Str key) {
    if (e->options.checked == nullptr) return " (no instance of it in this module)";
    Str base = function_part(key);
    Str listed = "";
    for (Usize i = 0; i < e->options.checked->instance_count; i++) {
        Str name = state::instance_name(&e->options.checked->instances[i]);
        if (state::same_text(function_part(name), base)) {
            listed = state::msg(format::push(listed, countof(listed) == 0 ? "" : ", ", name));
        }
        state::free_text(name);
    }
    if (countof(listed) == 0) return " (no instance of it in this module)";
    return state::msg(format::push(" (the instances of ", base, ": ", listed, ")"));
}

// The function a call names: one of the module's with a body, or a prototype of the module.
static SignatureResult find(state::Emitter *e, Str key, ast::Span span, const ast::Decl *imported) {
    if (imported != nullptr) return imported_function(e, key, imported);
    for (Usize i = 0; i < e->function_count; i++) {
        if (state::same_text(e->functions[i].name, key)) {
            state::FunctionInfo info = e->functions[i];
            Signature sig = {.function = info.llvm,
                             .type = info.llvm_type,
                             .result = info.result,
                             .params = info.params,
                             .variadic = info.variadic};
            return sig;
        }
    }
    for (Usize i = 0; i < countof(e->tree->decls); i++) {
        const ast::Decl *d = e->tree->decls[i];
        if (d->kind != .function || d->kind.function.body != nullptr) continue;
        if (!state::same_text(d->kind.function.name, key)) continue;
        SignatureResult made = signature(e, d);
        if (made == .error) return made;
        Signature sig = made.ok;
        Str symbol = prototype_symbol(e, d, key);
        char *label = state::cstr(symbol);
        state::free_text(symbol);
        sig.function = c::LLVMGetNamedFunction(e->module, label);
        mem::free(label);
        if (sig.function == nullptr) {
            release(sig);
            return signature_failed(state::failf(span, "the prototype of ", key, " is not declared"));
        }
        return sig;
    }
    return signature_failed(state::failf(span, "unknown function ", key, same_function_instances(e, key)));
}

static Bool is_named(const ast::Expr *a) {
    return a->kind == .named_arg;
}

// The name a named argument gives (empty for any other).
static Str given_name(const ast::Expr *a) {
    if (a->kind == .named_arg) return a->kind.named_arg.name;
    return "";
}

// The declaration of the function `key` names, with or without a body (its parameters' names), or null.
static const ast::Decl *find_decl(state::Emitter *e, Str key, const ast::Decl *imported) {
    if (imported != nullptr) return imported;
    for (Usize i = 0; i < countof(e->tree->decls); i++) {
        const ast::Decl *d = e->tree->decls[i];
        if (d->kind == .function && state::same_text(d->kind.function.name, key)) return d;
    }
    if (e->options.checked != nullptr) {
        for (Usize i = 0; i < e->options.checked->instance_count; i++) {
            const ast::Decl *d = e->options.checked->instances[i].decl;
            Str name = state::instance_name(&e->options.checked->instances[i]);
            Bool same = d->kind == .function && state::same_text(name, key);

            state::free_text(name);
            if (same) return d;
        }
    }
    return nullptr;
}

// The parameter each argument fills: `slot[i]` for `args[i]`. By position until the first named argument, then by
// name among the declaration's parameters (the checker's `argument_slot`).
static state::Status assign_slots(state::Emitter *e, Str key, ast::ExprRef args[:], Usize slot[64],
                                  const ast::Decl *imported) {
    Bool named = false;
    for (Usize i = 0; i < countof(args); i++) {
        slot[i] = i;
        if (is_named(args[i])) named = true;
    }
    if (!named) return state::success();
    const ast::Decl *d = find_decl(e, key, imported);
    if (d == nullptr) {
        return state::failf(args[0]->span, "the arguments of ", key, " cannot be named: it has no declaration here");
    }
    if (d->kind != .function) {
        return state::fail("not a function", d->span);
    }
    ast::Param params[:] = d->kind.function.params;
    Bool taken[64];
    for (Usize i = 0; i < 64; i++)
        taken[i] = false;
    Bool by_name = false;
    for (Usize i = 0; i < countof(args); i++) {
        if (!is_named(args[i])) {
            if (by_name) return state::fail("a positional argument cannot follow a named one", args[i]->span);
            taken[i] = true;
            continue;
        }
        by_name = true;
        Str given = given_name(args[i]);
        Bool found = false;
        for (Usize p = 0; p < countof(params) && p < 64; p++) {
            if (!state::same_text(params[p].name, given)) continue;
            if (taken[p]) return state::failf(args[i]->span, "parameter ", given, " of ", key, " is given twice");
            taken[p] = true;
            slot[i] = p;
            found = true;
            break;
        }
        if (!found) return state::failf(args[i]->span, key, " has no parameter ", given);
    }
    return state::success();
}

// The arguments of a call with every parameter it leaves out and that has a default given as a named argument at the
// end. A new slice; the same arguments when the callee has no declaration here (a C function) or nothing is left out.
static ArgumentList filled_arguments(state::Emitter *e, Str key, ast::ExprRef args[:], const ast::Decl *imported) {
    const ast::Decl *d = find_decl(e, key, imported);
    if (d == nullptr || d->kind != .function) return args;
    ast::Param params[:] = d->kind.function.params;
    if (countof(params) > 64) return args;
    Bool given[64];
    for (Usize i = 0; i < 64; i++)
        given[i] = false;
    Bool by_name = false;
    for (Usize i = 0; i < countof(args); i++) {
        if (is_named(args[i])) by_name = true;
        if (!by_name) {
            if (i < 64) given[i] = true;
            continue;
        }
        for (Usize k = 0; k < countof(params); k++) {
            if (state::same_text(params[k].name, given_name(args[i]))) given[k] = true;
        }
    }
    Usize extra = 0;
    for (Usize k = 0; k < countof(params); k++) {
        if (!given[k] && params[k].default_value != nullptr) extra += 1;
    }
    if (extra == 0) return args;
    ArgumentList filled = {};
    filled = mem::realloc(filled, countof(args) + extra);
    for (Usize i = 0; i < countof(args); i++)
        filled[i] = args[i];
    Usize at = countof(args);
    for (Usize k = 0; k < countof(params); k++) {
        if (!given[k] && params[k].default_value != nullptr) {
            filled[at] = ast::named_arg(params[k].name, params[k].default_value);
            at += 1;
        }
    }
    return filled;
}

// The argument's expression: the value of a named one.
static const ast::Expr *value_of(const ast::Expr *arg) {
    if (arg->kind == .named_arg) return arg->kind.named_arg.value;
    return arg;
}

static Bool find_record(state::Emitter *e, Str name, Usize *found) {
    for (Usize i = 0; i < e->record_count; i++) {
        if (state::same_text(e->records[i].name, name)) {
            *found = i;
            return true;
        }
    }
    return false;
}

// The record a checker symbol names, made when first named.
static Bool record_of_symbol(state::Emitter *e, const types::Symbol *symbol, Usize *at) {
    if (symbol == nullptr || symbol->kind != .type_name || symbol->type->kind != .record) return false;
    if (emit_memory::is_imported_record(e, symbol)) { // `AppTests(...)` after `from std.build import AppTests`
        state::TyResult made = emit_memory::imported_record(e, symbol->decl, types::name_of(symbol->type));
        if (made == .error) {
            state::free_text(made.error.message);
            return false;
        }
        return find_record(e, types::name_of(symbol->type), at);
    }
    ast::Span nowhere = {};
    state::TyResult ty = state::type_of_checked(e, symbol->type, nowhere);
    if (ty == .error) {
        state::free_text(ty.error.message);
        return false;
    }
    return find_record(e, types::name_of(symbol->type), at);
}

// `c::point` where a header declared the struct `point`: the record, made when first named.
static Bool c_record(state::Emitter *e, ast::Path path, Usize *at) {
    if (e->options.checked == nullptr) return false;
    Str full = join(path);
    Bool made = record_of_symbol(e, types::lookup_as(&e->options.checked->scopes, full, true), at); // the tag (#2610)
    state::free_text(full);
    return made;
}

// `Writer(...)` in the body of a generic's instance from another module: a record of that module, found under its
// prefix.
static Bool instance_record(state::Emitter *e, ast::Path path, Usize *at) {
    if (e->options.checked == nullptr || countof(e->instance_scope) == 0 || countof(path.segments) != 1) return false;
    Str full = state::msg(format::push(e->instance_scope, path.segments[0].text));
    return record_of_symbol(e, types::lookup(&e->options.checked->scopes, full), at);
}

static Bool find_field(state::RecordType record, Str name, Usize *found) {
    for (Usize i = 0; i < countof(record.fields); i++) {
        if (state::same_text(record.fields[i].name, name)) {
            *found = i;
            return true;
        }
    }
    return false;
}

// The field argument `i` fills: the one at its position, or the one it names.
static Bool field_for(state::RecordType record, ast::ExprRef args[:], Usize i, Usize *found) {
    if (!is_named(args[i])) {
        *found = i;
        return i < countof(record.fields);
    }
    return find_field(record, given_name(args[i]), found);
}

// Whether a field's default gives it a value: `step: Step = undefined` gives none, and the field left out stays as the
// construction starts it (zero).
static Bool fills(const ast::Expr *value) {
    if (value == nullptr) return false;
    if (value->kind != .name || countof(value->kind.name.path.segments) != 1) return true;
    return !state::same_text(value->kind.name.path.segments[0].text, "undefined");
}

// The arguments of a construction with every field they leave out and that has a default given as a named argument
// (the checker already refused a field left out that has none). A new slice.
static ArgumentList filled_fields(state::RecordType record, ast::ExprRef args[:]) {
    Bool given[64];
    for (Usize i = 0; i < 64; i++)
        given[i] = false;
    for (Usize i = 0; i < countof(args); i++) {
        Usize field = 0;
        if (field_for(record, args, i, &field) && field < 64) given[field] = true;
    }
    Usize extra = 0;
    for (Usize k = 0; k < countof(record.fields) && k < 64; k++) {
        if (!given[k] && fills(record.fields[k].default_value)) extra += 1;
    }
    ArgumentList filled = {};
    filled = mem::realloc(filled, countof(args) + extra);
    for (Usize i = 0; i < countof(args); i++)
        filled[i] = args[i];
    Usize at = countof(args);
    for (Usize k = 0; k < countof(record.fields) && k < 64; k++) {
        if (!given[k] && fills(record.fields[k].default_value)) {
            filled[at] = ast::named_arg(record.fields[k].name, record.fields[k].default_value);
            at += 1;
        }
    }
    return filled;
}

// The module path an import's name stands for: `box` after `import geometry.box` is `geometry.box`. A path that does
// not start with such a name is returned as it is.
static ast::Path through_import(state::Emitter *e, ast::Path path, ast::Identifier parts[8]) {
    if (e->options.checked == nullptr || countof(path.segments) == 0) return path;
    const types::Symbol *module = types::lookup(&e->options.checked->scopes, path.segments[0].text);
    if (module == nullptr || module->kind != .module_name || module->decl->kind != .import_module) return path;
    ast::Path imported = module->decl->kind.import_module.path;
    if (countof(imported.segments) + countof(path.segments) > 9) return path;
    Usize count = 0;
    for (Usize i = 0; i < countof(imported.segments); i++) {
        parts[count] = imported.segments[i];
        count += 1;
    }
    for (Usize i = 1; i < countof(path.segments); i++) {
        parts[count] = path.segments[i];
        count += 1;
    }
    ast::Path expanded = {.segments = parts[0:count], .span = path.span};
    return expanded;
}

// `random.UniformInt64(low = 0, high = 9)`: a record of an imported module, declared when first needed.
static Bool imported_record_at(state::Emitter *e, ast::Path path, Usize *at) {
    if (e->options.checked == nullptr || countof(path.segments) != 2) return false;
    ast::TypeExpr *written = ast::make_type({.named = {.path = path}});
    written->span = path.span;
    state::TyResult ty = state::type_of(e, written);
    if (ty == .error) {
        state::free_text(ty.error.message);
        return false;
    }
    return find_record(e, ty.ok.name, at);
}

// `words.Pair(key = w)`: a record of another module, named through the module.
static Bool member_record(state::Emitter *e, const ast::Expr *callee, Usize *at) {
    if (callee->kind != .member || callee->kind.member.arrow || callee->kind.member.base->kind != .name) return false;
    ast::Path base = callee->kind.member.base->kind.name.path;
    ast::Identifier parts[8];
    ast::Identifier expanded[8];
    base = through_import(e, base, expanded);
    Usize count = countof(base.segments);
    if (count >= 8) return false;
    for (Usize i = 0; i < count; i++)
        parts[i] = base.segments[i];
    parts[count] = (ast::Identifier){.text = callee->kind.member.name, .span = callee->span};
    ast::Path path = {.segments = parts[0:count + 1], .span = callee->span};
    if (c_record(e, path, at)) return true;
    return count == 1 && imported_record_at(e, path, at);
}

// The record a construction's callee names: one of the module's, a C one or one of another module (`words.Pair`,
// or `Pair` after `from words import Pair`).
static Bool callee_record(state::Emitter *e, const ast::Expr *callee, Usize *at) {
    if (callee->kind == .name) {
        ast::Path path = callee->kind.name.path;
        if (countof(path.segments) == 1 && find_record(e, path.segments[0].text, at)) return true;
        if (c_record(e, path, at) || imported_record_at(e, path, at) || instance_record(e, path, at)) return true;
        ast::Identifier expanded[8];
        return countof(path.segments) > 1 && c_record(e, through_import(e, path, expanded), at);
    }
    return member_record(e, callee, at);
}

// The record whose type is `ty`.
static Bool record_of_type(state::Emitter *e, state::Ty ty, Usize *at) {
    for (Usize i = 0; i < e->record_count; i++) {
        if (e->records[i].ty.llvm == ty.llvm && state::same_type(e->records[i].ty, ty)) {
            *at = i;
            return true;
        }
    }
    return false;
}

// A construction by the bare name of the record the value is expected to be: `Span()`, the default of a field
// `span: Span = Span()` of a record of another module, read where the construction leaves the field out, where `Span`
// is not a name (#3036).
static Bool expected_record(state::Emitter *e, const ast::Expr *callee, state::Hint hint, Usize *at) {
    if (callee->kind != .name || countof(callee->kind.name.path.segments) != 1) return false;
    if (!hint.present || hint.ty.kind != .record || !record_of_type(e, hint.ty, at)) return false;
    Str want = callee->kind.name.path.segments[0].text;
    Str name = e->records[*at].name;
    if (countof(name) < countof(want)) return false;
    Usize start = countof(name) - countof(want);
    if (start > 0 && name[start - 1] != ':' && name[start - 1] != '.') return false;
    return state::same_text(name[start:countof(name)], want);
}

// A construction of the `struct:` a type function made (`IntPair(1, 2)`, `Pair(i32)(first = 1, second = 2)`): the
// checker typed the call as that record, which is built from its fields the first time it is needed.
static Bool made_record(state::Emitter *e, const ast::Expr *x, Usize *at) {
    if (e->options.checked == nullptr || x->kind != .call) return false;
    const ast::Expr *callee = x->kind.call.callee;
    ast::Path path = {};
    if (callee->kind != .call) { // not `Pair(i32)(1, 2)`: the callee names the type, where a function may be named
        if (!types::names_a_constant(callee, &path)) return false;
        const types::Symbol *named = types::type_through_modules(e->options.checked, path);
        if (named == nullptr || named->kind != .type_name) return false;
    }
    types::TypeRef typed = types::type_of(e->options.checked, x);
    if (typed == nullptr || typed->kind != .record || !types::is_made(e->options.checked, typed)) return false;
    state::TyResult made = state::type_of_checked(e, typed, x->span);
    if (made == .error) {
        state::free_text(made.error.message);
        return false;
    }
    return record_of_type(e, made.ok, at);
}

// The field values are on the value stack, the first deepest: start from zero and insert each.
static state::Status construct_finish(state::Emitter *e, const state::ThenGeneral *w) {
    const ast::Expr *x = w->expr;
    if (x->kind != .call) {
        return state::fail("not a call", w->span);
    }
    ast::ExprRef written[:] = x->kind.call.args;
    const ast::Expr *callee = x->kind.call.callee;
    Usize count = (Usize)w->number;
    state::Value values[64];
    for (Usize i = count; i > 0; i--)
        values[i - 1] = state::pop_value(e);
    Usize at = 0;
    if (!callee_record(e, callee, &at) && !record_of_type(e, w->ty, &at)) return state::fail("unknown record", w->span);
    state::RecordType record = e->records[at];
    ast::ExprRef args[:] = filled_fields(record, written);
    c::LLVMValueRef built = c::LLVMConstNull(record.ty.llvm);
    for (Usize i = 0; i < count; i++) {
        Usize field = 0;
        if (!field_for(record, args, i, &field))
            return state::failf(args[i]->span, "no field ", given_name(args[i]), " in ", record.name);
        if (!state::same_type(values[i].ty, record.fields[field].ty)) {
            // The conversions a declaration makes (`u32` to a `usize` field) are made for a field too.
            state::Status converted = state::convert(e, values[i], record.fields[field].ty, args[i]->span, .initialize);
            if (converted == .error) {
                state::free_text(converted.error.message);
                return state::failf(args[i]->span, "field ", record.fields[field].name, " of ", record.name, " is ",
                                    record.fields[field].ty.name, ", the value is ", values[i].ty.name);
            }
            values[i] = state::pop_value(e);
        }
        built = c::LLVMBuildInsertValue(e->builder, built, values[i].llvm, (U32)field, "");
    }
    state::push_value(e, (state::Value){.llvm = built, .ty = record.ty});
    return state::success();
}

// `Point(1, y = 2)`: a record of the module built by a call: positional fields in order, then named ones.
static state::Status construct(state::Emitter *e, const ast::Expr *x, Usize at) {
    if (x->kind != .call) {
        return state::fail("not a call", x->span);
    }
    state::RecordType record = e->records[at];
    ast::ExprRef args[:] = filled_fields(record, x->kind.call.args);
    Usize count = countof(args);
    if (count > 64) return state::not_emitted("more than 64 fields in one construction", x->span);
    Bool seen[64];
    for (Usize i = 0; i < 64; i++)
        seen[i] = false;
    Bool by_name = false;
    for (Usize i = 0; i < count; i++) {
        if (is_named(args[i]))
            by_name = true;
        else if (by_name)
            return state::fail("a positional argument cannot follow a named one", args[i]->span);
        Usize field = 0;
        if (!field_for(record, args, i, &field))
            return state::failf(args[i]->span, "no field ", given_name(args[i]), " in ", record.name);
        if (seen[field])
            return state::failf(args[i]->span, "field ", record.fields[field].name, " of ", record.name,
                                " is given twice");
        seen[field] = true;
    }
    {
        state::ThenGeneral general = state::then_general(construct_finish, x->span);
        general.expr = x;
        general.ty = record.ty;
        general.number = count;
        state::push_then_general(e, general);
    }
    for (Usize i = count; i > 0; i--) {
        Usize field = 0;
        field_for(record, args, i - 1, &field);
        state::push_eval(e, value_of(args[i - 1]), state::hint_of(record.fields[field].ty));
    }
    return state::success();
}

// The value of an argument that has no parameter: an integer narrower than `int` widened to `int`, a `float` to
// `double` (C's default argument promotions).
static c::LLVMValueRef promoted(state::Emitter *e, state::Value value) {
    state::Ty ty = value.ty;
    c::LLVMTypeRef word = c::LLVMInt32TypeInContext(e->context);
    if (ty.kind == .boolean) return c::LLVMBuildZExt(e->builder, value.llvm, word, "promote");
    if (ty.kind == .integer && state::width(ty) < 32) {
        if (state::is_signed(ty)) return c::LLVMBuildSExt(e->builder, value.llvm, word, "promote");
        return c::LLVMBuildZExt(e->builder, value.llvm, word, "promote");
    }
    if (ty.kind == .floating && state::width(ty) < 64)
        return c::LLVMBuildFPExt(e->builder, value.llvm, c::LLVMDoubleTypeInContext(e->context), "promote");
    return value.llvm;
}

// What the call passes for an argument of the parameter type `param`: an array goes through a temporary, as a pointer.
static c::LLVMValueRef passed(state::Emitter *e, state::Value value, state::Ty param) {
    if (param.kind != .array) return value.llvm;
    c::LLVMValueRef temporary = state::new_alloca(e, param, "argument");
    c::LLVMBuildStore(e->builder, value.llvm, temporary);
    return temporary;
}

// `setjmp` and its kin return twice; LLVM must know at the call (as clang, which tells them by name), or it keeps a
// value in a register across the second return.
static void mark_returns_twice(c::LLVMValueRef function, c::LLVMValueRef call) {
    Usize length = 0;
    const char *text = c::LLVMGetValueName2(function, &length);
    if (text == nullptr) return;
    Str name = text[0:length];
    if (!(state::same_text(name, "setjmp") || state::same_text(name, "_setjmp") ||
          state::same_text(name, "sigsetjmp") || state::same_text(name, "__sigsetjmp") ||
          state::same_text(name, "savectx") || state::same_text(name, "vfork") || state::same_text(name, "getcontext")))
        return;
    U32 kind = c::LLVMGetEnumAttributeKindForName("returns_twice", 13);
    c::LLVMContextRef context = c::LLVMGetTypeContext(c::LLVMTypeOf(function));
    c::LLVMAttributeRef attribute = c::LLVMCreateEnumAttribute(context, kind, 0);
    c::LLVMAddCallSiteAttribute(call, 0xFFFFFFFF, attribute);
    c::LLVMAddAttributeAtIndex(function, 0xFFFFFFFF, attribute);
}

// The arguments' values are on the value stack, the first deepest: check them and call.
static state::Status call_finish(state::Emitter *e, const state::ThenGeneral *w) {
    const ast::Expr *written = w->expr;
    if (written->kind != .call) {
        return state::fail("not a call", w->span);
    }
    const ast::Expr *x = method_form(e, written);
    if (x->kind != .call) {
        return state::fail("not a call", w->span);
    }
    ast::ExprRef written_args[:] = x->kind.call.args;
    const ast::Expr *callee = x->kind.call.callee;
    const ast::Decl *imported = nullptr;
    Str key = "";
    Bool is_imported = false;
    const types::Instance *instance = callee_of(e, written, written_args, &written_args, &imported, &key, &is_imported);
    if (!is_imported && instance == nullptr && callee->kind != .name) {
        return state::fail("not a name", w->span);
    }
    Usize count = (Usize)w->number;
    state::Value values[64];
    for (Usize i = count; i > 0; i--)
        values[i - 1] = state::pop_value(e);
    if (!is_imported && instance == nullptr && callee->kind == .name) key = join(callee->kind.name.path);
    ast::ExprRef args[:] = filled_arguments(e, key, written_args, imported);
    SignatureResult found = find(e, key, callee->span, imported);
    if (found == .error) {
        state::free_text(key);
        return {.error = found.error};
    }
    Signature sig = found.ok;
    Usize slot[64];
    state::Status slotted = assign_slots(e, key, args, slot, imported);
    if (slotted == .error) {
        state::free_text(key);
        release(sig);
        return slotted;
    }
    c::LLVMValueRef argv[64];
    for (Usize i = 0; i < count; i++) {
        if (i >= countof(sig.params)) { // a variadic argument: C's default argument promotions
            argv[i] = promoted(e, values[i]);
            continue;
        }
        if (!state::same_type(values[i].ty, sig.params[slot[i]])) {
            // A value the parameter takes (an integer widened, a payload wrapped in its option) is converted.
            state::Status converted = state::convert(e, values[i], sig.params[slot[i]], args[i]->span, .initialize);
            if (converted == .ok) {
                values[i] = state::pop_value(e);
                argv[slot[i]] = passed(e, values[i], sig.params[slot[i]]);
                continue;
            }
            state::free_text(converted.error.message);
            state::Status wrong = state::failf(args[i]->span, "argument ", (U64)i + 1, " of ", key, " is ",
                                               values[i].ty.name, ", the parameter is ", sig.params[slot[i]].name);
            state::free_text(key);
            release(sig);
            return wrong;
        }
        argv[slot[i]] = passed(e, values[i], sig.params[slot[i]]);
    }
    c::LLVMValueRef made = nullptr;
    if (is_void(sig.result))
        made = c::LLVMBuildCall2(e->builder, sig.type, sig.function, argv, (U32)count, "");
    else
        made = c::LLVMBuildCall2(e->builder, sig.type, sig.function, argv, (U32)count, "call");
    mark_returns_twice(sig.function, made);
    state::push_value(e, (state::Value){.llvm = made, .ty = sig.result});
    state::free_text(key);
    release(sig);
    return state::success();
}

// A lambda written as an argument is made by `emit_lambda::argument` (it may capture by reference); any other argument
// is evaluated.
static state::Status lambda_argument(state::Emitter *e, const state::ThenGeneral *w) {
    return lambdas::argument(e, w->expr, w->hint);
}

static void push_argument(state::Emitter *e, const ast::Expr *arg, state::Hint hint) {
    const ast::Expr *value = value_of(arg);
    if (value->kind == .lambda) {
        state::ThenGeneral item = state::then_general(lambda_argument, value->span);
        item.expr = value;
        item.hint = hint;
        state::push_then_general(e, item);
    } else
        state::push_eval(e, value, hint);
}

// A struct and a function of one name (`sigaction`): positional arguments call the function.
static Bool function_twin(state::Emitter *e, const ast::Expr *callee, ast::ExprRef args[:]) {
    if (e->options.checked == nullptr || (countof(args) > 0 && is_named(args[0]))) return false;
    const ast::Decl *twin = nullptr;
    Str twin_symbol = "";
    return c_callee(e, callee, &twin, &twin_symbol);
}

static state::Status unsupported_callee(const ast::Expr *x, const ast::Expr *callee) {
    return state::failf(x->span, "not emitted yet: a call whose callee is of kind `", state::expr_kind_name(callee),
                        "`");
}

// `Expr.call`.
// `parse_expr.expression` read as a value, not called (#3036): a function of an imported module (or of a C header) is
// its address, which a `fn` value or a function pointer takes, as a function of this module's own name is. False when
// `x` names no such function.
export Bool module_function_value(state::Emitter *e, const ast::Expr *x, state::Status *status) {
    if (x->kind != .member) return false;
    const ast::Expr *base = x->kind.member.base;
    if (base->kind != .name || countof(base->kind.name.path.segments) != 1) return false;
    state::Local local = {};
    if (state::find_local(e, base->kind.name.path.segments[0].text, &local)) return false;
    const ast::Decl *imported = nullptr;
    Str key = "";
    if (!imported_callee(e, x, &imported, &key) || imported == nullptr || imported->kind != .function) return false;
    SignatureResult made = find(e, key, x->span, imported);
    if (made == .error) {
        *status = (state::Status){.error = made.error};
        return true;
    }
    state::Ty pointer = {.kind = {.pointer = {}}, .llvm = state::pointer_type(e, 0), .name = "pointer"};
    state::push_value(e, (state::Value){.llvm = made.ok.function, .ty = pointer});
    *status = state::success();
    return true;
}

// Whether the callee is the bare name of a global variable that holds a function (`chosen(bits)` with
// `mut chosen: fn(u64) -> u64 = twice`).
static Bool is_global_function_value(state::Emitter *e, const ast::Expr *callee) {
    if (callee->kind != .name || !emit_memory::is_global_name(e, callee)) return false;
    state::TyResult held = state::type_of_node(e, callee);
    return held != .error && (held.ok.kind == .fn_value || held.ok.kind == .fn_pointer);
}

static state::Status call_global_function_value(state::Emitter *e, const ast::Expr *x, const ast::Expr *callee) {
    state::TyResult held = state::type_of_node(e, callee);
    if (held == .error) return {.error = held.error};
    return lambdas::call_value(e, x, held.ok);
}

// A local of type `fn` or a C function pointer named as the callee.
static Bool local_function_value(state::Emitter *e, const ast::Expr *callee, state::Ty *held) {
    if (callee->kind != .name || countof(callee->kind.name.path.segments) != 1) return false;
    state::Local local = {};
    if (!state::find_local(e, callee->kind.name.path.segments[0].text, &local)) return false;
    state::Ty seen = local.ty;
    if (seen.kind == .option && seen.kind.option.element != nullptr && e->options.checked != nullptr) {
        // A `?fn` the checker narrowed to the `fn` (`if length != .none:`, item 27): the call is through the payload.
        types::TypeRef narrowed = types::type_of(e->options.checked, callee);
        if (narrowed != nullptr && narrowed->kind != .option) seen = *seen.kind.option.element;
    }
    if (seen.kind != .fn_value && seen.kind != .fn_pointer) return false;
    *held = seen;
    return true;
}

// No function has the callee's key: a global variable that holds a function is called as a value, else the error.
static state::Status unknown_callee(state::Emitter *e, const ast::Expr *x, const ast::Expr *callee, Str key,
                                    SignatureResult found) {
    state::free_text(key);
    if (is_global_function_value(e, callee)) return call_global_function_value(e, x, callee);
    if (found == .error) return {.error = found.error};
    return state::success();
}

export state::Status call(state::Emitter *e, const ast::Expr *written, state::Hint hint) {
    if (written->kind != .call) {
        return state::fail("not a call", written->span);
    }
    const ast::Expr *x = method_form(e, written);
    if (x->kind != .call) {
        return state::fail("not a call", written->span);
    }
    const ast::Expr *callee = x->kind.call.callee;
    ast::ExprRef written_args[:] = x->kind.call.args;
    const ast::Decl *imported = nullptr;
    Str key = "";
    Bool is_imported = false;
    Usize record = 0;
    if (callee_record(e, callee, &record) && !function_twin(e, callee, written_args)) return construct(e, x, record);
    if (expected_record(e, callee, hint, &record) || made_record(e, x, &record)) return construct(e, x, record);
    if (builtin::is_filled(e, x)) return builtin::filled(e, x);      // `array.filled` (#2339)
    if (builtin::is_alloc(e, x)) return builtin::shaped_alloc(e, x); // `mem.alloc(T, [a, b])` (#2527)
    if (builtin::is_call(x)) return builtin::call(e, x);             // a clang builtin (#2286)
    state::Ty held_local = {};
    if (local_function_value(e, callee, &held_local)) return lambdas::call_value(e, x, held_local);
    if (callee->kind == .name && streams::is_call(x)) return streams::call(e, x);
    const types::Instance *instance = callee_of(e, written, written_args, &written_args, &imported, &key, &is_imported);
    if (!is_imported && instance == nullptr && callee->kind != .name) {
        // A call through a field holding a function, an element of an array of them (`table[i](4)`), or through a
        // conversion `(address.to(Run))()` (#3110).
        if (callee->kind != .member && callee->kind != .cast && callee->kind != .index)
            return unsupported_callee(x, callee);
        state::TyResult held = state::type_of_node(e, callee);
        if (held == .error) return {.error = held.error};
        if (held.ok.kind != .fn_value && held.ok.kind != .fn_pointer)
            return state::failf(x->span, "not emitted yet: a call through a value that is not a function");
        return lambdas::call_value(e, x, held.ok);
    }
    if (!is_imported && instance == nullptr && callee->kind == .name) key = join(callee->kind.name.path);
    SignatureResult found = find(e, key, callee->span, imported);
    if (found == .error) return unknown_callee(e, x, callee, key, found);
    Signature sig = found.ok;
    ast::ExprRef args[:] = filled_arguments(e, key, written_args, imported);
    Usize count = countof(args);
    if (count != countof(sig.params) && !(sig.variadic && count > countof(sig.params))) {
        state::Status wrong =
            state::failf(x->span, key, " takes ", (U64)countof(sig.params), " arguments, the call has ", (U64)count);
        state::free_text(key);
        release(sig);
        return wrong;
    }
    Usize slot[64];
    state::Status slotted = assign_slots(e, key, args, slot, imported);
    if (slotted == .error) {
        state::free_text(key);
        release(sig);
        return slotted;
    }
    {
        state::ThenGeneral general = state::then_general(call_finish, x->span);
        general.expr = written;
        general.number = count;
        state::push_then_general(e, general);
    }
    // The first argument runs first: it is pushed last.
    for (Usize i = count; i > 0; i--) {
        Bool extra = i - 1 >= countof(sig.params); // a variadic argument has no parameter to give it a type
        push_argument(e, args[i - 1], extra ? state::no_hint() : state::hint_of(sig.params[slot[i - 1]]));
    }
    state::free_text(key);
    release(sig);
    return state::success();
}

// A call whose result is the function's value is a guaranteed tail call (#2709): LLVM `musttail`, so tail recursion is
// a loop at every optimization level, `-O0` included. The call is marked only where LLVM's rules hold: it is the last
// instruction of the block, so nothing runs after it (`value` is its result, returned unchanged), and the caller and
// the callee have the same function type and calling convention. Anywhere else the call stays ordinary.
export void mark_tail_call(state::Emitter *e, c::LLVMValueRef value) {
    if (value == nullptr || c::LLVMIsACallInst(value) == nullptr) return;
    c::LLVMBasicBlockRef here = c::LLVMGetInsertBlock(e->builder);
    if (c::LLVMGetLastInstruction(here) != value) return;
    c::LLVMValueRef caller = c::LLVMGetBasicBlockParent(here);
    if (c::LLVMGetCalledFunctionType(value) != c::LLVMGlobalGetValueType(caller)) return;
    if (c::LLVMGetInstructionCallConv(value) != c::LLVMGetFunctionCallConv(caller)) return;
    // A struct or array result comes back through a hidden pointer on most targets: LLVM cannot make that call a
    // `musttail` (`return fixed(memory, capacity)` of `std.arena.carve` aborted the compiler).
    c::LLVMTypeKind result = c::LLVMGetTypeKind(c::LLVMGetReturnType(c::LLVMGetCalledFunctionType(value)));
    if (result == c::LLVMStructTypeKind || result == c::LLVMArrayTypeKind) return;
    if (c::LLVMIsAFunction(c::LLVMGetCalledValue(value)) != nullptr &&
        c::LLVMGetIntrinsicID(c::LLVMGetCalledValue(value)) != 0)
        return;
    c::LLVMSetTailCallKind(value, c::LLVMTailCallKindMustTail);
}

// `return;` in a function with no result.
export state::Status return_void(state::Emitter *e, const ast::Stmt *s) {
    if (!is_void(e->result))
        return state::failf(s->span, "returning no value from a function that returns ", e->result.name);
    try control::before_return(e, s->span);
    c::LLVMBuildRetVoid(e->builder);
    return state::success();
}

// A `Decl.function` with no body, declared in the first pass: an external declaration in the LLVM module. (It is not
// added to `e->functions`, see the top of this file.)
export state::Status prototype(state::Emitter *e, const ast::Decl *d) {
    if (d->kind != .function) {
        return state::fail("not a function", d->span);
    }
    Str name = d->kind.function.name;
    ast::Span span = d->span;
    for (Usize i = 0; i < countof(e->tree->decls); i++) {
        const ast::Decl *other = e->tree->decls[i];
        if (other != d && other->kind == .function && state::same_text(other->kind.function.name, name))
            return state::failf(span, name, " is declared twice");
    }
    SignatureResult made = signature(e, d);
    if (made == .error) return {.error = made.error};
    Signature sig = made.ok;
    Str symbol = prototype_symbol(e, d, name);
    char *label = state::cstr(symbol);
    state::free_text(symbol);
    if (c::LLVMGetNamedFunction(e->module, label) != nullptr) {
        mem::free(label);
        release(sig);
        return state::failf(span, name, " is declared twice");
    }
    c::LLVMAddFunction(e->module, label, sig.type);
    mem::free(label);
    release(sig);
    return state::success();
}

// ----------------------------------------
// The recursion check of the new front end (#2709). A cycle of the module's call graph is allowed
// when every call on it is a tail call, which the emitter marks `musttail` (front::emit_call::mark_tail_call: a call
// whose result is the function's value, with nothing to run after it); any other call on a cycle is lowered by
// front::emit_recursion (#2710): it runs on a stack segment from the runtime when the stack in use is nearly full.
//
//   check   Reads the module's IR: the calls between the functions it defines (a call through a pointer, and a call
//           into code with no source, are not followed), the strongly connected components of that graph (Tarjan's
//           algorithm with a stack of its own: nothing here is recursive), and reports the first call that is not a
//           tail call and joins two functions of one component, with the way round: `a -> b -> a`.

// The calls of function `from` are `to[first[from]]` to `to[first[from + 1] - 1]`; `tail[k]` is whether call `k` is a
// guaranteed tail call.
struct CallNode {
    c::LLVMValueRef value;
};

struct CallGraph {
    CallNode functions[:];
    Usize slots[:]; // a table of function indexes plus one, keyed by the function's address (0 is empty)
    Usize first[:];
    Usize callees[:]; // the function each edge reaches (`to` is the built-in conversion `x.to(T)`, #2526)
    Bool tail[:];
    CallNode sites[:]; // the call instruction of each call
    Bool addressed[:]; // whether the function's address is used other than to call it: a call through a function
                       // value may reach it (a possible edge, #2710)
};

static Usize rec_slot_of(c::LLVMValueRef function, Usize size) {
    Usize address = (Usize)function;
    address = (address >> 4) * 0x9E3779B97F4A7C15ull;
    return (address >> 20) & (size - 1);
}

static void rec_remember(CallGraph *g, Usize index) {
    Usize size = countof(g->slots);
    Usize at = rec_slot_of(g->functions[index].value, size);
    while (g->slots[at] != 0) {
        at = (at + 1) & (size - 1);
    }
    g->slots[at] = index + 1;
}

// The index of a function this module defines, or `~0`.
static Usize rec_index_of(const CallGraph *g, c::LLVMValueRef function) {
    Usize size = countof(g->slots);
    Usize at = rec_slot_of(function, size);
    while (g->slots[at] != 0) {
        if (g->functions[g->slots[at] - 1].value == function) {
            return g->slots[at] - 1;
        }
        at = (at + 1) & (size - 1);
    }
    return ~(Usize)0;
}

// The defined function a call instruction calls, as an index, or `~0`.
static Usize rec_callee_of(const CallGraph *g, c::LLVMValueRef instruction) {
    if (c::LLVMIsACallInst(instruction) == nullptr) {
        return ~(Usize)0;
    }
    c::LLVMValueRef called = c::LLVMGetCalledValue(instruction);
    if (called == nullptr || c::LLVMIsAFunction(called) == nullptr) {
        return ~(Usize)0;
    }
    return rec_index_of(g, called);
}

// Whether the function's address is used other than as the callee of a call: stored, passed, or in an initializer.
static Bool rec_address_taken(c::LLVMValueRef function) {
    for (c::LLVMUseRef use = c::LLVMGetFirstUse(function); use != nullptr; use = c::LLVMGetNextUse(use)) {
        c::LLVMValueRef user = c::LLVMGetUser(use);
        if (c::LLVMIsACallInst(user) != nullptr && c::LLVMGetCalledValue(user) == function) continue;
        return true;
    }
    return false;
}

// Visits every call of the module's defined functions: with `fill` false it counts them, with `fill` true it writes
// them into `to` and `tail`.
static void rec_walk_calls(CallGraph *g, Bool fill) {
    Usize next = 0;
    for (Usize i = 0; i < countof(g->functions); i++) {
        if (fill) g->first[i] = next;
        for (c::LLVMBasicBlockRef b = c::LLVMGetFirstBasicBlock(g->functions[i].value); b != nullptr;
             b = c::LLVMGetNextBasicBlock(b)) {
            for (c::LLVMValueRef x = c::LLVMGetFirstInstruction(b); x != nullptr; x = c::LLVMGetNextInstruction(x)) {
                if (c::LLVMIsACallInst(x) == nullptr) continue;
                Bool musttail = c::LLVMGetTailCallKind(x) == c::LLVMTailCallKindMustTail;
                Usize callee = rec_callee_of(g, x);
                if (callee != ~(Usize)0) {
                    if (fill) {
                        g->callees[next] = callee;
                        g->tail[next] = musttail;
                        g->sites[next].value = x;
                    }
                    next += 1;
                    continue;
                }
                // A call through a function value: a possible call of every function whose address is taken and
                // whose type is the call's. Inline assembly and an intrinsic are no edge.
                c::LLVMValueRef called = c::LLVMGetCalledValue(x);
                if (called == nullptr || c::LLVMIsAFunction(called) != nullptr ||
                    c::LLVMIsAInlineAsm(called) != nullptr)
                    continue;
                c::LLVMTypeRef wanted = c::LLVMGetCalledFunctionType(x);
                for (Usize target = 0; target < countof(g->functions); target++) {
                    if (!g->addressed[target] || c::LLVMGlobalGetValueType(g->functions[target].value) != wanted)
                        continue;
                    if (fill) {
                        g->callees[next] = target;
                        g->tail[next] = musttail;
                        g->sites[next].value = x;
                    }
                    next += 1;
                }
            }
        }
    }
    if (fill) g->first[countof(g->functions)] = next;
    if (!fill) {
        Usize functions = countof(g->functions) + 1;
        g->first = mem::alloc_slice(Usize, functions);
        g->callees = mem::alloc_slice(Usize, next);
        g->tail = mem::alloc_slice(Bool, next);
        g->sites = mem::alloc_slice(CallNode, next);
    }
}

// Tarjan's algorithm with a stack of its own: `component[i]` for each function.
static void rec_components(const CallGraph *g, Usize component[:]) {
    Usize n = countof(g->functions);
    Usize order[:] = mem::alloc_slice(Usize, n); // 1 + the visit number, 0 when not visited
    Usize low[:] = mem::alloc_slice(Usize, n);
    Usize pending[:] = mem::alloc_slice(Usize, n); // the nodes of rec_components not closed yet
    Usize frame_node[:] = mem::alloc_slice(Usize, n);
    Usize frame_edge[:] = mem::alloc_slice(Usize, n);
    Bool open[:] = mem::alloc_slice(Bool, n);
    Usize visits = 0;
    Usize kept = 0;
    Usize components_made = 0;
    for (Usize root = 0; root < n; root++) {
        if (order[root] != 0) {
            continue;
        }
        Usize depth = 0;
        frame_node[0] = root;
        frame_edge[0] = g->first[root];
        order[root] = low[root] = ++visits;
        pending[kept++] = root;
        open[root] = true;
        depth = 1;
        while (depth > 0) {
            Usize u = frame_node[depth - 1];
            if (frame_edge[depth - 1] < g->first[u + 1]) {
                Usize v = g->callees[frame_edge[depth - 1]++];
                if (order[v] == 0) {
                    order[v] = low[v] = ++visits;
                    pending[kept++] = v;
                    open[v] = true;
                    frame_node[depth] = v;
                    frame_edge[depth] = g->first[v];
                    depth += 1;
                } else if (open[v] && order[v] < low[u]) {
                    low[u] = order[v];
                }
                continue;
            }
            if (low[u] == order[u]) {
                Usize member = ~(Usize)0;
                while (member != u) {
                    member = pending[--kept];
                    open[member] = false;
                    component[member] = components_made;
                }
                components_made += 1;
            }
            depth -= 1;
            if (depth > 0 && low[u] < low[frame_node[depth - 1]]) low[frame_node[depth - 1]] = low[u];
        }
    }
    mem::free(order.data);
    mem::free(low.data);
    mem::free(pending.data);
    mem::free(frame_node.data);
    mem::free(frame_edge.data);
    mem::free(open.data);
}

static const char *rec_name_of(const CallGraph *g, Usize index) {
    return c::LLVMGetValueName(g->functions[index].value);
}

// The cycle a call closes: `caller -> callee -> ... -> caller`, the way from `callee` back to `caller` found breadth
// first over the calls of the module.
static Str rec_way_round(const CallGraph *g, Usize caller, Usize callee) {
    Usize n = countof(g->functions);
    Usize parent[:] = mem::alloc_slice(Usize, n);
    Usize queue[:] = mem::alloc_slice(Usize, n);
    Bool seen[:] = mem::alloc_slice(Bool, n);
    Usize head = 0;
    Usize last = 0;
    queue[last++] = callee;
    seen[callee] = true;
    while (head < last && !seen[caller]) {
        Usize u = queue[head++];
        for (Usize k = g->first[u]; k < g->first[u + 1]; k++) {
            Usize v = g->callees[k];
            if (seen[v]) {
                continue;
            }
            seen[v] = true;
            parent[v] = u;
            queue[last++] = v;
        }
    }
    Str way = state::msg(format::push(rec_name_of(g, caller)));
    Usize at = caller;
    while (at != callee) {
        at = parent[at];
        way = state::msg(format::push(rec_name_of(g, at), " -> ", way));
    }
    way = state::msg(format::push(rec_name_of(g, caller), " -> ", way));
    mem::free(parent.data);
    mem::free(queue.data);
    mem::free(seen.data);
    return way;
}

// Whether the function has a way out that is not a tail call: a `ret` that does not return a `musttail` call, or an
// `unreachable` (the program ends there).
static Bool rec_has_exit(c::LLVMValueRef function) {
    for (c::LLVMBasicBlockRef b = c::LLVMGetFirstBasicBlock(function); b != nullptr; b = c::LLVMGetNextBasicBlock(b)) {
        c::LLVMValueRef last = c::LLVMGetLastInstruction(b);
        if (last == nullptr) {
            continue;
        }
        c::LLVMOpcode opcode = c::LLVMGetInstructionOpcode(last);
        if (opcode == c::LLVMUnreachable) {
            return true;
        }
        if (opcode != c::LLVMRet) {
            continue;
        }
        c::LLVMValueRef before = c::LLVMGetPreviousInstruction(last);
        if (before == nullptr || c::LLVMIsACallInst(before) == nullptr ||
            c::LLVMGetTailCallKind(before) != c::LLVMTailCallKindMustTail) {
            return true;
        }
    }
    return false;
}

// `main` of a module, whatever its prefix: it may run forever.
static Bool rec_is_main(c::LLVMValueRef function) {
    Usize length = 0;
    const char *name = c::LLVMGetValueName2(function, &length);
    if (length < 4) {
        return false;
    }
    const char *tail = name + length - 4;
    return tail[0] == 'm' && tail[1] == 'a' && tail[2] == 'i' && tail[3] == 'n' &&
           (length == 4 || (length > 5 && name[length - 5] == ':'));
}

// A cycle of tail calls with no exit never ends: outside `main` it is an error (owner, 2026-11-07: "We don't want to
// allow infinite recursion"). The cycle has an exit when one of its functions has a way out that is not a tail call.
static state::Status rec_check_exits(const CallGraph *g, const Usize component[:]) {
    Usize n = countof(g->functions);
    Bool exits[:] = mem::alloc_slice(Bool, n);
    Bool looped[:] = mem::alloc_slice(Bool, n);
    for (Usize u = 0; u < n; u++) {
        Usize id = component[u];
        if (rec_has_exit(g->functions[u].value) || rec_is_main(g->functions[u].value)) {
            exits[id] = true;
        }
        for (Usize k = g->first[u]; k < g->first[u + 1]; k++) {
            if (component[g->callees[k]] == id) {
                looped[id] = true;
            }
        }
    }
    state::Status result = state::success();
    for (Usize u = 0; u < n && result == .ok; u++) {
        if (!looped[component[u]] || exits[component[u]]) {
            continue;
        }
        for (Usize k = g->first[u]; k < g->first[u + 1]; k++) {
            if (component[g->callees[k]] != component[u]) {
                continue;
            }
            ast::Span nowhere = {};
            Str way = rec_way_round(g, u, g->callees[k]);
            result = state::failf(nowhere, "this recursion never ends: no path returns without the call: ", way);
            break;
        }
    }
    mem::free(exits.data);
    mem::free(looped.data);
    return result;
}

// The first call of a cycle that is not a tail call is an error; a cycle of tail calls only is fine.
export state::Status check_recursion(c::LLVMModuleRef module) {
    CallGraph g = {};
    Usize n = 0;
    for (c::LLVMValueRef f = c::LLVMGetFirstFunction(module); f != nullptr; f = c::LLVMGetNextFunction(f))
        if (c::LLVMCountBasicBlocks(f) > 0) n += 1;
    if (n == 0) {
        return state::success();
    }
    g.functions = mem::alloc_slice(CallNode, n);
    Usize size = 16;
    while (size < 2 * n) {
        size *= 2;
    }
    g.slots = mem::alloc_slice(Usize, size);
    Usize at = 0;
    for (c::LLVMValueRef f = c::LLVMGetFirstFunction(module); f != nullptr; f = c::LLVMGetNextFunction(f)) {
        if (c::LLVMCountBasicBlocks(f) == 0) {
            continue;
        }
        g.functions[at].value = f;
        rec_remember(&g, at);
        at += 1;
    }
    g.addressed = mem::alloc_slice(Bool, n);
    for (Usize i = 0; i < n; i++)
        g.addressed[i] = rec_address_taken(g.functions[i].value);
    rec_walk_calls(&g, false);
    rec_walk_calls(&g, true);
    Usize component[:] = mem::alloc_slice(Usize, n);
    rec_components(&g, component);
    state::Status result = rec_check_exits(&g, component);
    // Every other call that closes a cycle is lowered (front::emit_recursion): it runs on the stack in use while there
    // is room, and on a segment from the runtime when there is not.
    c::LLVMValueRef lowered = nullptr; // a call through a function value has an edge for each target: lowered once
    for (Usize u = 0; u < n && result == .ok; u++) {
        for (Usize k = g.first[u]; k < g.first[u + 1]; k++) {
            if (g.tail[k] || component[g.callees[k]] != component[u] || g.sites[k].value == lowered) {
                continue;
            }
            lowered = g.sites[k].value;
            recursion::wrap(module, lowered);
        }
    }
    mem::free(component.data);
    mem::free(g.functions.data);
    mem::free(g.slots.data);
    mem::free(g.first.data);
    mem::free(g.callees.data);
    mem::free(g.tail.data);
    mem::free(g.sites.data);
    mem::free(g.addressed.data);
    return result;
}
