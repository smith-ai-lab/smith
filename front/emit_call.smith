// front::emit_call: calls, `return;` and function prototypes for the emitter (B3a, #1112). The protocol is at the top
// of front/emit.smith.
//
// A call `f(a, b)` names a function of the module or a prototype in it. The callee's key is its path joined by `::`
// (`geometry::area`); it is found among the module's functions (`e->functions`, bodies) or among the module's
// prototypes (a `Decl.function` with no body, found in the tree). The arguments are evaluated left to right, each with
// the parameter's type as its hint; their number and types must be the parameters' exactly (no conversions yet).
// A prototype is NOT added to `e->functions`: pass 3 walks that table in step with the functions that have bodies, so a
// prototype in it would shift every body after it. It is declared in the LLVM module, and a call finds it again in the
// tree. A prototype's symbol is the module's path and its name, like any function (`front::test::cube`); a name
// written with `::` (`geometry::area`) is the symbol itself, which is how a prototype stands for a function of another
// module.
//
// Named arguments (`connect(host = x, retry = true)`) fill the parameter of that name, by position until the first
// named one (the checker's `argument_slot`); they are evaluated in the order written and passed in parameter order. A
// call of a name that is a record of the module builds a value of it, `Point(x = 1, y = 2)`: every field named, in any
// order, a field left out zero; the value starts as `LLVMConstNull` and each field is inserted in the order written.
//
// `Void` is a type of its own here (an LLVM `void`, kind `integer`, zero bits, named `Void`): a call of a function
// that returns it pushes one value of that type, so an expression statement drops it like any other.
module front::emit_call;

import front::ast;
import front::emit_control as control;
import front::emit_lambda as lambdas;
import front::emit_match as matching;
import front::emit_memory as memory;
import front::emit_state as state;
import front::emit_stream as streams;
import front::types;
import std::arena;
import std::format;
import std::mem;
import <llvm-c/Core.h>;

export struct Signature;

// A function as a call sees it. `params` is the callee's own when `owned` is false, else it is allocated.
export struct Signature {
    c::LLVMValueRef function;
    c::LLVMTypeRef type;
    state::Ty result;
    state::Ty params[:];
    Bool owned;
};

export typedef Result(Signature, state::Error) SignatureResult;

static Bool is_void(state::Ty ty) {
    return c::LLVMGetTypeKind(ty.llvm) == c::LLVMVoidTypeKind;
}

static void release(Signature sig) {
    if (sig.owned) mem::free(sig.params.data);
}

// The type a type expression says, with `Void` for the result of a function that returns nothing (the hook of
// front::emit's `type_of`, which cannot be imported from here).
static state::TyResult type_for(state::Emitter *e, const ast::TypeExpr *t) {
    return state::type_of(e, t);
}

// The path joined by `::`, in the allocator in force.
static Str join(ast::Path path) {
    Str key = state::msg(format::push(path.segments[0].text));
    for (Usize i = 1; i < countof(path.segments); i++) {
        Str longer = state::msg(format::push(key, "::", path.segments[i].text));
        state::free_text(key);
        key = longer;
    }
    return key;
}

// The LLVM name of a prototype: the module's path and the name, or the name itself when it holds a `::`.
static Str symbol_for(state::Emitter *e, Str name) {
    Str symbol = state::msg(format::push(name));
    for (Usize i = 0; i + 1 < countof(name); i++) {
        if (name[i] == ':' && name[i + 1] == ':') return symbol;
    }
    for (Usize i = countof(e->tree->name.segments); i > 0; i--) {
        Str longer = state::msg(format::push(e->tree->name.segments[i - 1].text, "::", symbol));
        state::free_text(symbol);
        symbol = longer;
    }
    return symbol;
}

static SignatureResult signature_failed(state::Status status) {
    if (status == .error) {
        return {.error = status.error};
    }
    state::Error none = {};
    return {.error = none};
}

// The types of a function declaration (its function type too), or why it is not emitted.
static SignatureResult signature(state::Emitter *e, const ast::Decl *d) {
    if (d->kind != .function) {
        return signature_failed(state::fail("not a function", d->span));
    }
    ast::Param source[:] = d->kind.function.params;
    const ast::TypeExpr *result_type = d->kind.function.result;
    Bool variadic = d->kind.function.variadic;
    if (variadic) return signature_failed(state::not_emitted("variadic function", d->span));
    if (d->is_extern) return signature_failed(state::not_emitted("extern C function", d->span));
    for (Usize i = 0; i < countof(d->attributes); i++) {
        ast::Path name = d->attributes[i].name;
        if (state::same_text(name.segments[countof(name.segments) - 1].text, "c_name"))
            return signature_failed(state::not_emitted("c_name", d->attributes[i].span));
    }
    if (result_type == nullptr) return signature_failed(state::not_emitted("function without a result", d->span));
    Usize count = countof(source);
    if (count > 64) return signature_failed(state::not_emitted("more than 64 parameters", d->span));
    for (Usize i = 0; i < count; i++) {
        if (source[i].is_constexpr || source[i].is_rest)
            return signature_failed(state::not_emitted("constexpr or rest parameter", source[i].span));
    }
    state::Ty all[:] = mem::alloc_slice(state::Ty, count + 1);
    c::LLVMTypeRef types[64];
    for (Usize i = 0; i < count; i++) {
        state::TyResult made = type_for(e, source[i].type);
        if (made == .error) {
            mem::free(all.data);
            return {.error = made.error};
        }
        if (is_void(made.ok)) {
            mem::free(all.data);
            return signature_failed(state::fail("a parameter cannot be Void", source[i].span));
        }
        all[i] = made.ok;
        types[i] = made.ok.llvm;
    }
    state::TyResult made_result = type_for(e, result_type);
    if (made_result == .error) {
        mem::free(all.data);
        return {.error = made_result.error};
    }
    Signature sig = {.result = made_result.ok, .params = all[0:count], .owned = true};
    sig.type = c::LLVMFunctionType(made_result.ok.llvm, types, (U32)count, 0);
    return sig;
}

// The prototype of a function of an imported module, declared when the first call needs it (#1714): an external
// function named by `key`, the symbol the module's own object defines.
static SignatureResult imported_function(state::Emitter *e, Str key, const ast::Decl *d) {
    SignatureResult made = signature(e, d);
    if (made == .error) return made;
    Signature sig = made.ok;
    char *label = state::cstr(key);
    sig.function = c::LLVMGetNamedFunction(e->module, label);
    if (sig.function == nullptr) sig.function = c::LLVMAddFunction(e->module, label, sig.type);
    mem::free(label);
    return sig;
}

// The function of an imported module a callee names: `m.sin`, `r.math.sin` (a module imported by another), or `sin`
// after `sin := m.sin`. The checker has declared each under its module's path (`lib::math::sin`), which is also the
// symbol the module's object defines. Returns false for any other callee.
static Bool imported_callee(state::Emitter *e, const ast::Expr *callee, const ast::Decl **found, Str *symbol) {
    if (e->options.checked == nullptr) return false;
    types::Names names = {};
    if (callee->kind == .member) {
        names = types::member_names(callee);
    } else if (callee->kind == .name && countof(callee->kind.name.path.segments) == 1) {
        for (Usize i = 0; i < countof(e->tree->decls); i++) {
            const ast::Decl *d = e->tree->decls[i];
            if (d->kind != .variable || !d->kind.variable.is_new || d->kind.variable.init == nullptr) continue;
            if (!state::same_text(d->kind.variable.name, callee->kind.name.path.segments[0].text)) continue;
            if (d->kind.variable.init->kind == .member) names = types::member_names(d->kind.variable.init);
        }
    }
    if (names.count < 2) return false;
    const types::Scopes *scopes = &e->options.checked->scopes;
    Str prefix = "";
    for (Usize i = 0; i + 1 < names.count; i++) {
        const types::Symbol *module = types::lookup(scopes, state::msg(format::push(prefix, names.items[i])));
        if (module == nullptr || module->kind != .module_name || module->decl->kind != .import_module) return false;
        prefix = state::msg(format::push(join(module->decl->kind.import_module.path), "::"));
    }
    Str full = state::msg(format::push(prefix, names.items[names.count - 1]));
    const types::Symbol *target = types::lookup(scopes, full);
    if (target == nullptr || target->kind != .function_symbol || target->decl->kind != .function) return false;
    *found = target->decl;
    *symbol = full;
    return true;
}

// The function a call names: one of the module's with a body, or a prototype of the module.
static SignatureResult find(state::Emitter *e, Str key, ast::Span span, const ast::Decl *imported) {
    if (imported != nullptr) return imported_function(e, key, imported);
    for (Usize i = 0; i < e->function_count; i++) {
        if (state::same_text(e->functions[i].name, key)) {
            state::FunctionInfo info = e->functions[i];
            Signature sig = {
                .function = info.llvm, .type = info.llvm_type, .result = info.result, .params = info.params};
            return sig;
        }
    }
    for (Usize i = 0; i < countof(e->tree->decls); i++) {
        const ast::Decl *d = e->tree->decls[i];
        if (d->kind != .function || d->kind.function.body != nullptr) continue;
        if (!state::same_text(d->kind.function.name, key)) continue;
        SignatureResult made = signature(e, d);
        if (made == .error) return made;
        Signature sig = made.ok;
        Str symbol = symbol_for(e, key);
        char *label = state::cstr(symbol);
        state::free_text(symbol);
        sig.function = c::LLVMGetNamedFunction(e->module, label);
        mem::free(label);
        if (sig.function == nullptr) {
            release(sig);
            return signature_failed(state::failf(span, "the prototype of ", key, " is not declared"));
        }
        return sig;
    }
    return signature_failed(state::failf(span, "unknown function ", key));
}

static Bool is_named(const ast::Expr *a) {
    return a->kind == .named_arg;
}

// The name a named argument gives (empty for any other).
static Str given_name(const ast::Expr *a) {
    if (a->kind == .named_arg) return a->kind.named_arg.name;
    return "";
}

// The declaration of the function `key` names, with or without a body (its parameters' names), or null.
static const ast::Decl *find_decl(state::Emitter *e, Str key, const ast::Decl *imported) {
    if (imported != nullptr) return imported;
    for (Usize i = 0; i < countof(e->tree->decls); i++) {
        const ast::Decl *d = e->tree->decls[i];
        if (d->kind == .function && state::same_text(d->kind.function.name, key)) return d;
    }
    return nullptr;
}

// The parameter each argument fills: `slot[i]` for `args[i]`. By position until the first named argument, then by
// name among the declaration's parameters (the checker's `argument_slot`).
static state::Status assign_slots(state::Emitter *e, Str key, ast::ExprRef args[:], Usize slot[64],
                                  const ast::Decl *imported) {
    Bool named = false;
    for (Usize i = 0; i < countof(args); i++) {
        slot[i] = i;
        if (is_named(args[i])) named = true;
    }
    if (!named) return state::success();
    const ast::Decl *d = find_decl(e, key, imported);
    if (d == nullptr) {
        return state::failf(args[0]->span, "the arguments of ", key, " cannot be named: it has no declaration here");
    }
    if (d->kind != .function) {
        return state::fail("not a function", d->span);
    }
    ast::Param params[:] = d->kind.function.params;
    Bool taken[64];
    for (Usize i = 0; i < 64; i++)
        taken[i] = false;
    Bool by_name = false;
    for (Usize i = 0; i < countof(args); i++) {
        if (!is_named(args[i])) {
            if (by_name) return state::fail("a positional argument cannot follow a named one", args[i]->span);
            taken[i] = true;
            continue;
        }
        by_name = true;
        Str given = given_name(args[i]);
        Bool found = false;
        for (Usize p = 0; p < countof(params) && p < 64; p++) {
            if (!state::same_text(params[p].name, given)) continue;
            if (taken[p]) return state::failf(args[i]->span, "parameter ", given, " of ", key, " is given twice");
            taken[p] = true;
            slot[i] = p;
            found = true;
            break;
        }
        if (!found) return state::failf(args[i]->span, key, " has no parameter ", given);
    }
    return state::success();
}

// The argument's expression: the value of a named one.
static const ast::Expr *value_of(const ast::Expr *arg) {
    if (arg->kind == .named_arg) return arg->kind.named_arg.value;
    return arg;
}

static Bool find_record(state::Emitter *e, Str name, Usize *found) {
    for (Usize i = 0; i < e->record_count; i++) {
        if (state::same_text(e->records[i].name, name)) {
            *found = i;
            return true;
        }
    }
    return false;
}

static Bool find_field(state::RecordType record, Str name, Usize *found) {
    for (Usize i = 0; i < countof(record.fields); i++) {
        if (state::same_text(record.fields[i].name, name)) {
            *found = i;
            return true;
        }
    }
    return false;
}

// The field values are on the value stack, the first deepest: start from zero and insert each.
static state::Status construct_finish(state::Emitter *e, const state::Work *w) {
    const ast::Expr *x = w->expr;
    if (x->kind != .call) {
        return state::fail("not a call", w->span);
    }
    ast::ExprRef args[:] = x->kind.call.args;
    const ast::Expr *callee = x->kind.call.callee;
    if (callee->kind != .name) {
        return state::fail("not a name", w->span);
    }
    Str name = callee->kind.name.path.segments[0].text;
    Usize count = (Usize)w->number;
    state::Value values[64];
    for (Usize i = count; i > 0; i--)
        values[i - 1] = state::pop_value(e);
    Usize at = 0;
    if (!find_record(e, name, &at)) return state::failf(w->span, "unknown record ", name);
    state::RecordType record = e->records[at];
    c::LLVMValueRef built = c::LLVMConstNull(record.ty.llvm);
    for (Usize i = 0; i < count; i++) {
        Usize field = 0;
        if (!find_field(record, given_name(args[i]), &field))
            return state::failf(args[i]->span, "no field ", given_name(args[i]), " in ", name);
        if (!state::same_type(values[i].ty, record.fields[field].ty))
            return state::failf(args[i]->span, "field ", record.fields[field].name, " of ", name, " is ",
                                record.fields[field].ty.name, ", the value is ", values[i].ty.name);
        built = c::LLVMBuildInsertValue(e->builder, built, values[i].llvm, (U32)field, "");
    }
    state::push_value(e, (state::Value){.llvm = built, .ty = record.ty});
    return state::success();
}

// `Point(x = 1, y = 2)`: a record of the module built by a call whose arguments are all named fields.
static state::Status construct(state::Emitter *e, const ast::Expr *x, Usize at) {
    if (x->kind != .call) {
        return state::fail("not a call", x->span);
    }
    ast::ExprRef args[:] = x->kind.call.args;
    state::RecordType record = e->records[at];
    Usize count = countof(args);
    if (count > 64) return state::not_emitted("more than 64 fields in one construction", x->span);
    Bool seen[64];
    for (Usize i = 0; i < 64; i++)
        seen[i] = false;
    for (Usize i = 0; i < count; i++) {
        if (!is_named(args[i]))
            return state::failf(args[i]->span, "a field of ", record.name, " is always named; write ", record.name,
                                "(x = ...)");
        Str given = given_name(args[i]);
        Usize field = 0;
        if (!find_field(record, given, &field))
            return state::failf(args[i]->span, "no field ", given, " in ", record.name);
        if (seen[field]) return state::failf(args[i]->span, "field ", given, " of ", record.name, " is given twice");
        seen[field] = true;
    }
    state::push_then(e, (state::Work){.then = construct_finish, .expr = x, .number = count, .span = x->span});
    for (Usize i = count; i > 0; i--) {
        Usize field = 0;
        find_field(record, given_name(args[i - 1]), &field);
        state::push_eval(e, value_of(args[i - 1]), state::hint_of(record.fields[field].ty));
    }
    return state::success();
}

// The arguments' values are on the value stack, the first deepest: check them and call.
static state::Status call_finish(state::Emitter *e, const state::Work *w) {
    const ast::Expr *x = w->expr;
    if (x->kind != .call) {
        return state::fail("not a call", w->span);
    }
    ast::ExprRef args[:] = x->kind.call.args;
    const ast::Expr *callee = x->kind.call.callee;
    const ast::Decl *imported = nullptr;
    Str key = "";
    Bool is_imported = imported_callee(e, callee, &imported, &key);
    if (!is_imported && callee->kind != .name) {
        return state::fail("not a name", w->span);
    }
    Usize count = (Usize)w->number;
    state::Value values[64];
    for (Usize i = count; i > 0; i--)
        values[i - 1] = state::pop_value(e);
    if (!is_imported && callee->kind == .name) key = join(callee->kind.name.path);
    SignatureResult found = find(e, key, callee->span, imported);
    if (found == .error) {
        state::free_text(key);
        return {.error = found.error};
    }
    Signature sig = found.ok;
    Usize slot[64];
    state::Status slotted = assign_slots(e, key, args, slot, imported);
    if (slotted == .error) {
        state::free_text(key);
        release(sig);
        return slotted;
    }
    c::LLVMValueRef argv[64];
    for (Usize i = 0; i < count; i++) {
        if (!state::same_type(values[i].ty, sig.params[slot[i]])) {
            // A value the parameter takes (an integer widened, a payload wrapped in its option) is converted.
            state::Status converted = state::convert(e, values[i], sig.params[slot[i]], args[i]->span, .initialize);
            if (converted == .ok) {
                values[i] = state::pop_value(e);
                argv[slot[i]] = values[i].llvm;
                continue;
            }
            state::free_text(converted.error.message);
            state::Status wrong = state::failf(args[i]->span, "argument ", (U64)i + 1, " of ", key, " is ",
                                               values[i].ty.name, ", the parameter is ", sig.params[slot[i]].name);
            state::free_text(key);
            release(sig);
            return wrong;
        }
        argv[slot[i]] = values[i].llvm;
    }
    c::LLVMValueRef made = nullptr;
    if (is_void(sig.result))
        made = c::LLVMBuildCall2(e->builder, sig.type, sig.function, argv, (U32)count, "");
    else
        made = c::LLVMBuildCall2(e->builder, sig.type, sig.function, argv, (U32)count, "call");
    state::push_value(e, (state::Value){.llvm = made, .ty = sig.result});
    state::free_text(key);
    release(sig);
    return state::success();
}

// A lambda written as an argument is made by `emit_lambda::argument` (it may capture by reference); any other argument
// is evaluated.
static state::Status lambda_argument(state::Emitter *e, const state::Work *w) {
    return lambdas::argument(e, w->expr, w->hint);
}

static void push_argument(state::Emitter *e, const ast::Expr *arg, state::Hint hint) {
    const ast::Expr *value = value_of(arg);
    if (value->kind == .lambda)
        state::push_then(e, (state::Work){.then = lambda_argument, .expr = value, .hint = hint, .span = value->span});
    else
        state::push_eval(e, value, hint);
}

// `Expr.call`.
export state::Status call(state::Emitter *e, const ast::Expr *x, state::Hint _) {
    if (x->kind != .call) {
        return state::fail("not a call", x->span);
    }
    const ast::Expr *callee = x->kind.call.callee;
    ast::ExprRef args[:] = x->kind.call.args;
    const ast::Decl *imported = nullptr;
    Str key = "";
    Bool is_imported = false;
    if (callee->kind == .name) {
        ast::Path path = callee->kind.name.path;
        Usize record = 0;
        if (countof(path.segments) == 1 && find_record(e, path.segments[0].text, &record))
            return construct(e, x, record);
        state::Local local = {};
        if (countof(path.segments) == 1 && state::find_local(e, path.segments[0].text, &local) &&
            local.ty.kind == .fn_value)
            return lambdas::call_value(e, x, local.ty);
        if (streams::is_call(x)) return streams::call(e, x);
    }
    is_imported = imported_callee(e, callee, &imported, &key);
    if (!is_imported && callee->kind != .name) {
        return state::not_emitted("call of something that is not a name", x->span);
    }
    if (!is_imported && callee->kind == .name) key = join(callee->kind.name.path);
    SignatureResult found = find(e, key, callee->span, imported);
    if (found == .error) {
        state::free_text(key);
        return {.error = found.error};
    }
    Signature sig = found.ok;
    Usize count = countof(args);
    if (count != countof(sig.params)) {
        state::Status wrong =
            state::failf(x->span, key, " takes ", (U64)countof(sig.params), " arguments, the call has ", (U64)count);
        state::free_text(key);
        release(sig);
        return wrong;
    }
    Usize slot[64];
    state::Status slotted = assign_slots(e, key, args, slot, imported);
    if (slotted == .error) {
        state::free_text(key);
        release(sig);
        return slotted;
    }
    state::push_then(e, (state::Work){.then = call_finish, .expr = x, .number = count, .span = x->span});
    // The first argument runs first: it is pushed last.
    for (Usize i = count; i > 0; i--)
        push_argument(e, args[i - 1], state::hint_of(sig.params[slot[i - 1]]));
    state::free_text(key);
    release(sig);
    return state::success();
}

// `return;` in a function with no result.
export state::Status return_void(state::Emitter *e, const ast::Stmt *s) {
    if (!is_void(e->result))
        return state::failf(s->span, "returning no value from a function that returns ", e->result.name);
    try control::before_return(e, s->span);
    c::LLVMBuildRetVoid(e->builder);
    return state::success();
}

// A `Decl.function` with no body, declared in the first pass: an external declaration in the LLVM module. (It is not
// added to `e->functions`, see the top of this file.)
export state::Status prototype(state::Emitter *e, const ast::Decl *d) {
    if (d->kind != .function) {
        return state::fail("not a function", d->span);
    }
    Str name = d->kind.function.name;
    ast::Span span = d->span;
    for (Usize i = 0; i < countof(e->tree->decls); i++) {
        const ast::Decl *other = e->tree->decls[i];
        if (other != d && other->kind == .function && state::same_text(other->kind.function.name, name))
            return state::failf(span, name, " is declared twice");
    }
    SignatureResult made = signature(e, d);
    if (made == .error) return {.error = made.error};
    Signature sig = made.ok;
    Str symbol = symbol_for(e, name);
    char *label = state::cstr(symbol);
    state::free_text(symbol);
    if (c::LLVMGetNamedFunction(e->module, label) != nullptr) {
        mem::free(label);
        release(sig);
        return state::failf(span, name, " is declared twice");
    }
    c::LLVMAddFunction(e->module, label, sig.type);
    mem::free(label);
    release(sig);
    return state::success();
}
