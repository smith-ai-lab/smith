// front::fix_type_same, the fix-it for C's `__builtin_types_compatible_p` (#3593): the old form asks the compiler
// whether two types are the same, and smith asks it of two type values, which are compared at compile time (#3039).
//
//   __builtin_types_compatible_p(typeof(f), fn(typeof(arg)))     typeof(f) == fn(typeof(arg))
//
// The rule reads the text, not the checker: a generic function is checked only in an instance, and the one that
// writes the question (`std::task::spawn`) has none in its own file. An argument with a space at its top level is put
// in parentheses, and so is the comparison unless it is a whole argument or a whole condition.
//
//   fix_type_same::edits(source)   one fix for each call of `__builtin_types_compatible_p` with two arguments
module front::fix_type_same;

import front::ast;
import front::parse as core;
import front::types;
import std::format;
import std::mem;

static Str name = "__builtin_types_compatible_p";

static Bool at(Str s, Usize i, Str pattern) {
    if (i + countof(pattern) > countof(s)) return false;
    return mem::equal(s[i:i + countof(pattern)], pattern);
}

static Bool word_char(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
}

static Bool blank(char ch) {
    return ch == ' ' || ch == '\n';
}

// The end of the call whose `(` is at `open`, and where its one top-level `,` is: `close` is the `)`, `comma` the `,`
// (0 when there is not exactly one).
struct Call {
    Usize close;
    Usize comma;
    Bool ok;
};

static Call read_call(Str s, Usize open) {
    Call call = {};
    Usize depth = 0;
    Usize commas = 0;
    for (Usize i = open; i < countof(s); i++) {
        char ch = s[i];
        if (ch == '"') {
            i += 1;
            while (i < countof(s) && s[i] != '"')
                i += (s[i] == '\\') ? 2 : 1;
        } else if (ch == '(' || ch == '[') {
            depth += 1;
        } else if (ch == ')' || ch == ']') {
            depth -= 1;
            if (depth == 0) {
                call.close = i;
                call.ok = commas == 1;
                return call;
            }
        } else if (ch == ',' && depth == 1) {
            commas += 1;
            call.comma = i;
        }
    }
    return call;
}

// `s[from:to]` without the blanks at its ends and its lines joined by one space; in parentheses when it has a space
// outside brackets.
static Str operand(Str s, Usize from, Usize to) {
    while (from < to && blank(s[from]))
        from += 1;
    while (to > from && blank(s[to - 1]))
        to -= 1;
    Usize depth = 0;
    Bool spaced = false;
    for (Usize i = from; i < to; i++) {
        char ch = s[i];
        if (ch == '(' || ch == '[') depth += 1;
        if (ch == ')' || ch == ']') depth -= 1;
        if (ch == ' ' && depth == 0) spaced = true;
    }
    Str text = s[from:to];
    if (!spaced) return text;
    return types::message_of(format::push("(", text, ")"));
}

// Whether the call at `start`..`end` is a whole argument or condition: `static_assert(<call>, ...)`, `if <call>:`.
static Bool stands_alone(Str s, Usize start, Usize end) {
    Usize before = start;
    while (before > 0 && blank(s[before - 1]))
        before -= 1;
    Usize after = end;
    while (after < countof(s) && s[after] == ' ')
        after += 1;
    Bool opens =
        before == 0 || s[before - 1] == '(' || s[before - 1] == ',' || at(s, before >= 2 ? before - 2 : 0, "if");
    Bool closes = after >= countof(s) || s[after] == ',' || s[after] == ')' || s[after] == ':' || s[after] == '\n';
    return opens && closes;
}

export core::Errors edits(Str source) {
    core::Errors out = {};
    for (Usize i = 0; i + countof(name) < countof(source); i++) {
        if (!at(source, i, name) || source[i + countof(name)] != '(' || (i > 0 && word_char(source[i - 1]))) continue;
        Usize open = i + countof(name);
        Call call = read_call(source, open);
        if (!call.ok) continue;
        Str text = types::message_of(
            format::push(operand(source, open + 1, call.comma), " == ", operand(source, call.comma + 1, call.close)));
        if (!stands_alone(source, i, call.close + 1)) text = types::message_of(format::push("(", text, ")"));
        core::Edits fix = {};
        fix = mem::realloc(fix, 1);
        ast::Span span = {.start = (U32)i, .end = (U32)(call.close + 1)};
        fix[0] = (core::Edit){.span = span, .text = text};
        core::ParseError made = {};
        made.span = span;
        Str why = "write `a == b`: types are values, and `==` on two of them asks whether they are the same";
        made.message = why;
        made.fix = fix;
        out = mem::realloc(out, countof(out) + 1);
        out[countof(out) - 1] = made;
    }
    return out;
}
