// front::fix_const, the fix-it for a local that C fills through its address (#2648).
//
//   ty: state.Ty = undefined             mut ty: state.Ty = undefined
//   state.scalar_type(e, "Bool", &ty)    state.scalar_type(e, "Bool", &ty)
//
// C's `T x = {};` followed by `f(&x)` is an out-parameter: `f` fills `x`. In smith a name is constant unless it is
// `mut`, so `&x` is a `*T` and the checker says "this drops const" where `f` wants a `*mut T`. The fixer's own checker
// does not report it for a callee in another module, so the rule reads the text: a local written `name: T = undefined`
// (what `{}` of a struct that C fills becomes) whose address `&name` is taken later in the same function is `mut`.
//
//   fix_const::edits(source)   one fix for each such local
module front::fix_const;

import front::ast;
import front::parse as core;
import std::mem;

static Bool starts_with(Str text, Str prefix) {
    if (countof(text) < countof(prefix)) return false;
    for (Usize i = 0; i < countof(prefix); i++)
        if (text[i] != prefix[i]) return false;
    return true;
}

static Bool ends_with(Str text, Str suffix) {
    if (countof(text) < countof(suffix)) return false;
    return starts_with(text[countof(text) - countof(suffix):countof(text)], suffix);
}

static Bool word_char(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
}

// The end of the line that starts at `at`.
static Usize line_end(Str source, Usize at) {
    while (at < countof(source) && source[at] != '\n')
        at += 1;
    return at;
}

// The name of the local that `line` declares as `name: T = undefined`, with no `mut`; empty when it is not one.
static Str undefined_local(Str line) {
    if (!ends_with(line, " = undefined")) return "";
    Usize k = 0;
    while (k < countof(line) && line[k] == ' ')
        k += 1;
    Usize from = k;
    while (k < countof(line) && word_char(line[k]))
        k += 1;
    if (k == from || k >= countof(line) || line[k] != ':') return "";
    Str name = line[from:k];
    if (countof(name) == 3 && starts_with(name, "mut")) return "";
    return name;
}

// Whether `&name` (not `&name2`) is in `text`.
static Bool takes_address(Str text, Str name) {
    for (Usize i = 0; i + 1 + countof(name) <= countof(text); i++) {
        if (text[i] != '&' || !starts_with(text[i + 1:countof(text)], name)) continue;
        Usize after = i + 1 + countof(name);
        if (after >= countof(text) || !word_char(text[after])) return true;
    }
    return false;
}

export core::Errors edits(Str source) {
    core::Errors out = {};
    Usize at = 0;
    while (at < countof(source)) {
        Usize end = line_end(source, at);
        Str name = undefined_local(source[at:end]);
        if (countof(name) > 0) {
            // the rest of the function: up to the next line at column 0
            Usize stop = end + 1;
            while (stop < countof(source) && (source[stop] == ' ' || source[stop] == '\n'))
                stop = line_end(source, stop) + 1;
            Usize body = stop < countof(source) ? stop : countof(source);
            if (end < body && takes_address(source[end:body], name)) {
                Usize k = at;
                while (source[k] == ' ')
                    k += 1;
                core::Edits fix = {};
                fix = mem::realloc(fix, 1);
                ast::Span here = {.start = (U32)k, .end = (U32)k};
                Str word = "mut ";
                fix[0] = (core::Edit){.span = here, .text = word};
                core::ParseError made = {};
                made.span = fix[0].span;
                Str why = "a local that C fills through its address is `mut`";
                made.message = why;
                made.fix = fix;
                out = mem::realloc(out, countof(out) + 1);
                out[countof(out) - 1] = made;
            }
        }
        at = end + 1;
    }
    return out;
}
