// front::fix_variants, the fixer's whole-tree rename of enum variants to lowercase (#2098, part of #2053).
//
// In the new syntax a variant is a value, so it is lowercase: `NotFound` is `not_found`, written `.not_found` where the
// context expects the enum. The names are declared in one file and used in others (`files.NotFound`, `case NotFound:`,
// `return NotFound`), so a per-file fix would break every other file. This pass reads all the files being fixed first,
// collects the variants of every enum they declare, then rewrites the declaration and every use in every file.
//
//   fix_variants::collect(source)        the variants the enums of `source` declare (names, no duplicates)
//   fix_variants::rename(source, names)  `source` with each of `names` written lowercase: a declaration or a name after
//                                        `.` or `::` as `snake_case`, any other use as `.snake_case`
//   fix_variants::rename_all(sources)    the same for a list of files (Words): the names of all of them, applied to
//   each
//   fix_variants::rename_all_with(sources, imported)  the same, with the names of the modules they import too
//
// A name is left alone (and so are its uses) when it is also the name of a struct, enum or union in the files, since
// text alone cannot tell which is meant. A lowercase result that is a keyword gets a `_` at the end (`Default` is
// `default_`). The variants keep the attributes written before them, so a `@c_name` stays as it was. Tests:
// `tests/front_fix_variants_test.smith`.
module front::fix_variants;

import front::lex;
import std::arena;
import std::format;
import std::mem;

// A text in a list: `Str xs[:]` would be a block of rows, not a list of texts (see front::ast's Identifier).
export struct Word {
    Str text;
};

export typedef typeof(Word[:]) Words;

// The variants found in a text, and the offsets of the tokens that declare them.
export struct Found {
    Words names;
    Usize declared[:];
};

static Str as_str(char chars[:]) {
    return chars;
}

static Bool is_upper(char c) {
    return c >= 'A' && c <= 'Z';
}

static Bool is_lower_or_digit(char c) {
    return (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9');
}

// `NotFound` as `not_found`; `IOError` as `io_error`; a result that is a keyword gets a `_`.
export Str snake(Str name) {
    Str out = "";
    for (Usize i = 0; i < countof(name); i++) {
        char c = name[i];
        if (!is_upper(c)) {
            out = as_str(format::push(out, name[i:i + 1]));
            continue;
        }
        Bool after_word = i > 0 && is_lower_or_digit(name[i - 1]);
        Bool ends_acronym = i > 0 && is_upper(name[i - 1]) && i + 1 < countof(name) && is_lower_or_digit(name[i + 1]);
        if (after_word || ends_acronym) out = as_str(format::push(out, "_"));
        Str letters = "abcdefghijklmnopqrstuvwxyz";
        Usize at = (Usize)(c - 'A');
        out = as_str(format::push(out, letters[at:at + 1]));
    }
    lex::Lexed read = lex::tokenize_new(out);
    if (read != .error && countof(read.ok) > 0 && lex::is_keyword(read.ok[0].kind)) {
        out = as_str(format::push(out, "_"));
    }
    return out;
}

static Bool has(Words names, Str name) {
    for (Usize i = 0; i < countof(names); i++) {
        if (mem::equal(names[i].text, name)) return true;
    }
    return false;
}

// The spaces at the start of the line that holds `at`.
static Usize indent_of(Str source, Usize at) {
    Usize start = at;
    while (start > 0 && source[start - 1] != '\n')
        start -= 1;
    Usize n = 0;
    while (start + n < countof(source) && source[start + n] == ' ')
        n += 1;
    return n;
}

static Bool is_open(lex::TokenKind k) {
    return k == lex::left_paren || k == lex::left_bracket || k == lex::left_brace;
}

static Bool is_close(lex::TokenKind k) {
    return k == lex::right_paren || k == lex::right_bracket || k == lex::right_brace;
}

// Where the body of the enum whose keyword is token `at` starts: the token after its `{` or `:`, or the length of the
// list when there is none within a few tokens (`enum Name;`).
static Usize body_start(lex::Tokens tokens, Usize at, Bool *braced) {
    Usize limit = at + 12;
    for (Usize i = at + 1; i < countof(tokens) && i < limit; i++) {
        // `enum End : u8:` has two colons (or a colon and a brace): the first ends the name and gives the
        // representation.
        // A representation follows the colon on its line: `enum:` with a payload variant `some: T` below it has two
        // colons too
        // (#2648: `T` was taken for a variant and written `.t`).
        if (tokens[i].kind == lex::colon && i + 2 < countof(tokens) && !tokens[i].line_break &&
            (tokens[i + 2].kind == lex::colon || tokens[i + 2].kind == lex::left_brace))
            continue;
        if (tokens[i].kind == lex::left_brace || tokens[i].kind == lex::colon) {
            *braced = tokens[i].kind == lex::left_brace;
            return i + 1;
        }
        if (tokens[i].kind == lex::semicolon) break;
    }
    return countof(tokens);
}

static void note(Found *found, Str source, lex::Token token) {
    Str name = lex::text(source, token);
    found->declared = mem::realloc(found->declared, countof(found->declared) + 1);
    found->declared[countof(found->declared) - 1] = token.span.start;
    if (has(found->names, name)) return;
    found->names = mem::realloc(found->names, countof(found->names) + 1);
    found->names[countof(found->names) - 1] = (Word){.text = name};
}

// Whether token `i` starts an entry of the body: first after the `{` or a `,`, first on its line, or after the `]]`
// of an attribute.
static Bool starts_entry(lex::Tokens tokens, Usize i, Usize first) {
    if (tokens[i].kind != lex::type_name) return false;
    // A name after `.`, `::`, `*` or `:` is part of a type (`*ast.TypeExpr`, `ast::Decl *decl`), never a variant: a
    // qualified or payload type that ends its line used to count as an entry (#2400).
    if (i > first) {
        lex::TokenKind prev = tokens[i - 1].kind;
        if (prev == lex::dot || prev == lex::colon_colon || prev == lex::star || prev == lex::colon) return false;
    }
    // `T some;` is a variant with a payload, written type first: the type is no variant (`Option`'s `T`, #2224).
    if (i + 1 < countof(tokens)) {
        lex::TokenKind next = tokens[i + 1].kind;
        Bool same_line = !tokens[i + 1].line_break;
        if (same_line && (next == lex::name || next == lex::star || next == lex::colon_colon)) return false;
    }
    if (i == first || tokens[i].line_break) return true;
    lex::TokenKind before = tokens[i - 1].kind;
    return before == lex::comma || before == lex::right_bracket;
}

// The variants of the enum whose keyword is token `at`, added to `found`.
static void read_body(Found *found, Str source, lex::Tokens tokens, Usize at) {
    Bool braced = false;
    Usize first = body_start(tokens, at, &braced);
    Usize base = indent_of(source, tokens[at].span.start);
    Usize depth = braced ? 1 : 0;
    for (Usize i = first; i < countof(tokens) && tokens[i].kind != lex::end_of_file; i++) {
        lex::Token t = tokens[i];
        if (!braced && t.line_break && indent_of(source, t.span.start) <= base) break;
        if (braced && is_close(t.kind) && depth == 1) break;
        Usize entry_depth = braced ? 1 : 0;
        if (depth == entry_depth && starts_entry(tokens, i, first)) note(found, source, t);
        if (is_open(t.kind)) depth += 1;
        if (is_close(t.kind) && depth > 0) depth -= 1;
    }
}

// The variants the enums of `source` declare, in smith's own syntax or today's. Text that does not tokenize declares
// none.
export Found collect(Str source) {
    Found found = {};
    lex::Lexed read = lex::tokenize_new(source);
    // An imported module as its file has it, still in today's syntax (`// ...`), reads with today's lexer (#3027).
    if (read == .error) read = lex::tokenize(source);
    if (read == .error) return found;
    lex::Tokens tokens = read.ok;
    for (Usize i = 0; i < countof(tokens); i++) {
        if (tokens[i].kind == lex::kw_enum) read_body(&found, source, tokens, i);
    }
    return found;
}

static Words push_word(Words list, Str text) {
    Words more = mem::realloc(list, countof(list) + 1);
    more[countof(more) - 1] = (Word){.text = text};
    return more;
}

// `tags` with the names `source` declares as a struct, enum or union tag added.
static Words add_tags(Words tags, Str source) {
    lex::Lexed read = lex::tokenize_new(source);
    if (read == .error) return tags;
    lex::Tokens tokens = read.ok;
    for (Usize i = 0; i + 1 < countof(tokens); i++) {
        lex::TokenKind k = tokens[i].kind;
        if (k != lex::kw_struct && k != lex::kw_enum && k != lex::kw_union) continue;
        if (tokens[i + 1].kind != lex::type_name) continue;
        Str name = lex::text(source, tokens[i + 1]);
        if (!has(tags, name)) tags = push_word(tags, name);
    }
    return tags;
}

static Bool declared_at(Found found, Usize offset) {
    for (Usize i = 0; i < countof(found.declared); i++) {
        if (found.declared[i] == offset) return true;
    }
    return false;
}

// Whether the `:` at token `colon` ends a declared name (`output: T`, `fn f(a: T, mut b: T)`, a field): the name before
// it starts its line or follows `(`, `,` or `mut`. `if c: console.Output` has a value after its `:`.
static Bool declares(Str source, lex::Tokens tokens, Usize colon) {
    if (colon == 0 || tokens[colon - 1].kind != lex::name) return false;
    Usize k = colon - 1;
    if (k == 0) return true;
    lex::TokenKind before = tokens[k - 1].kind;
    if (before == lex::left_paren || before == lex::comma || before == lex::kw_mut || before == lex::newline ||
        before == lex::indent)
        return true;
    for (Usize at = tokens[k - 1].span.end; at < tokens[k].span.start; at++) {
        if (source[at] == '\n') return true;
    }
    return false;
}

// Whether type name `i` is used as a type, not a variant. In today's syntax: a declaration's type
// (`process::Output output`, `Output *o`), a compound literal or cast (`(Output){...}`, `(Output)x`), a type argument
// (`Result(Output, Error)`). In the new syntax, which the rename also reads once a file is mended: after a declared
// name's `:`, `->`, `*` or `]` (`output: process.Output`, `-> Output`, `[]Output`). An imported module can name a
// type as another one names a variant (process's `Output`, console's `Stream.Output`, #3027).
static Bool used_as_type(Str source, lex::Tokens tokens, Usize i) {
    lex::TokenKind next = i + 1 < countof(tokens) ? tokens[i + 1].kind : lex::end_of_file;
    // a name on the next line is the next statement, not a declared name (`= console.Input` then `t: ...`)
    Bool same_line = i + 1 < countof(tokens) && !tokens[i].line_break;
    if (same_line && (next == lex::name || next == lex::star)) return true;
    Usize head = i;
    if (head >= 2 && (tokens[head - 1].kind == lex::colon_colon || tokens[head - 1].kind == lex::dot) &&
        tokens[head - 2].kind == lex::name)
        head -= 2;
    if (head == 0) return false;
    lex::TokenKind before = tokens[head - 1].kind;
    // not `?`: today's syntax still has `c ? console::Output : console::Input`
    if (before == lex::arrow || before == lex::star || before == lex::right_bracket) return true;
    if (before == lex::colon) return declares(source, tokens, head - 1);
    if (before != lex::left_paren) return false;
    // `(T){` and `(T)x`, but not a call's one argument, `f(console::Output)`
    if (next == lex::right_paren) {
        lex::TokenKind after = i + 2 < countof(tokens) ? tokens[i + 2].kind : lex::end_of_file;
        return after == lex::left_brace || after == lex::name;
    }
    return head >= 2 && tokens[head - 2].kind == lex::type_name;
}

// `source` with each of `names` lowercase.
export Str rename(Str source, Words names) {
    lex::Lexed read = lex::tokenize_new(source);
    if (read == .error || countof(names) == 0) return source;
    lex::Tokens tokens = read.ok;
    Found here = collect(source);
    Str out = "";
    Usize copied = 0;
    for (Usize i = 0; i < countof(tokens); i++) {
        lex::Token t = tokens[i];
        if (t.kind != lex::type_name) continue;
        Str name = lex::text(source, t);
        if (!has(names, name) || used_as_type(source, tokens, i)) continue;
        lex::TokenKind before = i > 0 ? tokens[i - 1].kind : lex::end_of_file;
        Bool qualified = before == lex::dot || before == lex::colon_colon;
        Str spelled = snake(name);
        if (!qualified && !declared_at(here, t.span.start)) spelled = as_str(format::push(".", spelled));
        out = as_str(format::push(out, source[copied:t.span.start], spelled));
        copied = t.span.end;
    }
    return as_str(format::push(out, source[copied:countof(source)]));
}

// The variants the enums of `texts` declare, added to `names`, and their struct, enum and union names to `tags`.
static Words add_variants(Words names, Words *tags, Words texts) {
    for (Usize i = 0; i < countof(texts); i++) {
        *tags = add_tags(*tags, texts[i].text);
        Found found = collect(texts[i].text);
        for (Usize j = 0; j < countof(found.names); j++) {
            if (!has(names, found.names[j].text)) names = push_word(names, found.names[j].text);
        }
    }
    return names;
}

// `sources` with the variants of all of them, and of the modules they import (`imported`, as their files have them),
// renamed in each: a file fixed alone writes `console::Closed` as `.closed`, as `console.smith` declares it once
// fixed (#3027).
export Words rename_all_with(Words sources, Words imported) {
    Words tags = {};
    Words names = add_variants((Words){}, &tags, sources);
    names = add_variants(names, &tags, imported);
    Words kept = {};
    for (Usize i = 0; i < countof(names); i++) {
        if (!has(tags, names[i].text)) kept = push_word(kept, names[i].text);
    }
    Words renamed = mem::alloc_slice(Word, countof(sources));
    for (Usize i = 0; i < countof(sources); i++)
        renamed[i].text = rename(sources[i].text, kept);
    return renamed;
}

// `sources` with the variants of all of them renamed in each.
export Words rename_all(Words sources) {
    Words none = {};
    return rename_all_with(sources, none);
}

// The fixer's rename of a local or parameter named like a module the file imports (#3027).
//
// In smith's own syntax a local, parameter or loop name that is the name of an imported module is a shadowing error
// (owner, 2026-11-10: "yeah it should be a shadowing error please"): `arena: *Arena` with `import std.arena`. Today's
// syntax tells the two apart by `::` (`arena::push(a, ...)` is the module, `arena->used` the local), and once fixed
// both are `arena.`, so the rename is made on today's text, before every other pass. The name gets a trailing `_` (the
// rule of `in` -> `in_`, #2390), and another while that name is in the file:
//
//   void f(arena::Arena *arena) { arena::push(arena, 1); }   void f(arena::Arena *arena_) { arena::push(arena_, 1); }
//
// Renamed: a name inside a function's parameters or body that has no `::` after it and no `.`, `->` or `::` before it,
// and no `(` after it (a function of that name). A name used at the top level of the file (a global, a function) is
// left, since its declaration is not in a function, and so are struct fields (`.arena` stays).
//
//   fix_variants::rename_shadows(source)   `source` with every such name renamed
// A text in a list.
struct ShadowName {
    Str text;
};

typedef typeof(ShadowName[:]) Names;
typedef typeof(U8[:]) Places;

static Bool listed(Names names, Str text) {
    for (Usize i = 0; i < countof(names); i++) {
        if (mem::equal(names[i].text, text)) return true;
    }
    return false;
}

static Names with_name(Names names, Str text) {
    if (listed(names, text)) return names;
    names = mem::realloc(names, countof(names) + 1);
    names[countof(names) - 1] = (ShadowName){.text = text};
    return names;
}

// `as` of an import: a keyword of smith's own syntax, a name to today's lexer.
static Bool is_as(Str source, lex::Token token) {
    Str word = "as";
    return token.kind == lex::kw_as || (token.kind == lex::name && mem::equal(lex::text(source, token), word));
}

// The names the file's module imports bind: the last part of `import a::b;`, or the name after `as`. A header
// (`import <h>;`) binds none here.
static Names imported(Str source, lex::Tokens tokens) {
    Names names = {};
    for (Usize i = 0; i + 1 < countof(tokens); i++) {
        if (tokens[i].kind != lex::kw_import || tokens[i + 1].kind != lex::name) continue;
        Usize j = i + 1;
        Str last = lex::text(source, tokens[j]);
        while (j + 2 < countof(tokens) && tokens[j + 1].kind == lex::colon_colon && tokens[j + 2].kind == lex::name) {
            j += 2;
            last = lex::text(source, tokens[j]);
        }
        if (j + 2 < countof(tokens) && is_as(source, tokens[j + 1]) && tokens[j + 2].kind == lex::name)
            last = lex::text(source, tokens[j + 2]);
        names = with_name(names, last);
    }
    return names;
}

// Where each token stands: 0 at the top level, 1 in a function's parameters or body, 2 elsewhere (a struct's body, the
// parentheses of a declaration with no body).
static Places places(lex::Tokens tokens) {
    Places place = mem::alloc_slice(U8, countof(tokens));
    Usize depth = 0;
    Bool function = false;
    for (Usize i = 0; i < countof(tokens); i++) {
        lex::TokenKind k = tokens[i].kind;
        if (k == lex::left_brace && depth == 0) {
            function = i > 0 && tokens[i - 1].kind == lex::right_paren;
            if (function) {
                // the parameters: back to the `(` that the `)` before the brace closes
                Usize open = 0;
                for (Usize j = i - 1; j > 0; j--) {
                    if (tokens[j].kind == lex::right_paren) {
                        open += 1;
                    }
                    if (tokens[j].kind == lex::left_paren) {
                        open -= 1;
                    }
                    place[j] = 1;
                    if (open == 0) break;
                }
            }
        }
        if (depth > 0) place[i] = function ? 1 : 2;
        if (k == lex::left_brace) depth += 1;
        if (k == lex::right_brace && depth > 0) {
            depth -= 1;
            place[i] = function ? 1 : 2;
            if (depth == 0) function = false;
        }
    }
    return place;
}

// Whether token `i` is a use of the local or parameter: no `::` after it, no `.`, `->` or `::` before it, and not a
// call of a function of that name.
static Bool is_local_use(lex::Tokens tokens, Usize i) {
    if (i + 1 < countof(tokens)) {
        lex::TokenKind next = tokens[i + 1].kind;
        if (next == lex::colon_colon || next == lex::left_paren) return false;
    }
    if (i == 0) return true;
    lex::TokenKind before = tokens[i - 1].kind;
    return before != lex::dot && before != lex::arrow && before != lex::colon_colon;
}

static Bool in_file(Str source, lex::Tokens tokens, Str text) {
    for (Usize i = 0; i < countof(tokens); i++) {
        if (mem::equal(lex::text(source, tokens[i]), text)) return true;
    }
    return false;
}

export Str rename_shadows(Str source) {
    lex::Lexed lexed = lex::tokenize(source);
    if (lexed == .error) return source;
    lex::Tokens tokens = lexed.ok;
    Names modules = imported(source, tokens);
    if (countof(modules) == 0) return source;
    Places place = places(tokens);
    // A name used at the top level is a global or a function of the file: its declaration is not renamed here.
    Names kept = {};
    for (Usize i = 0; i < countof(tokens); i++) {
        if (tokens[i].kind != lex::name || place[i] == 1) continue;
        if (i > 0 && tokens[i - 1].kind == lex::kw_import) continue;
        if (i > 0 && (tokens[i - 1].kind == lex::colon_colon || is_as(source, tokens[i - 1]))) continue;
        if (i + 1 < countof(tokens) && tokens[i + 1].kind == lex::colon_colon) continue;
        if (i > 0 && (tokens[i - 1].kind == lex::dot || tokens[i - 1].kind == lex::arrow)) continue;
        Str text = lex::text(source, tokens[i]);
        if (listed(modules, text) && place[i] == 0) kept = with_name(kept, text);
    }
    Names spelled = mem::alloc_slice(ShadowName, countof(modules));
    for (Usize m = 0; m < countof(modules); m++) {
        Str next = as_str(format::push(modules[m].text, "_"));
        while (in_file(source, tokens, next)) {
            next = as_str(format::push(next, "_"));
        }
        spelled[m].text = next;
    }
    Str out = "";
    Usize at = 0;
    for (Usize i = 0; i < countof(tokens); i++) {
        if (tokens[i].kind != lex::name || place[i] != 1 || !is_local_use(tokens, i)) continue;
        Str text = lex::text(source, tokens[i]);
        if (listed(kept, text)) continue;
        for (Usize m = 0; m < countof(modules); m++) {
            if (!mem::equal(modules[m].text, text)) continue;
            out = as_str(format::push(out, source[at:tokens[i].span.start], spelled[m].text));
            at = tokens[i].span.end;
            break;
        }
    }
    if (at == 0) return source;
    return as_str(format::push(out, source[at:countof(source)]));
}
