// front::emit_state: the types every part of the emitter shares (#1119, B1 of #1112). front::emit has the entry point
// and the walk and imports the handlers of the other emit_* modules; those need the emitter's state, so the state lives
// here, in a module all of them import (a module cannot import one that imports it). front::emit re-exports the types a
// caller names (`emit::Error`, `emit::Target`, `emit::Options`). The protocol of the walk is written at the top of
// front/emit.smith.
module front::emit_state;

import front::ast;
import front::types;
import std::contract;
import std::arena;
import std::mem;
import std::format;
import <llvm-c/Core.h>;
import <llvm-c/DebugInfo.h>;
import <llvm-c/Target.h>;

// ---------------------------------------------------------------------------------------------------------------
// What the entry point takes and gives

// A problem in the tree, with the node's span. `message` is in the current allocator.
export struct Error {
    Str message;
    ast::Span span;
    // Where `span` is (#2949): the prefix of the module whose text it is an offset in (`std::test::`), empty for the
    // file being compiled; and the instance of a generic whose body was being emitted, for the error trace.
    Str module;
    Bool in_instance;
    Usize instance;
};

// What the module is emitted for. The emitter never asks the host: the triple and the data layout come from here.
// An empty `data_layout` leaves the module's unset.
export struct Target {
    Str triple;
    Str data_layout;
};

export struct Options {
    Target target;
    Str source; // the file's text, for debug info's lines (B5)
    Bool debug_info;
    Bool fill_undefined;           // a debug build fills an `undefined` local with the byte 0xAA
    const types::Checked *checked; // the checker's result for the module; null: no cast is checked (K2, #1329)
};

// What a handler returns: success, or the Error that stops the walk.
export typedef Result(Bool, Error) Status;

export Status success() {
    return true;
}

// `status` with the module its error was found in, when no inner scope named one yet (#2949).
export Status in_module(Status status, Str module) {
    if (status != .error) return status;
    Error error = status.error;
    if (countof(error.module) == 0) error.module = module;
    return {.error = error};
}

// `status` with the instance whose body was being emitted when its error was found (#2949).
export Status in_instance(Status status, Usize instance) {
    if (status != .error) return status;
    Error error = status.error;
    if (!error.in_instance) {
        error.in_instance = true;
        error.instance = instance;
    }
    return {.error = error};
}

// A message built with format::push, as the Str that fail takes.
export Str msg(char chars[:]) {
    return chars;
}

// Every `Error.message` is a string of the allocator in force when it was made (the caller of `emit::module` frees it
// with `mem::free(message.data)` when it is done), never a literal: `fail` copies the text it is given.
export Status fail(Str message, ast::Span span) {
    Error error = {.message = msg(format::push(message)), .span = span};
    return {.error = error};
}

// A failure whose message is the pieces `args`, as `format::push` takes them: `failf(span, "unknown name ", name)`.
export Status failf(ast::Span span, auto... args) {
    Error error = {.message = msg(format::push(args...)), .span = span};
    return {.error = error};
}

// "not emitted yet: <kind>" at `span`: what a stub returns.
export Status not_emitted(Str kind, ast::Span span) {
    return failf(span, "not emitted yet: ", kind);
}

// Give back a string of the allocator in force: an `Error.message`, or a copy `msg` made.
// The name an instance's function goes by: the module its template is declared in (`math_trig::`) and the name the
// checker gave it (`clamp.f64`), so two instances of the same name from two modules are two functions (#2650). A fresh
// string.
export Str instance_name(const types::Instance *instance) {
    if (instance->decl->kind != .function) return msg(format::push(""));
    return msg(format::push(instance->prefix, instance->decl->kind.function.name));
}

export void free_text(Str text) {
    mem::free((char *)(Usize)text.data);
}

// A copy of `text` in the current allocator with a terminator after it, for LLVM's names. Free it with `mem::free`.
export char *cstr(Str text) {
    return format::push(text).data;
}

// ---------------------------------------------------------------------------------------------------------------
// Types and values

export struct Ty;

// An integer: its width and signedness. `Bool` is the kind `boolean` (1 bit, unsigned); `Void` is an integer of no
// bits.
export struct IntegerTy {
    U32 bits;
    Bool is_signed;
};

// A floating-point number: its width.
export struct FloatTy {
    U32 bits;
};

// A pointer: the type it points to (null for a pointer to an unknown type, `null`'s) and its address space.
export struct PointerTy {
    Ty *element;
    U32 address_space;
};

// `?T` (the payload) and `[]T` (the element).
export struct ElementTy {
    Ty *element;
};

// An array (`count` its length), a block `[,]T` (`count` its dimensions, `element` the cell, #1710) and a vector
// `vec(T, N)` (`count` its lanes, #1630).
export struct SizedTy {
    Ty *element;
    U64 count;
};

// A tuple's elements, a `Result(T, E)`'s `ok` and `error`; owned like `element`, chained through `Emitter.owned`.
export struct PartsTy {
    Ty *parts;
    Usize part_count;
};

// A `fn` value or a C function pointer: `parts` are the parameters, `element` the result.
export struct FnTy {
    Ty *parts;
    Usize part_count;
    Ty *element;
};

// What a type is, with exactly the fields its kind has (#2600).
export typedef enum {
    IntegerTy integer;
    boolean;
    PointerTy pointer;
    SizedTy array;
    record;
    ElementTy option; // `?T`: `element` is the payload
    PartsTy tuple;    // `parts` are the elements
    FnTy fn_value;    // `parts` are the parameters, `element` the result
    FnTy fn_pointer;  // a C function pointer (a field of a header's struct): the bare `ptr`
    ElementTy slice;
    FloatTy floating;
    SizedTy block;  // `[,]T`, `[,,]T`: `{ ptr, [count x usize] }`
    SizedTy vector; // `vec(T, N)`
    PartsTy result; // `Result(T, E)`: `{ i8 tag, T ok, E error }`, `parts` are `ok` and `error` (tag 0 ok, 1 error)
    variant_enum; // a payload enumeration: `{ i32 tag, [N x i64] payloads }`, the tag is the variant's position (#2140)
} TyKind;

// A type as the emitter knows it: the LLVM type, the name as written and what LLVM's does not say, by kind.
export struct Ty {
    TyKind kind;
    c::LLVMTypeRef llvm;
    Str name;
};

// A type, or the reason there is none.
export typedef Result(Ty, Error) TyResult;

// The name of a type's kind in the tree (`tuple`, `pointer`), for the messages that say which kind is not emitted yet
// (#2949).
export Str type_kind_name(const ast::TypeExpr *t) {
    if (t->kind == .named) return "named";
    if (t->kind == .auto_type) return "auto_type";
    if (t->kind == .pointer) return "pointer";
    if (t->kind == .array) return "array";
    if (t->kind == .slice) return "slice";
    if (t->kind == .function) return "function";
    if (t->kind == .applied) return "applied";
    if (t->kind == .type_of) return "type_of";
    if (t->kind == .unsupported_c) return "unsupported_c";
    if (t->kind == .record) return "record";
    if (t->kind == .tuple) return "tuple";
    if (t->kind == .option) return "option";
    if (t->kind == .block_type) return "block_type";
    return "unknown";
}

// The name of an expression's kind in the tree (`call`, `member`), for the messages that say which expression lacks a
// checked type (#2949).
export Str expr_kind_name(const ast::Expr *x) {
    if (x->kind == .integer) return "integer";
    if (x->kind == .floating) return "floating";
    if (x->kind == .character) return "character";
    if (x->kind == .string) return "string";
    if (x->kind == .boolean) return "boolean";
    if (x->kind == .null_pointer) return "null_pointer";
    if (x->kind == .name) return "name";
    if (x->kind == .variant) return "variant";
    if (x->kind == .type_value) return "type_value";
    if (x->kind == .unary) return "unary";
    if (x->kind == .binary) return "binary";
    if (x->kind == .assign) return "assign";
    if (x->kind == .conditional) return "conditional";
    if (x->kind == .call) return "call";
    if (x->kind == .index) return "index";
    if (x->kind == .slice_of) return "slice_of";
    if (x->kind == .member) return "member";
    if (x->kind == .cast) return "cast";
    if (x->kind == .query) return "query";
    if (x->kind == .compound) return "compound";
    if (x->kind == .lambda) return "lambda";
    if (x->kind == .try_expr) return "try_expr";
    if (x->kind == .reflect_member) return "reflect_member";
    if (x->kind == .expand) return "expand";
    if (x->kind == .named_arg) return "named_arg";
    if (x->kind == .tuple_lit) return "tuple_lit";
    if (x->kind == .array_lit) return "array_lit";
    if (x->kind == .stmt_expr) return "stmt_expr";
    if (x->kind == .generic_select) return "generic_select";
    if (x->kind == .pattern_test) return "pattern_test";
    return "unknown";
}

// A type that cannot be made, its message the pieces `args` as `format::push` takes them (#2949).
export TyResult ty_fail_with(ast::Span span, auto... args) {
    Error error = {.message = msg(format::push(args...)), .span = span};
    return {.error = error};
}

// A type that cannot be made.
export TyResult ty_fail(Str message, ast::Span span) {
    Error error = {.message = msg(format::push(message)), .span = span};
    return {.error = error};
}

// The type a literal takes where it stands, when there is one.
export struct Hint {
    Bool present;
    Ty ty;
};

// A value on the value stack. For a place (see `Work.place`), `llvm` is the address and `ty` the type stored there.
export struct Value {
    c::LLVMValueRef llvm;
    Ty ty;
};

// A function of the module: declared in the first pass so that a call (B3a) finds any of them.
export struct FunctionInfo {
    Str name;   // as written
    Str symbol; // the LLVM name, `front::test::add`
    c::LLVMValueRef llvm;
    c::LLVMTypeRef llvm_type;
    Ty result;
    Bool variadic; // defined with `...`: a call may pass more arguments than params
    Ty params[:];
};

export struct Local {
    Str name;
    Ty ty;
    c::LLVMValueRef address; // the alloca
};

export struct LoopTarget {
    c::LLVMBasicBlockRef break_block;
    c::LLVMBasicBlockRef continue_block;
    Usize scope_depth; // `e->scope_count` when the loop's body starts
};

// A `defer`red statement, run when the block it was in ends: the scope depth is `scope_count` when it was pushed.
export struct DeferEntry {
    const ast::Stmt *body;
    Usize scope_depth;
    Bool on_error; // an `errdefer`: it runs only on the early return of a `try`
};

// An enumeration of the module: its enumerators and their values (filled by emit_match).
export struct Enumerator {
    Str name;
    U64 value;
    Bool has_payload; // a payload enumeration's variant `circle: Circle`
    Ty payload;
};

// (A slice of `Str` is not a field type today, so the enumerators are one slice of pairs, not `names` and `values`.)
export struct EnumType {
    Str name;
    Ty ty;
    Enumerator items[:];
};

export struct FieldInfo {
    Str name;
    Ty ty;
    ast::Expr *default_value; // `x: T = 3`: written for a construction that leaves the field out (null: none)
};

export struct RecordType {
    Str name;
    Ty ty;
    FieldInfo fields[:];
    Bool overlay;    // a C union: every field is at offset 0 of the one array that sizes it (a field is read in place)
    Bool shell;      // named so a record above it can point to it; its fields come when its own declaration is reached
    Bool forward;    // declared with no body (`struct X;`): the declaration with a body completes it
    Bool owned_name; // an anonymous struct's key (front/emit_record.smith): `release` frees the name with the fields
};

// The state of a function whose lambda is being emitted in the middle of it (#1620, front/emit_lambda.smith):
// everything the lambda's own function replaces, and what its end needs to finish the lambda.
export struct SavedFunction {
    c::LLVMValueRef function;
    c::LLVMBasicBlockRef entry_block;
    c::LLVMBasicBlockRef trap_block;
    Ty result;
    Local locals[:];
    Usize local_count;
    Usize scope_marks[:];
    Usize scope_count;
    LoopTarget loops[:];
    Usize loop_count;
    DeferEntry defers[:];
    Usize defer_count;
    c::LLVMBasicBlockRef insert_block; // where the enclosing function's code was going
    c::LLVMValueRef lambda_function;   // the lambda's own function
    Ty fn_ty;                          // the lambda's `fn` type
    c::LLVMValueRef *loads;            // per enclosing local: the load of its address from the context, in the lambda
    Bool argument;                     // an argument of a call: it may capture, by reference
};

// ---------------------------------------------------------------------------------------------------------------
// The walk's work

export struct Emitter;

// Where a conversion happens: it names the Error when there is none.
export typedef enum {
    initialize;   // "initializing X with Y"
    return_value; // "returning Y from a function that returns X"
    assign;       // "assigning Y to X"
} ConvertSite;

// A `then` item: a continuation and the data its pusher stored for it, in the shape that continuation reads. Each shape
// carries its own kind of continuation, so a continuation's parameter holds exactly the fields it uses.
export struct ThenNone;
export struct ThenExpr;
export struct ThenBlocks;
export struct ThenGeneral;

export typedef Status (*NoneRun)(Emitter *e, const ThenNone *w);
export typedef Status (*ExprRun)(Emitter *e, const ThenExpr *w);
export typedef Status (*BlocksRun)(Emitter *e, const ThenBlocks *w);
export typedef Status (*Continuation)(Emitter *e, const ThenGeneral *w);

// A continuation that reads only what the work before it pushed.
export struct ThenNone {
    NoneRun run;
    ast::Span span;
};

// A continuation of an expression: an operator's finish, which reads its node.
export struct ThenExpr {
    ExprRun run;
    const ast::Expr *expr;
    ast::Span span;
};

// A continuation that closes a branch or a loop: it jumps to or positions at its blocks.
export struct ThenBlocks {
    BlocksRun run;
    c::LLVMBasicBlockRef blocks[3];
    ast::Span span;
};

// Temporary: every continuation not yet given a shape of its own. Only the fields its continuation reads mean anything.
// #2584 (statements), #2589 (expressions) and #2590 (match, option, iter, stream, lambda) move them off, and #2590
// deletes this.
export struct ThenGeneral {
    Continuation run;
    Continuation branch; // an `if let` used as a value: what runs each branch (stores its last line into `value`)
    const ast::Expr *expr;
    const ast::Stmt *stmt;
    const ast::Decl *decl;
    Hint hint;
    Ty ty;
    U64 number; // a continuation's own datum: an operator, a count
    Bool flag;
    c::LLVMBasicBlockRef blocks[3];
    c::LLVMValueRef value;
    ast::Span span;
};

export typedef enum {
    ThenNone none;
    ThenExpr expr;
    ThenBlocks blocks;
    ThenGeneral general;
} Then;

// One unit of work.
export typedef enum {
    struct {
        const ast::Expr *expr;
        Hint hint;
    } eval; // evaluate `expr` (with `hint`): the handler of its kind pushes one Value
    struct {
        const ast::Expr *expr;
    } place; // evaluate `expr` as an address: pushes one Value whose `llvm` is the address
    struct {
        const ast::Stmt *stmt;
    } statement; // emit `stmt`
    Then then;   // call the continuation with its data: it pops what the work before it pushed
} Work;

// ---------------------------------------------------------------------------------------------------------------
// The emitter

// The three hooks emit.smith sets: what a handler cannot call without importing front::emit (a cycle).
export typedef TyResult (*TypeHook)(Emitter *e, const ast::TypeExpr *t);
export typedef TyResult (*NodeTypeHook)(Emitter *e, const ast::Expr *x);
export typedef TyResult (*CheckedTypeHook)(Emitter *e, types::TypeRef t, ast::Span span);
export typedef Status (*ConvertHook)(Emitter *e, Value value, Ty to, ast::Span span, ConvertSite site);
export typedef Status (*FoldHook)(Emitter *e, const ast::Expr *x, Ty to, c::LLVMValueRef *out);

// Every field the tickets after B1 need. A ticket that finds one missing escalates; it does not edit this.
// A block a type's `element` or `parts` points to, and the next one; `ty` is first, so a block's address is the
// element's.
export struct OwnedTy {
    Ty ty;
    OwnedTy *next;
};

export struct Emitter {
    c::LLVMContextRef context;
    c::LLVMModuleRef module;
    c::LLVMBuilderRef builder;        // where code goes
    c::LLVMBuilderRef alloca_builder; // positioned before the entry block's branch: every alloca goes there
    c::LLVMTargetDataRef target_data; // null when the target has no data layout
    Options options;
    const ast::Module *tree;

    FunctionInfo functions[:]; // the module's functions, in order
    Usize function_count;

    // The function being emitted.
    c::LLVMValueRef function;
    c::LLVMBasicBlockRef entry_block;
    c::LLVMBasicBlockRef trap_block; // created when the first check needs it, null before
    Ty result;                       // the function's result type

    Local locals[:]; // the visible locals, newest last
    Usize local_count;
    Usize scope_marks[:]; // local_count at the start of each open scope
    Usize scope_count;

    LoopTarget loops[:]; // B2: the innermost last
    Usize loop_count;
    DeferEntry defers[:]; // B2
    Usize defer_count;

    RecordType records[:]; // B3b
    Usize record_count;

    EnumType enums[:]; // #1585: the module's enumerations
    Usize enum_count;
    SavedFunction lambda_frames[:]; // the enclosing functions of the lambda being emitted, innermost last (#1620)
    Usize lambda_frame_count;

    Error errors[:]; // every error found so far, in order: emit goes on past a failed declaration (#2982)
    Usize error_count;
    Usize skipped[:]; // the declarations that failed to declare, by index in the tree (instances: after the tree's)
    Usize skipped_count;

    Str instance_scope; // while the body of a generic's instance from another module is emitted: that module's prefix
    Str import_scope;   // while an imported function's signature is typed: its module's path and `::` (`geom::vec::`)
    const ast::TypeExpr *scoped_leaf; // the name `leaf_type` handed back to `type_of` in an import scope: a second
                                      // visit is an unknown type, not a loop (the 19 crashes of #2984)
    const types::Instance *instance;  // while a generic's instance is emitted: its bindings (`T` of `sizeof(T)`)
    const ast::Decl
        *local_types[16]; // the constants of the body being emitted that hold a type (`const T = typeof(x)`)
    Usize local_type_count;
    TypeHook type_hook;
    NodeTypeHook node_type_hook;
    CheckedTypeHook checked_type_hook; // a checker type as a `Ty`: the parameters of a C function (#1762)
    ConvertHook convert_hook;
    Bool folding;       // inside a static_assert or a global's initializer: a `const` integer global reads as its value
    FoldHook fold_hook; // an expression built and folded to a constant (a global's initializer, #2510)

    Work work[:]; // the work stack, the next to run last
    Usize work_count;
    Value values[:]; // the value stack
    Usize value_count;

    // B5: null when debug info is off.
    c::LLVMDIBuilderRef debug_builder;
    c::LLVMMetadataRef compile_unit;
    c::LLVMMetadataRef file;
    c::LLVMMetadataRef scope;
    U32 line_starts[:];  // the byte offset of each line of `options.source`, built once by `debug::begin_module`
    U32 parameters_left; // parameters of the function not yet declared
    U32 next_parameter;  // the `arg:` number of the next one

    // The blocks a type's `element` and `parts` point to, chained so `memory::release` frees them (B3b).
    OwnedTy *owned;
};

// ---------------------------------------------------------------------------------------------------------------
// Helpers for handlers

// Keeps `error` and lets the walk go on with the next declaration (#2982).
export void add_error(Emitter *e, Error error) {
    if (e->error_count == countof(e->errors)) {
        Usize capacity = countof(e->errors) * 2;
        if (capacity < 8) capacity = 8;
        e->errors = mem::realloc(e->errors, capacity);
    }
    e->errors[e->error_count] = error;
    e->error_count += 1;
}

// Keeps the error of `status`, if it has one; whether it had.
export Bool collect(Emitter *e, Status status) {
    if (status != .error) return false;
    add_error(e, status.error);
    return true;
}

// Marks declaration `index` as not declared: its body is not emitted.
export void skip_declaration(Emitter *e, Usize index) {
    if (e->skipped_count == countof(e->skipped)) {
        Usize capacity = countof(e->skipped) * 2;
        if (capacity < 8) capacity = 8;
        e->skipped = mem::realloc(e->skipped, capacity);
    }
    e->skipped[e->skipped_count] = index;
    e->skipped_count += 1;
}

export Bool is_skipped(const Emitter *e, Usize index) {
    for (Usize i = 0; i < e->skipped_count; i++) {
        if (e->skipped[i] == index) return true;
    }
    return false;
}

export void push_work(Emitter *e, Work item) {
    if (e->work_count == countof(e->work)) {
        Usize capacity = countof(e->work) * 2;
        if (capacity < 64) capacity = 64;
        e->work = mem::realloc(e->work, capacity);
    }
    e->work[e->work_count] = item;
    e->work_count += 1;
}

// Evaluate `x` next (before the work already on the stack). `has_hint` says whether `hint` is meant.
export void push_eval(Emitter *e, const ast::Expr *x, Hint hint) {
    Work item = {.eval = {.expr = x, .hint = hint}};
    push_work(e, item);
}

export void push_place(Emitter *e, const ast::Expr *x) {
    Work item = {.place = {.expr = x}};
    push_work(e, item);
}

export void push_statement(Emitter *e, const ast::Stmt *s) {
    Work item = {.statement = {.stmt = s}};
    push_work(e, item);
}

// Run `item.run(e, &item)` once everything pushed after it has run: one function for each shape of `Then`.
export void push_then_none(Emitter *e, ThenNone item) {
    Then then = {.none = item};
    Work work = {.then = then};
    push_work(e, work);
}

export void push_then_expr(Emitter *e, ThenExpr item) {
    Then then = {.expr = item};
    Work work = {.then = then};
    push_work(e, work);
}

export void push_then_blocks(Emitter *e, ThenBlocks item) {
    Then then = {.blocks = item};
    Work work = {.then = then};
    push_work(e, work);
}

export void push_then_general(Emitter *e, ThenGeneral item) {
    Then then = {.general = item};
    Work work = {.then = then};
    push_work(e, work);
}

// A branch of an `if let`: a statement, or (when `w` carries a `branch`) work that stores the branch's value in
// `w->value`.
export void push_branch(Emitter *e, const ThenGeneral *w, const ast::Stmt *s) {
    if (w->branch == nullptr) {
        push_statement(e, s);
        return;
    }
    ThenGeneral item = {.run = w->branch, .stmt = s, .ty = w->ty, .value = w->value, .span = s->span};
    push_then_general(e, item);
}

export void push_value(Emitter *e, Value value) {
    if (e->value_count == countof(e->values)) {
        Usize capacity = countof(e->values) * 2;
        if (capacity < 64) capacity = 64;
        e->values = mem::realloc(e->values, capacity);
    }
    e->values[e->value_count] = value;
    e->value_count += 1;
}

// The newest value; a continuation pops what its pushers pushed, so the stack is never empty there.
export Value pop_value(Emitter *e) {
    contract::requires(e->value_count > 0);
    e->value_count -= 1;
    return e->values[e->value_count];
}

// The newest value, left on the stack.
export Value peek_value(Emitter *e) {
    contract::requires(e->value_count > 0);
    return e->values[e->value_count - 1];
}

// The loop targets: the last pop gives the slice back (`realloc(xs, 0)` frees it and gives the empty slice).
export void push_loop(Emitter *e, LoopTarget target) {
    if (e->loop_count == countof(e->loops)) {
        Usize capacity = countof(e->loops) * 2;
        if (capacity < 4) capacity = 4;
        e->loops = mem::realloc(e->loops, capacity);
    }
    e->loops[e->loop_count] = target;
    e->loop_count += 1;
}

export void pop_loop(Emitter *e) {
    e->loop_count -= 1;
    if (e->loop_count == 0) e->loops = mem::realloc(e->loops, 0);
}

// The type a type expression says.
export TyResult type_of(Emitter *e, const ast::TypeExpr *t) {
    return e->type_hook(e, t);
}

// The checker's type of an expression, as a `Ty`.
export TyResult type_of_node(Emitter *e, const ast::Expr *x) {
    return e->node_type_hook(e, x);
}

// A type the checker names, as a `Ty`.
export TyResult type_of_checked(Emitter *e, types::TypeRef t, ast::Span span) {
    return e->checked_type_hook(e, t, span);
}

// Pushes `value` as a `to`, or the Error for `site`.
export Status convert(Emitter *e, Value value, Ty to, ast::Span span, ConvertSite site) {
    return e->convert_hook(e, value, to, span, site);
}

// `x` as the constant of type `to` it folds to, or the Error when it is not known at compile time.
export Status fold(Emitter *e, const ast::Expr *x, Ty to, c::LLVMValueRef *out) {
    return e->fold_hook(e, x, to, out);
}

export Hint no_hint() {
    return (Hint){};
}

export Hint hint_of(Ty ty) {
    return (Hint){.present = true, .ty = ty};
}

// The same text byte for byte (a literal converts to `Str`, so `same_text(name, "I8")` is fine).
export Bool same_text(Str a, Str b) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// Whether the instance being emitted binds the type `name` (`T` of `fn max(T: type)` called as `max(usize)`), and
// to what; false outside an instance or for any other name: a type parameter read as a value (`sizeof(T)`, `x.wrap(T)`)
// (#2497).
export Bool bound_type(const Emitter *e, Str name, types::TypeRef *found) {
    if (e->instance == nullptr) return false;
    for (Usize i = 0; i < countof(e->instance->bindings); i++) {
        types::Binding b = e->instance->bindings[i];
        if (b.is_type && same_text(b.name, name)) {
            *found = b.type;
            return true;
        }
    }
    return false;
}

// Whether a local declaration is a constant that holds a type (`const Element = typeof(xs[0])`, #3039): the checker
// made its name a name of that type, and nothing is stored for it.
export Bool is_local_type(const ast::Decl *d) {
    if (d->kind != .variable || !d->kind.variable.is_new || d->kind.variable.is_mut) return false;
    const ast::Expr *init = d->kind.variable.init;
    if (init == nullptr) return false;
    if (init->kind == .name) return true; // `wide: type = u16`
    if (init->kind == .call) return true; // `W := widen(T)`: the checker marked it when the call makes a type
    return init->kind == .type_value && init->kind.type_value.type != nullptr;
}

// The checker's number of the instance being emitted (`types::max_instances` outside one): what it recorded for a
// node of a generic's body is kept per instance.
export Usize instance_number(const Emitter *e) {
    Usize index = types::max_instances;
    if (e->options.checked == nullptr) return index;
    for (Usize i = 0; e->instance != nullptr && i < e->options.checked->instance_count; i++) {
        if (&e->options.checked->instances[i] == e->instance) index = i;
    }
    return index;
}

// The type a constant of the body being emitted holds when a call made it (`W := widen(T)`): the checker's. Null
// when `name` is not one.
export types::TypeRef local_made(const Emitter *e, Str name) {
    for (Usize i = e->local_type_count; i > 0; i--) {
        const ast::Decl *d = e->local_types[i - 1];
        if (d->kind != .variable || !same_text(d->kind.variable.name, name)) continue;
        const ast::Expr *init = d->kind.variable.init;
        if (init == nullptr || init->kind != .call) return nullptr;
        return types::held_type(e->options.checked, d, instance_number(e));
    }
    return nullptr;
}

// The type a constant of the body being emitted holds, as it is written; null when `name` is not one.
export const ast::TypeExpr *local_type(const Emitter *e, Str name) {
    for (Usize i = e->local_type_count; i > 0; i--) {
        const ast::Decl *d = e->local_types[i - 1];
        if (d->kind == .variable && same_text(d->kind.variable.name, name)) {
            const ast::Expr *init = d->kind.variable.init;
            if (init != nullptr && init->kind == .type_value) return init->kind.type_value.type;
            if (init != nullptr && init->kind == .name) {
                ast::TypeExpr *written = mem::alloc(ast::TypeExpr);
                written->span = init->span;
                written->kind = (ast::TypeKind){.named = {.path = init->kind.name.path}};
                return written;
            }
        }
    }
    return nullptr;
}

// Whether a number is signed: a signed integer or a floating-point number; false for any other type.
export Bool is_signed(Ty ty) {
    if (ty.kind == .integer) return ty.kind.integer.is_signed;
    return ty.kind == .floating;
}

// The bits of a number: an integer's or a floating-point number's width, 1 for `Bool`; 0 for any other type.
export U32 width(Ty ty) {
    if (ty.kind == .integer) return ty.kind.integer.bits;
    if (ty.kind == .floating) return ty.kind.floating.bits;
    if (ty.kind == .boolean) return 1;
    return 0;
}

// LLVM's types are unique in a context, so the same LLVM type and signedness is the same type.
export Bool same_type(Ty a, Ty b) {
    return a.llvm == b.llvm && is_signed(a) == is_signed(b);
}

// Two numbers of different types: the narrower one widens to the other's type (the checker has allowed only the
// conversions that lose nothing, #2531: `u8` to `i32`, `i32` to `f64`). Pushes nothing; `left` and `right` are updated.
export Status unify_operands(Emitter *e, Value *left, Value *right, ast::Span span) {
    Ty l = left->ty;
    Ty r = right->ty;
    Bool numbers = (l.kind == .integer || l.kind == .floating) && (r.kind == .integer || r.kind == .floating);
    if (!numbers || same_type(l, r)) return success();
    Bool right_wider = r.kind == .floating;
    if ((l.kind == .floating) == (r.kind == .floating)) {
        right_wider = width(r) > width(l);
        if (is_signed(l) != is_signed(r)) right_wider = is_signed(r);
    }
    Ty from = right_wider ? l : r;
    Ty to = right_wider ? r : l;
    Bool lossless = width(to) > width(from) && (is_signed(from) == is_signed(to) || !is_signed(from));
    if (to.kind == .integer && from.kind == .integer && !lossless) return success(); // the caller reports the mismatch
    if (right_wider) {
        try convert(e, *left, r, span, .assign);
        *left = pop_value(e);
    } else {
        try convert(e, *right, l, span, .assign);
        *right = pop_value(e);
    }
    return success();
}

// The one place a pointer type is made, so that B3b can give it an address space.
export c::LLVMTypeRef pointer_type(Emitter *e, U32 address_space) {
    return c::LLVMPointerTypeInContext(e->context, address_space);
}

// A zeroed slot in the entry block.
// The LLVM type a parameter of type `ty` has in a function's signature: an array is passed as a pointer to its first
// element (C's rule, so a header's `int32_t xs[4]` is what a C caller can call); every other type as it is.
export c::LLVMTypeRef abi_type(Emitter *e, Ty ty) {
    if (ty.kind == .array) return c::LLVMPointerTypeInContext(e->context, 0);
    return ty.llvm;
}

export c::LLVMValueRef new_alloca(Emitter *e, Ty ty, Str name) {
    char *label = cstr(name);
    c::LLVMValueRef slot = c::LLVMBuildAlloca(e->alloca_builder, ty.llvm, label);
    mem::free(label);
    return slot;
}

// Stores `value` at `slot`. A struct or an array whose value is all zeros (`Work()` with every field defaulted to its
// zero) is one clear, a `memset`, as C's `{0}` is (#2543): stored as an aggregate it is one store per field, since
// the new front end runs no optimizer.
export void store(Emitter *e, c::LLVMValueRef value, c::LLVMValueRef slot) {
    c::LLVMTypeRef type = c::LLVMTypeOf(value);
    c::LLVMTypeKind kind = c::LLVMGetTypeKind(type);
    Bool aggregate = kind == c::LLVMStructTypeKind || kind == c::LLVMArrayTypeKind;
    if (aggregate && c::LLVMIsConstant(value) != 0 && c::LLVMIsNull(value) != 0) {
        c::LLVMTypeRef byte = c::LLVMInt8TypeInContext(e->context);
        c::LLVMBuildMemSet(e->builder, slot, c::LLVMConstInt(byte, 0, 0), c::LLVMSizeOf(type), 1);
        return;
    }
    c::LLVMBuildStore(e->builder, value, slot);
}

export void add_local(Emitter *e, Local local) {
    if (e->local_count == countof(e->locals)) {
        Usize capacity = countof(e->locals) * 2;
        if (capacity < 16) capacity = 16;
        e->locals = mem::realloc(e->locals, capacity);
    }
    e->locals[e->local_count] = local;
    e->local_count += 1;
}

// The newest local of that name; false when there is none.
export Bool find_local(Emitter *e, Str name, Local *found) {
    for (Usize i = e->local_count; i > 0; i--) {
        if (same_text(e->locals[i - 1].name, name)) {
            *found = e->locals[i - 1];
            return true;
        }
    }
    return false;
}

export void begin_scope(Emitter *e) {
    if (e->scope_count == countof(e->scope_marks)) {
        Usize capacity = countof(e->scope_marks) * 2;
        if (capacity < 16) capacity = 16;
        e->scope_marks = mem::realloc(e->scope_marks, capacity);
    }
    e->scope_marks[e->scope_count] = e->local_count;
    e->scope_count += 1;
}

export void end_scope(Emitter *e) {
    contract::requires(e->scope_count > 0);
    e->scope_count -= 1;
    e->local_count = e->scope_marks[e->scope_count];
}

// The body of a union: an array of integers as wide as the strictest alignment of its members (at most 8 bytes), as
// big as the biggest member rounded up to it. False without a data layout.
export Bool union_body(Emitter *e, c::LLVMTypeRef named, const Ty fields[:]) {
    if (e->target_data == nullptr) return false;
    U64 size = 0;
    U64 align = 1;
    for (Usize i = 0; i < countof(fields); i++) {
        U64 own = c::LLVMABISizeOfType(e->target_data, fields[i].llvm);
        U64 own_align = (U64)c::LLVMABIAlignmentOfType(e->target_data, fields[i].llvm);
        if (own > size) size = own;
        if (own_align > align) align = own_align;
    }
    U64 unit = align > 8 ? 8 : align;
    U64 rounded = (size + align - 1) / align * align;
    c::LLVMTypeRef lanes[1] = {nullptr};
    lanes[0] = c::LLVMArrayType2(c::LLVMIntTypeInContext(e->context, (U32)(unit * 8)), rounded / unit);
    c::LLVMStructSetBody(named, lanes, 1, 0);
    return true;
}

// A pointer's width in bits on the target; 64 when it has no data layout (the rule of emit_debug's `pointer_bits`).
static U32 pointer_bits(Emitter *e) {
    if (e->target_data == nullptr) return 64;
    return (U32)c::LLVMPointerSize(e->target_data) * 8;
}

// The type a name says, for the names of the integer types, `char` and `bool`; `found` false for any other. Both
// spellings answer with the same type: smith's own `i8 i16 i32 i64 u8 u16 u32 u64 isize usize bool char` and today's
// `I8 .. I64`, `U8 .. U64`, `Isize`, `Usize`, `Bool`, `Char`. `Ty.name` is the name as written. `isize` and `usize` are
// as wide as a pointer on the target (`LLVMPointerSize` of its data layout, 64 bits when it has none), never the
// host's. `char` is the checker's character type: unsigned, 8 bits, the layout of `u8`.
export Bool scalar_type(Emitter *e, Str name, Ty *ty) {
    U32 bits = 0;
    Bool signed_int = false;
    Bool is_bool = false;
    if (same_text(name, "I8") || same_text(name, "i8")) {
        bits = 8;
        signed_int = true;
    } else if (same_text(name, "I16") || same_text(name, "i16")) {
        bits = 16;
        signed_int = true;
    } else if (same_text(name, "I32") || same_text(name, "i32")) {
        bits = 32;
        signed_int = true;
    } else if (same_text(name, "I64") || same_text(name, "i64")) {
        bits = 64;
        signed_int = true;
    } else if (same_text(name, "I128") || same_text(name, "i128")) {
        bits = 128;
        signed_int = true;
    } else if (same_text(name, "Isize") || same_text(name, "isize")) {
        bits = pointer_bits(e);
        signed_int = true;
    } else if (same_text(name, "U8") || same_text(name, "u8") || same_text(name, "Char") || same_text(name, "char")) {
        bits = 8;
    } else if (same_text(name, "U16") || same_text(name, "u16")) {
        bits = 16;
    } else if (same_text(name, "U32") || same_text(name, "u32")) {
        bits = 32;
    } else if (same_text(name, "U64") || same_text(name, "u64")) {
        bits = 64;
    } else if (same_text(name, "U128") || same_text(name, "u128")) {
        bits = 128;
    } else if (same_text(name, "Usize") || same_text(name, "usize")) {
        bits = pointer_bits(e);
    } else if (same_text(name, "Bool") || same_text(name, "bool")) {
        bits = 1;
        is_bool = true;
    } else {
        return false;
    }
    Ty t = {.kind = {.integer = {.bits = bits, .is_signed = signed_int}}, .name = name};
    if (is_bool) t.kind = .boolean;
    t.llvm = c::LLVMIntTypeInContext(e->context, bits);
    *ty = t;
    return true;
}

// `@c_name` or today's `[[std::c_name]]`.
export Bool is_c_name(ast::Attribute attribute) {
    ast::Path name = attribute.name;
    Usize n = countof(name.segments);
    if (n == 1) return same_text(name.segments[0].text, "c_name");
    return n == 2 && same_text(name.segments[0].text, "std") && same_text(name.segments[1].text, "c_name");
}

// `@align(N)` on a global or a local (D18): the LLVM alignment of its storage. `N` is an integer literal (a power of
// two, checked by the checker); anything else is left as the type's own alignment.
export void apply_align(const ast::Decl *d, c::LLVMValueRef storage) {
    for (Usize i = 0; i < countof(d->attributes); i++) {
        ast::Attribute attribute = d->attributes[i];
        if (countof(attribute.name.segments) != 1 || !same_text(attribute.name.segments[0].text, "align")) continue;
        if (countof(attribute.args) != 1) continue;
        const ast::Expr *argument = attribute.args[0];
        if (argument->kind == .integer) c::LLVMSetAlignment(storage, (U32)argument->kind.integer.value);
    }
}

// The function's c_name, or "" when it has none (checked by `check_function`).
export Str c_name_of(const ast::Decl *d) {
    for (Usize i = 0; i < countof(d->attributes); i++) {
        ast::Attribute attribute = d->attributes[i];
        if (!is_c_name(attribute) || countof(attribute.args) == 0) continue;
        const ast::Expr *argument = attribute.args[0];
        if (argument->kind == .string) return argument->kind.string.bytes;
    }
    return "";
}
