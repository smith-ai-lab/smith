// front::fix_option, the fix-it for an option given to a pointer parameter that tests for null (#2648).
//
//   if (n->next == nullptr) return 0;       if n.next == .none: return 0     (the field is `?*Node`)
//   return count(n->next);                  return count(n.next)
//   static I32 count(Node *n) {             fn count(n: ?*Node) -> i32:
//       if (n == nullptr) return 0;             if n == .none: return 0
//                                                ...
//
// C passes a null pointer to a function that checks for it; a field that some construction leaves null is `?*T` in
// smith, and the checker says "a value that may be absent is not a value". The function is the one that is written
// for a null (it tests the parameter against `nullptr` or `.none`), so its parameter is the option: this pass writes
// `?` before the parameter's pointer type, and the passes that follow turn the tests into `.none` and narrow the
// name. Only a function of the same module is mended (a fix edits one file), and only a call written `name(args)`.
// Tests: `tests/front_fix_option_test.smith`.
//
//   fix_option::edits(source, module, checked)   one fix for each such parameter
module front::fix_option;

import front::ast;
import front::parse as core;
import front::types;
import std::mem;

static Bool word_char(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
}

static Bool starts_with(Str text, Str prefix) {
    if (countof(text) < countof(prefix)) return false;
    for (Usize i = 0; i < countof(prefix); i++)
        if (text[i] != prefix[i]) return false;
    return true;
}

static Bool contains(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++)
        if (starts_with(text[i:countof(text)], needle)) return true;
    return false;
}

static Bool same(Str a, Str b) {
    return countof(a) == countof(b) && starts_with(a, b);
}

// Where the call that holds the argument at `at` opens, and which argument it is: the `(` before it, or `at` when
// the argument is in no call (a bracket or a brace opens first).
static Usize call_open(Str source, Usize at, Usize *index) {
    Usize depth = 0;
    Usize open = at;
    *index = 0;
    while (open > 0) {
        open -= 1;
        char ch = source[open];
        if (ch == ')' || ch == ']' || ch == '}') {
            depth += 1;
        } else if (ch == '(' || ch == '[' || ch == '{') {
            if (depth > 0) {
                depth -= 1;
            } else if (ch == '(') {
                return open;
            } else {
                return at;
            }
        } else if (ch == ',' && depth == 0) {
            *index += 1;
        }
    }
    return at;
}

// The function of the module named `name`, or null.
static const ast::Decl *function_named(const ast::Module *module, Str name) {
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind == .function && same(d->kind.function.name, name)) return d;
    }
    return nullptr;
}

// Whether the text of the function tests `name` against null: `name == nullptr`, `name != .none` and the like.
static Bool tests_for_null(Str body, Str name) {
    Str tests[4] = {" == nullptr", " != nullptr", " == .none", " != .none"};
    for (Usize i = 0; i + countof(name) < countof(body); i++) {
        if (!starts_with(body[i:countof(body)], name)) continue;
        if (i > 0 && (word_char(body[i - 1]) || body[i - 1] == '.')) continue;
        for (Usize k = 0; k < 4; k++)
            if (starts_with(body[i + countof(name):countof(body)], tests[k])) return true;
    }
    return false;
}

static Bool seen(core::Errors out, Usize at) {
    for (Usize i = 0; i < countof(out); i++)
        if (out[i].span.start == at) return true;
    return false;
}

export core::Errors edits(Str source, const ast::Module *module, const types::Checked *c) {
    core::Errors out = {};
    for (Usize i = 0; i < c->error_count; i++) {
        types::Error found = c->errors[i];
        if (countof(found.fix) > 0 || found.span.end > countof(source) || found.span.start >= found.span.end) continue;
        if (!starts_with(found.message, "expected ") || !contains(found.message, ", found Option(") ||
            !contains(found.message, "a value that may be absent is not a value"))
            continue;
        Usize index = 0;
        Usize open = call_open(source, found.span.start, &index);
        if (open == found.span.start) continue;
        Usize stop = open;
        Usize start = stop;
        while (start > 0 && word_char(source[start - 1]))
            start -= 1;
        if (start == stop || (start > 0 && (source[start - 1] == '.' || source[start - 1] == ':'))) continue;
        const ast::Decl *callee = function_named(module, source[start:stop]);
        if (callee == nullptr || index >= countof(callee->kind.function.params)) continue;
        const ast::Param *param = &callee->kind.function.params[index];
        if (param->is_pack || param->is_keyword || param->type == nullptr || param->type->kind != .pointer) continue;
        U32 at = param->type->span.start;
        if (seen(out, at) || callee->span.end > countof(source)) continue;
        if (!tests_for_null(source[callee->span.start:callee->span.end], param->name)) continue;
        core::Edits fix = {};
        fix = mem::realloc(fix, 1);
        fix[0] = (core::Edit){.span = {.start = at, .end = at}, .text = "?"};
        core::ParseError made = {};
        made.span = {.start = at, .end = at};
        made.message = "a parameter that is tested for null and given an option is `?*T`";
        made.fix = fix;
        out = mem::realloc(out, countof(out) + 1);
        out[countof(out) - 1] = made;
    }
    return out;
}
