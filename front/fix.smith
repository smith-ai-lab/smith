// front::fix, `smith lint --fix` (#1442, S6 of #1428): the fixes that parse errors carry (front::parse's `Edit`),
// applied to a file's text.
//
//   fix::apply_fixes(source, errors, warnings)
//                                     the text with the fixes of the errors, then of the warnings (the wider first),
//                                     applied: a fix (all its edits or none) is taken when no edit of it overlaps one
//                                     already taken, else it is skipped
//   fix::fix_file(path)               one file mended in place: parse, apply, and again until nothing applies (at most
//                                     8 passes); the number of fixes applied, -1 when the file cannot be read or
//                                     written
//   fix::fix_text(file, source)       the same on a text; `store(path, text)` writes a file
//   fix::set_loader(load)             the reader of imported modules the checker's fixes use (#1797): `fix_run` sets
//   the
//                                     project's and smith's folders; with none, a call is not rewritten to the method
//                                     form, which needs the types of another module
//   fix::fix_run(paths, count)        what the driver calls (C: `front_parser_fix_run`): `path: N fixes applied` on
//                                     standard output for each file, 0 when every file could be read and written
module front::fix;

import front::ast;
import front::parse as core;
import front::fix_method;
import front::lex;
import front::parse_decl;
import front::parse_expr;
import front::parse_stmt;
import front::parse_type;
import front::parser;
import front::roots;
import front::types;
import front::types_decl;
import std::files;
import std::format;
import std::mem;
import <unistd.h>;

// The text with the fixes applied, and how many fixes that was and how many were left out because an edit of theirs
// overlapped one already taken (the first, in the order of the errors, wins).
export struct Fixed {
    Str text;
    Usize applied;
    Usize skipped;
};

static Bool is_insert(core::Edit e) {
    return e.span.start == e.span.end;
}

// Two edits at one offset overlap, except an insertion beside an edit that deletes from there: the text goes in first
// (`n` then `;` removed: `n as i32` and no `;`). Two insertions at one offset have no order, so they clash.
static Bool overlaps(core::Edit a, core::Edit b) {
    if (a.span.start == b.span.start) return is_insert(a) == is_insert(b);
    return a.span.start < b.span.end && b.span.start < a.span.end;
}

static Bool clashes(core::Edits taken, core::Edits fix) {
    for (Usize i = 0; i < countof(fix); i++) {
        for (Usize j = 0; j < countof(taken); j++) {
            if (overlaps(fix[i], taken[j])) return true;
        }
        for (Usize j = 0; j < i; j++) {
            if (overlaps(fix[i], fix[j])) return true;
        }
    }
    return false;
}

static Str as_str(char chars[:]) {
    return chars;
}

static Fixed apply_all(Str source, core::Errors errors) {
    core::Edits taken = {};
    Fixed result = {.text = source};
    for (Usize i = 0; i < countof(errors); i++) {
        core::Edits fix = errors[i].fix;
        if (countof(fix) == 0) continue;
        if (clashes(taken, fix)) {
            result.skipped += 1;
            continue;
        }
        result.applied += 1;
        for (Usize j = 0; j < countof(fix); j++) {
            Usize at = countof(taken);
            taken = mem::realloc(taken, at + 1);
            while (at > 0 &&
                   (taken[at - 1].span.start > fix[j].span.start || (taken[at - 1].span.start == fix[j].span.start &&
                                                                     !is_insert(taken[at - 1]) && is_insert(fix[j])))) {
                taken[at] = taken[at - 1];
                at -= 1;
            }
            taken[at] = fix[j];
        }
    }
    if (result.applied == 0) return result;
    Str out = "";
    Usize from = 0;
    for (Usize i = 0; i < countof(taken); i++) {
        out = as_str(format::push(out, source[from:taken[i].span.start], taken[i].text));
        from = taken[i].span.end;
    }
    result.text = as_str(format::push(out, source[from:countof(source)]));
    return result;
}

static U32 width(core::ParseError e) {
    return e.span.end - e.span.start;
}

// Applies the fixes of `errors`, then of `warnings` (the wider first), to `source`.
export Fixed apply_fixes(Str source, core::Errors errors, core::Errors warnings) {
    core::Errors all = {};
    all = mem::realloc(all, countof(errors) + countof(warnings));
    for (Usize i = 0; i < countof(errors); i++)
        all[i] = errors[i];
    for (Usize i = 0; i < countof(warnings); i++) {
        // The wider warning goes first (a stable insertion), so a cast or a declaration is mended whole before a type
        // inside it: the next pass reads that type again in the new form and mends it then.
        Usize at = countof(errors) + i;
        while (at > countof(errors) && width(all[at - 1]) < width(warnings[i])) {
            all[at] = all[at - 1];
            at -= 1;
        }
        all[at] = warnings[i];
    }
    return apply_all(source, all);
}

constexpr Usize fix_passes = 8;

// Reads the modules a file imports (#1797): without one the checker knows nothing of an import, and the fixes that need
// another module's types (a call written in the method form) are not made. A test supplies its own; the driver's reads
// the project's and smith's folders.
static types::ModuleLoader loader = nullptr;

export void set_loader(types::ModuleLoader load) {
    loader = load;
}

// The errors of the checker that carry a fix, as parse errors, so `apply_fixes` takes both kinds (#1516).
static core::Errors checker_fixes(Str source, const ast::Module *module) {
    core::Errors out = {};
    types::Checked checked = types_decl::check_module_with(module, types::lp64(), loader);
    for (Usize i = 0; i < checked.error_count; i++) {
        types::Error e = checked.errors[i];
        if (countof(e.fix) == 0) continue;
        out = mem::realloc(out, countof(out) + 1);
        out[countof(out) - 1] = (core::ParseError){.span = e.span, .message = e.message, .fix = e.fix};
    }
    if (checked.error_count == 0 && loader != nullptr) {
        core::Errors methods = fix_method::edits(source, &checked);
        for (Usize i = 0; i < countof(methods); i++) {
            out = mem::realloc(out, countof(out) + 1);
            out[countof(out) - 1] = methods[i];
        }
    }
    return out;
}

// The text of a file as smith's own syntax (`fn`, `x: T`, `mut`, `*mut T`), which is what the checker's fixes mend; a
// text that does not read cleanly in that syntax is read as today's (`parser::parse`).
export parser::Parsed parse_for_fix(Str file, Str source) {
    if (lex::tokenize_new(source) != .error) {
        parser::Parsed own = parser::parse_new(file, source);
        if (countof(own.errors) == 0) return own;
    }
    return parser::parse(file, source);
}

// Writes `text` over the file `path`. False when it cannot.
export Bool store(Str path, Str text) {
    U8 bytes[:] = {};
    bytes = mem::realloc(bytes, countof(text));
    for (Usize i = 0; i < countof(text); i++)
        bytes[i] = (U8)text[i];
    files::CountResult written = files::write_file(path, bytes, files::Replace);
    return written != .error;
}

// The text of a `/* */` comment written as `#` lines: each line of `content` gets a `#` in front of it.
static Str block_as_hashes(Str content) {
    Str out = "#";
    for (Usize k = 0; k < countof(content); k++) {
        if (content[k] == '\n') {
            out = as_str(format::push(out, "\n#"));
        } else {
            out = as_str(format::push(out, content[k:k + 1]));
        }
    }
    return out;
}

// The index of the `/` after `*/` closing the block comment that opens at i, or the length of the text when none does.
static Usize block_end(Str source, Usize i) {
    Usize n = countof(source);
    for (Usize k = i + 2; k + 1 < n; k++) {
        if (source[k] == '*' && source[k + 1] == '/') return k + 1;
    }
    return n;
}

// The index after the closing quote of the string or character literal that opens at i, on the same line; i itself
// when the line holds no closing quote, so the quote is text (an apostrophe in a comment).
static Usize quoted_end(Str source, Usize i) {
    Usize n = countof(source);
    Usize k = i + 1;
    while (k < n && source[k] != '\n') {
        if (source[k] == '\\') {
            k += 2;
            continue;
        }
        if (source[k] == source[i]) return k + 1;
        k += 1;
    }
    return i;
}

// The text with every `//` comment written as a `#` comment (a space after it when there is none), and every
// `/* */` comment as `#` lines. The text is read as characters, not tokens: once the fixer has written `#` comments
// the text no longer tokenizes as today's syntax, and the `//` left would hide the causes behind it. A string or a
// character literal is left, so a `//` in a string stays.
static Str hash_comments(Str source) {
    Usize n = countof(source);
    Str out = "";
    Usize copied = 0;
    Usize i = 0;
    while (i < n) {
        if (source[i] == '"' || source[i] == '\'') {
            Usize end = quoted_end(source, i);
            i = end > i ? end : i + 1;
            continue;
        }
        if (source[i] == '#' && (i + 1 >= n || source[i + 1] == ' ' || source[i + 1] == '\n' || source[i + 1] == '#')) {
            // A `#` comment written already: what is in it stays (the pass that wrote it may run again, #1956).
            while (i < n && source[i] != '\n') {
                i += 1;
            }
            continue;
        }
        if (i + 1 < n && source[i] == '/' && source[i + 1] == '/') {
            Bool blank = i + 2 >= n || source[i + 2] == ' ' || source[i + 2] == '\n';
            Str spaced = blank ? "#" : "# ";
            out = as_str(format::push(out, source[copied:i], spaced));
            copied = i + 2;
            while (i < n && source[i] != '\n') {
                i += 1;
            }
            continue;
        }
        if (i + 1 < n && source[i] == '/' && source[i + 1] == '*') {
            Usize close = block_end(source, i);
            if (close >= n) {
                i = n;
                continue;
            }
            out = as_str(format::push(out, source[copied:i], block_as_hashes(source[i + 2:close - 1])));
            copied = close + 1;
            i = copied;
            continue;
        }
        i += 1;
    }
    return as_str(format::push(out, source[copied:n]));
}

// Mends the text of the file called `file`: parses, applies the fixes, and parses the result again, until a pass
// applies none (at most 8 passes). `applied` counts the fixes of all the passes.
export Fixed fix_text(Str file, Str source) {
    Fixed total = {.text = source};
    for (Usize pass = 0; pass < fix_passes; pass++) {
        parser::Parsed parsed = parse_for_fix(file, total.text);
        core::Errors errors = parsed.errors;
        if (countof(errors) == 0) {
            core::Errors more = checker_fixes(total.text, &parsed.module);
            for (Usize i = 0; i < countof(more); i++) {
                errors = mem::realloc(errors, countof(errors) + 1);
                errors[countof(errors) - 1] = more[i];
            }
        }
        Fixed fixed = apply_fixes(total.text, errors, parsed.warnings);
        if (fixed.applied == 0) break;
        total.text = fixed.text;
        // Once the text lexes as smith's own syntax (no old form is left in it), its `//` comments are written `#`
        // now: the next pass would otherwise read it with the old parser, which takes `pub const m: usize = 16` for
        // an old declaration and mends it again (#1956).
        Str hashed = hash_comments(total.text);
        if (!mem::equal(hashed, total.text) && lex::tokenize_new(hashed) != .error) total.text = hashed;
        total.applied += fixed.applied;
        total.skipped = fixed.skipped;
    }
    // The comments are written even when a form the fixer cannot mend is left, so no `//` hides the other causes.
    if (total.applied > 0) total.text = hash_comments(total.text);
    return total;
}

// The tree of the module at the dotted `path` (`std.list`, NUL-terminated) for the checker: the file under the
// project's source folder, else under smith's library folder (`front::roots`); null when neither holds it or it does
// not read.
static const ast::Module *load_from_folders(const char *dotted) {
    Str relative = as_str(format::push((const char *)dotted));
    Str inside = "";
    for (Usize i = 0; i < countof(relative); i++) {
        Str piece = relative[i:i + 1];
        if (relative[i] == '.') piece = "/";
        inside = as_str(format::push(inside, piece));
    }
    roots::Roots folders = roots::default_roots();
    Str where[2] = {folders.source, folders.library};
    for (Usize k = 0; k < 2; k++) {
        Str path = as_str(format::push(where[k], "/", inside, ".smith"));
        if (!files::exists(path)) continue;
        files::BytesResult loaded = files::read_file(path);
        if (loaded == .error) return nullptr;
        format::Chars chars = mem::view(loaded.ok, char);
        Str source = chars;
        parser::Parsed parsed = parse_for_fix(path, source);
        if (countof(parsed.errors) > 0) return nullptr;
        ast::Module *copy = mem::alloc(ast::Module);
        *copy = parsed.module;
        return copy;
    }
    return nullptr;
}

// Fixes one file in place. Returns the number of fixes applied, or -1 when the file cannot be read or written.
export I64 fix_file(Str path) {
    files::BytesResult loaded = files::read_file(path);
    if (loaded == .error) return -1;
    format::Chars chars = mem::view(loaded.ok, char);
    Str source = chars;
    Fixed fixed = fix_text(path, source);
    if (fixed.applied > 0 && !store(path, fixed.text)) return -1;
    return (I64)fixed.applied;
}

// The driver's entry for `smith lint --fix FILE...`: each file fixed, `path: N fixes applied` on standard output,
// 0 when every file could be read and written.
[[std::c_name("front_parser_fix_run")]] export I32 fix_run(const char *const *paths, Usize count) {
    I32 status = 0;
    loader = load_from_folders;
    for (Usize i = 0; i < count; i++) {
        Str path = as_str(format::push((const char *)paths[i]));
        I64 n = fix_file(path);
        Str line = n < 0 ? as_str(format::push(path, ": cannot read or write the file\n"))
                         : as_str(format::push(path, ": ", n, n == 1 ? " fix applied\n" : " fixes applied\n"));
        (void)c::write(n < 0 ? 2 : 1, line.data, countof(line));
        if (n < 0) status = 1;
    }
    return status;
}
