// front::fix, `smith lint --fix` (#1442, S6 of #1428): the fixes that parse errors carry (front::parse's `Edit`),
// applied to a file's text.
//
//   fix::apply_fixes(source, errors, warnings)
//                                     the text with the fixes of the errors, then of the warnings (the wider first),
//                                     applied: a fix (all its edits or none) is taken when no edit of it overlaps one
//                                     already taken, else it is skipped
//   fix::fix_file(path)               one file mended in place: parse, apply, and again until nothing applies (at most
//                                     16 passes); the number of fixes applied, -1 when the file cannot be read or
//                                     written
//   fix::fix_text(file, source)       the same on a text; `store(path, text)` writes a file
//   fix::set_loader(load)             the reader of imported modules the checker's fixes use (#1797): `fix_run` sets
//   the
//                                     project's and smith's folders; with none, a call is not rewritten to the method
//                                     form, which needs the types of another module
//   fix::fix_run(paths, count)        what the driver calls (C: `front_parser_fix_run`): each file fixed, then the enum
//                                     variants of all the files renamed lowercase (front::fix_variants, #2098);
//                                     `path: N fixes applied` on standard output for each file, 0 when every file
//                                     could be read and written
module front::fix;

import front::ast;
import front::cimport;
import front::fix_zero;
import front::parse as core;
import front::fix_blocks;
import front::fix_equal;
import front::fix_generic_c;
import front::fix_generic_mut;
import front::fix_method;
import front::fix_opaque;
import front::fix_payload;
import front::fix_array;
import front::fix_bool;
import front::fix_chain;
import front::fix_const;
import front::fix_guard;
import front::fix_place;
import front::fix_alloc;
import front::fix_build;
import front::fix_typeof;
import front::fix_variants;
import front::lex;
import front::parse_decl;
import front::parse_expr;
import front::parse_stmt;
import front::parse_type;
import front::parser;
import front::roots;
import front::types;
import front::types_decl;
import std::arena;
import std::files;
import std::format;
import std::mem;
import <stdlib.h>;
import <unistd.h>;

// The text with the fixes applied, and how many fixes that was and how many were left out because an edit of theirs
// overlapped one already taken (the first, in the order of the errors, wins).
export struct Fixed {
    Str text;
    Usize applied;
    Usize skipped;
    Str clash; // `line:column: `yield` is a keyword: rename it`, or empty
};

static Bool is_insert(core::Edit e) {
    return e.span.start == e.span.end;
}

// Two edits at one offset overlap, except an insertion beside an edit that deletes from there: the text goes in first
// (`n` then `;` removed: `n as i32` and no `;`). Two insertions at one offset have no order, so they clash, unless
// they are both ` }`: the closing braces of two unbraced bodies that end together (`for (...) if (c) s;`) go in
// in either order, and a clash would leave the inner `if` for a pass that no longer reads its old form (#2224).
static Bool overlaps(core::Edit a, core::Edit b) {
    if (a.span.start == b.span.start) {
        Str closer = " }";
        if (is_insert(a) && is_insert(b)) return !(mem::equal(a.text, closer) && mem::equal(b.text, closer));
        return is_insert(a) == is_insert(b);
    }
    return a.span.start < b.span.end && b.span.start < a.span.end;
}

static Bool clashes(core::Edits taken, core::Edits fix) {
    for (Usize i = 0; i < countof(fix); i++) {
        for (Usize j = 0; j < countof(taken); j++) {
            if (overlaps(fix[i], taken[j])) return true;
        }
        for (Usize j = 0; j < i; j++) {
            if (overlaps(fix[i], fix[j])) return true;
        }
    }
    return false;
}

static Str as_str(char chars[:]) {
    return chars;
}

static Fixed apply_all(Str source, core::Errors errors) {
    core::Edits taken = {};
    Fixed result = {.text = source};
    for (Usize i = 0; i < countof(errors); i++) {
        core::Edits fix = errors[i].fix;
        if (countof(fix) == 0) continue;
        if (clashes(taken, fix)) {
            result.skipped += 1;
            continue;
        }
        result.applied += 1;
        for (Usize j = 0; j < countof(fix); j++) {
            Usize at = countof(taken);
            taken = mem::realloc(taken, at + 1);
            while (at > 0 &&
                   (taken[at - 1].span.start > fix[j].span.start || (taken[at - 1].span.start == fix[j].span.start &&
                                                                     !is_insert(taken[at - 1]) && is_insert(fix[j])))) {
                taken[at] = taken[at - 1];
                at -= 1;
            }
            taken[at] = fix[j];
        }
    }
    if (result.applied == 0) return result;
    Str out = "";
    Usize from = 0;
    for (Usize i = 0; i < countof(taken); i++) {
        out = as_str(format::push(out, source[from:taken[i].span.start], taken[i].text));
        from = taken[i].span.end;
    }
    result.text = as_str(format::push(out, source[from:countof(source)]));
    return result;
}

static U32 width(core::ParseError e) {
    return e.span.end - e.span.start;
}

// Applies the fixes of `errors`, then of `warnings` (the wider first), to `source`.
export Fixed apply_fixes(Str source, core::Errors errors, core::Errors warnings) {
    core::Errors all = {};
    all = mem::realloc(all, countof(errors) + countof(warnings));
    for (Usize i = 0; i < countof(errors); i++)
        all[i] = errors[i];
    for (Usize i = 0; i < countof(warnings); i++) {
        // The wider warning goes first (a stable insertion), so a cast or a declaration is mended whole before a type
        // inside it: the next pass reads that type again in the new form and mends it then.
        Usize at = countof(errors) + i;
        while (at > countof(errors) && width(all[at - 1]) < width(warnings[i])) {
            all[at] = all[at - 1];
            at -= 1;
        }
        all[at] = warnings[i];
    }
    return apply_all(source, all);
}

constexpr Usize fix_passes = 16;
constexpr Usize fix_rounds = 6;

// Reads the modules a file imports (#1797): without one the checker knows nothing of an import, and the fixes that need
// another module's types (a call written in the method form) are not made. A test supplies its own; the driver's reads
// the project's and smith's folders.
static types::ModuleLoader loader = nullptr;

export void set_loader(types::ModuleLoader load) {
    loader = load;
}

static arena::Arena header_arena;
static Bool header_arena_made = false;
static Str header_folder = ".";

// The path of the file being fixed, to find its entry in a compile_commands.json (#2648).
static Str database_file = "";
static Str database_text = "";
static Str database_name(Usize k) {
    if (k == 0) return "compile_commands.json";
    if (k == 1) return "build/compile_commands.json";
    return ".smith/compile_commands.json";
}
static Bool database_read = false;

// Whether the database's `file` names the source `path`: the same text, or one a suffix of the other after a `/`.
static Bool same_file(Str file, Str path) {
    while (countof(path) >= 2 && path[0] == '.' && path[1] == '/')
        path = path[2:countof(path)];
    Str longer = countof(file) >= countof(path) ? file : path;
    Str shorter = countof(file) >= countof(path) ? path : file;
    Usize gap = countof(longer) - countof(shorter);
    if (gap > 0 && longer[gap - 1] != '/') return false;
    return countof(shorter) > 0 && mem::equal(longer[gap:countof(longer)], shorter);
}

// The text between the last two quotes of `line`, or an empty string when there are none.
static Str quoted(Str line) {
    Usize end = countof(line);
    while (end > 0 && line[end - 1] != '"')
        end -= 1;
    if (end == 0) return "";
    Usize begin = end - 1;
    while (begin > 0 && line[begin - 1] != '"')
        begin -= 1;
    if (begin == 0) return "";
    return line[begin:end - 1];
}

static Bool starts_with_text(Str text, Str prefix) {
    return countof(text) >= countof(prefix) && mem::equal(text[0:countof(prefix)], prefix);
}

static Bool is_flag(Str text, Str flag) {
    return countof(text) == countof(flag) && starts_with_text(text, flag);
}

// The `-I`, `-isystem`, `-D` and `-isysroot` flags the database gives `database_file`, one on each line as
// SMITH_FRONT_CIMPORT_FLAGS has them (`smith cc` does the same, #2313): `<llvm-c/Core.h>` is found at
// `-I<llvm>/include`, so a call of it is typed and the checker's fixes for it are made (#2648).
static Str database_flags() {
    if (database_read) return database_text;
    database_read = true;
    for (Usize k = 0; k < 3; k++) {
        if (!files::exists(database_name(k))) continue;
        files::BytesResult loaded = files::read_file(database_name(k));
        if (loaded == .error) continue;
        format::Chars chars = mem::view(loaded.ok, char);
        Str text = chars;
        Str out = "";
        Bool matched = false;
        Bool inside = false;
        Str previous = "";
        Usize from = 0;
        for (Usize i = 0; i <= countof(text); i++) {
            if (i < countof(text) && text[i] != '\n') continue;
            Str line = text[from:i];
            from = i + 1;
            Str value = quoted(line);
            Bool has_quote = false;
            for (Usize j = 0; j < countof(line); j++)
                has_quote = has_quote || line[j] == '"';
            if (starts_with_text(line, "    \"directory\"")) {
                if (matched && countof(out) > 0) break;
                matched = false;
                inside = false;
                previous = "";
            } else if (starts_with_text(line, "    \"file\"")) {
                matched = same_file(value, database_file);
            } else if (matched && starts_with_text(line, "    \"arguments\"")) {
                inside = true;
            } else if (matched && inside && !has_quote) {
                break;
            } else if (matched && inside) {
                Bool pair = is_flag(previous, "-I") || is_flag(previous, "-isystem") || is_flag(previous, "-D") ||
                            is_flag(previous, "-isysroot");
                if (pair) out = as_str(format::push(out, previous, "\n", value, "\n"));
                if (!pair && (starts_with_text(value, "-I") || starts_with_text(value, "-D")) && countof(value) > 2)
                    out = as_str(format::push(out, value, "\n"));
                previous = value;
            }
        }
        database_text = out;
        break;
    }
    return database_text;
}

// The declarations of a C header, for the fix that names a binding (#1678): read as front::compile reads one, with
// the flags of SMITH_FRONT_CIMPORT_FLAGS; null when clang cannot read it.
static const ast::Module *load_header(Str header, Bool angled) {
    Str name = as_str(format::push(header));
    Str folder = as_str(format::push(header_folder));
    if (!header_arena_made) {
        header_arena = arena::growing(1U << 20, nullptr);
        header_arena_made = true;
    }
    Str empty = "";
    const char *flags = empty.data;
    const char *given = c::getenv("SMITH_FRONT_CIMPORT_FLAGS");
    if (given != nullptr) flags = given;
    // `smith lint --fix` has no `-I` of its own: a library's header (`<smith/trace.h>`) is looked for in the project's
    // `include` and `.smith/include`, as `smith cc` is given them (#2224).
    Str given_text = as_str(format::push(flags));
    Str joined = as_str(format::push(given_text, countof(given_text) > 0 ? "\n" : "", "-Iinclude\n-I.smith/include\n",
                                     database_flags()));
    flags = joined.data;
    cimport::Header got = cimport::read(&header_arena, name.data, !angled, folder.data, flags);
    if (countof(got.error) > 0) return nullptr;
    ast::Module *module = mem::alloc(ast::Module);
    module->decls = got.decls;
    return module;
}

// The libc headers a name used as `c.name` may come from, most specific first (#2627): the file never imports the
// header (C reached it through another header's includes), so the fix adds `import c <h>` and the next pass writes
// `h.name`.
static Str libc_headers[14] = {"string.h", "stdlib.h", "stdio.h", "unistd.h",   "ctype.h",    "errno.h",  "fcntl.h",
                               "signal.h", "time.h",   "math.h",  "sys/stat.h", "sys/wait.h", "dirent.h", "limits.h"};

static Bool header_declares(const ast::Module *header, Str name) {
    for (Usize i = 0; i < countof(header->decls); i++) {
        const ast::Decl *d = header->decls[i];
        if (d->kind == .function && mem::equal(d->kind.function.name, name)) return true;
        if (d->kind == .variable && mem::equal(d->kind.variable.name, name)) return true;
    }
    return false;
}

// The name in "there is no global `c`: import the header that declares `strlen` (...)": empty for another message.
static Str undeclared_c_name(Str message) {
    Str lead = "there is no global `c`: import the header that declares `";
    if (countof(message) <= countof(lead) || !mem::equal(message[0:countof(lead)], lead)) return "";
    Usize end = countof(lead);
    while (end < countof(message) && message[end] != '`')
        end += 1;
    return message[countof(lead):end];
}

static Bool contains_text(Str text, Str needle);

// The name in "`T` has no method `printf`; write a function ...": empty for another message.
static Str no_method_name(Str message) {
    Str lead = "` has no method `";
    for (Usize i = 0; i + countof(lead) < countof(message); i++) {
        if (!mem::equal(message[i:i + countof(lead)], lead)) continue;
        Usize from = i + countof(lead);
        Usize end = from;
        while (end < countof(message) && message[end] != '`')
            end += 1;
        return message[from:end];
    }
    return "";
}

// A local named `c` hides the namespace `c` (#2648): `c.printf(...)` reads a method of the local. The header's own
// name, `stdio.printf`, is the same function whatever the locals are called, so the `c` of the call becomes it.
static core::Errors c_shadow_fixes(Str source, const types::Checked *checked) {
    core::Errors out = {};
    for (Usize i = 0; i < checked->error_count; i++) {
        types::Error e = checked->errors[i];
        Str name = no_method_name(e.message);
        if (countof(name) == 0 || e.span.end <= e.span.start + 2) continue;
        if (source[e.span.start] != 'c' || source[e.span.start + 1] != '.') continue;
        for (Usize h = 0; h < countof(libc_headers); h++) {
            Str header = libc_headers[h];
            const ast::Module *found = load_header(header, true);
            if (found == nullptr || !header_declares(found, name)) continue;
            Str written = as_str(format::push("import c <", header, ">"));
            if (!contains_text(source, written)) continue;
            Usize stem = 0;
            for (Usize k = 0; k < countof(header); k++)
                if (header[k] == '/') stem = k + 1;
            Str space = header[stem:countof(header) - 2];
            ast::Span at = {.start = e.span.start, .end = e.span.start + 1};
            core::Edits edits = {};
            edits = mem::realloc(edits, 1);
            edits[0] = (core::Edit){.span = at, .text = space};
            out = mem::realloc(out, countof(out) + 1);
            core::ParseError fix_error = {};
            fix_error.span = at;
            fix_error.message = "a local named `c` hides the C namespace";
            fix_error.fix = edits;
            out[countof(out) - 1] = fix_error;
            break;
        }
    }
    return out;
}

// One fix per header that declares a name the file reads as `c.name` without importing it: the line `import c <h>`.
static core::Errors c_import_fixes(const ast::Module *module, const types::Checked *checked) {
    core::Errors out = {};
    if (countof(module->decls) == 0) return out;
    Str added[8];
    Usize added_count = 0;
    for (Usize i = 0; i < checked->error_count; i++) {
        Str name = undeclared_c_name(checked->errors[i].message);
        if (countof(name) == 0) continue;
        for (Usize h = 0; h < countof(libc_headers); h++) {
            Str header = libc_headers[h];
            Bool done = false;
            for (Usize k = 0; k < added_count; k++)
                if (mem::equal(added[k], header)) done = true;
            if (done) continue;
            const ast::Module *found = load_header(header, true);
            if (found == nullptr || !header_declares(found, name)) continue;
            const ast::Decl *first = module->decls[0];
            for (Usize k = 0; k < countof(module->decls); k++) {
                const ast::Decl *candidate = module->decls[k];
                Bool is_import = candidate->kind == .import_module;
                if (candidate->kind == .import_c) is_import = true;
                if (!is_import) continue;
                first = candidate;
                break;
            }
            ast::Span at = {.start = first->span.start, .end = first->span.start};
            core::Edits edits = {};
            edits = mem::realloc(edits, 1);
            edits[0] = (core::Edit){.span = at, .text = as_str(format::push("import c <", header, ">\n"))};
            out = mem::realloc(out, countof(out) + 1);
            core::ParseError fix_error = {};
            fix_error.span = at;
            fix_error.message = "a C name needs its header";
            fix_error.fix = edits;
            out[countof(out) - 1] = fix_error;
            if (added_count < 8) {
                added[added_count] = header;
                added_count += 1;
            }
            break;
        }
    }
    return out;
}

// Whether the module imports a header with a language (`import c <h>`): only then does the checker need clang.
static Bool imports_header(const ast::Module *module) {
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind == .import_module) return true; // a library it imports may import a header its types come from
        if (d->kind != .import_c) continue;
        if (countof(d->kind.import_c.language) > 0) return true;
    }
    return false;
}

// Whether the module imports another module: that one's headers are read as well.
static Bool imports_module(const ast::Module *module) {
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind == .import_module) return true;
    }
    return false;
}

// Whether `needle` is in `text`.
// A checker fix that inserts at the first byte of a text the parser's fixes replace in the same pass would land before
// the new text (`?e: *T = x` for `?` at the type of `T *e = x`, #2648): it waits for the next pass, which reads the
// mended text and puts it at the new type.
static Bool inserts_at_replaced_start(core::Errors parsed_errors, core::Errors parsed_warnings, core::ParseError more) {
    for (Usize k = 0; k < countof(more.fix); k++) {
        if (!is_insert(more.fix[k])) continue;
        for (Usize i = 0; i < countof(parsed_errors) + countof(parsed_warnings); i++) {
            core::ParseError other =
                i < countof(parsed_errors) ? parsed_errors[i] : parsed_warnings[i - countof(parsed_errors)];
            for (Usize j = 0; j < countof(other.fix); j++) {
                if (!is_insert(other.fix[j]) && other.fix[j].span.start == more.fix[k].span.start) return true;
            }
        }
    }
    return false;
}

// Whether `needle` is in `text`.
static Bool contains_text(Str text, Str needle) {
    Usize n = countof(needle);
    for (Usize i = 0; i + n <= countof(text); i++) {
        if (mem::equal(text[i:i + n], needle)) return true;
    }
    return false;
}

// `out` and `more` in one list.
static core::Errors append(core::Errors out, core::Errors more) {
    for (Usize i = 0; i < countof(more); i++) {
        out = mem::realloc(out, countof(out) + 1);
        out[countof(out) - 1] = more[i];
    }
    return out;
}

// The fixes made from the checker's errors of the whole file, whatever else it still gets wrong (#2648): `Ty(kind =
// (vector = (...)))` where `kind` is a payload enumeration is `.vector((...))`, an array given to a C pointer
// parameter is `&xs[0]`, a Bool given where a C function wants an integer is `1` or `.to(i32)`, and `mem::equal(a, b)`
// is `==` (#2540: the call is found by its name). `fix_const` reads the text: a `= undefined` local whose address is
// taken is `mut`, and `fix_chain` writes a pattern conjunct for a payload read after its test in a value (D16), once
// the parser reads one.
static Usize pattern_probe = 0; // 0: not tried, 1: the parser reads a pattern in a value, 2: it does not

// Whether the parser reads a pattern conjunct in a value (D16: `return .v(v) := k && v.x`), tried once on a snippet.
// `fix_chain` writes that form, so it waits for the parser that reads it: written before, it would turn a check error
// into a parse error, and the module would still not pass.
static Bool values_take_patterns() {
    if (pattern_probe == 0) {
        parser::Parsed probe = parser::parse_new("probe.smith", "fn f(k: K) -> bool:\n    return .v(v) := k and v.x\n");
        pattern_probe = countof(probe.errors) == 0 ? 1 : 2;
    }
    return pattern_probe == 1;
}

static Usize guard_probe = 0; // 0: not tried, 1: the parser reads a binding with an else, 2: it does not

// Whether the parser reads `.ok(ok) := r else: return` (the binding of a guard that leaves), tried once on a snippet.
static Bool bindings_take_else() {
    if (guard_probe == 0) {
        parser::Parsed probe =
            parser::parse_new("probe.smith", "fn f(r: R) -> i32:\n    .ok(ok) := r else: return 0\n    return ok\n");
        guard_probe = countof(probe.errors) == 0 ? 1 : 2;
    }
    return guard_probe == 1;
}

static Usize place_probe = 0; // 0: not tried, 1: the parser reads a pattern on an address, 2: it does not

// Whether the parser reads `.v(v) := &k` (D21).
static Bool places_are_bound() {
    if (place_probe == 0) {
        parser::Parsed probe = parser::parse_new("probe.smith", "fn f(k: K):\n    if .v(v) := &k:\n        v.x = 1\n");
        place_probe = countof(probe.errors) == 0 ? 1 : 2;
    }
    return place_probe == 1;
}

static core::Errors typed_fixes(Str source, const types::Checked *checked) {
    core::Errors out = fix_equal::edits(source, checked);
    out = append(out, fix_payload::edits(source, checked));
    out = append(out, fix_array::edits(source, checked));
    out = append(out, fix_bool::edits(source, checked));
    out = append(out, fix_const::edits(source));
    if (bindings_take_else()) out = append(out, fix_guard::edits(source));
    if (places_are_bound()) out = append(out, fix_place::edits(source));
    if (!values_take_patterns()) return out;
    return append(out, fix_chain::edits(source));
}

// The errors of the checker that carry a fix, as parse errors, so `apply_fixes` takes both kinds (#1516).
static core::Errors checker_fixes(Str source, const ast::Module *module) {
    core::Errors out = {};
    // A module that imports another reads that one's C types too (std.arena's SmithAllocator); a file with only the
    // old `import <h>;` keeps the header out of its first passes.
    types::HeaderLoader headers = imports_header(module) || imports_module(module) ? load_header : nullptr;
    types_decl::set_source(source); // a test in a chain `a || k != .v` is fixed by copying its `then` (#2503)
    types::Checked checked = types_decl::check_module_headers(module, types::lp64(), loader, headers);
    types_decl::set_source("");
    for (Usize i = 0; i < checked.error_count; i++) {
        types::Error e = checked.errors[i];
        if (countof(e.fix) == 0) continue;
        out = mem::realloc(out, countof(out) + 1);
        out[countof(out) - 1] = (core::ParseError){.span = e.span, .message = e.message, .fix = e.fix};
    }
    out = append(out, c_import_fixes(module, &checked));
    out = append(out, c_shadow_fixes(source, &checked));
    // `{}` of a struct (#2224): its type is known once the declaration is, whatever else fails in the file.
    out = append(out, fix_zero::edits(source, module, &checked));
    // `c.name` in a template nothing instantiates (#2303): the checker never reads the body.
    out = append(out, fix_generic_c::edits(source, module, &checked));
    // `total := 0` assigned in a template (#2613): no instance of another module carries the fix.
    out = append(out, fix_generic_mut::edits(source, module));
    // `typeof` of a slice parameter and of a written type (#2340): the new syntax has neither.
    out = append(out, fix_typeof::edits(source, module));
    out = append(out, typed_fixes(source, &checked));
    if (checked.error_count == 0 && loader != nullptr) out = append(out, fix_method::edits(source, &checked));
    // `t[0]` over a tuple (#2679): the checker rejects the index, so this runs on a module that has errors.
    out = append(out, fix_method::tuple_edits(&checked));
    return out;
}

// The text of a file as smith's own syntax (`fn`, `x: T`, `mut`, `*mut T`), which is what the checker's fixes mend; a
// text that does not read cleanly in that syntax is read as today's (`parser::parse_file`).
export parser::Parsed parse_for_fix(Str file, Str source) {
    if (lex::tokenize_new(source) != .error) {
        parser::Parsed own = parser::parse_new(file, source);
        if (countof(own.errors) == 0) return own;
        // The passes read their own output with braces until `fix_blocks` ends them (#2014).
        parser::Parsed braced = parser::parse_new_braces(file, source);
        if (countof(braced.errors) == 0) return braced;
        // Today's lexer reads no `#` comment: a text with some (the fixer wrote them once it lexed as smith's own
        // syntax) and a form left to mend is mended by the errors the own syntax's parser reports (#2106). The braced
        // reader is the one that reads a body still written with braces; the indented one skips it (#2328).
        if (lex::tokenize(source) == .error) return countof(braced.errors) < countof(own.errors) ? braced : own;
    }
    return parser::parse_file(file, source);
}

// The modules `load_from_folders` has read in this run, by file (#2586). The checker loads every import, and every
// import of an import, on each of its passes, and a library module that needs mending is mended by up to `fix_passes`
// parses: read again each time, the fix of front/compile.smith grew past 11 GB and the 16 GB runner of
// `frontend-coverage` was shut down. So each file is read once: `fix_run` empties the list, and so does `store`, since
// a file the fixer writes is read again as it now is.
constexpr Usize loaded_max = 256;
static Str loaded_paths[loaded_max];
static const ast::Module *loaded_modules[loaded_max];
static Usize loaded_count = 0;

// Writes `text` over the file `path`. False when it cannot.
export Bool store(Str path, Str text) {
    U8 bytes[:] = {};
    bytes = mem::realloc(bytes, countof(text));
    for (Usize i = 0; i < countof(text); i++)
        bytes[i] = (U8)text[i];
    files::CountResult written = files::write_file(path, bytes, files::Replace);
    loaded_count = 0; // an import read before may be this file (#2586)
    return written != .error;
}

// The text of a `/* */` comment written as `#` lines: each line of `content` gets a `#` in front of it.
static Str block_as_hashes(Str content) {
    Str out = "#";
    for (Usize k = 0; k < countof(content); k++) {
        if (content[k] == '\n') {
            out = as_str(format::push(out, "\n#"));
        } else {
            out = as_str(format::push(out, content[k:k + 1]));
        }
    }
    return out;
}

// The index of the `/` after `*/` closing the block comment that opens at i, or the length of the text when none does.
static Usize block_end(Str source, Usize i) {
    Usize n = countof(source);
    for (Usize k = i + 2; k + 1 < n; k++) {
        if (source[k] == '*' && source[k + 1] == '/') return k + 1;
    }
    return n;
}

// The index after the closing quote of the string or character literal that opens at i, on the same line; i itself
// when the line holds no closing quote, so the quote is text (an apostrophe in a comment).
static Usize quoted_end(Str source, Usize i) {
    Usize n = countof(source);
    Usize k = i + 1;
    while (k < n && source[k] != '\n') {
        if (source[k] == '\\') {
            k += 2;
            continue;
        }
        if (source[k] == source[i]) return k + 1;
        k += 1;
    }
    return i;
}

// The text with every `//` comment written as a `#` comment (a space after it when there is none), and every
// `/* */` comment as `#` lines. The text is read as characters, not tokens: once the fixer has written `#` comments
// the text no longer tokenizes as today's syntax, and the `//` left would hide the causes behind it. A string or a
// character literal is left, so a `//` in a string stays.
static Str hash_comments(Str source) {
    Usize n = countof(source);
    Str out = "";
    Usize copied = 0;
    Usize i = 0;
    while (i < n) {
        if (source[i] == '"' || source[i] == '\'') {
            Usize end = quoted_end(source, i);
            i = end > i ? end : i + 1;
            continue;
        }
        if (source[i] == '#' && (i + 1 >= n || source[i + 1] == ' ' || source[i + 1] == '\n' || source[i + 1] == '#')) {
            // A `#` comment written already: what is in it stays (the pass that wrote it may run again, #1956).
            while (i < n && source[i] != '\n') {
                i += 1;
            }
            continue;
        }
        if (i + 1 < n && source[i] == '/' && source[i + 1] == '/') {
            Bool blank = i + 2 >= n || source[i + 2] == ' ' || source[i + 2] == '\n';
            Str spaced = blank ? "#" : "# ";
            out = as_str(format::push(out, source[copied:i], spaced));
            copied = i + 2;
            while (i < n && source[i] != '\n') {
                i += 1;
            }
            continue;
        }
        if (i + 1 < n && source[i] == '/' && source[i + 1] == '*') {
            Usize close = block_end(source, i);
            if (close >= n) {
                i = n;
                continue;
            }
            out = as_str(format::push(out, source[copied:i], block_as_hashes(source[i + 2:close - 1])));
            copied = close + 1;
            i = copied;
            continue;
        }
        i += 1;
    }
    return as_str(format::push(out, source[copied:n]));
}

// Whether the `:` at `colon` closes a `?` of the same expression: a `?` is found before a `;`, `{` or `}` and with the
// brackets between them balanced.
static Bool after_question(lex::Tokens tokens, Usize colon) {
    Usize depth = 0;
    for (Usize k = colon; k > 0; k--) {
        lex::TokenKind kind = tokens[k - 1].kind;
        if (kind == lex::right_paren || kind == lex::right_bracket) depth += 1;
        if (kind == lex::left_paren || kind == lex::left_bracket) {
            if (depth == 0) return false;
            depth -= 1;
        }
        if (depth > 0) continue;
        if (kind == lex::question) return true;
        if (kind == lex::semicolon || kind == lex::left_brace || kind == lex::right_brace) return false;
    }
    return false;
}

// `type` is reserved like `i32` (#1901): in an old-syntax text every name `type` (a field, a local, a parameter, a type
// argument, a use after `.` or `->`) is written `ty`, in the declaration and every use. A name after `.` or `->` is
// always `ty` (the field of another file's struct); any other is `ty_` when the text already has a `ty` of its own. The
// keyword of smith's own syntax stays: `type` after a `:`, or after the `->` of a function head (`) -> type`).
static Bool is_keyword_use(lex::Tokens tokens, Usize i) {
    if (i == 0) return false;
    // A `:` before a member access or a closing bracket is a slice's (`s[start:type.end]`): a value, not the keyword.
    if (tokens[i - 1].kind == lex::colon) {
        if (i + 1 >= countof(tokens)) return true;
        lex::TokenKind next = tokens[i + 1].kind;
        // After the `:` of a C conditional (`a ? b->type : type;`) the name is a value: a `?` earlier in the same
        // expression, or a `;` right after it (`(T: type)` and `T: type,` keep the keyword).
        if (next == lex::semicolon) return false;
        if (after_question(tokens, i - 1)) return false;
        return next != lex::dot && next != lex::arrow && next != lex::right_bracket;
    }
    return tokens[i - 1].kind == lex::arrow && i > 1 && tokens[i - 2].kind == lex::right_paren;
}

static Str rename_type_names(Str source) {
    lex::Lexed lexed = lex::tokenize(source);
    if (lexed == .error) return source;
    lex::Tokens tokens = lexed.ok;
    Str type_word = "type";
    Str ty_word = "ty";
    Bool own_ty = false;
    Bool any = false;
    for (Usize i = 0; i < countof(tokens); i++) {
        if (tokens[i].kind != lex::name) continue;
        Str word = lex::text(source, tokens[i]);
        if (mem::equal(word, type_word) && !is_keyword_use(tokens, i)) any = true;
        if (mem::equal(word, ty_word) &&
            !(i > 0 && (tokens[i - 1].kind == lex::dot || tokens[i - 1].kind == lex::arrow)))
            own_ty = true;
    }
    if (!any) return source;
    Str out = "";
    Usize at = 0;
    for (Usize i = 0; i < countof(tokens); i++) {
        if (tokens[i].kind != lex::name || !mem::equal(lex::text(source, tokens[i]), type_word)) continue;
        if (is_keyword_use(tokens, i)) continue;
        Bool member = i > 0 && (tokens[i - 1].kind == lex::dot || tokens[i - 1].kind == lex::arrow);
        out = as_str(format::push(out, source[at:tokens[i].span.start], member || !own_ty ? "ty" : "ty_"));
        at = tokens[i].span.end;
    }
    return as_str(format::push(out, source[at:countof(source)]));
}

// `target::macos` (a C enumerator of the system or the processor) is written `.macos` (#2519, decided on #2460);
// `target::os` and `target::arch` stay `target.os` and `target.arch`, which the later passes write. Clang's
// `__FINITE_MATH_ONLY__` is `target.fast_math` (D14).
static Str rename_target_systems(Str source) {
    lex::Lexed lexed = lex::tokenize(source);
    if (lexed == .error) return source;
    lex::Tokens tokens = lexed.ok;
    Str target_word = "target";
    Str macos_word = "macos";
    Str linux_word = "linux";
    Str aarch64_word = "aarch64";
    Str x86_word = "x86_64";
    Str finite_word = "__FINITE_MATH_ONLY__"; // clang's macro for -ffast-math and -ffinite-math-only (D14, #2647)
    Str out = "";
    Usize at = 0;
    for (Usize i = 0; i < countof(tokens); i++) {
        if (tokens[i].kind == lex::name && mem::equal(lex::text(source, tokens[i]), finite_word)) {
            out = as_str(format::push(out, source[at:tokens[i].span.start], "target.fast_math"));
            at = tokens[i].span.end;
            continue;
        }
        if (i + 2 >= countof(tokens)) continue;
        if (tokens[i].kind != lex::name || tokens[i + 1].kind != lex::colon_colon || tokens[i + 2].kind != lex::name)
            continue;
        if (!mem::equal(lex::text(source, tokens[i]), target_word)) continue;
        Str word = lex::text(source, tokens[i + 2]);
        if (!mem::equal(word, macos_word) && !mem::equal(word, linux_word) && !mem::equal(word, aarch64_word) &&
            !mem::equal(word, x86_word))
            continue;
        out = as_str(format::push(out, source[at:tokens[i].span.start], ".", word));
        at = tokens[i + 2].span.end;
    }
    if (at == 0) return source;
    return as_str(format::push(out, source[at:countof(source)]));
}

// The passes of `fix_text`: parse, apply the fixes, parse the result again, until a pass applies none.
static void mend_passes(Str file, Fixed *total, Bool with_checker) {
    for (Usize pass = 0; pass < fix_passes; pass++) {
        parser::Parsed parsed = parse_for_fix(file, total->text);
        core::Errors errors = parsed.errors;
        // A struct declared twice is mended whatever else the file still has to mend (#2224).
        core::Errors opaque = fix_opaque::edits(total->text, &parsed.module);
        for (Usize i = 0; i < countof(opaque); i++) {
            errors = mem::realloc(errors, countof(errors) + 1);
            errors[countof(errors) - 1] = opaque[i];
        }
        // `mem.alloc_slice(T, a, b)` and `arena.push_slice(&x, T, a, b)` take a size or a shape (#2527)
        core::Errors sized = fix_alloc::edits(total->text);
        for (Usize i = 0; i < countof(sized); i++) {
            errors = mem::realloc(errors, countof(errors) + 1);
            errors[countof(errors) - 1] = sized[i];
        }
        // The checker waits one pass when the first still mends old forms of a file with a `Result` it tests:
        // `Result(T, E) r = f();` is `r: Result(T, E) = f()` first, so the `try` rewrite (#2506) sees a new
        // declaration and not the `if .error(error) := r` guard that would take its place in the same pass (#2648).
        // Only these files wait: the guards of one test are edits at several places, so a pass cannot drop some.
        Bool held = pass == 0 && countof(parsed.warnings) > 0 && contains_text(total->text, "Result(") &&
                    contains_text(total->text, ".error");
        if (with_checker && countof(parsed.errors) == 0 && !held) {
            core::Errors more = checker_fixes(total->text, &parsed.module);
            for (Usize i = 0; i < countof(more); i++) {
                if (inserts_at_replaced_start(errors, parsed.warnings, more[i])) continue;
                errors = mem::realloc(errors, countof(errors) + 1);
                errors[countof(errors) - 1] = more[i];
            }
        }
        Fixed fixed = apply_fixes(total->text, errors, parsed.warnings);
        if (fixed.applied == 0 && !held) break;
        total->text = fixed.text;
        // Once the text lexes as smith's own syntax (no old form is left in it), its `//` comments are written `#`
        // now: the next pass would otherwise read it with the old parser, which takes `pub const m: usize = 16` for
        // an old declaration and mends it again (#1956).
        Str hashed = hash_comments(total->text);
        if (!mem::equal(hashed, total->text) && lex::tokenize_new(hashed) != .error) total->text = hashed;
        total->applied += fixed.applied;
        total->skipped = fixed.skipped;
    }
}

// `in` is a keyword of smith's own syntax: a C name `in` (a local, a parameter, a field) is written `in_`, in the
// declaration and every use (#2390). The `in` of a `for x in xs` loop already in smith's own syntax stays: it is the
// one with a `for` earlier on its line and no open parenthesis between them.
static Bool is_for_in(lex::Tokens tokens, Usize i) {
    Usize depth = 0;
    for (Usize back = i; back > 0; back--) {
        lex::Token before = tokens[back - 1];
        if (before.kind == lex::right_paren) depth += 1;
        if (before.kind == lex::left_paren) {
            if (depth == 0) return false; // `for (I32 in = 0; ...)`: the name is inside the parentheses
            depth -= 1;
        }
        if (before.kind == lex::kw_for) return depth == 0;
        if (before.line_break) return false;
    }
    return false;
}

static Str rename_in_names(Str source) {
    lex::Lexed lexed = lex::tokenize(source);
    if (lexed == .error) return source;
    lex::Tokens tokens = lexed.ok;
    Str in_word = "in";
    Str out = "";
    Usize at = 0;
    for (Usize i = 0; i < countof(tokens); i++) {
        if (tokens[i].kind != lex::name || !mem::equal(lex::text(source, tokens[i]), in_word)) continue;
        if (is_for_in(tokens, i)) continue;
        out = as_str(format::push(out, source[at:tokens[i].span.start], "in_"));
        at = tokens[i].span.end;
    }
    if (at == 0) return source;
    return as_str(format::push(out, source[at:countof(source)]));
}

// `fn` is a keyword of smith's own syntax: a C name `fn` (a parameter holding a function, a local) is an error (#2455),
// in the declaration and every use. The keyword stays: `fn` before a name (`fn area(...)`), or before a lambda's
// parameters (`fn(x): ...`, `fn(x) -> T: ...`), where the `)` that closes them is followed by `:` or `->`, or a
// function type after a `:` or `->` (`body: fn()`).
static Bool is_fn_keyword(lex::Tokens tokens, Usize i) {
    if (i + 1 >= countof(tokens)) return false;
    lex::TokenKind next = tokens[i + 1].kind;
    if (next == lex::name || next == lex::type_name || lex::is_keyword(next)) return true; // `fn double(x: i32)`
    if (next != lex::left_paren) return false;
    // A function type (`body: fn()`, `-> fn(i32) -> i32`) stands after the `:` of a declaration or after an arrow.
    if (i > 0 && (tokens[i - 1].kind == lex::colon || tokens[i - 1].kind == lex::arrow)) return true;
    Usize depth = 0;
    for (Usize j = i + 1; j < countof(tokens); j++) {
        if (tokens[j].kind == lex::left_paren) depth += 1;
        if (tokens[j].kind != lex::right_paren) continue;
        depth -= 1;
        if (depth > 0) continue;
        return j + 1 < countof(tokens) && (tokens[j + 1].kind == lex::colon || tokens[j + 1].kind == lex::arrow);
    }
    return false;
}

// `yield x` in smith's own syntax is a statement: the `yield` has no `::` or `.` before it and a name or literal after
// it on its line. Any other `yield` (a declaration `bool yield(`, a call `stream::yield(s)`, `s.yield`) is a C name.
static Bool is_yield_keyword(lex::Tokens tokens, Usize i) {
    if (i > 0 && (tokens[i - 1].kind == lex::colon_colon || tokens[i - 1].kind == lex::dot)) return false;
    if (i + 1 >= countof(tokens) || tokens[i].line_break) return false;
    lex::TokenKind next = tokens[i + 1].kind;
    return next == lex::name || next == lex::type_name || next == lex::integer || next == lex::floating ||
           next == lex::character || next == lex::string;
}

// `yield` is a keyword of smith's own syntax too: only the statement `yield x` is one, any other `yield` is a C name.
// The fixer never invents a name (#2455; owner, 2026-11-05): a C identifier spelled `fn` or `yield` that is not the
// keyword is an error at that identifier, `` `yield` is a keyword: rename it ``, and the text is left alone.
static Str keyword_clash(Str source) {
    lex::Lexed lexed = lex::tokenize(source);
    if (lexed == .error) return "";
    lex::Tokens tokens = lexed.ok;
    Str fn_word = "fn";
    Str yield_word = "yield";
    for (Usize i = 0; i < countof(tokens); i++) {
        if (tokens[i].kind != lex::name) continue;
        Str word = lex::text(source, tokens[i]);
        Bool is_fn = mem::equal(word, fn_word);
        if (!is_fn && !mem::equal(word, yield_word)) continue;
        if (is_fn ? is_fn_keyword(tokens, i) : is_yield_keyword(tokens, i)) continue;
        Usize line = 1;
        Usize column = 1;
        for (Usize k = 0; k < tokens[i].span.start; k++) {
            column = source[k] == '\n' ? 1 : column + 1;
            if (source[k] == '\n') line += 1;
        }
        return as_str(format::push(line, ":", column, ": `", word, "` is a keyword: rename it"));
    }
    return "";
}

// Mends the text of the file called `file`: parses, applies the fixes, and parses the result again, until a pass
// applies none (at most 16 passes). `applied` counts the fixes of all the passes.
export Fixed fix_text(Str file, Str source) {
    Str renamed = rename_in_names(rename_type_names(rename_target_systems(fix_build::mend(file, source))));
    Fixed total = {.text = renamed, .clash = keyword_clash(source)};
    if (!mem::equal(renamed, source)) total.applied = 1;
    header_folder = ".";
    // Not compared with the last file: its text may be gone with that file's memory.
    database_read = false;
    database_text = "";
    database_file = file;
    for (Usize i = countof(file); i > 0; i--) { // a quoted header is looked up beside the file
        if (file[i - 1] != '/') continue;
        header_folder = i == 1 ? file[0:1] : file[0:i - 1];
        break;
    }
    mend_passes(file, &total, true);
    if (header_arena_made) { // what the headers declared is not needed once the passes are done
        arena::release(&header_arena);
        header_arena_made = false;
    }
    // The comments are written even when a form the fixer cannot mend is left, so no `//` hides the other causes.
    if (total.applied > 0) total.text = hash_comments(total.text);
    // The blocks last (#2014): the passes above read their own output with braces, so only now do `:` and the
    // indentation replace them (#2253). A text with another gap left is converted too: `fix_blocks` leaves alone a
    // body it cannot read, so the file then fails only on its own gap, not also on the braces.
    if (total.applied > 0) total.text = fix_blocks::convert(total.text);
    // The checker mends a local only once it is declared in smith's own syntax (`mut sum`, `&xs[0]`), which the blocks
    // pass has just finished writing: one more round, so that a second run of the fixer has nothing left (#2386).
    // A round can make the next one possible (a variant `lex.string` becomes `.string` only once the pointer types
    // around it are mended), so rounds repeat until one applies nothing: a second run has nothing left (#2449).
    for (Usize round = 0; round < fix_rounds && total.applied > 0 && countof(total.text) > 0; round++) {
        Fixed more = {.text = total.text};
        mend_passes(file, &more, true);
        if (more.applied == 0) break;
        total.text = fix_blocks::convert(hash_comments(more.text));
        total.applied += more.applied;
        total.skipped = more.skipped;
    }
    if (header_arena_made) {
        arena::release(&header_arena);
        header_arena_made = false;
    }
    return total;
}

// The text of a library module for the checker that reads it as an import (#2561): `char` and `bool` are C types to the
// checker while the module is still in today's syntax, and a function with one in its signature was left out of the
// module (`text.parse_f32(word, &value)` then had no `parse_f32` to check its arguments against, so `value` got no
// `mut`). They are written `Char` and `Bool` here, as the fixed module has them.
static Str read_c_types(Str source) {
    lex::Lexed lexed = lex::tokenize(source);
    if (lexed == .error) return source;
    lex::Tokens tokens = lexed.ok;
    Str out = "";
    Usize at = 0;
    for (Usize i = 0; i < countof(tokens); i++) {
        Bool is_char = tokens[i].kind == lex::kw_char;
        if (!is_char && tokens[i].kind != lex::kw_bool) continue;
        if (i > 0 && (tokens[i - 1].kind == lex::dot || tokens[i - 1].kind == lex::arrow ||
                      tokens[i - 1].kind == lex::colon_colon))
            continue;
        out = as_str(format::push(out, source[at:tokens[i].span.start], is_char ? "Char" : "Bool"));
        at = tokens[i].span.end;
    }
    if (at == 0) return source;
    return as_str(format::push(out, source[at:countof(source)]));
}

// Whether the text is a module written in today's syntax: it has a `module` line (smith's own syntax derives the name
// from the path and has none).
static Bool has_module_line(Str source) {
    lex::Lexed lexed = lex::tokenize(source);
    if (lexed == .error) return false;
    lex::Tokens tokens = lexed.ok;
    for (Usize i = 0; i < countof(tokens); i++) {
        if (tokens[i].kind == lex::kw_module) return true;
    }
    return false;
}

// Whether a variable is the alias of a type, as a mended `typedef T Name;` is: a capitalized name bound to a name, a
// member (`c.SmithAllocator`) or a type value, which the checker reads as an alias only in smith's own syntax (#2602).
static Bool is_type_alias_form(Str name, const ast::Expr *init) {
    if (countof(name) == 0 || name[0] < 'A' || name[0] > 'Z' || init == nullptr) return false;
    return init->kind == .name || init->kind == .member || init->kind == .type_value;
}

// A module in today's syntax that the own-syntax parser took (it reads C-like declarations too) is marked as written in
// today's syntax: `Parser *p` is then a writable pointer, as it is in the file, and the importer's `&x` and `p` need
// `mut x` and `*mut Parser` to be passed (#2561). Left as the own parser marked them, they were read-only pointers and
// the checker asked for nothing.
static void as_todays_syntax(ast::Module *module) {
    for (Usize i = 0; i < countof(module->decls); i++) {
        ast::Decl *d = module->decls[i];
        if (d->kind == .function) {
            d->kind.function.is_new = false;
            for (Usize k = 0; k < countof(d->kind.function.params); k++) {
                ast::Param *param = &d->kind.function.params[k];
                param->is_new = false;
                // `auto... pieces` is the pack `pieces...` the checker types: left as a rest parameter, a call of
                // `console::print_error` had no type, so its discarded result got no `_ :=` (#2566).
                if (param->is_rest) {
                    param->is_rest = false;
                    param->is_pack = true;
                    param->is_new = true;
                }
            }
        } else if (d->kind == .variable) {
            // `Allocator := c.SmithAllocator`, what a typedef alias is mended to, is still an alias of a type (#2602)
            if (!is_type_alias_form(d->kind.variable.name, d->kind.variable.init)) d->kind.variable.is_new = false;
        }
    }
}

// The text of an import that does not parse, mended by the parse errors' fixes alone (#2561). The mending of
// front/types.smith, front/ast_clone.smith, std.mem and the others took 6 s in every fixer that imports them, and the
// count of `frontend-coverage` (one fixer per file) no longer fitted in its 20 minutes (#2586). With
// SMITH_FIX_IMPORT_CACHE set to a folder, the mended text is kept there by the hash of the path and the text, and the
// next fixer reads it back; the coverage gives one folder per smith, since the mending depends on the fixer.
static Str mended_import(Str path, Str source) {
    const char *folder = c::getenv("SMITH_FIX_IMPORT_CACHE");
    U64 hash = 14695981039346656037ULL; // FNV-1a over the path, a NUL, then the text
    for (Usize i = 0; i < countof(path); i++)
        hash = (hash ^ (U64)(U8)path[i]) * 1099511628211ULL;
    hash = hash * 1099511628211ULL;
    for (Usize i = 0; i < countof(source); i++)
        hash = (hash ^ (U64)(U8)source[i]) * 1099511628211ULL;
    Str kept = "";
    if (folder != nullptr) kept = as_str(format::push(folder, "/", format::hex(hash, 16), ".smith"));
    if (countof(kept) > 0 && files::exists(kept)) {
        files::BytesResult loaded = files::read_file(kept);
        if (loaded == .ok) {
            format::Chars chars = mem::view(loaded.ok, char);
            Str text = chars;
            return text;
        }
    }
    Fixed mended = {.text = source};
    mend_passes(path, &mended, false);
    if (countof(kept) > 0) {
        U8 bytes[:] = mem::alloc_slice(U8, countof(mended.text));
        for (Usize i = 0; i < countof(bytes); i++)
            bytes[i] = (U8)mended.text[i];
        (void)files::write_file(kept, bytes, files::Atomic);
    }
    return mended.text;
}

// The module of the file at `path`, read and mended as an import (#2561), or null when it does not read.
static const ast::Module *read_import(Str path) {
    files::BytesResult loaded = files::read_file(path);
    if (loaded == .error) return nullptr;
    format::Chars chars = mem::view(loaded.ok, char);
    // The file's own renames come first (`type` is `ty`, `in` is `in_`, `target::macos` is `.macos`), so an import
    // reads as the fixed module does (#2561).
    Str source = read_c_types(rename_in_names(rename_type_names(rename_target_systems(chars))));
    parser::Parsed parsed = parse_for_fix(path, source);
    if (countof(parsed.errors) > 0) {
        // A library module that still has a spelling smith's parser refuses (`[[gnu::always_inline]]`, `__asm__`)
        // does not read as it is, so the import was null and the checker, knowing nothing of `std.text`, made none
        // of its `mut` fix-its (#2561). Only the parse errors' fixes are applied here, never the checker's: the
        // checker is running (a nested one would take its hooks away), and the module stays in today's syntax,
        // where `F32 *value` is writable.
        parsed = parse_for_fix(path, mended_import(path, source));
        if (countof(parsed.errors) > 0) return nullptr;
    }
    ast::Module *copy = mem::alloc(ast::Module);
    *copy = parsed.module;
    if (has_module_line(source)) as_todays_syntax(copy);
    // a pointer field its own fix makes `?*T = .none` is one here too, so the reads of it are mended (#2557)
    fix_zero::nullable_fields(copy, source);
    return copy;
}

// `read_import` of `path`, once per run: a module read before is given again, null included (#2586).
static const ast::Module *read_import_once(Str path) {
    for (Usize i = 0; i < loaded_count; i++) {
        if (mem::equal(loaded_paths[i], path)) return loaded_modules[i];
    }
    const ast::Module *module = read_import(path);
    if (loaded_count < loaded_max) {
        loaded_paths[loaded_count] = path;
        loaded_modules[loaded_count] = module;
        loaded_count += 1;
    }
    return module;
}

// The tree of the module at the dotted `path` (`std.list`, NUL-terminated) for the checker: the file under the
// project's source folder, else under smith's library folder (`front::roots`), else beside the file that imports it;
// null when neither holds it or it does not read.
static const ast::Module *load_from_folders(const char *dotted) {
    Str relative = as_str(format::push((const char *)dotted));
    Str inside = "";
    for (Usize i = 0; i < countof(relative); i++) {
        Str piece = relative[i:i + 1];
        if (relative[i] == '.') piece = "/";
        inside = as_str(format::push(inside, piece));
    }
    roots::Roots folders = roots::default_roots();
    // The compile's `load_module` also looks beside the importing file (#2519): `tests/scratch.smith` for a test.
    Str where[3] = {folders.source, folders.library, header_folder};
    for (Usize k = 0; k < 3; k++) {
        Str path = as_str(format::push(where[k], "/", inside, ".smith"));
        if (!files::exists(path)) continue;
        return read_import_once(path);
    }
    return nullptr;
}

// Fixes one file in place. Returns the number of fixes applied, or -1 when the file cannot be read or written.
export I64 fix_file(Str path) {
    files::BytesResult loaded = files::read_file(path);
    if (loaded == .error) return -1;
    format::Chars chars = mem::view(loaded.ok, char);
    Str source = chars;
    Fixed fixed = fix_text(path, source);
    if (fixed.applied > 0 && !store(path, fixed.text)) return -1;
    return (I64)fixed.applied;
}

// The text of the file at `path` mended, or an empty text and false when it cannot be read.
static Bool fix_to_text(Str path, Fixed *fixed) {
    files::BytesResult loaded = files::read_file(path);
    if (loaded == .error) return false;
    format::Chars chars = mem::view(loaded.ok, char);
    Str source = chars;
    *fixed = fix_text(path, source);
    return true;
}

// The driver's entry for `smith lint --fix FILE...`: each file fixed, then the enum variants of all the files renamed
// to lowercase together (#2098: a variant is declared in one file and used in others), `path: N fixes applied` on
// standard output for each file (the renamed file counts one more), 0 when every file could be read and written.
[[std::c_name("front_parser_fix_run")]] export I32 fix_run(const char *const *paths, Usize count) {
    I32 status = 0;
    // The loader is the fixer's for this run only (#2560): left set, it made every later `fix_text` in the process
    // (the next test in the same worker) parse the real modules of smith's library folder, and overflow its arena.
    types::ModuleLoader outside = loader;
    loader = load_from_folders;
    loaded_count = 0; // the modules of an earlier run are read again: a test may have changed the files
    defer loader = outside;
    defer loaded_count = 0;
    fix_variants::Words texts = mem::alloc_slice(fix_variants::Word, count);
    I64 applied[:] = mem::alloc_slice(I64, count);
    for (Usize i = 0; i < count; i++) {
        Str path = as_str(format::push((const char *)paths[i]));
        Fixed fixed = {};
        applied[i] = fix_to_text(path, &fixed) ? (I64)fixed.applied : -1;
        texts[i].text = fixed.text;
        if (countof(fixed.clash) == 0) continue;
        Str problem = as_str(format::push(path, ":", fixed.clash, "\n"));
        (void)c::write(2, problem.data, countof(problem));
        status = 1;
    }
    fix_variants::Words renamed = fix_variants::rename_all(texts);
    for (Usize i = 0; i < count; i++) {
        Str path = as_str(format::push((const char *)paths[i]));
        I64 n = applied[i];
        if (n >= 0 && !mem::equal(renamed[i].text, texts[i].text)) {
            n += 1;
            // The renamed variants are what makes the text parse, and the checker's fixes (`mut`, `*mut`) read only a
            // text that parses: a second run mends them in the same `--fix` (#2224: a second `lint --fix` gave
            // `format` 32 more).
            Fixed again = fix_text(path, renamed[i].text);
            renamed[i].text = again.text;
            n += (I64)again.applied;
        }
        if (n > 0 && !store(path, renamed[i].text)) n = -1;
        Str line = n < 0 ? as_str(format::push(path, ": cannot read or write the file\n"))
                         : as_str(format::push(path, ": ", n, n == 1 ? " fix applied\n" : " fixes applied\n"));
        (void)c::write(n < 0 ? 2 : 1, line.data, countof(line));
        if (n < 0) status = 1;
    }
    return status;
}
