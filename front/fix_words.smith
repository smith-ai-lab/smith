// front::fix_words, the fix-it for the operators written as words (D19, #2648).
//
//   a && b || !c          a and b or not c
//
// `and`, `or` and `not` replace `&&`, `||` and `!`; `!=` stays. The text of a string, a character or a comment is not
// code and is left. A `!` is rewritten only when its operand is a name, a call, an index or a parenthesized group that
// no operator follows: `!a == b` reads `(!a) == b` in C and `not` binds looser, so that one stays as it is. The
// parser reads the words from #2649 on; `fix.smith` waits for it. Tests: `tests/front_fix_words_test.smith`.
//
//   fix_words::edits(source)   one fix for each operator
module front::fix_words;

import front::ast;
import front::parse as core;
import front::types;
import std::format;
import std::mem;

static Bool word_char(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
}

static core::Errors add(core::Errors out, Usize start, Usize stop, Str text) {
    out = mem::realloc(out, countof(out) + 1);
    core::Edits fix = {};
    fix = mem::realloc(fix, 1);
    ast::Span at = {.start = (U32)start, .end = (U32)stop};
    fix[0] = (core::Edit){.span = at, .text = text};
    core::ParseError made = {};
    made.span = at;
    Str why = "`and`, `or` and `not` are the operators";
    made.message = why;
    made.fix = fix;
    out[countof(out) - 1] = made;
    return out;
}

// The word `w` for the two characters at `at`, with a blank on each side that has none.
static Str spaced(Str source, Usize at, Str w) {
    Str blank = " ";
    Str none = "";
    Str lead = at > 0 && source[at - 1] == ' ' ? none : blank;
    Str tail = at + 2 < countof(source) && source[at + 2] == ' ' ? none : blank;
    return types::message_of(format::push(lead, w, tail));
}

// The end of the string or character literal that starts at `at` (the quote).
static Usize literal_end(Str source, Usize at) {
    char quote = source[at];
    Usize k = at + 1;
    while (k < countof(source) && source[k] != quote && source[k] != '\n') {
        if (source[k] == '\\') k += 1;
        k += 1;
    }
    return k + 1;
}

// The end of the operand of a `!` that starts at `at`: a name, a call, an index, a member, or a group; `at` itself
// when it is none of these.
static Usize operand_end(Str source, Usize at) {
    Usize k = at;
    while (k < countof(source) && (source[k] == '(' || source[k] == '[')) {
        char open = source[k];
        char close = open == '(' ? ')' : ']';
        Usize depth = 0;
        while (k < countof(source)) {
            if (source[k] == open) depth += 1;
            if (source[k] == close) depth -= 1;
            k += 1;
            if (depth == 0) break;
        }
        return k;
    }
    while (k < countof(source)) {
        if (word_char(source[k]) || source[k] == '.') {
            k += 1;
        } else if (source[k] == '-' && k + 1 < countof(source) && source[k + 1] == '>') {
            k += 2;
        } else if (source[k] == '(' || source[k] == '[') {
            char open = source[k];
            char close = open == '(' ? ')' : ']';
            Usize depth = 0;
            while (k < countof(source)) {
                if (source[k] == open) depth += 1;
                if (source[k] == close) depth -= 1;
                k += 1;
                if (depth == 0) break;
            }
        } else {
            break;
        }
    }
    return k;
}

// Whether an operator that binds tighter than `not` follows at `at` (after blanks).
static Bool operator_follows(Str source, Usize at) {
    Usize k = at;
    while (k < countof(source) && source[k] == ' ')
        k += 1;
    if (k >= countof(source)) return false;
    char ch = source[k];
    char next = k + 1 < countof(source) ? source[k + 1] : ' ';
    if (ch == '=' && next == '=') return true;
    if (ch == '!' && next == '=') return true;
    if (ch == '&' && next == '&') return false;
    if (ch == '|' && next == '|') return false;
    return ch == '<' || ch == '>' || ch == '+' || ch == '-' || ch == '*' || ch == '/' || ch == '%' || ch == '&' ||
           ch == '|' || ch == '^';
}

export core::Errors edits(Str source) {
    core::Errors out = {};
    Str and_word = "and";
    Str or_word = "or";
    Str not_word = "not ";
    Usize i = 0;
    Bool line_start = true;
    while (i < countof(source)) {
        char ch = source[i];
        char next = i + 1 < countof(source) ? source[i + 1] : ' ';
        if (ch == '\n') {
            line_start = true;
            i += 1;
            continue;
        }
        if (line_start && ch == ' ') {
            i += 1;
            continue;
        }
        if (line_start && ch == '#') {
            while (i < countof(source) && source[i] != '\n')
                i += 1;
            continue;
        }
        line_start = false;
        if (ch == '/' && next == '/') {
            while (i < countof(source) && source[i] != '\n')
                i += 1;
        } else if (ch == '/' && next == '*') {
            i += 2;
            while (i + 1 < countof(source) && !(source[i] == '*' && source[i + 1] == '/'))
                i += 1;
            i += 2;
        } else if (ch == '"' || ch == '\'') {
            i = literal_end(source, i);
        } else if (ch == '&' && next == '&') {
            out = add(out, i, i + 2, spaced(source, i, and_word));
            i += 2;
        } else if (ch == '|' && next == '|') {
            out = add(out, i, i + 2, spaced(source, i, or_word));
            i += 2;
        } else if (ch == '!' && next != '=' && next != ' ') {
            Usize stop = operand_end(source, i + 1);
            if (stop > i + 1 && !operator_follows(source, stop)) out = add(out, i, i + 1, not_word);
            i += 1;
        } else {
            i += 1;
        }
    }
    return out;
}
