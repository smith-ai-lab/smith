// front::fix_typeof, the fix-it for `typeof` of something the new syntax has no `typeof` for (#2340, part of #2224):
// a generic over a slice is an inferred parameter, so `realloc(auto xs, ...)` that names `typeof(xs)`,
// `typeof(xs.data)` and `typeof(xs.data.*)` (or `typeof(xs[0])`) is written `realloc[T](xs: []mut T, ...)` with
// `[]mut T`, `*mut T` and `T` in their places; `typeof([]u8)`, a `typeof` of a type written out, is that type.
//
// The slice is `[]mut T` when the function writes through the parameter (`xs[i] = v`, `xs.data[i] = v`,
// `__builtin_memcpy(&xs[0], ...)`) or builds a value of its type (`: typeof(xs) =`): a slice it makes is one its
// caller writes. Otherwise it is `[]T`. A function with more than one `auto` parameter, an `auto` that is not used as
// a slice, or a `typeof` of any other expression is left alone: the checker still reports it.
//
//   fix_typeof::edits(source, module)   one fix for each generic function and each `typeof` of a written type
module front::fix_typeof;

import front::ast;
import front::parse as core;
import front::types;
import std::format;
import std::mem;

static Bool at(Str s, Usize i, Str pattern) {
    if (i + countof(pattern) > countof(s)) return false;
    return mem::equal(s[i:i + countof(pattern)], pattern);
}

static Bool word_char(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
}

// The offset of the `)` that closes the `(` at `open`, or `to` when there is none.
static Usize close_of(Str s, Usize open, Usize to) {
    Usize depth = 0;
    for (Usize i = open; i < to; i++) {
        if (s[i] == '(') depth += 1;
        if (s[i] == ')') {
            depth -= 1;
            if (depth == 0) return i;
        }
    }
    return to;
}

static core::Edits push(core::Edits edits, Usize from, Usize to, Str text) {
    edits = mem::realloc(edits, countof(edits) + 1);
    edits[countof(edits) - 1] = (core::Edit){.span = {.start = (U32)from, .end = (U32)to}, .text = text};
    return edits;
}

// Whether `arg` is `name` followed by exactly `rest`.
static Bool is_use(Str arg, Str name, Str rest) {
    if (countof(arg) != countof(name) + countof(rest)) return false;
    return at(arg, 0, name) && at(arg, countof(name), rest);
}

// What `typeof(arg)` is written for the slice parameter `name`, or empty when it is something else.
static Str spelling(Str arg, Str name, Bool mutable) {
    if (is_use(arg, name, "")) return mutable ? "[]mut T" : "[]T";
    if (is_use(arg, name, ".data")) return mutable ? "*mut T" : "*T";
    if (is_use(arg, name, ".data.*") || is_use(arg, name, "[0]")) return "T";
    return "";
}

// Whether `text` holds `name` as a whole word followed by `rest`.
static Bool word_then(Str text, Usize i, Str name, Str rest) {
    if (i > 0 && (word_char(text[i - 1]) || text[i - 1] == '.')) return false;
    return at(text, i, name) && at(text, i + countof(name), rest);
}

// The offset after the `]` that closes the `[` at `open`, or the end of `text`.
static Usize after_bracket(Str text, Usize open) {
    Usize depth = 0;
    for (Usize i = open; i < countof(text); i++) {
        if (text[i] == '[') depth += 1;
        if (text[i] == ']') {
            depth -= 1;
            if (depth == 0) return i + 1;
        }
    }
    return countof(text);
}

// Whether `text` at `i` is the C memory function `writer` writing at `name` (`__builtin_memcpy(&dst[0], ...)`).
static Bool raw_write(Str text, Usize i, Str writer, Str name) {
    Usize after = i + countof(writer);
    return at(text, i, writer) && at(text, after, name) && at(text, after + countof(name), "[");
}

// Whether the function's text writes through `name` or builds a value of its type.
static Bool writes(Str text, Str name) {
    for (Usize i = 0; i < countof(text); i++) {
        if (at(text, i, ": typeof(") && at(text, i + 9, name) && at(text, i + 9 + countof(name), ") =")) return true;
        if (raw_write(text, i, "__builtin_memcpy(&", name) || raw_write(text, i, "__builtin_memmove(&", name) ||
            raw_write(text, i, "__builtin_memset(&", name))
            return true;
        Usize open = i + countof(name);
        if (word_then(text, i, name, ".data["))
            open += 5;
        else if (!word_then(text, i, name, "["))
            continue;
        Usize j = after_bracket(text, open);
        while (j < countof(text) && text[j] == ' ')
            j += 1;
        if (j + 1 < countof(text) && text[j] == '=' && text[j + 1] != '=') return true;
    }
    return false;
}

// Whether the offset `i` is inside a string or character literal or a comment of its line (#2520): a `typeof(` there is
// text, not code. Strings and comments end with their line.
static Bool in_literal(Str s, Usize i) {
    Usize from = i;
    while (from > 0 && s[from - 1] != '\n')
        from -= 1;
    char quote = 0;
    for (Usize k = from; k < i; k++) {
        if (quote != 0) {
            if (s[k] == '\\')
                k += 1;
            else if (s[k] == quote)
                quote = 0;
        } else if (s[k] == '"' || s[k] == '\'') {
            quote = s[k];
        } else if (s[k] == '#' || (s[k] == '/' && k + 1 < i && s[k + 1] == '/')) {
            return true;
        }
    }
    return quote != 0;
}

// Whether `text` picks what to do by the type of the parameter itself, `typeof(name) == char *` (#2668): the function
// takes more than slices (`std::format`'s `make_padded` tests a string, a slice and a number), so `auto` stays.
static Bool dispatches(Str text, Str name) {
    for (Usize i = 0; i < countof(text); i++) {
        if (!at(text, i, "typeof(") || !at(text, i + 7, name) || !at(text, i + 7 + countof(name), ")")) continue;
        Usize j = i + 8 + countof(name);
        while (j < countof(text) && text[j] == ' ')
            j += 1;
        if (at(text, j, "==") || at(text, j, "!=")) return true;
    }
    return false;
}

// Whether `text` uses `typeof(name` and reads `name` as a slice.
static Bool used_as_slice(Str text, Str name) {
    if (dispatches(text, name)) return false;
    Bool typed = false;
    Bool sliced = false;
    for (Usize i = 0; i < countof(text); i++) {
        if (at(text, i, "typeof(") && at(text, i + 7, name) && !in_literal(text, i)) typed = true;
        if (word_then(text, i, name, ".data") || word_then(text, i, name, ".count")) sliced = true;
        if (at(text, i, "countof(") && word_then(text, i + 8, name, ")")) sliced = true; // `copy(auto dst[:], ...)`
    }
    return typed && sliced;
}

// The edits of every `typeof(...)` in source[from:to] that the slice parameter `name` spells.
static core::Edits rewrite_uses(core::Edits edits, Str source, Usize from, Usize to, Str name, Bool mutable) {
    for (Usize i = from; i + 7 < to; i++) {
        if (!at(source, i, "typeof(") || (i > 0 && word_char(source[i - 1])) || in_literal(source, i)) continue;
        Usize close = close_of(source, i + 6, to);
        if (close == to) continue;
        Str text = spelling(source[i + 7:close], name, mutable);
        if (countof(text) > 0) edits = push(edits, i, close + 1, text);
    }
    return edits;
}

// The fix of the generic function `d`: its `auto` parameter, its name's `[T]` and every `typeof` of the parameter.
static core::ParseError generic_fix(Str source, const ast::Decl *d) {
    core::ParseError none = {};
    if (d->kind != .function) return none;
    ast::Param params[:] = d->kind.function.params;
    Usize found = countof(params);
    for (Usize i = 0; i < countof(params); i++) {
        const ast::TypeExpr *type = params[i].type;
        if (type == nullptr || type->kind != .auto_type) continue;
        if (found != countof(params) || params[i].is_rest) return none; // one `auto`, no pack
        found = i;
    }
    if (found == countof(params) || d->kind.function.body == nullptr) return none;
    Usize start = d->span.start;
    Usize end = d->span.end < countof(source) ? d->span.end : countof(source);
    Str name = params[found].name;
    Str text = source[start:end];
    if (!used_as_slice(text, name) || word_then(text, 0, "T", "")) return none;
    Usize param_end = params[found].span.end;
    if (param_end < 4 || param_end > end || !at(source, param_end - 4, "auto")) return none;
    // The name of the function: `fn <name>(`.
    Str fname = d->kind.function.name;
    Usize name_end = end;
    for (Usize i = start; i + 3 + countof(fname) < end; i++)
        if (at(source, i, "fn ") && at(source, i + 3, fname) && source[i + 3 + countof(fname)] == '(') {
            name_end = i + 3 + countof(fname);
            break;
        }
    if (name_end == end) return none;
    Bool mutable = writes(text, name);
    core::Edits edits = {};
    edits = push(edits, name_end, name_end, "[T]");
    edits = push(edits, param_end - 4, param_end, mutable ? "[]mut T" : "[]T");
    edits = rewrite_uses(edits, source, start, end, name, mutable);
    core::ParseError out = {};
    out.span = d->span;
    out.message = "an `auto` slice parameter is an inferred parameter: write `[T]` and `[]T`";
    out.fix = edits;
    return out;
}

// Whether the text of a parameter is `name: *[]auto` or `name: *mut []auto` (`mut` after the brackets too): a pointer to a
// slice of any element type, as `const auto (*xs)[:]` is mended.
static Bool is_slice_pointer(Str param) {
    Usize colon = 0;
    while (colon < countof(param) && param[colon] != ':') colon += 1;
    if (colon + 3 >= countof(param) || !at(param, colon + 1, " *")) return false;
    Usize n = countof(param);
    return n >= 6 && at(param, n - 6, "[]auto");
}

// The element type of the pointer to a slice that `d` takes, written `typeof((xs.*)[0])` in the body and the result:
// the function is generic in it, `fn name[T](xs: *mut []T, ...)`.
static core::ParseError pointer_fix(Str source, const ast::Decl *d) {
    core::ParseError none = {};
    if (d->kind != .function || d->kind.function.body == nullptr) return none;
    ast::Param params[:] = d->kind.function.params;
    Usize found = countof(params);
    for (Usize i = 0; i < countof(params); i++) {
        if (params[i].span.end > countof(source) || params[i].span.start >= params[i].span.end) continue;
        Str param = source[params[i].span.start:params[i].span.end];
        if (!is_slice_pointer(param)) continue;
        if (found != countof(params)) return none;
        found = i;
    }
    if (found == countof(params)) return none;
    Usize start = d->span.start;
    Usize end = d->span.end < countof(source) ? d->span.end : countof(source);
    Str fname = d->kind.function.name;
    Usize name_end = end;
    for (Usize i = start; i + 3 + countof(fname) < end; i++) {
        if (at(source, i, "fn ") && at(source, i + 3, fname) && source[i + 3 + countof(fname)] == '(') {
            name_end = i + 3 + countof(fname);
            break;
        }
    }
    if (name_end == end) return none;
    core::Edits edits = {};
    edits = push(edits, name_end, name_end, "[T]");
    edits = push(edits, params[found].span.end - 4, params[found].span.end, "T");
    Str name = params[found].name;
    for (Usize i = params[found].span.end; i + 8 < end; i++) {
        if (!at(source, i, "typeof(") || (i > 0 && word_char(source[i - 1])) || in_literal(source, i)) continue;
        Usize close = close_of(source, i + 6, end);
        if (close == end) continue;
        Str arg = source[i + 7:close];
        Str cut = types::message_of(format::push("(", name, ".*)[0:0]"));
        Str one = types::message_of(format::push("(", name, ".*)[0]"));
        if (mem::equal(arg, cut)) edits = push(edits, i, close + 1, "[]T");
        if (mem::equal(arg, one)) edits = push(edits, i, close + 1, "T");
    }
    core::ParseError out = {};
    out.span = d->span;
    out.message = "a pointer to a slice of `auto` is an inferred parameter: write `[T]` and `*mut []T`";
    out.fix = edits;
    return out;
}

// The fix of the `typeof([...])` that starts at `i`: the type inside, or none.
static core::ParseError written_type(Str source, Usize i) {
    core::ParseError none = {};
    if (!at(source, i, "typeof([") || (i > 0 && (word_char(source[i - 1]) || source[i - 1] == '.'))) return none;
    if (in_literal(source, i)) return none;
    Usize close = close_of(source, i + 6, countof(source));
    if (close == countof(source)) return none;
    core::ParseError out = {};
    out.span = (ast::Span){.start = (U32)i, .end = (U32)(close + 1)};
    out.message = "`typeof` of a type written out is that type";
    out.fix = push(out.fix, i, close + 1, source[i + 7:close]);
    return out;
}

// The new syntax's name of a C base type written in `typeof(x) == T *` (`U8` is `u8`); anything else is kept.
static Bool same(Str a, Str b) {
    return countof(a) == countof(b) && at(a, 0, b);
}

static Str base_name(Str word) {
    if (same(word, "Char")) return "char";
    if (same(word, "U8")) return "u8";
    if (same(word, "I8")) return "i8";
    if (same(word, "U16")) return "u16";
    if (same(word, "I16")) return "i16";
    if (same(word, "U32")) return "u32";
    if (same(word, "I32")) return "i32";
    if (same(word, "U64")) return "u64";
    if (same(word, "I64")) return "i64";
    if (same(word, "F32")) return "f32";
    if (same(word, "F64")) return "f64";
    if (same(word, "Usize")) return "usize";
    if (same(word, "Isize")) return "isize";
    if (same(word, "Bool")) return "bool";
    if (same(word, "Void")) return "void";
    return word;
}

static Usize skip_space(Str s, Usize i) {
    while (i < countof(s) && (s[i] == ' ' || s[i] == '\n' || s[i] == '\t')) i += 1;
    return i;
}

static Usize word_end(Str s, Usize i) {
    while (i < countof(s) && word_char(s[i])) i += 1;
    return i;
}

// The slice struct `struct smith_array_char_n` / `struct smith_array_const_char_n` at `i`: `[]mut char` / `[]char`.
static Str slice_type(Str s, Usize i, Usize *end) {
    if (!at(s, i, "struct smith_array_")) return "";
    Usize stop = word_end(s, i + 7);
    Str tag = s[i + 19:stop];
    if (countof(tag) < 3 || !at(tag, countof(tag) - 2, "_n")) return "";
    tag = tag[:countof(tag) - 2];
    Bool read_only = at(tag, 0, "const_");
    if (read_only) tag = tag[6:];
    if (countof(tag) == 0 || !word_char(tag[0])) return "";
    *end = stop;
    return types::message_of(format::push(read_only ? "[]" : "[]mut ", base_name(tag)));
}

// The pointer type `char *` / `const char *` at `i`: `*mut char` / `*char`. One star only.
static Str pointer_type(Str s, Usize i, Usize *end) {
    Bool read_only = false;
    if (at(s, i, "const ")) {
        read_only = true;
        i = skip_space(s, i + 5);
    }
    Usize stop = word_end(s, i);
    if (stop == i || same(s[i:stop], "struct")) return "";
    Str base = s[i:stop];
    Usize star = skip_space(s, stop);
    if (at(s, star, "const")) {
        read_only = true;
        star = skip_space(s, star + 5);
    }
    if (!at(s, star, "*") || at(s, star + 1, "*") || at(s, star + 1, "=")) return "";
    *end = star + 1;
    return types::message_of(format::push(read_only ? "*" : "*mut ", base_name(base)));
}

// The fix of the `typeof(x) == T` or `!= T` that starts at `i` when `T` is a C pointer or slice struct written out.
static core::ParseError compared_type(Str source, Usize i) {
    core::ParseError none = {};
    if (!at(source, i, "typeof(") || (i > 0 && (word_char(source[i - 1]) || source[i - 1] == '.'))) return none;
    if (in_literal(source, i)) return none;
    Usize close = close_of(source, i + 6, countof(source));
    if (close == countof(source)) return none;
    Usize at_op = skip_space(source, close + 1);
    if (!at(source, at_op, "==") && !at(source, at_op, "!=")) return none;
    Usize from = skip_space(source, at_op + 2);
    Usize end = from;
    Str type = slice_type(source, from, &end);
    if (countof(type) == 0) type = pointer_type(source, from, &end);
    if (countof(type) == 0) return none;
    core::ParseError out = {};
    out.span = (ast::Span){.start = (U32)from, .end = (U32)end};
    out.message = "a C pointer or slice type tested with `typeof` is written `*mut T`, `*T`, `[]mut T` or `[]T`";
    out.fix = push(out.fix, from, end, type);
    return out;
}

// The fixes of the module: each generic function over a slice, and each `typeof` of a type written out.
export core::Errors edits(Str source, const ast::Module *module) {
    core::Errors out = {};
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind != .function) continue;
        core::ParseError found = generic_fix(source, d);
        if (countof(found.fix) == 0) found = pointer_fix(source, d);
        if (countof(found.fix) == 0) continue;
        out = mem::realloc(out, countof(out) + 1);
        out[countof(out) - 1] = found;
    }
    for (Usize i = 0; i < countof(source); i++) {
        core::ParseError found = written_type(source, i);
        if (countof(found.fix) == 0) found = compared_type(source, i);
        if (countof(found.fix) == 0) continue;
        out = mem::realloc(out, countof(out) + 1);
        out[countof(out) - 1] = found;
    }
    return out;
}
