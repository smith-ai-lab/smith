// front::effects_table: the effects of smith's own checker as data (#1965, piece 1 of #1939): the 13 bits, their
// names, and what each function of libc and libSystem does to the world. It carries the same bits and the same table
// as shim/effects_table.h, which the plugin reads and stays the source until the plugin is deleted (#1632);
// tests/front_effects_table_test.smith fails when the two differ.
//
//   describe(set)      the names of the bits of a set joined by ", " ("nothing" for the empty set)
//   leaf(name, &set)   true and the set of a function of the C library by name (0 for a pure one); false when the
//                      table does not know the name, which is `unknown` for the checker
//   count / name_at / set_at   the table itself, sorted by name (bytes), for the drift test
module front::effects_table;

import <string.h>;

import std::format;
import std::mem;

export constexpr U32 alloc = 1u << 0;
export constexpr U32 files = 1u << 1;
export constexpr U32 net = 1u << 2;
export constexpr U32 console = 1u << 3;
export constexpr U32 clock = 1u << 4;
export constexpr U32 process = 1u << 5;
export constexpr U32 env = 1u << 6;
export constexpr U32 entropy = 1u << 7;
export constexpr U32 globals = 1u << 8;
export constexpr U32 unknown = 1u << 9;
export constexpr U32 fails = 1u << 10;
export constexpr U32 code = 1u << 11;
export constexpr U32 tasks = 1u << 12;
export constexpr U32 everything = (1u << 13) - 1;

export constexpr Usize bit_count = 13;

static Str msg(char chars[:]) {
    return chars;
}

static Str text_of(const char *chars) {
    return chars[0:c::strlen(chars)];
}

static const char *const bit_names[13] = {"alloc",   "files",   "net",     "console", "clock", "process", "env",
                                          "entropy", "globals", "unknown", "fails",   "code",  "tasks"};

// The name of bit `i` (0 to 12), "" past the end.
export Str bit_name(Usize i) {
    if (i >= bit_count) return "";
    return text_of(bit_names[i]);
}

// The names of the bits of a set, in bit order, joined by ", ": "alloc, files". "nothing" for the empty set.
export Str describe(U32 set) {
    Str text = "";
    for (Usize i = 0; i < bit_count; i++) {
        if ((set & (1u << i)) == 0) continue;
        if (countof(text) > 0) text = msg(format::push(text, ", "));
        text = msg(format::push(text, text_of(bit_names[i])));
    }
    if (countof(text) == 0) return "nothing";
    return text;
}

