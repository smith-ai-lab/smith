export Str name_at(Usize i) {
    return text_of(function_names[i]);
}

export U32 set_at(Usize i) {
    return function_sets[i];
}

// -1 when a sorts before b byte for byte, 1 when after, 0 when equal.
static I32 compare(Str a, Str b) {
    Usize n = countof(a) < countof(b) ? countof(a) : countof(b);
    for (Usize i = 0; i < n; i++) {
        if (a[i] != b[i]) return (U8)a[i] < (U8)b[i] ? -1 : 1;
    }
    if (countof(a) == countof(b)) return 0;
    return countof(a) < countof(b) ? -1 : 1;
}

// The effects of a function of the C library by name: true and `*set` when the table knows it (0 for a pure one).
export Bool leaf(Str name, U32 *set) {
    Usize low = 0;
    Usize high = count;
    while (low < high) {
        Usize middle = low + (high - low) / 2;
        I32 order = compare(name, text_of(function_names[middle]));
        if (order == 0) {
            *set = function_sets[middle];
            return true;
        }
        if (order < 0) {
            high = middle;
        } else {
            low = middle + 1;
        }
    }
    return false;
}
