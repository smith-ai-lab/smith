// front::compile: `smith cc --front-end=new` (#1221, J2 of #1112). The new front end, joined for the first time: a
// `.smith` file is read, parsed (front::parser), type checked (front::types_decl), emitted (front::emit) and written to
// an object file (front::emit_object). Experimental: the flag is off by default and without it a `.smith` file still
// goes through the token lowering.
//
//   file(path, output, triple, roots)   one file to the object `output` for `triple` (empty: the driver's default
//                                       target); a `Report`: whether it worked, the diagnostics, the time of each stage
//   header(path, output, triple, roots) the C header of one file in smith's own syntax (#1621): `pub struct`s and
//                                       `pub fn`s with a C spelling, from the declarations alone (no checker), written
//                                       only when its bytes change; `run_header` is its C entry (`--smith-header`)
//   run(sources, outputs, count, triple)
//                                       what the driver calls (C: `front_compile_run`): every file of the command line
//                                       with the default roots, diagnostics on stderr, 0 when every object was written
//
// A diagnostic is `file:line:column: error: message`, one per error, and a stage that fails stops the next ones. The
// parser's warnings (of a file in smith's own syntax; a file in today's has one per old form, so its report stays as it
// was) are `file:line:column: warning: message`, one per line before any error; they do not stop the
// compile and, when only warnings were found, are the `Report.text` of a report that is ok (`run` writes them to
// stderr). Which parser reads a file (#1578): one whose first token (comments are not tokens) is the keyword `module`
// is in today's syntax and goes through `parser::parse`; any other file is smith's own (no `module` line: a module is
// named by its path) and goes through `parser::parse_new`. A cast that can lose a value is checked on this path too
// (`Options.checked`). The
// module's name is its path from a root (front::roots); a `module` line that disagrees is an error naming both. The
// target comes from the caller: the triple is the driver's, the data layout is the machine's for it, and the checker's
// pointer width follows the triple. Nothing reads the host here but the default triple when none is given.
module front::compile;

import front::ast;
import front::cimport;
import front::emit;
import front::emit_object;
import front::emit_state as state;
import front::parser;
import front::roots;
import front::types;
import front::types_decl;
import front::parse;
import std::arena;
import std::ascii;
import std::clock;
import std::files;
import std::format;
import std::mem;
import <llvm-c/Core.h>;
import <llvm-c/Target.h>;
import <llvm-c/TargetMachine.h>;
import <stdio.h>;
import <stdlib.h>;
import <unistd.h>;

static Str as_str(char chars[:]) {
    return chars;
}

// Nanoseconds of each stage.
export struct Times {
    U64 parse;
    U64 check;
    U64 emit;
    U64 write;
};

export struct Report {
    Bool ok;
    Str text; // the diagnostics, one line each; only the warnings (maybe none) when it worked
    Times times;
};

// The 1-based line and column (in bytes) of the byte `offset` of `source`, as `line:column`.
static Str position(Str source, U32 offset) {
    U64 line = 1;
    U64 column = 1;
    for (Usize i = 0; i < countof(source) && i < offset; i++) {
        if (source[i] == '\n') {
            line += 1;
            column = 1;
        } else {
            column += 1;
        }
    }
    return as_str(format::push(line, ":", column));
}

// One line of the report: `file:line:column: severity: message`, with `severity` `error` or `warning`.
static Str diagnostic(Str file, Str source, ast::Span span, Str severity, Str message) {
    return as_str(format::push(file, ":", position(source, span.start), ": ", severity, ": ", message, "\n"));
}

// The lines of `list`, in order, as `severity`.
static Str lines_of(Str file, Str source, parse::Errors list, Str severity) {
    Str all = "";
    for (Usize i = 0; i < countof(list); i++) {
        all = as_str(format::push(all, diagnostic(file, source, list[i].span, severity, list[i].message)));
    }
    return all;
}

// The line of a diagnostic of `severity` at byte `offset` of `source`, for the tests: the parse files record no
// warning yet that a case could show (F1 to F4, #1506 to #1509).
export Str diagnostic_for_test(Str file, Str source, U32 offset, Str severity, Str message) {
    return diagnostic(file, source, (ast::Span){.start = offset, .end = offset}, severity, message);
}

static Bool word_at(Str source, Usize at, Str word) {
    if (at + countof(word) > countof(source)) return false;
    for (Usize i = 0; i < countof(word); i++) {
        if (source[at + i] != word[i]) return false;
    }
    if (at + countof(word) == countof(source)) return true;
    char next = source[at + countof(word)];
    return !(ascii::alpha(next) || ascii::digit(next) || next == '_');
}

// Whether the first token of `source` is the keyword `module`: today's syntax (every file in it has the line).
static Bool starts_with_module(Str source) {
    Usize i = 0;
    while (i < countof(source)) {
        if (ascii::space(source[i])) {
            i += 1;
        } else if (i + 1 < countof(source) && source[i] == '/' && source[i + 1] == '/') {
            while (i < countof(source) && source[i] != '\n')
                i += 1;
        } else if (i + 1 < countof(source) && source[i] == '/' && source[i + 1] == '*') {
            i += 2;
            while (i + 1 < countof(source) && !(source[i] == '*' && source[i + 1] == '/'))
                i += 1;
            i += 2;
        } else {
            break;
        }
    }
    return word_at(source, i, "module");
}

// 64-bit unless the triple's architecture says otherwise (`x86_64`, `aarch64`, `arm64`, `wasm64`).
static types::Target target_of(Str triple) {
    Usize end = 0;
    while (end < countof(triple) && triple[end] != '-')
        end += 1;
    for (Usize i = 0; i + 1 < end; i++) {
        if (triple[i] == '6' && triple[i + 1] == '4') return types::lp64();
    }
    return (types::Target){.pointer_bytes = 4, .max_align = 8};
}

// The data layout the machine of `triple` has, as text; empty when the triple has no target. The text is the current
// allocator's.
static Str layout_of(Str triple) {
    c::LLVMInitializeAllTargetInfos();
    c::LLVMInitializeAllTargets();
    c::LLVMInitializeAllTargetMCs();
    c::LLVMInitializeAllAsmPrinters();
    char *name = state::cstr(triple);
    defer mem::free(name);
    c::LLVMTargetRef target = nullptr;
    char *failure = nullptr;
    if (c::LLVMGetTargetFromTriple(name, &target, &failure) != 0) {
        c::LLVMDisposeMessage(failure);
        return "";
    }
    c::LLVMTargetMachineRef machine = c::LLVMCreateTargetMachine(target, name, "", "", c::LLVMCodeGenLevelNone,
                                                                 c::LLVMRelocPIC, c::LLVMCodeModelDefault);
    defer c::LLVMDisposeTargetMachine(machine);
    c::LLVMTargetDataRef data = c::LLVMCreateTargetDataLayout(machine);
    char *chars = c::LLVMCopyStringRepOfTargetData(data);
    c::LLVMDisposeTargetData(data);
    Str layout = as_str(format::push((const char *)chars));
    c::LLVMDisposeMessage(chars);
    return layout;
}

// The name of the module in the tree: from the path when a root holds the file, else the `module` line, else the
// file's own name. Returns an error text, empty when it worked.
static Str name_module(ast::Module *m, Str path, roots::Roots folders) {
    Str line_name = "";
    for (Usize i = 0; i < countof(m->name.segments); i++) {
        line_name = as_str(format::push(line_name, i == 0 ? "" : "::", m->name.segments[i].text));
    }
    roots::Named named = roots::name_for(path, folders);
    if (!named.rooted) return "";
    Str problem = roots::disagreement(path, named.name, line_name);
    if (countof(problem) > 0) {
        return problem;
    }
    ast::Identifier parts[:] = {};
    Usize start = 0;
    for (Usize i = 0; i <= countof(named.name); i++) {
        if (i < countof(named.name) && !(named.name[i] == ':' && i + 1 < countof(named.name))) continue;
        parts = mem::realloc(parts, countof(parts) + 1);
        parts[countof(parts) - 1] = (ast::Identifier){.text = named.name[start:i]};
        start = i + 2;
        i += 1;
    }
    m->name.segments = parts;
    return "";
}

// Standard error, written whole.
static void report(Str message) {
    (void)c::write(2, message.data, countof(message));
}

static files::BytesResult load(Str path) {
    return files::read_file(path);
}

// The folders `load_module` looks in: those of the file being compiled (the checker's loader takes no context).
static roots::Roots import_roots;

// The tree of the module at the dotted `path` (`std.math`, NUL-terminated) for the checker (#1714): the file
// `<root>/std/math.smith` under the project's source folder, else under smith's library folder, parsed as `file`
// parses and named by its path. Null when no root holds it, it does not parse, or its `module` line disagrees.
static const ast::Module *load_module(const char *dotted) {
    Str relative = as_str(format::push((const char *)dotted));
    Str inside = "";
    for (Usize i = 0; i < countof(relative); i++) {
        Str piece = relative[i:i + 1];
        if (relative[i] == '.') piece = "/";
        inside = as_str(format::push(inside, piece));
    }
    Str folders[2] = {import_roots.source, import_roots.library};
    for (Usize k = 0; k < 2; k++) {
        Str path = as_str(format::push(folders[k], "/", inside, ".smith"));
        if (!files::exists(path)) continue;
        files::BytesResult loaded = load(path);
        if (loaded == .error) return nullptr;
        format::Chars chars = mem::view(loaded.ok, char);
        Str source = chars;
        parser::Parsed parsed =
            starts_with_module(source) ? parser::parse(path, source) : parser::parse_new(path, source);
        if (countof(parsed.errors) > 0) return nullptr;
        if (countof(name_module(&parsed.module, path, import_roots)) > 0) return nullptr;
        ast::Module *copy = mem::alloc(ast::Module);
        *copy = parsed.module;
        return copy;
    }
    return nullptr;
}

// The folder of the file being compiled and the arena that holds what a header reads (`load_header` takes no context).
static Str header_folder;
static arena::Arena header_arena;
static Bool header_arena_made = false;

// The folder of `path`: everything before its last `/`, or `.`.
static Str folder_of(Str path) {
    for (Usize i = countof(path); i > 0; i--) {
        if (path[i - 1] != '/') continue;
        if (i == 1) return path[0:1];
        return path[0:i - 1];
    }
    return ".";
}

// The declarations of the C header `import <h>;` or `import "h";` names (#1762), read through clang and cached; null
// when clang cannot read it.
static const ast::Module *load_header(Str header, Bool angled) {
    Str name = as_str(format::push(header));
    Str folder = as_str(format::push(header_folder));
    if (!header_arena_made) {
        header_arena = arena::growing(1U << 22, nullptr);
        header_arena_made = true;
    }
    Str empty = "";
    const char *flags = empty.data;
    const char *given = c::getenv("SMITH_FRONT_CIMPORT_FLAGS");
    if (given != nullptr) flags = given;
    cimport::Header got = cimport::read(&header_arena, name.data, !angled, folder.data, flags);
    if (countof(got.error) > 0) return nullptr;
    ast::Module *module = mem::alloc(ast::Module);
    module->decls = got.decls;
    return module;
}

static Report failed(Str message, Times times) {
    return (Report){.ok = false, .text = message, .times = times};
}

// Compiles `path` to the object `output` for `triple`; `roots` are the folders names start from.
export Report file(Str path, Str output, Str triple, roots::Roots folders) {
    Times times = {};
    files::BytesResult loaded = load(path);
    if (loaded == .error) return failed(as_str(format::push(path, ": error: cannot read the file\n")), times);
    format::Chars chars = mem::view(loaded.ok, char);
    Str source = chars;

    U64 mark = clock::monotonic();
    Bool today = starts_with_module(source);
    parser::Parsed parsed = today ? parser::parse(path, source) : parser::parse_new(path, source);
    times.parse = clock::monotonic() - mark;
    // Today's syntax is all warnings (every old form), so its report is what it was: only smith's own files show them.
    Str none = "";
    Str warned = today ? none : lines_of(path, source, parsed.warnings, "warning");
    if (countof(parsed.errors) > 0) {
        return failed(as_str(format::push(warned, lines_of(path, source, parsed.errors, "error"))), times);
    }
    Str problem = name_module(&parsed.module, path, folders);
    if (countof(problem) > 0) return failed(as_str(format::push(warned, problem, "\n")), times);

    Str wanted = triple;
    char *default_triple = nullptr;
    if (countof(wanted) == 0) {
        default_triple = c::LLVMGetDefaultTargetTriple();
        wanted = as_str(format::push((const char *)default_triple));
        c::LLVMDisposeMessage(default_triple);
    }
    mark = clock::monotonic();
    import_roots = folders;
    header_folder = folder_of(path);
    types::Checked checked =
        types_decl::check_module_headers(&parsed.module, target_of(wanted), load_module, load_header);
    times.check = clock::monotonic() - mark;
    if (checked.error_count > 0) {
        Str all = warned;
        for (Usize i = 0; i < checked.error_count; i++) {
            all = as_str(format::push(
                all, diagnostic(path, source, checked.errors[i].span, "error", checked.errors[i].message)));
        }
        return failed(all, times);
    }

    emit::Options options = {};
    options.target = (emit::Target){.triple = wanted, .data_layout = layout_of(wanted)};
    options.source = source;
    options.checked = &checked;
    c::LLVMContextRef context = c::LLVMContextCreate();
    defer c::LLVMContextDispose(context);
    mark = clock::monotonic();
    emit::ModuleResult emitted = emit::module(context, &parsed.module, options);
    times.emit = clock::monotonic() - mark;
    if (emitted == .error)
        return failed(
            as_str(format::push(warned, diagnostic(path, source, emitted.error.span, "error", emitted.error.message))),
            times);
    c::LLVMModuleRef ir = emitted.ok;
    defer c::LLVMDisposeModule(ir);

    emit_object::ObjectOptions object_options = {.target = options.target, .optimization = 0};
    mark = clock::monotonic();
    emit_object::WriteResult written = emit_object::write(ir, object_options, output);
    times.write = clock::monotonic() - mark;
    if (written == .error)
        return failed(as_str(format::push(warned, path, ": error: ", written.error.message, "\n")), times);
    return (Report){.ok = true, .text = warned, .times = times};
}

// The stage that stopped a failed compile: a stage that ran has its time, so the last one with a time is it.
static Str stage_of(Times times) {
    if (times.write > 0) return "write";
    if (times.emit > 0) return "emit";
    if (times.check > 0) return "check";
    return "parse";
}

// The driver's entry: `count` sources and their objects, the default roots, the triple of the compile (null: the
// default). Nothing is compiled when two files would get one module name. Diagnostics go to stderr.
[[std::c_name("front_compile_run")]] export I32 run(const char *const *sources, const char *const *outputs, Usize count,
                                                    const char *triple) {
    roots::Roots folders = roots::default_roots();
    roots::Source paths[:] = {};
    for (Usize i = 0; i < count; i++) {
        paths = mem::realloc(paths, countof(paths) + 1);
        paths[i] = (roots::Source){.path = as_str(format::push((const char *)sources[i]))};
    }
    Str conflict = roots::clash(paths, folders);
    if (countof(conflict) > 0) {
        report(as_str(format::push("error: ", conflict, "\n")));
        return 1;
    }
    Str target = "";
    if (triple != nullptr) {
        target = as_str(format::push((const char *)triple));
    }
    I32 status = 0;
    for (Usize i = 0; i < count; i++) {
        Str output = as_str(format::push((const char *)outputs[i]));
        Report done = file(paths[i].path, output, target, folders);
        if (countof(done.text) > 0) report(done.text);
        if (!done.ok) status = 1;
        // With SMITH_FRONT_STAGE set, a failed file also names the stage that stopped it (frontend-coverage, #1730).
        if (!done.ok && c::getenv("SMITH_FRONT_STAGE") != nullptr) {
            report(as_str(format::push(paths[i].path, ": stage: ", stage_of(done.times), "\n")));
        }
    }
    return status;
}

// ---------------------------------------------------------------------------------------------------------------
// The C header of a module (#1621)

static Bool contains(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        if (roots::same(text[i:i + countof(needle)], needle)) return true;
    }
    return false;
}

// The target's prefix of a label: `_` for Darwin, macOS and iOS, else none (the token lowering's rule).
static Str label_prefix(Str triple) {
    Bool apple = contains(triple, "darwin") || contains(triple, "macos") || contains(triple, "ios");
    return apple ? "_" : "";
}

// The module's path joined by `separator`.
static Str joined(const ast::Module *m, Str separator) {
    Str all = "";
    for (Usize i = 0; i < countof(m->name.segments); i++) {
        if (i > 0) all = as_str(format::push(all, separator));
        all = as_str(format::push(all, m->name.segments[i].text));
    }
    return all;
}

static Bool is_c_name_attribute(ast::Attribute attribute) {
    Usize n = countof(attribute.name.segments);
    if (n == 1) return roots::same(attribute.name.segments[0].text, "c_name");
    return n == 2 && roots::same(attribute.name.segments[0].text, "std") &&
           roots::same(attribute.name.segments[1].text, "c_name");
}

// The function's `@c_name`, or "" when it has none.
static Str header_c_name(const ast::Decl *d) {
    for (Usize i = 0; i < countof(d->attributes); i++) {
        ast::Attribute attribute = d->attributes[i];
        if (!is_c_name_attribute(attribute) || countof(attribute.args) != 1) continue;
        const ast::Expr *argument = attribute.args[0];
        if (argument->kind == .string) return argument->kind.string.bytes;
    }
    return "";
}

// The C spelling of a scalar type's name (the new names and today's capitalized ones: `I32` is `i32`), or "" when the
// name is not one.
static Str scalar_spelling(Str name) {
    if (countof(name) == 0) return "";
    Bool capital = name[0] >= 'A' && name[0] <= 'Z';
    char first = capital ? (char)(name[0] + 32) : name[0];
    Str small = as_str(format::push(first, name[1:]));
    if (roots::same(small, "i8")) return "int8_t";
    if (roots::same(small, "i16")) return "int16_t";
    if (roots::same(small, "i32")) return "int32_t";
    if (roots::same(small, "i64")) return "int64_t";
    if (roots::same(small, "u8")) return "uint8_t";
    if (roots::same(small, "u16")) return "uint16_t";
    if (roots::same(small, "u32")) return "uint32_t";
    if (roots::same(small, "u64")) return "uint64_t";
    if (roots::same(small, "isize")) return "ptrdiff_t";
    if (roots::same(small, "usize")) return "size_t";
    if (roots::same(small, "bool")) return "bool";
    if (roots::same(small, "char")) return "char";
    if (roots::same(small, "f32")) return "float";
    if (roots::same(small, "f64")) return "double";
    return "";
}

static Bool is_struct_name(Str name, ast::Identifier structs[:]) {
    for (Usize i = 0; i < countof(structs); i++) {
        if (roots::same(name, structs[i].text)) return true;
    }
    return false;
}

// What a header spells a type as. `text` is empty when the type has no C spelling; `by_value` is set when it is one of
// the module's structs taken by value (its own message).
struct Spelled {
    Str text;
    Bool by_value;
};

// The base of a chain of pointers: a scalar or one of the module's structs (by value only when no pointer is above it).
static Spelled spell_base(const ast::TypeExpr *t, ast::Identifier structs[:], Str prefix, Bool under_pointer) {
    Spelled none = {.text = "", .by_value = false};
    if (t->kind != .named || countof(t->kind.named.path.segments) != 1) return none;
    Str name = t->kind.named.path.segments[0].text;
    Str scalar = scalar_spelling(name);
    if (countof(scalar) > 0) return (Spelled){.text = scalar, .by_value = false};
    if (!is_struct_name(name, structs)) return none;
    if (!under_pointer) return (Spelled){.text = "", .by_value = true};
    return (Spelled){.text = as_str(format::push(prefix, name)), .by_value = false};
}

constexpr Usize pointer_depth_max = 8;

// The spelling of a type: `*T` is `const T *`, `*mut T` is `T *`, a pointer to a pointer `const T * const *` (a chain
// of at most 8 pointers, written as a loop).
static Spelled spell(const ast::TypeExpr *t, ast::Identifier structs[:], Str prefix) {
    Bool mutable_level[8] = {};
    Usize depth = 0;
    const ast::TypeExpr *at = t;
    while (at->kind == .pointer && depth < pointer_depth_max) {
        mutable_level[depth] = at->kind.pointer.is_mut;
        depth += 1;
        at = at->kind.pointer.pointee;
    }
    Spelled base = spell_base(at, structs, prefix, depth > 0);
    if (countof(base.text) == 0) return base;
    Str text = base.text;
    for (Usize level = depth; level > 0; level--) {
        Bool is_mut = mutable_level[level - 1];
        Bool inner_pointer = level < depth;
        if (is_mut)
            text = as_str(format::push(text, " *"));
        else if (inner_pointer)
            text = as_str(format::push(text, " const *"));
        else
            text = as_str(format::push("const ", text, " *"));
    }
    return (Spelled){.text = text, .by_value = false};
}

// One error of the header at `span`.
static Str header_error(Str path, Str source, ast::Span span, Str message) {
    return diagnostic(path, source, span, "error", message);
}

// The text of the type in a message: the source between its span's ends.
static Str source_of(Str source, ast::Span span) {
    if (span.end > countof(source) || span.start > span.end) return "";
    return source[span.start:span.end];
}

// The line of a `pub fn` in the header, or "" with a message in `*problems`.
static Str function_line(Str path, Str source, const ast::Decl *d, ast::Identifier structs[:], Str prefix, Str module_c,
                         Str module_label, Str label_start, Str *problems) {
    if (d->kind != .function) {
        return "";
    }
    ast::Param params[:] = d->kind.function.params;
    Str name = d->kind.function.name;
    Str args = "";
    for (Usize i = 0; i < countof(params); i++) {
        Spelled spelled = spell(params[i].type, structs, prefix);
        if (countof(spelled.text) == 0) {
            Str message =
                spelled.by_value
                    ? as_str(format::push("`", name, "` takes `", source_of(source, params[i].type->span),
                                          "` by value; C passes a struct by value by the target's ABI, which the "
                                          "emitter does not follow yet: take `*",
                                          source_of(source, params[i].type->span), "`"))
                    : as_str(format::push("`", name, "` takes `", source_of(source, params[i].type->span),
                                          "`, which has no C spelling in a header yet"));
            *problems = as_str(format::push(*problems, header_error(path, source, params[i].span, message)));
            return "";
        }
        Bool star = spelled.text[countof(spelled.text) - 1] == '*';
        args = as_str(format::push(args, i == 0 ? "" : ", ", spelled.text, star ? "" : " ", params[i].name));
    }
    Str result = "void";
    if (d->kind.function.result != nullptr) {
        Spelled spelled = spell(d->kind.function.result, structs, prefix);
        if (countof(spelled.text) == 0) {
            Str shown = source_of(source, d->kind.function.result->span);
            Str message = spelled.by_value
                              ? as_str(format::push("`", name, "` returns `", shown,
                                                    "` by value; C returns a struct by value by the target's ABI, "
                                                    "which the emitter does not follow yet: return it through a `*mut ",
                                                    shown, "` parameter"))
                              : as_str(format::push("`", name, "` returns `", shown,
                                                    "`, which has no C spelling in a header yet"));
            *problems =
                as_str(format::push(*problems, header_error(path, source, d->kind.function.result->span, message)));
            return "";
        }
        result = spelled.text;
    }
    Str own = header_c_name(d);
    Bool star = result[countof(result) - 1] == '*';
    Str c_name = as_str(format::push(module_c, "_", name));
    if (countof(own) > 0) c_name = own;
    if (countof(params) == 0) args = "void";
    Str separator = " ";
    if (star) separator = "";
    Str head = as_str(format::push(result, separator, c_name, "(", args, ")"));
    if (countof(own) > 0) return as_str(format::push(head, ";\n"));
    return as_str(format::push(head, " __asm__(\"", label_start, module_label, "::", name, "\");\n"));
}

// The header's text for the parsed module, or "" with the errors in `*problems`.
static Str header_text(Str path, Str source, const ast::Module *m, Str triple, Str *problems) {
    Str module_c = joined(m, "_");
    Str module_label = joined(m, "::");
    Str prefix = as_str(format::push(module_c, "_"));
    ast::Identifier structs[:] = {};
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind != .record || !d->is_pub) continue;
        structs = mem::realloc(structs, countof(structs) + 1);
        structs[countof(structs) - 1] = (ast::Identifier){.text = d->kind.record.name};
    }
    Str types = "";
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind != .record || !d->is_pub) continue;
        Str fields = "";
        for (Usize k = 0; k < countof(d->kind.record.fields); k++) {
            ast::FieldDecl field = d->kind.record.fields[k];
            Spelled spelled = spell(field.type, structs, prefix);
            if (countof(spelled.text) == 0) {
                Str message = as_str(format::push("field `", field.name, "` of `", d->kind.record.name, "` is `",
                                                  source_of(source, field.type->span),
                                                  "`, which has no C spelling in a header yet"));
                *problems = as_str(format::push(*problems, header_error(path, source, field.span, message)));
                continue;
            }
            Bool star = spelled.text[countof(spelled.text) - 1] == '*';
            fields = as_str(format::push(fields, spelled.text, star ? "" : " ", field.name, "; "));
        }
        types = as_str(format::push(types, "typedef struct { ", fields, "} ", prefix, d->kind.record.name, ";\n"));
    }
    Str body = "";
    Str label_start = label_prefix(triple);
    Usize count = 0;
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind != .function || !d->is_pub || d->kind.function.body == nullptr) continue;
        if (roots::same(d->kind.function.name, "main")) continue;
        Str line = function_line(path, source, d, structs, prefix, module_c, module_label, label_start, problems);
        if (countof(line) == 0) continue;
        body = as_str(format::push(body, count == 0 ? "" : "\n", line));
        count += 1;
    }
    if (countof(*problems) > 0) return "";
    Str gap = "";
    if (countof(types) > 0 && countof(body) > 0) gap = "\n";
    return as_str(format::push("// clang-format off\n// Generated by smith from ", path,
                               ". Do not edit.\n// clang-format on\n",
                               "#pragma once\n#include <stddef.h>\n#include <stdint.h>\n#ifdef __cplusplus\n",
                               "extern \"C\" {\n#endif\n", types, gap, body, "#ifdef __cplusplus\n}\n#endif\n"));
}

// Writes `text` to `output` unless the file already holds those bytes. Returns an error text, empty when it worked.
static Str write_if_changed(Str output, Str text) {
    files::BytesResult old = files::read_file(output);
    if (old != .error) {
        format::Chars held = mem::view(old.ok, char);
        Str current = held;
        if (roots::same(current, text)) return "";
    }
    c::FILE *out = c::fopen(output.data, "w");
    if (out == nullptr) return as_str(format::push(output, ": error: cannot write the file\n"));
    Usize written = c::fwrite(text.data, 1, countof(text), out);
    Bool closed = c::fclose(out) == 0;
    if (written != countof(text) || !closed) return as_str(format::push(output, ": error: cannot write the file\n"));
    return "";
}

// Writes the C header of the module in `path` (smith's own syntax) to `output` for `triple` (empty: the default). The
// checker does not run: a header comes from the declarations alone. The file is written only when its bytes change.
export Report header(Str path, Str output, Str triple, roots::Roots folders) {
    Times times = {};
    files::BytesResult loaded = load(path);
    if (loaded == .error) return failed(as_str(format::push(path, ": error: cannot read the file\n")), times);
    format::Chars chars = mem::view(loaded.ok, char);
    Str source = chars;
    if (starts_with_module(source))
        return failed(as_str(format::push(path, ": error: this file is in today's syntax; write its header without "
                                                "--front-end=new\n")),
                      times);
    U64 mark = clock::monotonic();
    parser::Parsed parsed = parser::parse_new(path, source);
    times.parse = clock::monotonic() - mark;
    if (countof(parsed.errors) > 0)
        return failed(as_str(format::push(lines_of(path, source, parsed.errors, "error"))), times);
    Str problem = name_module(&parsed.module, path, folders);
    if (countof(problem) > 0) return failed(as_str(format::push(problem, "\n")), times);
    Str wanted = triple;
    if (countof(wanted) == 0) {
        char *default_triple = c::LLVMGetDefaultTargetTriple();
        wanted = as_str(format::push((const char *)default_triple));
        c::LLVMDisposeMessage(default_triple);
    }
    Str problems = "";
    Str text = header_text(path, source, &parsed.module, wanted, &problems);
    if (countof(problems) > 0) return failed(problems, times);
    mark = clock::monotonic();
    Str written = write_if_changed(output, text);
    times.write = clock::monotonic() - mark;
    if (countof(written) > 0) return failed(written, times);
    return (Report){.ok = true, .text = "", .times = times};
}

// The driver's entry for `--smith-header`: one source, its header, the triple (null: the default). Diagnostics go to
// stderr.
[[std::c_name("front_header_run")]] export I32 run_header(const char *source, const char *output, const char *triple) {
    roots::Roots folders = roots::default_roots();
    Str target = "";
    if (triple != nullptr) target = as_str(format::push((const char *)triple));
    Report done =
        header(as_str(format::push((const char *)source)), as_str(format::push((const char *)output)), target, folders);
    if (countof(done.text) > 0) report(done.text);
    return done.ok ? 0 : 1;
}
