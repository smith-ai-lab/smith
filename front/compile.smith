// front::compile: `smith cc --front-end=new` (#1221, J2 of #1112). The new front end, joined for the first time: a
// `.smith` file is read, parsed (front::parser), type checked (front::types_decl), emitted (front::emit) and written to
// an object file (front::emit_object). Experimental: the flag is off by default and without it a `.smith` file still
// goes through the token lowering.
//
//   file(path, output, triple, roots)   one file to the object `output` for `triple` (empty: the driver's default
//                                       target); a `Report`: whether it worked, the diagnostics, the time of each stage
//   header(path, output, triple, roots) the C header of one file in smith's own syntax (#1621): `pub struct`s and
//                                       `pub fn`s with a C spelling, from the declarations alone (no checker), written
//                                       only when its bytes change; `run_header` is its C entry (`--smith-header`)
//   diagnose(path, source, roots)       the parser's and the checker's findings on a text, as `Problems` (spans and
//                                       messages), for the language server (#1887)
//   run(sources, outputs, count, triple)
//                                       what the driver calls (C: `front_compile_run`): every file of the command line
//                                       with the default roots, diagnostics on stderr, 0 when every object was written
//
// A diagnostic is `file:line:column: error: message`, one per error, and a stage that fails stops the next ones. The
// parser's warnings (of a file in smith's own syntax; a file in today's has one per old form, so its report stays as it
// was) are `file:line:column: warning: message`, one per line before any error; they do not stop the
// compile and, when only warnings were found, are the `Report.text` of a report that is ok (`run` writes them to
// stderr). Which parser reads a file (#1578): one whose first token (comments are not tokens) is the keyword `module`
// is in today's syntax and goes through `parser::parse_file`; any other file is smith's own (no `module` line: a module
// is named by its path) and goes through `parser::parse_new`. A cast that can lose a value is checked on this path too
// (`Options.checked`). The
// module's name is its path from a root (front::roots); a `module` line that disagrees is an error naming both. The
// target comes from the caller: the triple is the driver's, the data layout is the machine's for it, and the checker's
// pointer width follows the triple. Nothing reads the host here but the default triple when none is given.
module front::compile;

import front::ast;
import front::cimport;
import front::emit;
import front::emit_object;
import front::emit_state as state;
import front::header_table;
import front::lint;
import front::module_cache;
import front::parser;
import front::roots;
import front::types;
import front::types_decl;
import front::when;
import front::parse;
import std::arena;
import std::ascii;
import std::clock;
import std::contract;
import std::files;
import std::format;
import std::mem;
import <llvm-c/BitWriter.h>;
import <llvm-c/Core.h>;
import <llvm-c/Target.h>;
import <llvm-c/TargetMachine.h>;
import <stdio.h>;
import <stdlib.h>;
import <string.h>;
import <unistd.h>;

static Str as_str(char chars[:]) {
    return chars;
}

// Nanoseconds of each stage.
export struct Times {
    U64 parse;
    U64 imports; // the part of `check` spent reading imported modules and C headers (--time, #2681)
    U64 headers; // the part of `imports` spent on C headers (#2888)
    U64 check;
    U64 emit;
    U64 write;
};

export struct Report {
    Bool ok;
    Str text; // the diagnostics, one line each; only the warnings (maybe none) when it worked
    Times times;
};

// The 1-based line and column (in bytes) of the byte `offset` of `source`, as `line:column`.
static Str position(Str source, U32 offset) {
    U64 line = 1;
    U64 column = 1;
    for (Usize i = 0; i < countof(source) && i < offset; i++) {
        if (source[i] == '\n') {
            line += 1;
            column = 1;
        } else {
            column += 1;
        }
    }
    return as_str(format::push(line, ":", column));
}

// One line of the report: `file:line:column: severity: message`, with `severity` `error` or `warning`.
static Str diagnostic(Str file, Str source, ast::Span span, Str severity, Str message) {
    return as_str(format::push(file, ":", position(source, span.start), ": ", severity, ": ", message, "\n"));
}

// The 1-based line of the byte `offset` of `source`.
static U64 line_of(Str source, U32 offset) {
    U64 line = 1;
    for (Usize i = 0; i < countof(source) && i < offset; i++) {
        if (source[i] == '\n') line += 1;
    }
    return line;
}

// `message` with its `$line` made the line of `related` (a check's message that names another place, #1986).
static Str with_line(Str source, Str message, ast::Span related) {
    for (Usize i = 0; i + 5 <= countof(message); i++) {
        if (message[i] == '$' && message[i + 1] == 'l' && message[i + 2] == 'i' && message[i + 3] == 'n' &&
            message[i + 4] == 'e') {
            return as_str(format::push(message[0:i], line_of(source, related.start), message[i + 5:countof(message)]));
        }
    }
    return message;
}

// The modules `read_module` read for the current check, by prefix (`std::test::`), with their path and text: an error
// the checker found in one of them is reported at its own file and line (#2669).
constexpr Usize read_max = 256;
static Str read_prefixes[read_max];
static Str read_paths[read_max];
static Str read_sources[read_max];
static const ast::Module *read_trees[read_max];
static Usize read_count = 0;

static void remember_module(Str dotted, Str path, Str source, const ast::Module *tree) {
    if (read_count == read_max) return;
    Str prefix = "";
    for (Usize i = 0; i < countof(dotted); i++) {
        Str piece = dotted[i:i + 1];
        if (dotted[i] == '.') piece = "::";
        prefix = as_str(format::push(prefix, piece));
    }
    read_prefixes[read_count] = as_str(format::push(prefix, "::"));
    read_paths[read_count] = path;
    read_sources[read_count] = source;
    read_trees[read_count] = tree;
    read_count += 1;
}

// The index of the module read under `prefix`, or `read_count` when none was.
static Usize read_index(Str prefix) {
    for (Usize i = 0; i < read_count; i++) {
        if (roots::same(read_prefixes[i], prefix)) return i;
    }
    return read_count;
}

// The report of one error of the checker: its line, then its note when it has one.
static Str error_lines(Str file, Str source, const types::Error *e) {
    Usize at = read_index(e->module);
    if (countof(e->module) > 0 && at < read_count) { // found in an import's text: reported there
        file = read_paths[at];
        source = read_sources[at];
    }
    Str message = e->has_related ? with_line(source, e->message, e->related) : e->message;
    Str text = diagnostic(file, source, e->span, "error", message);
    if (e->has_related) {
        text = as_str(format::push(text, diagnostic(file, source, e->related, "note", e->related_message)));
    }
    return text;
}

// The lines of `list`, in order, as `severity`.
static Str lines_of(Str file, Str source, parse::Errors list, Str severity) {
    Str all = "";
    for (Usize i = 0; i < countof(list); i++) {
        all = as_str(format::push(all, diagnostic(file, source, list[i].span, severity, list[i].message)));
    }
    return all;
}

// The line of a diagnostic of `severity` at byte `offset` of `source`, for the tests: the parse files record no
// warning yet that a case could show (F1 to F4, #1506 to #1509).
export Str diagnostic_for_test(Str file, Str source, U32 offset, Str severity, Str message) {
    return diagnostic(file, source, (ast::Span){.start = offset, .end = offset}, severity, message);
}

static Bool word_at(Str source, Usize at, Str word) {
    if (at + countof(word) > countof(source)) return false;
    for (Usize i = 0; i < countof(word); i++) {
        if (source[at + i] != word[i]) return false;
    }
    if (at + countof(word) == countof(source)) return true;
    char next = source[at + countof(word)];
    return !(ascii::alpha(next) || ascii::digit(next) || next == '_');
}

// Whether the first token of `source` is the keyword `module`: today's syntax (every file in it has the line).
export Bool starts_with_module(Str source) {
    Usize i = 0;
    while (i < countof(source)) {
        if (ascii::space(source[i])) {
            i += 1;
        } else if (i + 1 < countof(source) && source[i] == '/' && source[i + 1] == '/') {
            while (i < countof(source) && source[i] != '\n')
                i += 1;
        } else if (i + 1 < countof(source) && source[i] == '/' && source[i + 1] == '*') {
            i += 2;
            while (i + 1 < countof(source) && !(source[i] == '*' && source[i + 1] == '/'))
                i += 1;
            i += 2;
        } else {
            break;
        }
    }
    return word_at(source, i, "module");
}

// 64-bit unless the triple's architecture says otherwise (`x86_64`, `aarch64`, `arm64`, `wasm64`).
static types::Target target_of(Str triple) {
    Usize end = 0;
    while (end < countof(triple) && triple[end] != '-')
        end += 1;
    for (Usize i = 0; i + 1 < end; i++) {
        if (triple[i] == '6' && triple[i + 1] == '4') return types::lp64();
    }
    return (types::Target){.pointer_bytes = 4, .max_align = 8};
}

// The data layout the machine of `triple` has, as text; empty when the triple has no target. The text is the current
// allocator's.
static Str layout_of(Str triple) {
    c::LLVMInitializeAllTargetInfos();
    c::LLVMInitializeAllTargets();
    c::LLVMInitializeAllTargetMCs();
    c::LLVMInitializeAllAsmPrinters();
    c::LLVMInitializeAllAsmParsers();
    char *name = state::cstr(triple);
    defer mem::free(name);
    c::LLVMTargetRef target = nullptr;
    char *failure = nullptr;
    if (c::LLVMGetTargetFromTriple(name, &target, &failure) != 0) {
        c::LLVMDisposeMessage(failure);
        return "";
    }
    c::LLVMTargetMachineRef machine = c::LLVMCreateTargetMachine(target, name, "", "", c::LLVMCodeGenLevelNone,
                                                                 c::LLVMRelocPIC, c::LLVMCodeModelDefault);
    defer c::LLVMDisposeTargetMachine(machine);
    c::LLVMTargetDataRef data = c::LLVMCreateTargetDataLayout(machine);
    char *chars = c::LLVMCopyStringRepOfTargetData(data);
    c::LLVMDisposeTargetData(data);
    Str layout = as_str(format::push((const char *)chars));
    c::LLVMDisposeMessage(chars);
    return layout;
}

// The name of the module in the tree: from the path when a root holds the file, else the `module` line, else the
// file's own name. Returns an error text, empty when it worked.
static Str name_module(ast::Module *m, Str path, roots::Roots folders) {
    Str line_name = "";
    for (Usize i = 0; i < countof(m->name.segments); i++) {
        line_name = as_str(format::push(line_name, i == 0 ? "" : "::", m->name.segments[i].text));
    }
    roots::Roots held = folders;
    if (countof(line_name) > 0) held.local = ""; // a `module` line keeps the old meaning: only src and lib name a file
    roots::Named named = roots::name_for(path, held);
    if (!named.rooted) return "";
    Str problem = roots::disagreement(path, named.name, line_name);
    if (countof(problem) > 0) {
        return problem;
    }
    ast::Identifier parts[:] = {};
    Usize start = 0;
    for (Usize i = 0; i <= countof(named.name); i++) {
        if (i < countof(named.name) && !(named.name[i] == ':' && i + 1 < countof(named.name))) continue;
        parts = mem::realloc(parts, countof(parts) + 1);
        parts[countof(parts) - 1] = (ast::Identifier){.text = named.name[start:i]};
        start = i + 2;
        i += 1;
    }
    m->name.segments = parts;
    return "";
}

// Standard error, written whole.
static void report(Str message) {
    (void)c::write(2, message.data, countof(message));
}

static files::BytesResult load(Str path) {
    return files::read_file(path);
}

// The `.smith` modules this process has parsed (#2888), so the files of one compile parse std once. An entry is the
// file's path, its text (compared whole on every use, so an edited file is parsed again), and the folders that named
// it; its tree is the parse of exactly that text.
constexpr Usize shared_modules_max = 512;
static Str shared_module_paths[shared_modules_max];
static Str shared_module_names[shared_modules_max];
static Str shared_module_sources[shared_modules_max];
static const ast::Module *shared_module_trees[shared_modules_max];
static Usize shared_module_count = 0;

// What the table keeps is allocated by the system's allocator and never freed, whatever allocator is in force: a caller
// such as `smith lsp` resets its own after each request, and the next file must still find the entry whole.
static mem::Allocator *enter_shared() {
    return mem::set_allocator(nullptr);
}

// The system's allocator with the handler of the thread out of the way (a set allocator swaps malloc's family).
static void *system_raw(void *block, Usize size) {
    contract::trusted(); // the system's allocator is the edge
    mem::Allocator *before = mem::set_allocator(nullptr);
    void *result = c::realloc(block, size); // NOLINT(smith-effects): the edge, as mem's own
    mem::set_allocator(before);
    return result;
}

// What one file of `run` parses and checks (#2888, #3112): blocks bumped from chunks, so that the file's memory is
// freed by dropping the chunks. A chunk is 1 MB, and each new one doubles up to 64 MB; a block larger than a chunk gets
// a chunk of its own. A block is a header of `file_header` bytes that holds its size, then the block. `realloc` of the
// last block of the chunk in force grows it in place (the parser grows its lists one element at a time, and the list
// it is growing is the last block); any other grows by copy, and the old block stays until the chunks go. `free` of the
// last block takes it back; any other is not freed one by one.
constexpr Usize file_header = 16;
constexpr Usize file_chunk_header = 32;
constexpr Usize file_chunk_first = 1U << 20;
constexpr Usize file_chunk_last = 64U << 20;

struct FileChunk {
    FileChunk *next;
    Usize size; // bytes of the chunk, its header included
    Usize used; // bytes handed out, its header included
    Usize pad;
};

static FileChunk *file_chunks = nullptr; // the chunk being bumped first, then the others
static Usize file_chunk_size = file_chunk_first;
static U8 *file_last = nullptr; // the last block handed out from the chunk in force, null when it was freed

static Usize file_round(Usize size) {
    return (size + 15) & ~(Usize)15;
}

static FileChunk *file_chunk_new(Usize size) {
    FileChunk *chunk = (FileChunk *)system_raw(nullptr, size);
    if (chunk == nullptr) return nullptr;
    chunk->next = nullptr;
    chunk->size = size;
    chunk->used = file_chunk_header;
    chunk->pad = 0;
    return chunk;
}

static void *file_alloc(mem::Allocator *self, Usize size, Usize align) {
    (void)self;
    if (align > file_header) return nullptr; // nothing in the front end asks for more than 16
    if (size > ((Usize)-1) / 2) return nullptr;
    Usize need = file_header + file_round(size);
    if (file_chunks != nullptr && file_chunks->size - file_chunks->used >= need) {
        U8 *raw = (U8 *)file_chunks + file_chunks->used;
        file_chunks->used += need;
        *(Usize *)raw = size;
        file_last = raw + file_header;
        return file_last;
    }
    if (need + file_chunk_header > file_chunk_size) { // larger than a chunk: its own, behind the one in force
        FileChunk *own = file_chunk_new(need + file_chunk_header);
        if (own == nullptr) return nullptr;
        own->used = own->size;
        if (file_chunks == nullptr) {
            file_chunks = own;
            file_last = nullptr;
        } else {
            own->next = file_chunks->next;
            file_chunks->next = own;
        }
        U8 *raw = (U8 *)own + file_chunk_header;
        *(Usize *)raw = size;
        return raw + file_header;
    }
    FileChunk *chunk = file_chunk_new(file_chunk_size);
    if (chunk == nullptr) return nullptr;
    if (file_chunk_size < file_chunk_last) file_chunk_size *= 2;
    chunk->next = file_chunks;
    file_chunks = chunk;
    U8 *raw = (U8 *)chunk + chunk->used;
    chunk->used += need;
    *(Usize *)raw = size;
    file_last = raw + file_header;
    return file_last;
}

static Bool file_owns(mem::Allocator *self, const void *block) {
    (void)self;
    for (const FileChunk *chunk = file_chunks; chunk != nullptr; chunk = chunk->next) {
        const U8 *start = (const U8 *)chunk;
        if ((const U8 *)block >= start + file_chunk_header + file_header && (const U8 *)block < start + chunk->size)
            return true;
    }
    return false;
}

static Usize file_size(mem::Allocator *self, const void *block) {
    (void)self;
    return *(const Usize *)((const U8 *)block - file_header);
}

static void file_free(mem::Allocator *self, void *block) {
    (void)self;
    if (block == nullptr || (U8 *)block != file_last) return;
    file_chunks->used = (Usize)((U8 *)block - file_header - (U8 *)file_chunks);
    file_last = nullptr;
}

static void *file_realloc(mem::Allocator *self, void *block, Usize size, Usize align) {
    contract::trusted(); // the allocator is the edge: it copies a block of the size its header holds
    if (block == nullptr) return file_alloc(self, size, align);
    if (align > file_header || !file_owns(self, block)) return nullptr;
    if ((U8 *)block == file_last && size <= ((Usize)-1) / 2) { // the last block grows where it is
        Usize start = (Usize)((U8 *)block - file_header - (U8 *)file_chunks);
        Usize need = file_header + file_round(size);
        if (start + need <= file_chunks->size) {
            file_chunks->used = start + need;
            *(Usize *)((U8 *)block - file_header) = size;
            return block;
        }
    }
    Usize old = file_size(self, block);
    void *moved = file_alloc(self, size, align);
    if (moved == nullptr) return nullptr;
    __builtin_memcpy(moved, block, old < size ? old : size);
    return moved;
}

static mem::Allocator file_allocator = {
    .alloc = file_alloc, .realloc = file_realloc, .free = file_free, .owns = file_owns, .size = file_size};

static mem::Allocator *file_memory() {
    return &file_allocator;
}

// Drops every chunk the file's allocator holds. `run` calls it before a file, for the file before it: the last file of
// a process is never released, which took 19% of a whole-tree pass (10.7 of 57 s, #3080).
static void file_memory_release() {
    contract::trusted();                                  // the system's allocator is the edge
    mem::Allocator *before = mem::set_allocator(nullptr); // once, not around each chunk
    FileChunk *chunk = file_chunks;
    while (chunk != nullptr) {
        FileChunk *next = chunk->next;
        c::free(chunk); // NOLINT(smith-effects): the edge
        chunk = next;
    }
    mem::set_allocator(before);
    file_chunks = nullptr;
    file_last = nullptr;
    file_chunk_size = file_chunk_first;
}

static Str roots_key(roots::Roots named_by) {
    return as_str(format::push(named_by.source, "\n", named_by.library, "\n", named_by.local));
}

static const ast::Module *shared_module(Str path, Str named, Str source) {
    for (Usize i = 0; i < shared_module_count; i++) {
        if (roots::same(shared_module_paths[i], path) && roots::same(shared_module_names[i], named) &&
            roots::same(shared_module_sources[i], source))
            return shared_module_trees[i];
    }
    return nullptr;
}

static void share_module(Str path, Str named, Str source, const ast::Module *tree) {
    if (shared_module_count == shared_modules_max) return;
    shared_module_paths[shared_module_count] = path;
    shared_module_names[shared_module_count] = named;
    shared_module_sources[shared_module_count] = source;
    shared_module_trees[shared_module_count] = tree;
    shared_module_count += 1;
}

// The embedded sources of smith's `.smith` libraries (shim/cimport_std.cpp, filled by smith.c from `smith_libraries`):
// the source of `std.<name>` and its size, or null when this program has no such module (#2041).
extern const char *smith_std_source(const char *name, Usize *size);

// A module read for the table: its tree (null when it did not parse or names itself wrongly) and the texts the table
// keeps, all in memory that lives as long as the process. When it did not parse, the first error.
struct Kept {
    const ast::Module *tree;
    Str path;
    Str named;
    Str source;
    Bool parse_failed;
    U32 error_at;
    Str error;
};

// Parses `source` as `path` in the allocator in force, the texts copied into it first, and names the tree: as
// `std::<std_name>` when that is not empty (the embedded std), else by its path from `named_by`.
static Kept parse_kept(Str path, Str named, Str source, roots::Roots named_by, Str std_name) {
    Kept kept = {.path = as_str(format::push(path)),
                 .named = as_str(format::push(named)),
                 .source = as_str(format::push(source)),
                 .parse_failed = false};
    parser::Parsed parsed = starts_with_module(kept.source) ? parser::parse_file(kept.path, kept.source)
                                                            : parser::parse_new(kept.path, kept.source);
    if (countof(parsed.errors) != 0) {
        kept.parse_failed = true;
        kept.error_at = parsed.errors[0].span.start;
        kept.error = parsed.errors[0].message;
        return kept;
    }
    if (countof(std_name) != 0) {
        ast::Identifier parts[:] = {};
        parts = mem::realloc(parts, 2);
        parts[0] = (ast::Identifier){.text = as_str(format::push("std"))};
        parts[1] = (ast::Identifier){.text = as_str(format::push(std_name))};
        parsed.module.name.segments = parts;
    } else if (countof(name_module(&parsed.module, kept.path, named_by)) != 0) {
        return kept;
    }
    ast::Module *copy = mem::alloc(ast::Module);
    *copy = parsed.module;
    kept.tree = copy;
    return kept;
}

// The texts of a read, copied for the process's life.
static Kept kept_texts(Str path, Str named, Str source) {
    mem::Allocator *outside = enter_shared();
    Kept kept = {.path = as_str(format::push(path)),
                 .named = as_str(format::push(named)),
                 .source = as_str(format::push(source)),
                 .parse_failed = false};
    mem::set_allocator(outside);
    return kept;
}

// A module read for the table (#2891): from the disk cache when it holds the tree, else parsed, and then stored. With
// the cache on, a parse runs in a region of its own and again in a second one, which is what the store compares
// (front/module_cache.smith); the first region holds the tree for the process's life. `kind` says what was read: a
// file, or std embedded in smith.
static Kept read_kept(Str kind, Str path, Str named, Str source, roots::Roots named_by, Str std_name) {
    if (!module_cache::enabled()) {
        mem::Allocator *outside = enter_shared();
        Kept kept = parse_kept(path, named, source, named_by, std_name);
        mem::set_allocator(outside);
        return kept;
    }
    Str key = module_cache::key(kind, path, named, source);
    const ast::Module *hit = module_cache::load(key);
    if (hit != nullptr) {
        Kept kept = kept_texts(path, named, source);
        kept.tree = hit;
        return kept;
    }
    if (!module_cache::begin(countof(source))) {
        mem::Allocator *outside = enter_shared();
        Kept kept = parse_kept(path, named, source, named_by, std_name);
        mem::set_allocator(outside);
        return kept;
    }
    Kept first = parse_kept(path, named, source, named_by, std_name);
    module_cache::end();
    if (first.tree == nullptr) {
        // Not stored: the error's text is copied out of the region before it goes.
        Kept failed = kept_texts(path, named, source);
        failed.parse_failed = first.parse_failed;
        failed.error_at = first.error_at;
        mem::Allocator *outside = enter_shared();
        failed.error = as_str(format::push(first.error));
        mem::set_allocator(outside);
        module_cache::forget();
        return failed;
    }
    if (module_cache::begin(countof(source))) {
        (void)parse_kept(path, named, source, named_by, std_name);
        module_cache::end();
    }
    module_cache::store(key, first.tree);
    return first;
}

// The tree of `std.<name>` (`dotted` is `std.name`) read from the source inside the program, named `std::name`, or
// null when `dotted` is not a one-level `std` module this program embeds, or the source does not parse. A file on disk
// under a root wins over this (smith's developers compile against the library they edit).
static const ast::Module *load_embedded(Str dotted) {
    if (countof(dotted) <= 4 || !roots::same(dotted[0:4], "std.")) return nullptr;
    Str name = dotted[4:countof(dotted)];
    for (Usize i = 0; i < countof(name); i++) {
        if (name[i] == '.') return nullptr;
    }
    Str terminated = as_str(format::push(name));
    Usize size = 0;
    const char *found = smith_std_source(terminated.data, &size);
    if (found == nullptr) return nullptr;
    Str path = as_str(format::push("lib/std/", name, ".smith"));
    Str source = found[0:size];
    const ast::Module *shared = shared_module(path, "embedded", source);
    if (shared != nullptr) return shared;
    roots::Roots none = {};
    Kept kept = read_kept("embedded", path, "embedded", source, none, name);
    if (kept.tree == nullptr) {
        types::set_load_failure(as_str(format::push(path, ":", position(source, kept.error_at), ": ", kept.error)));
        return nullptr;
    }
    share_module(kept.path, "embedded", kept.source, kept.tree);
    return kept.tree;
}

// The folder of `path`: everything before its last `/`, or `.`.
static Str folder_of(Str path) {
    for (Usize i = countof(path); i > 0; i--) {
        if (path[i - 1] != '/') continue;
        if (i == 1) return path[0:1];
        return path[0:i - 1];
    }
    return ".";
}

constexpr Usize ancestors_max = 6;

// The folders `load_module` looks in: those of the file being compiled (the checker's loader takes no context).
static roots::Roots import_roots;

// The tree of the module at the dotted `path` (`std.math`, NUL-terminated) for the checker (#1714): the file
// `<root>/std/math.smith` under the project's source folder, else under smith's library folder, parsed as `file`
// parses and named by its path. Null when no root holds it, it does not parse, or its `module` line disagrees.
static const ast::Module *read_module(const char *dotted) {
    Str relative = as_str(format::push((const char *)dotted));
    Str inside = "";
    for (Usize i = 0; i < countof(relative); i++) {
        Str piece = relative[i:i + 1];
        if (relative[i] == '.') piece = "/";
        inside = as_str(format::push(inside, piece));
    }
    // After the three roots, the folders above the compiled file's: a file that says `module t::uses;` sits below the
    // root that names `t::point` (#2041).
    // One entry per root and per ancestor, all written out: an array literal needs its whole length.
    Str folders[9] = {import_roots.source, import_roots.library, import_roots.local, "", "", "", "", "", ""};
    static_assert(3 + ancestors_max == 9);
    Str above = import_roots.local;
    for (Usize level = 3; level < 3 + ancestors_max && countof(above) > 0 && !roots::same(above, "."); level++) {
        above = folder_of(above);
        folders[level] = above;
    }
    for (Usize k = 0; k < 3 + ancestors_max; k++) {
        if (countof(folders[k]) == 0) continue;
        Str path = as_str(format::push(folders[k], "/", inside, ".smith"));
        if (!files::exists(path)) continue;
        files::BytesResult loaded = load(path);
        if (loaded != .ok) return nullptr;
        format::Chars chars = mem::view(loaded.ok, char);
        Str source = chars;
        // A file found beside the compiled one is named from that folder alone: `src` may also hold it (the coverage
        // tree links `src` to the repo), and a `module runner;` line then disagrees with `tests::runner` (#2041).
        roots::Roots named_by = import_roots;
        if (k >= 2) named_by = (roots::Roots){.local = folders[k]};
        Str named = roots_key(named_by);
        const ast::Module *shared = shared_module(path, named, source);
        if (shared != nullptr) {
            remember_module(relative, path, source, shared);
            return shared;
        }
        Kept kept = read_kept("file", path, named, source, named_by, "");
        if (kept.parse_failed) {
            types::set_load_failure(as_str(format::push(path, ":", position(source, kept.error_at), ": ", kept.error)));
            return nullptr;
        }
        if (kept.tree == nullptr) return nullptr;
        remember_module(relative, path, source, kept.tree);
        share_module(kept.path, kept.named, kept.source, kept.tree);
        return kept.tree;
    }
    return load_embedded(relative);
}

// The folder of the file being compiled (`load_header` takes no context).
static Str header_folder;

// A header's file can change while the process lives (`front::header_table`): one command line reads its headers as it
// starts and does not check; any other entry (each file of `file`, `diagnose`, `hover_at` ...: `enter_file`) starts a
// new generation of the table.
static Bool within_command = false; // `run`: every file of one command line is one generation

static void enter_file(Str path) {
    header_folder = folder_of(path);
    if (!within_command) header_table::next_generation();
}

static Str header_flags() {
    Str empty = "";
    const char *given = c::getenv("SMITH_FRONT_CIMPORT_FLAGS");
    if (given == nullptr) return empty;
    return as_str(format::push(given));
}

// The declarations of the C header `import <h>;` or `import "h";` names (#1762), read through clang once per process
// (#2888); null when clang cannot read it.
static const ast::Module *read_header(Str header, Bool angled) {
    return header_table::read(header, angled, header_folder, header_flags());
}

// `--time` (#2681): what reading the imports cost, summed over a file's check, so `check` can be told from `import`.
static U64 import_nanoseconds = 0;
static U64 header_nanoseconds = 0;

static const ast::Module *load_module(const char *dotted) {
    U64 mark = clock::monotonic();
    const ast::Module *found = read_module(dotted);
    import_nanoseconds += clock::monotonic() - mark;
    return found;
}

static const ast::Module *load_header(Str header, Bool angled) {
    U64 mark = clock::monotonic();
    const ast::Module *found = read_header(header, angled);
    U64 spent = clock::monotonic() - mark;
    import_nanoseconds += spent;
    header_nanoseconds += spent;
    return found;
}

// The text of the C header `import c <h>` names, for smith's own lint check of library headers (#1976): a quoted
// header is looked for in the folder of the file being compiled; any header under the project's `include` and
// `.smith/include` (the libraries' generated headers) and smith's (`<library>/../include`). Empty when none is found.
static Str read_header_in(Str folder, Str header) {
    Str path = as_str(format::push(folder, "/", header));
    files::BytesResult loaded = files::read_file(path);
    if (loaded != .ok) return "";
    format::Chars chars = mem::view(loaded.ok, char);
    Str text = chars;
    return text;
}

static Str read_header_text(Str header, Bool angled) {
    Str found = "";
    if (!angled) found = read_header_in(header_folder, header);
    if (countof(found) == 0) found = read_header_in("include", header);
    if (countof(found) == 0) found = read_header_in(".smith/include", header);
    if (countof(found) == 0) found = read_header_in(as_str(format::push(import_roots.library, "/../include")), header);
    return found;
}

// Gives smith's lint checks the text of the file and where to read headers from (`# NOLINT`, smith-module-library).
static void lint_inputs(Str source) {
    lint::set_source(source);
    lint::set_header_text(read_header_text);
}

// Takes them back, so the next check (or a caller's own) starts with none.
static void lint_inputs_done() {
    lint::set_source("");
    lint::set_header_text(nullptr);
}

static Report failed(Str message, Times times) {
    return (Report){.ok = false, .text = message, .times = times};
}

export struct Link {
    Str label; // `in check_part[str], instantiated at`, `in module std.test, imported by`
    Str path;  // where, empty when it is not known
    U32 line;  // 0-based
    U32 column;
};

export typedef typeof(Link[:]) Links;

static Str root_path;
static Str root_source;
static const ast::Module *root_tree;

static Links links_of(const types::Checked *c, Str module, Bool in_instance, Usize i);

// One finding of `diagnose`: the bytes it covers, whether it is an error (else a warning), and its message.
export struct Problem {
    U32 start;
    U32 end;
    Bool error;
    Str message;
    Links links; // the error trace (#2949), empty when there is none
};

export typedef typeof(Problem[:]) Problems;

static Problems problems_of(Problems list, parse::Errors found, Bool error) {
    for (Usize i = 0; i < countof(found); i++) {
        list = mem::realloc(list, countof(list) + 1);
        list[countof(list) - 1] = (Problem){
            .start = found[i].span.start, .end = found[i].span.end, .error = error, .message = found[i].message};
    }
    return list;
}

// The findings of the parser and the checker on the text `source` of the file `path`, no file read and nothing written
// (the language server's diagnostics, #1887): the parser's errors (and the warnings of a file in smith's own syntax),
// or, when it parsed, the checker's errors. The module's name is not compared with its path. The findings are the
// current allocator's.
export Problems diagnose(Str path, Str source, roots::Roots folders) {
    Problems list = {};
    Bool today = starts_with_module(source);
    parser::Parsed parsed = today ? parser::parse_file(path, source) : parser::parse_new(path, source);
    if (!today) list = problems_of(list, parsed.warnings, false);
    list = problems_of(list, parsed.errors, true);
    if (countof(parsed.errors) > 0) return list;
    import_roots = folders;
    enter_file(path);
    root_path = path;
    root_source = source;
    root_tree = &parsed.module;
    lint_inputs(source);
    types::Checked checked = types_decl::check_module_headers(&parsed.module, types::lp64(), load_module, load_header);
    lint_inputs_done();
    for (Usize i = 0; i < checked.error_count; i++) {
        list = mem::realloc(list, countof(list) + 1);
        list[countof(list) - 1] =
            (Problem){.start = checked.errors[i].span.start,
                      .end = checked.errors[i].span.end,
                      .error = true,
                      .message = checked.errors[i].has_related
                                     ? with_line(source, checked.errors[i].message, checked.errors[i].related)
                                     : checked.errors[i].message,
                      .links = links_of(&checked, checked.errors[i].module, checked.errors[i].in_instance,
                                        checked.errors[i].instance)};
    }
    return list;
}

// The module the checker typed: `parsed` with each compile-time `if` keeping one branch and each `@when` decided
// (#2277), or `parsed` itself. Its nodes are the ones `types::type_of` knows.
static const ast::Module *checked_module(const types::Checked *checked, const ast::Module *parsed) {
    if (checked->module != nullptr) return checked->module;
    return parsed;
}

// What a hover finds: the bytes of the expression under the cursor and its type as text; `found` is false when the
// text does not parse, or no checked expression covers the offset.
export struct Hover {
    Bool found;
    U32 start;
    U32 end;
    Str type;
    Str doc; // the comment above the name's declaration in a C header, without its markers; empty when there is none
};

// The symbol of a name that a C header declared (`c::printf`, or `c.printf` in smith's own syntax), or null: headers
// declare their names as `c::name`, whatever the import is called, so the member of a plain name reads the same row.
static const types::Symbol *header_symbol(const types::Checked *checked, const ast::Expr *at) {
    const types::Symbol *found = nullptr;
    if (at->kind == .name) {
        found = types::lookup_path(&checked->scopes, at->kind.name.path);
    } else if (at->kind == .member && at->kind.member.base->kind == .name) {
        found = types::lookup(&checked->scopes, as_str(format::push("c::", at->kind.member.name)));
    }
    if (found == nullptr || !types::declared_in_c(found)) return nullptr;
    return found;
}

// The innermost checked expression of the text `source` of `path` that covers the byte `offset`, with its type (the
// language server's hover, #1892). Nothing is read or written; the result is the current allocator's.
export Hover hover_at(Str path, Str source, roots::Roots folders, U32 offset) {
    Bool today = starts_with_module(source);
    parser::Parsed parsed = today ? parser::parse_file(path, source) : parser::parse_new(path, source);
    if (countof(parsed.errors) > 0) return (Hover){};
    import_roots = folders;
    enter_file(path);
    types::Checked checked = types_decl::check_module_headers(&parsed.module, types::lp64(), load_module, load_header);
    const ast::Expr *at = ast::expr_at(checked_module(&checked, &parsed.module), offset);
    if (at == nullptr) return (Hover){};
    types::TypeRef type = types::type_of(&checked, at);
    const types::Symbol *named = header_symbol(&checked, at);
    if (type == nullptr && named != nullptr) type = named->type; // `c.f` before the checker binds `c` (#1961)
    if (type == nullptr) return (Hover){};
    Str doc = "";
    if (named != nullptr) doc = types::declared_doc(named);
    return (Hover){.found = true, .start = at->span.start, .end = at->span.end, .type = types::show(type), .doc = doc};
}

// One thing completion offers: its name, what the editor draws for it (LSP's `CompletionItemKind`: 2 method, 3
// function, 5 field, 6 variable, 7 type, 9 module), its type as text and, for a C header's name, the comment above it.
export struct Candidate {
    Str label;
    U32 kind;
    Str detail;
    Str doc;
};

export typedef typeof(Candidate[:]) Candidates;

static Bool starts_with_text(Str text, Str prefix) {
    if (countof(prefix) > countof(text)) return false;
    for (Usize i = 0; i < countof(prefix); i++)
        if (text[i] != prefix[i]) return false;
    return true;
}

static Bool equal_text(Str a, Str b) {
    return countof(a) == countof(b) && starts_with_text(a, b);
}

static Candidates offer(Candidates list, Candidate item) {
    for (Usize i = 0; i < countof(list); i++)
        if (equal_text(list[i].label, item.label)) return list;
    list = mem::realloc(list, countof(list) + 1);
    list[countof(list) - 1] = item;
    return list;
}

static Bool is_word(char ch) {
    return ascii::alpha(ch) || ascii::digit(ch) || ch == '_';
}

// Whether the variable `v` may be written at `offset`: a variable declared inside a function (its scope is the whole
// file in the list) is a local of that function, seen after its declaration and nowhere else; any other is a global.
static Bool visible_variable(ast::Symbols names, ast::Symbol v, U32 offset) {
    for (Usize i = 0; i < countof(names); i++) {
        ast::Symbol f = names[i];
        if (f.kind != ast::sym_function || f.at.start > v.at.start || v.at.end > f.at.end) continue;
        if (f.at.start == v.at.start) continue;
        return f.at.start <= offset && offset <= f.at.end && v.at.start < offset;
    }
    return true;
}

// The names a position can write unqualified: the names of the file whose scope covers `offset` (a local only after
// its declaration), that start with `prefix`.
static Candidates names_at(Candidates list, const ast::Module *m, Str source, U32 offset, Str prefix) {
    ast::Span everywhere = {.start = 0, .end = (U32)countof(source)};
    ast::Symbols names = ast::symbols(m, everywhere);
    for (Usize i = 0; i < countof(names); i++) {
        ast::Symbol s = names[i];
        if (s.kind == ast::sym_field || s.kind == ast::sym_variant) continue;
        if (s.scope.start > offset || offset > s.scope.end) continue;
        if (s.kind == ast::sym_variable && !visible_variable(names, s, offset)) continue;
        if (s.scope.start != everywhere.start || s.scope.end != everywhere.end) {
            if (s.at.start >= offset) continue;
        }
        if (!starts_with_text(s.name, prefix) || countof(s.name) == 0) continue;
        U32 kind = 6;
        if (s.kind == ast::sym_function) kind = 3;
        if (s.kind == ast::sym_type) kind = 7;
        if (s.kind == ast::sym_module) kind = 9;
        list = offer(list, (Candidate){.label = s.name, .kind = kind});
    }
    return list;
}

// Whether `name` is the name an `import c <header>` is reached by: `c`, or the alias of one.
static Bool header_qualifier(const ast::Module *m, Str name) {
    if (equal_text(name, "c")) return true;
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind == .import_c && countof(d->kind.import_c.alias) > 0 && equal_text(d->kind.import_c.alias, name))
            return true;
    }
    return false;
}

// What follows the `.` after the receiver `base`: its fields and its methods (a function of the module that defines
// its type or of this one, whose first parameter is the receiver, seen through one pointer), or, when `base` names a C
// header, that header's names.
static Candidates members_of(Candidates list, const types::Checked *checked, const ast::Module *m,
                             const ast::Expr *base, Str prefix) {
    if (base->kind == .name && countof(base->kind.name.path.segments) == 1 &&
        header_qualifier(m, base->kind.name.path.segments[0].text) && types::type_of(checked, base) == nullptr) {
        for (Usize i = 0; i < countof(checked->scopes.symbols) && i < checked->scopes.count; i++) {
            const types::Symbol *s = &checked->scopes.symbols[i];
            if (!types::declared_in_c(s) || !starts_with_text(s->name, "c::")) continue;
            Str label = s->name[3:countof(s->name)];
            if (!starts_with_text(label, prefix) || s->type == nullptr) continue;
            U32 kind = s->kind == .function_symbol ? 3 : 6;
            if (s->kind == .type_name) kind = 7;
            list = offer(
                list, (Candidate){
                          .label = label, .kind = kind, .detail = types::show(s->type), .doc = types::declared_doc(s)});
        }
        return list;
    }
    types::TypeRef type = types::type_of(checked, base);
    if (type == nullptr) return list;
    types::TypeRef self = type->kind == .pointer ? types::element_of(type) : type;
    Str module = "";
    if (self->kind == .record) {
        for (Usize cut = countof(types::name_of(self)); cut >= 2 && countof(module) == 0; cut--)
            if (types::name_of(self)[cut - 1] == ':' && types::name_of(self)[cut - 2] == ':')
                module = types::name_of(self)[0:cut];
        for (Usize i = 0; i < countof(types::slots_of(self).items); i++) {
            if (!types::field_visible(self, &types::slots_of(self).items[i]) ||
                !starts_with_text(types::slots_of(self).items[i].name, prefix))
                continue;
            list = offer(list, (Candidate){.label = types::slots_of(self).items[i].name,
                                           .kind = 5,
                                           .detail = types::show(types::slots_of(self).items[i].type)});
        }
    }
    for (Usize i = 0; i < countof(checked->scopes.symbols) && i < checked->scopes.count; i++) {
        const types::Symbol *s = &checked->scopes.symbols[i];
        if (s->kind != .function_symbol || s->type == nullptr || s->type->kind != .function) continue;
        if (countof(types::slots_of(s->type).items) == 0 || s->generic) continue;
        types::TypeRef takes = types::slots_of(s->type).items[0].type;
        if (takes->kind == .pointer) takes = types::element_of(takes);
        if (takes != self) continue;
        Str label = s->name;
        if (starts_with_text(label, module) && countof(module) > 0) {
            if (!types::is_public(s)) continue;
            label = label[countof(module):countof(label)];
        }
        Bool qualified = false;
        for (Usize k = 0; k + 1 < countof(label); k++)
            if (label[k] == ':' && label[k + 1] == ':') qualified = true;
        if (qualified || !starts_with_text(label, prefix)) continue;
        list = offer(list, (Candidate){.label = label, .kind = 2, .detail = types::show(s->type)});
    }
    return list;
}

// What the editor may offer at the byte `offset` of the text `source` of `path` (the language server's completion,
// #1894): after a `.`, the fields and methods of the receiver, or a C header's names; else the names in scope. The
// word being typed is dropped from the text first (a `.` and a word do not parse alone); the result is the current
// allocator's.
export Candidates completion_at(Str path, Str source, roots::Roots folders, U32 offset) {
    if (offset > countof(source)) offset = (U32)countof(source);
    U32 word = offset;
    while (word > 0 && is_word(source[word - 1]))
        word -= 1;
    Str prefix = source[word:offset];
    Bool dot = word > 0 && source[word - 1] == '.';
    Str edited = as_str(format::push(source[0:dot ? word - 1 : word], dot ? "" : "_", source[offset:countof(source)]));
    Bool today = starts_with_module(source);
    parser::Parsed parsed = today ? parser::parse_file(path, edited) : parser::parse_new(path, edited);
    Candidates list = {};
    if (countof(parsed.errors) > 0) return list;
    if (!dot) return names_at(list, &parsed.module, edited, offset, prefix);
    import_roots = folders;
    enter_file(path);
    types::Checked checked = types_decl::check_module_headers(&parsed.module, types::lp64(), load_module, load_header);
    if (word < 2) return list;
    const ast::Module *module = checked_module(&checked, &parsed.module);
    const ast::Expr *base = ast::expr_at(module, word - 2);
    if (base == nullptr) return list;
    return members_of(list, &checked, module, base, prefix);
}

// Where a name is declared (the language server's go-to-definition, #1893): in `file` (empty: the file asked about),
// the bytes `start` to `end`, or, for a declaration read from a C header, the `line` and `column` (1-based) clang gives
// when `by_line` is set.
export struct Location {
    Bool found;
    Str file;
    U32 start;
    U32 end;
    Bool by_line;
    U32 line;
    U32 column;
};

// The name a declaration introduces, empty when it introduces none (an import, a static assertion).
static Str declared_name(const ast::Decl *d) {
    if (d->kind == .function) return d->kind.function.name;
    if (d->kind == .record) return d->kind.record.name;
    if (d->kind == .enumeration) return d->kind.enumeration.name;
    if (d->kind == .type_alias) return d->kind.type_alias.name;
    if (d->kind == .variable) return d->kind.variable.name;
    return "";
}

static Bool same_text(Str a, Str b) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i++)
        if (a[i] != b[i]) return false;
    return true;
}

// The place of the declaration called `name` in `m`; not found when there is none.
static Location declaration_in(const ast::Module *m, Str name) {
    for (Usize i = 0; m != nullptr && i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (countof(name) == 0 || !same_text(declared_name(d), name)) continue;
        if (d->from_c) {
            return (Location){.found = true,
                              .file = d->place.file,
                              .by_line = true,
                              .line = d->place.line,
                              .column = d->place.column};
        }
        return (Location){.found = true, .file = m->file, .start = d->span.start, .end = d->span.end};
    }
    return (Location){};
}

// The dotted name of an import's path (`std.math`), NUL-terminated.
static Str dotted_of(ast::Path path) {
    Str out = "";
    for (Usize i = 0; i < countof(path.segments); i++)
        out = as_str(format::push(out, i == 0 ? "" : ".", path.segments[i].text));
    return out;
}

// The path an import declaration reads, empty when `d` is no import.
static ast::Path imported_path(const ast::Decl *d) {
    ast::Path path = {};
    if (d->kind == .import_module) path = d->kind.import_module.path;
    if (d->kind == .import_from) path = d->kind.import_from.path;
    return path;
}

// The dotted name an import declaration reads, empty when `d` is no import or names a standard module (the library
// has no cycles, and reading it twice would cost the compile).
static Str imported_name(const ast::Decl *d) {
    Str name = dotted_of(imported_path(d));
    if (starts_with_text(name, "std.") || same_text(name, "std")) return "";
    return name;
}

// A module the cycle search will read the imports of, and the chain that reached it.
struct Visit {
    const ast::Module *module;
    Str name;
    Str chain;
};

// The shortest chain from the module `first` (reached by `chain`, which ends in its name) back to `target` through
// imports, as `a -> b -> a` (dotted names), or empty when `first` leads nowhere near it. Each module is read once.
static Str cycle_through(const ast::Module *first, Str first_name, Str chain, Str target) {
    Visit queue[:] = {};
    queue = mem::realloc(queue, 1);
    queue[0] = (Visit){.module = first, .name = first_name, .chain = chain};
    for (Usize head = 0; head < countof(queue); head++) {
        const ast::Module *m = queue[head].module;
        for (Usize i = 0; i < countof(m->decls); i++) {
            Str name = imported_name(m->decls[i]);
            if (countof(name) == 0) continue;
            Str next = as_str(format::push(queue[head].chain, " -> ", name));
            if (same_text(name, target)) return next;
            Bool entered = false;
            for (Usize k = 0; k < countof(queue); k++)
                if (same_text(queue[k].name, name)) entered = true;
            if (entered) continue;
            const ast::Module *loaded = load_module(name.data);
            if (loaded == nullptr) continue;
            queue = mem::realloc(queue, countof(queue) + 1);
            queue[countof(queue) - 1] = (Visit){.module = loaded, .name = name, .chain = next};
        }
    }
    return "";
}

// `chain` with its dots written `::` (today's syntax names a module that way).
static Str colons(Str chain) {
    Str out = "";
    for (Usize i = 0; i < countof(chain); i++) {
        Str piece = chain[i:i + 1];
        if (chain[i] == '.') piece = "::";
        out = as_str(format::push(out, piece));
    }
    return out;
}

// ---------------------------------------------------------------------------------------------------------------
// The error trace (#2949): the chain that led to a diagnostic, innermost first. A link says what the diagnostic is
// inside (`in check_part[str], instantiated at`) and where that was; the report prints one `  in ...` line per link,
// the language server sends each as a `relatedInformation` entry.

static Links add_link(Links list, Str label, Str prefix, ast::Span span) {
    Str path = root_path;
    Str source = root_source;
    Usize at = read_index(prefix);
    if (countof(prefix) > 0 && at < read_count) {
        path = read_paths[at];
        source = read_sources[at];
    }
    U32 line = 0;
    U32 column = 0;
    for (Usize k = 0; k < countof(source) && k < span.start; k++) {
        if (source[k] == '\n') {
            line += 1;
            column = 0;
        } else {
            column += 1;
        }
    }
    list = mem::realloc(list, countof(list) + 1);
    list[countof(list) - 1] = (Link){.label = label, .path = path, .line = line, .column = column};
    return list;
}

static Links add_unplaced(Links list, Str label) {
    list = mem::realloc(list, countof(list) + 1);
    list[countof(list) - 1] = (Link){.label = label};
    return list;
}

// The dotted name (`std.test`) of the module read under `prefix` (`std::test::`).
static Str dotted_of_prefix(Str prefix) {
    Str out = "";
    for (Usize i = 0; i < countof(prefix); i++) {
        if (prefix[i] == ':') {
            if (i + 1 < countof(prefix) && prefix[i + 1] == ':') {
                if (i + 2 < countof(prefix)) out = as_str(format::push(out, "."));
                i += 1;
            }
            continue;
        }
        out = as_str(format::push(out, prefix[i:i + 1]));
    }
    return out;
}

// The import in `m` of the module `name`, or null.
static const ast::Decl *import_of(const ast::Module *m, Str name) {
    if (m == nullptr) return nullptr;
    for (Usize i = 0; i < countof(m->decls); i++) {
        ast::Path path = imported_path(m->decls[i]);
        if (countof(path.segments) > 0 && same_text(dotted_of(path), name)) return m->decls[i];
    }
    return nullptr;
}

// The `in module ..., imported by` links for the module read under `prefix`, up to the file being compiled.
static Links import_links(Links list, Str prefix) {
    for (Usize depth = 0; depth < 8 && countof(prefix) > 0; depth++) {
        Str name = dotted_of_prefix(prefix);
        Str label = as_str(format::push("in module ", name, ", imported by"));
        Str importer = "";
        const ast::Decl *at = import_of(root_tree, name);
        for (Usize i = 0; at == nullptr && i < read_count; i++) {
            at = import_of(read_trees[i], name);
            importer = read_prefixes[i];
        }
        if (at == nullptr) return add_unplaced(list, as_str(format::push("in module ", name)));
        list = add_link(list, label, importer, imported_path(at).span);
        prefix = importer;
    }
    return list;
}

// `check_part[str]`: the generic function of instance `i` and what its parameters are bound to.
static Str instance_label(const types::Checked *c, Usize i) {
    const types::Instance *x = &c->instances[i];
    Str label = "?";
    if (x->template->kind == .function) label = as_str(format::push(x->template->kind.function.name));
    for (Usize k = 0; k < countof(x->bindings); k++) {
        Str bound =
            x->bindings[k].is_type ? types::show(x->bindings[k].type) : as_str(format::push(x->bindings[k].value));
        label = as_str(format::push(label, k == 0 ? "[" : ", ", bound));
    }
    if (countof(x->bindings) > 0) label = as_str(format::push(label, "]"));
    return label;
}

// The `in <instance>, instantiated at` links from instance `i` out to the first call outside any instance.
static Links instance_links(Links list, const types::Checked *c, Usize i) {
    for (Usize depth = 0; depth < 16 && i < c->instance_count; depth++) {
        Usize use = 0;
        while (use < c->use_count && c->uses[use].instance != i)
            use += 1;
        if (use == c->use_count) return add_unplaced(list, as_str(format::push("in ", instance_label(c, i))));
        Str label = as_str(format::push("in ", instance_label(c, i), ", instantiated at"));
        list = add_link(list, label, c->uses[use].module, c->uses[use].call->span);
        i = c->uses[use].outer;
    }
    return list;
}

// The trace of an error found in `module` (a prefix) and, when `in_instance`, in the body of instance `i`.
static Links links_of(const types::Checked *c, Str module, Bool in_instance, Usize i) {
    Links list = {};
    if (in_instance) list = instance_links(list, c, i);
    return import_links(list, module);
}

// The `  in ...` lines of `links`.
static Str trace_text(Links links) {
    Str out = "";
    for (Usize i = 0; i < countof(links); i++) {
        Str where = links[i].path;
        if (countof(where) == 0) {
            out = as_str(format::push(out, "  ", links[i].label, "\n"));
        } else {
            out = as_str(format::push(out, "  ", links[i].label, " ", links[i].path, ":", links[i].line + 1, ":",
                                      links[i].column + 1, "\n"));
        }
    }
    return out;
}

static Str trace_of(const types::Checked *c, Str module, Bool in_instance, Usize i) {
    return trace_text(links_of(c, module, in_instance, i));
}

// The report of every error the checker found: each one's line, its note and its trace (#2949).
static Str checked_lines(Str path, Str source, const types::Checked *checked) {
    Str all = "";
    for (Usize i = 0; i < checked->error_count; i++) {
        const types::Error *e = &checked->errors[i];
        all = as_str(
            format::push(all, error_lines(path, source, e), trace_of(checked, e->module, e->in_instance, e->instance)));
    }
    return all;
}

// The report of the error the emitter stopped at: its line, in the module it was found in, then its trace (#2949).
static Str emit_error_lines(const types::Checked *checked, emit::Error e) {
    Str file = root_path;
    Str source = root_source;
    Usize at = read_index(e.module);
    if (countof(e.module) > 0 && at < read_count) {
        file = read_paths[at];
        source = read_sources[at];
    }
    return as_str(format::push(diagnostic(file, source, e.span, "error", e.message),
                               trace_of(checked, e.module, e.in_instance, e.instance)));
}

// The report of the imports of `m` (the module of `path`, named already) that close a cycle: one line at each such
// `import`, `file:line:column: error: import cycle: a -> b -> a`, the column that of the module's name. Empty when
// none does. `import_roots` says where the modules are.
static Str import_cycles(Str path, Str source, const ast::Module *m, roots::Roots folders) {
    import_roots = folders;
    Str self = dotted_of(m->name);
    if (countof(self) == 0) return "";
    Bool old = starts_with_module(source);
    Str all = "";
    for (Usize i = 0; i < countof(m->decls); i++) {
        Str name = imported_name(m->decls[i]);
        if (countof(name) == 0) continue;
        Str chain = "";
        if (same_text(name, self)) {
            chain = as_str(format::push(self, " -> ", self));
        } else {
            const ast::Module *loaded = load_module(name.data);
            if (loaded != nullptr) chain = cycle_through(loaded, name, as_str(format::push(self, " -> ", name)), self);
        }
        if (countof(chain) == 0) continue;
        Str shown = old ? colons(chain) : chain;
        Str message = as_str(format::push("import cycle: ", shown));
        all = as_str(format::push(all, diagnostic(path, source, imported_path(m->decls[i]).span, "error", message)));
    }
    return all;
}

// The module the name `qualifier` stands for in `m`: an `import a.b` is reached as `b`, `import a.b as q` as `q`, an
// `import c <h>` as `c` (or its alias), and a name brought in by `from a.b import n` is not a qualifier.
static const ast::Module *qualified_module(const ast::Module *m, Str qualifier) {
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind == .import_module) {
            Usize n = countof(d->kind.import_module.path.segments);
            if (n == 0) continue;
            Str last = d->kind.import_module.path.segments[n - 1].text;
            Str reached = last;
            if (countof(d->kind.import_module.alias) > 0) reached = d->kind.import_module.alias;
            if (same_text(reached, qualifier)) return load_module(dotted_of(d->kind.import_module.path).data);
        }
        if (d->kind == .import_c) {
            Str reached = "c";
            if (countof(d->kind.import_c.alias) > 0) reached = d->kind.import_c.alias;
            if (same_text(reached, qualifier)) return load_header(d->kind.import_c.header, d->kind.import_c.angled);
        }
    }
    return nullptr;
}

// The module that `from a.b import n` takes `name` from, when one does.
static const ast::Module *from_module(const ast::Module *m, Str name) {
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind != .import_from) continue;
        for (Usize k = 0; k < countof(d->kind.import_from.names); k++) {
            if (!same_text(d->kind.import_from.names[k].text, name)) continue;
            if (countof(d->kind.import_from.header) > 0)
                return load_header(d->kind.import_from.header, d->kind.import_from.angled);
            return load_module(dotted_of(d->kind.import_from.path).data);
        }
    }
    return nullptr;
}

// Where the name under the byte `offset` of the text `source` of `path` is declared (go-to-definition, #1893): a name
// of this file, `q.name` or `q::name` through an import (a module, or a C header with the place clang records), or a
// name a `from ... import` brought in. Nothing is read but the imported files; the result is the current allocator's.
export Location definition_at(Str path, Str source, roots::Roots folders, U32 offset) {
    Bool today = starts_with_module(source);
    parser::Parsed parsed = today ? parser::parse_file(path, source) : parser::parse_new(path, source);
    if (countof(parsed.errors) > 0) return (Location){};
    import_roots = folders;
    enter_file(path);
    const ast::Expr *at = ast::expr_at(&parsed.module, offset);
    if (at == nullptr) return (Location){};
    Location found = {};
    ast::Path name = {};
    ast::Identifier owner = {};
    Str member_name = "";
    if (types::name_path(at, &name)) {
        Usize n = countof(name.segments);
        if (n == 0) return (Location){};
        if (n >= 2) {
            found =
                declaration_in(qualified_module(&parsed.module, name.segments[n - 2].text), name.segments[n - 1].text);
        } else {
            Str word = name.segments[0].text;
            found = declaration_in(&parsed.module, word);
            if (!found.found) found = declaration_in(from_module(&parsed.module, word), word);
        }
    } else if (types::member_of_name(at, &owner, &member_name)) {
        found = declaration_in(qualified_module(&parsed.module, owner.text), member_name);
    }
    if (found.found && countof(found.file) == 0) found.file = path;
    return found;
}

// One declaration of a file for the outline: its name, what it is (`function`, `struct`, `enum`, `constant`,
// `variable`, `type`) and the bytes it covers.
export struct Symbol {
    Str name;
    Str kind;
    U32 start;
    U32 end;
};

export typedef typeof(Symbol[:]) Symbols;

// The declarations of the text `source` of `path` that have a name, in order (document symbols, #1893); none when the
// text does not parse. The result is the current allocator's.
export Symbols symbols(Str path, Str source) {
    Bool today = starts_with_module(source);
    parser::Parsed parsed = today ? parser::parse_file(path, source) : parser::parse_new(path, source);
    Symbols list = {};
    if (countof(parsed.errors) > 0) return list;
    for (Usize i = 0; i < countof(parsed.module.decls); i++) {
        const ast::Decl *d = parsed.module.decls[i];
        Str name = declared_name(d);
        if (countof(name) == 0) continue;
        Str kind = "variable";
        if (d->kind == .function) kind = "function";
        if (d->kind == .record) kind = "struct";
        if (d->kind == .enumeration) kind = "enum";
        if (d->kind == .type_alias) kind = "type";
        if (d->kind == .variable && d->kind.variable.is_constexpr) kind = "constant";
        list = mem::realloc(list, countof(list) + 1);
        list[countof(list) - 1] = (Symbol){.name = name, .kind = kind, .start = d->span.start, .end = d->span.end};
    }
    return list;
}

static Bool ends_with_bc(Str name) {
    return countof(name) > 3 && roots::same(name[countof(name) - 3:countof(name)], ".bc");
}

// The module as bitcode in `output`, for an output named `*.bc`: `smith prove` (#1974) reads bitcode, not an object.
static Report write_bitcode(c::LLVMModuleRef ir, Str path, Str output, Str warned, Times times) {
    char *bitcode_path = state::cstr(output);
    defer mem::free(bitcode_path);
    Times timed = times;
    U64 mark = clock::monotonic();
    I32 failed_write = c::LLVMWriteBitcodeToFile(ir, bitcode_path);
    timed.write = clock::monotonic() - mark;
    if (failed_write != 0) {
        return failed(as_str(format::push(warned, path, ": error: cannot write the bitcode\n")), timed);
    }
    return (Report){.ok = true, .text = warned, .times = timed};
}

// ---------------------------------------------------------------------------------------------------------------
// The count's run (#2984): what hides behind a first error, and a crash that names where it was

// SMITH_FRONT_KEEP_GOING (set by `smith build frontend-coverage`): set and not empty, not 0.
static Bool keep_going_requested() {
    const char *given = c::getenv("SMITH_FRONT_KEEP_GOING");
    return given != nullptr && given[0] != 0 && given[0] != '0';
}

static Bool span_inside(ast::Span outer, ast::Span at) {
    return outer.end > outer.start && at.start >= outer.start && at.end <= outer.end;
}

// The function declaration whose body holds `at`, or null.
static const ast::Decl *body_holding(const ast::Module *m, ast::Span at) {
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind != .function || d->kind.function.body == nullptr) continue;
        if (span_inside(d->kind.function.body->span, at)) return d;
    }
    return nullptr;
}

// The part of the module the emit stage still gets after check errors, in the count's run: every declaration, but a
// function whose body holds an error is a prototype (its signature checked, so a call to it is emitted as before).
// Nothing that is emitted depends on a declaration that failed. Null, and the file stops at `check` as an ordinary
// compile does, when an error is anywhere else: in a signature, a record, a global, an import or a generic's instance.
static const ast::Module *checked_part(const types::Checked *checked, const ast::Module *m) {
    for (Usize i = 0; i < checked->error_count; i++) {
        Str module = checked->errors[i].module;
        if (countof(module) > 0 || checked->errors[i].in_instance) return nullptr;
        if (body_holding(m, checked->errors[i].span) == nullptr) return nullptr;
    }
    Usize count = countof(m->decls);
    ast::DeclRef *block = (ast::DeclRef *)mem::alloc_array_raw(sizeof(ast::DeclRef), count, alignof(ast::DeclRef));
    ast::DeclRef kept[:] = block[0:count];
    for (Usize i = 0; i < countof(m->decls); i++) {
        ast::Decl *d = m->decls[i];
        kept[i] = d;
        if (d->kind != .function || d->kind.function.body == nullptr) continue;
        Bool failed_here = false;
        for (Usize k = 0; k < checked->error_count; k++)
            failed_here = failed_here || span_inside(d->kind.function.body->span, checked->errors[k].span);
        if (!failed_here) continue;
        ast::Decl *prototype = mem::alloc(ast::Decl);
        *prototype = *d;
        if (prototype->kind == .function) {
            prototype->kind.function.body = nullptr;
        }
        kept[i] = prototype;
    }
    ast::Module *part = mem::alloc(ast::Module);
    *part = *m;
    part->decls = kept;
    return part;
}

// The emit stage's errors on `part`, as lines; no object is written, whatever it finds.
static Str emit_part(const types::Checked *checked, const ast::Module *part, emit::Options options) {
    c::LLVMContextRef context = c::LLVMContextCreate();
    defer c::LLVMContextDispose(context);
    emit::Emitted emitted = emit::module_all(context, part, options);
    Str lines = "";
    for (Usize i = 0; i < countof(emitted.errors); i++)
        lines = as_str(format::push(lines, emit_error_lines(checked, emitted.errors[i])));
    if (emitted.module != nullptr) c::LLVMDisposeModule(emitted.module);
    return lines;
}

// The file being compiled and its stage, for the driver's crash handler (runtime/front_flag.c): kept in a fixed
// buffer and a literal, which the handler reads without allocating.
static char walk_file[4096];
static const char *walk_stage = "parse";

static void note_crash_file(Str path) {
    Usize n = countof(path) < sizeof walk_file - 1 ? countof(path) : sizeof walk_file - 1;
    for (Usize i = 0; i < n; i++)
        walk_file[i] = path[i];
    walk_file[n] = 0;
    walk_stage = "parse";
}

[[std::c_name("front_compile_crash_file")]] export const char *crash_file_name() {
    return walk_file;
}

[[std::c_name("front_compile_crash_stage")]] export const char *crash_stage_name() {
    return walk_stage;
}

// The emitter's options for one file: objects are made at optimization 0, a debug build, and `smith cc -g` sets
// SMITH_FRONT_DEBUG (runtime/front_flag.c), which gives the object debug info (#1979).
static emit::Options emit_options(Str wanted, Str source, types::Checked *checked) {
    emit::Options options = {};
    options.target = (emit::Target){.triple = wanted, .data_layout = layout_of(wanted)};
    options.source = source;
    options.checked = checked;
    options.fill_undefined = true;
    options.debug_info = c::getenv("SMITH_FRONT_DEBUG") != nullptr;
    return options;
}

// The name of the file being compiled: it keeps its plain symbol names, so `local` (which only finds its imports,
// #2041) is left out of the roots that name it.
static Str name_compiled(ast::Module *m, Str path, roots::Roots folders) {
    roots::Roots named_by = folders;
    named_by.local = "";
    return name_module(m, path, named_by);
}

// `triple`, or the default triple of this machine when it is empty.
static Str wanted_triple(Str triple) {
    if (countof(triple) > 0) return triple;
    char *default_triple = c::LLVMGetDefaultTargetTriple();
    Str found = as_str(format::push((const char *)default_triple));
    c::LLVMDisposeMessage(default_triple);
    return found;
}

// Compiles `path` to the object `output` for `triple`; `roots` are the folders names start from.
// `file` with what parsing and checking allocate taken from `memory` (null: the allocator in force), which the caller
// resets once the report is out (#2888): a process that compiles many files keeps only the shared table between them.
// Emitting and writing go back to the allocator in force, as LLVM keeps process-wide state in what it allocates.
static Report file_in(Str path, Str output, Str triple, roots::Roots folders, mem::Allocator *memory);

export Report file(Str path, Str output, Str triple, roots::Roots folders) {
    return file_in(path, output, triple, folders, nullptr);
}

// The state of one file's check: the roots its imports are found in, the timers, the inputs `smith lint` keys on and
// the root module the loader sees. The crash handler then names the `check` stage, which also stays the stage of a
// file whose clean part goes on to emit after a failed check.
static void begin_check(Str path, Str source, roots::Roots folders, ast::Module *tree) {
    import_roots = folders;
    enter_file(path);
    import_nanoseconds = 0;
    header_nanoseconds = 0;
    read_count = 0;
    lint_inputs(source);
    root_path = path;
    root_source = source;
    root_tree = tree;
    walk_stage = "check";
}

// Emits and writes a file whose check passed: `tree` is its parsed module, `warned` the warnings to report.
static Report emit_checked(Str path, Str output, Str wanted, Str source, Str warned, types::Checked *checked,
                           ast::Module *tree, Times times) {
    emit::Options options = emit_options(wanted, source, checked);
    c::LLVMContextRef context = c::LLVMContextCreate();
    defer c::LLVMContextDispose(context);
    walk_stage = "emit";
    U64 mark = clock::monotonic();
    emit::Emitted emitted = emit::module_all(context, checked_module(checked, tree), options);
    times.emit = clock::monotonic() - mark;
    if (countof(emitted.errors) > 0) {
        Str lines = warned;
        for (Usize i = 0; i < countof(emitted.errors); i++)
            lines = as_str(format::push(lines, emit_error_lines(checked, emitted.errors[i])));
        return failed(lines, times);
    }
    c::LLVMModuleRef ir = emitted.module;
    defer c::LLVMDisposeModule(ir);

    if (ends_with_bc(output)) return write_bitcode(ir, path, output, warned, times);
    emit_object::ObjectOptions object_options = {.target = options.target, .optimization = 0};
    walk_stage = "write";
    mark = clock::monotonic();
    emit_object::WriteResult written = emit_object::write(ir, object_options, output);
    times.write = clock::monotonic() - mark;
    if (written == .error)
        return failed(as_str(format::push(warned, path, ": error: ", written.error.message, "\n")), times);
    return (Report){.ok = true, .text = warned, .times = times};
}

static Report file_in(Str path, Str output, Str triple, roots::Roots folders, mem::Allocator *memory) {
    mem::Allocator *outside = mem::allocator();
    if (memory != nullptr) mem::set_allocator(memory);
    defer mem::set_allocator(outside);
    Times times = {};
    files::BytesResult loaded = load(path);
    if (loaded != .ok) return failed(as_str(format::push(path, ": error: cannot read the file\n")), times);
    format::Chars chars = mem::view(loaded.ok, char);
    Str source = chars;

    note_crash_file(path);
    U64 mark = clock::monotonic();
    Bool today = starts_with_module(source);
    parser::Parsed parsed = today ? parser::parse_file(path, source) : parser::parse_new(path, source);
    times.parse = clock::monotonic() - mark;
    // Today's syntax is all warnings (every old form), so its report is what it was: only smith's own files show them.
    Str none = "";
    Str warned = today ? none : lines_of(path, source, parsed.warnings, "warning");
    if (countof(parsed.errors) > 0) {
        return failed(as_str(format::push(warned, lines_of(path, source, parsed.errors, "error"))), times);
    }
    Str problem = name_compiled(&parsed.module, path, folders);
    if (countof(problem) > 0) return failed(as_str(format::push(warned, problem, "\n")), times);

    Str cycles = import_cycles(path, source, &parsed.module, folders);
    if (countof(cycles) > 0) return failed(as_str(format::push(warned, cycles)), times);
    Str wanted = wanted_triple(triple);
    mark = clock::monotonic();
    begin_check(path, source, folders, &parsed.module);
    types::Checked checked =
        types_decl::check_module_headers(&parsed.module, target_of(wanted), load_module, load_header);
    lint_inputs_done();
    U64 checking = clock::monotonic() - mark;
    times.imports = import_nanoseconds < checking ? import_nanoseconds : checking;
    times.check = checking - times.imports;
    times.headers = header_nanoseconds < times.imports ? header_nanoseconds : times.imports;
    if (checked.error_count > 0) {
        Str check_lines = as_str(format::push(warned, checked_lines(path, source, &checked)));
        const ast::Module *part = nullptr;
        if (keep_going_requested()) part = checked_part(&checked, checked_module(&checked, &parsed.module));
        if (part == nullptr) return failed(check_lines, times);
        mem::set_allocator(outside);
        return failed(
            as_str(format::push(check_lines, emit_part(&checked, part, emit_options(wanted, source, &checked)))),
            times);
    }

    mem::set_allocator(outside);
    return emit_checked(path, output, wanted, source, warned, &checked, &parsed.module, times);
}

// Whether SMITH_TIME asks for the stages (set, not empty, not 0).
static Bool time_requested() {
    const char *given = c::getenv("SMITH_TIME");
    return given != nullptr && given[0] != 0 && given[0] != '0';
}

// `--time` (#2681): the milliseconds of `nanoseconds` with a tenth, "12.3".
static Str milliseconds(U64 nanoseconds) {
    U64 tenths = nanoseconds / 100000;
    return as_str(format::push(tenths / 10, ".", tenths % 10));
}

static Str time_line(Str name, U64 nanoseconds) {
    return as_str(format::push("time:   ", name, " ", milliseconds(nanoseconds), " ms\n"));
}

// The stages of one file, for stderr when SMITH_TIME is set. Lexing is part of parsing (the parser pulls tokens as it
// goes), and the effect summary is part of emitting, so those two are not apart.
static void report_times(Str path, Times times, U64 wall) {
    U64 staged = times.parse + times.imports + times.check + times.emit + times.write;
    Str lines = as_str(format::push("time: ", path, "\n"));
    lines = as_str(format::push(lines, time_line("lex and parse", times.parse)));
    lines = as_str(format::push(lines, time_line("import (modules and C headers)", times.imports)));
    lines = as_str(format::push(lines, time_line("  of which C headers", times.headers)));
    lines = as_str(format::push(lines, time_line("check", times.check)));
    lines = as_str(format::push(lines, time_line("emit LLVM IR", times.emit)));
    lines = as_str(format::push(lines, time_line("write the object (LLVM passes and code generation)", times.write)));
    lines = as_str(format::push(lines, time_line("other (reading the file, setting up the target and LLVM)",
                                                 wall > staged ? wall - staged : 0)));
    lines = as_str(format::push(lines, time_line("wall (the file, every stage)", wall)));
    report(lines);
}

// The stage that stopped a failed compile: a stage that ran has its time, so the last one with a time is it.
static Str stage_of(Times times) {
    if (times.write > 0) return "write";
    if (times.emit > 0) return "emit";
    if (times.check > 0) return "check";
    return "parse";
}

// What the driver runs before each file (null: nothing): it sets the flags the file's C headers are read with, from its
// own compile command, so that a file compiled with others reads them as it does alone (#2888).
export typedef void (*BeforeFile)(const char *source);
static BeforeFile before_file_hook = nullptr;

[[std::c_name("front_compile_before_file")]] export void set_before_file(BeforeFile hook) {
    before_file_hook = hook;
}

// The driver's entry: `count` sources and their objects, the default roots, the triple of the compile (null: the
// default). Nothing is compiled when two files would get one module name. Diagnostics go to stderr.
[[std::c_name("front_compile_run")]] export I32 run(const char *const *sources, const char *const *outputs, Usize count,
                                                    const char *triple) {
    U64 run_started = clock::monotonic();
    roots::Roots folders = roots::default_roots();
    roots::Source paths[:] = {};
    for (Usize i = 0; i < count; i++) {
        paths = mem::realloc(paths, countof(paths) + 1);
        paths[i] = (roots::Source){.path = as_str(format::push((const char *)sources[i]))};
    }
    Str conflict = roots::clash(paths, folders);
    if (countof(conflict) > 0) {
        report(as_str(format::push("error: ", conflict, "\n")));
        return 1;
    }
    Str target = "";
    if (triple != nullptr) {
        target = as_str(format::push((const char *)triple));
    }
    within_command = true; // one generation for the whole command line
    header_table::next_generation();
    I32 status = 0;
    for (Usize i = 0; i < count; i++) {
        file_memory_release(); // what the file before this one left (of this call or an earlier one)
        Str output = as_str(format::push((const char *)outputs[i]));
        roots::Roots beside = folders;
        beside.local = folder_of(paths[i].path); // `import primes` finds primes.smith next to this file (#2041)
        U64 started = clock::monotonic();        // the file's flags (`before_file_hook`) are part of its compile
        if (before_file_hook != nullptr) before_file_hook(sources[i]);
        Report done = file_in(paths[i].path, output, target, beside, file_memory());
        U64 wall = clock::monotonic() - started;
        if (countof(done.text) > 0) report(done.text);
        if (time_requested()) report_times(paths[i].path, done.times, wall);
        if (!done.ok) status = 1;
        // With SMITH_FRONT_STAGE set, a failed file also names the stage that stopped it (frontend-coverage, #1730).
        if (!done.ok && c::getenv("SMITH_FRONT_STAGE") != nullptr) {
            report(as_str(format::push(paths[i].path, ": stage: ", stage_of(done.times), "\n")));
        }
    }
    within_command = false;
    if (time_requested()) {
        report(
            as_str(format::push("time: front end compile ", milliseconds(clock::monotonic() - run_started), " ms\n")));
    }
    return status;
}

// ---------------------------------------------------------------------------------------------------------------
// The C header of a module (#1621)

static Bool contains(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        if (roots::same(text[i:i + countof(needle)], needle)) return true;
    }
    return false;
}

// The target's prefix of a label: `_` for Darwin, macOS and iOS, else none (the token lowering's rule).
static Str label_prefix(Str triple) {
    Bool apple = contains(triple, "darwin") || contains(triple, "macos") || contains(triple, "ios");
    return apple ? "_" : "";
}

// The module's path joined by `separator`.
static Str joined(const ast::Module *m, Str separator) {
    Str all = "";
    for (Usize i = 0; i < countof(m->name.segments); i++) {
        if (i > 0) all = as_str(format::push(all, separator));
        all = as_str(format::push(all, m->name.segments[i].text));
    }
    return all;
}

static Bool is_c_name_attribute(ast::Attribute attribute) {
    Usize n = countof(attribute.name.segments);
    if (n == 1) return roots::same(attribute.name.segments[0].text, "c_name");
    return n == 2 && roots::same(attribute.name.segments[0].text, "std") &&
           roots::same(attribute.name.segments[1].text, "c_name");
}

// The function's `@c_name`, or "" when it has none.
static Str header_c_name(const ast::Decl *d) {
    for (Usize i = 0; i < countof(d->attributes); i++) {
        ast::Attribute attribute = d->attributes[i];
        if (!is_c_name_attribute(attribute) || countof(attribute.args) != 1) continue;
        const ast::Expr *argument = attribute.args[0];
        if (argument->kind == .string) return argument->kind.string.bytes;
    }
    return "";
}

// The C spelling of a scalar type's name (the new names and today's capitalized ones: `I32` is `i32`), or "" when the
// name is not one.
static Str scalar_spelling(Str name) {
    if (countof(name) == 0) return "";
    Bool capital = name[0] >= 'A' && name[0] <= 'Z';
    char first = capital ? (char)(name[0] + 32) : name[0];
    Str small = as_str(format::push(first, name[1:]));
    if (roots::same(small, "i8")) return "int8_t";
    if (roots::same(small, "i16")) return "int16_t";
    if (roots::same(small, "i32")) return "int32_t";
    if (roots::same(small, "i64")) return "int64_t";
    if (roots::same(small, "u8")) return "uint8_t";
    if (roots::same(small, "u16")) return "uint16_t";
    if (roots::same(small, "u32")) return "uint32_t";
    if (roots::same(small, "u64")) return "uint64_t";
    if (roots::same(small, "isize")) return "ptrdiff_t";
    if (roots::same(small, "usize")) return "size_t";
    if (roots::same(small, "bool")) return "bool";
    if (roots::same(small, "char")) return "char";
    if (roots::same(small, "f32")) return "float";
    if (roots::same(small, "f64")) return "double";
    return "";
}

static Bool is_struct_name(Str name, ast::Identifier structs[:]) {
    for (Usize i = 0; i < countof(structs); i++) {
        if (roots::same(name, structs[i].text)) return true;
    }
    return false;
}

// What a header spells a type as. `text` is empty when the type has no C spelling; `by_value` is set when it is one of
// the module's structs taken by value (its own message).
struct Spelled {
    Str text;
    Bool by_value;
    Str suffix;   // the array sizes after the name: `xs[4]`, `m[3][2]`; empty for every other type
    Str bindings; // the header bindings (`k` of `k.SIDE`) the sizes name, a line each
    Str defs;     // the struct a slice or block type needs defined before it (guarded, so a repeat is harmless)
};

// The struct of a run-time array: named after its element and shape (`n` is a run-time size), one count per run-time
// size, as the old lowering wrote it (`[]f32` is `smith_array_f32_n`, `[, 2]i32` is `smith_array_i32_n_2`).
static Spelled spell_dimensional(const ast::TypeExpr *t);

static Bool is_integer(const ast::Expr *e) {
    return e != nullptr && e->kind == .integer;
}

// The value of an integer literal, or 0 for any other expression (test `is_integer` first).
static U64 integer_value(const ast::Expr *e) {
    if (e == nullptr || e->kind != .integer) return 0;
    return e->kind.integer.value;
}

// Whether a type is an array whose length is an integer literal; the length.
static Bool sized_array(const ast::TypeExpr *t, U64 *length) {
    if (t->kind != .array) return false;
    if (!is_integer(t->kind.array.count)) return false;
    *length = integer_value(t->kind.array.count);
    return true;
}

// The element of an array type, else the type itself.
static const ast::TypeExpr *array_element(const ast::TypeExpr *t) {
    if (t->kind != .array) return t;
    return t->kind.array.element;
}

// The one name a type is written as (`i32`, `Char`), else an empty text.
static Str named_once(const ast::TypeExpr *t) {
    if (t->kind != .named) return "";
    if (countof(t->kind.named.path.segments) != 1) return "";
    return t->kind.named.path.segments[0].text;
}

static Spelled spell_dimensional(const ast::TypeExpr *t) {
    Spelled none = {.text = "", .by_value = false, .suffix = ""};
    Str shape = "";
    Usize runtime = 0;
    const ast::TypeExpr *at = t;
    Bool is_const = t->qualifiers.is_const;
    for (Usize guard = 0; guard < 8; guard++) {
        const ast::TypeExpr *here = at;
        U64 length = 0;
        if (here->kind == .slice) {
            shape = as_str(format::push(shape, "_n"));
            runtime += 1;
            at = here->kind.slice.element;
        } else if (here->kind == .block_type) {
            ast::ExprRef dims[:] = here->kind.block_type.dims;
            for (Usize i = 0; i < countof(dims); i++) {
                if (dims[i] == nullptr) {
                    shape = as_str(format::push(shape, "_n"));
                    runtime += 1;
                } else if (is_integer(dims[i])) {
                    shape = as_str(format::push(shape, "_", integer_value(dims[i])));
                } else {
                    return none;
                }
            }
            at = here->kind.block_type.element;
        } else if (sized_array(here, &length)) {
            shape = as_str(format::push(shape, "_", length));
            at = array_element(here);
        } else {
            break;
        }
    }
    if (at->kind == .slice || at->kind == .block_type || at->kind == .array) return none;
    is_const = is_const || at->qualifiers.is_const;
    // The element is a scalar: a pointer or a struct here would call `spell` back.
    Str written = named_once(at);
    if (countof(written) == 0) return none;
    Spelled element = {.text = scalar_spelling(written), .by_value = false, .suffix = ""};
    if (countof(element.text) == 0) return none;
    // The name of the struct uses the type's smith name, lowercase (`f32`, `char`), not the C spelling.
    Str name_part = written;
    if (written[0] >= 'A' && written[0] <= 'Z') {
        Usize at_letter = (Usize)(written[0] - 'A');
        Str letters = "abcdefghijklmnopqrstuvwxyz";
        name_part = as_str(format::push(letters[at_letter:at_letter + 1], written[1:]));
    }
    Str name = as_str(format::push(is_const ? "const_" : "", name_part, shape));
    Str guard_name = as_str(format::push("SMITH_ARRAY_", name));
    Str data = as_str(format::push(is_const ? "const " : "", element.text, " * data"));
    Str defs =
        as_str(format::push(element.defs, "\n#ifndef ", guard_name, "\n#define ", guard_name, "\nstruct smith_array_",
                            name, " { ", data, "; size_t count [", runtime, "]; };\n#endif\n"));
    return (Spelled){
        .text = as_str(format::push("struct smith_array_", name)), .by_value = false, .suffix = "", .defs = defs};
}

// What a header knows while it spells types: the module's own `pub struct`s, its `import`s of other modules and the
// `#include` lines the spelled types of those modules need (each once).
struct HeaderScope {
    ast::Identifier structs[:];
    const ast::Decl *imports[:];
    Str includes;
};

// The `import`ed module a path like `core.Thing` names (its path, or the alias of the import, spelled before the last
// segment), or null.
static const ast::Decl *imported_module(const ast::Path *path, HeaderScope *scope) {
    Usize n = countof(path->segments);
    for (Usize i = 0; i < countof(scope->imports); i++) {
        const ast::Decl *d = scope->imports[i];
        if (d->kind != .import_module) continue;
        Usize m = countof(d->kind.import_module.path.segments);
        if (countof(d->kind.import_module.alias) > 0) {
            if (n == 2 && roots::same(d->kind.import_module.alias, path->segments[0].text)) return d;
            continue;
        }
        if (m != n - 1) continue;
        Bool same = true;
        for (Usize k = 0; k < m; k++) {
            if (!roots::same(d->kind.import_module.path.segments[k].text, path->segments[k].text)) same = false;
        }
        if (same) return d;
    }
    return nullptr;
}

static Str path_joined(const ast::Path *path, Usize count, Str separator) {
    Str all = "";
    for (Usize i = 0; i < count; i++) {
        if (i > 0) all = as_str(format::push(all, separator));
        all = as_str(format::push(all, path->segments[i].text));
    }
    return all;
}

// `core.Thing` behind a pointer: the other module's struct under its C name, `core_Thing`, with the include of that
// module's header added to the scope; "" when no import names it.
static Str imported_spelling(const ast::TypeExpr *t, HeaderScope *scope) {
    if (t->kind != .named) return "";
    const ast::Path *path = &t->kind.named.path;
    const ast::Decl *module_import = imported_module(path, scope);
    if (module_import == nullptr || module_import->kind != .import_module) return "";
    const ast::Path *module_path = &module_import->kind.import_module.path;
    Usize count = countof(module_path->segments);
    Str include = as_str(format::push("#include \"", path_joined(module_path, count, "/"), ".h\"\n"));
    if (!contains(scope->includes, include)) scope->includes = as_str(format::push(scope->includes, include));
    return as_str(
        format::push(path_joined(module_path, count, "_"), "_", path->segments[countof(path->segments) - 1].text));
}

// The base of a chain of pointers: a scalar or one of the module's structs (by value only when no pointer is above it).
static Spelled spell_base(const ast::TypeExpr *t, HeaderScope *scope, Str prefix, Bool under_pointer) {
    Spelled none = {.text = "", .by_value = false, .suffix = ""};
    if (t->kind == .slice || t->kind == .block_type) return spell_dimensional(t);
    if (t->kind == .named && countof(t->kind.named.path.segments) > 1 && under_pointer) {
        Str imported = imported_spelling(t, scope);
        return (Spelled){.text = imported, .by_value = false, .suffix = ""};
    }
    Str name = named_once(t);
    if (countof(name) == 0) return none;
    Str scalar = scalar_spelling(name);
    if (countof(scalar) > 0) return (Spelled){.text = scalar, .by_value = false, .suffix = ""};
    if (!is_struct_name(name, scope->structs)) return none;
    if (!under_pointer) return (Spelled){.text = "", .by_value = true, .suffix = ""};
    return (Spelled){.text = as_str(format::push(prefix, name)), .by_value = false, .suffix = ""};
}

constexpr Usize pointer_depth_max = 8;

// The spelling of a type: `*T` is `const T *`, `*mut T` is `T *`, a pointer to a pointer `const T * const *` (a chain
// of at most 8 pointers, written as a loop).
static Spelled spell(const ast::TypeExpr *t, HeaderScope *scope, Str prefix) {
    Bool mutable_level[8] = {};
    Usize depth = 0;
    const ast::TypeExpr *at = t;
    for (Usize steps = 0; steps < pointer_depth_max; steps++) {
        const ast::TypeExpr *here = at;
        if (here->kind != .pointer || depth >= pointer_depth_max) break;
        mutable_level[depth] = here->kind.pointer.is_mut;
        depth += 1;
        at = here->kind.pointer.pointee;
    }
    Spelled base = spell_base(at, scope, prefix, depth > 0);
    if (countof(base.text) == 0) return base;
    Str text = base.text;
    for (Usize level = depth; level > 0; level--) {
        Bool is_mut = mutable_level[level - 1];
        Bool inner_pointer = level < depth;
        if (is_mut)
            text = as_str(format::push(text, " *"));
        else if (inner_pointer)
            text = as_str(format::push(text, " const *"));
        else
            text = as_str(format::push("const ", text, " *"));
    }
    return (Spelled){.text = text, .by_value = false, .suffix = "", .defs = base.defs};
}

// The spelling of a type that may be an array: `[4]i32` is `int32_t` with the suffix `[4]`, `[3][2]f32` is `float`
// with `[3][2]` (the outer size first, as C writes it). A size is an integer literal or constants of a header (see
// `length_text`); C has no array of a size it cannot read, and no array behind a pointer here.
static Str length_text(const ast::Expr *e, Str *binding);

// The sizes of the block type `t` as C array suffixes, added to `suffix` (and the bindings they name to `bindings`);
// false when one has no C spelling.
static Bool block_sizes(const ast::TypeExpr *t, Str *suffix, Str *bindings) {
    if (t->kind != .block_type) return false;
    ast::ExprRef dims[:] = t->kind.block_type.dims;
    for (Usize i = 0; i < countof(dims); i++) {
        Str binding = "";
        Str text = length_text(dims[i], &binding);
        if (countof(text) == 0) return false;
        if (countof(binding) > 0) *bindings = as_str(format::push(*bindings, binding, "\n"));
        *suffix = as_str(format::push(*suffix, "[", text, "]"));
    }
    return true;
}

static const ast::TypeExpr *block_element(const ast::TypeExpr *t) {
    if (t->kind != .block_type) return t;
    return t->kind.block_type.element;
}

// Whether the block type `[5, 64]T` has every size written, so it is a plain array of arrays in C.
static Bool block_is_sized(const ast::TypeExpr *t) {
    if (t->kind != .block_type) return false;
    ast::ExprRef dims[:] = t->kind.block_type.dims;
    for (Usize i = 0; i < countof(dims); i++) {
        if (dims[i] == nullptr) return false;
    }
    return countof(dims) > 0;
}

static Spelled spell_declarator(const ast::TypeExpr *t, HeaderScope *scope, Str prefix) {
    Str suffix = "";
    Str bindings = "";
    Usize depth = 0;
    const ast::TypeExpr *at = t;
    while ((at->kind == .array || block_is_sized(at)) && depth < pointer_depth_max) {
        if (block_is_sized(at)) { // `[5, 64]T` is `[5][64]T` (#2496)
            if (!block_sizes(at, &suffix, &bindings)) return (Spelled){.text = "", .by_value = false, .suffix = ""};
            depth += 1;
            at = block_element(at);
            continue;
        }
        const ast::TypeExpr *here = at;
        if (here->kind != .array) break;
        const ast::Expr *count = here->kind.array.count;
        Str binding = "";
        Str text = length_text(count, &binding);
        if (countof(text) == 0) return (Spelled){.text = "", .by_value = false, .suffix = ""};
        if (countof(binding) > 0) bindings = as_str(format::push(bindings, binding, "\n"));
        suffix = as_str(format::push(suffix, "[", text, "]"));
        depth += 1;
        at = here->kind.array.element;
    }
    Spelled base = spell(at, scope, prefix);
    if (countof(base.text) == 0 || depth == 0) return base;
    base.suffix = suffix;
    base.bindings = bindings;
    return base;
}

// One error of the header at `span`.
static Str header_error(Str path, Str source, ast::Span span, Str message) {
    return diagnostic(path, source, span, "error", message);
}

// The text of the type in a message: the source between its span's ends.
static Str source_of(Str source, ast::Span span) {
    if (span.end > countof(source) || span.start > span.end) return "";
    return source[span.start:span.end];
}

// The reason a type has no spelling: an option or a result has no C layout defined yet (its tag and payload follow the
// emitter's, not the old lowering's), any other type is just not spelled yet.
static Str no_spelling_reason(const ast::TypeExpr *t) {
    Bool optional = t->kind == .option;
    if (t->kind == .applied && countof(t->kind.applied.name.segments) == 1) {
        Str last = t->kind.applied.name.segments[0].text;
        optional = roots::same(last, "Option") || roots::same(last, "Result");
    }
    return optional ? ", whose C layout is not defined yet" : ", which has no C spelling in a header yet";
}

// The line of a `pub fn` in the header, or "" with a message in `*problems`.
static Str function_line(Str path, Str source, const ast::Decl *d, HeaderScope *scope, Str prefix, Str module_c,
                         Str module_label, Str label_start, Str *problems) {
    if (d->kind != .function) {
        return "";
    }
    ast::Param params[:] = d->kind.function.params;
    Str name = d->kind.function.name;
    Str args = "";
    Str needed = "";
    for (Usize i = 0; i < countof(params); i++) {
        Spelled spelled = spell_declarator(params[i].type, scope, prefix);
        if (countof(spelled.text) == 0) {
            Str message =
                spelled.by_value
                    ? as_str(format::push("`", name, "` takes `", source_of(source, params[i].type->span),
                                          "` by value; C passes a struct by value by the target's ABI, which the "
                                          "emitter does not follow yet: take `*",
                                          source_of(source, params[i].type->span), "`"))
                    : as_str(format::push("`", name, "` takes `", source_of(source, params[i].type->span), "`",
                                          no_spelling_reason(params[i].type)));
            *problems = as_str(format::push(*problems, header_error(path, source, params[i].span, message)));
            return "";
        }
        needed = as_str(format::push(needed, spelled.defs));
        Bool star = spelled.text[countof(spelled.text) - 1] == '*';
        args = as_str(
            format::push(args, i == 0 ? "" : ", ", spelled.text, star ? "" : " ", params[i].name, spelled.suffix));
    }
    Str result = "void";
    if (d->kind.function.result != nullptr) {
        Spelled spelled = spell(d->kind.function.result, scope, prefix);
        if (countof(spelled.text) == 0) {
            Str shown = source_of(source, d->kind.function.result->span);
            Str message = spelled.by_value
                              ? as_str(format::push("`", name, "` returns `", shown,
                                                    "` by value; C returns a struct by value by the target's ABI, "
                                                    "which the emitter does not follow yet: return it through a `*mut ",
                                                    shown, "` parameter"))
                              : as_str(format::push("`", name, "` returns `", shown, "`",
                                                    no_spelling_reason(d->kind.function.result)));
            *problems =
                as_str(format::push(*problems, header_error(path, source, d->kind.function.result->span, message)));
            return "";
        }
        result = spelled.text;
        needed = as_str(format::push(needed, spelled.defs));
    }
    Str own = header_c_name(d);
    Bool star = result[countof(result) - 1] == '*';
    Str c_name = as_str(format::push(module_c, "_", name));
    if (countof(own) > 0) c_name = own;
    if (countof(params) == 0) args = "void";
    Str separator = " ";
    if (star) separator = "";
    Str head = as_str(format::push(result, separator, c_name, "(", args, ")"));
    if (countof(own) > 0) return as_str(format::push(needed, head, ";\n"));
    return as_str(format::push(needed, head, " __asm__(\"", label_start, module_label, "::", name, "\");\n"));
}

// The header line of a `pub` global with a written type: `pub mut buf: [8]u8` is `extern uint8_t
// mod_buf[8] __asm__("mod::buf");` (`const` for a `pub const`), the array behind `array.filled` (#2339). Empty when it
// is not one; a type with no C spelling is a problem.
static Str variable_line(Str path, Str source, const ast::Decl *d, HeaderScope *scope, Str prefix, Str module_c,
                         Str module_label, Str label_start, Str *problems) {
    if (d->kind != .variable || !d->is_pub || !d->kind.variable.is_new || d->kind.variable.type == nullptr) return "";
    Str name = d->kind.variable.name;
    Spelled spelled = spell_declarator(d->kind.variable.type, scope, prefix);
    if (countof(spelled.text) == 0) {
        Str message = as_str(format::push("`", name, "` is `", source_of(source, d->kind.variable.type->span),
                                          "`, which has no C spelling in a header yet"));
        *problems = as_str(format::push(*problems, header_error(path, source, d->span, message)));
        return "";
    }
    Bool star = spelled.text[countof(spelled.text) - 1] == '*';
    Str constant = d->kind.variable.is_mut ? "" : "const ";
    return as_str(format::push(spelled.defs, "extern ", constant, spelled.text, star ? "" : " ", module_c, "_", name,
                               spelled.suffix, " __asm__(\"", label_start, module_label, "::", name, "\");\n"));
}

// `text` between `#if cond` and `#endif` when the declaration or field carries `@when(cond)` (#1801).
static Str guarded(ast::Attribute list[:], Str text, Bool own_lines) {
    const ast::Attribute *when_here = when::find(list);
    if (when_here == nullptr || countof(when_here->args) != 1) return text;
    Str condition = when::c_text(when_here->args[0]);
    if (countof(condition) == 0) return text;
    if (own_lines) return as_str(format::push("\n#if ", condition, "\n", text, "\n#endif\n"));
    return as_str(format::push("#if ", condition, "\n", text, "#endif\n"));
}

// The operator and operands of an expression that is a binary one, else false.
static Bool binary_of(const ast::Expr *e, ast::BinaryOp *op, const ast::Expr **left, const ast::Expr **right) {
    if (e == nullptr) return false;
    if (e->kind != .binary) return false;
    *op = e->kind.binary.op;
    *left = e->kind.binary.left;
    *right = e->kind.binary.right;
    return true;
}

// The C text of one operand of an array length: an integer, or a name a header binding gives (`k.SIDE` is `SIDE`, and
// `*binding` the binding's name). Empty when it has no C spelling (a constant of smith's own is no C name).
static Str length_leaf(const ast::Expr *e, Str *binding) {
    if (e == nullptr) return "";
    U64 literal = 0;
    if (types::integer_of(e, &literal)) return as_str(format::push(literal));
    ast::Path path = {};
    if (!types::names_a_constant(e, &path)) return "";
    if (countof(path.segments) != 2) return "";
    *binding = path.segments[0].text;
    return path.segments[1].text;
}

static Str length_operator(ast::BinaryOp op) {
    if (op == .add) return " + ";
    if (op == .subtract) return " - ";
    if (op == .multiply) return " * ";
    if (op == .divide) return " / ";
    return "";
}

// The C text of an array length: one operand, or two joined by `+ - * /`. Empty when it has no C spelling.
static Str length_text(const ast::Expr *e, Str *binding) {
    ast::BinaryOp operator = .add;
    const ast::Expr *first = nullptr;
    const ast::Expr *second = nullptr;
    if (binary_of(e, &operator, &first, &second)) {
        Str op = length_operator(operator);
        Str left = length_leaf(first, binding);
        Str right = length_leaf(second, binding);
        if (countof(op) == 0 || countof(left) == 0 || countof(right) == 0) return "";
        return as_str(format::push(left, op, right));
    }
    return length_leaf(e, binding);
}

// The `#include` lines for the header bindings (`k` of `import c "k.h"`) that array lengths used.
static Str length_includes(const ast::Module *m, Str bindings) {
    Str lines = "";
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind != .import_c) continue;
        Str name = d->kind.import_c.header;
        Usize begin = 0;
        Usize end = countof(name);
        for (Usize k = 0; k < countof(name); k++) {
            if (name[k] == '/') begin = k + 1;
        }
        for (Usize k = begin; k < countof(name); k++) {
            if (name[k] == '.') end = k;
        }
        Str binding = countof(d->kind.import_c.alias) > 0 ? d->kind.import_c.alias : name[begin:end];
        Bool used = false;
        Usize at = 0;
        while (at < countof(bindings)) {
            Usize stop = at;
            while (stop < countof(bindings) && bindings[stop] != '\n')
                stop += 1;
            if (roots::same(bindings[at:stop], binding)) used = true;
            at = stop + 1;
        }
        if (!used) continue;
        Str quote_open = d->kind.import_c.angled ? "<" : "\"";
        Str quote_close = d->kind.import_c.angled ? ">" : "\"";
        Str line = as_str(format::push("#include ", quote_open, name, quote_close, "\n"));
        lines = as_str(format::push(lines, guarded(d->attributes, line, false))); // an import under `@when` (#2142)
    }
    return lines;
}

// The header's text for the parsed module, or "" with the errors in `*problems`.
static Str header_text(Str path, Str source, const ast::Module *m, Str triple, Str *problems) {
    Str module_c = joined(m, "_");
    Str module_label = joined(m, "::");
    Str prefix = as_str(format::push(module_c, "_"));
    HeaderScope scope = {};
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind == .import_module) {
            scope.imports = mem::realloc(scope.imports, countof(scope.imports) + 1);
            scope.imports[countof(scope.imports) - 1] = d;
        }
        if (d->kind != .record || !d->is_pub) continue;
        scope.structs = mem::realloc(scope.structs, countof(scope.structs) + 1);
        scope.structs[countof(scope.structs) - 1] = (ast::Identifier){.text = d->kind.record.name};
    }
    Str type_declarations = "";
    Str used_bindings = "";
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind != .record || !d->is_pub) continue;
        Str fields = "";
        Str needed = "";
        for (Usize k = 0; k < countof(d->kind.record.fields); k++) {
            ast::FieldDecl field = d->kind.record.fields[k];
            Spelled spelled = spell_declarator(field.type, &scope, prefix);
            used_bindings = as_str(format::push(used_bindings, spelled.bindings));
            if (countof(spelled.text) == 0) {
                Str message = as_str(format::push("field `", field.name, "` of `", d->kind.record.name, "` is `",
                                                  source_of(source, field.type->span),
                                                  "`, which has no C spelling in a header yet"));
                *problems = as_str(format::push(*problems, header_error(path, source, field.span, message)));
                continue;
            }
            needed = as_str(format::push(needed, spelled.defs));
            Bool star = spelled.text[countof(spelled.text) - 1] == '*';
            Str one = as_str(format::push(spelled.text, star ? "" : " ", field.name, spelled.suffix, "; "));
            fields = as_str(format::push(fields, guarded(d->kind.record.fields[k].attributes, one, true)));
        }
        Str made = as_str(format::push("typedef struct { ", fields, "} ", prefix, d->kind.record.name, ";\n"));
        type_declarations = as_str(format::push(type_declarations, needed, guarded(d->attributes, made, false)));
    }
    Str body = "";
    Str label_start = label_prefix(triple);
    Usize count = 0;
    for (Usize i = 0; i < countof(m->decls); i++) {
        Str line =
            variable_line(path, source, m->decls[i], &scope, prefix, module_c, module_label, label_start, problems);
        if (countof(line) == 0) continue;
        body = as_str(format::push(body, count == 0 ? "" : "\n", guarded(m->decls[i]->attributes, line, false)));
        count += 1;
    }
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind != .function || !d->is_pub || d->kind.function.body == nullptr) continue;
        if (roots::same(d->kind.function.name, "main")) continue;
        Str line = function_line(path, source, d, &scope, prefix, module_c, module_label, label_start, problems);
        if (countof(line) == 0) continue;
        body = as_str(format::push(body, count == 0 ? "" : "\n", guarded(d->attributes, line, false)));
        count += 1;
    }
    if (countof(*problems) > 0) return "";
    Str gap = "";
    if (countof(type_declarations) > 0 && countof(body) > 0) gap = "\n";
    return as_str(
        format::push("// clang-format off\n// Generated by smith from ", path, ". Do not edit.\n// clang-format on\n",
                     "#pragma once\n#include <stddef.h>\n#include <stdint.h>\n", length_includes(m, used_bindings),
                     scope.includes, "#ifdef __cplusplus\n", "extern \"C\" {\n#endif\n", type_declarations, gap, body,
                     "#ifdef __cplusplus\n}\n#endif\n"));
}

// Writes `text` to `output` unless the file already holds those bytes. Returns an error text, empty when it worked.
static Str write_if_changed(Str output, Str text) {
    files::BytesResult old = files::read_file(output);
    if (old != .error) {
        format::Chars held = mem::view(old.ok, char);
        Str current = held;
        if (roots::same(current, text)) return "";
    }
    c::FILE *out = c::fopen(output.data, "w");
    if (out == nullptr) return as_str(format::push(output, ": error: cannot write the file\n"));
    Usize written = c::fwrite(text.data, 1, countof(text), out);
    Bool closed = c::fclose(out) == 0;
    if (written != countof(text) || !closed) return as_str(format::push(output, ": error: cannot write the file\n"));
    return "";
}

// Writes the C header of the module in `path` (smith's own syntax) to `output` for `triple` (empty: the default). The
// checker does not run: a header comes from the declarations alone. The file is written only when its bytes change.
export Report header(Str path, Str output, Str triple, roots::Roots folders) {
    Times times = {};
    files::BytesResult loaded = load(path);
    if (loaded != .ok) return failed(as_str(format::push(path, ": error: cannot read the file\n")), times);
    format::Chars chars = mem::view(loaded.ok, char);
    Str source = chars;
    if (starts_with_module(source))
        return failed(as_str(format::push(path, ": error: this file is in today's syntax; write its header without "
                                                "--front-end=new\n")),
                      times);
    U64 mark = clock::monotonic();
    parser::Parsed parsed = parser::parse_new(path, source);
    times.parse = clock::monotonic() - mark;
    if (countof(parsed.errors) > 0)
        return failed(as_str(format::push(lines_of(path, source, parsed.errors, "error"))), times);
    Str problem = name_compiled(&parsed.module, path, folders);
    if (countof(problem) > 0) return failed(as_str(format::push(problem, "\n")), times);
    Str wanted = triple;
    if (countof(wanted) == 0) {
        char *default_triple = c::LLVMGetDefaultTargetTriple();
        wanted = as_str(format::push((const char *)default_triple));
        c::LLVMDisposeMessage(default_triple);
    }
    Str problems = "";
    Str text = header_text(path, source, &parsed.module, wanted, &problems);
    if (countof(problems) > 0) return failed(problems, times);
    mark = clock::monotonic();
    Str written = write_if_changed(output, text);
    times.write = clock::monotonic() - mark;
    if (countof(written) > 0) return failed(written, times);
    return (Report){.ok = true, .text = "", .times = times};
}

// The driver's entry for `--smith-header`: one source, its header, the triple (null: the default). Diagnostics go to
// stderr.
[[std::c_name("front_header_run")]] export I32 run_header(const char *source, const char *output, const char *triple) {
    roots::Roots folders = roots::default_roots();
    Str target = "";
    if (triple != nullptr) target = as_str(format::push((const char *)triple));
    Str given = as_str(format::push((const char *)source));
    folders.local = folder_of(given);
    Report done = header(given, as_str(format::push((const char *)output)), target, folders);
    if (countof(done.text) > 0) report(done.text);
    return done.ok ? 0 : 1;
}
