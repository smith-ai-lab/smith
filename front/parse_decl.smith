// front::parse_decl, the declarations and whole files of smith's own front end (#1147, A5 of track A of #1112;
// internal, not wired into `smith cc`).
//
//   parse_decl::declaration(p)        one declaration: the hook `parse::Hooks.declaration` (A4 uses it for locals)
//   parse_decl::file(p, file)         a whole file: an optional `module x::y;`, then declarations to the end
//
// What it reads (types come from `parse::type`, initializers from `parse::expression`, bodies from `parse::statement`;
// the parser keeps no symbol table: a capitalized name is a type and any other a value):
//   * prefixes in any order: attributes (`[[std::pure]]`, `[[std::c_name("f")]]`), `export static extern inline
//     constexpr thread_local`;
//   * a variable: a type, ONE name, array suffixes after the name (`I32 xs[4]` is `array(I32, 4)`, `I32 xs[:]` a slice,
//     `I32 m[:][2]` a slice of arrays: the first suffix is the outermost), then `= init`;
//   * a function: a type, a name, parameters, then a body or `;`. A parameter is a type and a name (the name is
//     optional in a prototype) with array suffixes and attributes, `constexpr Type T` or `auto... rest`; `...` ends
//     the list of a variadic function; `()` and `(void)` are no parameters;
//   * records `struct Name { I32 x; U32 flags : 3; };` and `union`, and `typedef struct {...} Name;`; enums
//     `enum Color { red, green = 2 };`, `enum Small : U8 {...}` and payload enums `typedef enum { Circle circle;
//     empty; } Shape;`; `typedef T Name;`;
//   * `import std::arena;`, `import <stdio.h>;`, `import "x.h";`, `static_assert(c, "m");` and
//     `if constexpr (c) { decls } else { decls }`, which holds any declarations, imports included.
//
// The errors name the fix: a declaration with several names (`I32 a, b;`), C's function-pointer declarator
// (`I32 (*f)(I32)` is `Fn(I32 (I32)) f`), C's pointer to a slice (`T (*p)[:]` is `T[:] *p`), a K&R parameter list, a
// declaration with no type (implicit `int`), an array with no size, and a tag spelled as C does (`struct Point p;`).
// After an error the declaration is skipped to its `;` or its closing `}` and the parse goes on: it never aborts.
//
// Today's forms are warnings with fixes (F2 of #1428, #1507; `smith lint --fix` applies them): in a declaration of the
// file (never a local: `parse_stmt` owns those) `module a::b;` is removed, `export` is `pub`, `I32 a = 3;` is `a: I32 =
// 3`
// (`I32 a;` is `mut a: I32`, `auto a = 3;` is `let a = 3`, `constexpr I32 n = 3;` is `const n: I32 = 3`, `constexpr
// Type N = T;` and `typedef T N;` are `let N = T`), `R f(A a) {...}` is `fn f(a: A) -> R {...}` (`constexpr` removed,
// no `-> void`), a field `I32 x;` is `x: I32`, an enum member loses its `,` or `;` (a payload is `circle: Circle`),
// `typedef struct {...} N;` is `struct N {...}`, `};` is `}` and the attributes `[[nodiscard]]`, `[[maybe_unused]]` (a
// `_` prefix),
// `[[gnu::always_inline]]` (`@inline`), `[[gnu::noinline]]`, `[[gnu::cold]]`, `[[std::affine]]` and
// `[[std::c_name("f")]]` are `@name`. A form with no mechanical fix (a prototype, a parameter with no name, a qualified
// slice or `auto`, a bit-field, `extern`) is a warning with no edits; `I32 xs[3]` is `xs: [3]I32`. Types are copied as
// written: the fixes of `parse_type` mend them.
//
// Nothing here recurses: a nested `if constexpr` is read with an explicit stack of open blocks; nested types and
// bodies are the hooks'.
//
// An anonymous `struct { ... }` or `union { ... }` is a type (`TypeKind.record`): a payload variant, or the type of a
// variable. The types of its fields come from the type hook, so a record nested in one is the hook's to read.
module front::parse_decl;

import front::ast;
import front::lex;
import front::parse;
import front::parse_type;
import std::arena;
import std::format;
import std::mem;
import std::slice;

typedef ast::DeclRef DeclRefList[:];
typedef ast::ExprRef ExprRefList[:];
typedef ast::Param ParamList[:];
typedef ast::Identifier IdentifierList[:];
typedef ast::FieldDecl FieldList[:];
typedef ast::Enumerator EnumeratorList[:];

// What comes before a declaration's type: its attributes and keywords, in any order.
struct Prefixes {
    ast::Attribute attributes[:];
    Bool exported;
    Bool is_pub;
    Bool is_static;
    Bool is_extern;
    Bool is_inline;
    Bool is_constexpr;
    Bool is_thread_local;
    Bool top;            // a declaration of the file, not a local: only these carry fixes (locals are `parse_stmt`'s)
    U32 constexpr_start; // the `constexpr` token, and where the token after it starts (a fix deletes the span)
    U32 constexpr_end;
    U32 constexpr_after;
    Bool unused; // a lone `[[maybe_unused]]` group: the fix of the declaration deletes it and prefixes `_`
    U32 unused_start;
    U32 unused_after;
};

// Which spelling the members of a record or an enum used: the old (`I32 x;`, `red,`) or smith's own (`x: I32` and a
// member that ends with the line). A body with neither (`struct E {}`) takes the `;` of the old form or none.
struct Style {
    Bool saw_old;
    Bool saw_new;
    Bool top;     // the record or enum is a declaration of the file: its old members carry fixes
    Bool unfixed; // an old member that has no mechanical fix: the `;` after the `}` stays
};

// An open `if constexpr (c) { ... }`: the declarations read so far in each branch.
struct Frame {
    ast::Expr *condition;
    DeclRefList then_decls;
    DeclRefList else_decls;
    Bool in_else;
    Bool chained; // `else if constexpr`: the else branch is the one block that follows, and closes with it
    U32 start;
};

typedef Frame FrameList[:];

// An array suffix: `[N]` or `[:]`.
struct Suffix {
    Bool is_slice;
    ast::Expr *count;
    ast::Qualifiers qualifiers; // the slice's own, `U8 dst[restrict :]`
    ast::Span span;
};

// ---------------------------------------------------------------------------------------------------------------
// Small helpers

static DeclRefList push_decl(DeclRefList list, ast::Decl *item) {
    Usize n = countof(list);
    // Not mem::realloc: its instance for a pointer element draws the lint of a multilevel conversion.
    ast::DeclRef *block = (ast::DeclRef *)mem::alloc_array_raw(sizeof(ast::DeclRef), n + 1, alignof(ast::DeclRef));
    for (Usize i = 0; i < n; i++)
        block[i] = list[i];
    block[n] = item;
    DeclRefList grown = block[0:n + 1];
    return grown;
}

static ExprRefList push_expr(ExprRefList list, ast::Expr *item) {
    Usize n = countof(list);
    ast::ExprRef *block = (ast::ExprRef *)mem::alloc_array_raw(sizeof(ast::ExprRef), n + 1, alignof(ast::ExprRef));
    for (Usize i = 0; i < n; i++)
        block[i] = list[i];
    block[n] = item;
    ExprRefList grown = block[0:n + 1];
    return grown;
}

static Bool is_name(lex::TokenKind kind) {
    return kind == lex::name || kind == lex::type_name;
}

// A C keyword that names a type (`short`, `int`): a parameter cannot be named by one.
static Bool is_c_type_word(lex::TokenKind kind) {
    return kind == lex::kw_bool || kind == lex::kw_char || kind == lex::kw_double || kind == lex::kw_float ||
           kind == lex::kw_int || kind == lex::kw_long || kind == lex::kw_short || kind == lex::kw_signed ||
           kind == lex::kw_unsigned || kind == lex::kw_void;
}

static Bool take_tag_keyword(parse::Parser *p);

static Str source_between(const parse::Parser *p, U32 start, U32 end) {
    return p->source[start:end];
}

// The token after an identifier says a declaration was meant: `main() {`, `x = 3;`, `static x;`, `xs[4];`.
static Bool starts_untyped_declaration(const parse::Parser *p) {
    if (!parse::at(p, lex::name) || parse_type::call_type_ahead(p, 0)) return false;
    lex::TokenKind next = parse::peek_at(p, 1).kind;
    return next == lex::left_paren || next == lex::equal || next == lex::semicolon || next == lex::left_bracket;
}

// Skips to the end of the declaration that went wrong: past its `;` or the `}` that closes its body, or up to (not
// past) a `}` that closes something outside it.
static void recover(parse::Parser *p) {
    Usize depth = 0;
    while (!parse::at(p, lex::end_of_file)) {
        lex::TokenKind kind = parse::peek(p).kind;
        if (kind == lex::left_brace) {
            depth += 1;
        } else if (kind == lex::right_brace) {
            if (depth == 0) return;
            depth -= 1;
            if (depth == 0) {
                parse::advance(p);
                parse::accept(p, lex::semicolon);
                return;
            }
        } else if (kind == lex::semicolon && depth == 0) {
            parse::advance(p);
            return;
        }
        parse::advance(p);
    }
}

// Whether the token just taken ends its line.
static Bool line_ended(const parse::Parser *p) {
    return p->position > 0 && p->tokens[p->position - 1].line_break;
}

// The layout path (#1857): whether the position is at the `newline` that ends a line, the `dedent` that closes a block
// or the end of the file.
static Bool at_line_end(const parse::Parser *p) {
    return parse::at(p, lex::newline) || parse::at(p, lex::dedent) || parse::at(p, lex::end_of_file);
}

// Layout path: the `newline`s before a declaration, a field or a member.
static void skip_newlines(parse::Parser *p) {
    while (p->layout && parse::at(p, lex::newline))
        parse::advance(p);
}

// Layout path: skips to the `newline` or `dedent` that ends the line (not taken).
static void skip_to_line_end(parse::Parser *p) {
    while (!at_line_end(p))
        parse::advance(p);
}

// Layout path: the `newline` and `indent` that open the block after a `:`; false, with nothing taken, when the `:`
// ends the declaration with no block.
static Bool open_layout_block(parse::Parser *p) {
    if (!parse::at(p, lex::newline) || parse::peek_at(p, 1).kind != lex::indent) return false;
    parse::advance(p);
    parse::advance(p);
    return true;
}

// Skips to the end of the line of a declaration in smith's own syntax (the line break after a token outside any `{ }`),
// or up to a `}` that closes something outside it.
static void recover_line(parse::Parser *p) {
    Usize depth = 0;
    if (p->layout) {
        skip_to_line_end(p);
        return;
    }
    if (line_ended(p)) return;
    while (!parse::at(p, lex::end_of_file)) {
        lex::Token token = parse::peek(p);
        if (token.kind == lex::right_brace && depth == 0) return;
        if (token.kind == lex::left_brace) depth += 1;
        if (token.kind == lex::right_brace) depth -= 1;
        parse::advance(p);
        if (token.line_break && depth == 0) return;
    }
}

// The end of a declaration, field or enumerator in smith's own syntax: a line break (or the `}` or the end of the file
// that follows it). A `;` or a `,` is an error with a fix that removes it; anything else on the line is an error.
static void end_line(parse::Parser *p, Str what) {
    lex::Token token = parse::peek(p);
    if (token.kind == lex::semicolon || token.kind == lex::comma) {
        Str mark = token.kind == lex::semicolon ? ";" : ",";
        char message[:] = format::push("a ", what, " ends with the line, not `", mark, "`: remove it");
        parse::Edits edits = mem::alloc_slice(parse::Edit, 1);
        Str nothing = "";
        edits[0] = (parse::Edit){.span = token.span, .text = nothing};
        parse::error_fix(p, token.span, message, edits);
        parse::advance(p);
        return;
    }
    if (token.kind == lex::right_brace || token.kind == lex::end_of_file || line_ended(p)) {
        return;
    }
    if (p->layout && at_line_end(p)) return;
    // A value that ends in an indented block (`let r = do:` and its lines) ends with its `dedent`.
    if (p->layout && p->position > 0 && p->tokens[p->position - 1].kind == lex::dedent) return;
    char message[:] =
        format::push("a ", what, " is one line: expected a line break after it, found `", parse::text(p, token), "`");
    parse::error(p, token.span, message);
    recover_line(p);
}

static void skip_braces(parse::Parser *p);

// Skips to the end of the head of a function that went wrong, and the body when there is one.
static void skip_new_function(parse::Parser *p) {
    Usize depth = 0;
    while (!parse::at(p, lex::end_of_file)) {
        if (depth == 0 && parse::at(p, lex::left_brace)) {
            skip_braces(p);
            return;
        }
        lex::Token token = parse::advance(p);
        if (token.kind == lex::left_paren) depth += 1;
        if (token.kind == lex::right_paren && depth > 0) depth -= 1;
        if (token.line_break && depth == 0 && !parse::at(p, lex::left_brace)) return;
    }
}

// Layout path: skips the rest of a block whose `indent` was taken, to its `dedent` (taken).
static void skip_layout_body(parse::Parser *p) {
    Usize depth = 1;
    while (!parse::at(p, lex::end_of_file)) {
        lex::TokenKind kind = parse::advance(p).kind;
        if (kind == lex::indent) depth += 1;
        if (kind == lex::dedent) {
            depth -= 1;
            if (depth == 0) return;
        }
    }
}

// Skips a `{ ... }` already at the position, balanced.
static void skip_braces(parse::Parser *p) {
    Usize depth = 0;
    while (!parse::at(p, lex::end_of_file)) {
        lex::TokenKind kind = parse::advance(p).kind;
        if (kind == lex::left_brace) depth += 1;
        if (kind == lex::right_brace) {
            if (depth <= 1) return;
            depth -= 1;
        }
    }
}

// The text of a string token: the quotes and the prefix (`u8`, `u`, `U`, `L`) gone and C's simple escapes decoded.
static Str string_value(const parse::Parser *p, lex::Token token) {
    Str text = parse::text(p, token);
    Usize begin = 0;
    while (begin < countof(text) && text[begin] != '"')
        begin += 1;
    Usize end = countof(text);
    if (end > begin + 1 && text[end - 1] == '"') end -= 1;
    if (begin < end) begin += 1;
    Str body = text[begin:end];
    Bool escapes = false;
    for (Usize i = 0; i < countof(body); i++) {
        if (body[i] == '\\') escapes = true;
    }
    if (!escapes) {
        return body;
    }
    char decoded[:] = mem::alloc_slice(char, countof(body));
    Usize used = 0;
    for (Usize i = 0; i < countof(body); i++) {
        char c = body[i];
        if (c == '\\' && i + 1 < countof(body)) {
            i += 1;
            c = body[i];
            if (c == 'n') c = '\n';
            if (c == 't') c = '\t';
            if (c == 'r') c = '\r';
            if (c == '0') c = '\0';
        }
        decoded[used] = c;
        used += 1;
    }
    Str result = decoded[0:used];
    return result;
}

// Whether a text is the same as another.
static Bool same_text(Str a, Str b) {
    return countof(a) == countof(b) && (countof(a) == 0 || mem::equal(a, b));
}

// ---------------------------------------------------------------------------------------------------------------
// Fixes: each form of today's syntax that parses keeps its node and records a warning with the edits that write
// smith's own form (`smith lint --fix`). Only the declarations of a file carry them (`Prefixes.top`).

static Str as_str(char chars[:]) {
    return chars;
}

// The text without the white space at its ends.
static Str trimmed(Str text) {
    Usize from = 0;
    Usize to = countof(text);
    while (from < to && (text[from] == ' ' || text[from] == '\n' || text[from] == '\t'))
        from += 1;
    while (to > from && (text[to - 1] == ' ' || text[to - 1] == '\n' || text[to - 1] == '\t'))
        to -= 1;
    return text[from:to];
}

static parse::Edit edit(U32 start, U32 end, Str text) {
    ast::Span span = {.start = start, .end = end};
    return (parse::Edit){.span = span, .text = text};
}

static parse::Edits with_edit(parse::Edits edits, parse::Edit item) {
    edits = mem::realloc(edits, countof(edits) + 1);
    edits[countof(edits) - 1] = item;
    return edits;
}

static void warn(parse::Parser *p, U32 start, U32 end, Str message, parse::Edits edits) {
    ast::Span span = {.start = start, .end = end};
    parse::warning_fix(p, span, message, edits);
}

static Bool starts_with(Str text, Str prefix) {
    if (countof(text) < countof(prefix)) return false;
    return same_text(text[0:countof(prefix)], prefix);
}

// What one `[[...]]` attribute is in smith's own syntax: `@name`, nothing, or a `_` prefix on the name.
struct Mapped {
    Bool known;
    Bool unused;
    Str text;
};

static Mapped map_attribute(Str inner) {
    Mapped result = {};
    Str word = trimmed(inner);
    result.known = true;
    if (same_text(word, "nodiscard")) return result;
    if (same_text(word, "maybe_unused")) {
        result.unused = true;
        return result;
    }
    if (same_text(word, "gnu::always_inline")) {
        result.text = "@inline";
    } else if (same_text(word, "gnu::noinline")) {
        result.text = "@noinline";
    } else if (same_text(word, "gnu::cold")) {
        result.text = "@cold";
    } else if (same_text(word, "std::affine")) {
        result.text = "@affine";
    } else if (starts_with(word, "std::c_name(")) {
        result.text = as_str(format::push("@c_name(", word[12:countof(word)]));
    } else {
        result.known = false;
    }
    return result;
}

// The name of a declaration with its `[[maybe_unused]]` written as a prefix.
static Str named(const Prefixes *pre, Str name) {
    if (!pre->unused) return name;
    return as_str(format::push("_", name));
}

static parse::Edits with_unused(const Prefixes *pre, parse::Edits edits) {
    if (!pre->unused) return edits;
    return with_edit(edits, edit(pre->unused_start, pre->unused_after, ""));
}

// The group `[[...]]` just read, from `start`: a warning that writes it as `@name` (or removes it), or for a lone
// `[[maybe_unused]]` a note for the declaration. A `[[gnu::x]]` is an error already: the fix goes on that error.
static void fix_attribute_group(parse::Parser *p, Prefixes *pre, U32 start, Usize errors_before) {
    U32 end = p->tokens[p->position - 1].span.end;
    if (end < start + 4) return;
    Str inner = p->source[start + 2:end - 2];
    Mapped mapped = map_attribute(inner);
    if (!mapped.known) return;
    U32 after = parse::peek(p).span.start;
    if (mapped.unused) {
        pre->unused = true;
        pre->unused_start = start;
        pre->unused_after = after;
        return;
    }
    parse::Edits edits = {};
    if (countof(mapped.text) == 0) {
        edits = with_edit(edits, edit(start, after, ""));
    } else {
        edits = with_edit(edits, edit(start, end, mapped.text));
    }
    if (countof(p->errors) == errors_before + 1) {
        p->errors[errors_before].fix = edits;
        return;
    }
    Str word = trimmed(inner);
    char message[:] = format::push("`[[", word, "]]` is written `", mapped.text, "`");
    if (countof(mapped.text) == 0) message = format::push("`[[", word, "]]` is removed: delete it");
    warn(p, start, end, message, edits);
}

// A path `a::b::c` (a name or a type name for each segment).
static ast::Path parse_path(parse::Parser *p, Str what) {
    ast::Path path = {};
    U32 start = parse::peek(p).span.start;
    while (!parse::at(p, lex::end_of_file)) {
        lex::Token token = parse::peek(p);
        // `[[std::inline]]`: after `std::` the keyword is the attribute's name.
        Bool std_inline =
            token.kind == lex::kw_inline && countof(path.segments) == 1 && same_text(path.segments[0].text, "std");
        if (!is_name(token.kind) && !std_inline) {
            parse::expect(p, lex::name, what);
            break;
        }
        parse::advance(p);
        path.segments = mem::realloc(path.segments, countof(path.segments) + 1);
        path.segments[countof(path.segments) - 1] =
            (ast::Identifier){.text = parse::text(p, token), .span = token.span};
        if (!parse::accept(p, lex::colon_colon)) break;
    }
    path.span = parse::span_from(p, start);
    return path;
}

// ---------------------------------------------------------------------------------------------------------------
// Prefixes and attributes

// A `[[gnu::x]]` is not Smith's: the error names `[[std::x]]` where the std set has `x`, else says there is none.
static void reject_gnu_attribute(parse::Parser *p, ast::Path name) {
    if (countof(name.segments) != 2 || !same_text(name.segments[0].text, "gnu")) return;
    Str word = name.segments[1].text;
    Str std_word = word;
    if (same_text(word, "always_inline")) std_word = "inline";
    if (same_text(word, "pure") || same_text(word, "always_inline") || same_text(word, "noinline") ||
        same_text(word, "cold")) {
        char message[:] = format::push("`[[gnu::", word, "]]` is not part of Smith; use `[[std::", std_word, "]]`");
        parse::error(p, name.span, message);
        return;
    }
    char message[:] =
        format::push("`[[gnu::", word, "]]` is not part of Smith and `[[std::", word, "]]` is not available yet");
    parse::error(p, name.span, message);
}

// The GNU attribute names that have a `[[std::]]` spelling: the GNU name and the `std` one. One table (#1348).
static Str gnu_to_std(Str word) {
    if (same_text(word, "pure") || same_text(word, "__pure__")) return "pure";
    if (same_text(word, "always_inline") || same_text(word, "__always_inline__")) return "inline";
    if (same_text(word, "noinline") || same_text(word, "__noinline__")) return "noinline";
    if (same_text(word, "cold") || same_text(word, "__cold__")) return "cold";
    return "";
}

// A GNU `__attribute__((a, b(1)))` is not Smith's: one error per attribute name (the first word of each), at the
// name, then the group is skipped. False when the position is not at `__attribute__`.
static Bool reject_gnu_spelling(parse::Parser *p) {
    lex::Token head = parse::peek(p);
    if (head.kind != lex::name || !same_text(parse::text(p, head), "__attribute__")) return false;
    parse::advance(p);
    Usize depth = 0;
    Bool at_name = false;
    while (!parse::at(p, lex::end_of_file)) {
        lex::Token token = parse::peek(p);
        parse::advance(p);
        if (token.kind == lex::left_paren) {
            depth += 1;
            at_name = depth == 2;
            continue;
        }
        if (token.kind == lex::right_paren) {
            if (depth <= 1) break;
            depth -= 1;
            continue;
        }
        if (token.kind == lex::comma && depth == 2) {
            at_name = true;
            continue;
        }
        if (at_name && depth == 2) {
            Str word = parse::text(p, token);
            Str std_word = gnu_to_std(word);
            char message[:] = format::push("there is no Smith spelling of `", word, "` yet");
            if (countof(std_word) > 0)
                message = format::push("`__attribute__` is a C extension: write `[[std::", std_word, "]]`");
            parse::error(p, token.span, message);
        }
        at_name = false;
    }
    return true;
}

// One `[[a, b::c(args)]]` group (the position is at its first `[`).
static void parse_attribute_group(parse::Parser *p, Prefixes *out) {
    U32 group_start = parse::peek(p).span.start;
    Usize errors_before = countof(p->errors);
    parse::advance(p);
    parse::advance(p);
    while (!parse::at(p, lex::end_of_file)) {
        U32 start = parse::peek(p).span.start;
        ast::Attribute attribute = {};
        attribute.name = parse_path(p, "an attribute name");
        reject_gnu_attribute(p, attribute.name);
        if (parse::accept(p, lex::left_paren)) {
            while (!parse::at(p, lex::right_paren) && !parse::at(p, lex::end_of_file)) {
                ast::Expr *argument = parse::expression(p);
                if (argument == nullptr) break;
                attribute.args = push_expr(attribute.args, argument);
                if (!parse::accept(p, lex::comma)) break;
            }
            parse::expect(p, lex::right_paren, "`)`");
        }
        attribute.span = parse::span_from(p, start);
        out->attributes = mem::realloc(out->attributes, countof(out->attributes) + 1);
        out->attributes[countof(out->attributes) - 1] = attribute;
        if (!parse::accept(p, lex::comma)) break;
    }
    parse::expect(p, lex::right_bracket, "`]`");
    parse::expect(p, lex::right_bracket, "`]`");
    if (out->top) fix_attribute_group(p, out, group_start, errors_before);
}

// The attribute name after `@`: a name, or a keyword that is also an attribute (`@inline`).
static Bool at_attribute_name(const parse::Parser *p) {
    lex::TokenKind kind = parse::peek(p).kind;
    return is_name(kind) || lex::is_keyword(kind);
}

// One argument of an attribute: `value`, or `name = value` (a named argument, as in a call).
static ast::Expr *parse_attribute_argument(parse::Parser *p) {
    if (!parse::at(p, lex::name) || parse::peek_at(p, 1).kind != lex::equal) return parse::expression(p);
    lex::Token name = parse::advance(p);
    parse::advance(p);
    ast::Expr *value = parse::expression(p);
    if (value == nullptr) return nullptr;
    ast::Expr *node = mem::alloc(ast::Expr);
    node->span = parse::span_from(p, name.span.start);
    node->kind = {.named_arg = {.name = parse::text(p, name), .value = value}};
    return node;
}

// Whether the text between two tokens has a blank line or a comment.
static Bool gap_is_not_plain(Str gap) {
    Usize breaks = 0;
    for (Usize i = 0; i < countof(gap); i++) {
        if (gap[i] == '\n') breaks += 1;
        if (gap[i] == '/' && i + 1 < countof(gap) && (gap[i + 1] == '/' || gap[i + 1] == '*')) return true;
    }
    return breaks > 1;
}

// An attribute that ends its line marks the declaration on the next line: not a blank line, a comment, or the end of
// the block.
static void check_attribute_target(parse::Parser *p, ast::Span span) {
    if (!line_ended(p) && !(p->layout && at_line_end(p))) return;
    lex::Token last = p->tokens[p->position - 1];
    Usize ahead = 0;
    while (p->layout && parse::peek_at(p, ahead).kind == lex::newline) // layout path: the line break is a token
        ahead += 1;
    lex::Token next = parse::peek_at(p, ahead);
    Bool ends = next.kind == lex::right_brace || next.kind == lex::end_of_file || next.kind == lex::dedent;
    if (!ends && !gap_is_not_plain(p->source[last.span.end:next.span.start])) return;
    parse::error(p, span, "an attribute marks the declaration on the next line");
}

// `@x()` with nothing between the parentheses: a warning whose fix drops the `()` (#1813).
static void warn_empty_call(parse::Parser *p, U32 open) {
    U32 end = parse::span_from(p, open).end;
    parse::Edits fix = with_edit(mem::alloc_slice(parse::Edit, 0), edit(open, end, ""));
    warn(p, open, end, "an attribute without arguments is written without `()`: drop them", fix);
}

// One `@name` or `@name(args)` (smith's own spelling; the position is at the `@`). A name may be qualified
// (`@serial::rename("id")`).
static void parse_at_attribute(parse::Parser *p, Prefixes *out) {
    U32 start = parse::advance(p).span.start;
    ast::Attribute attribute = {.is_new = true};
    if (!at_attribute_name(p)) {
        parse::error(p, parse::peek(p).span, "an attribute has a name: write `@inline` or `@c_name(\"f\")`");
        return;
    }
    lex::Token name = parse::advance(p);
    attribute.name.segments = mem::alloc_slice(ast::Identifier, 1);
    attribute.name.segments[0] = (ast::Identifier){.text = parse::text(p, name), .span = name.span};
    attribute.name.span = name.span;
    while ((parse::at(p, lex::colon_colon) || parse::at(p, lex::dot)) && is_name(parse::peek_at(p, 1).kind)) {
        lex::Token separator = parse::advance(p);
        if (separator.kind == lex::colon_colon) parse::warn_separator(p, separator);
        lex::Token part = parse::advance(p);
        Usize count = countof(attribute.name.segments);
        attribute.name.segments = mem::realloc(attribute.name.segments, count + 1);
        attribute.name.segments[count] = (ast::Identifier){.text = parse::text(p, part), .span = part.span};
        attribute.name.span = parse::span_from(p, name.span.start);
    }
    if (parse::at(p, lex::left_paren)) {
        U32 open = parse::advance(p).span.start;
        while (!parse::at(p, lex::right_paren) && !parse::at(p, lex::end_of_file)) {
            ast::Expr *argument = parse_attribute_argument(p);
            if (argument == nullptr) break;
            attribute.args = push_expr(attribute.args, argument);
            if (!parse::accept(p, lex::comma)) break;
        }
        Bool empty = countof(attribute.args) == 0 && parse::at(p, lex::right_paren);
        parse::expect(p, lex::right_paren, "`)` after the attribute's arguments");
        if (empty) warn_empty_call(p, open);
    }
    attribute.span = parse::span_from(p, start);
    out->attributes = mem::realloc(out->attributes, countof(out->attributes) + 1);
    out->attributes[countof(out->attributes) - 1] = attribute;
    check_attribute_target(p, attribute.span);
}

static Bool at_attribute(const parse::Parser *p) {
    return parse::at(p, lex::left_bracket) && parse::peek_at(p, 1).kind == lex::left_bracket;
}

// Sets the flag a prefix keyword stands for; false for any other token.
static Bool take_prefix_keyword(Prefixes *pre, lex::TokenKind kind) {
    switch (kind) {
    case lex::kw_export:
        pre->exported = true;
        return true;
    case lex::kw_pub:
        pre->is_pub = true;
        return true;
    case lex::kw_static:
        pre->is_static = true;
        return true;
    case lex::kw_extern:
        pre->is_extern = true;
        return true;
    case lex::kw_inline:
        pre->is_inline = true;
        return true;
    case lex::kw_constexpr:
        pre->is_constexpr = true;
        return true;
    case lex::kw_thread_local:
        pre->is_thread_local = true;
        return true;
    default:
        return false;
    }
}

// Attributes and keywords before the type, in any order.
static Prefixes parse_prefixes(parse::Parser *p, Bool top) {
    Prefixes pre = {.top = top};
    while (!parse::at(p, lex::end_of_file)) {
        lex::TokenKind kind = parse::peek(p).kind;
        if (at_attribute(p)) {
            parse_attribute_group(p, &pre);
            continue;
        }
        if (kind == lex::at) {
            parse_at_attribute(p, &pre);
            skip_newlines(p); // layout path: an attribute on a line of its own
            continue;
        }
        if (reject_gnu_spelling(p)) continue;
        if (top && kind == lex::kw_export) {
            ast::Span word = parse::peek(p).span;
            parse::Edits edits = {};
            edits = with_edit(edits, edit(word.start, word.end, "pub"));
            warn(p, word.start, word.end, "`export` is written `pub`", edits);
        }
        if (top && kind == lex::kw_constexpr) {
            ast::Span word = parse::peek(p).span;
            pre.constexpr_start = word.start;
            pre.constexpr_end = word.end;
            pre.constexpr_after = parse::peek_at(p, 1).span.start;
        }
        if (!take_prefix_keyword(&pre, kind)) break;
        parse::advance(p);
    }
    return pre;
}

static ast::Decl *make(const parse::Parser *p, U32 start, const Prefixes *pre, ast::DeclKind kind) {
    ast::Decl d = {.span = parse::span_from(p, start),
                   .attributes = pre->attributes,
                   .exported = pre->exported,
                   .is_pub = pre->is_pub,
                   .is_static = pre->is_static,
                   .is_extern = pre->is_extern,
                   .is_inline = pre->is_inline};
    d.kind = kind;
    return ast::new_decl(d);
}

// ---------------------------------------------------------------------------------------------------------------
// Declarators: array suffixes and the errors of C's declarator forms

// `[N]` and `[:]` after a name wrap the type, the first being the outermost: `I32 m[:][2]` is a slice of arrays of 2.
static ast::TypeExpr *array_suffixes(parse::Parser *p, ast::TypeExpr *type) {
    Suffix suffixes[8];
    Usize count = 0;
    while (parse::at(p, lex::left_bracket) && !at_attribute(p)) {
        U32 start = parse::peek(p).span.start;
        Suffix suffix = {};
        if (parse_type::at_bad_slice_qualifier(p)) {
            parse_type::bad_slice_qualifier(p);
            suffix.is_slice = true;
            suffix.span = parse::span_from(p, start);
            if (count < 8) {
                suffixes[count] = suffix;
                count += 1;
            }
            continue;
        }
        if (parse_type::at_slice(p)) {
            parse_type::take_slice(p, &suffix.qualifiers);
            suffix.is_slice = true;
            Bool carries = suffix.qualifiers.is_const || suffix.qualifiers.is_restrict;
            if (carries && count > 0) {
                Str message = "a qualifier of a slice goes in the first bracket: write `F32 m[const :][:]`";
                parse::error(p, parse::span_from(p, start), message);
            }
            suffix.span = parse::span_from(p, start);
            if (count < 8) {
                suffixes[count] = suffix;
                count += 1;
            } else {
                parse::error(p, suffix.span, "at most 8 array dimensions");
            }
            continue;
        }
        parse::advance(p);
        if (parse::accept(p, lex::colon)) {
            suffix.is_slice = true;
        } else if (parse::at(p, lex::right_bracket)) {
            Str message = "an array needs a size: write `[N]`, or `[:]` for a slice";
            parse::error(p, parse::peek(p).span, message);
        } else {
            suffix.count = parse::expression(p);
        }
        parse::expect(p, lex::right_bracket, "`]`");
        suffix.span = parse::span_from(p, start);
        if (count < 8) {
            suffixes[count] = suffix;
            count += 1;
        } else {
            parse::error(p, suffix.span, "at most 8 array dimensions");
        }
    }
    ast::TypeExpr *wrapped = type;
    for (Usize i = count; i > 0 && wrapped != nullptr; i--) {
        Suffix suffix = suffixes[i - 1];
        ast::Span span = {.start = type->span.start, .end = suffix.span.end};
        ast::TypeKind kind = {.array = {.element = wrapped, .count = suffix.count}};
        if (suffix.is_slice) kind = {.slice = {.element = wrapped}};
        wrapped = ast::new_type((ast::TypeExpr){.span = span, .kind = kind, .qualifiers = suffix.qualifiers});
    }
    return wrapped;
}

static Str type_text(const parse::Parser *p, const ast::TypeExpr *type) {
    return source_between(p, type->span.start, type->span.end);
}

// `T (*p)[:]` or `T (*p)[4]`: the position is at the `(`. A pointer to a slice is written `T[:] *p` (A7i, #1344) and a
// pointer to an array `T[4] *p` (A7u, #1390); says so with the
// type, the stars, the name and the brackets as written, and skips the declarator.
static void slice_pointer_error(parse::Parser *p, const ast::TypeExpr *type) {
    U32 start = parse::peek(p).span.start;
    parse::advance(p);
    U32 stars_start = parse::peek(p).span.start;
    while (parse::accept(p, lex::star)) {
    }
    U32 stars_end = parse::peek(p).span.start;
    Str stars = source_between(p, stars_start, stars_end);
    Str name = "";
    if (is_name(parse::peek(p).kind)) name = parse::text(p, parse::advance(p));
    parse::accept(p, lex::right_paren);
    U32 brackets_start = parse::peek(p).span.start;
    U32 brackets_end = brackets_start;
    Bool is_slice = parse_type::slice_bracket_at(p, 0);
    while (parse::at(p, lex::left_bracket)) {
        while (!parse::at(p, lex::right_bracket) && !parse::at(p, lex::end_of_file))
            parse::advance(p);
        brackets_end = parse::advance(p).span.end;
    }
    Str brackets = source_between(p, brackets_start, brackets_end);
    // The span of a C keyword type (`char`) leaves out its `const`; the replacement keeps it.
    Str const_word = "const";
    Str text = type_text(p, type);
    Bool spelled = countof(text) >= countof(const_word) && mem::equal(text[0:countof(const_word)], const_word);
    Str lead = type->qualifiers.is_const && !spelled ? "const " : "";
    Str kind = is_slice ? "a slice" : "an array";
    char message[:] = format::push("a pointer to ", kind, " is written `", lead, text, brackets, " ", stars, name,
                                   "`, not `", lead, text, " (", stars, name, ")", brackets, "`");
    parse::error(p, parse::span_from(p, start), message);
}

// `I32 (*f)(I32)`: the position is at the `(` after the type. Says what to write and skips the rest.
static void fn_pointer_error(parse::Parser *p, const ast::TypeExpr *type) {
    if (parse_type::at_slice_pointer_declarator(p)) {
        slice_pointer_error(p, type);
        return;
    }
    U32 start = parse::peek(p).span.start;
    parse::advance(p);
    while (parse::accept(p, lex::star)) {
    }
    Str name = "f";
    if (is_name(parse::peek(p).kind)) {
        name = parse::text(p, parse::advance(p));
    }
    parse::accept(p, lex::right_paren);
    Str params = "";
    if (parse::at(p, lex::left_paren)) {
        U32 open = parse::advance(p).span.end;
        Usize depth = 1;
        U32 close = open;
        while (depth > 0 && !parse::at(p, lex::end_of_file)) {
            lex::Token token = parse::advance(p);
            if (token.kind == lex::left_paren) depth += 1;
            if (token.kind == lex::right_paren) depth -= 1;
            close = token.span.start;
        }
        params = source_between(p, open, close);
    }
    char message[:] = format::push("C's function-pointer declarator is gone: write `Fn(", type_text(p, type), " (",
                                   params, ")) ", name, "` (a function value is `Fn(F)` everywhere)");
    parse::error(p, parse::span_from(p, start), message);
}

// `I32 a, b;`: the position is at the first `,`. Names the fix and skips the rest.
static void several_names_error(parse::Parser *p, const ast::TypeExpr *type, Str first) {
    U32 start = parse::peek(p).span.start;
    Str second = "b";
    if (is_name(parse::peek_at(p, 1).kind)) {
        second = parse::text(p, parse::peek_at(p, 1));
    }
    char message[:] = format::push("one name per declaration: write `", type_text(p, type), " ", first, ";` and `",
                                   type_text(p, type), " ", second, ";`");
    parse::error(p, parse::span_from(p, start), message);
    recover(p);
}

// ---------------------------------------------------------------------------------------------------------------
// Functions and variables

static ast::TypeExpr *auto_type(ast::Span span) {
    ast::TypeExpr node = {.span = span};
    node.kind = .auto_type;
    return ast::new_type(node);
}

// A parameter, from after the `(` or a `,`.
static ast::Param parse_param(parse::Parser *p) {
    ast::Param param = {};
    U32 start = parse::peek(p).span.start;
    Prefixes pre = {};
    while (at_attribute(p))
        parse_attribute_group(p, &pre);
    param.is_constexpr = parse::accept(p, lex::kw_constexpr);
    if (parse::at(p, lex::kw_auto) && parse::peek_at(p, 1).kind == lex::ellipsis) {
        ast::Span span = parse::advance(p).span;
        parse::advance(p);
        param.type = auto_type(span);
        param.is_rest = true;
    } else if (parse::at(p, lex::name) &&
               (parse::peek_at(p, 1).kind == lex::comma || parse::peek_at(p, 1).kind == lex::right_paren)) {
        Str name = parse::text(p, parse::peek(p));
        char message[:] = format::push("a parameter list without types (K&R) is gone: write the type of `", name,
                                       "`, as in `I32 f(I32 ", name, ")`");
        parse::error(p, parse::peek(p).span, message);
        while (!parse::at(p, lex::right_paren) && !parse::at(p, lex::end_of_file)) {
            parse::advance(p);
        }
        return param;
    } else if (take_tag_keyword(p)) {
        param.type = parse::type(p);
    }
    if (param.type == nullptr) return param;
    if (parse_type::at_slice_pointer_declarator(p)) {
        slice_pointer_error(p, param.type);
        return param;
    }
    lex::TokenKind named = parse::peek(p).kind;
    if (is_c_type_word(named)) {
        lex::Token word = parse::advance(p);
        char message[:] = format::push("the C keyword `", parse::text(p, word), "` cannot name a parameter");
        parse::error(p, word.span, message);
        param.span = parse::span_from(p, start);
        return param;
    }
    Str type_word = "Type";
    // `Type T` without `constexpr` reads like the one with it (is_constexpr false); the checker reports it (N1, #1339).
    Bool type_param = named == lex::type_name && mem::equal(type_text(p, param.type), type_word);
    if (named == lex::name || type_param || (param.is_constexpr && named == lex::type_name) ||
        (param.is_rest && is_name(named)))
        param.name = parse::text(p, parse::advance(p));
    if (param.is_rest && countof(param.name) == 0) parse::expect(p, lex::name, "a name after `auto...`");
    param.type = array_suffixes(p, param.type);
    while (at_attribute(p))
        parse_attribute_group(p, &pre);
    param.attributes = pre.attributes;
    param.span = parse::span_from(p, start);
    return param;
}

// The parameters after a function's name, the position at the `(`; the `)` is taken.
static ParamList parse_params(parse::Parser *p, Bool *variadic) {
    parse::advance(p);
    ParamList params = {};
    if (parse::at(p, lex::kw_void) && parse::peek_at(p, 1).kind == lex::right_paren) parse::advance(p);
    while (!parse::at(p, lex::right_paren) && !parse::at(p, lex::end_of_file)) {
        if (parse::accept(p, lex::ellipsis)) {
            *variadic = true;
            break;
        }
        Usize before = p->position;
        ast::Param param = parse_param(p);
        params = mem::realloc(params, countof(params) + 1);
        params[countof(params) - 1] = param;
        if (!parse::accept(p, lex::comma)) break;
        if (p->position == before) break;
    }
    parse::expect(p, lex::right_paren, "`)`");
    return params;
}

static Bool at_anonymous_record(const parse::Parser *p);
static ast::TypeExpr *parse_anonymous_record(parse::Parser *p);

// The token after the path that follows the tag keyword at the position: `Name`, `a::B`, `c::stat`.
static lex::Token after_tag_path(const parse::Parser *p) {
    Usize at = 1;
    for (Usize step = 0; step < 64; step++) {
        if (!is_name(parse::peek_at(p, at).kind)) break;
        if (parse::peek_at(p, at + 1).kind != lex::colon_colon) return parse::peek_at(p, at + 1);
        at += 2;
    }
    return parse::peek_at(p, at);
}

// Whether the tag keyword at the position starts a use of the type (`struct Pair a = {...};`, `struct c::stat info;`),
// not the declaration of the type by itself (`struct Pair {...};`, `struct Pair;`, `enum Small : U8 {...}`).
static Bool at_tag_use(const parse::Parser *p) {
    lex::TokenKind kind = parse::peek(p).kind;
    if (kind != lex::kw_struct && kind != lex::kw_union && kind != lex::kw_enum) return false;
    if (!is_name(parse::peek_at(p, 1).kind)) return false;
    lex::TokenKind next = after_tag_path(p).kind;
    // the layout path: `enum Small(u8):`, and `struct Name` alone on its line
    if (next == lex::left_paren && kind == lex::kw_enum) return false;
    if (next == lex::newline || next == lex::dedent) return false;
    return next != lex::left_brace && next != lex::semicolon && next != lex::colon;
}

// `struct Pair` as the type of a variable, field or parameter: the keyword is dropped and the type is the name that
// follows (a tag is a type name). A lowercase name alone is a C tag, which is written `struct c::stat`. False after
// an error.
static Bool take_tag_keyword(parse::Parser *p) {
    if (!at_tag_use(p)) return true;
    lex::Token keyword = parse::advance(p);
    lex::Token name = parse::peek(p);
    Bool plain = parse::peek_at(p, 1).kind != lex::colon_colon;
    if (name.kind == lex::name && plain) {
        Str tag = parse::text(p, name);
        Str word = parse::text(p, keyword);
        char message[:] = format::push("`", word, " ", tag, "` names a C tag; write `", word, " c::", tag, "`");
        parse::error(p, name.span, message);
        return false;
    }
    return true;
}

// The type of a variable or function: `auto`, an anonymous record, or the type hook's.
static ast::TypeExpr *declared_type(parse::Parser *p) {
    if (parse::at(p, lex::kw_auto)) return auto_type(parse::advance(p).span);
    if (at_anonymous_record(p)) return parse_anonymous_record(p);
    if (!take_tag_keyword(p)) return nullptr;
    return parse::type(p);
}

static Bool failed_since(const parse::Parser *p, Usize errors_before) {
    return countof(p->errors) > errors_before;
}

// After an error in the parameters (the `)` is taken): skips the K&R declarations that may follow and the body, or the
// `;` of a prototype.
static void skip_function(parse::Parser *p) {
    if (!parse::at(p, lex::left_brace) && !parse::at(p, lex::semicolon)) {
        while (!parse::at(p, lex::left_brace) && !parse::at(p, lex::end_of_file)) {
            parse::advance(p);
        }
    }
    if (parse::at(p, lex::left_brace)) {
        skip_braces(p);
    } else {
        parse::accept(p, lex::semicolon);
    }
}

// Where a variable's or function's type starts and its name.
struct Head {
    U32 type_start;
    lex::Token name;
};

// The array suffixes after a parameter's name, `xs[3]` or `m[:][2]`: the tokens `at` to `to` lose them, the new end
// comes back (0 when a suffix has no fix: `[]`, `[const :]`) and `dims` is the same suffixes as smith writes them in
// front of the type, the first one outermost: `[3]`, `[][2]`.
static Usize strip_suffixes(const parse::Parser *p, Usize at, Usize to, Str *dims) {
    Str none = "";
    *dims = none;
    for (Usize guard = 0; guard < 8 && to > at + 2 && p->tokens[to - 1].kind == lex::right_bracket; guard++) {
        Usize open = to - 1;
        while (open > at && p->tokens[open].kind != lex::left_bracket)
            open -= 1;
        if (p->tokens[open].kind != lex::left_bracket || open <= at + 1) return 0;
        Str inner = trimmed(source_between(p, p->tokens[open].span.end, p->tokens[to - 1].span.start));
        if (countof(inner) == 0) return 0;
        if (same_text(inner, ":")) inner = none;
        if (countof(inner) > 0 && inner[0] == ':') return 0;
        if (starts_with(inner, "const") || starts_with(inner, "restrict") || starts_with(inner, "static")) return 0;
        *dims = as_str(format::push("[", inner, "]", *dims));
        to = open;
    }
    return to;
}

// The array suffixes written after a name (#1898): `text` is them as smith writes them in front of the type (`[3]`,
// `[][2]`), `end` is where the last one ends in the source, `blocked` is set when one has no fix (`[]`, `[const :]`).
// Without a suffix `text` is empty and `blocked` is false.
struct Dims {
    Str text;
    U32 end;
    Bool blocked;
};

// The suffixes in the tokens `first` to `last` (not taken), which follow a type and a name (so `first` is at least 2).
static Dims read_dims(const parse::Parser *p, Usize first, Usize last) {
    Dims dims = {.text = ""};
    if (last <= first) return dims;
    dims.end = p->tokens[last - 1].span.end;
    Str text = "";
    dims.blocked = first < 2 || strip_suffixes(p, first - 2, last, &text) != first;
    if (!dims.blocked) dims.text = text;
    return dims;
}

// One parameter, the tokens `from` to `to` (not taken), as smith writes it: `name: T`, `const n: T`, `T: type`,
// `rest: ...`, an attribute first. An array suffix moves in front of the type (`I32 xs[3]` is `xs: [3]I32`). Empty when
// it has no mechanical fix (no name, `auto x`, a qualified slice).
static Str new_parameter(const parse::Parser *p, Usize from, Usize to) {
    Usize at = from;
    Str prefix = "";
    Bool unused = false;
    while (at + 1 < to && p->tokens[at].kind == lex::left_bracket && p->tokens[at + 1].kind == lex::left_bracket) {
        Usize close = at + 2;
        while (close + 1 < to &&
               !(p->tokens[close].kind == lex::right_bracket && p->tokens[close + 1].kind == lex::right_bracket))
            close += 1;
        if (close + 1 >= to) return "";
        Mapped mapped = map_attribute(source_between(p, p->tokens[at + 1].span.end, p->tokens[close].span.start));
        if (!mapped.known) return "";
        if (mapped.unused) unused = true;
        if (countof(mapped.text) > 0) prefix = as_str(format::push(prefix, mapped.text, " "));
        at = close + 2;
    }
    Bool is_const = at < to && p->tokens[at].kind == lex::kw_constexpr;
    if (is_const) at += 1;
    Str dims = "";
    to = strip_suffixes(p, at, to, &dims);
    if (to == 0 || to <= at + 1) return "";
    lex::Token last = p->tokens[to - 1];
    if (last.kind != lex::name && !(is_const && last.kind == lex::type_name)) return "";
    Str name = parse::text(p, last);
    if (unused) name = as_str(format::push("_", name));
    if (to == at + 3 && p->tokens[at].kind == lex::kw_auto && p->tokens[at + 1].kind == lex::ellipsis)
        return as_str(format::push(prefix, name, ": ..."));
    Str type = trimmed(parse::mended(p, p->tokens[at].span.start, p->tokens[to - 2].span.end));
    Str raw = trimmed(source_between(p, p->tokens[at].span.start, p->tokens[to - 2].span.end));
    if (same_text(raw, "auto")) return "";
    if (is_const && same_text(raw, "Type")) return as_str(format::push(prefix, name, ": type"));
    type = as_str(format::push(dims, type));
    if (is_const) return as_str(format::push(prefix, "const ", name, ": ", type));
    return as_str(format::push(prefix, name, ": ", type));
}

// The parameters, the tokens after `open` up to `close`, as `a: T, b: U`. False when one has no mechanical fix.
static Bool new_parameters(const parse::Parser *p, Usize open, Usize close, Str *out) {
    Str none = "";
    *out = none;
    if (close == open + 1 || (close == open + 2 && p->tokens[open + 1].kind == lex::kw_void)) return true;
    Usize depth = 0;
    Usize from = open + 1;
    for (Usize i = open + 1; i <= close; i++) {
        lex::TokenKind kind = p->tokens[i].kind;
        if (i < close && (kind == lex::left_paren || kind == lex::left_bracket || kind == lex::left_brace)) depth += 1;
        if (i < close && (kind == lex::right_paren || kind == lex::right_bracket || kind == lex::right_brace))
            depth -= 1;
        if (i == close || (kind == lex::comma && depth == 0)) {
            Str one = new_parameter(p, from, i);
            if (countof(one) == 0) return false;
            if (countof(*out) > 0)
                *out = as_str(format::push(*out, ", ", one));
            else
                *out = one;
            from = i + 1;
        }
    }
    return true;
}

// `R f(A a) { ... }` is `fn f(a: A) -> R { ... }` (no `-> void`); the parameters are the tokens `open` to `close`. A
// prototype, and a head with a parameter that has no mechanical fix, are a warning with no edits.
static void fix_function(parse::Parser *p, const Prefixes *pre, Head head, Usize open, Usize close, Bool has_body) {
    U32 end = p->tokens[close].span.end;
    // `fn run() {` read with today's tokenizer (`smith lint --fix` does until the switch) is a function whose type is
    // the name `fn`: it is smith's own form already.
    if (same_text(trimmed(source_between(p, head.type_start, head.name.span.start)), "fn")) return;
    Str name = named(pre, parse::text(p, head.name));
    Str params = "";
    Bool fixable = new_parameters(p, open, close, &params) && has_body;
    if (pre->is_constexpr && pre->constexpr_end > head.type_start) fixable = false;
    if (!fixable) {
        char message[:] = format::push("a function is written `fn ", name,
                                       "(a: i32) -> i32 { ... }`: this one has no mechanical fix (a prototype, or a "
                                       "parameter with no name, an array suffix or `auto`): write it by hand");
        parse::Edits none = {};
        warn(p, head.type_start, end, message, none);
        return;
    }
    Str result = trimmed(parse::mended(p, head.type_start, head.name.span.start));
    Str written = as_str(format::push("fn ", name, "(", params, ")"));
    if (!same_text(result, "void")) written = as_str(format::push(written, " -> ", result));
    parse::Edits edits = {};
    edits = with_edit(edits, edit(head.type_start, end, written));
    if (pre->is_constexpr) edits = with_edit(edits, edit(pre->constexpr_start, pre->constexpr_after, ""));
    edits = with_unused(pre, edits);
    char message[:] = format::push("a function is written `", written, " { ... }`: the types follow the names");
    warn(p, head.type_start, end, message, edits);
}

// Whether the initializer is an untyped list of `.field = value` items that ends at the `;`, for a variable of a
// named type: then `P p = {.x = 1};` is `let p = P(x = 1)`.
static Bool named_list_init(const parse::Parser *p, const ast::TypeExpr *type, U32 equal_end, U32 semicolon) {
    if (type->kind != .named || equal_end == 0 || !p->named_list.plain) return false;
    const parse::NamedList *list = &p->named_list;
    return list->open.start >= equal_end && list->close.end <= semicolon &&
           same_text(trimmed(source_between(p, equal_end, list->open.start)), "") &&
           same_text(trimmed(source_between(p, list->close.end, semicolon)), "");
}

// The edits that turn the braces of that list into the call `Type(...)`; the dots' edits come with it.
static parse::Edits named_list_edits(const parse::Parser *p, Str type) {
    parse::Edits edits = p->named_list.edits;
    edits = with_edit(edits, edit(p->named_list.open.start, p->named_list.open.end, as_str(format::push(type, "("))));
    return with_edit(edits, edit(p->named_list.close.start, p->named_list.close.end, ")"));
}

// Whether the written type is a number: C zeroes a static or a global of one, so its fix writes `= 0`.
static Bool is_number_type(Str type) {
    return same_text(type, "i8") || same_text(type, "i16") || same_text(type, "i32") || same_text(type, "i64") ||
           same_text(type, "u8") || same_text(type, "u16") || same_text(type, "u32") || same_text(type, "u64") ||
           same_text(type, "isize") || same_text(type, "usize") || same_text(type, "f32") || same_text(type, "f64");
}

// `T a = v;` is `let a: T = v`, `T a;` is `let mut a: T = undefined` (`= 0` for a static or a file's number, which C
// zeroes), `auto a = v;` is `let a = v`, `constexpr T N = v;` is `const N: T = v` and `constexpr Type N = T;` is
// `let N = T`; the `;` goes. The position is after the `;`. An array suffix, `extern` and
// the like are a warning with no edits.
static void fix_variable(parse::Parser *p, const Prefixes *pre, Head head, ast::TypeExpr *type, U32 equal_end,
                         Dims dims) {
    lex::Token last = p->tokens[p->position - 1];
    Bool has_init = equal_end > 0;
    Bool automatic = type->kind == .auto_type;
    Str name = named(pre, parse::text(p, head.name));
    Str written = trimmed(parse::mended(p, head.type_start, head.name.span.start));
    Str raw = trimmed(source_between(p, head.type_start, head.name.span.start));
    Bool type_value = pre->is_constexpr && head.name.kind == lex::type_name && same_text(raw, "Type");
    Bool suffixed = countof(dims.text) > 0;
    Bool fixable = last.kind == lex::semicolon && !dims.blocked && !pre->is_extern && !p->for_init;
    // A static or file-level array with no value is zeroed by C, and a `{...}` list has no spelling yet: by hand.
    if (suffixed && !has_init && (pre->is_static || pre->top)) fixable = false;
    Str value = "";
    if (has_init) value = trimmed(source_between(p, equal_end, last.span.start));
    if (suffixed && countof(value) > 0 && value[0] == '{') fixable = false;
    if (pre->is_constexpr && (pre->constexpr_end > head.type_start || !has_init)) fixable = false;
    if (automatic && !has_init) fixable = false;
    if (!fixable) {
        char message[:] = format::push("a variable is written `", name, ": T = value`, the type after the name: `",
                                       written, " ", name,
                                       "` has no mechanical fix (`extern`, a `for` initializer, `[]` or `[const :]` "
                                       "after the name, a `{...}` list, an array that C zeroes): write it by hand");
        parse::Edits none = {};
        warn(p, head.type_start, head.name.span.end, message, none);
        return;
    }
    // A global of C is writable: `let mut` (`pub let mut` with the `export` before it); a local is `let`.
    Str lead = "let ";
    if (pre->is_constexpr && !type_value) lead = "const ";
    if (!pre->is_constexpr && pre->top) lead = "let mut ";
    written = as_str(format::push(dims.text, written));
    Str text = as_str(format::push(lead, name, ": ", written, " ="));
    U32 to = equal_end;
    parse::Edits list_edits = {};
    if (named_list_init(p, type, equal_end, last.span.start)) {
        text = as_str(format::push(lead, name, " ="));
        list_edits = named_list_edits(p, written);
    }
    if (type_value || automatic) text = as_str(format::push(lead, name, " ="));
    if (!has_init) {
        Bool zeroed = (pre->is_static || pre->top) && is_number_type(written);
        text = as_str(format::push("let mut ", name, ": ", written, zeroed ? " = 0" : " = undefined"));
        to = suffixed ? dims.end : head.name.span.end;
    }
    parse::Edits edits = {};
    edits = with_edit(edits, edit(head.type_start, to, text));
    edits = with_edit(edits, edit(last.span.start, last.span.end, ""));
    for (Usize i = 0; i < countof(list_edits); i += 1)
        edits = with_edit(edits, list_edits[i]);
    if (pre->is_constexpr) edits = with_edit(edits, edit(pre->constexpr_start, pre->constexpr_after, ""));
    edits = with_unused(pre, edits);
    char message[:] = format::push("a variable is written `", text, " ...`: the name comes first and the `;` goes");
    warn(p, head.type_start, last.span.end, message, edits);
}

static ast::Decl *parse_function(parse::Parser *p, const Prefixes *pre, Head head, U32 start, ast::TypeExpr *type) {
    Bool variadic = false;
    Usize errors_before = countof(p->errors);
    Usize open = p->position;
    ParamList params = parse_params(p, &variadic);
    if (failed_since(p, errors_before)) {
        skip_function(p);
        return nullptr;
    }
    Str name = parse::text(p, head.name);
    if (pre->top) fix_function(p, pre, head, open, p->position - 1, parse::at(p, lex::left_brace));
    ast::Stmt *body = nullptr;
    if (parse::at(p, lex::left_brace)) {
        body = parse::statement(p);
    } else {
        parse::expect(p, lex::semicolon, "`{` or `;` after the parameters");
    }
    ast::DeclKind kind = {
        .function = {.name = name, .params = params, .result = type, .body = body, .variadic = variadic}};
    return make(p, start, pre, kind);
}

static ast::Decl *parse_variable(parse::Parser *p, const Prefixes *pre, Head head, U32 start, ast::TypeExpr *type) {
    Str name = parse::text(p, head.name);
    Usize errors_before = countof(p->errors);
    Usize suffix_first = p->position;
    ast::TypeExpr *full = array_suffixes(p, type);
    Dims dims = read_dims(p, suffix_first, p->position);
    ast::Expr *init = nullptr;
    U32 equal_end = 0;
    if (!parse::at(p, lex::comma) && parse::at(p, lex::equal)) equal_end = parse::peek(p).span.end;
    if (!parse::at(p, lex::comma) && parse::accept(p, lex::equal)) {
        init = parse::expression(p);
        if (init == nullptr) {
            recover(p);
            return nullptr;
        }
    }
    // `for (Usize i, T x : xs)`: after `Usize i` a `,` and a type is the statement's, which reads the element.
    lex::TokenKind after_comma = parse::peek_at(p, 1).kind;
    Bool index_of_range =
        init == nullptr && parse::at(p, lex::comma) &&
        (after_comma == lex::type_name || after_comma == lex::kw_auto || after_comma == lex::kw_const);
    if (parse::at(p, lex::comma) && !index_of_range) {
        several_names_error(p, type, name);
        return nullptr;
    }
    // A range `for (T x : xs)`: the `:` is the statement's, which reads the range.
    Bool before_range = index_of_range || (init == nullptr && parse::at(p, lex::colon));
    if (!before_range) parse::expect(p, lex::semicolon, "`;` after the declaration");
    if (!before_range && !failed_since(p, errors_before)) fix_variable(p, pre, head, type, equal_end, dims);
    ast::DeclKind kind = {.variable = {.name = name,
                                       .type = full,
                                       .init = init,
                                       .is_constexpr = pre->is_constexpr,
                                       .is_thread_local = pre->is_thread_local}};
    return make(p, start, pre, kind);
}

// A variable or a function: a type, a name, then `(` for a function.
static ast::Decl *parse_typed(parse::Parser *p, const Prefixes *pre, U32 start) {
    if (starts_untyped_declaration(p)) {
        Str name = parse::text(p, parse::peek(p));
        char message[:] =
            format::push("a declaration needs a type (there is no implicit `int`): write the type before `", name,
                         "`, as in `I32 ", name, "`");
        parse::error(p, parse::peek(p).span, message);
        recover(p);
        return nullptr;
    }
    U32 type_start = parse::peek(p).span.start;
    ast::TypeExpr *type = declared_type(p);
    if (type == nullptr) {
        recover(p);
        return nullptr;
    }
    if (parse::at(p, lex::left_paren) && parse::peek_at(p, 1).kind == lex::star) {
        fn_pointer_error(p, type);
        recover(p);
        return nullptr;
    }
    // `constexpr Type Meters = F64;`: a type value is named like a type.
    Str type_word = "Type";
    Bool type_value = pre->is_constexpr && parse::at(p, lex::type_name) && mem::equal(type_text(p, type), type_word);
    lex::Token name_token = type_value ? parse::advance(p) : parse::expect(p, lex::name, "a name");
    if (name_token.kind != lex::name && !type_value) {
        recover(p);
        return nullptr;
    }
    Head head = {.type_start = type_start, .name = name_token};
    if (parse::at(p, lex::left_paren)) return parse_function(p, pre, head, start, type);
    return parse_variable(p, pre, head, start, type);
}

// ---------------------------------------------------------------------------------------------------------------
// Records, enums and typedefs

// The name after `struct`, `union` or `enum`: a type name, or none.
static Str tag_name(parse::Parser *p) {
    if (parse::at(p, lex::type_name)) return parse::text(p, parse::advance(p));
    if (parse::at(p, lex::name) && parse::peek_at(p, 1).kind == lex::left_brace) {
        lex::Token token = parse::advance(p);
        char message[:] = format::push("a type's name starts with a capital letter: `", parse::text(p, token),
                                       "` is the spelling of a value");
        parse::error(p, token.span, message);
        return parse::text(p, token);
    }
    return "";
}

// `I32 x;` is `x: I32` in a record, and the `;` goes. False (and a warning with no edits) for a field with an array
// suffix, a bit-width or no name.
static Bool fix_field(parse::Parser *p, U32 start, lex::Token name, lex::Token semi, Dims dims, Bool blocked) {
    parse::Edits edits = {};
    if (blocked || dims.blocked || name.kind != lex::name || semi.kind != lex::semicolon) {
        warn(p, start, semi.span.end,
             "a field is written `x: T`: this one (a bit-width, no name, `[]` or `[const :]` after the name) has no "
             "mechanical fix: write it by hand",
             edits);
        return false;
    }
    Str word = parse::text(p, name);
    Str written = trimmed(source_between(p, start, name.span.start));
    char text[:] = format::push(word, ": ", dims.text, written);
    edits = with_edit(edits, edit(start, countof(dims.text) > 0 ? dims.end : name.span.end, text));
    edits = with_edit(edits, edit(semi.span.start, semi.span.end, ""));
    char message[:] = format::push("a field is written `", text, "`, one to a line, with no `;`");
    warn(p, start, semi.span.end, message, edits);
    return true;
}

// The rest of a field once its type is read: one name (none for an unnamed bit-field, and none for C11's unnamed member
// `struct { I32 a; };` when `anonymous`), array suffixes, `: width`, `;`.
static ast::FieldDecl finish_field(parse::Parser *p, ast::FieldDecl field, Bool anonymous, U32 start, Style *style,
                                   Bool top) {
    if (anonymous && parse::at(p, lex::semicolon)) {
        parse::advance(p);
        field.span = parse::span_from(p, start);
        return field;
    }
    if (parse_type::at_slice_pointer_declarator(p)) {
        slice_pointer_error(p, field.type);
        recover(p);
        return field;
    }
    lex::Token name_token = {};
    if (parse::at(p, lex::name)) {
        name_token = parse::advance(p);
        field.name = parse::text(p, name_token);
    } else if (!parse::at(p, lex::colon)) {
        if (parse::at(p, lex::right_brace)) {
            Str message =
                "a field has a name: a record is `struct { I32 a; }`, a tuple `struct { I32, F32 }`, not a mix";
            parse::error(p, parse::peek(p).span, message);
            return field;
        }
        parse::expect(p, lex::name, "a field name");
    }
    if (parse::at(p, lex::comma)) {
        several_names_error(p, field.type, field.name);
        return field;
    }
    Usize suffix_first = p->position;
    field.type = array_suffixes(p, field.type);
    Dims dims = read_dims(p, suffix_first, p->position);
    Bool blocked = false;
    if (parse::accept(p, lex::colon)) {
        field.bit_width = parse::expression(p);
        blocked = true;
    }
    Usize errors_before = countof(p->errors);
    lex::Token semi = parse::expect(p, lex::semicolon, "`;` after the field");
    if (!(top && countof(p->errors) == errors_before && fix_field(p, start, name_token, semi, dims, blocked)))
        style->unfixed = true;
    field.span = parse::span_from(p, start);
    return field;
}

// One field whose type is not an anonymous record: a type, then the rest.
static ast::FieldDecl parse_field(parse::Parser *p, Style *style, Bool top) {
    ast::FieldDecl field = {};
    U32 start = parse::peek(p).span.start;
    if (take_tag_keyword(p)) field.type = parse::type(p);
    if (field.type == nullptr) {
        recover(p);
        return field;
    }
    return finish_field(p, field, false, start, style, top);
}

// A field in smith's own syntax starts with a lowercase name and `:` (the old form starts with a type). A keyword may
// name a field (`module: str`); `int : 3`, an unnamed C bit-field, is not one.
static Bool new_field_ahead(const parse::Parser *p) {
    if (parse::at(p, lex::kw_pub))
        return parse::peek_at(p, 1).kind == lex::name && parse::peek_at(p, 2).kind == lex::colon;
    lex::TokenKind kind = parse::peek(p).kind;
    if (parse::peek_at(p, 1).kind != lex::colon) return false;
    if (kind == lex::name) return true;
    return lex::is_keyword(kind) && parse::peek_at(p, 2).kind != lex::integer;
}

// `x: f64`, one to a line, with no `;` or `,` (the position is at the name).
static ast::FieldDecl parse_new_field(parse::Parser *p) {
    ast::FieldDecl field = {.is_new = true};
    U32 start = parse::peek(p).span.start;
    if (parse::accept(p, lex::kw_pub)) field.is_pub = true;
    field.name = parse::text(p, parse::advance(p));
    parse::advance(p);
    field.type = parse::type(p);
    if (field.type == nullptr) {
        recover_line(p);
        return field;
    }
    if (parse::accept(p, lex::equal)) field.default_value = parse::expression(p);
    end_line(p, "field");
    field.span = parse::span_from(p, start);
    return field;
}

// A record being read: its fields so far, and where the field it is the type of began.
struct OpenRecord {
    FieldList fields;
    Bool is_union;
    U32 field_start;
};

constexpr Usize max_nesting = 16;

static void add_field(FieldList *fields, ast::FieldDecl field) {
    *fields = mem::realloc(*fields, countof(*fields) + 1);
    (*fields)[countof(*fields) - 1] = field;
}

// The fields up to the closing `}` (not taken). A field of type `struct { ... }` or `union { ... }` opens a record on
// an explicit stack, so a nest of them is a loop, not a recursion.
static FieldList parse_fields(parse::Parser *p, Style *style) {
    OpenRecord stack[max_nesting] = {};
    Usize depth = 0;
    Usize limit = 2 * countof(p->tokens) + max_nesting;
    for (Usize step = 0; step < limit; step++) {
        if (p->layout && depth == 0) {
            skip_newlines(p);
            if (parse::at(p, lex::dedent) || parse::at(p, lex::end_of_file)) return stack[0].fields;
        }
        if (parse::at(p, lex::right_brace) || parse::at(p, lex::end_of_file)) {
            if (depth == 0) return stack[0].fields;
            U32 field_start = stack[depth].field_start;
            ast::TypeKind kind = {.record = {.fields = stack[depth].fields, .is_union = stack[depth].is_union}};
            parse::expect(p, lex::right_brace, "`}`");
            ast::TypeExpr node = {.span = parse::span_from(p, field_start)};
            node.kind = kind;
            depth -= 1;
            ast::FieldDecl field = {.type = ast::new_type(node)};
            field = finish_field(p, field, true, field_start, style, false);
            add_field(&stack[depth].fields, field);
            continue;
        }
        Usize before = p->position;
        if (parse::at(p, lex::at)) {
            Prefixes marks = {};
            while (parse::at(p, lex::at)) {
                parse_at_attribute(p, &marks);
                skip_newlines(p); // layout path: stacked attributes, one per line
            }
            if (!new_field_ahead(p)) {
                if (!parse::at(p, lex::right_brace) && !parse::at(p, lex::end_of_file) && !parse::at(p, lex::dedent))
                    parse::error(p, parse::peek(p).span, "an attribute marks a field written `name: type`");
                if (p->position == before) parse::advance(p);
                continue;
            }
            style->saw_new = true;
            ast::FieldDecl marked = parse_new_field(p);
            marked.attributes = marks.attributes;
            if (marked.type != nullptr) add_field(&stack[depth].fields, marked);
            continue;
        }
        if (new_field_ahead(p)) {
            style->saw_new = true;
            ast::FieldDecl made = parse_new_field(p);
            if (made.type != nullptr) add_field(&stack[depth].fields, made);
            if (p->position == before) parse::advance(p);
            continue;
        }
        style->saw_old = true;
        if (at_anonymous_record(p) && depth + 1 < max_nesting) {
            OpenRecord child = {.is_union = parse::peek(p).kind == lex::kw_union,
                                .field_start = parse::peek(p).span.start};
            parse::advance(p);
            parse::expect(p, lex::left_brace, "`{`");
            depth += 1;
            stack[depth] = child;
            continue;
        }
        if (at_anonymous_record(p)) parse::error(p, parse::peek(p).span, "anonymous records are nested too deeply");
        ast::FieldDecl field = parse_field(p, style, style->top && depth == 0);
        if (field.type != nullptr) add_field(&stack[depth].fields, field);
        if (p->position == before) parse::advance(p);
    }
    return stack[0].fields;
}

// `struct {` or `union {`: an anonymous record used as a type.
static Bool at_anonymous_record(const parse::Parser *p) {
    lex::TokenKind kind = parse::peek(p).kind;
    return (kind == lex::kw_struct || kind == lex::kw_union) && parse::peek_at(p, 1).kind == lex::left_brace &&
           !parse_type::tuple_ahead(p);
}

// `struct { fields }` or `union { fields }` as a type: a payload variant, or the type of a variable. Its fields' own
// types come from the type hook, so a nest of anonymous records is the hook's, not a recursion here.
static ast::TypeExpr *parse_anonymous_record(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    Bool is_union = parse::advance(p).kind == lex::kw_union;
    parse::expect(p, lex::left_brace, "`{`");
    Style style = {};
    FieldList fields = parse_fields(p, &style);
    parse::expect(p, lex::right_brace, "`}`");
    ast::TypeKind kind = {.record = {.fields = fields, .is_union = is_union}};
    ast::TypeExpr node = {.span = parse::span_from(p, start)};
    node.kind = kind;
    return ast::new_type(node);
}

// `struct Name { fields }` or `union`, the position at the keyword. A `typedef struct {...} Name;` has no tag name: the
// caller gives it.
static ast::DeclKind record_kind(parse::Parser *p, Style *style) {
    Bool is_union = parse::advance(p).kind == lex::kw_union;
    Str name = tag_name(p);
    FieldList fields = {};
    Bool opaque = false;
    if (p->layout && !parse::at(p, lex::left_brace)) {
        // `struct Name:` and the fields, indented; `struct Name` alone is opaque; a `:` with no block is empty.
        style->saw_new = true;
        if (parse::accept(p, lex::colon)) {
            if (open_layout_block(p)) {
                fields = parse_fields(p, style);
                parse::expect(p, lex::dedent, "the end of the fields");
            }
        } else {
            opaque = true;
        }
    } else if (parse::accept(p, lex::left_brace)) {
        fields = parse_fields(p, style);
        parse::expect(p, lex::right_brace, "`}`");
    } else if (parse::at(p, lex::semicolon)) {
        opaque = true;
    } else if (countof(name) > 0) {
        char message[:] = format::push("`struct ", name, "` is C's spelling: a tag is a type name, write `", name, "`");
        parse::error(p, parse::peek(p).span, message);
    }
    ast::DeclKind kind = {.record = {.name = name, .is_union = is_union, .opaque = opaque, .fields = fields}};
    return kind;
}

static Bool ends_variant(lex::TokenKind kind) {
    return kind == lex::equal || kind == lex::comma || kind == lex::semicolon || kind == lex::right_brace ||
           kind == lex::newline || kind == lex::dedent;
}

// An old member of an enum, `red,` or `Circle circle;`: the `,` or `;` goes (a line break stands for it when more
// follows on the line), and a payload is `circle: Circle`.
static void fix_enumerator(parse::Parser *p, U32 start, Bool plain, lex::Token name, lex::Token ender) {
    parse::Edits edits = {};
    Str stand_in = ender.line_break || parse::at(p, lex::right_brace) ? "" : "\n";
    Str message = "an enum member ends with the line: remove the `,` or `;`";
    if (!plain && name.kind == lex::name) {
        Str word = parse::text(p, name);
        Str written = trimmed(source_between(p, start, name.span.start));
        char text[:] = format::push(word, ": ", written);
        edits = with_edit(edits, edit(start, name.span.end, text));
        message = as_str(format::push("a payload is written `", text, "`, one to a line"));
    } else if (!plain) {
        return;
    }
    edits = with_edit(edits, edit(ender.span.start, ender.span.end, stand_in));
    warn(p, start, ender.span.end, message, edits);
}

// One enumerator: `red`, `Red`, `green = 2`, `Fib7 = f(7)`, `Circle circle;` or `empty;` (a name alone, with or without
// a value, is a value; a payload has a type before its name), then `,` or `;`.
static ast::Enumerator parse_enumerator(parse::Parser *p, Style *style) {
    ast::Enumerator item = {};
    U32 start = parse::peek(p).span.start;
    lex::Token head = parse::peek(p);
    // smith's own syntax: `circle: Circle`, and a lowercase name that ends its line (`red`, the next on its own line).
    Bool payload_ahead = head.kind == lex::name && parse::peek_at(p, 1).kind == lex::colon;
    Bool line_variant = head.kind == lex::name && head.line_break;
    if (payload_ahead) {
        style->saw_new = true;
        item.name = parse::text(p, parse::advance(p));
        parse::advance(p);
        item.payload = parse::type(p);
        if (item.payload == nullptr) {
            recover_line(p);
            return item;
        }
        end_line(p, "member");
        item.span = parse::span_from(p, start);
        return item;
    }
    lex::Token payload_name = {};
    Bool plain = false;
    if (at_anonymous_record(p)) {
        item.payload = parse_anonymous_record(p);
        lex::Token name = parse::expect(p, lex::name, "a variant name");
        if (name.kind == lex::name) item.name = parse::text(p, name);
        style->unfixed = true;
    } else if ((parse::at(p, lex::name) || parse::at(p, lex::type_name)) &&
               (ends_variant(parse::peek_at(p, 1).kind) || line_variant)) {
        item.name = parse::text(p, parse::advance(p));
        if (parse::accept(p, lex::equal)) item.value = parse::expression(p);
        plain = true;
    } else {
        item.payload = parse::type(p);
        if (item.payload == nullptr) {
            recover(p);
            return item;
        }
        lex::Token name = parse::expect(p, lex::name, "a variant name");
        if (name.kind == lex::name) {
            item.name = parse::text(p, name);
            payload_name = name;
        }
    }
    lex::Token ender = parse::peek(p);
    if (parse::accept(p, lex::comma) || parse::accept(p, lex::semicolon)) {
        style->saw_old = true;
        if (style->top)
            fix_enumerator(p, start, plain, payload_name, ender);
        else
            style->unfixed = true;
    } else if (parse::at(p, lex::right_brace)) {
        // the last member of either spelling
    } else if ((p->layout && at_line_end(p)) || line_ended(p)) {
        style->saw_new = true;
    } else {
        parse::expect(p, lex::comma, "`,`, `;` or `}`");
    }
    item.span = parse::span_from(p, start);
    return item;
}

// Layout path: `enum Name:` or `enum Name(u8):`, and the members, indented, one to a line (the position is after the
// name).
static ast::DeclKind enum_layout(parse::Parser *p, Style *style, Str name) {
    style->saw_new = true;
    ast::TypeExpr *underlying = nullptr;
    if (parse::accept(p, lex::left_paren)) {
        underlying = parse::type(p);
        parse::expect(p, lex::right_paren, "`)`");
    }
    EnumeratorList items = {};
    parse::expect(p, lex::colon, "`:` before the members");
    if (open_layout_block(p)) {
        Usize limit = countof(p->tokens);
        for (Usize step = 0; step <= limit; step++) {
            skip_newlines(p);
            if (parse::at(p, lex::dedent) || parse::at(p, lex::end_of_file)) break;
            Usize before = p->position;
            Prefixes marks = {};
            while (parse::at(p, lex::at))
                parse_at_attribute(p, &marks);
            skip_newlines(p);
            if (parse::at(p, lex::dedent)) break;
            ast::Enumerator item = parse_enumerator(p, style);
            item.attributes = marks.attributes;
            if (countof(item.name) > 0) {
                items = mem::realloc(items, countof(items) + 1);
                items[countof(items) - 1] = item;
            }
            if (p->position == before) parse::advance(p);
        }
        parse::expect(p, lex::dedent, "the end of the members");
    }
    ast::DeclKind kind = {.enumeration = {.name = name, .underlying = underlying, .items = items}};
    return kind;
}

// `enum Name : Underlying { items }`, the position at the keyword.
static ast::DeclKind enum_kind(parse::Parser *p, Style *style) {
    parse::advance(p);
    Str name = tag_name(p);
    ast::TypeExpr *underlying = nullptr;
    EnumeratorList items = {};
    if (p->layout &&
        (parse::at(p, lex::left_paren) || (parse::at(p, lex::colon) && parse::peek_at(p, 1).kind == lex::newline)))
        return enum_layout(p, style, name);
    if (parse::accept(p, lex::colon)) underlying = parse::type(p);
    parse::expect(p, lex::left_brace, "`{`");
    while (!parse::at(p, lex::right_brace) && !parse::at(p, lex::end_of_file)) {
        Usize before = p->position;
        Prefixes marks = {};
        while (parse::at(p, lex::at))
            parse_at_attribute(p, &marks);
        if (parse::at(p, lex::right_brace)) continue;
        ast::Enumerator item = parse_enumerator(p, style);
        item.attributes = marks.attributes;
        if (countof(item.name) > 0) {
            items = mem::realloc(items, countof(items) + 1);
            items[countof(items) - 1] = item;
        }
        if (p->position == before) parse::advance(p);
    }
    parse::expect(p, lex::right_brace, "`}`");
    ast::DeclKind kind = {.enumeration = {.name = name, .underlying = underlying, .items = items}};
    return kind;
}

static ast::DeclKind tag_kind(parse::Parser *p, Style *style) {
    if (parse::at(p, lex::kw_enum)) return enum_kind(p, style);
    return record_kind(p, style);
}

// `struct Name {...};`, `union`, `enum`: a declaration of the type by itself.
static ast::Decl *parse_tag(parse::Parser *p, const Prefixes *pre, U32 start) {
    Usize errors_before = countof(p->errors);
    Style style = {.top = pre->top};
    ast::DeclKind kind = tag_kind(p, &style);
    if (failed_since(p, errors_before)) {
        // A body in smith's own syntax recovered line by line and is closed; the old form skips to its `;`.
        if (!style.saw_new) recover(p);
        return nullptr;
    }
    if (parse::at(p, lex::name) || parse::at(p, lex::star)) {
        Str message = "declare the type by itself: write `struct Name {...};`, then `Name x;` for the variable";
        parse::error(p, parse::peek(p).span, message);
        recover(p);
        return nullptr;
    }
    if (style.saw_new) {
        // smith's own syntax ends with the line: a `;` after the `}` is removed.
        if (parse::at(p, lex::semicolon)) end_line(p, "type");
    } else if (style.saw_old || parse::at(p, lex::semicolon)) {
        lex::Token semi = parse::peek(p);
        parse::expect(p, lex::semicolon, "`;` after the type");
        Bool opaque = kind == .record && kind.record.opaque;
        if (pre->top && semi.kind == lex::semicolon && !opaque && !style.unfixed) {
            parse::Edits edits = {};
            edits = with_edit(edits, edit(semi.span.start, semi.span.end, ""));
            warn(p, semi.span.start, semi.span.end, "a type ends with its `}`, not `};`: remove the `;`", edits);
        }
    }
    return make(p, start, pre, kind);
}

// `typedef T Name;` is `let Name = T` (the type follows the name); an array suffix is a warning with no edits.
static void fix_typedef_alias(parse::Parser *p, U32 typedef_start, Head head, lex::Token semi, Dims dims) {
    Str name = parse::text(p, head.name);
    Str written = trimmed(parse::mended(p, head.type_start, head.name.span.start));
    parse::Edits edits = {};
    if (dims.blocked || semi.kind != lex::semicolon) {
        warn(p, typedef_start, semi.span.end,
             "an alias is written `let Name = T`: one with `[]` or `[const :]` after the name has no mechanical fix: "
             "write it by hand",
             edits);
        return;
    }
    char text[:] = format::push("let ", name, " = ", dims.text, written);
    edits = with_edit(edits, edit(typedef_start, semi.span.end, text));
    char message[:] = format::push("an alias is written `", text, "`");
    warn(p, typedef_start, semi.span.end, message, edits);
}

// `typedef struct {...} Name;` is `struct Name {...}` (`union`, `enum` alike): `typedef` goes, the name moves to the
// tag, and the `Name;` after the `}` goes. A tag with another name than the alias, or a member with no fix, is a
// warning with no edits.
static void fix_typedef_tag(parse::Parser *p, Usize typedef_index, Usize close_index, lex::Token alias, lex::Token semi,
                            Bool renamed, Bool unfixed) {
    lex::Token typedef_token = p->tokens[typedef_index];
    lex::Token keyword = p->tokens[typedef_index + 1];
    lex::Token close = p->tokens[close_index];
    parse::Edits edits = {};
    if (renamed || unfixed || semi.kind != lex::semicolon || close.kind != lex::right_brace) {
        warn(p, typedef_token.span.start, semi.span.end,
             "a type is declared as `struct Name {...}`: this typedef (another tag name, or a member with no fix) has "
             "no mechanical fix",
             edits);
        return;
    }
    Str name = parse::text(p, alias);
    lex::Token after_keyword = p->tokens[typedef_index + 2];
    Bool has_tag = after_keyword.kind == lex::type_name;
    if (has_tag) {
        edits = with_edit(edits, edit(typedef_token.span.start, keyword.span.start, ""));
    } else {
        char head[:] = format::push(parse::text(p, keyword), " ", name);
        edits = with_edit(edits, edit(typedef_token.span.start, keyword.span.end, head));
    }
    edits = with_edit(edits, edit(close.span.end, semi.span.end, ""));
    char message[:] =
        format::push("a type is declared as `", parse::text(p, keyword), " ", name, " {...}`, not with `typedef`");
    warn(p, typedef_token.span.start, semi.span.end, message, edits);
}

// `typedef struct {...} Name;`, `typedef enum {...} Name;` and `typedef T Name;` (a tuple is a type: `typedef struct {
// I32, F32 } Pair;`).
static ast::Decl *parse_typedef(parse::Parser *p, const Prefixes *pre, U32 start) {
    Usize typedef_index = p->position;
    parse::advance(p);
    Usize errors_before = countof(p->errors);
    if (!parse_type::tuple_ahead(p) &&
        (parse::at(p, lex::kw_struct) || parse::at(p, lex::kw_union) || parse::at(p, lex::kw_enum))) {
        Style style = {.top = pre->top};
        ast::DeclKind kind = tag_kind(p, &style);
        Usize close_index = p->position - 1;
        lex::Token alias = parse::expect(p, lex::type_name, "the type's name after `}`");
        if (failed_since(p, errors_before)) {
            recover(p);
            return nullptr;
        }
        Str name = parse::text(p, alias);
        Str tag = "";
        if (kind == .record) tag = kind.record.name;
        if (kind == .enumeration) tag = kind.enumeration.name;
        Bool renamed = countof(tag) > 0 && !same_text(tag, name);
        if (kind == .record && countof(kind.record.name) == 0) kind.record.name = name;
        if (kind == .enumeration && countof(kind.enumeration.name) == 0) kind.enumeration.name = name;
        lex::Token semi = parse::expect(p, lex::semicolon, "`;` after the type");
        if (pre->top && !failed_since(p, errors_before))
            fix_typedef_tag(p, typedef_index, close_index, alias, semi, renamed, style.unfixed);
        return make(p, start, pre, kind);
    }
    U32 type_start = parse::peek(p).span.start;
    ast::TypeExpr *type = parse::type(p);
    if (type == nullptr) {
        recover(p);
        return nullptr;
    }
    if (parse::at(p, lex::left_paren) && parse::peek_at(p, 1).kind == lex::star) {
        fn_pointer_error(p, type);
        recover(p);
        return nullptr;
    }
    lex::Token alias = parse::expect(p, lex::type_name, "the type's name");
    if (alias.kind != lex::type_name) {
        recover(p);
        return nullptr;
    }
    Str name = parse::text(p, alias);
    Usize suffix_first = p->position;
    ast::TypeExpr *full = array_suffixes(p, type);
    Dims dims = read_dims(p, suffix_first, p->position);
    if (parse::at(p, lex::comma)) {
        several_names_error(p, type, name);
        return nullptr;
    }
    reject_gnu_spelling(p);
    lex::Token semi = parse::expect(p, lex::semicolon, "`;` after the type");
    if (pre->top && !failed_since(p, errors_before)) {
        Head head = {.type_start = type_start, .name = alias};
        fix_typedef_alias(p, p->tokens[typedef_index].span.start, head, semi, dims);
    }
    ast::DeclKind kind = {.type_alias = {.name = name, .type = full}};
    return make(p, start, pre, kind);
}

// ---------------------------------------------------------------------------------------------------------------
// Imports, static_assert and `if constexpr`

// Whether the next token is the name `as`, a keyword only right after an import path.
static Bool at_as(parse::Parser *p) {
    Str keyword = "as";
    return parse::at(p, lex::kw_as) ||
           (parse::at(p, lex::name) && slice::equal(parse::text(p, parse::peek(p)), keyword));
}

// Whether `c` can be part of a name.
static Bool is_name_char(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

// The name a header binds: its file name without the extension (`sys/stat.h` binds `stat`, `<vector>` binds `vector`);
// empty when that is not a valid name (`x-y.h`), where `as name` is required.
static Str header_default_name(Str header) {
    Usize begin = 0;
    for (Usize i = 0; i < countof(header); i++)
        if (header[i] == '/') begin = i + 1;
    Usize end = countof(header);
    for (Usize i = begin; i < countof(header); i++)
        if (header[i] == '.') end = i;
    Str name = header[begin:end];
    if (countof(name) == 0 || (name[0] >= '0' && name[0] <= '9')) return "";
    for (Usize i = 0; i < countof(name); i++)
        if (!is_name_char(name[i])) return "";
    return name;
}

// `c`, `cpp` or `objc` followed by a header: `import c <stdio.h>`.
static Bool at_header_language(parse::Parser *p) {
    if (!parse::at(p, lex::name)) return false;
    Str text = parse::text(p, parse::peek(p));
    Bool known = same_text(text, "c") || same_text(text, "cpp") || same_text(text, "objc");
    lex::TokenKind next = parse::peek_at(p, 1).kind;
    return known && (next == lex::less || next == lex::string);
}

// `<stdio.h>` or `"x.h"`: reads the header and whether it was angled.
static Bool parse_header_spec(parse::Parser *p, Str *header, Bool *angled) {
    if (parse::at(p, lex::string)) {
        *header = string_value(p, parse::advance(p));
        *angled = false;
        return true;
    }
    if (!parse::at(p, lex::less)) {
        parse::error(p, parse::peek(p).span, "a header in `<...>` or quotes");
        return false;
    }
    U32 begin = parse::advance(p).span.end;
    while (!parse::at(p, lex::greater) && !parse::at(p, lex::semicolon) && !parse::at(p, lex::end_of_file) &&
           !line_ended(p))
        parse::advance(p);
    *header = source_between(p, begin, parse::peek(p).span.start);
    *angled = true;
    parse::expect(p, lex::greater, "`>`");
    return true;
}

// The spelling of a header as written: `<stdio.h>` or `"x.h"`.
static typeof(char[:]) header_spelling(Str header, Bool angled) {
    if (angled) return format::push("<", header, ">");
    return format::push("\"", header, "\"");
}

static void fix_import(parse::Parser *p, U32 import_start, lex::Token semi, ast::Path path, ast::Text alias);

// The old `import <stdio.h>;` and `import "x.h";`: an error-free read that records the new spelling as a warning.
static ast::Decl *parse_old_header_import(parse::Parser *p, const Prefixes *pre, U32 start, U32 import_start) {
    Str header = "";
    Bool angled = false;
    if (!parse_header_spec(p, &header, &angled)) {
        recover_line(p);
        return nullptr;
    }
    if (at_as(p)) {
        parse::error(p, parse::peek(p).span, "a C header has no alias: write `import path as name;` for a module");
        parse::advance(p);
        if (parse::at(p, lex::name)) parse::advance(p);
    }
    lex::Token semi = parse::expect(p, lex::semicolon, "`;` after the import");
    if (semi.kind == lex::semicolon) {
        Str name = header_default_name(header);
        Str suffix = "";
        if (countof(name) == 0) suffix = " as name";
        char text[:] = format::push("import c ", header_spelling(header, angled), suffix);
        char message[:] = format::push("a header import is a statement: write `", text, "`");
        parse::Edits edits = {};
        if (countof(name) > 0) edits = with_edit(edits, edit(import_start, semi.span.end, text));
        warn(p, import_start, semi.span.end, message, edits);
    }
    ast::DeclKind kind = {.import_c = {.header = header, .angled = angled}};
    return make(p, start, pre, kind);
}

// The end of an import line: a redundant `as` repeats the name the import binds anyway.
static void end_import(parse::Parser *p) {
    end_line(p, "import");
}

// `as name` after a module or header; the name, or empty. `end` is where the import ended, for the fix-it.
static ast::Text parse_alias(parse::Parser *p, U32 before_as, Str default_name) {
    ast::Text alias = {};
    if (!at_as(p)) return alias;
    parse::advance(p);
    lex::Token name = parse::expect(p, lex::name, "a name after `as`: write `import path as name;`");
    if (name.kind != lex::name) return alias;
    alias = parse::text(p, name);
    if (countof(default_name) > 0 && slice::equal(alias, default_name)) {
        parse::Edits edits = {};
        edits = with_edit(edits, edit(before_as, name.span.end, ""));
        char message[:] = format::push("`as ", alias, "` repeats the name the import binds: remove it");
        warn(p, before_as, name.span.end, message, edits);
    }
    return alias;
}

// `import c <stdio.h>`, `import c <sys/stat.h> as st`, `import cpp <vector>`, `import objc <Foundation/Foundation.h>`.
static ast::Decl *parse_header_import(parse::Parser *p, const Prefixes *pre, U32 start) {
    ast::Text language = parse::text(p, parse::advance(p));
    Str header = "";
    Bool angled = false;
    if (!parse_header_spec(p, &header, &angled)) {
        recover_line(p);
        return nullptr;
    }
    Str name = header_default_name(header);
    U32 line_end = parse::peek(p).span.start;
    ast::Text alias = parse_alias(p, line_end > 0 ? line_end - 1 : 0, name);
    if (countof(alias) == 0 && countof(name) == 0) {
        char message[:] = format::push("`", header, "` is not a name: write `import ", language, " ",
                                       header_spelling(header, angled), " as name`");
        parse::error(p, (ast::Span){.start = start, .end = line_end}, message);
    }
    end_import(p);
    ast::DeclKind kind = {.import_c = {.header = header, .angled = angled, .language = language, .alias = alias}};
    return make(p, start, pre, kind);
}

// A module path of names joined by `.`; `old` is set when a `::` joined two of them (the old `import std::math;`).
static ast::Path parse_import_path(parse::Parser *p, Bool *old) {
    ast::Path path = {};
    U32 start = parse::peek(p).span.start;
    while (!parse::at(p, lex::end_of_file)) {
        lex::Token token = parse::peek(p);
        if (!is_name(token.kind)) {
            parse::expect(p, lex::name, "a module name after `import`");
            break;
        }
        parse::advance(p);
        path.segments = mem::realloc(path.segments, countof(path.segments) + 1);
        path.segments[countof(path.segments) - 1] =
            (ast::Identifier){.text = parse::text(p, token), .span = token.span};
        if (parse::accept(p, lex::colon_colon)) {
            *old = true;
            continue;
        }
        if (!parse::accept(p, lex::dot)) break;
    }
    path.span = parse::span_from(p, start);
    return path;
}

// `import std.arena`, `import std.arena as a`, `import c <stdio.h>`, and the old `import std::arena;`,
// `import <stdio.h>;`, `import "x.h";`. An import is a statement of the top level, one per line.
static ast::Decl *parse_import(parse::Parser *p, const Prefixes *pre, U32 start) {
    U32 import_start = parse::advance(p).span.start;
    if (parse::at(p, lex::less) || parse::at(p, lex::string))
        return parse_old_header_import(p, pre, start, import_start);
    if (at_header_language(p)) return parse_header_import(p, pre, start);
    Bool old = false;
    ast::Path path = parse_import_path(p, &old);
    if (countof(path.segments) == 0) {
        recover_line(p);
        return nullptr;
    }
    Str last = path.segments[countof(path.segments) - 1].text;
    Str default_name = last;
    if (old) default_name = "";
    ast::Text alias = parse_alias(p, path.span.end, default_name);
    if (parse::at(p, lex::semicolon)) old = true; // `import serial;`: the old spelling, mended like `import a::b;`
    if (old) {
        lex::Token semi = parse::expect(p, lex::semicolon, "`;` after the import");
        if (semi.kind == lex::semicolon) fix_import(p, import_start, semi, path, alias);
    } else {
        end_import(p);
    }
    ast::DeclKind kind = {.import_module = {.path = path, .alias = alias}};
    return make(p, start, pre, kind);
}

// `import std::arena;` is `import std.arena`, and `import std::arena as a;` is `import std.arena as a`.
static void fix_import(parse::Parser *p, U32 import_start, lex::Token semi, ast::Path path, ast::Text alias) {
    Usize count = countof(path.segments);
    if (count == 0) {
        return;
    }
    char text[:] = format::push("import ");
    for (Usize i = 0; i < count; i += 1) {
        Str dot = i > 0 ? "." : "";
        text = format::push(text, dot, path.segments[i].text);
    }
    if (countof(alias) > 0 && !slice::equal(alias, path.segments[count - 1].text))
        text = format::push(text, " as ", alias);
    char message[:] = format::push("an import has no `::` or `;`: write `", text, "`");
    parse::Edits edits = {};
    edits = with_edit(edits, edit(import_start, semi.span.end, text));
    warn(p, import_start, semi.span.end, message, edits);
}

// Whether the position starts `from std.math import sin`: the name `from` and a module or a header after it.
static Bool at_from_import(parse::Parser *p) {
    if (!parse::at(p, lex::name) || !same_text(parse::text(p, parse::peek(p)), "from")) return false;
    lex::TokenKind next = parse::peek_at(p, 1).kind;
    return is_name(next);
}

// `from std.math import sin, cos` and `from c <stdlib.h> import malloc, free`: the names are bound in this module.
static ast::Decl *parse_from_import(parse::Parser *p, const Prefixes *pre, U32 start) {
    parse::advance(p);
    ast::Path path = {};
    ast::Text header = {};
    ast::Text language = {};
    Bool angled = false;
    if (at_header_language(p)) {
        language = parse::text(p, parse::advance(p));
        Str spelled = "";
        if (!parse_header_spec(p, &spelled, &angled)) {
            recover_line(p);
            return nullptr;
        }
        header = spelled;
    } else {
        Bool old = false;
        path = parse_import_path(p, &old);
        if (old) parse::error(p, path.span, "a module path is joined by `.`: write `from std.math import name`");
    }
    parse::expect(p, lex::kw_import, "`import` after the module in `from`");
    ast::Identifier names[:] = {};
    while (!parse::at(p, lex::end_of_file)) {
        lex::Token name = parse::peek(p);
        if (!is_name(name.kind)) {
            parse::expect(p, lex::name, "a name to bring in");
            break;
        }
        parse::advance(p);
        names = mem::realloc(names, countof(names) + 1);
        names[countof(names) - 1] = (ast::Identifier){.text = parse::text(p, name), .span = name.span};
        if (!parse::accept(p, lex::comma)) break;
    }
    end_import(p);
    ast::DeclKind kind = {
        .import_from = {.path = path, .header = header, .angled = angled, .language = language, .names = names}};
    return make(p, start, pre, kind);
}

// `static_assert(condition, "message");`, the message optional.
static ast::Decl *parse_static_assert(parse::Parser *p, const Prefixes *pre, U32 start) {
    parse::advance(p);
    parse::expect(p, lex::left_paren, "`(`");
    ast::Expr *condition = parse::expression(p);
    if (condition == nullptr) {
        recover(p);
        return nullptr;
    }
    Str message = "";
    if (parse::accept(p, lex::comma)) {
        lex::Token token = parse::expect(p, lex::string, "the message, a string");
        if (token.kind == lex::string) message = string_value(p, token);
    }
    parse::expect(p, lex::right_paren, "`)`");
    parse::expect(p, lex::semicolon, "`;` after `static_assert`");
    ast::DeclKind kind = {.static_assert_decl = {.condition = condition, .message = message}};
    return make(p, start, pre, kind);
}

// ---------------------------------------------------------------------------------------------------------------
// smith's own syntax (#1428): `let a = v`, `a: T = v`, `let mut a = 0`, `const X = v`, `let (q, r) = f()`, `fn`
//
// What tells the new form from the old one is the first one or two tokens, never the rest: `fn`, `mut` and `@` start
// only the new forms; a name followed by `:=` or `:` is a binding (the old forms start with a type and never have a
// name before a `:`); `const` followed by such a name is a constant (the old `const` is followed by a type, and a type
// is never followed by `:=` or `:`); a field is a lowercase name and `:` (an old field starts with a type); an
// enumerator is a lowercase name that ends its line, or a name and `:`.

// Whether the token at `at` is the word `let` and a name, `mut` or `(` follows (`if let .some(x)` has a `.`).
static Bool let_at(const parse::Parser *p, Usize at) {
    lex::Token word = parse::peek_at(p, at);
    if (word.kind != lex::name || !same_text(parse::text(p, word), "let")) return false;
    lex::TokenKind next = parse::peek_at(p, at + 1).kind;
    return is_name(next) || next == lex::kw_mut || next == lex::left_paren;
}

// `let a = v`, `let a: T = v`, `let mut a: T = v` and `const X = v`; a `const` and a `mut` together is read to be
// told off. A destructuring `let (q, r) = f()` is `at_destructure`'s.
export Bool starts_binding(const parse::Parser *p) {
    if (let_at(p, 0)) return parse::peek_at(p, 1).kind != lex::left_paren;
    if (parse::peek(p).kind != lex::kw_const) return false;
    if (parse::peek_at(p, 1).kind == lex::kw_mut) return true; // read to be told off
    lex::TokenKind after = parse::peek_at(p, 2).kind;
    return is_name(parse::peek_at(p, 1).kind) && (after == lex::equal || after == lex::colon);
}

// What follows the name of a binding: `: T` and then `= v`, or `= v`. A binding with no value is an error that says
// to give one or to write `= undefined`; an `extern let` (`bare`) has none. False after an error.
static Bool parse_binding_value(parse::Parser *p, lex::Token name, Str opener, Bool bare, ast::TypeExpr **type,
                                ast::Expr **init) {
    *type = auto_type(name.span);
    if (parse::accept(p, lex::colon)) {
        *type = parse::type(p);
        if (*type == nullptr) return false;
    }
    if (parse::accept(p, lex::equal)) {
        *init = parse::expression(p);
        return *init != nullptr;
    }
    const ast::TypeExpr *given = *type;
    Bool automatic = given->kind == .auto_type;
    if (bare && !automatic) return true;
    Str word = parse::text(p, name);
    Str written = "T";
    if (!automatic) written = type_text(p, given);
    char message[:] = format::push("`", word, "` needs a value: write `", opener, " ", word, ": ", written,
                                   " = value`, or `= undefined` to leave it unset");
    parse::error(p, name.span, message);
    return false;
}

// `let xs: [_]i32 = [1, 2, 3]` and `const s: [_]char = "abc"`: a `[_]` length is the initializer's element count, a
// string literal's bytes and its terminator, as in C. The length is written into the type, so the checker, the
// emitter and the headers all see an ordinary `[3]`. Any other initializer is left alone for them to report.
static void infer_array_length(ast::TypeExpr *type, const ast::Expr *init) {
    if (type == nullptr || init == nullptr || type->kind != .array) return;
    const ast::Expr *count = type->kind.array.count;
    if (count == nullptr || count->kind != .name || countof(count->kind.name.path.segments) != 1) return;
    Str word = count->kind.name.path.segments[0].text;
    if (countof(word) != 1 || word[0] != '_') return;
    if (init->kind == .array_lit) {
        type->kind.array.count = ast::integer(countof(init->kind.array_lit.items));
    } else if (init->kind == .string) {
        type->kind.array.count = ast::integer(countof(init->kind.string.bytes) + 1);
    }
}

// `let a = v`, `let a: T = v`, `let mut a: usize = 0`, `const X = v`; the position is at the first of them.
static ast::Decl *parse_binding(parse::Parser *p, const Prefixes *pre, U32 start) {
    Bool is_let = let_at(p, 0);
    if (is_let) parse::advance(p);
    Bool is_const = !is_let && parse::accept(p, lex::kw_const);
    Bool is_mut = parse::accept(p, lex::kw_mut);
    if (is_mut && is_const) {
        parse::error(p, parse::span_from(p, start), "`const` and `mut` cannot be combined: a constant never changes");
        recover_line(p);
        return nullptr;
    }
    lex::Token name = parse::peek(p);
    Str opener = is_let ? "let" : "const";
    if (is_mut) opener = "mut";
    if (!is_name(name.kind)) {
        char message[:] = format::push("expected a name after `", opener, "`, found `", parse::text(p, name), "`");
        parse::error(p, name.span, message);
        recover_line(p);
        return nullptr;
    }
    parse::advance(p);
    ast::TypeExpr *type = nullptr;
    ast::Expr *init = nullptr;
    Str kind_word = is_const ? "const" : "let";
    if (!parse_binding_value(p, name, kind_word, pre->is_extern, &type, &init)) {
        recover_line(p);
        return nullptr;
    }
    end_line(p, "declaration");
    infer_array_length(type, init);
    ast::DeclKind kind = {.variable = {.name = parse::text(p, name),
                                       .type = type,
                                       .init = init,
                                       .is_constexpr = is_const,
                                       .is_mut = is_mut,
                                       .is_new = true}};
    return make(p, start, pre, kind);
}

// Whether the position starts `let (q, mut r) = f()`: `let`, a parenthesized list and then `=`, which no expression
// statement starting with the word `let` is.
export Bool at_destructure(const parse::Parser *p) {
    if (!let_at(p, 0) || parse::peek_at(p, 1).kind != lex::left_paren) return false;
    Usize at = 1;
    Usize depth = 0;
    for (Usize step = 0; step < countof(p->tokens); step++) {
        lex::TokenKind kind = parse::peek_at(p, at).kind;
        if (kind == lex::end_of_file) return false;
        if (kind == lex::left_paren) depth += 1;
        if (kind == lex::right_paren) {
            depth -= 1;
            if (depth == 0) return parse::peek_at(p, at + 1).kind == lex::equal;
        }
        at += 1;
    }
    return false;
}

// `let (q, mut r) = f()`: a statement, not a declaration (it declares no one thing), so it is not behind the
// declaration hook: the statement parser calls this where `at_destructure` says so. `mut` marks one name.
export ast::Stmt *destructure(parse::Parser *p) {
    parse::advance(p);
    parse::expect(p, lex::left_paren, "`(`");
    IdentifierList names = {};
    while (!parse::at(p, lex::right_paren) && !parse::at(p, lex::end_of_file)) {
        Bool is_mut = parse::accept(p, lex::kw_mut);
        lex::Token token = parse::peek(p);
        if (!is_name(token.kind)) {
            char message[:] = format::push("a destructuring lists names: write `let (q, r) = f()`, found `",
                                           parse::text(p, token), "`");
            parse::error(p, token.span, message);
            recover_line(p);
            return nullptr;
        }
        parse::advance(p);
        names = mem::realloc(names, countof(names) + 1);
        names[countof(names) - 1] =
            (ast::Identifier){.text = parse::text(p, token), .span = token.span, .is_mut = is_mut};
        if (!parse::accept(p, lex::comma)) break;
    }
    lex::Token close = parse::expect(p, lex::right_paren, "`)`");
    if (countof(names) == 0) {
        parse::error(p, close.span, "a destructuring lists names: write `let (q, r) = f()`");
        recover_line(p);
        return nullptr;
    }
    parse::expect(p, lex::equal, "`=` after the names");
    ast::Expr *init = parse::expression(p);
    if (init == nullptr) {
        recover_line(p);
        return nullptr;
    }
    end_line(p, "declaration");
    return ast::destructure(names, false, init);
}

// One parameter: `a: i32`, `mut b: i32`, `const n: usize`, `T: type`, `rest: ...`, after any `@attribute`. False after
// an error.
static Bool parse_new_param(parse::Parser *p, ast::Param *param) {
    U32 start = parse::peek(p).span.start;
    Prefixes pre = {};
    while (parse::at(p, lex::at))
        parse_at_attribute(p, &pre);
    param->is_mut = parse::accept(p, lex::kw_mut);
    param->is_new = true;
    param->is_const = parse::accept(p, lex::kw_const);
    lex::Token name = parse::peek(p);
    if (is_name(name.kind) && parse::peek_at(p, 1).kind == lex::ellipsis) {
        // `xs...` gathers positional arguments, `; kw...` named ones (the list tells which, see below).
        param->name = parse::text(p, parse::advance(p));
        param->type = auto_type(parse::advance(p).span);
        param->is_pack = true;
        param->attributes = pre.attributes;
        param->span = parse::span_from(p, start);
        return true;
    }
    if (!is_name(name.kind) || parse::peek_at(p, 1).kind != lex::colon) {
        Str word = parse::text(p, name);
        char message[:] = format::push("a parameter is written `name: type`, found `", word, "`");
        if (is_name(name.kind)) message = format::push("a parameter is written `name: type`: `", word, "` has no type");
        if (name.kind == lex::end_of_file)
            message = format::push("a parameter is written `name: type`, found the end of the file");
        parse::error(p, name.span, message);
        return false;
    }
    param->name = parse::text(p, parse::advance(p));
    parse::advance(p);
    if (parse::at(p, lex::ellipsis)) {
        param->type = auto_type(parse::advance(p).span);
        param->is_rest = true;
    } else {
        param->type = parse::type(p);
        if (param->type == nullptr) return false;
        if (parse::accept(p, lex::equal)) param->default_value = parse::expression(p);
    }
    param->attributes = pre.attributes;
    param->span = parse::span_from(p, start);
    return true;
}

// Layout path: the `:` and the body of `fn name(...) -> r:`, the block indented or one statement on the line; a `:`
// with nothing after it is an empty body.
static ast::Decl *finish_layout_function(parse::Parser *p, const Prefixes *pre, U32 start, lex::Token name,
                                         ParamList params, ast::TypeExpr *result, Usize errors_before) {
    if (!failed_since(p, errors_before) && !parse::accept(p, lex::colon)) {
        parse::error(p, parse::peek(p).span, "a function has a body: expected `:` after the parameters");
    }
    if (failed_since(p, errors_before)) {
        skip_to_line_end(p);
        if (open_layout_block(p)) skip_layout_body(p);
        return nullptr;
    }
    ast::Stmt *body = nullptr;
    if (parse::at(p, lex::newline) && parse::peek_at(p, 1).kind != lex::indent) {
        ast::StmtRef none[:] = {};
        body = ast::block(none);
    } else {
        body = parse::statement(p);
    }
    ast::DeclKind kind = {.function = {.name = parse::text(p, name), .params = params, .result = result, .body = body}};
    return make(p, start, pre, kind);
}

// A `name...` parameter before the `;` gathers positional arguments; after it, named ones (`; kw...`).
static void check_pack(ast::Param *param, Bool after_semicolon) {
    if (!param->is_pack || !after_semicolon) return;
    param->is_pack = false;
    param->is_gather = true;
}

// `fn name(a: i32, mut b: i32) -> r { body }`, the `-> r` optional (no result is none, not `void`); the position is at
// `fn`.
static ast::Decl *parse_new_function(parse::Parser *p, const Prefixes *pre, U32 start) {
    parse::advance(p);
    Usize errors_before = countof(p->errors);
    lex::Token name = parse::peek(p);
    // `type` is a keyword only where a type is expected: `fn type(p: *Parser)` names a function.
    if (!is_name(name.kind) && name.kind != lex::kw_type) {
        Str form = p->layout ? "fn name(a: i32) -> i32:" : "fn name(a: i32) -> i32 { ... }";
        parse::error(p, name.span, as_str(format::push("a function has a name: write `", form, "`")));
    } else {
        parse::advance(p);
        parse::expect(p, lex::left_paren, "`(` after the function's name");
    }
    ParamList params = {};
    Bool keyword_only = false;
    while (!failed_since(p, errors_before) && !parse::at(p, lex::right_paren) && !parse::at(p, lex::end_of_file)) {
        ast::Param param = {};
        if (!parse_new_param(p, &param)) break;
        param.is_keyword = keyword_only;
        check_pack(&param, keyword_only);
        params = mem::realloc(params, countof(params) + 1);
        params[countof(params) - 1] = param;
        // `;` ends the positional parameters: the ones after it are keyword-only.
        if (param.is_gather && !parse::at(p, lex::right_paren)) {
            parse::error(p, parse::peek(p).span,
                         "`name...` after the `;` gathers the named arguments: it is the last parameter");
            break;
        }
        if (parse::accept(p, lex::semicolon)) {
            if (keyword_only) parse::error(p, parse::peek(p).span, "a parameter list has one `;`");
            keyword_only = true;
            continue;
        }
        if (!parse::accept(p, lex::comma)) break;
    }
    if (!failed_since(p, errors_before)) parse::expect(p, lex::right_paren, "`)`");
    ast::TypeExpr *result = nullptr;
    if (!failed_since(p, errors_before) && parse::accept(p, lex::arrow)) result = parse::type(p);
    if (p->layout) return finish_layout_function(p, pre, start, name, params, result, errors_before);
    if (!failed_since(p, errors_before) && !parse::at(p, lex::left_brace)) {
        parse::error(p, parse::peek(p).span, "a function has a body: expected `{` after the parameters");
    }
    if (failed_since(p, errors_before)) {
        skip_new_function(p);
        return nullptr;
    }
    ast::Stmt *body = parse::statement(p);
    ast::DeclKind kind = {.function = {.name = parse::text(p, name), .params = params, .result = result, .body = body}};
    return make(p, start, pre, kind);
}

// One declaration that opens no block of its own.
static ast::Decl *parse_simple(parse::Parser *p, Bool top) {
    U32 start = parse::peek(p).span.start;
    Prefixes pre = parse_prefixes(p, top);
    lex::TokenKind kind = parse::peek(p).kind;
    if (kind == lex::kw_fn) return parse_new_function(p, &pre, start);
    if (at_destructure(p)) {
        parse::error(p, parse::peek(p).span,
                     "a destructuring `let (q, r) = f()` is a statement, not a declaration of a module");
        recover_line(p);
        return nullptr;
    }
    if (at_from_import(p)) return parse_from_import(p, &pre, start);
    if (starts_binding(p)) return parse_binding(p, &pre, start);
    if (kind == lex::kw_import) return parse_import(p, &pre, start);
    if (kind == lex::kw_static_assert) return parse_static_assert(p, &pre, start);
    if (kind == lex::kw_typedef) return parse_typedef(p, &pre, start);
    Bool is_tag = kind == lex::kw_struct || kind == lex::kw_union || kind == lex::kw_enum;
    if (is_tag && !at_anonymous_record(p) && !parse_type::tuple_ahead(p) && !at_tag_use(p))
        return parse_tag(p, &pre, start);
    return parse_typed(p, &pre, start);
}

// The head of `if constexpr (c) {`.
static Frame open_frame(parse::Parser *p) {
    Frame frame = {.start = parse::peek(p).span.start};
    parse::advance(p);
    parse::expect(p, lex::kw_constexpr, "`constexpr`: `if constexpr` is the only `if` of a file");
    parse::expect(p, lex::left_paren, "`(`");
    frame.condition = parse::expression(p);
    parse::expect(p, lex::right_paren, "`)`");
    parse::expect(p, lex::left_brace, "`{`");
    return frame;
}

static ast::Decl *finish_frame(const parse::Parser *p, const Frame *frame) {
    Prefixes none = {};
    ast::DeclKind kind = {.if_constexpr = {.condition = frame->condition,
                                           .then_decls = frame->then_decls,
                                           .else_decls = frame->else_decls}};
    return make(p, frame->start, &none, kind);
}

// A declaration read into the open block on top of the stack.
static void add_to_frame(Frame *top, ast::Decl *item) {
    if (item == nullptr) return;
    if (top->in_else) {
        top->else_decls = push_decl(top->else_decls, item);
    } else {
        top->then_decls = push_decl(top->then_decls, item);
    }
}

// One declaration, which for an `if constexpr` is the whole block with its declarations: the open blocks are an
// explicit stack, so a nest of them is no recursion.
static ast::Decl *parse_one(parse::Parser *p, Bool at_top) {
    FrameList stack = {};
    Usize depth = 0;
    for (Usize step = 0; step <= countof(p->tokens); step++) {
        ast::Decl *done = nullptr;
        Bool closed = false;
        lex::TokenKind kind = parse::peek(p).kind;
        if (depth > 0 && kind == lex::end_of_file) {
            parse::error(p, parse::peek(p).span, "expected `}` to close `if constexpr`, found the end of the file");
            done = finish_frame(p, &stack[depth - 1]);
            depth -= 1;
            closed = true;
        } else if (depth > 0 && kind == lex::right_brace) {
            parse::advance(p);
            Frame *top = &stack[depth - 1];
            if (!top->in_else && parse::at(p, lex::kw_else)) {
                parse::advance(p);
                top->in_else = true;
                if (parse::at(p, lex::kw_if)) {
                    top->chained = true;
                } else {
                    parse::expect(p, lex::left_brace, "`{` or `if constexpr` after `else`");
                }
                continue;
            }
            done = finish_frame(p, top);
            depth -= 1;
            closed = true;
        } else if (kind == lex::kw_if) {
            if (depth == countof(stack)) {
                stack = mem::realloc(stack, depth + 1);
            }
            stack[depth] = open_frame(p);
            depth += 1;
            continue;
        } else {
            Usize before = p->position;
            done = parse_simple(p, at_top);
            if (done == nullptr && p->position == before) parse::advance(p);
        }
        for (Usize level = 0; level <= countof(stack); level++) {
            if (depth == 0) return done;
            Frame *top = &stack[depth - 1];
            if (closed && top->chained) {
                add_to_frame(top, done);
                done = finish_frame(p, top);
                depth -= 1;
                continue;
            }
            add_to_frame(top, done);
            break;
        }
    }
    return nullptr;
}

// ---------------------------------------------------------------------------------------------------------------
// Entry points

// One declaration, the hook `parse::Hooks.declaration`: null after an error, with the parser past the bad declaration.
export ast::Decl *declaration(parse::Parser *p) {
    return parse_one(p, false);
}

// `module a::b;` is removed: the path of the file names the module. The line goes with it.
static void fix_module_line(parse::Parser *p, lex::Token module_token, lex::Token semi) {
    U32 end = semi.span.end;
    if (end < countof(p->source) && p->source[end] == '\n') end += 1;
    Str path = trimmed(source_between(p, module_token.span.end, semi.span.start));
    char message[:] = format::push("the path of the file names the module: remove `module ", path, ";`");
    parse::Edits edits = {};
    edits = with_edit(edits, edit(module_token.span.start, end, ""));
    warn(p, module_token.span.start, semi.span.end, message, edits);
}

// A whole file: an optional `module x::y;` (recorded in the module's name until the keyword is the switch), then
// declarations to the end of the file. `file` is the file's name, kept in the module.
export ast::Module file(parse::Parser *p, Str file) {
    ast::Module result = {.file = file};
    lex::Token module_token = parse::peek(p);
    if (parse::accept(p, lex::kw_module)) {
        result.name = parse_path(p, "a module name");
        lex::Token semi = parse::expect(p, lex::semicolon, "`;` after the module's name");
        if (semi.kind == lex::semicolon) fix_module_line(p, module_token, semi);
    }
    while (!parse::at(p, lex::end_of_file)) {
        skip_newlines(p);
        if (parse::at(p, lex::end_of_file)) break;
        Usize before = p->position;
        ast::Decl *item = parse_one(p, true);
        if (item != nullptr) result.decls = push_decl(result.decls, item);
        if (p->position == before) parse::advance(p);
    }
    return result;
}
