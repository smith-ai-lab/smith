// front::types: the types of smith's own front end and the checker's entry point (#1112, ticket J1a of #1220). The
// parser (track A) gives syntax; this module says what a name and a type expression mean. J1b (expressions,
// types_expr), J1c (conversions, types_convert) and J1d (declarations, statements and calls, types_decl) are built on
// the API below. Not wired into `smith cc`.
//
// THE API, in the order a checker uses it. Everything is allocated in the current allocator (std::mem), so a caller
// that sets an arena as the allocator frees a whole check at once; nothing here recurses (a walk uses a work stack).
//
//   Ty, TypeRef        A type (named `Ty`: `Type` is the type of types) is an immutable `Ty`, handed around as a
//                      `TypeRef` (`const Ty *`). Types are INTERNED in a `Table`: two types are the same type exactly
//                      when their `TypeRef`s are equal, so `a == b` is the comparison and there is no `equal(a, b)`. A
//                      record and an enumeration are nominal (one per declaration, equal only to themselves); every
//                      other type is equal by structure: kind, size in bits, signedness, element, count, parameters,
//                      qualifiers.
//   Ty.kind            A payload enum (`TyKind`): each kind has only its own fields, and the accessors below
//   (`element_of`,
//                      `slots_of`, `bits_of`, `name_of`, ...) read a field that several kinds share. The kinds are
//                      invalid (a type that already has an error; checking goes on without a second report),
//                      automatic (`Auto`, the concept that is always true), void_type, bool_type, integer, floating,
//                      text (`Str`), null_type (the type of `null`), pointer, array, slice, record, enumeration,
//                      function (`R (P1, P2)`), option, result, fn_value (`Fn(F)` as a value).
//   Qualifiers         `const` on a pointee, an array element or a slice element is part of the pointer, array or
//                      slice type (`pointee_const`). `const` on the type of a variable is not a type: it is the
//                      `is_const` of the variable's `Symbol`. A reader of a `TypeExpr` takes the second from
//                      `t->qualifiers.is_const` and the first is taken by `resolve`.
//   Table, start       `types::start(Target)` gives the table with every builtin made. `builtin(table, name)` finds
//                      `I8 I16 I32 I64 Isize U8 U16 U32 U64 Usize F32 F64 Char Bool Void Str Auto` by its name (null
//                      for any other); the fields `invalid`, `void_type`, `bool_type`, `text`, `null_type`, `automatic`
//                      hold the ones that are not a number. `integer(table, bits, is_signed)` and `floating(table,
//                      bits)` give the fixed-size ones. `Isize` and `Usize` are their own types (as C's `long`
//                      is not `long long`), the width of the target's pointer.
//   Makers             `pointer_to`, `array_of`, `slice_of`, `function_of`, `option_of`, `stream_of`, `result_of`,
//   `fn_value_of`
//                      intern a type from its parts. `new_record(table, name, is_union)` and `new_enumeration(table,
//                      name, underlying)` make a nominal type that is `complete` once `set_fields` has run (a record
//                      can point to itself, so it is made before its fields).
//   show(t)            The type as a user writes it, for messages: `I32`, `const U8 *`, `Point[3]`, `Fn(Bool (I32,
//                      I32))`, `Option(I32)`. `<error>` for invalid.
//   Target, layout     `Target` holds the sizes of the machine the module is checked for (pointer width and the
//                      largest alignment); it is a parameter of `types::start` and `Options`, and nothing here ever
//                      asks the host (a GPU target has other sizes). `layout(&target, t)` gives `Layout {size,
//                      align, known}` by C's rules (natural alignment up to `max_align`, fields in order, a union
//                      the largest); `known` is false for types with no layout yet (`Void`, a function, an
//                      incomplete record, `Option`, `Checked`, `Auto`).
//   Scopes, Symbol     A stack of scopes of `Symbol`s (a name, its kind, its type, its declaration). `declare` adds
//                      to the innermost (false when the name is already there), `lookup` and `lookup_path` search
//                      from the innermost out. Names are resolved HERE, not in the parser. A name from a C header is
//                      declared as `c::name`, so the path `c::printf` is found whole; `import std::arena;` declares
//                      the module `arena` (its members come with J1d).
//   Checked, check      `check(module, options)` declares the module's top-level names, resolves the types of
//                      records, enumerations, aliases, function signatures and variables, and calls
//                      `options.bodies` (when set) for each function with a body; J1d supplies that function, since
//                      this module cannot import it. Errors are in `Checked.errors`, never an abort; each message
//                      names what was expected and what to write. A construct J1 does not type is `not yet typed:
//                      <kind>` with its span, never silently accepted.
//   The side table     Until the interface to the emitter is decided, the type of an expression is recorded in
//                      `Checked`'s table keyed by the node: `set_type(&r, node, t)` and `type_of(&r, node)` (null
//                      when none). No field was added to front/ast.smith.
//   resolve(r, texpr)  A `TypeExpr` as a `TypeRef`, reporting unknown names; with no recursion.
//
// Order of top-level resolution: records and enumerations first (so any order of use works), then `typedef`s in the
// order written, then fields, enumerators, function signatures and variables.
module front::types;

import front::ast;
import front::ast_clone;
import front::parse as syntax;
import front::when;
import std::arena;
import std::format;
import std::mem;

// ---------------------------------------------------------------------------------------------------------------
// The target

// What the checker knows of the machine: never the host's.
export struct Target {
    U32 pointer_bytes; // the width of a pointer, `Usize` and `Isize`
    U32 max_align;     // the largest alignment a type has
};

// A 64-bit target with 8-byte pointers and 16-byte alignment at most.
export Target lp64() {
    return (Target){.pointer_bytes = 8, .max_align = 16};
}

export struct Layout {
    U64 size;
    U64 align;
    Bool known;
};

// ---------------------------------------------------------------------------------------------------------------
// Types

export struct Ty;
export typedef const Ty *TypeRef;

// A field of a record, or a parameter of a function type (whose names are empty: they are not part of the type).
export struct Slot {
    Str name;
    TypeRef type;
    U64 value;   // an enumerator's value
    Bool is_pub; // a field other modules may name (`pub x: T`, or any field written in today's syntax)
    const ast::Expr *default_value; // `x: T = 3`: the field's default (null when none)
    Str doc;                        // the comment above the field, for `fields(T)` (#2295)
    ast::Attribute attributes[:];   // the attributes written on the field, for `f.attr(X)`
    const ast::TypeExpr *written;   // a field written in smith's own syntax: its type as written (for a fix-it)
};

// A `Slot` with every field written: the ones a construction does not set are zero, false, empty or null, and the
// construction assigns the ones it does (`value` of an enumerator, `written`).
export Slot make_slot(Str name, TypeRef type) {
    Slot slot = {.name = name,
                 .type = type,
                 .value = 0,
                 .is_pub = false,
                 .default_value = nullptr,
                 .doc = "",
                 .written = nullptr};
    return slot;
}

// One variant per kind of type, each holding only the fields its kind uses (D17, #2673).
export typedef enum {
    invalid;
    automatic;
    void_type;
    bool_type;
    struct {
        U32 bits;
        Bool is_signed;
        ast::Text name;
    } integer;
    struct {
        U32 bits;
        ast::Text name;
    } floating;
    text;
    null_type;
    struct {
        TypeRef element;
        Bool pointee_const;
        Bool pointee_volatile; // `*volatile T`: every read and write through it is made (#2669)
    } pointer;
    struct {
        TypeRef element;
        U64 count;
        Bool pointee_const;
        Bool pointee_volatile;
    } array;
    struct {
        TypeRef element;
        Bool pointee_const;
        Bool pointee_volatile;
    } slice;
    struct {
        ast::Text name;
        ast::Text owner;  // the prefix of the module that declares it (`lib::math::`), empty for the module checked
        ast::Text c_name; // the C struct it is (`@c_name("SmithTaskGroup")`, or a C header's own name), else empty
        Slot slots[:];
        Bool is_union;
        Bool complete;
        Bool affine; // marked `@affine`: a value is used at most once (front::affine, #1986)
    } record;
    struct {
        ast::Text name;
        TypeRef element; // the underlying integer
        Slot slots[:];   // the enumerators, with their values; when has_payload, a slot's type is what it carries
        Bool complete;
        Bool has_payload; // the enumerators carry values (`circle: Circle`)
    } enumeration;
    struct {
        Slot slots[:]; // the parameters
        TypeRef result;
        Bool variadic;
    } function;
    struct {
        TypeRef element;
    } option;
    struct {
        TypeRef element; // the ok type
        TypeRef error;
    } result_type;
    struct {
        TypeRef element; // a function type
    } fn_value;
    struct {
        ast::Text name;
    } concept_type; // `num`, `int`: a family of types, one instance per type (a parameter or local, never a field)
    type_type;      // `type`: a value of it is a type
    struct {
        TypeRef element;
        U64 count;
    } block; // `[,]T`, `[,,]T`: a contiguous block with `count` dimensions known at run time, `element` per cell
    struct {
        TypeRef element;
    } stream; // `stream::Stream(T)`: a built-in iterable of `element`; one pointer, null when ended
    struct {
        Slot slots[:];
    } tuple; // `(A, B)`: `slots` hold the element types, named "0", "1", ... (read as `t.0`, `t.1`)
    struct {
        ast::Text name; // written with its dot: `.green`
    } symbol;           // `.green`: the type with the one value `.green`, a member of any union that holds it (#3237)
    struct {
        TypeRef element;
        U64 count;
    } vector; // `vec(T, N)`: `count` lanes of `element` (a number type, or `bool` for a comparison), one `<N x T>`
} TyKind;

// A type is its kind, a payload enum: each kind has only the fields it means (`record`: name, owner, slots, ...;
// `pointer`: element, pointee_const). Read the fields of a kind after testing it (`t->kind == .pointer &&
// t->kind.pointer.element`).
export struct Ty {
    TyKind kind;
};

export struct Entry {
    Ty *type;
};

export struct Builtin {
    Str name;
    TypeRef type;
};

export struct ShapeSlot {
    TypeRef type; // null: an empty slot
};

export struct Table {
    Target target;
    Entry entries[:];
    Usize count;
    ShapeSlot shapes[:]; // the structural entries, by `shape_hash` (open addressing): `intern`'s index
    Usize shaped;
    Builtin builtins[:];
    TypeRef invalid;
    TypeRef automatic;
    TypeRef void_type;
    TypeRef bool_type;
    TypeRef text;
    TypeRef null_type;
};

// A message built with format::push, as the Str that the pieces of a text take.
static Str msg(char chars[:]) {
    return chars;
}

export Bool same_text(Str a, Str b) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// Readers of the payloads that the checker reads in a condition. Each is one test and one read, so that the fixer binds
// the payload (`.name(name) := e.kind`), and gives an empty value for any other kind.

// The name `n` of an expression that is one plain name (a path of one segment), else an empty text.
static Str single_name(const ast::Expr *e) {
    if (e == nullptr) return "";
    if (e->kind != .name) return "";
    if (countof(e->kind.name.path.segments) != 1) return "";
    return e->kind.name.path.segments[0].text;
}

// `k.f` with `k` a plain name and `.` (not `->`): the identifier `k` and the member `f`.
export Bool member_of_name(const ast::Expr *e, ast::Identifier *base, Str *field) {
    if (e->kind != .member) return false;
    if (e->kind.member.arrow) return false;
    const ast::Expr *owner = e->kind.member.base;
    if (owner->kind != .name) return false;
    if (countof(owner->kind.name.path.segments) != 1) return false;
    *base = owner->kind.name.path.segments[0];
    *field = e->kind.member.name;
    return true;
}

// The path of a written type that is a name, else an empty path.
static Bool written_path(const ast::TypeExpr *t, ast::Path *path) {
    if (t == nullptr) return false;
    if (t->kind != .named) return false;
    *path = t->kind.named.path;
    return true;
}

// The expression of a type argument that is a value, else null.
static const ast::Expr *value_argument(const ast::TypeArg *a) {
    if (a == nullptr) return nullptr;
    if (*a != .value) return nullptr;
    return a->value.value;
}

static Bool same_slots(Slot a[:], Slot b[:]) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i++) {
        if (a[i].type != b[i].type) return false;
        if (!same_text(a[i].name, b[i].name)) return false;
    }
    return true;
}

// Whether a tuple slot's name is its position (`0`, `1`) and not a written name.
export Bool is_position(Str name) {
    return countof(name) > 0 && name[0] >= '0' && name[0] <= '9';
}

export struct Members {
    Slot items[:];
};

export Members slots_of(TypeRef t);
export Str owner_of(TypeRef t);
export Str c_name_of(TypeRef t);
export Bool is_union_record(TypeRef t);
export Bool is_affine_record(TypeRef t);
export Bool is_payload_enum(TypeRef t);
export Bool is_complete(TypeRef t);
export Bool points_to_const(TypeRef t);
export Bool points_to_volatile(TypeRef t);
export Bool is_variadic(TypeRef t);
export TypeRef element_of(TypeRef t);
export TypeRef error_of(TypeRef t);
export U64 count_of(TypeRef t);
export Str name_of(TypeRef t);
export U32 bits_of(TypeRef t);
export Bool signed_of(TypeRef t);

// Whether two types are of the same kind (a payload enum has no `==` between two values).
static Bool same_variant(const Ty *a, const Ty *b) {
    if (a->kind == .invalid) return b->kind == .invalid;
    if (a->kind == .automatic) return b->kind == .automatic;
    if (a->kind == .void_type) return b->kind == .void_type;
    if (a->kind == .bool_type) return b->kind == .bool_type;
    if (a->kind == .text) return b->kind == .text;
    if (a->kind == .null_type) return b->kind == .null_type;
    if (a->kind == .type_type) return b->kind == .type_type;
    if (a->kind == .integer) return b->kind == .integer;
    if (a->kind == .floating) return b->kind == .floating;
    if (a->kind == .pointer) return b->kind == .pointer;
    if (a->kind == .slice) return b->kind == .slice;
    if (a->kind == .array) return b->kind == .array;
    if (a->kind == .function) return b->kind == .function;
    if (a->kind == .option) return b->kind == .option;
    if (a->kind == .result_type) return b->kind == .result_type;
    if (a->kind == .fn_value) return b->kind == .fn_value;
    if (a->kind == .concept_type) return b->kind == .concept_type;
    if (a->kind == .block) return b->kind == .block;
    if (a->kind == .stream) return b->kind == .stream;
    if (a->kind == .tuple) return b->kind == .tuple;
    if (a->kind == .vector) return b->kind == .vector;
    if (a->kind == .symbol) return b->kind == .symbol;
    if (a->kind == .record) return b->kind == .record;
    if (a->kind == .enumeration) return b->kind == .enumeration;
    return false;
}

// Whether `a` and `b` have the same element (or error): the accessors answer the type itself for a kind with none.
static Bool same_part(const Ty *a, TypeRef part_of_a, const Ty *b, TypeRef part_of_b) {
    if (part_of_a == a) return part_of_b == b;
    return part_of_a == part_of_b;
}

// Whether two structural types are the same type: the same kind with the same fields. The accessors answer the same
// default for a field the kind has not, so comparing every one is comparing the fields the kind has.
static Bool same_shape(const Ty *a, const Ty *b) {
    if (!same_variant(a, b)) return false;
    if (bits_of(a) != bits_of(b) || signed_of(a) != signed_of(b) || count_of(a) != count_of(b)) return false;
    if (points_to_const(a) != points_to_const(b) || is_variadic(a) != is_variadic(b)) return false;
    if (points_to_volatile(a) != points_to_volatile(b)) return false;
    if (!same_part(a, element_of(a), b, element_of(b)) || !same_part(a, error_of(a), b, error_of(b))) return false;
    if (!same_text(name_of(a), name_of(b))) return false;
    return same_slots(slots_of(a).items, slots_of(b).items);
}

static Ty *add_entry(Table *t, Ty value) {
    if (t->count == countof(t->entries)) {
        Usize capacity = countof(t->entries) * 2;
        if (capacity < 64) capacity = 64;
        t->entries = mem::realloc(t->entries, capacity);
    }
    Ty *node = mem::alloc(Ty);
    *node = value;
    t->entries[t->count].type = node;
    t->count += 1;
    return node;
}

// A number for each kind, for `shape_hash`.
static U64 kind_code(const Ty *a) {
    if (a->kind == .invalid) return 1;
    if (a->kind == .automatic) return 2;
    if (a->kind == .void_type) return 3;
    if (a->kind == .bool_type) return 4;
    if (a->kind == .text) return 5;
    if (a->kind == .null_type) return 6;
    if (a->kind == .type_type) return 7;
    if (a->kind == .integer) return 8;
    if (a->kind == .floating) return 9;
    if (a->kind == .pointer) return 10;
    if (a->kind == .slice) return 11;
    if (a->kind == .array) return 12;
    if (a->kind == .function) return 13;
    if (a->kind == .option) return 14;
    if (a->kind == .result_type) return 15;
    if (a->kind == .fn_value) return 16;
    if (a->kind == .concept_type) return 17;
    if (a->kind == .block) return 18;
    if (a->kind == .stream) return 19;
    if (a->kind == .tuple) return 20;
    if (a->kind == .vector) return 21;
    if (a->kind == .symbol) return 23;
    return 22;
}

static U64 mix(U64 h, U64 v) {
    return (h ^ v) * 0x100000001B3ULL;
}

static U64 mix_text(U64 h, Str text) {
    U64 at = mix(h, countof(text));
    for (Usize i = 0; i < countof(text); i++) {
        at = mix(at, (U64)(U8)text[i]);
    }
    return at;
}

// A hash of what `same_shape` compares, so that two types it calls the same hash the same (a part that is the type
// itself, as the accessors answer for a kind with none, hashes as no part).
static U64 shape_hash(const Ty *a) {
    U64 h = mix(0xcbf29ce484222325ULL, kind_code(a));
    h = mix(h, bits_of(a));
    h = mix(h, count_of(a));
    h = mix(h, (signed_of(a) ? 1U : 0U) | (points_to_const(a) ? 2U : 0U) | (is_variadic(a) ? 4U : 0U) |
                   (points_to_volatile(a) ? 8U : 0U));
    TypeRef element = element_of(a);
    TypeRef error = error_of(a);
    h = mix(h, element == a ? 0 : (U64)(Usize)element);
    h = mix(h, error == a ? 0 : (U64)(Usize)error);
    h = mix_text(h, name_of(a));
    Slot slots[:] = slots_of(a).items;
    for (Usize i = 0; i < countof(slots); i++) {
        h = mix_text(mix(h, (U64)(Usize)slots[i].type), slots[i].name);
    }
    return h;
}

// The slot of `intern`'s index where `candidate` is, or the empty one where it goes.
static Usize shape_slot(const Table *t, const Ty *candidate) {
    Usize mask = countof(t->shapes) - 1;
    Usize i = (Usize)shape_hash(candidate) & mask;
    while (t->shapes[i].type != nullptr && !same_shape(t->shapes[i].type, candidate))
        i = (i + 1) & mask;
    return i;
}

static void grow_shapes(Table *t) {
    Usize capacity = countof(t->shapes) == 0 ? 256 : countof(t->shapes) * 2;
    ShapeSlot old[:] = t->shapes;
    t->shapes = mem::alloc_slice(ShapeSlot, capacity);
    for (Usize i = 0; i < countof(old); i++) {
        if (old[i].type != nullptr) t->shapes[shape_slot(t, old[i].type)] = old[i];
    }
    mem::free(old.data);
}

// The type with the shape of `candidate`: the one made before, or a new one. Records and enumerations are nominal and
// never in the index. A module that imports std declares thousands of types, so the search is by hash (#2888).
static TypeRef intern(Table *t, Ty candidate) {
    if (2 * (t->shaped + 1) > countof(t->shapes)) grow_shapes(t);
    Usize at = shape_slot(t, &candidate);
    if (t->shapes[at].type != nullptr) return t->shapes[at].type;
    Ty *made = add_entry(t, candidate);
    t->shapes[at].type = made;
    t->shaped += 1;
    return made;
}

static void add_builtin(Table *t, Str name, TypeRef type) {
    Usize at = countof(t->builtins);
    Builtin grown[:] = mem::alloc_slice(Builtin, at + 1);
    for (Usize i = 0; i < at; i++) {
        grown[i] = t->builtins[i];
    }
    grown[at] = (Builtin){.name = name, .type = type};
    t->builtins = grown;
}

static void add_integer(Table *t, Str name, U32 bits, Bool is_signed) {
    TyKind made = {.integer = {.bits = bits, .is_signed = is_signed, .name = name}};
    add_builtin(t, name, intern(t, (Ty){.kind = made}));
}

static void add_floating(Table *t, Str name, U32 bits) {
    TyKind made = {.floating = {.bits = bits, .name = name}};
    add_builtin(t, name, intern(t, (Ty){.kind = made}));
}

static void add_va_list(Table *t);

// A table with every builtin type made, for `target`.
export Table start(Target target) {
    Table t = {.target = target,
               .invalid = nullptr,
               .automatic = nullptr,
               .void_type = nullptr,
               .bool_type = nullptr,
               .text = nullptr,
               .null_type = nullptr};
    U32 word = target.pointer_bytes * 8;
    t.invalid = intern(&t, (Ty){.kind = .invalid});
    t.automatic = intern(&t, (Ty){.kind = .automatic});
    t.void_type = intern(&t, (Ty){.kind = .void_type});
    t.bool_type = intern(&t, (Ty){.kind = .bool_type});
    t.text = intern(&t, (Ty){.kind = .text});
    t.null_type = intern(&t, (Ty){.kind = .null_type});
    TypeRef type_of_types = intern(&t, (Ty){.kind = .type_type});
    add_builtin(&t, "Auto", t.automatic);
    add_builtin(&t, "type", type_of_types);
    add_builtin(&t, "Void", t.void_type);
    add_builtin(&t, "Bool", t.bool_type);
    add_builtin(&t, "Str", t.text);
    add_integer(&t, "I8", 8, true);
    add_integer(&t, "I16", 16, true);
    add_integer(&t, "I32", 32, true);
    add_integer(&t, "I64", 64, true);
    add_integer(&t, "I128", 128, true);
    add_integer(&t, "Isize", word, true);
    add_integer(&t, "U8", 8, false);
    add_integer(&t, "U16", 16, false);
    add_integer(&t, "U32", 32, false);
    add_integer(&t, "U64", 64, false);
    add_integer(&t, "U128", 128, false);
    add_integer(&t, "Usize", word, false);
    add_floating(&t, "F16", 16);  // IEEE half (LLVM `half`)
    add_floating(&t, "BF16", 16); // bfloat16 (LLVM `bfloat`)
    add_floating(&t, "F32", 32);
    add_floating(&t, "F64", 64);
    add_integer(&t, "Char", 8, false); // the 8-bit character type, a type of its own (not an alias of `U8`)
    // C's `__builtin_va_list` for std's variadic definitions (#2611): storage of 32 bytes, as large as the list of any
    // 64-bit target; `__builtin_va_start`, `__builtin_va_end` and `__builtin_vsnprintf` take its address.
    add_va_list(&t);
    return t;
}

// The builtin called `name`, or null.
export TypeRef builtin(const Table *t, Str name) {
    for (Usize i = 0; i < countof(t->builtins); i++) {
        if (same_text(t->builtins[i].name, name)) return t->builtins[i].type;
    }
    return nullptr;
}

// `I8`..`I128`, `U8`..`U128` (bits 8, 16, 32, 64 or 128); null for another width.
export TypeRef integer(const Table *t, U32 bits, Bool is_signed) {
    for (Usize i = 0; i < countof(t->builtins); i++) {
        const Ty *x = t->builtins[i].type;
        if (x->kind != .integer) continue;
        Str name = x->kind.integer.name;
        if (x->kind.integer.bits == bits && x->kind.integer.is_signed == is_signed && name[1] != 's' && name[1] != 'z')
            return x;
    }
    return nullptr;
}

// `F32` or `F64` (and `F16`, never `BF16`, for 16); null for another width.
export TypeRef floating(const Table *t, U32 bits) {
    for (Usize i = 0; i < countof(t->builtins); i++) {
        const Ty *x = t->builtins[i].type;
        if (x->kind != .floating) continue;
        if (x->kind.floating.bits == bits && !same_text(x->kind.floating.name, "BF16")) return x;
    }
    return nullptr;
}

// `floating` under a name no enumerator has: `types::floating(...)` read from another module is taken for the
// enumerator `.floating` by the fixer (#2612).
export TypeRef float_of_width(const Table *t, U32 bits) {
    return floating(t, bits);
}

export TypeRef pointer_to(Table *t, TypeRef pointee, Bool pointee_const) {
    TyKind made = {.pointer = {.element = pointee, .pointee_const = pointee_const}};
    return intern(t, (Ty){.kind = made});
}

export TypeRef array_of(Table *t, TypeRef element, U64 count, Bool element_const) {
    TyKind made = {.array = {.element = element, .count = count, .pointee_const = element_const}};
    return intern(t, (Ty){.kind = made});
}

static void add_va_list(Table *t) {
    add_builtin(t, "__builtin_va_list", array_of(t, builtin(t, "U64"), 4, false));
}

export TypeRef slice_of(Table *t, TypeRef element, Bool element_const) {
    TyKind made = {.slice = {.element = element, .pointee_const = element_const}};
    return intern(t, (Ty){.kind = made});
}

// `t` with a `volatile` element: `*volatile T`, `[]volatile T`, `[n]volatile T`; `t` itself for another kind.
export TypeRef with_volatile(Table *t, TypeRef of) {
    if (of->kind == .pointer) {
        TyKind made = {.pointer = {.element = of->kind.pointer.element,
                                   .pointee_const = of->kind.pointer.pointee_const,
                                   .pointee_volatile = true}};
        return intern(t, (Ty){.kind = made});
    }
    if (of->kind == .array) {
        TyKind made = {.array = {.element = of->kind.array.element,
                                 .count = of->kind.array.count,
                                 .pointee_const = of->kind.array.pointee_const,
                                 .pointee_volatile = true}};
        return intern(t, (Ty){.kind = made});
    }
    if (of->kind == .slice) {
        TyKind made = {.slice = {.element = of->kind.slice.element,
                                 .pointee_const = of->kind.slice.pointee_const,
                                 .pointee_volatile = true}};
        return intern(t, (Ty){.kind = made});
    }
    return of;
}

// `[,]T` (count 2), `[,,]T` (count 3): a block whose sizes are known at run time.
export TypeRef block_of(Table *t, TypeRef element, U64 dimensions) {
    TyKind made = {.block = {.element = element, .count = dimensions}};
    return intern(t, (Ty){.kind = made});
}

// `vec(T, N)`: `count` lanes of `element`.
export TypeRef vector_of(Table *t, TypeRef element, U64 count) {
    TyKind made = {.vector = {.element = element, .count = count}};
    return intern(t, (Ty){.kind = made});
}

export TypeRef stream_of(Table *t, TypeRef element) {
    TyKind made = {.stream = {.element = element}};
    return intern(t, (Ty){.kind = made});
}

export TypeRef option_of(Table *t, TypeRef some) {
    TyKind made = {.option = {.element = some}};
    return intern(t, (Ty){.kind = made});
}

export TypeRef result_of(Table *t, TypeRef ok, TypeRef error) {
    TyKind made = {.result_type = {.element = ok, .error = error}};
    return intern(t, (Ty){.kind = made});
}

// The type `(A, B)`: the elements in order, each made a slot named by its position. A named tuple
// `(count: A, ms: B)` has elements whose `name` is not empty: the name is part of the type.
export TypeRef tuple_of(Table *t, Slot elements[:]) {
    Slot slots[:] = mem::alloc_slice(Slot, countof(elements));
    for (Usize i = 0; i < countof(elements); i++) {
        Str given = elements[i].name;
        slots[i].name = countof(given) > 0 ? given : msg(format::push(i));
        slots[i].type = elements[i].type;
    }
    TyKind made = {.tuple = {.slots = slots}};
    return intern(t, (Ty){.kind = made});
}

export TypeRef fn_value_of(Table *t, TypeRef function) {
    TyKind made = {.fn_value = {.element = function}};
    return intern(t, (Ty){.kind = made});
}

// `result (params...)`; the parameter names are dropped, they are not part of the type.
export TypeRef function_of(Table *t, Slot params[:], TypeRef result, Bool variadic) {
    Slot copy[:] = mem::alloc_slice(Slot, countof(params));
    for (Usize i = 0; i < countof(params); i++)
        copy[i].type = params[i].type;
    TyKind made = {.function = {.slots = copy, .result = result, .variadic = variadic}};
    return intern(t, (Ty){.kind = made});
}

// A record, nominal: every call makes a new type. It is not `complete` (a pointer to it is fine, a value is not)
// until `set_fields`. The pointer is the table's, to be given back to `set_fields`.
export Ty *new_record(Table *t, Str name, Bool is_union) {
    TyKind made = {.record = {.name = name, .is_union = is_union}};
    return add_entry(t, (Ty){.kind = made});
}

static void set_record_fields(Ty *record, Slot fields[:]) {
    if (record->kind != .record) return;
    TyKind made = {.record = {.name = name_of(record),
                              .owner = owner_of(record),
                              .c_name = c_name_of(record),
                              .slots = fields,
                              .is_union = is_union_record(record),
                              .complete = true,
                              .affine = is_affine_record(record)}};
    record->kind = made;
}

static void set_enumeration_fields(Ty *enumeration, Slot fields[:]) {
    if (enumeration->kind != .enumeration) return;
    TyKind made = {.enumeration = {.name = name_of(enumeration),
                                   .element = element_of(enumeration),
                                   .slots = fields,
                                   .complete = true,
                                   .has_payload = is_payload_enum(enumeration)}};
    enumeration->kind = made;
}

// The members of a record or an enumeration, which makes it complete. The kind is rebuilt in place: a payload is
// replaced as a whole, never written field by field.
export void set_fields(Ty *record, Slot fields[:]) {
    if (record->kind == .record) set_record_fields(record, fields);
    if (record->kind == .enumeration) set_enumeration_fields(record, fields);
}

// The module prefix a record is declared in (`lib::math::`).
export void set_owner(Ty *record, Str owner) {
    if (record->kind != .record) return;
    TyKind made = {.record = {.name = name_of(record),
                              .owner = owner,
                              .c_name = c_name_of(record),
                              .slots = slots_of(record).items,
                              .is_union = is_union_record(record),
                              .complete = is_complete(record),
                              .affine = is_affine_record(record)}};
    record->kind = made;
}

// Whether a record is `@affine`, and the C struct it is.
export void set_marks(Ty *record, Bool affine, Str c_name) {
    if (record->kind != .record) return;
    TyKind made = {.record = {.name = name_of(record),
                              .owner = owner_of(record),
                              .c_name = c_name,
                              .slots = slots_of(record).items,
                              .is_union = is_union_record(record),
                              .complete = is_complete(record),
                              .affine = affine}};
    record->kind = made;
}

// Whether the enumerators of an enumeration carry values.
export void set_payload(Ty *enumeration, Bool has_payload) {
    if (enumeration->kind != .enumeration) return;
    TyKind made = {.enumeration = {.name = name_of(enumeration),
                                   .element = element_of(enumeration),
                                   .slots = slots_of(enumeration).items,
                                   .complete = is_complete(enumeration),
                                   .has_payload = has_payload}};
    enumeration->kind = made;
}

// An enumeration, nominal, over the integer type `underlying`.
export Ty *new_enumeration(Table *t, Str name, TypeRef underlying) {
    TyKind made = {.enumeration = {.name = name, .element = underlying, .complete = true}};
    return add_entry(t, (Ty){.kind = made});
}

// ---------------------------------------------------------------------------------------------------------------
// Sizes and alignments: the target's, by C's rules

static U64 round_up(U64 n, U64 align) {
    if (align == 0) return n;
    return (n + align - 1) / align * align;
}

static U64 least(U64 a, U64 b) {
    if (a < b) return a;
    return b;
}

static U64 most(U64 a, U64 b) {
    if (a > b) return a;
    return b;
}

// The fields of a record, the enumerators of an enumeration, the parameters of a function or the slots of a tuple; none
// for every other kind.
export Members slots_of(TypeRef t) {
    Members found = {};
    if (t->kind == .record) found.items = t->kind.record.slots;
    if (t->kind == .enumeration) found.items = t->kind.enumeration.slots;
    if (t->kind == .function) found.items = t->kind.function.slots;
    if (t->kind == .tuple) found.items = t->kind.tuple.slots;
    return found;
}

// The prefix of the module that declares a record (`lib::math::`), empty for the module being checked.
export Str owner_of(TypeRef t) {
    if (t->kind == .record) return t->kind.record.owner;
    return "";
}

// How many parts a type is measured from: the fields of a record, the element of an array, the underlying type of an
// enumeration; none for a leaf.
static Usize part_count(TypeRef t) {
    if (t->kind == .record || t->kind == .tuple) return countof(slots_of(t).items);
    if (t->kind == .array || t->kind == .enumeration || t->kind == .option) return 1;
    return 0;
}

static TypeRef part(TypeRef t, Usize i) {
    if (t->kind == .record || t->kind == .tuple) return slots_of(t).items[i].type;
    return element_of(t);
}

// A vector is `count` lanes, its size and alignment rounded up to a power of two as LLVM's `<N x T>` is.
// Whether the type is a record with its fields set.
static Bool record_complete(TypeRef t) {
    if (t->kind != .record) return false;
    return t->kind.record.complete;
}

// Whether the type is a record whose fields are not set yet (its layout is not known).
static Bool record_incomplete(TypeRef t) {
    if (t->kind != .record) return false;
    return !t->kind.record.complete;
}

// Whether the type is an enumeration whose enumerators carry values.
export Bool is_payload_enum(TypeRef t) {
    if (t->kind != .enumeration) return false;
    return t->kind.enumeration.has_payload;
}

// Whether the type is a union record.
export Bool is_union_record(TypeRef t) {
    if (t->kind != .record) return false;
    return t->kind.record.is_union;
}

// Whether a record or an enumeration has its members; false for any other kind.
export Bool is_complete(TypeRef t) {
    if (t->kind == .record) return t->kind.record.complete;
    if (t->kind == .enumeration) return t->kind.enumeration.complete;
    return false;
}

// Whether the type is a record marked `@affine`.
export Bool is_affine_record(TypeRef t) {
    if (t->kind != .record) return false;
    return t->kind.record.affine;
}

// Whether a pointer, array or slice has a `const` element; false for any other kind.
export Bool points_to_const(TypeRef t) {
    if (t->kind == .pointer) return t->kind.pointer.pointee_const;
    if (t->kind == .array) return t->kind.array.pointee_const;
    if (t->kind == .slice) return t->kind.slice.pointee_const;
    return false;
}

// Whether a pointer, array or slice has a `volatile` element (`*volatile T`); false for any other kind.
export Bool points_to_volatile(TypeRef t) {
    if (t->kind == .pointer) return t->kind.pointer.pointee_volatile;
    if (t->kind == .array) return t->kind.array.pointee_volatile;
    if (t->kind == .slice) return t->kind.slice.pointee_volatile;
    return false;
}

// Whether a function type takes C's `...`; false for any other kind.
export Bool is_variadic(TypeRef t) {
    if (t->kind != .function) return false;
    return t->kind.function.variadic;
}

// The element of a pointer, array, slice, option, stream, block or vector, the ok type of a result, the result of a
// function, the underlying integer of an enumeration, the function of an `Fn`. A type without one is its own element:
// ask only for a kind that has one (#2673: the readers move to a pattern on the kind, then this goes).
export TypeRef element_of(TypeRef t) {
    if (t->kind == .pointer) return t->kind.pointer.element;
    if (t->kind == .array) return t->kind.array.element;
    if (t->kind == .slice) return t->kind.slice.element;
    if (t->kind == .option) return t->kind.option.element;
    if (t->kind == .stream) return t->kind.stream.element;
    if (t->kind == .block) return t->kind.block.element;
    if (t->kind == .vector) return t->kind.vector.element;
    if (t->kind == .result_type) return t->kind.result_type.element;
    if (t->kind == .fn_value) return t->kind.fn_value.element;
    if (t->kind == .function) return t->kind.function.result;
    if (t->kind == .enumeration) return t->kind.enumeration.element;
    return t;
}

// The error type of a result; the type itself for any other kind.
export TypeRef error_of(TypeRef t) {
    if (t->kind == .result_type) return t->kind.result_type.error;
    return t;
}

// The length of an array, the dimensions of a block, the lanes of a vector; 0 for any other kind.
export U64 count_of(TypeRef t) {
    if (t->kind == .array) return t->kind.array.count;
    if (t->kind == .block) return t->kind.block.count;
    if (t->kind == .vector) return t->kind.vector.count;
    return 0;
}

// The C struct a record is, or empty.
export Str c_name_of(TypeRef t) {
    if (t->kind == .record) return t->kind.record.c_name;
    return "";
}

// The name of an integer, floating, record, enumeration or concept type, and of a kind with one spelling (`Void`,
// `Bool`, `Str`, `Auto`, `Null`, `type`, `<error>`).
export Str name_of(TypeRef t) {
    if (t->kind == .integer) return t->kind.integer.name;
    if (t->kind == .floating) return t->kind.floating.name;
    if (t->kind == .record) return t->kind.record.name;
    if (t->kind == .enumeration) return t->kind.enumeration.name;
    if (t->kind == .concept_type) return t->kind.concept_type.name;
    if (t->kind == .symbol) return t->kind.symbol.name;
    if (t->kind == .invalid) return "<error>";
    if (t->kind == .automatic) return "Auto";
    if (t->kind == .void_type) return "Void";
    if (t->kind == .bool_type) return "Bool";
    if (t->kind == .text) return "Str";
    if (t->kind == .null_type) return "Null";
    if (t->kind == .type_type) return "type";
    return "";
}

// The width of an integer or floating type in bits; 0 for any other kind.
export U32 bits_of(TypeRef t) {
    if (t->kind == .integer) return t->kind.integer.bits;
    if (t->kind == .floating) return t->kind.floating.bits;
    return 0;
}

// Whether an integer type is signed (a floating type is, by its sign bit); false for any other kind.
export Bool signed_of(TypeRef t) {
    if (t->kind == .integer) return t->kind.integer.is_signed;
    return t->kind == .floating;
}

static Layout vector_layout(const Target *target, TypeRef t) {
    if (t->kind != .vector) return (Layout){.size = 1, .align = 1, .known = true};
    TypeRef lane_type = t->kind.vector.element;
    U64 count = t->kind.vector.count;
    U64 lane = 1;
    if (lane_type->kind != .bool_type) lane = bits_of(lane_type) / 8;
    U64 size = 1;
    while (size < lane * count)
        size *= 2;
    return (Layout){.size = size, .align = least(size, target->max_align), .known = true};
}

// A type with no parts: its size and alignment from the target alone.
static Layout leaf_layout(const Target *target, TypeRef t) {
    U64 word = target->pointer_bytes;
    Layout none = {};
    if (t->kind == .bool_type) return (Layout){.size = 1, .align = 1, .known = true};
    if (t->kind == .integer || t->kind == .floating) {
        U64 bytes = bits_of(t) / 8;
        return (Layout){.size = bytes, .align = least(bytes, target->max_align), .known = true};
    }
    if (t->kind == .pointer || t->kind == .fn_value || t->kind == .function || t->kind == .null_type ||
        t->kind == .stream)
        return (Layout){.size = word, .align = word, .known = true};
    if (t->kind == .slice || t->kind == .text) return (Layout){.size = 2 * word, .align = word, .known = true};
    if (t->kind == .vector) return vector_layout(target, t);
    if (record_complete(t) || t->kind == .tuple) return (Layout){.size = 0, .align = 1, .known = true};
    return none;
}

struct Frame {
    TypeRef type;
    Usize next;
    U64 size;
    U64 align;
    Bool known;
};

// Folds the layout of one part into the frame of its parent.
static void absorb(Frame *f, Layout part_layout) {
    if (!part_layout.known) f->known = false;
    if (f->type->kind == .array) {
        f->size = part_layout.size * f->type->kind.array.count;
        f->align = part_layout.align;
    } else if (f->type->kind == .enumeration) {
        f->size = part_layout.size;
        f->align = part_layout.align;
    } else if (f->type->kind == .option) { // `?*T` is the pointer (null is `.none`); any other `?T` is a tag and `T`
        f->size = f->type->kind.option.element->kind == .pointer ? part_layout.size
                                                                 : round_up(1, part_layout.align) + part_layout.size;
        f->align = part_layout.align;
    } else if (is_union_record(f->type)) {
        f->size = most(f->size, part_layout.size);
        f->align = most(f->align, part_layout.align);
    } else {
        U64 offset = round_up(f->size, part_layout.align);
        f->size = offset + part_layout.size;
        f->align = most(f->align, part_layout.align);
    }
}

constexpr Usize layout_depth = 64;

// The size and alignment of `t` on `target`. A record nested deeper than 64 levels, or containing itself by value,
// is not `known`.
export Layout layout(const Target *target, TypeRef t) {
    Layout answer = {};
    if (part_count(t) == 0) return leaf_layout(target, t);
    Frame stack[layout_depth];
    Usize top = 1;
    stack[0] = (Frame){.type = t, .align = 1, .known = !record_incomplete(t)};
    Layout finished = {};
    Bool have_finished = false;
    while (top > 0) {
        Frame *f = &stack[top - 1];
        if (have_finished) {
            absorb(f, finished);
            have_finished = false;
        }
        if (f->next < part_count(f->type)) {
            TypeRef child = part(f->type, f->next);
            f->next += 1;
            if (part_count(child) == 0) {
                finished = leaf_layout(target, child);
                have_finished = true;
            } else if (top == layout_depth) {
                return answer;
            } else {
                stack[top] = (Frame){.type = child, .align = 1, .known = !record_incomplete(child)};
                top += 1;
            }
            continue;
        }
        U64 size = f->size;
        if (f->type->kind == .record || f->type->kind == .tuple || f->type->kind == .option)
            size = round_up(f->size, f->align);
        finished = (Layout){.size = size, .align = f->align, .known = f->known};
        have_finished = true;
        top -= 1;
        if (top == 0) answer = finished;
    }
    return answer;
}

// ---------------------------------------------------------------------------------------------------------------
// Types as text, for messages

struct Output {
    char data[:];
    Usize length;
};

static void reserve(Output *text, Usize more) {
    Usize needed = text->length + more;
    if (needed <= countof(text->data)) return;
    Usize capacity = countof(text->data) * 2;
    if (capacity < needed) capacity = needed;
    if (capacity < 64) {
        capacity = 64;
    }
    char grown[:] = mem::alloc_slice(char, capacity);
    for (Usize i = 0; i < text->length; i++)
        grown[i] = text->data[i];
    text->data = grown;
}

static void put(Output *text, Str piece) {
    reserve(text, countof(piece));
    for (Usize i = 0; i < countof(piece); i++)
        text->data[text->length + i] = piece[i];
    text->length += countof(piece);
}

static void put_number(Output *text, U64 number) {
    char digits[40];
    Usize written = format::write(digits, sizeof digits, number).length;
    put(text, digits[0:written]);
}

// A piece still to write: a type, or a word.
// A piece of `show`'s output: a type to expand, or a word written as it is. A word's type is `no_type`, never null, so
// the field reads as a plain pointer in smith's own syntax too.
struct Piece {
    TypeRef type;
    Str word;
    Bool is_word;
};

static const Ty no_type = {.kind = .invalid};

static void push_piece(Piece stack[:], Usize *top, Piece piece) {
    stack[*top] = piece;
    *top += 1;
}

static Piece word(Str text) {
    return (Piece){.type = &no_type, .word = text, .is_word = true};
}

static Piece of(TypeRef type) {
    return (Piece){.type = type, .word = "", .is_word = false};
}

// A tuple `(A, B)`: one piece per slot, a written name before its type (`count: i32`), and `(A,)` for one.
static void push_tuple(Piece stack[:], Usize *top, Output *text, Slot slots[:]) {
    if (countof(slots) == 1)
        push_piece(stack, top, word(",)"));
    else
        push_piece(stack, top, word(")"));
    for (Usize i = countof(slots); i > 0; i--) {
        push_piece(stack, top, of(slots[i - 1].type));
        if (!is_position(slots[i - 1].name)) push_piece(stack, top, word(msg(format::push(slots[i - 1].name, ": "))));
        if (i > 1) push_piece(stack, top, word(", "));
    }
    put(text, "(");
}

// The pieces of a function type `R (P1, P2, ...)`.
static void push_function(Piece stack[:], Usize *top, TypeRef t) {
    if (t->kind != .function) return;
    push_piece(stack, top, word(")"));
    if (t->kind.function.variadic) push_piece(stack, top, word(", ..."));
    for (Usize i = countof(t->kind.function.slots); i > 0; i--) {
        push_piece(stack, top, of(t->kind.function.slots[i - 1].type));
        if (i > 1) push_piece(stack, top, word(", "));
    }
    push_piece(stack, top, word(" ("));
    push_piece(stack, top, of(t->kind.function.result));
}

// The pieces of `first, second)`, for `Result(` to precede.
static void push_pair(Piece stack[:], Usize *top, TypeRef first, TypeRef second) {
    push_piece(stack, top, word(")"));
    push_piece(stack, top, of(second));
    push_piece(stack, top, word(", "));
    push_piece(stack, top, of(first));
}

// Pushes the pieces of `t` so that the first to write is on top. A type has at most 4 + 2 * its parameters pieces.
static void expand(Piece stack[:], Usize *top, Output *text, TypeRef t) {
    if (t->kind == .pointer) {
        push_piece(stack, top, word(" *"));
        push_piece(stack, top, of(element_of(t)));
        if (points_to_const(t)) put(text, "const ");
        if (points_to_volatile(t)) put(text, "volatile ");
    } else if (t->kind == .array) {
        push_piece(stack, top, word(msg(format::push("[", count_of(t), "]"))));
        push_piece(stack, top, of(element_of(t)));
        if (points_to_const(t)) put(text, "const ");
        if (points_to_volatile(t)) put(text, "volatile ");
    } else if (t->kind == .slice) {
        push_piece(stack, top, word("[:]"));
        push_piece(stack, top, of(element_of(t)));
        if (points_to_const(t)) put(text, "const ");
        if (points_to_volatile(t)) put(text, "volatile ");
    } else if (t->kind == .block) {
        push_piece(stack, top, word(count_of(t) == 2 ? "[,]" : "[,,]"));
        push_piece(stack, top, of(element_of(t)));
    } else if (t->kind == .vector) {
        push_piece(stack, top, word(msg(format::push(", ", count_of(t), ")"))));
        push_piece(stack, top, of(element_of(t)));
        put(text, "vec(");
    } else if (t->kind == .option) {
        push_piece(stack, top, word(")"));
        push_piece(stack, top, of(element_of(t)));
        put(text, "Option(");
    } else if (t->kind == .stream) {
        push_piece(stack, top, word(")"));
        push_piece(stack, top, of(element_of(t)));
        put(text, "stream::Stream(");
    } else if (t->kind == .result_type) {
        push_pair(stack, top, element_of(t), error_of(t));
        put(text, "Result(");
    } else if (t->kind == .tuple) {
        push_tuple(stack, top, text, slots_of(t).items);
    } else if (t->kind == .fn_value) {
        push_piece(stack, top, word(")"));
        push_piece(stack, top, of(element_of(t)));
        put(text, "Fn(");
    } else if (t->kind == .function) {
        push_function(stack, top, t);
    } else
        put(text, name_of(t));
}

// The type as a user writes it, in the current allocator.
export Str show(TypeRef t) {
    Output text = {};
    Usize capacity = 16;
    Piece stack[:] = mem::alloc_slice(Piece, capacity);
    Usize top = 0;
    push_piece(stack, &top, of(t));
    while (top > 0) {
        top -= 1;
        Piece piece = stack[top];
        TypeRef shown = piece.type;
        Usize pushes = 0;
        if (!piece.is_word) pushes = 2 * countof(slots_of(shown).items);
        while (top + 8 + pushes + 2 * layout_depth > capacity) {
            capacity *= 2;
            stack = mem::realloc(stack, capacity);
        }
        if (piece.is_word) {
            put(&text, piece.word);
            continue;
        }
        expand(stack, &top, &text, shown);
    }
    return text.data[0:text.length];
}

// ---------------------------------------------------------------------------------------------------------------
// Scopes and the symbol table

export typedef enum {
    variable;
    function_symbol;
    type_name;
    module_name;
} SymbolKind;

// A name and what it means. `is_const` is the variable's own `const`, and in smith's own syntax (`is_new`, #1524)
// the absence of `mut`: constant is the default there.
export struct Symbol {
    Str name;
    SymbolKind kind;
    TypeRef type;
    const ast::Decl *decl;
    Bool is_const;
    Bool is_volatile; // a variable written `volatile T` (`mut sink: volatile u64 = 0`): every read and write is made
    Bool is_new;      // declared in smith's own syntax (`let x = v`, `x: T = v`, `mut x`, a parameter `x: T`)
    Bool exported;
    // Where a fix-it mends it (#1516): the binding's span (empty: it has none, so no fix), whether a fix may put
    // `mut` before its name, the type as written (null: none) and the initializer (null: none).
    ast::Span at;
    Bool may_mut;
    const ast::TypeExpr *written;
    const ast::Expr *init;
    Bool generic; // a function with compile-time parameters (`T: type`, `const n: usize`): a template, no body checked
    Bool has_value; // a compile-time parameter bound in an instance (`n`): `value` is what the call passed
    U64 value;
    Bool narrowed;  // a `?T` name known not to be `.none` here, typed `T` (#2481): `x.some` is `x`
    Bool loop_name; // the name of a `for x in xs` (`at` is its span): `*x` of it is `for mut x`, `x` (#3251)
    U64 excluded;   // a payload enumeration name known not to be some variants here: bit `i` is the slot `i` (#3225)
    Bool by_equal;  // the narrowing was made by `==` or `!=`, which the fixer writes as a binding, not by `is` (#3587)
};

// An index of the names of `symbols[0:indexed)` (#2888): a module that imports std holds tens of thousands of symbols
// (the C headers' above all), and a scan of all of them for each declaration and each name made the check quadratic.
// A name hashes to a bucket; `heads[b]` is one more than the highest index in bucket `b` (0: none), and `next[i]` one
// more than the next lower index in the bucket of symbol `i`, so a walk meets the newest first, as the scan did.
//
// The index is a cache and never decides: it is used only while `data` is still where the symbols are, and it follows
// `count` before each search (`index_follow`): the symbols past `indexed` are added, and when `count` went below it
// (a scope ended) the newest are taken out again, by the hash kept for each. A symbol is only ever written at `count`
// or over one of the same name (a forward-declared struct), so the names below `indexed` are those it was built from.
export struct ScopeIndex {
    const Symbol *data;
    Usize indexed;
    U32 heads[:];
    U32 next[:];
    U32 hashes[:];
};

// The stack of scopes: `marks[d]` is where scope `d + 1` starts in `symbols`; scope 0 (the module's) always exists.
export struct Scopes {
    Symbol symbols[:];
    Usize count;
    Usize marks[:];
    Usize depth;
    Str prefix;   // while the body of a generic's instance from another module is checked: that module's prefix
    Usize floor;  // the symbols from here on are the body's own (locals, the bound generics): they hide the module's
    Bool prelude; // `std.prelude` is declared (as `std::prelude::name`): a bare name nothing else declares is its
    ScopeIndex *index; // null until a scope has enough names to need one; a copy of the struct shares it
};

export void push_scope(Scopes *s) {
    if (s->depth == countof(s->marks)) {
        Usize capacity = countof(s->marks) * 2;
        if (capacity < 16) capacity = 16;
        s->marks = mem::realloc(s->marks, capacity);
    }
    s->marks[s->depth] = s->count;
    s->depth += 1;
}

// Leaves the innermost scope, forgetting its names. The module's own scope stays.
export void pop_scope(Scopes *s) {
    if (s->depth == 0) return;
    s->depth -= 1;
    s->count = s->marks[s->depth];
}

static Usize scope_start(const Scopes *s) {
    if (s->depth == 0) return 0;
    return s->marks[s->depth - 1];
}

// A scope with this many symbols gets an index; fewer are scanned.
constexpr Usize index_gap = 256;

static U32 name_hash(Str name) {
    U32 h = 2166136261U;
    for (Usize i = 0; i < countof(name); i++)
        h = (h ^ (U32)(U8)name[i]) * 16777619U;
    return h;
}

// Puts symbol `i` at the head of its bucket; the index has room for it.
static void index_add(const Scopes *s, Usize i) {
    ScopeIndex *x = s->index;
    U32 hash = name_hash(s->symbols[i].name);
    Usize b = hash & (countof(x->heads) - 1);
    x->hashes[i] = hash;
    x->next[i] = x->heads[b];
    x->heads[b] = (U32)(i + 1);
}

// Builds the index over every symbol of `s`.
static void index_build(const Scopes *s) {
    ScopeIndex *x = s->index;
    Usize buckets = 1024;
    while (buckets < 2 * countof(s->symbols))
        buckets *= 2;
    if (countof(x->heads) != buckets) {
        mem::free(x->heads.data);
        x->heads = mem::alloc_slice(U32, buckets);
    } else {
        for (Usize b = 0; b < buckets; b++)
            x->heads[b] = 0;
    }
    if (countof(x->next) < countof(s->symbols)) {
        mem::free(x->next.data);
        mem::free(x->hashes.data);
        x->next = mem::alloc_slice(U32, countof(s->symbols));
        x->hashes = mem::alloc_slice(U32, countof(s->symbols));
    }
    for (Usize i = 0; i < s->count; i++)
        index_add(s, i);
    x->data = s->symbols.data;
    x->indexed = s->count;
}

// Brings the index to `symbols[0:count)`: the symbols added since are put in, those taken out since (a scope ended) are
// taken out newest first, which leaves each bucket as it was before them. A moved array is indexed again.
static void index_follow(const Scopes *s) {
    ScopeIndex *x = s->index;
    if (x->data != s->symbols.data || countof(x->next) < countof(s->symbols)) {
        index_build(s);
        return;
    }
    while (x->indexed > s->count) {
        x->indexed -= 1;
        x->heads[x->hashes[x->indexed] & (countof(x->heads) - 1)] = x->next[x->indexed];
    }
    while (x->indexed < s->count) {
        index_add(s, x->indexed);
        x->indexed += 1;
    }
}

// One more than the highest index below `upper` whose symbol is called `name`; 0 when none is.
static Usize find_below(const Scopes *s, Str name, Usize upper) {
    if (upper > s->count) upper = s->count;
    if (s->index == nullptr) {
        for (Usize i = upper; i > 0; i--) {
            if (same_text(s->symbols[i - 1].name, name)) return i;
        }
        return 0;
    }
    index_follow(s);
    const ScopeIndex *x = s->index;
    U32 at = x->heads[name_hash(name) & (countof(x->heads) - 1)];
    while (at != 0) {
        Usize i = at - 1;
        if (i < upper && same_text(s->symbols[i].name, name)) return i + 1;
        at = x->next[i];
    }
    return 0;
}

// The innermost symbol below `upper` called `name`, or null.
static const Symbol *named_below(const Scopes *s, Str name, Usize upper) {
    Usize found = find_below(s, name, upper);
    return found == 0 ? nullptr : &s->symbols[found - 1];
}

// Room for one more symbol. A scope that grew large enough gets an index (its first use builds it).
static void make_room(Scopes *s) {
    if (s->count == countof(s->symbols)) {
        Usize capacity = countof(s->symbols) * 2;
        if (capacity < 64) capacity = 64;
        s->symbols = mem::realloc(s->symbols, capacity);
    }
    if (s->index == nullptr && s->count >= index_gap) s->index = mem::alloc(ScopeIndex);
}

// Adds `symbol` to the innermost scope; false, and nothing added, when that scope has the name already.
export Bool declare(Scopes *s, Symbol symbol) {
    if (find_below(s, symbol.name, s->count) > scope_start(s)) return false;
    make_room(s);
    s->symbols[s->count] = symbol;
    s->count += 1;
    return true;
}

// `declare` for a C header's declaration: a struct tag and a function of one name (`struct stat`, `stat()`) live side
// by side (#2610), told apart by `lookup_as`; two of the same kind (two headers' `size_t`) keep the first.
static Bool names_type(const Symbol *s) {
    return s->kind == .type_name;
}

static Bool declare_beside(Scopes *s, Symbol symbol) {
    Usize start = scope_start(s);
    for (Usize at = find_below(s, symbol.name, s->count); at > start; at = find_below(s, symbol.name, at - 1)) {
        if (names_type(&s->symbols[at - 1]) == names_type(&symbol)) return false;
    }
    make_room(s);
    s->symbols[s->count] = symbol;
    s->count += 1;
    return true;
}

// Adds `symbol` to the innermost scope over a name that is declared already: a `?T` name that is known not to be
// `.none` from here to the end of the scope has the type `T` (#2481). `lookup` finds the newest, so the narrowed one
// wins.
export void narrow(Scopes *s, Symbol symbol) {
    make_room(s);
    s->symbols[s->count] = symbol;
    s->count += 1;
}

// Whether `symbol` is a narrowing `narrow` added over a name, not the name's own declaration.
static Bool is_narrowing(const Symbol *symbol) {
    return symbol->narrowed || symbol->excluded != 0;
}

// Whether the newest `name` is a local of the function being checked (a parameter, a local, a binding), not a global.
export Bool is_local(const Scopes *s, Str name) {
    Usize at = find_below(s, name, s->count);
    if (at == 0 || s->depth == 0) return false;
    return at > s->marks[0] && at > s->floor;
}

// The declaration of `name` under the narrowings that were added over it: null when there is none.
export const Symbol *declared(const Scopes *s, Str name) {
    Usize at = find_below(s, name, s->count);
    while (at > 0 && is_narrowing(&s->symbols[at - 1]))
        at = find_below(s, name, at - 1);
    return at == 0 ? nullptr : &s->symbols[at - 1];
}

// Drops what a test proved about `name`: every narrowing over it becomes the declaration again, in the scope that holds
// it, so the end of the scope that assigned does not bring it back (#3438, item 55 of #3284).
export void unnarrow(Scopes *s, Str name) {
    Usize top = find_below(s, name, s->count);
    if (top == 0 || !is_narrowing(&s->symbols[top - 1])) return;
    const Symbol *base = declared(s, name);
    if (base == nullptr) return;
    Symbol own = *base;
    for (Usize at = top; at > 0 && is_narrowing(&s->symbols[at - 1]); at = find_below(s, name, at - 1)) {
        s->symbols[at - 1] = own;
    }
}

// Whether `name` is `prefix` or a field path under it (`a.kind.b` under `a.kind` and under `a`).
static Bool is_under(Str name, Str prefix) {
    if (countof(name) < countof(prefix)) return false;
    for (Usize i = 0; i < countof(prefix); i++) {
        if (name[i] != prefix[i]) return false;
    }
    return countof(name) == countof(prefix) || name[countof(prefix)] == '.';
}

// Drops what tests proved about the field path `prefix` and every path under it (#3587, item 68 of #3516): the path
// was written, or a pointer to it or to a part of it was handed out.
export void unnarrow_under(Scopes *s, Str prefix) {
    for (Usize at = s->count; at > 0; at--) {
        const Symbol *symbol = &s->symbols[at - 1];
        if (!is_narrowing(symbol) || !is_under(symbol->name, prefix)) continue;
        unnarrow(s, symbol->name);
    }
}

export Bool is_public(const Symbol *s);

static Bool has_separator(Str name) {
    for (Usize i = 0; i + 1 < countof(name); i++) {
        if (name[i] == ':' && name[i + 1] == ':') return true;
    }
    return false;
}

// The public declaration `name` of `std.prelude`, which every module sees without an import (#2669): its concepts and
// loop helpers. Only a name nothing else declares reaches it, so a module's own `range` wins. Null without a prelude.
static const Symbol *prelude_symbol(const Scopes *s, Str name) {
    if (!s->prelude || countof(name) == 0 || has_separator(name)) return nullptr;
    Str full = msg(format::push("std::prelude::", name));
    const Symbol *found = named_below(s, full, s->count);
    if (found == nullptr) return nullptr;
    return is_public(found) ? found : nullptr;
}

// The innermost symbol called `name`, or null. In the body of a generic instance from another module the body's own
// names come first, then the module's (`util::name`), then the names of the module being checked, then the prelude's.
export const Symbol *lookup(const Scopes *s, Str name) {
    if (countof(s->prefix) > 0) {
        Usize body = find_below(s, name, s->count);
        if (body > s->floor) return &s->symbols[body - 1];
        Str own = msg(format::push(s->prefix, name));
        const Symbol *module = named_below(s, own, s->floor);
        if (module != nullptr) return module;
    }
    const Symbol *found = named_below(s, name, s->count);
    if (found != nullptr) return found;
    return prelude_symbol(s, name);
}

// `lookup` as a declaration sees it, to tell whether a new name hides another: in the body of a generic instance from
// another module only the body's own names and that module's (`util::name`) count, not those of the module being
// checked, which the body cannot see by its own name (#2669). Elsewhere it is `lookup`.
export const Symbol *lookup_own(const Scopes *s, Str name) {
    if (countof(s->prefix) == 0) return lookup(s, name);
    Usize body = find_below(s, name, s->count);
    if (body > s->floor) return &s->symbols[body - 1];
    Str own = msg(format::push(s->prefix, name));
    return named_below(s, own, s->floor);
}

// The symbol `name` stands for in a type position (`want_type`) or a value position: a C header has a struct tag and a
// function of one name (`struct stat` and `stat()`, #2610), kept apart here by position. Falls back to the other kind
// when only that one exists, so every other name reads as before.
export const Symbol *lookup_as(const Scopes *s, Str name, Bool want_type) {
    for (Usize at = find_below(s, name, s->count); at > 0; at = find_below(s, name, at - 1)) {
        const Symbol *found = &s->symbols[at - 1];
        if (names_type(found) == want_type) return found;
    }
    return lookup(s, name);
}

// The innermost symbol whose whole name is `path`, or null (`c::printf` is the name `c::printf`).
static Str prefix_of_symbol(const Symbol *s);

// `math_trig::lerp` in the body of an instance of std.math's generic, read in today's syntax as an import is: the
// first name is a module std.math imports (the symbol `std::math::math_trig`), so the rest is a name of that module
// (`std::math_trig::lerp`), as `math_trig.lerp` reads through `through_modules` (#2669). Null when it is not one.
static const Symbol *through_own_import(const Scopes *s, ast::Path path) {
    if (countof(path.segments) < 2) return nullptr;
    Str module_name = msg(format::push(s->prefix, path.segments[0].text));
    const Symbol *module = nullptr;
    for (Usize at = find_below(s, module_name, s->floor); at > 0 && module == nullptr;
         at = find_below(s, module_name, at - 1)) {
        const Symbol *candidate = &s->symbols[at - 1];
        if (candidate->kind == .module_name) module = candidate;
    }
    if (module == nullptr) return nullptr;
    Str full = prefix_of_symbol(module);
    if (countof(full) == 0) return nullptr;
    for (Usize k = 1; k < countof(path.segments); k++)
        full = msg(format::push(full, k > 1 ? "::" : "", path.segments[k].text));
    return named_below(s, full, s->floor);
}

export const Symbol *lookup_path(const Scopes *s, ast::Path path) {
    if (countof(path.segments) == 0) return nullptr;
    // A symbol's whole name is the path when it is the segments joined by `::` (`is_path`).
    Str joined_path = path.segments[0].text;
    for (Usize k = 1; k < countof(path.segments); k++)
        joined_path = msg(format::push(joined_path, "::", path.segments[k].text));
    if (countof(s->prefix) > 0) {
        Usize body = find_below(s, joined_path, s->count);
        if (body > s->floor) return &s->symbols[body - 1];
        Str own = msg(format::push(s->prefix, joined_path));
        const Symbol *module = named_below(s, own, s->floor);
        if (module != nullptr) return module;
        const Symbol *through = through_own_import(s, path);
        if (through != nullptr) return through;
    }
    const Symbol *found = named_below(s, joined_path, s->count);
    if (found != nullptr) return found;
    if (countof(path.segments) == 1) return prelude_symbol(s, path.segments[0].text);
    return nullptr;
}

// ---------------------------------------------------------------------------------------------------------------
// The result

export struct Error {
    Str message; // `$line` in it is the line of `related` when the message is printed
    ast::Span span;
    Bool has_related;    // another place the error is about, printed as a `note:` (the first use, #1986)
    ast::Span related;   // where
    Str related_message; // and what the note says
    syntax::Edits fix;   // the edits `smith lint --fix` applies together (#1516); empty: none
    // An error found in the body of an instance of a generic from another module (#2669): its fix edits that module's
    // text, not this file's, so it is kept apart from `fix`. `fix_module` is that module's prefix (`std::math_trig::`)
    // and the spans of `module_fix` are offsets in the text the module was read from (as an import, mended).
    Str fix_module;
    syntax::Edits module_fix;
    // The prefix of the module whose text `span` is in (`std::test::`) when the error was found while checking that
    // module's declarations or an instance of its generic; empty for the file being checked. The driver reports such an
    // error at that module's file and line, not one past the end of the importer (#2669).
    Str module;
    // The instance of a generic whose body was being checked (#2949), for the error trace.
    Bool in_instance;
    Usize instance;
    // A construction that leaves a field out (#2329): the call, the record, and which fields (bit k for field k) it
    // gives. The fixer writes the zero values (`front::fix_zero`), which the checker cannot spell without its imports.
    const ast::Expr *left_out_call;
    const Ty *left_out_record;
    U64 left_out_given;
};

// One entry of the side table.
export struct NodeType {
    const ast::Expr *node;
    Usize instance; // the instance whose body holds the node, or `max_instances` (also the latest record) (#2669)
    TypeRef type;
    Bool cast_checked; // a written cast that can lose a value: the emitter checks it at run time (K1, #1328)
    TypeRef cast_from; // the operand's type, when `cast_checked`
    Bool has_length;   // an array length written as constants (`[k.SIDE * 2]u8`): the value is `length`
    U64 length;
    const ast::Expr *method; // a method call `x.f(a)`: the call `f(x, a)` it stands for, which has the types (#1795)
    Bool decided;            // the condition of an `if` that asks about types: one branch is kept (#1902)
    Bool keeps_then;         // when `decided`: the `then` branch is the one kept, else the `else` branch
    Bool has_value; // an expression the checker computed (`small(T)`, `u8 != i8`): its value is `value` (#3039)
    U64 value;
};

// A test of a payload enumeration's variant, `if k == .v:` or `if k != .v: return`, kept for the fix of the reads `k.v`
// it guards: `if .v(v) := k:` or `.v(v) := k else: return`, and each read is `v` (#2494).
export struct Guard {
    const ast::Expr *base; // `k`
    Str variant;           // `v`, which is also the name the fix binds unless `bound` is set
    Str bound;             // the name the fix binds when `v` is taken in the function: `v_value` (empty: `v`)
    ast::Span reads;       // the reads inside this span are the test's
    ast::Span skip;        // except those in this one: the `else` of `k != .v: return`, which runs without `v`
    syntax::Edits head;    // the edits that write the test itself
    Bool head_sent;        // the first read carries them
    Bool spoiled;          // a write through `k.v`, a change of `k` or a local named `v` leaves the site (#2503)
    // A test of an option field, `if a.f != nullptr:` or `if a.f == nullptr: return` (#2557): `variant` is the field,
    // the fix binds it, `if f := a.f:` or `f := a.f else: return`, and each read `a.f` is `f`.
    Bool option;
    const ast::Expr *test;  // the comparison `a.f != nullptr`
    syntax::Edits null_fix; // the comparison's own fix, `nullptr` as `.none`, for when no read takes the head
    Usize null_error;       // the comparison's error, plus one (0: none)
};

export struct Checked;

// What J1d supplies: checks the body of one function of the module (its scopes are already set up to the module's).
export typedef void (*BodyChecker)(Checked *r, const ast::Decl *function);

// Gives the module at a dotted path (`std.math`, NUL-terminated), or null when there is none (#1677). Without one, an
// import declares its alias and nothing from the module.
export typedef const ast::Module *(*ModuleLoader)(const char *path);

// Gives the declarations of the C header `import <h>;` (angled) or `import "h";` names, each with `from_c` set
// (front::cimport, #1762), or null when it cannot be read. Without one, a C import declares nothing.
export typedef const ast::Module *(*HeaderLoader)(Str header, Bool angled);

// Gives the type of an expression (J1b's `infer`), for `typeof(a + b)` in a type; this file cannot import it (#1918).
export typedef TypeRef (*ExprTyper)(Checked *r, const ast::Expr *e);

// Gives the value of an expression that must be an integer known at compile time and not negative, such as an array
// length (#3039). `what` names what needs it ("an array length") and makes the folder report the reason when the value
// is not known; an empty `what` asks quietly. J1d sets it to `front::eval`, which this file cannot import.
export typedef Bool (*LengthFolder)(Checked *r, const ast::Expr *e, Str what, U64 *out);

// Gives the type of a module-level constant written without one whose initializer is no literal
// (`const words = page / sizeof(usize)`, #3039): the type of the value the compiler computes, or null when it computes
// none. J1d sets it to `front::eval`'s.
export typedef TypeRef (*ConstantTyper)(Checked *r, const ast::Expr *init);

// Gives the type an applied type is when its name is a function that returns a type (`Pair(i32)`, `widen(T)`,
// #3039): the function is run with the arguments. Null when the name is no function; an error is reported by the
// typer, which then gives the invalid type. J1d sets it to `front::eval`'s.
export typedef TypeRef (*AppliedTyper)(Checked *r, const ast::TypeExpr *applied);

// Gives the type a call is when it calls a function that returns a type (`IntPair := Pair(i32)`); null when `e` is
// no such call. An error is reported by the holder, which then gives the invalid type.
export typedef TypeRef (*TypeHolder)(Checked *r, const ast::Expr *e);

// Why the last `ModuleLoader` call returned null although the module exists: "<file>:<line>: <first parse error>", or
// "" when the module is not there. The loader sets it on each call; `collect_imports` reads it (#2224).
static Str load_failure_text = "";

export void set_load_failure(Str text) {
    load_failure_text = text;
}

export struct Options {
    Target target;
    BodyChecker bodies;     // null: bodies are not checked
    ExprTyper expression;   // null: `typeof` of an expression that is not a name is refused
    LengthFolder length;    // null: only an integer literal is a length
    ConstantTyper constant; // null: a constant written without a type takes one only from a literal
    AppliedTyper applied;   // null: an applied type is only a built-in one (`Option(T)`)
    TypeHolder held;        // null: a call is never a type
    ModuleLoader load;      // null: imports are not read
    HeaderLoader headers;   // null: C headers are not read
};

// What a call passed for one compile-time parameter of a generic function (#1908, part of #1700): a type, or a value.
export struct Binding {
    Str name;
    Bool is_type;
    TypeRef type; // the type passed (`is_type`), else the type of the parameter
    U64 value;
};

// One instance of a generic function: its declaration cloned with the compile-time parameters taken out, and what
// they are bound to. Its body is checked after the bodies of the module (`types_decl::check_instances`).
export struct Instance {
    const ast::Decl *template;
    ast::Decl *decl;
    Binding bindings[:];
    TypeRef signature;
    Bool checked;
    Str prefix; // the module the template is declared in, as its names carry it (`util::`), empty for this one
};

export const Usize max_instances = 256;

// A type a type function made (`Pair(i32)`): one type for one name, however many times the call is written.
export struct MadeType {
    Str name;
    TypeRef type;
};

// The name `import c <stdio.h>` binds (`stdio`, or the `as` name) and the header's declarations, which are also
// declared as `c::name` (one entity however many bindings reach it, #1678).
export struct HeaderBinding {
    Str name;
    const ast::Module *header;
    Str owner; // the prefix of the imported module that wrote the import (`fmt::`), empty for the module itself
};

export const Usize max_header_bindings = 128;

// The instance a call of a generic function was checked against (the emitter reads it).
export struct InstanceUse {
    const ast::Expr *call;
    Usize instance;
    Usize outer; // the instance whose body holds the call, or `max_instances` for a call outside any instance
    Str module;  // the prefix of the module the call is in (#2949), empty for the file being compiled
};

export struct Checked {
    Options options;
    HeaderBinding bindings[:]; // `max_header_bindings` of them
    Usize binding_count;
    Instance instances[:];
    Usize instance_count;
    InstanceUse uses[:]; // the calls of generic functions, each with its instance
    Usize use_count;
    Usize current;   // the instance whose body is being checked, or `max_instances` (#2669)
    Bool new_body;   // the function being checked has a parameter or a local in smith's own syntax (so far)
    Bool new_syntax; // the type being resolved is written in smith's own syntax (`x: int`): lowercase names, concepts
    Bool in_header;  // the declarations of a C header are being declared: a repeated name is not an error
    Str prefix;      // `m::` while the declarations of the module imported as `m` are declared; else empty
    Table table;
    Scopes scopes;
    NodeType nodes[:]; // open addressing on the node's address; a null node is an empty slot
    Usize node_count;
    Error errors[:];
    Usize error_count;
    Guard guards[:]; // the variant tests of the function being checked (#2494)
    Usize guard_count;
    Usize paths; // the field paths (`a.kind`) a test narrowed so far in this module: zero means no read looks for one
                 // (#3587)
    MadeType made[:]; // the types the type functions made so far
    Usize made_count;
    const ast::Module *module; // the module as checked for the system smith runs on (`when::live_module`), null when
                               // it is the one given (#2277): the emitter emits this one
};

// Records an error; the checking goes on. `message` is copied into the current allocator.
export void fail(Checked *r, ast::Span span, Str message) {
    if (r->error_count == countof(r->errors)) {
        Usize capacity = countof(r->errors) * 2;
        if (capacity < 8) capacity = 8;
        r->errors = mem::realloc(r->errors, capacity);
    }
    r->errors[r->error_count] = (Error){.message = msg(format::push(message)),
                                        .span = span,
                                        .module = r->prefix,
                                        .in_instance = r->current != max_instances,
                                        .instance = r->current,
                                        .left_out_call = nullptr,
                                        .left_out_record = nullptr};
    r->error_count += 1;
}

// Records the error of a construction that leaves a field out: `call` builds `record` and gives the fields marked in
// `given` (bit k for field k; a record of more than 64 fields is not recorded for the fixer).
export void fail_left_out(Checked *r, ast::Span span, Str message, const ast::Expr *call, const Ty *record, U64 given) {
    fail(r, span, message);
    if (countof(slots_of(record).items) <= 64) {
        r->errors[r->error_count - 1].left_out_call = call;
        r->errors[r->error_count - 1].left_out_record = record;
        r->errors[r->error_count - 1].left_out_given = given;
    }
}

// Records an error at `span` that is also about another place: `related` gets the note `related_message`, and a `$line`
// in `message` becomes the line of `related`.
export void fail_related(Checked *r, ast::Span span, Str message, ast::Span related, Str related_message) {
    fail(r, span, message);
    Error *e = &r->errors[r->error_count - 1];
    e->has_related = true;
    e->related = related;
    e->related_message = related_message;
}

// A message built with format::push, kept as a `Str` (for an error that is rewritten after the check).
export Str message_of(char chars[:]) {
    return chars;
}

// Appends an error that was made elsewhere.
// Gives the error at `at` its fix. The spans of a generic's body from another module are that module's: its edits
// would land in this file (#2386), so they are kept with the module they mend, for the fixer to apply when it mends
// that module (#2669).
export void set_fix(Checked *r, Usize at, syntax::Edits fix) {
    Error *made = &r->errors[at];
    if (countof(r->prefix) == 0) {
        made->fix = fix;
        return;
    }
    made->fix_module = r->prefix;
    made->module_fix = fix;
}

export void add_error(Checked *r, Error error) {
    fail(r, error.span, error.message);
    set_fix(r, r->error_count - 1, error.fix);
}

// Records an error that carries a fix: the edits that mend it, applied together or not at all.
export void fail_fix(Checked *r, ast::Span span, Str message, syntax::Edits fix) {
    fail(r, span, message);
    set_fix(r, r->error_count - 1, fix);
}

// An error whose message is the pieces `args`, as `format::push` takes them.
export void failf(Checked *r, ast::Span span, auto... args) {
    fail(r, span, msg(format::push(args...)));
}

static Usize slot_of(const ast::Expr *node, Usize capacity) {
    return (((Usize)node) >> 4U) & (capacity - 1);
}

static void grow_nodes(Checked *r) {
    NodeType old[:] = r->nodes;
    Usize capacity = countof(old) * 2;
    if (capacity < 64) capacity = 64;
    r->nodes = mem::alloc_slice(NodeType, capacity);
    for (Usize i = 0; i < countof(old); i++) {
        if (old[i].node == nullptr) continue;
        Usize at = slot_of(old[i].node, capacity);
        while (r->nodes[at].node != nullptr) {
            at = (at + 1) & (capacity - 1);
        }
        r->nodes[at] = old[i];
    }
}

// The entry of `node` recorded in the body of `instance` (`max_instances`: outside every instance, and the latest
// record of any instance), or null.
static const NodeType *find_in(const Checked *r, const ast::Expr *node, Usize instance) {
    Usize capacity = countof(r->nodes);
    if (capacity == 0) return nullptr;
    Usize at = slot_of(node, capacity);
    while (r->nodes[at].node != nullptr) {
        if (r->nodes[at].node == node && r->nodes[at].instance == instance) return &r->nodes[at];
        at = (at + 1) & (capacity - 1);
    }
    return nullptr;
}

// The entry a reader of the body being checked sees: the instance's own, else the one recorded outside every instance
// (a global's initializer, a signature).
static const NodeType *find_here(const Checked *r, const ast::Expr *node) {
    const NodeType *entry = find_in(r, node, r->current);
    if (entry == nullptr && r->current != max_instances) entry = find_in(r, node, max_instances);
    return entry;
}

// The entry of `node` for `instance`, made when there is none.
static NodeType *entry_in(Checked *r, const ast::Expr *node, Usize instance) {
    if ((r->node_count + 1) * 2 > countof(r->nodes)) grow_nodes(r);
    Usize capacity = countof(r->nodes);
    Usize at = slot_of(node, capacity);
    while (r->nodes[at].node != nullptr && !(r->nodes[at].node == node && r->nodes[at].instance == instance)) {
        at = (at + 1) & (capacity - 1);
    }
    if (r->nodes[at].node == nullptr) {
        r->node_count += 1;
        r->nodes[at].node = node;
        r->nodes[at].instance = instance;
    }
    return &r->nodes[at];
}

// Records the type of an expression. In the body of an instance of a generic the type is that instance's (#2669); the
// record outside every instance (`max_instances`) always holds the latest one, which is what a reader that does not
// name an instance gets, as before.
export void set_type(Checked *r, const ast::Expr *node, TypeRef type) {
    // through a named record: the fixer renames the field `type` (a word of smith's syntax) only on a name's access
    NodeType *here = entry_in(r, node, r->current);
    here->type = type;
    if (r->current != max_instances) {
        NodeType *latest = entry_in(r, node, max_instances);
        latest->type = type;
    }
}

// The type recorded for an expression in the body of the instance being checked (outside a check: the latest), or null
// when there is none.
export TypeRef type_of(const Checked *r, const ast::Expr *node) {
    const NodeType *entry = find_here(r, node);
    if (entry == nullptr) return nullptr;
    return entry->type;
}

// The type recorded for an expression in the body of `instance`, or null.
export TypeRef type_of_in(const Checked *r, const ast::Expr *node, Usize instance) {
    const NodeType *entry = find_in(r, node, instance);
    if (entry == nullptr) return nullptr;
    return entry->type;
}

// Records that the condition of an `if` is a question about types (`is_integer(typeof(x)) and ...`) that the checker
// answered: only the branch it picks is checked, and only that branch is emitted (#1902).
export void set_decided(Checked *r, const ast::Expr *condition, Bool keeps_then) {
    NodeType *entry = entry_in(r, condition, r->current);
    entry->decided = true;
    entry->keeps_then = keeps_then;
    if (r->current == max_instances) return;
    entry = entry_in(r, condition, max_instances);
    entry->decided = true;
    entry->keeps_then = keeps_then;
}

// Records the value the compiler computed for an expression that has no run-time form (a question about a type, a
// call of a concept), as the 64 bits of its type: the emitter writes the constant (#3039).
// The type a type function gave the applied type `node` (`Pair(i32)`), null when none did.
export TypeRef applied_type(const Checked *r, const ast::TypeExpr *node, Usize instance) {
    const NodeType *entry = find_in(r, (const ast::Expr *)(Usize)node, instance);
    if (entry == nullptr && instance != max_instances)
        entry = find_in(r, (const ast::Expr *)(Usize)node, max_instances);
    return entry == nullptr ? nullptr : entry->type;
}

// Records the type a constant that holds one stands for when a call makes it (`W := widen(T)`), under its
// declaration; `held_type` reads it back for the instance.
export void set_held(Checked *r, const ast::Decl *d, TypeRef type) {
    set_type(r, (const ast::Expr *)(Usize)d, type);
}

export TypeRef held_type(const Checked *r, const ast::Decl *d, Usize instance) {
    return applied_type(r, (const ast::TypeExpr *)(Usize)d, instance);
}

// Whether a type function made the type `t` (`Pair(i32)`).
export Bool is_made(const Checked *r, TypeRef t) {
    for (Usize i = 0; i < r->made_count; i++) {
        if (r->made[i].type == t) return true;
    }
    return false;
}

export void set_value(Checked *r, const ast::Expr *node, U64 value) {
    NodeType *entry = entry_in(r, node, r->current);
    entry->has_value = true;
    entry->value = value;
    if (r->current == max_instances) return;
    entry = entry_in(r, node, max_instances);
    entry->has_value = true;
    entry->value = value;
}

// The value the checker computed for an expression in the body of `instance`; false when it recorded none.
export Bool value_in(const Checked *r, const ast::Expr *node, Usize instance, U64 *value) {
    const NodeType *entry = find_in(r, node, instance);
    if (entry == nullptr || !entry->has_value) return false;
    *value = entry->value;
    return true;
}

// Whether the checker answered the condition of an `if` in the body of `instance`, and which branch it kept.
export Bool decided_in(const Checked *r, const ast::Expr *condition, Usize instance, Bool *keeps_then) {
    const NodeType *entry = find_in(r, condition, instance);
    if (entry == nullptr || !entry->decided) return false;
    *keeps_then = entry->keeps_then;
    return true;
}

// The same for the body being checked now (outside a check: the latest answer).
export Bool decided(const Checked *r, const ast::Expr *condition, Bool *keeps_then) {
    const NodeType *entry = find_here(r, condition);
    if (entry == nullptr || !entry->decided) return false;
    *keeps_then = entry->keeps_then;
    return true;
}

// What the emitter needs to know about a cast: whether it asserts that the value fits (checked in every build, and
// removed only by a proof), and the types of the operand and of the result.
export struct CastCheck {
    Bool needed;
    TypeRef from;
    TypeRef target_type;
};

static NodeType *entry_for(Checked *r, const ast::Expr *node, Usize instance) {
    Usize capacity = countof(r->nodes);
    if (capacity == 0) return nullptr;
    Usize at = slot_of(node, capacity);
    while (r->nodes[at].node != nullptr) {
        if (r->nodes[at].node == node && r->nodes[at].instance == instance) return &r->nodes[at];
        at = (at + 1) & (capacity - 1);
    }
    return nullptr;
}

static NodeType *entry_of(Checked *r, const ast::Expr *node) {
    return entry_for(r, node, r->current);
}

// The entry that holds the latest record of `node`, when `entry_of` is one of an instance.
static NodeType *latest_of(Checked *r, const ast::Expr *node) {
    if (r->current == max_instances) return nullptr;
    return entry_for(r, node, max_instances);
}

// Records that the call `node`, written `x.f(args)`, is the call `rewritten`, `f(x, args)` or `f(&x, args)`.
export void set_method(Checked *r, const ast::Expr *node, const ast::Expr *rewritten) {
    NodeType *entry = entry_of(r, node);
    if (entry == nullptr) {
        // The call's type is recorded after its rewritten form is checked; make the entry now.
        set_type(r, node, nullptr);
        entry = entry_of(r, node);
    }
    if (entry != nullptr) entry->method = rewritten;
    NodeType *latest = latest_of(r, node);
    if (latest != nullptr) latest->method = rewritten;
}

// Records that the array length `node`, written as constants, has the value `length`.
export void set_length(Checked *r, const ast::Expr *node, U64 length) {
    NodeType *entry = entry_of(r, node);
    if (entry == nullptr) {
        set_type(r, node, nullptr);
        entry = entry_of(r, node);
    }
    if (entry == nullptr) return;
    entry->has_length = true;
    entry->length = length;
    NodeType *latest = latest_of(r, node);
    if (latest != nullptr) {
        latest->has_length = true;
        latest->length = length;
    }
}

// The value of an array length that the checker folded; false when `node` is not one.
export Bool length_of(const Checked *r, const ast::Expr *node, U64 *out) {
    const NodeType *entry = find_here(r, node);
    if (entry == nullptr) return false;
    *out = entry->length;
    return entry->has_length;
}

// The call a method call stands for, or null when `node` is not a method call.
export const ast::Expr *method_of(const Checked *r, const ast::Expr *node) {
    const NodeType *entry = find_here(r, node);
    if (entry == nullptr) return nullptr;
    return entry->method;
}

// Marks the cast `node` (whose type is already recorded) as needing a run-time check; `from` is its operand's type.
export void mark_cast_checked(Checked *r, const ast::Expr *node, TypeRef from) {
    NodeType *entry = entry_of(r, node);
    if (entry == nullptr) return;
    entry->cast_checked = true;
    entry->cast_from = from;
    NodeType *latest = latest_of(r, node);
    if (latest != nullptr) {
        latest->cast_checked = true;
        latest->cast_from = from;
    }
}

// Whether the cast `node` needs a run-time check, with its source and target type; `needed` is false for every other
// node and for a cast that cannot lose anything.
export CastCheck cast_checked(const Checked *r, const ast::Expr *node) {
    const NodeType *entry = find_here(r, node);
    if (entry == nullptr || !entry->cast_checked) return (CastCheck){.target_type = nullptr};
    return (CastCheck){.needed = true, .from = entry->cast_from, .target_type = entry->type};
}

// ---------------------------------------------------------------------------------------------------------------
// Ty expressions

// A frame of the walk of a type expression: a node to read, or one whose children are done and which is built.
struct Step {
    const ast::TypeExpr *node;
    Bool built;
};

struct Made {
    TypeRef type;
};

struct Walk {
    Step steps[:];
    Usize step_count;
    Made values[:];
    Usize value_count;
};

static void push_step(Walk *w, const ast::TypeExpr *node, Bool built) {
    if (w->step_count == countof(w->steps)) {
        Usize capacity = countof(w->steps) * 2;
        if (capacity < 16) capacity = 16;
        w->steps = mem::realloc(w->steps, capacity);
    }
    w->steps[w->step_count] = (Step){.node = node, .built = built};
    w->step_count += 1;
}

static void push_made(Walk *w, TypeRef type) {
    if (w->value_count == countof(w->values)) {
        Usize capacity = countof(w->values) * 2;
        if (capacity < 16) capacity = 16;
        w->values = mem::realloc(w->values, capacity);
    }
    w->values[w->value_count] = (Made){.type = type};
    w->value_count += 1;
}

// A type path `a.T`, `a::T` or `a.b.T`: through the modules when its first name is one, else the whole path as a name
// (`c::printf`); inside an imported module, that module's own names first.
export const Symbol *type_through_modules(const Checked *r, ast::Path path);
export const HeaderBinding *header_binding(const Checked *r, Str name);

static Str path_text(ast::Path path) {
    Output text = {};
    for (Usize i = 0; i < countof(path.segments); i++) {
        if (i > 0) put(&text, "::");
        put(&text, path.segments[i].text);
    }
    return text.data[0:text.length];
}

// The type `.green` of the one value `.green` (#3237); `name` is without the dot.
export TypeRef symbol_of(Table *t, Str name) {
    TyKind made = {.symbol = {.name = msg(format::push(".", name))}};
    return intern(t, (Ty){.kind = made});
}

// A concept of smith's own syntax (`num`), in a type that is written in it: a family of types, never a field's type.
export TypeRef concept_of(Table *t, Str name) {
    TyKind made = {.concept_type = {.name = name}};
    return intern(t, (Ty){.kind = made});
}

static Bool is_own_concept(Str name) {
    return same_text(name, "int") || same_text(name, "float") || same_text(name, "num") || same_text(name, "signed") ||
           same_text(name, "unsigned") || same_text(name, "pointer");
}

// The lowercase concept a capitalized concept name stands for (`Int` is `int`), or empty.
static Str lowercase_concept(Str name) {
    if (same_text(name, "Int")) return "int";
    if (same_text(name, "Float")) return "float";
    if (same_text(name, "Num")) return "num";
    if (same_text(name, "Signed")) return "signed";
    if (same_text(name, "Unsigned")) return "unsigned";
    if (same_text(name, "Pointer")) return "pointer";
    return "";
}

// The name a lowercase builtin of smith's own syntax has in the table (`u8` is `U8`), or empty.
static Str own_builtin(Str name) {
    if (same_text(name, "i8")) return "I8";
    if (same_text(name, "i16")) return "I16";
    if (same_text(name, "i32")) return "I32";
    if (same_text(name, "i64")) return "I64";
    if (same_text(name, "i128")) return "I128";
    if (same_text(name, "isize")) return "Isize";
    if (same_text(name, "u8")) return "U8";
    if (same_text(name, "u16")) return "U16";
    if (same_text(name, "u32")) return "U32";
    if (same_text(name, "u64")) return "U64";
    if (same_text(name, "u128")) return "U128";
    if (same_text(name, "usize")) return "Usize";
    if (same_text(name, "f16")) return "F16";
    if (same_text(name, "bf16")) return "BF16";
    if (same_text(name, "f32")) return "F32";
    if (same_text(name, "f64")) return "F64";
    if (same_text(name, "bool")) return "Bool";
    if (same_text(name, "char")) return "Char";
    if (same_text(name, "str")) return "Str";
    if (same_text(name, "void")) return "Void";
    if (same_text(name, "type")) return "type";
    return "";
}

// The sized type that replaces a C type name, or empty when `name` is no C type name.
static Str c_type_fix(Str name) {
    if (same_text(name, "int")) return "i32";
    if (same_text(name, "long")) return "i64";
    if (same_text(name, "short")) return "i16";
    if (same_text(name, "unsigned")) return "u32";
    if (same_text(name, "float")) return "f32";
    if (same_text(name, "double")) return "f64";
    if (same_text(name, "signed")) return "i32";
    return "";
}

// The concept a written type names (`int`, `Num`): its lowercase name, or empty when it is no concept (#1821).
export Str written_concept(const ast::TypeExpr *t) {
    if (t == nullptr || t->kind != .named || countof(t->kind.named.path.segments) != 1) return "";
    Str written = t->kind.named.path.segments[0].text;
    if (is_own_concept(written)) return written;
    return lowercase_concept(written);
}

static Bool is_type_name(const ast::TypeExpr *written);

// The one statement of a block of one, the statement itself when it is not a block, null for a longer block.
static const ast::Stmt *only_statement(const ast::Stmt *body) {
    if (body->kind != .block) return body;
    ast::StmtRef items[:] = body->kind.block.items;
    if (countof(items) != 1) return nullptr;
    return items[0];
}

// The one expression a statement gives as a function's value: `return e`, the expression `e`, or a block of one of
// those; else null.
static const ast::Expr *single_value(const ast::Stmt *written) {
    if (written == nullptr) return nullptr;
    const ast::Stmt *body = only_statement(written);
    if (body == nullptr) return nullptr;
    if (body->kind == .return_stmt) return body->kind.return_stmt.value;
    if (body->kind == .expression) return body->kind.expression.value;
    return nullptr;
}

// Whether the written type is the bare name `bool`.
static Bool is_bool_name(const ast::TypeExpr *written) {
    if (written == nullptr || written->kind != .named) return false;
    ast::Path path = written->kind.named.path;
    return countof(path.segments) == 1 && same_text(path.segments[0].text, "bool");
}

// The body of a concept function, a question about types answered at compile time: `fn floaty(T: type) -> bool:
// is_float(T)`, every parameter a `type`, the result `bool`, the body one expression (the prelude's `signed`, a
// user's `shape`). Null for any other declaration.
export const ast::Expr *concept_body(const ast::Decl *d) {
    if (d == nullptr || d->kind != .function || !d->kind.function.is_new) return nullptr;
    if (!is_bool_name(d->kind.function.result) || countof(d->kind.function.params) == 0) return nullptr;
    ast::Param params[:] = d->kind.function.params;
    for (Usize i = 0; i < countof(params); i++) {
        if (params[i].is_rest || params[i].is_pack || params[i].is_gather || !is_type_name(params[i].type))
            return nullptr;
    }
    return single_value(d->kind.function.body);
}

// Whether the type satisfies the concept: `int` any integer, `signed` and `unsigned` by sign, `float`, `num` either,
// `pointer` any pointer (#1821).
export Bool concept_holds(Str concept, TypeRef t) {
    if (same_text(concept, "int")) return t->kind == .integer;
    if (same_text(concept, "signed")) return t->kind == .integer && signed_of(t);
    if (same_text(concept, "unsigned")) return t->kind == .integer && !signed_of(t);
    if (same_text(concept, "float")) return t->kind == .floating;
    if (same_text(concept, "num")) return t->kind == .integer || t->kind == .floating;
    if (same_text(concept, "pointer")) return t->kind == .pointer;
    return false;
}

// The concept a capitalized concept name of today's spelling stands for (`Int` is `int`), or empty.
static Str concept_lower(Str name) {
    if (same_text(name, "Int")) return "int";
    if (same_text(name, "Num")) return "num";
    if (same_text(name, "Signed")) return "signed";
    if (same_text(name, "Unsigned")) return "unsigned";
    if (same_text(name, "Float")) return "float";
    if (same_text(name, "Pointer")) return "pointer";
    return "";
}

static Bool is_concept_name(Str name) {
    return same_text(name, "Struct") || same_text(name, "Enum");
}

// Whether `path` starts with `c::`: a name from a C header, which waits for the C importer (#1124).
static Bool is_c_path(ast::Path path) {
    return countof(path.segments) > 1 && same_text(path.segments[0].text, "c");
}

// A named type: a builtin, or a type name in scope. An unknown name is an error that says what to write.
static TypeRef resolve_name(Checked *r, ast::Span span, ast::Path path) {
    if (countof(path.segments) == 1) {
        Str written = path.segments[0].text;
        if (r->new_syntax && is_own_concept(written)) return concept_of(&r->table, written);
        // the capitalized spelling a fixed file still carries (`Int`, like `I32`) is the same concept
        Str lowered = lowercase_concept(written);
        if (r->new_syntax && countof(lowered) > 0) return concept_of(&r->table, lowered);
        Str own = own_builtin(written);
        if (!r->new_syntax && (same_text(written, "char") || same_text(written, "bool"))) own = "";
        TypeRef known = builtin(&r->table, countof(own) > 0 ? own : written);
        if (known != nullptr && (countof(own) > 0 || !same_text(written, "type"))) return known;
        Str fix = c_type_fix(written);
        if (countof(fix) > 0) {
            failf(r, span, "`", written, "` is a C type: write `", fix, "`");
            return r->table.invalid;
        }
        if (same_text(written, "char") || same_text(written, "bool")) {
            if (same_text(written, "char")) {
                failf(r, span, "`char` is a C type: write `Char`");
            } else {
                failf(r, span, "`bool` is a C type: write `Bool`");
            }
            return r->table.invalid;
        }
        Str lower = concept_lower(written);
        if (countof(lower) > 0) return concept_of(&r->table, lower);
        if (is_concept_name(written)) {
            failf(r, span, "not yet typed: the concept `", written, "`; only `Auto`, `Int`, `Num`, `Signed`, ",
                  "`Unsigned`, `Float` and `Pointer` are typed so far");
            return r->table.invalid;
        }
    }
    const Symbol *found = type_through_modules(r, path);
    if (found == nullptr && countof(path.segments) == 2 && header_binding(r, path.segments[0].text) != nullptr) {
        failf(r, span, "`", path_text(path), "` is not declared by that header; check its spelling, or import the ",
              "header that declares it");
        return r->table.invalid;
    }
    if (found == nullptr && is_c_path(path) && r->options.headers != nullptr) {
        failf(r, span, "`", path_text(path), "` is not declared by any C header this file imports; ",
              "write `import <h>;` for the header that has it, and check its spelling");
        return r->table.invalid;
    }
    if (found == nullptr && is_c_path(path)) {
        failf(r, span, "not yet typed: c:: name `", path_text(path), "`");
        return r->table.invalid;
    }
    if (found == nullptr) {
        failf(r, span, "unknown type `", path_text(path),
              "`; declare it before it is used, and write a type name with a capital letter");
        return r->table.invalid;
    }
    if (found->kind != .type_name) {
        failf(r, span, "`", path_text(path), "` is not a type; write a type name here");
        return r->table.invalid;
    }
    return found->type;
}

static Bool is_composite(const ast::TypeExpr *node) {
    return node->kind == .pointer || node->kind == .array || node->kind == .slice || node->kind == .function ||
           node->kind == .applied || node->kind == .option || node->kind == .block_type || node->kind == .tuple ||
           node->kind == .record;
}

// The children of a composite type, in the order their types are wanted: a function's parameters and then its result,
// an applied type's type arguments.
static Usize child_count(const ast::TypeExpr *node) {
    if (node->kind == .function) {
        Usize n = countof(node->kind.function.params);
        if (node->kind.function.result != nullptr) n += 1;
        return n;
    }
    if (node->kind == .tuple) return countof(node->kind.tuple.elements);
    if (node->kind == .record) return countof(node->kind.record.fields);
    if (node->kind == .applied) {
        Usize n = 0;
        for (Usize i = 0; i < countof(node->kind.applied.args); i++) {
            const ast::TypeArg *arg = &node->kind.applied.args[i];
            if (*arg == .type) n += 1;
        }
        return n;
    }
    return 1;
}

// The child `i` (0 is the first wanted).
static const ast::TypeExpr *child(const ast::TypeExpr *node, Usize i) {
    if (node->kind == .pointer) return node->kind.pointer.pointee;
    if (node->kind == .array) return node->kind.array.element;
    if (node->kind == .slice) return node->kind.slice.element;
    if (node->kind == .option) return node->kind.option.inner;
    if (node->kind == .block_type) return node->kind.block_type.element;
    if (node->kind == .function) {
        if (i < countof(node->kind.function.params)) return node->kind.function.params[i];
        return node->kind.function.result;
    }
    if (node->kind == .tuple) return node->kind.tuple.elements[i];
    if (node->kind == .record) return node->kind.record.fields[i].type;
    Usize seen = 0;
    if (node->kind == .applied) {
        for (Usize k = 0; k < countof(node->kind.applied.args); k++) {
            const ast::TypeArg *arg = &node->kind.applied.args[k];
            if (*arg == .type) {
                if (seen == i) return arg->type.type;
                seen += 1;
            }
        }
    }
    return nullptr;
}

// `typeof(T)` is `T`; `typeof(x)` is the type of the variable or parameter `x` that is in scope. Another expression is
// typed by `options.expression` (J1b's `infer`, which this file cannot import); without one it is reported.
static TypeRef type_of_operand(Checked *r, const ast::TypeExpr *node) {
    if (node->kind != .type_of) return r->table.invalid;
    const ast::Expr *operand = node->kind.type_of.operand;
    if (operand->kind == .type_value) {
        // (no recursion: only a named type, as `typeof(i32)`, is read here)
        const ast::TypeExpr *given = operand->kind.type_value.type;
        ast::Path given_path = {};
        if (written_path(given, &given_path)) return resolve_name(r, given->span, given_path);
        // `typeof(Edit[:])`, the alias of a list (`Edits`, `Errors`): one slice of a plain name, with no recursion
        // (#2602)
        const ast::TypeExpr *element = nullptr;
        if (given->kind == .slice) element = given->kind.slice.element;
        ast::Path element_path = {};
        if (written_path(element, &element_path)) {
            TypeRef of = resolve_name(r, element->span, element_path);
            // In smith's own syntax `typeof([]char)` is read-only, as `[]char` is, and `typeof([]mut char)` writable;
            // in today's, `typeof(const char[:])` is read-only and `typeof(char[:])` writable (#3206).
            Bool read_only = element->qualifiers.is_const;
            if (r->new_syntax && given->kind == .slice) read_only = !given->kind.slice.is_mut;
            return slice_of(&r->table, of, read_only);
        }
        failf(r, node->span, "not yet typed: `typeof` of a type that is not a plain name; write the type itself");
        return r->table.invalid;
    }
    Str operand_name = single_name(operand);
    if (countof(operand_name) > 0) {
        const Symbol *found = lookup(&r->scopes, operand_name);
        if (found != nullptr && found->kind == .variable) return found->type;
        if (operand->kind == .name) {
            return resolve_name(r, operand->span, operand->kind.name.path); // a type written as a name; else unknown
        }
    }
    if (r->options.expression != nullptr) return r->options.expression(r, operand);
    failf(r, node->span,
          "not yet typed: `typeof` of an expression that is not a name; write `typeof(x)` of a variable");
    return r->table.invalid;
}

static TypeRef leaf_type(Checked *r, const ast::TypeExpr *node) {
    if (node->kind == .named) {
        ast::Path named_path = node->kind.named.path;
        return resolve_name(r, node->span, named_path);
    }
    if (node->kind == .auto_type) return r->table.automatic;
    if (node->kind == .type_of) {
        return type_of_operand(r, node);
    } else if (node->kind == .unsupported_c) {
        failf(r, node->span, "the C type `", node->kind.unsupported_c.spelling,
              "` has no smith type; use a fixed-size type such as `F64` or `I64`");
    } else {
        failf(r, node->span, "not yet typed: this kind of type");
    }
    return r->table.invalid;
}

// An anonymous struct or union used as a type (a payload variant `struct { I32 a; } one;`): a nominal record of its
// own, one per place it is written, whose fields are the children's types.
static TypeRef build_record(Checked *r, const ast::TypeExpr *node, const Walk *w, Usize base, Usize n) {
    if (node->kind != .record) return r->table.invalid;
    ast::FieldDecl members[:] = node->kind.record.fields;
    Slot fields[:] = mem::alloc_slice(Slot, n);
    for (Usize i = 0; i < n; i++) {
        fields[i].name = members[i].name;
        fields[i].is_pub = true;
        fields[i].default_value = members[i].default_value;
        fields[i].type = w->values[base + i].type;
        for (Usize k = 0; k < i; k++) {
            if (same_text(fields[k].name, members[i].name)) {
                failf(r, members[i].span, "the field `", members[i].name, "` is declared twice; rename one");
            }
        }
    }
    Str name = node->kind.record.is_union ? "(anonymous union)" : "(anonymous struct)";
    Ty *made = new_record(&r->table, name, node->kind.record.is_union);
    set_fields(made, fields);
    set_owner(made, r->prefix);
    return made;
}

static Bool any_invalid(const Checked *r, const Walk *w, Usize base, Usize n) {
    for (Usize i = 0; i < n; i++) {
        if (w->values[base + i].type == r->table.invalid) return true;
    }
    return false;
}

// `vec(T, N)`: `T` is a number type and `N` an integer literal of 1 or more.
static TypeRef build_vector(Checked *r, const ast::TypeExpr *node, TypeRef element) {
    if (node->kind != .applied) {
        return r->table.invalid;
    }
    ast::TypeArg args[:] = node->kind.applied.args;
    if (countof(args) != 2) {
        failf(r, node->span, "`vec` takes an element type and a lane count; write `vec(f32, 4)`");
        return r->table.invalid;
    }
    const ast::TypeArg *first = &args[0];
    const ast::TypeArg *second = &args[1];
    if (!(*first == .type) || !(*second == .value)) {
        failf(r, node->span, "`vec` takes an element type and a lane count; write `vec(f32, 4)`");
        return r->table.invalid;
    }
    const ast::Expr *count = value_argument(second);
    if (count->kind != .integer) {
        failf(r, count->span, "not yet typed: a lane count that is not an integer literal; write `vec(f32, 4)`");
        return r->table.invalid;
    }
    if (count->kind.integer.value < 1) {
        failf(r, count->span, "a vector has at least one lane; write a count of 1 or more, as in `vec(f32, 4)`");
        return r->table.invalid;
    }
    if (element->kind != .integer && element->kind != .floating) {
        failf(r, node->span, "the element of `vec` is a number type, found `", show(element),
              "`; write `vec(f32, 4)` or `vec(i32, 3)`");
        return r->table.invalid;
    }
    return vector_of(&r->table, element, count->kind.integer.value);
}

static Bool constant_length(Checked *r, const ast::Expr *root, Str what, U64 *out);

// Whether a function's full name is `slice.with_dims` of std.slice, or std.arena's `slice_of`, the same function
// under its old name, which std.arena and std.mem keep until the old front end can read the new one from them.
export Bool is_with_dims(Str name) {
    return same_text(name, "std::slice::with_dims") || same_text(name, "std::arena::slice_of");
}

// Whether `path` names `slice.with_dims` of std.slice, however the module is imported (`from std.slice import
// with_dims` too). It is built in: a function over types cannot write `[,]T`.
export Bool names_with_dims(const Checked *r, ast::Path path) {
    const Symbol *named = type_through_modules(r, path);
    return named != nullptr && named->kind == .function_symbol && is_with_dims(named->name);
}

// `slice.with_dims(T, k)`: the slice of `k` dimensions known at run time over `T`. `slice.with_dims(f32, 1)` is
// `[]f32`, `slice.with_dims(f32, 2)` is `[,]f32`.
export TypeRef with_dims(Checked *r, TypeRef element, U64 count) {
    if (count == 1) return slice_of(&r->table, element, false);
    return block_of(&r->table, element, count);
}

static TypeRef build_with_dims(Checked *r, const ast::TypeExpr *node, TypeRef element) {
    if (node->kind != .applied) return r->table.invalid;
    ast::TypeArg args[:] = node->kind.applied.args;
    U64 count = 0;
    const ast::TypeArg *second = countof(args) == 2 ? &args[1] : nullptr;
    const ast::Expr *count_expr = value_argument(second);
    if (count_expr == nullptr || !constant_length(r, count_expr, "", &count)) {
        failf(r, node->span, "the count of `slice.with_dims` is not known at compile time; write a constant, for ",
              "example `slice.with_dims(f32, 2)`");
        return r->table.invalid;
    }
    if (count < 1) {
        failf(r, node->span, "`slice.with_dims` makes a slice of 1 or more dimensions, not 0; write the element ",
              "type itself");
        return r->table.invalid;
    }
    return with_dims(r, element, count);
}

static TypeRef build_applied(Checked *r, const ast::TypeExpr *node, ast::Path applied_name, Usize args, const Walk *w,
                             Usize base, Usize n) {
    ast::Span span = node->span;
    Str name = path_text(applied_name);
    if (names_with_dims(r, applied_name) && args == 2 && n == 1) {
        TypeRef dims = build_with_dims(r, node, w->values[base].type);
        set_type(r, (const ast::Expr *)(Usize)node, dims); // the emitter asks `applied_type` for it
        return dims;
    }
    // (an element the parser read as a value, `with_dims(T, 2)` with `T` a parameter, is run as the call it is)
    if (same_text(name, "Option") && args == 1 && n == 1) return option_of(&r->table, w->values[base].type);
    if (same_text(name, "stream::Stream") && args == 1 && n == 1) return stream_of(&r->table, w->values[base].type);
    // `iter(T)`, the result of a generator in smith's own syntax (#1428), is the stream of `T`
    if (r->new_syntax && same_text(name, "iter") && args == 1 && n == 1)
        return stream_of(&r->table, w->values[base].type);
    if ((same_text(name, "Checked") || same_text(name, "Result")) && args == 2 && n == 2)
        return result_of(&r->table, w->values[base].type, w->values[base + 1].type);
    Bool is_lambda = same_text(name, "Lambda");
    if ((same_text(name, "Fn") || is_lambda) && args == 1 && n == 1) {
        TypeRef argument = w->values[base].type;
        if (argument->kind != .function) {
            Str written = is_lambda ? "Lambda" : "Fn";
            failf(r, span, "`", written, "` takes a function type; write `", written, "(R (P1, P2))`, for example `",
                  written, "(Bool (I32, I32))`");
            return r->table.invalid;
        }
        return fn_value_of(&r->table, w->values[base].type);
    }
    if (r->options.applied != nullptr) {
        TypeRef made = r->options.applied(r, node);
        // recorded under the node, as an expression's type is: the emitter asks `applied_type` for it
        if (made != nullptr) set_type(r, (const ast::Expr *)(Usize)node, made);
        if (made != nullptr) return made;
    }
    failf(r, span, "not yet typed: the applied type `", name, "` with these arguments");
    return r->table.invalid;
}

// `[5,3]T` is `[5][3]T`; `[,3]T` is a slice of `[3]T`; `[,]T` and `[,,]T` are blocks of 2 and 3 dimensions known at run
// time. The sizes after the last empty one are the cell; a known size before it (`[,2,]T`) is a dimension counted at
// run time. A size that is not an integer literal is not typed yet.
static TypeRef build_block(Checked *r, ast::Span span, ast::ExprRef dims[:], TypeRef element) {
    Usize empty = countof(dims);
    while (empty > 0 && dims[empty - 1] != nullptr)
        empty -= 1;
    TypeRef cell = element;
    for (Usize i = countof(dims); i > empty; i--) {
        const ast::Expr *size = dims[i - 1];
        if (size->kind != .integer) {
            failf(r, span, "not yet typed: a block with a size that is not an integer literal; write the integer, ",
                  "for example `[,3]T`");
            return r->table.invalid;
        }
        cell = array_of(&r->table, cell, size->kind.integer.value, false);
    }
    if (empty == 0) return cell;
    if (empty == 1) return slice_of(&r->table, cell, false);
    return block_of(&r->table, cell, empty);
}

export const Symbol *type_through_modules(const Checked *r, ast::Path path);

// Whether `e` is a name that may stand for a constant, and its path: `n`, or `N`, which the parser reads as a type
// written as a value.
export Bool names_a_constant(const ast::Expr *e, ast::Path *path) {
    ast::Identifier header = {};
    Str header_member = "";
    if (member_of_name(e, &header, &header_member)) {
        // `k.depth`: a name of a C header's constant, `k` the header's binding (the path of `k.SIDE` is a type_value)
        ast::Identifier second = {.text = header_member, .span = e->span};
        ast::Identifier segments[:] = mem::alloc_slice(ast::Identifier, 2);
        segments[0] = header;
        segments[1] = second;
        *path = (ast::Path){.segments = segments, .span = e->span};
        return true;
    }
    if (e->kind == .name) {
        *path = e->kind.name.path;
        return true;
    }
    if (e->kind == .type_value) return written_path(e->kind.type_value.type, path);
    return false;
}

// Whether a declaration is a function written in the new syntax.
static Bool is_new_function(const ast::Decl *d) {
    if (d->kind != .function) return false;
    return d->kind.function.is_new;
}

// `k.f` with `.` (not `->`): the base `k` and the member `f`.
static Bool is_dot_member(const ast::Expr *e) {
    if (e->kind != .member) return false;
    return !e->kind.member.arrow;
}

static const ast::Expr *member_base(const ast::Expr *e) {
    if (e->kind != .member) return nullptr;
    return e->kind.member.base;
}

static Str member_field(const ast::Expr *e) {
    if (e->kind != .member) return "";
    return e->kind.member.name;
}

// The value of an expression that is an integer literal, false for anything else.
export Bool integer_of(const ast::Expr *e, U64 *out) {
    if (e == nullptr) return false;
    if (e->kind != .integer) return false;
    *out = e->kind.integer.value;
    return true;
}

// What the declaration of a symbol says. A symbol has none when it is a builtin, so each reader below tests for it once
// and gives an empty answer.

// The initializer of a symbol that is a constant variable (`const`, `constexpr`, or a `let` that is not `mut`); null
// when it is not one or has none.
export const ast::Expr *constant_initializer(const Symbol *s) {
    if (s == nullptr) return nullptr;
    const ast::Decl *decl = s->decl;
    if (decl == nullptr) return nullptr;
    if (decl->kind != .variable) return nullptr;
    Bool fixed = s->is_const;
    Bool is_new = decl->kind.variable.is_new;
    if (is_new) fixed = !decl->kind.variable.is_mut || decl->kind.variable.is_constexpr;
    if (!fixed || s->kind != .variable) return nullptr;
    return decl->kind.variable.init;
}

// Whether the symbol's declaration is `pub` or `export`.
static Bool declared_public(const Symbol *s) {
    const ast::Decl *decl = s->decl;
    if (decl == nullptr) return false;
    return decl->is_pub || decl->exported;
}

// Whether the symbol was declared in a C header.
export Bool declared_in_c(const Symbol *s) {
    const ast::Decl *decl = s->decl;
    if (decl == nullptr) return false;
    return decl->from_c;
}

// The doc comment of the symbol's declaration; empty when it has none.
export Str declared_doc(const Symbol *s) {
    const ast::Decl *decl = s->decl;
    if (decl == nullptr) return "";
    return decl->doc;
}

// Whether the symbol is the declaration `d`.
export Bool declared_by(const Symbol *s, const ast::Decl *d) {
    const ast::Decl *decl = s->decl;
    if (decl == nullptr) return false;
    return decl == d;
}

// Whether the symbol is declared by a record.
static Bool declared_by_record(const Symbol *s) {
    const ast::Decl *decl = s->decl;
    if (decl == nullptr) return false;
    return decl->kind == .record;
}

// Whether the symbol is declared by a record that is only named (`struct Expr;`), with no fields.
static Bool declared_opaque(const Symbol *s) {
    const ast::Decl *decl = s->decl;
    if (decl == nullptr) return false;
    if (decl->kind != .record) return false;
    return decl->kind.record.opaque;
}

// The number of parameters of a symbol that is a function with a declaration that is not generic.
static Bool declared_arity(const Symbol *s, Usize *count) {
    if (s == nullptr) return false;
    if (s->generic) return false;
    const ast::Decl *decl = s->decl;
    if (decl == nullptr) return false;
    if (decl->kind != .function) return false;
    *count = countof(decl->kind.function.params);
    return true;
}

// The `at`th parameter of a symbol that is a function with a declaration, else null.
static const ast::Param *declared_param(const Symbol *s, Usize at) {
    const ast::Decl *decl = s->decl;
    if (decl == nullptr) return nullptr;
    if (decl->kind != .function) return nullptr;
    const ast::Param params[:] = decl->kind.function.params;
    return &params[at];
}

// The prefix an import symbol stands for, else an empty text.
static Str prefix_of_symbol(const Symbol *s);

// The operand of a negation `-x`, else null.
static const ast::Expr *negated_operand(const ast::Expr *e) {
    if (e == nullptr) return nullptr;
    if (e->kind != .unary) return nullptr;
    if (e->kind.unary.op != .negate) return nullptr;
    return e->kind.unary.operand;
}

// The path of an expression that is a name, false for anything else.
export Bool name_path(const ast::Expr *e, ast::Path *path) {
    if (e == nullptr) return false;
    if (e->kind != .name) return false;
    *path = e->kind.name.path;
    return true;
}

// The value of an array length or a count: an integer known at compile time that is not negative (#3039). A literal
// is read here; anything else is `front::eval`'s to give, through `Options.length`. `what` is the folder's (empty:
// nothing is reported).
static Bool constant_length(Checked *r, const ast::Expr *root, Str what, U64 *out) {
    if (root->kind == .integer) {
        *out = root->kind.integer.value;
        return true;
    }
    if (r->options.length != nullptr) return r->options.length(r, root, what, out);
    if (countof(what) > 0) {
        failf(r, root->span, what, " must be known at compile time; write an integer");
    }
    return false;
}

// `made` with a `volatile` element when the element is written `volatile T` (`*volatile i32`).
static TypeRef volatile_if(Checked *r, const ast::TypeExpr *element, TypeRef made) {
    if (element == nullptr || !element->qualifiers.is_volatile) return made;
    return with_volatile(&r->table, made);
}

// Makes the type of a composite node from its children's, which are `n` values from `base`.
static TypeRef build(Checked *r, const ast::TypeExpr *node, const Walk *w, Usize base, Usize n) {
    if (any_invalid(r, w, base, n)) return r->table.invalid;
    if (node->kind == .pointer) {
        Bool is_const = node->kind.pointer.pointee->qualifiers.is_const;
        if (r->new_syntax) is_const = !node->kind.pointer.is_mut; // smith's own `*T` is read-only, `*mut T` writable
        TypeRef made = pointer_to(&r->table, w->values[base].type, is_const);
        return volatile_if(r, node->kind.pointer.pointee, made);
    }
    if (node->kind == .slice) {
        Bool is_const = node->kind.slice.element->qualifiers.is_const;
        if (r->new_syntax) is_const = !node->kind.slice.is_mut; // smith's own `[]T` is read-only, `[]mut T` writable
        TypeRef made = slice_of(&r->table, w->values[base].type, is_const);
        return volatile_if(r, node->kind.slice.element, made);
    }
    if (node->kind == .array) {
        const ast::Expr *count = node->kind.array.count;
        Str count_name = single_name(count);
        if (countof(count_name) > 0) {
            const Symbol *bound = lookup(&r->scopes, count_name); // `n` of an instance
            if (bound != nullptr && bound->has_value) {
                Bool bound_const = node->kind.array.element->qualifiers.is_const;
                TypeRef made = array_of(&r->table, w->values[base].type, bound->value, bound_const);
                return volatile_if(r, node->kind.array.element, made);
            }
        }
        U64 length = 0;
        if (count == nullptr) {
            failf(r, node->span, "an array has a length: write `[4]T`, or `[]T` for a slice");
            return r->table.invalid;
        }
        if (!constant_length(r, count, "an array length", &length)) return r->table.invalid;
        Bool is_const = node->kind.array.element->qualifiers.is_const;
        set_length(r, count, length);
        TypeRef made = array_of(&r->table, w->values[base].type, length, is_const);
        return volatile_if(r, node->kind.array.element, made);
    }
    if (node->kind == .option) return option_of(&r->table, w->values[base].type);
    if (node->kind == .block_type) return build_block(r, node->span, node->kind.block_type.dims, w->values[base].type);
    if (node->kind == .function) {
        Usize params = countof(node->kind.function.params);
        Slot slots[:] = mem::alloc_slice(Slot, params);
        for (Usize i = 0; i < params; i++)
            slots[i].type = w->values[base + i].type;
        TypeRef result = r->table.void_type;
        if (node->kind.function.result != nullptr) result = w->values[base + params].type;
        return function_of(&r->table, slots, result, node->kind.function.variadic);
    }
    if (node->kind == .record) return build_record(r, node, w, base, n);
    if (node->kind == .tuple) {
        Slot elements[:] = mem::alloc_slice(Slot, n);
        for (Usize i = 0; i < n; i++) {
            elements[i].type = w->values[base + i].type;
            if (i < countof(node->kind.tuple.names)) elements[i].name = node->kind.tuple.names[i].text;
        }
        return tuple_of(&r->table, elements);
    }
    if (node->kind == .applied) {
        ast::Path applied_name = node->kind.applied.name;
        Usize args = countof(node->kind.applied.args);
        if (same_text(path_text(applied_name), "vec")) {
            if (n == 1) return build_vector(r, node, w->values[base].type);
            failf(r, node->span, "`vec` takes an element type and a lane count; write `vec(f32, 4)`");
            return r->table.invalid;
        }
        return build_applied(r, node, applied_name, args, w, base, n);
    }
    return r->table.invalid;
}

// The path a value argument spells when it is a chain of names (`c.FILE`, `state.Error`), else an empty path. The
// emitter reads an applied type's value arguments the same way (#3036).
export ast::Path member_path(const ast::Expr *e) {
    ast::Path none = {};
    Usize depth = 0;
    const ast::Expr *at = e;
    while (at != nullptr && at->kind == .member && !at->kind.member.arrow) {
        depth += 1;
        at = at->kind.member.base;
    }
    if (at == nullptr || at->kind != .name) return none;
    if (depth == 0) return countof(at->kind.name.path.segments) > 1 ? at->kind.name.path : none; // `c.FILE` read whole
    ast::Path root = at->kind.name.path;
    ast::Identifier segments[:] = mem::alloc_slice(ast::Identifier, countof(root.segments) + depth);
    for (Usize i = 0; i < countof(root.segments); i++)
        segments[i] = root.segments[i];
    at = e;
    for (Usize k = countof(segments); k > countof(root.segments) && at->kind == .member; k--) {
        segments[k - 1] = (ast::Identifier){.text = at->kind.member.name, .span = at->span};
        at = at->kind.member.base;
    }
    ast::Path made = {.segments = segments, .span = e->span};
    return made;
}

// The call `value` as an applied type when it calls a function over types (`Option(arena.slice_of(T, 2))`: the
// parser reads the argument as a value); null when it is no such call.
static ast::TypeExpr *call_as_type(const Checked *r, const ast::Expr *value) {
    if (value->kind != .call) return nullptr;
    ast::ExprRef given[:] = value->kind.call.args;
    const ast::Expr *callee = value->kind.call.callee;
    ast::Path path = member_path(callee);
    if (callee->kind == .name) path = callee->kind.name.path;
    if (countof(path.segments) == 0) return nullptr;
    const Symbol *found = type_through_modules(r, path);
    if (found == nullptr || found->kind != .function_symbol) return nullptr;
    const ast::Decl *d = found->decl;
    Bool over_types = is_with_dims(found->name);
    if (!over_types && d != nullptr && d->kind == .function) {
        const ast::TypeExpr *result = d->kind.function.result;
        ast::Path written = {};
        over_types = result != nullptr && written_path(result, &written) && countof(written.segments) == 1 &&
                     same_text(written.segments[0].text, "type");
    }
    if (!over_types) return nullptr;
    ast::TypeArg args[:] = mem::alloc_slice(ast::TypeArg, countof(given));
    for (Usize i = 0; i < countof(given); i++) {
        ast::TypeArg one = {.value = {.value = given[i]}};
        const ast::Expr *written = given[i];
        ast::Path name = member_path(written);
        if (written->kind == .name) name = written->kind.name.path;
        const Symbol *type = countof(name.segments) > 0 ? type_through_modules(r, name) : nullptr;
        if (type != nullptr && type->kind == .type_name) { // `T` of `slice_of(T, 2)`
            ast::TypeExpr *named = ast::make_type({.named = {.path = name}});
            named->span = given[i]->span;
            ast::TypeArg as_type = {.type = {.type = named}};
            one = as_type;
        }
        args[i] = one;
    }
    ast::TypeKind kind = {.applied = {.name = path, .args = args}};
    ast::TypeExpr *applied = ast::make_type(kind);
    applied->span = value->span;
    return applied;
}

// An applied type whose value arguments that name a type (`Result(c.LLVMModuleRef, state.Error)`: the parser reads a
// lower-case first name as a value) are its type arguments: a copy where each is the named type. `node` itself when
// none is.
static const ast::TypeExpr *typed_arguments(const Checked *r, const ast::TypeExpr *node) {
    if (node->kind != .applied) return node;
    ast::TypeArg args[:] = node->kind.applied.args;
    ast::TypeArg made[:] = {};
    for (Usize i = 0; i < countof(args); i++) {
        const ast::Expr *value = value_argument(&args[i]);
        if (value == nullptr) continue;
        ast::TypeExpr *named = call_as_type(r, value);
        if (named == nullptr) {
            ast::Path path = member_path(value);
            if (countof(path.segments) == 0) continue;
            const Symbol *found = type_through_modules(r, path);
            if (found == nullptr || found->kind != .type_name) continue;
            named = ast::make_type({.named = {.path = path}});
            named->span = value->span;
        }
        if (countof(made) == 0) {
            made = mem::alloc_slice(ast::TypeArg, countof(args));
            for (Usize k = 0; k < countof(args); k++)
                made[k] = args[k];
        }
        ast::TypeArg as_type = {.type = {.type = named}};
        made[i] = as_type;
    }
    if (countof(made) == 0) return node;
    ast::TypeKind kind = {.applied = {.name = node->kind.applied.name, .args = made}};
    ast::TypeExpr *copy = ast::make_type(kind);
    copy->span = node->span;
    copy->qualifiers = node->qualifiers;
    return copy;
}

// A type expression as a type. Unknown names and constructs not typed yet are reported in `r` and give the invalid
// type, so a second report is not made for the same mistake. A walk with an explicit stack, never recursion.
export TypeRef resolve(Checked *r, const ast::TypeExpr *t) {
    Walk w = {};
    push_step(&w, t, false);
    while (w.step_count > 0) {
        w.step_count -= 1;
        Step step = w.steps[w.step_count];
        const ast::TypeExpr *node = step.node;
        if (!is_composite(node)) {
            push_made(&w, leaf_type(r, node));
        } else if (!step.built) {
            node = typed_arguments(r, node);
            push_step(&w, node, true);
            Usize n = child_count(node);
            for (Usize i = n; i > 0; i--)
                push_step(&w, child(node, i - 1), false);
        } else {
            Usize n = child_count(node);
            Usize base = w.value_count - n;
            TypeRef made = build(r, node, &w, base, n);
            w.value_count = base;
            push_made(&w, made);
        }
    }
    return w.values[0].type;
}

// ---------------------------------------------------------------------------------------------------------------
// The module's own names

// The mutable type behind a `TypeRef` of this table (the record or enumeration a pass fills in).
static Ty *own(Table *t, TypeRef x) {
    for (Usize i = 0; i < t->count; i++) {
        if (t->entries[i].type == x) return t->entries[i].type;
    }
    return nullptr;
}

// The field `name` of an anonymous struct or union member of the record (`union { I64 signed_value; };`), whose
// fields belong to the record itself; `at` is the slot of the anonymous member that holds it. Null when there is none.
export const Slot *inner_member(TypeRef t, Str name, Usize *at) {
    Slot members[:] = slots_of(t).items;
    for (Usize i = 0; i < countof(members); i++) {
        Str own_name = members[i].name;
        TypeRef inner = members[i].type;
        if (countof(own_name) != 0 || inner == nullptr || inner->kind != .record) continue;
        Slot inside[:] = slots_of(inner).items;
        for (Usize k = 0; k < countof(inside); k++) {
            if (same_text(inside[k].name, name)) {
                *at = i;
                return &inside[k];
            }
        }
    }
    return nullptr;
}

// The field of a record, or the enumerator of an enumeration, called `name`; null when there is none.
export const Slot *member(TypeRef t, Str name) {
    Slot members[:] = slots_of(t).items;
    for (Usize i = 0; i < countof(members); i++) {
        if (same_text(members[i].name, name)) return &members[i];
    }
    if (t->kind == .record) {
        Usize at = 0;
        return inner_member(t, name, &at);
    }
    return nullptr;
}

// Whether the module being checked may name the field: it is `pub`, or the record is the module's own.
// A message for the one that may not is `private_field`.
export Bool field_visible(const Ty *record, const Slot *field) {
    return field->is_pub || countof(owner_of(record)) == 0;
}

// The same, for code checked in the module `current` (`Checked.prefix`): the body of a generic's instance is checked
// while the importer's file is open, and it may name the private fields of the module that wrote it.
export Bool field_visible_from(const Ty *record, const Slot *field, Str current) {
    return field_visible(record, field) || (countof(current) > 0 && same_text(owner_of(record), current));
}

static Bool starts_with(Str text, Str prefix) {
    if (countof(prefix) > countof(text)) return false;
    for (Usize i = 0; i < countof(prefix); i++) {
        if (text[i] != prefix[i]) return false;
    }
    return true;
}

// The module that declares the record, as written: `lib.math`.
static Str owner_dotted(const Ty *record) {
    Str owner = owner_of(record);
    Str module = owner[0:countof(owner) - 2];
    Str dotted = module;
    for (Usize i = 0; i + 1 < countof(module); i++) {
        if (module[i] == ':' && module[i + 1] == ':') {
            Str head = module[0:i];
            Str tail = module[i + 2:countof(module)];
            dotted = msg(format::push(head, ".", tail));
            module = dotted;
            i = 0;
        }
    }
    return dotted;
}

// Reports a field the module being checked may not name: it is private to the module that declares the record.
export void private_field(Checked *r, ast::Span span, const Ty *record, Str name) {
    Str dotted = owner_dotted(record);
    failf(r, span, name, " is private to ", dotted, "; mark it pub or call a function of ", dotted);
}

// Reports a construction of a record that has a private field, from outside its module (#1813): only a function of
// the module builds it. The message lists the module's `pub` functions that return the record.
export void private_build(Checked *r, ast::Span span, const Ty *record) {
    Str dotted = owner_dotted(record);
    Str names = "";
    for (Usize i = 0; i < r->scopes.count; i++) {
        const Symbol *s = &r->scopes.symbols[i];
        if (s->kind != .function_symbol || s->type == nullptr || s->type->kind != .function) continue;
        Bool public = s->exported || declared_public(s);
        if (element_of(s->type) != record || !public) continue;
        if (countof(s->name) <= countof(owner_of(record)) || !starts_with(s->name, owner_of(record))) continue;
        Str name = s->name[countof(owner_of(record)):countof(s->name)];
        if (countof(names) > 0) names = msg(format::push(names, ", "));
        names = msg(format::push(names, "`", name, "`"));
    }
    Str type = show(record);
    if (countof(names) == 0) {
        failf(r, span, "`", type, "` has private fields; build it with a function of `", dotted, "`");
        return;
    }
    failf(r, span, "`", type, "` has private fields; build it with a function of `", dotted, "`: ", names);
}

// The name a declaration is known by: `c::` before a C name, and the alias of the module being imported (`m::`) before
// a name of that module (#1677).
static Str qualified(const Checked *r, Bool from_c, Str name) {
    if (countof(r->prefix) > 0) return msg(format::push(r->prefix, name));
    if (!from_c) return name;
    return msg(format::push("c::", name));
}

static void declare_in_module(Checked *r, Symbol symbol, ast::Span span) {
    if (r->in_header) {
        declare_beside(&r->scopes,
                       symbol); // two headers declare `size_t`: the first stays, and no error names a header
        return;
    }
    if (!declare(&r->scopes, symbol)) {
        failf(r, span, "`", symbol.name, "` is declared twice in this module; rename one or remove the second");
    }
}

static Symbol type_symbol(Str name, TypeRef type, const ast::Decl *d, Bool exported) {
    return (Symbol){.name = name, .kind = .type_name, .type = type, .decl = d, .exported = exported};
}

// Whether a declaration carries `@affine` (written `[[std::affine]]` in today's syntax).
static Bool marks_affine(const ast::Decl *d) {
    for (Usize i = 0; i < countof(d->attributes); i++) {
        ast::Identifier segments[:] = d->attributes[i].name.segments;
        Usize n = countof(segments);
        if (n > 0 && same_text(segments[n - 1].text, "affine")) return true;
    }
    return false;
}

// Pass 1: the nominal types, so that any order of use works.
// The C name `@c_name("...")` gives a record, or empty.
static Str record_c_name(const ast::Decl *d) {
    for (Usize i = 0; i < countof(d->attributes); i++) {
        ast::Attribute attribute = d->attributes[i];
        ast::Path name = attribute.name;
        Usize n = countof(name.segments);
        Bool is_c_name =
            (n == 1 && same_text(name.segments[0].text, "c_name")) ||
            (n == 2 && same_text(name.segments[0].text, "std") && same_text(name.segments[1].text, "c_name"));
        if (!is_c_name || countof(attribute.args) == 0) continue;
        const ast::Expr *argument = attribute.args[0];
        if (argument->kind == .string) return argument->kind.string.bytes;
    }
    return "";
}

// Whether `a` and `b` are the same C struct: a record of the module tagged `@c_name("X")` and the header's `struct X`.
export Bool same_c_record(TypeRef a, TypeRef b) {
    if (a == b) return true;
    if (a->kind != .record || b->kind != .record) return false;
    Str a_name = c_name_of(a);
    if (countof(a_name) == 0) return false;
    return same_text(a_name, c_name_of(b));
}

static void declare_nominal(Checked *r, const ast::Decl *d) {
    Bool from_c = d->from_c;
    Bool exported = d->exported;
    ast::Span span = d->span;
    if (d->kind == .record) {
        Bool forward = d->kind.record.opaque;
        Str from_header = d->kind.record.name;
        Str name = qualified(r, from_c, d->kind.record.name);
        Ty *made = new_record(&r->table, name, d->kind.record.is_union);
        set_marks(made, marks_affine(d), from_c ? from_header : record_c_name(d));
        // A forward declaration (`struct Expr` alone) and the definition that follows it are one type (#2329).
        Symbol *earlier = nullptr;
        Usize found = find_below(&r->scopes, name, r->scopes.count);
        if (found > 0) earlier = &r->scopes.symbols[found - 1];
        if (earlier != nullptr && earlier->kind == .type_name && declared_by_record(earlier)) {
            if (forward) return;
            if (declared_opaque(earlier)) {
                *earlier = type_symbol(name, made, d, exported);
                return;
            }
        }
        declare_in_module(r, type_symbol(name, made, d, exported), span);
    } else if (d->kind == .enumeration) {
        Str name = qualified(r, from_c, d->kind.enumeration.name);
        const ast::TypeExpr *over = d->kind.enumeration.underlying;
        TypeRef underlying = builtin(&r->table, "I32");
        if (over != nullptr) {
            underlying = resolve(r, over);
            if (underlying->kind != .integer) {
                if (underlying != r->table.invalid) {
                    failf(r, span, "an enumeration is over an integer type, not `", show(underlying), "`; write `enum ",
                          name, " : U8`");
                }
                underlying = builtin(&r->table, "I32");
            }
        }
        Ty *made = new_enumeration(&r->table, name, underlying);
        declare_in_module(r, type_symbol(name, made, d, exported), span);
    }
}

// A name or a type value read where a value is read, as a type: null when it is neither. A name counts when it is a
// builtin or a type in scope (`i32`, `Meters`), so `const origin = (x, y)` of values stays a value.
static ast::TypeExpr *leaf_as_type(Checked *r, const ast::Expr *e) {
    if (e->kind == .type_value) return e->kind.type_value.type;
    if (e->kind != .name) return nullptr;
    ast::Path path = e->kind.name.path;
    Bool builtin_name = false;
    if (countof(path.segments) == 1) {
        Str own = own_builtin(path.segments[0].text);
        builtin_name = countof(own) > 0 && builtin(&r->table, own) != nullptr;
    }
    const Symbol *found = builtin_name ? nullptr : type_through_modules(r, path);
    if (!builtin_name && (found == nullptr || found->kind != .type_name)) return nullptr;
    return ast::make_type({.named = {.path = path}});
}

typedef ast::TypeRef TypeRefList[:];

static TypeRefList type_slice(Usize count) {
    ast::TypeRef *block = (ast::TypeRef *)mem::alloc_array_raw(sizeof(ast::TypeRef), count, alignof(ast::TypeRef));
    TypeRefList list = block[0:count];
    return list;
}

// `(i32, f32)` where a value is read: the type it stands for, or null when an element is no type. `tuple_as_type` also
// takes a tuple of such tuples (`(Meters, (f32, f32))`); deeper nesting is not an alias, since a checker function
// cannot recurse.
static ast::TypeExpr *pair_as_type(Checked *r, const ast::Expr *e) {
    if (e->kind != .tuple_lit) return nullptr;
    ast::ExprRef items[:] = e->kind.tuple_lit.items;
    if (countof(items) < 2) return nullptr;
    ast::TypeRef elements[:] = type_slice(countof(items));
    for (Usize i = 0; i < countof(items); i++) {
        elements[i] = leaf_as_type(r, items[i]);
        if (elements[i] == nullptr) return nullptr;
    }
    return ast::make_type({.tuple = {.elements = elements}});
}

static ast::TypeExpr *tuple_as_type(Checked *r, const ast::Expr *e) {
    if (e->kind != .tuple_lit) return nullptr;
    ast::ExprRef items[:] = e->kind.tuple_lit.items;
    if (countof(items) < 2) return nullptr;
    ast::TypeRef elements[:] = type_slice(countof(items));
    for (Usize i = 0; i < countof(items); i++) {
        elements[i] = leaf_as_type(r, items[i]);
        if (elements[i] == nullptr) elements[i] = pair_as_type(r, items[i]);
        if (elements[i] == nullptr) return nullptr;
    }
    return ast::make_type({.tuple = {.elements = elements}});
}

// Whether a name is written like a type of C: a capital first, a lowercase letter later (`FILE` and `EOF` are not).
static Bool looks_like_type_name(Str name) {
    if (countof(name) < 2 || name[0] < 'A' || name[0] > 'Z') return false;
    for (Usize i = 1; i < countof(name); i++) {
        if (name[i] >= 'a' && name[i] <= 'z') return true;
    }
    return false;
}

// `let Allocator = c.SmithAllocator`: `c` a binding of an imported C header (or the old global `c`) and the name a type
// of that header. The alias stands for the type written as the path `c.SmithAllocator`; null when `init` is anything
// else.
static ast::TypeExpr *header_type_alias(Checked *r, const ast::Expr *init) {
    ast::Identifier segments[:] = mem::alloc_slice(ast::Identifier, 2);
    ast::Identifier header = {};
    Str thing = "";
    ast::Path pair = {};
    if (member_of_name(init, &header, &thing)) {
        segments[0] = header;
        segments[1] = (ast::Identifier){.text = thing, .span = init->span};
    } else if (name_path(init, &pair) && countof(pair.segments) == 2) {
        // a capitalized `c.Thing` is read as one qualified name
        segments[0] = pair.segments[0];
        segments[1] = pair.segments[1];
    } else {
        return nullptr;
    }
    Str first = segments[0].text;
    if (!same_text(first, "c") && header_binding(r, first) == nullptr) return nullptr;
    ast::Path path = {.segments = segments, .span = init->span};
    const Symbol *found = nullptr;
    if (same_text(first, "c")) {
        found = lookup(&r->scopes, msg(format::push("c::", segments[1].text)));
    } else {
        found = type_through_modules(r, path);
    }
    // A header the importer does not read (the fixer reads an import without its headers) leaves the name unfound: a
    // capitalized name with a lowercase letter, which a macro or a constant does not have, still stands for a type
    // (#2602: `Allocator := c.SmithAllocator` in std.mem), typed as unknown.
    if (found == nullptr && r->options.headers == nullptr && looks_like_type_name(segments[1].text)) {
        return ast::make_type({.named = {.path = path}});
    }
    if (found == nullptr || found->kind != .type_name) return nullptr;
    return ast::make_type({.named = {.path = path}});
}

// `Count := U64`, `Image := Other`: a binding whose value is the name of a type declared before it is an alias of that
// type (#2323). The rule is on the binding's value, not on the keyword that spells it.
static ast::TypeExpr *named_type_alias(Checked *r, const ast::Expr *init) {
    if (init->kind != .name || countof(init->kind.name.path.segments) != 1) return nullptr;
    Str written = init->kind.name.path.segments[0].text;
    const Symbol *found = lookup(&r->scopes, written);
    Str own = own_builtin(written);
    if (found == nullptr && countof(own) > 0) {
        return ast::make_type({.named = {.path = init->kind.name.path}}); // `Wide := u128`: a builtin type
    }
    if (found == nullptr || found->kind != .type_name) return nullptr;
    return ast::make_type({.named = {.path = init->kind.name.path}});
}

// The type a `let`/`const` of smith's own syntax stands for, or null when it is a value: `let Line = []u8` is a type
// value, `const Pair = (i32, f32)` a tuple of types. It is plain substitution.
static ast::TypeExpr *own_alias_type(Checked *r, const ast::Decl *d) {
    if (d->kind != .variable || !d->kind.variable.is_new) return nullptr;
    const ast::Expr *init = d->kind.variable.init;
    if (init == nullptr) return nullptr;
    if (init->kind == .type_value) return init->kind.type_value.type;
    if (init->kind == .tuple_lit) return tuple_as_type(r, init);
    ast::TypeExpr *header = header_type_alias(r, init);
    if (header != nullptr) return header;
    return named_type_alias(r, init);
}

static void declare_own_alias(Checked *r, const ast::Decl *d) {
    ast::TypeExpr *written = own_alias_type(r, d);
    if (written == nullptr || d->kind != .variable) return;
    r->new_syntax = true;
    TypeRef target = resolve(r, written);
    r->new_syntax = false;
    declare_in_module(r, type_symbol(qualified(r, false, d->kind.variable.name), target, d, d->exported), d->span);
}

// Pass 2: aliases in the order written.
static void declare_alias(Checked *r, const ast::Decl *d) {
    if (own_alias_type(r, d) != nullptr) {
        declare_own_alias(r, d);
        return;
    }
    Bool from_c = d->from_c;
    Bool exported = d->exported;
    ast::Span span = d->span;
    if (d->kind == .type_alias) {
        Str name = qualified(r, from_c, d->kind.type_alias.name);
        const ast::TypeExpr *aliased = d->kind.type_alias.type;
        TypeRef target = resolve(r, aliased);
        declare_in_module(r, type_symbol(name, target, d, exported), span);
    }
}

static void fill_record(Checked *r, const ast::Decl *d, Str name) {
    if (d->kind != .record) return;
    Bool opaque = d->kind.record.opaque;
    ast::FieldDecl members[:] = d->kind.record.fields;
    const Symbol *symbol = lookup_as(&r->scopes, name, true); // a function of the tag's name may be declared (#2610)
    if (symbol == nullptr || opaque) return;
    Usize n = countof(members);
    Slot fields[:] = mem::alloc_slice(Slot, n);
    for (Usize i = 0; i < n; i++) {
        const ast::FieldDecl *f = &members[i];
        fields[i].name = f->name;
        fields[i].is_pub = f->is_pub || !f->is_new;
        fields[i].default_value = f->default_value;
        fields[i].doc = f->doc;
        fields[i].attributes = f->attributes;
        fields[i].written = f->is_new ? f->type : nullptr;
        if (f->is_pub && !(d->is_pub || d->exported) && countof(d->kind.record.name) > 0) {
            failf(r, f->span, "the field `", f->name, "` is `pub`, but `", name,
                  "` is not; nothing outside the module can see the type, so mark the struct `pub` or drop the `pub`");
        }
        r->new_syntax = true;
        fields[i].type = resolve(r, f->type);
        r->new_syntax = false;
        TypeRef field_type = fields[i].type;
        if (field_type->kind == .concept_type) {
            failf(r, f->span, "the field `", f->name, "` has the concept `", name_of(field_type),
                  "` as its type; a struct field needs a concrete type such as `i32`");
            fields[i].type = r->table.invalid;
        }
        if (f->bit_width != nullptr) {
            failf(r, f->span, "not yet typed: a bit-field");
        }
        for (Usize k = 0; k < i; k++) {
            if (same_text(fields[k].name, f->name)) {
                failf(r, f->span, "the field `", f->name, "` is declared twice in `", name, "`; rename one");
            }
        }
    }
    Ty *made = own(&r->table, symbol->type);
    if (made != nullptr) {
        set_fields(made, fields);
        set_owner(made, r->prefix);
    }
}

static void fill_enumeration(Checked *r, Str name, ast::Enumerator members[:]) {
    const Symbol *symbol = lookup_as(&r->scopes, name, true);
    if (symbol == nullptr) return;
    Usize n = countof(members);
    Slot items[:] = mem::alloc_slice(Slot, n);
    U64 next = 0;
    Bool has_payload = false;
    for (Usize i = 0; i < n; i++) {
        has_payload = has_payload || members[i].payload != nullptr;
    }
    for (Usize i = 0; i < n; i++) {
        const ast::Enumerator *item = &members[i];
        const ast::Expr *value = item->value;
        Bool literal = integer_of(value, &next);
        if (!literal && value != nullptr) {
            failf(r, value->span, "not yet typed: an enumerator value that is not an integer literal");
        }
        TypeRef carried = r->table.void_type;
        if (symbol->type->kind == .enumeration) carried = symbol->type->kind.enumeration.element;
        if (has_payload) {
            // A payload struct the fixer converted holds types in smith's own spelling (`bool`, `*T`) (#2329).
            r->new_syntax = true;
            carried = item->payload != nullptr ? resolve(r, item->payload) : r->table.void_type;
            r->new_syntax = false;
        }
        items[i] = make_slot(item->name, carried);
        items[i].value = next;
        // The payload as written, for a fix that edits it (`*T` to `*mut T`, #2647): only where the source being
        // mended is the module's own, so the span reaches the right text.
        if (has_payload && countof(r->prefix) == 0) items[i].written = item->payload;
        next += 1;
    }
    Ty *made = own(&r->table, symbol->type);
    if (made != nullptr) {
        set_fields(made, items);
        set_payload(made, has_payload);
    }
}

// Whether the written type is the bare name `Type`: a type argument as a parameter, the result of a type function.
static Bool is_type_name(const ast::TypeExpr *written) {
    if (written == nullptr || written->kind != .named) return false;
    ast::Path path = written->kind.named.path;
    return countof(path.segments) == 1 &&
           (same_text(path.segments[0].text, "Type") || same_text(path.segments[0].text, "type"));
}

// The value parameters used in a type of their function's signature (`n` in `fn table(n: usize) -> [n]f32:`), by
// where the name is written: a copy of a template (an instance) shares the source texts and the spans, so its
// parameters are found too. Filled by `mark_used_in_types` when a function is declared; a fixed table, since it
// outlives the allocator of any one check (past its room a parameter stays a run-time one).
struct UsedInTypes {
    const char *name;
    ast::Span span;
};

static UsedInTypes used_in_types[4096];
static Usize used_in_types_count = 0;

static Bool is_used_in_types(const ast::Param *p) {
    if (countof(p->name) == 0) return false;
    for (Usize i = 0; i < used_in_types_count; i++) {
        const UsedInTypes *u = &used_in_types[i];
        if (u->name == &p->name[0] && u->span.start == p->span.start && u->span.end == p->span.end) return true;
    }
    return false;
}

// Whether the expression (an array's count, a value argument of a type function) names `name`.
static Bool names_in(const ast::Expr *e, Str wanted) {
    const ast::Expr *todo[32];
    Usize n = 0;
    if (e != nullptr) todo[n++] = e;
    while (n > 0) {
        const ast::Expr *x = todo[--n];
        if (x->kind == .name) {
            ast::Path path = x->kind.name.path;
            if (countof(path.segments) == 1 && same_text(path.segments[0].text, wanted)) return true;
        }
        if (x->kind == .binary && n + 2 <= countof(todo)) {
            todo[n++] = x->kind.binary.left;
            todo[n++] = x->kind.binary.right;
        }
        if (x->kind == .unary && n < countof(todo)) todo[n++] = x->kind.unary.operand;
    }
    return false;
}

// Whether the written type uses `name` as a value: `[n]f32`, `[n, 3]T`, `Array(f32, n)`, anywhere inside it.
static Bool type_uses(const ast::TypeExpr *t, Str name) {
    const ast::TypeExpr *todo[32];
    Usize n = 0;
    if (t != nullptr) todo[n++] = t;
    while (n > 0) {
        const ast::TypeExpr *x = todo[--n];
        if (x == nullptr) continue;
        if (x->kind == .array && names_in(x->kind.array.count, name)) return true;
        if (x->kind == .block_type) {
            for (Usize i = 0; i < countof(x->kind.block_type.dims); i++)
                if (names_in(x->kind.block_type.dims[i], name)) return true;
        }
        if (x->kind == .applied) {
            for (Usize i = 0; i < countof(x->kind.applied.args); i++) {
                const ast::TypeArg *arg = &x->kind.applied.args[i];
                if (*arg == .value && names_in(arg->value.value, name)) return true;
            }
        }
        Usize children = 1;
        if (x->kind == .function) children = countof(x->kind.function.params) + 1;
        if (x->kind == .tuple) children = countof(x->kind.tuple.elements);
        if (x->kind == .applied) children = countof(x->kind.applied.args);
        for (Usize i = 0; i < children && n < countof(todo); i++) {
            const ast::TypeExpr *inner = child(x, i);
            if (inner != nullptr) todo[n++] = inner;
        }
    }
    return false;
}

// Whether the written type names `name` as a type, anywhere inside it: `T`, `T *`, `T[:]`, `Option(T)`.
static Bool type_names(const ast::TypeExpr *t, Str name) {
    const ast::TypeExpr *todo[32];
    Usize n = 0;
    if (t != nullptr) todo[n++] = t;
    while (n > 0) {
        const ast::TypeExpr *x = todo[--n];
        if (x == nullptr) continue;
        if (x->kind == .named && countof(x->kind.named.path.segments) == 1 &&
            same_text(x->kind.named.path.segments[0].text, name))
            return true;
        Usize children = 1;
        if (x->kind == .function) children = countof(x->kind.function.params) + 1;
        if (x->kind == .tuple) children = countof(x->kind.tuple.elements);
        if (x->kind == .applied) children = countof(x->kind.applied.args);
        for (Usize i = 0; i < children && n < countof(todo); i++) {
            const ast::TypeExpr *inner = child(x, i);
            if (inner != nullptr) todo[n++] = inner;
        }
    }
    return false;
}

// Whether the result of a function names one of its own type parameters (`T *push(Pool *p, constexpr Type T)`): the
// call site says what the result is, as it says what the argument `T` is (#3101).
static Bool result_names_type_parameter(ast::Param list[:], const ast::TypeExpr *result_type) {
    for (Usize i = 0; i < countof(list); i++) {
        if (is_type_name(list[i].type) && type_names(result_type, list[i].name)) return true;
    }
    return false;
}

// Marks the value parameters of a function in smith's own syntax that a type of its signature uses: they are known at
// compile time, with one instance per value (owner, 2026-11-08: "Yeah, drop const from parameters").
static void mark_used_in_types(ast::Param list[:], const ast::TypeExpr *result_type) {
    for (Usize i = 0; i < countof(list); i++) {
        const ast::Param *p = &list[i];
        if (!p->is_new || p->is_rest || p->is_pack || p->is_gather || p->is_const || countof(p->name) == 0) continue;
        if (p->type == nullptr || is_type_name(p->type) || is_used_in_types(p)) continue;
        Bool used = type_uses(result_type, p->name);
        for (Usize k = 0; k < countof(list) && !used; k++)
            if (k != i) used = type_uses(list[k].type, p->name);
        if (!used) continue;
        if (used_in_types_count == countof(used_in_types)) return;
        used_in_types[used_in_types_count] = (UsedInTypes){.name = &p->name[0], .span = p->span};
        used_in_types_count += 1;
    }
}

// Whether a parameter is known at compile time in smith's own syntax: `T: type`, a value a type of the signature uses
// (`n` in `fn table(n: usize) -> [n]f32:`), or the old marker `const n: usize`, kept until the parser stops writing it.
export Bool is_compile_time(const ast::Param *p) {
    return p->is_new && (is_type_name(p->type) || p->is_const || is_used_in_types(p)) && !p->is_rest;
}

// Whether a compile-time parameter is a type (`T: type`), else a constant (`const n: usize`).
export Bool is_type_parameter(const ast::Param *p) {
    return is_type_name(p->type);
}

// Whether a written type is a slice of `auto` (`const auto xs[:]`): the call's argument must be a slice, and the
// instance keeps its element type and the parameter's `const` (#2070).
export Bool is_auto_slice(const ast::TypeExpr *t) {
    if (t == nullptr || t->kind != .slice) return false;
    const ast::TypeExpr *inner = t->kind.slice.element;
    return inner != nullptr && inner->kind == .auto_type;
}

// Whether a written type is a pointer to `auto` (`arg: *auto`, `*mut auto`): the call's argument must be a pointer, and
// the instance keeps its pointee type, read-only when the parameter is (#3593).
export Bool is_auto_pointer(const ast::TypeExpr *t) {
    if (t == nullptr || t->kind != .pointer) return false;
    const ast::TypeExpr *inner = t->kind.pointer.pointee;
    return inner != nullptr && inner->kind == .auto_type;
}

// Whether a parameter is written `auto x` (today's syntax) or `x: auto` (smith's own): its type is the type each call
// passes, so the function is a template with one instance per set of argument types (#1934). A `; kw...` parameter is
// one too: its type is the named tuple of the call's leftover named arguments (#1985).
export Bool is_auto_param(const ast::Param *p) {
    if (p->is_gather) return p->is_new && !p->is_pack;
    if (p->is_pack) return p->is_new; // `rest...`: its type is the tuple of the leftover positional arguments
    if (p->type == nullptr || p->is_rest || p->is_pack || p->is_gather) return false;
    // `a: num` (smith's own syntax): a concept in a parameter is an implicit generic parameter of its own (#1701)
    if (p->is_new && countof(written_concept(p->type)) > 0) return true;
    return is_auto_slice(p->type) || is_auto_pointer(p->type) || p->type->kind == .auto_type;
}

// Whether a written slice type's element is `const` (`const T[:]`).
static Bool const_element(const ast::TypeExpr *t) {
    if (t->kind != .slice) return false;
    return t->kind.slice.element->qualifiers.is_const;
}

// The slice of `given`'s element, `const` when `given`'s is or `fixed` says so; null when `given` is no slice.
static TypeRef slice_with(Checked *r, TypeRef given, Bool fixed) {
    if (given->kind != .slice) return nullptr;
    return slice_of(&r->table, given->kind.slice.element, given->kind.slice.pointee_const || fixed);
}

// The type an `auto` parameter is bound to for an argument of type `given`: the argument's type, and for a slice of
// `auto` its element with the parameter's `const` added; null when the argument is not a slice.
export TypeRef auto_binding(Checked *r, const ast::Param *p, TypeRef given) {
    if (is_auto_pointer(p->type)) {
        if (given->kind != .pointer) return nullptr;
        Bool is_read_only = p->type->kind == .pointer && !p->type->kind.pointer.is_mut;
        return pointer_to(&r->table, given->kind.pointer.element, given->kind.pointer.pointee_const || is_read_only);
    }
    if (!is_auto_slice(p->type) || p->type->kind != .slice) return given;
    return slice_with(r, given, const_element(p->type));
}

// A function with a body and a compile-time or `auto` parameter, whose result is not a type, is a template (#1908,
// #1934): its body is checked in each instance, not here. A type function (`-> type`) and a prototype are ordinary.
static Bool is_template(const ast::Decl *d, ast::Param list[:], const ast::TypeExpr *result_type) {
    if (d->kind != .function || d->kind.function.body == nullptr || is_type_name(result_type)) return false;
    if (countof(d->kind.function.generics) > 0) return true; // `fn f[T](...)`: one instance per set of bindings (#1698)
    for (Usize i = 0; i < countof(list); i++) {
        if (is_compile_time(&list[i]) || is_auto_param(&list[i])) return true;
    }
    return false;
}

// The template's symbol: a signature with no types, since a call finds the instance's.
static void declare_template(Checked *r, const ast::Decl *d, Str name, ast::Param list[:]) {
    Slot params[:] = mem::alloc_slice(Slot, countof(list));
    for (Usize i = 0; i < countof(list); i++) {
        params[i] = make_slot(list[i].name, r->table.invalid);
    }
    TypeRef type = function_of(&r->table, params, r->table.invalid, false);
    Symbol symbol = {.name = name, .kind = .function_symbol, .type = type, .decl = d, .exported = d->exported};
    symbol.generic = true;
    declare_in_module(r, symbol, d->span);
}

static void declare_function(Checked *r, const ast::Decl *d, Str name, ast::Param list[:],
                             const ast::TypeExpr *result_type, Bool variadic) {
    mark_used_in_types(list, result_type);
    if (is_template(d, list, result_type)) {
        declare_template(r, d, name, list);
        return;
    }
    Usize n = countof(list);
    Slot params[:] = mem::alloc_slice(Slot, n);
    push_scope(&r->scopes); // the parameters, for a `typeof(a)` after them
    for (Usize i = 0; i < n; i++) {
        const ast::Param *p = &list[i];
        params[i].name = p->name;
        if (p->is_pack || p->is_gather) {
            failf(r, p->span, p->is_pack ? "not yet: positional packs" : "not yet: gathered keywords");
            params[i].type = r->table.invalid;
        } else if (is_type_name(p->type)) {
            if (!p->is_constexpr && !p->is_new) {
                failf(r, p->span, "parameter `", p->name,
                      "` has type `Type`, so it is compile-time: write `constexpr Type ", p->name, "`");
            }
            // a type argument is not typed yet: the call site will say what it is (`T: type` is compile-time on its
            // own in smith's own syntax)
            params[i].type = p->is_new ? builtin(&r->table, "type") : r->table.invalid;
        } else if ((p->is_constexpr || p->is_rest) && !p->is_new) {
            failf(r, p->span, "not yet typed: a compile-time or rest parameter");
            params[i].type = r->table.invalid;
        } else if (p->type == nullptr) {
            failf(r, p->span, "the parameter `", p->name, "` has no type; write its type before the name");
            params[i].type = r->table.invalid;
        } else {
            r->new_syntax = p->is_new;
            params[i].type = resolve(r, p->type);
            r->new_syntax = false;
            TypeRef param_type = params[i].type;
            if (param_type->kind == .concept_type && d->exported) {
                failf(r, p->span, "`", p->name, "` has the concept `", name_of(param_type),
                      "` as its type, and a `pub` function is called from C and other modules: write a concrete ",
                      "type such as `i32`, or drop `pub`");
            }
        }
        declare(
            &r->scopes,
            (Symbol){
                .name = p->name, .kind = .variable, .type = params[i].type, .is_new = p->is_new, .written = p->type});
    }
    TypeRef result = r->table.void_type;
    if (result_names_type_parameter(list, result_type)) {
        result = r->table.invalid; // its type is the argument's: `T` is not a type here (#3101)
    } else if (result_type != nullptr && !is_type_name(result_type)) {
        r->new_syntax = (countof(list) > 0 && list[0].is_new) || is_new_function(d);
        result = resolve(r, result_type); // (`Type`: a type function)
        r->new_syntax = false;
    }
    pop_scope(&r->scopes);
    TypeRef type = function_of(&r->table, params, result, variadic);
    Symbol symbol = {.name = name, .kind = .function_symbol, .type = type, .decl = d, .exported = d->exported};
    // C keeps struct tags apart from functions (`struct sigaction`, `sigaction()`): the function of a header takes
    // `name()` where a struct already has the plain name (#2611).
    const Symbol *tagged = r->in_header ? lookup(&r->scopes, name) : nullptr;
    if (tagged != nullptr && tagged->kind == .type_name) symbol.name = msg(format::push(name, "()"));
    declare_in_module(r, symbol, d->span);
}

// Whether an instance of `template` with these bindings exists; its index, or max when there is none.
static Usize find_instance(const Checked *r, const ast::Decl *template, Binding given[:]) {
    for (Usize i = 0; i < r->instance_count; i++) {
        const Instance *x = &r->instances[i];
        if (x->template != template || countof(x->bindings) != countof(given)) continue;
        Bool same = true;
        for (Usize k = 0; k < countof(given); k++) {
            // A constant (`const n: usize`) is given with no type: the instance holds the parameter's own, so the
            // value is all there is to compare, or no call of a template with a constant would find its instance.
            if (x->bindings[k].is_type != given[k].is_type ||
                (given[k].is_type && x->bindings[k].type != given[k].type) || x->bindings[k].value != given[k].value) {
                same = false;
            }
        }
        if (same) return i;
    }
    return r->instance_count + max_instances;
}

// A type as an instance name spells it: a scalar in smith's own lowercase (`i32`, `f64`, `bool`), others as `show`.
static Str instance_type_name(TypeRef t) {
    Str shown = show(t);
    if (t->kind != .integer && t->kind != .floating && t->kind != .bool_type) return shown;
    char lower[:] = mem::alloc_slice(char, countof(shown));
    for (Usize i = 0; i < countof(shown); i++) {
        char ch = shown[i];
        lower[i] = ch >= 'A' && ch <= 'Z' ? (char)(ch + ('a' - 'A')) : ch;
    }
    return lower;
}

// The name of an instance: `alloc.i32`, `table.64`, stable and readable in a debugger.
static Str instance_name(Str base, Binding bindings[:]) {
    Str name = base;
    for (Usize i = 0; i < countof(bindings); i++) {
        if (bindings[i].is_type) {
            name = msg(format::push(name, ".", instance_type_name(bindings[i].type)));
        } else {
            name = msg(format::push(name, ".", bindings[i].value));
        }
    }
    return name;
}

// Binds the compile-time parameters of an instance in the innermost scope: a type is a type name, a value a constant.
export void bind_instance(Checked *r, const Instance *x) {
    for (Usize i = 0; i < countof(x->bindings); i++) {
        const Binding *b = &x->bindings[i];
        SymbolKind kind = .variable;
        if (b->is_type) kind = .type_name;
        Symbol symbol = {.name = b->name, .kind = kind, .type = b->type};
        symbol.is_new = true;
        symbol.is_const = true;
        symbol.has_value = !b->is_type;
        symbol.value = b->value;
        declare(&r->scopes, symbol);
    }
}

// Records that `call` is a call of the instance `instance`.
export void use_instance(Checked *r, const ast::Expr *call, Usize instance) {
    if (r->use_count == countof(r->uses)) {
        Usize capacity = countof(r->uses) * 2;
        if (capacity < 8) capacity = 8;
        r->uses = mem::realloc(r->uses, capacity);
    }
    r->uses[r->use_count] = (InstanceUse){.call = call, .instance = instance, .outer = r->current, .module = r->prefix};
    r->use_count += 1;
}

// The index of the instance `call` calls inside the body of the instance `outer` (`max_instances` for a call outside
// every instance), or `max_instances` when it calls no generic function. A generic's body is one tree whatever its
// instances, so one call node is recorded once per instance of the function that holds it (#2669).
export Usize instance_called_in(const Checked *r, const ast::Expr *call, Usize outer) {
    for (Usize i = 0; i < r->use_count; i++) {
        if (r->uses[i].call == call && r->uses[i].outer == outer) return r->uses[i].instance;
    }
    return max_instances;
}

// The same for the body being checked now. Outside a check (the emitter) `current` is `max_instances`, and a call
// recorded in an instance answers with the first record, as before, until the emitter asks `instance_called_in`.
export Usize instance_called(const Checked *r, const ast::Expr *call) {
    Usize at = instance_called_in(r, call, r->current);
    if (at < max_instances) return at;
    for (Usize i = 0; i < r->use_count; i++) {
        if (r->uses[i].call == call) return r->uses[i].instance;
    }
    return max_instances;
}

// ---------------------------------------------------------------------------------------------------------------
// The lists `fields(T)` and `parameters(F)` (#2295): what front::reflect asks of the checker

static Checked *reflecting = nullptr;

static const Symbol *reflected_symbol(Str subject, Bool is_type) {
    if (reflecting == nullptr) return nullptr;
    const Symbol *s = lookup(&reflecting->scopes, subject);
    if (s == nullptr) return nullptr;
    if (is_type) return s->kind == .type_name ? s : nullptr;
    return s->kind == .function_symbol ? s : nullptr;
}

// How many fields the module being checked may name.
static Usize visible_count(const Ty *record) {
    Usize seen = 0;
    for (Usize i = 0; i < countof(slots_of(record).items); i++)
        if (field_visible(record, &slots_of(record).items[i])) seen += 1;
    return seen;
}

// The `at`-th field the module being checked may name, in order; null when there are fewer.
static const Slot *visible_at(const Ty *record, Usize at) {
    Usize seen = 0;
    for (Usize i = 0; i < countof(slots_of(record).items); i++) {
        if (!field_visible(record, &slots_of(record).items[i])) continue;
        if (seen == at) return &slots_of(record).items[i];
        seen += 1;
    }
    return nullptr;
}

// The base of a type as smith's own syntax writes it: the builtin scalars are lowercase (`i32`, `usize`, `bool`,
// `str`).
static Str written_base(TypeRef t) {
    Str shown = show(t);
    if (t->kind != .integer && t->kind != .floating && t->kind != .bool_type && t->kind != .text) return shown;
    char lowered[:] = mem::alloc_slice(char, countof(shown));
    for (Usize i = 0; i < countof(shown); i++) {
        char ch = shown[i];
        lowered[i] = ch >= 'A' && ch <= 'Z' ? (char)(ch - 'A' + 'a') : ch;
    }
    Str text = lowered;
    return text;
}

// The type as smith's own syntax writes it: a pointer `*T` or `*mut T`, a slice `[]T` or `[]mut T`, an array `[N]T`,
// peeled from the outside in (#3609: a field of `fields(T)` is read back as this text, so `F64[:]` must be `[]mut
// f64`).
static Str written_name(TypeRef t) {
    Str prefix = "";
    for (Usize depth = 0; depth < 64; depth++) {
        if (t->kind == .pointer) {
            char grown[:] = format::push(prefix, t->kind.pointer.pointee_const ? "*" : "*mut ");
            prefix = grown;
            t = t->kind.pointer.element;
        } else if (t->kind == .slice) {
            char grown[:] = format::push(prefix, t->kind.slice.pointee_const ? "[]" : "[]mut ");
            prefix = grown;
            t = t->kind.slice.element;
        } else if (t->kind == .array) {
            char grown[:] = format::push(prefix, "[", t->kind.array.count, "]");
            prefix = grown;
            t = t->kind.array.element;
        } else {
            break;
        }
    }
    if (countof(prefix) == 0) return written_base(t);
    char joined[:] = format::push(prefix, written_base(t));
    Str text = joined;
    return text;
}

static Bool reflect_count(Str kind, Str subject, Usize *count) {
    if (same_text(kind, "fields")) {
        const Symbol *s = reflected_symbol(subject, true);
        if (s == nullptr || s->type->kind != .record || !is_complete(s->type)) return false;
        *count = visible_count(s->type);
        return true;
    }
    const Symbol *s = reflected_symbol(subject, false);
    return declared_arity(s, count);
}

static ast_clone::Entry reflect_at(Str kind, Str subject, Usize at) {
    if (same_text(kind, "fields")) {
        const Symbol *owner = reflected_symbol(subject, true);
        const Slot *slot = visible_at(owner->type, at);
        return (ast_clone::Entry){.name = slot->name,
                                  .type_name = written_name(slot->type),
                                  .doc = slot->doc,
                                  .attributes = slot->attributes,
                                  .default_value = slot->default_value};
    }
    const Symbol *s = reflected_symbol(subject, false);
    const ast::Param *param = declared_param(s, at);
    if (param == nullptr) return (ast_clone::Entry){};
    Str shown = "";
    if (at < countof(slots_of(s->type).items)) shown = written_name(slots_of(s->type).items[at].type);
    return (ast_clone::Entry){
        .name = param->name, .type_name = shown, .attributes = param->attributes, .default_value = nullptr};
}

static void reflect_fail(ast::Span span, Str message) {
    failf(reflecting, span, message);
}

// ---------------------------------------------------------------------------------------------------------------
// D20 (owner, 2026-11-07: "A"): `for (i, x) in enumerate(list)` over a pack, `fields(T)` or `parameters(F)` is unrolled
// as `for x in list` is, since each element has its own type, and `i` is a compile-time `usize` in each copy: the copy
// is a block of `const i: usize = <at>`, then `x := rest.<at>` for a pack (`x` stands for `fields(T)[<at>]` in a list,
// which `ast_clone` expands after), then the body.

static Str enumerated_pack;
static Usize enumerated_count = 0;
static Bool enumerated_any = false;
static Str substituted_name;
static Str substituted_index;
static ast::Expr *substituted_list = nullptr;
static Usize substituted_at = 0;

static Str single_name_of(const ast::Expr *e) {
    Str none = "";
    if (e == nullptr || e->kind != .name || countof(e->kind.name.path.segments) != 1) return none;
    return e->kind.name.path.segments[0].text;
}

static Usize typed_subjects = 0;
static const ast::Decl *expanding = nullptr; // the function whose lists `expand_reflection` is rewriting

// The type of the variable `typeof(v)` names, or null: the new syntax may read the operand `v` as a type name.
static TypeRef typeof_variable(const Checked *r, const ast::Expr *operand) {
    Str name = single_name_of(operand);
    if (operand == nullptr) return nullptr;
    if (operand->kind == .type_value && operand->kind.type_value.type != nullptr &&
        operand->kind.type_value.type->kind == .named &&
        countof(operand->kind.type_value.type->kind.named.path.segments) == 1) {
        name = operand->kind.type_value.type->kind.named.path.segments[0].text;
    }
    if (countof(name) == 0) return nullptr;
    // A parameter written with a type of the instance (`x: U`, `U` bound here): its type, resolved in the instance. It
    // is the variable `x` the body means, whatever a function being checked around this one calls `x`.
    ast::Param params[:] = {};
    const ast::Decl *decl = expanding;
    if (decl != nullptr) {
        if (decl->kind == .function) params = decl->kind.function.params;
    }
    {
        for (Usize i = 0; i < countof(params); i++) {
            if (!same_text(params[i].name, name) || params[i].type == nullptr || is_auto_param(&params[i])) continue;
            if (params[i].is_pack || params[i].is_rest) continue;
            Checked *m = reflecting;
            if (m == nullptr) continue;
            Usize errors = m->error_count;
            Bool was_new = m->new_syntax;
            m->new_syntax = true;
            TypeRef t = resolve(m, params[i].type);
            m->new_syntax = was_new;
            m->error_count = errors;
            if (t != nullptr && t != r->table.invalid) return t;
        }
    }
    // Before an instance's parameters are declared, an `auto` parameter `v` is bound as `$auto.v` (`bind_given`). It
    // comes first: an instance made while another is being checked (a walk that calls itself with a field's type)
    // would otherwise find the variable `v` of the outer instance, and read the fields of the wrong type.
    const Symbol *found = lookup(&r->scopes, msg(format::push("$auto.", name)));
    if (found != nullptr) return found->type;
    found = lookup(&r->scopes, name);
    if (found != nullptr && found->kind == .variable) return found->type;
    return nullptr;
}

// The type of `v`, `p.*` or `p.f` (a field through a pointer too), a few steps from a variable: the subject of
// `fields(typeof(p.*))` in an instance (`tests/smith-lang/cases/generic-fields-pointee`).
static TypeRef typeof_path(const Checked *r, const ast::Expr *operand) {
    const ast::Expr *steps[8];
    Usize n = 0;
    const ast::Expr *at = operand;
    while (at != nullptr && n < countof(steps)) {
        const ast::Expr *inner = nullptr;
        if (at->kind == .unary && at->kind.unary.op == .dereference) inner = at->kind.unary.operand;
        if (at->kind == .member) inner = at->kind.member.base;
        if (inner == nullptr) break;
        steps[n++] = at;
        at = inner;
    }
    TypeRef t = typeof_variable(r, at);
    for (Usize i = n; i > 0 && t != nullptr; i--) {
        const ast::Expr *step = steps[i - 1];
        if (t->kind == .pointer && step->kind == .unary) {
            t = element_of(t);
            continue;
        }
        if (t->kind == .pointer) t = element_of(t);
        if (t->kind != .record || step->kind != .member) return nullptr;
        TypeRef field = nullptr;
        for (Usize k = 0; k < countof(slots_of(t).items); k++)
            if (same_text(slots_of(t).items[k].name, step->kind.member.name)) field = slots_of(t).items[k].type;
        t = field;
    }
    return t;
}

// The name `fields(...)` looks its subject up by: the last name of `T` or `geometry.Point`. A subject written as a type
// that is no name, `typeof(v)` or `typeof(p.*)` in an instance, is resolved here and named by a symbol of its own in
// the instance's scope, so the record is found by its type and not by a name the instance's module may not see.
static Str reflected_subject(const ast::Expr *arg) {
    Str none = "";
    if (arg->kind == .name) {
        Usize n = countof(arg->kind.name.path.segments);
        return n == 0 ? none : arg->kind.name.path.segments[n - 1].text;
    }
    if (arg->kind != .type_value || arg->kind.type_value.type == nullptr) return none;
    const ast::TypeExpr *written = arg->kind.type_value.type;
    if (written->kind == .named) {
        Usize n = countof(written->kind.named.path.segments);
        return n == 0 ? none : written->kind.named.path.segments[n - 1].text;
    }
    if (reflecting == nullptr || written->kind != .type_of) return none;
    Usize errors = reflecting->error_count;
    Bool was_new = reflecting->new_syntax;
    reflecting->new_syntax = true;
    TypeRef t = typeof_path(reflecting, written->kind.type_of.operand);
    if (t == nullptr) t = resolve(reflecting, written);
    reflecting->new_syntax = was_new;
    reflecting->error_count = errors;
    if (t == nullptr || t->kind != .record) return none;
    typed_subjects += 1;
    char chars[:] = format::push("#typeof", typed_subjects);
    Str name = chars;
    if (!declare(&reflecting->scopes, (Symbol){.name = name, .kind = .type_name, .type = t})) return none;
    return name;
}

// `fields(typeof(v))` in an instance as `fields(#typeofN)`, the name `reflected_subject` gave its record.
static const ast::Expr *typed_subject(const ast::Expr *e) {
    if (reflecting == nullptr || e->kind != .call || countof(e->kind.call.args) != 1) return e;
    if (!same_text(single_name_of(e->kind.call.callee), "fields")) return e;
    const ast::Expr *arg = e->kind.call.args[0];
    if (arg->kind != .type_value || arg->kind.type_value.type == nullptr) return e;
    if (arg->kind.type_value.type->kind != .type_of) return e;
    Str name = reflected_subject(arg);
    if (countof(name) == 0) return e;
    ast::Expr *subject = ast::expr({.type_value = {.type = ast::named(name)}});
    subject->span = arg->span;
    ast::ExprRef args[1] = {subject};
    ast::Expr *call = ast::call(e->kind.call.callee, args);
    call->span = e->span;
    enumerated_any = true;
    return call;
}

// `fields(T)[i]` where `i` is a compile-time parameter bound in this instance (`fn name_at(p: auto, const i: usize)`):
// the index written as the number the call passed, which is what the lists are read by. Any other expression is
// `typed_subject`'s.
static const ast::Expr *bound_index(const ast::Expr *e) {
    if (reflecting == nullptr || e->kind != .index) return typed_subject(e);
    const ast::Expr *base = e->kind.index.base;
    if (base->kind != .call) return typed_subject(e);
    Str kind = single_name_of(base->kind.call.callee);
    if (!same_text(kind, "fields") && !same_text(kind, "parameters")) return typed_subject(e);
    Str name = single_name_of(e->kind.index.index);
    if (countof(name) == 0) return typed_subject(e);
    const Symbol *bound = lookup(&reflecting->scopes, name);
    if (bound == nullptr || !bound->has_value) return typed_subject(e);
    ast::Expr *position = ast::integer(bound->value);
    position->span = e->kind.index.index->span;
    ast::Expr *indexed = ast::expr({.index = {.base = e->kind.index.base, .index = position}});
    indexed->span = e->span;
    enumerated_any = true;
    return indexed;
}

// The number of elements of the list of an enumerated loop, when it is the pack or a reflection list known here.
static Bool enumerated_length(const ast::Expr *list, Bool *is_pack, Usize *count) {
    Str name = single_name_of(list);
    *is_pack = countof(name) > 0 && countof(enumerated_pack) > 0 && same_text(name, enumerated_pack);
    if (*is_pack) {
        *count = enumerated_count;
        return true;
    }
    if (reflecting == nullptr || list->kind != .call || countof(list->kind.call.args) != 1) return false;
    Str kind = single_name_of(list->kind.call.callee);
    if (!same_text(kind, "fields") && !same_text(kind, "parameters")) return false;
    Str subject = reflected_subject(list->kind.call.args[0]);
    return countof(subject) > 0 && reflect_count(kind, subject, count);
}

static const ast::Stmt *kept_statement(const ast::Stmt *s) {
    return s;
}

// In a copy of the body: the loop's element name over a list is `fields(T)[<at>]`, and an index by the loop's index
// name is by `<at>` (`rest[i]` is `rest.<at>`, `fields(T)[i]` is `fields(T)[<at>]`).
static const ast::Expr *substituted(const ast::Expr *e) {
    Str name = single_name_of(e);
    ast::Expr *entry = nullptr;
    if (countof(name) > 0 && substituted_list != nullptr && same_text(name, substituted_name)) {
        entry = ast::expr({.index = {.base = substituted_list, .index = ast::integer(substituted_at)}});
    } else if (e->kind == .index && countof(substituted_index) > 0 &&
               same_text(single_name_of(e->kind.index.index), substituted_index)) {
        Str base = single_name_of(e->kind.index.base);
        if (countof(base) > 0 && same_text(base, enumerated_pack)) {
            char chars[:] = format::push(substituted_at);
            Str at = chars;
            entry = ast::expr({.member = {.base = e->kind.index.base, .name = at}});
        } else {
            entry = ast::expr({.index = {.base = e->kind.index.base, .index = ast::integer(substituted_at)}});
        }
    }
    if (entry == nullptr) return e;
    entry->span = e->span;
    return entry;
}

// `const name: usize = at`, or `name := pack.at`.
static ast::Stmt *enumerated_binding(ast::Identifier name, Usize at, Str pack) {
    ast::Expr *init = ast::integer(at);
    ast::TypeExpr *type = ast::named("usize");
    if (countof(pack) > 0) {
        char chars[:] = format::push(at);
        Str index = chars;
        init = ast::expr({.member = {.base = ast::name(pack), .name = index}});
        type = ast::make_type((ast::TypeKind){});
        type->kind = .auto_type;
    }
    init->span = name.span;
    ast::DeclKind kind = {
        .variable = {
            .name = name.text, .type = type, .init = init, .is_constexpr = countof(pack) == 0, .is_new = true}};
    ast::Decl *d = ast::plain_decl(kind);
    d->span = name.span;
    ast::Stmt *s = ast::stmt({.declaration = {.decl = d}});
    s->span = name.span;
    return s;
}

// One copy of the body of the enumerated loop `s` for the element `at`.
static ast::Stmt *enumerated_copy(const ast::Stmt *s, ast::Expr *list, Bool is_pack, Usize at) {
    if (s->kind != .for_in) return nullptr;
    ast::Identifier names[:] = s->kind.for_in.names;
    ast::StmtRef *items = (ast::StmtRef *)mem::alloc_array_raw(sizeof(ast::StmtRef), 3, alignof(ast::StmtRef));
    Usize n = 0;
    Str none = "";
    if (!same_text(names[0].text, "_")) items[n++] = enumerated_binding(names[0], at, none);
    if (is_pack && !same_text(names[1].text, "_")) items[n++] = enumerated_binding(names[1], at, single_name_of(list));
    substituted_name = names[1].text;
    substituted_index = same_text(names[0].text, "_") ? none : names[0].text;
    substituted_list = is_pack || same_text(names[1].text, "_") ? nullptr : list;
    substituted_at = at;
    items[n++] = ast_clone::clone_stmt_rewriting(s->kind.for_in.body, kept_statement, substituted);
    substituted_list = nullptr;
    substituted_index = none;
    ast::StmtRef copied[:] = items[0:n];
    ast::Stmt *copy = ast::block(copied);
    copy->span = s->span;
    return copy;
}

static const ast::Stmt *enumerated(const ast::Stmt *s) {
    if (s->kind != .for_in || !s->kind.for_in.is_tuple || countof(s->kind.for_in.names) != 2) return s;
    const ast::Expr *iterable = s->kind.for_in.iterable;
    if (iterable->kind != .call || countof(iterable->kind.call.args) != 1) return s;
    if (!same_text(single_name_of(iterable->kind.call.callee), "enumerate")) return s;
    ast::Expr *list = iterable->kind.call.args[0];
    Bool is_pack = false;
    Usize count = 0;
    if (!enumerated_length(list, &is_pack, &count)) return s;
    enumerated_any = true;
    ast::StmtRef *copies = (ast::StmtRef *)mem::alloc_array_raw(sizeof(ast::StmtRef), count, alignof(ast::StmtRef));
    for (Usize at = 0; at < count; at++)
        copies[at] = enumerated_copy(s, list, is_pack, at);
    ast::StmtRef all[:] = copies[0:count];
    ast::Stmt *block = ast::block(all);
    block->span = s->span;
    return block;
}

// Unrolls each enumerated loop of the function `d` in place (over `pack`, when it names one of `count` elements).
static Bool unroll_enumerated(ast::Decl *d, Str pack, Usize count) {
    if (d->kind != .function || d->kind.function.body == nullptr) return false;
    enumerated_pack = pack;
    enumerated_count = count;
    enumerated_any = false;
    ast::Decl *copy = ast_clone::clone_decl_rewriting(d, enumerated, bound_index);
    Str none = "";
    enumerated_pack = none;
    if (enumerated_any) *d = *copy;
    return enumerated_any;
}

// Expands the `fields(T)` and `parameters(F)` of a function in place, with the names of the scopes now in force.
export Bool expand_reflection(Checked *r, ast::Decl *function) {
    reflecting = r;
    expanding = function;
    Str none = "";
    Bool unrolled = unroll_enumerated(function, none, 0);
    ast_clone::Sources sources = {.count = reflect_count, .at = reflect_at, .fail = reflect_fail};
    Bool expanded = ast_clone::expand_reflection_lists(function, sources) || unrolled;
    reflecting = nullptr;
    expanding = nullptr;
    return expanded;
}

// Whether a type a call binds is not known: the invalid type or `Auto`, or a tuple (a pack) that holds one. The
// argument that has it failed to be typed, and said why.
static Bool binds_unknown(const Checked *r, Binding given[:]) {
    for (Usize i = 0; i < countof(given); i++) {
        TypeRef t = given[i].type;
        if (!given[i].is_type || t == nullptr) continue;
        if (t == r->table.invalid || t == r->table.automatic) return true;
        if (t->kind != .tuple) continue;
        for (Usize k = 0; k < countof(t->kind.tuple.slots); k++) {
            TypeRef element = t->kind.tuple.slots[k].type;
            if (element == r->table.invalid || element == r->table.automatic) return true;
        }
    }
    return false;
}

// The instance of the template `template` for what a call passed, one per set of arguments: made (cloned, its
// compile-time parameters taken out, its signature typed) on the first call and found after. Its index in
// `r->instances`, or `max_instances` when there are too many.
// Fills `bindings` from what the call passed, one per compile-time or `auto` parameter in order. Returns how many
// parameters the instance keeps; `auto_syntax` is set when the kept parameters are written in today's syntax.
static Usize bind_given(Checked *r, ast::Param generics[:], ast::Param all[:], Binding given[:], Binding bindings[:],
                        Bool *auto_syntax) {
    Usize kept_count = 0;
    Usize bound = 0;
    for (Usize i = 0; i < countof(generics); i++) { // `fn f[T, n: usize]`: bound first, passed by no argument
        bindings[bound] = given[bound];
        bindings[bound].name = generics[i].name;
        if (!bindings[bound].is_type) {
            r->new_syntax = true;
            bindings[bound].type = resolve(r, generics[i].type);
            r->new_syntax = false;
        }
        bound += 1;
    }
    for (Usize i = 0; i < countof(all); i++) {
        if (is_auto_param(&all[i])) {
            kept_count += 1;
            bindings[bound] = given[bound];
            bindings[bound].name = msg(format::push("$auto.", all[i].name));
            bound += 1;
            continue;
        }
        if (!is_compile_time(&all[i])) {
            kept_count += 1;
            *auto_syntax = *auto_syntax || !all[i].is_new;
            continue;
        }
        bindings[bound] = given[bound];
        bindings[bound].name = all[i].name;
        if (!bindings[bound].is_type) {
            r->new_syntax = true;
            bindings[bound].type = resolve(r, all[i].type);
            r->new_syntax = false;
        }
        bound += 1;
    }
    return kept_count;
}

// The parameters an instance keeps, with their types: an `auto` parameter has the type it was bound to.
static void keep_params(Checked *r, Usize generic_count, ast::Param all[:], Binding bindings[:], Bool auto_syntax,
                        ast::Param kept[:], Slot slots[:]) {
    Usize at = 0;
    Usize taken = generic_count; // the next binding for an `auto` parameter, after those of the generics
    for (Usize i = 0; i < countof(all); i++) {
        if (is_compile_time(&all[i])) {
            taken += 1;
            continue;
        }
        kept[at] = all[i];
        slots[at].name = all[i].name;
        if (is_auto_param(&all[i])) {
            slots[at].type = bindings[taken].type;
            taken += 1;
        } else {
            r->new_syntax = !auto_syntax;
            slots[at].type = all[i].type == nullptr ? r->table.invalid : resolve(r, all[i].type);
            r->new_syntax = false;
        }
        declare(&r->scopes,
                (Symbol){.name = all[i].name, .kind = .variable, .type = slots[at].type}); // for `typeof(a)`
        at += 1;
    }
}

// The copy of the template that an instance is made of. A `for x in rest` over the pack becomes one copy of its body
// for each element of the tuple the pack is bound to (#2293).
static ast::Decl *clone_instance(const ast::Decl *template, Binding given[:]) {
    if (template->kind != .function) return ast_clone::clone_decl(template);
    ast::Param params[:] = template->kind.function.params;
    Usize bound = countof(template->kind.function.generics);
    for (Usize i = 0; i < countof(params); i++) {
        if (params[i].is_pack && !params[i].is_gather && params[i].is_new) {
            if (bound >= countof(given)) break;
            TypeRef pack = given[bound].type;
            if (pack == nullptr) break;
            if (pack->kind != .tuple) break;
            ast::Decl *copy = ast_clone::clone_decl_unrolling(template, params[i].name, countof(slots_of(pack).items));
            (void)unroll_enumerated(copy, params[i].name, countof(slots_of(pack).items));
            return copy;
        }
        if (is_auto_param(&params[i]) || is_compile_time(&params[i])) bound += 1;
    }
    return ast_clone::clone_decl(template);
}

// What a function declaration says of itself apart from its parameters; `ok` is false for any other declaration.
struct Shape {
    ast::TypeExpr *result;
    Str name;
    ast::Stmt *body;
    Bool variadic;
    Bool is_new;
    Bool ok;
};

static Shape shape_of(const ast::Decl *d) {
    Shape s = {.result = nullptr, .name = "", .body = nullptr, .variadic = false, .is_new = false, .ok = false};
    if (d->kind != .function) return s;
    s.result = d->kind.function.result;
    s.name = d->kind.function.name;
    s.body = d->kind.function.body;
    s.variadic = d->kind.function.variadic;
    s.is_new = d->kind.function.is_new;
    s.ok = true;
    return s;
}

// The instance of the template `template` for what a call passed, one per set of arguments: made (cloned, its
// compile-time parameters taken out, its signature typed) on the first call and found after. Its index in
// `r->instances`, or `max_instances` when there are too many.
static Usize make_instance(Checked *r, const ast::Decl *template, Str prefix, Binding given[:]) {
    Usize found = find_instance(r, template, given);
    if (found < r->instance_count) return found;
    if (!shape_of(template).ok) return max_instances;
    if (r->instance_count == max_instances) {
        failf(r, template->span, "`", shape_of(template).name, "` has more than ", max_instances,
              " instances; a generic function that calls itself with ever larger types never ends");
        return max_instances;
    }
    ast::Decl *copy = clone_instance(template, given);
    const ast::Decl *first = copy;
    if (first->kind != .function) return max_instances;
    ast::Param all[:] = first->kind.function.params;
    Binding bindings[:] = mem::alloc_slice(Binding, countof(given));
    Bool auto_syntax = false; // the types of an `auto` template are written in today's syntax
    push_scope(&r->scopes);
    ast::Param generics[:] = first->kind.function.generics;
    Usize generic_count = countof(generics);
    Usize kept_count = bind_given(r, generics, all, given, bindings, &auto_syntax);
    Instance made = {.template = template, .decl = copy, .bindings = bindings, .prefix = prefix, .signature = nullptr};
    bind_instance(r, &made);
    expand_reflection(r, copy); // `fields(T)` of the instance, with `T` bound
    Shape shape = shape_of(copy);
    if (!shape.ok) return max_instances;
    ast::TypeExpr *result_type = shape.result;
    Str function_name = shape.name;
    ast::Stmt *function_body = shape.body;
    Bool is_variadic = shape.variadic;
    Bool is_new = shape.is_new;
    ast::Param kept[:] = mem::alloc_slice(ast::Param, kept_count);
    Slot slots[:] = mem::alloc_slice(Slot, kept_count);
    // The signature is written in the template's module: `Chars` in `format::push`'s result is `format::Chars`.
    Str outer = r->prefix;
    Str outer_scopes = r->scopes.prefix;
    r->prefix = prefix;
    r->scopes.prefix = prefix;
    keep_params(r, generic_count, all, bindings, auto_syntax, kept, slots);
    for (Usize i = 0; i < kept_count; i++) { // the parameters, for a `typeof(v)` in the result
        Symbol parameter = {.name = slots[i].name, .kind = .variable, .type = slots[i].type};
        declare(&r->scopes, parameter);
    }
    TypeRef result = r->table.void_type;
    if (result_type != nullptr) {
        r->new_syntax = !auto_syntax;
        result = resolve(r, result_type);
        r->new_syntax = false;
    }
    r->prefix = outer;
    r->scopes.prefix = outer_scopes;
    pop_scope(&r->scopes);
    // the instance has no generics: they are bound
    ast::DeclKind instance_kind = {.function = {.name = instance_name(function_name, bindings),
                                                .params = kept,
                                                .generics = generics[0:0],
                                                .result = result_type,
                                                .body = function_body,
                                                .variadic = is_variadic,
                                                .is_new = is_new}};
    copy->kind = instance_kind;
    made.signature = function_of(&r->table, slots, result, is_variadic);
    if (r->instance_count == countof(r->instances)) {
        Usize capacity = countof(r->instances) * 2;
        if (capacity < 8) capacity = 8;
        r->instances = mem::realloc(r->instances, capacity);
    }
    r->instances[r->instance_count] = made;
    r->instance_count += 1;
    return r->instance_count - 1;
}

export Usize instance_of(Checked *r, const ast::Decl *template, Str prefix, Binding given[:]) {
    Usize found = find_instance(r, template, given);
    if (found < r->instance_count) return found;
    // An argument whose type is not known after an error was reported (a struct that is not typed yet): no instance
    // is made for it, which would check the body with a type that is not known and report each comparison of it
    // (#3609).
    if (r->error_count > 0 && binds_unknown(r, given)) return max_instances;
    return make_instance(r, template, prefix, given);
}

// ---------------------------------------------------------------------------------------------------------------
// Working the bracketed parameters of `fn f[T, n: usize](...)` out from the types of a call's arguments (#1698)

// Whether a bracketed parameter is a type (`T`, or `T: num` with a concept), else a constant (`n: usize`).
export Bool is_generic_type(const ast::Param *g) {
    return g->type == nullptr || countof(written_concept(g->type)) > 0;
}

export struct Unified {
    Bool conflict;  // a generic was bound twice, to different things
    Usize generic;  // which one
    TypeRef before; // what it was bound to
    TypeRef now;    // what this argument binds it to
};

struct UnifyPair {
    const ast::TypeExpr *written;
    TypeRef given;
};

// The index of the generic a written type names (`T`), or the count when it names none.
static Usize generic_named(ast::Param generics[:], const ast::TypeExpr *written) {
    if (written->kind != .named) return countof(generics);
    Str name = path_text(written->kind.named.path);
    for (Usize i = 0; i < countof(generics); i++) {
        if (is_generic_type(&generics[i]) && same_text(generics[i].name, name)) return i;
    }
    return countof(generics);
}

// Binds the generic `at` to `type` (or to the constant `value`); false, with the clash recorded, when it is already
// bound to something else and `strict`.
static Bool bind_generic(Binding bound[:], Bool set[:], Usize at, Bool is_type, TypeRef type, U64 value, Bool strict,
                         Unified *out) {
    if (set[at]) {
        TypeRef prior = bound[at].type;
        Bool same = bound[at].value == value;
        if (is_type) {
            same = false;
            if (prior != nullptr) same = prior == type;
        }
        if (same || !strict) return true;
        out->conflict = true;
        out->generic = at;
        if (prior != nullptr) out->before = prior;
        out->now = type;
        return false;
    }
    set[at] = true;
    bound[at] = (Binding){.is_type = is_type, .type = type, .value = value};
    return true;
}

// Matches a parameter's written type against the type an argument has, binding the generics it names. A shape that
// does not match binds nothing: the call's own check reports it. A walk with an explicit stack.
export Bool unify_generics(ast::Param generics[:], const ast::TypeExpr *written, TypeRef given, Binding bound[:],
                           Bool set[:], Bool strict, Unified *out) {
    UnifyPair stack[32] = {};
    Usize top = 1;
    stack[0] = (UnifyPair){.written = written, .given = given};
    while (top > 0) {
        top -= 1;
        UnifyPair pair = stack[top];
        const ast::TypeExpr *w = pair.written;
        TypeRef g = pair.given;
        if (w == nullptr || g == nullptr) continue;
        Usize at = generic_named(generics, w);
        if (at < countof(generics)) {
            if (!bind_generic(bound, set, at, true, g, 0, strict, out)) return false;
            continue;
        }
        const ast::TypeExpr *inner = nullptr;
        TypeRef inner_given = nullptr;
        if (w->kind == .pointer && g->kind == .pointer) {
            inner = w->kind.pointer.pointee;
            inner_given = element_of(g);
        } else if (w->kind == .slice && g->kind == .slice) {
            inner = w->kind.slice.element;
            inner_given = element_of(g);
        } else if (w->kind == .option && g->kind == .option) {
            inner = w->kind.option.inner;
            inner_given = element_of(g);
        } else if (w->kind == .array && g->kind == .array) {
            inner = w->kind.array.element;
            inner_given = element_of(g);
            const ast::Expr *count = w->kind.array.count;
            ast::Path count_path = {};
            if (name_path(count, &count_path)) {
                Str name = path_text(count_path);
                for (Usize i = 0; i < countof(generics); i++) {
                    if (is_generic_type(&generics[i]) || !same_text(generics[i].name, name)) continue;
                    if (!bind_generic(bound, set, i, false, nullptr, count_of(g), strict, out)) return false;
                }
            }
        } else if (w->kind == .tuple && g->kind == .tuple) {
            ast::TypeRef written_elements[:] = w->kind.tuple.elements;
            Slot given_slots[:] = slots_of(g).items;
            Usize pairs = countof(written_elements) == countof(given_slots) ? countof(given_slots) : 0;
            for (Usize i = 0; i < pairs && top < countof(stack); i++) {
                stack[top] = (UnifyPair){.written = written_elements[i], .given = given_slots[i].type};
                top += 1;
            }
        }
        if (inner != nullptr && top < countof(stack)) {
            stack[top] = (UnifyPair){.written = inner, .given = inner_given};
            top += 1;
        }
    }
    return true;
}

// The type a literal initializer gives `let a = 3` (smith's own syntax: `i32` for an integer, `f64` for a float, the
// suffix and `-` considered), or null when the initializer is not a literal; a name or an expression is typed with the
// bodies.
static TypeRef literal_type(Checked *r, const ast::Expr *given) {
    Bool negated = false;
    const ast::Expr *at = given;
    for (Usize steps = 0; steps < 64; steps++) {
        const ast::Expr *inner = negated_operand(at);
        if (inner == nullptr) break;
        at = inner;
        negated = true;
    }
    const ast::Expr *init = at;
    if (init == nullptr) return nullptr;
    if (init->kind == .integer) {
        Str suffix = init->kind.integer.suffix;
        if (countof(suffix) == 0) return builtin(&r->table, "I32");
        if (same_text(suffix, "u")) return builtin(&r->table, "U32");
        if (same_text(suffix, "l") || same_text(suffix, "ll")) return builtin(&r->table, "I64");
        if (same_text(suffix, "ul") || same_text(suffix, "ull")) return builtin(&r->table, "U64");
        return nullptr;
    }
    if (init->kind == .floating) {
        if (same_text(init->kind.floating.suffix, "f")) return builtin(&r->table, "F32");
        return builtin(&r->table, "F64");
    }
    if (negated) return nullptr;
    if (init->kind == .call && init->kind.call.callee->kind == .name) {
        // `const f = Format(24, -149)`: a record built by its name has that record's type, and the global's uses
        // are checked before its initializer is
        ast::Path path = init->kind.call.callee->kind.name.path;
        const Symbol *named = lookup_path(&r->scopes, path);
        if (named != nullptr && named->kind == .type_name && named->type->kind == .record) return named->type;
        return nullptr;
    }
    if (init->kind == .boolean) return r->table.bool_type;
    if (init->kind == .string) return r->table.text;
    return nullptr;
}

static void declare_variable(Checked *r, const ast::Decl *d, Str name, const ast::TypeExpr *written,
                             Bool constexpr_variable, Bool is_new, const ast::Expr *init) {
    r->new_syntax = is_new;
    TypeRef type = resolve(r, written);
    r->new_syntax = false;
    if (is_new && written->kind == .auto_type) {
        TypeRef taken = literal_type(r, init);
        if (taken != nullptr) type = taken;
    }
    Bool is_const = constexpr_variable || written->qualifiers.is_const;
    Symbol symbol = {.name = name,
                     .kind = .variable,
                     .type = type,
                     .decl = d,
                     .is_const = is_const,
                     .is_volatile = written->qualifiers.is_volatile,
                     .is_new = is_new,
                     .exported = d->exported};
    // The type as written, for the fix that makes a pointer global `*mut` where it is written through (#2611).
    if (is_new) symbol.written = written;
    declare_in_module(r, symbol, d->span);
}

// After pass 3 of a module: each constant written without a type whose initializer is no literal takes the type of
// the value the compiler computes for it (#3039). Every name of the module is declared by now, so the order the
// constants are written in does not matter.
static void type_constants(Checked *r, const ast::Module *m) {
    if (r->options.constant == nullptr) return;
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind != .variable || d->from_c || !d->kind.variable.is_new) continue;
        const ast::Expr *init = d->kind.variable.init;
        if (init == nullptr || d->kind.variable.type->kind != .auto_type) continue;
        const Symbol *found = lookup(&r->scopes, qualified(r, false, d->kind.variable.name));
        if (found == nullptr || found->kind != .variable || found->decl != d) continue;
        if (found->type != r->table.automatic) continue;
        TypeRef computed = r->options.constant(r, init);
        if (computed != nullptr) ((Symbol *)(Usize)found)->type = computed;
    }
}

// The type the unnamed `struct:` or `enum:` `d` is under the name `name` (`m::Pair(i32)`): made the first time, in
// the scopes `r` is in, where the parameters of the type function that holds it are type names; the same type after.
export TypeRef unnamed_type(Checked *r, const ast::Decl *d, Str name) {
    for (Usize i = 0; i < r->made_count; i++) {
        if (same_text(r->made[i].name, name)) return r->made[i].type;
    }
    Ty *made = nullptr;
    if (d->kind == .record) {
        made = new_record(&r->table, name, d->kind.record.is_union);
    } else {
        made = new_enumeration(&r->table, name, builtin(&r->table, "I32"));
    }
    if (r->made_count == countof(r->made)) {
        Usize capacity = countof(r->made) * 2;
        if (capacity < 8) capacity = 8;
        r->made = mem::realloc(r->made, capacity);
    }
    r->made[r->made_count] = (MadeType){.name = name, .type = made}; // first, so a type that names itself ends
    r->made_count += 1;
    push_scope(&r->scopes);
    (void)declare(&r->scopes, type_symbol(name, made, d, true));
    if (d->kind == .record) {
        fill_record(r, d, name);
    } else if (d->kind == .enumeration) {
        fill_enumeration(r, name, d->kind.enumeration.items);
    }
    pop_scope(&r->scopes);
    return made;
}

static Bool declare_module_alias(Checked *r, const ast::Decl *d);

// Pass 3 for one declaration.
static void declare_member(Checked *r, const ast::Decl *d) {
    Bool from_c = d->from_c;
    ast::Span span = d->span;
    if (d->kind == .record) {
        Str name = qualified(r, from_c, d->kind.record.name);
        fill_record(r, d, name);
    } else if (d->kind == .enumeration) {
        Str name = qualified(r, from_c, d->kind.enumeration.name);
        fill_enumeration(r, name, d->kind.enumeration.items);
    } else if (d->kind == .function) {
        Str name = qualified(r, from_c, d->kind.function.name);
        declare_function(r, d, name, d->kind.function.params, d->kind.function.result, d->kind.function.variadic);
    } else if (d->kind == .variable) {
        Str name = qualified(r, from_c, d->kind.variable.name);
        const ast::TypeExpr *written = d->kind.variable.type;
        Bool is_constexpr = d->kind.variable.is_constexpr;
        Bool is_new = d->kind.variable.is_new;
        const ast::Expr *init = d->kind.variable.init;
        if (own_alias_type(r, d) != nullptr || declare_module_alias(r, d)) return;
        TypeRef held = nullptr;
        if (is_new && init != nullptr && r->options.held != nullptr) held = r->options.held(r, init);
        if (held != nullptr) {
            // `IntPair := Pair(i32)`: a name of the type the call makes, as `Line := []u8` is of the one written
            declare_in_module(r, type_symbol(name, held, d, d->exported), span);
            return;
        }
        declare_variable(r, d, name, written, is_constexpr, is_new, init);
    } else if (d->kind == .if_constexpr) {
        failf(r, span, "not yet typed: if constexpr");
    }
}

// ---------------------------------------------------------------------------------------------------------------
// Modules as values (#1677): `import a.b as m` binds `m`, and `m.name` is a public declaration of `a.b`

// Whether other modules may name the symbol: `pub` or `export` on its declaration.
export Bool is_public(const Symbol *s) {
    return s->exported || declared_public(s);
}

static Str joined(ast::Path path, Str separator) {
    Str text = path.segments[0].text;
    for (Usize i = 1; i < countof(path.segments); i++)
        text = msg(format::push(text, separator, path.segments[i].text));
    return text;
}

// The module a module symbol names as its import writes it (`std.array` for `import std.array as a`), for a message.
export Str imported_path(const Symbol *s) {
    if (s->decl == nullptr || s->decl->kind != .import_module) return s->name;
    return joined(s->decl->kind.import_module.path, ".");
}

// The prefix of every name of the module a module symbol stands for: `std::math::`. The declarations of a module
// are in the table once, under this prefix, however many names it is imported by.
static Str prefix_of_import(const ast::Decl *imported) {
    if (imported->kind == .import_from) return msg(format::push(joined(imported->kind.import_from.path, "::"), "::"));
    if (imported->kind != .import_module) return "";
    return msg(format::push(joined(imported->kind.import_module.path, "::"), "::"));
}

static Str prefix_of_symbol(const Symbol *s) {
    const ast::Decl *decl = s->decl;
    if (decl == nullptr) return "";
    return prefix_of_import(decl);
}

// The prefix a declaration's table name carries: `util::` for `util::apply`, empty for a name of the module being
// checked.
export Str module_prefix(Str name) {
    Usize end = 0;
    for (Usize i = 0; i + 1 < countof(name); i++)
        if (name[i] == ':' && name[i + 1] == ':') end = i + 2;
    return name[0:end];
}

// The module's path as written, `std.math`.
export Str module_dotted(const Symbol *s) {
    const ast::Decl *decl = s->decl;
    if (decl == nullptr) return "";
    if (decl->kind != .import_module) return "";
    return joined(decl->kind.import_module.path, ".");
}

// The names of `m.a.b`, the root first.
export struct Names {
    Str items[8];
    Usize count;
};

// The names of a chain of `.` that starts at a plain name; none (count 0) for anything else.
export Names member_names(const ast::Expr *e) {
    Names out = {};
    Usize depth = 0;
    const ast::Expr *at = e;
    while (is_dot_member(at)) {
        depth += 1;
        if (depth == 8) return out;
        at = member_base(at);
    }
    Str root = single_name(at);
    if (countof(root) == 0) return out;
    out.items[0] = root;
    out.count = depth + 1;
    at = e;
    for (Usize k = depth; k > 0; k--) {
        out.items[k] = member_field(at);
        at = member_base(at);
    }
    return out;
}

// The result of reading a name through modules.
export struct Through {
    const Symbol *symbol; // where the names ended (null: a name was missing)
    const Symbol *module; // the module symbol a missing name was looked up in
    Str missing;
    Bool stopped; // `symbol` is not a module and names remain
};

// A name as the code being checked sees it: inside an imported module, that module's own names first.
export const Symbol *scoped(const Checked *r, Str name) {
    const Symbol *found = nullptr;
    if (countof(r->prefix) > 0) found = lookup(&r->scopes, msg(format::push(r->prefix, name)));
    if (found == nullptr) found = lookup(&r->scopes, name);
    return found;
}

// Whether the code checked now sees the binding: the module's own, and an imported module's while that module's code
// is read (its declarations, or the body of an instance of one of its generics, whose prefix is the module's), so
// `stdio.putchar` in a generic of `fmt` reads `fmt`'s `import c <stdio.h>` wherever the instance is made.
static Bool binding_visible(const HeaderBinding *b, Str scope) {
    return countof(b->owner) == 0 || same_text(b->owner, scope);
}

// The binding `import c <h>` made under `name` that code of the module with the prefix `scope` sees, or null.
export const HeaderBinding *header_binding_in(const Checked *r, Str name, Str scope) {
    for (Usize i = 0; i < r->binding_count; i++)
        if (binding_visible(&r->bindings[i], scope) && same_text(r->bindings[i].name, name)) return &r->bindings[i];
    return nullptr;
}

// The binding `import c <h>` made under `name`, or null.
export const HeaderBinding *header_binding(const Checked *r, Str name) {
    return header_binding_in(r, name, r->prefix);
}

// Whether the header declares `name`: a function, variable, type or enumerator, directly or through its includes.
static Bool header_has(const ast::Module *header, Str name) {
    for (Usize i = 0; i < countof(header->decls); i++) {
        const ast::Decl *d = header->decls[i];
        if (d->kind == .function && same_text(d->kind.function.name, name)) return true;
        if (d->kind == .variable && same_text(d->kind.variable.name, name)) return true;
        if (d->kind == .record && same_text(d->kind.record.name, name)) return true;
        if (d->kind == .type_alias && same_text(d->kind.type_alias.name, name)) return true;
        if (d->kind != .enumeration) continue;
        if (same_text(d->kind.enumeration.name, name)) return true;
        for (Usize k = 0; k < countof(d->kind.enumeration.items); k++)
            if (same_text(d->kind.enumeration.items[k].name, name)) return true;
    }
    return false;
}

// Whether a header bound as `base` declares `name`. Two headers can share a binding name (`<time.h>` and
// `<sys/time.h>` are both `time`): the name is declared when either has it (#2611).
static Bool binding_declares(const Checked *r, Str base, Str name, Str scope) {
    for (Usize i = 0; i < r->binding_count; i++)
        if (binding_visible(&r->bindings[i], scope) && same_text(r->bindings[i].name, base) &&
            header_has(r->bindings[i].header, name))
            return true;
    return false;
}

// The binding a name of a header is read through, or null: `stdio.printf` has the base `stdio`. The text of the base
// is empty when `e` is not `name.member`.
export Str c_member_base(const ast::Expr *e) {
    if (e->kind != .member || e->kind.member.arrow) return "";
    const ast::Expr *base = e->kind.member.base;
    if (base->kind != .name || countof(base->kind.name.path.segments) != 1) return "";
    return base->kind.name.path.segments[0].text;
}

// `stdio.name` after `import c <stdio.h>` (#1678): the member of a header binding that no local or module of the file
// hides, spelled as the name `c::name` the header's declaration has. Empty when `e` is not that shape, the base is no
// binding, or the header does not declare the name. The caller has checked that no local hides the base (the checker
// through `scoped`, the emitter through its locals).
export Str c_member_name_in(const Checked *r, const ast::Expr *e, Str scope) {
    Str base = c_member_base(e);
    if (countof(base) == 0 || e->kind != .member) return "";
    const HeaderBinding *binding = header_binding_in(r, base, scope);
    if (binding == nullptr || !binding_declares(r, base, e->kind.member.name, scope)) return "";
    return e->kind.member.name;
}

// The same for the code checked now: the module's own, or an imported module's while its prefix is in force.
export Str c_member_name(const Checked *r, const ast::Expr *e) {
    return c_member_name_in(r, e, r->prefix);
}

// The header declaration `stdio.name` stands for, or null.
export const Symbol *c_member(const Checked *r, const ast::Expr *e) {
    Str name = c_member_name(r, e);
    if (countof(name) == 0 || scoped(r, c_member_base(e)) != nullptr) return nullptr;
    return lookup_as(&r->scopes, msg(format::push("c::", name)), false);
}

// The function `stat.sigaction` stands for when a struct of the header has the same name (`struct sigaction`), or null.
export const Symbol *c_member_function(const Checked *r, const ast::Expr *e) {
    Str name = c_member_name(r, e);
    if (countof(name) == 0 || scoped(r, c_member_base(e)) != nullptr) return nullptr;
    return lookup(&r->scopes, msg(format::push("c::", name, "()")));
}

// The text of the error for `base.name` when `base` is a header binding that lacks `name`, or `c.name` with no `c`
// bound: empty when `e` is neither.
export Str c_member_error(const Checked *r, const ast::Expr *e, syntax::Edits *fix) {
    Str base = c_member_base(e);
    if (countof(base) == 0 || e->kind != .member || r->binding_count == 0 || scoped(r, base) != nullptr) return "";
    Str name = e->kind.member.name;
    const HeaderBinding *binding = header_binding(r, base);
    if (binding != nullptr) {
        if (binding_declares(r, base, name, r->prefix)) return "";
        return msg(format::push("`", base, ".", name,
                                "` is not declared by that header; check its spelling, or import ",
                                "the header that declares it"));
    }
    if (!same_text(base, "c")) return "";
    for (Usize i = 0; i < r->binding_count; i++)
        if (binding_visible(&r->bindings[i], r->prefix) && header_has(r->bindings[i].header, name)) {
            *fix = mem::realloc(*fix, 1); // `smith lint --fix` writes the binding where `c` stood (#1678)
            (*fix)[0] = (syntax::Edit){.span = e->kind.member.base->span, .text = r->bindings[i].name};
            return msg(format::push("there is no global `c`: write `", r->bindings[i].name, ".", name, "`"));
        }
    return msg(format::push("there is no global `c`: import the header that declares `", name,
                            "` (`import c <h>`) and write `h.", name, "`"));
}

// The binding of the first `import c <h>` whose header declares `name`, for a bare `printf` that needs `stdio.` in
// front of it: empty when no header does. `smith lint --fix` writes the binding at `span` (#2287).
export Str c_binding_of(const Checked *r, Str name) {
    for (Usize i = 0; i < r->binding_count; i++)
        if (binding_visible(&r->bindings[i], r->prefix) && header_has(r->bindings[i].header, name))
            return r->bindings[i].name;
    return "";
}

// Reads `names`: the first is a module symbol, each next name is looked up in the module before. In the code being
// checked a name that is not `pub` is missing; inside an imported module it is not.
export Through through_modules(const Checked *r, const Names *names) {
    Through out = {.symbol = scoped(r, names->items[0]), .module = nullptr};
    for (Usize i = 1; i < names->count; i++) {
        const Symbol *module = out.symbol;
        if (module == nullptr || module->kind != .module_name) {
            out.stopped = true;
            return out;
        }
        Str prefix = prefix_of_symbol(module);
        Str full = msg(format::push(prefix, names->items[i]));
        const Symbol *next = lookup(&r->scopes, full);
        if (next == nullptr || (countof(r->prefix) == 0 && !is_public(next))) {
            return (Through){.symbol = nullptr, .module = module, .missing = names->items[i]};
        }
        out.symbol = next;
    }
    return out;
}

export const Symbol *type_through_modules(const Checked *r, ast::Path path) {
    Usize count = countof(path.segments);
    if (count > 1 && count <= 8) {
        const Symbol *first = scoped(r, path.segments[0].text);
        if (first != nullptr && first->kind == .module_name) {
            Names names = {.count = count};
            for (Usize i = 0; i < count; i++)
                names.items[i] = path.segments[i].text;
            Through t = through_modules(r, &names);
            return t.stopped ? nullptr : t.symbol;
        }
    }
    if (count == 2 && header_binding(r, path.segments[0].text) != nullptr &&
        scoped(r, path.segments[0].text) == nullptr) {
        if (!binding_declares(r, path.segments[0].text, path.segments[1].text, r->prefix)) return nullptr;
        return lookup_as(&r->scopes, msg(format::push("c::", path.segments[1].text)),
                         true); // `stdio.size_t` is `c::size_t`; a struct tag over a function of its name
    }
    const Symbol *found = nullptr;
    if (countof(r->prefix) > 0) found = lookup(&r->scopes, msg(format::push(r->prefix, path_text(path))));
    if (found == nullptr) found = lookup_path(&r->scopes, path);
    if (found != nullptr && found->kind != .type_name && declared_in_c(found)) {
        const Symbol *tag = lookup_as(&r->scopes, found->name, true); // `c::stat` in a type is the struct (#2610)
        if (tag != nullptr && tag->kind == .type_name) found = tag;
    }
    return found;
}

// The symbol a written type name stands for, read through the modules imported (`words.Pair`), else null.
export const Symbol *written_type_symbol(const Checked *r, ast::Path path) {
    return type_through_modules(r, path);
}

static Usize distance(Str a, Str b) {
    Usize row[65] = {};
    if (countof(a) > 64 || countof(b) > 64) return 65;
    for (Usize j = 0; j <= countof(b); j++)
        row[j] = j;
    for (Usize i = 1; i <= countof(a); i++) {
        Usize diagonal = row[0];
        row[0] = i;
        for (Usize j = 1; j <= countof(b); j++) {
            Usize above = row[j];
            Usize best = diagonal + (a[i - 1] == b[j - 1] ? 0 : 1);
            if (above + 1 < best) best = above + 1;
            if (row[j - 1] + 1 < best) best = row[j - 1] + 1;
            row[j] = best;
            diagonal = above;
        }
    }
    return row[countof(b)];
}

// The enumeration of the module `prefix` names that has an enumerator `name`: C writes `lex::kw_const`, smith's own
// syntax `lex.TokenKind.kw_const` (#2460). Empty when no enumeration has it.
export Str enumeration_of(const Checked *r, Str prefix, Str name) {
    for (Usize i = 0; i < r->scopes.count; i++) {
        const Symbol *s = &r->scopes.symbols[i];
        if (s->kind != .type_name || s->type == nullptr || s->type->kind != .enumeration ||
            (countof(prefix) > 0 && !is_public(s)))
            continue;
        if (countof(s->name) <= countof(prefix) || !same_text(s->name[0:countof(prefix)], prefix)) continue;
        if (countof(prefix) == 0 && countof(module_prefix(s->name)) > 0) continue; // a bare name: this module's own
        for (Usize k = 0; k < countof(slots_of(s->type).items); k++) {
            if (same_text(slots_of(s->type).items[k].name, name)) return s->name[countof(prefix):countof(s->name)];
        }
    }
    return "";
}

// Reports `std.math has no public sinn`, with the closest public name when one is near.
export void report_missing(Checked *r, ast::Span span, Through t) {
    Str prefix = prefix_of_symbol(t.module);
    Str owner = enumeration_of(r, prefix, t.missing);
    if (countof(owner) > 0) {
        syntax::Edits fix = mem::alloc_slice(syntax::Edit, 1);
        fix[0] = (syntax::Edit){.span = span, .text = msg(format::push(".", t.missing))};
        fail_fix(r, span,
                 msg(format::push("`", t.missing, "` is an enumerator of `", owner, "`: write `.", t.missing,
                                  "` where the type is known")),
                 fix);
        return;
    }
    Str best = "";
    Usize best_distance = 3;
    for (Usize i = 0; i < r->scopes.count; i++) {
        const Symbol *s = &r->scopes.symbols[i];
        Str name = s->name;
        if (countof(name) <= countof(prefix) || !is_public(s)) continue;
        if (!same_text(name[0:countof(prefix)], prefix)) continue;
        Str rest = name[countof(prefix):countof(name)];
        Usize d = distance(rest, t.missing);
        if (d < best_distance) {
            best_distance = d;
            best = rest;
        }
    }
    if (countof(best) > 0) {
        failf(r, span, "`", module_dotted(t.module), "` has no public `", t.missing, "`; did you mean `", best, "`?");
    } else {
        failf(r, span, "`", module_dotted(t.module), "` has no public `", t.missing,
              "`; write the name of one of its `pub` declarations");
    }
}

// What `let sin = m.sin` or `let Arena = arena.Arena` stands for: the symbol of a function, constant or type of a
// module, or null (an error is reported when a name is missing). A name for the same declaration: no copy and no call
// through a pointer.
static const Symbol *alias_target(Checked *r, const ast::Decl *d, Bool *reported) {
    if (d->kind != .variable) return nullptr;
    const ast::Expr *init = d->kind.variable.init;
    if (!d->kind.variable.is_new || init == nullptr || init->kind != .member) return nullptr;
    Names names = member_names(init);
    if (names.count < 2) return nullptr;
    const Symbol *first = scoped(r, names.items[0]);
    if (first == nullptr || first->kind != .module_name) return nullptr;
    Through t = through_modules(r, &names);
    if (t.symbol == nullptr) {
        report_missing(r, init->span, t);
        *reported = true;
        return nullptr;
    }
    if (t.stopped || t.symbol->kind == .module_name) return nullptr;
    return t.symbol;
}

static void declare_alias_symbol(Checked *r, const ast::Decl *d, const Symbol *target) {
    if (d->kind != .variable) return;
    Symbol alias = *target;
    alias.name = qualified(r, false, d->kind.variable.name);
    alias.decl = target->decl;
    alias.exported = d->exported || d->is_pub;
    declare_in_module(r, alias, d->span);
}

// `let Arena = arena.Arena`: a type alias, declared with the aliases (pass 2) so a signature may use it.
static Bool declare_module_type_alias(Checked *r, const ast::Decl *d) {
    if (d->kind != .variable) return false;
    Bool reported = false;
    const Symbol *target = alias_target(r, d, &reported);
    if (reported) return true;
    if (target == nullptr || target->kind != .type_name) return false;
    declare_alias_symbol(r, d, target);
    return true;
}

// `let sin = m.sin`: a function or constant, declared with the members (pass 3).
static Bool declare_module_alias(Checked *r, const ast::Decl *d) {
    Bool reported = false;
    const Symbol *target = alias_target(r, d, &reported);
    if (reported) return true;
    if (target == nullptr || target->kind == .type_name) return target != nullptr;
    declare_alias_symbol(r, d, target);
    return true;
}

// One module waiting to be declared: its prefix and the tree.
struct Pending {
    Str prefix;
    const ast::Module *module;
};

static constexpr Usize max_modules = 256;

static Bool has_prefix(const Pending list[:], Usize count, Str prefix) {
    for (Usize i = 0; i < count; i++) {
        if (same_text(list[i].prefix, prefix)) return true;
    }
    return false;
}

// Declares the module symbol of every `import a.b as x` of `m`, and, with a loader, reads each module they name
// (and the modules those import) into `list` once, a cycle ending where it started.
static Usize collect_imports(Checked *r, const ast::Module *m, Pending list[:]) {
    Usize count = 0;
    Usize next = 0;
    const ast::Module *at = m;
    Str scope = "";
    while (at != nullptr) {
        for (Usize i = 0; i < countof(at->decls); i++) {
            const ast::Decl *d = at->decls[i];
            ast::Path path = {};
            if (d->kind == .import_from) {
                path = d->kind.import_from.path;
            } else if (d->kind == .import_module) {
                path = d->kind.import_module.path;
            } else {
                continue;
            }
            if (countof(path.segments) == 0) continue;
            if (d->kind == .import_module) {
                Str alias = d->kind.import_module.alias;
                if (countof(alias) == 0) alias = path.segments[countof(path.segments) - 1].text;
                Symbol symbol = {.name = msg(format::push(scope, alias)),
                                 .kind = .module_name,
                                 .type = r->table.invalid,
                                 .decl = d,
                                 .exported = d->exported || d->is_pub};
                declare_in_module(r, symbol, d->span);
            }
            ModuleLoader load = r->options.load;
            if (load == nullptr) continue;
            Str prefix = prefix_of_import(d);
            if (has_prefix(list, count, prefix)) continue;
            load_failure_text = "";
            const ast::Module *loaded =
                load(msg(format::push(joined(path, ".")))
                         .data); // a copy: one name is a slice of the source, with no terminator
            if (loaded == nullptr && countof(load_failure_text) > 0) {
                if (at != m && countof(at->name.segments) > 0) {
                    failf(r, d->span, "`", joined(at->name, "."), "` imports `", joined(path, "."),
                          "`, which does not parse: ", load_failure_text);
                } else {
                    failf(r, d->span, "the module `", joined(path, "."), "` does not parse: ", load_failure_text);
                }
            } else if (loaded == nullptr) {
                failf(r, d->span, "cannot find the module `", joined(path, "."), "`; check its path under the roots");
            } else if (count == countof(list)) {
                failf(r, d->span, "more than ", countof(list), " modules are imported; the checker reads that many");
            } else {
                // an imported module is read as it is on this system, as the main one is (#2323)
                if (when::uses_when(loaded)) {
                    loaded = when::live_module(loaded, when::host());
                }
                list[count] = (Pending){.prefix = prefix, .module = loaded};
                count += 1;
            }
        }
        at = nullptr;
        if (next < count) {
            at = list[next].module;
            scope = list[next].prefix;
            next += 1;
        }
    }
    return count;
}

// `std.prelude` (lib/std/prelude.smith), read with the imports of every module but itself when the loader has it
// (#2669): its public names are seen without an import, after every other name (`prelude_symbol`). A module the
// prelude imports is not read; it imports none.
static Bool is_prelude(const ast::Module *m) {
    return countof(m->name.segments) == 2 && same_text(m->name.segments[0].text, "std") &&
           same_text(m->name.segments[1].text, "prelude");
}

static Usize collect_prelude(Checked *r, const ast::Module *m, Pending list[:], Usize count) {
    Str prefix = "std::prelude::";
    ModuleLoader load = r->options.load;
    if (load == nullptr || is_prelude(m) || count == countof(list)) return count;
    if (has_prefix(list, count, prefix)) {
        r->scopes.prelude = true;
        return count;
    }
    load_failure_text = "";
    const ast::Module *loaded = load("std.prelude");
    if (loaded == nullptr) {
        return count;
    }
    list[count] = (Pending){.prefix = prefix, .module = loaded};
    r->scopes.prelude = true;
    return count + 1;
}

// Declares the public and private declarations of the imported modules, each under its prefix, before the module's
// own (#1677). A generic function is not declared (its use reports itself).
static void declare_headers(Checked *r, const ast::Module *m);

// Whether every module in `list` that module `k` imports is already in `done`.
static Bool imports_done(const Pending list[:], Usize count, const Bool done[:], Usize k) {
    const ast::Module *m = list[k].module;
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind != .import_from && d->kind != .import_module) continue;
        Str prefix = prefix_of_import(d);
        for (Usize j = 0; j < count; j++) {
            if (j != k && !done[j] && same_text(list[j].prefix, prefix)) return false;
        }
    }
    return true;
}

// Puts each module after the ones it imports, so a type that names another module's type finds it declared. The walk
// finds a module before its imports, and an import found early may be needed by one found later. A cycle is cut at
// the first module left.
static void order_by_imports(Pending list[:], Usize count) {
    Pending sorted[max_modules] = {};
    Bool done[max_modules] = {};
    Usize placed = 0;
    while (placed < count) {
        Bool progress = false;
        for (Usize k = 0; k < count; k++) {
            if (done[k] || !imports_done(list, count, done, k)) continue;
            sorted[placed] = list[k];
            placed += 1;
            done[k] = true;
            progress = true;
        }
        if (progress) continue;
        for (Usize k = 0; k < count; k++) {
            if (done[k]) continue;
            sorted[placed] = list[k];
            placed += 1;
            done[k] = true;
            break;
        }
    }
    for (Usize k = 0; k < count; k++)
        list[k] = sorted[k];
}

static void declare_imported(Checked *r, Pending list[:], Usize count) {
    order_by_imports(list, count);
    for (Usize k = 0; k < count; k++) {
        const ast::Module *m = list[k].module;
        // The headers the module imports bind their names for its own code only (`[k.SIDE]u8` in a field, and the
        // body of an instance of its generic): each binding it adds is its own, seen while its prefix is in force.
        Usize bindings = r->binding_count;
        declare_headers(r, m);
        for (Usize i = bindings; i < r->binding_count; i++)
            r->bindings[i].owner = list[k].prefix;
        r->prefix = list[k].prefix;
        for (Usize i = 0; i < countof(m->decls); i++)
            declare_nominal(r, m->decls[i]);
        for (Usize i = 0; i < countof(m->decls); i++) {
            if (!declare_module_type_alias(r, m->decls[i])) declare_alias(r, m->decls[i]);
        }
        for (Usize i = 0; i < countof(m->decls); i++) {
            const ast::Decl *d = m->decls[i];
            Usize before = r->error_count;
            Usize symbols = r->scopes.count;
            declare_member(r, d);
            if (d->kind == .function && r->error_count > before) {
                r->error_count = before;
                r->scopes.count = symbols;
            }
        }
        type_constants(r, m);
    }
    r->prefix = "";
}

// The enumerators of a C enumeration are names of their own, as in C: `c::red`, a constant of the enumeration's type
// whose initializer is the value the header gave it.
static void declare_enumerators(Checked *r, const ast::Decl *d) {
    if (d->kind != .enumeration) return;
    ast::Enumerator items[:] = d->kind.enumeration.items;
    const Symbol *named = lookup(&r->scopes, qualified(r, true, d->kind.enumeration.name));
    if (named == nullptr || !declared_by(named, d)) return;
    for (Usize i = 0; i < countof(items); i++) {
        ast::Enumerator item = items[i];
        if (item.value == nullptr) continue;
        ast::Decl *constant = ast::variable(item.name, ast::named("I32"), item.value);
        constant->from_c = true;
        Symbol symbol = {.name = qualified(r, true, item.name),
                         .kind = .variable,
                         .type = named->type,
                         .decl = constant,
                         .is_const = true};
        declare_in_module(r, symbol, d->span);
    }
}

// The name a header binds without `as`: its file name without the extension (`sys/stat.h` binds `stat`).
static Str header_stem(Str header) {
    Usize begin = 0;
    for (Usize i = 0; i < countof(header); i++)
        if (header[i] == '/') begin = i + 1;
    Usize end = countof(header);
    for (Usize i = begin; i < countof(header); i++)
        if (header[i] == '.') end = i;
    return header[begin:end];
}

// Whether `m` declares a function called `name`.
static Bool declares_function(const ast::Module *m, Str name) {
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind == .function && same_text(d->kind.function.name, name)) return true;
    }
    return false;
}

// The name `import c <h>` binds with no `as`: the header's stem, or `<stem>_h` with a fix that writes it, when a
// function of the module has the stem's name and would hide the binding (#2446).
static Str default_binding(Checked *r, const ast::Module *m, const ast::Decl *imported, Str header) {
    Str binding = header_stem(header);
    if (!declares_function(m, binding)) return binding;
    Str renamed = msg(format::push(binding, "_h"));
    syntax::Edits fix = mem::alloc_slice(syntax::Edit, 1);
    fix[0] = (syntax::Edit){.span = {.start = imported->span.end, .end = imported->span.end},
                            .text = msg(format::push(" as ", renamed))};
    Str prefix = r->prefix; // the previous header left `c::`, which would drop the fix
    r->prefix = "";
    fail_fix(r, imported->span,
             msg(format::push("this module has a function `", binding,
                              "`, which hides the header's binding: write `as ", renamed, "`")),
             fix);
    r->prefix = prefix;
    return renamed;
}

// Declares what each `import <h>;` of `m` brings, as `c::name` (#1762): the header's declarations in the three passes
// a module's own take.
// The headers this check has declared (#2888). Every header declares under `c::` and the first declaration of a name
// stays (`declare_beside`), so declaring a header a second time adds nothing: a module that imports one already
// declared only binds its name. The loader gives the same tree for the same header, so the tree is the identity.
constexpr Usize declared_headers_max = 512;
static const ast::Module *declared_header_list[declared_headers_max];
static Usize declared_header_count = 0;

static Bool header_declared(const ast::Module *header) {
    for (Usize i = 0; i < declared_header_count; i++) {
        if (declared_header_list[i] == header) return true;
    }
    if (declared_header_count < declared_headers_max) {
        declared_header_list[declared_header_count] = header;
        declared_header_count += 1;
    }
    return false;
}

static void declare_headers(Checked *r, const ast::Module *m) {
    if (r->options.headers == nullptr) return;
    r->in_header = true;
    for (Usize k = 0; k < countof(m->decls); k++) {
        const ast::Decl *imported = m->decls[k];
        Str name = "";
        Bool angled = false;
        if (imported->kind == .import_c) {
            name = imported->kind.import_c.header;
            angled = imported->kind.import_c.angled;
        } else if (imported->kind == .import_from && countof(imported->kind.import_from.header) > 0) {
            name = imported->kind.import_from.header;
            angled = imported->kind.import_from.angled;
        } else {
            continue;
        }
        if (imported->kind == .import_c && countof(imported->kind.import_c.language) > 0 &&
            !same_text(imported->kind.import_c.language, "c")) {
            failf(r, imported->span, same_text(imported->kind.import_c.language, "cpp") ? "C++" : "Objective-C",
                  " headers are not imported yet");
            continue;
        }
        const ast::Module *header = r->options.headers(name, angled);
        if (header == nullptr) {
            failf(r, imported->span, "cannot read the C header `", name,
                  "`; check that it exists and that its flags are right");
            continue;
        }
        if (imported->kind == .import_c && countof(imported->kind.import_c.language) > 0 &&
            r->binding_count < max_header_bindings) {
            Str binding = imported->kind.import_c.alias;
            if (countof(binding) == 0) {
                binding = default_binding(r, m, imported, name);
            }
            r->bindings[r->binding_count] = (HeaderBinding){.name = binding, .header = header};
            r->binding_count++;
        }
        if (header_declared(header)) continue;
        r->prefix = "c::"; // a type in a header names another by its bare name: it is looked up as `c::name`
        for (Usize i = 0; i < countof(header->decls); i++)
            declare_nominal(r, header->decls[i]);
        for (Usize i = 0; i < countof(header->decls); i++) {
            Usize failed = r->error_count;
            if (!declare_module_type_alias(r, header->decls[i])) declare_alias(r, header->decls[i]);
            r->error_count = failed; // an alias of a type with no smith type is left out: its use says unknown
        }
        for (Usize i = 0; i < countof(header->decls); i++) {
            Usize before = r->error_count;
            Usize symbols = r->scopes.count;
            declare_member(r, header->decls[i]);
            if (r->error_count > before) { // a declaration this checker cannot type is left out: its use says unknown
                r->error_count = before;
                r->scopes.count = symbols;
            }
        }
        for (Usize i = 0; i < countof(header->decls); i++)
            declare_enumerators(r, header->decls[i]);
    }
    r->prefix = "";
    r->in_header = false;
}

// Binds what each `from a.b import x, y` of `m` names (#1809): `x` is the declaration `x` of `a.b` (or `c::x` of a C
// header), under the bare name, as if the module wrote `let x = b.x`.
static void declare_from(Checked *r, const ast::Decl *d) {
    if (d->kind == .import_from) {
        ast::Identifier names[:] = d->kind.import_from.names;
        ast::Path path = d->kind.import_from.path;
        Bool header = countof(d->kind.import_from.header) > 0;
        Str prefix = "c::";
        Str where = d->kind.import_from.header;
        if (!header) {
            prefix = prefix_of_import(d);
            where = joined(path, ".");
        }
        Bool is_pub = d->exported || d->is_pub;
        for (Usize i = 0; i < countof(names); i++) {
            ast::Identifier name = names[i];
            const Symbol *target = lookup(&r->scopes, msg(format::push(prefix, name.text)));
            if (target == nullptr || (!header && !is_public(target))) {
                failf(r, name.span, "`", where, "` has no public `", name.text, "`");
                continue;
            }
            Symbol alias = *target;
            alias.name = name.text;
            alias.exported = is_pub;
            declare_in_module(r, alias, name.span);
        }
    }
}

static void declare_from_names(Checked *r, const ast::Module *m) {
    for (Usize k = 0; k < countof(m->decls); k++)
        declare_from(r, m->decls[k]);
}

// Declares the names of `m`, resolves the types of its declarations and, when `o.bodies` is set, checks each body.
// Errors are in the result, never an abort.
export Checked check(const ast::Module *m, Options o) {
    Checked r = {.options = o,
                 .table = start(o.target),
                 .bindings = mem::alloc_slice(HeaderBinding, max_header_bindings),
                 .current = max_instances,
                 .module = nullptr};
    if (o.target.pointer_bytes == 0) {
        fail(&r, (ast::Span){}, "the target has no pointer width; pass a target such as types::lp64() in the options");
        return r;
    }
    Pending pending[:] = mem::alloc_slice(Pending, o.load == nullptr ? 0 : max_modules);
    declared_header_count = 0;
    declare_headers(&r, m);
    Usize imported = collect_imports(&r, m, pending);
    imported = collect_prelude(&r, m, pending, imported);
    declare_imported(&r, pending, imported);
    declare_from_names(&r, m);
    for (Usize i = 0; i < countof(m->decls); i++)
        declare_nominal(&r, m->decls[i]);
    for (Usize i = 0; i < countof(m->decls); i++) {
        if (!declare_module_type_alias(&r, m->decls[i])) declare_alias(&r, m->decls[i]);
    }
    for (Usize i = 0; i < countof(m->decls); i++)
        declare_member(&r, m->decls[i]);
    type_constants(&r, m);
    if (o.bodies == nullptr) return r;
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind == .function && d->kind.function.body != nullptr) {
            expand_reflection(&r, m->decls[i]);
            o.bodies(&r, d);
        }
    }
    return r;
}

// The module-level symbols and the errors as text, for the golden tests: a line `<kind> <name>: <type>` per symbol in
// the order declared, then `error <start>-<end>: <message>` per error.
static Str kind_word(SymbolKind kind) {
    switch (kind) {
    case .variable:
        return "variable";
    case .function_symbol:
        return "function";
    case .type_name:
        return "type";
    case .module_name:
        return "module";
    }
    return "";
}

export Str dump(const Checked *r) {
    Output text = {};
    for (Usize i = 0; i < r->scopes.count; i++) {
        const Symbol *s = &r->scopes.symbols[i];
        put(&text, kind_word(s->kind));
        put(&text, " ");
        put(&text, s->name);
        put(&text, ": ");
        put(&text, show(s->type));
        put(&text, "\n");
    }
    for (Usize i = 0; i < r->error_count; i++) {
        put(&text, "error ");
        put_number(&text, r->errors[i].span.start);
        put(&text, "-");
        put_number(&text, r->errors[i].span.end);
        put(&text, ": ");
        put(&text, r->errors[i].message);
        put(&text, "\n");
    }
    return text.data[0:text.length];
}
