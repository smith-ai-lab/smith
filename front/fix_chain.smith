// front::fix_chain, the fix-it for a payload read after its variant test in a value (D16, #2648).
//
//   return s == .circle && s.circle.r > 1                   return s is .circle and s.r > 1
//   return e.kind == .binary && e.kind.binary.op == .add    kind := e.kind
//                                                           return kind is .binary and kind.op == .add
//
// `s is .v` is an ordinary bool that narrows the name `s` to the payload of `v` to its right in the chain (#3190 items
// 27 and 28), so a read `s.v` is `s` and `s.v.f` is `s.f`; no name is bound. Only a name that cannot change narrows, so
// a field (`e.kind`) is named first, in a line of its own before the statement, after the field (`kind`; `kind_value`
// where `kind` is taken); that moves the read of the field before the whole chain, so it is done only where the test
// is the first conjunct. A name declared `mut` stays, and so does a test after another conjunct on a field.
//
// A chain is a `return` or a `name := ...` / `name: bool = ...` of one line, whose chain at the top level has `A == .v`
// followed by reads of `A.v`; in a chain of `or`s it is `A != .v`, written `A is not .v` (`return s != .circle or
// s.circle.r > 1` is `return s is not .circle or s.r > 1`). A chain with both is left, and so is a read to the left of
// the test.
// The `if` and `while` forms are the checker's. Tests: `tests/front_fix_chain_test.smith`.
//
//   fix_chain::edits(source)   the fixes for the statements of `source`
module front::fix_chain;

import front::ast;
import front::parse as core;
import front::types;
import std::format;
import std::mem;

static Bool word_char(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
}

static Bool starts_with(Str text, Str prefix) {
    if (countof(text) < countof(prefix)) return false;
    for (Usize i = 0; i < countof(prefix); i++)
        if (text[i] != prefix[i]) return false;
    return true;
}

static Usize line_end(Str source, Usize at) {
    while (at < countof(source) && source[at] != '\n')
        at += 1;
    return at;
}

// Where the value of the statement at `from` starts, in `line` (`return x`, `name := x`, `name: bool = x`); the end of
// the line when the statement is none of these.
static Usize value_start(Str line, Usize from) {
    Str ret = "return ";
    if (starts_with(line[from:countof(line)], ret)) return from + countof(ret);
    Usize k = from;
    if (starts_with(line[k:countof(line)], "mut ")) k += 4;
    Usize name = k;
    while (k < countof(line) && word_char(line[k]))
        k += 1;
    if (k == name) return countof(line);
    if (starts_with(line[k:countof(line)], " := ")) return k + 4;
    if (starts_with(line[k:countof(line)], ": bool = ")) return k + 9;
    return countof(line);
}

// One conjunct of the chain: [start, stop) in the line, with the blanks around it out.
struct Piece {
    Usize start;
    Usize stop;
};

// Splits `line[from:]` at its top-level `&&` (or at its top-level `||`, then `*or_chain` is set); false when both are
// in it or a trailing `:` (a block follows) is. A pattern `.w(w) := x` is a piece that no test matches.
static Bool pieces_of(Str line, Usize from, Piece parts[8], Usize *count, Bool *or_chain) {
    Usize depth = 0;
    Bool saw_and = false;
    *or_chain = false;
    Usize start = from;
    *count = 0;
    Bool quoted = false;
    for (Usize i = from; i < countof(line); i++) {
        char ch = line[i];
        if (ch == '"') quoted = !quoted;
        if (quoted) continue;
        if (ch == '(' || ch == '[' || ch == '{') depth += 1;
        if ((ch == ')' || ch == ']' || ch == '}') && depth > 0) depth -= 1;
        if (depth != 0) continue;
        if (ch == ':' && i + 1 == countof(line)) return false; // a block follows: `x := if ...:`
        Bool or_here = (ch == '|' && i + 1 < countof(line) && line[i + 1] == '|') ||
                       (ch == ' ' && starts_with(line[i:countof(line)], " or "));
        if (or_here) {
            if (saw_and) return false;
            *or_chain = true;
            if (*count >= 8) return false;
            parts[*count] = (Piece){.start = start, .stop = i};
            *count += 1;
            start = i + (ch == '|' ? 2 : 4);
            i = start - 1;
            continue;
        }
        if (ch == ' ' && starts_with(line[i:countof(line)], " and ")) {
            if (*or_chain) return false;
            saw_and = true;
            if (*count >= 8) return false;
            parts[*count] = (Piece){.start = start, .stop = i};
            *count += 1;
            start = i + 5;
            i += 4;
        }
        if (ch == '&' && i + 1 < countof(line) && line[i + 1] == '&') {
            if (*or_chain) return false;
            saw_and = true;
            if (*count >= 8) return false;
            parts[*count] = (Piece){.start = start, .stop = i};
            *count += 1;
            start = i + 2;
            i += 1;
        }
    }
    if (*count >= 8) return false;
    parts[*count] = (Piece){.start = start, .stop = countof(line)};
    *count += 1;
    return true;
}

// `A == .v` (`A != .v` where `negative`) as a whole conjunct: the chain `A` of names and dots, then the variant; false
// when it is anything else.
static Bool is_test(Str piece, Bool negative, Str *subject, Str *variant) {
    Usize k = 0;
    while (k < countof(piece) && (word_char(piece[k]) || piece[k] == '.'))
        k += 1;
    if (k == 0 || !starts_with(piece[k:countof(piece)], negative ? " != ." : " == .")) return false;
    Usize v = k + 5;
    Usize end = v;
    while (end < countof(piece) && word_char(piece[end]))
        end += 1;
    if (end == v || end != countof(piece)) return false;
    *subject = piece[0:k];
    *variant = piece[v:end];
    return true;
}

// The places in `text` that read `A.v` as a whole (not `A.value`, not `xA.v`).
static Usize read_at(Str text, Usize from, Str subject, Str variant) {
    Usize n = countof(subject) + 1 + countof(variant);
    for (Usize i = from; i + n <= countof(text); i++) {
        if (i > 0 && (word_char(text[i - 1]) || text[i - 1] == '.')) continue;
        if (!starts_with(text[i:countof(text)], subject)) continue;
        if (text[i + countof(subject)] != '.') continue;
        if (!starts_with(text[i + countof(subject) + 1:countof(text)], variant)) continue;
        if (i + n < countof(text) && word_char(text[i + n])) continue;
        return i;
    }
    return countof(text);
}

// The first byte of the function that has the byte `at` and the end of it: the lines at column 0 around it.
static Usize function_start(Str source, Usize at) {
    Usize start = at;
    while (start > 0) {
        Usize prev = start - 1;
        while (prev > 0 && source[prev - 1] != '\n')
            prev -= 1;
        start = prev;
        if (source[start] != ' ' && source[start] != '\n') break;
    }
    return start;
}

static Usize function_stop(Str source, Usize at) {
    Usize stop = line_end(source, at) + 1;
    while (stop < countof(source) && (source[stop] == ' ' || source[stop] == '\n'))
        stop = line_end(source, stop) + 1;
    if (stop > countof(source)) stop = countof(source);
    return stop;
}

// Whether `name` is a word in the function that has the byte `at`, other than as a variant or a field (`.name`): a
// local, a parameter or a call of that name would be hidden by a new name, so the chain stays as it is.
static Bool function_uses(Str source, Usize at, Str name) {
    Usize start = function_start(source, at);
    Usize stop = function_stop(source, at);
    for (Usize i = start; i + countof(name) <= stop; i++) {
        if (i > 0 && (word_char(source[i - 1]) || source[i - 1] == '.')) continue;
        if (!starts_with(source[i:stop], name)) continue;
        if (i + countof(name) < stop && word_char(source[i + countof(name)])) continue;
        return true;
    }
    return false;
}

// Whether a fix already in `out` for the function that has the byte `at` writes the name `name` (`name := ...`).
static Bool named_in(core::Errors out, Str source, Usize at, Str name) {
    Usize start = function_start(source, at);
    Usize stop = function_stop(source, at);
    Str written = types::message_of(format::push(name, " := "));
    for (Usize i = 0; i < countof(out); i++) {
        if (out[i].span.start < start || out[i].span.start >= stop) continue;
        if (starts_with(out[i].fix[0].text, written)) return true;
    }
    return false;
}

// The part of the field chain `subject` after its last dot: `kind` for `w.expr.kind`.
static Str last_part(Str subject) {
    Usize k = countof(subject);
    while (k > 0 && subject[k - 1] != '.')
        k -= 1;
    return subject[k:countof(subject)];
}

static Bool has_dot(Str subject) {
    for (Usize i = 0; i < countof(subject); i++)
        if (subject[i] == '.') return true;
    return false;
}

static core::Errors add(core::Errors out, Usize start, Usize stop, Str text) {
    out = mem::realloc(out, countof(out) + 1);
    core::Edits fix = {};
    fix = mem::realloc(fix, 1);
    ast::Span at = {.start = (U32)start, .end = (U32)stop};
    fix[0] = (core::Edit){.span = at, .text = text};
    core::ParseError made = {};
    made.span = at;
    Str why = "a payload read after its variant test is a pattern of the chain";
    made.message = why;
    made.fix = fix;
    out[countof(out) - 1] = made;
    return out;
}

// The fixes for one chain whose line starts at `base` in the source; the first test that can be written, one per chain.
static core::Errors chain(core::Errors out, Str source, Str line, Usize base, Usize from) {
    Piece parts[8];
    Usize count = 0;
    Bool or_chain = false;
    if (!pieces_of(line, from, parts, &count, &or_chain) || count < 2) return out;
    for (Usize i = 0; i + 1 < count; i++) {
        Usize a = parts[i].start;
        Usize b = parts[i].stop;
        while (a < b && line[a] == ' ')
            a += 1;
        while (b > a && line[b - 1] == ' ')
            b -= 1;
        Str subject = "";
        Str variant = "";
        if (!is_test(line[a:b], or_chain, &subject, &variant)) continue;
        // a read to the left of the test is out of its scope: leave the chain
        if (read_at(line[from:a], 0, subject, variant) < countof(line[from:a])) continue;
        Usize first = read_at(line, parts[i].stop, subject, variant);
        if (first >= countof(line)) continue;
        // a name that can change does not narrow
        if (function_uses(source, base + a, types::message_of(format::push("mut ", subject)))) continue;
        // a field is named first, which reads it before the whole chain: only where the test is the first conjunct
        Str name = subject;
        Usize indent = 0;
        if (has_dot(subject)) {
            if (i != 0) continue;
            name = last_part(subject);
            if (function_uses(source, base + a, name) || named_in(out, source, base + a, name))
                name = types::message_of(format::push(name, "_value"));
            if (function_uses(source, base + a, name) || named_in(out, source, base + a, name)) continue;
            while (indent < countof(line) && line[indent] == ' ')
                indent += 1;
            Str naming = types::message_of(format::push(name, " := ", subject, "\n", line[0:indent]));
            out = add(out, base + indent, base + indent, naming);
        }
        out = add(out, base + a, base + b,
                  types::message_of(format::push(name, or_chain ? " is not ." : " is .", variant)));
        Usize at = parts[i].stop;
        Usize found = read_at(line, at, subject, variant);
        while (found < countof(line)) {
            out = add(out, base + found, base + found + countof(subject) + 1 + countof(variant), name);
            at = found + countof(subject) + 1 + countof(variant);
            found = read_at(line, at, subject, variant);
        }
        return out;
    }
    return out;
}

// The fixes for the statements of `source`: a `return` or an initializer (D16). A test in an `if`, `else if` or `while`
// is the checker's when it starts the chain and stays as it is when a conjunct comes before it (`ok and k == .v and
// k.v.n`: the conjuncts before it may be what makes `k` safe to read).
export core::Errors edits(Str source) {
    core::Errors out = {};
    Usize at = 0;
    while (at < countof(source)) {
        Usize end = line_end(source, at);
        Str line = source[at:end];
        Usize k = 0;
        while (k < countof(line) && line[k] == ' ')
            k += 1;
        Usize from = value_start(line, k);
        if (from < countof(line)) out = chain(out, source, line, at, from);
        at = end + 1;
    }
    return out;
}
