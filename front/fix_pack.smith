// front::fix_pack, the fix-it for a pack expansion with a pattern (item 45 of #3235, the row of #3221).
//
//   plus(rest, off)...                   map(rest, fn(each): plus(each, off))...
//
// Today's `pattern...` writes the pattern once for each element of a pack: `plus(rest, off)...` is `plus(rest.0, off),
// plus(rest.1, off), ...`. The language has one spread, of a name (`rest...`); applying a function to each element
// is `map`, so the pattern becomes the body of a lambda whose parameter stands for the element: every word `rest` of the
// pattern is replaced by `each`. The checker reads `map(rest, f)...` as the arguments `f(rest.0), f(rest.1), ...`
// (`spread_value` in `types_expr`).
//
// The pack is the `name...` parameter of the function the expansion is in. An expansion whose pattern is a name or a
// chain of fields (`rest...`, `opts.items...`) ends with a word and is left as it is; so is one already a `map`.
//
//   fix_pack::edits(source)   one fix for each expansion with a pattern
module front::fix_pack;

import front::ast;
import front::parse as core;
import std::arena;
import std::format;
import std::mem;

static Bool word_char(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
}

static Bool starts_with(Str text, Str prefix) {
    if (countof(text) < countof(prefix)) return false;
    for (Usize i = 0; i < countof(prefix); i++)
        if (text[i] != prefix[i]) return false;
    return true;
}

static Bool same(Str a, Str b) {
    return countof(a) == countof(b) && starts_with(a, b);
}

// Whether `source` has `...` at `at`, and it is no longer run of dots.
static Bool dots_at(Str source, Usize at) {
    if (at + 3 > countof(source) || !starts_with(source[at:countof(source)], "...")) return false;
    if (at > 0 && source[at - 1] == '.') return false;
    return at + 3 >= countof(source) || source[at + 3] != '.';
}

// The start of the line that holds `at`.
static Usize line_start(Str source, Usize at) {
    while (at > 0 && source[at - 1] != '\n')
        at -= 1;
    return at;
}

static Usize line_end(Str source, Usize at) {
    while (at < countof(source) && source[at] != '\n')
        at += 1;
    return at;
}

// The pack parameter `name...` of the function that holds `at`: the nearest line above, at column 0 or after `pub `,
// `export `, `static `, that starts a `fn` and has a parameter written `name...`. Empty when there is none.
static Str pack_of(Str source, Usize at) {
    Usize here = line_start(source, at);
    while (true) {
        Usize end = line_end(source, here);
        Str line = source[here:end];
        Usize k = 0;
        while (k < countof(line) && (starts_with(line[k:countof(line)], "pub ") || starts_with(line[k:countof(line)], "export ") ||
                                     starts_with(line[k:countof(line)], "static ")))
            k += line[k] == 'p' ? 4 : (line[k] == 'e' ? 7 : 7);
        if (starts_with(line[k:countof(line)], "fn ")) {
            for (Usize i = k; i + 3 <= countof(line); i++) {
                if (!dots_at(line, i) || i == 0 || !word_char(line[i - 1])) continue;
                Usize from = i;
                while (from > 0 && word_char(line[from - 1]))
                    from -= 1;
                return line[from:i];
            }
            return "";
        }
        if (here == 0) return "";
        here = line_start(source, here - 1);
    }
}

// The start of the pattern that ends at `end`: back over a balanced run of text to the `,`, `(`, `[` or `{` before it.
static Usize pattern_start(Str source, Usize end) {
    Usize depth = 0;
    Usize at = end;
    while (at > 0) {
        char ch = source[at - 1];
        if (ch == ')' || ch == ']' || ch == '}') {
            depth += 1;
        } else if (ch == '(' || ch == '[' || ch == '{') {
            if (depth == 0) break;
            depth -= 1;
        } else if (depth == 0 && (ch == ',' || ch == ';' || ch == '\n')) {
            break;
        }
        at -= 1;
    }
    while (at < end && source[at] == ' ')
        at += 1;
    return at;
}

// `pattern` with each whole word `pack` (not a member `x.pack`) written `each`.
static Str substituted(Str pattern, Str pack) {
    char out[:] = mem::alloc_slice(char, countof(pattern) * 2 + 8);
    Usize n = 0;
    Str each = "each";
    Usize i = 0;
    while (i < countof(pattern)) {
        Bool word_start = word_char(pattern[i]) && (i == 0 || !word_char(pattern[i - 1]));
        if (word_start) {
            Usize j = i;
            while (j < countof(pattern) && word_char(pattern[j]))
                j += 1;
            Bool member = i > 0 && (pattern[i - 1] == '.' || (i > 1 && pattern[i - 1] == '>' && pattern[i - 2] == '-'));
            Str word = pattern[i:j];
            Str put = word;
            if (!member && same(word, pack)) put = each;
            for (Usize k = 0; k < countof(put); k++) {
                out[n] = put[k];
                n += 1;
            }
            i = j;
            continue;
        }
        out[n] = pattern[i];
        n += 1;
        i += 1;
    }
    Str result = out[0:n];
    return result;
}

static Bool names(Str pattern, Str pack) {
    Str probe = substituted(pattern, pack);
    return !same(probe, pattern);
}

export core::Errors edits(Str source) {
    core::Errors out = {};
    for (Usize at = 1; at + 3 <= countof(source); at++) {
        if (!dots_at(source, at)) continue;
        char before = source[at - 1];
        if (before != ')' && before != ']') continue;
        Usize start = pattern_start(source, at);
        Str pattern = source[start:at];
        if (starts_with(pattern, "map(")) continue;
        Str pack = pack_of(source, at);
        if (countof(pack) == 0 || !names(pattern, pack)) continue;
        Str body = substituted(pattern, pack);
        char text[:] = format::push("map(", pack, ", fn(each): ", body, ")");
        core::Edits fix = {};
        fix = mem::realloc(fix, 1);
        Str written = text;
        fix[0] = (core::Edit){.span = {.start = (U32)start, .end = (U32)at}, .text = written};
        core::ParseError made = {};
        made.span = fix[0].span;
        Str why = "a pack expansion with a pattern is `map` over the pack, spread: `map(rest, fn(each): f(each))...`";
        made.message = why;
        made.fix = fix;
        out = mem::realloc(out, countof(out) + 1);
        out[countof(out) - 1] = made;
    }
    return out;
}
