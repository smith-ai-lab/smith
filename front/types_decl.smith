// front::types_decl: declarations, statements and bodies (#1112, ticket J1d of #1220). The last piece of the checker:
// it joins front::types (J1a: types, scopes, signatures), front::types_expr (J1b: expressions) and front::types_convert
// (J1c: conversions). Not wired into `smith cc`.
//
// THE API
//
//   check_module(module, target)   Checks a whole module and gives the `types::Checked`: the module's names and
//                                  signatures (types::check), each function body, each module-level initializer, and
//                                  every lambda body. Errors are in `Checked.errors`, each at a span and each naming
//                                  what was expected and what to write.
//   check_module_with(module, target, load)
//                                  check_module that also reads the modules the file imports (`import a.b as m`),
//                                  `load` giving the tree of a dotted path (#1677): `m.name` is then a public
//                                  declaration of that module, and `let sin = m.sin` a name for it. Without `load`,
//                                  an import binds a name and reads nothing.
//   options(target)                The `types::Options` that make `types::check` call `check_body` for every function
//                                  with a body, after wiring the hooks below. For a caller that wants `types::check`
//                                  itself.
//   install()                      Wires J1c and J1d into J1b: `types_expr::Hooks.convert` is `types_convert::convert`
//                                  (a refusal is reported at the expression's span with the verdict's message, which
//                                  names the expected type, the found type and what to write) and `.lambda_body`
//                                  checks a lambda's body. `check_module` and `options` call it; `check_module` takes
//                                  the hooks out again with `uninstall()` when it is done, `options` leaves them for
//                                  the caller.
//   check_body(r, function)        The `types::BodyChecker`: declares the parameters in a scope, walks the statements
//                                  and pops the scope.
//   locals_dump()                  The locals and returns that the bodies declared, one line each, for the golden
//                                  tests: `local <function>.<name>: <type>`.
//
// WHAT IS CHECKED
//   Statements     blocks (each its own scope), expression statements, locals (`I32 n = count(xs);`, `Auto x = e;`,
//                  an array local), `if`, `while`, `do`/`while`, `for (init; condition; step)`, `return`, `defer`, a
//                  label's statement, `break`, `continue`, `goto`. A condition is checked against `Bool`; a `return`
//                  value against the function's result type (a plain `return;` in a function that returns a value is
//                  an error, a value in a `Void` function too).
//   Constants      `const X = v` (and `constexpr`), local or of the module, is an error when `v` names a variable
//                  that is not constant (spec "Modules and declarations"). In smith's own syntax (`is_new`): a
//                  binding is constant unless `mut` (writes are refused by types_expr), shadowing is an error (the
//                  earlier declaration is named by its byte offset: the checker has no line table), `let _ = f()`
//                  discards, and a call whose result is not `Void` and is not used is an error, once the function has a
//                  parameter or an earlier local in that syntax (a function has no marker of its own). `let (q, r) =
//                  f()` and `let (mut q, mut r) = f()` split a tuple: one binding per element, `_` discards one, a
//                  wrong count is an error naming both. Nested patterns are not parsed yet.
//   Locals         The type is written, or `Auto` takes the initializer's type. A name already in the same scope is an
//                  error. A local is `const` through the written type.
//   Calls, Fn      Calls and the `Fn(F)` values are typed by front::types_expr; this module supplies the conversions
//                  they ask for (a function name for a parameter `Fn(F)` of its own type, a lambda from the expected
//                  `Fn(F)`).
//   Lambdas        A lambda's parameters take the types of the expected `Fn(F)`. Its body is checked after the body
//                  that holds it: the hook keeps a copy of the scopes as they were at the lambda and the statement
//                  walk, which has no recursion, runs on it when the enclosing walk is done.
//   static_assert  In a body its condition is checked as a `Bool`; the emitter folds it and reports a false or unknown
//                  condition (front::emit).
//   Not yet        Each reported as `not yet typed: <kind>` at its span, never accepted: `switch`, `if constexpr` and
//   `for constexpr`, a range `for`, a local type or function, a name from a C
//                  header (`c::printf`, until front::cimport lands, #1124), a function that falls off its end is not
//                  yet reported.
//
// No recursion: the statement walk has a work stack of frames (a statement and what to do with it); no malloc: the
// stack and the copies are the current allocator's (std::mem).
module front::types_decl;

import front::ast;
import front::types;
import front::types_attr;
import front::types_builtin;
import front::types_convert;
import front::types_expr;
import front::types_fn;
import front::types_iter;
import front::types_stream;
import front::lint;
import front::types_undefined;
import front::affine;
import front::parse as syntax;
import front::when;
import std::arena;
import std::format;
import std::mem;

// ---------------------------------------------------------------------------------------------------------------
// State of one check (reset by check_module)

// What a frame of the work stack means for its statement or expression.
// NOLINTBEGIN(readability-identifier-naming)
enum Step {
    enter,       // read the statement
    leave,       // leave the scope entered for a block or a `for`
    condition,   // the expression must be a Bool
    advance,     // the expression is a statement of its own (a `for`'s step)
    arm,         // a `match` arm `index` starts: its patterns, and a scope with what it binds (#2336)
    cover,       // after a `match`'s arms: every case is named once
    tail_arm,    // the expression is the function's result: an arm of a `match` that is the last line
    open_true,   // the condition `expr` is true: a scope in which the names it proves are not `.none` are narrowed
                 // (#2481)
    open_false,  // the condition `expr` is false: the same for the `else` branch
    narrow_rest, // the condition `expr` is false from here to the end of the scope: after an `if` that always leaves
};
// NOLINTEND(readability-identifier-naming)

struct Frame {
    const ast::Stmt *stmt;
    const ast::Expr *expr;
    Step step;
    Usize index;
    U32 end; // a statement of a block: where the block ends (#2503)
};

// A local that a body declared, for the golden tests.
struct Local {
    Str function;
    Str name;
    types::TypeRef type;
};

// A lambda body to check once the walk that met the lambda is done: the lambda, its type and the scopes it sees.
struct Pending {
    const ast::Expr *lambda;
    types::TypeRef type;
    types::Scopes scopes;
    Str function;
};

struct StmtRef {
    const ast::Stmt *stmt;
};

struct State {
    Frame work[:];
    Usize top;
    U32 block_end; // where the block of the statement being entered ends, 0 when it is in none: the reach of a
                   // binding the statement makes (#2503)
    Local locals[:];
    Usize local_count;
    Pending pending[:];
    Usize pending_count;
    Str function;
    types::TypeRef result;      // what `return` is checked against
    types::TypeRef generator;   // the element `T` when the function is a generator (types_stream), else null
    StmtRef tails[:];           // the statements whose value is the function's result (the last line, through
    Usize tail_count;           // blocks and both arms of an if), so a call there is not unused
    const ast::Decl *declaring; // the local whose initializer is being checked, for the fix on its written type
    const ast::Decl *last_decl; // the local the statement entered last declared, null when it declared none
    const ast::Decl *prev_decl; // the local declared by the statement before the one being entered (#2506)
};

constexpr Usize max_tails = 32;

// A state with nothing in it; the pointers are named, as a construction leaves none out.
static State empty_state() {
    return (State){
        .result = nullptr, .generator = nullptr, .declaring = nullptr, .last_decl = nullptr, .prev_decl = nullptr};
}

static State state = {
    .result = nullptr, .generator = nullptr, .declaring = nullptr, .last_decl = nullptr, .prev_decl = nullptr};
static Str fixed_source = ""; // the text being fixed, for the fixes that copy a part of it; empty when none (#2503)

static Str msg(char chars[:]) {
    return chars;
}

// ---------------------------------------------------------------------------------------------------------------
// The conversion hook (J1c into J1b)

// `1U << 22`, `64 * 1024` and `4096 + 8` are constants too: two integer literals joined by `<<`, `*`, `+` or `|`
// whose value fits 64 bits, so `test.memory(1U << 22)` passes a `usize` (the count's `expected Usize, found U32`).
// The value of an integer literal, or 0 for any other expression.
static U64 integer_value(const ast::Expr *e) {
    if (e->kind != .integer) return 0;
    return e->kind.integer.value;
}

static types_convert::Literal folded_literal(const ast::Expr *e) {
    if (e->kind != .binary) return types_convert::no_literal();
    const ast::Expr *left = e->kind.binary.left;
    const ast::Expr *right = e->kind.binary.right;
    if (left->kind != .integer) return types_convert::no_literal();
    if (right->kind != .integer) return types_convert::no_literal();
    U64 a = integer_value(left);
    U64 b = integer_value(right);
    ast::BinaryOp op = e->kind.binary.op;
    if (op == .shift_left && b < 63 && a < ((U64)1 << (63 - b))) return types_convert::constant_unsigned(a << b);
    if (op == .multiply && a < (U64)0x80000000 && b < (U64)0x80000000) return types_convert::constant_unsigned(a * b);
    if (op == .add && a < (U64)0x7fffffffffffffff && b < (U64)0x7fffffffffffffff)
        return types_convert::constant_unsigned(a + b);
    if (op == .bit_or) return types_convert::constant_unsigned(a | b);
    return types_convert::no_literal();
}

// The constant that `e` is, when it is an integer or floating literal (possibly negated).
static types_convert::Literal literal_of(const ast::Expr *e) {
    if (e->kind == .integer) {
        return types_convert::constant_unsigned(e->kind.integer.value);
    }
    if (e->kind == .unary) {
        const ast::Expr *operand = e->kind.unary.operand;
        if (e->kind.unary.op == .negate) {
            if (operand->kind == .integer) {
                return (types_convert::Literal){
                    .is_constant = true, .negative = true, .magnitude = operand->kind.integer.value};
            }
            if (operand->kind == .floating) {
                return types_convert::constant_float(-operand->kind.floating.value);
            }
        }
    }
    if (e->kind == .floating) {
        return types_convert::constant_float(e->kind.floating.value);
    }
    if (e->kind == .binary) return folded_literal(e);
    return types_convert::no_literal();
}

// What a written pointer type points at, or null when it is not a pointer.
static const ast::TypeExpr *pointee_written(const ast::TypeExpr *t) {
    if (t == nullptr) return nullptr;
    if (t->kind != .pointer) return nullptr;
    return t->kind.pointer.pointee;
}

// Whether a written type is a pointer that is not `*mut`.
static Bool is_plain_pointer(const ast::TypeExpr *t) {
    if (t->kind != .pointer) return false;
    return !t->kind.pointer.is_mut;
}

// The element of a written array type, or null.
static const ast::TypeExpr *array_element_written(const ast::TypeExpr *t) {
    if (t->kind != .array) return nullptr;
    return t->kind.array.element;
}

// The array `xs` of `&xs[i]`, or null for any other expression.
static const ast::Expr *address_of_element_base(const ast::Expr *e) {
    if (e->kind != .unary) return nullptr;
    if (e->kind.unary.op != .address_of) return nullptr;
    const ast::Expr *operand = e->kind.unary.operand;
    if (operand->kind != .index) return nullptr;
    return operand->kind.index.base;
}

// The operand of `&x`, or null for any other expression.
static const ast::Expr *address_operand(const ast::Expr *e) {
    if (e->kind != .unary) return nullptr;
    if (e->kind.unary.op != .address_of) return nullptr;
    return e->kind.unary.operand;
}

// The written type of the local `declaring` declares when `e` is its initializer and the type is a pointer, else null.
static const ast::TypeExpr *declared_pointer_type(const ast::Decl *declaring, const ast::Expr *e) {
    if (declaring == nullptr) return nullptr;
    if (declaring->kind != .variable) return nullptr;
    if (declaring->kind.variable.init != e) return nullptr;
    const ast::TypeExpr *written = declaring->kind.variable.type;
    if (written == nullptr) return nullptr;
    if (written->kind != .pointer) return nullptr;
    return written;
}

// `p + n` and `p - n` point where `p` points, and `buffer[filled:]` is as writable as `buffer`: the place a fix for a
// pointer expression is made for.
static const ast::Expr *pointer_source(const ast::Expr *e) {
    const ast::Expr *source = e;
    for (Usize steps = 0; steps < 64; steps++) {
        const ast::Expr *at = source; // not reassigned, so that the fixer can bind its payloads
        if (at->kind != .binary) break;
        ast::BinaryOp op = at->kind.binary.op;
        if (op != .add && op != .subtract) break;
        source = at->kind.binary.left;
    }
    const ast::Expr *last = source;
    if (last->kind == .slice_of) return last->kind.slice_of.base;
    return last;
}

// The edit for a local written `*mut *T` and initialized with a `*mut *mut T`: the inner pointer becomes `*mut T`,
// since what the initializer points at is writable (std.mem's `buckets` from `table(...)`, #2427).
static syntax::Edits inner_mut_fix(const ast::Expr *e, types::TypeRef from, types::TypeRef to) {
    syntax::Edits edits = {};
    const ast::Decl *d = state.declaring;
    if (d == nullptr) return edits;
    if (d->kind != .variable) return edits;
    if (d->kind.variable.init != e) return edits;
    if (types::element_of(from)->kind != .pointer || types::element_of(to)->kind != .pointer) return edits;
    if (types::element_of(types::element_of(from)) != types::element_of(types::element_of(to))) return edits;
    if (types::points_to_const(types::element_of(from)) || !types::points_to_const(types::element_of(to))) return edits;
    const ast::TypeExpr *inner = pointee_written(d->kind.variable.type);
    if (inner == nullptr || !is_plain_pointer(inner)) return edits;
    edits = mem::realloc(edits, 1);
    U32 after_star = inner->span.start + 1;
    Str word = "mut ";
    edits[0] = (syntax::Edit){.span = {.start = after_star, .end = after_star}, .text = word};
    return edits;
}

// The edit for `&xs[0]` handed where `*(*mut T)` is wanted, with `xs` declared `[n]*T`: the element becomes `*mut T`
// (`execv`'s `argv`, #2611). Empty when `e` is not that shape.
static syntax::Edits element_mut_fix(const types::Checked *c, const ast::Expr *e, types::TypeRef from,
                                     types::TypeRef to) {
    syntax::Edits edits = {};
    if (from->kind != .pointer || to->kind != .pointer || types::element_of(from)->kind != .pointer ||
        types::element_of(to)->kind != .pointer || !types::points_to_const(types::element_of(from)) ||
        types::points_to_const(types::element_of(to)))
        return edits;
    const ast::Expr *array = address_of_element_base(e);
    if (array == nullptr) return edits;
    if (array->kind != .name) return edits;
    const types::Symbol *s = types::lookup_path(&c->scopes, array->kind.name.path);
    if (s == nullptr || s->kind != .variable || !s->is_new || s->written == nullptr) return edits;
    const ast::TypeExpr *element = array_element_written(s->written);
    if (element == nullptr || !is_plain_pointer(element)) return edits;
    edits = mem::realloc(edits, 1);
    U32 after_star = element->span.start + 1;
    Str word = "mut ";
    edits[0] = (syntax::Edit){.span = {.start = after_star, .end = after_star}, .text = word};
    return edits;
}

static const ast::Expr *member_base(const ast::Expr *e);
static const ast::Expr *additive_left(const ast::Expr *e);

static syntax::Edits nonzero_fix(const ast::Expr *e);

static Bool convert_hook(types::Checked *c, const ast::Expr *e, types::TypeRef from, types::TypeRef to) {
    types_convert::Verdict verdict = types_convert::convert(&c->table, from, to, literal_of(e));
    if (verdict.ok) {
        return true;
    }
    // A `*T` argument where a `*mut T` is wanted: the fix writes `*mut T` on the parameter or local it comes from.
    Bool drops_const =
        from->kind == .pointer && to->kind == .pointer && types::points_to_const(from) && !types::points_to_const(to);
    drops_const = drops_const || (from->kind == .slice && to->kind == .slice && types::points_to_const(from) &&
                                  !types::points_to_const(to));
    // `p + n` and `p - n` point where `p` points: the fix is the one for `p` (`arena.memory + used`).
    const ast::Expr *source = pointer_source(e);
    syntax::Edits fix = mem::alloc_slice(syntax::Edit, 0);
    if (drops_const) fix = types_expr::pointer_fix(c, source);
    // `&bottom` handed where `const void **` is wanted: the local is `mut`, and its `*void` stays (#2643).
    const ast::Expr *addressed = address_operand(source);
    if (drops_const && addressed != nullptr && to->kind == .pointer && types::element_of(to)->kind == .pointer &&
        types::points_to_const(types::element_of(to)))
        fix = types_expr::address_binding_fix(c, addressed);
    // `&p.f` handed where a `*mut` is wanted is as writable as `p`: the fix is the one for `p` (`&simulation.waiting`).
    if (drops_const && countof(fix) == 0 && addressed != nullptr) {
        const ast::Expr *place = addressed;
        while (member_base(place) != nullptr) {
            const ast::Expr *base = member_base(place);
            types::TypeRef owner = types::type_of(c, base);
            if (owner != nullptr && owner->kind == .pointer) {
                fix = types_expr::pointer_fix(c, base);
                break;
            }
            place = base;
        }
    }
    if (from->kind == .pointer && to->kind == .pointer && !types::points_to_const(from) && !types::points_to_const(to))
        fix = inner_mut_fix(e, from, to);
    if (countof(fix) == 0) fix = element_mut_fix(c, e, from, to);
    // `&rest` where `*(*mut T)` is wanted (`strtol`'s end pointer): the local `rest: *T` becomes `*mut T`.
    if (countof(fix) == 0 && from->kind == .pointer && to->kind == .pointer &&
        types::element_of(from)->kind == .pointer && types::element_of(to)->kind == .pointer &&
        types::points_to_const(types::element_of(from)) && !types::points_to_const(types::element_of(to)) &&
        address_operand(e) != nullptr)
        fix = types_expr::pointer_name_fix(c, address_operand(e));
    if (from->kind == .array && to->kind == .pointer &&
        (types::element_of(from) == types::element_of(to) || types::element_of(to)->kind == .void_type ||
         (types::element_of(from)->kind == .pointer && types::element_of(to)->kind == .pointer))) // `execv(path, argv)`
        fix = types_builtin::element_address_fix(e);
    // An integer that needs `.to(T)` (a different width, a sign change, a narrowing): the message's own fix (#2506).
    if (from->kind == .integer && to->kind == .integer && countof(fix) == 0) fix = types_expr::convert_fix(e, to);
    // `nullptr` where a `?T` is wanted is `.none`; a read `a.f` of an option field that a test guards is its binding
    // `f` (#2557).
    if (from->kind == .null_type && to->kind == .option && e->kind == .null_pointer) {
        Str none = ".none";
        fix = mem::realloc(fix, 1);
        fix[0] = (syntax::Edit){.span = e->span, .text = none};
    }
    if (from->kind == .option && to->kind != .option && countof(fix) == 0) fix = types_expr::option_read_fix(c, e);
    // `p: *char = a.f` of an option: the local holds the option, `p: ?*char = a.f`.
    const ast::Decl *declaring = state.declaring;
    const ast::TypeExpr *declared = declared_pointer_type(declaring, e);
    if (from->kind == .option && to->kind == .pointer && countof(fix) == 0 && declared != nullptr) {
        fix = mem::realloc(fix, 1);
        U32 at = declared->span.start;
        Str question = "?";
        fix[0] = (syntax::Edit){.span = {.start = at, .end = at}, .text = question};
    }
    // A number where a Bool is wanted: the fix writes the comparison the message names, `x != 0`; an operand that is
    // not a postfix expression goes in parentheses first, `(a + b) != 0`.
    if (from->kind == .integer && to->kind == .bool_type && countof(fix) == 0) fix = nonzero_fix(e);
    types::fail_fix(c, e->span, verdict.message, fix);
    return false;
}

// `x` where a Bool is wanted and `x` is an integer: ` != 0` after it, with parentheses around an operand that is not a
// name, member, call, index or literal.
static syntax::Edits nonzero_fix(const ast::Expr *e) {
    Bool postfix =
        e->kind == .name || e->kind == .member || e->kind == .call || e->kind == .index || e->kind == .integer;
    Str test = postfix ? " != 0" : ") != 0";
    Str open = "(";
    syntax::Edits edits = mem::alloc_slice(syntax::Edit, 0);
    edits = mem::realloc(edits, postfix ? 1 : 2);
    edits[0] = (syntax::Edit){.span = {.start = e->span.end, .end = e->span.end}, .text = test};
    if (!postfix) edits[1] = (syntax::Edit){.span = {.start = e->span.start, .end = e->span.start}, .text = open};
    return edits;
}

// `(Void)x` written as a statement discards a value; smith writes that `_ := x`. The fix replaces the cast's head,
// from the cast to its operand, with `_ := `. Empty for any other cast.
static syntax::Edits discard_fix(const ast::Expr *e, types::TypeRef to) {
    syntax::Edits edits = {};
    if (e->kind != .cast || to->kind != .void_type) {
        return edits;
    }
    Str word = "_ := ";
    ast::Span head = {.start = e->span.start, .end = e->kind.cast.operand->span.start};
    ast::Span tail = {.start = e->kind.cast.operand->span.end, .end = e->span.end};
    // `x.to(void)` has its cast after the operand: the tail goes too, or each pass writes another `_ := ` (#2224).
    Usize count = tail.end > tail.start ? 2 : 1;
    edits = mem::realloc(edits, count);
    edits[0] = (syntax::Edit){.span = head, .text = word};
    Str nothing = "";
    if (count == 2) edits[1] = (syntax::Edit){.span = tail, .text = nothing};
    return edits;
}

// Whether the cast `e` may be written; a cast that can lose a value is marked for a run-time check (K1, #1328).
static Bool cast_hook(types::Checked *c, const ast::Expr *e, types::TypeRef from, types::TypeRef to) {
    types_convert::Literal lit = types_convert::no_literal();
    if (e->kind == .cast) {
        lit = literal_of(e->kind.cast.operand);
    }
    ast::CastForm form = .convert;
    if (e->kind == .cast) form = e->kind.cast.form;
    if (form == .wrapping && !(from->kind == .integer && to->kind == .integer)) {
        types::fail(c, e->span, "`wrap` keeps the low bits of an integer: it converts an integer to an integer");
        return false;
    }
    if (form == .reinterpret && to->kind != .pointer) {
        types::fail(c, e->span,
                    "`cast` reinterprets a pointer, or an integer of pointer size, as another pointer type");
        return false;
    }
    // `x.wrap(T)` keeps the low bits of any integer, a constant too: `(-1).wrap(usize)` is the largest usize (#2474).
    if (form == .wrapping) return true;
    types_convert::Verdict verdict = types_convert::cast_ok(&c->table, from, to, lit);
    if (!verdict.ok) {
        // A `p.cast(*mut T)` of a `*T` drops const: the fix writes `*mut T` on the parameter or local `p` comes from
        // (std.mem's `self: *Allocator` cast to `*mut Checked`, #2427).
        syntax::Edits fix = discard_fix(e, to);
        if (e->kind == .cast && from->kind == .pointer && to->kind == .pointer && types::points_to_const(from) &&
            !types::points_to_const(to)) {
            // `(base + n).cast(*mut T)` points where `base` does: the fix is the one for `base` (#2643).
            const ast::Expr *source = e->kind.cast.operand;
            while (additive_left(source) != nullptr)
                source = additive_left(source);
            fix = types_expr::pointer_fix(c, source);
        }
        // `task_main.to(usize)`: a function is an address, so it is a pointer first, `task_main.cast(*void).to(usize)`
        // (#2643).
        if (e->kind == .cast && from->kind == .function && to->kind == .integer) {
            Str pointer = ".cast(*void)";
            fix = mem::realloc(fix, 1);
            fix[0] =
                (syntax::Edit){.span = {.start = e->kind.cast.operand->span.end, .end = e->kind.cast.operand->span.end},
                               .text = pointer};
        }
        types::fail_fix(c, e->span, verdict.message, fix);
        return false;
    }
    if (verdict.checked && form != .wrapping) {
        types::mark_cast_checked(c, e, from);
    }
    return true;
}

// ---------------------------------------------------------------------------------------------------------------
// The work stack

static void push(const ast::Stmt *stmt, const ast::Expr *expr, Step step) {
    if (state.top == countof(state.work)) {
        Usize capacity = countof(state.work) * 2;
        if (capacity < 32) {
            capacity = 32;
        }
        state.work = mem::realloc(state.work, capacity);
    }
    state.work[state.top] = (Frame){.stmt = stmt, .expr = expr, .step = step};
    state.top += 1;
}

static void note_local(Str name, types::TypeRef type) {
    if (state.local_count == countof(state.locals)) {
        Usize capacity = countof(state.locals) * 2;
        if (capacity < 16) {
            capacity = 16;
        }
        state.locals = mem::realloc(state.locals, capacity);
    }
    state.locals[state.local_count] = (Local){.function = state.function, .name = name, .type = type};
    state.local_count += 1;
}

// ---------------------------------------------------------------------------------------------------------------
// Locals

static Bool is_auto(types::TypeRef t) {
    return t->kind == .automatic;
}

// A local written in smith's own syntax: constant unless it is `mut`.
static const ast::Expr *variable_init(const ast::Decl *d) {
    if (d->kind != .variable) return nullptr;
    return d->kind.variable.init;
}

static Str variable_name(const ast::Decl *d) {
    if (d->kind != .variable) return "";
    return d->kind.variable.name;
}

// Whether `d` is a variable written `mut`.
static Bool variable_is_mut(const ast::Decl *d) {
    if (d->kind != .variable) return false;
    return d->kind.variable.is_mut;
}

// The `then` of an `if`; null for any other statement.
static const ast::Stmt *then_of(const ast::Stmt *s) {
    if (s->kind != .if_stmt) return nullptr;
    return s->kind.if_stmt.then_branch;
}

// The value of a `return`, null for `return;` and for any other statement.
static const ast::Expr *returned_value(const ast::Stmt *s) {
    if (s->kind != .return_stmt) return nullptr;
    return s->kind.return_stmt.value;
}

static Bool error_item(const ast::Initializer *item);

// The value `.error = x` or `.error(x)` carries in a returned expression, else null.
static const ast::Expr *passed_error(const ast::Expr *value) {
    if (value->kind == .compound) {
        if (countof(value->kind.compound.items) != 1) return nullptr;
        if (!error_item(&value->kind.compound.items[0])) return nullptr;
        return value->kind.compound.items[0].value;
    }
    if (value->kind != .variant) return nullptr;
    if (!types::same_text(value->kind.variant.name, "error")) return nullptr;
    return value->kind.variant.payload;
}

static Bool is_new_variable(const ast::Decl *d) {
    if (d->kind != .variable) return false;
    return d->kind.variable.is_new;
}

// The statements of a block; none for any other statement.
static Usize block_size(const ast::Stmt *s) {
    if (s->kind != .block) return 0;
    return countof(s->kind.block.items);
}

static const ast::Stmt *block_item(const ast::Stmt *s, Usize k) {
    if (s->kind != .block) return nullptr;
    return s->kind.block.items[k];
}

// The parts of a binary or unary expression; null for any other.
static const ast::Expr *binary_left(const ast::Expr *e) {
    if (e->kind != .binary) return nullptr;
    return e->kind.binary.left;
}

static const ast::Expr *binary_right(const ast::Expr *e) {
    if (e->kind != .binary) return nullptr;
    return e->kind.binary.right;
}

static Bool binary_and(const ast::Expr *e) {
    if (e->kind != .binary) return false;
    return e->kind.binary.op == .logical_and;
}

static Bool binary_or(const ast::Expr *e) {
    if (e->kind != .binary) return false;
    return e->kind.binary.op == .logical_or;
}

// Whether `e` is `a == b` (`a != b` when not `equal`).
static Bool binary_compares(const ast::Expr *e, Bool equal) {
    if (e->kind != .binary) return false;
    if (equal) return e->kind.binary.op == .equal;
    return e->kind.binary.op == .not_equal;
}

// Whether `e` is `a.f` with `.` (not `->`).
// The statement a `stmt_expr` holds; null for any other expression.
static const ast::Stmt *inner_statement(const ast::Expr *e) {
    if (e->kind != .stmt_expr) return nullptr;
    return e->kind.stmt_expr.stmt;
}

// The left of `a + b` and `a - b`; null for any other expression.
static const ast::Expr *additive_left(const ast::Expr *e) {
    if (e->kind != .binary) return nullptr;
    if (e->kind.binary.op != .add && e->kind.binary.op != .subtract) return nullptr;
    return e->kind.binary.left;
}

static Bool dot_member(const ast::Expr *e) {
    if (e->kind != .member) return false;
    return !e->kind.member.arrow;
}

static Str member_name(const ast::Expr *e) {
    if (e->kind != .member) return "";
    return e->kind.member.name;
}

static const ast::Expr *member_base(const ast::Expr *e) {
    if (e->kind != .member) return nullptr;
    return e->kind.member.base;
}

static const ast::Expr *unary_operand(const ast::Expr *e) {
    if (e->kind != .unary) return nullptr;
    return e->kind.unary.operand;
}

static Bool unary_not(const ast::Expr *e) {
    if (e->kind != .unary) return false;
    return e->kind.unary.op == .logical_not;
}

// The name of a variant (`.error`); empty for any other expression.
static Str variant_name(const ast::Expr *e) {
    if (e->kind != .variant) return "";
    return e->kind.variant.name;
}

// Whether `e` is a variant with no payload (`.none`).
static Bool bare_variant(const ast::Expr *e) {
    if (e->kind != .variant) return false;
    return e->kind.variant.payload == nullptr;
}

static Bool is_discard(Str name) {
    return countof(name) == 1 && name[0] == '_';
}

// Shadowing is an error in smith's own syntax (spec "Modules and declarations"): a name that hides a variable of an
// enclosing scope. Returns whether `name` shadows one. `_` never does. A binding in today's syntax may shadow.
static Bool shadows(types::Checked *r, const ast::Decl *d, Str name) {
    if (!is_new_variable(d) || is_discard(name)) {
        return false;
    }
    const types::Symbol *earlier = types::lookup_own(&r->scopes, name);
    if (earlier != nullptr && earlier->kind == .module_name) {
        types::failf(r, d->span, "`", name, "` hides the module `", name,
                     "`; shadowing is an error: assign with `=`, or choose another name");
        return true;
    }
    if (earlier == nullptr || earlier->kind != .variable) {
        return false;
    }
    const ast::Decl *there = earlier->decl;
    if (there != nullptr) {
        types::failf(r, d->span, "`", name, "` hides the `", name, "` declared at byte ", there->span.start,
                     "; shadowing is an error: assign with `=`, or choose another name");
    } else {
        types::failf(r, d->span, "`", name, "` hides a parameter or an outer `", name,
                     "`; shadowing is an error: assign with `=`, or choose another name");
    }
    return true;
}

static void declare_local(types::Checked *r, const ast::Decl *d, Str name, types::TypeRef type, Bool is_const) {
    if (is_new_variable(d)) {
        r->new_body = true;
    }
    if (is_discard(name) && is_new_variable(d)) {
        return; // `_ := f()` discards the value: nothing is declared
    }
    if (shadows(r, d, name)) {
        return;
    }
    types::Symbol symbol = {
        .name = name, .kind = .variable, .type = type, .decl = d, .is_const = is_const, .is_new = is_new_variable(d)};
    if (d->kind == .variable && d->kind.variable.is_new) {
        symbol.at = d->span;
        symbol.at.start = d->kind.variable.name_at; // a fix writes `mut ` before the name
        symbol.may_mut = countof(d->attributes) == 0 && !d->kind.variable.is_constexpr;
        symbol.written = d->kind.variable.type;
        symbol.init = d->kind.variable.init;
    }
    if (!types::declare(&r->scopes, symbol)) {
        types::failf(r, d->span, "`", name, "` is already declared in this scope; choose another name");
        return;
    }
    note_local(name, type);
}

// The type an `Auto` local takes from its initializer.
static types::TypeRef auto_type(types::Checked *r, const ast::Decl *d, Str name, const ast::Expr *init) {
    if (init == nullptr) {
        types::failf(r, d->span, "`Auto ", name, "` has no value to take its type from; write `Auto ", name,
                     " = value;` or write the type");
        return r->table.invalid;
    }
    types::TypeRef found = types_expr::infer(r, init);
    if (found->kind == .null_type) {
        types::failf(r, init->span, "`nullptr` has no type of its own; write the pointer type, such as `U8 *", name,
                     " = nullptr;`");
        return r->table.invalid;
    }
    return found;
}

// Pushes the operands of `e` that decide whether it is a constant, onto `stack` (a work stack, no recursion).
static Usize constant_operands(const ast::Expr *e, const ast::Expr *stack[:], Usize top) {
    if (e->kind == .unary) {
        stack[top] = e->kind.unary.operand;
        return top + 1;
    }
    if (e->kind == .binary) {
        stack[top] = e->kind.binary.left;
        stack[top + 1] = e->kind.binary.right;
        return top + 2;
    }
    if (e->kind == .conditional) {
        stack[top] = e->kind.conditional.condition;
        stack[top + 1] = e->kind.conditional.then_value;
        stack[top + 2] = e->kind.conditional.else_value;
        return top + 3;
    }
    if (e->kind == .cast) {
        stack[top] = e->kind.cast.operand;
        return top + 1;
    }
    return top;
}

// The first part of `init` that cannot be known at compile time: a name of a variable that is not constant, or an
// assignment. A call is not judged here (its callee may be a constexpr function). Null when there is none.
static const ast::Expr *not_constant(types::Checked *r, const ast::Expr *init) {
    const ast::Expr *stack[64] = {};
    Usize top = 1;
    stack[0] = init;
    while (top > 0) {
        top -= 1;
        const ast::Expr *e = stack[top];
        if (e == nullptr) {
            continue;
        }
        if (e->kind == .assign || e->kind == .stmt_expr) {
            return e;
        }
        if (e->kind == .name) {
            const types::Symbol *s = types::lookup_path(&r->scopes, e->kind.name.path);
            if (s != nullptr && s->kind == .variable && !s->is_const) {
                return e;
            }
        }
        if (top + 3 > countof(stack)) {
            return nullptr;
        }
        top = constant_operands(e, stack, top);
    }
    return nullptr;
}

// A `const` (or `constexpr`) binding is known at compile time: reports the part of `init` that is not.
static void require_constant(types::Checked *r, Str name, const ast::Expr *init) {
    if (init == nullptr || types_expr::is_undefined(init)) {
        return;
    }
    const ast::Expr *bad = not_constant(r, init);
    if (bad != nullptr) {
        types::failf(r, bad->span, "`const ", name,
                     "` is known at compile time, but this is not; use a constant here, or write `", name,
                     " := ...` without `const`");
    }
}

static void local_variable(types::Checked *r, const ast::Decl *d) {
    if (d->kind != .variable) {
        return;
    }
    Str name = d->kind.variable.name;
    const ast::TypeExpr *written = d->kind.variable.type;
    const ast::Expr *init = d->kind.variable.init;
    Bool is_constexpr = d->kind.variable.is_constexpr;
    Bool is_new = d->kind.variable.is_new;
    Bool is_mut = d->kind.variable.is_mut;
    // the initializer is already smith's own syntax: a lambda in `let _ = f(fn(a: i32) -> bool: ...)` writes `bool`
    if (is_new) {
        r->new_body = true;
    }
    types::TypeRef type = r->table.automatic;
    if (written->kind != .auto_type) {
        r->new_syntax = is_new; // a local's `*T` is read-only in smith's own syntax (#1899), as a parameter's is
        type = types::resolve(r, written);
        r->new_syntax = false;
    }
    if (init == nullptr) {
        types::failf(r, d->span, "`", name, "` needs a value: give one, or write `= undefined`");
        type = r->table.invalid;
    } else if (types_expr::is_undefined(init) && types::lookup(&r->scopes, "undefined") == nullptr) {
        if (is_auto(type)) {
            types::failf(r, init->span, "`mut ", name, " := undefined` has no type to take; write the type, e.g. `mut ",
                         name, ": i32 = undefined`");
            type = r->table.invalid;
        }
    } else if (is_auto(type)) {
        type = auto_type(r, d, name, init);
    } else if (init != nullptr) {
        state.declaring = d;
        (void)types_expr::check(r, init, type);
        state.declaring = nullptr;
    }
    if (is_constexpr) {
        require_constant(r, name, init);
    }
    Bool is_const = written->qualifiers.is_const || is_constexpr;
    if (is_new) {
        is_const = !is_mut || is_constexpr;
    }
    declare_local(r, d, name, type, is_const);
    state.last_decl = d;
}

static void local_declaration(types::Checked *r, const ast::Decl *d) {
    if (d->kind == .variable) {
        local_variable(r, d);
        return;
    }
    types::failf(r, d->span, "not yet typed: a type or function declared inside a function; declare it at the top ",
                 "of the module");
}

// `let (q, r) = f()` and `let (mut q, mut r) = f()`: one constant (or variable) per element of the tuple the
// initializer returns; `_` discards an element. The count must match the tuple's length.
static void destructure_statement(types::Checked *r, const ast::Stmt *s) {
    if (s->kind != .destructure) {
        return;
    }
    ast::Identifier names[:] = s->kind.destructure.names;
    Bool is_mut = s->kind.destructure.is_mut;
    types::TypeRef found = types_expr::infer(r, s->kind.destructure.init);
    r->new_body = true;
    if (found == r->table.invalid) {
        return;
    }
    if (found->kind != .tuple) {
        types::failf(r, s->span, "`(", countof(names), " names) := ...` splits a tuple, but this is a `",
                     types::show(found), "`; write a single name, or call something that returns a tuple");
        return;
    }
    if (countof(types::slots_of(found).items) != countof(names)) {
        types::failf(r, s->span, "this destructuring has ", countof(names), " names, but the tuple `",
                     types::show(found), "` has ", countof(types::slots_of(found).items),
                     " elements; write one name (or `_`) per element");
        return;
    }
    for (Usize i = 0; i < countof(names); i++) {
        Str name = names[i].text;
        if (is_discard(name)) {
            continue;
        }
        const types::Symbol *earlier = types::lookup_own(&r->scopes, name);
        if (earlier != nullptr && earlier->kind == .variable) {
            types::failf(r, names[i].span, "`", name, "` hides a variable of the same name; shadowing is an error: ",
                         "assign with `=`, or choose another name");
            continue;
        }
        types::TypeRef type = types::slots_of(found).items[i].type;
        types::Symbol symbol = {
            .name = name, .kind = .variable, .type = type, .is_const = !(is_mut || names[i].is_mut), .is_new = true};
        if (!types::declare(&r->scopes, symbol)) {
            types::failf(r, names[i].span, "`", name, "` is already declared in this scope; choose another name");
            continue;
        }
        note_local(name, type);
    }
}

// ---------------------------------------------------------------------------------------------------------------
// return

static void return_statement(types::Checked *r, const ast::Stmt *s) {
    if (s->kind != .return_stmt) {
        return;
    }
    const ast::Expr *value = s->kind.return_stmt.value;
    if (types_stream::check_return(r, s, state.generator)) {
        return;
    }
    types::TypeRef want = state.result;
    if (want == nullptr || is_auto(want)) {
        if (value != nullptr) {
            (void)types_expr::infer(r, value);
        }
        return;
    }
    if (value == nullptr) {
        if (want->kind != .void_type && want != r->table.invalid) {
            Str shown = types::show(want);
            types::failf(r, s->span, "expected `", shown,
                         "`, found `Void`; write `return value;` with a value of type `", shown, "`");
        }
        return;
    }
    if (want->kind == .void_type) {
        types::TypeRef got = types_expr::infer(r, value);
        if (got != nullptr && got->kind == .void_type) { // the last line of a body is its value (#1428): a call of Void
            return;
        }
        types::failf(r, s->span,
                     "this function returns `Void`, so it has no value to return; remove the value after `return`, or "
                     "give the function a result type");
        return;
    }
    (void)types_expr::check(r, value, want);
}

// ---------------------------------------------------------------------------------------------------------------
// The statement walk

static void not_yet(types::Checked *r, const ast::Stmt *s, Str what) {
    types::failf(r, s->span, "not yet typed: ", what);
}

static void block_statement(types::Checked *r, const ast::Stmt *s) {
    if (s->kind != .block) {
        return;
    }
    ast::StmtRef items[:] = s->kind.block.items;
    types::push_scope(&r->scopes);
    push(nullptr, nullptr, leave);
    for (Usize i = countof(items); i > 0; i--) {
        push(items[i - 1], nullptr, enter);
        state.work[state.top - 1].end = s->span.end;
    }
}

// The text that `smith lint --fix` mends, for the fixes that copy a part of it (`front::fix` sets it, #2503).
export void set_source(Str source) {
    fixed_source = source;
}

// Whether the statement always ends by leaving its block: it is a `return`, `break` or `continue`, or a block whose
// last statement is one.
static Bool leaves(const ast::Stmt *s) {
    while (block_size(s) > 0)
        s = block_item(s, block_size(s) - 1);
    return s->kind == .return_stmt || s->kind == .break_stmt || s->kind == .continue_stmt;
}

// A variant test `k == .v` or `k != .v: return` is kept, with the edits that write it as `.v(v) := k` and the reads of
// `k.v` it guards as `v` (#2494). The binding takes the variant's name; a variable of that name in scope, or declared
// later in the function, leaves the site as it is, as does a write through `k.v` or to `k`.
static void add_guard(types::Checked *r, types::Guard guard) {
    if (r->guard_count == countof(r->guards)) {
        Usize capacity = 8;
        if (r->guard_count >= 8) capacity = r->guard_count * 2;
        r->guards = mem::realloc(r->guards, capacity);
    }
    r->guards[r->guard_count] = guard;
    r->guard_count += 1;
}

// `k == .v` (or `k != .v` when not `equal`) with no payload on `.v`: the test, else null.
static const ast::Expr *plain_variant_test(const ast::Expr *test, Bool equal) {
    if (!binary_compares(test, equal)) return nullptr;
    if (!bare_variant(binary_right(test))) return nullptr;
    return test;
}

// The same, and `!(k == .v)` counts as `k != .v` (its inner test is returned).
static const ast::Expr *variant_test(const ast::Expr *test, Bool equal) {
    if (!equal && unary_not(test)) {
        return plain_variant_test(unary_operand(test), true);
    }
    return plain_variant_test(test, equal);
}

static Bool name_taken(types::Checked *r, Str name) {
    const types::Symbol *taken = types::lookup(&r->scopes, name);
    return taken != nullptr && taken->kind == .variable;
}

// The place a test reads the payload through: `p` for `p.*` (the reads are `p.v`, through the pointer), else `k`.
static const ast::Expr *guard_base(const ast::Expr *tested) {
    if (tested->kind == .unary && tested->kind.unary.op == .dereference) {
        return tested->kind.unary.operand;
    }
    return tested;
}

static syntax::Edit edit_of(U32 start, U32 end, Str text) {
    return (syntax::Edit){.span = {.start = start, .end = end}, .text = text};
}

// `if k == .v:` with no `else`: the reads in the `then` are the test's, written `if .v(v) := k:`.
static void note_then_guard(types::Checked *r, const ast::Stmt *s, const ast::Expr *test) {
    if (s->kind != .if_stmt || test->kind != .binary) return;
    const ast::Expr *left = binary_left(test);
    const ast::Expr *right = binary_right(test);
    Str variant = variant_name(right);
    if (countof(variant) == 0 || name_taken(r, variant)) return;
    Str pattern = msg(format::push(".", variant, "(", variant, ") := "));
    syntax::Edits head = {};
    head = mem::realloc(head, 2);
    head[0] = edit_of(left->span.start, left->span.start, pattern);
    head[1] = edit_of(left->span.end, right->span.end, "");
    const ast::Stmt *then_branch = s->kind.if_stmt.then_branch;
    add_guard(
        r,
        (types::Guard){
            .base = guard_base(left), .variant = variant, .reads = then_branch->span, .head = head, .test = nullptr});
}

// `if k == .v && rest: X` and `while k == .v && rest: X` (D12): a variant test that starts an `&&` chain binds the
// payload for the rest of the chain and the body, `if .v(v) := k && rest:`. Only the first conjunct can: the ones
// before a test may be what makes `k` safe to read. The reads in the chain's other conjuncts and in `body` are the
// test's; the `else` is not.
static void note_chain_guard(types::Checked *r, const ast::Expr *test, const ast::Stmt *body) {
    if (!binary_and(test)) return;
    const ast::Expr *first = test;
    while (binary_and(first))
        first = binary_left(first);
    const ast::Expr *tested = plain_variant_test(first, true);
    if (tested == nullptr) return;
    const ast::Expr *left = binary_left(tested);
    const ast::Expr *right = binary_right(tested);
    Str variant = variant_name(right);
    if (countof(variant) == 0 || name_taken(r, variant)) return;
    Str pattern = msg(format::push(".", variant, "(", variant, ") := "));
    syntax::Edits head = {};
    head = mem::realloc(head, 2);
    head[0] = edit_of(left->span.start, left->span.start, pattern);
    head[1] = edit_of(left->span.end, right->span.end, "");
    ast::Span reads = {.start = tested->span.end, .end = body->span.end};
    add_guard(
        r, (types::Guard){.base = guard_base(left), .variant = variant, .reads = reads, .head = head, .test = nullptr});
}

// The operands of a chain `a || b || c`, at most `countof(out)`; 0 when there are more.
static Usize or_operands(const ast::Expr *test, const ast::Expr *out[8]) {
    Usize count = 0;
    const ast::Expr *at = test;
    while (binary_or(at)) {
        if (count == 7) return 0;
        out[count] = binary_right(at);
        count += 1;
        at = binary_left(at);
    }
    out[count] = at;
    count += 1;
    for (Usize i = 0; i < count / 2; i++) { // the right operands were met first
        const ast::Expr *swap = out[i];
        out[i] = out[count - 1 - i];
        out[count - 1 - i] = swap;
    }
    return count;
}

// The spaces that start the line holding `at`.
static Str indent_at(U32 at) {
    Str text = fixed_source;
    Usize line = at;
    while (line > 0 && text[line - 1] != '\n')
        line -= 1;
    Usize end = line;
    while (end < countof(text) && text[end] == ' ')
        end += 1;
    return text[line:end];
}

// Whether the text holds the `if` as smith's own syntax writes it, `if test:`: while it still has C's parentheses and
// braces the statement's span does not start at its `if` (#2503).
static Bool indented_if(ast::Span statement, ast::Span test) {
    Str text = fixed_source;
    if (countof(text) < statement.end || statement.start + 3 > test.start || test.end >= countof(text)) return false;
    return types::same_text(text[statement.start:statement.start + 3], "if ") && text[test.end] == ':';
}

// `if k != .v: return X` (or `break`, `continue`) with no `else`: the reads of `k.v` to the end of the block are the
// test's, written `.v(v) := k else: return X` (#2503). In a chain `if a || k != .v || b: X` the test stands alone
// between `if a: X` and `if b: X`, which copies `X`: that needs the text, so a chain is left when there is none.
static void note_rest_guard(types::Checked *r, const ast::Stmt *s) {
    if (s->kind != .if_stmt) return;
    const ast::Expr *test = s->kind.if_stmt.condition;
    const ast::Stmt *then_branch = s->kind.if_stmt.then_branch;
    const ast::Expr *parts[8] = {};
    Usize count = or_operands(test, parts);
    Usize at = count;
    for (Usize i = 0; i < count; i++) {
        if (at == count && variant_test(parts[i], false) != nullptr) at = i;
    }
    U32 end = state.block_end;
    if (at == count || end == 0 || !indented_if(s->span, test->span)) return;
    const ast::Expr *tested = variant_test(parts[at], false);
    if (tested == nullptr) return;
    const ast::Expr *left = binary_left(tested);
    const ast::Expr *right = binary_right(tested);
    Str variant = variant_name(right);
    if (countof(variant) == 0 || name_taken(r, variant)) return;
    for (Usize i = 0; i < r->guard_count; i++) { // a second test of the same variant is covered by the first
        types::Guard *g = &r->guards[i];
        Bool covered = s->span.start >= g->reads.start && s->span.start < g->reads.end;
        if (covered && types::same_text(g->variant, variant)) return;
    }
    Str pattern = msg(format::push(".", variant, "(", variant, ") := "));
    syntax::Edits head = {};
    if (count == 1) {
        head = mem::realloc(head, 2);
        head[0] = edit_of(s->span.start, left->span.start, pattern);
        head[1] = edit_of(left->span.end, test->span.end, " else");
    } else {
        Str leave = fixed_source[test->span.end:s->span.end];
        Str indent = indent_at(s->span.start);
        Str before = "";
        if (at > 0) {
            Str first = fixed_source[parts[0]->span.start:parts[at - 1]->span.end];
            before = msg(format::push("if ", first, leave, "\n", indent));
        }
        Str bound = fixed_source[left->span.start:left->span.end];
        U32 stop = at + 1 < count ? parts[at + 1]->span.start : parts[at]->span.end;
        Str after = "";
        if (at + 1 < count) after = msg(format::push(leave, "\n", indent, "if "));
        head = mem::realloc(head, 2);
        head[0] = edit_of(s->span.start, parts[at]->span.start, before);
        head[1] = edit_of(parts[at]->span.start, stop, msg(format::push(pattern, bound, " else", after)));
    }
    ast::Span reads = {.start = parts[at]->span.end, .end = end};
    add_guard(r, (types::Guard){.base = guard_base(left),
                                .variant = variant,
                                .reads = reads,
                                .skip = then_branch->span,
                                .head = head,
                                .test = nullptr});
}

// The statement itself when `s` is a block of one statement, through nested blocks.
static const ast::Stmt *only_statement(const ast::Stmt *s) {
    while (block_size(s) == 1) {
        s = block_item(s, 0);
    }
    return s;
}

static Bool word_char(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

// Whether every use of the word `name` in `text` is followed by `.ok`: the uses a `try` leaves meaningful.
static Bool only_ok_reads(Str text, Str name) {
    Usize n = countof(name);
    Str suffix = ".ok";
    for (Usize i = 0; i + n <= countof(text); i++) {
        if (!types::same_text(text[i:i + n], name)) continue;
        if (i > 0 && (word_char(text[i - 1]) || text[i - 1] == '.')) continue;
        if (i + n < countof(text) && word_char(text[i + n])) continue;
        Bool ok = i + n + 3 <= countof(text) && types::same_text(text[i + n:i + n + 3], suffix);
        if (ok && !(i + n + 3 < countof(text) && word_char(text[i + n + 3]))) continue;
        return false;
    }
    return true;
}

// Whether the word `name` is in `text` at all.
static Bool mentions(Str text, Str name) {
    Usize n = countof(name);
    for (Usize i = 0; i + n <= countof(text); i++) {
        if (!types::same_text(text[i:i + n], name)) continue;
        if (i > 0 && (word_char(text[i - 1]) || text[i - 1] == '.')) continue;
        if (i + n < countof(text) && word_char(text[i + n])) continue;
        return true;
    }
    return false;
}

// The edit that deletes the statement and its line.
static syntax::Edit delete_statement(ast::Span span) {
    U32 start = span.start;
    while (start > 0 && fixed_source[start - 1] == ' ')
        start -= 1;
    U32 end = span.end;
    while (end > start && (fixed_source[end - 1] == ' ' || fixed_source[end - 1] == '\n')) // the span may run on
        end -= 1;
    if (end < countof(fixed_source) && fixed_source[end] == '\n') end += 1;
    return edit_of(start, end, "");
}

static Bool contains(Str text, Str needle) {
    Usize n = countof(needle);
    for (Usize i = 0; i + n <= countof(text); i++) {
        if (types::same_text(text[i:i + n], needle)) return true;
    }
    return false;
}

// Whether the item is written `.error = value`.
static Bool error_item(const ast::Initializer *item) {
    if (countof(item->designators) != 1) return false;
    const ast::Designator *d = &item->designators[0];
    if (*d != .field) return false;
    return types::same_text(d->field.name, "error");
}

// `r: Result(T, E) = f()` followed by `if r == .error: return {.error = r.error}` (or `.error(r.error)`) passes the
// error up unchanged: the fix is `ok := try f()`, no guard, and each read `r.ok` is `ok` (#2506). The binding takes the
// variant's name; `ok` in scope, a use of `r` other than `r.ok`, or an error type that differs from the function's
// leaves the site as it is. Returns whether the site is one.
static Bool note_try_guard(types::Checked *r, const ast::Stmt *s, const ast::Expr *test) {
    const ast::Decl *d = state.prev_decl;
    if (d == nullptr || d->span.end > s->span.start || countof(fixed_source) == 0 || d->kind != .variable ||
        s->kind != .if_stmt)
        return false;
    const ast::Expr *init = variable_init(d);
    if (test == nullptr || test->kind != .binary || init == nullptr || variable_is_mut(d) || !is_new_variable(d))
        return false;
    const ast::Expr *left = binary_left(test);
    Str name = variable_name(d);
    const ast::Expr *right = binary_right(test);
    if (!types::same_text(variant_name(right), "error") ||
        !types::same_text(fixed_source[left->span.start:left->span.end], name))
        return false;
    // `if r == .error: cleanup; return {.error = r.error}`: the cleanup, one line, becomes an `errdefer` before the
    // call.
    const ast::Stmt *body = then_of(s);
    const ast::Stmt *cleanup = nullptr;
    if (block_size(body) == 2) {
        cleanup = block_item(body, 0);
        body = block_item(body, 1);
    }
    const ast::Stmt *leave = only_statement(body);
    const ast::Expr *value = returned_value(leave);
    if (value == nullptr) return false;
    // `{.error = r.error}` of C, or `.error(r.error)` once the option and Result fix has mended the braces (#2563)
    const ast::Expr *error_value = passed_error(value);
    if (error_value == nullptr) return false;
    Str passed = fixed_source[error_value->span.start:error_value->span.end];
    if (!types::same_text(passed, msg(format::push(name, ".error")))) return false;
    const types::Symbol *local = types::lookup(&r->scopes, name);
    types::TypeRef want = state.result;
    if (local == nullptr || local->type->kind != .result_type || want == nullptr || want->kind != .result_type ||
        !types::same_text(types::show(types::error_of(local->type)), types::show(types::error_of(want))) ||
        name_taken(r, "ok"))
        return false;
    U32 end = state.block_end;
    if (end == 0 || end < s->span.end || !only_ok_reads(fixed_source[s->span.end:end], name)) return false;
    Str before = "";
    if (cleanup != nullptr) {
        Str line = fixed_source[cleanup->span.start:cleanup->span.end];
        // a later error return would run the `errdefer` too, which the original did not: leave such a site
        Str rest = fixed_source[s->span.end:end];
        if (contains(line, "\n") || contains(line, name) || contains(rest, ".error") || contains(rest, "try "))
            return false;
        before = msg(format::push("errdefer ", line, "\n", indent_at(d->span.start)));
    }
    // A result nothing reads is a bare `try` (#2552): no read carries the edits, so the declaration's own error does.
    Bool unread = !mentions(fixed_source[s->span.end:end], name);
    syntax::Edits head = {};
    head = mem::realloc(head, 2);
    head[0] = edit_of(d->span.start, init->span.start, msg(format::push(before, unread ? "try " : "ok := try ")));
    head[1] = delete_statement(s->span);
    if (unread) {
        types::fail_fix(r, d->span, "a `Result` whose error is passed up unchanged is written `try call(...)`", head);
        return true;
    }
    ast::Span reads = {.start = s->span.end, .end = end};
    Str ok_name = "ok";
    add_guard(
        r, (types::Guard){.base = guard_base(left), .variant = ok_name, .reads = reads, .head = head, .test = nullptr});
    return true;
}

// `a.f != nullptr` or `a.f != .none` (`==` when `equal`), where `a.f` is a field read: the test, else null.
static const ast::Expr *null_test(const ast::Expr *test, Bool equal) {
    if (!binary_compares(test, equal)) return nullptr;
    const ast::Expr *left = binary_left(test);
    const ast::Expr *right = binary_right(test);
    if (!dot_member(left)) return nullptr;
    Bool none = bare_variant(right) && types::same_text(variant_name(right), "none");
    if (!none && right->kind != .null_pointer) return nullptr;
    return test;
}

// The leftmost test of a chain `a && b && c`, when `test` is one, else null.
static const ast::Expr *chain_head(const ast::Expr *test) {
    if (!binary_and(test)) return nullptr;
    const ast::Expr *head = binary_left(test);
    while (binary_and(head))
        head = binary_left(head);
    return head;
}

// Whether only spaces come before `at` on its line.
static Bool starts_line(U32 at) {
    Str text = fixed_source;
    Usize line = at;
    while (line > 0 && text[line - 1] != '\n')
        line -= 1;
    return countof(indent_at(at)) == at - line;
}

// `if a.f != nullptr && rest:` (#2643): a field does not narrow, so the option is read into a local first, `f := a.f`
// on the line before, which the test and its `then` use: `if f != .none && rest:` narrows the name. The reads of
// `a.f` after the first test are `f`.
static Bool note_field_chain_guard(types::Checked *r, const ast::Stmt *s, const ast::Expr *first) {
    if (s->kind != .if_stmt) return false;
    const ast::Expr *left = binary_left(first);
    if (left == nullptr) return false;
    const ast::Expr *test = s->kind.if_stmt.condition;
    const ast::Stmt *then_branch = s->kind.if_stmt.then_branch;
    const ast::Expr *some = null_test(first, false);
    if (some == nullptr || !indented_if(s->span, test->span) || !starts_line(s->span.start)) return false;
    Str field = member_name(left);
    if (countof(field) == 0 || name_taken(r, field)) return false;
    for (Usize i = 0; i < r->guard_count; i++) {
        types::Guard *g = &r->guards[i];
        Bool covered = s->span.start >= g->reads.start && s->span.start < g->reads.end;
        if (covered && g->option && types::same_text(g->variant, field)) return false;
    }
    Str read = fixed_source[left->span.start:left->span.end];
    syntax::Edits head = {};
    head = mem::realloc(head, 2);
    head[0] =
        edit_of(s->span.start, s->span.start, msg(format::push(field, " := ", read, "\n", indent_at(s->span.start))));
    head[1] = edit_of(left->span.start, left->span.end, field);
    types::Guard guard = {.base = member_base(left), .variant = field, .option = true, .test = first};
    guard.reads = (ast::Span){.start = first->span.end, .end = then_branch->span.end};
    guard.head = head;
    add_guard(r, guard);
    return true;
}

// A test of a field that is an option (#2557): `if a.f != nullptr:` guards its `then`, written `if f := a.f:`, and
// `if a.f == nullptr: return X` with no `else` guards the rest of the block, written `f := a.f else: return X`. Each
// read `a.f` the test guards is `f`, the field's own name (#2455: no invented names); a name `f` in scope leaves the
// site as it is. Only while the fixer runs, on the `if` as smith's own syntax writes it. The guard is kept whatever
// the field's type: only a read of an option takes it (`front::types_expr`). Returns whether the test is one.
static Bool note_option_guard(types::Checked *r, const ast::Stmt *s) {
    if (countof(fixed_source) == 0 || s->kind != .if_stmt) return false;
    const ast::Expr *test = s->kind.if_stmt.condition;
    const ast::Stmt *then_branch = s->kind.if_stmt.then_branch;
    const ast::Expr *chain = chain_head(test);
    if (chain != nullptr) return note_field_chain_guard(r, s, chain);
    const ast::Expr *some = null_test(test, false);
    Bool rest = null_test(test, true) != nullptr && s->kind.if_stmt.else_branch == nullptr && leaves(then_branch) &&
                state.block_end != 0;
    if ((some == nullptr && !rest) || !indented_if(s->span, test->span) || test->kind != .binary) return false;
    const ast::Expr *left = binary_left(test);
    Str field = member_name(left);
    if (countof(field) == 0 || name_taken(r, field)) return false;
    for (Usize i = 0; i < r->guard_count; i++) { // a second test of the same field is covered by the first
        types::Guard *g = &r->guards[i];
        Bool covered = s->span.start >= g->reads.start && s->span.start < g->reads.end;
        if (covered && g->option && types::same_text(g->variant, field)) return false;
    }
    Str pattern = msg(format::push(field, " := "));
    syntax::Edits head = {};
    head = mem::realloc(head, 2);
    types::Guard guard = {.base = member_base(left), .variant = field, .option = true, .test = test};
    if (some != nullptr) {
        head[0] = edit_of(left->span.start, left->span.start, pattern);
        head[1] = edit_of(left->span.end, test->span.end, "");
        guard.reads = then_branch->span;
    } else {
        head[0] = edit_of(s->span.start, left->span.start, pattern);
        head[1] = edit_of(left->span.end, test->span.end, " else");
        guard.reads = (ast::Span){.start = test->span.end, .end = state.block_end};
        guard.skip = then_branch->span;
    }
    guard.head = head;
    add_guard(r, guard);
    return true;
}

// `if k == .v:` guards its `then` whether or not an `else` follows (an `else if` chain of tests is one guard each);
// `if k != .v: return` guards the rest of the block only with no `else`.
static void note_guard(types::Checked *r, const ast::Stmt *s) {
    if (note_option_guard(r, s)) {
        return;
    }
    if (s->kind == .while_stmt) {
        note_chain_guard(r, s->kind.while_stmt.condition, s->kind.while_stmt.body);
        return;
    }
    if (s->kind != .if_stmt) {
        return;
    }
    const ast::Expr *test = s->kind.if_stmt.condition;
    const ast::Expr *equal = variant_test(test, true);
    if (equal != nullptr) {
        if (s->kind.if_stmt.else_branch != nullptr || !note_try_guard(r, s, equal)) note_then_guard(r, s, equal);
    } else if (test->kind == .binary && test->kind.binary.op == .logical_and) {
        note_chain_guard(r, test, s->kind.if_stmt.then_branch);
    } else if (s->kind.if_stmt.else_branch == nullptr && leaves(s->kind.if_stmt.then_branch)) {
        note_rest_guard(r, s);
    }
}

// An arm `.v: value` of a `match k:` reads the payload as `k.v`: the fix is `.v(v): value` and `v` for each read.
static void note_arm_guards(types::Checked *r, const ast::Stmt *s) {
    if (s->kind != .match_stmt) {
        return;
    }
    const ast::Expr *scrutinee = s->kind.match_stmt.value;
    ast::MatchArm arms[:] = s->kind.match_stmt.arms;
    for (Usize i = 0; i < countof(arms); i++) {
        ast::Pattern pats[:] = arms[i].patterns;
        if (countof(pats) != 1 || arms[i].value == nullptr || pats[0].wildcard || pats[0].constant != nullptr) {
            continue;
        }
        Str name = pats[0].name;
        Str bound = pats[0].binding;
        if (countof(bound) > 0 || countof(name) == 0) {
            continue;
        }
        const types::Symbol *taken = types::lookup(&r->scopes, name);
        if (taken != nullptr && taken->kind == .variable) {
            continue;
        }
        char built[:] = format::push("(", name, ")");
        Str binding = built;
        syntax::Edits head = {};
        head = mem::realloc(head, 1);
        head[0] = (syntax::Edit){.span = {.start = pats[0].span.end, .end = pats[0].span.end}, .text = binding};
        add_guard(r, (types::Guard){.base = guard_base(scrutinee),
                                    .variant = name,
                                    .reads = arms[i].value->span,
                                    .head = head,
                                    .test = nullptr});
    }
}

// Whether `e` is `and`, `or` or `not`, the connectives a compile-time question about a type is joined with.
static Bool connective(const ast::Expr *e) {
    if (e->kind == .unary) return e->kind.unary.op == .logical_not;
    if (e->kind != .binary) return false;
    return e->kind.binary.op == .logical_and || e->kind.binary.op == .logical_or;
}

// The answer of a condition made of questions about types (`is_integer(typeof(x)) and is_signed(typeof(x))`,
// `typeof(x) == *char or typeof(x) == []char`), joined by `and`, `or` and `not`; false when a part is not such a
// question or its type is not known yet. An instance keeps the branch the answer picks, as for one question (#1902).
static Bool query_answer(types::Checked *r, const ast::Expr *test, Bool *answer) {
    const ast::Expr *nodes[32];
    Bool opened[32];
    Bool values[32];
    Usize n = 1;
    Usize have = 0;
    nodes[0] = test;
    opened[0] = false;
    while (n > 0) {
        const ast::Expr *e = nodes[n - 1];
        if (!connective(e)) {
            n -= 1;
            Bool value = false;
            if (have == countof(values) || !types_builtin::query_value(r, e, &value)) return false;
            values[have++] = value;
        } else if (!opened[n - 1]) {
            opened[n - 1] = true;
            if (n + 2 > countof(nodes)) return false;
            if (e->kind == .unary) {
                nodes[n] = e->kind.unary.operand;
                opened[n++] = false;
            } else if (e->kind == .binary) {
                nodes[n] = e->kind.binary.right;
                opened[n++] = false;
                nodes[n] = e->kind.binary.left;
                opened[n++] = false;
            }
        } else {
            n -= 1;
            if (e->kind == .unary) {
                values[have - 1] = !values[have - 1];
            } else if (e->kind == .binary) {
                Bool left = values[have - 2]; // the left side is answered first
                Bool right = values[have - 1];
                have -= 1;
                values[have - 1] = e->kind.binary.op == .logical_and ? left && right : left || right;
            }
        }
    }
    if (have != 1) return false;
    *answer = values[0];
    return true;
}

static void if_statement(types::Checked *r, const ast::Stmt *s) {
    if (s->kind != .if_stmt) {
        return;
    }
    Bool is_constexpr = s->kind.if_stmt.is_constexpr;
    const ast::Expr *test = s->kind.if_stmt.condition;
    const ast::Stmt *then_branch = s->kind.if_stmt.then_branch;
    const ast::Stmt *else_branch = s->kind.if_stmt.else_branch;
    // A condition about the target that `when::live_module` did not decide (#2277); a local named `target` is not one.
    if (when::about_target(test) && !when::is_folded_fact(test) && types::lookup(&r->scopes, "target") == nullptr) {
        types::failf(r, test->span,
                     "a condition on `target` is decided at compile time and this one cannot be: write it with "
                     "`target.os == .macos` (or `.linux`), `target.static_analyzer`, `!`, `&&`, `||`, "
                     "`true` and `false`");
        return;
    }
    if (is_constexpr) {
        not_yet(r, s, "if constexpr in a body");
        return;
    }
    Bool answer = false;
    if (query_answer(r, test, &answer)) { // `is_slice(typeof(x))`: one branch is live (#1902)
        types::set_decided(r, test, answer);
        const ast::Stmt *live = answer ? then_branch : else_branch;
        if (live != nullptr) push(live, nullptr, enter);
        return;
    }
    note_guard(r, s); // first: a read in the test's own chain (`k != .v || k.v == 0`) is one it guards
    (void)types_expr::check(r, test, r->table.bool_type);
    // `if x != .none:` names `x` a `T` in the `then` (and `x == .none` in the `else`); `if x == .none: return` does the
    // same for the rest of the block. Each branch gets a scope of its own for the narrowed names (#2481).
    if (else_branch != nullptr) {
        push(nullptr, nullptr, leave);
        push(else_branch, nullptr, enter);
        push(nullptr, test, open_false);
    } else if (leaves(then_branch)) {
        push(nullptr, test, narrow_rest);
    }
    push(nullptr, nullptr, leave);
    push(then_branch, nullptr, enter);
    push(nullptr, test, open_true);
}

static Bool calls_noreturn(const types::Checked *r, const ast::Expr *value);

// Whether a refutable binding's `else` ends by leaving: `return`, `break`, `continue` or a call that never returns.
static Bool else_leaves(const types::Checked *r, const ast::Stmt *s) {
    while (block_size(s) > 0)
        s = block_item(s, block_size(s) - 1);
    if (s->kind == .expression) return calls_noreturn(r, s->kind.expression.value);
    return leaves(s);
}

// The checks of `.v(x) := value else: ...` (#2494): the pattern can fail, the `else` leaves, the name is new.
static void refutable_binding(types::Checked *r, ast::Span span, types::TypeRef t, ast::Pattern pattern,
                              const ast::Stmt *else_branch) {
    Bool can_fail = t != nullptr && (t->kind == .option || t->kind == .result_type ||
                                     (t->kind == .enumeration && types::is_payload_enum(t)));
    if (t != nullptr && t != r->table.invalid && !can_fail) {
        types::failf(r, span, "this pattern always matches: remove `else`");
    }
    if (else_branch != nullptr && !else_leaves(r, else_branch)) {
        types::failf(r, else_branch->span, "the `else` of a binding must leave: end it with `return`, ",
                     "`break`, `continue` or a call that never returns");
    }
    const types::Symbol *earlier = types::lookup_own(&r->scopes, pattern.binding);
    if (countof(pattern.binding) > 0 && earlier != nullptr && earlier->kind == .variable) {
        types::failf(r, pattern.span, "`", pattern.binding,
                     "` hides a variable of the same name; shadowing is an error, choose another name");
    }
}

// `if let .some(x) = o`: the value is typed (a call of a generic function there makes its instance), `x` has the
// payload's type in the `then` branch, and the `else` branch is checked outside it. A payload enumeration's
// `.circle(c)` binds what the enumerator carries (#2494).
static void if_let_statement(types::Checked *r, const ast::Stmt *s) {
    if (s->kind != .if_let) {
        return;
    }
    ast::Pattern pattern = s->kind.if_let.pattern;
    const ast::Stmt *then_branch = s->kind.if_let.then_branch;
    const ast::Stmt *else_branch = s->kind.if_let.else_branch;
    Bool refutable = pattern.refutable;
    types::TypeRef t = types_expr::infer(r, s->kind.if_let.value);
    if (refutable) refutable_binding(r, s->span, t, pattern, else_branch);
    if (else_branch != nullptr) {
        push(else_branch, nullptr, enter);
    }
    types::push_scope(&r->scopes);
    push(nullptr, nullptr, leave);
    push(then_branch, nullptr, enter);
    Str binding = pattern.binding;
    types::TypeRef element = r->table.invalid;
    if (t != nullptr && t->kind == .enumeration && types::is_payload_enum(t)) {
        element = types_expr::pattern_payload(r, s->span, t, pattern);
    }
    if (countof(binding) == 0 || is_discard(binding)) {
        return;
    }
    if (t != nullptr && t->kind == .option) {
        types::TypeRef inner =
            types::element_of(t); // tested as a local: a test of the field `element` would make it an option
        if (inner != nullptr) element = inner;
    }
    types::Symbol symbol = {
        .name = binding, .kind = .variable, .type = element, .is_const = !pattern.is_mut, .is_new = true};
    symbol.init = s->kind.if_let.value; // a fix that makes the value writable reaches it through the name (#2643)
    (void)types::declare(&r->scopes, symbol);
    note_local(binding, element);
}

static void for_in_statement(types::Checked *r, const ast::Stmt *s) {
    if (s->kind != .for_in) {
        return;
    }
    ast::Identifier names[:] = s->kind.for_in.names;
    types::TypeRef element = types_iter::element_type(r, s->kind.for_in.iterable, s->kind.for_in.is_tuple);
    if (element == nullptr) {
        element = r->table.invalid;
    }
    types::TypeRef first = element;
    if (s->kind.for_in.is_tuple && element != r->table.invalid) {
        // `for (i, x) in enumerate(xs)`: the index is a `Usize`, then the element (#2456).
        first = types::builtin(&r->table, "Usize");
        if (countof(names) != 2) {
            types::failf(r, s->span, "`enumerate` yields two values, the index and the element: write `for (i, x) in`");
        }
    }
    types::push_scope(&r->scopes);
    push(nullptr, nullptr, leave);
    push(s->kind.for_in.body, nullptr, enter);
    for (Usize i = 0; i < countof(names); i++) {
        types::TypeRef bound = i == 0 ? first : element;
        const types::Symbol *earlier = types::lookup(&r->scopes, names[i].text);
        if (earlier != nullptr && earlier->kind == .variable && !is_discard(names[i].text)) {
            types::failf(r, names[i].span, "`", names[i].text, "` hides a variable of the same name; shadowing is an ",
                         "error, choose another name");
        } else if (!is_discard(names[i].text)) {
            types::Symbol symbol = {
                .name = names[i].text, .kind = .variable, .type = bound, .is_const = true, .is_new = true};
            (void)types::declare(&r->scopes, symbol);
            r->new_body = true;
            note_local(names[i].text, bound);
        }
    }
}

static void for_statement(types::Checked *r, const ast::Stmt *s) {
    if (s->kind != .for_stmt) {
        return;
    }
    Bool is_constexpr = s->kind.for_stmt.is_constexpr;
    const ast::Expr *range = s->kind.for_stmt.range;
    const ast::Stmt *init = s->kind.for_stmt.init;
    const ast::Expr *test = s->kind.for_stmt.condition;
    const ast::Expr *step = s->kind.for_stmt.step;
    const ast::Stmt *body = s->kind.for_stmt.body;
    if (is_constexpr) {
        not_yet(r, s, "for constexpr");
        return;
    }
    if (range != nullptr) {
        not_yet(r, s, "a range for");
        return;
    }
    types::push_scope(&r->scopes);
    push(nullptr, nullptr, leave);
    push(body, nullptr, enter);
    if (step != nullptr) {
        push(nullptr, step, advance);
    }
    if (test != nullptr) {
        push(nullptr, test, condition);
    }
    if (init != nullptr) {
        push(init, nullptr, enter);
    }
}

// Collects the statements whose value is the function's result: the body's last line, into a block's last line and
// into both arms of an if with an else (#1428: the last line is the value).
static void find_tails(const ast::Stmt *root) {
    state.tail_count = 0;
    if (countof(state.tails) == 0) state.tails = mem::alloc_slice(StmtRef, max_tails);
    const ast::Stmt *todo[32];
    Usize n = 0;
    if (root != nullptr) {
        todo[0] = root;
        n = 1;
    }
    while (n > 0) {
        n -= 1;
        const ast::Stmt *s = todo[n];
        if (s->kind == .block) {
            ast::StmtRef items[:] = s->kind.block.items;
            if (countof(items) > 0) {
                todo[n] = items[countof(items) - 1];
                n += 1;
            }
        } else if (s->kind == .if_stmt && s->kind.if_stmt.else_branch != nullptr && n + 2 <= countof(todo)) {
            todo[n] = s->kind.if_stmt.then_branch;
            todo[n + 1] = s->kind.if_stmt.else_branch;
            n += 2;
        } else if (s->kind == .match_stmt && state.tail_count < countof(state.tails)) {
            state.tails[state.tail_count].stmt = s; // its arms are the result
            state.tail_count += 1;
            ast::MatchArm arms[:] = s->kind.match_stmt.arms;
            for (Usize i = 0; i < countof(arms) && n < countof(todo); i++) {
                const ast::Expr *value = arms[i].value;
                if (value != nullptr && inner_statement(value) != nullptr) {
                    todo[n] = inner_statement(value);
                    n += 1;
                }
            }
        } else if (s->kind == .expression && state.tail_count < countof(state.tails)) {
            state.tails[state.tail_count].stmt = s;
            state.tail_count += 1;
        }
    }
}

static Bool is_tail(const ast::Stmt *s) {
    for (Usize i = 0; i < state.tail_count; i++) {
        if (state.tails[i].stmt == s) {
            return true;
        }
    }
    return false;
}

// Whether a call names a function marked `[[noreturn]]` (or `@noreturn`): as the last line it ends the function, so it
// has no value to match against the result type (#2461: `std.arena` ends in `stop(...)`).
static Bool calls_noreturn(const types::Checked *r, const ast::Expr *value) {
    if (value->kind != .call) {
        return false;
    }
    const ast::Expr *callee = value->kind.call.callee;
    if (callee->kind != .name) {
        return false;
    }
    const types::Symbol *s = types::lookup_path(&r->scopes, callee->kind.name.path);
    if (s == nullptr || s->kind != .function_symbol) {
        return false;
    }
    const ast::Decl *decl = s->decl;
    if (decl == nullptr) {
        return false;
    }
    for (Usize i = 0; i < countof(decl->attributes); i++) {
        ast::Identifier segments[:] = decl->attributes[i].name.segments;
        Usize n = countof(segments);
        if (n > 0 && types::same_text(segments[n - 1].text, "noreturn")) return true;
    }
    return false;
}

// An expression statement. In smith's own syntax a call whose result is not `Void` must be used or discarded.
static void expression_statement(types::Checked *r, const ast::Stmt *s) {
    if (s->kind != .expression) {
        return;
    }
    const ast::Expr *value = s->kind.expression.value;
    types::TypeRef type = nullptr;
    if (r->new_body && is_tail(s) && state.result != nullptr && state.result != r->table.void_type &&
        !calls_noreturn(r, value)) {
        type = types_expr::check(r, value, state.result); // the last line is the value: it takes the result's type
    } else {
        type = types_expr::infer(r, value);
    }
    if (!r->new_body || value->kind != .call || type == nullptr) {
        return;
    }
    if (state.result != r->table.void_type && is_tail(s)) {
        return;
    }
    if (type == r->table.void_type || type == r->table.invalid || type == r->table.automatic) {
        return;
    }
    // `smith lint --fix` writes the discard: `_ := ` before the call (#2311). The error itself stays for new code.
    syntax::Edits fix = {};
    fix = mem::realloc(fix, 1);
    ast::Span at = {.start = value->span.start, .end = value->span.start};
    Str word = "_ := ";
    fix[0] = (syntax::Edit){.span = at, .text = word};
    types::fail_fix(r, s->span,
                    msg(format::push("the result of this call, a `", types::show(type),
                                     "`, is not used; use it, or write `_ := ...` to discard it")),
                    fix);
}

// `switch (v) { case .a: ... default: ... }` (#1916): the value is typed, and when it is an enumeration with payloads
// its cases are variants, which the arms of a `match` check by name; any other value types its cases against it. Each
// case opens a scope for its body, like a block.
static void switch_statement(types::Checked *r, const ast::Stmt *s) {
    if (s->kind != .switch_stmt) {
        return;
    }
    types::TypeRef t = types_expr::infer(r, s->kind.switch_stmt.value);
    Bool variants = t != nullptr && t->kind == .enumeration && types::is_payload_enum(t);
    ast::SwitchCase cases[:] = s->kind.switch_stmt.cases;
    for (Usize i = countof(cases); i > 0; i--) {
        ast::SwitchCase *k = &cases[i - 1];
        push(ast::block(k->body), nullptr, enter);
    }
    if (variants || t == nullptr) {
        return;
    }
    for (Usize c = 0; c < countof(cases); c++) {
        ast::ExprRef values[:] = cases[c].values;
        for (Usize j = 0; j < countof(values); j++) {
            (void)types_expr::check(r, values[j], t);
        }
    }
}

// Types the constant patterns of arm `index` of a `match`, before the arm checks them against its value. Over an
// enumeration a name is one of its enumerators (`lex.name`), which is not a value in scope, so it is not typed.
static void match_patterns(types::Checked *r, const ast::Stmt *s, Usize index) {
    if (s->kind != .match_stmt) {
        return;
    }
    ast::Pattern pats[:] = s->kind.match_stmt.arms[index].patterns;
    types::TypeRef t = types::type_of(r, s->kind.match_stmt.value);
    Bool enumeration = t != nullptr && t->kind == .enumeration;
    for (Usize k = 0; k < countof(pats); k++) {
        const ast::Expr *constant = pats[k].constant;
        if (constant != nullptr && !(enumeration && types_expr::names_case(constant))) {
            (void)types_expr::infer(r, constant);
        }
    }
}

// `match v:` (#2336): the value is typed, then each arm in a scope of its own, with its patterns checked against the
// value and what it binds; then the arms together cover every case. An arm's value is a statement (`return`, a block)
// or an expression, which is the function's result when the `match` is its last line.
static void match_statement(types::Checked *r, const ast::Stmt *s) {
    if (s->kind != .match_stmt) {
        return;
    }
    ast::MatchArm arms[:] = s->kind.match_stmt.arms;
    (void)types_expr::infer(r, s->kind.match_stmt.value);
    note_arm_guards(r, s);
    Bool tail = r->new_body && is_tail(s) && state.result != nullptr && state.result != r->table.void_type;
    push(s, nullptr, cover);
    for (Usize i = countof(arms); i > 0; i--) {
        const ast::Expr *value = arms[i - 1].value;
        push(nullptr, nullptr, leave);
        if (value != nullptr && inner_statement(value) != nullptr) {
            push(inner_statement(value), nullptr, enter);
        } else if (value != nullptr) {
            push(nullptr, value, tail ? tail_arm : advance);
        }
        push(s, nullptr, arm);
        state.work[state.top - 1].index = i - 1;
    }
}

// Reads one statement: does what needs no children now, and pushes the children.
static void enter_statement(types::Checked *r, const ast::Stmt *s) {
    state.prev_decl = state.last_decl;
    state.last_decl = nullptr;
    if (s->kind == .expression) {
        expression_statement(r, s);
    } else if (s->kind == .declaration) {
        local_declaration(r, s->kind.declaration.decl);
    } else if (s->kind == .destructure) {
        destructure_statement(r, s);
    } else if (s->kind == .block) {
        block_statement(r, s);
    } else if (s->kind == .if_stmt) {
        if_statement(r, s);
    } else if (s->kind == .while_stmt) {
        const ast::Expr *condition = s->kind.while_stmt.condition;
        const ast::Stmt *body = s->kind.while_stmt.body;
        note_guard(r, s); // `while k == .v && k.v.n < 3:` (D12)
        (void)types_expr::check(r, condition, r->table.bool_type);
        push(body, nullptr, enter);
    } else if (s->kind == .do_while) {
        push(nullptr, s->kind.do_while.condition, condition);
        push(s->kind.do_while.body, nullptr, enter);
    } else if (s->kind == .for_stmt) {
        for_statement(r, s);
    } else if (s->kind == .if_let) {
        if_let_statement(r, s);
    } else if (s->kind == .for_in) {
        for_in_statement(r, s);
    } else if (s->kind == .return_stmt) {
        return_statement(r, s);
    } else if (s->kind == .yield_stmt) {
        types_stream::check_yield(r, s, state.generator);
    } else if (s->kind == .defer_stmt) {
        push(s->kind.defer_stmt.body, nullptr, enter);
    } else if (s->kind == .labeled) {
        push(s->kind.labeled.body, nullptr, enter);
    } else if (s->kind == .switch_stmt) {
        switch_statement(r, s);
    } else if (s->kind == .match_stmt) {
        match_statement(r, s);
    } else if (s->kind == .static_assert_stmt) {
        (void)types_expr::check(r, s->kind.static_assert_stmt.condition, r->table.bool_type);
    }
}

// A statement inside a block that is a value (`let v = if c:` and its lines): the ones that need no children are
// checked in the scope the block opened; a loop, a nested block and the like are `not yet typed`.
static void value_block_statement(types::Checked *r, const ast::Stmt *s) {
    if (s->kind == .expression) {
        expression_statement(r, s);
    } else if (s->kind == .declaration) {
        local_declaration(r, s->kind.declaration.decl);
    } else if (s->kind == .destructure) {
        destructure_statement(r, s);
    } else if (s->kind == .return_stmt) {
        return_statement(r, s);
    } else if (s->kind == .static_assert_stmt) {
        (void)types_expr::check(r, s->kind.static_assert_stmt.condition, r->table.bool_type);
    } else if (s->kind == .break_stmt || s->kind == .continue_stmt) {
        return; // a `match` arm that leaves the loop (#2336)
    } else {
        types::failf(r, s->span, "not yet typed: this statement inside a block that is used as a value");
    }
}

// Walks `root` with the function's result type `result`.
static void walk(types::Checked *r, const ast::Stmt *root, types::TypeRef result) {
    types::TypeRef outer = state.result;
    state.result = result;
    r->guard_count = 0;
    state.last_decl = nullptr; // a declaration of an earlier body would be a dangling pointer (#2506)
    state.prev_decl = nullptr;
    Usize first_error = r->error_count;
    Usize first_local = state.local_count;
    find_tails(root);
    types_undefined::check_body(r, root);
    state.top = 0;
    push(root, nullptr, enter);
    while (state.top > 0) {
        state.top -= 1;
        Frame f = state.work[state.top];
        if (f.step == leave) {
            types::pop_scope(&r->scopes);
        } else if (f.step == open_true || f.step == open_false) {
            types::push_scope(&r->scopes);
            types_expr::narrow_scope(r, f.expr, f.step == open_true);
        } else if (f.step == narrow_rest) {
            types_expr::narrow_scope(r, f.expr, false);
        } else if (f.step == condition) {
            (void)types_expr::check(r, f.expr, r->table.bool_type);
        } else if (f.step == advance) {
            (void)types_expr::infer(r, f.expr);
        } else if (f.step == tail_arm) {
            (void)types_expr::check(r, f.expr, state.result);
        } else if (f.step == arm) {
            match_patterns(r, f.stmt, f.index);
            types_expr::match_arm(r, f.stmt, f.index);
        } else if (f.step == cover) {
            types_expr::match_coverage(r, f.stmt);
        } else {
            state.block_end = f.end;
            enter_statement(r, f.stmt);
        }
    }
    affine::check_body(r, root);                 // after the walk: it reads the types the walk recorded
    for (Usize i = 0; i < r->guard_count; i++) { // a local of the binding's name, anywhere in the body (#2503)
        for (Usize k = first_local; k < state.local_count; k++) {
            if (types::same_text(state.locals[k].name, r->guards[i].variant)) r->guards[i].spoiled = true;
        }
    }
    types_expr::drop_spoiled(r, first_error);
    // The test of an option field whose binding no read wrote (or whose site is spoiled) gets its own fix: `nullptr`
    // as `.none` (#2557).
    for (Usize i = 0; i < r->guard_count; i++) {
        types::Guard *g = &r->guards[i];
        if (g->option && g->null_error > 0 && (!g->head_sent || g->spoiled)) {
            r->errors[g->null_error - 1].fix = g->null_fix;
        }
    }
    state.result = outer;
}

// ---------------------------------------------------------------------------------------------------------------
// Lambdas

static types::Scopes copy_scopes(const types::Scopes *s) {
    types::Scopes copy = {};
    copy.symbols = mem::alloc_slice(types::Symbol, s->count + 8);
    for (Usize i = 0; i < s->count; i++) {
        copy.symbols[i] = s->symbols[i];
    }
    copy.count = s->count;
    copy.marks = mem::alloc_slice(Usize, s->depth + 8);
    for (Usize i = 0; i < s->depth; i++) {
        copy.marks[i] = s->marks[i];
    }
    copy.depth = s->depth;
    return copy;
}

// The hook J1b calls with a lambda whose type was decided: keep it, with the scopes it sees, for `drain`.
static void lambda_hook(types::Checked *c, const ast::Expr *lambda, types::TypeRef type) {
    if (state.pending_count == countof(state.pending)) {
        Usize capacity = countof(state.pending) * 2;
        if (capacity < 8) {
            capacity = 8;
        }
        state.pending = mem::realloc(state.pending, capacity);
    }
    state.pending[state.pending_count] =
        (Pending){.lambda = lambda, .type = type, .scopes = copy_scopes(&c->scopes), .function = state.function};
    state.pending_count += 1;
}

static void lambda_body(types::Checked *r, Pending p) {
    const ast::Expr *anchor = p.lambda;
    if (anchor->kind != .lambda) {
        return;
    }
    ast::Param params[:] = anchor->kind.lambda.params;
    const ast::Stmt *body = anchor->kind.lambda.body;
    types::Scopes outer = r->scopes;
    r->scopes = p.scopes;
    types::push_scope(&r->scopes);
    types::TypeRef shape = types::element_of(p.type);
    Str outer_function = state.function;
    state.function = p.function;
    for (Usize i = 0; i < countof(params) && i < countof(types::slots_of(shape).items); i++) {
        types::Symbol symbol = {
            .name = params[i].name, .kind = .variable, .type = types::slots_of(shape).items[i].type};
        if (!is_discard(params[i].name) && !types::declare(&r->scopes, symbol)) {
            types::failf(r, params[i].span, "the parameter `", params[i].name,
                         "` is already declared in this lambda; choose another name");
        } else {
            note_local(params[i].name, types::slots_of(shape).items[i].type);
        }
    }
    walk(r, body, types::element_of(shape));
    state.function = outer_function;
    types::pop_scope(&r->scopes);
    r->scopes = outer;
}

// Checks every lambda body kept so far, and those they hold in turn.
static void drain(types::Checked *r) {
    for (Usize i = 0; i < state.pending_count; i++) {
        lambda_body(r, state.pending[i]);
    }
    state.pending_count = 0;
}

// ---------------------------------------------------------------------------------------------------------------
// Functions and the module

static void check_function(types::Checked *r, const ast::Decl *function, types::TypeRef signature);
static Bool declares_type(const ast::Decl *function);

// The types::BodyChecker: the body of one function of the module.
export void check_body(types::Checked *r, const ast::Decl *target) {
    if (target->kind != .function) {
        return;
    }
    if (target->kind.function.body == nullptr) {
        return;
    }
    Str name = target->kind.function.name;
    const types::Symbol *symbol = types::lookup(&r->scopes, name);
    if (symbol == nullptr || !types::declared_by(symbol, target) || symbol->type->kind != .function) {
        return;
    }
    if (symbol->generic) {
        return; // a template: its bodies are the instances' (check_instances)
    }
    if (declares_type(target)) {
        return; // a type function: its unnamed `enum:` or `struct:` is the type it returns (#2251)
    }
    check_function(r, target, symbol->type);
}

// Whether a function's result is written `type`.
static Bool returns_type(const ast::TypeExpr *result) {
    if (result == nullptr || result->kind != .named) {
        return false;
    }
    ast::Path path = result->kind.named.path;
    return countof(path.segments) == 1 && types::same_text(path.segments[0].text, "type");
}

// Whether `function` is a type function (`-> type`) whose last statement is an unnamed `enum:` or `struct:` block:
// that declaration is the type each call returns (`Option(i32)`), so the body has nothing else to check.
// Whether a statement declares an `enum:` or `struct:` with no name.
static Bool declares_unnamed(const ast::Stmt *last) {
    if (last->kind != .declaration) {
        return false;
    }
    const ast::Decl *declared = last->kind.declaration.decl;
    if (declared->kind == .enumeration) return countof(declared->kind.enumeration.name) == 0;
    if (declared->kind == .record) return countof(declared->kind.record.name) == 0;
    return false;
}

static Bool declares_type(const ast::Decl *target) {
    if (target->kind != .function) {
        return false;
    }
    if (!returns_type(target->kind.function.result)) {
        return false;
    }
    const ast::Stmt *body = target->kind.function.body;
    if (block_size(body) == 0) {
        return false;
    }
    const ast::Stmt *last = block_item(body, block_size(body) - 1);
    return declares_unnamed(last);
}

// The body of `function` against `signature`: the parameters in a scope of their own, then the body.
static void check_function(types::Checked *r, const ast::Decl *target, types::TypeRef signature) {
    if (target->kind != .function) {
        return;
    }
    Str name = target->kind.function.name;
    ast::Param params[:] = target->kind.function.params;
    types::push_scope(&r->scopes);
    for (Usize i = 0; i < countof(params) && i < countof(types::slots_of(signature).items); i++) {
        Bool is_const = params[i].type != nullptr && params[i].type->qualifiers.is_const;
        if (params[i].is_new) {
            is_const = !params[i].is_mut;
        }
        ast::Attribute attributes[:] = params[i].attributes;
        types::Symbol parameter = {.name = params[i].name,
                                   .kind = .variable,
                                   .type = types::slots_of(signature).items[i].type,
                                   .is_const = is_const,
                                   .is_new = params[i].is_new,
                                   .at = params[i].span,
                                   .may_mut = params[i].is_new && countof(attributes) == 0 && !params[i].is_const &&
                                              !params[i].is_constexpr && !params[i].is_rest,
                                   .written = params[i].type};
        if (!is_discard(params[i].name) && !types::declare(&r->scopes, parameter)) {
            types::failf(r, params[i].span, "the parameter `", params[i].name, "` is already declared in `", name,
                         "`; choose another name");
        }
    }
    state.function = name;
    r->new_body = false;
    for (Usize p = 0; p < countof(params); p++) {
        r->new_body = r->new_body || params[p].is_new;
    }
    types::TypeRef outer_generator = state.generator;
    state.generator = types_stream::generator_element(types::element_of(signature), target->kind.function.body);
    types::TypeRef returned = types::element_of(signature);
    if (returns_type(target->kind.function.result))
        returned = types::builtin(&r->table, "type"); // a type function returns a type value
    walk(r, target->kind.function.body, state.generator != nullptr ? r->table.void_type : returned);
    state.generator = outer_generator;
    types_fn::check_once(r, params, target->kind.function.body);
    types::pop_scope(&r->scopes);
    drain(r);
}

// Checks the body of every instance of a generic function that a call made (#1908), each in a scope that binds its
// compile-time parameters; an instance may make others, which are checked in turn.
static void check_instances(types::Checked *r) {
    for (Usize i = 0; i < r->instance_count; i++) {
        if (r->instances[i].checked) {
            continue;
        }
        r->instances[i].checked = true;
        types::Instance instance = r->instances[i];
        types::push_scope(&r->scopes);
        Str outer = r->prefix;
        Str outer_scopes = r->scopes.prefix;
        Usize outer_floor = r->scopes.floor;
        r->prefix = instance.prefix; // the template's own names, as when its module was declared
        r->scopes.prefix = instance.prefix;
        r->scopes.floor = r->scopes.count;
        types::bind_instance(r, &instance);
        Usize outer_instance = r->current;
        r->current = i;
        check_function(r, instance.decl, instance.signature);
        r->current = outer_instance;
        r->prefix = outer;
        r->scopes.prefix = outer_scopes;
        r->scopes.floor = outer_floor;
        types::pop_scope(&r->scopes);
    }
}

static types::TypeRef result_hook() {
    return state.result;
}

export void install() {
    types_expr::set_hooks((types_expr::Hooks){.function_result = result_hook,
                                              .convert = convert_hook,
                                              .cast_rule = cast_hook,
                                              .lambda_body = lambda_hook,
                                              .statement = value_block_statement});
}

// Takes the hooks out again (the default of front::types_expr is exact equality).
export void uninstall() {
    types_expr::set_hooks((types_expr::Hooks){});
}

export types::Options options(types::Target target) {
    install();
    return (types::Options){.target = target, .bodies = check_body, .expression = types_expr::infer};
}

// A condition against Bool; the fixer drops a `(void)` cast, so the type is read here.
static void check_condition(types::Checked *r, const ast::Expr *condition) {
    const types::Ty *t = types_expr::check(r, condition, r->table.bool_type);
    if (t == nullptr) return;
}

// A module-level variable's initializer, against its declared type.
static void check_initializer(types::Checked *r, const ast::Decl *d) {
    if (d->kind == .static_assert_decl) { // its condition folds before emit (`target.float_radix == 2`)
        check_condition(r, d->kind.static_assert_decl.condition);
        return;
    }
    if (d->kind != .variable || d->from_c || d->kind.variable.init == nullptr) {
        return;
    }
    if (types_expr::is_undefined(d->kind.variable.init) && types::lookup(&r->scopes, "undefined") == nullptr) {
        return; // `mut first: Task = undefined`: the storage C zeroes, filled before use (#2643)
    }
    if (d->kind.variable.init->kind == .type_value) {
        return; // `let Point = m.Point`: an alias of a type, resolved with the declarations
    }
    if (types_expr::is_undefined(d->kind.variable.init)) {
        return; // `mut p: *mut T = undefined`: a global C zeroes
    }
    Str name = d->kind.variable.name;
    Bool constant = d->kind.variable.is_constexpr;
    const ast::Expr *init = d->kind.variable.init;
    const types::Symbol *symbol = types::lookup(&r->scopes, name);
    if (symbol == nullptr || !types::declared_by(symbol, d)) {
        return;
    }
    if (symbol->kind == .type_name) {
        return; // `const Pair = (i32, f32)`: a tuple of types, an alias declared with the aliases
    }
    state.function = name;
    types::TypeRef type = symbol->type;
    if (constant) {
        require_constant(r, name, init);
    }
    if (is_auto(type)) {
        (void)types_expr::infer(r, init);
    } else {
        (void)types_expr::check(r, init, type);
    }
}

static types::Checked check_once(const ast::Module *m, types::Target target, types::ModuleLoader load,
                                 types::HeaderLoader headers) {
    state = empty_state();
    types_fn::reset();
    types::Options chosen = options(target);
    chosen.load = load;
    chosen.headers = headers;
    types::Checked r = types::check(m, chosen);
    for (Usize i = 0; i < countof(m->decls); i++) {
        check_initializer(&r, m->decls[i]);
        const ast::Decl *asserted = m->decls[i];
        if (asserted->kind == .static_assert_decl) {
            state.function = "static_assert";
            check_condition(&r, asserted->kind.static_assert_decl.condition);
        }
    }
    check_instances(&r);
    drain(&r);
    types_attr::check_module(&r, m);
    lint::check_module(&r, m);
    uninstall();
    return r;
}

static Bool starts_with(Str text, Str head) {
    if (countof(head) > countof(text)) return false;
    for (Usize i = 0; i < countof(head); i++) {
        if (text[i] != head[i]) return false;
    }
    return true;
}

// The name between the first pair of backticks of `text`, "" when there is none.
static Str first_quoted(Str text) {
    Usize from = 0;
    while (from < countof(text) && text[from] != '`')
        from += 1;
    Usize to = from + 1;
    while (to < countof(text) && text[to] != '`')
        to += 1;
    if (to >= countof(text)) return "";
    return text[from + 1:to];
}

static Usize length_of(Str text) {
    return countof(text);
}

static Bool same_str(Str a, Str b) {
    return starts_with(a, b) && countof(a) == countof(b);
}

// A use of a name that is gone on `os` says where the name is declared.
static void explain_dead(types::Checked *r, const ast::Module *m, when::Os os) {
    typeof(when::Dead[:]) dead = when::dead_names(m, os);
    for (Usize i = 0; i < r->error_count; i++) {
        Str text = r->errors[i].message;
        if (!starts_with(text, "unknown name `") && !starts_with(text, "unknown type `")) continue;
        Str name = first_quoted(text);
        for (Usize k = 0; k < countof(dead); k++) {
            if (!same_str(dead[k].name, name)) continue;
            Str condition = dead[k].condition;
            if (length_of(condition) == 0) {
                condition = "a condition";
            }
            r->errors[i].message = types::message_of(format::push("`", name, "` is not declared on ", when::os_name(os),
                                                                  ": it is declared only when ", condition));
            break;
        }
    }
}

// `check_module_with` that also reads the C headers the file imports (`import <stdio.h>;`, #1762): `headers` gives the
// declarations of one, and `c::printf`, `c::FILE` are then names of the module. A module with `@when` is checked as it
// is on the system smith runs on: a variant for another system is not checked (#2323).
export types::Checked check_module_headers(const ast::Module *m, types::Target target, types::ModuleLoader load,
                                           types::HeaderLoader headers) {
    if (!when::uses_when(m)) return check_once(m, target, load, headers);
    // A variant whose `@when` does not hold for the system being compiled is not checked, as a compile-time `if` in a
    // body is not (#2283, #2323): its headers, its types and its names are the other system's. The CI of each system
    // compiles its own variant, so an error in the other one is found there.
    const ast::Module *live = when::live_module(m, when::host());
    types::Checked only = check_once(live, target, load, headers);
    explain_dead(&only, m, when::host());
    types_attr::check_when(&only, m);
    only.module = live;
    return only;
}

// Checks a whole module, reading the modules it imports with `load` (#1677): `import a.b as m` makes `m.name` the
// public declaration `name` of `a.b`.
export types::Checked check_module_with(const ast::Module *m, types::Target target, types::ModuleLoader load) {
    return check_module_headers(m, target, load, nullptr);
}

// Checks a whole module for `target`.
export types::Checked check_module(const ast::Module *m, types::Target target) {
    return check_module_with(m, target, nullptr);
}

// The locals the bodies declared, one line each: `local <function>.<name>: <type>`.
export Str locals_dump() {
    Str text = "";
    for (Usize i = 0; i < state.local_count; i++) {
        Local l = state.locals[i];
        Str line = msg(format::push("local ", l.function, ".", l.name, ": ", types::show(l.type), "\n"));
        text = msg(format::push(text, line));
    }
    return text;
}
