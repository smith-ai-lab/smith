// front::fix_match, the fix-it for a `match` that names every variant and still ends in `_: ()` (#3321).
//
//   match c:                       match c:
//       .red: return 1                 .red: return 1
//       .green: return 2               .green: return 2
//       .blue: return 3                .blue: return 3
//       _: ()
//
// The parser writes a C `switch` that had no `default` as a `match` with a last arm `_: ()`, because it does not know
// the enum. When the arms above name every variant of the enumeration the `match` is exhaustive without it, and the
// arm would be the last line of the function, a `()` where the function's type is wanted. The checker knows the type of
// the matched value; the arms are read from the text. A `match` that leaves a variant out keeps its `_` arm.
//
//   fix_match::edits(source, checked)   one fix for each such `_: ()` arm: the line is removed
module front::fix_match;

import front::ast;
import front::parse as core;
import front::types;
import std::arena;
import std::mem;

static Bool starts_with(Str text, Str prefix) {
    if (countof(text) < countof(prefix)) return false;
    for (Usize i = 0; i < countof(prefix); i++)
        if (text[i] != prefix[i]) return false;
    return true;
}

static Bool same(Str a, Str b) {
    return countof(a) == countof(b) && starts_with(a, b);
}

static Bool word_char(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
}

// One line of the text: where it starts, where its text ends (before the newline) and its indentation; `blank` when it
// holds nothing but spaces.
struct Line {
    Usize start;
    Usize end;
    Usize indent;
    Bool blank;
};

static Line line_at(Str source, Usize start) {
    Usize end = start;
    while (end < countof(source) && source[end] != '\n')
        end += 1;
    Usize indent = 0;
    while (start + indent < end && source[start + indent] == ' ')
        indent += 1;
    return (Line){.start = start, .end = end, .indent = indent, .blank = start + indent == end};
}

// The type of the expression written at `[from, to)`, when the checker typed it as an enumeration; else nullptr.
static types::TypeRef enumeration_at(const types::Checked *c, Usize from, Usize to) {
    for (Usize i = 0; i < countof(c->nodes); i++) {
        const ast::Expr *e = c->nodes[i].node;
        if (e == nullptr || e->span.start != from || e->span.end != to) continue;
        types::TypeRef t = c->nodes[i].type;
        if (t != nullptr && t->kind == .enumeration) return t;
    }
    return nullptr;
}

// Marks in `seen` the variants an arm line `.a, .b(x):` names; false when the line is not a list of variants.
static Bool mark_arm(Str source, Line line, types::TypeRef t, Bool seen[:]) {
    Usize at = line.start + line.indent;
    types::Members members = types::slots_of(t);
    while (at < line.end) {
        if (source[at] != '.') return false;
        Usize from = at + 1;
        at = from;
        while (at < line.end && word_char(source[at]))
            at += 1;
        if (at == from) return false;
        for (Usize k = 0; k < countof(members.items); k++) {
            if (same(members.items[k].name, source[from:at])) seen[k] = true;
        }
        if (at < line.end && source[at] == '(') return true; // a payload pattern: the rest is the binding and the body
        if (at < line.end && source[at] == ':') return true;
        if (at + 1 < line.end && source[at] == ',' && source[at + 1] == ' ')
            at += 2;
        else
            return false;
    }
    return false;
}

// The `_: ()` arm at the end of the `match` whose header is `head`, when the other arms name every variant of `t`:
// its line, else a line with `end == start`.
static Line redundant_arm(Str source, Line head, types::TypeRef t) {
    Line none = {};
    Usize total = countof(types::slots_of(t).items);
    Bool seen[:] = mem::alloc_slice(Bool, total);
    Line wild = none;
    Bool clean = true;
    Usize at = head.end + 1;
    while (at < countof(source)) {
        Line line = line_at(source, at);
        at = line.end + 1;
        if (line.blank) continue;
        if (line.indent <= head.indent) break;
        if (line.indent != head.indent + 4) continue;
        Str text = source[line.start + line.indent:line.end];
        if (same(text, "_: ()"))
            wild = line;
        else if (!mark_arm(source, line, t, seen))
            clean = false;
    }
    Bool all = clean && wild.end > wild.start;
    for (Usize k = 0; k < total; k++)
        all = all && seen[k];
    mem::free(seen.data);
    return all ? wild : none;
}

export core::Errors edits(Str source, const types::Checked *c) {
    core::Errors out = {};
    Usize at = 0;
    while (at < countof(source)) {
        Line line = line_at(source, at);
        at = line.end + 1;
        Str text = source[line.start + line.indent:line.end];
        if (!starts_with(text, "match ") || text[countof(text) - 1] != ':') continue;
        Usize from = line.start + line.indent + 6;
        types::TypeRef t = enumeration_at(c, from, line.end - 1);
        if (t == nullptr) continue;
        Line wild = redundant_arm(source, line, t);
        if (wild.end == wild.start) continue;
        Usize stop = wild.end < countof(source) ? wild.end + 1 : wild.end;
        core::Edits fix = {};
        fix = mem::realloc(fix, 1);
        Str nothing = "";
        ast::Span gone = {.start = (U32)wild.start, .end = (U32)stop};
        fix[0] = (core::Edit){.span = gone, .text = nothing};
        out = mem::realloc(out, countof(out) + 1);
        core::ParseError made = {};
        made.span = fix[0].span;
        made.message = "this `match` names every variant: the `_: ()` arm is not needed";
        made.fix = fix;
        out[countof(out) - 1] = made;
    }
    return out;
}
