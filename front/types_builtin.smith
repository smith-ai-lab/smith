// front::types_builtin: clang's `__builtin_*` functions as intrinsics of the checker (#2286 of #2224). std's modules
// spell a few operations the way clang does (`__builtin_add_overflow(a, b, &r)`, `__builtin_bit_cast(T, x)`); the names
// stay as clang spells them, they are std's private machinery and not user API, and they have no new-syntax alias.
//
// THE TABLE. `find(name)` gives the `Entry` of a builtin: its `Shape` (the parameter and result types, checked here by
// `check`) and the LLVM intrinsic it lowers to (`intrinsic`, the name after `llvm.`; the emitter, front::emit_builtin,
// reads the same entry). A name that is not in the table is not a builtin, and the checker reports it as unknown.
//
//   Shape            parameters                              result      lowers to
//   overflow         (int a, int b, *int r)                  Bool        llvm.{s,u}<intrinsic>.with.overflow, the sum
//   stored in r bit_cast         (type T, x)                             T           the bytes of x read as T assume
//   (Bool)                                  Void        llvm.assume trap             () Void        llvm.trap
//   float_unary      (float x)                               its type    llvm.<intrinsic>
//   float_binary     (float a, float b)                      its type    llvm.<intrinsic>
//   absolute         (int or float x)                        its type    llvm.fabs, llvm.abs
//   smallest         (number a, number b)                    its type    llvm.minnum, llvm.smin, llvm.umin
//   predicate        (float x)                               Bool        isnan: an unordered compare; isfinite: x - x
//   libc             (see libc_name)                         see libc_name  a call of the libc function
//   format           (*char out, n, *char format, rest...)   I32         a variadic call of snprintf
//   va_start         (__builtin_va_list list, last)          Void        llvm.va_start on the list's address
//   va_end           (__builtin_va_list list)                Void        llvm.va_end on the list's address
//   va_format        (*char out, n, *char format, list)      I32         a call of vsnprintf, the list by address
//   frame_address    (0)                                     *Void       llvm.frameaddress of the current frame
//   count_zeros      (U64 x)                                 I32         llvm.ctlz, truncated
//   type_query       (type T)                                Bool        `is_slice(T)`, `is_record(T)`...: asks the
//   type filled           (type T, n, value)                      [n]T        `array.filled(T, n, value)` of std.array
//   (#2339):
//                                                                        n copies of value; n is a constant
//   alloc                 (type T, n) or (type T, [a, b])         []T or [,]T `mem.alloc(T, n)` of std.mem (#2527):
//                                                                        zeroed, the sizes known at run time; and
//                         (*Arena, type T, n or [a, b])                       `arena.push_slice(&a, T, n)`
//   == 0 constant         () or ("") for nan                      F64 or F32  the constant (`inf`, `nan`; the F32 ones
//   end in `f`)
//
// A type argument (the first of `bit_cast`) is read as a type, not typed as a value.
module front::types_builtin;

import front::ast;
import front::types;
import front::parse as syntax;
import std::mem;

export typedef enum {
    overflow;
    bit_cast;
    assume;
    trap;
    float_unary;
    float_binary;
    absolute;
    smallest;
    predicate;
    constant;
    libc;
    format;
    count_zeros;
    atomic_add;
    filled;
    alloc;
    type_query;
    va_start;
    va_end;
    va_format;
    frame_address;
} Shape;

export struct Entry {
    Str name;
    Shape shape;
    Str intrinsic; // the part of the LLVM intrinsic's name that the shape does not fix
};

static Bool same(Str a, Str b) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

static Entry made(Str name, Shape shape, Str intrinsic) {
    return (Entry){.name = name, .shape = shape, .intrinsic = intrinsic};
}

// The libc-shaped and bit-counting builtins of the table (see `libc_name`).
static Bool find_libc(Str name, Entry *found) {
    if (same(name, "__builtin_memcpy")) {
        *found = made(name, .libc, "memcpy ppz v");
    } else if (same(name, "__builtin_memmove")) {
        *found = made(name, .libc, "memmove ppz v");
    } else if (same(name, "__builtin_memset")) {
        *found = made(name, .libc, "memset piz v");
    } else if (same(name, "__builtin_memcmp")) {
        *found = made(name, .libc, "memcmp ppz i");
    } else if (same(name, "__builtin_strlen")) {
        *found = made(name, .libc, "strlen p z");
    } else if (same(name, "__builtin_strcmp")) {
        *found = made(name, .libc, "strcmp pp i");
    } else if (same(name, "__builtin_strncmp")) {
        *found = made(name, .libc, "strncmp ppz i");
    } else if (same(name, "__builtin_strcpy")) {
        *found = made(name, .libc, "strcpy pp v");
    } else if (same(name, "__builtin_strncpy")) {
        *found = made(name, .libc, "strncpy ppz v");
    } else if (same(name, "__builtin_strchr")) {
        *found = made(name, .libc, "strchr pi p");
    } else if (same(name, "__builtin_strstr")) {
        *found = made(name, .libc, "strstr pp p");
    } else if (same(name, "__builtin_strcspn")) {
        *found = made(name, .libc, "strcspn pp z");
    } else if (same(name, "__builtin_ldexp")) {
        *found = made(name, .libc, "ldexp di d");
    } else if (same(name, "__builtin_nextafterf")) {
        *found = made(name, .libc, "nextafterf ff f");
    } else if (same(name, "__builtin_snprintf")) {
        *found = made(name, .format, "snprintf");
    } else if (same(name, "__builtin_frame_address")) {
        *found = made(name, .frame_address, "frameaddress");
    } else if (same(name, "__builtin_va_start")) {
        *found = made(name, .va_start, "va_start");
    } else if (same(name, "__builtin_va_end")) {
        *found = made(name, .va_end, "va_end");
    } else if (same(name, "__builtin_vsnprintf")) {
        *found = made(name, .va_format, "vsnprintf");
    } else if (same(name, "__atomic_fetch_add")) {
        *found = made(name, .atomic_add, "add");
    } else if (same(name, "__builtin_clzll")) {
        *found = made(name, .count_zeros, "ctlz");
    } else {
        return false;
    }
    return true;
}

// The questions about a type that std's generic bodies ask in an `if` (`is_slice(typeof(x))`); an instance keeps the
// branch the answer picks (#1902).
static Bool is_query(Str name) {
    return same(name, "is_slice") || same(name, "is_array") || same(name, "is_record") || same(name, "is_pointer") ||
           same(name, "is_integer") || same(name, "is_float") || same(name, "is_signed") || same(name, "is_bool") ||
           same(name, "is_enum");
}

// The answer of the question `name` for the type `t`.
static Bool answer(Str name, types::TypeRef t) {
    if (same(name, "is_slice")) return t->kind == .slice || t->kind == .text || t->kind == .block;
    if (same(name, "is_array")) return t->kind == .array;
    if (same(name, "is_record")) return t->kind == .record;
    if (same(name, "is_pointer")) return t->kind == .pointer;
    if (same(name, "is_integer")) return t->kind == .integer;
    if (same(name, "is_float")) return t->kind == .floating;
    if (same(name, "is_signed")) return t->kind == .integer && t->is_signed;
    if (same(name, "is_bool")) return t->kind == .bool_type;
    return t->kind == .enumeration;
}

// The entry named `name`; false when it is not a builtin of the table.
export Bool find(Str name, Entry *found) {
    if (same(name, "__builtin_add_overflow")) {
        *found = made(name, .overflow, "add");
    } else if (same(name, "__builtin_sub_overflow")) {
        *found = made(name, .overflow, "sub");
    } else if (same(name, "__builtin_mul_overflow")) {
        *found = made(name, .overflow, "mul");
    } else if (same(name, "__builtin_bit_cast")) {
        *found = made(name, .bit_cast, "");
    } else if (same(name, "__builtin_assume")) {
        *found = made(name, .assume, "assume");
    } else if (same(name, "__builtin_trap")) {
        *found = made(name, .trap, "trap");
    } else if (same(name, "__builtin_elementwise_sqrt") || same(name, "__builtin_sqrt")) {
        *found = made(name, .float_unary, "sqrt");
    } else if (same(name, "__builtin_elementwise_sin")) {
        *found = made(name, .float_unary, "sin");
    } else if (same(name, "__builtin_elementwise_cos")) {
        *found = made(name, .float_unary, "cos");
    } else if (same(name, "__builtin_floor") || same(name, "__builtin_floorf")) {
        *found = made(name, .float_unary, "floor");
    } else if (same(name, "__builtin_fabs") || same(name, "__builtin_fabsf")) {
        *found = made(name, .float_unary, "fabs");
    } else if (same(name, "__builtin_elementwise_pow")) {
        *found = made(name, .float_binary, "pow");
    } else if (same(name, "__builtin_elementwise_minnum")) {
        *found = made(name, .float_binary, "minnum");
    } else if (same(name, "__builtin_elementwise_maxnum")) {
        *found = made(name, .float_binary, "maxnum");
    } else if (same(name, "__builtin_elementwise_abs")) {
        *found = made(name, .absolute, "abs");
    } else if (same(name, "__builtin_elementwise_min")) {
        *found = made(name, .smallest, "min");
    } else if (same(name, "__builtin_isnan")) {
        *found = made(name, .predicate, "isnan");
    } else if (same(name, "__builtin_isfinite")) {
        *found = made(name, .predicate, "isfinite");
    } else if (same(name, "__builtin_inf")) {
        *found = made(name, .constant, "inf64");
    } else if (same(name, "__builtin_inff")) {
        *found = made(name, .constant, "inf32");
    } else if (same(name, "__builtin_nan")) {
        *found = made(name, .constant, "nan64");
    } else if (same(name, "__builtin_nanf")) {
        *found = made(name, .constant, "nan32");
    } else if (is_query(name)) {
        *found = made(name, .type_query, name);
    } else {
        return find_libc(name, found);
    }
    return true;
}

// Whether the callee is `<module>.<name>`, `name` read through a module that `import <module>` bound.
static Bool names_std(const types::Checked *c, const ast::Expr *callee, Str module_path, Str name) {
    types::Names names = {};
    if (callee->kind == .member && !callee->kind.member.arrow) {
        names = types::member_names(callee);
    } else if (callee->kind == .name) {
        ast::Path path = callee->kind.name.path;
        if (countof(path.segments) != 2) return false;
        names = (types::Names){.count = 2, .items = {path.segments[0].text, path.segments[1].text}};
    }
    if (names.count != 2 || !same(names.items[1], name)) return false;
    const types::Symbol *module = types::scoped(c, names.items[0]);
    return module != nullptr && module->kind == .module_name && same(types::module_dotted(module), module_path);
}

static Bool names_filled(const types::Checked *c, const ast::Expr *callee) {
    return names_std(c, callee, "std.array", "filled");
}

// Whether a call of `callee` with that many arguments is `arena.push_slice(&a, T, n)` or `arena.push_slice(&a, T,
// [a, b])` of std.arena: the same bridge as `mem.alloc`'s, for the same reason (arena.smith's `slice_of`, #2539).
export Bool names_push_slice(const types::Checked *c, const ast::Expr *callee, Usize arguments) {
    return arguments == 3 && names_std(c, callee, "std.arena", "push_slice");
}

// Whether a call of `callee` with that many arguments is `mem.alloc(T, n)` or `mem.alloc(T, [a, b])` of std.mem, where
// `mem.alloc(T)` is the function of std.mem returning `*mut T`. A bridge while lib/std/mem.smith is in today's syntax,
// which has no one function for both forms: #2539 makes `mem.alloc` an ordinary generic of mem.smith and deletes this
// (#2527).
export Bool names_alloc(const types::Checked *c, const ast::Expr *callee, Usize arguments) {
    return (arguments == 2 && names_std(c, callee, "std.mem", "alloc")) || names_push_slice(c, callee, arguments);
}

// The builtin a call's callee names, when it is one: a single plain name that no scope declares, or `array.filled`.
export Bool callee_entry(const types::Checked *c, const ast::Expr *callee, Entry *found) {
    if (names_filled(c, callee)) {
        *found = made("array.filled", .filled, "");
        return true;
    }
    if (callee->kind != .name) return false;
    ast::Path path = callee->kind.name.path;
    if (countof(path.segments) != 1) return false;
    if (!find(path.segments[0].text, found)) return false;
    return types::lookup_path(&c->scopes, path) == nullptr;
}

// The builtin a call names: `mem.alloc` with a size, or the builtin of its callee (`callee_entry`).
export Bool call_entry(const types::Checked *c, const ast::Expr *call, Entry *found) {
    if (call->kind == .call && names_alloc(c, call->kind.call.callee, countof(call->kind.call.args))) {
        Bool arena = names_push_slice(c, call->kind.call.callee, countof(call->kind.call.args));
        *found = made(arena ? "arena.push_slice" : "mem.alloc", .alloc, "");
        return true;
    }
    return call->kind == .call && callee_entry(c, call->kind.call.callee, found);
}

// Whether the argument `index` of the builtin is not a value: a type (read as a type, not typed as a value), the
// tag string of `nan`, which is ignored, or the memory order of an atomic, a predefined macro the checker reads.
export Bool is_type_argument(Entry entry, Usize index) {
    if (entry.shape == .alloc) return index == (same(entry.name, "arena.push_slice") ? 1 : 0); // T after the arena
    if (entry.shape == .bit_cast || entry.shape == .filled || entry.shape == .type_query) return index == 0;
    if (entry.shape == .atomic_add) return index == 2;
    return entry.shape == .constant && same(entry.intrinsic[0:3], "nan") && index == 0;
}

// The type written as argument of a builtin: a name of a type, or a type written as a value.
static types::TypeRef type_argument(types::Checked *c, const ast::Expr *arg, Str callee_name) {
    if (arg->kind == .name) {
        const types::Symbol *s = types::lookup_path(&c->scopes, arg->kind.name.path);
        if (s != nullptr && s->kind == .type_name) return s->type;
        if (s == nullptr) {
            ast::TypeExpr *written = mem::alloc(ast::TypeExpr);
            written->span = arg->span;
            written->kind = {.named = {.path = arg->kind.name.path}};
            Usize errors = c->error_count;
            c->new_syntax = true;
            types::TypeRef t = types::resolve(c, written);
            c->new_syntax = false;
            c->error_count = errors;
            if (t != c->table.invalid) return t;
        }
    } else if (arg->kind == .type_value) {
        c->new_syntax = true;
        types::TypeRef t = types::resolve(c, arg->kind.type_value.type);
        c->new_syntax = false;
        if (t != c->table.invalid) return t;
        return nullptr;
    }
    types::failf(c, arg->span, "the first argument of `", callee_name, "` is a type; write a type such as `u64`");
    return nullptr;
}

static types::TypeRef value_type(const types::Checked *c, const ast::Expr *x) {
    types::TypeRef t = types::type_of(c, x);
    if (t == nullptr) return c->table.invalid;
    return t;
}

// A type that is not known yet: a parameter of a concept (`Int a`) or of `auto`, checked again for each instance.
static Bool is_open(types::TypeRef t) {
    return t->kind == .concept_type || t->kind == .automatic;
}

static Bool is_number(types::TypeRef t) {
    return t->kind == .integer || t->kind == .floating;
}

static types::TypeRef wrong(types::Checked *c, ast::Span span, Entry entry, Str wanted) {
    types::failf(c, span, "`", entry.name, "` takes ", wanted);
    return c->table.invalid;
}

static types::TypeRef check_overflow(types::Checked *c, const ast::Expr *e, Entry entry, ast::ExprRef args[:]) {
    Str wanted = "two integers of one type and a pointer to a third of that type; write `(a, b, &result)`";
    if (countof(args) != 3) return wrong(c, e->span, entry, wanted);
    types::TypeRef a = value_type(c, args[0]);
    types::TypeRef b = value_type(c, args[1]);
    types::TypeRef r = value_type(c, args[2]);
    if (a == c->table.invalid || b == c->table.invalid || r == c->table.invalid) return c->table.invalid;
    if (is_open(a) || is_open(b)) return c->table.bool_type;
    if (a->kind != .integer || b != a || r->kind != .pointer || r->element != a)
        return wrong(c, e->span, entry, wanted);
    return c->table.bool_type;
}

static types::TypeRef check_bit_cast(types::Checked *c, const ast::Expr *e, Entry entry, ast::ExprRef args[:]) {
    if (countof(args) != 2) return wrong(c, e->span, entry, "a type and a value; write `(u64, x)`");
    types::TypeRef to = type_argument(c, args[0], entry.name);
    if (to == nullptr) return c->table.invalid;
    if (value_type(c, args[1]) == c->table.invalid) return c->table.invalid;
    return to;
}

static types::TypeRef check_numbers(types::Checked *c, const ast::Expr *e, Entry entry, ast::ExprRef args[:],
                                    Usize count, Bool floats_only) {
    Str wanted = floats_only ? "floating-point arguments of one type" : "numbers of one type";
    if (countof(args) != count) return wrong(c, e->span, entry, wanted);
    types::TypeRef first = value_type(c, args[0]);
    for (Usize i = 0; i < count; i++) {
        types::TypeRef t = value_type(c, args[i]);
        if (t == c->table.invalid) return c->table.invalid;
        if (is_open(t) || is_open(first)) continue;
        Bool kind_ok = floats_only ? t->kind == .floating : is_number(t);
        if (!kind_ok || t != first) return wrong(c, e->span, entry, wanted);
    }
    return first;
}

static types::TypeRef check_constant(types::Checked *c, const ast::Expr *e, Entry entry, ast::ExprRef args[:]) {
    Bool tagged = same(entry.intrinsic[0:3], "nan");
    if (countof(args) != (tagged ? 1 : 0))
        return wrong(c, e->span, entry, tagged ? "a tag string; write `(\"\")`" : "no arguments");
    return types::float_of_width(&c->table, same(entry.intrinsic[3:5], "32") ? 32 : 64);
}

// The built-in type called `name` (`I32`, `Usize`), read from the table: the checker's own lookup, without a call
// into a header (a pointer-returning function of another module needs an ownership idiom in the lint's table).
static types::TypeRef named(const types::Checked *c, Str name) {
    for (Usize i = 0; i < countof(c->table.builtins); i++) {
        if (same(c->table.builtins[i].name, name)) return c->table.builtins[i].type;
    }
    return c->table.invalid;
}

// A libc-shaped builtin (`__builtin_memcpy`, `__builtin_strlen`): its entry's text is `<libc name> <parameters>
// <result>` with one letter each: `p` a pointer, `z` a 64-bit unsigned integer (a Usize), `i` an integer (I32 as a
// result), `d` an F64, `f` an F32; as a result, `p` is the type of the first argument and `v` is Void (the copy
// functions' pointer result is never used). The call lowers to a call of the libc function.
export Str libc_name(Entry entry) {
    Usize end = 0;
    while (entry.intrinsic[end] != ' ')
        end += 1;
    return entry.intrinsic[0:end];
}

export Str libc_params(Entry entry) {
    Usize start = countof(libc_name(entry)) + 1;
    Usize end = start;
    while (entry.intrinsic[end] != ' ')
        end += 1;
    return entry.intrinsic[start:end];
}

export U8 libc_result(Entry entry) {
    return (U8)entry.intrinsic[countof(entry.intrinsic) - 1];
}

// The type a letter of a libc builtin's signature stands for, given the type of the first argument.
export types::TypeRef libc_type(const types::Checked *c, U8 letter, types::TypeRef first) {
    if (letter == 'p') return first;
    if (letter == 'v') return c->table.void_type;
    if (letter == 'z') return named(c, "Usize");
    if (letter == 'i') return named(c, "I32");
    return types::float_of_width(&c->table, letter == 'd' ? 64 : 32);
}

// A pointer that may be null (`?*T`): C's libc functions take it where they take a pointer.
static Bool is_pointer_option(types::TypeRef t) {
    return t->kind == .option && t->element != nullptr && t->element->kind == .pointer;
}

static Bool letter_fits(U8 letter, types::TypeRef t, types::TypeRef want) {
    if (is_open(t)) return true;
    if (letter == 'p') return t->kind == .pointer || is_pointer_option(t);
    if (letter == 'z' || letter == 'i') return t->kind == .integer;
    return t == want;
}

// A fixed array handed where a bare pointer to its element is wanted (C's decay): the fix writes the address of its
// first element, `xs` to `&xs[0]`. Empty unless the array is a place (a name, a member, an element).
export syntax::Edits element_address_fix(const ast::Expr *e) {
    syntax::Edits edits = {};
    if (e->kind != .name && e->kind != .member && e->kind != .index) return edits;
    Str open = "&";
    Str close = "[0]";
    edits = mem::realloc(edits, 2);
    edits[0] = (syntax::Edit){.span = {.start = e->span.start, .end = e->span.start}, .text = open};
    edits[1] = (syntax::Edit){.span = {.start = e->span.end, .end = e->span.end}, .text = close};
    return edits;
}

static types::TypeRef check_libc(types::Checked *c, const ast::Expr *e, Entry entry, ast::ExprRef args[:]) {
    Str params = libc_params(entry);
    Str wanted = "arguments of the types of the C function";
    if (countof(args) != countof(params)) return wrong(c, e->span, entry, wanted);
    types::TypeRef first = nullptr;
    for (Usize i = 0; i < countof(args); i++) {
        types::TypeRef t = value_type(c, args[i]);
        if (t == c->table.invalid) return c->table.invalid;
        if (i == 0) first = t;
        if (params[i] == 'p' && t->kind == .array) {
            types::fail_fix(c, args[i]->span,
                            "a fixed array never converts to a bare pointer; write the address of an element: &xs[0]",
                            element_address_fix(args[i]));
            return c->table.invalid;
        }
        if (!letter_fits((U8)params[i], t, libc_type(c, (U8)params[i], first))) return wrong(c, e->span, entry, wanted);
    }
    U8 result = libc_result(entry);
    if (result == 'p' && first->kind != .pointer && !is_pointer_option(first)) return c->table.invalid;
    return libc_type(c, result, first);
}

// The type a format argument of `__builtin_snprintf` is expected to have, so that a literal is a C string: `const Char
// *`.
export types::TypeRef format_pointer(types::Checked *c) {
    return types::pointer_to(&c->table, types::builtin(&c->table, "Char"), true);
}

// `__builtin_snprintf(out, n, format, rest...)`: a pointer, a size, a format and any number of integers, floats and
// pointers; the result is an I32.
static types::TypeRef check_format(types::Checked *c, const ast::Expr *e, Entry entry, ast::ExprRef args[:]) {
    Str wanted = "a pointer, a size, a format and integers, floats or pointers";
    if (countof(args) < 3) return wrong(c, e->span, entry, wanted);
    for (Usize i = 0; i < countof(args); i++) {
        types::TypeRef t = value_type(c, args[i]);
        if (t == c->table.invalid) return c->table.invalid;
        if (is_open(t)) continue;
        Bool pointer = t->kind == .pointer;
        Bool integer = t->kind == .integer;
        if (t->kind == .array && i != 1) { // a `%s` argument too: the array decays in C (#2611)
            types::fail_fix(c, args[i]->span,
                            "a fixed array never converts to a bare pointer; write the address of an element: &xs[0]",
                            element_address_fix(args[i]));
            return c->table.invalid;
        }
        if (i == 1 ? !integer : (i == 0 || i == 2) ? !pointer : !(pointer || integer || t->kind == .floating)) {
            types::failf(c, args[i]->span, "`", entry.name, "` takes ", wanted, ", found ", types::show(t));
            return c->table.invalid;
        }
    }
    return named(c, "I32");
}

// Whether `t` is the type of `__builtin_va_list`.
static Bool is_va_list(const types::Checked *c, types::TypeRef t) {
    return t == types::builtin(&c->table, "__builtin_va_list");
}

// `__builtin_va_start(list, last)`, `__builtin_va_end(list)` and `__builtin_vsnprintf(out, n, format, list)`: the list
// is a `__builtin_va_list` variable, passed by its address.
static types::TypeRef check_va(types::Checked *c, const ast::Expr *e, Entry entry, ast::ExprRef args[:]) {
    Bool format = entry.shape == .va_format;
    Usize count = format ? 4 : entry.shape == .va_start ? 2 : 1;
    Str wanted = format ? "a pointer, a size, a format and a `__builtin_va_list`"
                        : "a `__builtin_va_list` variable (and, for va_start, the last named parameter)";
    if (countof(args) != count) return wrong(c, e->span, entry, wanted);
    types::TypeRef list = value_type(c, args[count == 4 ? 3 : 0]);
    if (list == c->table.invalid) return c->table.invalid;
    if (is_open(list)) return c->table.invalid;
    if (!is_va_list(c, list)) return wrong(c, e->span, entry, wanted);
    if (!format) return c->table.void_type;
    types::TypeRef out = value_type(c, args[0]);
    types::TypeRef size = value_type(c, args[1]);
    types::TypeRef text = value_type(c, args[2]);
    for (Usize i = 0; i < 3; i += 2) { // an array argument decays in C: write the address of an element
        types::TypeRef t = i == 0 ? out : text;
        if (t->kind != .array) continue;
        types::fail_fix(c, args[i]->span,
                        "a fixed array never converts to a bare pointer; write the address of an element: &xs[0]",
                        element_address_fix(args[i]));
        return c->table.invalid;
    }
    if (out->kind != .pointer || size->kind != .integer || text->kind != .pointer)
        return wrong(c, e->span, entry, wanted);
    return named(c, "I32");
}

// `__atomic_fetch_add(p, n, order)`: adds the integer `n` to what the pointer `p` points to and gives the old value.
// The memory order is the macro `__ATOMIC_RELAXED`, the only one the emitter lowers (a monotonic `atomicrmw`).
static types::TypeRef check_atomic_add(types::Checked *c, const ast::Expr *e, Entry entry, ast::ExprRef args[:]) {
    Str wanted = "a pointer to an integer, an integer and a memory order";
    if (countof(args) != 3) return wrong(c, e->span, entry, wanted);
    types::TypeRef p = value_type(c, args[0]);
    types::TypeRef n = value_type(c, args[1]);
    if (p == c->table.invalid || n == c->table.invalid) return c->table.invalid;
    if (is_open(p) || is_open(n)) return c->table.invalid;
    const ast::Expr *order = args[2];
    if (order->kind != .name || countof(order->kind.name.path.segments) != 1 ||
        !same(order->kind.name.path.segments[0].text, "__ATOMIC_RELAXED"))
        return wrong(c, e->span, entry,
                     "a pointer to an integer, an integer and `__ATOMIC_RELAXED`, the one order smith lowers");
    if (p->kind != .pointer || p->element->kind != .integer || n->kind != .integer)
        return wrong(c, e->span, entry, wanted);
    return p->element;
}

// The element type `array.filled` is called with (its first argument), for the checker to expect of the value; null
// when the call is malformed (`check` reports it).
export types::TypeRef filled_element(types::Checked *c, const ast::Expr *e) {
    if (e->kind != .call) return nullptr;
    ast::ExprRef args[:] = e->kind.call.args;
    if (countof(args) != 3) return nullptr;
    Usize errors = c->error_count;
    types::TypeRef t = type_argument(c, args[0], "array.filled");
    c->error_count = errors;
    return t;
}

// The constant `node` of one dimension of `array.filled`; false, with the error reported, when it is not one.
static Bool filled_dimension(types::Checked *c, const ast::Expr *node, U64 *count) {
    if (types::fold_length(c, node, count)) return true;
    types::fail(c, node->span,
                "the length of `array.filled` is a constant: an integer, a `const` or arithmetic on them");
    return false;
}

// `array.filled(T, n, value)`: `[n]T`; `array.filled(T, [a, b], value)`: `[a, b]T`, the same type as `[a][b]T`, with
// `value` of type `T`. Each dimension folds to a constant; `value` has the type `T`. The length recorded on the call is
// the outermost dimension.
static types::TypeRef check_filled(types::Checked *c, const ast::Expr *e, Entry entry, ast::ExprRef args[:]) {
    Str wanted = "a type, a constant length or shape and a value; write `(u32, 256, 0)` or `(u32, [4, 8], 0)`";
    if (countof(args) != 3) return wrong(c, e->span, entry, wanted);
    types::TypeRef element = type_argument(c, args[0], entry.name);
    if (element == nullptr) return c->table.invalid;
    U64 dims[16];
    Usize rank = 0;
    const ast::Expr *length = args[1];
    if (length->kind == .array_lit) {
        ast::ExprRef items[:] = length->kind.array_lit.items;
        if (countof(items) == 0 || countof(items) > 16) return wrong(c, e->span, entry, wanted);
        for (Usize i = 0; i < countof(items); i++) {
            if (!filled_dimension(c, items[i], &dims[i])) return c->table.invalid;
        }
        rank = countof(items);
    } else {
        if (!filled_dimension(c, args[1], &dims[0])) return c->table.invalid;
        rank = 1;
    }
    types::TypeRef value = value_type(c, args[2]);
    if (value == c->table.invalid) return c->table.invalid;
    if (value != element) {
        types::failf(c, args[2]->span, "`array.filled` needs a value of type ", types::show(element), ", found ",
                     types::show(value));
        return c->table.invalid;
    }
    types::TypeRef made_type = element;
    for (Usize i = rank; i > 0; i--)
        made_type = types::array_of(&c->table, made_type, dims[i - 1], false);
    types::set_length(c, e, dims[0]);
    return made_type;
}

// The type the sizes of `mem.alloc(T, n)` and `mem.alloc(T, [a, b])` are given: `usize`.
export types::TypeRef size_type(const types::Checked *c) {
    return named(c, "Usize");
}

// `mem.alloc(T, n)`: `[]T` of n zeroed elements; `mem.alloc(T, [a, b])`: one zeroed block `[,]T`, a comma for each
// size after the first. The sizes are integers known at run time. `arena.push_slice(&a, T, ...)` the same, in `a`.
static types::TypeRef check_alloc(types::Checked *c, const ast::Expr *e, Entry entry, ast::ExprRef args[:]) {
    Usize first = same(entry.name, "arena.push_slice") ? 1 : 0;
    Str wanted = first == 1 ? "an arena, a type and a size or a shape; write `(&a, u8, n)` or `(&a, f64, [rows, cols])`"
                            : "a type and a size or a shape; write `(u8, n)` or `(f64, [rows, cols])`";
    if (countof(args) != first + 2) return wrong(c, e->span, entry, wanted);
    types::TypeRef arena = first == 1 ? value_type(c, args[0]) : nullptr;
    if (arena != nullptr && arena->kind != .pointer) return wrong(c, e->span, entry, wanted);
    types::TypeRef element = type_argument(c, args[first], entry.name);
    if (element == nullptr) return c->table.invalid;
    const ast::Expr *shape = args[first + 1];
    Usize rank = 1;
    if (shape->kind == .array_lit) {
        rank = countof(shape->kind.array_lit.items);
        if (rank == 0 || rank > 16) return wrong(c, e->span, entry, wanted);
    }
    for (Usize i = 0; i < rank; i++) {
        const ast::Expr *size = shape->kind == .array_lit ? shape->kind.array_lit.items[i] : shape;
        types::TypeRef t = value_type(c, size);
        if (t == c->table.invalid) return c->table.invalid;
        if (t->kind != .integer) {
            types::failf(c, size->span, "a size of `", entry.name, "` is an integer, found ", types::show(t));
            return c->table.invalid;
        }
    }
    if (rank == 1) return types::slice_of(&c->table, element, false);
    return types::block_of(&c->table, element, rank);
}

// The type of a call of the builtin, once its arguments are typed (a type argument is read here); the invalid type,
// with the error reported, when the arguments do not fit.
export types::TypeRef check(types::Checked *c, const ast::Expr *e, Entry entry) {
    if (e->kind != .call) return c->table.invalid;
    ast::ExprRef args[:] = e->kind.call.args;
    switch (entry.shape) {
    case .overflow:
        return check_overflow(c, e, entry, args);
    case .bit_cast:
        return check_bit_cast(c, e, entry, args);
    case .assume:
        if (countof(args) != 1 || value_type(c, args[0]) != c->table.bool_type)
            return wrong(c, e->span, entry, "one Bool; write `(x > 0)`");
        return c->table.void_type;
    case .trap:
        if (countof(args) != 0) return wrong(c, e->span, entry, "no arguments");
        return c->table.void_type;
    case .float_unary:
        return check_numbers(c, e, entry, args, 1, true);
    case .float_binary:
        return check_numbers(c, e, entry, args, 2, true);
    case .absolute:
        return check_numbers(c, e, entry, args, 1, false);
    case .smallest:
        return check_numbers(c, e, entry, args, 2, false);
    case .constant:
        return check_constant(c, e, entry, args);
    case .libc:
        return check_libc(c, e, entry, args);
    case .format:
        return check_format(c, e, entry, args);
    case .filled:
        return check_filled(c, e, entry, args);
    case .alloc:
        return check_alloc(c, e, entry, args);
    case .type_query:
        if (countof(args) != 1) return wrong(c, e->span, entry, "one type; write `(typeof(x))`");
        if (type_argument(c, args[0], entry.name) == nullptr) return c->table.invalid;
        return c->table.bool_type;
    case .atomic_add:
        return check_atomic_add(c, e, entry, args);
    case .va_start:
    case .va_end:
    case .va_format:
        return check_va(c, e, entry, args);
    case .frame_address:
        if (countof(args) != 1) return wrong(c, e->span, entry, "one integer, the depth; write `(0)`");
        types::TypeRef depth = value_type(c, args[0]);
        if (depth->kind != .integer) return wrong(c, e->span, entry, "one integer, the depth; write `(0)`");
        return types::pointer_to(&c->table, c->table.void_type, false);
    case .count_zeros:
        if (countof(args) != 1 || value_type(c, args[0]) != named(c, "U64")) return wrong(c, e->span, entry, "one U64");
        return named(c, "I32");
    case .predicate:
        if (check_numbers(c, e, entry, args, 1, true) == c->table.invalid) return c->table.invalid;
        return c->table.bool_type;
    }
    return c->table.invalid;
}

// Whether the expression is a call of a question about a type, with its answer for the type it is asked of. False
// when it is no such call, or the type is not known yet (a parameter of a concept or `auto`).
export Bool query_value(types::Checked *c, const ast::Expr *e, Bool *value) {
    Entry entry = {};
    if (e->kind != .call || !callee_entry(c, e->kind.call.callee, &entry) || entry.shape != .type_query) return false;
    ast::ExprRef args[:] = e->kind.call.args;
    if (countof(args) != 1) return false;
    Usize errors = c->error_count;
    types::TypeRef t = type_argument(c, args[0], entry.name);
    c->error_count = errors;
    if (t == nullptr || t == c->table.invalid || is_open(t)) return false;
    *value = answer(entry.name, t);
    return true;
}
