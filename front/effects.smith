// front::effects: effect inference in smith's own checker (#1966, piece 2 of #1939, part of #1631). The sets are the
// ones the plugin (shim/effects_infer.cpp) gives for the same function; the bits and the libc table are
// front::effects_table. Skill smith-lang-effects, knowledge/effect-inference.md.
//
//   infer(r, m)        The effects of every function of module `m` that has a body or an effects attribute, to a
//                      fixed point over the module's call graph. `r` is the module as checked (types::Checked).
//   set_of(e, name)    The set of the function `name` (false when the module has no such function).
//   cause_of(e, i, b)  The first call that added bit `b` to function `i` (null when it is the function's own).
//
// WHAT A CALL IS
//   a function of the module      its set (the fixed point); a body-less one with `@effects(..)` or `@pure` has
//                                 the attribute's set (a promise)
//   `c::name`                     the set of front::effects_table, `unknown` for a name the table lacks
//   anything else                 `unknown`: a call through a value, a function of another module (not yet typed here)
//   a method call `x.f(a)`        the call it stands for (types::method_of)
//   `contract::...`               `fails`
// OTHER WAYS TO GET A BIT
//   a slice index                 `fails` (a checked index; a proof removing it is not read here)
//   a write to a global           `globals` (a name the module declares at the top level, or a local `static`)
//
// No recursion: a body is walked with a work stack, and the fixed point is a loop.
module front::effects;

import front::ast;
import front::effects_table;
import front::types;
import std::mem;

// A call that added a bit: where it is, and what it calls.
export struct Cause {
    const ast::Expr *at; // the call, the slice index or the write (null: the bit is not set)
    Str callee;          // the name called ("" for an index or a write)
};

// One function of the module.
export struct Entry {
    Str name;
    const ast::Decl *decl;
    U32 set;
    Cause causes[13]; // the first thing that added each bit
};

export struct Effects {
    Entry entries[:];
    Usize count;
};

// One call of a function of the module, kept for the fixed point.
struct Edge {
    Usize from;
    Usize to;
    const ast::Expr *at;
};

struct Item {
    const ast::Stmt *stmt;
    const ast::Expr *expr;
};

struct Work {
    Item items[:];
    Usize top;
};

struct Graph {
    Edge edges[:];
    Usize count;
};

static Bool same(Str a, Str b) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

static void push(Work *w, const ast::Stmt *stmt, const ast::Expr *expr) {
    if (stmt == nullptr && expr == nullptr) return;
    if (w->top == countof(w->items)) {
        Usize capacity = countof(w->items) * 2;
        if (capacity < 32) capacity = 32;
        w->items = mem::realloc(w->items, capacity);
    }
    w->items[w->top] = (Item){.stmt = stmt, .expr = expr};
    w->top += 1;
}

static void push_exprs(Work *w, ast::ExprRef list[:]) {
    for (Usize i = 0; i < countof(list); i++)
        push(w, nullptr, list[i]);
}

static void push_stmts(Work *w, ast::StmtRef list[:]) {
    for (Usize i = 0; i < countof(list); i++)
        push(w, list[i], nullptr);
}

// ---------------------------------------------------------------------------------------------------------------
// The module's functions and globals

static Usize entry_index(const Effects *e, Str name) {
    for (Usize i = 0; i < e->count; i++) {
        if (same(e->entries[i].name, name)) return i;
    }
    return e->count;
}

static void add_entry(Effects *e, Str name, const ast::Decl *decl) {
    if (e->count == countof(e->entries)) {
        Usize capacity = countof(e->entries) * 2;
        if (capacity < 16) capacity = 16;
        e->entries = mem::realloc(e->entries, capacity);
    }
    e->entries[e->count] = (Entry){.name = name, .decl = decl};
    e->count += 1;
}

// The bit named by an attribute argument: `alloc`, `.alloc` or `effects::alloc`. Everything is `everything` when the
// name is no bit.
static U32 bit_named(Str name) {
    for (Usize i = 0; i < effects_table::bit_count; i++) {
        if (same(name, effects_table::bit_name(i))) return 1u << i;
    }
    return 0;
}

static U32 bit_of_arg(const ast::Expr *a) {
    if (a->kind == .variant) return bit_named(a->kind.variant.name);
    if (a->kind == .name) {
        ast::Identifier segments[:] = a->kind.name.path.segments;
        return bit_named(segments[countof(segments) - 1].text);
    }
    return 0;
}

// The set a declaration states, with `declared` false when it has no `@pure` and no `@effects`.
static U32 declared_set(const ast::Decl *d, Bool *declared) {
    U32 set = 0;
    *declared = false;
    for (Usize i = 0; i < countof(d->attributes); i++) {
        ast::Identifier segments[:] = d->attributes[i].name.segments;
        if (countof(segments) == 0) continue;
        Str last = segments[countof(segments) - 1].text;
        if (same(last, "pure")) {
            *declared = true;
        } else if (same(last, "effects")) {
            *declared = true;
            ast::ExprRef args[:] = d->attributes[i].args;
            for (Usize k = 0; k < countof(args); k++)
                set |= bit_of_arg(args[k]);
        }
    }
    return set;
}

static Bool is_global_name(const ast::Module *m, Str name) {
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind == .variable && !d->from_c && same(d->kind.variable.name, name)) return true;
    }
    return false;
}

// ---------------------------------------------------------------------------------------------------------------
// What one body does

struct Local {
    Str name;
};

struct Scan {
    const types::Checked *checked;
    const ast::Module *module;
    Effects *effects;
    Graph *graph;
    Usize self;
    Local locals[:]; // names declared in the body: they hide a global of the same name
    Usize local_count;
};

static void add_bit(Scan *s, U32 bits, const ast::Expr *at, Str callee) {
    Entry *entry = &s->effects->entries[s->self];
    for (Usize i = 0; i < effects_table::bit_count; i++) {
        if ((bits & (1u << i)) == 0 || (entry->set & (1u << i)) != 0) continue;
        entry->set |= 1u << i;
        entry->causes[i] = (Cause){.at = at, .callee = callee};
    }
}

static void add_edge(Graph *g, Edge edge) {
    if (g->count == countof(g->edges)) {
        Usize capacity = countof(g->edges) * 2;
        if (capacity < 32) capacity = 32;
        g->edges = mem::realloc(g->edges, capacity);
    }
    g->edges[g->count] = edge;
    g->count += 1;
}

static Str last_of(ast::Path path) {
    return path.segments[countof(path.segments) - 1].text;
}

// A call by name: `f(x)` or `c::name(x)`.
static void call_by_name(Scan *s, const ast::Expr *call, ast::Path path) {
    Usize n = countof(path.segments);
    if (n == 1) {
        Usize to = entry_index(s->effects, path.segments[0].text);
        if (to < s->effects->count) {
            add_edge(s->graph, (Edge){.from = s->self, .to = to, .at = call});
            return;
        }
    }
    Str callee = last_of(path);
    if (n == 2 && same(path.segments[0].text, "c")) {
        U32 set = 0;
        if (effects_table::leaf(callee, &set)) {
            add_bit(s, set, call, callee);
        } else {
            add_bit(s, effects_table::unknown, call, callee);
        }
    } else if (n >= 2 && same(path.segments[0].text, "contract")) {
        add_bit(s, effects_table::fails, call, callee);
    } else {
        add_bit(s, effects_table::unknown, call, callee);
    }
}

static void call(Scan *s, Work *w, const ast::Expr *e, const ast::Expr *callee, ast::ExprRef args[:]) {
    const ast::Expr *method = types::method_of(s->checked, e);
    if (method != nullptr) {
        push(w, nullptr, method);
        return;
    }
    if (callee->kind == .name) {
        call_by_name(s, e, callee->kind.name.path);
    } else {
        add_bit(s, effects_table::unknown, e, "");
        push(w, nullptr, callee);
    }
    push_exprs(w, args);
}

static const ast::Expr *root_of(const ast::Expr *e) {
    while (e != nullptr) {
        if (e->kind == .index) {
            e = e->kind.index.base;
        } else if (e->kind == .member && !e->kind.member.arrow) {
            e = e->kind.member.base;
        } else {
            break;
        }
    }
    return e;
}

static Bool is_local(const Scan *s, Str name) {
    for (Usize i = 0; i < s->local_count; i++) {
        if (same(s->locals[i].name, name)) return true;
    }
    return false;
}

static void assignment(Scan *s, Work *w, const ast::Expr *e, const ast::Expr *target, const ast::Expr *value) {
    const ast::Expr *root = root_of(target);
    if (root != nullptr && root->kind == .name && countof(root->kind.name.path.segments) == 1) {
        Str name = root->kind.name.path.segments[0].text;
        if (is_global_name(s->module, name) && !is_local(s, name)) add_bit(s, effects_table::globals, e, "");
    }
    push(w, nullptr, target);
    push(w, nullptr, value);
}

static void index(Scan *s, Work *w, const ast::Expr *e, const ast::Expr *base_expr, const ast::Expr *at) {
    types::TypeRef base = types::type_of(s->checked, base_expr);
    if (base != nullptr && base->kind == .slice) add_bit(s, effects_table::fails, e, "");
    push(w, nullptr, base_expr);
    push(w, nullptr, at);
}

static void operands(Work *w, const ast::Expr *e) {
    if (e->kind == .binary) {
        push(w, nullptr, e->kind.binary.left);
        push(w, nullptr, e->kind.binary.right);
    } else if (e->kind == .unary) {
        push(w, nullptr, e->kind.unary.operand);
    } else if (e->kind == .conditional) {
        push(w, nullptr, e->kind.conditional.condition);
        push(w, nullptr, e->kind.conditional.then_value);
        push(w, nullptr, e->kind.conditional.else_value);
    } else if (e->kind == .slice_of) {
        push(w, nullptr, e->kind.slice_of.base);
        push(w, nullptr, e->kind.slice_of.start);
        push(w, nullptr, e->kind.slice_of.end);
    } else if (e->kind == .member) {
        push(w, nullptr, e->kind.member.base);
    } else if (e->kind == .cast) {
        push(w, nullptr, e->kind.cast.operand);
    } else if (e->kind == .variant) {
        push(w, nullptr, e->kind.variant.payload);
    } else if (e->kind == .try_expr) {
        push(w, nullptr, e->kind.try_expr.operand);
    } else if (e->kind == .named_arg) {
        push(w, nullptr, e->kind.named_arg.value);
    } else if (e->kind == .expand) {
        push(w, nullptr, e->kind.expand.pattern);
    } else if (e->kind == .tuple_lit) {
        push_exprs(w, e->kind.tuple_lit.items);
    } else if (e->kind == .array_lit) {
        push_exprs(w, e->kind.array_lit.items);
    } else if (e->kind == .compound) {
        for (Usize i = 0; i < countof(e->kind.compound.items); i++)
            push(w, nullptr, e->kind.compound.items[i].value);
    } else if (e->kind == .stmt_expr) {
        push(w, e->kind.stmt_expr.stmt, nullptr);
    }
}

static void expression(Scan *s, Work *w, const ast::Expr *e) {
    if (e->kind == .call) {
        call(s, w, e, e->kind.call.callee, e->kind.call.args);
    } else if (e->kind == .assign) {
        assignment(s, w, e, e->kind.assign.target, e->kind.assign.value);
    } else if (e->kind == .index) {
        index(s, w, e, e->kind.index.base, e->kind.index.index);
    } else {
        operands(w, e);
    }
}

static void note_local(Scan *s, Str name) {
    if (s->local_count == countof(s->locals)) {
        Usize capacity = countof(s->locals) * 2;
        if (capacity < 16) capacity = 16;
        s->locals = mem::realloc(s->locals, capacity);
    }
    s->locals[s->local_count] = (Local){.name = name};
    s->local_count += 1;
}

static void declaration(Scan *s, Work *w, const ast::Decl *d) {
    if (!(d->kind == .variable)) return;
    // A function-local `static` is global state, whatever its name.
    if (d->is_static) {
        add_bit(s, effects_table::globals, d->kind.variable.init, "");
    } else {
        note_local(s, d->kind.variable.name);
    }
    push(w, nullptr, d->kind.variable.init);
}

static void statement(Scan *s, Work *w, const ast::Stmt *st) {
    if (st->kind == .expression) {
        push(w, nullptr, st->kind.expression.value);
    } else if (st->kind == .declaration) {
        declaration(s, w, st->kind.declaration.decl);
    } else if (st->kind == .block) {
        push_stmts(w, st->kind.block.items);
    } else if (st->kind == .if_stmt) {
        push(w, nullptr, st->kind.if_stmt.condition);
        push(w, st->kind.if_stmt.then_branch, nullptr);
        push(w, st->kind.if_stmt.else_branch, nullptr);
    } else if (st->kind == .while_stmt) {
        push(w, nullptr, st->kind.while_stmt.condition);
        push(w, st->kind.while_stmt.body, nullptr);
    } else if (st->kind == .do_while) {
        push(w, nullptr, st->kind.do_while.condition);
        push(w, st->kind.do_while.body, nullptr);
    } else if (st->kind == .for_stmt) {
        push(w, st->kind.for_stmt.init, st->kind.for_stmt.condition);
        push(w, nullptr, st->kind.for_stmt.step);
        push(w, nullptr, st->kind.for_stmt.range);
        push(w, st->kind.for_stmt.index, nullptr);
        push(w, st->kind.for_stmt.body, nullptr);
    }
}

static void statement_more(Work *w, const ast::Stmt *st) {
    if (st->kind == .for_in) {
        push(w, nullptr, st->kind.for_in.iterable);
        push(w, st->kind.for_in.body, nullptr);
    } else if (st->kind == .match_stmt) {
        push(w, nullptr, st->kind.match_stmt.value);
        for (Usize i = 0; i < countof(st->kind.match_stmt.arms); i++)
            push(w, nullptr, st->kind.match_stmt.arms[i].value);
    } else if (st->kind == .switch_stmt) {
        push(w, nullptr, st->kind.switch_stmt.value);
        for (Usize i = 0; i < countof(st->kind.switch_stmt.cases); i++) {
            push_stmts(w, st->kind.switch_stmt.cases[i].body);
        }
    } else if (st->kind == .destructure) {
        push(w, nullptr, st->kind.destructure.init);
    } else if (st->kind == .if_let) {
        push(w, nullptr, st->kind.if_let.value);
        push(w, st->kind.if_let.then_branch, nullptr);
        push(w, st->kind.if_let.else_branch, nullptr);
    } else if (st->kind == .return_stmt) {
        push(w, nullptr, st->kind.return_stmt.value);
    } else if (st->kind == .yield_stmt) {
        push(w, nullptr, st->kind.yield_stmt.value);
    } else if (st->kind == .defer_stmt) {
        push(w, st->kind.defer_stmt.body, nullptr);
    } else if (st->kind == .errdefer_stmt) {
        push(w, st->kind.errdefer_stmt.body, nullptr);
    } else if (st->kind == .labeled) {
        push(w, st->kind.labeled.body, nullptr);
    }
}

// Reads the body of function `self` and records its own bits and its calls into the module's functions.
static void scan_body(Scan *s, const ast::Stmt *body) {
    Work w = {};
    push(&w, body, nullptr);
    while (w.top > 0) {
        w.top -= 1;
        Item item = w.items[w.top];
        if (item.stmt != nullptr) {
            statement(s, &w, item.stmt);
            statement_more(&w, item.stmt);
        }
        if (item.expr != nullptr) expression(s, &w, item.expr);
    }
}

// ---------------------------------------------------------------------------------------------------------------
// The fixed point

// Adds to each caller what its callees have, until no set grows; the first call to add a bit is its cause.
static void solve(Effects *e, const Graph *g) {
    Bool changed = true;
    while (changed) {
        changed = false;
        for (Usize k = 0; k < g->count; k++) {
            Edge edge = g->edges[k];
            Entry *from = &e->entries[edge.from];
            U32 added = e->entries[edge.to].set & ~from->set;
            for (Usize i = 0; i < effects_table::bit_count; i++) {
                if ((added & (1u << i)) == 0) continue;
                from->set |= 1u << i;
                from->causes[i] = (Cause){.at = edge.at, .callee = e->entries[edge.to].name};
                changed = true;
            }
        }
    }
}

static Bool is_function(const ast::Decl *d) {
    return d->kind == .function && !d->from_c;
}

static const ast::Stmt *body_of(const ast::Decl *d) {
    if (d->kind == .function) {
        return d->kind.function.body;
    }
    return nullptr;
}

static Str name_of(const ast::Decl *d) {
    if (d->kind == .function) {
        return d->kind.function.name;
    }
    return "";
}

// The effects of every function of `m`. `r` is `m` as checked, which has the types of the expressions.
export Effects infer(const types::Checked *r, const ast::Module *m) {
    Effects e = {};
    Graph g = {};
    for (Usize i = 0; i < countof(m->decls); i++) {
        if (is_function(m->decls[i])) add_entry(&e, name_of(m->decls[i]), m->decls[i]);
    }
    for (Usize i = 0; i < e.count; i++) {
        const ast::Decl *d = e.entries[i].decl;
        Bool declared = false;
        U32 promised = declared_set(d, &declared);
        const ast::Stmt *body = body_of(d);
        if (body == nullptr) {
            // A declaration with no body: the attribute's set is a promise, and with none it is `unknown`.
            e.entries[i].set = declared ? promised : effects_table::unknown;
            continue;
        }
        Scan s = {.checked = r, .module = m, .effects = &e, .graph = &g, .self = i};
        scan_body(&s, body);
    }
    solve(&e, &g);
    return e;
}

// The set of function `name`; false when the module has none.
export Bool set_of(const Effects *e, Str name, U32 *set) {
    Usize i = entry_index(e, name);
    if (i >= e->count) return false;
    *set = e->entries[i].set;
    return true;
}

// The first thing that added `bit` (one bit) to function `name`: its call, index or write, and the name called.
export Cause cause_of(const Effects *e, Str name, U32 bit) {
    Usize i = entry_index(e, name);
    for (Usize b = 0; b < effects_table::bit_count; b++) {
        if (i < e->count && bit == (1u << b)) return e->entries[i].causes[b];
    }
    return (Cause){};
}
