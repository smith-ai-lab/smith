// front::ast_clone: a deep copy of a declaration of the syntax tree (#1907, part of #1700). A generic function is made
// into an instance by cloning its declaration and binding its compile-time parameters in the clone, so the checker and
// the emitter see an ordinary declaration (the lead's decision on #1700).
//
// The copy shares no node with the original: every node, list and path is allocated again in the current allocator.
// Texts (`Str`) point into the source and are not copied. Nothing here is recursive: a work list holds the copies whose
// children are still the original's, and each is visited once, which replaces its children by copies (breadth first,
// as the dump does).
//
// Adding a kind to `front/ast.smith` means adding it here: the walks below name every kind of node, and a test of
// `tests/front_ast_clone_test.smith` builds a tree with each.
module front::ast_clone;

import front::ast;
import std::arena;
import std::format;
import std::mem;

typedef ast::ExprRef ExprRefList[:];
typedef ast::StmtRef StmtRefList[:];
typedef ast::DeclRef DeclRefList[:];
typedef ast::TypeRef TypeRefList[:];
typedef ast::Identifier IdentifierList[:];
typedef ast::Attribute AttributeList[:];
typedef ast::Param ParamList[:];
typedef ast::FieldDecl FieldDeclList[:];
typedef ast::Enumerator EnumeratorList[:];
typedef ast::Initializer InitializerList[:];
typedef ast::MatchArm MatchArmList[:];
typedef ast::SwitchCase SwitchCaseList[:];
typedef ast::GenericAssoc GenericAssocList[:];
typedef ast::TypeArg TypeArgList[:];

// Gives the statement a copy holds in place of `s`: `s` itself, or another (never null). A compile-time `if` is
// copied as the branch it keeps (#2277).
export typedef const ast::Stmt *(*Choose)(const ast::Stmt *s);

// The same for an expression: the copy holds the one it gives (`x.[f]` copied as `x.name`, #2295).
export typedef const ast::Expr *(*ChooseExpr)(const ast::Expr *e);

// One copy whose children are not copied yet.
typedef enum {
    ast::Decl *decl;
    ast::Stmt *stmt;
    ast::Expr *expr;
    ast::TypeExpr *type;
} Node;

struct Work {
    Node data[:];
    Usize length;
};

static void add(Work *work, Node node) {
    if (work->length == countof(work->data)) {
        Usize capacity = countof(work->data) * 2;
        if (capacity < 64) {
            capacity = 64;
        }
        Node grown[:] = mem::alloc_slice(Node, capacity);
        for (Usize i = 0; i < work->length; i++)
            grown[i] = work->data[i];
        work->data = grown;
    }
    work->data[work->length] = node;
    work->length += 1;
}

// ---------------------------------------------------------------------------------------------------------------
// A child: a copy of the node, queued so that its own children are copied later. Null stays null.

static ChooseExpr choosing_expr = nullptr;

static ast::Expr *take_expr(Work *work, const ast::Expr *old) {
    if (old == nullptr) return nullptr;
    for (Usize k = 0; choosing_expr != nullptr && k < 64; k++) {
        const ast::Expr *chosen = choosing_expr(old);
        if (chosen == old) break;
        old = chosen;
    }
    ast::Expr *copy = ast::new_expr(*old);
    add(work, {.expr = copy});
    return copy;
}

// What a statement is copied as, when set (`clone_decl_choosing`): the statement itself, or another in its place.
static Choose choosing = nullptr;

static ast::Stmt *take_stmt(Work *work, const ast::Stmt *old) {
    if (old == nullptr) return nullptr;
    for (Usize k = 0; choosing != nullptr && k < 64; k++) {
        const ast::Stmt *chosen = choosing(old);
        if (chosen == old) break;
        old = chosen;
    }
    ast::Stmt *copy = ast::new_stmt(*old);
    add(work, {.stmt = copy});
    return copy;
}

static ast::TypeExpr *take_type(Work *work, const ast::TypeExpr *old) {
    if (old == nullptr) return nullptr;
    ast::TypeExpr *copy = ast::new_type(*old);
    add(work, {.type = copy});
    return copy;
}

static ast::Decl *take_decl(Work *work, const ast::Decl *old) {
    if (old == nullptr) return nullptr;
    ast::Decl *copy = ast::new_decl(*old);
    add(work, {.decl = copy});
    return copy;
}

// ---------------------------------------------------------------------------------------------------------------
// Lists. A list of pointers is not made by mem::alloc_slice: its instance for a pointer element draws the lint of a
// multilevel conversion (as in front/ast.smith).

static ExprRefList take_exprs(Work *work, ast::ExprRef list[:]) {
    ast::ExprRef *block =
        (ast::ExprRef *)mem::alloc_array_raw(sizeof(ast::ExprRef), countof(list), alignof(ast::ExprRef));
    for (Usize i = 0; i < countof(list); i++)
        block[i] = take_expr(work, list[i]);
    ExprRefList copy = block[0:countof(list)];
    return copy;
}

static StmtRefList take_stmts(Work *work, ast::StmtRef list[:]) {
    ast::StmtRef *block =
        (ast::StmtRef *)mem::alloc_array_raw(sizeof(ast::StmtRef), countof(list), alignof(ast::StmtRef));
    for (Usize i = 0; i < countof(list); i++)
        block[i] = take_stmt(work, list[i]);
    StmtRefList copy = block[0:countof(list)];
    return copy;
}

static DeclRefList take_decls(Work *work, ast::DeclRef list[:]) {
    ast::DeclRef *block =
        (ast::DeclRef *)mem::alloc_array_raw(sizeof(ast::DeclRef), countof(list), alignof(ast::DeclRef));
    for (Usize i = 0; i < countof(list); i++)
        block[i] = take_decl(work, list[i]);
    DeclRefList copy = block[0:countof(list)];
    return copy;
}

static TypeRefList take_types(Work *work, ast::TypeRef list[:]) {
    ast::TypeRef *block =
        (ast::TypeRef *)mem::alloc_array_raw(sizeof(ast::TypeRef), countof(list), alignof(ast::TypeRef));
    for (Usize i = 0; i < countof(list); i++)
        block[i] = take_type(work, list[i]);
    TypeRefList copy = block[0:countof(list)];
    return copy;
}

static IdentifierList take_identifiers(ast::Identifier list[:]) {
    IdentifierList copy = mem::alloc_slice(ast::Identifier, countof(list));
    for (Usize i = 0; i < countof(list); i++)
        copy[i] = list[i];
    return copy;
}

static ast::Path take_path(ast::Path path) {
    path.segments = take_identifiers(path.segments);
    return path;
}

static AttributeList take_attributes(Work *work, ast::Attribute list[:]) {
    AttributeList copy = mem::alloc_slice(ast::Attribute, countof(list));
    for (Usize i = 0; i < countof(list); i++) {
        copy[i] = list[i];
        copy[i].name = take_path(list[i].name);
        copy[i].args = take_exprs(work, list[i].args);
    }
    return copy;
}

static ParamList take_params(Work *work, ast::Param list[:]) {
    ParamList copy = mem::alloc_slice(ast::Param, countof(list));
    for (Usize i = 0; i < countof(list); i++) {
        copy[i] = list[i];
        copy[i].type = take_type(work, list[i].type);
        copy[i].default_value = take_expr(work, list[i].default_value);
        copy[i].attributes = take_attributes(work, list[i].attributes);
    }
    return copy;
}

static FieldDeclList take_fields(Work *work, ast::FieldDecl list[:]) {
    FieldDeclList copy = mem::alloc_slice(ast::FieldDecl, countof(list));
    for (Usize i = 0; i < countof(list); i++) {
        copy[i] = list[i];
        copy[i].type = take_type(work, list[i].type);
        copy[i].bit_width = take_expr(work, list[i].bit_width);
        copy[i].default_value = take_expr(work, list[i].default_value);
        copy[i].attributes = take_attributes(work, list[i].attributes);
    }
    return copy;
}

static EnumeratorList take_enumerators(Work *work, ast::Enumerator list[:]) {
    EnumeratorList copy = mem::alloc_slice(ast::Enumerator, countof(list));
    for (Usize i = 0; i < countof(list); i++) {
        copy[i] = list[i];
        copy[i].value = take_expr(work, list[i].value);
        copy[i].payload = take_type(work, list[i].payload);
        copy[i].attributes = take_attributes(work, list[i].attributes);
    }
    return copy;
}

static void take_designators(Work *work, ast::Designator source[:], ast::Designator target[:]) {
    for (Usize k = 0; k < countof(source); k++) {
        ast::Designator one = source[k];
        if (one == .index) {
            one.index.index = take_expr(work, one.index.index);
        }
        target[k] = one;
    }
}

static InitializerList take_initializers(Work *work, ast::Initializer list[:]) {
    InitializerList copy = mem::alloc_slice(ast::Initializer, countof(list));
    for (Usize i = 0; i < countof(list); i++) {
        copy[i] = list[i];
        copy[i].value = take_expr(work, list[i].value);
        ast::Designator source[:] = list[i].designators;
        ast::Designator target[:] = mem::alloc_slice(ast::Designator, countof(source));
        take_designators(work, source, target);
        copy[i].designators = target;
    }
    return copy;
}

static MatchArmList take_arms(Work *work, ast::MatchArm list[:]) {
    MatchArmList copy = mem::alloc_slice(ast::MatchArm, countof(list));
    for (Usize i = 0; i < countof(list); i++) {
        copy[i] = list[i];
        copy[i].value = take_expr(work, list[i].value);
        ast::Pattern source[:] = list[i].patterns;
        ast::Pattern target[:] = mem::alloc_slice(ast::Pattern, countof(source));
        for (Usize k = 0; k < countof(source); k++) {
            target[k] = source[k];
            if (source[k].constant != nullptr) target[k].constant = take_expr(work, source[k].constant);
        }
        copy[i].patterns = target;
    }
    return copy;
}

static SwitchCaseList take_cases(Work *work, ast::SwitchCase list[:]) {
    SwitchCaseList copy = mem::alloc_slice(ast::SwitchCase, countof(list));
    for (Usize i = 0; i < countof(list); i++) {
        copy[i] = list[i];
        copy[i].values = take_exprs(work, list[i].values);
        copy[i].body = take_stmts(work, list[i].body);
    }
    return copy;
}

static GenericAssocList take_assocs(Work *work, ast::GenericAssoc list[:]) {
    GenericAssocList copy = mem::alloc_slice(ast::GenericAssoc, countof(list));
    for (Usize i = 0; i < countof(list); i++) {
        copy[i] = list[i];
        copy[i].type = take_type(work, list[i].type);
        copy[i].value = take_expr(work, list[i].value);
    }
    return copy;
}

static TypeArgList take_type_args(Work *work, ast::TypeArg list[:]) {
    TypeArgList copy = mem::alloc_slice(ast::TypeArg, countof(list));
    for (Usize i = 0; i < countof(list); i++) {
        ast::TypeArg one = list[i];
        if (one == .type) {
            one.type.type = take_type(work, one.type.type);
        }
        if (one == .value) {
            one.value.value = take_expr(work, one.value.value);
        }
        copy[i] = one;
    }
    return copy;
}

// ---------------------------------------------------------------------------------------------------------------
// The children of a copy: types

static void visit_type(Work *work, ast::TypeExpr *t) {
    if (t->kind == .named) t->kind.named.path = take_path(t->kind.named.path);
    if (t->kind == .pointer) t->kind.pointer.pointee = take_type(work, t->kind.pointer.pointee);
    if (t->kind == .array) {
        t->kind.array.element = take_type(work, t->kind.array.element);
        t->kind.array.count = take_expr(work, t->kind.array.count);
    }
    if (t->kind == .slice) t->kind.slice.element = take_type(work, t->kind.slice.element);
    if (t->kind == .function) {
        t->kind.function.params = take_types(work, t->kind.function.params);
        t->kind.function.result = take_type(work, t->kind.function.result);
    }
    if (t->kind == .applied) {
        t->kind.applied.name = take_path(t->kind.applied.name);
        t->kind.applied.args = take_type_args(work, t->kind.applied.args);
    }
    if (t->kind == .type_of) t->kind.type_of.operand = take_expr(work, t->kind.type_of.operand);
    if (t->kind == .record) t->kind.record.fields = take_fields(work, t->kind.record.fields);
    if (t->kind == .tuple) t->kind.tuple.elements = take_types(work, t->kind.tuple.elements);
    if (t->kind == .option) t->kind.option.inner = take_type(work, t->kind.option.inner);
    if (t->kind == .block_type) {
        t->kind.block_type.element = take_type(work, t->kind.block_type.element);
        t->kind.block_type.dims = take_exprs(work, t->kind.block_type.dims);
    }
}

// ---------------------------------------------------------------------------------------------------------------
// Expressions

static void visit_expr_leaves(Work *work, ast::Expr *e) {
    if (e->kind == .name) e->kind.name.path = take_path(e->kind.name.path);
    if (e->kind == .variant) e->kind.variant.payload = take_expr(work, e->kind.variant.payload);
    if (e->kind == .type_value) e->kind.type_value.type = take_type(work, e->kind.type_value.type);
    if (e->kind == .unary) e->kind.unary.operand = take_expr(work, e->kind.unary.operand);
    if (e->kind == .binary) {
        e->kind.binary.left = take_expr(work, e->kind.binary.left);
        e->kind.binary.right = take_expr(work, e->kind.binary.right);
    }
    if (e->kind == .assign) {
        e->kind.assign.target = take_expr(work, e->kind.assign.target);
        e->kind.assign.value = take_expr(work, e->kind.assign.value);
    }
    if (e->kind == .conditional) {
        e->kind.conditional.condition = take_expr(work, e->kind.conditional.condition);
        e->kind.conditional.then_value = take_expr(work, e->kind.conditional.then_value);
        e->kind.conditional.else_value = take_expr(work, e->kind.conditional.else_value);
    }
    if (e->kind == .call) {
        e->kind.call.callee = take_expr(work, e->kind.call.callee);
        e->kind.call.args = take_exprs(work, e->kind.call.args);
    }
    if (e->kind == .index) {
        e->kind.index.base = take_expr(work, e->kind.index.base);
        e->kind.index.index = take_expr(work, e->kind.index.index);
    }
    if (e->kind == .slice_of) {
        e->kind.slice_of.base = take_expr(work, e->kind.slice_of.base);
        e->kind.slice_of.start = take_expr(work, e->kind.slice_of.start);
        e->kind.slice_of.end = take_expr(work, e->kind.slice_of.end);
    }
    if (e->kind == .member) e->kind.member.base = take_expr(work, e->kind.member.base);
}

static void visit_expr(Work *work, ast::Expr *e) {
    visit_expr_leaves(work, e);
    if (e->kind == .cast) {
        e->kind.cast.type = take_type(work, e->kind.cast.type);
        e->kind.cast.operand = take_expr(work, e->kind.cast.operand);
    }
    if (e->kind == .query) {
        e->kind.query.type = take_type(work, e->kind.query.type);
        e->kind.query.operand = take_expr(work, e->kind.query.operand);
    }
    if (e->kind == .compound) {
        e->kind.compound.type = take_type(work, e->kind.compound.type);
        e->kind.compound.items = take_initializers(work, e->kind.compound.items);
    }
    if (e->kind == .lambda) {
        e->kind.lambda.captures = take_identifiers(e->kind.lambda.captures);
        e->kind.lambda.params = take_params(work, e->kind.lambda.params);
        e->kind.lambda.result = take_type(work, e->kind.lambda.result);
        e->kind.lambda.body = take_stmt(work, e->kind.lambda.body);
    }
    if (e->kind == .try_expr) e->kind.try_expr.operand = take_expr(work, e->kind.try_expr.operand);
    if (e->kind == .reflect_member) {
        e->kind.reflect_member.base = take_expr(work, e->kind.reflect_member.base);
        e->kind.reflect_member.field = take_expr(work, e->kind.reflect_member.field);
    }
    if (e->kind == .expand) e->kind.expand.pattern = take_expr(work, e->kind.expand.pattern);
    if (e->kind == .named_arg) e->kind.named_arg.value = take_expr(work, e->kind.named_arg.value);
    if (e->kind == .tuple_lit) e->kind.tuple_lit.items = take_exprs(work, e->kind.tuple_lit.items);
    if (e->kind == .array_lit) e->kind.array_lit.items = take_exprs(work, e->kind.array_lit.items);
    if (e->kind == .stmt_expr) e->kind.stmt_expr.stmt = take_stmt(work, e->kind.stmt_expr.stmt);
    if (e->kind == .generic_select) {
        e->kind.generic_select.control = take_expr(work, e->kind.generic_select.control);
        e->kind.generic_select.assocs = take_assocs(work, e->kind.generic_select.assocs);
    }
}

// ---------------------------------------------------------------------------------------------------------------
// Statements

static void visit_stmt_loops(Work *work, ast::Stmt *s) {
    if (s->kind == .while_stmt) {
        s->kind.while_stmt.condition = take_expr(work, s->kind.while_stmt.condition);
        s->kind.while_stmt.body = take_stmt(work, s->kind.while_stmt.body);
    }
    if (s->kind == .do_while) {
        s->kind.do_while.body = take_stmt(work, s->kind.do_while.body);
        s->kind.do_while.condition = take_expr(work, s->kind.do_while.condition);
    }
    if (s->kind == .for_stmt) {
        s->kind.for_stmt.init = take_stmt(work, s->kind.for_stmt.init);
        s->kind.for_stmt.condition = take_expr(work, s->kind.for_stmt.condition);
        s->kind.for_stmt.step = take_expr(work, s->kind.for_stmt.step);
        s->kind.for_stmt.body = take_stmt(work, s->kind.for_stmt.body);
        s->kind.for_stmt.range = take_expr(work, s->kind.for_stmt.range);
        s->kind.for_stmt.index = take_stmt(work, s->kind.for_stmt.index);
    }
    if (s->kind == .for_in) {
        s->kind.for_in.names = take_identifiers(s->kind.for_in.names);
        s->kind.for_in.iterable = take_expr(work, s->kind.for_in.iterable);
        s->kind.for_in.body = take_stmt(work, s->kind.for_in.body);
    }
}

static void visit_stmt(Work *work, ast::Stmt *s) {
    visit_stmt_loops(work, s);
    if (s->kind == .expression) s->kind.expression.value = take_expr(work, s->kind.expression.value);
    if (s->kind == .declaration) s->kind.declaration.decl = take_decl(work, s->kind.declaration.decl);
    if (s->kind == .block) s->kind.block.items = take_stmts(work, s->kind.block.items);
    if (s->kind == .if_stmt) {
        s->kind.if_stmt.condition = take_expr(work, s->kind.if_stmt.condition);
        s->kind.if_stmt.then_branch = take_stmt(work, s->kind.if_stmt.then_branch);
        s->kind.if_stmt.else_branch = take_stmt(work, s->kind.if_stmt.else_branch);
    }
    if (s->kind == .switch_stmt) {
        s->kind.switch_stmt.value = take_expr(work, s->kind.switch_stmt.value);
        s->kind.switch_stmt.cases = take_cases(work, s->kind.switch_stmt.cases);
    }
    if (s->kind == .match_stmt) {
        s->kind.match_stmt.value = take_expr(work, s->kind.match_stmt.value);
        s->kind.match_stmt.arms = take_arms(work, s->kind.match_stmt.arms);
    }
    if (s->kind == .destructure) {
        s->kind.destructure.names = take_identifiers(s->kind.destructure.names);
        s->kind.destructure.init = take_expr(work, s->kind.destructure.init);
    }
    if (s->kind == .if_let) {
        s->kind.if_let.value = take_expr(work, s->kind.if_let.value);
        s->kind.if_let.then_branch = take_stmt(work, s->kind.if_let.then_branch);
        s->kind.if_let.else_branch = take_stmt(work, s->kind.if_let.else_branch);
    }
    if (s->kind == .return_stmt) s->kind.return_stmt.value = take_expr(work, s->kind.return_stmt.value);
    if (s->kind == .yield_stmt) s->kind.yield_stmt.value = take_expr(work, s->kind.yield_stmt.value);
    if (s->kind == .defer_stmt) s->kind.defer_stmt.body = take_stmt(work, s->kind.defer_stmt.body);
    if (s->kind == .errdefer_stmt) s->kind.errdefer_stmt.body = take_stmt(work, s->kind.errdefer_stmt.body);
    if (s->kind == .labeled) s->kind.labeled.body = take_stmt(work, s->kind.labeled.body);
    if (s->kind == .static_assert_stmt) {
        s->kind.static_assert_stmt.condition = take_expr(work, s->kind.static_assert_stmt.condition);
    }
}

// ---------------------------------------------------------------------------------------------------------------
// Declarations

static void visit_decl(Work *work, ast::Decl *d) {
    d->attributes = take_attributes(work, d->attributes);
    if (d->kind == .variable) {
        d->kind.variable.type = take_type(work, d->kind.variable.type);
        d->kind.variable.init = take_expr(work, d->kind.variable.init);
    }
    if (d->kind == .function) {
        d->kind.function.params = take_params(work, d->kind.function.params);
        d->kind.function.generics = take_params(work, d->kind.function.generics);
        d->kind.function.result = take_type(work, d->kind.function.result);
        d->kind.function.body = take_stmt(work, d->kind.function.body);
    }
    if (d->kind == .record) d->kind.record.fields = take_fields(work, d->kind.record.fields);
    if (d->kind == .enumeration) {
        d->kind.enumeration.underlying = take_type(work, d->kind.enumeration.underlying);
        d->kind.enumeration.items = take_enumerators(work, d->kind.enumeration.items);
    }
    if (d->kind == .type_alias) d->kind.type_alias.type = take_type(work, d->kind.type_alias.type);
    if (d->kind == .import_module) d->kind.import_module.path = take_path(d->kind.import_module.path);
    if (d->kind == .import_from) {
        d->kind.import_from.path = take_path(d->kind.import_from.path);
        d->kind.import_from.names = take_identifiers(d->kind.import_from.names);
    }
    if (d->kind == .static_assert_decl) {
        d->kind.static_assert_decl.condition = take_expr(work, d->kind.static_assert_decl.condition);
    }
    if (d->kind == .if_constexpr) {
        d->kind.if_constexpr.condition = take_expr(work, d->kind.if_constexpr.condition);
        d->kind.if_constexpr.then_decls = take_decls(work, d->kind.if_constexpr.then_decls);
        d->kind.if_constexpr.else_decls = take_decls(work, d->kind.if_constexpr.else_decls);
    }
}

// Visits every copy queued, and those the visits queue.
static void drain(Work *work) {
    for (Usize at = 0; at < work->length; at++) {
        Node node = work->data[at];
        if (node == .decl) visit_decl(work, node.decl);
        if (node == .stmt) visit_stmt(work, node.stmt);
        if (node == .expr) visit_expr(work, node.expr);
        if (node == .type) visit_type(work, node.type);
    }
}

// A deep copy of `d`, a function, a variable or any other declaration, in the current allocator. The copy shares no
// node, list or path with `d`; texts still point into the source.
export ast::Decl *clone_decl(const ast::Decl *d) {
    Work work = {};
    ast::Decl *root = take_decl(&work, d);
    drain(&work);
    return root;
}

// `clone_decl`, with each statement copied as what `choose` gives for it (the statements of the branch chosen are
// copied the same way).
export ast::Decl *clone_decl_choosing(const ast::Decl *d, Choose choose) {
    choosing = choose;
    ast::Decl *copy = clone_decl(d);
    choosing = nullptr;
    return copy;
}

// `clone_decl`, with each statement and each expression copied as what `choose` and `choose_expr` give for it (#2295).
// A chooser may itself call this (a `for f in fields(T)` is copied as a block of the body, rewritten once for each
// field): the choosers of the copy in progress are put back after.
export ast::Decl *clone_decl_rewriting(const ast::Decl *d, Choose choose, ChooseExpr choose_expr) {
    Choose outer = choosing;
    ChooseExpr outer_expr = choosing_expr;
    choosing = choose;
    choosing_expr = choose_expr;
    ast::Decl *copy = clone_decl(d);
    choosing = outer;
    choosing_expr = outer_expr;
    return copy;
}

// A deep copy of the statement `s`, rewritten as `clone_decl_rewriting` does.
export ast::Stmt *clone_stmt_rewriting(const ast::Stmt *s, Choose choose, ChooseExpr choose_expr) {
    Choose outer = choosing;
    ChooseExpr outer_expr = choosing_expr;
    choosing = choose;
    choosing_expr = choose_expr;
    Work work = {};
    ast::Stmt *root = take_stmt(&work, s);
    drain(&work);
    choosing = outer;
    choosing_expr = outer_expr;
    return root;
}

// ---------------------------------------------------------------------------------------------------------------
// Unrolling `for x in rest` over a pack (#2293, part of #1821)

static Str unrolled_pack;
static Usize unrolled_count = 0;

// The statement `let name = pack.at`.
static ast::Stmt *element_binding(ast::Identifier name, Str pack, Usize at) {
    char chars[:] = format::push(at);
    Str index = chars;
    ast::Expr *base = ast::name(pack);
    ast::Expr *element = ast::expr({.member = {.base = base, .name = index}});
    element->span = name.span;
    ast::TypeExpr *automatic = ast::make_type((ast::TypeKind){});
    automatic->kind = .auto_type;
    ast::DeclKind kind = {.variable = {.name = name.text, .type = automatic, .init = element, .is_new = true}};
    ast::Decl *d = ast::decl((ast::Decl){}, kind);
    d->span = name.span;
    ast::Stmt *s = ast::stmt({.declaration = {.decl = d}});
    s->span = name.span;
    return s;
}

// One copy of the body of the loop `s`, for the element `at` of the pack: a block with the binding and the body.
static ast::Stmt *unrolled_copy(const ast::Stmt *s, Usize at) {
    if (!(s->kind == .for_in)) return nullptr;
    ast::StmtRef *block = (ast::StmtRef *)mem::alloc_array_raw(sizeof(ast::StmtRef), 2, alignof(ast::StmtRef));
    block[0] = element_binding(s->kind.for_in.names[0], unrolled_pack, at);
    block[1] = s->kind.for_in.body;
    StmtRefList items = block[0:2];
    ast::Stmt *copy = ast::block(items);
    copy->span = s->span;
    return copy;
}

// A `for x in <pack>` becomes a block with one copy of the body for each element of the pack.
static const ast::Stmt *unroll(const ast::Stmt *s) {
    if (s->kind != .for_in || s->kind.for_in.is_tuple || countof(s->kind.for_in.names) != 1) return s;
    const ast::Expr *iterable = s->kind.for_in.iterable;
    if (iterable->kind != .name || countof(iterable->kind.name.path.segments) != 1) return s;
    Str written = iterable->kind.name.path.segments[0].text;
    if (countof(written) != countof(unrolled_pack)) return s;
    for (Usize i = 0; i < countof(written); i++) {
        if (written[i] != unrolled_pack[i]) return s;
    }
    ast::StmtRef *block =
        (ast::StmtRef *)mem::alloc_array_raw(sizeof(ast::StmtRef), unrolled_count, alignof(ast::StmtRef));
    for (Usize at = 0; at < unrolled_count; at++) {
        block[at] = unrolled_copy(s, at);
    }
    StmtRefList items = block[0:unrolled_count];
    ast::Stmt *all = ast::block(items);
    all->span = s->span;
    return all;
}

// `clone_decl`, with each `for x in pack` of the body unrolled into `count` copies of its body, one for each element
// of the pack, which is `pack.0`, `pack.1`, ... (the loop variable is bound to it in each copy).
export ast::Decl *clone_decl_unrolling(const ast::Decl *d, Str pack, Usize count) {
    unrolled_pack = pack;
    unrolled_count = count;
    ast::Decl *copy = clone_decl_choosing(d, unroll);
    Str none = {};
    unrolled_pack = none;
    return copy;
}

// ---------------------------------------------------------------------------------------------------------------
// The compile-time reflection lists `fields(T)` and `parameters(F)` (#2295, piece 4 of #1821)
//
// A list is known when the function is checked: an instance of a generic function has its `T` bound, and a function
// that names a struct (`fields(Point)`) has it in scope. So the lists are expanded in the tree, before the body is
// checked, the way `for x in rest` is unrolled over a pack (#2293): the checker and the emitter see ordinary code.
//
//   for f in fields(T): body    one copy of the body for each field, with `f` standing for that field
//   f.name, f.doc               the field's name and its `##` comment, as string literals
//   f.type                      the field's type, written as a name
//   value.[f]                   `value.<name of the field>`
//   fields(T)[2], countof(fields(T))    a compile-time index, and the number of entries
//   first := fields(T)[0]       a name for one entry (no code: `first` stands for it from there on)
//   if let .some(a) = f.attr(X): then else: other    `then` with `a = X(...)` (the attribute written on the field),
//                               or `other` when the field has none
//
// The entries come from the checker through `set_reflection_source` (this module cannot import it). `fields(T)` in
// another module lists only the `pub` fields (#1787). Nothing here is recursive: a rewrite of the body is a clone of it
// with the two choosers below, and a nested list is a clone inside a chooser (the outer choosers are put back after).

// One entry of a list: a field of a struct, or a parameter of a function.
export struct Entry {
    Str name;
    Str type_name;
    Str doc;
    ast::Attribute attributes[:];
};

// The number of entries of the list `kind` ("fields" or "parameters") of the type or function `subject`; false when
// the subject is not known here (a generic function not yet instantiated, a name that is neither).
export typedef Bool (*Count)(Str kind, Str subject, Usize *count);
export typedef Entry (*At)(Str kind, Str subject, Usize at);
export typedef void (*Fail)(ast::Span span, Str message);

static Count count_source = nullptr;
static At entry_source = nullptr;
static Fail fail_sink = nullptr;

export void set_reflection_source(Count count, At at, Fail fail) {
    count_source = count;
    entry_source = at;
    fail_sink = fail;
}

// ---------------------------------------------------------------------------------------------------------------
// What a name stands for

// An entry: the list it is in and its index.
struct Ref {
    Bool known;
    Str kind;
    Str subject;
    Usize at;
};

// A name bound to an entry: the variable of an unrolled `for`, or `first := fields(T)[0]`.
struct Alias {
    Str name;
    Ref entry;
};

static Alias aliases[32];
static Usize alias_count = 0;
static Bool rewrote = false;

static Bool same(Str a, Str b) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// The one name an expression is (`f`, `fields`), else "".
static Str single_name(const ast::Expr *e) {
    Str none = {};
    if (e == nullptr || e->kind != .name || countof(e->kind.name.path.segments) != 1) return none;
    return e->kind.name.path.segments[0].text;
}

// The last name of a path expression (`geometry.Point` is `Point`), or of a written type that is a plain name (a name
// that is a type, `Point`, is parsed as a type value), else "".
static Str last_name(const ast::Expr *e) {
    Str none = {};
    if (e == nullptr) return none;
    if (e->kind == .type_value) {
        const ast::TypeExpr *written = e->kind.type_value.type;
        if (written == nullptr || written->kind != .named) return none;
        Usize n = countof(written->kind.named.path.segments);
        return n == 0 ? none : written->kind.named.path.segments[n - 1].text;
    }
    if (e->kind != .name) return none;
    Usize n = countof(e->kind.name.path.segments);
    if (n == 0) return none;
    return e->kind.name.path.segments[n - 1].text;
}

// Whether `e` is `fields(T)` or `parameters(F)`: its list and subject.
static Bool list_call(const ast::Expr *e, Str *kind, Str *subject) {
    if (e == nullptr || e->kind != .call || countof(e->kind.call.args) != 1) return false;
    Str callee = single_name(e->kind.call.callee);
    if (!same(callee, "fields") && !same(callee, "parameters")) return false;
    Str named = last_name(e->kind.call.args[0]);
    if (countof(named) == 0) return false;
    *kind = callee;
    *subject = named;
    return true;
}

// The number of entries of the list `e` is, when it is one and its subject is known.
static Bool list_count(const ast::Expr *e, Str *kind, Str *subject, Usize *count) {
    if (count_source == nullptr || !list_call(e, kind, subject)) return false;
    return count_source(*kind, *subject, count);
}

// The entry an expression names: an alias, or `fields(T)[2]`.
static Ref ref_of(const ast::Expr *e) {
    Ref none = {};
    Str name = single_name(e);
    if (countof(name) > 0) {
        for (Usize i = alias_count; i > 0; i--) {
            if (same(aliases[i - 1].name, name)) return aliases[i - 1].entry;
        }
        return none;
    }
    if (e == nullptr || e->kind != .index || e->kind.index.index->kind != .integer) return none;
    Str kind = {};
    Str subject = {};
    Usize count = 0;
    if (!list_count(e->kind.index.base, &kind, &subject, &count)) return none;
    U64 at = e->kind.index.index->kind.integer.value;
    if (at >= count) return none;
    return (Ref){.known = true, .kind = kind, .subject = subject, .at = at};
}

static void push_alias(Str name, Ref entry) {
    if (alias_count == countof(aliases)) return;
    aliases[alias_count] = (Alias){.name = name, .entry = entry};
    alias_count += 1;
}

static Entry entry_of(Ref r) {
    return entry_source(r.kind, r.subject, r.at);
}

// ---------------------------------------------------------------------------------------------------------------
// Building the replacements

// Room for `count` statements, to be filled and given to `block_of`.
static ast::StmtRef *room(Usize count) {
    return (ast::StmtRef *)mem::alloc_array_raw(sizeof(ast::StmtRef), count + 1, alignof(ast::StmtRef));
}

static ast::Stmt *block_of(ast::StmtRef *items, Usize count) {
    ast::StmtRef list[:] = items[0:count];
    return ast::block(list);
}

static ast::Stmt *empty_block(ast::Span span) {
    ast::Stmt *s = block_of(room(0), 0);
    s->span = span;
    return s;
}

// `let name = value`.
static ast::Stmt *binding(Str name, ast::Expr *value, ast::Span span) {
    ast::TypeExpr *automatic = ast::make_type((ast::TypeKind){});
    automatic->kind = .auto_type;
    ast::DeclKind kind = {.variable = {.name = name, .type = automatic, .init = value, .is_new = true}};
    ast::Decl *d = ast::decl((ast::Decl){}, kind);
    d->span = span;
    ast::Stmt *s = ast::stmt({.declaration = {.decl = d}});
    s->span = span;
    return s;
}

static ast::Expr *at_span(ast::Expr *e, ast::Span span) {
    e->span = span;
    return e;
}

// ---------------------------------------------------------------------------------------------------------------
// The choosers

// `entry.name`, `entry.doc` and `entry.type` of an entry, as the value they stand for; null for another member.
static ast::Expr *member_value(const ast::Expr *e) {
    if (e->kind != .member) return nullptr;
    Ref r = ref_of(e->kind.member.base);
    if (!r.known || e->kind.member.arrow) return nullptr;
    Str member = e->kind.member.name;
    Entry entry = entry_of(r);
    if (same(member, "name")) return at_span(ast::string(entry.name), e->span);
    if (same(member, "doc")) return at_span(ast::string(entry.doc), e->span);
    if (same(member, "type")) {
        ast::Expr *value = ast::expr({.type_value = {.type = ast::named(entry.type_name)}});
        return at_span(value, e->span);
    }
    return nullptr;
}

// `sizeof(f.type)` and the like: the query of the type the entry has.
static ast::Expr *queried(const ast::Expr *e) {
    if (e->kind != .query || e->kind.query.operand == nullptr || e->kind.query.operand->kind != .member) return nullptr;
    ast::Expr *type = member_value(e->kind.query.operand);
    if (type == nullptr || type->kind != .type_value) return nullptr;
    ast::Expr *query = ast::expr({.query = {.op = e->kind.query.op, .type = type->kind.type_value.type}});
    return at_span(query, e->span);
}

// `value.[f]`: the field the entry `f` names.
static ast::Expr *reflected_member(const ast::Expr *e) {
    if (e->kind != .reflect_member) return nullptr;
    Ref r = ref_of(e->kind.reflect_member.field);
    if (!r.known) return nullptr;
    Entry entry = entry_of(r);
    ast::Expr *member = ast::expr(
        {.member = {.base = e->kind.reflect_member.base, .name = entry.name, .arrow = e->kind.reflect_member.arrow}});
    return at_span(member, e->span);
}

// `countof(fields(T))`.
static ast::Expr *counted(const ast::Expr *e) {
    if (e->kind != .query || e->kind.query.op != .count_of || e->kind.query.operand == nullptr) return nullptr;
    Str kind = {};
    Str subject = {};
    Usize count = 0;
    if (!list_count(e->kind.query.operand, &kind, &subject, &count)) return nullptr;
    return at_span(ast::integer(count), e->span);
}

// `fields(T)[i]` with an index that is not a number written in the code, or past the end: a compile error.
static void check_index(const ast::Expr *e) {
    if (e->kind != .index || fail_sink == nullptr) return;
    Str kind = {};
    Str subject = {};
    Usize count = 0;
    if (!list_count(e->kind.index.base, &kind, &subject, &count)) return;
    char written[:] = format::push(kind, "(", subject, ")");
    Str shown = written;
    const ast::Expr *index = e->kind.index.index;
    if (index->kind != .integer) {
        char text[:] = format::push("the index of `", shown, "` must be a number written in the code: the list exists ",
                                    "only at compile time; for a list that is indexed at run time use a slice `[]T`");
        Str message = text;
        fail_sink(index->span, message);
    } else if (index->kind.integer.value >= count) {
        char text[:] = format::push("`", shown, "` has ", count, " entries, but this index is ",
                                    index->kind.integer.value, "; the first is 0");
        Str message = text;
        fail_sink(index->span, message);
    }
}

static const ast::Expr *rewrite_expr(const ast::Expr *e) {
    check_index(e);
    ast::Expr *replacement = nullptr;
    if (e->kind == .member) replacement = member_value(e);
    if (e->kind == .reflect_member) replacement = reflected_member(e);
    if (e->kind == .query) replacement = counted(e);
    if (e->kind == .query && replacement == nullptr) replacement = queried(e);
    if (replacement == nullptr) return e;
    rewrote = true;
    return replacement;
}

static const ast::Stmt *rewrite_stmt(const ast::Stmt *s);

// `for f in fields(T): body` as a block of one rewritten copy of the body for each entry.
static const ast::Stmt *unrolled(const ast::Stmt *s, Usize count) {
    if (s->kind != .for_in) return s;
    Str kind = {};
    Str subject = {};
    list_call(s->kind.for_in.iterable, &kind, &subject);
    Str variable = s->kind.for_in.names[0].text;
    ast::StmtRef *copies = room(count);
    for (Usize at = 0; at < count; at++) {
        push_alias(variable, (Ref){.known = true, .kind = kind, .subject = subject, .at = at});
        copies[at] = clone_stmt_rewriting(s->kind.for_in.body, rewrite_stmt, rewrite_expr);
        alias_count -= 1;
    }
    ast::Stmt *all = block_of(copies, count);
    all->span = s->span;
    return all;
}

// `if let .some(a) = f.attr(X)`: the attribute `X` written on the entry, or null.
static const ast::Attribute *attribute_named(Entry entry, const ast::Expr *wanted) {
    Str want = last_name(wanted);
    for (Usize i = 0; i < countof(entry.attributes); i++) {
        ast::Path path = entry.attributes[i].name;
        Usize n = countof(path.segments);
        if (n > 0 && same(path.segments[n - 1].text, want)) return &entry.attributes[i];
    }
    return nullptr;
}

// `if let .some(a) = f.attr(X): then else: other` is decided now: `then` with `a = X(...)`, or `other`.
static const ast::Stmt *attribute_branch(const ast::Stmt *s) {
    if (s->kind != .if_let) return s;
    const ast::Expr *value = s->kind.if_let.value;
    if (value->kind != .call || value->kind.call.callee->kind != .member || countof(value->kind.call.args) != 1) {
        return s;
    }
    const ast::Expr *callee = value->kind.call.callee;
    if (callee->kind != .member) return s;
    if (!same(callee->kind.member.name, "attr")) return s;
    Ref r = ref_of(callee->kind.member.base);
    if (!r.known || !same(s->kind.if_let.pattern.name, "some")) return s;
    const ast::Expr *wanted = value->kind.call.args[0];
    const ast::Attribute *found = attribute_named(entry_of(r), wanted);
    rewrote = true;
    if (found == nullptr) {
        if (s->kind.if_let.else_branch == nullptr) return empty_block(s->span);
        return s->kind.if_let.else_branch;
    }
    ast::ExprRef args[:] = found->args;
    ast::StmtRef *parts = room(2);
    parts[0] = binding(s->kind.if_let.pattern.binding, ast::call(ast::name(last_name(wanted)), args), s->span);
    parts[1] = s->kind.if_let.then_branch;
    ast::Stmt *both = block_of(parts, 2);
    both->span = s->span;
    return both;
}

static const ast::Stmt *rewrite_stmt(const ast::Stmt *s) {
    if (s->kind == .for_in && !s->kind.for_in.is_tuple && countof(s->kind.for_in.names) == 1) {
        Str kind = {};
        Str subject = {};
        Usize count = 0;
        if (!list_count(s->kind.for_in.iterable, &kind, &subject, &count)) return s;
        rewrote = true;
        return unrolled(s, count);
    }
    if (s->kind == .declaration && s->kind.declaration.decl->kind == .variable) {
        const ast::Decl *d = s->kind.declaration.decl;
        if (d->kind != .variable) return s;
        Ref r = ref_of(d->kind.variable.init);
        if (!r.known) return s;
        push_alias(d->kind.variable.name, r);
        rewrote = true;
        return empty_block(s->span);
    }
    if (s->kind == .if_let) return attribute_branch(s);
    return s;
}

// Expands the lists of the function `d` in place, when it names any whose subject is known; whether it did.
export Bool expand_reflection_lists(ast::Decl *d) {
    if (count_source == nullptr || d->kind != .function || d->kind.function.body == nullptr) return false;
    rewrote = false;
    alias_count = 0;
    ast::Decl *copy = clone_decl_rewriting(d, rewrite_stmt, rewrite_expr);
    alias_count = 0;
    if (!rewrote) return false;
    *d = *copy;
    return true;
}
