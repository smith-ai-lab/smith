// front::fix_generic_mut, the fix-it for `x := v` that a generic function's body assigns later (#2613, area D): the
// checker reads the body of a generic function only through its instances, and an instance from another module
// carries no fix (#2386), so a template's `total := 0` followed by `total += x` is never mended where it is written.
// This pass reads the text of such a body: a local declared with `name := v` or `name: T = v` and assigned later by
// `name = v`, `name += v` (or the other operators) is written `mut name`. A member or an index is assigned through
// the name (`padded.width = w`) only when the declared type is a plain one: not a pointer, a slice, `auto` or `typeof`.
//
// The same holds for a pointer parameter: `fn write(buffer: *char, args...)` whose body writes through `buffer`
// (`buffer[i] = c`, `buffer.* = c`, `buffer.n = 1`) or passes it whole where a `*mut` is wanted (`Writer(buffer, ..)`
// with a `*mut char` field, `put(buffer, ..)` with a `*mut` parameter, both of this module) is `*mut char` (#2668):
// the checker's own fix for a write through a `*T` never sees the body of a template that no call of this module
// instantiates, and an instance from another module carries no fix.
//
//   fix_generic_mut::edits(source, module)   one fix for each local of a generic function's body that is assigned,
//                                            and for each pointer parameter that is written through
module front::fix_generic_mut;

import front::ast;
import front::parse as core;
import std::mem;

static Bool is_generic(const ast::Decl *d) {
    if (d->kind != .function) return false;
    ast::Param params[:] = d->kind.function.params;
    for (Usize i = 0; i < countof(params); i++) {
        if (params[i].is_const || params[i].is_constexpr || params[i].is_pack || params[i].is_rest) return true;
        const ast::TypeExpr *type = params[i].type;
        if (type != nullptr && type->kind == .auto_type) return true;
    }
    return false;
}

static Bool word_char(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
}

static Bool starts_word(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || ch == '_';
}

static Usize skip_space(Str source, Usize at, Usize end) {
    while (at < end && (source[at] == ' ' || source[at] == '\t'))
        at += 1;
    return at;
}

// Whether a statement starts at `at`: only blanks before it on its line, or the last character before it is one that
// ends a statement or opens a block.
static Bool at_statement_start(Str source, Usize at, Usize floor) {
    Usize back = at;
    while (back > floor && (source[back - 1] == ' ' || source[back - 1] == '\t'))
        back -= 1;
    if (back == floor) return false;
    char before = source[back - 1];
    return before == '\n' || before == '{' || before == ';' || before == '}';
}

static Usize word_end(Str source, Usize at, Usize end) {
    while (at < end && word_char(source[at]))
        at += 1;
    return at;
}

static Bool same(Str a, Str b) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// Whether the text at `at` is `=` (not `==`) or an operator followed by `=`.
static Bool is_assign_op(Str source, Usize at, Usize end) {
    if (at >= end) return false;
    char ch = source[at];
    if (ch == '=') return at + 1 >= end || source[at + 1] != '=';
    Usize op = 1;
    if ((ch == '<' || ch == '>') && at + 1 < end && source[at + 1] == ch)
        op = 2;
    else if (!(ch == '+' || ch == '-' || ch == '*' || ch == '/' || ch == '%' || ch == '&' || ch == '|' || ch == '^'))
        return false;
    return at + op < end && source[at + op] == '=' && (at + op + 1 >= end || source[at + op + 1] != '=');
}

// The end of `.name` and `[...]` steps after a name, or `at` when none follows.
static Usize skip_steps(Str source, Usize at, Usize end) {
    Usize p = at;
    for (Usize step = 0; step < end - at; step++) {
        if (p < end && source[p] == '.' && p + 1 < end && starts_word(source[p + 1])) {
            p = word_end(source, p + 1, end);
        } else if (p + 1 < end && source[p] == '.' && source[p + 1] == '*') {
            p += 2;
        } else if (p < end && source[p] == '[') {
            Usize depth = 0;
            while (p < end) {
                if (source[p] == '[') depth += 1;
                if (source[p] == ']') depth -= 1;
                p += 1;
                if (depth == 0) break;
            }
        } else {
            return p;
        }
    }
    return p;
}

// Whether the statement at `at`, which starts with `name`, assigns the local: `name = v` always, `name.f = v` and
// `name[i] = v` only when `through` (the declared type is a plain value).
static Bool assigns(Str source, Usize at, Usize end, Usize name_len, Bool through) {
    Usize p = skip_space(source, at + name_len, end);
    if (is_assign_op(source, p, end)) return true;
    if (!through) return false;
    Usize steps = skip_steps(source, at + name_len, end);
    if (steps == at + name_len) return false;
    return is_assign_op(source, skip_space(source, steps, end), end);
}

// The type written after `name:` starts at `at`; whether it is a plain value type. A pointer, a slice, an array,
// `auto`, `typeof` and an option are not (a member of a pointer is assigned without changing the pointer).
static Bool plain_type(Str source, Usize at, Usize end) {
    at = skip_space(source, at, end);
    if (at >= end || !starts_word(source[at])) return false;
    Usize stop = word_end(source, at, end);
    Str word = source[at:stop];
    return !same(word, "auto") && !same(word, "typeof") && !same(word, "type");
}

// The local declared at `at` (a statement that starts with a name): where its type starts, `at` for `name :=`, and
// the name's length. None when it is not a declaration.
static Bool declaration(Str source, Usize at, Usize end, Usize *name_len, Bool *plain) {
    if (at >= end || !starts_word(source[at])) return false;
    Usize stop = word_end(source, at, end);
    *name_len = stop - at;
    Usize p = skip_space(source, stop, end);
    if (p + 1 < end && source[p] == ':' && source[p + 1] == '=') {
        *plain = false;
        return true;
    }
    if (p < end && source[p] == ':' && (p + 1 >= end || source[p + 1] != ':')) {
        *plain = plain_type(source, p + 1, end);
        return true;
    }
    return false;
}

// Whether the keyword `mut` or another keyword stands where a name does: those words do not declare a local.
static Bool is_keyword(Str word) {
    return same(word, "mut") || same(word, "return") || same(word, "else") || same(word, "case") ||
           same(word, "default") || same(word, "const") || same(word, "if") || same(word, "for") ||
           same(word, "while") || same(word, "match") || same(word, "defer");
}

// Whether a later statement of the function (from `from` to `end`) assigns the local called `name`.
static Bool assigned_later(Str source, Usize from, Usize end, Str name, Bool plain, Usize floor) {
    for (Usize at = from; at < end; at++) {
        if (!starts_word(source[at]) || (at > 0 && word_char(source[at - 1]))) continue;
        if (!at_statement_start(source, at, floor)) continue;
        Usize stop = word_end(source, at, end);
        if (!same(source[at:stop], name)) continue;
        if (assigns(source, at, end, countof(name), plain)) return true;
    }
    return false;
}

static core::ParseError fix_at(Usize at) {
    core::Edits fix = {};
    fix = mem::realloc(fix, 1);
    fix[0] = (core::Edit){};
    fix[0].span.start = (U32)at;
    fix[0].span.end = (U32)at;
    fix[0].text = "mut ";
    core::ParseError error = {};
    error.span = fix[0].span;
    error.message = "the local is assigned: declare it `mut`";
    error.fix = fix;
    return error;
}

static core::Errors scan(Str source, Usize start, Usize end, core::Errors out) {
    for (Usize at = start; at < end; at++) {
        if (!starts_word(source[at]) || (at > 0 && word_char(source[at - 1]))) continue;
        if (!at_statement_start(source, at, start)) continue;
        Usize name_len = 0;
        Bool plain = false;
        if (!declaration(source, at, end, &name_len, &plain)) continue;
        Str name = source[at:at + name_len];
        if (is_keyword(name)) continue;
        if (!assigned_later(source, at + name_len, end, name, plain, start)) continue;
        out = mem::realloc(out, countof(out) + 1);
        out[countof(out) - 1] = fix_at(at);
    }
    return out;
}

// Whether the word at `at` (length `len`) is a whole word and not a member (`x.buffer`).
static Bool is_whole_word(Str source, Usize at, Usize len, Usize floor) {
    if (at > floor && (word_char(source[at - 1]) || source[at - 1] == '.')) return false;
    return at + len >= countof(source) || !word_char(source[at + len]);
}

// The `*mut` of the parameter or field `type`: true when it is a pointer written `*mut T`.
static Bool is_mut_pointer(const ast::TypeExpr *type) {
    return type != nullptr && type->kind == .pointer && type->kind.pointer.is_mut;
}

// Whether the argument at `at` of a call or construction is wanted as a `*mut` by a function or a struct of this
// module: the callee's name stands before the `(` that opens the list, and the argument is the n-th of it.
static Bool wanted_mut(const ast::Module *module, Str source, Usize at, Usize floor) {
    Usize depth = 0;
    Usize index = 0;
    Usize open = at;
    while (open > floor) {
        open -= 1;
        char ch = source[open];
        if (ch == ')' || ch == ']') {
            depth += 1;
        } else if (ch == '(' || ch == '[') {
            if (depth > 0)
                depth -= 1;
            else if (ch == '(')
                break;
            else
                return false;
        } else if (ch == ',' && depth == 0) {
            index += 1;
        }
    }
    if (open <= floor || source[open] != '(') return false;
    Usize stop = open;
    Usize start = stop;
    while (start > floor && word_char(source[start - 1]))
        start -= 1;
    if (start == stop || (start > floor && source[start - 1] == '.')) return false;
    Str callee = source[start:stop];
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind == .function && same(d->kind.function.name, callee)) {
            return index < countof(d->kind.function.params) && is_mut_pointer(d->kind.function.params[index].type);
        }
        if (d->kind == .record && same(d->kind.record.name, callee)) {
            return index < countof(d->kind.record.fields) && is_mut_pointer(d->kind.record.fields[index].type);
        }
    }
    return false;
}

// Whether the body (from `start` to `end`) writes through the pointer called `name`, or hands it whole to a `*mut`.
static Bool pointer_written(const ast::Module *module, Str source, Usize start, Usize end, Str name) {
    for (Usize at = start; at < end; at++) {
        if (!starts_word(source[at]) || !is_whole_word(source, at, countof(name), start)) continue;
        if (!same(source[at:at + countof(name)], name)) continue;
        Usize after = at + countof(name);
        Usize steps = skip_steps(source, after, end);
        if (steps != after && is_assign_op(source, skip_space(source, steps, end), end)) return true;
        Usize back = at;
        while (back > start && (source[back - 1] == ' ' || source[back - 1] == '\t' || source[back - 1] == '\n'))
            back -= 1;
        Usize next = skip_space(source, after, end);
        Bool opens = back > start && (source[back - 1] == '(' || source[back - 1] == ',');
        Bool closes = next < end && (source[next] == ',' || source[next] == ')');
        if (opens && closes && wanted_mut(module, source, at, start)) return true;
    }
    return false;
}

static core::ParseError mut_pointer_fix(Usize star) {
    core::Edits fix = {};
    fix = mem::realloc(fix, 1);
    fix[0] = (core::Edit){};
    fix[0].span.start = (U32)star + 1;
    fix[0].span.end = (U32)star + 1;
    fix[0].text = "mut ";
    core::ParseError error = {};
    error.span = fix[0].span;
    error.message = "the pointer is written through: declare it `*mut`";
    error.fix = fix;
    return error;
}

static core::Errors pointer_params(const ast::Module *module, Str source, ast::Param params[:], Usize body, Usize end,
                                   core::Errors out) {
    for (Usize i = 0; i < countof(params); i++) {
        const ast::TypeExpr *type = params[i].type;
        if (type == nullptr || type->kind != .pointer || type->kind.pointer.is_mut) continue;
        Usize star = type->span.start;
        if (star >= countof(source) || source[star] != '*') continue;
        if (!pointer_written(module, source, body, end, params[i].name)) continue;
        out = mem::realloc(out, countof(out) + 1);
        out[countof(out) - 1] = mut_pointer_fix(star);
    }
    return out;
}

export core::Errors edits(Str source, const ast::Module *module) {
    core::Errors out = {};
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind != .function) continue;
        const ast::Stmt *function_body = d->kind.function.body;
        ast::Param params[:] = d->kind.function.params;
        if (function_body != nullptr && is_generic(d)) {
            Usize end = d->span.end < countof(source) ? d->span.end : countof(source);
            Usize body = function_body->span.start;
            if (body < end) out = scan(source, body, end, out);
            if (body < end) out = pointer_params(module, source, params, body, end, out);
        }
    }
    return out;
}
