// front::lsp_definition: `textDocument/definition` for `.smith` on smith's own front end (#1893, a piece of #1887). The
// declaration a name under the cursor stands for: a name of the file, a name through an import (`q.name`, `q::name`,
// a `from ... import` name), a module's or a C header's (the place clang records for it).
//
//   result(path, source, line, character)   the JSON for the `result` of the reply: `null` when nothing is found, else
//                                           `{"uri":...,"range":{...}}`
//   offset_of(source, line, character)      the byte offset of a 0-based line and byte column
//   position(source, offset)                `{"line":L,"character":C}` of a byte offset
//
// A position is a line and a byte count in the line (LSP asks for UTF-16 units; the two agree on ASCII). The text is
// the current allocator's.
module front::lsp_definition;

import front::compile;
import front::roots;
import std::files;
import std::format;
import std::mem;

static Str as_str(char chars[:]) {
    return chars;
}

// The byte offset of the 0-based `line` and `character` in `source`; the end of the text when the line is past it.
export U32 offset_of(Str source, U64 line, U64 character) {
    U64 seen = 0;
    Usize i = 0;
    while (i < countof(source) && seen < line) {
        if (source[i] == '\n') seen += 1;
        i += 1;
    }
    U64 column = 0;
    while (i < countof(source) && column < character && source[i] != '\n') {
        i += 1;
        column += 1;
    }
    return (U32)i;
}

// The 0-based line and the byte column of the byte `offset` of `source`, as `{"line":L,"character":C}`.
export Str position(Str source, U32 offset) {
    U64 line = 0;
    U64 column = 0;
    for (Usize i = 0; i < countof(source) && i < offset; i++) {
        if (source[i] == '\n') {
            line += 1;
            column = 0;
        } else {
            column += 1;
        }
    }
    return as_str(format::push("{\"line\":", line, ",\"character\":", column, "}"));
}

// `text` as the inside of a JSON string.
export Str escape(Str text) {
    Str out = "";
    for (Usize i = 0; i < countof(text); i++) {
        char ch = text[i];
        if (ch == '"' || ch == '\\') {
            out = as_str(format::push(out, "\\", text[i:i + 1]));
        } else if ((U8)ch < 32) {
            out = as_str(format::push(out, " "));
        } else {
            out = as_str(format::push(out, text[i:i + 1]));
        }
    }
    return out;
}

// The text of the file `path`, empty when it cannot be read.
static Str read_text(Str path) {
    files::BytesResult loaded = files::read_file(path);
    if (loaded == .error) return "";
    format::Chars chars = mem::view(loaded.ok, char);
    Str text = chars;
    return text;
}

static Str range_json(Str source, U32 start, U32 end) {
    return as_str(format::push("{\"start\":", position(source, start), ",\"end\":", position(source, end), "}"));
}

// The `result` of a definition request at `line` and `character` of the text `source` of the file `path`.
export Str result(Str path, Str source, U64 line, U64 character) {
    U32 offset = offset_of(source, line, character);
    compile::Location found = compile::definition_at(path, source, roots::default_roots(), offset);
    if (!found.found) return "null";
    Str uri = as_str(format::push("file://", escape(found.file)));
    if (found.by_line) {
        if (countof(found.file) == 0 || found.line == 0) return "null";
        U64 l = found.line - 1;
        U64 c = found.column == 0 ? 0 : found.column - 1;
        Str spot = as_str(format::push("{\"line\":", l, ",\"character\":", c, "}"));
        return as_str(format::push("{\"uri\":\"", uri, "\",\"range\":{\"start\":", spot, ",\"end\":", spot, "}}"));
    }
    Str text = roots::same(found.file, path) ? source : read_text(found.file);
    return as_str(format::push("{\"uri\":\"", uri, "\",\"range\":", range_json(text, found.start, found.end), "}"));
}
