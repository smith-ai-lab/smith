// front::parse, the core of the parser of smith's own front end (#1112, A2 of track A; internal, not wired into
// `smith cc`).
//
// A `Parser` is the tokens of one file (front::lex), the text they lie in, a position and the errors found so far. The
// cursor functions are all the parsers of the other files need to read tokens:
//
//   parse::make(tokens, source)         a parser at the first token, with no errors and no hooks
//   parse::peek(p), peek_at(p, n)       the token at the position, or n after it (the end of the file past the end)
//   parse::advance(p)                   takes the token at the position and moves past it (never past the end of file)
//   parse::at(p, kind)                  whether the token at the position has this kind
//   parse::accept(p, kind)              takes it and says true when it has, else does nothing
//   parse::expect(p, kind, what)        takes it when it has; else records `expected <what>, found <text>` and takes
//   nothing parse::text(p, token)               the source text of a token parse::error(p, span, message)      records
//   an error; parsing goes on parse::span_from(p, start)          from a start offset to the end of the last token
//   taken
//
// Expressions, statements and declarations are parsed in three other files (A3, A4, A5) that call each other only
// through the four hooks of the parser, so each can be tested with stubs before the others exist and one module wires
// the real ones in (A6): a test or the wiring sets `p.hooks.expression` and its three siblings, and
// `parse::expression(p)`, `parse::type(p)`, `parse::statement(p)` and `parse::declaration(p)` call them. A hook that is
// not set records the error `no parser for an expression is installed` and gives a null pointer. The hooks are
// scaffolding of the parser's own code, not a feature of the language: in the language a function value is `Fn(F)`.
//
// The errors are the allocator's, as the tree is: a caller that sets an arena as the current allocator frees both with
// it.
module front::parse;

import front::ast;
import front::lex;
import std::arena;
import std::format;
import std::mem;

// The four entry points. Each reads one construct from the parser and gives its node, or null after recording an error.
export struct Parser;

export typedef struct {
    ast::Expr *(*expression)(Parser *);
    ast::TypeExpr *(*type)(Parser *);
    ast::Stmt *(*statement)(Parser *);
    ast::Decl *(*declaration)(Parser *);
} Hooks;

// One change a fix makes: the text of `span` becomes `text` (an empty span inserts, an empty text deletes).
export typedef struct {
    ast::Span span;
    Str text;
} Edit;

export typedef typeof(Edit[:]) Edits;

export typedef typeof(Str[:]) Names;

// What went wrong and where. `fix` is the edits that mend it (empty: none), applied together or not at all by
// `smith lint --fix` (parser::apply_fixes). An old form that still compiles goes in the parser's `warnings`, not here.
export typedef struct {
    ast::Span span;
    Str message;
    Edits fix;
} ParseError;

export typedef typeof(ParseError[:]) Errors;

// The state of a parse: the tokens (ending with an `end_of_file` token), the text they lie in, the position of the next
// one, and the errors recorded so far (in the order they were found).
// A braced list with no type whose items are all `.field = value`: where its braces are and the edits that drop the
// dots, kept for the declaration it initializes (`P p = {.x = 1};` is `let p = P(x = 1)`, #1767).
export struct NamedList {
    Bool plain;
    Bool positional; // the items have no designators: `Format f = {1, 2};` is `Format(1, 2)`
    ast::Span open;
    ast::Span close;
    Edits edits;
};

export struct Parser {
    lex::Tokens tokens;
    Str source;
    Usize position;
    Errors errors;
    Errors warnings; // old forms that still compile, with their fixes: kept apart so `errors` stays the failures
    Hooks hooks;
    NamedList named_list; // the last untyped list with only field designators
    Bool head;     // the next expression is a condition head (`if`, `while`, `for ... in`, `match`): no trailing block
                   // at its top level, so a `{` opens the body (#961)
    Bool for_init; // a declaration is the init of a `for (...)`: its `;` stays, it separates the header's parts
    Bool in_value; // an `if` is read as a value (an argument, an operand): a `,` or `)` ends its branch statement
    Bool new_syntax; // the tokens come from lex::tokenize_new: `.`, `(`, `[` and `{` also start smith's own forms
                     // (#1446)
    Names modules;   // the names that the imports read so far bind (`import std.format` binds `format`): `m.to(x)` on
                     // one is a call of the module's function, not the conversion `x.to(T)` (#2104)
    Bool layout;     // the tokens went through lex::layout: blocks are `:` and `indent` ... `dedent`, a statement ends
                     // with `newline` (#1856; parser::parse_new chooses, #1859 removes the other path)
};

// Records that an import binds `name` in the file.
export void bind_module(Parser *p, Str name) {
    if (countof(name) == 0) return;
    Usize count = countof(p->modules);
    p->modules = mem::realloc(p->modules, count + 1);
    p->modules[count] = name;
}

// Whether an import has bound `name`.
export Bool is_module(const Parser *p, Str name) {
    for (Usize i = 0; i < countof(p->modules); i += 1) {
        Str bound = p->modules[i];
        if (countof(bound) == countof(name) && (countof(name) == 0 || mem::equal(bound, name))) return true;
    }
    return false;
}

// A parser at the first token with no errors and no hooks. The tokens must end with the end of the file, as
// lex::tokenize gives them.
export Parser make(lex::Tokens tokens, Str source) {
    Parser parser = {.tokens = tokens, .source = source};
    return parser;
}

// The token `offset` places after the position; past the end of the tokens, the last one, the end of the file.
export lex::Token peek_at(const Parser *p, Usize offset) {
    Usize last = countof(p->tokens) - 1;
    Usize at_offset = p->position + offset;
    return p->tokens[at_offset < last ? at_offset : last];
}

// The token at the position.
export lex::Token peek(const Parser *p) {
    return peek_at(p, 0);
}

// Takes the token at the position and moves past it; at the end of the file the position stays.
export lex::Token advance(Parser *p) {
    lex::Token token = peek(p);
    if (token.kind != lex::end_of_file) p->position += 1;
    return token;
}

// Whether the token at the position has this kind.
export Bool at(const Parser *p, lex::TokenKind kind) {
    return peek(p).kind == kind;
}

// Takes the token when it has this kind and says so; else does nothing.
export Bool accept(Parser *p, lex::TokenKind kind) {
    if (!at(p, kind)) return false;
    advance(p);
    return true;
}

// The source text of a token.
export Str text(const Parser *p, lex::Token token) {
    return lex::text(p->source, token);
}

// Records an error. Parsing goes on: it is the caller's job to recover.
export void error(Parser *p, ast::Span span, Str message) {
    p->errors = mem::realloc(p->errors, countof(p->errors) + 1);
    ParseError failure = {.span = span, .message = message};
    p->errors[countof(p->errors) - 1] = failure;
}

// Records an error that carries a fix. Parsing goes on.
export void error_fix(Parser *p, ast::Span span, Str message, Edits edits) {
    p->errors = mem::realloc(p->errors, countof(p->errors) + 1);
    ParseError failure = {.span = span, .message = message, .fix = edits};
    p->errors[countof(p->errors) - 1] = failure;
}

// Records an old form with its fix as a warning: the file still compiles, and `smith lint --fix` mends it. It goes in
// `warnings`, never in `errors`.
export void warning_fix(Parser *p, ast::Span span, Str message, Edits edits) {
    p->warnings = mem::realloc(p->warnings, countof(p->warnings) + 1);
    ParseError failure = {.span = span, .message = message, .fix = edits};
    p->warnings[countof(p->warnings) - 1] = failure;
}

// The source between two offsets with the fixes of the old types inside it applied, so a declaration or a cast that
// writes its type again writes the type as smith's own (`Key *` is `*Key`): without it the next pass reads `p: Key *`
// or `as I32`, which is no form at all. Edits are taken in source order, the wider first, and one that starts inside
// another is left out.
export Str mended(const Parser *p, U32 start, U32 end) {
    Edits inside = {};
    for (Usize i = 0; i < countof(p->warnings); i++) {
        Edits fix = p->warnings[i].fix;
        for (Usize j = 0; j < countof(fix); j++) {
            if (fix[j].span.start < start || fix[j].span.end > end) continue;
            inside = mem::realloc(inside, countof(inside) + 1);
            Usize at = countof(inside) - 1;
            while (at > 0 &&
                   (inside[at - 1].span.start > fix[j].span.start ||
                    (inside[at - 1].span.start == fix[j].span.start && inside[at - 1].span.end < fix[j].span.end))) {
                inside[at] = inside[at - 1];
                at -= 1;
            }
            inside[at] = fix[j];
        }
    }
    char text[:] = format::push("");
    U32 from = start;
    for (Usize i = 0; i < countof(inside); i++) {
        if (inside[i].span.start < from) continue;
        text = format::push(text, p->source[from:inside[i].span.start], inside[i].text);
        from = inside[i].span.end;
    }
    text = format::push(text, p->source[from:end]);
    return text;
}

// The old module separator `::` read where a path continues: a warning whose fix writes `.` (#1676). `.` is the only
// separator of smith's own syntax.
export void warn_separator(Parser *p, lex::Token colons) {
    Str dot = ".";
    Edit change = {.span = colons.span, .text = dot};
    Edits edits = mem::alloc_slice(Edit, 1);
    edits[0] = change;
    warning_fix(p, colons.span, "`::` is written `.`: write `a.b`", edits);
}

// Takes the token when it has this kind. Else it records `expected <what>, found <text>` at the token (`found the end
// of the file` at the end) and takes nothing: the token at the position is returned either way.
export lex::Token expect(Parser *p, lex::TokenKind kind, Str what) {
    lex::Token token = peek(p);
    if (token.kind == kind) return advance(p);
    Str found = text(p, token);
    if (token.kind == lex::end_of_file) {
        char message[:] = format::push("expected ", what, ", found the end of the file");
        error(p, token.span, message);
    } else {
        char message[:] = format::push("expected ", what, ", found `", found, "`");
        error(p, token.span, message);
    }
    return token;
}

// From a start offset to the end of the last token taken (the start itself when none was taken since).
export ast::Span span_from(const Parser *p, U32 start) {
    ast::Span span = {.start = start, .end = start};
    if (p->position > 0) {
        U32 end = p->tokens[p->position - 1].span.end;
        if (end > start) span.end = end;
    }
    return span;
}

// Reads an expression through the hook of A3.
export ast::Expr *expression(Parser *p) {
    if (p->hooks.expression == nullptr) {
        Str message = "no parser for an expression is installed";
        error(p, peek(p).span, message);
        return nullptr;
    }
    return p->hooks.expression(p);
}

// The error of a type hook that is not set. It is a function of its own because the body of a function named `type`
// is read as a type function's by today's smith (a string literal does not convert to `Str` in it): the name is free
// when types are rewritten to `Type` (#366).
static void missing_type(Parser *p) {
    Str message = "no parser for a type is installed";
    error(p, peek(p).span, message);
}

// Reads a type through the hook of A5.
export ast::TypeExpr *type(Parser *p) {
    if (p->hooks.type == nullptr) {
        missing_type(p);
        return nullptr;
    }
    return p->hooks.type(p);
}

// Reads a statement through the hook of A4.
export ast::Stmt *statement(Parser *p) {
    if (p->hooks.statement == nullptr) {
        Str message = "no parser for a statement is installed";
        error(p, peek(p).span, message);
        return nullptr;
    }
    return p->hooks.statement(p);
}

// Reads a declaration through the hook of A5.
export ast::Decl *declaration(Parser *p) {
    if (p->hooks.declaration == nullptr) {
        Str message = "no parser for a declaration is installed";
        error(p, peek(p).span, message);
        return nullptr;
    }
    return p->hooks.declaration(p);
}
