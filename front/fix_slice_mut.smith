// front::fix_slice_mut, the fix-it for a slice that a function hands to std.mem to write (#3073).
//
//   mut parts: []str = []                     mut parts: []mut str = []
//   parts = mem.realloc(parts, n + 1)         parts = mem.realloc(parts, n + 1)
//
// C's `T xs[:]` is a writable slice, and the fixer writes a local or a parameter as the read-only `[]T`: a field keeps
// C's `[]mut T`, but a local or parameter that is only read must stay `[]T`, since one given the slice field of a `*T`
// record would refuse it. std.mem's `realloc`, `try_realloc`, `copy` and `move` take a `[]mut T`, and the fixer's own
// checker does not see it (the import is read before `fix_typeof` writes its `[]mut T`), so the compile said "this
// drops const" and nothing mended it. The rule reads the text: a local `name: []T` or a parameter `name: []T` that the
// same function hands to one of the four as the slice they write (`mem.realloc(name, ..)`, `mem.copy(name, ..)`,
// `mem.copy(name[0:n], ..)`) is `[]mut T`.
//
//   fix_slice_mut::edits(source)   one fix for each such local or parameter
module front::fix_slice_mut;

import front::ast;
import front::parse as core;
import std::mem;

static Bool starts_with(Str text, Str prefix) {
    if (countof(text) < countof(prefix)) return false;
    for (Usize i = 0; i < countof(prefix); i++)
        if (text[i] != prefix[i]) return false;
    return true;
}

static Bool word_char(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
}

// The end of the line that starts at `at`.
static Usize line_end(Str source, Usize at) {
    while (at < countof(source) && source[at] != '\n')
        at += 1;
    return at;
}

// The end of the function whose line ends at `end`: the start of the next line at column 0 (or the text's end).
static Usize function_end(Str source, Usize end) {
    Usize stop = end + 1;
    while (stop < countof(source) && (source[stop] == ' ' || source[stop] == '\n'))
        stop = line_end(source, stop) + 1;
    return stop < countof(source) ? stop : countof(source);
}

// Whether `text` hands `name` to `mem.realloc`, `mem.try_realloc`, `mem.copy` or `mem.move` as the slice they write:
// `name` (not `name2`, not `name.field`) right after the call's `(`, then `,`, `)` or a sub-slice `[`.
static Str mem_call(Usize c) {
    if (c == 0) return "mem.realloc(";
    if (c == 1) return "mem.try_realloc(";
    if (c == 2) return "mem.copy(";
    return "mem.move(";
}

static Bool written_by_mem(Str text, Str name) {
    for (Usize i = 0; i < countof(text); i++) {
        if (i > 0 && (word_char(text[i - 1]) || text[i - 1] == '.')) continue;
        for (Usize c = 0; c < 4; c++) {
            Str call = mem_call(c);
            if (!starts_with(text[i:countof(text)], call)) continue;
            Usize at = i + countof(call);
            if (!starts_with(text[at:countof(text)], name)) continue;
            Usize after = at + countof(name);
            if (after < countof(text) && (text[after] == ',' || text[after] == ')' || text[after] == '[')) return true;
        }
    }
    return false;
}

// The offset of the `[]` of a read-only slice type written right after `at` (`[]T`, not `[]mut T`), or 0.
static Usize read_only_slice(Str source, Usize at) {
    if (!starts_with(source[at:countof(source)], "[]")) return 0;
    if (starts_with(source[at + 2:countof(source)], "mut ")) return 0;
    return at;
}

// The fix that writes `mut ` after the `[]` at `brackets`.
static core::ParseError mut_fix(Usize brackets) {
    core::Edits fix = {};
    fix = mem::realloc(fix, 1);
    U32 after = (U32)(brackets + 2);
    ast::Span here = {.start = after, .end = after};
    Str word = "mut ";
    fix[0] = (core::Edit){.span = here, .text = word};
    core::ParseError made = {};
    made.span = here;
    Str why = "a slice that std.mem writes (`mem.realloc`, `mem.copy`) is `[]mut T`";
    made.message = why;
    made.fix = fix;
    return made;
}

static core::Errors push(core::Errors out, core::ParseError made) {
    out = mem::realloc(out, countof(out) + 1);
    out[countof(out) - 1] = made;
    return out;
}

// The fix for a local declared on the line `source[at:end]` as `name: []T` or `mut name: []T`, when the rest of its
// function hands it to std.mem to write; `out` as it was otherwise.
static core::Errors local_fix(Str source, Usize at, Usize end, core::Errors out) {
    Usize k = at;
    while (k < end && source[k] == ' ')
        k += 1;
    if (k == at) return out; // a line at column 0 is no local
    if (starts_with(source[k:end], "mut ")) k += 4;
    Usize from = k;
    while (k < end && word_char(source[k]))
        k += 1;
    if (k == from || !starts_with(source[k:end], ": ")) return out;
    Usize brackets = read_only_slice(source, k + 2);
    if (brackets == 0) return out;
    Str name = source[from:k];
    Usize body = function_end(source, end);
    if (end < body && written_by_mem(source[end:body], name)) out = push(out, mut_fix(brackets));
    return out;
}

// The fixes for the parameters `name: []T` of a function header on the line `source[at:end]` (`fn f(a: []u8, ..)`)
// that its body hands to std.mem to write.
static core::Errors parameter_fixes(Str source, Usize at, Usize end, core::Errors out) {
    Usize k = at;
    if (starts_with(source[k:end], "pub ")) k += 4;
    if (!starts_with(source[k:end], "fn ")) return out;
    Usize body = function_end(source, end);
    for (Usize i = k; i + 4 < end; i++) {
        if (source[i] != '(' && !(source[i] == ' ' && source[i - 1] == ',')) continue;
        Usize from = i + 1;
        Usize n = from;
        while (n < end && word_char(source[n]))
            n += 1;
        if (n == from || !starts_with(source[n:end], ": ")) continue;
        Usize brackets = read_only_slice(source, n + 2);
        if (brackets == 0) continue;
        if (end < body && written_by_mem(source[end:body], source[from:n])) out = push(out, mut_fix(brackets));
    }
    return out;
}

export core::Errors edits(Str source) {
    core::Errors out = {};
    Usize at = 0;
    while (at < countof(source)) {
        Usize end = line_end(source, at);
        out = local_fix(source, at, end, out);
        out = parameter_fixes(source, at, end, out);
        at = end + 1;
    }
    return out;
}
