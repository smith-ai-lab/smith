// front::parse_stmt, the statements of smith's own front end (#1112, A4 of track A; internal, not wired into `smith
// cc`).
//
// `parse_stmt::statement(p)` reads one statement into `ast::Stmt`; it is the hook, `p.hooks.statement =
// parse_stmt::statement`. Expressions, types and declarations come through the other hooks (`parse::expression`,
// `parse::declaration`); there is no symbol table, a capitalized name is a type and any other name is a value.
//
//   { ... }                    a block
//   if (c) s else s            `if constexpr (c) ...` sets `is_constexpr`; an `else` binds to the nearest `if`
//   while (c) s                `do s while (c);`
//   for (init; cond; step) s   `init` is a declaration (one name; the declaration takes its own `;`), an expression
//                              or nothing, `step` one expression (no comma operator); `for constexpr (...)`
//   for (T x : xs) s          a range for: `init` is the variable with no initializer, `range` is `xs`
//                              and `for (Usize i, T x : xs) s` also declares the index `i` (`index`)
//   switch (v) { case 1: case 2: ...; case .circle: ...; default: ... }
//                              consecutive labels join one `SwitchCase`; the statements up to the next label are its
//                              body
//   break; continue; return; return e; goto l; l: s; defer s; errdefer s; static_assert(c, "m"); ;
//   an expression statement, or a declaration (below)
//
// The new syntax (#1428, S4) is read beside these, into the same nodes. A statement ends at a `;` or at the end of its
// line (the lexer's line-break flag, Go's rule: `lex::ends_statement`), or before a `}`.
//
//   if c { } else if d { } else { }     no parentheses, braces required; `if let .some(x) = e { } else { }`
//   while c { }
//   for x in xs { }                     `for (i, x) in e { }`: a `for_in`
//   match s { .a => v ... }             one arm per line; `.b(x) => v`; `.c, .d => v`
//
// The old and the new form are told apart by a fixed lookahead, no symbol table: `if (c) s` is the old form when the
// `)` that closes the first `(` is followed by `{` or by the start of a statement, and `if c {` the new one when a `{`
// comes before the end of the line; `for (` is a new `for` when its `)` is followed by `in`. Where `(` follows the
// keyword and the token after the `)` could begin a statement (`(`: `if (a) (b) {`), the old form wins. After `-`, `*`
// and
// `&` a `{` before the end of the line makes it the new form: `if (a + 1) * 2 > n {` (#2226).
//
// A statement starts a declaration, and goes to `parse::declaration`, when it starts with a `type_name`, a path whose
// last name is a `type_name` (`geometry::Box b`), a type or storage keyword (`const`, `static`, `auto`, `struct`,
// `int`...), an attribute `[[`, or a `c::` path in the shape of a declaration (`c::size_t n;`, `c::stat *s;`); anything
// else is an expression statement. The `c::` rule is the orchestrator's recommendation, kept in `c_path_declaration`.
//
// There is no recursion: the constructs that hold a statement (blocks, branches, loops, labels, `defer`, `switch`) are
// frames of an explicit stack, so a deeply nested statement costs memory and never the call stack. A finished statement
// is handed to the frame under it (`deliver`), which either takes it or closes and hands its own up.
//
// Recovery: after an error inside a statement, the rest of it is skipped (to the next `;` at the same depth, or to the
// `}` that ends the block) and the statement is an `empty` placeholder, so one mistake gives one error and the next
// statement parses. A broken `(...)` header is skipped as a whole and the body still parses.
module front::parse_stmt;

import front::ast;
import front::lex;
import front::parse;
import front::parse_decl;
import front::parse_type;
import std::format;
import std::mem;

// What an open construct waits for.
// NOLINTBEGIN(readability-identifier-naming)
enum FrameKind {
    block_frame,   // statements up to `}`
    if_then,       // the then branch
    if_else,       // the else branch
    while_body,    // the body of a while
    do_body,       // the body of a do, then `while (c);`
    for_body,      // the body of a for
    switch_frame,  // labels and statements up to `}`
    label_body,    // the statement after `l:`
    defer_body,    // the statement after `defer`
    errdefer_body, // the statement after `errdefer`
    for_in_body,   // the body of a `for x in xs`
};
// NOLINTEND(readability-identifier-naming)

// An open construct. One struct for all kinds, so the stack is one slice; each kind uses the fields it needs.
struct Frame {
    FrameKind kind;
    U32 start;
    ast::Expr *condition;
    ast::Stmt *init;
    ast::Expr *step;
    ast::Expr *range; // a range `for (T x : range)`
    ast::Stmt *index; // and its index, `for (Usize i, T x : range)`
    ast::Stmt *first; // the then branch while the else is read
    Bool is_constexpr;
    Str label;
    ast::StmtRef items[:]; // a block's statements: the first `item_count` of the slice are in use
    Usize item_count;
    ast::SwitchCase cases[:];
    ast::ExprRef values[:]; // the open case of a switch: the first `value_count` of the slice
    Usize value_count;
    ast::StmtRef body[:]; // and its statements, the first `body_count`
    Usize body_count;
    Bool case_open;
    Bool case_default;
    U32 case_start;
    Bool no_body;         // the `{` of a new form is missing: the body is an empty statement
    Bool braced;          // the new form of `if` and `while`: the body is a block
    Bool layout;          // a block that ends at its `dedent`, not at a `}`
    Bool is_let;          // `if let pattern = value`: `condition` is the value
    ast::Pattern pattern; // and its pattern
    // An old header and the fix that writes it as smith's own, recorded once the body is known (old_header_fix).
    Bool old;
    Bool has_close;  // the `)` of the header is an edit of its own (`if` and `while`)
    Bool else_wrap;  // the `else` of an old `if` has a body with no braces
    U32 else_end;    // and where that `else` ends
    ast::Span cut;   // the text of the header the fix replaces
    Str head;        // and what replaces it
    ast::Span close; // the `)`, when `has_close`
    Str message;
    Str tail;        // a `for` written as `while`: the step, put before the `}` of the body
    Usize body_from; // and the token where the body starts (0: not a `while`)
    Bool wrapped;    // and the `while` is inside a block with the init: a `}` closes it
    // An old `switch` and the fix that writes it as `match` (case_fix): its edits so far, in source order.
    parse::Edits switch_edits;
    Usize switch_edit_count;
    Usize switch_warning; // where its warning is in `warnings`
    Usize last_label;     // the edit of the open case's last label
    Bool switch_bad;      // a case has no `match` arm: the warning keeps no fix
};

struct Stack {
    Frame frames[:];
    Usize depth;
};

static void push(Stack *stack, Frame frame) {
    if (stack->depth == countof(stack->frames)) {
        stack->frames = mem::realloc(stack->frames, stack->depth * 2 + 8);
    }
    stack->frames[stack->depth] = frame;
    stack->depth += 1;
}

typedef typeof(ast::StmtRef[:]) StmtList;
typedef typeof(ast::ExprRef[:]) ExprList;

// A list of statements (or expressions) with room for one more after the first `count`. The room doubles, so a long
// block is read in linear time. Not mem::alloc_slice: its instance for a pointer element draws the lint of a multilevel
// conversion (as in ast.smith).
static StmtList room_for_statement(StmtList list, Usize count) {
    if (count < countof(list)) return list;
    Usize capacity = count * 2 + 4;
    ast::StmtRef *block = (ast::StmtRef *)mem::alloc_array_raw(sizeof(ast::StmtRef), capacity, alignof(ast::StmtRef));
    for (Usize i = 0; i < count; i++)
        block[i] = list[i];
    StmtList bigger = block[0:capacity];
    return bigger;
}

static ExprList room_for_expression(ExprList list, Usize count) {
    if (count < countof(list)) return list;
    Usize capacity = count * 2 + 4;
    ast::ExprRef *block = (ast::ExprRef *)mem::alloc_array_raw(sizeof(ast::ExprRef), capacity, alignof(ast::ExprRef));
    for (Usize i = 0; i < count; i++)
        block[i] = list[i];
    ExprList bigger = block[0:capacity];
    return bigger;
}

static Frame *top(Stack *stack) {
    return &stack->frames[stack->depth - 1];
}

// ---------------------------------------------------------------------------------------------------------------
// Old forms: warnings with the fix that writes smith's own form (#1428, F3)

static parse::Edit edit(ast::Span span, Str text) {
    return (parse::Edit){.span = span, .text = text};
}

// A list of `count` edits to fill in.
static parse::Edits edit_list(Usize count) {
    parse::Edits list = {};
    return mem::realloc(list, count);
}

static ast::Span point(U32 at) {
    return (ast::Span){.start = at, .end = at};
}

// A warning that has no mechanical fix: the message says what to write.
static void warn(parse::Parser *p, ast::Span span, Str message) {
    parse::Edits none = {};
    parse::warning_fix(p, span, message, none);
}

// ---------------------------------------------------------------------------------------------------------------
// Recovery

static Bool opens(lex::TokenKind kind) {
    return kind == lex::left_paren || kind == lex::left_bracket || kind == lex::left_brace;
}

static Bool closes(lex::TokenKind kind) {
    return kind == lex::right_paren || kind == lex::right_bracket || kind == lex::right_brace;
}

// Skips the rest of a broken statement: past the next `;` at the same depth, or up to the `}` that ends the block.
static void skip_statement(parse::Parser *p) {
    Usize depth = 0;
    while (!parse::at(p, lex::end_of_file)) {
        lex::TokenKind kind = parse::peek(p).kind;
        if (depth == 0 && kind == lex::right_brace) return;
        if (p->layout && depth == 0 && kind == lex::dedent) return;
        if (p->layout && depth == 0 && kind == lex::newline) {
            parse::advance(p);
            return;
        }
        if (depth == 0 && kind == lex::semicolon) {
            parse::advance(p);
            return;
        }
        if (opens(kind))
            depth += 1;
        else if (closes(kind) && depth > 0)
            depth -= 1;
        parse::advance(p);
    }
}

// Goes back to the `(` at `open` and skips the whole group, so a broken header gives its one error and the body parses.
// Without a `(` there, the rest of the statement is skipped.
static void skip_group(parse::Parser *p, Usize open) {
    p->position = open;
    if (!parse::at(p, lex::left_paren)) {
        skip_statement(p);
        return;
    }
    Usize depth = 0;
    while (!parse::at(p, lex::end_of_file)) {
        lex::TokenKind kind = parse::advance(p).kind;
        if (opens(kind)) depth += 1;
        if (closes(kind) && depth > 0) depth -= 1;
        if (depth == 0) return;
    }
}

// Skips a broken case label to its `:`.
static void skip_label(parse::Parser *p) {
    while (!parse::at(p, lex::end_of_file) && !parse::at(p, lex::semicolon) && !parse::at(p, lex::right_brace)) {
        if (parse::advance(p).kind == lex::colon) return;
    }
}

// ---------------------------------------------------------------------------------------------------------------
// Pieces

// An expression through the hook; null, with an error recorded, when there is none.
static ast::Expr *expression(parse::Parser *p) {
    Usize before = countof(p->errors);
    ast::Expr *value = parse::expression(p);
    if (value == nullptr && countof(p->errors) == before) {
        parse::error(p, parse::peek(p).span, "expected an expression");
    }
    return value;
}

// A statement node of the kind, in the current allocator.
static ast::Stmt *new_stmt(ast::StmtKind kind) {
    return ast::new_stmt((ast::Stmt){.kind = kind});
}

static ast::Stmt *empty_stmt() {
    ast::StmtKind kind = .empty;
    return new_stmt(kind);
}

static ast::StmtKind break_kind() {
    return .break_stmt;
}

static ast::StmtKind continue_kind() {
    return .continue_stmt;
}

// The statement `node` with its span from `start` to the last token taken.
static ast::Stmt *spanned(const parse::Parser *p, U32 start, ast::Stmt *node) {
    node->span = parse::span_from(p, start);
    return node;
}

// What a leaf statement gives: the statement, or after an error the rest skipped and an `empty` placeholder.
static ast::Stmt *settle(parse::Parser *p, U32 start, Usize before, ast::Stmt *built) {
    if (countof(p->errors) > before) {
        skip_statement(p);
        built = empty_stmt();
    }
    return spanned(p, start, built);
}

// The condition of a header `( expression )`; `ok` is false when something was wrong (the group is then skipped).
struct Header {
    ast::Expr *condition;
    Bool ok;
    ast::Span open; // the `(` and the `)`, when ok
    ast::Span close;
};

static Header header(parse::Parser *p) {
    Header result = {};
    Usize open = p->position;
    result.open = parse::peek(p).span;
    Usize before = countof(p->errors);
    parse::expect(p, lex::left_paren, "`(`");
    if (countof(p->errors) == before) {
        result.condition = expression(p);
        parse::expect(p, lex::right_paren, "`)`");
    }
    result.ok = countof(p->errors) == before;
    if (result.ok) result.close = p->tokens[p->position - 1].span;
    if (!result.ok) skip_group(p, open);
    return result;
}

// Whether the keyword starts a declaration: a type or a storage class.
static Bool declaration_keyword(lex::TokenKind kind) {
    switch (kind) {
    case lex::kw_alignas:
    case lex::kw_atomic:
    case lex::kw_auto:
    case lex::kw_bit_int:
    case lex::kw_bool:
    case lex::kw_char:
    case lex::kw_complex:
    case lex::kw_const:
    case lex::kw_constexpr:
    case lex::kw_decimal32:
    case lex::kw_decimal64:
    case lex::kw_decimal128:
    case lex::kw_double:
    case lex::kw_enum:
    case lex::kw_extern:
    case lex::kw_float:
    case lex::kw_imaginary:
    case lex::kw_inline:
    case lex::kw_int:
    case lex::kw_long:
    case lex::kw_noreturn:
    case lex::kw_register:
    case lex::kw_restrict:
    case lex::kw_short:
    case lex::kw_signed:
    case lex::kw_static:
    case lex::kw_struct:
    case lex::kw_thread_local:
    case lex::kw_typedef:
    case lex::kw_typeof:
    case lex::kw_typeof_unqual:
    case lex::kw_union:
    case lex::kw_unsigned:
    case lex::kw_void:
    case lex::kw_volatile:
        return true;
    default:
        return false;
    }
}

// Whether the path of `last + 1` names starting at the position, `c::name` or `c::name::more`, is the `c::` path of a
// declaration. After `c::` case means nothing, so the shape decides: any `*`s, a name, then `=`, `;` or `[`. This is
// the one place the rule lives (the lead may still change it).
static Bool c_path_declaration(const parse::Parser *p, Usize last) {
    Usize at = last + 1;
    while (parse::peek_at(p, at).kind == lex::star)
        at += 1;
    lex::TokenKind named = parse::peek_at(p, at).kind;
    if (named != lex::name && named != lex::type_name) return false;
    lex::TokenKind after = parse::peek_at(p, at + 1).kind;
    return after == lex::equal || after == lex::semicolon || after == lex::left_bracket;
}

// Whether the statement starts with a path written with `.` that ends in a type name and is followed by a name or a
// `*`: `arena.Arena memory = ...` (what `smith lint --fix` writes for `arena::Arena memory`). A `.` before a type name
// follows a lowercase name only (`Color.Red` is a member of a type), as in parse_type's paths (#1746).
static Bool dotted_declaration(const parse::Parser *p) {
    if (!p->new_syntax) return false;
    Usize last = 0;
    while (parse::peek_at(p, last).kind == lex::name && parse::peek_at(p, last + 1).kind == lex::dot) {
        lex::TokenKind next = parse::peek_at(p, last + 2).kind;
        if (next != lex::name && next != lex::type_name) return false;
        last += 2;
    }
    if (last == 0 || parse::peek_at(p, last).kind != lex::type_name) return false;
    if (!parse_type::path_is_type(p, 0)) return false;
    lex::TokenKind after = parse::peek_at(p, last + 1).kind;
    return after == lex::name || after == lex::star;
}

// Whether a statement that starts with a name (a value's, as the case says) is a declaration: a path ending in a type
// name, a `c::` path in the shape of one, or a path and then a name (`once x`).
static Bool path_declaration(const parse::Parser *p) {
    if (dotted_declaration(p)) return true;
    Usize last = 0;
    while (parse::peek_at(p, last + 1).kind == lex::colon_colon) {
        lex::TokenKind next = parse::peek_at(p, last + 2).kind;
        if (next != lex::name && next != lex::type_name) break;
        last += 2;
    }
    Str c_name = "c";
    if (last > 0 && mem::equal(parse::text(p, parse::peek(p)), c_name)) return c_path_declaration(p, last);
    if (parse::peek_at(p, last).kind == lex::type_name && last > 0) return true;
    // `once x = 1.5;`: a name and a name is no expression, so the first names a type value (the checker decides).
    return parse::peek_at(p, last + 1).kind == lex::name;
}

// Whether the `(` that is `offset` tokens ahead closes with a `)` that a name or a `*` follows: `Fn(I32 (I32)) f` is a
// type called with a variable after it, `T(1)` alone is a construction (#2145).
static Bool group_then_declarator(const parse::Parser *p, Usize offset) {
    Usize depth = 0;
    Usize at = offset;
    for (Usize i = 0; i < countof(p->tokens); i += 1) {
        lex::TokenKind kind = parse::peek_at(p, at).kind;
        if (kind == lex::end_of_file) return false;
        if (kind == lex::left_paren) depth += 1;
        if (kind == lex::right_paren) depth -= 1;
        at += 1;
        if (depth == 0) break;
    }
    lex::TokenKind after = parse::peek_at(p, at).kind;
    return after == lex::name || after == lex::star;
}

// Declaration or expression at the start of a statement, with no symbol table.
static Bool starts_declaration(const parse::Parser *p) {
    lex::TokenKind kind = parse::peek(p).kind;
    // In smith's own syntax a type name and `(` is a construction, `T(1)`, not a declarator; `T (*f)(A)` is one
    // (#2145).
    if (kind == lex::type_name && p->new_syntax && parse::peek_at(p, 1).kind == lex::left_paren &&
        parse::peek_at(p, 2).kind != lex::star && !group_then_declarator(p, 1))
        return false;
    if (kind == lex::type_name || declaration_keyword(kind)) return true;
    if (kind == lex::left_bracket) return parse::peek_at(p, 1).kind == lex::left_bracket;
    if (kind == lex::name) return path_declaration(p) || parse_type::call_type_ahead(p, 0);
    return false;
}

// ---------------------------------------------------------------------------------------------------------------
// Leaf statements

// Whether a line break follows the last token taken and ends a statement (`lex::ends_statement`).
static Bool last_token_ends_line(const parse::Parser *p) {
    return p->position > 0 && lex::ends_statement(p->tokens[p->position - 1]);
}

// The end of a leaf statement: a `;`, the end of the line, or a `}` that closes the block. Anything else is the error
// "expected `;`".
static void end_statement(parse::Parser *p) {
    lex::Token mark = parse::peek(p);
    if (parse::accept(p, lex::semicolon)) {
        // Where a line break or a `}` follows, the `;` goes; in the middle of a line it still separates two statements.
        if (mark.line_break || parse::at(p, lex::right_brace) || parse::at(p, lex::end_of_file)) {
            parse::Edits edits = edit_list(1);
            edits[0] = edit(mark.span, "");
            parse::warning_fix(p, mark.span, "a statement ends with the line, not `;`: remove it", edits);
        }
        return;
    }
    if (last_token_ends_line(p) || parse::at(p, lex::right_brace)) return;
    // A trailing block (`f(x):` and its lines) ends with its `dedent`, and that ends the statement too.
    if (p->layout && p->position > 0 && p->tokens[p->position - 1].kind == lex::dedent) return;
    if (p->layout && (parse::at(p, lex::newline) || parse::at(p, lex::dedent) || parse::at(p, lex::end_of_file) ||
                      parse::at(p, lex::kw_else)))
        return;
    // An `if c: a else: b` in an argument list or an index ends with its `,`, `)` or `]` (#2224).
    if (p->layout && p->in_value &&
        (parse::at(p, lex::comma) || parse::at(p, lex::right_paren) || parse::at(p, lex::right_bracket)))
        return;
    parse::expect(p, lex::semicolon, "`;`");
}

static ast::Stmt *declaration_statement(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    Usize before = countof(p->errors);
    ast::Decl *decl = parse::declaration(p);
    if (decl == nullptr && countof(p->errors) == before) {
        parse::error(p, parse::peek(p).span, "expected a declaration");
    }
    return settle(p, start, before, new_stmt({.declaration = {.decl = decl}}));
}

// Whether the statement is a binding in smith's own syntax: `let a = v`, `let mut a: T = v` or `const A = v`.
static Bool new_binding(const parse::Parser *p) {
    return parse_decl::starts_binding(p);
}

// `let (q, mut r) = f()`: the declaration parser reads it, whole.
static ast::Stmt *destructure_statement(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    Usize before = countof(p->errors);
    ast::Stmt *built = parse_decl::destructure(p);
    return settle(p, start, before, built);
}

static ast::Stmt *expression_statement(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    Usize before = countof(p->errors);
    ast::Expr *value = expression(p);
    if (countof(p->errors) == before) end_statement(p);
    return settle(p, start, before, new_stmt({.expression = {.value = value}}));
}

// Whether the statement starts an extended `__asm__`: `__asm__ volatile`, or a `:` among the tokens of its `( )`.
static Bool extended_asm(const parse::Parser *p) {
    lex::Token first = parse::peek(p);
    if (first.kind != lex::name) return false;
    Str word = parse::text(p, first);
    Str extended = "__asm__";
    Str plain = "__asm";
    if (!mem::equal(word, extended) && !mem::equal(word, plain)) return false;
    if (parse::peek_at(p, 1).kind == lex::kw_volatile) return true;
    if (parse::peek_at(p, 1).kind != lex::left_paren) return false;
    Usize depth = 0;
    for (Usize i = 1; parse::peek_at(p, i).kind != lex::end_of_file; i += 1) {
        lex::TokenKind kind = parse::peek_at(p, i).kind;
        if (kind == lex::colon && depth == 1) return true;
        if (opens(kind)) depth += 1;
        if (closes(kind)) depth -= 1;
        if (depth == 0) return false;
    }
    return false;
}

// An extended `__asm__` statement is an error that names the std function of the optimization barrier.
static ast::Stmt *asm_statement(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    Usize before = countof(p->errors);
    parse::error(p, parse::peek(p).span, "extended asm is not part of Smith; use `optimize::opaque(x)`");
    return settle(p, start, before, empty_stmt());
}

// `break;` and `continue;`.
static ast::Stmt *jump(parse::Parser *p, ast::StmtKind kind) {
    U32 start = parse::advance(p).span.start;
    Usize before = countof(p->errors);
    end_statement(p);
    return settle(p, start, before, new_stmt(kind));
}

static ast::Stmt *return_statement(parse::Parser *p) {
    U32 start = parse::advance(p).span.start;
    Usize before = countof(p->errors);
    ast::Expr *value = nullptr;
    Bool bare = parse::at(p, lex::semicolon) || parse::at(p, lex::right_brace) || last_token_ends_line(p);
    if (!bare) value = expression(p);
    if (countof(p->errors) == before) end_statement(p);
    return settle(p, start, before, new_stmt({.return_stmt = {.value = value}}));
}

// `yield x` (smith's own syntax): `x` is on the same line. A `yield` alone is one error. The checker (#1545) decides
// where a `yield` may stand.
static ast::Stmt *yield_statement(parse::Parser *p) {
    lex::Token keyword = parse::advance(p);
    U32 start = keyword.span.start;
    Usize before = countof(p->errors);
    Bool bare = parse::at(p, lex::semicolon) || parse::at(p, lex::right_brace) || last_token_ends_line(p);
    if (p->layout && (parse::at(p, lex::newline) || parse::at(p, lex::dedent) || parse::at(p, lex::end_of_file)))
        bare = true;
    if (bare) {
        parse::error(p, keyword.span, "yield needs a value: `yield x` (a plain `return` ends the stream)");
        return settle(p, start, before, empty_stmt());
    }
    ast::Expr *value = expression(p);
    if (countof(p->errors) == before) end_statement(p);
    return settle(p, start, before, ast::yield_stmt(value));
}

static ast::Stmt *goto_statement(parse::Parser *p) {
    warn(p, parse::peek(p).span, "smith has no goto: use a loop, `break` or `defer`");
    U32 start = parse::advance(p).span.start;
    Usize before = countof(p->errors);
    lex::Token label = parse::expect(p, lex::name, "a label");
    if (countof(p->errors) == before) parse::expect(p, lex::semicolon, "`;`");
    return settle(p, start, before, new_stmt({.goto_stmt = {.label = parse::text(p, label)}}));
}

// The text of a string literal token without its quotes.
static Str unquoted(const parse::Parser *p, lex::Token token) {
    Str whole = parse::text(p, token);
    if (countof(whole) < 2) return whole;
    return whole[1:countof(whole) - 1];
}

// `static_assert(c, "m");`, the message optional.
static ast::Stmt *static_assert_statement(parse::Parser *p) {
    U32 start = parse::advance(p).span.start;
    Usize before = countof(p->errors);
    parse::expect(p, lex::left_paren, "`(`");
    ast::Expr *condition = nullptr;
    Str message = "";
    if (countof(p->errors) == before) condition = expression(p);
    if (countof(p->errors) == before && parse::accept(p, lex::comma)) {
        lex::Token text = parse::expect(p, lex::string, "a message string");
        message = unquoted(p, text);
    }
    if (countof(p->errors) == before) parse::expect(p, lex::right_paren, "`)`");
    if (countof(p->errors) == before) end_statement(p);
    ast::Stmt *built = new_stmt({.static_assert_stmt = {.condition = condition, .message = message}});
    return settle(p, start, before, built);
}

// ---------------------------------------------------------------------------------------------------------------
// Opening a construct

// `{`, `if`, `while`, `do`, `defer` and `l:` open a frame; they read their header and give the frame.
static Frame open_block(parse::Parser *p) {
    Frame frame = {.kind = block_frame, .start = parse::advance(p).span.start};
    return frame;
}

// ---- the new forms (#1428, S4)

// The offset of the token after the group that the bracket at `open` starts (`(`/`[`), or the end of the file.
static Usize after_group(const parse::Parser *p, Usize open) {
    Usize depth = 0;
    Usize limit = open + countof(p->tokens);
    for (Usize i = open; i < limit; i++) {
        lex::TokenKind kind = parse::peek_at(p, i).kind;
        if (kind == lex::end_of_file) return i;
        if (kind == lex::left_paren || kind == lex::left_bracket) depth += 1;
        if ((kind == lex::right_paren || kind == lex::right_bracket) && depth > 0) {
            depth -= 1;
            if (depth == 0) return i + 1;
        }
    }
    return limit;
}

// Whether a `{` comes at depth 0 from the offset `from` before the statement or the line ends.
static Bool brace_before_line_end(const parse::Parser *p, Usize from) {
    Usize depth = 0;
    Usize limit = from + countof(p->tokens);
    for (Usize i = from; i < limit; i++) {
        lex::Token token = parse::peek_at(p, i);
        if (token.kind == lex::end_of_file) return false;
        if (depth == 0 && token.kind == lex::left_brace) return true;
        if (depth == 0 && (token.kind == lex::semicolon || token.kind == lex::right_brace)) return false;
        if (token.kind == lex::left_paren || token.kind == lex::left_bracket) depth += 1;
        if ((token.kind == lex::right_paren || token.kind == lex::right_bracket) && depth > 0) depth -= 1;
        if (depth == 0 && lex::ends_statement(token)) return false;
    }
    return false;
}

// Whether a token continues an expression where the new form has a `{` before the line ends: the token after `if (a)`
// in `if (a) < b {`. `-`, `*` and `&` also begin a statement (`if (a) *p = 1;`), but that statement ends in `;` before
// any `{`, which `new_header` checks; so `if (a + 1) * 2 > n {` is a product, as the fixer's first pass writes it
// (#2226).
static Bool continues_condition(lex::TokenKind kind) {
    switch (kind) {
    case lex::dot:
    case lex::dot_star:
    case lex::arrow:
    case lex::plus:
    case lex::minus:
    case lex::star:
    case lex::ampersand:
    case lex::slash:
    case lex::percent:
    case lex::less_less:
    case lex::greater_greater:
    case lex::less:
    case lex::greater:
    case lex::less_equal:
    case lex::greater_equal:
    case lex::equal_equal:
    case lex::bang_equal:
    case lex::caret:
    case lex::pipe:
    case lex::ampersand_ampersand:
    case lex::pipe_pipe:
    case lex::question:
    case lex::left_bracket:
    case lex::kw_as:
        return true;
    default:
        return false;
    }
}

// Whether the `if` or `while` at the position is the new form (no parentheses around the condition).
static Bool new_header(const parse::Parser *p) {
    if (p->layout) return parse::peek_at(p, 1).kind != lex::kw_constexpr;
    lex::Token next = parse::peek_at(p, 1);
    if (next.kind == lex::kw_constexpr) return false;
    if (next.kind != lex::left_paren) return brace_before_line_end(p, 1);
    Usize after = after_group(p, 1);
    return continues_condition(parse::peek_at(p, after).kind) && brace_before_line_end(p, after);
}

// Skips to the `{` of the body (or the `}` that ends the block) after a broken condition.
static void skip_to_brace(parse::Parser *p) {
    while (!parse::at(p, lex::end_of_file) && !parse::at(p, lex::left_brace) && !parse::at(p, lex::right_brace))
        parse::advance(p);
}

// Braces are required around the body of the new `if`, `while` and `for`.
// Gives false when there is none: the rest of the line is skipped, and the caller gives the construct an empty body.
static Bool require_brace(parse::Parser *p, Usize before) {
    if (countof(p->errors) > before) skip_to_brace(p);
    if (parse::at(p, lex::left_brace)) return true;
    if (countof(p->errors) == before) {
        parse::error(p, parse::peek(p).span, "expected `{`: braces are required around the body");
    }
    while (!parse::at(p, lex::end_of_file) && !parse::at(p, lex::right_brace)) {
        if (parse::advance(p).line_break) break;
    }
    return false;
}

// Skips to the `:` of the body (or the end of the line) after a broken condition, in the layout path.
static void skip_to_colon(parse::Parser *p) {
    while (!parse::at(p, lex::end_of_file) && !parse::at(p, lex::colon) && !parse::at(p, lex::newline) &&
           !parse::at(p, lex::dedent))
        parse::advance(p);
}

// The `:` that opens the body of the new `if`, `while` and `for` in the layout path; false, with the rest of the line
// skipped, when there is none.
static Bool require_colon(parse::Parser *p, Usize before) {
    if (countof(p->errors) > before) skip_to_colon(p);
    if (parse::accept(p, lex::colon)) return true;
    if (countof(p->errors) == before) parse::error(p, parse::peek(p).span, "expected `:` before the body");
    skip_to_colon(p);
    return false;
}

// `require_brace` or `require_colon`, by the path the file took.
static Bool require_body(parse::Parser *p, Usize before) {
    if (p->layout) return require_colon(p, before);
    return require_brace(p, before);
}

// `.name` or `.name(binding)`; the errors are recorded and the pattern is then empty.
static ast::Pattern read_pattern(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    Usize before = countof(p->errors);
    parse::expect(p, lex::dot, "`.` before a variant name");
    Str name = parse::text(p, parse::expect(p, lex::name, "a variant name"));
    Str binding = "";
    if (countof(p->errors) == before && parse::accept(p, lex::left_paren)) {
        binding = parse::text(p, parse::expect(p, lex::name, "a name for the payload"));
        parse::expect(p, lex::right_paren, "`)`");
    }
    ast::Pattern result = ast::pattern(name, binding);
    result.span = parse::span_from(p, start);
    return result;
}

// `if c {` and `while c {`, without parentheses. `if let .some(x) = e {` is the `if` with a pattern.
static Frame open_bare(parse::Parser *p, FrameKind kind) {
    Str let_word = "let";
    Frame frame = {.kind = kind, .start = parse::advance(p).span.start, .braced = true};
    Usize before = countof(p->errors);
    if (kind == if_then && parse::at(p, lex::name) && mem::equal(parse::text(p, parse::peek(p)), let_word) &&
        parse::peek_at(p, 1).kind == lex::dot) {
        parse::advance(p);
        frame.is_let = true;
        frame.pattern = read_pattern(p);
        parse::expect(p, lex::equal, "`=` after the pattern");
    }
    p->head = true;
    if (countof(p->errors) == before) frame.condition = expression(p);
    p->head = false;
    frame.no_body = !require_body(p, before);
    return frame;
}

// An old `if` or `while` header: the fix drops the parentheses (and a `constexpr` before them), and braces a body that
// has none.
static void paren_fix(Frame *frame, Header head, U32 cut_start, U32 keyword_end, Str message) {
    frame->old = true;
    frame->has_close = true;
    frame->cut = (ast::Span){.start = cut_start, .end = head.open.end};
    frame->head = cut_start == keyword_end ? " " : "";
    frame->close = head.close;
    frame->message = message;
}

// Records the fix of an old header, now that its body is known: all its edits or none.
// Whether the tokens from `from` to the position hold a `continue`: the step of a `while` would be skipped by it.
static Bool has_continue(const parse::Parser *p, Usize from) {
    for (Usize i = from; i < p->position; i += 1) {
        if (p->tokens[i].kind == lex::kw_continue) return true;
    }
    return false;
}

// A `for (init; cond; step) { body }` as `{ init; while cond { body step; } }`, when its body is a block with no
// `continue`; otherwise a warning with no edits.
static void loop_fix(parse::Parser *p, Frame *frame, ast::Stmt *body) {
    if (body->kind != .block && (has_continue(p, frame->body_from) || frame->wrapped)) {
        // The loop itself is written by front::fix_blocks, which reads a braced body: brace this one (#2224).
        parse::Edits wrap = edit_list(2);
        wrap[0] = edit(point(frame->cut.end), " {");
        wrap[1] = edit(point(body->span.end), " }");
        parse::warning_fix(p, frame->cut, "the body of a `for` is braced: write `for (...) { ... }`", wrap);
        return;
    }
    if (body->kind != .block || has_continue(p, frame->body_from) || frame->wrapped) {
        // With an init the `while` would need a block around it for the scope of the init, and a statement has no
        // block form in smith's own syntax (`do:` is a value, #2014): the user writes it by hand.
        parse::Edits none = {};
        parse::warning_fix(p, frame->cut, "this `for` has no `while` form here: write it by hand with `while`", none);
        return;
    }
    parse::Edits edits = edit_list(2);
    edits[0] = edit(frame->cut, frame->head);
    edits[1] = edit(point(body->span.end - 1), frame->tail);
    parse::warning_fix(p, frame->cut, frame->message, edits);
}

static void old_header_fix(parse::Parser *p, Frame *frame, ast::Stmt *body) {
    if (!frame->old) return;
    frame->old = false;
    if (frame->body_from > 0) {
        loop_fix(p, frame, body);
        return;
    }
    Bool wrap = body->kind != .block;
    Str brace = " {";
    Usize count = 1 + (frame->has_close ? 1 : 0) + (wrap ? 1 : 0);
    parse::Edits edits = edit_list(count);
    Usize at = 0;
    Str first = frame->head;
    char joined[:] = format::push(frame->head, brace);
    if (wrap && !frame->has_close) {
        first = joined;
    }
    edits[at] = edit(frame->cut, first);
    at += 1;
    if (frame->has_close) {
        Str nothing = "";
        edits[at] = edit(frame->close, wrap ? brace : nothing);
        at += 1;
    }
    if (wrap) edits[at] = edit(point(body->span.end), " }");
    parse::warning_fix(p, frame->cut, frame->message, edits);
}

// The body of an `else` with no braces gets them (`else if` is left to the `if` it holds).
static void else_wrap_fix(parse::Parser *p, U32 else_end, ast::Stmt *body) {
    parse::Edits edits = edit_list(2);
    edits[0] = edit((ast::Span){.start = else_end, .end = body->span.start}, " { ");
    edits[1] = edit(point(body->span.end), " }");
    parse::warning_fix(p, body->span, "the body of an `else` is braced: write `else { ... }`", edits);
}

// `}` and then `else` on the next line: smith's `else` follows the `}` on its line.
static void join_else_fix(parse::Parser *p) {
    lex::Token before = p->tokens[p->position - 1];
    if (before.kind != lex::right_brace || !before.line_break) return;
    ast::Span gap = {.start = before.span.end, .end = parse::peek(p).span.start};
    parse::Edits edits = edit_list(1);
    edits[0] = edit(gap, " ");
    parse::warning_fix(p, gap, "`else` follows the `}` on the same line: write `} else {`", edits);
}

static Frame open_if(parse::Parser *p) {
    if (new_header(p)) return open_bare(p, if_then);
    lex::Token keyword = parse::advance(p);
    Frame frame = {.kind = if_then, .start = keyword.span.start};
    U32 cut_start = parse::peek(p).span.start;
    frame.is_constexpr = parse::accept(p, lex::kw_constexpr);
    Header head = header(p);
    frame.condition = head.condition;
    if (head.ok) {
        paren_fix(&frame, head, cut_start, keyword.span.end,
                  "an `if` condition has no parentheses: write `if c { ... }`");
    }
    return frame;
}

static Frame open_while(parse::Parser *p) {
    if (new_header(p)) return open_bare(p, while_body);
    lex::Token keyword = parse::advance(p);
    Frame frame = {.kind = while_body, .start = keyword.span.start};
    U32 cut_start = parse::peek(p).span.start;
    Header head = header(p);
    frame.condition = head.condition;
    if (head.ok) {
        paren_fix(&frame, head, cut_start, keyword.span.end,
                  "a `while` condition has no parentheses: write `while c { ... }`");
    }
    return frame;
}

// Whether the `for` at the position is `for x in xs` or `for (i, x) in xs`.
static Bool new_for(const parse::Parser *p) {
    lex::Token next = parse::peek_at(p, 1);
    if (next.kind == lex::name) return parse::peek_at(p, 2).kind == lex::kw_in;
    if (next.kind != lex::left_paren) return false;
    return parse::peek_at(p, after_group(p, 1)).kind == lex::kw_in;
}

// `for x in xs {` and `for (i, x) in xs {`. The node is made here, and its body is set when the block is read
// (`frame.init` holds it).
static Frame open_for_in(parse::Parser *p) {
    Frame frame = {.kind = for_in_body, .start = parse::advance(p).span.start};
    Usize before = countof(p->errors);
    Bool is_tuple = parse::accept(p, lex::left_paren);
    ast::Identifier names[:] = {};
    Usize limit = countof(p->tokens);
    for (Usize i = 0; i < limit && countof(p->errors) == before; i++) {
        lex::Token token = parse::expect(p, lex::name, "a name");
        names = mem::realloc(names, countof(names) + 1);
        names[countof(names) - 1] = (ast::Identifier){.text = parse::text(p, token), .span = token.span};
        if (!is_tuple || !parse::accept(p, lex::comma)) break;
    }
    if (is_tuple) parse::expect(p, lex::right_paren, "`)`");
    parse::expect(p, lex::kw_in, "`in`");
    ast::Expr *iterable = nullptr;
    p->head = true;
    if (countof(p->errors) == before) iterable = expression(p);
    p->head = false;
    frame.no_body = !require_body(p, before);
    frame.init = ast::for_in(names, is_tuple, iterable, nullptr);
    return frame;
}

// Skips the balanced `{ }` whose `{` is at `open`.
static void skip_braces(parse::Parser *p, Usize open) {
    p->position = open;
    Usize depth = 0;
    while (!parse::at(p, lex::end_of_file)) {
        lex::TokenKind kind = parse::advance(p).kind;
        if (opens(kind)) depth += 1;
        if (closes(kind) && depth > 0) depth -= 1;
        if (depth == 0) return;
    }
}

// Skips a broken `match` in the layout path: to the `dedent` that ends its block, or the end of its line when it has
// none.
static void skip_layout_block(parse::Parser *p, Usize open) {
    p->position = open;
    Usize depth = 0;
    while (!parse::at(p, lex::end_of_file)) {
        lex::TokenKind kind = parse::advance(p).kind;
        if (kind == lex::indent) depth += 1;
        if (kind == lex::dedent && depth > 0) depth -= 1;
        if (kind == lex::dedent && depth == 0) return;
        if (kind == lex::newline && depth == 0 && parse::peek(p).kind != lex::indent) return;
    }
}

// `match v:` and then the arms, indented: `.a: x` one to a line, `.a, .b: x` for several patterns.
static ast::Stmt *match_layout(parse::Parser *p) {
    U32 start = parse::advance(p).span.start;
    Usize before = countof(p->errors);
    p->head = true;
    ast::Expr *value = expression(p);
    p->head = false;
    Usize open = p->position;
    if (countof(p->errors) == before) parse::expect(p, lex::colon, "`:`");
    if (countof(p->errors) == before) parse::expect(p, lex::newline, "a line break and the arms, indented");
    if (countof(p->errors) == before) parse::expect(p, lex::indent, "the arms, indented");
    ast::MatchArm arms[:] = {};
    Usize limit = countof(p->tokens);
    for (Usize i = 0; i < limit && countof(p->errors) == before; i++) {
        if (parse::at(p, lex::dedent) || parse::at(p, lex::end_of_file)) break;
        U32 arm_start = parse::peek(p).span.start;
        ast::Pattern patterns[:] = {};
        for (Usize j = 0; j < limit && countof(p->errors) == before; j++) {
            patterns = mem::realloc(patterns, countof(patterns) + 1);
            patterns[countof(patterns) - 1] = read_pattern(p);
            if (!parse::accept(p, lex::comma)) break;
        }
        if (countof(p->errors) == before) parse::expect(p, lex::colon, "`:` after the pattern");
        ast::Expr *result = nullptr;
        if (countof(p->errors) == before) result = expression(p);
        Bool block_ended = p->position > 0 && p->tokens[p->position - 1].kind == lex::dedent; // `.a: do:` and its block
        if (countof(p->errors) == before && !block_ended && !parse::at(p, lex::newline) && !parse::at(p, lex::dedent))
            parse::error(p, parse::peek(p).span, "expected the end of the line: one arm per line");
        if (countof(p->errors) == before) parse::accept(p, lex::newline);
        arms = mem::realloc(arms, countof(arms) + 1);
        arms[countof(arms) - 1] = ast::match_arm(patterns, result);
        arms[countof(arms) - 1].span = parse::span_from(p, arm_start);
    }
    if (countof(p->errors) == before) parse::expect(p, lex::dedent, "the end of the arms");
    if (countof(p->errors) > before) {
        skip_layout_block(p, open);
        return spanned(p, start, empty_stmt());
    }
    return spanned(p, start, ast::match_stmt(value, arms));
}

// `match v { .a => x ... }`: one arm per line, `.a, .b => x` for several patterns.
static ast::Stmt *match_statement(parse::Parser *p) {
    if (p->layout) return match_layout(p);
    U32 start = parse::advance(p).span.start;
    Usize before = countof(p->errors);
    p->head = true;
    ast::Expr *value = expression(p);
    p->head = false;
    Usize open = p->position;
    if (countof(p->errors) == before) {
        parse::expect(p, lex::left_brace, "`{`");
    }
    ast::MatchArm arms[:] = {};
    Usize limit = countof(p->tokens);
    for (Usize i = 0; i < limit && countof(p->errors) == before; i++) {
        if (parse::at(p, lex::right_brace) || parse::at(p, lex::end_of_file)) break;
        U32 arm_start = parse::peek(p).span.start;
        ast::Pattern patterns[:] = {};
        for (Usize j = 0; j < limit && countof(p->errors) == before; j++) {
            patterns = mem::realloc(patterns, countof(patterns) + 1);
            patterns[countof(patterns) - 1] = read_pattern(p);
            if (!parse::accept(p, lex::comma)) break;
        }
        if (countof(p->errors) == before) parse::expect(p, lex::fat_arrow, "`=>`");
        ast::Expr *result = nullptr;
        if (countof(p->errors) == before) result = expression(p);
        if (countof(p->errors) == before && !last_token_ends_line(p) && !parse::at(p, lex::right_brace))
            parse::error(p, parse::peek(p).span, "expected the end of the line: one arm per line");
        arms = mem::realloc(arms, countof(arms) + 1);
        arms[countof(arms) - 1] = ast::match_arm(patterns, result);
        arms[countof(arms) - 1].span = parse::span_from(p, arm_start);
    }
    if (countof(p->errors) == before) parse::expect(p, lex::right_brace, "`}`");
    if (countof(p->errors) > before) {
        skip_braces(p, open);
        return spanned(p, start, empty_stmt());
    }
    return spanned(p, start, ast::match_stmt(value, arms));
}

static Frame open_simple(parse::Parser *p, FrameKind kind) {
    Frame frame = {.kind = kind, .start = parse::advance(p).span.start};
    if (kind == do_body) frame.body_from = p->position;
    if (p->layout && kind != do_body) parse::accept(p, lex::colon); // `defer:` and then an indented block
    return frame;
}

static Frame open_label(parse::Parser *p) {
    Frame frame = {.kind = label_body, .start = parse::peek(p).span.start};
    warn(p, parse::peek(p).span, "smith has no labels, as it has no goto: use a loop, `break` or `defer`");
    frame.label = parse::text(p, parse::advance(p));
    parse::advance(p);
    return frame;
}

// The offset of the first token of the kind at depth 0 from offset `from`, or `stop` when there is none before it.
static Usize find_at_depth_0(const parse::Parser *p, Usize from, Usize stop, lex::TokenKind kind) {
    Usize depth = 0;
    for (Usize i = from; i < stop; i += 1) {
        lex::TokenKind found = parse::peek_at(p, i).kind;
        if (depth == 0 && found == kind) return i;
        if (opens(found)) depth += 1;
        if (closes(found) && depth > 0) depth -= 1;
    }
    return stop;
}

// The source text of the tokens at the offsets `first` to `last`, with the fixes of the forms inside it applied (a cast
// `(T)x` in the header is written `x.to(T)` there, #1958): the header is read again once its expressions are parsed.
static Str tokens_text(const parse::Parser *p, Usize first, Usize last) {
    return parse::mended(p, parse::peek_at(p, first).span.start, parse::peek_at(p, last).span.end);
}

// The header of the `for` in smith's own form, or an empty text when it has none. The `(` is at offset 0.
struct RangeText {
    Bool ok;
    Str text;
    Bool loop; // the text is a `while` (with the init before it in a block); `tail` is the step
    Str tail;
    Bool wrapped;
};

static Bool same_name(const parse::Parser *p, Usize at, Str name) {
    return parse::peek_at(p, at).kind == lex::name && mem::equal(parse::text(p, parse::peek_at(p, at)), name);
}

// `(T x : xs)` is `x in xs`.
static RangeText range_of_collection(const parse::Parser *p, Usize close) {
    RangeText none = {};
    Usize colon = find_at_depth_0(p, 1, close, lex::colon);
    if (colon < 3 || colon + 1 >= close) return none;
    if (find_at_depth_0(p, 1, colon, lex::comma) != colon) return none;
    if (parse::peek_at(p, colon - 1).kind != lex::name) return none;
    Str name = parse::text(p, parse::peek_at(p, colon - 1));
    char text[:] = format::push(name, " in ", tokens_text(p, colon + 1, close - 1));
    RangeText found = {.ok = true, .text = text};
    return found;
}

// Whether the tokens from `from` to `stop` hold, outside any group, an operator that binds looser than the `<` of the
// loop's condition: `i < n && ok` is not `range(0, n && ok)`.
static Bool has_looser_operator(const parse::Parser *p, Usize from, Usize stop) {
    lex::TokenKind kinds[_] = {
        lex::ampersand_ampersand, lex::pipe_pipe,     lex::question,    lex::less,      lex::greater,
        lex::less_equal,          lex::greater_equal, lex::equal_equal, lex::bang_equal};
    for (Usize k = 0; k < countof(kinds); k += 1) {
        if (find_at_depth_0(p, from, stop, kinds[k]) != stop) return true;
    }
    return false;
}

// `(T i = a; i < b; i++)`, and `<=`, `++i`, `i += 1`, is `i in range(a, b)` (`b + 1` for `<=`).
static RangeText range_of_count(const parse::Parser *p, Usize close, Usize first_semicolon) {
    RangeText none = {};
    Usize second = find_at_depth_0(p, first_semicolon + 1, close, lex::semicolon);
    Usize equal = find_at_depth_0(p, 1, first_semicolon, lex::equal);
    if (second == close || equal < 3 || equal + 1 >= first_semicolon) return none;
    if (parse::peek_at(p, equal - 1).kind != lex::name) return none;
    Str name = parse::text(p, parse::peek_at(p, equal - 1));
    Usize cond = first_semicolon + 1;
    lex::TokenKind op = parse::peek_at(p, cond + 1).kind;
    if (!same_name(p, cond, name) || (op != lex::less && op != lex::less_equal) || second <= cond + 2 ||
        has_looser_operator(p, cond + 2, second))
        return none;
    Usize step = second + 1;
    Usize length = close - step;
    Bool plain = length == 2 && same_name(p, step, name) && parse::peek_at(p, step + 1).kind == lex::plus_plus;
    Bool prefix = length == 2 && parse::peek_at(p, step).kind == lex::plus_plus && same_name(p, step + 1, name);
    Str one = "1";
    Bool added = length == 3 && same_name(p, step, name) && parse::peek_at(p, step + 1).kind == lex::plus_equal &&
                 mem::equal(parse::text(p, parse::peek_at(p, step + 2)), one);
    if (!plain && !prefix && !added) return none;
    Str low = tokens_text(p, equal + 1, first_semicolon - 1);
    Str high = tokens_text(p, cond + 2, second - 1);
    if (op == lex::less_equal) {
        char raised[:] = second == cond + 3 ? format::push(high, " + 1") : format::push("(", high, ") + 1");
        high = raised;
    }
    char text[:] = format::push(name, " in range(", low, ", ", high, ")");
    RangeText found = {.ok = true, .text = text};
    return found;
}

// `(init; cond; step)` is `{ init; while cond { body step; } }`: C's three-part `for`, as the spec says, is `while`. No
// comma in the init or the step (two names, two steps) and no empty header gets this form.
static RangeText while_of(const parse::Parser *p, Usize close, Usize first_semicolon) {
    RangeText none = {};
    Usize second = find_at_depth_0(p, first_semicolon + 1, close, lex::semicolon);
    if (second == close) return none;
    if (find_at_depth_0(p, 1, first_semicolon, lex::comma) != first_semicolon) return none;
    if (find_at_depth_0(p, second + 1, close, lex::comma) != close) return none;
    Str init = "";
    if (first_semicolon > 1) init = tokens_text(p, 1, first_semicolon - 1);
    Str condition = "true";
    if (second > first_semicolon + 1) condition = tokens_text(p, first_semicolon + 1, second - 1);
    Str step = "";
    if (close > second + 1) step = tokens_text(p, second + 1, close - 1);
    // The step goes on its own line, one level in; the `}` it is inserted before keeps the indentation it has.
    Usize at = parse::peek(p).span.start;
    while (at > 0 && p->source[at - 1] != '\n')
        at -= 1;
    Usize indent = 0;
    while (at + indent < countof(p->source) && p->source[at + indent] == ' ')
        indent += 1;
    Str margin = p->source[at:at + indent];
    char head[:] = format::push("while ", condition);
    char tail[:] = format::push("");
    if (countof(step) > 0) tail = format::push("    ", step, ";\n", margin);
    RangeText found = {.ok = true, .text = head, .loop = true, .tail = tail, .wrapped = countof(init) > 0};
    return found;
}

static RangeText range_text(const parse::Parser *p) {
    Usize close = after_group(p, 0) - 1;
    Usize first_semicolon = find_at_depth_0(p, 1, close, lex::semicolon);
    if (first_semicolon == close) return range_of_collection(p, close);
    RangeText counted = range_of_count(p, close, first_semicolon);
    if (counted.ok) return counted;
    return while_of(p, close, first_semicolon);
}

// The fix of an old `for`: the header is `x in xs` or `i in range(a, b)`, or a warning with no fix when it has none.
static void for_fix(parse::Parser *p, Frame *frame, U32 cut_start, RangeText range) {
    ast::Span close = p->tokens[p->position - 1].span;
    ast::Span whole = {.start = cut_start, .end = close.end};
    if (!range.ok || (range.loop && frame->is_constexpr)) {
        warn(p, whole, "this `for` has no range form: write `for x in ...`, or `while`");
        return;
    }
    frame->old = true;
    frame->cut = whole;
    frame->head = range.text;
    frame->message = "a `for` reads `for x in xs` or `for i in range(a, b)`: write it so";
    if (range.loop) {
        // The whole `for (...)`, and the step and the closing brace once the body is known.
        frame->cut.start = frame->start;
        frame->tail = range.tail;
        frame->wrapped = range.wrapped;
        frame->body_from = p->position;
        frame->message = "a `for` with three parts is a `while`: write `{ init; while cond { body step } }`";
    }
}

// The header's text again, from the `(` at token `open`, once the header is parsed: the first reading ran before the
// expressions inside it recorded their fixes.
static RangeText reread_range(parse::Parser *p, Usize open) {
    Usize after = p->position;
    p->position = open;
    RangeText again = range_text(p);
    p->position = after;
    return again;
}

// Whether the tokens ahead are `*T name =`: the declaration of a pointer written as smith writes the type, in the init
// of a C `for`.
static Bool new_pointer_init(const parse::Parser *p) {
    Usize at = 0;
    while (parse::peek_at(p, at).kind == lex::star)
        at += 1;
    if (at == 0) return false;
    lex::TokenKind type = parse::peek_at(p, at).kind;
    if (type != lex::name && type != lex::type_name && !parse_type::is_keyword_type(type)) return false;
    return parse::peek_at(p, at + 1).kind == lex::name && parse::peek_at(p, at + 2).kind == lex::equal;
}

// `*T name = v;` as a statement: a declaration whose type an earlier pass wrote in smith's own form (the init of a
// `for` that became a `while`), not the dereference `*T` (#2224). It is `let mut name: *T = v`.
static ast::Stmt *pointer_statement(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    Usize stars = 0;
    while (parse::peek_at(p, stars).kind == lex::star)
        stars += 1;
    ast::Span type = parse::peek_at(p, stars).span;
    Str name = parse::text(p, parse::peek_at(p, stars + 1));
    U32 equal_end = parse::peek_at(p, stars + 2).span.end;
    Str pointer = p->source[start:type.end];
    for (Usize i = 0; i < stars + 3; i += 1)
        parse::advance(p);
    Usize before = countof(p->errors);
    ast::Expr *value = expression(p);
    lex::Token semicolon = parse::peek(p);
    if (countof(p->errors) == before) parse::expect(p, lex::semicolon, "`;`");
    if (countof(p->errors) == before) {
        parse::Edits edits = edit_list(2);
        char text[:] = format::push("let mut ", name, ": ", pointer, " =");
        edits[0] = edit((ast::Span){.start = start, .end = equal_end}, text);
        edits[1] = edit(semicolon.span, "");
        ast::Span whole = {.start = start, .end = semicolon.span.end};
        parse::warning_fix(p, whole, "a pointer variable is written `let mut p: *T = v`", edits);
    }
    return settle(p, start, before, new_stmt({.expression = {.value = value}}));
}

// `for [constexpr] (init; cond; step)`. A broken header is skipped as a whole.
static Frame open_for(parse::Parser *p) {
    if (new_for(p)) return open_for_in(p);
    Frame frame = {.kind = for_body, .start = parse::advance(p).span.start};
    U32 cut_start = parse::peek(p).span.start;
    frame.is_constexpr = parse::accept(p, lex::kw_constexpr);
    Usize open = p->position;
    RangeText range = {};
    if (parse::at(p, lex::left_paren)) range = range_text(p);
    Usize before = countof(p->errors);
    parse::expect(p, lex::left_paren, "`(`");
    if (countof(p->errors) == before && !parse::accept(p, lex::semicolon)) {
        if (starts_declaration(p)) {
            p->for_init = true;
            frame.init = declaration_statement(p);
            p->for_init = false;
        } else if (new_pointer_init(p)) {
            // `*T r = v`, a declaration whose type an earlier pass wrote in smith's own form: not the dereference
            // `*T` (its fix would make `T.* r`, #2224). front::fix_blocks writes the loop from the text.
            while (!parse::at(p, lex::semicolon) && !parse::at(p, lex::end_of_file))
                parse::advance(p);
            parse::expect(p, lex::semicolon, "`;`");
            frame.init = empty_stmt();
        } else {
            U32 start = parse::peek(p).span.start;
            ast::Expr *value = expression(p);
            parse::expect(p, lex::semicolon, "`;`");
            frame.init = spanned(p, start, new_stmt({.expression = {.value = value}}));
        }
    }
    if (countof(p->errors) == before && frame.init != nullptr && parse::accept(p, lex::comma)) {
        frame.index = frame.init;
        frame.init = starts_declaration(p) ? declaration_statement(p) : nullptr;
        if (frame.init == nullptr)
            parse::error(p, parse::peek(p).span,
                         "a range `for (Usize i, T x : xs)` declares the element after the index");
    }
    if (countof(p->errors) == before && frame.index != nullptr && parse::at(p, lex::comma)) {
        Str message = "a range `for` declares an index and an element at most: `for (Usize i, T x : xs)`";
        parse::error(p, parse::peek(p).span, message);
    }
    Bool ranged = countof(p->errors) == before && frame.init != nullptr && parse::accept(p, lex::colon);
    if (ranged) {
        frame.range = expression(p);
        parse::expect(p, lex::right_paren, "`)` after the range");
    } else if (countof(p->errors) == before) {
        if (!parse::at(p, lex::semicolon)) frame.condition = expression(p);
        parse::expect(p, lex::semicolon, "`;`");
    }
    if (!ranged && countof(p->errors) == before) {
        if (!parse::at(p, lex::right_paren)) frame.step = expression(p);
        parse::expect(p, lex::right_paren, "`)`");
    }
    if (countof(p->errors) > before) skip_group(p, open);
    if (countof(p->errors) == before && range.ok) range = reread_range(p, open);
    if (countof(p->errors) == before) for_fix(p, &frame, cut_start, range);
    return frame;
}

static void add_switch_edit(Frame *frame, parse::Edit one) {
    frame->switch_edits = mem::realloc(frame->switch_edits, frame->switch_edit_count + 1);
    frame->switch_edits[frame->switch_edit_count] = one;
    frame->switch_edit_count += 1;
}

// `switch (v) {`; null, with the rest skipped, when the `{` is missing. Its warning has no fix until the cases are
// known: when each one is `case .a:`, one expression and `break`, close_braces gives it the edits.
static ast::Stmt *open_switch(parse::Parser *p, Stack *stack) {
    Usize warning = countof(p->warnings);
    warn(p, parse::peek(p).span, "`switch` is `match` in smith: write `match v { .a => x }`, one arm per line");
    U32 start = parse::advance(p).span.start;
    Frame frame = {.kind = switch_frame, .start = start, .switch_warning = warning};
    Usize group_end = after_group(p, 0);
    Str condition = "";
    if (parse::at(p, lex::left_paren) && group_end >= 3) condition = tokens_text(p, 1, group_end - 2);
    frame.switch_bad = countof(condition) == 0;
    frame.condition = header(p).condition;
    Usize before = countof(p->errors);
    parse::expect(p, lex::left_brace, "`{`");
    if (countof(p->errors) > before) return settle(p, start, before, empty_stmt());
    U32 brace_end = p->tokens[p->position - 1].span.end;
    char head[:] = format::push("match ", condition, " {");
    add_switch_edit(&frame, edit((ast::Span){.start = start, .end = brace_end}, head));
    push(stack, frame);
    return nullptr;
}

// A habit from another language at the start of a statement: a warning that names the smith form. Parsing goes on.
static void habit_warning(parse::Parser *p) {
    lex::Token first = parse::peek(p);
    Str impl_word = "impl";
    if (first.kind == lex::name && mem::equal(parse::text(p, first), impl_word) &&
        (parse::peek_at(p, 1).kind == lex::name || parse::peek_at(p, 1).kind == lex::type_name)) {
        warn(p, first.span, "smith has no `impl`: write a function that takes the value, `fn area(s: Shape)`");
    } else if (first.kind == lex::ampersand && parse::peek_at(p, 1).kind == lex::kw_mut) {
        ast::Span both = {.start = first.span.start, .end = parse::peek_at(p, 1).span.end};
        warn(p, both, "smith has no `&mut`: write `&x`, which is a `*mut T` when `x` is `mut`");
    } else if (first.kind == lex::question) {
        warn(p, first.span, "smith has no `?` operator: write `try f()` to return the error of a `Result`");
    }
}

// A `newline` where a statement could start (layout path). After a `:` it comes with an `indent`, and they open a
// block; elsewhere it only ends the line before. A construct that waits for its body and meets a plain line break has
// none.
static ast::Stmt *layout_line(parse::Parser *p, Stack *stack) {
    U32 at = parse::peek(p).span.start;
    Bool waiting = stack->depth > 0 && top(stack)->kind != block_frame && top(stack)->kind != switch_frame;
    if (parse::peek_at(p, 1).kind == lex::indent) {
        parse::advance(p);
        parse::advance(p);
        Frame frame = {.kind = block_frame, .start = at, .layout = true};
        push(stack, frame);
        return nullptr;
    }
    if (waiting) {
        parse::error(p, parse::peek(p).span, "expected an indented block or a statement on the same line");
        return spanned(p, at, empty_stmt());
    }
    parse::advance(p);
    return nullptr;
}

// The statement at the position: a finished leaf, or null after opening a frame.
static ast::Stmt *start(parse::Parser *p, Stack *stack) {
    if (p->layout && parse::at(p, lex::newline)) return layout_line(p, stack);
    switch (parse::peek(p).kind) {
    case lex::left_brace:
        push(stack, open_block(p));
        return nullptr;
    case lex::kw_if:
        push(stack, open_if(p));
        return nullptr;
    case lex::kw_while:
        push(stack, open_while(p));
        return nullptr;
    case lex::kw_do:
        push(stack, open_simple(p, do_body));
        return nullptr;
    case lex::kw_defer:
        push(stack, open_simple(p, defer_body));
        return nullptr;
    case lex::kw_errdefer:
        push(stack, open_simple(p, errdefer_body));
        return nullptr;
    case lex::kw_for:
        push(stack, open_for(p));
        return nullptr;
    case lex::kw_switch:
        return open_switch(p, stack);
    case lex::kw_match:
        return match_statement(p);
    case lex::kw_break:
        return jump(p, break_kind());
    case lex::kw_continue:
        return jump(p, continue_kind());
    case lex::kw_return:
        return return_statement(p);
    case lex::kw_yield:
        return yield_statement(p);
    case lex::kw_goto:
        return goto_statement(p);
    case lex::kw_static_assert:
        return static_assert_statement(p);
    case lex::semicolon:
        parse::advance(p);
        return spanned(p, parse::peek(p).span.start, empty_stmt());
    default:
        break;
    }
    if (parse_decl::at_destructure(p)) return destructure_statement(p);
    if (new_binding(p)) return declaration_statement(p);
    if (parse::at(p, lex::name) && parse::peek_at(p, 1).kind == lex::colon) {
        push(stack, open_label(p));
        return nullptr;
    }
    if (extended_asm(p)) return asm_statement(p);
    if (starts_declaration(p)) return declaration_statement(p);
    if (new_pointer_init(p)) return pointer_statement(p);
    habit_warning(p);
    return expression_statement(p);
}

// ---------------------------------------------------------------------------------------------------------------
// Closing a construct

// The arm of a closing case of an old switch: the last label ends in ` =>` and the `break` goes. A case of any other
// shape leaves the switch with no fix.
static void case_fix(Frame *frame) {
    if (frame->switch_bad) return;
    if (frame->body_count != 2 || frame->case_default || frame->value_count == 0) {
        frame->switch_bad = true;
        return;
    }
    ast::Stmt *first = frame->body[0];
    ast::Stmt *second = frame->body[1];
    if (first->kind != .expression || second->kind != .break_stmt) {
        frame->switch_bad = true;
        return;
    }
    Str label = frame->switch_edits[frame->last_label].text;
    char arm[:] = format::push(label[0:countof(label) - 2], " => ");
    frame->switch_edits[frame->last_label].text = arm;
    Str nothing = "";
    ast::Span gone = {.start = first->span.end, .end = second->span.end};
    add_switch_edit(frame, edit(gone, nothing));
}

// The open case of a switch frame goes to its list of cases.
static void flush_case(const parse::Parser *p, Frame *frame) {
    if (!frame->case_open) return;
    case_fix(frame);
    ast::SwitchCase one = {.values = frame->values[0:frame->value_count],
                           .is_default = frame->case_default,
                           .body = frame->body[0:frame->body_count],
                           .span = parse::span_from(p, frame->case_start)};
    frame->cases = mem::realloc(frame->cases, countof(frame->cases) + 1);
    frame->cases[countof(frame->cases) - 1] = one;
    ast::ExprRef no_values[:] = {};
    ast::StmtRef no_body[:] = {};
    frame->values = no_values;
    frame->value_count = 0;
    frame->body = no_body;
    frame->body_count = 0;
    frame->case_open = false;
    frame->case_default = false;
}

static void append(Frame *frame, ast::Stmt *done) {
    if (frame->kind == switch_frame) {
        frame->body = room_for_statement(frame->body, frame->body_count);
        frame->body[frame->body_count] = done;
        frame->body_count += 1;
        return;
    }
    frame->items = room_for_statement(frame->items, frame->item_count);
    frame->items[frame->item_count] = done;
    frame->item_count += 1;
}

// `}` of a block or a switch: the construct is complete.
static ast::Stmt *close_braces(parse::Parser *p, Frame frame) {
    flush_case(p, &frame);
    if (frame.layout)
        parse::expect(p, lex::dedent, "the end of the block");
    else
        parse::expect(p, lex::right_brace, "`}`");
    if (frame.kind == switch_frame) {
        if (!frame.switch_bad && countof(frame.cases) > 0) {
            parse::ParseError *warning = &p->warnings[frame.switch_warning];
            warning->message = "a `switch` is a `match` in smith: write it so";
            warning->fix = frame.switch_edits[0:frame.switch_edit_count];
        }
        return spanned(p, frame.start, new_stmt({.switch_stmt = {.value = frame.condition, .cases = frame.cases}}));
    }
    return spanned(p, frame.start, new_stmt({.block = {.items = frame.items[0:frame.item_count]}}));
}

// `do { body } while (c);` is `while true { body  if !(c) { break } }`: smith has no `do`-`while` (a `do:` is a value).
// A body with a `continue` has no such form (the `continue` would skip the test): a warning with no fix.
static void do_while_fix(parse::Parser *p, Frame frame, ast::Stmt *body, const ast::Expr *condition) {
    ast::Span whole = {.start = frame.start, .end = p->tokens[p->position - 1].span.end};
    if (body->kind != .block || has_continue(p, frame.body_from)) {
        parse::Edits none = {};
        parse::warning_fix(p, whole, "this `do` has no `while true` form here: write it by hand with `while`", none);
        return;
    }
    Usize at = frame.start;
    while (at > 0 && p->source[at - 1] != '\n')
        at -= 1;
    Usize indent = 0;
    while (at + indent < countof(p->source) && p->source[at + indent] == ' ')
        indent += 1;
    Str margin = p->source[at:at + indent];
    Str text = p->source[condition->span.start:condition->span.end];
    ast::Span keyword = {.start = frame.start, .end = frame.start + 2};
    ast::Span tail = {.start = body->span.end, .end = whole.end};
    parse::Edits edits = edit_list(3);
    edits[0] = edit(keyword, "while true");
    char inserted[:] = format::push("    if !(", text, ") { break }\n", margin);
    edits[1] = edit(point(body->span.end - 1), inserted);
    edits[2] = edit(tail, "");
    parse::warning_fix(p, whole, "smith has no `do` `while`: write `while true { ...; if !(c) { break } }`", edits);
}

// `while (c);` after the body of a do.
static ast::Stmt *close_do(parse::Parser *p, Frame frame, ast::Stmt *done) {
    Usize before = countof(p->errors);
    parse::expect(p, lex::kw_while, "`while`");
    ast::Expr *condition = nullptr;
    if (countof(p->errors) == before) condition = header(p).condition;
    if (countof(p->errors) == before) parse::expect(p, lex::semicolon, "`;`");
    ast::Stmt *built = new_stmt({.do_while = {.body = done, .condition = condition}});
    if (countof(p->errors) == before && !p->layout) do_while_fix(p, frame, done, condition);
    if (countof(p->errors) > before) skip_statement(p);
    return spanned(p, frame.start, built);
}

// A frame that holds one statement is complete with it; the statement it makes. (Not blocks and switches, `else`.)
static ast::Stmt *close_one(parse::Parser *p, Frame frame, ast::Stmt *done) {
    ast::Stmt *built = nullptr;
    old_header_fix(p, &frame, done);
    if (frame.kind == if_else && frame.else_wrap) else_wrap_fix(p, frame.else_end, done);
    switch (frame.kind) {
    case if_then:
        if (frame.is_let) {
            built = ast::if_let(frame.pattern, frame.condition, done, nullptr);
            break;
        }
        built = new_stmt(
            {.if_stmt = {.condition = frame.condition, .then_branch = done, .is_constexpr = frame.is_constexpr}});
        break;
    case if_else:
        if (frame.is_let) {
            built = ast::if_let(frame.pattern, frame.condition, frame.first, done);
            break;
        }
        built = new_stmt({.if_stmt = {.condition = frame.condition,
                                      .then_branch = frame.first,
                                      .else_branch = done,
                                      .is_constexpr = frame.is_constexpr}});
        break;
    case while_body:
        built = new_stmt({.while_stmt = {.condition = frame.condition, .body = done}});
        break;
    case for_body:
        built = new_stmt({.for_stmt = {.init = frame.init,
                                       .condition = frame.condition,
                                       .step = frame.step,
                                       .body = done,
                                       .is_constexpr = frame.is_constexpr,
                                       .range = frame.range,
                                       .index = frame.index}});
        break;
    case for_in_body:
        built = frame.init;
        if (built->kind == .for_in) built->kind.for_in.body = done;
        break;
    case label_body:
        built = new_stmt({.labeled = {.label = frame.label, .body = done}});
        break;
    case defer_body:
        built = new_stmt({.defer_stmt = {.body = done}});
        break;
    case errdefer_body:
        built = new_stmt({.errdefer_stmt = {.body = done}});
        break;
    default:
        return close_do(p, frame, done);
    }
    return spanned(p, frame.start, built);
}

// Hands a finished statement to the frame under it. A block or a switch takes it and goes on; an `if` with an `else`
// next takes it as its then branch; any other frame is complete with it and hands its own statement up. Gives the
// statement of the whole parse once no frame is left, and null while a frame still wants more.
static ast::Stmt *deliver(parse::Parser *p, Stack *stack, ast::Stmt *done) {
    while (stack->depth > 0) {
        Frame *frame = top(stack);
        if (frame->kind == block_frame || frame->kind == switch_frame) {
            append(frame, done);
            return nullptr;
        }
        if (p->layout && frame->kind == if_then && parse::at(p, lex::newline) &&
            parse::peek_at(p, 1).kind == lex::kw_else) {
            parse::advance(p); // `if c: x` and its `else:` on the next line
        }
        if (p->layout && frame->kind == if_then && parse::at(p, lex::kw_else)) {
            frame->else_end = parse::advance(p).span.end;
            if (!parse::at(p, lex::kw_if) && !parse::accept(p, lex::colon))
                parse::error(p, parse::peek(p).span, "expected `:` or `if` after `else`");
            frame->first = done;
            frame->kind = if_else;
            return nullptr;
        }
        if (frame->kind == if_then && parse::at(p, lex::kw_else)) {
            old_header_fix(p, frame, done);
            join_else_fix(p);
            frame->else_end = parse::advance(p).span.end;
            frame->else_wrap = !frame->braced && !parse::at(p, lex::left_brace) && !parse::at(p, lex::kw_if);
            if (frame->braced && !parse::at(p, lex::left_brace) && !parse::at(p, lex::kw_if)) {
                parse::error(p, parse::peek(p).span, "expected `{` or `if` after `else`");
            }
            frame->first = done;
            frame->kind = if_else;
            return nullptr;
        }
        Frame closed = *frame;
        stack->depth -= 1;
        done = close_one(p, closed, done);
    }
    return done;
}

// A `case` or `default` label of the switch on top of the stack.
static void take_label(parse::Parser *p, Stack *stack) {
    Frame *frame = top(stack);
    lex::Token token = parse::advance(p);
    if (frame->case_open && frame->body_count > 0) flush_case(p, frame);
    if (!frame->case_open) {
        frame->case_open = true;
        frame->case_start = token.span.start;
    }
    Usize before = countof(p->errors);
    Bool plain = token.kind == lex::kw_case && parse::peek_at(p, 0).kind == lex::dot &&
                 parse::peek_at(p, 1).kind == lex::name && parse::peek_at(p, 2).kind == lex::colon;
    if (!plain) frame->switch_bad = true;
    Str name = "";
    if (plain) name = tokens_text(p, 0, 1);
    if (token.kind == lex::kw_default) {
        frame->case_default = true;
    } else {
        ast::Expr *value = expression(p);
        if (value != nullptr) {
            frame->values = room_for_expression(frame->values, frame->value_count);
            frame->values[frame->value_count] = value;
            frame->value_count += 1;
        }
    }
    if (countof(p->errors) == before) parse::expect(p, lex::colon, "`:`");
    if (countof(p->errors) > before) skip_label(p);
    if (plain && countof(p->errors) == before) {
        ast::Span label = {.start = token.span.start, .end = p->tokens[p->position].span.start};
        char comma[:] = format::push(name, ", ");
        add_switch_edit(frame, edit(label, comma));
        frame->last_label = frame->switch_edit_count - 1;
    }
}

// One step of the loop: what the position and the frame on top ask for. A statement that is complete is given.
static ast::Stmt *step(parse::Parser *p, Stack *stack) {
    Bool at_end = parse::at(p, lex::right_brace) || parse::at(p, lex::end_of_file);
    if (stack->depth > 0) {
        Frame *frame = top(stack);
        if (frame->no_body) {
            frame->no_body = false;
            return empty_stmt();
        }
        if (frame->kind == block_frame && frame->layout) {
            if (parse::at(p, lex::newline)) {
                parse::advance(p);
                return nullptr;
            }
            if (parse::at(p, lex::dedent) || parse::at(p, lex::end_of_file)) {
                Frame closed = *frame;
                stack->depth -= 1;
                return close_braces(p, closed);
            }
            return start(p, stack);
        }
        if (frame->kind == block_frame && at_end) {
            Frame closed = *frame;
            stack->depth -= 1;
            return close_braces(p, closed);
        }
        if (frame->kind == switch_frame) {
            if (at_end) {
                Frame closed = *frame;
                stack->depth -= 1;
                return close_braces(p, closed);
            }
            if (parse::at(p, lex::kw_case) || parse::at(p, lex::kw_default)) {
                take_label(p, stack);
                return nullptr;
            }
            if (!frame->case_open) {
                parse::error(p, parse::peek(p).span, "expected `case` or `default` before a statement in a switch");
                skip_statement(p);
                return nullptr;
            }
        }
    }
    return start(p, stack);
}

// Reads one statement. After an error it is an `empty` placeholder and the parser stands at the next statement.
export ast::Stmt *statement(parse::Parser *p) {
    Usize skipped_max = countof(p->tokens);
    for (Usize i = 0;
         p->layout && i < skipped_max && parse::at(p, lex::newline) && parse::peek_at(p, 1).kind != lex::indent; i++)
        parse::advance(p);
    if (parse::at(p, lex::right_brace) || (p->layout && parse::at(p, lex::dedent))) {
        Usize before = countof(p->errors);
        parse::error(p, parse::peek(p).span, "expected a statement, found `}`");
        parse::advance(p);
        return settle(p, parse::peek(p).span.start, before, empty_stmt());
    }
    Stack stack = {};
    // Every step takes a token or closes a frame the tokens opened, so a count of eight steps to a token is a bound.
    Usize steps_max = 8 * countof(p->tokens) + 16;
    for (Usize steps = 0; steps < steps_max; steps++) {
        ast::Stmt *done = step(p, &stack);
        if (done == nullptr) continue;
        done = deliver(p, &stack, done);
        if (done != nullptr) return done;
    }
    parse::error(p, parse::peek(p).span, "the statement does not end");
    return empty_stmt();
}
