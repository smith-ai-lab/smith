// front::parse_expr, the expressions of smith's own front end (#1145, A3 of track A of #1112; internal, not wired into
// `smith cc`).
//
// `parse_expr::expression(p)` reads one expression at the parser's position into `ast::Expr` and is installed as the
// hook `parse::Hooks.expression`. It is an operator-precedence parser with C's precedence and associativity, without
// the comma operator, and it has no recursion: prefix operators, binary operators, `?:` and assignments live on two
// stacks of this function, and a construct that nests another expression (parentheses, call arguments, an index, a
// `?:` middle, an initializer, a lambda) reads it through the hooks of the parser, `parse::expression`, `parse::type`
// and `parse::statement`, which the wiring points back at these modules (A6 makes that chain iterative).
//
//   primary    integer literals (decimal, hex, octal, binary, `'` separators, suffixes; the value is a U64, a literal
//              that does not fit is an error), floating literals (decimal and hex, an F64), characters and strings
//              (escapes decoded to UTF-8; adjacent strings joined; `u8"..."` is a plain string, and the prefixes `u U
//              L` are errors: wide strings are not supported yet), `true`, `false`, `nullptr`, a name or a path (`x`,
//              `ascii::digit`, `c::printf`), `.variant`, `( e )`
//   a type     a `type_name` token or a path that ends in one starts a type, read by `parse::type` into a
//   as a value `type_value` (`f(I32)`, `Option(I32)`): see parse_type::starts_type
//   postfix    call `f(a, b)`, index `xs[i]`, slice `xs[a:b]` `xs[a:]` `xs[:b]` `xs[:]`, `.name`, `->name`, `.[f]`,
//              `->[f]` (a reflected member, any expression for f), `++`, `--`
//   expansion  `pattern...` as a call argument or an item of a braced list (`f(rest...)`, `{(F64)rest...}`)
//   prefix     `- + ! ~ & * ++ --`; `sizeof`, `alignof` and `countof` of a type (`sizeof(Point)`) or an expression
//              (`sizeof x`, `countof(xs)`); a cast `(T)x`, where T starts a type; `try e`, at the precedence of the
//              other prefix operators
//   a compound `(Point){...}`; `{...}` alone is a `compound` with no type: items are `e`, `.x = e`, `[2] = e`, nested
//   literal    designators `.a.b = e`, and a lone `.name` item is a variant value
//   a lambda   `[x, y](I32 a, I32 b) -> I32 { ... }`, `[] { ... }`, `[](I32 a) { ... }`: a capture is a name, a
//              parameter a type, `auto` or a concept then a name (a lone name is an error that says to write `auto a`),
//              the body is read by `parse::statement`
//   _Generic   `_Generic(x, T: a, default: b)`: a `generic_select` of the control and its associations (a type or
//              `default`, then a value)
//   binary     `* / %`, `+ -`, `<< >>`, `< > <= >=`, `== !=`, `&`, `^`, `|`, `&&`, `||` left associative; `?:` and
//              `= += -= *= /= %= <<= >>= &= ^= |=` right associative
//
// A cast and a parenthesized value: `(T)x` is a cast when T starts a type (a `type_name`, a path ending in one such as
// `geometry::Box`, a keyword type, `typeof`...), so `(I32) - 1` is a cast of `-1` and `(x) - 1` a difference. A
// parenthesized `c::` path is a value, never a cast (#1112): the one decision is parse_type::c_path_is_type.
//
// Errors are recorded through parse::error and parsing goes on or gives null. A comma where the operator would be
// (`(a, b)`, `xs[a, b]`) says that there is no comma operator.
module front::parse_expr;

import front::ast;
import front::lex;
import front::parse;
import front::parse_type;
import std::format;
import std::mem;
import std::text;

// ---------------------------------------------------------------------------------------------------------------
// Literals

// Whether a character is a digit of a base.
static Bool digit_of(char c, U32 base, U32 *value) {
    U32 d = 99;
    if (c >= '0' && c <= '9') d = (U32)(c - '0');
    if (c >= 'a' && c <= 'f') d = (U32)(c - 'a') + 10;
    if (c >= 'A' && c <= 'F') d = (U32)(c - 'A') + 10;
    *value = d;
    return d < base;
}

// What reading an integer literal found: whether the digits fit in 64 bits, the value, and where the suffix starts.
struct Number {
    Bool fits;
    U64 value;
    Usize suffix;
};

// Decodes the digits of an integer literal: its base from the prefix, `'` separators skipped.
static Number decode_integer(Str t) {
    Number number = {.fits = true};
    U32 base = 10;
    Usize i = 0;
    if (countof(t) > 1 && t[0] == '0') {
        char c = t[1];
        if (c == 'x' || c == 'X') {
            base = 16;
            i = 2;
        } else if (c == 'b' || c == 'B') {
            base = 2;
            i = 2;
        } else if (c == 'o' || c == 'O') {
            base = 8;
            i = 2;
        } else {
            base = 8;
            i = 1;
        }
    }
    for (; i < countof(t); i += 1) {
        if (t[i] == '\'') continue;
        U32 d = 0;
        if (!digit_of(t[i], base, &d)) break;
        if (number.value > (0xFFFFFFFFFFFFFFFFULL - d) / base) number.fits = false;
        number.value = number.value * base + d;
    }
    number.suffix = i;
    return number;
}

// What reading a floating literal found.
struct Real {
    Bool ok;
    F64 value;
    Usize suffix;
};

// Doubles a value `count` times (a negative `count` halves it): the binary exponent of a hex float.
static F64 scale(F64 value, I64 count) {
    F64 result = value;
    for (I64 i = 0; i < count && i < 2200; i += 1)
        result *= 2.0;
    for (I64 i = 0; i > count && i > -2200; i -= 1)
        result /= 2.0;
    return result;
}

// A hexadecimal float, `0x1.8p3`: the position is after `0x`.
static Real decode_hex_float(Str t) {
    Real real = {.ok = true};
    I64 exponent = 0;
    Bool fraction = false;
    Usize i = 2;
    for (; i < countof(t); i += 1) {
        U32 d = 0;
        if (t[i] == '\'') continue;
        if (t[i] == '.') {
            fraction = true;
            continue;
        }
        if (!digit_of(t[i], 16, &d)) break;
        real.value = real.value * 16.0 + (F64)d;
        if (fraction) exponent -= 4;
    }
    if (i < countof(t) && (t[i] == 'p' || t[i] == 'P')) {
        i += 1;
        Bool negative = i < countof(t) && t[i] == '-';
        if (i < countof(t) && (t[i] == '-' || t[i] == '+')) i += 1;
        I64 power = 0;
        for (; i < countof(t) && t[i] >= '0' && t[i] <= '9'; i += 1) {
            if (power < 100000) power = power * 10 + (I64)(t[i] - '0');
        }
        exponent += negative ? -power : power;
    }
    real.value = scale(real.value, exponent);
    real.suffix = i;
    return real;
}

// A decimal float: the characters up to the suffix (`f F l L` and the decimal-float ones `d D`), separators dropped.
static Real decode_decimal_float(Str t) {
    Real real = {};
    Usize end = 0;
    char clean[:] = {};
    clean = mem::realloc(clean, countof(t) + 1);
    Usize n = 0;
    for (; end < countof(t); end += 1) {
        char c = t[end];
        if (c == 'f' || c == 'F' || c == 'l' || c == 'L' || c == 'd' || c == 'D') break;
        if (c != '\'') {
            clean[n] = c;
            n += 1;
        }
    }
    real.suffix = end;
    real.ok = text::parse_f64(clean[0:n], &real.value);
    return real;
}

static Real decode_float(Str t) {
    Bool hex = countof(t) > 1 && t[0] == '0' && (t[1] == 'x' || t[1] == 'X');
    return hex ? decode_hex_float(t) : decode_decimal_float(t);
}

// Appends the UTF-8 bytes of a code point to `out` at `n`; gives the new count.
static Usize put_utf8(char out[:], Usize n, U32 cp) {
    Usize at = n;
    if (cp < 0x80) {
        out[at] = (char)cp;
        return at + 1;
    }
    if (cp < 0x800) {
        out[at] = (char)(0xC0 | (cp >> 6));
        out[at + 1] = (char)(0x80 | (cp & 0x3F));
        return at + 2;
    }
    if (cp < 0x10000) {
        out[at] = (char)(0xE0 | (cp >> 12));
        out[at + 1] = (char)(0x80 | ((cp >> 6) & 0x3F));
        out[at + 2] = (char)(0x80 | (cp & 0x3F));
        return at + 3;
    }
    out[at] = (char)(0xF0 | (cp >> 18));
    out[at + 1] = (char)(0x80 | ((cp >> 12) & 0x3F));
    out[at + 2] = (char)(0x80 | ((cp >> 6) & 0x3F));
    out[at + 3] = (char)(0x80 | (cp & 0x3F));
    return at + 4;
}

// The value of a simple escape (`\n`), or -1 when the letter is not one.
static I32 simple_escape(char c) {
    switch (c) {
    case 'n':
        return '\n';
    case 't':
        return '\t';
    case 'r':
        return '\r';
    case 'a':
        return 7;
    case 'b':
        return 8;
    case 'f':
        return 12;
    case 'v':
        return 11;
    case '\\':
        return '\\';
    case '\'':
        return '\'';
    case '"':
        return '"';
    case '?':
        return '?';
    default:
        return -1;
    }
}

// What one escape sequence decoded to: its value, whether it is a code point to write as UTF-8 (`\u`, `\U`) or a byte,
// and how many characters it took after the backslash.
struct Escape {
    U32 value;
    Bool code_point;
    Bool valid;
    Usize length;
};

// Reads the escape that starts at `body[at]`, the character after the backslash.
static Escape read_escape(Str body, Usize at) {
    Escape escape = {.valid = true, .length = 1};
    char c = body[at];
    I32 simple = simple_escape(c);
    if (simple >= 0) {
        escape.value = (U32)simple;
        return escape;
    }
    U32 base = 16;
    Usize most = 8;
    Usize i = at + 1;
    if (c >= '0' && c <= '7') {
        base = 8;
        most = 3;
        i = at;
    } else if (c == 'u') {
        most = 4;
        escape.code_point = true;
    } else if (c == 'U') {
        escape.code_point = true;
    } else if (c != 'x') {
        escape.valid = false;
        return escape;
    }
    Usize taken = 0;
    for (; i < countof(body) && taken < most; i += 1) {
        U32 d = 0;
        if (!digit_of(body[i], base, &d)) break;
        escape.value = escape.value * base + d;
        taken += 1;
    }
    escape.valid = taken > 0 && (escape.code_point || escape.value <= 0xFF) && escape.value <= 0x10FFFF;
    escape.length = i - at;
    return escape;
}

// Decodes the body of a string or character literal (between the quotes) into bytes; reports an unknown or malformed
// escape at `where` and goes on.
static Str unescape(parse::Parser *p, ast::Span where, Str body) {
    char out[:] = {};
    out = mem::realloc(out, countof(body) + 4);
    Usize n = 0;
    for (Usize i = 0; i < countof(body); i += 1) {
        if (body[i] != '\\' || i + 1 >= countof(body)) {
            out[n] = body[i];
            n += 1;
            continue;
        }
        Escape escape = read_escape(body, i + 1);
        if (!escape.valid) {
            parse::error(p, where, "unknown or malformed escape sequence in a literal");
        } else if (escape.code_point) {
            n = put_utf8(out, n, escape.value);
        } else {
            out[n] = (char)escape.value;
            n += 1;
        }
        i += escape.length;
    }
    return out[0:n];
}

// The text between the quotes of a string or character literal, without its prefix (`u8`, `u`, `U`, `L`).
static Str quoted(Str t) {
    Usize open = 0;
    while (open < countof(t) && t[open] != '"' && t[open] != '\'')
        open += 1;
    if (open + 1 >= countof(t)) return t[0:0];
    return t[open + 1:countof(t) - 1];
}

// Where the quote of a string or character literal is: the length of its prefix (`u8`, `u`, `U`, `L`).
static Usize prefix_length(Str t) {
    Usize open = 0;
    while (open < countof(t) && t[open] != '"' && t[open] != '\'')
        open += 1;
    return open;
}

// The code point at the start of UTF-8 bytes, and how many bytes it took; a stray byte is its own value.
static U32 first_code_point(Str bytes, Usize *length) {
    U32 lead = (U32)(U8)bytes[0];
    Usize need = lead >= 0xF0 ? 4 : lead >= 0xE0 ? 3 : lead >= 0xC0 ? 2 : 1;
    if (need == 1 || need > countof(bytes)) {
        *length = 1;
        return lead;
    }
    U32 value = lead & (0xFFU >> (need + 1));
    for (Usize i = 1; i < need; i += 1)
        value = (value << 6) | ((U32)(U8)bytes[i] & 0x3F);
    *length = need;
    return value;
}

// ---------------------------------------------------------------------------------------------------------------
// Nodes of literals and names

static ast::Expr *make(ast::Span span, ast::ExprKind kind) {
    ast::Expr *node = mem::alloc(ast::Expr);
    node->span = span;
    node->kind = kind;
    return node;
}

static ast::Expr *integer_literal(parse::Parser *p) {
    lex::Token token = parse::advance(p);
    Str t = parse::text(p, token);
    Number number = decode_integer(t);
    if (!number.fits) parse::error(p, token.span, "this integer literal does not fit in 64 bits");
    return make(token.span, {.integer = {.value = number.value, .suffix = t[number.suffix:]}});
}

static ast::Expr *floating_literal(parse::Parser *p) {
    lex::Token token = parse::advance(p);
    Str t = parse::text(p, token);
    Real real = decode_float(t);
    if (!real.ok) parse::error(p, token.span, "cannot decode this floating literal");
    return make(token.span, {.floating = {.value = real.value, .suffix = t[real.suffix:]}});
}

static ast::Expr *character_literal(parse::Parser *p) {
    lex::Token token = parse::advance(p);
    if (prefix_length(parse::text(p, token)) > 0) {
        parse::error(p, token.span, "prefixed character literals are not supported in .smith yet: write 'a'");
    }
    Str bytes = unescape(p, token.span, quoted(parse::text(p, token)));
    U32 value = 0;
    if (countof(bytes) == 0) {
        parse::error(p, token.span, "an empty character literal: write the character between the quotes");
    } else {
        Usize length = 0;
        value = first_code_point(bytes, &length);
        if (length != countof(bytes)) parse::error(p, token.span, "a character literal holds one character");
    }
    return make(token.span, {.character = {.value = value}});
}

// A string literal, and the string literals right after it: they are one string.
static ast::Expr *string_literal(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    char all[:] = {};
    for (Usize i = 0; i < countof(p->tokens) && parse::at(p, lex::string); i += 1) {
        lex::Token token = parse::advance(p);
        Str written = parse::text(p, token);
        Usize prefix = prefix_length(written);
        if (prefix > 0 && !(prefix == 2 && written[0] == 'u' && written[1] == '8')) {
            parse::error(p, token.span, "wide strings are not supported in .smith yet: write \"...\" or u8\"...\"");
        }
        Str piece = unescape(p, token.span, quoted(written));
        all = format::push(all, piece);
    }
    Str bytes = all;
    return make(parse::span_from(p, start), {.string = {.bytes = bytes}});
}

// Takes a token of the kind, or records the error and says false.
static Bool expect_ok(parse::Parser *p, lex::TokenKind kind, Str what) {
    Usize before = countof(p->errors);
    _ = parse::expect(p, kind, what);
    return countof(p->errors) == before;
}

// `.name` as a value, and `.name(payload)` in smith's own syntax.
static ast::Expr *variant_value(parse::Parser *p) {
    U32 start = parse::advance(p).span.start;
    lex::Token name = parse::peek(p);
    if (name.kind != lex::name && name.kind != lex::type_name && !(p->new_syntax && lex::is_keyword(name.kind))) {
        parse::expect(p, lex::name, "a variant name after `.`");
        return nullptr;
    }
    parse::advance(p);
    ast::Expr *payload = nullptr;
    if (p->new_syntax && parse::accept(p, lex::left_paren)) {
        payload = parse::expression(p);
        if (payload == nullptr) return nullptr;
        if (!expect_ok(p, lex::right_paren, "`)` to end the payload")) return nullptr;
    }
    return make(parse::span_from(p, start), {.variant = {.name = parse::text(p, name), .payload = payload}});
}

// A type where a value is expected: `f(I32)`, `Option(I32)`.
static ast::Expr *type_value(parse::Parser *p) {
    ast::TypeExpr *type = parse::type(p);
    if (type == nullptr) return nullptr;
    return make(type->span, {.type_value = {.type = type}});
}

// `)`-less message for a token that starts no expression.
static void not_an_expression(parse::Parser *p) {
    lex::Token token = parse::peek(p);
    if (token.kind == lex::end_of_file) {
        parse::error(p, token.span, "expected an expression, found the end of the file");
    } else {
        char message[:] = format::push("expected an expression, found `", parse::text(p, token), "`");
        parse::error(p, token.span, message);
    }
}

// ---------------------------------------------------------------------------------------------------------------
// Old forms and their fixes (#1509): each is read as before and records a warning whose edits write the new form

static Str as_str(char chars[:]) {
    return chars;
}

static ast::Span at_offset(U32 offset) {
    ast::Span span = {.start = offset, .end = offset};
    return span;
}

static ast::Span from_to(U32 start, U32 end) {
    ast::Span span = {.start = start, .end = end};
    return span;
}

static parse::Edits no_edits() {
    parse::Edits none = {};
    return none;
}

// `edits` and one more.
static parse::Edits with_edit(parse::Edits edits, ast::Span span, Str text) {
    parse::Edit added = {.span = span, .text = text};
    edits = mem::realloc(edits, countof(edits) + 1);
    edits[countof(edits) - 1] = added;
    return edits;
}

// ---------------------------------------------------------------------------------------------------------------
// Initializer lists and lambdas

// What the items of a braced list say about its fix: the edits of the designators (`.x` loses its dot), how many items
// have a field designator and how many none, and whether any item has a form with no mechanical fix (`[2] = e`, `.a.b =
// e`, a lone `.name`).
struct ListFix {
    parse::Edits edits;
    Usize designated;
    Usize positional;
    Bool complex;
};

// One designator: `.x` or `[2]`, or none when neither is at the position.
static Bool designator(parse::Parser *p, ast::Designator ds[:], Usize *count, ListFix *fix) {
    if (parse::at(p, lex::dot) &&
        (parse::peek_at(p, 1).kind == lex::name || parse::peek_at(p, 1).kind == lex::type_name)) {
        lex::Token dot = parse::advance(p);
        fix->edits = with_edit(fix->edits, dot.span, "");
        ast::Designator d = {.field = {.name = parse::text(p, parse::advance(p))}};
        ds[*count] = d;
        *count += 1;
        return true;
    }
    if (parse::at(p, lex::left_bracket)) {
        fix->complex = true;
        parse::advance(p);
        ast::Designator d = {.index = {.index = parse::expression(p)}};
        parse::expect(p, lex::right_bracket, "`]` to end the designator");
        ds[*count] = d;
        *count += 1;
        return true;
    }
    return false;
}

// `pattern...` after an argument or a list item: wraps `value` in an `expand` when `...` follows. A second `...` is an
// error that says what to write.
static ast::Expr *expansion(parse::Parser *p, ast::Expr *value) {
    if (value == nullptr || !parse::at(p, lex::ellipsis)) return value;
    parse::advance(p);
    if (parse::at(p, lex::ellipsis)) {
        parse::error(p, parse::peek(p).span, "an expansion does not nest: write one `...` after the pattern");
        parse::advance(p);
    }
    return make(parse::span_from(p, value->span.start), {.expand = {.pattern = value}});
}

// One item of an initializer list: designators then `=` then a value, or a value.
static ast::Initializer item(parse::Parser *p, ListFix *fix) {
    U32 first = parse::peek(p).span.start;
    ast::Designator found[:] = {};
    found = mem::realloc(found, 16);
    Usize count = 0;
    while (count < 16 && designator(p, found, &count, fix)) {
    }
    ast::Initializer result = {};
    if (count == 0) {
        fix->positional += 1;
        result.value = expansion(p, parse::expression(p));
        return result;
    }
    ast::Designator only = found[0];
    if (count > 1 || only != .field) fix->complex = true;
    if (count == 1 && only == .field && !parse::at(p, lex::equal)) {
        fix->complex = true;
        result.value = make(parse::span_from(p, first), {.variant = {.name = only.field.name}});
        return result;
    }
    parse::expect(p, lex::equal, "`=` after the designator");
    fix->designated += 1;
    result.designators = found[0:count];
    result.value = parse::expression(p);
    return result;
}

// Whether the length of an array type, `_` or an integer, is the number of items of its literal: then the type adds
// nothing, and `[a, b]` says the same.
static Bool length_fits(const ast::Expr *count, Usize items) {
    if (count == nullptr) return false;
    if (count->kind == .integer) return count->kind.integer.value == items;
    if (count->kind != .name || countof(count->kind.name.path.segments) != 1) return false;
    return text::is(count->kind.name.path.segments[0].text, "_");
}

// The warning of a braced list. A typed one `(P){.x = 1}` is `P(x = 1)` when every item has a field designator and the
// type is a name, and `(P){}` is `P()`; one of an array type, `([_]T){a, b}` or `([2]T){a, b}`, is `[a, b]` (#2105);
// an untyped one `{1, 2}` is `[1, 2]` when no item has a designator; any other
// has no mechanical fix
// (`P p = {.x = 1};` gets its type from the declaration's rewrite, F2).
static void list_warning(parse::Parser *p, ast::TypeExpr *type, U32 start, U32 rparen, lex::Token open,
                         lex::Token close, ListFix *fix) {
    ast::Span whole = parse::span_from(p, start);
    Bool plain = !fix->complex && countof(fix->edits) + fix->positional > 0;
    if (type != nullptr) {
        Bool empty = !fix->complex && countof(fix->edits) + fix->positional + fix->designated == 0;
        // Every item named, or none named: `(P){a, b}` is `P(a, b)` (#1958). A mix has no fix.
        Bool unmixed = fix->positional == 0 || fix->designated == 0;
        if (plain && fix->designated == 0 && type->kind == .array &&
            length_fits(type->kind.array.count, fix->positional)) {
            // `([_]F64){3.5}` and `([3]I32){1, 2, 3}` are the array values `[3.5]` and `[1, 2, 3]` (#2105).
            parse::Edits edits = fix->edits;
            edits = with_edit(edits, from_to(start, open.span.end), "[");
            edits = with_edit(edits, close.span, "]");
            parse::warning_fix(p, whole, "a compound literal of an array type `([N]T){a, b}` is written `[a, b]`",
                               edits);
            return;
        }
        if ((plain || empty) && unmixed && type->kind == .named) {
            parse::Edits edits = fix->edits;
            edits = with_edit(edits, from_to(start, start + 1), "");
            edits = with_edit(edits, from_to(rparen, open.span.end), "(");
            edits = with_edit(edits, close.span, ")");
            Str message = fix->positional > 0 ? "a compound literal `(P){a, b}` is written `P(a, b)`"
                                              : "a compound literal `(P){.x = 1}` is written `P(x = 1)`";
            parse::warning_fix(p, whole, message, edits);
            return;
        }
        parse::warning_fix(p, whole, "a compound literal is written `P(x = 1, y = 2)`: name each field", no_edits());
        return;
    }
    if (plain && fix->designated == 0) {
        // A declaration of a named type takes this list for its arguments (`Format f = {1, 2};`) and drops the fix
        // below.
        parse::NamedList named = {
            .plain = true, .positional = true, .open = open.span, .close = close.span, .edits = fix->edits};
        p->named_list = named;
        parse::Edits edits = {};
        edits = with_edit(edits, open.span, "[");
        edits = with_edit(edits, close.span, "]");
        parse::warning_fix(p, whole, "an array value `{1, 2}` is written `[1, 2]`", edits);
        return;
    }
    if (!fix->complex && fix->designated > 0 && fix->positional == 0) {
        parse::NamedList named = {.plain = true, .open = open.span, .close = close.span, .edits = fix->edits};
        p->named_list = named;
        p->listed = mem::realloc(p->listed, countof(p->listed) + 1);
        p->listed[countof(p->listed) - 1] = named;
    }
    parse::warning_fix(
        p, whole,
        "a braced list with no type has no form in Smith: write the type, `P(x = 1)`, or `[1, 2]` for an array",
        no_edits());
}

// Whether the `{` at the position opens a list whose first item is `.name =`: in smith's own syntax a block never
// starts that way, so it is today's initializer list (`P p = {.x = 1};`), which has a fix (#1767).
static Bool designated_list_ahead(const parse::Parser *p) {
    lex::TokenKind name = parse::peek_at(p, 2).kind;
    return parse::peek_at(p, 1).kind == lex::dot && (name == lex::name || name == lex::type_name) &&
           parse::peek_at(p, 3).kind == lex::equal;
}

// Whether the items are the single integer `0`, C's way to zero a struct.
static Bool is_lone_zero(ast::Initializer items[:]) {
    if (countof(items) != 1) return false;
    ast::Initializer only = items[0];
    if (countof(only.designators) > 0 || only.value == nullptr) return false;
    return only.value->kind == .integer && only.value->kind.integer.value == 0;
}

// `{ items }`: the position is at the brace. `type` is null for a list alone; `rparen` is where the `)` of a typed
// list's type starts.
static ast::Expr *initializer_list(parse::Parser *p, ast::TypeExpr *type, U32 start, U32 rparen) {
    lex::Token open = parse::expect(p, lex::left_brace, "`{`");
    ListFix fix = {};
    ast::Initializer items[:] = {};
    while (!parse::at(p, lex::right_brace) && !parse::at(p, lex::end_of_file)) {
        ast::Initializer next = item(p, &fix);
        if (next.value == nullptr) break;
        items = mem::realloc(items, countof(items) + 1);
        items[countof(items) - 1] = next;
        if (!parse::accept(p, lex::comma)) break;
    }
    lex::Token close = parse::expect(p, lex::right_brace, "`}` to end the list");
    if (type != nullptr && is_lone_zero(items)) fix.complex = true; // `(P){0}` zeroes P: it is no argument list
    if (close.kind == lex::right_brace) list_warning(p, type, start, rparen, open, close, &fix);
    return make(parse::span_from(p, start), {.compound = {.type = type, .items = items}});
}

// One parameter of a lambda: a type then a name, or a lone name.
static ast::Param lambda_param(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    ast::Param param = {};
    lex::TokenKind after = parse::peek_at(p, 1).kind;
    if (parse::at(p, lex::name) && (after == lex::comma || after == lex::right_paren)) {
        lex::Token lone = parse::advance(p);
        param.name = parse::text(p, lone);
        char message[:] = format::push("a lambda parameter needs a type: write `auto ", param.name, "`");
        parse::error(p, lone.span, message);
    } else {
        param.type = parse::type(p);
        lex::Token name = parse::expect(p, lex::name, "a parameter name");
        if (name.kind == lex::name) param.name = parse::text(p, name);
    }
    param.span = parse::span_from(p, start);
    return param;
}

// The text without the spaces at its ends.
static Str trim_ends(Str text) {
    Usize from = 0;
    Usize to = countof(text);
    while (from < to && text[from] == ' ')
        from += 1;
    while (to > from && text[to - 1] == ' ')
        to -= 1;
    return text[from:to];
}

// The fix of an old lambda `[x](I32 a) -> I32 { ... }` (#1771): `fn(a: i32) -> i32 { ... }`, with no capture list. The
// bracket group becomes `fn` (`fn()` when no parameters follow), and each parameter `T a` becomes `a: T` with its type
// mended. The result type has its own fix.
static void lambda_warning(parse::Parser *p, U32 start, U32 bracket_end, const ast::Param params[:], Bool has_parens) {
    parse::Edits edits = {};
    edits = with_edit(edits, from_to(start, bracket_end), has_parens ? "fn" : "fn()");
    for (Usize i = 0; i < countof(params); i += 1) {
        const ast::Param *param = &params[i];
        if (param->type == nullptr) return;
        U32 name_start = param->span.end - (U32)countof(param->name);
        Str type = trim_ends(parse::mended(p, param->span.start, name_start));
        Str written = as_str(format::push(param->name, ": ", type));
        edits = with_edit(edits, from_to(param->span.start, param->span.end), written);
    }
    U32 end = has_parens ? p->tokens[p->position - 1].span.end : bracket_end;
    parse::warning_fix(p, from_to(start, end), "a lambda is `fn(a: T) -> R { ... }` in Smith, with no capture list",
                       edits);
}

// Whether the position is at the head of a lambda in today's form: `[`, names and commas, `]`, then `(`. In smith's own
// syntax a `[` otherwise starts an array literal, and an array literal is never called (#1786).
static Bool at_old_lambda(const parse::Parser *p) {
    Usize at = 1;
    while (parse::peek_at(p, at).kind == lex::name || parse::peek_at(p, at).kind == lex::comma)
        at += 1;
    return parse::peek_at(p, at).kind == lex::right_bracket && parse::peek_at(p, at + 1).kind == lex::left_paren;
}

// `[x, y](I32 a) -> I32 { ... }`: the position is at the bracket.
static ast::Expr *lambda(parse::Parser *p) {
    U32 start = parse::advance(p).span.start;
    Usize errors_before = countof(p->errors);
    ast::Identifier captures[:] = {};
    while (parse::at(p, lex::name)) {
        lex::Token name = parse::advance(p);
        captures = mem::realloc(captures, countof(captures) + 1);
        ast::Identifier capture = {.text = parse::text(p, name), .span = name.span};
        captures[countof(captures) - 1] = capture;
        if (!parse::accept(p, lex::comma)) break;
    }
    parse::expect(p, lex::right_bracket, "`]` to end the captures");
    U32 bracket_end = p->tokens[p->position - 1].span.end;
    Bool has_parens = parse::at(p, lex::left_paren);
    ast::Param params[:] = {};
    if (parse::accept(p, lex::left_paren)) {
        while (!parse::at(p, lex::right_paren) && !parse::at(p, lex::end_of_file)) {
            params = mem::realloc(params, countof(params) + 1);
            params[countof(params) - 1] = lambda_param(p);
            if (!parse::accept(p, lex::comma)) break;
        }
        parse::expect(p, lex::right_paren, "`)` to end the parameters");
    }
    if (countof(p->errors) == errors_before) lambda_warning(p, start, bracket_end, params, has_parens);
    ast::TypeExpr *result = parse::accept(p, lex::arrow) ? parse::type(p) : nullptr;
    if (!parse::at(p, lex::left_brace)) {
        parse::expect(p, lex::left_brace, "`{` to start the lambda's body");
        return nullptr;
    }
    ast::Stmt *body = parse::statement(p);
    if (body == nullptr) return nullptr;
    return make(parse::span_from(p, start),
                {.lambda = {.captures = captures, .params = params, .result = result, .body = body}});
}

// ---------------------------------------------------------------------------------------------------------------
// Smith's own forms (#1446): arrays, tuples, lambdas and blocks

// The offset just past the group that opens at `offset` (an `open` token), counting depth.
static Usize after_group(const parse::Parser *p, Usize offset, lex::TokenKind open, lex::TokenKind close) {
    Usize depth = 0;
    for (Usize i = 0; i < countof(p->tokens); i += 1) {
        lex::TokenKind kind = parse::peek_at(p, offset).kind;
        if (kind == lex::end_of_file) return offset;
        if (kind == open) depth += 1;
        if (kind == close) depth -= 1;
        offset += 1;
        if (depth == 0) return offset;
    }
    return offset;
}

// `[1, 2, 3]`: the position is at the bracket.
static ast::Expr *array_literal(parse::Parser *p) {
    // `[n]T` is an array type written as a value (`no_rule([n + 1]char)`): a type follows the closing bracket.
    Usize after = after_group(p, 0, lex::left_bracket, lex::right_bracket);
    if (after > 0 && parse_type::starts_type(p, after)) return type_value(p);
    U32 start = parse::advance(p).span.start;
    ast::ExprRef items[:] = {};
    while (!parse::at(p, lex::right_bracket) && !parse::at(p, lex::end_of_file)) {
        ast::Expr *next = parse::expression(p);
        if (next == nullptr) return nullptr;
        items = parse_type::with_expr(items, next);
        if (!parse::accept(p, lex::comma)) break;
    }
    if (!expect_ok(p, lex::right_bracket, "`]` to end the array")) return nullptr;
    return make(parse::span_from(p, start), {.array_lit = {.items = items}});
}

// The token that opens a lambda's body: the `:` of the layout path, a `{` otherwise.
static lex::TokenKind body_opener(const parse::Parser *p) {
    return p->layout ? lex::colon : lex::left_brace;
}

// The body of a lambda or a `do:` in the layout path, after its `:`: an indented block on the lines that follow, or
// one expression on the same line, which is a block of that one statement.
static ast::Stmt *layout_body(parse::Parser *p) {
    if (parse::at(p, lex::newline)) return parse::statement(p);
    U32 start = parse::peek(p).span.start;
    ast::Expr *value = parse::expression(p);
    if (value == nullptr) return nullptr;
    ast::Stmt *line = ast::new_stmt((ast::Stmt){.kind = {.expression = {.value = value}}});
    line->span = parse::span_from(p, start);
    ast::StmtRef list[:] = {};
    list = mem::realloc(list, 1);
    list[0] = line;
    ast::Stmt *body = ast::block(list);
    body->span = line->span;
    return body;
}

// Whether the `fn` at the position starts a lambda (a body follows its parameters and result) and not a function type.
static Bool fn_has_body(const parse::Parser *p) {
    Usize at = 1;
    if (parse::peek_at(p, at).kind == lex::left_bracket) at = after_group(p, at, lex::left_bracket, lex::right_bracket);
    if (parse::peek_at(p, at).kind != lex::left_paren) return false;
    at = after_group(p, at, lex::left_paren, lex::right_paren);
    if (parse::peek_at(p, at).kind == body_opener(p)) return true;
    if (parse::peek_at(p, at).kind != lex::arrow) return false;
    Usize depth = 0;
    for (Usize i = at + 1; i < at + 1 + countof(p->tokens); i += 1) {
        lex::TokenKind kind = parse::peek_at(p, i).kind;
        if (kind == lex::left_paren || kind == lex::left_bracket) depth += 1;
        if (kind == lex::right_paren || kind == lex::right_bracket) {
            if (depth == 0) return false;
            depth -= 1;
        }
        if (depth > 0) continue;
        if (kind == body_opener(p)) return true;
        if (kind == lex::comma || kind == lex::semicolon || kind == lex::equal || kind == lex::right_brace)
            return false;
        if (kind == lex::end_of_file || kind == lex::newline || kind == lex::dedent) return false;
    }
    return false;
}

// One parameter of a lambda in smith's own syntax: a name, and a type only when the context cannot give it.
static ast::Param fn_param(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    ast::Param param = {};
    lex::Token name = parse::expect(p, lex::name, "a parameter name");
    if (name.kind == lex::name) param.name = parse::text(p, name);
    if (parse::accept(p, lex::colon)) param.type = parse::type(p);
    param.span = parse::span_from(p, start);
    return param;
}

// `fn(x) { body }` and `fn[a, b](x) -> R { body }`: the position is at `fn`. Without a body it is a type.
static ast::Expr *fn_lambda(parse::Parser *p) {
    if (!fn_has_body(p)) return type_value(p);
    U32 start = parse::advance(p).span.start;
    ast::Identifier captures[:] = {};
    if (parse::at(p, lex::left_bracket)) {
        U32 open = parse::advance(p).span.start;
        while (parse::at(p, lex::name)) {
            lex::Token name = parse::advance(p);
            ast::Identifier capture = {.text = parse::text(p, name), .span = name.span};
            captures = mem::realloc(captures, countof(captures) + 1);
            captures[countof(captures) - 1] = capture;
            if (!parse::accept(p, lex::comma)) break;
        }
        if (!expect_ok(p, lex::right_bracket, "`]` to end the captures")) return nullptr;
        ast::Span list = from_to(open, p->tokens[p->position - 1].span.end);
        parse::warning_fix(p, list, "a lambda has no capture list in Smith: captures are inferred",
                           with_edit(no_edits(), list, ""));
    }
    ast::Param params[:] = {};
    if (!expect_ok(p, lex::left_paren, "`(` to start the parameters")) return nullptr;
    while (!parse::at(p, lex::right_paren) && !parse::at(p, lex::end_of_file)) {
        params = mem::realloc(params, countof(params) + 1);
        params[countof(params) - 1] = fn_param(p);
        if (!parse::accept(p, lex::comma)) break;
    }
    if (!expect_ok(p, lex::right_paren, "`)` to end the parameters")) return nullptr;
    ast::TypeExpr *result = nullptr;
    if (parse::accept(p, lex::arrow)) {
        result = parse::type(p);
        if (result == nullptr) return nullptr;
    }
    ast::Stmt *body = nullptr;
    if (p->layout) {
        if (!expect_ok(p, lex::colon, "`:` to start the lambda's body")) return nullptr;
        body = layout_body(p);
    } else {
        body = parse::statement(p);
    }
    if (body == nullptr) return nullptr;
    return make(parse::span_from(p, start),
                {.lambda = {.captures = captures, .params = params, .result = result, .body = body}});
}

// `do:` and then an indented block, or one expression: a block used as a value, its last line the value. The position
// is at `do`.
static ast::Expr *do_block(parse::Parser *p) {
    U32 start = parse::advance(p).span.start;
    if (!expect_ok(p, lex::colon, "`:` after `do`")) return nullptr;
    ast::Stmt *body = layout_body(p);
    if (body == nullptr) return nullptr;
    return make(parse::span_from(p, start), {.stmt_expr = {.stmt = body}});
}

// An `if`, `match`, `for` or block in expression position: the statement it is.
static ast::Expr *statement_value(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    Bool outer = p->in_value;
    p->in_value = true;
    ast::Stmt *stmt = parse::statement(p);
    p->in_value = outer;
    if (stmt == nullptr) return nullptr;
    return make(parse::span_from(p, start), {.stmt_expr = {.stmt = stmt}});
}

// ---------------------------------------------------------------------------------------------------------------
// Primary expressions

// Whether the path at the position is called as a construction: `Point(x = 1)`, `Point(1, 2)` or the empty `Point()`,
// in smith's own syntax (an applied type never has `name =` inside, and `T()` names no type with arguments).
static Bool named_construction(const parse::Parser *p) {
    Usize last = 0;
    lex::TokenKind first = parse::peek_at(p, 0).kind;
    if (!p->new_syntax || (first != lex::name && first != lex::type_name)) return false;
    // `words.Pair(...)`: a record of another module is named through the module (a dot joins the path).
    while (parse::peek_at(p, last + 1).kind == lex::colon_colon || parse::peek_at(p, last + 1).kind == lex::dot) {
        lex::TokenKind next = parse::peek_at(p, last + 2).kind;
        if (next != lex::name && next != lex::type_name) break;
        last += 2;
    }
    if (parse::peek_at(p, last + 1).kind != lex::left_paren) return false;
    lex::TokenKind second = parse::peek_at(p, last + 2).kind;
    if (second == lex::right_paren) return true;
    // A type function takes a type first (`Option(i32)`, `vec(f32, 4)`), so a literal first is a positional field
    // (`Point(1, 2)`, #1813). A name first (`Point(a, b)`) stays a type until the checker can tell.
    if (second == lex::integer || second == lex::floating || second == lex::string || second == lex::character ||
        second == lex::kw_true || second == lex::kw_false) {
        return true;
    }
    return second == lex::name && parse::peek_at(p, last + 3).kind == lex::equal;
}

// A name or path as a value, or a type as a value.
static ast::Expr *name_or_type(parse::Parser *p) {
    if (parse_type::starts_type(p, 0) && !named_construction(p) && !parse_type::path_then_product(p, 0))
        return type_value(p);
    lex::TokenKind kind = parse::peek(p).kind;
    if (kind != lex::name && kind != lex::type_name) {
        not_an_expression(p);
        return nullptr;
    }
    ast::Path path = parse_type::path(p);
    return make(path.span, {.name = {.path = path}});
}

// One association of `_Generic`: `T: value` or `default: value`; the value is null after an error.
static ast::GenericAssoc generic_assoc(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    ast::GenericAssoc assoc = {};
    if (parse::at(p, lex::kw_default)) {
        parse::advance(p);
    } else {
        assoc.type = parse::type(p);
        if (assoc.type == nullptr) return assoc;
    }
    if (!expect_ok(p, lex::colon, "`:` after the type of the association")) return assoc;
    assoc.value = parse::expression(p);
    assoc.span = parse::span_from(p, start);
    return assoc;
}

// `_Generic(control, T: a, default: b)`: the position is at the keyword.
static ast::Expr *generic_select(parse::Parser *p) {
    U32 start = parse::advance(p).span.start;
    if (!expect_ok(p, lex::left_paren, "`(` after `_Generic`")) return nullptr;
    ast::Expr *control = parse::expression(p);
    if (control == nullptr) return nullptr;
    if (!parse::at(p, lex::comma)) {
        parse::error(p, parse::peek(p).span,
                     "`_Generic` needs an association after the controlling expression: write `, T: value` or `, "
                     "default: value`");
        return nullptr;
    }
    ast::GenericAssoc assocs[:] = {};
    while (parse::accept(p, lex::comma)) {
        ast::GenericAssoc next = generic_assoc(p);
        if (next.value == nullptr) return nullptr;
        assocs = mem::realloc(assocs, countof(assocs) + 1);
        assocs[countof(assocs) - 1] = next;
    }
    if (!expect_ok(p, lex::right_paren, "`)` to end the `_Generic`")) return nullptr;
    return make(parse::span_from(p, start), {.generic_select = {.control = control, .assocs = assocs}});
}

// A primary expression at the position, or null after an error. Parentheses are the caller's.
static ast::Expr *primary(parse::Parser *p) {
    lex::Token token = parse::peek(p);
    switch (token.kind) {
    case lex::integer:
        return integer_literal(p);
    case lex::floating:
        return floating_literal(p);
    case lex::character:
        return character_literal(p);
    case lex::string:
        return string_literal(p);
    case lex::kw_true:
    case lex::kw_false:
        parse::advance(p);
        return make(token.span, {.boolean = {.value = token.kind == lex::kw_true}});
    case lex::kw_nullptr:
        parse::advance(p);
        return make(token.span, .null_pointer);
    case lex::dot:
        return variant_value(p);
    case lex::left_brace:
        if (p->new_syntax && !p->layout && !designated_list_ahead(p)) return statement_value(p);
        return initializer_list(p, nullptr, token.span.start, 0);
    case lex::left_bracket:
        // `[]i32` and `[3]f32` as a value are types (`let Numbers = []i32`); a bracket group followed by a type is no
        // array.
        if (p->new_syntax && !at_old_lambda(p) && parse_type::starts_new_type(p, 0)) return type_value(p);
        if (p->new_syntax && !at_old_lambda(p)) return array_literal(p);
        return lambda(p);
    case lex::kw_fn:
        return fn_lambda(p);
    case lex::kw_do:
        if (p->layout) return do_block(p);
        return name_or_type(p);
    case lex::kw_fn_once:
        return type_value(p);
    case lex::kw_if:
    case lex::kw_match:
    case lex::kw_for:
        return statement_value(p);
    case lex::kw_generic:
        return generic_select(p);
    default:
        return name_or_type(p);
    }
}

// ---------------------------------------------------------------------------------------------------------------
// Operators

// What a pending operator is: it waits on the stack for its operands.
typedef enum {
    infix;
    assignment;
    conditional_form;
    prefix;
    cast_form;
    query_form;
    try_form;
} Form;

// The precedence of the prefix operators, above every binary one.
constexpr U32 prefix_prec = 14;

struct Pending {
    Form form;
    U32 prec;
    U32 start;
    ast::UnaryOp unary;
    ast::BinaryOp binary;
    ast::AssignOp assign;
    ast::QueryOp query;
    ast::TypeExpr *type;
    ast::Expr *middle;
    ast::Span head;  // a cast's `(T)`, a prefix operator's token, the `?` of a conditional
    ast::Span colon; // the `:` of a conditional
};

// A `++` or `--` seen in an expression: it is a statement in Smith, so the end of the expression decides its warning.
struct Bump {
    ast::Expr *expr;
    ast::Span token;
};

// The two stacks of one expression: operators waiting for operands, and finished operands.
struct Stack {
    Pending ops[:];
    Usize op_count;
    ast::ExprRef values[:];
    Usize value_count;
    parse::Parser *parser;
    Bump bumps[:];
    Bool head; // a condition head: a call here takes no trailing block (parentheses and arguments lift this)
};

typedef enum {
    more;
    value;
    failed;
} Step;

typedef enum {
    absent;
    done;
    broken;
} Outcome;

static void push_op(Stack *st, Pending op) {
    st->ops = mem::realloc(st->ops, st->op_count + 1);
    st->ops[st->op_count] = op;
    st->op_count += 1;
}

static void push_value(Stack *st, ast::Expr *e) {
    st->values = parse_type::with_expr(st->values[0:st->value_count], e);
    st->value_count += 1;
}

static ast::Expr *pop_value(Stack *st) {
    st->value_count -= 1;
    return st->values[st->value_count];
}

// Replaces the last operand.
static void replace_top(Stack *st, ast::Expr *e) {
    st->values[st->value_count - 1] = e;
}

static ast::Span between(U32 start, const ast::Expr *last) {
    ast::Span span = {.start = start, .end = last->span.end};
    return span;
}

// Records a fix whose last edit inserts `tail` at `end`. When the warning recorded last is a fix of something inside
// (its last edit inserts at the same `end`), the two are one fix: two inserts at one offset clash, and `smith lint
// --fix` reads the text between its passes with today's lexer, which does not know `as` or `if`, so a nested form
// must be mended in the pass that mends the form around it.
static void tail_warning(Stack *st, ast::Span span, Str message, parse::Edits edits, U32 end, Str tail) {
    parse::Parser *p = st->parser;
    Usize count = countof(p->warnings);
    if (count > 0) {
        parse::Edits inner = p->warnings[count - 1].fix;
        Usize n = countof(inner);
        if (n > 0 && inner[n - 1].span.start == end && inner[n - 1].span.end == end &&
            p->warnings[count - 1].span.start >= span.start) {
            Str joined = as_str(format::push(inner[n - 1].text, tail));
            for (Usize i = 0; i + 1 < n; i += 1)
                edits = with_edit(edits, inner[i].span, inner[i].text);
            p->warnings = p->warnings[0:count - 1];
            tail = joined;
        }
    }
    edits = with_edit(edits, at_offset(end), tail);
    parse::warning_fix(p, span, message, edits);
}

// Whether a value reads as a postfix chain (`p.x`, `f(x)`, a name, a group), so `.*` can follow it as it is.
static Bool is_postfix_level(Str source, const ast::Expr *e) {
    if (source[e->span.start] == '(') return true;
    if (e->kind == .unary) return e->kind.unary.op == .dereference;
    return e->kind != .query && e->kind != .try_expr;
}

// The conversion function that writes a cast to `type`: `cast` for a pointer, else `to` (#1811).
static Str conversion_name(const ast::TypeExpr *type) {
    if (type->kind == .pointer || type->kind == .function) return "cast";
    return "to";
}

// `(T)x` is `x.to(T)`, or `p.cast(T)` when T is a pointer type; the operand is parenthesized when it is not a postfix
// chain (`(-x).to(T)`).
static void cast_warning(Stack *st, const Pending *op, const ast::Expr *operand) {
    parse::Parser *p = st->parser;
    Str type_text = parse::mended(p, op->head.start + 1, op->head.end - 1);
    Str name = conversion_name(op->type);
    Bool plain = is_postfix_level(p->source, operand);
    parse::Edits edits = {};
    edits = with_edit(edits, from_to(op->head.start, operand->span.start), plain ? "" : "(");
    Str tail = as_str(format::push(plain ? "" : ")", ".", name, "(", type_text, ")"));
    Str message = as_str(format::push("a cast is `x.", name, "(T)`: write `x.", name, "(", type_text, ")`"));
    tail_warning(st, from_to(op->head.start, operand->span.end), message, edits, operand->span.end, tail);
}

// `*p` is `p.*`, and `(-x).*` when the operand is not a postfix chain.
static void deref_warning(Stack *st, const Pending *op, const ast::Expr *operand) {
    parse::Edits edits = {};
    Bool plain = is_postfix_level(st->parser->source, operand);
    edits = with_edit(edits, from_to(op->head.start, operand->span.start), plain ? "" : "(");
    tail_warning(st, from_to(op->head.start, operand->span.end), "`*p` reads through a pointer as `p.*`", edits,
                 operand->span.end, plain ? ".*" : ").*");
}

// Puts `if ` in front of the condition: into the edit of an inner fix that already replaces the text from there (a cast
// `(T)c ? a : b` loses its `(T)` there), else as an insert.
static parse::Edits if_before(const parse::Parser *p, parse::Edits edits, U32 start) {
    for (Usize i = countof(p->warnings); i > 0; i -= 1) {
        parse::Edits fix = p->warnings[i - 1].fix;
        for (Usize j = 0; j < countof(fix); j += 1) {
            if (fix[j].span.start == start && fix[j].span.end > start) {
                fix[j].text = as_str(format::push("if ", fix[j].text));
                return edits;
            }
        }
        if (p->warnings[i - 1].span.end < start) break;
    }
    return with_edit(edits, at_offset(start), "if ");
}

// Whether the text between two offsets has a line break.
static Bool has_break(Str source, U32 from, U32 to) {
    for (Usize i = from; i < to && i < countof(source); i += 1) {
        if (source[i] == '\n') return true;
    }
    return false;
}

// `c ? a : b` is `if c { a } else { b }`.
static void conditional_warning(Stack *st, const Pending *op, const ast::Expr *condition, const ast::Expr *last) {
    parse::Edits edits = if_before(st->parser, no_edits(), condition->span.start);
    // A `?` or `:` that starts a line leaves the line break out: `if c {` and `} else {` stay on their lines.
    Bool head_breaks = has_break(st->parser->source, condition->span.end, op->head.start);
    Bool colon_breaks = has_break(st->parser->source, op->middle->span.end, op->colon.start);
    edits = with_edit(edits, head_breaks ? from_to(condition->span.end, op->head.end) : op->head,
                      head_breaks ? " {" : "{");
    edits = with_edit(edits, colon_breaks ? from_to(op->middle->span.end, op->colon.end) : op->colon,
                      colon_breaks ? " } else {" : "} else {");
    ast::Span span = from_to(condition->span.start, last->span.end);
    tail_warning(st, span, "`c ? a : b` is written `if c { a } else { b }`", edits, last->span.end, " }");
}

static void note_bump(Stack *st, ast::Expr *expr, ast::Span token) {
    Bump bump = {.expr = expr, .token = token};
    st->bumps = mem::realloc(st->bumps, countof(st->bumps) + 1);
    st->bumps[countof(st->bumps) - 1] = bump;
}

// The fix of `x = y++;`, `x = ++y;` as the whole statement of a line: the step is a statement of its own, after the
// assignment (`y++`) or before it (`++y`). Nothing when the statement shares its line with anything else (an unbraced
// `if (c) x = y++;` would take only the first).
static parse::Edits bump_in_assignment(const parse::Parser *p, Bump bump, const ast::Expr *whole, Bool is_post, Str step) {
    parse::Edits none = {};
    if (whole == nullptr || whole->kind != .assign || whole->kind.assign.op != .plain) return none;
    if (whole->kind.assign.value != bump.expr || bump.expr->kind != .unary) return none;
    const ast::Expr *operand = bump.expr->kind.unary.operand;
    if (operand->kind != .name) return none;
    lex::Token after = parse::peek(p);
    if (after.kind != lex::semicolon) return none;
    Usize line = whole->span.start;
    while (line > 0 && p->source[line - 1] != '\n')
        line -= 1;
    Usize indent = line;
    while (indent < countof(p->source) && p->source[indent] == ' ')
        indent += 1;
    if (indent != whole->span.start) return none;
    Str margin = p->source[line:indent];
    Str target = p->source[operand->span.start:operand->span.end];
    Str bumped = as_str(format::push(target, step, ";"));
    parse::Edits edits = {};
    if (is_post) {
        edits = with_edit(edits, bump.token, "");
        edits = with_edit(edits, at_offset(after.span.end), as_str(format::push("\n", margin, bumped)));
    } else {
        edits = with_edit(edits, from_to(bump.token.start, operand->span.start), "");
        edits = with_edit(edits, at_offset(whole->span.start), as_str(format::push(bumped, "\n", margin)));
    }
    return edits;
}

// The warnings of the `++` and `--` of an expression: as the whole of a statement (`i++;`) it is `i += 1`; anywhere
// else it has no value form and no mechanical fix.
static void bump_warnings(parse::Parser *p, const Stack *st, const ast::Expr *whole) {
    for (Usize i = 0; i < countof(st->bumps); i += 1) {
        Bump bump = st->bumps[i];
        if (bump.expr->kind != .unary) continue;
        ast::UnaryOp op = bump.expr->kind.unary.op;
        Bool is_up = op == .pre_increment || op == .post_increment;
        Bool is_post = op == .post_increment || op == .post_decrement;
        Str step = is_up ? " += 1" : " -= 1";
        Str message =
            is_up ? "`++` is a statement in Smith: write `i += 1`" : "`--` is a statement in Smith: write `i -= 1`";
        if (bump.expr != whole || !parse::at(p, lex::semicolon)) {
            parse::warning_fix(p, bump.token, message, bump_in_assignment(p, bump, whole, is_post, step));
            continue;
        }
        parse::Edits edits = {};
        if (is_post) {
            edits = with_edit(edits, bump.token, step);
        } else {
            edits = with_edit(edits, from_to(bump.token.start, bump.expr->kind.unary.operand->span.start), "");
            edits = with_edit(edits, at_offset(bump.expr->span.end), step);
        }
        parse::warning_fix(p, bump.expr->span, message, edits);
    }
}

static Bool is_adapter(Str name) {
    return text::is(name, "map") || text::is(name, "filter") || text::is(name, "collect") ||
           text::is(name, "for_each") || text::is(name, "fold") || text::is(name, "enumerate") ||
           text::is(name, "zip") || text::is(name, "rev") || text::is(name, "take") || text::is(name, "skip");
}

// `xs.iter()` and `xs.iter().map(f)`: a method chain has no form in Smith.
static void chain_warning(parse::Parser *p, const ast::Expr *callee) {
    if (callee->kind != .member) return;
    Str name = callee->kind.member.name;
    Bool chained = callee->kind.member.base->kind == .call;
    if (!text::is(name, "iter") && !text::is(name, "into_iter") && !(chained && is_adapter(name))) return;
    parse::warning_fix(
        p, callee->span,
        "a method chain such as `.iter().map(f)` has no form in Smith: write a function that returns a stream",
        no_edits());
}

// Takes the last pending operator and applies it to its operands.
static void reduce(Stack *st) {
    st->op_count -= 1;
    Pending op = st->ops[st->op_count];
    ast::Expr *right = pop_value(st);
    switch (op.form) {
    case .infix: {
        ast::Expr *left = pop_value(st);
        push_value(st,
                   make(between(left->span.start, right), {.binary = {.op = op.binary, .left = left, .right = right}}));
        break;
    }
    case .assignment: {
        ast::Expr *left = pop_value(st);
        push_value(
            st, make(between(left->span.start, right), {.assign = {.op = op.assign, .target = left, .value = right}}));
        break;
    }
    case .conditional_form: {
        ast::Expr *condition = pop_value(st);
        conditional_warning(st, &op, condition, right);
        push_value(st, make(between(condition->span.start, right),
                            {.conditional = {.condition = condition, .then_value = op.middle, .else_value = right}}));
        break;
    }
    case .prefix: {
        ast::Expr *unary = make(between(op.start, right), {.unary = {.op = op.unary, .operand = right}});
        if (op.unary == .dereference) deref_warning(st, &op, right);
        if (op.unary == .pre_increment || op.unary == .pre_decrement) note_bump(st, unary, op.head);
        push_value(st, unary);
        break;
    }
    case .cast_form:
        cast_warning(st, &op, right);
        push_value(st, make(between(op.start, right), {.cast = {.type = op.type, .operand = right}}));
        break;
    case .query_form:
        push_value(st, make(between(op.start, right), {.query = {.op = op.query, .type = nullptr, .operand = right}}));
        break;
    case .try_form:
        push_value(st, make(between(op.start, right), {.try_expr = {.operand = right}}));
        break;
    }
}

// Applies the pending operators that bind at least as tight as an incoming one (tighter only, when it is right
// associative).
static void reduce_above(Stack *st, U32 prec, Bool right) {
    Usize pending = st->op_count;
    for (Usize i = 0; i < pending && st->op_count > 0; i += 1) {
        U32 top = st->ops[st->op_count - 1].prec;
        if (top < prec || (top == prec && right)) break;
        reduce(st);
    }
}

// The precedence of a binary operator token, or 0 when the token is none.
static U32 binary_prec(lex::TokenKind kind) {
    switch (kind) {
    case lex::star:
    case lex::slash:
    case lex::percent:
        return 12;
    case lex::plus:
    case lex::minus:
        return 11;
    case lex::less_less:
    case lex::greater_greater:
        return 10;
    case lex::less:
    case lex::greater:
    case lex::less_equal:
    case lex::greater_equal:
        return 9;
    case lex::equal_equal:
    case lex::bang_equal:
        return 8;
    case lex::ampersand:
        return 7;
    case lex::caret:
        return 6;
    case lex::pipe:
        return 5;
    case lex::ampersand_ampersand:
        return 4;
    case lex::pipe_pipe:
        return 3;
    default:
        return 0;
    }
}

static ast::BinaryOp binary_op(lex::TokenKind kind) {
    switch (kind) {
    case lex::star:
        return .multiply;
    case lex::slash:
        return .divide;
    case lex::percent:
        return .remainder;
    case lex::plus:
        return .add;
    case lex::minus:
        return .subtract;
    case lex::less_less:
        return .shift_left;
    case lex::greater_greater:
        return .shift_right;
    case lex::less:
        return .less;
    case lex::greater:
        return .greater;
    case lex::less_equal:
        return .less_equal;
    case lex::greater_equal:
        return .greater_equal;
    case lex::equal_equal:
        return .equal;
    case lex::bang_equal:
        return .not_equal;
    case lex::ampersand:
        return .bit_and;
    case lex::caret:
        return .bit_xor;
    case lex::pipe:
        return .bit_or;
    case lex::ampersand_ampersand:
        return .logical_and;
    default:
        return .logical_or;
    }
}

// Whether a token is `=` or a compound assignment.
static Bool is_assign(lex::TokenKind kind) {
    switch (kind) {
    case lex::equal:
    case lex::star_equal:
    case lex::slash_equal:
    case lex::percent_equal:
    case lex::plus_equal:
    case lex::minus_equal:
    case lex::less_less_equal:
    case lex::greater_greater_equal:
    case lex::ampersand_equal:
    case lex::caret_equal:
    case lex::pipe_equal:
        return true;
    default:
        return false;
    }
}

static ast::AssignOp assign_op(lex::TokenKind kind) {
    switch (kind) {
    case lex::star_equal:
        return .multiply;
    case lex::slash_equal:
        return .divide;
    case lex::percent_equal:
        return .remainder;
    case lex::plus_equal:
        return .add;
    case lex::minus_equal:
        return .subtract;
    case lex::less_less_equal:
        return .shift_left;
    case lex::greater_greater_equal:
        return .shift_right;
    case lex::ampersand_equal:
        return .bit_and;
    case lex::caret_equal:
        return .bit_xor;
    case lex::pipe_equal:
        return .bit_or;
    default:
        return .plain;
    }
}

// Whether a token is a prefix operator, and which.
static Bool is_prefix(lex::TokenKind kind) {
    switch (kind) {
    case lex::minus:
    case lex::plus:
    case lex::bang:
    case lex::tilde:
    case lex::ampersand:
    case lex::star:
    case lex::plus_plus:
    case lex::minus_minus:
        return true;
    default:
        return false;
    }
}

static ast::UnaryOp prefix_op(lex::TokenKind kind) {
    switch (kind) {
    case lex::minus:
        return .negate;
    case lex::plus:
        return .plus;
    case lex::bang:
        return .logical_not;
    case lex::tilde:
        return .bit_not;
    case lex::ampersand:
        return .address_of;
    case lex::star:
        return .dereference;
    case lex::plus_plus:
        return .pre_increment;
    default:
        return .pre_decrement;
    }
}

// An infix operator at the position: binary, assignment or the `?:`. Absent when the token is none.
static Outcome infix_step(parse::Parser *p, Stack *st) {
    lex::TokenKind kind = parse::peek(p).kind;
    U32 prec = binary_prec(kind);
    if (prec > 0) {
        reduce_above(st, prec, false);
        Pending op = {.form = .infix, .prec = prec, .binary = binary_op(kind)};
        push_op(st, op);
        parse::advance(p);
        return .done;
    }
    if (is_assign(kind)) {
        reduce_above(st, 1, true);
        Pending op = {.form = .assignment, .prec = 1, .assign = assign_op(kind)};
        push_op(st, op);
        parse::advance(p);
        return .done;
    }
    if (kind != lex::question) return .absent;
    reduce_above(st, 2, true);
    ast::Span question = parse::advance(p).span;
    ast::Expr *middle = parse::expression(p);
    if (middle == nullptr) return .broken;
    ast::Span colon = parse::peek(p).span;
    if (!parse::accept(p, lex::colon)) {
        parse::expect(p, lex::colon, "`:` of the conditional");
        return .broken;
    }
    Pending op = {.form = .conditional_form, .prec = 2, .middle = middle, .head = question, .colon = colon};
    push_op(st, op);
    return .done;
}

// ---------------------------------------------------------------------------------------------------------------
// Postfix operators

// The error for a comma where the operator would be; says whether there was one.
static Bool comma_operator(parse::Parser *p) {
    if (!parse::at(p, lex::comma)) return false;
    Str message =
        "there is no comma operator in Smith: write two statements, or call a function that takes both values";
    parse::error(p, parse::peek(p).span, message);
    return true;
}

// One call argument: `value`, or `name = value` in smith's own syntax.
static ast::Expr *argument(parse::Parser *p) {
    if (!p->new_syntax || !parse::at(p, lex::name) || parse::peek_at(p, 1).kind != lex::equal) {
        return expansion(p, parse::expression(p));
    }
    lex::Token name = parse::advance(p);
    parse::advance(p);
    ast::Expr *value = parse::expression(p);
    if (value == nullptr) return nullptr;
    return make(parse::span_from(p, name.span.start), {.named_arg = {.name = parse::text(p, name), .value = value}});
}

// The trailing block of a call, `f(x) { ... }` (layout path: `f(x):` and an indented block): a `{` on the line of the
// `)` is a lambda with no parameters, the call's last argument. The position is at the `{`, or at the `:`.
static ast::Expr *trailing_block(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    ast::Identifier captures[:] = {};
    ast::Param params[:] = {};
    if (p->layout) parse::advance(p);
    ast::Stmt *body = parse::statement(p);
    if (body == nullptr) return nullptr;
    return make(parse::span_from(p, start),
                {.lambda = {.captures = captures, .params = params, .result = nullptr, .body = body}});
}

// Whether a trailing block follows the `)` just taken: smith's own syntax, not in a condition head, and the `{` on the
// same line (a line break after the `)` ends the statement).
static Bool has_trailing_block(const parse::Parser *p, Bool head) {
    if (p->layout) {
        // `f(x):` at the end of the line, with an indented block under it; a `:` followed by more on the line is a
        // slice, a conditional or an arm.
        return !head && parse::at(p, lex::colon) && parse::peek_at(p, 1).kind == lex::newline &&
               parse::peek_at(p, 2).kind == lex::indent;
    }
    if (!p->new_syntax || head || !parse::at(p, lex::left_brace) || p->position == 0) return false;
    return !p->tokens[p->position - 1].line_break;
}

// Whether a trailing lambda follows the `)` just taken (layout path): `fn(a, b): ...` on the same line.
static Bool has_trailing_lambda(const parse::Parser *p, Bool head) {
    if (!p->layout || head || !parse::at(p, lex::kw_fn) || p->position == 0) return false;
    if (p->tokens[p->position - 1].line_break) return false;
    return fn_has_body(p);
}

// `f(a, b)` and `f(a) { ... }`: the position is at the parenthesis.
static ast::Expr *call(parse::Parser *p, ast::Expr *callee, Bool head) {
    parse::advance(p);
    ast::ExprRef args[:] = {};
    Bool after_semicolon = false;
    while (!parse::at(p, lex::right_paren) && !parse::at(p, lex::end_of_file)) {
        // `f(x; s...)`: after the `;`, a `s...` passes the fields of `s` as named arguments.
        if (p->new_syntax && parse::at(p, lex::semicolon)) {
            if (after_semicolon) parse::error(p, parse::peek(p).span, "a call has one `;`: put every spread after it");
            parse::advance(p);
            after_semicolon = true;
            continue;
        }
        ast::Expr *arg = argument(p);
        if (arg == nullptr) return nullptr;
        if (after_semicolon && arg->kind == .expand) arg->kind.expand.named = true;
        args = parse_type::with_expr(args, arg);
        if (parse::at(p, lex::semicolon) && p->new_syntax) continue;
        if (!parse::accept(p, lex::comma)) break;
    }
    parse::expect(p, lex::right_paren, "`)` to end the arguments");
    if (has_trailing_block(p, head)) {
        ast::Expr *block = trailing_block(p);
        if (block == nullptr) return nullptr;
        args = parse_type::with_expr(args, block);
    } else if (has_trailing_lambda(p, head)) {
        ast::Expr *lambda_arg = fn_lambda(p); // `sort(xs) fn(a, b): a < b`: the trailing lambda
        if (lambda_arg == nullptr) return nullptr;
        args = parse_type::with_expr(args, lambda_arg);
    }
    chain_warning(p, callee);
    return make(parse::span_from(p, callee->span.start), {.call = {.callee = callee, .args = args}});
}

// `xs[i, j, k]` of a block: the same as `xs[i][j][k]`, one index node per position. The position is at the first comma.
static ast::Expr *block_index(parse::Parser *p, ast::Expr *base, ast::Expr *first) {
    ast::Expr *result = make(parse::span_from(p, base->span.start), {.index = {.base = base, .index = first}});
    while (parse::accept(p, lex::comma)) {
        ast::Expr *next = parse::expression(p);
        if (next == nullptr) return nullptr;
        result = make(parse::span_from(p, base->span.start), {.index = {.base = result, .index = next}});
    }
    parse::expect(p, lex::right_bracket, "`]` to end the index");
    return result;
}

// `xs[i]`, `xs[a:b]`, `xs[a:]`, `xs[:b]`, `xs[:]`: the position is at the bracket.
static ast::Expr *index_or_slice(parse::Parser *p, ast::Expr *base) {
    parse::advance(p);
    ast::Expr *first = nullptr;
    ast::Expr *last = nullptr;
    Bool is_slice = false;
    if (!parse::at(p, lex::colon)) {
        first = parse::expression(p);
        if (first == nullptr) return nullptr;
        if (p->new_syntax && parse::at(p, lex::comma)) return block_index(p, base, first);
        if (comma_operator(p)) return nullptr;
    }
    if (parse::accept(p, lex::colon)) {
        is_slice = true;
        if (!parse::at(p, lex::right_bracket)) {
            last = parse::expression(p);
            if (last == nullptr) return nullptr;
        }
    }
    parse::expect(p, lex::right_bracket, "`]` to end the index");
    ast::Span span = parse::span_from(p, base->span.start);
    if (is_slice) return make(span, {.slice_of = {.base = base, .start = first, .end = last}});
    return make(span, {.index = {.base = base, .index = first}});
}

// `x.[f]` and `x->[f]`: the position is at the bracket, after the operator. The field is any expression.
static ast::Expr *reflect_member(parse::Parser *p, ast::Expr *base, Bool arrow) {
    parse::advance(p);
    if (parse::at(p, lex::right_bracket)) {
        parse::error(p, parse::peek(p).span, "expected a field in `.[ ]`: write `x.[fields(T)[i]]` or `x.[f]`");
        return nullptr;
    }
    ast::Expr *field = parse::expression(p);
    if (field == nullptr) return nullptr;
    parse::expect(p, lex::right_bracket, "`]` to end the reflected member");
    ast::Span span = parse::span_from(p, base->span.start);
    return make(span, {.reflect_member = {.base = base, .field = field, .arrow = arrow}});
}

// `.name` and `->name`: the position is at the operator.
static ast::Expr *member(parse::Parser *p, ast::Expr *base) {
    lex::Token operator = parse::advance(p);
    Bool arrow = operator.kind == lex::arrow;
    if (arrow) {
        parse::Edits edits = with_edit(no_edits(), operator.span, ".");
        parse::warning_fix(p, operator.span, "`->` reads through a pointer as `.`: write `p.x`", edits);
    }
    if (parse::at(p, lex::left_bracket)) return reflect_member(p, base, arrow);
    lex::Token name = parse::peek(p);
    if (name.kind != lex::name && name.kind != lex::type_name && name.kind != lex::integer &&
        !lex::is_keyword(name.kind)) {
        parse::expect(p, lex::name, "a member name");
        return nullptr;
    }
    parse::advance(p);
    return make(parse::span_from(p, base->span.start),
                {.member = {.base = base, .name = parse::text(p, name), .arrow = arrow}});
}

// `x as T` is no longer a cast (#1811): it still reads, as an error whose fix writes `x.to(T)` (`p.cast(T)` for a
// pointer type), the operand in parentheses when it is not a postfix chain. Pending prefix operators apply first. The
// position is at `as`.
static ast::Expr *as_cast(parse::Parser *p, Stack *st) {
    reduce_above(st, prefix_prec, false);
    ast::Expr *operand = st->values[st->value_count - 1];
    parse::advance(p);
    ast::TypeExpr *type = parse::type(p);
    if (type == nullptr) return nullptr;
    ast::Span whole = parse::span_from(p, operand->span.start);
    Bool plain = is_postfix_level(p->source, operand);
    parse::Edits edits = {};
    if (!plain) edits = with_edit(edits, at_offset(operand->span.start), "(");
    Str name = conversion_name(type);
    Str type_text = parse::mended(p, type->span.start, whole.end);
    Str call_text = as_str(format::push(plain ? "" : ")", ".", name, "(", type_text, ")"));
    edits = with_edit(edits, from_to(operand->span.end, whole.end), call_text);
    Str message = as_str(format::push("`as` is gone: write `x.", name, "(T)`"));
    parse::error_fix(p, whole, message, edits);
    return make(whole, {.cast = {.type = type, .operand = operand}});
}

static Bool same_text(Str a, Str b) {
    return countof(a) == countof(b) && (countof(a) == 0 || mem::equal(a, b));
}

// Whether a conversion call `.to(T)`, `.wrap(T)` or `.cast(T)` starts at the `.` the position is at: the three are
// built-in functions, so the argument is always a type.
static Bool conversion_ahead(const parse::Parser *p, const ast::Expr *base) {
    if (parse::peek(p).kind != lex::dot) return false;
    // `format.to(out, n, x)`: `format` is a module bound by an import, so this is that module's function (#2104).
    if (base->kind == .name && countof(base->kind.name.path.segments) == 1 &&
        parse::is_module(p, base->kind.name.path.segments[0].text))
        return false;
    lex::Token name = parse::peek_at(p, 1);
    if (name.kind != lex::name || parse::peek_at(p, 2).kind != lex::left_paren) return false;
    Str word = parse::text(p, name);
    Bool known = same_text(word, "to") || same_text(word, "wrap") || same_text(word, "cast");
    return known;
}

// `x.to(T)`, `x.wrap(T)`, `p.cast(T)`: the position is at the `.`.
static ast::Expr *conversion(parse::Parser *p, ast::Expr *operand) {
    parse::advance(p);
    Str word = parse::text(p, parse::advance(p));
    parse::advance(p);
    ast::CastForm form = .convert;
    if (same_text(word, "wrap")) form = .wrapping;
    if (same_text(word, "cast")) form = .reinterpret;
    ast::TypeExpr *type = parse::type(p);
    if (type == nullptr) return nullptr;
    parse::expect(p, lex::right_paren, "`)` to end the type");
    return make(parse::span_from(p, operand->span.start), {.cast = {.type = type, .operand = operand, .form = form}});
}

// Whether the position lies inside an unclosed `(` or `[` of the statement, so a line break there ends nothing: the
// tokens before it are read back to the nearest unmatched opener (a `{` or `;` first means no, a `(` or `[` yes).
static Bool inside_brackets(const parse::Parser *p) {
    Usize depth = 0;
    for (Usize i = p->position; i > 0; i--) {
        lex::TokenKind kind = p->tokens[i - 1].kind;
        if (kind == lex::right_paren || kind == lex::right_bracket || kind == lex::right_brace) depth += 1;
        if (depth == 0 && (kind == lex::semicolon || kind == lex::left_brace)) return false;
        if (kind != lex::left_paren && kind != lex::left_bracket && kind != lex::left_brace) continue;
        if (depth == 0) return true;
        depth -= 1;
    }
    return false;
}

// A postfix operator applied to the last operand, if one is at the position.
static Outcome postfix_step(parse::Parser *p, Stack *st) {
    lex::Token token = parse::peek(p);
    // A block that ends the operand (`do:` or a lambda in an arm) is the end of it: `.b` after its `dedent` starts the
    // next line.
    if (p->layout && p->position > 0 && p->tokens[p->position - 1].kind == lex::dedent) return .absent;
    ast::Expr *base = st->values[st->value_count - 1];
    ast::Expr *result = nullptr;
    switch (token.kind) {
    case lex::left_paren:
        result = call(p, base, st->head);
        break;
    case lex::left_bracket:
        // A `[` that starts a line is not an index where the line before it ends a statement (`[[noreturn]] fn` after
        // a constant's value, #2224).
        if (p->new_syntax && !p->layout && p->position > 0 &&
            lex::ends_statement(p->tokens[p->position - 1]) && !inside_brackets(p))
            return .absent;
        result = index_or_slice(p, base);
        break;
    case lex::dot:
    case lex::arrow:
        // A `.` that starts a line is not a continuation where the line before it ends a statement (`.b => x` after
        // `.a => f(1)` in a match, the Go rule of lex::ends_statement). Inside parentheses or brackets a line break
        // ends nothing, so `f(g(x)\n.name)` continues (#1773).
        if (p->new_syntax && token.kind == lex::dot && p->position > 0 &&
            lex::ends_statement(p->tokens[p->position - 1]) && !inside_brackets(p))
            return .absent;
        result = conversion_ahead(p, base) ? conversion(p, base) : member(p, base);
        break;
    case lex::dot_star:
        parse::advance(p);
        result = ast::deref(base);
        result->span = parse::span_from(p, base->span.start);
        break;
    case lex::kw_as:
        result = as_cast(p, st);
        break;
    case lex::plus_plus:
    case lex::minus_minus:
        parse::advance(p);
        ast::UnaryOp op = .post_decrement;
        if (token.kind == lex::plus_plus) op = .post_increment;
        result = make(parse::span_from(p, base->span.start), {.unary = {.op = op, .operand = base}});
        note_bump(st, result, token.span);
        break;
    default:
        return .absent;
    }
    if (result == nullptr) return .broken;
    replace_top(st, result);
    return .done;
}

// ---------------------------------------------------------------------------------------------------------------
// Operands: prefix operators, parentheses, casts, `sizeof`

// `sizeof(T)`, `sizeof x`, `alignof`, `countof`: the position is at the keyword.
static Step query(parse::Parser *p, Stack *st) {
    lex::Token keyword = parse::advance(p);
    ast::QueryOp op = .count_of;
    if (keyword.kind == lex::kw_sizeof) op = .size_of;
    if (keyword.kind == lex::kw_alignof) op = .align_of;
    if (parse::at(p, lex::left_paren) &&
        (parse_type::starts_type(p, 1) || (p->new_syntax && parse_type::typeof_new_type_at(p, 1)))) {
        parse::advance(p);
        ast::TypeExpr *type = parse::type(p);
        parse::expect(p, lex::right_paren, "`)` to end the type");
        if (type == nullptr) return .failed;
        push_value(
            st, make(parse::span_from(p, keyword.span.start), {.query = {.op = op, .type = type, .operand = nullptr}}));
        return .value;
    }
    Pending pending = {.form = .query_form, .prec = prefix_prec, .start = keyword.span.start, .query = op};
    push_op(st, pending);
    return .more;
}

// Whether a token starts an operand that no binary operator continues: after `(x)` it makes `(x)` a cast.
static Bool starts_bare_operand(lex::TokenKind kind) {
    switch (kind) {
    case lex::kw_nullptr:
    case lex::kw_true:
    case lex::kw_false:
    case lex::integer:
    case lex::floating:
    case lex::character:
    case lex::string:
    case lex::name:
    case lex::type_name:
        return true;
    default:
        return false;
    }
}

// Whether `(x) operand` is a cast to a type value: the path `x` (lowercase; a `c::` path too) alone in the parentheses, then a
// token that starts an operand and cannot continue an expression (`(t)nullptr`). `(x) - 1` stays a difference and
// `(x)(y)` a call. Whether `x` IS a type is the checker's.
static Bool type_value_cast(const parse::Parser *p) {
    Usize last = 0;
    if (parse::peek_at(p, 0).kind != lex::name) return false;
    while (parse::peek_at(p, last + 1).kind == lex::colon_colon) {
        lex::TokenKind next = parse::peek_at(p, last + 2).kind;
        if (next != lex::name && next != lex::type_name) break;
        last += 2;
    }
    Bool is_c = text::is(parse::text(p, parse::peek_at(p, 0)), "c");
    if (is_c && last == 0) return false;
    Usize close = last + 1;
    // A `c::` type is lowercase (`c::pid_t`), so it reads as a value; one or more `*` before the `)` make it a pointer
    // type (`(c::rusage_info_t *)&usage`), which no value is.
    while (is_c && parse::peek_at(p, close).kind == lex::star)
        close += 1;
    if (parse::peek_at(p, close).kind != lex::right_paren) return false;
    if (close > last + 1) return true;
    return starts_bare_operand(parse::peek_at(p, close + 1).kind);
}

// Whether `(c::T) {` starts a compound literal of a C name: a `c::` path alone in the parentheses and a `{` after them.
// `(c::name)` is a value otherwise, but a brace after it can only be an initializer list (`(c::Handler){.fill = f}`).
static Bool c_literal_type(const parse::Parser *p) {
    Usize last = 0;
    if (parse::peek_at(p, 0).kind != lex::name) return false;
    if (!text::is(parse::text(p, parse::peek_at(p, 0)), "c")) return false;
    while (parse::peek_at(p, last + 1).kind == lex::colon_colon) {
        lex::TokenKind next = parse::peek_at(p, last + 2).kind;
        if (next != lex::name && next != lex::type_name) break;
        last += 2;
    }
    if (last == 0 || parse::peek_at(p, last + 1).kind != lex::right_paren) return false;
    return parse::peek_at(p, last + 2).kind == lex::left_brace;
}

// `(` in smith's own syntax: `()`, `(x,)` and `(a, b)` are tuples, `(x)` groups. The `(` is read.
// Whether `(fn(A))operand` is ahead, the `(` taken: a cast to a function type (`(void (*)(i32))0` after a pass), read as
// a cast whose fix writes `operand.cast(fn(A))`.
static Bool fn_type_cast(const parse::Parser *p) {
    lex::Token word = parse::peek_at(p, 0);
    Bool is_fn = word.kind == lex::kw_fn || (word.kind == lex::name && text::is(parse::text(p, word), "fn"));
    if (!is_fn || parse::peek_at(p, 1).kind != lex::left_paren) return false;
    Usize after = after_group(p, 1, lex::left_paren, lex::right_paren);
    return parse::peek_at(p, after).kind == lex::right_paren && starts_bare_operand(parse::peek_at(p, after + 1).kind);
}

// Whether `(T *)operand` is ahead, the `(` taken: C's pointer type, written after the type, which smith's own syntax
// never has before a `)`. A text a pass has half mended (the head of its function is new, the body is not) holds it.
static Bool old_pointer_cast(const parse::Parser *p) {
    Usize at = 0;
    lex::TokenKind first = parse::peek_at(p, 0).kind;
    if (parse_type::is_keyword_type(first)) {
        while (parse_type::is_keyword_type(parse::peek_at(p, at + 1).kind))
            at += 1;
    } else if (first == lex::name || first == lex::type_name) {
        while ((parse::peek_at(p, at + 1).kind == lex::colon_colon || parse::peek_at(p, at + 1).kind == lex::dot) &&
               (parse::peek_at(p, at + 2).kind == lex::name || parse::peek_at(p, at + 2).kind == lex::type_name))
            at += 2;
    } else {
        return false;
    }
    at += 1;
    Usize stars = 0;
    while (parse::peek_at(p, at + stars).kind == lex::star)
        stars += 1;
    return stars > 0 && parse::peek_at(p, at + stars).kind == lex::right_paren;
}

// Whether `(T){.x = ...` is ahead, the `(` taken: a compound literal of today's syntax in a text a pass has half mended.
static Bool old_literal_ahead(const parse::Parser *p) {
    Usize at = 0;
    lex::TokenKind first = parse::peek_at(p, 0).kind;
    if (first != lex::name && first != lex::type_name) return false;
    while ((parse::peek_at(p, at + 1).kind == lex::colon_colon || parse::peek_at(p, at + 1).kind == lex::dot) &&
           (parse::peek_at(p, at + 2).kind == lex::name || parse::peek_at(p, at + 2).kind == lex::type_name))
        at += 2;
    if (parse::peek_at(p, at + 1).kind != lex::right_paren || parse::peek_at(p, at + 2).kind != lex::left_brace)
        return false;
    return parse::peek_at(p, at + 3).kind == lex::dot && parse::peek_at(p, at + 5).kind == lex::equal;
}

static Step group_or_tuple(parse::Parser *p, Stack *st, U32 start) {
    if (old_literal_ahead(p) && parse_type::path_is_type(p, 0)) {
        ast::TypeExpr *type = parse::type(p);
        lex::Token close = parse::expect(p, lex::right_paren, "`)` to end the cast's type");
        if (type == nullptr) return .failed;
        push_value(st, initializer_list(p, type, start, close.span.start));
        return .value;
    }
    if (fn_type_cast(p) || old_pointer_cast(p)) {
        Bool was_new = p->new_syntax;
        p->new_syntax = !old_pointer_cast(p) && was_new;
        ast::TypeExpr *type = parse::type(p);
        p->new_syntax = was_new;
        lex::Token close = parse::expect(p, lex::right_paren, "`)` to end the cast's type");
        if (type == nullptr) return .failed;
        Pending cast = {.form = .cast_form,
                        .prec = prefix_prec,
                        .start = start,
                        .type = type,
                        .head = from_to(start, close.span.end)};
        push_op(st, cast);
        return .more;
    }
    ast::ExprRef items[:] = {};
    Bool is_tuple = parse::at(p, lex::right_paren);
    Usize named_count = 0;
    for (Usize i = 0; i <= countof(p->tokens) && !parse::at(p, lex::right_paren); i += 1) {
        Bool named = parse::at(p, lex::name) && parse::peek_at(p, 1).kind == lex::equal;
        ast::Expr *item = named ? argument(p) : parse::expression(p);
        if (item == nullptr) return .failed;
        items = parse_type::with_expr(items, item);
        if (named) {
            is_tuple = true;
            named_count += 1;
        }
        if (!parse::accept(p, lex::comma)) break;
        is_tuple = true;
    }
    if (!expect_ok(p, lex::right_paren, "`)` to close the `(`")) return .failed;
    if (named_count > 0 && named_count != countof(items)) {
        parse::error(p, parse::span_from(p, start), "a tuple names all its elements or none: `(count = 3, ms = 1.5)`");
        return .failed;
    }
    ast::Span span = parse::span_from(p, start);
    if (is_tuple) {
        push_value(st, make(span, {.tuple_lit = {.items = items}}));
    } else {
        items[0]->span = span;
        push_value(st, items[0]);
    }
    return .value;
}

// Whether the `[` at the position starts the array type of a compound literal that a pass has already written
// (`([_]F64){3.5}`), not a lambda's capture list (`[x](I32 a) {...}`): a type follows its bracket group, not a `(`.
static Bool array_type_ahead(const parse::Parser *p) {
    if (!parse::at(p, lex::left_bracket) || !parse_type::starts_new_type(p, 0)) return false;
    return parse::peek_at(p, after_group(p, 0, lex::left_bracket, lex::right_bracket)).kind != lex::left_paren;
}

// `(`: a cast `(T)x`, a compound literal `(T){...}` or a parenthesized expression.
static Step paren(parse::Parser *p, Stack *st) {
    U32 start = parse::advance(p).span.start;
    if (p->new_syntax) return group_or_tuple(p, st, start);
    if (parse_type::starts_type(p, 0) || type_value_cast(p) || c_literal_type(p) || array_type_ahead(p)) {
        ast::TypeExpr *type = parse::type(p);
        lex::Token close = parse::expect(p, lex::right_paren, "`)` to end the cast's type");
        if (type == nullptr) return .failed;
        if (parse::at(p, lex::left_brace)) {
            push_value(st, initializer_list(p, type, start, close.span.start));
            return .value;
        }
        Pending cast = {.form = .cast_form,
                        .prec = prefix_prec,
                        .start = start,
                        .type = type,
                        .head = from_to(start, close.span.end)};
        push_op(st, cast);
        return .more;
    }
    ast::Expr *inner = parse::expression(p);
    if (inner == nullptr || comma_operator(p)) return .failed;
    parse::expect(p, lex::right_paren, "`)` to close the `(`");
    inner->span = parse::span_from(p, start);
    push_value(st, inner);
    return .value;
}

// One operand position: a prefix operator (more to come), or a value.
static Step operand_step(parse::Parser *p, Stack *st) {
    lex::Token token = parse::peek(p);
    if (is_prefix(token.kind) || token.kind == lex::kw_try) {
        parse::advance(p);
        Pending op = {.form = .prefix, .prec = prefix_prec, .start = token.span.start, .head = token.span};
        if (token.kind == lex::kw_try) {
            op.form = .try_form;
        } else {
            op.unary = prefix_op(token.kind);
        }
        push_op(st, op);
        return .more;
    }
    switch (token.kind) {
    case lex::kw_sizeof:
    case lex::kw_alignof:
    case lex::kw_countof:
        return query(p, st);
    case lex::left_paren:
        return paren(p, st);
    default:
        break;
    }
    ast::Expr *e = primary(p);
    if (e == nullptr) return .failed;
    push_value(st, e);
    return .value;
}

// ---------------------------------------------------------------------------------------------------------------
// The expression

// Reads an expression at the position, or records an error and gives null. The hook `parse::Hooks.expression`.
export ast::Expr *expression(parse::Parser *p) {
    Stack st = {.parser = p, .head = p->head};
    p->head = false;
    Bool want_operand = true;
    for (Usize i = 0; i <= countof(p->tokens); i += 1) {
        if (want_operand) {
            Step step = operand_step(p, &st);
            if (step == .failed) return nullptr;
            want_operand = step == .more;
            continue;
        }
        Outcome postfix = postfix_step(p, &st);
        if (postfix == .broken) return nullptr;
        if (postfix == .done) continue;
        Outcome infix_result = infix_step(p, &st);
        if (infix_result == .broken) return nullptr;
        if (infix_result == .absent) break;
        want_operand = true;
    }
    if (want_operand) return nullptr;
    Usize pending = st.op_count;
    for (Usize i = 0; i < pending && st.op_count > 0; i += 1)
        reduce(&st);
    ast::Expr *whole = pop_value(&st);
    bump_warnings(p, &st, whole);
    return whole;
}
