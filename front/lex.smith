// front::lex, the tokenizer of smith's own front end (#1112, A2 of track A; internal, not wired into `smith cc`).
//
// It reads the text of a `.smith` file and gives all its tokens at once, ending with an `end_of_file` token. There is
// no preprocessor in a `.smith` file, so there are no `#` tokens either: a `#` outside a string or a comment is an
// error that says to write `constexpr` or `import`.
//
//   Token { TokenKind kind; Span span; }    the text of a token is `source[span.start:span.end]` (lex::text): no copy
//   lex::tokenize(source)                   Result(Token[:], LexError): the tokens, or the first error
//   lex::dump(tokens, source)               one token a line, `line:column kind text`, for golden files
//
// What the tokenizer decides, and what it leaves to the parser:
//   * An identifier is a `type_name` when its first character is an uppercase ASCII letter (`I32`, `Point`, `Option`)
//     and a `name` otherwise (`x`, `printf`, `_tmp`); what `c::EOF` is, is the parser's question. A keyword has a kind
//     of its own (`kw_if`): C23's keywords, `_Atomic _BitInt _Complex _Decimal32 _Decimal64 _Decimal128 _Generic
//     _Imaginary _Noreturn` and smith's `module import export defer try countof`. `int`, `char`, `long`, `unsigned`
//     and the rest of C's type keywords stay keywords: the parser decides what it accepts.
//   * A literal has the form checked, not its value (the parser decodes it): `integer` (decimal, `0x`, octal, `0b`,
//     `'` between digits, the suffixes `u l ll wb`), `floating` (decimal and hexadecimal, `f l` and `f16`..`f128`
//     style suffixes), `character` and `string`, with the prefixes `u8`, `u`, `U` and `L` and C's escapes.
//   * The punctuators are C's without the preprocessor's `#` and `##`, plus `::`. `[:]` is three tokens, `[[` is two
//     and `]]` is two. There are no trigraphs and no digraphs.
//   * Whitespace and comments (`//`, `/* */`) make no tokens.
// An error is an unterminated string, character or block comment, a malformed number, a `#`, or a byte that starts no
// token. Tokenizing stops at the first.
module front::lex;

import front::ast;
import std::arena;
import std::ascii;
import std::mem;
import std::text;

// What a token is. The keywords are `kw_alignas` to `kw_countof` and the punctuators `left_paren` to `comma`, each run
// in one piece.
// NOLINTBEGIN(readability-identifier-naming)
// The constants are written short, as lex::name and lex::kw_if, and the check wants C's Type_Value.
export enum TokenKind {
    end_of_file,
    type_name,
    name,
    integer,
    floating,
    character,
    string,
    kw_alignas,
    kw_alignof,
    kw_auto,
    kw_bool,
    kw_break,
    kw_case,
    kw_char,
    kw_const,
    kw_constexpr,
    kw_continue,
    kw_default,
    kw_do,
    kw_double,
    kw_else,
    kw_enum,
    kw_extern,
    kw_false,
    kw_float,
    kw_for,
    kw_goto,
    kw_if,
    kw_inline,
    kw_int,
    kw_long,
    kw_nullptr,
    kw_register,
    kw_restrict,
    kw_return,
    kw_short,
    kw_signed,
    kw_sizeof,
    kw_static,
    kw_static_assert,
    kw_struct,
    kw_switch,
    kw_thread_local,
    kw_true,
    kw_typedef,
    kw_typeof,
    kw_typeof_unqual,
    kw_union,
    kw_unsigned,
    kw_void,
    kw_volatile,
    kw_while,
    kw_atomic,
    kw_bit_int,
    kw_complex,
    kw_decimal32,
    kw_decimal64,
    kw_decimal128,
    kw_generic,
    kw_imaginary,
    kw_noreturn,
    kw_module,
    kw_import,
    kw_export,
    kw_defer,
    kw_try,
    kw_countof,
    kw_fn,
    kw_pub,
    kw_mut,
    kw_match,
    kw_in,
    kw_as,
    kw_fn_once,
    kw_type,
    left_paren,
    right_paren,
    left_bracket,
    right_bracket,
    left_brace,
    right_brace,
    dot,
    arrow,
    plus_plus,
    minus_minus,
    ampersand,
    star,
    plus,
    minus,
    tilde,
    bang,
    slash,
    percent,
    less_less,
    greater_greater,
    less,
    greater,
    less_equal,
    greater_equal,
    equal_equal,
    bang_equal,
    caret,
    pipe,
    ampersand_ampersand,
    pipe_pipe,
    question,
    colon,
    colon_colon,
    semicolon,
    ellipsis,
    equal,
    star_equal,
    slash_equal,
    percent_equal,
    plus_equal,
    minus_equal,
    less_less_equal,
    greater_greater_equal,
    ampersand_equal,
    caret_equal,
    pipe_equal,
    comma,
    colon_equal,
    fat_arrow,
    at,
    dot_star,
};
// NOLINTEND(readability-identifier-naming)

// A token: its kind and where its text lies in the source.
export struct Token {
    TokenKind kind;
    ast::Span span;
    Bool line_break;
};

// The tokens of a file, and what tokenizing gives: the tokens or the first error.
export typedef typeof(Token[:]) Tokens;

// Why tokenizing stopped: where, and what is wrong (a literal, owned by nobody).
export typedef struct {
    ast::Span span;
    Str message;
} LexError;

export typedef Result(Tokens, LexError) Lexed;

