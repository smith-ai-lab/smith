// front::fix_alloc, the fix-it for a sized allocation (#2527): `mem.alloc_slice(T, n)` is `mem.alloc(T, n)`,
// `mem.alloc_slice(T, a, b)` is `mem.alloc(T, [a, b])` (one block `[,]T`), and `arena.push_slice(&x, T, a, b)` is
// `arena.push_slice(&x, T, [a, b])`: a size or a shape, as `array.filled` takes. Element access through the nested
// slices of a C caller (`x[i][j]`) is not rewritten here: it is a `[,]T` index `x[i, j]` that a later fix writes.
//
//   fix_alloc::edits(source)   one fix for each call of `mem.alloc_slice` or of `arena.push_slice` with a shape
module front::fix_alloc;

import front::ast;
import front::parse as core;
import std::mem;

static Bool at(Str s, Usize i, Str pattern) {
    if (i + countof(pattern) > countof(s)) return false;
    return mem::equal(s[i:i + countof(pattern)], pattern);
}

static Bool word_char(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
}

static core::Edits push(core::Edits edits, Usize from, Usize to, Str text) {
    edits = mem::realloc(edits, countof(edits) + 1);
    edits[countof(edits) - 1] = (core::Edit){.span = {.start = (U32)from, .end = (U32)to}, .text = text};
    return edits;
}

// The arguments of the call whose `(` is at `open`: where each one starts (after the `(` or a `,` at the top level),
// how many there are (at most `countof(starts)`), and the offset of the closing `)`; false when it does not close on
// this text or has more arguments.
static Bool arguments(Str s, Usize open, Usize starts[:], Usize *count, Usize *close) {
    Usize depth = 0;
    Usize n = 0;
    Bool quoted = false;
    for (Usize i = open; i < countof(s); i++) {
        char ch = s[i];
        if (quoted) {
            if (ch == '\\') {
                i += 1;
            } else if (ch == '"') {
                quoted = false;
            }
            continue;
        }
        if (ch == '"') quoted = true;
        if (ch == '(' || ch == '[' || ch == '{') depth += 1;
        if (ch == ')' || ch == ']' || ch == '}') {
            depth -= 1;
            if (depth == 0) {
                *count = n;
                *close = i;
                return true;
            }
        }
        Bool starts_one = (ch == ',' && depth == 1) || i == open;
        if (starts_one && n == countof(starts)) return false;
        if (starts_one) {
            starts[n] = i + 1;
            n += 1;
        }
    }
    return false;
}

// The fix of the call `<name>(` at `i`, whose shape starts at argument `shape` (1 for `mem.alloc_slice`, after the
// type; 2 for `arena.push_slice`, after the arena and the type); `rename` replaces `name`. None when the call keeps its
// form: one size and no rename.
static core::ParseError call_fix(Str source, Usize i, Str name, Usize shape, Str rename) {
    core::ParseError none = {};
    if (!at(source, i, name) || (i > 0 && (word_char(source[i - 1]) || source[i - 1] == '.'))) return none;
    Usize starts[18] = {};
    Usize count = 0;
    Usize close = 0;
    Usize open = i + countof(name) - 1;
    if (!arguments(source, open, starts, &count, &close) || count < shape + 1) return none;
    Bool shaped = count > shape + 1;
    if (!shaped && countof(rename) == 0) return none;
    core::ParseError out = {};
    out.span = (ast::Span){.start = (U32)i, .end = (U32)(close + 1)};
    if (countof(rename) > 0) out.fix = push(out.fix, i, open, rename);
    if (shaped) {
        Usize first = starts[shape];
        while (first < close && source[first] == ' ')
            first += 1;
        out.fix = push(out.fix, first, first, "[");
        out.fix = push(out.fix, close, close, "]");
    }
    out.message = shaped ? "a size for each dimension is one shape: write `mem.alloc(T, [a, b])`, one block `[,]T`"
                         : "`mem.alloc(T, n)` makes the slice of n";
    return out;
}

// The offset of the `)` that closes the `(` at `open`, or `countof(s)` when there is none.
static Usize close_paren(Str s, Usize open) {
    Usize depth = 0;
    for (Usize i = open; i < countof(s); i++) {
        if (s[i] == '(') depth += 1;
        if (s[i] == ')') {
            depth -= 1;
            if (depth == 0) return i;
        }
    }
    return countof(s);
}

static Usize skip_blanks(Str s, Usize i) {
    while (i < countof(s) && (s[i] == ' ' || s[i] == '\n' || s[i] == '\t')) i += 1;
    return i;
}

// The fix of the zero value of a type made from an expression, `(typeof(a)){0}` or `(typeof(a)){}`, that starts at
// `i`: `mem::zeroed(typeof(a))` (D10, decided on #1406). The type is only known at compile time, so it has no `T()`.
static core::ParseError zero_fix(Str source, Usize i) {
    core::ParseError none = {};
    if (!at(source, i, "(typeof(") || (i > 0 && (word_char(source[i - 1]) || source[i - 1] == '.'))) return none;
    Usize close = close_paren(source, i);
    if (close == countof(source)) return none;
    Usize brace = skip_blanks(source, close + 1);
    if (brace >= countof(source) || source[brace] != '{') return none;
    Usize inner = skip_blanks(source, brace + 1);
    if (inner < countof(source) && source[inner] == '0') inner = skip_blanks(source, inner + 1);
    if (inner >= countof(source) || source[inner] != '}') return none;
    core::ParseError out = {};
    out.span = (ast::Span){.start = (U32)i, .end = (U32)(inner + 1)};
    out.fix = push(out.fix, i, i + 1, "mem::zeroed(");
    out.fix = push(out.fix, close, inner + 1, ")");
    out.message = "the zero value of a type known at compile time is `mem.zeroed(T)`";
    return out;
}

// Whether the text imports `std::mem` (or has already been written `import std.mem`).
static Bool has_mem(Str source) {
    for (Usize i = 0; i + 14 < countof(source); i++) {
        if (at(source, i, "import std::mem;") || at(source, i, "import std.mem")) return true;
    }
    return false;
}

// The fix that adds `import std::mem;` once, on the line after `module ...;`.
static core::ParseError import_mem(Str source) {
    core::ParseError none = {};
    for (Usize i = 0; i + 7 < countof(source); i++) {
        if (!at(source, i, "module ") || (i > 0 && source[i - 1] != '\n')) continue;
        Usize end = i;
        while (end < countof(source) && source[end] != '\n') end += 1;
        core::ParseError out = {};
        out.span = (ast::Span){.start = (U32)end, .end = (U32)end};
        out.fix = push(out.fix, end, end, "\nimport std::mem;");
        out.message = "a fix needs a standard module";
        return out;
    }
    return none;
}

// The fixes of the module's text.
export core::Errors edits(Str source) {
    core::Errors out = {};
    Bool zeroes = false;
    for (Usize i = 0; i < countof(source); i++) {
        core::ParseError found = call_fix(source, i, "mem.alloc_slice(", 1, "mem.alloc");
        if (countof(found.fix) == 0) found = call_fix(source, i, "arena.push_slice(", 2, "");
        core::ParseError zero = zero_fix(source, i);
        if (countof(found.fix) == 0 && countof(zero.fix) > 0) {
            found = zero;
            zeroes = true;
        }
        if (countof(found.fix) == 0) continue;
        out = mem::realloc(out, countof(out) + 1);
        out[countof(out) - 1] = found;
    }
    if (zeroes && !has_mem(source)) {
        core::ParseError add = import_mem(source);
        if (countof(add.fix) > 0) {
            out = mem::realloc(out, countof(out) + 1);
            out[countof(out) - 1] = add;
        }
    }
    return out;
}
