// front::fix_bool, the fix-it for a Bool given where a C function wants an integer (#2648).
//
//   c::LLVMBuildIntCast2(b, v, t, is_signed(ty), "")   c::LLVMBuildIntCast2(b, v, t, is_signed(ty).to(i32), "")
//   c::LLVMStructType(ctx, f, n, false)                c::LLVMStructType(ctx, f, n, 0)
//
// C's `int` holds a comparison and `false`; smith's `Bool` is not an integer, and the checker says "a Bool is not an
// integer; write a conversion". The literals `true` and `false` become `1` and `0`; any other expression gets the
// built-in conversion, in parentheses unless it is a name, a member chain or a call.
//
//   fix_bool::edits(source, checked)   one fix for each such error
module front::fix_bool;

import front::ast;
import front::parse as core;
import front::types;
import std::format;
import std::mem;

static Bool starts_with(Str text, Str prefix) {
    if (countof(text) < countof(prefix)) return false;
    for (Usize i = 0; i < countof(prefix); i++)
        if (text[i] != prefix[i]) return false;
    return true;
}

static Bool contains(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++)
        if (starts_with(text[i:countof(text)], needle)) return true;
    return false;
}

static Bool same(Str a, Str b) {
    return countof(a) == countof(b) && starts_with(a, b);
}

// A name, a member chain or a call: what `.to(T)` can follow as it is written. The brackets of a call are matched, so
// `(a + b) * c` and `f(x) + 1` are not one.
static Bool is_postfix(Str text) {
    Usize depth = 0;
    Bool closed = false;
    for (Usize i = 0; i < countof(text); i++) {
        char ch = text[i];
        Bool word = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
        if (closed && depth == 0) return false;
        if (ch == '(')
            depth += 1;
        else if (ch == ')') {
            if (depth == 0) return false;
            depth -= 1;
            closed = depth == 0;
        } else if (depth == 0 && !word && ch != '.') {
            return false;
        }
    }
    return depth == 0 && countof(text) > 0 && text[0] != '(';
}

// The integer type the message names, lower case: `expected I32, found Bool: ...` is `i32`.
static Str integer_name(Str message) {
    Str lead = "expected ";
    Usize from = countof(lead);
    Usize to = from;
    while (to < countof(message) && message[to] != ',')
        to += 1;
    Str name = message[from:to];
    if (countof(name) < 2 || (name[0] != 'I' && name[0] != 'U')) return "";
    for (Usize i = 1; i < countof(name); i++)
        if (name[i] < '0' || name[i] > '9') return "";
    Str low = "";
    low = types::message_of(format::push(name[0] == 'I' ? "i" : "u", name[1:countof(name)]));
    return low;
}

export core::Errors edits(Str source, const types::Checked *c) {
    core::Errors out = {};
    for (Usize i = 0; i < c->error_count; i++) {
        types::Error found = c->errors[i];
        if (countof(found.fix) > 0 || found.span.end > countof(source) || found.span.start >= found.span.end) continue;
        if (!starts_with(found.message, "expected ") ||
            !contains(found.message, ", found Bool: a Bool is not an integer"))
            continue;
        Str integer = integer_name(found.message);
        if (countof(integer) == 0) continue;
        Str text = source[found.span.start:found.span.end];
        Str written = "";
        if (same(text, "true"))
            written = "1";
        else if (same(text, "false"))
            written = "0";
        else if (is_postfix(text))
            written = types::message_of(format::push(text, ".to(", integer, ")"));
        else
            written = types::message_of(format::push("(", text, ").to(", integer, ")"));
        core::Edits fix = {};
        fix = mem::realloc(fix, 1);
        fix[0] = (core::Edit){.span = found.span, .text = written};
        out = mem::realloc(out, countof(out) + 1);
        core::ParseError made = {};
        made.span = found.span;
        made.message = "write the integer a C function wants";
        made.fix = fix;
        out[countof(out) - 1] = made;
    }
    return out;
}
