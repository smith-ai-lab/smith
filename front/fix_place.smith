// front::fix_place, the fix-it for a write through a payload (D21, #2648).
//
//   if one == .index:                       if .index(index) := &one:
//       one.index.index = take(one.index.index)       index.index = take(index.index)
//
// Matching a pointer to a payload enumeration binds pointers into the payload, so a write through the name changes
// the enumeration (smith-dev-syntax-bindings). The pass covers `if K == .v:` with an indented body whose every
// `K.v` is followed by `.field`, at least one of them written (`=`, `+=`, `&K.v.f`), where `K` is a name or a member
// chain and `v` is no word of the function. The checker types the pattern on a pointer once #2647 lands, so
// `fix.smith` waits for the parser to read the form. Tests: `tests/front_fix_place_test.smith`.
//
//   fix_place::edits(source)   one fix for each test, and one for each `_ = x` statement
//
// A statement that starts with `_ =` discards a value the way C did (`(void)x` and `_ = x` in today's syntax); in the new
// syntax `_` is no name to assign to, and the discard is `_ := x` (smith-dev-syntax-attributes: `_` for unused, #3084).
module front::fix_place;

import front::ast;
import front::parse as core;
import front::types;
import std::format;
import std::mem;

static Bool word_char(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
}

static Bool starts_with(Str text, Str prefix) {
    if (countof(text) < countof(prefix)) return false;
    for (Usize i = 0; i < countof(prefix); i++)
        if (text[i] != prefix[i]) return false;
    return true;
}

static Usize line_end(Str source, Usize at) {
    while (at < countof(source) && source[at] != '\n')
        at += 1;
    return at;
}

static Usize indent_of(Str source, Usize at) {
    Usize k = at;
    while (k < countof(source) && source[k] == ' ')
        k += 1;
    return k - at;
}

static Bool blank(Str source, Usize at) {
    return at >= countof(source) || line_end(source, at) == at + indent_of(source, at);
}

static Usize next_line(Str source, Usize at) {
    return line_end(source, at) + 1;
}

// The place of `name` as a whole word (not `x.name`) in `text`, or `countof(text)`.
static Usize word_at(Str text, Str name) {
    for (Usize i = 0; i + countof(name) <= countof(text); i++) {
        if (i > 0 && (word_char(text[i - 1]) || text[i - 1] == '.')) continue;
        if (!starts_with(text[i:countof(text)], name)) continue;
        if (i + countof(name) < countof(text) && word_char(text[i + countof(name)])) continue;
        return i;
    }
    return countof(text);
}

static Usize function_start(Str source, Usize at) {
    Usize start = at;
    while (start > 0) {
        Usize prev = start - 1;
        while (prev > 0 && source[prev - 1] != '\n')
            prev -= 1;
        start = prev;
        if (source[start] != ' ' && source[start] != '\n') break;
    }
    return start;
}

static Usize function_end(Str source, Usize start) {
    Usize stop = next_line(source, start);
    while (stop < countof(source) && (source[stop] == ' ' || source[stop] == '\n'))
        stop = next_line(source, stop);
    return stop < countof(source) ? stop : countof(source);
}

// The `K` and `v` of the trimmed `line` `if K == .v:`, and where the colon ends.
static Bool test_of(Str line, Str *base, Str *variant, Usize *after) {
    if (!starts_with(line, "if ")) return false;
    Usize k = 3;
    while (k < countof(line) && (word_char(line[k]) || line[k] == '.'))
        k += 1;
    if (k == 3 || !starts_with(line[k:countof(line)], " == .")) return false;
    Usize name = k + 5;
    Usize j = name;
    while (j < countof(line) && word_char(line[j]))
        j += 1;
    if (j == name || j + 1 != countof(line) || line[j] != ':') return false;
    *base = line[3:k];
    *variant = line[name:j];
    *after = j + 1;
    return true;
}

// Whether the text from `at` is a write: `= `, `+= ` and the like, but not `==`.
static Bool written(Str text, Usize at) {
    Usize k = at;
    while (k < countof(text) && (word_char(text[k]) || text[k] == '.'))
        k += 1;
    while (k < countof(text) && text[k] == ' ')
        k += 1;
    if (k + 1 >= countof(text)) return false;
    if (text[k] == '=') return text[k + 1] != '=';
    char ch = text[k];
    Bool op = ch == '+' || ch == '-' || ch == '*' || ch == '/' || ch == '%' || ch == '|' || ch == '^';
    return op && text[k + 1] == '=';
}

// The places of `base.variant` in `text` (offsets), up to `limit`; false when one is not followed by `.field`.
static Bool reads_of(Str text, Str base, Str variant, Usize *places, Usize *count, Bool *wrote) {
    Usize want = countof(base) + 1 + countof(variant);
    for (Usize i = 0; i + want <= countof(text); i++) {
        if (i > 0 && (word_char(text[i - 1]) || text[i - 1] == '.')) continue;
        if (!starts_with(text[i:countof(text)], base)) continue;
        if (text[i + countof(base)] != '.') continue;
        if (!starts_with(text[i + countof(base) + 1:countof(text)], variant)) continue;
        Usize after = i + want;
        if (after < countof(text) && word_char(text[after])) continue;
        if (after + 1 >= countof(text) || text[after] != '.' || !word_char(text[after + 1])) return false;
        if (*count >= 64) return false;
        places[*count] = i;
        *count += 1;
        if (written(text, after + 1) || (i > 0 && text[i - 1] == '&')) *wrote = true;
    }
    return true;
}

// One fix for each line that starts with `_ = `: the `:` goes before the `=`, so `_ = f(x)` is `_ := f(x)`.
static core::Errors discard_edits(Str source, core::Errors out) {
    Usize at = 0;
    while (at < countof(source)) {
        Usize end = line_end(source, at);
        Usize head = at + indent_of(source, at);
        if (starts_with(source[head:end], "_ = ")) {
            core::Edits fix = {};
            fix = mem::realloc(fix, 1);
            fix[0] = (core::Edit){.span = {.start = (U32)(head + 2), .end = (U32)(head + 2)}, .text = ":"};
            core::ParseError made = {};
            made.span = (ast::Span){.start = (U32)head, .end = (U32)(head + 3)};
            made.message = "`_` is no name to assign to: a discarded value is `_ := x`";
            made.fix = fix;
            out = mem::realloc(out, countof(out) + 1);
            out[countof(out) - 1] = made;
        }
        at = end + 1;
    }
    return out;
}

export core::Errors edits(Str source) {
    core::Errors out = discard_edits(source, {});
    Usize last_function = countof(source);
    Usize at = 0;
    while (at < countof(source)) {
        Usize end = line_end(source, at);
        Usize indent = indent_of(source, at);
        Str base = "";
        Str variant = "";
        Usize after = 0;
        if (!test_of(source[at + indent:end], &base, &variant, &after)) {
            at = end + 1;
            continue;
        }
        Usize head = at + indent;
        Usize body = end + 1;
        Usize body_end = body;
        while (body_end < countof(source) && (blank(source, body_end) || indent_of(source, body_end) > indent))
            body_end = next_line(source, body_end);
        if (body_end > countof(source)) body_end = countof(source);
        Bool has_else = body_end < countof(source) && indent_of(source, body_end) == indent &&
                        starts_with(source[body_end + indent:countof(source)], "else");
        Usize start = function_start(source, at);
        Usize stop = function_end(source, start);
        if (body_end == body || has_else || start == last_function ||
            word_at(source[start:stop], variant) < stop - start) {
            at = end + 1;
            continue;
        }
        Usize places[64] = {};
        Usize count = 0;
        Bool wrote = false;
        if (!reads_of(source[body:body_end], base, variant, places, &count, &wrote) || !wrote) {
            at = end + 1;
            continue;
        }
        last_function = start;
        core::Edits fix = {};
        fix = mem::realloc(fix, count + 1);
        Str pattern = types::message_of(format::push(".", variant, "(", variant, ") := &", base, ":"));
        fix[0] = (core::Edit){.span = {.start = (U32)(head + 3), .end = (U32)(head + after)}, .text = pattern};
        for (Usize i = 0; i < count; i++) {
            Usize from = body + places[i];
            fix[i + 1] =
                (core::Edit){.span = {.start = (U32)from, .end = (U32)(from + countof(base) + 1 + countof(variant))},
                             .text = variant};
        }
        ast::Span span = {.start = (U32)head, .end = (U32)(head + after)};
        core::ParseError made = {};
        made.span = span;
        Str why = "a write through a payload binds a pointer: `.v(v) := &k`";
        made.message = why;
        made.fix = fix;
        out = mem::realloc(out, countof(out) + 1);
        out[countof(out) - 1] = made;
        at = end + 1;
    }
    return out;
}
