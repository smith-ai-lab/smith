// front::emit_control: control flow for the emitter (B2, #1131 of #1112). Statements: `if`, `while`, `do while`, `for`,
// `break`, `continue`; expressions: comparisons, `&&`, `||` (short circuit: blocks and a phi), `!`, `?:` and `true`
// and `false`. `defer` runs on every way out of its block (below). `switch`, `goto` and labels keep their `not emitted
// yet`.
//
// How it works with the walk (the protocol is at the top of front/emit.smith): a statement makes its blocks, then
// pushes its pieces as work in reverse order, so they run as: the condition (an `eval`), `branch_on_condition`, the
// body, a continuation that closes the loop or branch. A continuation reads the node it needs from `Then.stmt` or
// `Then.expr` and the blocks from `Then.blocks`. A block that already ends in a terminator (after `return`, `break`)
// gets no branch. `break` and `continue` find their blocks on `Emitter.loops`; a loop pushes its target when its body
// starts and pops it when it ends, and the last pop gives the slice back.
//
// `defer body` pushes the body on `Emitter.defers` with the scope depth it was in. A block's end runs and removes its
// own (newest first) unless its end is unreachable; `return` runs all of them after its value is computed; `break` and
// `continue` run those deeper than the loop (`LoopTarget.scope_depth`) and then jump. A deferred body is emitted once
// per way out, so a local in it gets a slot each time.
//
// Conditions are `Bool` (the module rule): an integer where a condition is expected is an Error with the condition's
// span, "a condition is a Bool; write `x != 0`".
module front::emit_control;

import front::ast;
import front::emit_state as state;
import front::types;
import std::mem;
import <llvm-c/Core.h>;

// ---------------------------------------------------------------------------------------------------------------
// Helpers

static c::LLVMBasicBlockRef new_block(state::Emitter *e, const char *name) {
    return c::LLVMAppendBasicBlockInContext(e->context, e->function, name);
}

// Branch to `block` unless the current block already ends (a `return`, a `break`).
static void jump(state::Emitter *e, c::LLVMBasicBlockRef block) {
    c::LLVMBasicBlockRef here = c::LLVMGetInsertBlock(e->builder);
    if (c::LLVMGetBasicBlockTerminator(here) == nullptr) c::LLVMBuildBr(e->builder, block);
}

// A continuation that jumps to `blocks[0]` once the work pushed after it (a `break`'s deferred bodies) has run.
static state::Status jump_to(state::Emitter *e, const state::ThenBlocks *w) {
    jump(e, w->blocks[0]);
    return state::success();
}

static void position(state::Emitter *e, c::LLVMBasicBlockRef block) {
    c::LLVMPositionBuilderAtEnd(e->builder, block);
}

static state::Ty bool_type(state::Emitter *e) {
    state::Ty ty = {};
    state::scalar_type(e, "Bool", &ty);
    return ty;
}

// An Error of this module: the walk ends, so the loop targets go back now.
static state::Status stop(state::Emitter *e, Str message, ast::Span span) {
    e->loop_count = 0;
    e->loops = mem::realloc(e->loops, 0);
    return state::fail(message, span);
}

// A condition, or an operand of `&&`, `||` and `!`, is a Bool.
static state::Status require_bool(state::Emitter *e, state::Value value, ast::Span span) {
    if (value.ty.kind == .boolean) return state::success();
    return stop(e, "a condition is a Bool; write `x != 0`", span);
}

static state::Status branch_on_condition(state::Emitter *e, const state::ThenGeneral *w) {
    state::Value condition = state::pop_value(e);
    try require_bool(e, condition, w->expr->span);
    c::LLVMBuildCondBr(e->builder, condition.llvm, w->blocks[0], w->blocks[1]);
    position(e, w->blocks[(Usize)w->number]);
    return state::success();
}

// Evaluate `condition`, then branch to `yes` or `no` and go on in `yes` (`continue_in` 0) or in `no` (1).
static void push_condition(state::Emitter *e, const ast::Expr *condition, c::LLVMBasicBlockRef yes,
                           c::LLVMBasicBlockRef no, U64 continue_in) {
    state::ThenGeneral item = state::then_general(branch_on_condition, condition->span);
    item.expr = condition;
    item.number = continue_in;
    item.blocks[0] = yes;
    item.blocks[1] = no;
    state::push_then_general(e, item);
    state::push_eval(e, condition, state::no_hint());
}

// The value of an expression statement is dropped.
static state::Status discard(state::Emitter *e, const state::ThenNone *_) {
    _ = state::pop_value(e);
    return state::success();
}

// ---------------------------------------------------------------------------------------------------------------
// if

// The `then` branch is done: leave for the end, and go on in the `else` block when there is one.
static state::Status if_after_then(state::Emitter *e, const state::ThenGeneral *w) {
    jump(e, w->blocks[1]);
    if (w->flag)
        position(e, w->blocks[0]);
    else
        position(e, w->blocks[1]);
    return state::success();
}

static state::Status if_end(state::Emitter *e, const state::ThenBlocks *w) {
    jump(e, w->blocks[0]);
    position(e, w->blocks[0]);
    return state::success();
}

export state::Status if_stmt(state::Emitter *e, const ast::Stmt *s) {
    if (s->kind != .if_stmt) {
        return state::fail("not an if", s->span);
    }
    const ast::Expr *condition = s->kind.if_stmt.condition;
    const ast::Stmt *then_branch = s->kind.if_stmt.then_branch;
    const ast::Stmt *else_branch = s->kind.if_stmt.else_branch;
    if (s->kind.if_stmt.is_constexpr) return stop(e, "`if constexpr` belongs to the type checker", s->span);
    Bool has_else = else_branch != nullptr;
    c::LLVMBasicBlockRef then_block = new_block(e, "then");
    c::LLVMBasicBlockRef else_block = nullptr;
    if (has_else) else_block = new_block(e, "else");
    c::LLVMBasicBlockRef end_block = new_block(e, "endif");
    if (!has_else) else_block = end_block;
    if (has_else) {
        state::ThenBlocks end = state::then_blocks(if_end, s->span);
        end.blocks[0] = end_block;
        state::push_then_blocks(e, end);
        state::push_statement(e, else_branch);
    }
    state::ThenGeneral after = state::then_general(if_after_then, s->span);
    after.flag = has_else;
    after.blocks[0] = else_block;
    after.blocks[1] = end_block;
    state::push_then_general(e, after);
    state::push_statement(e, then_branch);
    push_condition(e, condition, then_block, else_block, 0);
    return state::success();
}

// ---------------------------------------------------------------------------------------------------------------
// Loops

static state::Status while_end(state::Emitter *e, const state::ThenBlocks *w) {
    jump(e, w->blocks[0]);
    state::pop_loop(e);
    position(e, w->blocks[1]);
    return state::success();
}

export state::Status while_stmt(state::Emitter *e, const ast::Stmt *s) {
    if (s->kind != .while_stmt) {
        return state::fail("not a while", s->span);
    }
    const ast::Expr *condition = s->kind.while_stmt.condition;
    const ast::Stmt *body = s->kind.while_stmt.body;
    c::LLVMBasicBlockRef condition_block = new_block(e, "whilecond");
    c::LLVMBasicBlockRef body_block = new_block(e, "whilebody");
    c::LLVMBasicBlockRef end_block = new_block(e, "endwhile");
    jump(e, condition_block);
    position(e, condition_block);
    state::push_loop(e, (state::LoopTarget){.break_block = end_block,
                                            .continue_block = condition_block,
                                            .scope_depth = e->scope_count});
    state::ThenBlocks end = state::then_blocks(while_end, s->span);
    end.blocks[0] = condition_block;
    end.blocks[1] = end_block;
    state::push_then_blocks(e, end);
    state::push_statement(e, body);
    push_condition(e, condition, body_block, end_block, 0);
    return state::success();
}

// The body is done: the condition is evaluated in its own block (`continue` jumps there), then goes on in the end.
static state::Status do_condition(state::Emitter *e, const state::ThenGeneral *w) {
    if (w->stmt->kind != .do_while) {
        return state::fail("not a do while", w->span);
    }
    const ast::Expr *condition = w->stmt->kind.do_while.condition;
    jump(e, w->blocks[1]);
    position(e, w->blocks[1]);
    state::pop_loop(e);
    push_condition(e, condition, w->blocks[0], w->blocks[2], 1);
    return state::success();
}

export state::Status do_while(state::Emitter *e, const ast::Stmt *s) {
    if (s->kind != .do_while) {
        return state::fail("not a do while", s->span);
    }
    const ast::Stmt *body = s->kind.do_while.body;
    c::LLVMBasicBlockRef body_block = new_block(e, "dobody");
    c::LLVMBasicBlockRef condition_block = new_block(e, "docond");
    c::LLVMBasicBlockRef end_block = new_block(e, "enddo");
    jump(e, body_block);
    position(e, body_block);
    state::push_loop(e, (state::LoopTarget){.break_block = end_block,
                                            .continue_block = condition_block,
                                            .scope_depth = e->scope_count});
    state::ThenGeneral next = state::then_general(do_condition, s->span);
    next.stmt = s;
    next.blocks[0] = body_block;
    next.blocks[1] = condition_block;
    next.blocks[2] = end_block;
    state::push_then_general(e, next);
    state::push_statement(e, body);
    return state::success();
}

static state::Status for_back(state::Emitter *e, const state::ThenBlocks *w) {
    jump(e, w->blocks[0]);
    return state::success();
}

// The body is done: the step runs in its own block (`continue` jumps there), then back to the condition.
static state::Status for_step(state::Emitter *e, const state::ThenGeneral *w) {
    if (w->stmt->kind != .for_stmt) {
        return state::fail("not a for", w->span);
    }
    const ast::Expr *step = w->stmt->kind.for_stmt.step;
    jump(e, w->blocks[0]);
    position(e, w->blocks[0]);
    if (step == nullptr) {
        jump(e, w->blocks[1]);
        return state::success();
    }
    state::ThenBlocks back = state::then_blocks(for_back, w->span);
    back.blocks[0] = w->blocks[1];
    state::push_then_blocks(e, back);
    state::push_then_none(e, (state::ThenNone){.run = discard, .span = w->span});
    state::push_eval(e, step, state::no_hint());
    return state::success();
}

// The init has run: the condition block, the body and the step.
static state::Status for_start(state::Emitter *e, const state::ThenGeneral *w) {
    if (w->stmt->kind != .for_stmt) {
        return state::fail("not a for", w->span);
    }
    const ast::Expr *condition = w->stmt->kind.for_stmt.condition;
    const ast::Stmt *body = w->stmt->kind.for_stmt.body;
    c::LLVMBasicBlockRef end_block = w->blocks[0];
    c::LLVMBasicBlockRef condition_block = new_block(e, "forcond");
    c::LLVMBasicBlockRef body_block = new_block(e, "forbody");
    c::LLVMBasicBlockRef step_block = new_block(e, "forstep");
    jump(e, condition_block);
    position(e, condition_block);
    state::push_loop(
        e, (state::LoopTarget){.break_block = end_block, .continue_block = step_block, .scope_depth = e->scope_count});
    state::ThenGeneral next = state::then_general(for_step, w->span);
    next.stmt = w->stmt;
    next.blocks[0] = step_block;
    next.blocks[1] = condition_block;
    state::push_then_general(e, next);
    state::push_statement(e, body);
    if (condition == nullptr) {
        jump(e, body_block);
        position(e, body_block);
    } else {
        push_condition(e, condition, body_block, end_block, 0);
    }
    return state::success();
}

static state::Status for_end(state::Emitter *e, const state::ThenBlocks *w) {
    state::pop_loop(e);
    state::end_scope(e);
    position(e, w->blocks[0]);
    return state::success();
}

// `for (init; condition; step) body`: the init may declare a variable, which lives in the loop's scope; any part may
// be absent.
export state::Status for_stmt(state::Emitter *e, const ast::Stmt *s) {
    if (s->kind != .for_stmt) {
        return state::fail("not a for", s->span);
    }
    const ast::Stmt *init = s->kind.for_stmt.init;
    if (s->kind.for_stmt.is_constexpr) return stop(e, "`for constexpr` belongs to the type checker", s->span);
    state::begin_scope(e);
    c::LLVMBasicBlockRef end_block = new_block(e, "endfor");
    state::ThenBlocks end = state::then_blocks(for_end, s->span);
    end.blocks[0] = end_block;
    state::push_then_blocks(e, end);
    state::ThenGeneral start = state::then_general(for_start, s->span);
    start.stmt = s;
    start.blocks[0] = end_block;
    state::push_then_general(e, start);
    if (init != nullptr) state::push_statement(e, init);
    return state::success();
}

// The pending `defer`s a jump out of the loop on top leaves: pushes the jump to `target` as work, then the bodies of
// the entries deeper than the loop, so the innermost runs first and the jump last. Nothing is removed from `defers`:
// the other paths out of those blocks still need them.
static void leave_loop(state::Emitter *e, c::LLVMBasicBlockRef target, ast::Span span) {
    Usize depth = e->loops[e->loop_count - 1].scope_depth;
    Usize first = e->defer_count;
    while (first > 0 && e->defers[first - 1].scope_depth > depth)
        first -= 1;
    if (first == e->defer_count) {
        jump(e, target);
        return;
    }
    state::ThenBlocks next = state::then_blocks(jump_to, span);
    next.blocks[0] = target;
    state::push_then_blocks(e, next);
    for (Usize i = first; i < e->defer_count; i++)
        if (!e->defers[i].on_error) state::push_statement(e, e->defers[i].body);
}

export state::Status break_stmt(state::Emitter *e, const ast::Stmt *s) {
    if (e->loop_count == 0) return stop(e, "`break` outside a loop", s->span);
    leave_loop(e, e->loops[e->loop_count - 1].break_block, s->span);
    return state::success();
}

export state::Status continue_stmt(state::Emitter *e, const ast::Stmt *s) {
    if (e->loop_count == 0) return stop(e, "`continue` outside a loop", s->span);
    leave_loop(e, e->loops[e->loop_count - 1].continue_block, s->span);
    return state::success();
}

// ---------------------------------------------------------------------------------------------------------------
// Expressions

// The type a name stands for, as the hint of a literal beside it.
static state::Hint hint_from_name(state::Emitter *e, const ast::Expr *x) {
    state::Local local = {};
    if (x->kind == .name && countof(x->kind.name.path.segments) == 1 &&
        state::find_local(e, x->kind.name.path.segments[0].text, &local))
        return state::hint_of(local.ty);
    return state::no_hint();
}

static c::LLVMIntPredicate predicate(ast::BinaryOp op, Bool is_signed) {
    if (op == .equal) return c::LLVMIntEQ;
    if (op == .less) return is_signed ? c::LLVMIntSLT : c::LLVMIntULT;
    if (op == .greater) return is_signed ? c::LLVMIntSGT : c::LLVMIntUGT;
    if (op == .less_equal) return is_signed ? c::LLVMIntSLE : c::LLVMIntULE;
    if (op == .greater_equal) return is_signed ? c::LLVMIntSGE : c::LLVMIntUGE;
    return c::LLVMIntNE;
}

// ---- slices and `str` (#2540): equal when the counts are equal and each element is.

// An element whose bytes are its value: one `memcmp` compares the whole run.
static Bool bytes_are_value(state::Ty t) {
    return (t.kind == .integer && state::width(t) % 8 == 0) || t.kind == .pointer;
}

static c::LLVMValueRef memcmp_equal(state::Emitter *e, state::Ty element, c::LLVMValueRef a, c::LLVMValueRef b,
                                    c::LLVMValueRef count) {
    c::LLVMTypeRef word = c::LLVMTypeOf(count);
    c::LLVMTypeRef pointer = state::pointer_type(e, 0);
    c::LLVMTypeRef params[3] = {pointer, pointer, word};
    c::LLVMTypeRef type = c::LLVMFunctionType(c::LLVMInt32TypeInContext(e->context), params, 3, 0);
    c::LLVMValueRef function = c::LLVMGetNamedFunction(e->module, "memcmp");
    if (function == nullptr) function = c::LLVMAddFunction(e->module, "memcmp", type);
    c::LLVMValueRef size = c::LLVMBuildIntCast2(e->builder, c::LLVMSizeOf(element.llvm), word, 0, "");
    c::LLVMValueRef args[3] = {a, b, c::LLVMBuildMul(e->builder, count, size, "bytes")};
    c::LLVMValueRef order = c::LLVMBuildCall2(e->builder, type, function, args, 3, "");
    return c::LLVMBuildICmp(e->builder, c::LLVMIntEQ, order,
                            c::LLVMConstInt(c::LLVMInt32TypeInContext(e->context), 0, 0), "");
}

// Element by element, for floats (`NaN != NaN`) and the like: a loop over the common count.
static c::LLVMValueRef loop_equal(state::Emitter *e, state::Ty element, c::LLVMValueRef a, c::LLVMValueRef b,
                                  c::LLVMValueRef count) {
    c::LLVMTypeRef word = c::LLVMTypeOf(count);
    c::LLVMTypeRef flag = c::LLVMInt1TypeInContext(e->context);
    c::LLVMBasicBlockRef before = c::LLVMGetInsertBlock(e->builder);
    c::LLVMBasicBlockRef head = new_block(e, "slice_head");
    c::LLVMBasicBlockRef check = new_block(e, "slice_check");
    c::LLVMBasicBlockRef step = new_block(e, "slice_step");
    c::LLVMBasicBlockRef leave = new_block(e, "slice_exit");
    c::LLVMBuildBr(e->builder, head);
    position(e, head);
    c::LLVMValueRef at = c::LLVMBuildPhi(e->builder, word, "at");
    c::LLVMValueRef more = c::LLVMBuildICmp(e->builder, c::LLVMIntULT, at, count, "");
    c::LLVMBuildCondBr(e->builder, more, check, leave);
    position(e, check);
    c::LLVMValueRef left_at = c::LLVMBuildInBoundsGEP2(e->builder, element.llvm, a, &at, 1, "");
    c::LLVMValueRef right_at = c::LLVMBuildInBoundsGEP2(e->builder, element.llvm, b, &at, 1, "");
    c::LLVMValueRef x = c::LLVMBuildLoad2(e->builder, element.llvm, left_at, "");
    c::LLVMValueRef y = c::LLVMBuildLoad2(e->builder, element.llvm, right_at, "");
    c::LLVMValueRef same = element.kind == .floating ? c::LLVMBuildFCmp(e->builder, c::LLVMRealOEQ, x, y, "")
                                                     : c::LLVMBuildICmp(e->builder, c::LLVMIntEQ, x, y, "");
    c::LLVMBuildCondBr(e->builder, same, step, leave);
    position(e, step);
    c::LLVMValueRef next = c::LLVMBuildAdd(e->builder, at, c::LLVMConstInt(word, 1, 0), "");
    c::LLVMBuildBr(e->builder, head);
    c::LLVMValueRef from_at[2] = {c::LLVMConstInt(word, 0, 0), next};
    c::LLVMBasicBlockRef from_block[2] = {before, step};
    c::LLVMAddIncoming(at, from_at, from_block, 2);
    position(e, leave);
    c::LLVMValueRef result = c::LLVMBuildPhi(e->builder, flag, "");
    c::LLVMValueRef values[2] = {c::LLVMConstInt(flag, 1, 0), c::LLVMConstInt(flag, 0, 0)};
    c::LLVMBasicBlockRef blocks[2] = {head, check};
    c::LLVMAddIncoming(result, values, blocks, 2);
    return result;
}

// The two slices (or `str`) of `element` as an `i1`: true when they have the same contents.
static c::LLVMValueRef slice_equal(state::Emitter *e, state::Ty element, state::Value left, state::Value right) {
    c::LLVMValueRef a = c::LLVMBuildExtractValue(e->builder, left.llvm, 0, "data");
    c::LLVMValueRef na = c::LLVMBuildExtractValue(e->builder, left.llvm, 1, "count");
    c::LLVMValueRef b = c::LLVMBuildExtractValue(e->builder, right.llvm, 0, "data");
    c::LLVMValueRef nb = c::LLVMBuildExtractValue(e->builder, right.llvm, 1, "count");
    c::LLVMTypeRef flag = c::LLVMInt1TypeInContext(e->context);
    c::LLVMBasicBlockRef start = c::LLVMGetInsertBlock(e->builder);
    c::LLVMBasicBlockRef body = new_block(e, "slice_eq");
    c::LLVMBasicBlockRef done = new_block(e, "slice_eq_end");
    c::LLVMValueRef counts = c::LLVMBuildICmp(e->builder, c::LLVMIntEQ, na, nb, "same_count");
    c::LLVMBuildCondBr(e->builder, counts, body, done);
    position(e, body);
    c::LLVMValueRef contents =
        bytes_are_value(element) ? memcmp_equal(e, element, a, b, na) : loop_equal(e, element, a, b, na);
    c::LLVMBasicBlockRef body_end = c::LLVMGetInsertBlock(e->builder);
    c::LLVMBuildBr(e->builder, done);
    position(e, done);
    c::LLVMValueRef result = c::LLVMBuildPhi(e->builder, flag, "");
    c::LLVMValueRef values[2] = {c::LLVMConstInt(flag, 0, 0), contents};
    c::LLVMBasicBlockRef blocks[2] = {start, body_end};
    c::LLVMAddIncoming(result, values, blocks, 2);
    return result;
}

// `a == b` of two `?T` (#2650): the same tag, and equal payloads when both are `.some`. Null when the payload is not
// a number, a Bool or a pointer. `?*T` is the pointer itself.
static c::LLVMValueRef option_equal(state::Emitter *e, state::Value left, state::Value right) {
    if (left.ty.kind != .option) return nullptr;
    state::Ty element = *left.ty.kind.option.element;
    if (element.kind != .integer && element.kind != .boolean && element.kind != .pointer) return nullptr;
    if (element.kind == .pointer) return c::LLVMBuildICmp(e->builder, c::LLVMIntEQ, left.llvm, right.llvm, "");
    c::LLVMValueRef tag_left = c::LLVMBuildExtractValue(e->builder, left.llvm, 0, "tag");
    c::LLVMValueRef tag_right = c::LLVMBuildExtractValue(e->builder, right.llvm, 0, "tag");
    c::LLVMValueRef value_left = c::LLVMBuildExtractValue(e->builder, left.llvm, 1, "value");
    c::LLVMValueRef value_right = c::LLVMBuildExtractValue(e->builder, right.llvm, 1, "value");
    c::LLVMValueRef tags = c::LLVMBuildICmp(e->builder, c::LLVMIntEQ, tag_left, tag_right, "same_tag");
    c::LLVMValueRef values = c::LLVMBuildICmp(e->builder, c::LLVMIntEQ, value_left, value_right, "same_value");
    c::LLVMValueRef none =
        c::LLVMBuildICmp(e->builder, c::LLVMIntEQ, tag_left, c::LLVMConstNull(c::LLVMTypeOf(tag_left)), "none");
    c::LLVMValueRef agree = c::LLVMBuildOr(e->builder, none, values, "");
    return c::LLVMBuildAnd(e->builder, tags, agree, "");
}

static state::Status compare_finish(state::Emitter *e, const state::ThenExpr *w) {
    if (w->expr->kind != .binary) {
        return state::fail("not a comparison", w->span);
    }
    ast::BinaryOp op = w->expr->kind.binary.op;
    state::Value right = state::pop_value(e);
    state::Value left = state::pop_value(e);
    // An operand that failed earlier (the run goes on after an error) has no value to compare.
    if (left.llvm == nullptr || right.llvm == nullptr) return state::fail("operand has no value", w->span);
    try state::unify_operands(e, &left, &right, w->span);
    // A `fn` value against `nullptr`: its code word is the pointer that is compared.
    if (left.ty.kind == .fn_value && right.ty.kind == .pointer)
        left = (state::Value){.llvm = c::LLVMBuildExtractValue(e->builder, left.llvm, 0, "code"), .ty = right.ty};
    else if (right.ty.kind == .fn_value && left.ty.kind == .pointer)
        right = (state::Value){.llvm = c::LLVMBuildExtractValue(e->builder, right.llvm, 0, "code"), .ty = left.ty};
    // An enumerator of a C header (an `int` constant) against a value of the enumeration's unsigned type: the constant
    // takes the other side's type, its bits kept.
    if (!state::same_type(left.ty, right.ty) && left.ty.kind == .integer && right.ty.kind == .integer &&
        state::width(left.ty) == state::width(right.ty)) {
        if (c::LLVMIsAConstantInt(right.llvm) != nullptr)
            right = (state::Value){.llvm = c::LLVMConstInt(left.ty.llvm, c::LLVMConstIntGetZExtValue(right.llvm), 0),
                                   .ty = left.ty};
        else if (c::LLVMIsAConstantInt(left.llvm) != nullptr)
            left = (state::Value){.llvm = c::LLVMConstInt(right.ty.llvm, c::LLVMConstIntGetZExtValue(left.llvm), 0),
                                  .ty = right.ty};
    }
    if (!state::same_type(left.ty, right.ty))
        return state::failf(w->span, "operands of different types: ", left.ty.name, " and ", right.ty.name);
    if (left.ty.kind == .slice && left.ty.kind.slice.element != nullptr && (op == .equal || op == .not_equal)) {
        c::LLVMValueRef same = slice_equal(e, *left.ty.kind.slice.element, left, right);

        if (op == .not_equal) same = c::LLVMBuildNot(e->builder, same, "");
        state::push_value(e, (state::Value){.llvm = same, .ty = bool_type(e)});
        return state::success();
    }
    if (left.ty.kind == .option && (op == .equal || op == .not_equal)) {
        c::LLVMValueRef same = option_equal(e, left, right);

        if (same == nullptr) return state::failf(w->span, "comparison of ", left.ty.name);
        if (op == .not_equal) same = c::LLVMBuildNot(e->builder, same, "");
        state::push_value(e, (state::Value){.llvm = same, .ty = bool_type(e)});
        return state::success();
    }
    if (left.ty.kind != .integer && left.ty.kind != .boolean && left.ty.kind != .pointer && left.ty.kind != .fn_pointer)
        return state::failf(w->span, "comparison of ", left.ty.name);
    c::LLVMValueRef out =
        c::LLVMBuildICmp(e->builder, predicate(op, state::is_signed(left.ty)), left.llvm, right.llvm, "");
    state::push_value(e, (state::Value){.llvm = out, .ty = bool_type(e)});
    return state::success();
}

// The left operand is on the stack: the right one is evaluated as its type.
static state::Status compare_middle(state::Emitter *e, const state::ThenExpr *w) {
    if (w->expr->kind != .binary) {
        return state::fail("not a comparison", w->span);
    }
    const ast::Expr *right = w->expr->kind.binary.right;
    state::Value left = state::peek_value(e);
    state::push_then_expr(e, (state::ThenExpr){.run = compare_finish, .expr = w->expr, .span = w->span});
    state::push_eval(e, right, state::hint_of(left.ty));
    return state::success();
}

// `x == .none`, `x != .some` and the like over a `?T` (#2481), and `written == .ok` or `r != .error` over a Result
// (#2984): the side that is not written with a leading dot, or null when this is no such test. `wants_some` says
// whether the dotted side is `.some` (or `.ok`).
static const ast::Expr *option_operand(state::Emitter *e, const ast::Expr *x, Bool *wants_some) {
    if (!(x->kind == .binary) || e->options.checked == nullptr) return nullptr;
    ast::BinaryOp op = x->kind.binary.op;
    if (op != .equal && op != .not_equal) return nullptr;
    const ast::Expr *left = x->kind.binary.left;
    const ast::Expr *right = x->kind.binary.right;
    const ast::Expr *dotted = right->kind == .variant && left->kind != .variant ? right : nullptr;
    if (dotted == nullptr && left->kind == .variant && right->kind != .variant) dotted = left;
    if (dotted == nullptr || !(dotted->kind == .variant) || dotted->kind.variant.payload != nullptr) return nullptr;
    Str name = dotted->kind.variant.name;
    Bool some = countof(name) == 4 && name[0] == 's' && name[1] == 'o' && name[2] == 'm' && name[3] == 'e';
    Bool none = countof(name) == 4 && name[0] == 'n' && name[1] == 'o' && name[2] == 'n' && name[3] == 'e';
    Bool ok = state::same_text(name, "ok");
    Bool error = state::same_text(name, "error");
    if (!some && !none && !ok && !error) return nullptr;
    const ast::Expr *operand = dotted == right ? left : right;
    types::TypeRef t = types::type_of(e->options.checked, operand);
    if (t == nullptr) return nullptr;
    if ((some || none) && t->kind != .option) return nullptr;
    if ((ok || error) && t->kind != .result_type) return nullptr;
    *wants_some = some || ok;
    return operand;
}

// The option is on the stack: its tag says `.some` or `.none`.
static state::Status option_test_finish(state::Emitter *e, const state::ThenExpr *w) {
    Bool wants_some = false;
    option_operand(e, w->expr, &wants_some);
    state::Value o = state::pop_value(e);
    c::LLVMValueRef tag = o.llvm;
    if (!(o.ty.kind == .option && o.ty.kind.option.element->kind == .pointer)) // `?*T` is the pointer itself
        tag = c::LLVMBuildExtractValue(e->builder, o.llvm, 0, "tag");
    c::LLVMValueRef zero = c::LLVMConstNull(c::LLVMTypeOf(tag));
    Bool same = w->expr->kind == .binary &&
                (w->expr->kind.binary.op == .equal) == wants_some; // `== .some` and `!= .none` ask for a payload
    if (o.ty.kind == .result) same = !same; // a Result's tag is 0 for `.ok`, where an option's is 1 for `.some`
    c::LLVMIntPredicate predicate = same ? c::LLVMIntNE : c::LLVMIntEQ;
    c::LLVMValueRef out = c::LLVMBuildICmp(e->builder, predicate, tag, zero, "");
    state::push_value(e, (state::Value){.llvm = out, .ty = bool_type(e)});
    return state::success();
}

// `kind == .pointer`, `k != .pair` over an enumeration whose enumerators carry values (#2984): the side that is not
// written with a leading dot, or null when this is no such test. `position` is the enumerator's place, its tag.
static const ast::Expr *payload_operand(state::Emitter *e, const ast::Expr *x, Usize *position) {
    if (!(x->kind == .binary) || e->options.checked == nullptr) return nullptr;
    ast::BinaryOp op = x->kind.binary.op;
    if (op != .equal && op != .not_equal) return nullptr;
    const ast::Expr *left = x->kind.binary.left;
    const ast::Expr *right = x->kind.binary.right;
    const ast::Expr *dotted = right->kind == .variant && left->kind != .variant ? right : nullptr;
    if (dotted == nullptr && left->kind == .variant && right->kind != .variant) dotted = left;
    if (dotted == nullptr || !(dotted->kind == .variant) || dotted->kind.variant.payload != nullptr) return nullptr;
    Str name = dotted->kind.variant.name;
    const ast::Expr *operand = dotted == right ? left : right;
    types::TypeRef t = types::type_of(e->options.checked, operand);
    if (t == nullptr || !types::is_payload_enum(t)) return nullptr;
    types::Slot items[:] = types::slots_of(t).items;
    for (Usize i = 0; i < countof(items); i++) {
        if (!state::same_text(items[i].name, name)) continue;
        *position = i;
        return operand;
    }
    return nullptr;
}

// The enumeration is on the stack: its tag (field 0, an `i32`) against the enumerator's place.
static state::Status payload_test_finish(state::Emitter *e, const state::ThenExpr *w) {
    Usize position = 0;
    payload_operand(e, w->expr, &position);
    state::Value v = state::pop_value(e);
    if (v.ty.kind != .variant_enum) return state::failf(w->span, "comparison of ", v.ty.name);
    c::LLVMValueRef tag = c::LLVMBuildExtractValue(e->builder, v.llvm, 0, "tag");
    c::LLVMValueRef want = c::LLVMConstInt(c::LLVMTypeOf(tag), position, 0);
    Bool equal = w->expr->kind == .binary && w->expr->kind.binary.op == .equal;
    c::LLVMValueRef out = c::LLVMBuildICmp(e->builder, equal ? c::LLVMIntEQ : c::LLVMIntNE, tag, want, "");
    state::push_value(e, (state::Value){.llvm = out, .ty = bool_type(e)});
    return state::success();
}

// `x is T`, `x is not T`, `x is .v`, `x is not .v` (#3226): the operand, the variant's place in a payload enumeration
// (`countof(slots)` when the operand is not one) and whether the test asks for a payload (`.some`, `.ok`, a type).
static const ast::Expr *is_operand(state::Emitter *e, const ast::Expr *x, Usize *position, Bool *wants_some) {
    if (!(x->kind == .binary) || e->options.checked == nullptr) return nullptr;
    const ast::Expr *operand = x->kind.binary.left;
    const ast::Expr *right = x->kind.binary.right;
    types::TypeRef t = types::type_of(e->options.checked, operand);
    if (t == nullptr) return nullptr;
    types::TypeRef written = right->kind == .type_value ? types::type_of(e->options.checked, right) : nullptr;
    Str name = "";
    if (right->kind == .variant) name = right->kind.variant.name;
    *position = 0;
    if (types::is_payload_enum(t)) {
        types::Slot items[:] = types::slots_of(t).items;
        *position = countof(items);
        for (Usize i = 0; i < countof(items); i++) {
            if (written != nullptr ? items[i].type == written : state::same_text(items[i].name, name)) {
                *position = i;
                break;
            }
        }
        return operand;
    }
    *wants_some = written != nullptr || state::same_text(name, "some") || state::same_text(name, "ok");
    return operand;
}

// The operand is on the stack: a tag compare for a payload enumeration, an option or a Result; the constant the type
// decides when the operand is not a union here (a name already narrowed to the variant's payload).
static state::Status is_test_finish(state::Emitter *e, const state::ThenExpr *w) {
    Usize position = 0;
    Bool wants_some = false;
    is_operand(e, w->expr, &position, &wants_some);
    if (!(w->expr->kind == .binary)) return state::fail("not a type test", w->span);
    Bool positive = w->expr->kind.binary.op == .is;
    state::Value v = state::pop_value(e);
    c::LLVMValueRef out = nullptr;
    if (v.ty.kind == .variant_enum) {
        c::LLVMValueRef tag = c::LLVMBuildExtractValue(e->builder, v.llvm, 0, "tag");
        c::LLVMValueRef want = c::LLVMConstInt(c::LLVMTypeOf(tag), position, 0);
        out = c::LLVMBuildICmp(e->builder, positive ? c::LLVMIntEQ : c::LLVMIntNE, tag, want, "");
    } else if (v.ty.kind == .option || v.ty.kind == .result) {
        c::LLVMValueRef tag = v.llvm;
        if (!(v.ty.kind == .option && v.ty.kind.option.element->kind == .pointer)) // `?*T` is the pointer itself
            tag = c::LLVMBuildExtractValue(e->builder, v.llvm, 0, "tag");
        Bool same = positive == wants_some;     // `is .some` and `is not .none` ask for a payload
        if (v.ty.kind == .result) same = !same; // a Result's tag is 0 for `.ok`, where an option's is 1 for `.some`
        out = c::LLVMBuildICmp(e->builder, same ? c::LLVMIntNE : c::LLVMIntEQ, tag,
                               c::LLVMConstNull(c::LLVMTypeOf(tag)), "");
    } else {
        out = c::LLVMConstInt(bool_type(e).llvm, positive ? 1 : 0, 0);
    }
    state::push_value(e, (state::Value){.llvm = out, .ty = bool_type(e)});
    return state::success();
}

// `x is T` / `x is not T` over any operand the checker accepted (#3226): one compare of the tag.
export state::Status type_test(state::Emitter *e, const ast::Expr *x, state::Hint _) {
    Usize position = 0;
    Bool wants_some = false;
    const ast::Expr *operand = is_operand(e, x, &position, &wants_some);
    if (operand == nullptr) return state::fail("not yet supported: a type test without the checker's types", x->span);
    state::push_then_expr(e, (state::ThenExpr){.run = is_test_finish, .expr = x, .span = x->span});
    state::push_eval(e, operand, state::no_hint());
    return state::success();
}

// `binary` with `less`, `greater`, `less_equal`, `greater_equal`, `equal` or `not_equal`: signed or unsigned by the
// operands' type, a Bool (an `i1`) as the result.
export state::Status comparison(state::Emitter *e, const ast::Expr *x, state::Hint _) {
    if (x->kind != .binary) {
        return state::fail("not a comparison", x->span);
    }
    const ast::Expr *left = x->kind.binary.left;
    const ast::Expr *right = x->kind.binary.right;
    Bool wants_some = false;
    Usize position = 0;
    const ast::Expr *tagged = payload_operand(e, x, &position);
    if (tagged != nullptr) {
        state::push_then_expr(e, (state::ThenExpr){.run = payload_test_finish, .expr = x, .span = x->span});
        state::push_eval(e, tagged, state::no_hint());
        return state::success();
    }
    const ast::Expr *operand = option_operand(e, x, &wants_some);
    if (operand != nullptr) {
        state::push_then_expr(e, (state::ThenExpr){.run = option_test_finish, .expr = x, .span = x->span});
        state::push_eval(e, operand, state::no_hint());
        return state::success();
    }
    state::Hint left_hint = state::no_hint();
    if (left->kind == .integer) left_hint = hint_from_name(e, right);
    state::push_then_expr(e, (state::ThenExpr){.run = compare_middle, .expr = x, .span = x->span});
    state::push_eval(e, left, left_hint);
    return state::success();
}

// The right side has run: join the two paths with a phi.
static state::Status logical_finish(state::Emitter *e, const state::ThenGeneral *w) {
    if (w->expr->kind != .binary) {
        return state::fail("not a logical operator", w->span);
    }
    ast::BinaryOp op = w->expr->kind.binary.op;
    ast::Span right_span = w->expr->kind.binary.right->span;
    state::Value right = state::pop_value(e);
    try require_bool(e, right, right_span);
    c::LLVMBasicBlockRef right_end = c::LLVMGetInsertBlock(e->builder);
    c::LLVMBuildBr(e->builder, w->blocks[1]);
    position(e, w->blocks[1]);
    U64 skipped = 0;
    if (op == .logical_or) skipped = 1;
    c::LLVMValueRef phi = c::LLVMBuildPhi(e->builder, right.ty.llvm, "");
    c::LLVMValueRef values[2] = {c::LLVMConstInt(right.ty.llvm, skipped, 0), right.llvm};
    c::LLVMBasicBlockRef from[2] = {w->blocks[0], right_end};
    c::LLVMAddIncoming(phi, values, from, 2);
    state::push_value(e, (state::Value){.llvm = phi, .ty = right.ty});
    return state::success();
}

// The right side of `&&` or `||` that a constant left side left to run: it is a Bool too.
static state::Status right_is_bool(state::Emitter *e, const state::ThenExpr *w) {
    if (w->expr->kind != .binary) {
        return state::fail("not a logical operator", w->span);
    }
    ast::Span right_span = w->expr->kind.binary.right->span;
    state::Value right = state::pop_value(e);
    try require_bool(e, right, right_span);
    state::push_value(e, right);
    return state::success();
}

// The left side is on the stack: `&&` goes on to the right side only when it is true, `||` only when it is false.
static state::Status logical_middle(state::Emitter *e, const state::ThenExpr *w) {
    if (w->expr->kind != .binary) {
        return state::fail("not a logical operator", w->span);
    }
    ast::BinaryOp op = w->expr->kind.binary.op;
    const ast::Expr *right = w->expr->kind.binary.right;
    ast::Span left_span = w->expr->kind.binary.left->span;
    state::Value left = state::pop_value(e);
    try require_bool(e, left, left_span);
    if (c::LLVMIsAConstantInt(left.llvm) != nullptr) {
        // A known left side decides at once, so a condition of constants stays one (`static_assert(a == 2 && b == 3)`).
        Bool truth = c::LLVMConstIntGetZExtValue(left.llvm) != 0;
        if (op == .logical_and ? !truth : truth) {
            state::push_value(e, left);
        } else {
            state::push_then_expr(e, (state::ThenExpr){.run = right_is_bool, .expr = w->expr, .span = w->span});
            state::push_eval(e, right, state::no_hint());
        }
        return state::success();
    }
    c::LLVMBasicBlockRef left_end = c::LLVMGetInsertBlock(e->builder);
    c::LLVMBasicBlockRef right_block = new_block(e, "rhs");
    c::LLVMBasicBlockRef end_block = new_block(e, "endlogic");
    if (op == .logical_and)
        c::LLVMBuildCondBr(e->builder, left.llvm, right_block, end_block);
    else
        c::LLVMBuildCondBr(e->builder, left.llvm, end_block, right_block);
    position(e, right_block);
    state::ThenGeneral finish = state::then_general(logical_finish, w->span);
    finish.expr = w->expr;
    finish.blocks[0] = left_end;
    finish.blocks[1] = end_block;
    state::push_then_general(e, finish);
    state::push_eval(e, right, state::no_hint());
    return state::success();
}

// `binary` with `logical_and` or `logical_or`: the right side is evaluated only when it is needed.
export state::Status logical(state::Emitter *e, const ast::Expr *x, state::Hint _) {
    if (x->kind != .binary) {
        return state::fail("not a logical operator", x->span);
    }
    const ast::Expr *left = x->kind.binary.left;
    state::push_then_expr(e, (state::ThenExpr){.run = logical_middle, .expr = x, .span = x->span});
    state::push_eval(e, left, state::no_hint());
    return state::success();
}

static state::Status not_finish(state::Emitter *e, const state::ThenExpr *w) {
    if (w->expr->kind != .unary) {
        return state::fail("not a logical not", w->span);
    }
    ast::Span operand_span = w->expr->kind.unary.operand->span;
    state::Value operand = state::pop_value(e);
    try require_bool(e, operand, operand_span);
    state::push_value(e, (state::Value){.llvm = c::LLVMBuildNot(e->builder, operand.llvm, ""), .ty = operand.ty});
    return state::success();
}

// `unary` with `logical_not`.
export state::Status logical_not(state::Emitter *e, const ast::Expr *x, state::Hint _) {
    if (x->kind != .unary) {
        return state::fail("not a logical not", x->span);
    }
    const ast::Expr *operand = x->kind.unary.operand;
    state::push_then_expr(e, (state::ThenExpr){.run = not_finish, .expr = x, .span = x->span});
    state::push_eval(e, operand, state::no_hint());
    return state::success();
}

// The `else` value has run: join the two paths with a phi. The `then` value is in the item.
static state::Status conditional_finish(state::Emitter *e, const state::ThenGeneral *w) {
    state::Value other = state::pop_value(e);
    if (!state::same_type(w->ty, other.ty))
        return state::failf(w->span, "the branches of ?: have different types: ", w->ty.name, " and ", other.ty.name);
    c::LLVMBasicBlockRef other_end = c::LLVMGetInsertBlock(e->builder);
    c::LLVMBuildBr(e->builder, w->blocks[1]);
    position(e, w->blocks[1]);
    c::LLVMValueRef phi = c::LLVMBuildPhi(e->builder, w->ty.llvm, "");
    c::LLVMValueRef values[2] = {w->value, other.llvm};
    c::LLVMBasicBlockRef from[2] = {w->blocks[0], other_end};
    c::LLVMAddIncoming(phi, values, from, 2);
    state::push_value(e, (state::Value){.llvm = phi, .ty = w->ty});
    return state::success();
}

// The `then` value is on the stack: leave for the end and evaluate the `else` value as its type.
static state::Status conditional_middle(state::Emitter *e, const state::ThenGeneral *w) {
    if (w->expr->kind != .conditional) {
        return state::fail("not a conditional expression", w->span);
    }
    const ast::Expr *else_value = w->expr->kind.conditional.else_value;
    state::Value chosen = state::pop_value(e);
    c::LLVMBasicBlockRef chosen_end = c::LLVMGetInsertBlock(e->builder);
    c::LLVMBuildBr(e->builder, w->blocks[1]);
    position(e, w->blocks[0]);
    state::ThenGeneral finish = state::then_general(conditional_finish, w->span);
    finish.ty = chosen.ty;
    finish.value = chosen.llvm;
    finish.blocks[0] = chosen_end;
    finish.blocks[1] = w->blocks[1];
    state::push_then_general(e, finish);
    state::push_eval(e, else_value, state::hint_of(chosen.ty));
    return state::success();
}

// `condition ? a : b`: only the chosen side is evaluated.
export state::Status conditional(state::Emitter *e, const ast::Expr *x, state::Hint hint) {
    if (x->kind != .conditional) {
        return state::fail("not a conditional expression", x->span);
    }
    const ast::Expr *condition = x->kind.conditional.condition;
    const ast::Expr *then_value = x->kind.conditional.then_value;
    const ast::Expr *else_value = x->kind.conditional.else_value;
    state::Hint then_hint = hint;
    if (!then_hint.present && then_value->kind == .integer) then_hint = hint_from_name(e, else_value);
    c::LLVMBasicBlockRef then_block = new_block(e, "qthen");
    c::LLVMBasicBlockRef else_block = new_block(e, "qelse");
    c::LLVMBasicBlockRef end_block = new_block(e, "qend");
    state::ThenGeneral middle = state::then_general(conditional_middle, x->span);
    middle.expr = x;
    middle.blocks[0] = else_block;
    middle.blocks[1] = end_block;
    state::push_then_general(e, middle);
    state::push_eval(e, then_value, then_hint);
    push_condition(e, condition, then_block, else_block, 0);
    return state::success();
}

// A Bool the checker computed for an expression that has no run-time form (`small(T)`, `u8 != T`, #3039).
export state::Status computed_boolean(state::Emitter *e, U64 bits) {
    state::Ty ty = bool_type(e);
    state::push_value(e, (state::Value){.llvm = c::LLVMConstInt(ty.llvm, bits != 0 ? 1 : 0, 0), .ty = ty});
    return state::success();
}

export state::Status boolean(state::Emitter *e, const ast::Expr *x, state::Hint _) {
    if (x->kind != .boolean) {
        return state::fail("not a boolean", x->span);
    }
    U64 bit = 0;
    if (x->kind.boolean.value) bit = 1;
    state::Ty ty = bool_type(e);
    state::push_value(e, (state::Value){.llvm = c::LLVMConstInt(ty.llvm, bit, 0), .ty = ty});
    return state::success();
}

// ---------------------------------------------------------------------------------------------------------------
// Later tickets: they keep their `not emitted yet`

export state::Status switch_stmt(state::Emitter *_, const ast::Stmt *s) {
    return state::not_emitted("switch", s->span);
}

export state::Status goto_stmt(state::Emitter *_, const ast::Stmt *s) {
    return state::not_emitted("goto", s->span);
}

export state::Status labeled(state::Emitter *_, const ast::Stmt *s) {
    return state::not_emitted("label", s->span);
}

static state::Status push_defer(state::Emitter *e, const ast::Stmt *body, Bool on_error) {
    if (e->defer_count == countof(e->defers)) {
        Usize capacity = countof(e->defers) * 2;
        if (capacity < 4) capacity = 4;
        e->defers = mem::realloc(e->defers, capacity);
    }
    e->defers[e->defer_count] = (state::DeferEntry){.body = body, .scope_depth = e->scope_count, .on_error = on_error};
    e->defer_count += 1;
    return state::success();
}

// `defer body`: the body waits on `defers` with the depth of the block it is in, and emits nothing now.
export state::Status defer_stmt(state::Emitter *e, const ast::Stmt *s) {
    if (s->kind != .defer_stmt) {
        return state::fail("not a defer", s->span);
    }
    return push_defer(e, s->kind.defer_stmt.body, false);
}

// `errdefer body`: like `defer`, but it runs only on the early return of a `try`.
export state::Status errdefer_stmt(state::Emitter *e, const ast::Stmt *s) {
    if (s->kind != .errdefer_stmt) {
        return state::fail("not an errdefer", s->span);
    }
    return push_defer(e, s->kind.errdefer_stmt.body, true);
}

// Called when a block ends, before its locals go out of scope: the `defer`s of this scope run here, the newest first,
// and leave `defers`. A block whose end cannot be reached (it ended in `return`, `break` or `continue`) runs none.
export state::Status end_of_block(state::Emitter *e, ast::Span _) {
    Usize first = e->defer_count;
    while (first > 0 && e->defers[first - 1].scope_depth >= e->scope_count)
        first -= 1;
    c::LLVMBasicBlockRef here = c::LLVMGetInsertBlock(e->builder);
    if (c::LLVMGetBasicBlockTerminator(here) == nullptr) {
        for (Usize i = first; i < e->defer_count; i++)
            if (!e->defers[i].on_error) state::push_statement(e, e->defers[i].body);
    }
    e->defer_count = first;
    if (first == 0 && countof(e->defers) > 0) e->defers = mem::realloc(e->defers, 0);
    return state::success();
}

// Called by `return` after its value is computed, before `ret`: every pending `defer` runs, the newest first. None is
// removed: the function's other paths still need them.
export state::Status before_return(state::Emitter *e, ast::Span _) {
    for (Usize i = 0; i < e->defer_count; i++)
        if (!e->defers[i].on_error) state::push_statement(e, e->defers[i].body);
    return state::success();
}

// The early return of a `try`: every pending `defer` and `errdefer` runs, the newest first.
export state::Status before_error_return(state::Emitter *e, ast::Span _) {
    for (Usize i = 0; i < e->defer_count; i++)
        state::push_statement(e, e->defers[i].body);
    return state::success();
}
