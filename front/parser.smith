// front::parser, the whole parser of smith's own front end (#1112, A6 of track A; internal, not wired into `smith cc`).
//
//   parser::parse(file, source)       a file's text as a `Parsed`: the `ast::Module` and the errors found
//   parser::parse_new(file, source)   the same for a file in smith's own syntax (lex::tokenize_new, Parser.new_syntax)
//
// It tokenizes (front::lex), makes a `parse::Parser`, installs the four real hooks (expressions and types from A3,
// statements from A4, declarations from A5) and reads the file with `parse_decl::file`. It never aborts: a lexer error
// comes back as the one error with an empty module, and parse errors come back in the order they were found. The tree
// and the errors are the current allocator's, so a caller that sets an arena frees both at once.
//
// The hooks reach each other only through `parse::Parser.hooks`, so nesting (a lambda body, a declaration in a
// statement, an expression in a type) goes through function values, never through a call of one module's function by
// another's: no module here recurses by name.
module front::parser;

import front::ast;
import front::fix_directive;
import front::lex;
import front::parse;
import front::parse_decl;
import front::parse_expr;
import front::parse_stmt;
import front::parse_type;
import std::mem;

// What reading a file gave: the module (the declarations read before and after each error), the errors and the warnings
// (old forms that still compile; the compile ignores them, `smith lint --fix` mends them).
export struct Parsed {
    ast::Module module;
    parse::Errors errors;
    parse::Errors warnings;
};

// The fix of a `//` comment: `#` in its place, with a space after it when the comment has none. (A `/*` has no fix.)
static parse::Edits slash_comment_edits(Str source, ast::Span at) {
    parse::Edits none = {};
    if (source[at.start + 1] != '/') return none;
    Bool spaced = at.end >= countof(source) || source[at.end] == ' ' || source[at.end] == '\n';
    Str text = spaced ? "#" : "# ";
    parse::Edit change = {.span = at, .text = text};
    parse::Edits edits = {};
    edits = mem::realloc(edits, 1);
    edits[0] = change;
    return edits;
}

// The fix of a lexer error: a `#` that starts a simple `#define` or `#include` line carries the edits of all such lines
// (front::fix_directive, #1748); any other lexer error has none.
static parse::Edits lex_fix(Str source, lex::LexError failure) {
    parse::Edits none = {};
    if (failure.span.start >= countof(source)) return none;
    if (source[failure.span.start] == '/') return slash_comment_edits(source, failure.span);
    if (source[failure.span.start] != '#') return none;
    return fix_directive::edits(source);
}

// Reads the text of the file called `file`. A file with errors still has the module of what could be read.
export Parsed parse(Str file, Str source) {
    Parsed result = {};
    result.module.file = file;
    lex::Lexed lexed = lex::tokenize(source);
    if (lexed == .error) {
        lex::LexError failure = lexed.error;
        parse::ParseError first = {.span = failure.span, .message = failure.message};
        first.fix = lex_fix(source, failure);
        result.errors = mem::realloc(result.errors, 1);
        result.errors[0] = first;
        return result;
    }
    parse::Parser p = parse::make(lexed.ok, source);
    p.hooks.expression = parse_expr::expression;
    p.hooks.type = parse_type::type;
    p.hooks.statement = parse_stmt::statement;
    p.hooks.declaration = parse_decl::declaration;
    result.module = parse_decl::file(&p, file);
    result.errors = p.errors;
    result.warnings = p.warnings;
    return result;
}

// Which path a file takes, decided here and nowhere else (#1856; #1859 deletes it with the brace path): the layout
// path, with `newline`, `indent` and `dedent` from lex::layout, when the file has an indented block (a file with none
// has no
// `:` block to read, and the layout tokens would only add `newline`s to the declaration parser, #1857, before it reads
// them); the brace path, today's tokens, otherwise. Gives true, and the tokens with layout in `laid`, for the layout
// path.
static Bool takes_layout(Str source, lex::Tokens tokens, lex::Tokens *laid) {
    lex::Lexed made = lex::layout(source, tokens);
    if (made == .error) return false;
    Bool indents = false;
    for (lex::Token token : made.ok) {
        if (token.kind == lex::indent) indents = true;
    }
    if (!indents) {
        mem::free(made.ok.data);
        return false;
    }
    *laid = made.ok;
    return true;
}

// Reads the text of the file called `file` in smith's own syntax (#1578): what `parse` does with `lex::tokenize_new`
// and `Parser.new_syntax` set. The errors and the warnings come back as for `parse`.
export Parsed parse_new(Str file, Str source) {
    Parsed result = {};
    result.module.file = file;
    lex::Lexed lexed = lex::tokenize_new(source);
    if (lexed == .error) {
        lex::LexError failure = lexed.error;
        parse::ParseError first = {.span = failure.span, .message = failure.message};
        first.fix = lex_fix(source, failure);
        result.errors = mem::realloc(result.errors, 1);
        result.errors[0] = first;
        return result;
    }
    lex::Tokens tokens = lexed.ok;
    lex::Lexed made = lex::layout(source, tokens);
    if (made == .error) {
        lex::LexError failure = made.error;
        parse::ParseError first = {.span = failure.span, .message = failure.message};
        result.errors = mem::realloc(result.errors, 1);
        result.errors[0] = first;
        return result;
    }
    mem::free(made.ok.data);
    Bool layout = takes_layout(source, lexed.ok, &tokens);
    parse::Parser p = parse::make(tokens, source);
    p.new_syntax = true;
    p.layout = layout;
    p.hooks.expression = parse_expr::expression;
    p.hooks.type = parse_type::type;
    p.hooks.statement = parse_stmt::statement;
    p.hooks.declaration = parse_decl::declaration;
    result.module = parse_decl::file(&p, file);
    result.errors = p.errors;
    result.warnings = p.warnings;
    return result;
}
