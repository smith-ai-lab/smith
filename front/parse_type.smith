// front::parse_type, the types of smith's own front end (#1145, A3 of track A of #1112; internal, not wired into
// `smith cc`).
//
// `parse_type::type(p)` reads a type at the parser's position into `ast::TypeExpr` and is installed as the hook
// `parse::Hooks.type`. It is the type of a cast, of `sizeof`, of `typeof`, of an argument of a type function, and the
// type part of a declaration (A5 calls it, then reads the name and the array suffix that follows it).
//
//   base      qualifiers `const volatile restrict`; a name or a path (`I32`, `geometry::Box`, `c::FILE`); `auto`;
//             C's keyword types, as one named type spelled as written (`unsigned long`); `struct X`, `union X`,
//             `enum X`; `typeof(e)` or `typeof(T)`
//   suffixes  `*` (a pointer; qualifiers after it belong to the pointer), `[:]` (a slice), `[N]` (an array)
//   applied   `Option(T)`, `Result(T, E)`, `Fn(F)`, `Lambda(F)`, a user's type function with type or value arguments
//   function  `R (P1, P2)`, `R (P1, ...)` and `R ()`: only as the argument of `Fn(...)`, where a name followed by a
//             parenthesis group is the result of a function type (`Fn(Bool (I32, I32))`), unless a second group
//             follows it, which makes the name an applied type (`Fn(Option(I32) (I32))`)
//
// Smith's own syntax (S2, #1443, part of #1428) is read beside those, by `new_type`, when a type starts with a token
// that no C type starts with: `*T` and `*mut T` (a pointer), `?T` (an option), `[5]T` `[_]T` `[]T` (an array, a slice),
// `[5,3]T` `[,3]T` `[,]T` (a contiguous block: one size per dimension, a null size when empty), `(A, B)` `(T,)` `()` (a
// tuple), `fn(A) -> R` and `fn_once(A) -> R` (a function; no `->` means no result). The lowercase built-ins are names
// (`i32`, `str`) or keywords (`void`, `bool`, `char`) and parse as `named`; `type` is the keyword `kw_type`. A new type
// has no suffixes: `*T` takes the whole type after it. `starts_new_type` tells a caller where a new type starts.
//
// No symbol table: a name's case says what it is, and after `c::` the position in the grammar decides. A path is a type
// when its last segment is a `type_name` token (`I32`, `geometry::Box`), but never a path that starts with `c` in
// `starts_type` (a parenthesized `(c::name)` is a value, #1112); `c_path_is_type` is the one place that says so. C's
// function-pointer declarator `I32 (*f)(I32)` is an error that names `Fn(I32 (I32))`. A pointer to a slice is written
// `I32[:] *p`; C's `I32 (*p)[:]` is left for the declaration to report (A7i, #1344).
//
// There is no recursion: the suffixes are a loop, and a nested type (an argument, a parameter of a function type) or
// expression (a count, `typeof`) is read through the hooks of the parser, `parse::type` and `parse::expression`, which
// the wiring points back at these modules (A6 makes that chain iterative).
module front::parse_type;

import front::ast;
import front::lex;
import front::parse;
import std::arena;
import std::format;
import std::mem;
import std::text;

// Whether a token is a qualifier.
static Bool is_qualifier(lex::TokenKind kind) {
    return kind == lex::kw_const || kind == lex::kw_volatile || kind == lex::kw_restrict;
}

// Whether a token is one of C's keyword types (`int`, `unsigned`, `char`, `void`...).
export Bool is_keyword_type(lex::TokenKind kind) {
    switch (kind) {
    case lex::kw_int:
    case lex::kw_char:
    case lex::kw_short:
    case lex::kw_long:
    case lex::kw_signed:
    case lex::kw_unsigned:
    case lex::kw_float:
    case lex::kw_double:
    case lex::kw_bool:
    case lex::kw_void:
        return true;
    default:
        return false;
    }
}

// What `path_last` gives when no path starts there.
constexpr Usize no_path = 1000000000;

// Whether a token is a segment of a path.
static Bool is_segment(lex::TokenKind kind) {
    return kind == lex::name || kind == lex::type_name;
}

// Whether the token `offset` ahead continues a path: `::` (the old separator, which warns) or `.` before a type name
// (`build.Build`; a `.` before a lowercase name is a member access and ends the path).
static Bool at_separator(const parse::Parser *p, Usize offset, lex::TokenKind before) {
    lex::TokenKind kind = parse::peek_at(p, offset).kind;
    if (kind == lex::colon_colon) return true;
    // Only after a lowercase name: `Color.Red` stays a member of a type.
    return kind == lex::dot && p->new_syntax && before == lex::name &&
           parse::peek_at(p, offset + 1).kind == lex::type_name;
}

// The offset of the last segment of the path that starts `offset` tokens ahead, or the largest Usize when no path
// starts there.
static Usize path_last(const parse::Parser *p, Usize offset) {
    if (!is_segment(parse::peek_at(p, offset).kind)) return no_path;
    Usize last = offset;
    while (at_separator(p, last + 1, parse::peek_at(p, last).kind) && is_segment(parse::peek_at(p, last + 2).kind)) {
        last += 2;
    }
    return last;
}

// The one decision about `c::`: whether a path that starts with `c` is a type where a type or a value may stand. After
// `c::` case means nothing and the position decides, and in a cast or a type argument a `c::` path is a value
// (`(c::name)` is a parenthesized value, never a cast), so no: a place that wants `c::size_t` as a type calls
// `parse_type::type` itself.
static Bool c_path_is_type() {
    return false;
}

// Whether a parenthesis group starts `at` tokens ahead and a name (or a type's name, in a `typedef`) follows its
// closing parenthesis: `(T) keep`.
static Bool group_then_name(const parse::Parser *p, Usize at) {
    if (parse::peek_at(p, at).kind != lex::left_paren) return false;
    Usize depth = 0;
    for (Usize i = 0; i < countof(p->tokens); i += 1) {
        lex::TokenKind kind = parse::peek_at(p, at).kind;
        if (kind == lex::end_of_file) return false;
        if (kind == lex::left_paren) depth += 1;
        if (kind == lex::right_paren) depth -= 1;
        at += 1;
        if (depth == 0) break;
    }
    // In smith's own syntax a line break after the `)` ends the statement: `f(x)` and a `f(x)` on the next line are two
    // calls, not a type and a name (#1554).
    if (p->new_syntax && lex::ends_statement(parse::peek_at(p, at - 1))) return false;
    return is_segment(parse::peek_at(p, at).kind);
}

// Whether the path `offset` tokens ahead is a call of a type function that is a type: `maybe(I32) m`,
// `opt::maybe(Usize) x`. A call followed by a name is no expression and no declaration otherwise (#1358).
export Bool call_type_ahead(const parse::Parser *p, Usize offset) {
    Usize last = path_last(p, offset);
    if (last == no_path || parse::peek_at(p, last).kind != lex::name) return false;
    if (last != offset && text::is(parse::text(p, parse::peek_at(p, offset)), "c")) return false;
    return group_then_name(p, last + 1);
}

// Whether the path `offset` tokens ahead is a type: its last segment is a `type_name`, and it does not start with
// `c::`.
export Bool path_is_type(const parse::Parser *p, Usize offset) {
    Usize last = path_last(p, offset);
    if (last == no_path) return false;
    if (parse::peek_at(p, last).kind != lex::type_name) return false;
    if (last == offset) return true;
    Str first = parse::text(p, parse::peek_at(p, offset));
    return !text::is(first, "c") || c_path_is_type();
}

// Whether the `Lambda(` of a lambda parameter's type is `offset` tokens ahead. `lambda` is a name, not a
// keyword, so the case rule does not make it a type; only the parenthesis after it does (`Lambda(I32 (I32)) f`).
static Bool is_lambda_type(const parse::Parser *p, Usize offset) {
    lex::Token token = parse::peek_at(p, offset);
    if (token.kind != lex::name || parse::peek_at(p, offset + 1).kind != lex::left_paren) return false;
    return text::is(parse::text(p, token), "Lambda");
}

// Whether a type starts `offset` tokens ahead: a qualifier, a keyword type, `auto`, `struct`, `union`, `enum`,
// `typeof`, a `type_name` or a path that ends in one.
export Bool starts_type(const parse::Parser *p, Usize offset) {
    lex::TokenKind kind = parse::peek_at(p, offset).kind;
    if (is_lambda_type(p, offset)) return true;
    if (is_qualifier(kind) || is_keyword_type(kind)) return true;
    switch (kind) {
    case lex::kw_auto:
    case lex::kw_struct:
    case lex::kw_union:
    case lex::kw_enum:
    case lex::kw_typeof:
    case lex::kw_typeof_unqual:
        return true;
    default:
        return path_is_type(p, offset) || call_type_ahead(p, offset);
    }
}

// Whether `fn` or `fn_once` starts a function type `offset` tokens ahead. Today's lexer reads them as names, so while
// fixing (`smith lint --fix` reads a text again after each pass) a name followed by `(` counts too, and a type that a
// pass has already written is read.
static Bool fn_word(const parse::Parser *p, Usize offset) {
    lex::Token token = parse::peek_at(p, offset);
    if (token.kind == lex::kw_fn || token.kind == lex::kw_fn_once) return true;
    if (token.kind != lex::name || parse::peek_at(p, offset + 1).kind != lex::left_paren) return false;
    return text::is(parse::text(p, token), "fn") || text::is(parse::text(p, token), "fn_once");
}

// Whether the tokens from `offset` start a type of the new syntax that no expression starts: `*`, `?`, `fn`, `fn_once`,
// `type`, or a bracket group followed directly by a type (`[5]T`, `[]T`, `[,3]T`). A parenthesis is never judged here:
// `(A, B)` is a tuple type where a type is expected, and a parenthesized value where it is not.
export Bool starts_new_type(const parse::Parser *p, Usize offset) {
    lex::TokenKind kind = parse::peek_at(p, offset).kind;
    if (kind == lex::star || kind == lex::question || fn_word(p, offset)) return true;
    if (kind != lex::left_bracket) return false;
    Usize depth = 0;
    Usize at = offset;
    for (Usize i = 0; i < countof(p->tokens); i += 1) {
        lex::TokenKind inside = parse::peek_at(p, at).kind;
        if (inside == lex::end_of_file) return false;
        if (inside == lex::left_bracket || inside == lex::left_paren) depth += 1;
        if (inside == lex::right_bracket || inside == lex::right_paren) depth -= 1;
        at += 1;
        if (depth == 0) break;
    }
    lex::TokenKind after = parse::peek_at(p, at).kind;
    return after == lex::star || after == lex::question || after == lex::left_bracket || after == lex::left_paren ||
           after == lex::kw_fn || after == lex::kw_fn_once || after == lex::kw_type || after == lex::type_name ||
           after == lex::name || is_keyword_type(after);
}

static ast::Path read_path(parse::Parser *p, Bool in_type);

// Reads a path: `x`, `ascii::digit`, `c::printf`. The caller has checked that one starts here.
export ast::Path path(parse::Parser *p) {
    return read_path(p, false);
}

// Reads the path of a type. After a lowercase name a `.` may also be followed by a lowercase name, since a type has no
// member access: `stdio.size_t`, `stdlib.div_t` (a C type under a header binding, #1678).
static ast::Path type_path(parse::Parser *p) {
    return read_path(p, true);
}

static ast::Path read_path(parse::Parser *p, Bool in_type) {
    ast::Identifier segments[:] = {};
    ast::Path result = {.segments = segments};
    lex::Token first = parse::peek(p);
    for (Usize i = 0; i < countof(p->tokens); i += 1) {
        lex::Token token = parse::advance(p);
        result.segments = mem::realloc(result.segments, countof(result.segments) + 1);
        ast::Identifier segment = {.text = parse::text(p, token), .span = token.span};
        result.segments[countof(result.segments) - 1] = segment;
        Bool more = at_separator(p, 0, token.kind) && is_segment(parse::peek_at(p, 1).kind);
        if (in_type && p->new_syntax && token.kind == lex::name && parse::peek_at(p, 0).kind == lex::dot &&
            parse::peek_at(p, 1).kind == lex::name && parse::peek_at(p, 2).kind != lex::left_paren) {
            more = true;
        }
        if (!more) break;
        lex::Token separator = parse::advance(p);
        if (separator.kind == lex::colon_colon) parse::warn_separator(p, separator);
    }
    result.span = parse::span_from(p, first.span.start);
    return result;
}

// A list of expressions with one more at the end, and a list of types likewise: a new block of the current allocator
// (the old one stays with it). `mem::realloc` would do, but clang-tidy reports its use on a slice of pointers.
export typedef typeof(ast::ExprRef[:]) ExprList;
export typedef typeof(ast::TypeRef[:]) TypeList;

export ExprList with_expr(ast::ExprRef list[:], ast::Expr *e) {
    Usize count = countof(list) + 1;
    ast::ExprRef *data = (ast::ExprRef *)mem::alloc_array_raw(sizeof(ast::ExprRef), count, alignof(ast::ExprRef));
    ExprList grown = data[0:count];
    for (Usize i = 0; i < countof(list); i += 1) {
        grown[i] = list[i];
    }
    grown[countof(list)] = e;
    return grown;
}

export TypeList with_type(ast::TypeRef list[:], ast::TypeExpr *t) {
    Usize count = countof(list) + 1;
    ast::TypeRef *data = (ast::TypeRef *)mem::alloc_array_raw(sizeof(ast::TypeRef), count, alignof(ast::TypeRef));
    TypeList grown = data[0:count];
    for (Usize i = 0; i < countof(list); i += 1) {
        grown[i] = list[i];
    }
    grown[countof(list)] = t;
    return grown;
}

export typedef ast::Identifier NameList[:];

export NameList with_name(ast::Identifier list[:], ast::Identifier name) {
    Usize count = countof(list) + 1;
    NameList grown = mem::alloc_slice(ast::Identifier, count);
    for (Usize i = 0; i < countof(list); i += 1) {
        grown[i] = list[i];
    }
    grown[countof(list)] = name;
    return grown;
}

// A type node from its parts.
static ast::TypeExpr *node(U32 start, const parse::Parser *p, ast::Qualifiers qualifiers, ast::TypeKind kind) {
    ast::TypeExpr value = {.span = parse::span_from(p, start), .qualifiers = qualifiers, .kind = kind};
    return ast::new_type(value);
}

// Takes the qualifiers at the position into `q`.
static void take_qualifiers(parse::Parser *p, ast::Qualifiers *q) {
    while (is_qualifier(parse::peek(p).kind)) {
        lex::Token token = parse::advance(p);
        if (token.kind == lex::kw_const) q->is_const = true;
        if (token.kind == lex::kw_volatile) q->is_volatile = true;
        if (token.kind == lex::kw_restrict) q->is_restrict = true;
    }
}

// A named type whose one segment is the source text from `start` to the end of the last token taken.
static ast::TypeExpr *spelled(parse::Parser *p, U32 start, ast::Qualifiers q) {
    ast::Span span = parse::span_from(p, start);
    ast::Identifier owned[:] = {};
    owned = mem::realloc(owned, 1);
    ast::Identifier segment = {.text = p->source[span.start:span.end], .span = span};
    owned[0] = segment;
    ast::Path name = {.segments = owned, .span = span};
    return node(start, p, q, {.named = {.path = name}});
}

// Whether the operand of `typeof` is a reflected member of a path, `T.[f]` or `T->[f]`: the path is read as a value.
static Bool is_reflected(const parse::Parser *p) {
    Usize last = path_last(p, 0);
    if (last == no_path) return false;
    lex::TokenKind next = parse::peek_at(p, last + 1).kind;
    if (next != lex::dot && next != lex::arrow) return false;
    return parse::peek_at(p, last + 2).kind == lex::left_bracket;
}

// Whether the operand of `typeof` starts a type of the new syntax. A `*` is also a dereference (`typeof(*p)`,
// `typeof(*(t)nullptr)`), so it counts only when the stars end at a word that names a type or at a type of its own.
static Bool typeof_new_type(const parse::Parser *p) {
    Usize at = 0;
    for (Usize i = 0; i < countof(p->tokens); i += 1) {
        if (parse::peek_at(p, at).kind != lex::star) break;
        at += 1;
    }
    if (at == 0) return starts_new_type(p, 0);
    lex::TokenKind after = parse::peek_at(p, at).kind;
    return after == lex::type_name || after == lex::kw_type || is_keyword_type(after) || starts_new_type(p, at);
}

// `typeof(e)` or `typeof(T)`: the position is at the keyword.
static ast::TypeExpr *type_of(parse::Parser *p, U32 start, ast::Qualifiers q) {
    parse::advance(p);
    parse::expect(p, lex::left_paren, "`(` after `typeof`");
    ast::Expr *operand = nullptr;
    if ((starts_type(p, 0) || typeof_new_type(p)) && !is_reflected(p)) {
        ast::TypeExpr *inner = parse::type(p);
        operand = ast::expr({.type_value = {.type = inner}});
    } else {
        operand = parse::expression(p);
    }
    parse::expect(p, lex::right_paren, "`)` to end `typeof`");
    return node(start, p, q, {.type_of = {.operand = operand}});
}

// Whether `struct { ... }` at the position is a tuple: the first thing at the braces' own depth that ends an element is
// a `,` or the `}` (a record's field ends with `;`). An empty `struct {}` is a record. A scan of the tokens, no
// speculative parse.
export Bool tuple_ahead(const parse::Parser *p) {
    if (parse::peek(p).kind != lex::kw_struct || parse::peek_at(p, 1).kind != lex::left_brace) return false;
    if (parse::peek_at(p, 2).kind == lex::right_brace) return false;
    Usize depth = 0;
    for (Usize offset = 2; offset < countof(p->tokens) + 2; offset++) {
        lex::TokenKind kind = parse::peek_at(p, offset).kind;
        if (kind == lex::end_of_file || (kind == lex::semicolon && depth == 0)) return false;
        if (kind == lex::left_paren || kind == lex::left_bracket || kind == lex::left_brace) depth += 1;
        if ((kind == lex::right_paren || kind == lex::right_bracket) && depth > 0) depth -= 1;
        if (kind == lex::right_brace) {
            if (depth == 0) return true;
            depth -= 1;
        }
        if (kind == lex::comma && depth == 0) return true;
    }
    return false;
}

// `struct { I32, F32 }`: types with no names. A name after a type is an error that names both forms.
static ast::TypeExpr *tuple(parse::Parser *p, U32 start, ast::Qualifiers q) {
    parse::advance(p);
    parse::advance(p);
    ast::TypeRef elements[:] = {};
    while (!parse::at(p, lex::right_brace) && !parse::at(p, lex::end_of_file)) {
        ast::TypeExpr *element = parse::type(p);
        if (element == nullptr) break;
        elements = mem::realloc(elements, countof(elements) + 1);
        elements[countof(elements) - 1] = element;
        if (parse::at(p, lex::name)) {
            Str message =
                "a tuple has types only: `struct { I32, F32 }`; a name makes a record field, `struct { I32 a; }`";
            parse::error(p, parse::peek(p).span, message);
            break;
        }
        if (!parse::accept(p, lex::comma)) break;
    }
    parse::expect(p, lex::right_brace, "`}` to end the tuple");
    return node(start, p, q, {.tuple = {.elements = elements}});
}

// The base of a type without an applied form: `auto`, `struct X`, a keyword type, `typeof`, a path. Null after an
// error.
static ast::TypeExpr *plain(parse::Parser *p, U32 start, ast::Qualifiers q) {
    lex::Token token = parse::peek(p);
    switch (token.kind) {
    case lex::kw_auto:
        parse::advance(p);
        return node(start, p, q, .auto_type);
    case lex::kw_struct:
    case lex::kw_union:
    case lex::kw_enum:
        if (tuple_ahead(p)) return tuple(p, start, q);
        parse::advance(p);
        if (!parse::accept(p, lex::name) && !parse::accept(p, lex::type_name)) {
            parse::error(p, parse::peek(p).span, "expected a tag name after `struct`, `union` or `enum`");
        }
        return spelled(p, token.span.start, q);
    case lex::kw_typeof:
    case lex::kw_typeof_unqual:
        return type_of(p, start, q);
    default:
        break;
    }
    if (is_keyword_type(token.kind)) {
        while (is_keyword_type(parse::peek(p).kind))
            parse::advance(p);
        return spelled(p, token.span.start, q);
    }
    if (is_segment(token.kind)) {
        ast::Path named = type_path(p);
        return node(start, p, q, {.named = {.path = named}});
    }
    if (token.kind == lex::end_of_file) {
        parse::error(p, token.span, "expected a type, found the end of the file");
    } else {
        char message[:] = format::push("expected a type, found `", parse::text(p, token), "`");
        parse::error(p, token.span, message);
    }
    return nullptr;
}

// The error of a function-pointer declarator, and recovery past it: the two parenthesis groups of `I32 (*f)(I32)`. The
// fix rewrites the type and both groups, from `start`, to `Fn(I32 (I32)) f` (the name is left out when there is none).
static void function_pointer(parse::Parser *p, U32 start) {
    Str message = "C's function-pointer declarator is not Smith: write the function value as `Fn(I32 (I32))`, a result "
                  "type and the parameter types in parentheses, inside `Fn(...)`";
    U32 open = parse::peek(p).span.start;
    U32 open_end = parse::peek(p).span.end;
    Str name = "";
    Str params = "";
    U32 end = open;
    for (Usize group = 0; group < 2 && parse::at(p, lex::left_paren); group += 1) {
        U32 inner = parse::peek(p).span.end;
        U32 close = inner;
        Usize depth = 0;
        for (Usize i = 0; i < countof(p->tokens); i += 1) {
            lex::Token token = parse::peek(p);
            if (token.kind == lex::end_of_file) {
                parse::error(p, parse::peek(p).span, message);
                return;
            }
            if (token.kind == lex::left_paren) depth += 1;
            if (token.kind == lex::right_paren) depth -= 1;
            if (group == 0 && depth == 1 && (token.kind == lex::name || token.kind == lex::type_name))
                name = parse::text(p, token);
            close = token.span.start;
            end = token.span.end;
            parse::advance(p);
            if (depth == 0) break;
        }
        if (group == 1) params = p->source[inner:close];
    }
    Str type = p->source[start:open];
    while (countof(type) > 0 && type[countof(type) - 1] == ' ') {
        type = type[0:countof(type) - 1];
    }
    Str space = " ";
    Str none = "";
    Str gap = countof(name) > 0 ? space : none;
    parse::Edits edits = mem::alloc_slice(parse::Edit, 1);
    ast::Span span = {.start = start, .end = end};
    char built[:] = format::push("Fn(", type, " (", params, "))", gap, name);
    Str text = built;
    parse::Edit edit = {.span = span, .text = text};
    edits[0] = edit;
    ast::Span at = {.start = open, .end = open_end};
    parse::error_fix(p, at, message, edits);
}

// One bracket suffix: `[:]`, `[const restrict :]` or `[N]`.
struct Bracket {
    Bool is_slice;
    ast::Qualifiers qualifiers;
    ast::Expr *count;
};

// Where the qualifiers of a slice bracket end: `[` is at the position, and `[:]`, `[const :]` and `[const restrict :]`
// answer the offset of the `:`; any other bracket answers `no_path`.
static Usize slice_colon(const parse::Parser *p) {
    if (!parse::at(p, lex::left_bracket)) return no_path;
    Usize at = 1;
    while (is_qualifier(parse::peek_at(p, at).kind)) {
        at += 1;
    }
    if (parse::peek_at(p, at).kind != lex::colon || parse::peek_at(p, at + 1).kind != lex::right_bracket)
        return no_path;
    return at;
}

// Whether a slice bracket is at the position: `[:]`, or with the slice's own qualifiers `[const :]`, `[restrict :]`,
// `[const restrict :]` (after C99's `int a[const 10]`). A declaration reads the brackets after a name with this and
// `take_slice`.
export Bool at_slice(const parse::Parser *p) {
    return slice_colon(p) != no_path;
}

// Whether `[static :]` or `[volatile :]` is at the position: a slice has no meaning for them.
export Bool at_bad_slice_qualifier(const parse::Parser *p) {
    if (!parse::at(p, lex::left_bracket)) return false;
    lex::TokenKind first = parse::peek_at(p, 1).kind;
    if (first != lex::kw_static && first != lex::kw_volatile) return false;
    return parse::peek_at(p, 2).kind == lex::colon && parse::peek_at(p, 3).kind == lex::right_bracket;
}

// Reads the slice bracket at the position (`at_slice` is true) and gives the slice's own qualifiers in `q`.
export void take_slice(parse::Parser *p, ast::Qualifiers *q) {
    parse::advance(p);
    take_qualifiers(p, q);
    parse::advance(p);
    parse::advance(p);
}

// The error of `[static :]` and `[volatile :]`, and the recovery past the bracket.
export void bad_slice_qualifier(parse::Parser *p) {
    lex::Token token = parse::peek_at(p, 1);
    char message[:] = format::push("`", parse::text(p, token),
                                   "` has no meaning for a slice: write `const` or `restrict` in the bracket, and "
                                   "`volatile` on the element (`volatile U8 xs[:]`)");
    parse::error(p, token.span, message);
    for (Usize i = 0; i < 4; i += 1) {
        parse::advance(p);
    }
}

// A run of bracket suffixes, `T[:][3]`, and the type they make. As in C and in the AST (`T[:][2]` is a slice of
// arrays), the first bracket is the outermost: `[:][3]` is a slice of arrays of 3. Only the first carries the slice's
// qualifiers (`T[restrict :]`); they are the `qualifiers` of the slice node, as a pointer's are.
static ast::TypeExpr *brackets(parse::Parser *p, U32 start, ast::TypeExpr *element) {
    Bracket run[:] = {};
    while (at_slice(p) || at_bad_slice_qualifier(p) || parse::at(p, lex::left_bracket)) {
        Bracket bracket = {};
        U32 open = parse::peek(p).span.start;
        U32 open_end = parse::peek(p).span.end;
        if (at_bad_slice_qualifier(p)) {
            bad_slice_qualifier(p);
            bracket.is_slice = true;
        } else if (at_slice(p)) {
            take_slice(p, &bracket.qualifiers);
            bracket.is_slice = true;
            Bool carries = bracket.qualifiers.is_const || bracket.qualifiers.is_restrict;
            if (carries && countof(run) > 0) {
                Str message = "a qualifier of a slice goes in the first bracket: the rows of `F32 m[:][:]` are views "
                              "with no pointer of their own, so write `F32 m[const :][:]`";
                parse::error(p, parse::span_from(p, open), message);
            }
        } else {
            parse::advance(p);
            bracket.count = parse::expression(p);
            parse::expect(p, lex::right_bracket, "`]` to end the array size");
        }
        run = mem::realloc(run, countof(run) + 1);
        run[countof(run) - 1] = bracket;
    }
    ast::TypeExpr *result = element;
    for (Usize i = countof(run); i > 0; i -= 1) {
        ast::Span span = parse::span_from(p, start);
        ast::TypeKind slice_kind = {.slice = {.element = result}};
        ast::TypeKind array_kind = {.array = {.element = result, .count = run[i - 1].count}};
        ast::TypeKind kind = run[i - 1].is_slice ? slice_kind : array_kind;
        ast::TypeExpr value = {.span = span, .qualifiers = run[i - 1].qualifiers, .kind = kind};
        result = ast::new_type(value);
    }
    return result;
}

// Whether the token at `i` is a `[` that opens a slice bracket (`[:]`, `[const :]`, `[restrict :]`).
export Bool slice_bracket_at(const parse::Parser *p, Usize i) {
    if (parse::peek_at(p, i).kind != lex::left_bracket) return false;
    lex::TokenKind inside = parse::peek_at(p, i + 1).kind;
    return inside == lex::colon || inside == lex::kw_const || inside == lex::kw_restrict;
}

// Whether the position, at the `(` after a type, starts C's pointer-to-slice or pointer-to-array declarator `(*p)[:]`
// or `(*p)[4]` (or `(**pp)[:]`, `(*)[4]`): stars, an optional name, `)`, then a bracket. A function pointer's `)` is
// followed by `(`.
export Bool at_slice_pointer_declarator(const parse::Parser *p) {
    if (!parse::at(p, lex::left_paren)) return false;
    Usize i = 1;
    while (parse::peek_at(p, i).kind == lex::star)
        i += 1;
    if (i == 1) return false;
    lex::TokenKind named = parse::peek_at(p, i).kind;
    if (named == lex::name || named == lex::type_name) i += 1;
    if (parse::peek_at(p, i).kind != lex::right_paren) return false;
    return parse::peek_at(p, i + 1).kind == lex::left_bracket;
}

static Bool c_declarator_ahead(const parse::Parser *p);

// The suffixes of a type: pointers (with the qualifiers after each) and runs of brackets.
static ast::TypeExpr *suffixes(parse::Parser *p, U32 start, ast::TypeExpr *base) {
    ast::TypeExpr *type_so_far = base;
    take_qualifiers(p, &type_so_far->qualifiers);
    for (Usize i = 0; i < countof(p->tokens); i += 1) {
        if (parse::accept(p, lex::star)) {
            ast::Qualifiers q = {};
            take_qualifiers(p, &q);
            type_so_far = node(start, p, q, {.pointer = {.pointee = type_so_far}});
        } else if (parse::at(p, lex::left_bracket)) {
            type_so_far = brackets(p, start, type_so_far);
        } else if (c_declarator_ahead(p)) {
            // C's `(*p)[:]` and `(*p)[4]` are left for the declaration to report, with the name it knows.
            if (!at_slice_pointer_declarator(p)) function_pointer(p, start);
            break;
        } else {
            break;
        }
    }
    return type_so_far;
}

// The parameters of a function type, the opening parenthesis already taken: `)` ends them.
static ast::TypeKind function_rest(parse::Parser *p, ast::TypeExpr *result) {
    ast::TypeRef params[:] = {};
    Bool variadic = false;
    while (!parse::at(p, lex::right_paren) && !parse::at(p, lex::end_of_file)) {
        if (parse::accept(p, lex::ellipsis)) {
            variadic = true;
            break;
        }
        ast::TypeExpr *param = parse::type(p);
        params = with_type(params, param);
        // A parameter's name (`Fn(void (Key key))`) is left out of the type: the fix writes only the types.
        if (param != nullptr && parse::at(p, lex::name)) parse::advance(p);
        if (!parse::accept(p, lex::comma)) break;
    }
    parse::expect(p, lex::right_paren, "`)` to end the parameters of the function type");
    ast::TypeKind kind = {.function = {.params = params, .result = result, .variadic = variadic}};
    return kind;
}

// Whether the name at the position, followed by a parenthesis group, is an applied type that is the result of a
// function type (`Option(I32) (I32)`): another group follows it. `Bool (I32, I32)` has one group, and is the function
// type itself.
static Bool applied_result(const parse::Parser *p) {
    Usize last = path_last(p, 0);
    if (last == no_path || parse::peek_at(p, last + 1).kind != lex::left_paren) return false;
    Usize depth = 0;
    Usize at = last + 1;
    for (Usize i = 0; i < countof(p->tokens); i += 1) {
        lex::TokenKind kind = parse::peek_at(p, at).kind;
        if (kind == lex::end_of_file) return false;
        if (kind == lex::left_paren) depth += 1;
        if (kind == lex::right_paren) depth -= 1;
        at += 1;
        if (depth == 0) break;
    }
    return parse::peek_at(p, at).kind == lex::left_paren;
}

// The argument of `Fn(...)`: a function type `R (P1, P2)` when a parenthesis group follows the result.
static ast::TypeExpr *function_argument(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    ast::TypeExpr *result = nullptr;
    if (applied_result(p)) {
        result = parse::type(p);
    } else {
        ast::Qualifiers q = {};
        take_qualifiers(p, &q);
        ast::TypeExpr *base = plain(p, start, q);
        result = base == nullptr ? nullptr : suffixes(p, start, base);
    }
    if (result == nullptr || !parse::at(p, lex::left_paren)) return result;
    parse::advance(p);
    ast::TypeKind kind = function_rest(p, result);
    ast::Qualifiers plain_q = {};
    return node(start, p, plain_q, kind);
}

// Whether a name is one of the lowercase built-in types of the new syntax (`i32`, `usize`, `str`...): a fixed list, so
// no symbol table. Where a type or a value may stand, as an argument of a type function, such a name is a type.
static Bool is_builtin_name(Str word) {
    return text::is(word, "i8") || text::is(word, "i16") || text::is(word, "i32") || text::is(word, "i64") ||
           text::is(word, "isize") || text::is(word, "u8") || text::is(word, "u16") || text::is(word, "u32") ||
           text::is(word, "u64") || text::is(word, "usize") || text::is(word, "f32") || text::is(word, "f64") ||
           text::is(word, "str");
}

// One argument of a type function: a type, or a value when no type starts there.
static ast::TypeArg argument(parse::Parser *p, Bool is_function) {
    if (is_function) {
        ast::TypeArg arg = {.type = {.type = function_argument(p)}};
        return arg;
    }
    Bool builtin =
        parse::at(p, lex::name) && is_builtin_name(parse::text(p, parse::peek(p))) && !parse::at(p, lex::colon_colon);
    if (starts_type(p, 0) || starts_new_type(p, 0) || builtin) {
        ast::TypeArg arg = {.type = {.type = parse::type(p)}};
        return arg;
    }
    ast::TypeArg arg = {.value = {.value = parse::expression(p)}};
    return arg;
}

// `Name(A, B)`: the path was read, and `(` is at the position.
static ast::TypeExpr *applied(parse::Parser *p, U32 start, ast::Qualifiers q, ast::Path name) {
    parse::advance(p);
    Bool is_function = countof(name.segments) == 1 &&
                       (text::is(name.segments[0].text, "Fn") || text::is(name.segments[0].text, "Lambda"));
    ast::TypeArg args[:] = {};
    while (!parse::at(p, lex::right_paren) && !parse::at(p, lex::end_of_file)) {
        args = mem::realloc(args, countof(args) + 1);
        args[countof(args) - 1] = argument(p, is_function);
        if (!parse::accept(p, lex::comma)) break;
    }
    parse::expect(p, lex::right_paren, "`)` to end the type's arguments");
    return node(start, p, q, {.applied = {.name = name, .args = args}});
}

// Whether the type at the position is written in the new syntax and only there (`read` uses it).
static Bool at_new_type(const parse::Parser *p) {
    lex::TokenKind kind = parse::peek(p).kind;
    return starts_new_type(p, 0) || kind == lex::left_bracket || kind == lex::left_paren || kind == lex::kw_type;
}

// `*T` or `*mut T`: the position is at the `*`.
static ast::TypeExpr *new_pointer(parse::Parser *p, U32 start) {
    parse::advance(p);
    Bool is_mut = parse::accept(p, lex::kw_mut);
    ast::TypeExpr *pointee = parse::type(p);
    ast::Qualifiers none = {};
    return node(start, p, none, {.pointer = {.pointee = pointee, .is_mut = is_mut}});
}

// `?T`: the position is at the `?`.
static ast::TypeExpr *new_option(parse::Parser *p, U32 start) {
    parse::advance(p);
    ast::TypeExpr *inner = parse::type(p);
    ast::Qualifiers none = {};
    return node(start, p, none, {.option = {.inner = inner}});
}

// `[5]T`, `[_]T`, `[]T`, `[5,3]T`, `[,3]T`, `[,]T`: the position is at the `[`. One dimension is an array (a slice when
// empty); two or more are a block, with a null size for each empty one.
static ast::TypeExpr *new_brackets(parse::Parser *p, U32 start) {
    parse::advance(p);
    ast::ExprRef dims[:] = {};
    for (Usize i = 0; i < countof(p->tokens); i += 1) {
        ast::Expr *size = nullptr;
        if (!parse::at(p, lex::comma) && !parse::at(p, lex::right_bracket)) size = parse::expression(p);
        dims = with_expr(dims, size);
        if (!parse::accept(p, lex::comma)) break;
    }
    parse::expect(p, lex::right_bracket, "`]` to end the array size");
    ast::TypeExpr *element = parse::type(p);
    ast::Qualifiers none = {};
    if (countof(dims) > 1) return node(start, p, none, {.block_type = {.element = element, .dims = dims}});
    if (dims[0] == nullptr) return node(start, p, none, {.slice = {.element = element}});
    return node(start, p, none, {.array = {.element = element, .count = dims[0]}});
}

// `(A, B)`, `(T,)` and `()`: the position is at the `(`. A single type with no comma is no tuple.
static ast::TypeExpr *new_tuple(parse::Parser *p, U32 start) {
    parse::advance(p);
    ast::TypeRef elements[:] = {};
    NameList names = {};
    Bool comma = false;
    while (!parse::at(p, lex::right_paren) && !parse::at(p, lex::end_of_file)) {
        if (p->new_syntax && parse::at(p, lex::name) && parse::peek_at(p, 1).kind == lex::colon) {
            lex::Token field = parse::advance(p);
            names = with_name(names, (ast::Identifier){.text = parse::text(p, field), .span = field.span});
            parse::advance(p);
        }
        elements = with_type(elements, parse::type(p));
        comma = parse::accept(p, lex::comma);
        if (!comma) break;
    }
    Bool closed = parse::at(p, lex::right_paren);
    parse::expect(p, lex::right_paren, "`)` to end the tuple type");
    if (countof(names) > 0 && countof(names) != countof(elements)) {
        parse::error(p, parse::span_from(p, start),
                     "a tuple type names all its elements or none: `(count: i32, ms: f64)`");
        names = names[0:0];
    }
    if (closed && countof(elements) == 1 && !comma && countof(names) == 0) {
        parse::error(p, parse::span_from(p, start),
                     "a tuple of one type is written with a comma, `(T,)`; a type needs no parentheses");
    }
    ast::Qualifiers none = {};
    return node(start, p, none, {.tuple = {.elements = elements, .names = names}});
}

// `fn(A, B) -> R` and `fn_once(A) -> R`: the position is at the keyword. Without `->` the function has no result.
static ast::TypeExpr *new_function(parse::Parser *p, U32 start) {
    lex::Token word = parse::advance(p);
    Bool is_once = word.kind == lex::kw_fn_once || text::is(parse::text(p, word), "fn_once");
    parse::expect(p, lex::left_paren, "`(` after `fn`");
    ast::TypeRef params[:] = {};
    while (!parse::at(p, lex::right_paren) && !parse::at(p, lex::end_of_file)) {
        params = with_type(params, parse::type(p));
        if (!parse::accept(p, lex::comma)) break;
    }
    parse::expect(p, lex::right_paren, "`)` to end the parameters of the function type");
    ast::TypeExpr *result = nullptr;
    if (parse::accept(p, lex::arrow)) result = parse::type(p);
    ast::Qualifiers none = {};
    return node(start, p, none, {.function = {.params = params, .result = result, .is_once = is_once}});
}

// One type of the new syntax; the position is at its first token.
static ast::TypeExpr *new_type(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    switch (parse::peek(p).kind) {
    case lex::star:
        return new_pointer(p, start);
    case lex::question:
        return new_option(p, start);
    case lex::left_bracket:
        return new_brackets(p, start);
    case lex::left_paren:
        return new_tuple(p, start);
    case lex::kw_type:
        parse::advance(p);
        return spelled(p, start, (ast::Qualifiers){});
    default:
        return new_function(p, start);
    }
}

// Whether the `(` at the position starts one of C's declarators, `(*f)(I32)`, `(*p)[4]` or `(*table[2])(I32)`: a star
// first and the matching `)` followed by `(` or `[`. `Pair(*i32)` is a type function's call with a pointer argument.
static Bool c_declarator_ahead(const parse::Parser *p) {
    if (!parse::at(p, lex::left_paren) || parse::peek_at(p, 1).kind != lex::star) return false;
    Usize depth = 0;
    Usize at = 0;
    for (Usize i = 0; i < countof(p->tokens); i += 1) {
        lex::TokenKind kind = parse::peek_at(p, at).kind;
        if (kind == lex::end_of_file) return false;
        if (kind == lex::left_paren) depth += 1;
        if (kind == lex::right_paren) depth -= 1;
        at += 1;
        if (depth == 0) break;
    }
    lex::TokenKind after = parse::peek_at(p, at).kind;
    return after == lex::left_paren || after == lex::left_bracket;
}

// ---------------------------------------------------------------------------------------------------------------
// Fix-its for today's type forms (F1, #1506 of #1428). Each old form still parses into the same node as its new form
// and records one warning per type with the edit that writes the whole type in smith's own syntax: capitalized
// built-ins and C's names become the lowercase sized types, `T *`, `T[:]` and `T[N]` become `*T`, `[]T` and `[N]T` (two
// or more brackets, `[:][3]`, one block `[,3]T`), `struct { A, B }` becomes `(A, B)` and `Fn(R (A))` becomes
// `fn(A) -> R`. `const` is dropped (constant is the default). A type with no smith spelling (`volatile`, `restrict`,
// `long double`, a variadic function type) is a warning with no edit that says what to do. A type inside another is
// read first, so its warning comes first and wins an overlap; the next pass of `smith lint --fix` mends the outer one.

// The tokens of an old type: the first (qualifiers included), the base's first, the one after the base, the one after
// the whole type.
struct OldType {
    Usize first;
    Usize base;
    Usize after;
    Usize end;
};

// The type being written in smith's own syntax: what goes before the base, the brackets of the run being read (`dims`
// of them), and what is wrong with the type when it has no spelling.
struct Rewrite {
    char prefix[:];
    char run[:];
    Usize dims;
    Str problem;
};

// The source text of the tokens from `from` up to but not including `to`.
static Str source_of(const parse::Parser *p, Usize from, Usize to) {
    return p->source[p->tokens[from].span.start:p->tokens[to - 1].span.end];
}

// Text built by `format::push`, as the read-only `Str`.
static Str frozen(char chars[:]) {
    return chars;
}

// The word with its capitals made lowercase.
static Str lowered(Str word) {
    char out[:] = mem::alloc_slice(char, countof(word));
    for (Usize i = 0; i < countof(word); i += 1) {
        char c = word[i];
        out[i] = c >= 'A' && c <= 'Z' ? (char)(c + 32) : c;
    }
    return frozen(out);
}

// Whether two texts are equal.
static Bool same(Str a, Str b) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i += 1) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// Whether a name is one of the capitalized built-ins of today's spelling.
static Bool old_builtin(Str w) {
    return text::is(w, "I8") || text::is(w, "I16") || text::is(w, "I32") || text::is(w, "I64") ||
           text::is(w, "Isize") || text::is(w, "U8") || text::is(w, "U16") || text::is(w, "U32") ||
           text::is(w, "U64") || text::is(w, "Usize") || text::is(w, "F32") || text::is(w, "F64") ||
           text::is(w, "Bool") || text::is(w, "Char") || text::is(w, "Str") || text::is(w, "Void") ||
           text::is(w, "Type");
}

// The sized type of a C typedef name such as `size_t` or `uint32_t`; empty for any other name.
static Str c_type_name(Str w) {
    if (text::is(w, "size_t") || text::is(w, "uintptr_t")) return "usize";
    if (text::is(w, "ssize_t") || text::is(w, "ptrdiff_t") || text::is(w, "intptr_t")) return "isize";
    if (text::is(w, "int8_t")) return "i8";
    if (text::is(w, "int16_t")) return "i16";
    if (text::is(w, "int32_t")) return "i32";
    if (text::is(w, "int64_t") || text::is(w, "intmax_t")) return "i64";
    if (text::is(w, "uint8_t")) return "u8";
    if (text::is(w, "uint16_t")) return "u16";
    if (text::is(w, "uint32_t")) return "u32";
    if (text::is(w, "uint64_t") || text::is(w, "uintmax_t")) return "u64";
    return "";
}

// The sized type of C's keyword types, the words joined by one space (`unsigned long`); empty when there is none.
static Str keyword_type(Str w) {
    if (text::is(w, "int") || text::is(w, "signed") || text::is(w, "signed int")) return "i32";
    if (text::is(w, "unsigned") || text::is(w, "unsigned int")) return "u32";
    if (text::is(w, "short") || text::is(w, "short int") || text::is(w, "signed short")) return "i16";
    if (text::is(w, "unsigned short") || text::is(w, "unsigned short int")) return "u16";
    if (text::is(w, "long") || text::is(w, "long int") || text::is(w, "long long") || text::is(w, "long long int"))
        return "i64";
    if (text::is(w, "unsigned long") || text::is(w, "unsigned long int") || text::is(w, "unsigned long long"))
        return "u64";
    if (text::is(w, "signed char")) return "i8";
    if (text::is(w, "unsigned char")) return "u8";
    if (text::is(w, "float")) return "f32";
    if (text::is(w, "double")) return "f64";
    return "";
}

// `volatile` and `restrict` have no spelling yet; `const` is the default and is dropped.
static void note_qualifier(lex::TokenKind kind, Rewrite *r) {
    if (kind == lex::kw_const) return;
    r->problem = "`volatile` and `restrict` have no spelling in smith's own syntax: remove them";
}

// The base when it is C's keyword types: `unsigned long` is `u64`.
static Str keyword_base(const parse::Parser *p, const OldType *t, Rewrite *r) {
    char words[:] = {};
    for (Usize i = t->base; i < t->after; i += 1) {
        words = format::push(words, i > t->base ? " " : "", parse::text(p, p->tokens[i]));
    }
    Str sized = keyword_type(words);
    if (countof(sized) > 0) return sized;
    if (text::is(words, "char") || text::is(words, "void") || text::is(words, "bool")) return frozen(words);
    r->problem = frozen(format::push("`", words, "` has no sized type in smith: write the type by hand"));
    return frozen(words);
}

// `struct { A, B }` as `(A, B)`, and `(A,)` for one element.
static Str tuple_base(const parse::Parser *p, const ast::TypeExpr *base) {
    ast::TypeKind kind = base->kind;
    if (kind != .tuple) {
        return "";
    }
    ast::TypeRef elements[:] = kind.tuple.elements;
    char joined[:] = {};
    for (Usize i = 0; i < countof(elements); i += 1) {
        ast::Span span = elements[i]->span;
        joined = format::push(joined, i > 0 ? ", " : "", p->source[span.start:span.end]);
    }
    if (countof(elements) == 1) joined = format::push(joined, ",");
    return frozen(format::push("(", joined, ")"));
}

// The function type that is the one argument of `Fn(R (A, B))` when the base is that applied `Fn`; else null.
static ast::TypeExpr *fn_type_of(const ast::TypeExpr *base) {
    ast::TypeKind kind = base->kind;
    if (kind != .applied) return nullptr;
    ast::Path name = kind.applied.name;
    ast::TypeArg args[:] = kind.applied.args;
    if (countof(name.segments) != 1 || !text::is(name.segments[0].text, "Fn") || countof(args) != 1) return nullptr;
    ast::TypeArg only = args[0];
    if (only != .type || only.type.type == nullptr) return nullptr;
    ast::TypeKind inner = only.type.type->kind;
    return inner == .function ? only.type.type : nullptr;
}

// `Fn(R (A, B))` as `fn(A, B) -> R` from its function type: no `->` for a result of `void`.
static Str fn_base(const parse::Parser *p, const ast::TypeExpr *function, Rewrite *r) {
    ast::TypeKind kind = function->kind;
    if (kind != .function) {
        return "";
    }
    ast::TypeRef params[:] = kind.function.params;
    char joined[:] = {};
    // C's `(void)` is no parameters.
    Usize count = countof(params);
    if (count == 1 && text::is(p->source[params[0]->span.start:params[0]->span.end], "void")) count = 0;
    for (Usize i = 0; i < count; i += 1) {
        ast::Span span = params[i]->span;
        // The inner types are mended first: `Fn(U32 (U32 x))` is `fn(u32) -> u32`, not `fn(U32) -> U32`.
        // A name after the type (`void *context`) leaves the space the mended star wants (`*void `): it goes.
        Str inner = parse::mended(p, span.start, span.end);
        while (countof(inner) > 0 && inner[countof(inner) - 1] == ' ')
            inner = inner[0:countof(inner) - 1];
        joined = format::push(joined, i > 0 ? ", " : "", inner);
    }
    if (kind.function.variadic) {
        r->problem = "a variadic function type has no spelling in smith's own syntax yet: write the function by hand";
    }
    char written[:] = format::push("fn(", joined, ")");
    ast::TypeExpr *result = kind.function.result;
    if (result == nullptr) return frozen(written);
    Str shown = parse::mended(p, result->span.start, result->span.end);
    if (text::is(shown, "void") || text::is(shown, "Void")) return frozen(written);
    return frozen(format::push(written, " -> ", shown));
}

// The base in smith's own spelling, or as it is when it has no old form.
static Str head_of(const parse::Parser *p, const OldType *t, const ast::TypeExpr *base, Rewrite *r) {
    lex::TokenKind first = p->tokens[t->base].kind;
    if (is_keyword_type(first)) return keyword_base(p, t, r);
    if (first == lex::kw_struct && base->kind == .tuple) return tuple_base(p, base);
    ast::TypeExpr *function = fn_type_of(base);
    if (function != nullptr) return fn_base(p, function, r);
    ast::TypeKind kind = base->kind;
    if (kind == .named && countof(kind.named.path.segments) == 1) {
        Str word = kind.named.path.segments[0].text;
        if (old_builtin(word)) return lowered(word);
        Str sized = c_type_name(word);
        if (countof(sized) > 0) return sized;
    }
    return source_of(p, t->base, t->after);
}

// Puts the bracket run being read in front of what is written so far: `[]`, `[3]`, `[,3]` (a block, as `[3][4]` is the
// same type as `[3,4]`).
static void flush_run(Rewrite *r) {
    if (r->dims == 0) return;
    r->prefix = format::push("[", r->run, "]", r->prefix);
    char none[:] = {};
    r->run = none;
    r->dims = 0;
}

// The bracket that opens at token `open`: its size joins the run (empty for a slice). Gives the token after it.
static Usize scan_bracket(const parse::Parser *p, Usize open, Usize end, Rewrite *r) {
    Usize close = open;
    Usize depth = 0;
    for (Usize j = open; j < end && close == open; j += 1) {
        if (p->tokens[j].kind == lex::left_bracket) depth += 1;
        if (p->tokens[j].kind == lex::right_bracket) depth -= 1;
        if (depth == 0) close = j;
    }
    if (close == open) {
        r->problem = "this array size has no spelling in smith's own syntax: write the type by hand";
        return end;
    }
    Usize from = open + 1;
    while (from < close && is_qualifier(p->tokens[from].kind)) {
        note_qualifier(p->tokens[from].kind, r);
        from += 1;
    }
    Str size = "";
    if (from < close && p->tokens[from].kind != lex::colon) size = source_of(p, from, close);
    r->run = format::push(r->run, r->dims > 0 ? "," : "", size);
    r->dims += 1;
    return close + 1;
}

// The suffixes of the type, from the token after the base: each star and run of brackets goes in front.
static void scan_suffixes(const parse::Parser *p, const OldType *t, Rewrite *r) {
    Usize i = t->after;
    while (i < t->end) {
        lex::TokenKind kind = p->tokens[i].kind;
        if (kind == lex::left_bracket) {
            i = scan_bracket(p, i, t->end, r);
            continue;
        }
        flush_run(r);
        if (kind == lex::star) {
            r->prefix = format::push("*", r->prefix);
        } else if (is_qualifier(kind)) {
            note_qualifier(kind, r);
        } else {
            r->problem = "this type has no spelling in smith's own syntax: write it by hand";
            return;
        }
        i += 1;
    }
    flush_run(r);
}

// Whether an error was recorded from `since` on: the type did not parse, so there is nothing to mend.
static Bool failed_since(const parse::Parser *p, Usize since) {
    return countof(p->errors) > since;
}

// Whether a name starts right at `end`: `char *name` written `*char name` needs the space the star did not have.
static Bool glued(const parse::Parser *p, U32 end) {
    if (end >= countof(p->source)) return false;
    char c = p->source[end];
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
}

// Records the warning of an old type: the edit that writes it in smith's own syntax, or a message alone.
static void warn_old_type(parse::Parser *p, const OldType *t, const ast::TypeExpr *base) {
    Rewrite r = {};
    for (Usize i = t->first; i < t->base; i += 1) {
        note_qualifier(p->tokens[i].kind, &r);
    }
    Str head = head_of(p, t, base, &r);
    scan_suffixes(p, t, &r);
    Str old_text = source_of(p, t->first, t->end);
    ast::Span span = {.start = p->tokens[t->first].span.start, .end = p->tokens[t->end - 1].span.end};
    Str shown = frozen(format::push(r.prefix, head));
    Str written = glued(p, span.end) ? frozen(format::push(shown, " ")) : shown;
    parse::Edits edits = {};
    if (countof(r.problem) > 0) {
        parse::warning_fix(p, span, r.problem, edits);
        return;
    }
    if (same(shown, old_text)) return;
    edits = mem::alloc_slice(parse::Edit, 1);
    edits[0] = (parse::Edit){.span = span, .text = written};
    char message[:] = format::push("write the type `", old_text, "` as `", shown, "` in smith's own syntax");
    parse::warning_fix(p, span, message, edits);
}

// In smith's own syntax a type function of a module is applied through a dot, `arena.slice_of(T, n)`: when the path
// just read is followed by `.name(`, the dot and the name join the path and the result is true, so the arguments are
// read as an applied type. Anywhere else a `.` after a type is not part of it.
static Bool qualified_type_function(parse::Parser *p, ast::TypeExpr *base) {
    if (!p->new_syntax || base->kind != .named) return false;
    if (parse::peek(p).kind != lex::dot || parse::peek_at(p, 1).kind != lex::name) return false;
    if (parse::peek_at(p, 2).kind != lex::left_paren) return false;
    parse::advance(p);
    lex::Token token = parse::advance(p);
    ast::Path named = base->kind.named.path;
    named.segments = mem::realloc(named.segments, countof(named.segments) + 1);
    ast::Identifier segment = {.text = parse::text(p, token), .span = token.span};
    named.segments[countof(named.segments) - 1] = segment;
    named.span = parse::span_from(p, named.span.start);
    base->kind.named.path = named;
    return true;
}

// Reads one type: qualifiers, the base, the applied form of a type name followed by `(`, the suffixes.
static ast::TypeExpr *read(parse::Parser *p) {
    if (at_new_type(p)) return new_type(p);
    Usize errors_before = countof(p->errors);
    OldType old = {.first = p->position};
    U32 start = parse::peek(p).span.start;
    ast::Qualifiers q = {};
    take_qualifiers(p, &q);
    old.base = p->position;
    ast::TypeExpr *base = plain(p, start, q);
    if (base == nullptr) return nullptr;
    Bool qualified_call = qualified_type_function(p, base);
    Bool call_shape = parse::at(p, lex::left_paren) && !c_declarator_ahead(p);
    if (call_shape && base->kind == .named) {
        ast::Path name = base->kind.named.path;
        Str last = name.segments[countof(name.segments) - 1].text;
        Bool is_lambda = countof(name.segments) == 1 && text::is(last, "Lambda");
        Bool capital = countof(last) > 0 && last[0] >= 'A' && last[0] <= 'Z';
        Bool is_vec = countof(name.segments) == 1 && text::is(last, "vec");
        if (capital || is_lambda || is_vec || qualified_call || group_then_name(p, 0))
            base = applied(p, start, q, name);
    }
    old.after = p->position;
    ast::TypeExpr *result = suffixes(p, start, base);
    old.end = p->position;
    if (!failed_since(p, errors_before)) warn_old_type(p, &old, base);
    return result;
}

// Reads a type at the position, or records an error and gives null. The hook `parse::Hooks.type`.
export ast::TypeExpr *type(parse::Parser *p) {
    return read(p);
}
