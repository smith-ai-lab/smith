// front::cimport (#1112 track C, #1114): what a C header declares, read through clang's C++ libraries at the one edge
// file, shim/cimport.cpp. `read` parses the header and returns its functions and structs as records; whatever it
// cannot express is in `not_imported` with a reason, never guessed and never dropped silently.
//
// What it returns is front::ast: `Decl` and `TypeExpr` nodes with `from_c` set (#1124). The shim's flat table of types
// stays private; a type refers to another by its index there, and `read` builds the tree of each from the table.
//
// Not wired into `smith cc`: the work shows through tests/front_cimport_test.smith.
module front::cimport;

import <string.h>;

import front::ast;
import std::arena;
import std::mem;

// The kinds of CType. The layout of the shim's flat result (shim/cimport.cpp) is the source of these numbers.
constexpr U32 kind_void = 0;
constexpr U32 kind_bool = 1;
constexpr U32 kind_integer = 2;     // a = bits, b = 1 when signed
constexpr U32 kind_floating = 3;    // a = bits
constexpr U32 kind_pointer = 4;     // a = pointee
constexpr U32 kind_array = 5;       // a = element, b = count
constexpr U32 kind_typedef = 6;     // name, a = underlying
constexpr U32 kind_struct = 7;      // a = index in Header.structs
constexpr U32 kind_function = 8;    // a = result, parameters, variadic
constexpr U32 kind_fn_pointer = 10; // a = the function type: `Fn` applied to it, never a pointer
constexpr U32 kind_unsupported = 9; // name = the C type's spelling: a union, `long double`, a bit-field

constexpr U32 flag_const = 1;
constexpr U32 flag_restrict = 2;

// What was left out: a declaration (kind_declaration) or an attribute of one (kind_attribute).
export constexpr U32 not_imported_declaration = 0;
export constexpr U32 not_imported_attribute = 1;

struct Parameter {
    Str name; // empty when the declaration has none
    U32 type;
};

struct CType {
    U32 kind;
    U32 flags;
    U32 a;
    U32 b;
    Str name;                // a typedef's name
    Parameter parameters[:]; // a function type's
    Bool variadic;
};

struct Function {
    Str name;
    U32 result; // an index in Header.types
    Parameter parameters[:];
    Bool variadic;
};

struct Field {
    Str name;
    U32 type;
};

struct Record {
    Str name;    // empty for an anonymous struct that no typedef names
    Bool opaque; // no definition, or members that could not be imported
    Field fields[:];
};

export struct NotImported {
    U32 kind;
    Str name;
    Str reason;
};

struct Table {
    CType types[:];
    Function functions[:];
    Record structs[:];
    NotImported not_imported[:];
    Str error;
};

// What a header declares: structs, then the typedefs, then the functions, each a `from_c` declaration.
export struct Header {
    ast::DeclRef decls[:];
    NotImported not_imported[:];
    Str error; // empty when the header was read
};

// Keep in step with SmithCimportRequest in shim/cimport.cpp.
struct Request {
    const char *name;
    I32 quoted;
    const char *folder;
    const char *flags;
};

extern Usize smith_cimport_read(const Request *request, U32 *words, Usize capacity);

static Str text(const char *pool, U32 at) {
    Usize length = c::strlen(pool + at);
    return pool[at:at + length];
}

static Parameter parameter_at(const U32 w[:], const char *pool, U32 first, U32 index) {
    Usize at = first + 2 * (Usize)index;
    return (Parameter){.name = text(pool, w[at]), .type = w[at + 1]};
}

// Reads `name` (written `<name>` or, with quoted, "name" beside `folder`) with the compile flags `flags`, one on each
// line. All three are NUL-terminated. The records are allocated in `a`.
static Table read_table(arena::Arena *a, const char *name, Bool quoted, const char *folder, const char *flags) {
    Request request = {.name = name, .quoted = quoted ? 1 : 0, .folder = folder, .flags = flags};
    Usize capacity = 1U << 16;
    U32 words[:] = arena::push_slice(a, U32, capacity);
    Usize needed = smith_cimport_read(&request, words.data, capacity);
    if (needed > capacity) { // the first call said how many
        words = arena::push_slice(a, U32, needed);
        needed = smith_cimport_read(&request, words.data, needed);
    }
    const U32 w[:] = words;
    const char *pool = (const char *)words.data + w[2];
    Table header = {};
    header.error = text(pool, w[16]);
    header.types = arena::push_slice(a, CType, w[5]);
    for (U32 i = 0; i < w[5]; i++) {
        Usize at = w[4] + 5 * (Usize)i;
        CType t = {.kind = w[at], .flags = w[at + 1], .a = w[at + 2], .b = w[at + 3]};
        if (t.kind == kind_typedef) {
            t.name = text(pool, w[at + 2]);
            t.a = w[at + 3];
            t.b = 0;
        }
        if (t.kind == kind_unsupported) {
            t.name = text(pool, w[at + 2]);
            t.a = 0;
        }
        if (t.kind == kind_function) {
            t.variadic = (w[at + 1] & 4) != 0;
            t.parameters = arena::push_slice(a, Parameter, w[at + 4]);
            for (U32 j = 0; j < w[at + 4]; j++) {
                t.parameters[j] = parameter_at(w, pool, w[12], w[at + 3] + j);
            }
            t.b = 0;
        }
        header.types[i] = t;
    }
    header.functions = arena::push_slice(a, Function, w[7]);
    for (U32 i = 0; i < w[7]; i++) {
        Usize at = w[6] + 5 * (Usize)i;
        Function f = {.name = text(pool, w[at]), .result = w[at + 1], .variadic = (w[at + 4] & 1) != 0};
        f.parameters = arena::push_slice(a, Parameter, w[at + 3]);
        for (U32 j = 0; j < w[at + 3]; j++) {
            f.parameters[j] = parameter_at(w, pool, w[12], w[at + 2] + j);
        }
        header.functions[i] = f;
    }
    header.structs = arena::push_slice(a, Record, w[9]);
    for (U32 i = 0; i < w[9]; i++) {
        Usize at = w[8] + 4 * (Usize)i;
        Record s = {.name = text(pool, w[at]), .opaque = (w[at + 3] & 1) != 0};
        s.fields = arena::push_slice(a, Field, w[at + 2]);
        for (U32 j = 0; j < w[at + 2]; j++) {
            Usize f = w[10] + 2 * ((Usize)w[at + 1] + j);
            s.fields[j] = (Field){.name = text(pool, w[f]), .type = w[f + 1]};
        }
        header.structs[i] = s;
    }
    header.not_imported = arena::push_slice(a, NotImported, w[15]);
    for (U32 i = 0; i < w[15]; i++) {
        Usize at = w[14] + 3 * (Usize)i;
        header.not_imported[i] =
            (NotImported){.kind = w[at], .name = text(pool, w[at + 1]), .reason = text(pool, w[at + 2])};
    }
    return header;
}

static Str integer_name(U32 bits, Bool is_signed) {
    if (bits == 8) return is_signed ? "I8" : "U8";
    if (bits == 16) return is_signed ? "I16" : "U16";
    if (bits == 32) return is_signed ? "I32" : "U32";
    if (bits == 128) return is_signed ? "I128" : "U128";
    return is_signed ? "I64" : "U64";
}

typedef ast::TypeRef TypeList[:];

static ast::TypeRef *type_block(Usize count) {
    // Not mem::alloc_slice: its instance for a pointer element draws the lint of a multilevel conversion.
    return (ast::TypeRef *)mem::alloc_array_raw(sizeof(ast::TypeRef), count, alignof(ast::TypeRef));
}

static ast::TypeExpr *build_function(const CType *c, TypeList done) {
    if (done[c->a] == nullptr) return nullptr;
    ast::TypeRef *params = type_block(countof(c->parameters));
    for (Usize i = 0; i < countof(c->parameters); i++) {
        if (done[c->parameters[i].type] == nullptr) return nullptr;
        params[i] = done[c->parameters[i].type];
    }
    ast::TypeKind kind = {
        .function = {.params = params[0:countof(c->parameters)], .result = done[c->a], .variadic = c->variadic}};
    return ast::make_type(kind);
}

// The type at `index` when everything it is made of is in `done`; null when not yet.
static ast::TypeExpr *build_type(const Table *t, TypeList done, U32 index) {
    CType c = t->types[index];
    if (c.kind == kind_void) return ast::named("Void");
    if (c.kind == kind_bool) return ast::named("Bool");
    if (c.kind == kind_integer) return ast::named(integer_name(c.a, c.b == 1));
    if (c.kind == kind_floating) return ast::named(c.a == 32 ? "F32" : "F64");
    if (c.kind == kind_typedef) return ast::named(c.name);
    if (c.kind == kind_struct) return ast::named(t->structs[c.a].name);
    if (c.kind == kind_unsupported) {
        ast::TypeKind kind = {.unsupported_c = {.spelling = c.name}};
        return ast::make_type(kind);
    }
    if (c.kind == kind_function) return build_function(&c, done);
    if (done[c.a] == nullptr) return nullptr;
    if (c.kind == kind_pointer) {
        ast::TypeKind kind = {.pointer = {.pointee = done[c.a]}};
        return ast::make_type(kind);
    }
    if (c.kind == kind_array) {
        ast::TypeKind kind = {.array = {.element = done[c.a], .count = ast::integer(c.b)}};
        return ast::make_type(kind);
    }
    if (c.kind != kind_fn_pointer) {
        return nullptr;
    }
    // `Fn` applied to the function type.
    ast::TypeArg args[:] = mem::alloc_slice(ast::TypeArg, 1);
    ast::TypeArg arg = {.type = {.type = done[c.a]}};
    args[0] = arg;
    ast::TypeKind kind = {.applied = {.name = ast::path("Fn"), .args = args}};
    return ast::make_type(kind);
}

// Every type of the table as a tree: passes until none is left, because the table's order is not promised (and a
// module has no recursion). A struct and a typedef are named, so they need no pass.
static TypeList build_types(const Table *t) {
    Usize count = countof(t->types);
    ast::TypeRef *block = type_block(count);
    for (Usize i = 0; i < count; i++)
        block[i] = nullptr;
    TypeList done = block[0:count];
    Bool progress = true;
    while (progress) {
        progress = false;
        for (Usize i = 0; i < countof(done); i++) {
            if (done[i] != nullptr) continue;
            ast::TypeExpr *node = build_type(t, done, (U32)i);
            if (node == nullptr) continue;
            node->qualifiers.is_const = (t->types[i].flags & flag_const) != 0;
            node->qualifiers.is_restrict = (t->types[i].flags & flag_restrict) != 0;
            done[i] = node;
            progress = true;
        }
    }
    return done;
}

// Whether the typedef at `index` is the first of its name: the table holds one per use, with qualifiers.
static Bool first_typedef(const Table *t, Usize index) {
    if (t->types[index].kind != kind_typedef) {
        return false;
    }
    for (Usize i = 0; i < index; i++) {
        if (t->types[i].kind == kind_typedef && c::strcmp(t->types[i].name.data, t->types[index].name.data) == 0) {
            return false;
        }
    }
    return true;
}

static ast::Decl *from_c(ast::Decl *d) {
    d->from_c = true;
    return d;
}

static ast::Decl *record_decl(const Record *s, TypeList types) {
    ast::FieldDecl fields[:] = mem::alloc_slice(ast::FieldDecl, countof(s->fields));
    for (Usize i = 0; i < countof(fields); i++) {
        fields[i] = ast::field(s->fields[i].name, types[s->fields[i].type]);
    }
    ast::DeclKind kind = {.record = {.name = s->name, .opaque = s->opaque, .fields = fields}};
    return from_c(ast::decl((ast::Decl){}, kind));
}

static ast::Decl *function_decl(const Function *f, TypeList types) {
    ast::Param params[:] = mem::alloc_slice(ast::Param, countof(f->parameters));
    for (Usize i = 0; i < countof(params); i++) {
        params[i] = ast::param(f->parameters[i].name, types[f->parameters[i].type]);
    }
    ast::DeclKind kind = {
        .function = {.name = f->name, .params = params, .result = types[f->result], .variadic = f->variadic}};
    return from_c(ast::decl((ast::Decl){}, kind));
}

// Reads `name` (written `<name>` or, with quoted, "name" beside `folder`) with the compile flags `flags`, one on each
// line. All three are NUL-terminated. The declarations are allocated in the allocator in force; `a` holds the
// tables read from the shim.
export Header read(arena::Arena *a, const char *name, Bool quoted, const char *folder, const char *flags) {
    Table t = read_table(a, name, quoted, folder, flags);
    Header header = {.not_imported = t.not_imported, .error = t.error};
    if (countof(t.error) != 0) return header;
    TypeList types = build_types(&t);
    Usize typedefs = 0;
    for (Usize i = 0; i < countof(t.types); i++)
        if (first_typedef(&t, i)) typedefs += 1;
    Usize total = countof(t.structs) + typedefs + countof(t.functions);
    ast::DeclRef *block = (ast::DeclRef *)mem::alloc_array_raw(sizeof(ast::DeclRef), total, alignof(ast::DeclRef));
    Usize at = 0;
    for (Usize i = 0; i < countof(t.structs); i++)
        block[at++] = record_decl(&t.structs[i], types);
    for (Usize i = 0; i < countof(t.types); i++) {
        if (!first_typedef(&t, i)) {
            continue;
        }
        block[at++] = from_c(ast::type_alias(t.types[i].name, types[t.types[i].a]));
    }
    for (Usize i = 0; i < countof(t.functions); i++)
        block[at++] = function_decl(&t.functions[i], types);
    header.decls = block[0:total];
    return header;
}
