// front::emit_builtin: the emit side of clang's `__builtin_*` functions (#2286 of #2224). The checker
// (front::types_builtin) says what each one takes and returns; this module lowers a call of one to the LLVM intrinsic
// or the few instructions its entry names. The call emitter (front::emit_call) hands every call whose callee is a name
// of the table to `call`; nothing else of the emitter knows the table.
module front::emit_builtin;

import front::ast;
import front::emit_state as state;
import front::types as types;
import front::types_builtin as table;
import std::arena;
import std::format;
import std::mem;
import <llvm-c/Core.h>;

// The entry of the builtin the call `x` calls; false when `x` is not a call of one.
static Bool entry_of(const ast::Expr *x, table::Entry *found) {
    if (x->kind != .call) return false;
    const ast::Expr *callee = x->kind.call.callee;
    if (callee->kind != .name) return false;
    ast::Path path = callee->kind.name.path;
    return countof(path.segments) == 1 && table::find(path.segments[0].text, found);
}

// Whether the call `x` is a call of a builtin of the table.
export Bool is_call(const ast::Expr *x) {
    table::Entry found = {};
    return entry_of(x, &found);
}

// A call of the LLVM intrinsic `name`, overloaded on `over` (null for one that is not). The call's value.
static c::LLVMValueRef intrinsic(state::Emitter *e, Str name, c::LLVMTypeRef over, c::LLVMValueRef *args, U32 count) {
    U32 id = c::LLVMLookupIntrinsicID(name.data, countof(name));
    c::LLVMTypeRef overload_types[1] = {over};
    U32 overloads = over == nullptr ? 0 : 1;
    c::LLVMValueRef declaration = c::LLVMGetIntrinsicDeclaration(e->module, id, overload_types, overloads);
    c::LLVMTypeRef type = c::LLVMIntrinsicGetType(e->context, id, overload_types, overloads);
    return c::LLVMBuildCall2(e->builder, type, declaration, args, count, "");
}

// `llvm.<name>` called on `over` with the arguments `args`.
static c::LLVMValueRef named_intrinsic(state::Emitter *e, Str prefix, Str base, Str suffix, c::LLVMTypeRef over,
                                       c::LLVMValueRef *args, U32 count) {
    char text[:] = format::push("llvm.", prefix, base, suffix);
    c::LLVMValueRef made = intrinsic(e, text, over, args, count);
    mem::free(text.data);
    return made;
}

// The operand `x` widened to the integer type `to` (a sign extension for a signed operand, a zero extension else).
static c::LLVMValueRef widened_to(state::Emitter *e, state::Value x, c::LLVMTypeRef to) {
    return c::LLVMBuildIntCast2(e->builder, x.llvm, to, state::is_signed(x.ty) ? 1 : 0, "");
}

// `__builtin_add_overflow(a, b, &r)`: stores the wrapped result in `r` and says whether it overflowed. The operands
// and `r` may be of different integer types, as in C: the operation is done in a type that holds both operands (two
// operands of one signedness: the wider; mixed: a signed type twice the wider's width), and the result is converted
// to `r`'s type, which also counts as an overflow when the converted value is not the same number.
static c::LLVMValueRef overflow(state::Emitter *e, table::Entry entry, state::Value *v) {
    state::Ty *target = nullptr;
    state::Value out = v[2];
    if (out.ty.kind == .pointer) target = out.ty.kind.pointer.element;
    if (target == nullptr || (target->kind != .integer) || v[0].ty.kind != .integer || v[1].ty.kind != .integer) {
        c::LLVMValueRef args[2] = {v[0].llvm, v[1].llvm};
        c::LLVMValueRef pair = named_intrinsic(e, state::is_signed(v[0].ty) ? "s" : "u", entry.intrinsic,
                                               ".with.overflow", v[0].ty.llvm, args, 2);
        c::LLVMBuildStore(e->builder, c::LLVMBuildExtractValue(e->builder, pair, 0, "wrapped"), v[2].llvm);
        return c::LLVMBuildExtractValue(e->builder, pair, 1, "overflow");
    }
    Bool signed_math = state::is_signed(v[0].ty) || state::is_signed(v[1].ty);
    Usize wide = state::width(v[0].ty) > state::width(v[1].ty) ? state::width(v[0].ty) : state::width(v[1].ty);
    if (state::is_signed(v[0].ty) != state::is_signed(v[1].ty)) wide *= 2;
    c::LLVMTypeRef common = c::LLVMIntTypeInContext(e->context, (U32)wide);
    c::LLVMValueRef args[2] = {widened_to(e, v[0], common), widened_to(e, v[1], common)};
    c::LLVMValueRef pair =
        named_intrinsic(e, signed_math ? "s" : "u", entry.intrinsic, ".with.overflow", common, args, 2);
    c::LLVMValueRef value = c::LLVMBuildExtractValue(e->builder, pair, 0, "wrapped");
    c::LLVMValueRef lost = c::LLVMBuildExtractValue(e->builder, pair, 1, "overflow");
    if (state::width(*target) != wide || state::is_signed(*target) != signed_math) {
        c::LLVMValueRef narrowed = c::LLVMBuildIntCast2(e->builder, value, target->llvm, signed_math ? 1 : 0, "");
        c::LLVMValueRef back =
            c::LLVMBuildIntCast2(e->builder, narrowed, common, state::is_signed(*target) ? 1 : 0, "");
        c::LLVMValueRef changed = c::LLVMBuildICmp(e->builder, c::LLVMIntNE, back, value, "changed");
        lost = c::LLVMBuildOr(e->builder, lost, changed, "overflow");
        value = narrowed;
    }
    c::LLVMBuildStore(e->builder, value, v[2].llvm);
    return lost;
}

// `__builtin_bit_cast(T, x)`: the bytes of `x` read back as a `T`, through a temporary.
static c::LLVMValueRef bit_cast(state::Emitter *e, state::Value x, state::Ty to) {
    c::LLVMValueRef slot = state::new_alloca(e, x.ty, "cast");
    c::LLVMBuildStore(e->builder, x.llvm, slot);
    return c::LLVMBuildLoad2(e->builder, to.llvm, slot, "cast");
}

static c::LLVMValueRef absolute(state::Emitter *e, state::Value x) {
    if (x.ty.kind == .floating) {
        c::LLVMValueRef args[1] = {x.llvm};
        return named_intrinsic(e, "", "fabs", "", x.ty.llvm, args, 1);
    }
    c::LLVMValueRef args[2] = {x.llvm, c::LLVMConstInt(c::LLVMInt1TypeInContext(e->context), 0, 0)};
    return named_intrinsic(e, "", "abs", "", x.ty.llvm, args, 2);
}

static c::LLVMValueRef smallest(state::Emitter *e, state::Value a, state::Value b) {
    c::LLVMValueRef args[2] = {a.llvm, b.llvm};
    if (a.ty.kind == .floating) return named_intrinsic(e, "", "minnum", "", a.ty.llvm, args, 2);
    return named_intrinsic(e, "", state::is_signed(a.ty) ? "smin" : "umin", "", a.ty.llvm, args, 2);
}

// `isnan`: unordered with itself. `isfinite`: `x - x` is zero, and is not for an infinity or a NaN.
static c::LLVMValueRef predicate(state::Emitter *e, table::Entry entry, state::Value x) {
    if (state::same_text(entry.intrinsic, "isnan"))
        return c::LLVMBuildFCmp(e->builder, c::LLVMRealUNO, x.llvm, x.llvm, "isnan");
    c::LLVMValueRef difference = c::LLVMBuildFSub(e->builder, x.llvm, x.llvm, "difference");
    return c::LLVMBuildFCmp(e->builder, c::LLVMRealOEQ, difference, c::LLVMConstReal(x.ty.llvm, 0.0), "isfinite");
}

constexpr Usize max_values = 8;

// The value `v` as the C type a letter of a libc signature names: `z` a 64-bit integer, `i` an int, `d` a double, `f` a
// float; a pointer is as it is.
static c::LLVMValueRef coerced(state::Emitter *e, state::Value v, U8 letter) {
    if (letter == 'z')
        return c::LLVMBuildIntCast2(e->builder, v.llvm, c::LLVMInt64TypeInContext(e->context),
                                    state::is_signed(v.ty) ? 1 : 0, "");
    if (letter == 'i')
        return c::LLVMBuildIntCast2(e->builder, v.llvm, c::LLVMInt32TypeInContext(e->context),
                                    state::is_signed(v.ty) ? 1 : 0, "");
    if (letter == 'd' && v.ty.kind == .floating && state::width(v.ty) < 64)
        return c::LLVMBuildFPExt(e->builder, v.llvm, c::LLVMDoubleTypeInContext(e->context), "double");
    if (letter == 'f' && v.ty.kind == .floating && state::width(v.ty) > 32)
        return c::LLVMBuildFPTrunc(e->builder, v.llvm, c::LLVMFloatTypeInContext(e->context), "float");
    return v.llvm;
}

// A call of the libc function the entry names, declared on first use with the types of the arguments.
static c::LLVMValueRef libc_call(state::Emitter *e, table::Entry entry, state::Value *v, state::Ty result) {
    Str params = table::libc_params(entry);
    c::LLVMValueRef args[3] = {};
    c::LLVMTypeRef argument_types[3] = {};
    for (Usize i = 0; i < countof(params); i++) {
        args[i] = coerced(e, v[i], (U8)params[i]);
        argument_types[i] = c::LLVMTypeOf(args[i]);
    }
    c::LLVMTypeRef type = c::LLVMFunctionType(result.llvm, argument_types, (U32)countof(params), 0);
    char *label = state::cstr(table::libc_name(entry));
    c::LLVMValueRef function = c::LLVMGetNamedFunction(e->module, label);
    if (function == nullptr) function = c::LLVMAddFunction(e->module, label, type);
    mem::free(label);
    return c::LLVMBuildCall2(e->builder, type, function, args, (U32)countof(params), "");
}

// `__builtin_snprintf(out, n, format, rest...)`: a call of the variadic libc function. A size is a 64-bit integer; an
// integer narrower than an int is widened to one, as C's promotions do; any other value is passed as it is.
static c::LLVMValueRef format_call(state::Emitter *e, table::Entry entry, state::Value *v, Usize count,
                                   state::Ty result) {
    c::LLVMValueRef args[max_values] = {};
    c::LLVMTypeRef argument_types[max_values] = {};
    for (Usize i = 0; i < count; i++) {
        args[i] = v[i].llvm;
        if (i == 1) args[i] = coerced(e, v[i], 'z');
        if (i > 2 && v[i].ty.kind == .integer && state::width(v[i].ty) < 32) args[i] = coerced(e, v[i], 'i');
        if (i > 2 && v[i].ty.kind == .floating && state::width(v[i].ty) < 64)
            args[i] = c::LLVMBuildFPExt(e->builder, v[i].llvm, c::LLVMDoubleTypeInContext(e->context), "promoted");
        argument_types[i] = c::LLVMTypeOf(args[i]);
    }
    c::LLVMTypeRef type = c::LLVMFunctionType(result.llvm, argument_types, 3, 1);
    char *label = state::cstr(entry.intrinsic);
    c::LLVMValueRef function = c::LLVMGetNamedFunction(e->module, label);
    if (function == nullptr) function = c::LLVMAddFunction(e->module, label, type);
    mem::free(label);
    return c::LLVMBuildCall2(e->builder, type, function, args, (U32)count, "");
}

// `__builtin_va_start(list, last)`, `__builtin_va_end(list)`: `llvm.va_start` and `llvm.va_end` on the list's address.
static c::LLVMValueRef va_lifetime(state::Emitter *e, table::Entry entry, state::Value list) {
    c::LLVMValueRef args[1] = {list.llvm};
    c::LLVMTypeRef pointer = state::pointer_type(e, 0);
    if (entry.shape == .va_start) return intrinsic(e, "llvm.va_start", pointer, args, 1);
    return intrinsic(e, "llvm.va_end", pointer, args, 1);
}

// `__builtin_vsnprintf(out, n, format, list)`: a call of libc's `vsnprintf`, the list passed by its address (the
// 64-bit targets pass a `va_list` that way).
static c::LLVMValueRef va_format_call(state::Emitter *e, state::Value *v, state::Ty result) {
    c::LLVMTypeRef pointer = state::pointer_type(e, 0);
    c::LLVMTypeRef params[4] = {pointer, c::LLVMInt64TypeInContext(e->context), pointer, pointer};
    c::LLVMValueRef args[4] = {v[0].llvm, coerced(e, v[1], 'z'), v[2].llvm, v[3].llvm};
    c::LLVMTypeRef type = c::LLVMFunctionType(result.llvm, params, 4, 0);
    c::LLVMValueRef function = c::LLVMGetNamedFunction(e->module, "vsnprintf");
    if (function == nullptr) function = c::LLVMAddFunction(e->module, "vsnprintf", type);
    return c::LLVMBuildCall2(e->builder, type, function, args, 4, "");
}

// `__builtin_clzll(x)`: `llvm.ctlz` (an undefined result for zero, as C), truncated to an int.
static c::LLVMValueRef count_zeros(state::Emitter *e, state::Value x, state::Ty result) {
    c::LLVMValueRef args[2] = {x.llvm, c::LLVMConstInt(c::LLVMInt1TypeInContext(e->context), 1, 0)};
    c::LLVMValueRef counted = named_intrinsic(e, "", "ctlz", "", x.ty.llvm, args, 2);
    return c::LLVMBuildTrunc(e->builder, counted, result.llvm, "clz");
}

// The ordering a call of `__atomic_exchange_n` or `__atomic_store_n` names in its third argument (the macro).
static c::LLVMAtomicOrdering memory_order(const ast::Expr *x) {
    if (x->kind != .call || countof(x->kind.call.args) != 3) return c::LLVMAtomicOrderingMonotonic;
    const ast::Expr *order = x->kind.call.args[2];
    if (order->kind != .name) return c::LLVMAtomicOrderingMonotonic;
    Str macro = order->kind.name.path.segments[0].text;
    if (state::same_text(macro, "__ATOMIC_ACQUIRE")) return c::LLVMAtomicOrderingAcquire;
    if (state::same_text(macro, "__ATOMIC_RELEASE")) return c::LLVMAtomicOrderingRelease;
    if (state::same_text(macro, "__ATOMIC_ACQ_REL")) return c::LLVMAtomicOrderingAcquireRelease;
    if (state::same_text(macro, "__ATOMIC_SEQ_CST")) return c::LLVMAtomicOrderingSequentiallyConsistent;
    return c::LLVMAtomicOrderingMonotonic;
}

// The value of the call, from its entry and its arguments' values (the type argument has none).
static c::LLVMValueRef lowered(state::Emitter *e, table::Entry entry, state::Value *v, Usize count, state::Ty result,
                               c::LLVMAtomicOrdering order) {
    c::LLVMValueRef args[2] = {v[0].llvm, v[1].llvm};
    switch (entry.shape) {
    case .overflow:
        return overflow(e, entry, v);
    case .bit_cast:
        return bit_cast(e, v[0], result);
    case .assume:
        return intrinsic(e, "llvm.assume", nullptr, args, 1);
    case .trap:
        return intrinsic(e, "llvm.trap", nullptr, nullptr, 0);
    case .float_unary:
        return named_intrinsic(e, "", entry.intrinsic, "", v[0].ty.llvm, args, 1);
    case .float_binary:
        return named_intrinsic(e, "", entry.intrinsic, "", v[0].ty.llvm, args, 2);
    case .absolute:
        return absolute(e, v[0]);
    case .smallest:
        return smallest(e, v[0], v[1]);
    case .predicate:
        return predicate(e, entry, v[0]);
    case .libc:
        return libc_call(e, entry, v, result);
    case .format:
        return format_call(e, entry, v, count, result);
    case .va_start:
    case .va_end:
        return va_lifetime(e, entry, v[0]);
    case .va_format:
        return va_format_call(e, v, result);
    case .frame_address: {
        c::LLVMValueRef depth[1] = {coerced(e, v[0], 'i')};
        return intrinsic(e, "llvm.frameaddress", state::pointer_type(e, 0), depth, 1);
    }
    case .count_zeros:
        return count_zeros(e, v[0], result);
    case .atomic_add:
        return c::LLVMBuildAtomicRMW(
            e->builder, c::LLVMAtomicRMWBinOpAdd, v[0].llvm,
            c::LLVMBuildIntCast2(e->builder, v[1].llvm, result.llvm, state::is_signed(v[1].ty) ? 1 : 0, ""),
            c::LLVMAtomicOrderingMonotonic, 0);
    case .atomic_exchange:
        return c::LLVMBuildAtomicRMW(
            e->builder, c::LLVMAtomicRMWBinOpXchg, v[0].llvm,
            c::LLVMBuildIntCast2(e->builder, v[1].llvm, result.llvm, state::is_signed(v[1].ty) ? 1 : 0, ""), order, 0);
    case .atomic_store: {
        state::Ty target = v[0].ty;
        if (!(target.kind == .pointer)) return nullptr;
        if (target.kind.pointer.element == nullptr) return nullptr;
        c::LLVMTypeRef element = target.kind.pointer.element->llvm;
        c::LLVMValueRef stored = c::LLVMBuildStore(
            e->builder, c::LLVMBuildIntCast2(e->builder, v[1].llvm, element, state::is_signed(v[1].ty) ? 1 : 0, ""),
            v[0].llvm);
        c::LLVMSetOrdering(stored, order);
        c::LLVMSetAlignment(stored, c::LLVMABIAlignmentOfType(e->target_data, element));
        return stored;
    }
    case .filled:
    case .alloc:
    case .type_query:
        return nullptr; // `filled` and `alloc` lower themselves; the checker decides a type question and keeps one
                        // branch
    case .constant:
        return c::LLVMConstRealOfStringAndSize(result.llvm, entry.intrinsic.data, 3);
    }
    return nullptr;
}

// The arguments' values are on the value stack, the first deepest.
static state::Status finish(state::Emitter *e, const state::ThenGeneral *w) {
    const ast::Expr *x = w->expr;
    table::Entry entry = {};
    if (!entry_of(x, &entry)) return state::fail("not a builtin", w->span);
    state::Ty result = {.kind = .record, .llvm = c::LLVMVoidTypeInContext(e->context), .name = "Void"};
    Bool no_value = entry.shape == .assume || entry.shape == .trap || entry.shape == .atomic_store ||
                    entry.shape == .va_start || entry.shape == .va_end ||
                    (entry.shape == .libc && table::libc_result(entry) == 'v');
    if (!no_value) {
        state::TyResult typed = state::type_of_node(e, x);
        if (typed == .error) return {.error = typed.error};
        result = typed.ok;
    }
    state::Value values[max_values] = {};
    for (Usize i = (Usize)w->number; i > 0; i--)
        values[i - 1] = state::pop_value(e);
    c::LLVMValueRef made = lowered(e, entry, values, (Usize)w->number, result, memory_order(x));
    state::push_value(e, (state::Value){.llvm = made, .ty = result});
    return state::success();
}

// Emits a call of a builtin: the value arguments are evaluated first to last, then `finish` lowers the call.
export state::Status call(state::Emitter *e, const ast::Expr *x) {
    table::Entry entry = {};
    if (x->kind != .call) return state::fail("not a call", x->span);
    ast::ExprRef args[:] = x->kind.call.args;
    if (!entry_of(x, &entry)) return state::fail("not a builtin call", x->span);
    Usize values = countof(args);
    for (Usize i = 0; i < countof(args); i++) {
        if (table::is_type_argument(entry, i)) values -= 1;
    }
    if (values > max_values)
        return state::failf(x->span, entry.name, " takes at most 8 arguments, the call has ", (U64)values);
    state::push_then_general(e, (state::ThenGeneral){.run = finish, .expr = x, .number = values, .span = x->span});
    for (Usize i = countof(args); i > 0; i--) {
        state::Hint hint = state::no_hint(); // the format of `__builtin_snprintf` is a C string, not a `str`
        if ((entry.shape == .format || entry.shape == .va_format) && i == 3) {
            state::Ty pointer = {.kind = {.pointer = {}}, .llvm = state::pointer_type(e, 0), .name = "Char *"};
            hint = state::hint_of(pointer);
        }
        Bool list = entry.shape == .va_format ? i == 4 : (entry.shape == .va_start || entry.shape == .va_end) && i == 1;
        if (list) {
            state::push_place(e, args[i - 1]); // the list is passed by its address
        } else if (!table::is_type_argument(entry, i - 1)) {
            state::push_eval(e, args[i - 1], hint);
        }
    }
    return state::success();
}

// ---------------------------------------------------------------------------------------------------------------
// `mem.alloc(T, n)` and `mem.alloc(T, [a, b])` (#2527): a bridge while lib/std/mem.smith is in today's syntax; #2539
// makes them an ordinary generic of mem.smith and deletes this.

// Whether the call `x` is `mem.alloc` or `arena.push_slice` with a size or a shape.
export Bool is_alloc(const state::Emitter *e, const ast::Expr *x) {
    return x->kind == .call && e->options.checked != nullptr &&
           table::names_alloc(e->options.checked, x->kind.call.callee, countof(x->kind.call.args));
}

// Whether the call `x` is `mem.zeroed(T)` of std.mem.
export Bool is_zeroed(const state::Emitter *e, const ast::Expr *x) {
    return x->kind == .call && e->options.checked != nullptr &&
           table::names_zeroed(e->options.checked, x->kind.call.callee, countof(x->kind.call.args));
}

// a * b, or the largest size when it overflows: no allocator has that many bytes, so std.mem refuses it by name.
static c::LLVMValueRef times_or_largest(state::Emitter *e, c::LLVMValueRef a, c::LLVMValueRef b) {
    c::LLVMTypeRef word = c::LLVMTypeOf(a);
    U32 id = c::LLVMLookupIntrinsicID("llvm.umul.with.overflow", 23);
    c::LLVMValueRef declaration = c::LLVMGetIntrinsicDeclaration(e->module, id, &word, 1);
    c::LLVMTypeRef type = c::LLVMIntrinsicGetType(e->context, id, &word, 1);
    c::LLVMValueRef args[2] = {a, b};
    c::LLVMValueRef pair = c::LLVMBuildCall2(e->builder, type, declaration, args, 2, "");
    c::LLVMValueRef over = c::LLVMBuildExtractValue(e->builder, pair, 1, "");
    return c::LLVMBuildSelect(e->builder, over, c::LLVMConstAllOnes(word),
                              c::LLVMBuildExtractValue(e->builder, pair, 0, ""), "");
}

// The sizes are on the value stack, the first deepest (under them the arena of `arena.push_slice`): one call of
// std.mem's `smith_mem_alloc_array` or std.arena's `smith_arena_push_array` (zeroed, never null) for their product,
// and the slice or block over it.
static state::Status alloc_finish(state::Emitter *e, const state::ThenGeneral *w) {
    state::TyResult typed = state::type_of_node(e, w->expr);
    if (typed == .error) return {.error = typed.error};
    state::Ty result = typed.ok;
    state::Ty *element = nullptr;
    if (result.kind == .slice) element = result.kind.slice.element;
    if (result.kind == .block) element = result.kind.block.element;
    if (element == nullptr || e->target_data == nullptr)
        return state::fail("mem.alloc makes a slice or a block", w->span);
    c::LLVMTypeRef counts = c::LLVMStructGetTypeAtIndex(result.llvm, 1);
    c::LLVMTypeRef word = result.kind == .slice ? counts : c::LLVMGetElementType(counts);
    c::LLVMValueRef sizes[16] = {};
    Usize rank = (Usize)w->number;
    if (rank == 0 || rank > 16) return state::fail("mem.alloc takes one to 16 sizes", w->span);
    for (Usize i = rank; i > 0; i--) {
        state::Value size = state::pop_value(e);
        sizes[i - 1] = c::LLVMBuildIntCast2(e->builder, size.llvm, word, state::is_signed(size.ty) ? 1 : 0, "");
    }
    Bool with_arena = w->expr->kind == .call && countof(w->expr->kind.call.args) == 3; // `arena.push_slice(&a, T, n)`
    c::LLVMValueRef in = with_arena ? state::pop_value(e).llvm : nullptr;
    c::LLVMValueRef total = sizes[0];
    for (Usize i = 1; i < rank; i++)
        total = times_or_largest(e, total, sizes[i]);
    c::LLVMTypeRef cell = element->llvm;

    c::LLVMValueRef all[4] = {in, c::LLVMConstInt(word, c::LLVMABISizeOfType(e->target_data, cell), 0), total,
                              c::LLVMConstInt(word, c::LLVMABIAlignmentOfType(e->target_data, cell), 0)};
    c::LLVMTypeRef params[4] = {state::pointer_type(e, 0), word, word, word};
    U32 skip = with_arena ? 0 : 1;
    c::LLVMTypeRef type = c::LLVMFunctionType(state::pointer_type(e, 0), &params[skip], 4 - skip, 0);
    const char *name = with_arena ? "smith_arena_push_array" : "smith_mem_alloc_array";
    c::LLVMValueRef function = c::LLVMGetNamedFunction(e->module, name);
    if (function == nullptr) function = c::LLVMAddFunction(e->module, name, type);
    c::LLVMValueRef data = c::LLVMBuildCall2(e->builder, type, function, &all[skip], 4 - skip, "");
    c::LLVMValueRef made = c::LLVMBuildInsertValue(e->builder, c::LLVMGetUndef(result.llvm), data, 0, "");
    c::LLVMValueRef count = sizes[0];
    if (result.kind == .block) {
        count = c::LLVMGetUndef(counts);
        for (Usize i = 0; i < rank; i++)
            count = c::LLVMBuildInsertValue(e->builder, count, sizes[i], (U32)i, "");
    }
    made = c::LLVMBuildInsertValue(e->builder, made, count, 1, "");
    state::push_value(e, (state::Value){.llvm = made, .ty = result});
    return state::success();
}

// Emits `mem.alloc(T, n)` or `mem.alloc(T, [a, b])`: the sizes first to last, then `alloc_finish`; the arena of
// `arena.push_slice(&a, T, n)` before them.
export state::Status shaped_alloc(state::Emitter *e, const ast::Expr *x) {
    if (x->kind != .call || countof(x->kind.call.args) < 2) return state::fail("not a call of mem.alloc", x->span);
    ast::ExprRef args[:] = x->kind.call.args;
    const ast::Expr *shape = args[countof(args) - 1];
    Usize rank = shape->kind == .array_lit ? countof(shape->kind.array_lit.items) : 1;
    state::push_then_general(e, (state::ThenGeneral){.run = alloc_finish, .expr = x, .number = rank, .span = x->span});
    for (Usize i = rank; i > 0; i--)
        state::push_eval(e, shape->kind == .array_lit ? shape->kind.array_lit.items[i - 1] : shape, state::no_hint());
    if (countof(args) == 3) state::push_eval(e, args[0], state::no_hint());
    return state::success();
}

// ---------------------------------------------------------------------------------------------------------------
// `array.filled(T, n, value)` (#2339)

// Whether the call `x` is one of `array.filled`: the checker recorded its length `n` on the call.
export Bool is_filled(const state::Emitter *e, const ast::Expr *x) {
    U64 count = 0;
    return x->kind == .call && e->options.checked != nullptr && countof(x->kind.call.args) == 3 &&
           types::length_of(e->options.checked, x, &count);
}

// The expression of the value `array.filled` repeats.
export const ast::Expr *filled_value(const ast::Expr *x) {
    if (x->kind != .call) return nullptr;
    return x->kind.call.args[2];
}

// The cells of a constant array, a struct so that `mem::alloc_slice` takes it.
export struct Cells {
    c::LLVMValueRef item;
};

// The array types `array.filled` fills, outermost first: `[5, 64]char` is `[5][64]char`, two entries, the last one
// whose element is the type of the value (`char`). The nested form `array.filled([64]char, 5, ...)` has one.
export Usize filled_chain(state::Emitter *e, const ast::Expr *x, state::SizedTy array, state::SizedTy *chain) {
    state::TyResult typed = state::type_of_node(e, filled_value(x));
    Usize n = 0;
    state::SizedTy at = array;
    while (n < 16) {
        chain[n] = at;
        n += 1;
        state::Ty inner = *at.element;
        if (typed == .error || inner.kind != .array || state::same_type(inner, typed.ok)) break;
        at = inner.kind.array;
    }
    return n;
}

// The constant array of the chain with `item` in every cell of the last dimension.
export c::LLVMValueRef filled_nest(const state::SizedTy *chain, Usize n, c::LLVMValueRef item) {
    c::LLVMValueRef made = item;
    for (Usize d = n; d > 0; d--) {
        Cells cells[:] = mem::alloc_slice(Cells, chain[d - 1].count);
        for (Usize i = 0; i < chain[d - 1].count; i++)
            cells[i].item = made;
        made = c::LLVMConstArray2(chain[d - 1].element->llvm, (c::LLVMValueRef *)cells.data, chain[d - 1].count);
        mem::free(cells.data);
    }
    return made;
}

// The array: a constant when the value is one (all zero is the null constant, any other a repeat), else a loop that
// stores the value into every cell of a slot, read back as the array.
static state::Status filled_finish(state::Emitter *e, const state::ThenGeneral *w) {
    state::Ty array = w->ty;
    if (array.kind != .array) return state::fail("array.filled is not an array", w->span);
    state::SizedTy chain[16];
    Usize n = filled_chain(e, w->expr, array.kind.array, chain);
    state::Ty leaf = *chain[n - 1].element;
    Usize total = 1;
    for (Usize d = 0; d < n; d++)
        total *= chain[d].count;
    state::Value item = state::pop_value(e);
    if (!state::same_type(item.ty, leaf)) {
        try state::convert(e, item, leaf, w->span, .initialize);
        item = state::pop_value(e);
    }
    if (c::LLVMIsConstant(item.llvm) != 0) {
        if (c::LLVMIsNull(item.llvm) != 0) {
            state::push_value(e, (state::Value){.llvm = c::LLVMConstNull(array.llvm), .ty = array});
            return state::success();
        }
        state::push_value(e, (state::Value){.llvm = filled_nest(chain, n, item.llvm), .ty = array});
        return state::success();
    }
    c::LLVMValueRef slot = state::new_alloca(e, array, "filled");
    c::LLVMTypeRef word = c::LLVMInt64TypeInContext(e->context);
    state::Ty counter = {.kind = {.integer = {.bits = 64}}, .llvm = word, .name = "U64"};
    c::LLVMValueRef at = state::new_alloca(e, counter, "at");
    c::LLVMBuildStore(e->builder, c::LLVMConstInt(word, 0, 0), at);
    c::LLVMBasicBlockRef test = c::LLVMAppendBasicBlockInContext(e->context, e->function, "fill.test");
    c::LLVMBasicBlockRef body = c::LLVMAppendBasicBlockInContext(e->context, e->function, "fill.body");
    c::LLVMBasicBlockRef done = c::LLVMAppendBasicBlockInContext(e->context, e->function, "fill.done");
    c::LLVMBuildBr(e->builder, test);
    c::LLVMPositionBuilderAtEnd(e->builder, test);
    c::LLVMValueRef index = c::LLVMBuildLoad2(e->builder, word, at, "i");
    c::LLVMValueRef more = c::LLVMBuildICmp(e->builder, c::LLVMIntULT, index, c::LLVMConstInt(word, total, 0), "more");
    c::LLVMBuildCondBr(e->builder, more, body, done);
    c::LLVMPositionBuilderAtEnd(e->builder, body);
    c::LLVMValueRef place = c::LLVMBuildInBoundsGEP2(e->builder, leaf.llvm, slot, &index, 1, "cell");
    c::LLVMBuildStore(e->builder, item.llvm, place);
    c::LLVMBuildStore(e->builder, c::LLVMBuildAdd(e->builder, index, c::LLVMConstInt(word, 1, 0), "next"), at);
    c::LLVMBuildBr(e->builder, test);
    c::LLVMPositionBuilderAtEnd(e->builder, done);
    state::push_value(e, (state::Value){.llvm = c::LLVMBuildLoad2(e->builder, array.llvm, slot, "array"), .ty = array});
    return state::success();
}

// Emits `array.filled(T, n, value)` as a value of the array type the checker gave the call.
export state::Status filled(state::Emitter *e, const ast::Expr *x) {
    state::TyResult typed = state::type_of_node(e, x);
    if (typed == .error) return {.error = typed.error};
    state::Ty array = typed.ok;
    if (array.kind != .array) return state::fail("array.filled is not an array", x->span);
    state::push_then_general(e, (state::ThenGeneral){.run = filled_finish, .expr = x, .ty = array, .span = x->span});
    state::SizedTy chain[16];
    Usize n = filled_chain(e, x, array.kind.array, chain);

    state::push_eval(e, filled_value(x), state::hint_of(*chain[n - 1].element));
    return state::success();
}
