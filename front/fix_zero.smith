// front::fix_zero, the fix-it for the empty list of a struct (#2224, decided on #1406): `P x = {}` of C is `x: P =
// {}` after the declaration's own fix, and `{}` with no type has no form in smith.
//
//   x: P = {}                  x: P = P(a = 0, p = nullptr)         every field given, zero values from the types
//   mut x: P = {}              mut x: P = undefined                 when the statements right after the declaration, in
//   x.a = 1                    x.a = 1                              the same block, assign every field by name and
//   x.p = q                    x.p = q                              none reads `x`
//
// A zero value is written for a number (`0`, `0.0`), a `Bool`, a pointer, an enum's variant of value 0 (`.empty`), an
// array of those (`[0, 0]`, up to `array_limit` elements) and a struct of those, one level down (three for the element
// of `T xs[n] = {}`, which becomes `array.filled(T, n, zero)` with `import std.array` added once, #2385). A struct with
// any other field (an enum with no variant of value 0, a slice, a union, a struct two levels down) keeps its warning:
// it needs a spelling smith has not settled. A
// list that has no struct type (`struct smith_array_T_n`, `typeof(xs)`) is left alone too.
//
// A construction that leaves fields out, `E(k = k)` (from the C list `(E){.k = k}`), is `E(k = k, s = S(a = 0, b = 0))`
// (#2329, decided on #1406): C zeroes the fields a list does not name, and smith's construction demands them. The
// checker records the call (`Error.left_out_call`) and this pass writes the text; a field with no zero spelling (above)
// keeps its error.
//
//   fix_zero::edits(module, checked)   one fix for each declaration whose initializer is `{}` of a struct
module front::fix_zero;

import front::ast;
import front::lex;
import front::parse as core;
import front::types;
import std::arena;
import std::format;
import std::mem;

constexpr Usize array_limit = 64;

struct Work {
    const ast::Stmt *items[:];
    Usize top;
};

static void push(Work *w, const ast::Stmt *stmt) {
    if (stmt == nullptr) return;
    if (w->top == countof(w->items)) {
        Usize capacity = countof(w->items) * 2;
        if (capacity < 32) capacity = 32;
        w->items = mem::realloc(w->items, capacity);
    }
    w->items[w->top] = stmt;
    w->top += 1;
}

static void push_children(Work *w, const ast::Stmt *s) {
    if (s->kind == .block) {
        for (Usize i = countof(s->kind.block.items); i > 0; i--)
            push(w, s->kind.block.items[i - 1]);
    } else if (s->kind == .if_stmt) {
        push(w, s->kind.if_stmt.then_branch);
        push(w, s->kind.if_stmt.else_branch);
    } else if (s->kind == .while_stmt) {
        push(w, s->kind.while_stmt.body);
    } else if (s->kind == .do_while) {
        push(w, s->kind.do_while.body);
    } else if (s->kind == .for_stmt) {
        push(w, s->kind.for_stmt.body);
    } else if (s->kind == .for_in) {
        push(w, s->kind.for_in.body);
    } else if (s->kind == .if_let) {
        push(w, s->kind.if_let.then_branch);
        push(w, s->kind.if_let.else_branch);
    } else if (s->kind == .defer_stmt) {
        push(w, s->kind.defer_stmt.body);
    } else if (s->kind == .errdefer_stmt) {
        push(w, s->kind.errdefer_stmt.body);
    } else if (s->kind == .labeled) {
        push(w, s->kind.labeled.body);
    } else if (s->kind == .switch_stmt) {
        for (Usize i = 0; i < countof(s->kind.switch_stmt.cases); i++) {
            ast::StmtRef body[:] = s->kind.switch_stmt.cases[i].body;
            for (Usize k = 0; k < countof(body); k++)
                push(w, body[k]);
        }
    }
}

static Bool same(Str a, Str b) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// Whether a field can be named in `T(f = 0)`: a keyword of smith's own syntax (`in`) cannot.
static Bool nameable(Str field) {
    lex::Lexed lexed = lex::tokenize_new(field);
    if (lexed == .error) return false;
    Bool ok = countof(lexed.ok) > 0 && lexed.ok[0].kind == lex::name;
    mem::free(lexed.ok.data);
    return ok;
}

// The zero value of an enumeration with no payloads: the variant whose value is 0, `.empty` (lead, 2026-11-05, #2488).
// By value, not by position: with no such variant it is empty, and the error stays.
static Str enum_zero(types::TypeRef t) {
    if (t->kind != .enumeration || t->has_payload) return "";
    for (Usize i = 0; i < countof(t->slots); i++)
        if (t->slots[i].value == 0) return types::message_of(format::push(".", t->slots[i].name));
    return "";
}

// The zero value of a type that is a number, a `Bool`, a pointer or a slice (`[]`); empty for any other.
static Str scalar_zero(types::TypeRef t) {
    if (t->kind == .integer) return "0";
    if (t->kind == .floating) return "0.0";
    if (t->kind == .bool_type) return "false";
    if (t->kind == .pointer) return "nullptr";
    if (t->kind == .slice) return "[]"; // the empty slice literal, typed by the field (owner, 2026-11-05, #2460)
    return enum_zero(t);
}

// The zero value of a scalar or of an array of scalars; empty for any other.
static Str flat_zero(types::TypeRef t) {
    Str one = scalar_zero(t);
    if (countof(one) > 0) return one;
    if (t->kind != .array || t->count == 0 || t->count > array_limit) return "";
    Str item = scalar_zero(t->element);
    if (countof(item) == 0) return "";
    Str out = "[";
    for (Usize i = 0; i < t->count; i++)
        out = types::message_of(format::push(out, i > 0 ? ", " : "", item));
    return types::message_of(format::push(out, "]"));
}

// `T(a = 0, inner = U(x = 0))`: a struct whose fields are numbers, `Bool`s, pointers, arrays of those and structs of
// the same, one, two or three structs deep (a C struct such as `LLVMOrcCSymbolMapPair` is three). No recursion is
// allowed, so each level is a function that calls the one below it.
static Str construct_one(Str name, types::TypeRef t) {
    if (t->kind != .record || t->is_union || !t->complete || countof(t->slots) == 0) return "";
    Str out = types::message_of(format::push(name, "("));
    for (Usize i = 0; i < countof(t->slots); i++) {
        types::TypeRef field = t->slots[i].type;
        Str zero = flat_zero(field);
        if (countof(zero) == 0) zero = "";
        if (countof(zero) == 0 || !nameable(t->slots[i].name)) return "";
        out = types::message_of(format::push(out, i > 0 ? ", " : "", t->slots[i].name, " = ", zero));
    }
    return types::message_of(format::push(out, ")"));
}

static Str construct_two(Str name, types::TypeRef t) {
    if (t->kind != .record || t->is_union || !t->complete || countof(t->slots) == 0) return "";
    Str out = types::message_of(format::push(name, "("));
    for (Usize i = 0; i < countof(t->slots); i++) {
        types::TypeRef field = t->slots[i].type;
        Str zero = flat_zero(field);
        if (countof(zero) == 0) zero = construct_one(types::show(field), field);
        if (countof(zero) == 0 || !nameable(t->slots[i].name)) return "";
        out = types::message_of(format::push(out, i > 0 ? ", " : "", t->slots[i].name, " = ", zero));
    }
    return types::message_of(format::push(out, ")"));
}

static Str construct_three(Str name, types::TypeRef t) {
    if (t->kind != .record || t->is_union || !t->complete || countof(t->slots) == 0) return "";
    Str out = types::message_of(format::push(name, "("));
    for (Usize i = 0; i < countof(t->slots); i++) {
        types::TypeRef field = t->slots[i].type;
        Str zero = flat_zero(field);
        if (countof(zero) == 0) zero = construct_two(types::show(field), field);
        if (countof(zero) == 0 || !nameable(t->slots[i].name)) return "";
        out = types::message_of(format::push(out, i > 0 ? ", " : "", t->slots[i].name, " = ", zero));
    }
    return types::message_of(format::push(out, ")"));
}

static Str construct(Str name, types::TypeRef t) {
    return construct_two(name, t);
}

// The zero value of an element type as the file writes it (`char`, `bool`, `u8`, `f64`), for when the checker did not
// resolve the element (`char` is a C type to it until the file is converted); empty for any other.
static Str written_zero(Str element) {
    if (same(element, "char")) return "0";
    if (same(element, "bool")) return "false";
    if (same(element, "f32") || same(element, "f64")) return "0.0";
    if (same(element, "isize") || same(element, "usize")) return "0";
    if (countof(element) < 2 || (element[0] != 'i' && element[0] != 'u')) return "";
    for (Usize i = 1; i < countof(element); i++) {
        if (element[i] < '0' || element[i] > '9') return "";
    }
    return "0";
}

// `array.filled(P, 12, P(...))` for an array of structs (#2385, decided on #1406): C zeroes `P xs[12] = {}` and smith
// has no zero value, so the one zero element is written out and `std.array` fills the rest. `element` is the element
// type as the file writes it; empty for any other array, or a struct that cannot be filled.
static Str construct_array(Str element, types::TypeRef t) {
    if (t->kind != .array || t->count == 0) return "";
    // a number, `Bool` or pointer element is its own zero: `static char buf[named_length]` (#1901)
    Str one = scalar_zero(t->element);
    if (countof(one) == 0) one = written_zero(element);
    if (countof(one) == 0) one = construct_three(element, t->element);
    if (countof(one) == 0) return "";
    return types::message_of(format::push("array.filled(", element, ", ", t->count, ", ", one, ")"));
}

// The text that gives the fields of `record` that `given` marks not (and that have no default) their zero values,
// each after a comma: `, b = 0, c = nullptr`. Empty when a field cannot be given.
static Str omitted(types::TypeRef record, U64 given) {
    if (record->kind != .record || record->is_union || !record->complete) return "";
    Str out = "";
    for (Usize k = 0; k < countof(record->slots); k++) {
        if ((given & ((U64)1 << k)) != 0 || record->slots[k].default_value != nullptr) continue;
        types::TypeRef field = record->slots[k].type;
        Str zero = flat_zero(field);
        if (countof(zero) == 0) zero = construct_one(types::show(field), field);
        if (countof(zero) == 0 || !nameable(record->slots[k].name)) return "";
        out = types::message_of(format::push(out, ", ", record->slots[k].name, " = ", zero));
    }
    return out;
}

// The fix of the construction `e` that leaves fields out: their zero values after the last argument.
static core::ParseError left_out_fix(const ast::Expr *e, types::TypeRef record, U64 given) {
    core::ParseError none = {};
    Str text = omitted(record, given);
    if (countof(text) == 0 || !(e->kind == .call)) return none;
    ast::ExprRef args[:] = e->kind.call.args;
    U32 at = e->span.end - 1; // before the `)`
    if (countof(args) > 0) {
        at = args[countof(args) - 1]->span.end;
    } else {
        text = text[2:countof(text)];
    }
    core::Edits fix = {};
    fix = mem::realloc(fix, 1);
    fix[0] = (core::Edit){.span = {.start = at, .end = at}, .text = text};
    core::ParseError found = {};
    found.span = e->span;
    found.message = "a construction that leaves fields out gives them their zero values";
    found.fix = fix;
    return found;
}

// Whether `text` holds `name` as a whole word.
static Bool mentions(Str text, Str name) {
    Usize n = countof(name);
    if (n == 0) return false;
    for (Usize i = 0; i + n <= countof(text); i++) {
        if (!same(text[i:i + n], name)) continue;
        Bool before =
            i > 0 && (text[i - 1] == '_' || (text[i - 1] >= 'a' && text[i - 1] <= 'z') ||
                      (text[i - 1] >= 'A' && text[i - 1] <= 'Z') || (text[i - 1] >= '0' && text[i - 1] <= '9'));
        Usize e = i + n;
        Bool after = e < countof(text) && (text[e] == '_' || (text[e] >= 'a' && text[e] <= 'z') ||
                                           (text[e] >= 'A' && text[e] <= 'Z') || (text[e] >= '0' && text[e] <= '9'));
        if (!before && !after) return true;
    }
    return false;
}

// The index of the field that the statement `x.f = v` assigns, when it is one and `v` does not mention `x`; else the
// number of fields.
static Usize assigned_field(Str source, const ast::Stmt *s, Str name, types::TypeRef t) {
    Usize none = countof(t->slots);
    if (s->kind != .expression) return none;
    const ast::Expr *e = s->kind.expression.value;
    if (e == nullptr || e->kind != .assign || e->kind.assign.op != .plain) return none;
    const ast::Expr *target = e->kind.assign.target;
    if (target->kind != .member || target->kind.member.arrow) return none;
    const ast::Expr *base = target->kind.member.base;
    if (base->kind != .name || countof(base->kind.name.path.segments) != 1) return none;
    if (!same(base->kind.name.path.segments[0].text, name)) return none;
    const ast::Expr *value = e->kind.assign.value;
    if (value == nullptr || mentions(source[value->span.start:value->span.end], name)) return none;
    for (Usize i = 0; i < countof(t->slots); i++) {
        if (same(t->slots[i].name, target->kind.member.name)) return i;
    }
    return none;
}

// Whether the statements after `items[at]` assign every field of `t` by name before anything else.
static Bool written_first(Str source, ast::StmtRef items[:], Usize at, Str name, types::TypeRef t) {
    Usize total = countof(t->slots);
    if (total > 64) return false;
    U64 seen = 0;
    Usize covered = 0;
    for (Usize k = at + 1; k < countof(items) && covered < total; k++) {
        Usize field = assigned_field(source, items[k], name, t);
        if (field == total) return false;
        if ((seen & ((U64)1 << field)) != 0) return false;
        seen |= (U64)1 << field;
        covered += 1;
    }
    return covered == total;
}

// Whether `e` is `{}`: an empty list with no type, or (in braces, new syntax) an empty block used as a value.
static Bool is_empty_braces(const ast::Expr *e) {
    if (e->kind == .compound) return e->kind.compound.type == nullptr && countof(e->kind.compound.items) == 0;
    if (e->kind != .stmt_expr) return false;
    const ast::Stmt *s = e->kind.stmt_expr.stmt;
    return s != nullptr && s->kind == .block && countof(s->kind.block.items) == 0;
}

constexpr Usize no_block = ~(Usize)0;

// The fix of the variable `d`, which is `items[at]` of a block (`at` is `no_block` for a global).
static core::ParseError fix_of(Str source, types::Checked *c, const ast::Decl *d, ast::StmtRef items[:], Usize at,
                               Bool *filled) {
    core::ParseError none = {};
    if (d->kind != .variable) return none;
    const ast::Expr *init = d->kind.variable.init;
    ast::TypeExpr *written = d->kind.variable.type;
    if (init == nullptr || written == nullptr || !is_empty_braces(init)) return none;
    // The declared type: in braces (`x: P = {}` before the blocks are indented) `{}` reads as an empty block, so
    // the initializer has no type of its own. Resolving it again must not leave an error behind.
    Usize errors_before = c->error_count;
    // The element `char` is a C type until the file is converted, so it is read as the new spelling (#1901).
    Bool was_new = c->new_syntax;
    c->new_syntax = true;
    types::TypeRef t = types::resolve(c, written);
    c->new_syntax = was_new;
    c->error_count = errors_before;
    if (t == nullptr || (t->kind != .record && t->kind != .array)) return none;
    Str name = d->kind.variable.name;
    Str text = "";
    if (t->kind == .array) {
        Str written_text = source[written->span.start:written->span.end];
        Usize close = 0;
        while (close < countof(written_text) && written_text[close] != ']')
            close += 1;
        if (close + 1 < countof(written_text)) text = construct_array(written_text[close + 1:countof(written_text)], t);
        if (countof(text) > 0) *filled = true;
    } else if (at != no_block && d->kind.variable.is_new && written->span.end > written->span.start &&
               written_first(source, items, at, name, t)) {
        text = "undefined";
    } else {
        text = construct(source[written->span.start:written->span.end], t);
    }
    if (countof(text) == 0) return none;
    core::Edits edits = {};
    edits = mem::realloc(edits, 1);
    edits[0] = (core::Edit){.span = init->span, .text = text};
    core::ParseError found = {};
    found.span = init->span;
    found.message = "an empty `{}` of a struct is written out";
    found.fix = edits;
    return found;
}

static core::Errors add(core::Errors out, core::ParseError found) {
    if (countof(found.fix) == 0) return out;
    out = mem::realloc(out, countof(out) + 1);
    out[countof(out) - 1] = found;
    return out;
}

// Whether the module imports `std.array` (`import std.array`, `import std::array;`, with or without an alias).
static Bool imports_array(const ast::Module *module) {
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind != .import_module) continue;
        ast::Identifier segments[:] = d->kind.import_module.path.segments;
        if (countof(segments) == 2 && same(segments[0].text, "std") && same(segments[1].text, "array")) return true;
    }
    return false;
}

// The fix that adds `import std.array` once, in front of the module's first import (or its first declaration).
static core::ParseError import_array(const ast::Module *module) {
    core::ParseError none = {};
    if (imports_array(module) || countof(module->decls) == 0) return none;
    const ast::Decl *first = module->decls[0];
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind == .import_module) {
            first = d;
            break;
        }
    }
    ast::Span at = {.start = first->span.start, .end = first->span.start};
    core::Edits edits = {};
    edits = mem::realloc(edits, 1);
    Str line = "import std.array\n";
    edits[0] = (core::Edit){.span = at, .text = line};
    core::ParseError found = {};
    found.span = at;
    found.message = "`array.filled` needs `import std.array`";
    found.fix = edits;
    return found;
}

// `front.ast.Span` as the file names it: `ast.Span` when it imports `front::ast` (or the alias it gave it). The types
// print with the module's whole path (#2460).
static Str local_names(const ast::Module *module, Str text) {
    for (Usize d_index = 0; d_index < 2; d_index++) {
        Str divider = ".";
        if (d_index == 1) divider = "::";
        for (Usize i = 0; i < countof(module->decls); i++) {
            const ast::Decl *d = module->decls[i];
            if (d->kind != .import_module) continue;
            ast::Identifier segments[:] = d->kind.import_module.path.segments;
            if (countof(segments) < 2) continue;
            Str whole = "";
            for (Usize k = 0; k < countof(segments); k++)
                whole = types::message_of(format::push(whole, segments[k].text, divider));
            Str local = d->kind.import_module.alias;
            if (countof(local) == 0) local = segments[countof(segments) - 1].text;
            Str out = "";
            Usize at = 0;
            for (Usize j = 0; j + countof(whole) <= countof(text); j++) {
                Bool word =
                    j > 0 && (text[j - 1] == '_' || text[j - 1] == '.' || (text[j - 1] >= 'a' && text[j - 1] <= 'z') ||
                              (text[j - 1] >= 'A' && text[j - 1] <= 'Z') || (text[j - 1] >= '0' && text[j - 1] <= '9'));
                if (word || !same(text[j:j + countof(whole)], whole)) continue;
                out = types::message_of(format::push(out, text[at:j], local, divider));
                at = j + countof(whole);
                j = at - 1;
            }
            if (at > 0) text = types::message_of(format::push(out, text[at:countof(text)]));
        }
    }
    return text;
}

// Writes every fix of `errors` with the names the file gives its modules.
static void localize(const ast::Module *module, core::Errors errors) {
    for (Usize i = 0; i < countof(errors); i++) {
        core::Edits fix = errors[i].fix;
        for (Usize k = 0; k < countof(fix); k++)
            fix[k].text = local_names(module, fix[k].text);
    }
}

// The fixes of the module's `{}` declarations, as errors that carry them (the driver applies them with the rest).
export core::Errors edits(Str source, const ast::Module *module, types::Checked *c) {
    core::Errors out = {};
    const ast::Expr *last = nullptr;
    for (Usize i = 0; i < c->error_count; i++) {
        types::Error error = c->errors[i];
        if (error.left_out_call == nullptr || error.left_out_call == last) continue;
        last = error.left_out_call;
        out = add(out, left_out_fix(error.left_out_call, error.left_out_record, error.left_out_given));
    }
    Bool filled = false;
    Work w = {};
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind == .function) push(&w, d->kind.function.body);
        if (d->kind == .variable) {
            ast::StmtRef none[:] = {};
            out = add(out, fix_of(source, c, d, none, no_block, &filled));
        }
    }
    while (w.top > 0) {
        w.top -= 1;
        const ast::Stmt *s = w.items[w.top];
        if (s->kind == .block) {
            ast::StmtRef items[:] = s->kind.block.items;
            for (Usize i = 0; i < countof(items); i++) {
                const ast::Stmt *item = items[i];
                if (item->kind == .declaration)
                    out = add(out, fix_of(source, c, item->kind.declaration.decl, items, i, &filled));
            }
        }
        push_children(&w, s);
    }
    if (filled) out = add(out, import_array(module));
    localize(module, out);
    return out;
}
