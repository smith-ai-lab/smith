// front::fix_zero, the fix-it for the empty list of a struct (#2224, decided on #1406): `P x = {}` of C is `x: P =
// {}` after the declaration's own fix, and `{}` with no type has no form in smith.
//
//   x: P = {}                  x: P = P(a = 0, p = nullptr)         every field given, zero values from the types
//   mut x: P = {}              mut x: P = undefined                 when the statements right after the declaration, in
//   x.a = 1                    x.a = 1                              the same block, assign every field by name and
//   x.p = q                    x.p = q                              none reads `x`
//
// A zero value is written for a number (`0`, `0.0`), a `Bool`, a pointer, an enum's variant of value 0 (`.empty`), an
// array of those (`[0, 0]`, up to `array_limit` elements) and a struct of those, one level down (three for the element
// of `T xs[n] = {}`, which becomes `array.filled(T, n, zero)` with `import std.array` added once, #2385). A struct with
// any other field (an enum with no variant of value 0, a slice, a union, a struct two levels down) keeps its warning:
// it needs a spelling smith has not settled. A
// list that has no struct type (`struct smith_array_T_n`, `typeof(xs)`) is left alone too.
//
// A construction that leaves fields out, `E(k = k)` (from the C list `(E){.k = k}`), is `E(k = k, s = S(a = 0, b = 0))`
// (#2329, decided on #1406): C zeroes the fields a list does not name, and smith's construction demands them. The
// checker records the call (`Error.left_out_call`) and this pass writes the text; a field with no zero spelling (above)
// keeps its error.
//
//   fix_zero::edits(module, checked)   one fix for each declaration whose initializer is `{}` of a struct
module front::fix_zero;

import front::ast;
import front::fix_optional;
import front::lex;
import front::parse as core;
import front::types;
import std::arena;
import std::contract;
import std::files;
import std::format;
import std::mem;
import <stdlib.h>;

constexpr Usize array_limit = 64;

struct Work {
    const ast::Stmt *items[:];
    Usize top;
};

static void push(Work *w, const ast::Stmt *stmt) {
    if (stmt == nullptr) return;
    if (w->top == countof(w->items)) {
        Usize capacity = countof(w->items) * 2;
        if (capacity < 32) capacity = 32;
        w->items = mem::realloc(w->items, capacity);
    }
    w->items[w->top] = stmt;
    w->top += 1;
}

static void push_children(Work *w, const ast::Stmt *s) {
    if (s->kind == .block) {
        for (Usize i = countof(s->kind.block.items); i > 0; i--)
            push(w, s->kind.block.items[i - 1]);
    } else if (s->kind == .if_stmt) {
        push(w, s->kind.if_stmt.then_branch);
        push(w, s->kind.if_stmt.else_branch);
    } else if (s->kind == .while_stmt) {
        push(w, s->kind.while_stmt.body);
    } else if (s->kind == .do_while) {
        push(w, s->kind.do_while.body);
    } else if (s->kind == .for_stmt) {
        push(w, s->kind.for_stmt.body);
    } else if (s->kind == .for_in) {
        push(w, s->kind.for_in.body);
    } else if (s->kind == .if_let) {
        push(w, s->kind.if_let.then_branch);
        push(w, s->kind.if_let.else_branch);
    } else if (s->kind == .defer_stmt) {
        push(w, s->kind.defer_stmt.body);
    } else if (s->kind == .errdefer_stmt) {
        push(w, s->kind.errdefer_stmt.body);
    } else if (s->kind == .labeled) {
        push(w, s->kind.labeled.body);
    } else if (s->kind == .switch_stmt) {
        for (Usize i = 0; i < countof(s->kind.switch_stmt.cases); i++) {
            ast::StmtRef body[:] = s->kind.switch_stmt.cases[i].body;
            for (Usize k = 0; k < countof(body); k++)
                push(w, body[k]);
        }
    }
}

static Bool same(Str a, Str b) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// Whether a field can be named in `T(f = 0)`: a keyword of smith's own syntax (`in`) cannot.
static Bool nameable(Str field) {
    // read where it is written, as an argument name: `module` and `type` are names there (`Error(module = "")`)
    lex::Lexed lexed = lex::tokenize_new(types::message_of(format::push("(", field, " = 0)")));
    if (lexed == .error) return false;
    Bool ok = countof(lexed.ok) > 3 && lexed.ok[1].kind == lex::name;
    mem::free(lexed.ok.data);
    return ok;
}

// The zero value of an enumeration with no payloads: the variant whose value is 0, `.empty` (lead, 2026-11-05, #2488).
// By value, not by position: with no such variant it is empty, and the error stays.
static Str enum_zero(types::TypeRef t) {
    if (t->kind != .enumeration || types::is_payload_enum(t)) return "";
    for (Usize i = 0; i < countof(types::slots_of(t).items); i++)
        if (types::slots_of(t).items[i].value == 0)
            return types::message_of(format::push(".", types::slots_of(t).items[i].name));
    return "";
}

// The zero value of a type that is a number, a `Bool`, a pointer or a slice (`[]`); empty for any other.
static Str scalar_zero(types::TypeRef t) {
    if (t->kind == .integer) return "0";
    if (t->kind == .floating) return "0.0";
    if (t->kind == .bool_type) return "false";
    // a C function pointer is null like a pointer
    if (t->kind == .pointer || t->kind == .function || t->kind == .fn_value) return "nullptr";
    if (t->kind == .slice) return "[]";  // the empty slice literal, typed by the field (owner, 2026-11-05, #2460)
    if (t->kind == .text) return "\"\""; // a smith struct from another module holds `str` (`ast.Place`, #2648)
    return enum_zero(t);
}

// The zero value of a scalar or of an array of scalars; empty for any other.
static Str flat_zero(types::TypeRef t) {
    Str one = scalar_zero(t);
    if (countof(one) > 0) return one;
    if (t->kind != .array || types::count_of(t) == 0 || types::count_of(t) > array_limit) return "";
    Str item = scalar_zero(types::element_of(t));
    if (countof(item) == 0) return "";
    Str out = "[";
    for (Usize i = 0; i < types::count_of(t); i++)
        out = types::message_of(format::push(out, i > 0 ? ", " : "", item));
    return types::message_of(format::push(out, "]"));
}

// The checker and the module of the file being fixed, for `nested_name`; set while `edits` runs.
static types::Checked *naming = nullptr;
static const ast::Module *naming_module = nullptr;

// Whether `binding.name` names the type that `types::show` writes as `whole`.
static Bool names_the_type(Str binding, Str name, Str whole) {
    if (countof(binding) == 0) return false;
    Str path = types::message_of(format::push(binding, "::", name));
    Usize errors_before = naming->error_count;
    Bool was_new = naming->new_syntax;
    naming->new_syntax = true;
    types::TypeRef found = types::resolve(naming, ast::named(path));
    naming->new_syntax = was_new;
    naming->error_count = errors_before;
    return found != nullptr && same(types::show(found), whole); // an alias is another ref of the type
}

// How the file names the struct `t` of a field of the struct it wrote as `outer`: `types::show` gives the module's
// whole path (`front.emit_state.Target`), which the file may not import, so a struct of another module is named
// through a module the file imports when that name is the same type: the outer's own module first (`emit.Target`, an
// alias `emit` exports), then each import (#3027).
static Str nested_name(Str outer, types::TypeRef t) {
    Str whole = types::show(t);
    if (naming == nullptr || countof(types::owner_of(t)) == 0 || same(types::owner_of(t), "c::")) return whole;
    Str own = types::name_of(t); // `front::emit_state::Target`: the last segment is the name an alias would give
    for (Usize i = countof(own); i > 1; i--) {
        if (own[i - 1] == ':' && own[i - 2] == ':') {
            own = own[i:countof(own)];
            break;
        }
    }
    // the outer's module: the text before its one `.` or `::` (`emit.Options`, `emit::Options`)
    Usize cut = countof(outer);
    Usize separators = 0;
    for (Usize i = 0; i < countof(outer); i++) {
        if (outer[i] == '.' || (outer[i] == ':' && i + 1 < countof(outer) && outer[i + 1] == ':')) {
            if (cut == countof(outer)) cut = i;
            separators += 1;
        }
    }
    if (separators == 1 && names_the_type(outer[0:cut], own, whole))
        return types::message_of(format::push(outer[0:cut], ".", own));
    if (naming_module == nullptr) return whole;
    for (Usize i = 0; i < countof(naming_module->decls); i++) {
        const ast::Decl *d = naming_module->decls[i];
        if (d->kind != .import_module) continue;
        ast::Path path = d->kind.import_module.path;
        if (countof(path.segments) == 0) continue;
        Str binding = countof(d->kind.import_module.alias) > 0 ? d->kind.import_module.alias
                                                               : path.segments[countof(path.segments) - 1].text;
        if (names_the_type(binding, own, whole)) return types::message_of(format::push(binding, ".", own));
    }
    return whole;
}

// `T(a = 0, inner = U(x = 0))`: a struct whose fields are numbers, `Bool`s, pointers, arrays of those and structs of
// the same, one, two or three structs deep (a C struct such as `LLVMOrcCSymbolMapPair` is three). No recursion is
// allowed, so each level is a function that calls the one below it.
static Str construct_one(Str name, types::TypeRef t) {
    if (t->kind != .record || types::is_union_record(t) || !types::is_complete(t) ||
        countof(types::slots_of(t).items) == 0)
        return "";
    Str out = types::message_of(format::push(name, "("));
    for (Usize i = 0; i < countof(types::slots_of(t).items); i++) {
        types::TypeRef field = types::slots_of(t).items[i].type;
        Str zero = flat_zero(field);
        if (countof(zero) == 0) zero = "";
        if (countof(zero) == 0 || !nameable(types::slots_of(t).items[i].name)) return "";
        out = types::message_of(format::push(out, i > 0 ? ", " : "", types::slots_of(t).items[i].name, " = ", zero));
    }
    return types::message_of(format::push(out, ")"));
}

static Str construct_two(Str name, types::TypeRef t) {
    if (t->kind != .record || types::is_union_record(t) || !types::is_complete(t) ||
        countof(types::slots_of(t).items) == 0)
        return "";
    Str out = types::message_of(format::push(name, "("));
    for (Usize i = 0; i < countof(types::slots_of(t).items); i++) {
        types::TypeRef field = types::slots_of(t).items[i].type;
        Str zero = flat_zero(field);
        if (countof(zero) == 0) zero = construct_one(nested_name(name, field), field);
        if (countof(zero) == 0 || !nameable(types::slots_of(t).items[i].name)) return "";
        out = types::message_of(format::push(out, i > 0 ? ", " : "", types::slots_of(t).items[i].name, " = ", zero));
    }
    return types::message_of(format::push(out, ")"));
}

static Str construct_three(Str name, types::TypeRef t) {
    if (t->kind != .record || types::is_union_record(t) || !types::is_complete(t) ||
        countof(types::slots_of(t).items) == 0)
        return "";
    Str out = types::message_of(format::push(name, "("));
    for (Usize i = 0; i < countof(types::slots_of(t).items); i++) {
        types::TypeRef field = types::slots_of(t).items[i].type;
        Str zero = flat_zero(field);
        if (countof(zero) == 0) zero = construct_two(nested_name(name, field), field);
        if (countof(zero) == 0 || !nameable(types::slots_of(t).items[i].name)) return "";
        out = types::message_of(format::push(out, i > 0 ? ", " : "", types::slots_of(t).items[i].name, " = ", zero));
    }
    return types::message_of(format::push(out, ")"));
}

static Str construct(Str name, types::TypeRef t) {
    return construct_two(name, t);
}

// The zero value of an element type as the file writes it (`char`, `bool`, `u8`, `f64`), for when the checker did not
// resolve the element (`char` is a C type to it until the file is converted); empty for any other.
static Str written_zero(Str element) {
    if (same(element, "char")) return "0";
    if (same(element, "bool")) return "false";
    if (same(element, "f32") || same(element, "f64")) return "0.0";
    if (same(element, "isize") || same(element, "usize")) return "0";
    if (countof(element) < 2 || (element[0] != 'i' && element[0] != 'u')) return "";
    for (Usize i = 1; i < countof(element); i++) {
        if (element[i] < '0' || element[i] > '9') return "";
    }
    return "0";
}

// `array.filled(P, 12, P(...))` for an array of structs (#2385, decided on #1406): C zeroes `P xs[12] = {}` and smith
// has no zero value, so the one zero element is written out and `std.array` fills the rest. `element` is the element
// type as the file writes it; empty for any other array, or a struct that cannot be filled.
static Str construct_array(Str element, types::TypeRef t) {
    if (t->kind != .array || types::count_of(t) == 0) return "";
    // `T xs[a][b]` is `[a][b]T`: the shape `[a, b]` names every dimension (#2496).
    Str shape = types::message_of(format::push(types::count_of(t)));
    types::TypeRef leaf = types::element_of(t);
    Usize rank = 1;
    while (leaf->kind == .array && rank < 16) {
        if (types::count_of(leaf) == 0) return "";
        shape = types::message_of(format::push(shape, ", ", types::count_of(leaf)));
        leaf = types::element_of(leaf);
        rank += 1;
    }
    // a number, `Bool` or pointer element is its own zero: `static char buf[named_length]` (#1901)
    Str one = scalar_zero(leaf);
    if (countof(one) == 0) one = written_zero(element);
    if (countof(one) == 0) one = construct_three(element, leaf);
    if (countof(one) == 0) return "";
    if (rank > 1) shape = types::message_of(format::push("[", shape, "]"));
    return types::message_of(format::push("array.filled(", element, ", ", shape, ", ", one, ")"));
}

static Bool mentions(Str text, Str name);
static Bool array_written = false; // a construction fix wrote `array.filled`: the file needs `import std.array`
static Str local_record_zero(types::TypeRef t, Str name);
static Str defaulted_record(types::TypeRef t, Str name);

// A member of another module's smith struct, written out where it is left out: the fields it gives no default get
// their zero, the ones it defaults (a pointer made an option) are left to the default. `undefined` is not a value
// inside a construction, so a field with neither a default nor a zero gives up and leaves the construction alone.
static Str defaulted_record(types::TypeRef t, Str name) {
    Str built = "";
    for (Usize i = 0; i < countof(types::slots_of(t).items); i++) {
        if (types::slots_of(t).items[i].default_value != nullptr) continue;
        types::TypeRef field = types::slots_of(t).items[i].type;
        Str zero = flat_zero(field);
        if (field->kind == .option) zero = ".none";
        if (countof(zero) == 0 || mentions(zero, "nullptr") || !nameable(types::slots_of(t).items[i].name)) return "";
        if (countof(built) > 0) built = types::message_of(format::push(built, ", "));
        built = types::message_of(format::push(built, types::slots_of(t).items[i].name, " = ", zero));
    }
    return types::message_of(format::push(name, "(", built, ")"));
}

// The text that gives the fields of `record` that `given` marks not (and that have no default) their zero values,
// each after a comma: `, b = 0, c = nullptr`. Empty when a field cannot be given.
static Str omitted(types::TypeRef record, U64 given, Str outer, Bool header) {
    if (record->kind != .record || types::is_union_record(record) || !types::is_complete(record)) return "";
    Str out = "";
    for (Usize k = 0; k < countof(types::slots_of(record).items); k++) {
        if ((given & ((U64)1 << k)) != 0 || types::slots_of(record).items[k].default_value != nullptr) continue;
        types::TypeRef field = types::slots_of(record).items[k].type;
        Str zero = flat_zero(field);
        if (field->kind == .option) zero = ".none";
        // a pointer of a smith struct has no zero (item 3 of #3224): it stays the one error left, the fields that have
        // a zero are still written
        if (!header && same(zero, "nullptr")) continue;
        if (countof(zero) == 0 && field->kind == .array) {
            types::TypeRef leaf = field;
            for (Usize d = 0; d < 16 && leaf->kind == .array; d++)
                leaf = types::element_of(leaf);
            zero = construct_array(types::show(leaf), field); // too long to write out: `array.filled(u32, 128, 0)`
            if (countof(zero) > 0) array_written = true;
        }
        if (countof(zero) == 0)
            zero = construct(nested_name(outer, field), field); // `Path(segments = [], span = Span(..))`
        if (countof(zero) == 0 && field->kind == .record) zero = local_record_zero(field, nested_name(outer, field));
        if (field->kind == .record && same(zero, "undefined")) continue; // not a value here: the struct's `= undefined`
        // a member of a smith struct whose pointers nothing tests against null: C fills it before use (lead on #2613).
        // No construction can write it (`undefined` is a whole initializer), so its own module gives it `= undefined`
        // in the struct (`defaults`) and this construction leaves it out.
        if (field->kind == .record && countof(types::owner_of(field)) > 0 && !same(types::owner_of(field), "c::") &&
            !types::is_union_record(field) && types::is_complete(field) &&
            (countof(zero) == 0 || mentions(zero, "nullptr"))) {
            zero = defaulted_record(field, nested_name(outer, field));
            if (countof(zero) == 0) continue;
        }
        if (countof(zero) == 0 || !nameable(types::slots_of(record).items[k].name)) return "";
        out = types::message_of(format::push(out, ", ", types::slots_of(record).items[k].name, " = ", zero));
    }
    return out;
}

// The fix of the construction `e` that leaves fields out: their zero values after the last argument. Only for a
// struct this module cannot give defaults, one a C header declares (#2530: a smith struct gets them in its
// declaration).
static core::ParseError left_out_fix(Str source, const ast::Expr *e, types::TypeRef record, U64 given) {
    core::ParseError none = {};
    if (!(e->kind == .call) && !(e->kind == .tuple_lit)) return none;
    // a call names what it builds; a named value `(element = x)` nested in a payload is the same construction without
    // a name (#3658): the one rule, at the one function
    Str outer = "";
    ast::ExprRef args[:] = {};
    if (e->kind == .tuple_lit) args = e->kind.tuple_lit.items;
    if (e->kind == .call) {
        args = e->kind.call.args;
        const ast::Expr *callee = e->kind.call.callee;
        if (callee->span.end > callee->span.start && callee->span.end <= countof(source))
            outer = source[callee->span.start:callee->span.end];
    }
    Str text = omitted(record, given, outer, same(types::owner_of(record), "c::"));
    if (countof(text) == 0) return none;
    U32 at = e->span.end - 1; // before the `)`
    if (countof(args) > 0) {
        at = args[countof(args) - 1]->span.end;
    } else {
        text = text[2:countof(text)];
    }
    core::Edits fix = {};
    fix = mem::realloc(fix, 1);
    fix[0] = (core::Edit){.span = {.start = at, .end = at}, .text = text};
    core::ParseError found = {};
    found.span = e->span;
    found.message = "a construction that leaves fields out gives them their zero values";
    found.fix = fix;
    return found;
}

// Whether `text` holds `name` as a whole word.
static Bool mentions(Str text, Str name) {
    Usize n = countof(name);
    if (n == 0) return false;
    for (Usize i = 0; i + n <= countof(text); i++) {
        if (!same(text[i:i + n], name)) continue;
        Bool before =
            i > 0 && (text[i - 1] == '_' || (text[i - 1] >= 'a' && text[i - 1] <= 'z') ||
                      (text[i - 1] >= 'A' && text[i - 1] <= 'Z') || (text[i - 1] >= '0' && text[i - 1] <= '9'));
        Usize e = i + n;
        Bool after = e < countof(text) && (text[e] == '_' || (text[e] >= 'a' && text[e] <= 'z') ||
                                           (text[e] >= 'A' && text[e] <= 'Z') || (text[e] >= '0' && text[e] <= '9'));
        if (!before && !after) return true;
    }
    return false;
}

// The index of the field that the statement `x.f = v` assigns, when it is one and `v` does not mention `x`; else the
// number of fields.
static Usize assigned_field(Str source, const ast::Stmt *s, Str name, types::TypeRef t) {
    Usize none = countof(types::slots_of(t).items);
    if (s->kind != .expression) return none;
    const ast::Expr *e = s->kind.expression.value;
    if (e == nullptr || e->kind != .assign || e->kind.assign.op != .plain) return none;
    const ast::Expr *target = e->kind.assign.target;
    if (target->kind != .member || target->kind.member.arrow) return none;
    const ast::Expr *base = target->kind.member.base;
    if (base->kind != .name || countof(base->kind.name.path.segments) != 1) return none;
    if (!same(base->kind.name.path.segments[0].text, name)) return none;
    const ast::Expr *value = e->kind.assign.value;
    if (value == nullptr || mentions(source[value->span.start:value->span.end], name)) return none;
    for (Usize i = 0; i < countof(types::slots_of(t).items); i++) {
        if (same(types::slots_of(t).items[i].name, target->kind.member.name)) return i;
    }
    return none;
}

// Whether the statements after `items[at]` assign every field of `t` by name before anything else.
static Bool written_first(Str source, ast::StmtRef items[:], Usize at, Str name, types::TypeRef t) {
    Usize total = countof(types::slots_of(t).items);
    if (total > 64) return false;
    U64 seen = 0;
    Usize covered = 0;
    for (Usize k = at + 1; k < countof(items) && covered < total; k++) {
        Usize field = assigned_field(source, items[k], name, t);
        if (field == total) return false;
        if ((seen & ((U64)1 << field)) != 0) return false;
        seen |= (U64)1 << field;
        covered += 1;
    }
    return covered == total;
}

static Bool word_char(char c) {
    return c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9');
}

// Whether `text[at]` is the `&` of an argument whose call names a C function (`c::stat(path, &info)`: a `::` in the
// callee before its `(`; `c.stat(...)` once the file is converted).
static Bool argument_of_c_call(Str text, Usize at) {
    Usize depth = 0;
    Usize j = at;
    while (j > 0) {
        j -= 1;
        if (text[j] == ')') {
            depth += 1;
        } else if (text[j] == '(') {
            if (depth == 0) break;
            depth -= 1;
        }
    }
    if (text[j] != '(') return false;
    Usize b = j;
    while (b > 0 && (word_char(text[b - 1]) || text[b - 1] == ':' || text[b - 1] == '.'))
        b -= 1;
    for (Usize m = b; m + 1 < j; m++) {
        if ((text[m] == ':' && text[m + 1] == ':') || (text[m] == '.' && word_char(text[m + 1]))) return true;
    }
    return false;
}

// Whether the first statement after `items[at]` that mentions `name` hands `&name` to a call of a C function, with no
// read of `name` before it: the call fills the struct (`struct stat info = {};` then `stat(path, &info)`, #2610), so
// no zero is written.
static Bool filled_by_call(Str source, ast::StmtRef items[:], Usize at, Str name) {
    Usize n = countof(name);
    for (Usize k = at + 1; k < countof(items); k++) {
        Str text = source[items[k]->span.start:items[k]->span.end];
        if (!mentions(text, name)) continue;
        Usize i = 0;
        for (; i + n <= countof(text); i++) {
            if (!same(text[i:i + n], name)) continue;
            Bool before = i > 0 && word_char(text[i - 1]);
            Bool after = i + n < countof(text) && word_char(text[i + n]);
            if (!before && !after) break;
        }
        return i > 0 && i + n <= countof(text) && text[i - 1] == '&' && argument_of_c_call(text, i - 1);
    }
    return false;
}

// Whether `e` is `{}`: an empty list with no type, or (in braces, new syntax) an empty block used as a value.
static Bool is_empty_braces(const ast::Expr *e) {
    if (e->kind == .compound) return e->kind.compound.type == nullptr && countof(e->kind.compound.items) == 0;
    if (e->kind != .stmt_expr) return false;
    const ast::Stmt *s = e->kind.stmt_expr.stmt;
    return s != nullptr && s->kind == .block && countof(s->kind.block.items) == 0;
}

constexpr Usize no_block = ~(Usize)0;

// Set when a fix wrote `mem.zeroed(T)`: the module then needs `import std.mem` (#2627, D10).
static Bool zeroed_written = false;

// Whether `written` names a C struct tag that a function of the same name hides (`stat.stat`, `struct stat` and
// `stat()`): a construction `stat.stat(st_dev = 0, ...)` would read as the call, so such a struct starts zeroed with
// `mem.zeroed(stat.stat)` (D10).
static Bool tag_is_also_function(types::Checked *c, Str written) {
    Usize dot = 0;
    for (Usize k = 0; k < countof(written); k += 1) {
        if (written[k] == '.') dot = k + 1;
    }
    Str name = written[dot:countof(written)];
    return types::lookup(&c->scopes, types::message_of(format::push("c::", name, "()"))) != nullptr;
}

// The fix of the variable `d`, which is `items[at]` of a block (`at` is `no_block` for a global).
static core::ParseError fix_of(Str source, types::Checked *c, const ast::Decl *d, ast::StmtRef items[:], Usize at,
                               Bool *filled) {
    core::ParseError none = {};
    if (d->kind != .variable) return none;
    const ast::Expr *init = d->kind.variable.init;
    ast::TypeExpr *written = d->kind.variable.type;
    if (init == nullptr || written == nullptr || !is_empty_braces(init)) return none;
    // The declared type: in braces (`x: P = {}` before the blocks are indented) `{}` reads as an empty block, so
    // the initializer has no type of its own. Resolving it again must not leave an error behind.
    Usize errors_before = c->error_count;
    // The element `char` is a C type until the file is converted, so it is read as the new spelling (#1901).
    Bool was_new = c->new_syntax;
    c->new_syntax = true;
    types::TypeRef t = types::resolve(c, written);
    c->new_syntax = was_new;
    c->error_count = errors_before;
    if (t == nullptr || (t->kind != .record && t->kind != .array)) return none;
    Str name = d->kind.variable.name;
    Str text = "";
    Str written_source = source[written->span.start:written->span.end];
    if (t->kind == .array) {
        Str written_text = source[written->span.start:written->span.end];
        Usize close = 0;
        for (Usize k = 0; k < countof(written_text); k += 1) {
            if (written_text[k] == ']') close = k;
        }
        if (close + 1 < countof(written_text)) text = construct_array(written_text[close + 1:countof(written_text)], t);
        if (countof(text) > 0) *filled = true;
    } else if (at != no_block && d->kind.variable.is_new && written->span.end > written->span.start &&
               (written_first(source, items, at, name, t) || filled_by_call(source, items, at, name))) {
        text = "undefined";
    } else if (same(types::owner_of(t), "c::") && tag_is_also_function(c, written_source)) {
        text = types::message_of(format::push("mem.zeroed(", source[written->span.start:written->span.end], ")"));
        zeroed_written = true;
    } else {
        text = construct(source[written->span.start:written->span.end], t);
    }
    if (countof(text) == 0) return none;
    core::Edits edits = {};
    edits = mem::realloc(edits, 1);
    edits[0] = (core::Edit){.span = init->span, .text = text};
    core::ParseError found = {};
    found.span = init->span;
    found.message = "an empty `{}` of a struct is written out";
    found.fix = edits;
    return found;
}

static core::Errors add(core::Errors out, core::ParseError found) {
    if (countof(found.fix) == 0) return out;
    out = mem::realloc(out, countof(out) + 1);
    out[countof(out) - 1] = found;
    return out;
}

// Whether the text at `at` starts with `prefix`.
static Bool text_at(Str source, Usize at, Str prefix) {
    if (at + countof(prefix) > countof(source)) return false;
    return same(source[at:at + countof(prefix)], prefix);
}

// Whether the line holding `at` lies in a function already written `fn`: the column-0 line above it says so.
static Bool in_new_function(Str source, Usize at) {
    Usize start = at;
    while (start > 0) {
        Usize prev = start - 1;
        while (prev > 0 && source[prev - 1] != '\n')
            prev -= 1;
        start = prev;
        if (source[start] != ' ' && source[start] != '\n') break;
    }
    return text_at(source, start, "fn ") || text_at(source, start, "pub fn ") || text_at(source, start, "static fn ");
}

// `(T){0}` as a value (D10, #2627): C's zero of `T`, which may be a `typeof`
// type or one the file cannot see, is `mem.zeroed(T)`. A struct named by a plain declaration `x: P = {}` is not this
// (fix_of fills its fields); an array type `([3]I32){0}` is the parser's.
static core::Errors zeroed_literals(core::Errors out, Str source) {
    Usize at = 0;
    while (at < countof(source)) {
        if (source[at] != '(' ||
            (at > 0 && (word_char(source[at - 1]) || source[at - 1] == ')' || source[at - 1] == ']'))) {
            at += 1;
            continue;
        }
        Usize depth = 0;
        Usize close = at;
        while (close < countof(source) && source[close] != '\n') {
            if (source[close] == '(') depth += 1;
            if (source[close] == ')') depth -= 1;
            if (depth == 0) break;
            close += 1;
        }
        Bool braces = close < countof(source) && source[close] == ')' && text_at(source, close + 1, "{");
        Usize stop = close + 2;
        if (!braces || !text_at(source, stop, "0}") || close <= at + 1 || source[at + 1] == '[') {
            at += 1;
            continue;
        }
        Str type_text = source[at + 1:close];
        // an old-syntax function is mended later: its `mem::zeroed(T)` becomes `mem.zeroed(T)` with the rest
        Str call = in_new_function(source, at) ? "mem.zeroed(" : "mem::zeroed(";
        core::Edits edits = {};
        edits = mem::realloc(edits, 1);
        ast::Span whole = {.start = (U32)at, .end = (U32)(stop + 2)};
        edits[0] = (core::Edit){.span = whole, .text = types::message_of(format::push(call, type_text, ")"))};
        core::ParseError found = {};
        found.span = whole;
        found.message = "a compound literal of zero is `mem.zeroed(T)`";
        found.fix = edits;
        out = add(out, found);
        zeroed_written = true;
        at = stop + 2;
    }
    return out;
}

// Whether the module imports `std.array` (`import std.array`, `import std::array;`, with or without an alias).
static Bool imports_std(const ast::Module *module, Str library) {
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind != .import_module) continue;
        ast::Identifier segments[:] = d->kind.import_module.path.segments;
        if (countof(segments) == 2 && same(segments[0].text, "std") && same(segments[1].text, library)) return true;
    }
    return false;
}

// The fix that adds `import std.array` once, in front of the module's first import (or its first declaration).
static core::ParseError import_std(const ast::Module *module, Str library) {
    core::ParseError none = {};
    if (imports_std(module, library) || countof(module->decls) == 0) return none;
    const ast::Decl *first = module->decls[0];
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind == .import_module) {
            first = d;
            break;
        }
    }
    ast::Span at = {.start = first->span.start, .end = first->span.start};
    core::Edits edits = {};
    edits = mem::realloc(edits, 1);
    Str line = types::message_of(format::push("import std.", library, "\n"));
    edits[0] = (core::Edit){.span = at, .text = line};
    core::ParseError found = {};
    found.span = at;
    found.message = "a fix needs a standard module";
    found.fix = edits;
    return found;
}

// `front.ast.Span` as the file names it: `ast.Span` when it imports `front::ast` (or the alias it gave it). The types
// print with the module's whole path (#2460).
static Str local_names(const ast::Module *module, Str text) {
    for (Usize d_index = 0; d_index < 2; d_index++) {
        Str divider = ".";
        if (d_index == 1) divider = "::";
        for (Usize i = 0; i < countof(module->decls); i++) {
            const ast::Decl *d = module->decls[i];
            if (d->kind != .import_module) continue;
            ast::Identifier segments[:] = d->kind.import_module.path.segments;
            if (countof(segments) < 2) continue;
            Str whole = "";
            for (Usize k = 0; k < countof(segments); k++)
                whole = types::message_of(format::push(whole, segments[k].text, divider));
            Str local = d->kind.import_module.alias;
            if (countof(local) == 0) local = segments[countof(segments) - 1].text;
            Str out = "";
            Usize at = 0;
            for (Usize j = 0; j + countof(whole) <= countof(text); j++) {
                Bool word =
                    j > 0 && (text[j - 1] == '_' || text[j - 1] == '.' || (text[j - 1] >= 'a' && text[j - 1] <= 'z') ||
                              (text[j - 1] >= 'A' && text[j - 1] <= 'Z') || (text[j - 1] >= '0' && text[j - 1] <= '9'));
                if (word || !same(text[j:j + countof(whole)], whole)) continue;
                out = types::message_of(format::push(out, text[at:j], local, divider));
                at = j + countof(whole);
                j = at - 1;
            }
            if (at > 0) text = types::message_of(format::push(out, text[at:countof(text)]));
        }
    }
    return text;
}

// Writes every fix of `errors` with the names the file gives its modules.
static void localize(const ast::Module *module, core::Errors errors) {
    for (Usize i = 0; i < countof(errors); i++) {
        core::Edits fix = errors[i].fix;
        for (Usize k = 0; k < countof(fix); k++)
            fix[k].text = local_names(module, fix[k].text);
    }
}

// ---------------------------------------------------------------------------------------------------------------
// Defaults in the declaration (#2530, decided by the owner on 2026-11-06): C zeroes the fields a construction leaves
// out, smith has no zero values, so a field that some construction leaves out gets its zero written as its default in
// the struct (`count: usize = 0`); the constructions stay as written. Only those fields get one. A pointer among them
// that a read tests against null is `?*T = .none` (#2557); the checker writes its tested reads as bindings.

constexpr Usize records_max = 64;
constexpr Usize fields_max = 64;

// The records of the module and, for each, the fields (by index in the declaration) some construction leaves out.
struct Record {
    Str name;
    ast::FieldDecl fields[:];
    Bool exported;
    Bool c_layout; // `@c_name("SmithApp")`: C owns the layout and reads null as unset (D2, lead on #2631)
};

// Whether the declaration is a C-layout struct: it carries `@c_name(...)` (or `[[std::c_name(...)]]`).
static Bool has_c_name(const ast::Decl *d) {
    for (Usize i = 0; i < countof(d->attributes); i++) {
        ast::Identifier segments[:] = d->attributes[i].name.segments;
        if (countof(segments) > 0 && same(segments[countof(segments) - 1].text, "c_name")) return true;
    }
    return false;
}

constexpr Usize variants_max = 128;

// A payload enum of the module and one variant that holds a pointer or a record: `Node.pattern` is a `*Pattern`. A read
// `node.pattern.constant` is a read of `Pattern.constant`, whichever way the file has spelled the test so far.
struct Variant {
    Str owner;
    Str name;
    const ast::TypeExpr *payload;
};

struct Wanted {
    Variant variants[variants_max];
    Usize variant_count;
    Record records[records_max];
    U64 left[records_max];
    U64 text_left[records_max]; // the fields left out by a construction the text shows (`left` has the checker's too)
    U64 tested[records_max];    // the fields a read tests against null: `x.f != nullptr` (#2557)
    Usize count;
};

static U64 all_fields(const Record *d) {
    Usize n = countof(d->fields);
    if (n >= fields_max) return ~(U64)0;
    return ((U64)1 << n) - 1;
}

static Wanted records_of(const ast::Module *module) {
    Wanted w = {};
    for (Usize i = 0; i < countof(module->decls) && w.count < records_max; i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind == .record) {
            if (d->kind.record.is_union || d->kind.record.opaque) continue;
            if (countof(d->kind.record.fields) == 0 || countof(d->kind.record.fields) > fields_max) continue;
            w.records[w.count] = (Record){.name = d->kind.record.name,
                                          .fields = d->kind.record.fields,
                                          .exported = d->exported || d->is_pub,
                                          .c_layout = has_c_name(d)};
            w.count += 1;
        } else if (d->kind == .type_alias) {
            // `typedef struct { ... } Node;`, today's spelling of a struct the fixer has not converted yet
            const ast::TypeExpr *t = d->kind.type_alias.type;
            if (t == nullptr || !(t->kind == .record)) continue;
            if (t->kind.record.is_union || countof(t->kind.record.fields) == 0) continue;
            if (countof(t->kind.record.fields) > fields_max) continue;
            w.records[w.count] = (Record){.name = d->kind.type_alias.name,
                                          .fields = t->kind.record.fields,
                                          .exported = d->exported || d->is_pub,
                                          .c_layout = has_c_name(d)};
            w.count += 1;
        } else if (d->kind == .enumeration) {
            ast::Enumerator items[:] = d->kind.enumeration.items;
            for (Usize k = 0; k < countof(items) && w.variant_count < variants_max; k++) {
                if (items[k].payload == nullptr) continue;
                w.variants[w.variant_count] =
                    (Variant){.owner = d->kind.enumeration.name, .name = items[k].name, .payload = items[k].payload};
                w.variant_count += 1;
            }
        }
    }
    return w;
}

static Usize record_index(const Wanted *w, Str name) {
    for (Usize i = 0; i < w->count; i++)
        if (same(w->records[i].name, name)) return i;
    return w->count;
}

// The index of the field `name` of `d`. The records are read after the file's renames (`type` is `ty`), while a file
// that imports the module is read as it is on disk, so a field called `type` there is the declared `ty` (#2458).
static Usize field_index(const Record *d, Str name) {
    ast::FieldDecl fields[:] = d->fields;
    if (same(name, "type")) name = "ty";
    for (Usize k = 0; k < countof(fields); k++)
        if (same(fields[k].name, name)) return k;
    return countof(fields);
}

// What the checker found: a construction of a record of this module that leaves fields out (`Error.left_out_call`).
static void from_checker(Wanted *w, const types::Checked *c) {
    for (Usize i = 0; i < c->error_count; i++) {
        types::Error error = c->errors[i];
        types::TypeRef record = error.left_out_record;
        if (error.left_out_call == nullptr || record == nullptr || countof(types::owner_of(record)) > 0) continue;
        Usize r = record_index(w, types::name_of(record));
        if (r == w->count) continue;
        for (Usize k = 0; k < countof(types::slots_of(record).items) && k < fields_max; k++) {
            if ((error.left_out_given & ((U64)1 << k)) != 0) continue;
            Usize f = field_index(&w->records[r], types::slots_of(record).items[k].name);
            if (f < fields_max) w->left[r] |= (U64)1 << f;
        }
    }
}

static Bool opens(lex::TokenKind k) {
    return k == lex::left_paren || k == lex::left_bracket || k == lex::left_brace;
}

static Bool closes(lex::TokenKind k) {
    return k == lex::right_paren || k == lex::right_bracket || k == lex::right_brace;
}

static Bool is_member(lex::TokenKind k) {
    return k == lex::dot || k == lex::colon_colon || k == lex::arrow;
}

// The index of the token that closes the bracket `t[open]`, or the number of tokens.
static Usize closing(lex::Tokens t, Usize open) {
    Usize depth = 0;
    for (Usize i = open; i < countof(t); i++) {
        if (opens(t[i].kind)) depth += 1;
        if (closes(t[i].kind)) {
            if (depth <= 1) return i;
            depth -= 1;
        }
    }
    return countof(t);
}

// The fields of `d` that the list or the arguments between `t[open]` and `t[close]` give: by name (`.a = 1`, `a = 1`)
// or by position. Every field when an item has a form not read here (`[0] = 1`).
static U64 given_of(Str source, lex::Tokens t, Usize open, Usize close, const Record *d) {
    U64 given = 0;
    Usize positional = 0;
    Usize depth = 0;
    Bool item_start = true;
    for (Usize i = open + 1; i < close; i++) {
        lex::TokenKind k = t[i].kind;
        if (depth == 0 && item_start) {
            item_start = false;
            Str name = "";
            if (k == lex::dot && i + 2 < close && t[i + 1].kind == lex::name &&
                (t[i + 2].kind == lex::equal || t[i + 2].kind == lex::dot)) {
                name = lex::text(source, t[i + 1]);
            } else if (k == lex::name && i + 1 < close && t[i + 1].kind == lex::equal) {
                name = lex::text(source, t[i]);
            } else if (k == lex::left_bracket) {
                return all_fields(d);
            }
            Usize f = countof(name) > 0 ? field_index(d, name) : fields_max;
            if (f < fields_max) given |= (U64)1 << f;
            if (countof(name) == 0) positional += 1;
        }
        if (opens(k)) depth += 1;
        if (closes(k) && depth > 0) depth -= 1;
        if (depth == 0 && k == lex::comma) item_start = true;
    }
    for (Usize k = 0; k < positional && k < fields_max; k++)
        given |= (U64)1 << k;
    return given;
}

// Whether the name `t[i]` is reached as `prefix.R` or `prefix::R` (bare, with no member before it, when `prefix` is
// empty: the module's own file).
static Bool prefixed(Str source, lex::Tokens t, Usize i, Str prefix) {
    Bool member = i > 0 && is_member(t[i - 1].kind);
    if (countof(prefix) == 0) return !member;
    if (!member || t[i - 1].kind == lex::arrow || i < 2 || !same(lex::text(source, t[i - 2]), prefix)) return false;
    return i < 3 || !is_member(t[i - 3].kind);
}

// The bracket that opens the construction of the record named at `t[i]`: `R(...)`, `(R){...}`, `R x = {...}` (not
// `R x = {}`, which the fix of `{}` writes out); the number of tokens when it is none.
static Usize construction_at(lex::Tokens t, Usize i, Usize start) {
    Usize n = countof(t);
    if (i + 1 < n && t[i + 1].kind == lex::left_paren) return i + 1;
    if (i + 2 < n && start > 0 && t[start - 1].kind == lex::left_paren && t[i + 1].kind == lex::right_paren &&
        t[i + 2].kind == lex::left_brace)
        return i + 2;
    if (i + 4 < n && t[i + 1].kind == lex::name && t[i + 2].kind == lex::equal && t[i + 3].kind == lex::left_brace &&
        t[i + 4].kind != lex::right_brace)
        return i + 3;
    return n;
}

// The name a text gives the module whose file is `base`.smith: `state` for `import front::emit_state as state;`,
// `emit_state` for `import front.emit_state`; empty when it imports no module of that name. The name, not the whole
// path: once the fixer has written a file in smith's own syntax it has no `module` line left.
static Str local_name(Str source, lex::Tokens t, Str base) {
    Usize n = countof(t);
    for (Usize i = 0; i < n; i++) {
        if (t[i].kind != lex::kw_import) continue;
        Usize k = i + 1;
        while (k + 2 < n && t[k].kind == lex::name && (t[k + 1].kind == lex::dot || t[k + 1].kind == lex::colon_colon))
            k += 2;
        if (k >= n || t[k].kind != lex::name || !same(lex::text(source, t[k]), base)) continue;
        if (k + 2 < n && t[k + 1].kind == lex::kw_as) return lex::text(source, t[k + 2]);
        return base;
    }
    return "";
}

// Whether `t[i]` is `nullptr` or `.none`.
static Bool null_word(Str source, lex::Tokens t, Usize i) {
    if (i >= countof(t)) return false;
    if (t[i].kind == lex::kw_nullptr) return true;
    return t[i].kind == lex::dot && i + 1 < countof(t) && same(lex::text(source, t[i + 1]), "none");
}

static Bool is_word(lex::TokenKind k) {
    return k == lex::name || k == lex::type_name || k == lex::kw_type; // `type` is a field of old text (#2458)
}

// Whether the field read that ends at `t[i]` (`x.f`, `x->f`, `a.b.f`) is tested against null: `x.f != nullptr`,
// `x->f == .none`, `!x->f`, or bound by its own name, `f := x.f else` (a test the fixer already wrote, #2557).
static Bool null_tested_at(Str source, lex::Tokens t, Usize i) {
    Usize n = countof(t);
    lex::TokenKind after = i + 1 < n ? t[i + 1].kind : lex::semicolon;
    if ((after == lex::equal_equal || after == lex::bang_equal) && null_word(source, t, i + 2)) return true;
    Usize start = i - 1; // the member operator before the field; the chain before it back to its first name
    while (start >= 2 && is_word(t[start - 1].kind) && is_member(t[start - 2].kind))
        start -= 2;
    if (start < 1 || !is_word(t[start - 1].kind)) return false;
    Usize base = start - 1;
    Bool continued = after == lex::left_paren || after == lex::left_bracket || is_member(after);
    if (base >= 1 && t[base - 1].kind == lex::bang && !continued) return true;
    return base >= 2 && t[base - 1].kind == lex::colon_equal && is_word(t[base - 2].kind) &&
           same(lex::text(source, t[base - 2]), lex::text(source, t[i]));
}

// Whether the text tests the name `local` against null anywhere: `local != nullptr`, `local == .none`, `!local`.
static Bool local_tested(Str source, lex::Tokens t, Str local) {
    for (Usize i = 0; i < countof(t); i++) {
        if (t[i].kind != lex::name || !same(lex::text(source, t[i]), local)) continue;
        if (i > 0 && t[i - 1].kind == lex::bang) return true;
        if (i + 2 < countof(t) && (t[i + 1].kind == lex::equal_equal || t[i + 1].kind == lex::bang_equal) &&
            null_word(source, t, i + 2))
            return true;
    }
    return false;
}

// Whether the field read that ends at `t[i]` gives its value to a local (`n = x->f`, `n := x.f`, `T *n = x->f`) that
// the text tests against null: the null of the field flows through the local (#2648).
static Bool flows_to_tested_local(Str source, lex::Tokens t, Usize i) {
    Usize start = i - 1; // the member operator before the field; the chain before it back to its first name
    while (start >= 2 && is_word(t[start - 1].kind) && is_member(t[start - 2].kind))
        start -= 2;
    if (start < 3 || !is_word(t[start - 1].kind)) return false;
    Usize base = start - 1; // the first name of the chain
    if (t[base - 1].kind != lex::equal && t[base - 1].kind != lex::colon_equal) return false;
    if (base < 2 || t[base - 2].kind != lex::name) return false;
    Usize after = i + 1;
    if (after < countof(t) &&
        (t[after].kind == lex::left_paren || t[after].kind == lex::left_bracket || is_member(t[after].kind)))
        return false;
    return local_tested(source, t, lex::text(source, t[base - 2]));
}

// The last name of a type written `T`, `*T`, `?*T` or `module.T`; empty when it is none of these.
static Str type_name_of(const ast::TypeExpr *type) {
    while (type != nullptr) {
        if (type->kind == .pointer) {
            type = type->kind.pointer.pointee;
        } else if (type->kind == .option) {
            type = type->kind.option.inner;
        } else {
            break;
        }
    }
    if (type == nullptr || type->kind != .named || countof(type->kind.named.path.segments) == 0) return "";
    return type->kind.named.path.segments[countof(type->kind.named.path.segments) - 1].text;
}

// The type name that the variant `member` of the payload enum `owner` holds; empty when `owner` is no such enum.
static Str variant_type(const Wanted *w, Str owner, Str member) {
    for (Usize i = 0; i < w->variant_count; i++)
        if (same(w->variants[i].owner, owner) && same(w->variants[i].name, member))
            return type_name_of(w->variants[i].payload);
    return "";
}

// The type named after `t[k]`, which starts a type: `module.T` or `T`, its last name.
static Str last_of_path(Str source, lex::Tokens t, Usize k) {
    while (k + 2 < countof(t) && is_member(t[k + 1].kind) && is_word(t[k + 2].kind))
        k += 2;
    Str none = "";
    if (k < countof(t) && is_word(t[k].kind)) return lex::text(source, t[k]);
    return none;
}

// The type name of the local, parameter or field `t[at]` names, from its nearest declaration before `at` in the same
// text: `n: *Node`, `n: Node`, `Node *n`, `const Node *n`, or `n := Node(...)`. Empty when none is found (D23: a
// test counts only for the struct it is on, so a name that cannot be typed counts for none).
static Str declared_type(Str source, lex::Tokens t, Usize at) {
    Str name = lex::text(source, t[at]);
    for (Usize j = at; j > 0; j--) {
        Usize d = j - 1;
        if (t[d].kind != lex::name || !same(lex::text(source, t[d]), name) || d + 1 >= countof(t)) continue;
        lex::TokenKind next = t[d + 1].kind;
        if (next == lex::colon) {
            Usize k = d + 2;
            while (k < countof(t) && (t[k].kind == lex::star || t[k].kind == lex::question ||
                                      t[k].kind == lex::kw_mut || t[k].kind == lex::kw_const))
                k += 1;
            Str none = "";
            if (k < countof(t)) return last_of_path(source, t, k);
            return none;
        }
        if (next == lex::colon_equal && d + 3 < countof(t) && is_word(t[d + 2].kind)) {
            Usize k = d + 2;
            while (k + 2 < countof(t) && is_member(t[k + 1].kind) && is_word(t[k + 2].kind))
                k += 2;
            if (k + 1 < countof(t) && t[k + 1].kind == lex::left_paren) return lex::text(source, t[k]);
            continue;
        }
        Bool ends = next == lex::equal || next == lex::semicolon || next == lex::comma || next == lex::right_paren ||
                    next == lex::left_bracket;
        if (!ends || d == 0) continue;
        Usize k = d;
        while (k > 0 && (t[k - 1].kind == lex::star || t[k - 1].kind == lex::kw_const))
            k -= 1;
        if (k < d && k > 0 && is_word(t[k - 1].kind)) return lex::text(source, t[k - 1]);
        // `Node node` (a parameter or local held by value in today's text) names its type just as `Node *node` does;
        // a name that starts its line is a statement (`n = n.next`), never a declaration, and the word before it ends
        // the line above
        if (k == d && k > 0 && !t[k - 1].line_break && is_word(t[k - 1].kind)) return lex::text(source, t[k - 1]);
    }
    return "";
}

// The record that owns the field read that ends at `t[i]` (`x.f`, `x->f`, `a.b.f`): the type of the first name of the
// chain, followed through the fields of the module's records; the number of records when it is not known.
static Usize chain_owner(const Wanted *w, Str source, lex::Tokens t, Usize i) {
    Usize start = i - 1;
    while (start >= 2 && is_word(t[start - 1].kind) && is_member(t[start - 2].kind))
        start -= 2;
    if (start < 1 || !is_word(t[start - 1].kind)) return w->count;
    Usize at = start - 1;
    Str type = declared_type(source, t, at);
    for (Usize step = at; step + 2 < i && countof(type) > 0; step += 2) {
        Usize r = record_index(w, type);
        if (r == w->count) {
            // `node.pattern.constant`: the payload enum's variant holds the record (a union typedef in today's text)
            type = variant_type(w, type, lex::text(source, t[step + 2]));
            if (countof(type) == 0) return w->count;
            continue;
        }
        Usize f = field_index(&w->records[r], lex::text(source, t[step + 2]));
        if (f >= countof(w->records[r].fields)) return w->count;
        type = type_name_of(w->records[r].fields[f].type);
    }
    return countof(type) > 0 ? record_index(w, type) : w->count;
}

// The fields of the module's records that `source` tests against null: a read `x.f` counts for the record that the
// type of `x` names, never for a record that merely has a field of that name (D23), and so does one whose value goes
// to a local that is tested (#2648).
static void scan_tests(Wanted *w, Str source, lex::Tokens t, const Bool named[records_max]) {
    for (Usize i = 2; i < countof(t); i++) {
        if (!is_word(t[i].kind) || !(t[i - 1].kind == lex::dot || t[i - 1].kind == lex::arrow)) continue;
        if (!null_tested_at(source, t, i) && !flows_to_tested_local(source, t, i)) continue;
        Usize r = chain_owner(w, source, t, i);
        if (r == w->count || !named[r]) continue;
        Usize f = field_index(&w->records[r], lex::text(source, t[i]));
        if (f < fields_max) w->tested[r] |= (U64)1 << f;
    }
}

// Whether the file has `from <path>.<base> import ...` and, with a `name`, whether that line imports `name` (D6: a
// build file writes `from std.build import Build, App` and builds `App(...)` with no module in front of it). An empty
// `name` asks only for the line.
static Bool from_imported(Str source, lex::Tokens t, Str base, Str name) {
    Usize n = countof(t);
    for (Usize i = 0; i + 3 < n; i++) {
        if (t[i].kind != lex::name || !same(lex::text(source, t[i]), "from")) continue;
        Usize k = i + 1;
        while (k + 2 < n && t[k].kind == lex::name && (t[k + 1].kind == lex::dot || t[k + 1].kind == lex::colon_colon))
            k += 2;
        if (k + 1 >= n || t[k].kind != lex::name || !same(lex::text(source, t[k]), base)) continue;
        if (t[k + 1].kind != lex::kw_import) continue;
        if (countof(name) == 0) return true;
        for (Usize j = k + 2; j < n && !t[j].line_break; j++)
            if (is_word(t[j].kind) && same(lex::text(source, t[j]), name)) return true;
    }
    return false;
}

// The fields left out by the constructions of the module's records in `source`: the module's own file (`own`), or a
// file that imports it, where a record is reached through the name it gives the module. The fields it tests against
// null too (#2557).
static void scan_file(Wanted *w, Str source, Str base, Bool own) {
    if (!own && (countof(base) == 0 || !mentions(source, base))) return;
    lex::Lexed lexed = lex::tokenize_new(source);
    if (lexed == .error) lexed = lex::tokenize(source);
    if (lexed == .error) return;
    lex::Tokens t = lexed.ok;
    Str prefix = "";
    if (!own) prefix = local_name(source, t, base);
    Bool bare = !own && countof(prefix) == 0 && from_imported(source, t, base, ""); // `from std.build import App`
    Bool named[records_max] = {}; // the records the file names: only a test in such a file counts (#2557)
    for (Usize i = 0; i + 1 < countof(t) && (own || countof(prefix) > 0 || bare); i++) {
        if (t[i].kind != lex::type_name && t[i].kind != lex::name) continue;
        Usize r = record_index(w, lex::text(source, t[i]));
        if (r == w->count || !prefixed(source, t, i, prefix)) continue;
        if (bare && !from_imported(source, t, base, lex::text(source, t[i]))) continue;
        named[r] = true;
        Usize open = construction_at(t, i, countof(prefix) == 0 ? i : i - 2);
        Usize close = open < countof(t) ? closing(t, open) : countof(t);
        if (close == countof(t)) continue;
        U64 left = all_fields(&w->records[r]) & ~given_of(source, t, open, close, &w->records[r]);
        w->left[r] |= left;
        w->text_left[r] |= left;
    }
    if (own) {
        for (Usize r = 0; r < w->count; r++)
            named[r] = true;
    }
    if (own || countof(prefix) > 0 || bare) scan_tests(w, source, t, named);
    mem::free(t.data);
}

constexpr Usize cache_text_max = 256;

// What the files that import a module leave out, kept for the file the fixer works on: its passes run many times,
// and the files that import it do not change meanwhile. The names are copied, so no pointer outlives the memory of a
// run.
struct SiblingCache {
    char file[cache_text_max];
    Usize file_length;
    char names[records_max][cache_text_max];
    Usize name_lengths[records_max];
    U64 left[records_max];
    U64 tested[records_max];
    Usize count;
};

static SiblingCache sibling_cache;

static Usize copy_into(char to[:], Str from) {
    Usize n = countof(from) < countof(to) ? countof(from) : countof(to);
    for (Usize i = 0; i < n; i++)
        to[i] = from[i];
    return n;
}

static Bool exports_a_record(const Wanted *w) {
    for (Usize r = 0; r < w->count; r++)
        if (w->records[r].exported) return true;
    return false;
}

// The folder of `file` (`.` when it has none).
static Str folder_of(Str file) {
    for (Usize i = countof(file); i > 0; i--)
        if (file[i - 1] == '/') return i == 1 ? file[0:1] : file[0:i - 1];
    return ".";
}

// The name of `file` without its folder and its `.smith`: the last name of its module.
static Str base_of(Str file) {
    Usize start = 0;
    for (Usize i = countof(file); i > 0 && start == 0; i--)
        if (file[i - 1] == '/') start = i;
    Usize end = countof(file);
    if (end >= start + 6 && same(file[end - 6:end], ".smith")) end -= 6;
    return file[start:end];
}

// The constructions in the other `.smith` files of `folder` that import the module.
static void scan_folder(Wanted *w, const ast::Module *module, Str folder) {
    files::EntriesResult listed = files::list(folder);
    if (listed == .error) return;
    for (Usize i = 0; i < countof(listed.ok); i++) {
        files::Entry entry = listed.ok[i];
        Usize n = countof(entry.name);
        if (entry.folder || n < 7 || !same(entry.name[n - 6:n], ".smith")) continue;
        Str path = types::message_of(format::push(folder, "/", entry.name));
        if (same(path, module->file) || same(entry.name, module->file)) continue;
        files::BytesResult loaded = files::read_file(path);
        if (loaded == .error) continue;
        format::Chars chars = mem::view(loaded.ok, char);
        scan_file(w, chars, base_of(module->file), false);
    }
}

constexpr Usize folders_max = 4096;

// Whether the walk of the tree skips the folder `name`: a hidden one (`.git`, `.smith`) or a build's output.
static Bool skipped_folder(Str name) {
    return countof(name) == 0 || name[0] == '.' || same(name, "build");
}

// Whether `file` is in the tree under the working folder: a relative path, or an absolute one whose end names a file
// there (the coverage tool fixes a copy by its absolute path from the pristine tree, #2521).
static Bool in_working_tree(Str file) {
    if (countof(file) == 0 || file[0] != '/') return true;
    for (Usize i = 1; i + 1 < countof(file); i++)
        if (file[i] == '/' && files::exists(file[i + 1:countof(file)])) return true;
    return false;
}

// The constructions in every file of the tree under the working folder that imports the module, wherever it is
// (#2543: `tests/front_format_space_test.smith` builds `front.format_space.SpaceContext`). The module's own folder is
// read first; the walk is a stack of folders, as no recursion is allowed. Only for a module whose file is in the tree:
// a bare `t.smith` (a test's) has only its neighbours.
static void scan_siblings(Wanted *w, const ast::Module *module) {
    Str own = folder_of(module->file);
    scan_folder(w, module, own);
    if (same(own, ".") || !in_working_tree(module->file)) return;
    Str stack[folders_max];
    Usize top = 1;
    stack[0] = ".";
    Usize visited = 0;
    while (top > 0 && visited < folders_max) {
        top -= 1;
        Str folder = stack[top];
        visited += 1;
        if (!same(folder, own)) scan_folder(w, module, folder);
        files::EntriesResult listed = files::list(folder);
        if (listed == .error) continue;
        for (Usize i = 0; i < countof(listed.ok) && top < folders_max; i++) {
            files::Entry entry = listed.ok[i];
            if (!entry.folder || skipped_folder(entry.name)) continue;
            stack[top] = same(folder, ".") ? types::message_of(format::push(entry.name))
                                           : types::message_of(format::push(folder, "/", entry.name));
            top += 1;
        }
    }
}

static void from_siblings(Wanted *w, const ast::Module *module) {
    if (!exports_a_record(w) || countof(base_of(module->file)) == 0 || countof(module->file) >= cache_text_max) return;
    SiblingCache *cache = &sibling_cache;
    if (!same(cache->file[0:cache->file_length], module->file)) {
        Wanted found = *w;
        for (Usize r = 0; r < found.count; r++) {
            found.left[r] = 0;
            found.tested[r] = 0;
        }
        scan_siblings(&found, module);
        cache->file_length = copy_into(cache->file[0:cache_text_max], module->file);
        cache->count = found.count;
        for (Usize r = 0; r < found.count; r++) {
            cache->name_lengths[r] = copy_into(cache->names[r][0:cache_text_max], found.records[r].name);
            cache->left[r] = found.left[r];
            cache->tested[r] = found.tested[r];
        }
    }
    for (Usize r = 0; r < cache->count; r++) {
        Usize at = record_index(w, cache->names[r][0:cache->name_lengths[r]]);
        if (at == w->count) continue;
        w->left[at] |= cache->left[r];
        w->text_left[at] |= cache->left[r];
        w->tested[at] |= cache->tested[r];
    }
}

// The type of a field, resolved in the module as smith's own syntax; null when it does not resolve. Resolving it must
// not leave an error behind.
static types::TypeRef field_type(types::Checked *c, const ast::FieldDecl *f) {
    contract::assert(f->type != nullptr); // a member of a record is written with its type
    Usize errors_before = c->error_count;
    Bool was_new = c->new_syntax;
    c->new_syntax = true;
    types::TypeRef t = types::resolve(c, f->type);
    c->new_syntax = was_new;
    c->error_count = errors_before;
    return t;
}

// `S(a = 0, b = 0)` for a struct of the module being fixed that is not complete to the checker yet (its fields are
// still C types): each field's flat zero. Empty when a field has none, or the struct is not the module's.
static Str local_record_zero(types::TypeRef t, Str name) {
    if (naming == nullptr || naming_module == nullptr || countof(types::owner_of(t)) != 0) return "";
    Wanted w = records_of(naming_module);
    Usize r = record_index(&w, types::name_of(t));
    if (r >= w.count) return "";
    ast::FieldDecl fields[:] = w.records[r].fields;
    Str built = "";
    Bool pointers = false;
    for (Usize k = 0; k < countof(fields); k++) {
        Str one = "";
        if (fields[k].type != nullptr) {
            types::TypeRef ft = field_type(naming, &fields[k]);
            if (ft != nullptr) one = flat_zero(ft);
            if (ft != nullptr && (ft->kind == .pointer || ft->kind == .function)) pointers = true;
        }
        if (mentions(one, "nullptr")) one = "";
        if (countof(one) == 0 && pointers) continue;
        if (countof(one) == 0 || !nameable(fields[k].name)) return "";
        built = types::message_of(format::push(built, k > 0 ? ", " : "", fields[k].name, " = ", one));
    }
    if (pointers) return "undefined"; // C fills a pointer before use (lead on #2613)
    if (countof(built) == 0) return "";
    return types::message_of(format::push(name, "(", built, ")"));
}

// A record of the module that a field left out holds is built with `R()`, so every field of it is left out too, a
// few records deep.
static void nest(Wanted *w, types::Checked *c) {
    for (Usize pass = 0; pass < 4; pass++) {
        for (Usize r = 0; r < w->count; r++) {
            ast::FieldDecl fields[:] = w->records[r].fields;
            for (Usize k = 0; k < countof(fields) && k < fields_max; k++) {
                if ((w->left[r] & ((U64)1 << k)) == 0 || fields[k].type == nullptr) continue;
                types::TypeRef t = field_type(c, &fields[k]);
                if (t == nullptr || t->kind != .record || countof(types::owner_of(t)) > 0) continue;
                Usize e = record_index(w, types::name_of(t));
                if (e < w->count) w->left[e] = all_fields(&w->records[e]);
            }
        }
    }
}

// Whether the written type is a pointer or a function, or a name the module declares as one (`TypeRef := *Ty`, C's
// `typedef const Ty *TypeRef;`). From the declarations alone, so that the struct's file and its importers agree.
static Bool pointer_like(const ast::Module *module, const ast::TypeExpr *t) {
    if (t == nullptr) return false;
    if (t->kind == .pointer || t->kind == .function) return true;
    if (!(t->kind == .named) || countof(t->kind.named.path.segments) != 1) return false;
    Str name = t->kind.named.path.segments[0].text;
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        const ast::TypeExpr *aliased = nullptr;
        if (d->kind == .type_alias && same(d->kind.type_alias.name, name)) {
            aliased = d->kind.type_alias.type;
        } else if (d->kind == .variable && same(d->kind.variable.name, name)) {
            const ast::Expr *init = d->kind.variable.init; // `TypeRef := *Ty`, a type as a value
            if (init != nullptr && init->kind == .type_value) aliased = init->kind.type_value.type;
        } else {
            continue;
        }
        return aliased != nullptr && (aliased->kind == .pointer || aliased->kind == .function);
    }
    return false;
}

// The pointer fields of the record `r` that C leaves null where null is a real state (#2557, owner on #2530): a
// construction the text shows leaves the field out, and a read tests it against null. Each becomes `?*T = .none`
// (`?F = .none` for a function, lead on #2557). Only the text counts, not the checker, so that the struct's file and
// each file that imports it, fixed one at a time, make the same decision.
static U64 nullable(const ast::Module *module, const Wanted *w, Usize r) {
    U64 out = 0;
    ast::FieldDecl fields[:] = w->records[r].fields;
    U64 both = w->text_left[r] & w->tested[r];
    // A C-layout struct is read by C, which takes null for unset: a pointer a construction leaves out is an option even
    // when no smith read tests it (D2, lead on #2631: translating, not inventing).
    if (w->records[r].c_layout) both = w->text_left[r];
    for (Usize k = 0; k < countof(fields) && k < fields_max; k++) {
        U64 bit = (U64)1 << k;
        if ((both & bit) == 0 || fields[k].default_value != nullptr || fields[k].bit_width != nullptr) continue;
        if (pointer_like(module, fields[k].type)) out |= bit;
    }
    return out;
}

// Whether the fix writes a `nullptr`: a pointer a smith struct's construction leaves out has no zero. It becomes
// `?*T = .none` (`nullable`, item 3 of #3224) or stays an error; only a C header's struct is given `nullptr`.
static Bool needs_pointer(core::ParseError fix) {
    return countof(fix.fix) > 0 && mentions(fix.fix[0].text, "nullptr");
}

// Whether a field of the record is a pointer or a function that stays one, or a record of this module that holds one,
// as far down as it goes: it has no zero, so a value of the record cannot be built from defaults.
static Bool has_plain_pointer(const ast::Module *module, types::Checked *c, const Wanted *w, Usize e) {
    Usize stack[records_max] = {};
    Bool seen[records_max] = {};
    Usize top = 1;
    stack[0] = e;
    seen[e] = true;
    while (top > 0) {
        top -= 1;
        Usize r = stack[top];
        U64 nulls = nullable(module, w, r); // those are options, with a default of their own
        ast::FieldDecl fields[:] = w->records[r].fields;
        for (Usize k = 0; k < countof(fields) && k < fields_max; k++) {
            if (fields[k].type == nullptr || (nulls & ((U64)1 << k)) != 0) continue;
            types::TypeRef t = field_type(c, &fields[k]);
            if (t == nullptr) continue;
            if (t->kind == .pointer) return true;
            if (t->kind != .record || countof(types::owner_of(t)) > 0) continue;
            Usize inner = record_index(w, types::name_of(t));
            if (inner < w->count && !seen[inner]) {
                seen[inner] = true;
                stack[top] = inner;
                top += 1;
            }
        }
    }
    return false;
}

// The fix that writes the pointer field `f` as an option with no value: `next: ?*Node = .none`.
static core::ParseError nullable_fix(const ast::FieldDecl *f) {
    contract::assert(f->type != nullptr); // the caller found a pointer type in it
    core::Edits fix = {};
    fix = mem::realloc(fix, 2);
    Str mark = "?";
    Str none = " = .none";
    fix[0] = (core::Edit){.span = {.start = f->type->span.start, .end = f->type->span.start}, .text = mark};
    fix[1] = (core::Edit){.span = {.start = f->type->span.end, .end = f->type->span.end}, .text = none};
    core::ParseError found = {};
    found.span = f->span;
    found.message = "a pointer that a construction leaves null and a read tests is an option: `?*T = .none`";
    found.fix = fix;
    return found;
}

// Whether the field `f` is a member that is a record of this module with a pointer that stays a pointer.
static Bool holds_plain_pointers(const ast::Module *module, types::Checked *c, const Wanted *w,
                                 const ast::FieldDecl *f) {
    types::TypeRef t = field_type(c, f);
    if (t == nullptr || t->kind != .record || countof(types::owner_of(t)) > 0) return false;
    Usize e = record_index(w, types::name_of(t));
    return e < w->count && has_plain_pointer(module, c, w, e);
}

// The fix that gives the member `f` the default `= undefined`.
static core::ParseError undefined_default(const ast::FieldDecl *f) {
    core::Edits fix = {};
    contract::assert(f->type != nullptr); // the caller found a pointer type in it
    fix = mem::realloc(fix, 1);
    U32 at = f->type->span.end;
    Str text = " = undefined";
    fix[0] = (core::Edit){.span = {.start = at, .end = at}, .text = text};
    core::ParseError found = {};
    found.span = f->span;
    found.message = "a member whose pointers C fills before use is `undefined` until then";
    found.fix = fix;
    return found;
}

// The defaults of the fields of the module's records that some construction leaves out, one insertion after each
// field's type: `count: usize = 0`.
static core::Errors defaults(Str source, const ast::Module *module, types::Checked *c, core::Errors out) {
    Wanted w = records_of(module);
    if (w.count == 0) return out;
    from_checker(&w, c);
    scan_file(&w, source, "", true);
    from_siblings(&w, module);
    nest(&w, c);
    for (Usize r = 0; r < w.count; r++) {
        ast::FieldDecl fields[:] = w.records[r].fields;
        U64 nulls = nullable(module, &w, r);
        for (Usize k = 0; k < countof(fields) && k < fields_max; k++) {
            const ast::FieldDecl *f = &fields[k];
            if ((w.left[r] & ((U64)1 << k)) == 0 || !f->is_new || f->default_value != nullptr) continue;
            if (f->bit_width != nullptr || f->type == nullptr || !nameable(f->name)) continue;
            if ((nulls & ((U64)1 << k)) != 0) {
                out = add(out, nullable_fix(f));
                continue;
            }
            // Any other field is not given a default in the struct (#3190 item 25, #3224): the construction that
            // leaves it out writes it (`module_edits`). The one exception is a member that is a record of this module
            // holding a pointer that stays a pointer: no construction can write it (`undefined` is a whole
            // initializer, not a value in a call), and C fills it before use (lead on #2613, #3268's regression).
            if (holds_plain_pointers(module, c, &w, f)) out = add(out, undefined_default(f));
        }
    }
    return out;
}

// ---------------------------------------------------------------------------------------------------------------
// A module that a file being fixed imports, as its own fix will write it (#2557): the reads of its option fields in the
// importing file are mended against `?*T`, not the pristine `*T`.

constexpr Usize loaded_max = 128;

// The decisions for the modules read so far, by file and contents: each costs a walk of the tree, and the checker
// reads a module again on every pass. A record is kept by its place among the module's records.
struct LoadedCache {
    char files[loaded_max][cache_text_max];
    Usize lengths[loaded_max];
    U64 hashes[loaded_max];
    U64 masks[loaded_max][records_max];
    Usize count;
};

static LoadedCache loaded_cache;

static U64 hash_of(Str text) {
    U64 h = 14695981039346656037U;
    for (Usize i = 0; i < countof(text); i++) {
        h ^= (U64)(U8)text[i];
        h *= 1099511628211U;
    }
    return h;
}

// The file of SMITH_FIX_IMPORT_CACHE that keeps the masks of the module `file` whose text hashes to `h`, or an empty
// text when the variable is not set. Each mask costs a walk of the whole tree, once in every fixer that imports the
// module: the count of `frontend-coverage`, a fixer for each of its 1500 files, no longer fitted in its 20 minutes
// (#2586). The coverage empties the folder at the start of a run, so the tree the masks were read from is this run's.
static Str masks_file(Str file, U64 h) {
    const char *folder = c::getenv("SMITH_FIX_IMPORT_CACHE");
    if (folder == nullptr) return "";
    U64 key = hash_of(file) ^ (h * 1099511628211U);
    return types::message_of(format::push(folder, "/", format::hex(key, 16), ".masks"));
}

// Reads the `count` masks kept for the module, false when none are.
static Bool kept_masks(Str file, U64 h, Usize count, U64 masks[records_max]) {
    Str path = masks_file(file, h);
    if (countof(path) == 0 || !files::exists(path)) return false;
    files::BytesResult loaded = files::read_file(path);
    if (loaded == .error) return false;
    if (countof(loaded.ok) != count * 8) return false;
    for (Usize r = 0; r < count; r++) {
        U64 m = 0;
        for (Usize b = 0; b < 8; b++)
            m |= (U64)loaded.ok[r * 8 + b] << (8 * b);
        masks[r] = m;
    }
    return true;
}

// Keeps the `count` masks of the module for the next fixer, when SMITH_FIX_IMPORT_CACHE is set.
static void keep_masks(Str file, U64 h, Usize count, const U64 masks[records_max]) {
    Str path = masks_file(file, h);
    if (countof(path) == 0) return;
    U8 bytes[:] = mem::alloc_slice(U8, count * 8);
    for (Usize r = 0; r < count; r++) {
        for (Usize b = 0; b < 8; b++)
            bytes[r * 8 + b] = (U8)(masks[r] >> (8 * b));
    }
    (void)files::write_file(path, bytes, files::Atomic);
}

// The nullable fields of each record of `module` (its text is `source`), from the cache or worked out once.
static void loaded_masks(const ast::Module *module, Str source, Wanted *w, U64 masks[records_max]) {
    LoadedCache *cache = &loaded_cache;
    U64 h = hash_of(source);
    for (Usize i = 0; i < cache->count; i++) {
        if (cache->hashes[i] != h || !same(cache->files[i][0:cache->lengths[i]], module->file)) continue;
        for (Usize r = 0; r < w->count; r++)
            masks[r] = cache->masks[i][r];
        return;
    }
    if (!kept_masks(module->file, h, w->count, masks)) {
        scan_file(w, source, "", true);
        scan_siblings(w, module);
        for (Usize r = 0; r < w->count; r++)
            masks[r] = nullable(module, w, r);
        keep_masks(module->file, h, w->count, masks);
    }
    if (cache->count == loaded_max || countof(module->file) >= cache_text_max) return;
    Usize at = cache->count;
    cache->lengths[at] = copy_into(cache->files[at][0:cache_text_max], module->file);
    cache->hashes[at] = h;
    for (Usize r = 0; r < w->count; r++)
        cache->masks[at][r] = masks[r];
    cache->count += 1;
}

// Writes each pointer field of `module` that its own file's fix makes an option as `?*T = .none` in the tree: the type
// wrapped in an option, the default `.none`. `source` is the module's text.
export void nullable_fields(ast::Module *module, Str source) {
    Wanted w = records_of(module);
    if (w.count == 0 || !exports_a_record(&w) || countof(base_of(module->file)) == 0) return;
    U64 masks[records_max] = {};
    loaded_masks(module, source, &w, masks);
    for (Usize r = 0; r < w.count; r++) {
        ast::FieldDecl fields[:] = w.records[r].fields;
        for (Usize k = 0; k < countof(fields) && k < fields_max; k++) {
            if ((masks[r] & ((U64)1 << k)) == 0) continue;
            ast::TypeExpr *inner = fields[k].type;
            contract::assert(inner != nullptr); // the mask has a bit only for a field with a pointer type
            ast::TypeExpr *wrapped = mem::alloc(ast::TypeExpr);
            wrapped->span = inner->span;
            ast::TypeKind kind = {.option = {.inner = inner}};
            wrapped->kind = kind;
            fields[k].type = wrapped;
            Str none = "none";
            ast::Expr value = {.span = inner->span, .kind = {.variant = {.name = none, .payload = nullptr}}};
            fields[k].default_value = ast::new_expr(value);
        }
    }
}

// The fixes of the module's `{}` declarations, as errors that carry them (the driver applies them with the rest).
// Whether `call` is the whole initializer of a variable the module declares at its top level, written with no
// arguments (`first_task: Task = Task()`).
static Bool global_zero(const ast::Module *module, const ast::Expr *call) {
    if (call == nullptr || call->kind != .call || countof(call->kind.call.args) != 0) return false;
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind == .variable && d->kind.variable.init == call) return true;
    }
    return false;
}

static core::ParseError undefined_fix(const ast::Expr *call) {
    core::Edits fix = {};
    fix = mem::realloc(fix, 1);
    fix[0] = (core::Edit){.span = call->span, .text = types::message_of(format::push("undefined"))};
    core::ParseError found = {};
    found.span = call->span;
    found.message = "a global of a struct with pointers C fills before use is `undefined`";
    found.fix = fix;
    return found;
}

// The fix of a global `static arena::Arena memory;` that is written `arena.Arena()`: `mem.zeroed(arena.Arena)`.
static core::ParseError zeroed_global_fix(Str source, const ast::Expr *call) {
    core::ParseError none = {};
    if (call->kind != .call) return none;
    const ast::Expr *callee = call->kind.call.callee;
    core::Edits fix = {};
    fix = mem::realloc(fix, 1);
    Str written = source[callee->span.start:callee->span.end];
    fix[0] = (core::Edit){.span = call->span, .text = types::message_of(format::push("mem.zeroed(", written, ")"))};
    core::ParseError found = {};
    found.span = call->span;
    found.message = "a global of a struct of another module is C's zeroed storage, `mem.zeroed(T)`";
    found.fix = fix;
    zeroed_written = true;
    return found;
}

// The fixes of a `{}` where a `str` is wanted (`none: str = {}`, C's `Str none = {};`): the empty string `""`. The
// checker refuses the list (`not a `Str``) and carries no fix.
static core::Errors empty_strings(core::Errors out, Str source, const types::Checked *c) {
    Str head = "a `{...}` list makes a struct";
    Str tail = "not a `Str`; write a value of type `Str`";
    for (Usize i = 0; i < c->error_count; i++) {
        types::Error e = c->errors[i];
        Str m = e.message;
        if (!text_at(m, 0, head) || countof(m) < countof(tail) || !same(m[countof(m) - countof(tail):countof(m)], tail))
            continue;
        if (e.span.end != e.span.start + 2 || !text_at(source, e.span.start, "{}")) continue;
        core::Edits fix = {};
        fix = mem::realloc(fix, 1);
        Str quotes = "\"\"";
        fix[0] = (core::Edit){.span = e.span, .text = quotes};
        core::ParseError found = {};
        found.span = e.span;
        found.message = "the empty `str` is `\"\"`";
        found.fix = fix;
        out = add(out, found);
    }
    return out;
}

// `out`, the fixes of a `{}` where a `str` is wanted and of the pointer parameters that are handed an option
// (`fix_optional`, #2648).
static core::Errors with_optionals(core::Errors out, Str source, const ast::Module *module, const types::Checked *c) {
    out = empty_strings(out, source, c);
    core::Errors optionals = fix_optional::edits(source, module, c);
    for (Usize i = 0; i < countof(optionals); i++)
        out = add(out, optionals[i]);
    core::Errors assigned = fix_optional::reassigned(source, module);
    for (Usize i = 0; i < countof(assigned); i++)
        out = add(out, assigned[i]);
    return out;
}

static Bool option_starts_with(Str text, Str prefix) {
    if (countof(text) < countof(prefix)) return false;
    return same(text[0:countof(prefix)], prefix);
}

static Bool option_contains(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++)
        if (same(text[i:i + countof(needle)], needle)) return true;
    return false;
}

// An option given to a pointer parameter that tests for null (#2648): `count(n->next)` where `n->next` is `?*Node`
// and `count` (of this module, written for a null: it tests `n == nullptr`) takes a `*Node`. The checker says "a value
// that may be absent (`?T`) is not a `T`"; the fix writes `?` before the parameter's pointer type, and the passes
// after it turn the tests into `.none` and narrow the name. A call written `name(args)` only: a fix edits one file.
// Where the call that holds the argument at `at` opens, and which argument it is: the `(` before it, or `at` when
// the argument is in no call (a bracket or a brace opens first).
static Usize option_call_open(Str source, Usize at, Usize *index) {
    Usize depth = 0;
    Usize open = at;
    *index = 0;
    while (open > 0) {
        open -= 1;
        char ch = source[open];
        if (ch == ')' || ch == ']' || ch == '}') {
            depth += 1;
        } else if (ch == '(' || ch == '[' || ch == '{') {
            if (depth > 0) {
                depth -= 1;
            } else if (ch == '(') {
                return open;
            } else {
                return at;
            }
        } else if (ch == ',' && depth == 0) {
            *index += 1;
        }
    }
    return at;
}

// The function of the module named `name`, or null.
static const ast::Decl *option_function_named(const ast::Module *module, Str name) {
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind == .function && same(d->kind.function.name, name)) return d;
    }
    return nullptr;
}

// Whether the text of the function tests `name` against null: `name == nullptr`, `name != .none` and the like.
static Bool option_tests_for_null(Str body, Str name) {
    for (Usize i = 0; i + countof(name) < countof(body); i++) {
        if (!option_starts_with(body[i:countof(body)], name)) continue;
        if (i > 0 && (word_char(body[i - 1]) || body[i - 1] == '.')) continue;
        Str after = body[i + countof(name):countof(body)];
        if (option_starts_with(after, " == nullptr") || option_starts_with(after, " != nullptr") ||
            option_starts_with(after, " == .none") || option_starts_with(after, " != .none"))
            return true;
    }
    return false;
}

static Bool option_seen(core::Errors out, Usize at) {
    for (Usize i = 0; i < countof(out); i++)
        if (out[i].span.start == at) return true;
    return false;
}

static core::Errors option_param_edits(core::Errors out, Str source, const ast::Module *module,
                                       const types::Checked *c) {
    for (Usize i = 0; i < c->error_count; i++) {
        types::Error found = c->errors[i];
        if (countof(found.fix) > 0 || found.span.end > countof(source) || found.span.start >= found.span.end) continue;
        if (!option_starts_with(found.message, "expected ") || !option_contains(found.message, ", found Option(") ||
            !option_contains(found.message, "a value that may be absent (`?T`) is not a `T`"))
            continue;
        Usize index = 0;
        Usize open = option_call_open(source, found.span.start, &index);
        if (open == found.span.start) continue;
        Usize stop = open;
        Usize start = stop;
        while (start > 0 && word_char(source[start - 1]))
            start -= 1;
        if (start == stop || (start > 0 && (source[start - 1] == '.' || source[start - 1] == ':'))) continue;
        const ast::Decl *callee = option_function_named(module, source[start:stop]);
        if (callee == nullptr || callee->kind != .function || index >= countof(callee->kind.function.params)) continue;
        const ast::Param *param = &callee->kind.function.params[index];
        if (param->is_pack || param->is_keyword || param->type == nullptr || param->type->kind != .pointer) continue;
        U32 at = param->type->span.start;
        if (option_seen(out, at) || callee->span.end > countof(source)) continue;
        if (!option_tests_for_null(source[callee->span.start:callee->span.end], param->name)) continue;
        core::Edits fix = {};
        fix = mem::realloc(fix, 1);
        Str mark = "?";
        fix[0] = (core::Edit){.span = {.start = at, .end = at}, .text = mark};
        core::ParseError made = {};
        made.span = fix[0].span;
        made.message = "a parameter that is tested for null and given an option is `?*T`";
        made.fix = fix;
        out = mem::realloc(out, countof(out) + 1);
        out[countof(out) - 1] = made;
    }
    return out;
}

// The imports the edits need: `std.array` for an `array.filled`, `std.mem` for a `mem.zeroed`; the flags are per file.
static core::Errors with_imports(core::Errors out, const ast::Module *module, Bool filled) {
    if (filled || array_written) out = add(out, import_std(module, "array"));
    if (zeroed_written) out = add(out, import_std(module, "mem"));
    array_written = false;
    zeroed_written = false;
    return out;
}

static core::Errors module_edits(Str source, const ast::Module *module, types::Checked *c) {
    core::Errors out = {};
    Bool filled = false;
    out = defaults(source, module, c, out);
    Wanted local = records_of(module);
    const ast::Expr *last = nullptr;
    for (Usize i = 0; i < c->error_count; i++) {
        types::Error error = c->errors[i];
        types::TypeRef record = error.left_out_record;
        if (error.left_out_call == nullptr || error.left_out_call == last || record == nullptr) continue;
        if (countof(error.module) > 0) continue; // the span is in the text of another module: its own fix mends it
        Bool from_header = same(types::owner_of(record), "c::");
        Usize own = record_index(&local, types::name_of(record));
        if (!from_header && countof(types::owner_of(record)) == 0 && own < local.count &&
            global_zero(module, error.left_out_call) && has_plain_pointer(module, c, &local, own)) {
            // C zeroes a global and fills its pointers before use: `x: T = T()` has no value for them, `undefined` is
            // the storage C gave (#2643).
            last = error.left_out_call;
            out = add(out, undefined_fix(error.left_out_call));
            continue;
        }
        if (!from_header && countof(types::owner_of(record)) > 0 && global_zero(module, error.left_out_call)) {
            // A global `static arena::Arena memory;` of a struct of another module that gives no defaults: C's zeroed
            // storage is `mem.zeroed(T)` (D10, #2648).
            last = error.left_out_call;
            out = add(out, zeroed_global_fix(source, error.left_out_call));
            continue;
        }
        last = error.left_out_call;
        core::ParseError given_zero = left_out_fix(source, error.left_out_call, record, error.left_out_given);
        if (!from_header && needs_pointer(given_zero)) continue;
        if (countof(given_zero.fix) == 0 && global_zero(module, error.left_out_call)) {
            out = add(out, undefined_fix(error.left_out_call)); // a C union or struct of a global: C's zeroed storage
            continue;
        }
        out = add(out, given_zero);
    }
    Work w = {};
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind == .function) push(&w, d->kind.function.body);
        if (d->kind == .variable) {
            ast::StmtRef none[:] = {};
            out = add(out, fix_of(source, c, d, none, no_block, &filled));
        }
    }
    while (w.top > 0) {
        w.top -= 1;
        const ast::Stmt *s = w.items[w.top];
        if (s->kind == .block) {
            ast::StmtRef items[:] = s->kind.block.items;
            for (Usize i = 0; i < countof(items); i++) {
                const ast::Stmt *item = items[i];
                if (item->kind == .declaration)
                    out = add(out, fix_of(source, c, item->kind.declaration.decl, items, i, &filled));
            }
        }
        push_children(&w, s);
    }
    out = zeroed_literals(out, source);
    out = with_optionals(out, source, module, c);
    // the import waits when it starts where the function's own rewrite does: the next pass finds the call and adds it
    for (Usize k = 0; k < countof(source) && !zeroed_written; k += 1)
        if (source[k] == 'm' && text_at(source, k, "mem.zeroed(") && (k == 0 || !word_char(source[k - 1])))
            zeroed_written = true;
    out = with_imports(out, module, filled);
    out = option_param_edits(out, source, module, c);
    localize(module, out);
    return out;
}

export core::Errors edits(Str source, const ast::Module *module, types::Checked *c) {
    naming = c; // what `nested_name` resolves through: the file's checker and its imports
    naming_module = module;
    core::Errors out = module_edits(source, module, c);
    naming = nullptr;
    naming_module = nullptr;
    return out;
}
