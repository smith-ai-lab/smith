// front::emit_lambda: `fn` types and lambdas. Filled by the next batch of #1428; today every handler is `not emitted
// yet`, with its final signature, so that ticket edits this file and never front/emit.smith (the wave-3 scaffold, #1582
// of #1428).
module front::emit_lambda;

import front::ast;
import front::emit_state as state;
import front::types;

export state::TyResult type_function(state::Emitter *e, const ast::TypeExpr *t) {
    _ = e;
    return state::ty_fail("not emitted yet: a function type", t->span);
}

export state::TyResult from_checked(state::Emitter *e, types::TypeRef t) {
    _ = e;
    _ = t;
    return state::ty_fail("not emitted yet: a function type", (ast::Span){});
}

export state::Status lambda(state::Emitter *e, const ast::Expr *x, state::Hint hint) {
    _ = e;
    _ = hint;
    return state::not_emitted("a lambda", x->span);
}
