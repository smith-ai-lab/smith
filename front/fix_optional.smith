// front::fix_optional, the fix-it for a pointer parameter that is handed an option (#2648).
//
//   fn take(old: *Expr) -> *Expr:           fn take(old: ?*Expr) -> *Expr:
//       if old == nullptr: ...                  if old == nullptr: ...
//   take(list.default_value)                take(list.default_value)
//
// A field that a construction leaves out and a read tests against null is already `?*T = .none` (`fix_zero`). A
// function of the same module that tests its pointer parameter against `nullptr` and is called with such a field is the
// other half: the checker says `expected *T, found Option(*T)`, and the parameter is the option (the lead's rule: a
// pointer parameter that is tested against nullptr and is passed an option anywhere in the fixed tree becomes `?*T`).
// The parameter's own `nullptr` tests and the reads under them are mended by the checker's option guard on the next
// pass.
//
//   fix_optional::edits(source, module, checked)   one fix for each such parameter
module front::fix_optional;

import front::ast;
import front::parse as core;
import front::types;
import std::mem;

static Bool word_char(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
}

static Bool starts_with(Str text, Str prefix) {
    if (countof(text) < countof(prefix)) return false;
    for (Usize i = 0; i < countof(prefix); i++)
        if (text[i] != prefix[i]) return false;
    return true;
}

// Whether `body` tests the name `name` against `nullptr`: `name == nullptr`, `name != nullptr`, `nullptr == name`.
static Bool tests_null(Str body, Str name) {
    for (Usize i = 0; i + countof(name) <= countof(body); i++) {
        if (!starts_with(body[i:countof(body)], name)) continue;
        if (i > 0 && word_char(body[i - 1])) continue;
        Usize after = i + countof(name);
        if (after < countof(body) && word_char(body[after])) continue;
        Str rest = body[after:countof(body)];
        if (starts_with(rest, " == nullptr") || starts_with(rest, " != nullptr")) return true;
        if (i >= 11 && starts_with(body[i - 11:countof(body)], "nullptr == ")) return true;
        if (i >= 11 && starts_with(body[i - 11:countof(body)], "nullptr != ")) return true;
    }
    return false;
}

static Bool same(Str a, Str b) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i++)
        if (a[i] != b[i]) return false;
    return true;
}

// The function of `module` named `name`, or null.
static const ast::Decl *function_named(const ast::Module *module, Str name) {
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind != .function) continue;
        if (same(d->kind.function.name, name)) return d;
    }
    return nullptr;
}

// Whether the argument `arg` is an option. A call the checker refuses poisons its argument (its type is invalid), so a
// field read (`list.default_value`) is read from the record's declaration.
static Bool is_option(const types::Checked *c, const ast::Expr *arg) {
    types::TypeRef given = types::type_of(c, arg);
    if (given != nullptr && given->kind == .option) return true;
    if (arg->kind != .member) return false;
    types::TypeRef base = types::type_of(c, arg->kind.member.base);
    if (base == nullptr) return false;
    if (base->kind == .pointer) base = types::element_of(base);
    if (base->kind != .record) return false;
    const types::Slot *field = types::member(base, arg->kind.member.name);
    return field != nullptr && field->type != nullptr && field->type->kind == .option;
}

static Bool seen(core::Errors out, Usize at) {
    for (Usize i = 0; i < countof(out); i++)
        if (out[i].span.start == at) return true;
    return false;
}

// The fixes of the calls in `module` that hand an option to a pointer parameter the callee tests against `nullptr`.
export core::Errors edits(Str source, const ast::Module *module, const types::Checked *c) {
    core::Errors out = {};
    for (Usize i = 0; i < countof(c->nodes); i++) {
        const ast::Expr *e = c->nodes[i].node;
        if (e == nullptr || e->kind != .call) continue;
        const ast::Expr *callee = e->kind.call.callee;
        if (callee->kind != .name || countof(callee->kind.name.path.segments) != 1) continue;
        const ast::Decl *d = function_named(module, callee->kind.name.path.segments[0].text);
        if (d == nullptr || d->kind != .function || d->kind.function.body == nullptr) continue;
        ast::ExprRef args[:] = e->kind.call.args;
        Usize n = countof(args) < countof(d->kind.function.params) ? countof(args) : countof(d->kind.function.params);
        Str body = source[d->kind.function.body->span.start:d->kind.function.body->span.end];
        for (Usize k = 0; k < n; k++) {
            const ast::Param *p = &d->kind.function.params[k];
            if (p->type == nullptr || p->type->kind != .pointer || p->is_rest) continue;
            if (!is_option(c, args[k])) continue;
            if (!tests_null(body, p->name) || seen(out, p->type->span.start)) continue;
            core::Edits fix = {};
            fix = mem::realloc(fix, 1);
            ast::Span at = {.start = p->type->span.start, .end = p->type->span.start};
            Str question = "?";
            fix[0] = (core::Edit){.span = at, .text = question};
            out = mem::realloc(out, countof(out) + 1);
            core::ParseError found = {};
            found.span = p->type->span;
            found.message =
                "a pointer parameter that is tested against nullptr and is handed an option is an option: `?*T`";
            found.fix = fix;
            out[countof(out) - 1] = found;
        }
    }
    return out;
}
