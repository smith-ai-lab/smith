// front::fix_optional, the fix-it for a pointer parameter that is handed an option (#2648).
//
//   fn take(old: *Expr) -> *Expr:           fn take(old: ?*Expr) -> *Expr:
//       if old == nullptr: ...                  if old == nullptr: ...
//   take(list.default_value)                take(list.default_value)
//
// A field that a construction leaves out and a read tests against null is already `?*T = .none` (`fix_zero`). A
// function of the same module that tests its pointer parameter against `nullptr` and is called with such a field is the
// other half: the checker says `expected *T, found Option(*T)`, and the parameter is the option (the lead's rule: a
// pointer parameter that is tested against nullptr and is passed an option anywhere in the fixed tree becomes `?*T`).
// The parameter's own `nullptr` tests and the reads under them are mended by the checker's option guard on the next
// pass.
//
//   fix_optional::edits(source, module, checked)   one fix for each such parameter
module front::fix_optional;

import front::ast;
import front::parse as core;
import front::types;
import std::format;
import std::mem;

static Bool word_char(char ch) {
    return (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9') || ch == '_';
}

static Bool starts_with(Str text, Str prefix) {
    if (countof(text) < countof(prefix)) return false;
    for (Usize i = 0; i < countof(prefix); i++)
        if (text[i] != prefix[i]) return false;
    return true;
}

// Whether `body` tests the name `name` against `nullptr`: `name == nullptr`, `name != nullptr`, `nullptr == name`.
static Bool tests_null(Str body, Str name) {
    for (Usize i = 0; i + countof(name) <= countof(body); i++) {
        if (!starts_with(body[i:countof(body)], name)) continue;
        if (i > 0 && word_char(body[i - 1])) continue;
        Usize after = i + countof(name);
        if (after < countof(body) && word_char(body[after])) continue;
        Str rest = body[after:countof(body)];
        if (starts_with(rest, " == nullptr") || starts_with(rest, " != nullptr")) return true;
        if (i >= 11 && starts_with(body[i - 11:countof(body)], "nullptr == ")) return true;
        if (i >= 11 && starts_with(body[i - 11:countof(body)], "nullptr != ")) return true;
    }
    return false;
}

static Bool same(Str a, Str b) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i++)
        if (a[i] != b[i]) return false;
    return true;
}

// The function of `module` named `name`, or null.
static const ast::Decl *function_named(const ast::Module *module, Str name) {
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind != .function) continue;
        if (same(d->kind.function.name, name)) return d;
    }
    return nullptr;
}

// Whether the argument `arg` is an option. A call the checker refuses poisons its argument (its type is invalid), so a
// field read (`list.default_value`) is read from the record's declaration.
static Bool is_option(const types::Checked *c, const ast::Expr *arg) {
    types::TypeRef given = types::type_of(c, arg);
    if (given != nullptr && given->kind == .option) return true;
    if (arg->kind != .member) return false;
    types::TypeRef base = types::type_of(c, arg->kind.member.base);
    if (base == nullptr) return false;
    if (base->kind == .pointer) base = types::element_of(base);
    if (base->kind != .record) return false;
    const types::Slot *field = types::member(base, arg->kind.member.name);
    return field != nullptr && field->type != nullptr && field->type->kind == .option;
}

static Bool seen(core::Errors out, Usize at) {
    for (Usize i = 0; i < countof(out); i++)
        if (out[i].span.start == at) return true;
    return false;
}

// The fixes of the calls in `module` that hand an option to a pointer parameter the callee tests against `nullptr`.
export core::Errors edits(Str source, const ast::Module *module, const types::Checked *c) {
    core::Errors out = {};
    for (Usize i = 0; i < countof(c->nodes); i++) {
        const ast::Expr *e = c->nodes[i].node;
        if (e == nullptr || e->kind != .call) continue;
        const ast::Expr *callee = e->kind.call.callee;
        if (callee->kind != .name || countof(callee->kind.name.path.segments) != 1) continue;
        const ast::Decl *d = function_named(module, callee->kind.name.path.segments[0].text);
        if (d == nullptr || d->kind != .function || d->kind.function.body == nullptr) continue;
        ast::ExprRef args[:] = e->kind.call.args;
        Usize n = countof(args) < countof(d->kind.function.params) ? countof(args) : countof(d->kind.function.params);
        Str body = source[d->kind.function.body->span.start:d->kind.function.body->span.end];
        for (Usize k = 0; k < n; k++) {
            const ast::Param *p = &d->kind.function.params[k];
            if (p->type == nullptr || p->type->kind != .pointer || p->is_rest) continue;
            if (!is_option(c, args[k])) continue;
            if (!tests_null(body, p->name) || seen(out, p->type->span.start)) continue;
            core::Edits fix = {};
            fix = mem::realloc(fix, 1);
            ast::Span at = {.start = p->type->span.start, .end = p->type->span.start};
            Str question = "?";
            fix[0] = (core::Edit){.span = at, .text = question};
            out = mem::realloc(out, countof(out) + 1);
            core::ParseError found = {};
            found.span = p->type->span;
            found.message =
                "a pointer parameter that is tested against nullptr and is handed an option is an option: `?*T`";
            found.fix = fix;
            out[countof(out) - 1] = found;
        }
    }
    return out;
}

// ---------------------------------------------------------------------------------------------------------------
// A parameter that is an option and is assigned later

static Usize line_start(Str s, Usize at) {
    while (at > 0 && s[at - 1] != '\n')
        at -= 1;
    return at;
}

static Usize line_end(Str s, Usize at) {
    while (at < countof(s) && s[at] != '\n')
        at += 1;
    return at;
}

static Usize indent_of(Str s, Usize start) {
    Usize k = start;
    while (k < countof(s) && s[k] == ' ')
        k += 1;
    return k - start;
}

static Bool blank(Str s, Usize start, Usize end) {
    return indent_of(s, start) == end - start;
}

// The end of the guard `if name == .none:` that opens the body (the first statement of the lines from `at`), when its
// block ends in a `return`; else zero.
static Usize guard_end(Str source, Usize at, Usize limit, Str name) {
    Usize ls = line_start(source, at);
    while (ls < limit && blank(source, ls, line_end(source, ls)))
        ls = line_end(source, ls) + 1;
    Usize base = indent_of(source, ls);
    Str head = source[ls + base:line_end(source, ls)];
    Str want = "if ";
    if (!starts_with(head, want)) return 0;
    Str rest = head[3:countof(head)];
    if (!starts_with(rest, name)) return 0;
    if (!same(rest[countof(name):countof(rest)], " == .none:")) return 0;
    Usize end = line_end(source, ls);
    Usize last = end;
    Usize k = end + 1;
    while (k < limit) {
        Usize e = line_end(source, k);
        if (!blank(source, k, e)) {
            if (indent_of(source, k) <= base) break;
            last = e;
        }
        k = e + 1;
    }
    Usize from = line_start(source, last);
    Str tail = source[from + indent_of(source, from):last];
    if (last == end || !starts_with(tail, "return")) return 0;
    return last;
}

// The edits of the option parameter `p` of `d` that the body assigns: it is no longer `mut`, and after the guard
// a local `mut name_some: *T = name` takes its place for the rest of the body.
static core::Edits reassigned_fix(Str source, const ast::Decl *d, const ast::Param *p) {
    core::Edits none = {};
    if (d->kind != .function) return none;
    Usize body_start = d->kind.function.body->span.start;
    Usize body_end = d->kind.function.body->span.end;
    Usize at = body_start;
    if (at < countof(source) && source[at] == '{') return none; // still braced: a later pass
    if (at < countof(source) && source[at] == ':') at = line_end(source, at) + 1;
    Usize end = guard_end(source, at, body_end, p->name);
    if (end == 0 || !starts_with(source[p->span.start:countof(source)], "mut ")) return none;
    Str local = types::message_of(format::push(p->name, "_some"));
    Str pointer = source[p->type->span.start + 1:p->type->span.end];
    Usize first = line_start(source, at);
    while (first < body_end && blank(source, first, line_end(source, first)))
        first = line_end(source, first) + 1;
    Usize base = indent_of(source, first);
    Str pad = "";
    for (Usize i = 0; i < base; i++)
        pad = types::message_of(format::push(pad, " "));
    core::Edits out = {};
    out = mem::realloc(out, 2);
    ast::Span drop = {.start = p->span.start, .end = p->span.start + 4};
    Str nothing = "";
    out[0] = (core::Edit){.span = drop, .text = nothing};
    ast::Span here = {.start = (U32)end, .end = (U32)end};
    Str decl = types::message_of(format::push("\n", pad, "mut ", local, ": ", pointer, " = ", p->name));
    out[1] = (core::Edit){.span = here, .text = decl};
    for (Usize i = end; i + countof(p->name) <= body_end; i++) {
        if (!starts_with(source[i:countof(source)], p->name)) continue;
        if (word_char(source[i - 1]) || source[i - 1] == '.') continue;
        if (word_char(source[i + countof(p->name)])) continue;
        ast::Span name_span = {.start = (U32)i, .end = (U32)(i + countof(p->name))};
        out = mem::realloc(out, countof(out) + 1);
        out[countof(out) - 1] = (core::Edit){.span = name_span, .text = local};
    }
    return out;
}

// The fixes of the option parameters of `module` that their function assigns.
export core::Errors reassigned(Str source, const ast::Module *module) {
    core::Errors out = {};
    for (Usize i = 0; i < countof(module->decls); i++) {
        const ast::Decl *d = module->decls[i];
        if (d->kind != .function || d->kind.function.body == nullptr) continue;
        ast::Param params[:] = d->kind.function.params;
        for (Usize k = 0; k < countof(params); k++) {
            const ast::Param *p = &params[k];
            if (!p->is_mut || p->type == nullptr || p->type->span.end <= p->type->span.start) continue;
            if (source[p->type->span.start] != '?') continue;
            core::Edits fix = reassigned_fix(source, d, p);
            if (countof(fix) == 0) continue;
            core::ParseError found = {};
            found.span = p->span;
            found.message =
                "an option parameter that is assigned later is read through a local once it is known to hold a value";
            found.fix = fix;
            out = mem::realloc(out, countof(out) + 1);
            out[countof(out) - 1] = found;
        }
    }
    return out;
}

// ---------------------------------------------------------------------------------------------------------------
// `x.some` (#3083)
//
//   if b.v == .some: b.v.some else: -1          if v := b.v: v else: -1
//
// There is no `x.some` (smith-dev-syntax-options): after a test, `x` is the value. Two fixes, both where the checker
// reports the read: `N.some` on a name that is not an option (a binding the option guard wrote, `if v := b.v:` with
// `v.some` left) is `N`; and a test `F == .some` (`F != .some`) of an option field `F` read as `F.some` below it in the
// function is written `F != .none` (`F == .none`), which the checker's guard of an option field binds on the next pass.
// A name keeps its test: `x == .some` over a name that cannot change is the checker's (`some_test_fix`), and a `mut`
// name cannot be narrowed.

static Bool same_text(Str a, Str b) {
    if (countof(a) != countof(b)) return false;
    return starts_with(a, b);
}

// Whether `text` is a member chain of names, `a.b` or `a.b.c`: names joined by single dots, at least one dot.
static Bool member_chain(Str text) {
    Usize dots = 0;
    for (Usize i = 0; i < countof(text); i++) {
        if (text[i] == '.') {
            if (i == 0 || i + 1 == countof(text) || text[i - 1] == '.') return false;
            dots += 1;
        } else if (!word_char(text[i])) {
            return false;
        }
    }
    return dots > 0;
}

// The start of the function that holds `at`: the nearest line above it at column 0 that is not blank.
static Usize enclosing_function(Str s, Usize at) {
    Usize line = line_start(s, at);
    while (line > 0 && (s[line] == ' ' || s[line] == '\n' || s[line] == '#'))
        line = line_start(s, line - 1);
    return line;
}

static core::Errors some_fix(core::Errors out, Usize start, Usize stop, Str text, Str why) {
    for (Usize i = 0; i < countof(out); i++)
        if (out[i].span.start == start) return out;
    core::Edits fix = {};
    fix = mem::realloc(fix, 1);
    ast::Span at = {.start = (U32)start, .end = (U32)stop};
    fix[0] = (core::Edit){.span = at, .text = text};
    out = mem::realloc(out, countof(out) + 1);
    out[countof(out) - 1] = (core::ParseError){.span = at, .message = why, .fix = fix};
    return out;
}

// The tests `field == .some` and `field != .some` in `source[start:stop]`, written with `.none`.
static core::Errors field_tests(core::Errors out, Str source, Usize start, Usize stop, Str field) {
    Str why = "an option is tested with `.none`: write `== .some` as `!= .none`";
    for (Usize i = start; i + countof(field) + 9 <= stop; i++) {
        if (i > 0 && (word_char(source[i - 1]) || source[i - 1] == '.')) continue;
        if (!starts_with(source[i:countof(source)], field)) continue;
        Usize op = i + countof(field);
        Str after = source[op:countof(source)];
        Bool equal = starts_with(after, " == .some");
        if (!equal && !starts_with(after, " != .some")) continue;
        if (op + 9 < countof(source) && (word_char(source[op + 9]) || source[op + 9] == '(')) continue;
        out = some_fix(out, op, op + 9, equal ? " != .none" : " == .none", why);
    }
    return out;
}

// The line of the `if` that holds the read at `at` and tests the name `name` (`name != .none` or `name == .some`), or
// `countof(source)`: the nearest line above with less indent than the read's must be that `if`.
static Usize test_line(Str source, Usize at, Str name) {
    Usize indent = indent_of(source, line_start(source, at));
    Usize line = line_start(source, at);
    while (line > 0) {
        line = line_start(source, line - 1);
        Usize end = line_end(source, line);
        if (blank(source, line, end)) continue;
        Usize pad = indent_of(source, line);
        if (pad >= indent) continue;
        Str text = source[line + pad:end];
        if (!starts_with(text, "if ")) return countof(source);
        for (Usize i = 0; i + countof(name) + 9 <= countof(text); i++) {
            if (!starts_with(text[i:countof(text)], name) || (i > 0 && (word_char(text[i - 1]) || text[i - 1] == '.')))
                continue;
            Str after = text[i + countof(name):countof(text)];
            if (starts_with(after, " != .none") || starts_with(after, " == .some")) return line;
        }
        return countof(source);
    }
    return countof(source);
}

// Whether `name` is assigned (`name = `) in `source[start:stop]`.
static Bool assigned_in(Str source, Usize start, Usize stop, Str name) {
    for (Usize i = start; i + countof(name) + 3 <= stop; i++) {
        if (!starts_with(source[i:countof(source)], name) || (i > 0 && word_char(source[i - 1]))) continue;
        if (starts_with(source[i + countof(name):countof(source)], " = ")) return true;
    }
    return false;
}

// The end of the block of the `if` at `line`: the first line after it that is not indented deeper.
static Usize block_end(Str source, Usize line) {
    Usize pad = indent_of(source, line);
    Usize k = line_end(source, line) + 1;
    while (k < countof(source)) {
        Usize end = line_end(source, k);
        if (!blank(source, k, end) && indent_of(source, k) <= pad) break;
        k = end + 1;
    }
    return k < countof(source) ? k : countof(source);
}

// A read `name.some` of a name the checker cannot narrow (a `mut` name, assigned after its declaration) under an `if`
// that tests it: the value is named first, `v := name` above the `if`, and the test and the read use `v` (item 27,
// #3211). The `if` is the first read's; its other reads are single edits. Not when the block writes the name.
static core::Errors named_copy(core::Errors out, Str source, Usize line, ast::Span read, Str name) {
    Str copy = types::message_of(format::push(name, "_value"));
    if (assigned_in(source, line, block_end(source, line), name)) return out;
    for (Usize i = 0; i < countof(out); i++)
        if (out[i].span.start == read.start) return out;
    Str why = "a name that may change is named first, and the copy is tested and read";
    Bool first = true;
    for (Usize i = 0; i < countof(out); i++) {
        core::Edits had = out[i].fix;
        if (countof(had) > 1 && had[0].span.start == line) first = false;
    }
    core::Edits fix = {};
    if (first) {
        Usize pad = indent_of(source, line);
        Str head = types::message_of(format::push(source[line:line + pad], copy, " := ", name, "\n"));
        Str test = source[line:line_end(source, line)];
        fix = mem::realloc(fix, 3);
        fix[0] = (core::Edit){.span = {.start = (U32)line, .end = (U32)line}, .text = head};
        Usize at = 0;
        for (Usize i = 0; i + countof(name) + 9 <= countof(test); i++) {
            Str after = test[i + countof(name):countof(test)];
            if (starts_with(test[i:countof(test)], name) &&
                !(i > 0 && (word_char(test[i - 1]) || test[i - 1] == '.')) &&
                (starts_with(after, " != .none") || starts_with(after, " == .some"))) {
                at = i;
                break;
            }
        }
        Usize from = line + at;
        fix[1] = (core::Edit){.span = {.start = (U32)from, .end = (U32)(from + countof(name) + 9)},
                              .text = types::message_of(format::push(copy, " != .none"))};
        fix[2] = (core::Edit){.span = read, .text = copy};
    } else {
        fix = mem::realloc(fix, 1);
        fix[0] = (core::Edit){.span = read, .text = copy};
    }
    out = mem::realloc(out, countof(out) + 1);
    out[countof(out) - 1] = (core::ParseError){.span = read, .message = why, .fix = fix};
    return out;
}

export core::Errors some_reads(Str source, const types::Checked *c) {
    core::Errors out = {};
    Str lead = "`.` needs a record, found `";
    for (Usize i = 0; i < c->error_count; i++) {
        types::Error e = c->errors[i];
        if (countof(e.fix) > 0 || countof(e.fix_module) > 0 || e.span.end > countof(source) ||
            e.span.start + 5 >= e.span.end || !starts_with(e.message, lead))
            continue;
        Str read = source[e.span.start:e.span.end];
        if (!same_text(read[countof(read) - 5:countof(read)], ".some")) continue;
        Str base = read[0:countof(read) - 5];
        Str found = e.message[countof(lead):countof(e.message)];
        Bool option = starts_with(found, "Option(");
        if (starts_with(found, "Result(")) continue;
        Bool name = countof(base) > 0;
        for (Usize k = 0; k < countof(base); k++)
            if (!word_char(base[k])) name = false;
        if (!option && name) {
            Str why = "a name that is not an option is the value already: write it without `.some`";
            out = some_fix(out, e.span.end - 5, e.span.end, "", why);
        } else if (option && name) {
            Usize line = test_line(source, e.span.start, base);
            if (line < countof(source)) out = named_copy(out, source, line, e.span, base);
        } else if (option && member_chain(base)) {
            out = field_tests(out, source, enclosing_function(source, e.span.start), e.span.start, base);
        }
    }
    return out;
}
