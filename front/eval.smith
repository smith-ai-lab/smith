// front::eval: the one place the new front end decides a value at compile time (#3039, steps 1 and 2 of 3).
//
// `eval::value(r, expr)` gives the value of an expression when it is known at compile time, in the scopes the checker
// `r` is in. It is asked wherever the language needs a constant: a `const`, an array length, a `static_assert`, the
// condition of a compile-time `if`, a `match` pattern, an attribute's argument. Every answer is the target's
// (`r->table.target`), never the host's.
//
// What it reads:
//   literals        integers, characters, booleans, floats
//   names           a constant (`const`, or a name that is not `mut`) through its initializer, in the module that
//                   declares it; a compile-time parameter bound in an instance; a type
//   operators       `+ - * / % << >> & | ^ ~`, comparisons, `and or not`, with the checks a run would make: a result
//                   that does not fit its type, a division by zero and a shift past the width are errors (`failed`)
//   types           `sizeof`, `alignof`, `countof`, `typeof`, `==` on two types, the questions about a type
//                   (`is_slice(T)`, `int(T)`) and a concept function (`fn small(T: type) -> bool: sizeof(T) <= 4`)
//   target          `target.os`, `target.arch`, `target.f32_mantissa_bits` and the other facts (`target_fact`)
//   conversions     `x.to(T)` (checked) and `x.wrap(T)` between numbers
//   `if` as a value  `if c: a else: b` with a condition that is known
//   calls           a smith function with a body, run statement by statement (declarations, assignment to a `mut`
//                   local, `if`, `while`, `for i in range(a, b)`, `match`, `break`, `continue`, `return`, `assert`)
//                   over numbers, bools, enumerators and types; a function whose result is `type` is a type
//                   function (`applied_for`, `held_for`); `slice.with_dims(T, k)` is built in
// Anything else is not known: the outcome names the part (`at`) and says why (`why`), and the caller writes the error
// for its own place.
//
// The working defaults of #3039, each behind one function so that it is cheap to change: `step_limit`, `depth_limit`
// (the limits), `may_run` (which functions are answered by their one expression: a concept function) and `target_fact`
// (which facts `target` has). Nothing here recurses: a run is a stack of steps and a stack of values.
module front::eval;

import front::ast;
import front::types;
import front::when;
import std::arena;
import std::format;
import std::mem;
import target;

// ---------------------------------------------------------------------------------------------------------------
// Values

// A value known at compile time. An integer is a magnitude and a sign, so every `i64` and every `u64` is held; its
// type is null for a literal no type has been given to yet (`4096` in `const page = 4096`). An enumerator is the
// index of its slot in its enumeration. A fact is a name of the target (`target.os` is the fact `os` named `linux`).
export typedef enum {
    struct {
        U64 magnitude;
        Bool negative;
        types::TypeRef type;
    } integer;
    struct {
        Bool value;
    } boolean;
    struct {
        F64 value;
        types::TypeRef type;
    } floating;
    struct {
        types::TypeRef type;
        Usize index;
    } enumerator;
    struct {
        types::TypeRef type;
    } type_value;
    struct {
        ast::Text family;
        ast::Text name;
    } fact;
    struct {
        Usize object;
        types::TypeRef type;
    } aggregate; // a struct, an array or a tuple (step 3): its cells are the object's, in the compile-time heap
    struct {
        Usize object;
        Usize begin;
        Usize end;
        types::TypeRef type;
    } slice; // `str` and `[]T` (step 3): the cells `begin` to `end` of an object
    unset;   // `undefined`: a cell nothing has written
    nothing; // what a statement that is no value leaves: an assignment, a loop, a call of a function with no result
} Value;

// What `value` found: the value when `known`; else the part that is not known (`at`) and why. `failed` is an error of
// the evaluation itself (an overflow, a division by zero): `why` is the whole message and the caller reports it as it
// stands.
export struct Outcome {
    Bool known;
    Value value;
    Bool failed;
    ast::Span at;
    Str why;
};

// The most steps one evaluation takes before it is an error, and the deepest chain of names and calls: the numbers of
// the old front end (clang's). No way to raise them yet (#3039, default 3).
export U64 step_limit() {
    return 1048576;
}

export Usize depth_limit() {
    return 512;
}

static Str msg(char chars[:]) {
    return chars;
}

static Bool same(Str a, Str b) {
    return types::same_text(a, b);
}

export Value integer_value(U64 magnitude, Bool negative, types::TypeRef type) {
    Value made = {.integer = {.magnitude = magnitude, .negative = negative && magnitude != 0, .type = type}};
    return made;
}

export Value boolean_value(Bool value) {
    Value made = {.boolean = {.value = value}};
    return made;
}

export Value type_value(types::TypeRef type) {
    Value made = {.type_value = {.type = type}};
    return made;
}

static Value floating_value(F64 value, types::TypeRef type) {
    Value made = {.floating = {.value = value, .type = type}};
    return made;
}

static Value enumerator_value(types::TypeRef type, Usize index) {
    Value made = {.enumerator = {.type = type, .index = index}};
    return made;
}

static Value fact_value(Str family, Str name) {
    Value made = {.fact = {.family = family, .name = name}};
    return made;
}

static Value nothing_value() {
    Value made = .nothing;
    return made;
}

static Value unset_value() {
    Value made = .unset;
    return made;
}

static Value aggregate_value(Usize object, types::TypeRef type) {
    Value made = {.aggregate = {.object = object, .type = type}};
    return made;
}

static Value slice_value(Usize object, Usize begin, Usize end, types::TypeRef type) {
    Value made = {.slice = {.object = object, .begin = begin, .end = end, .type = type}};
    return made;
}

// The value as a message shows it: `-3`, `true`, `1.5`, `.linux`, `u32`.
export Str show(Value v) {
    if (v == .integer) return msg(format::push(v.integer.negative ? "-" : "", v.integer.magnitude));
    if (v == .boolean) return v.boolean.value ? "true" : "false";
    if (v == .floating) return msg(format::push(v.floating.value));
    if (v == .enumerator) {
        types::Slot slots[:] = types::slots_of(v.enumerator.type).items;
        return msg(format::push(".", slots[v.enumerator.index].name));
    }
    if (v == .type_value) return types::show(v.type_value.type);
    if (v == .fact) return msg(format::push(".", v.fact.name));
    if (v == .aggregate) return msg(format::push("a value of `", types::show(v.aggregate.type), "`"));
    if (v == .slice) return msg(format::push("a value of `", types::show(v.slice.type), "`"));
    if (v == .unset) return "undefined";
    return "";
}

// ---------------------------------------------------------------------------------------------------------------
// Whole numbers: a magnitude and a sign

constexpr U64 most = 0xFFFFFFFFFFFFFFFF;

// A whole number, or `ok` false when the result has no 64-bit magnitude.
struct Whole {
    U64 magnitude;
    Bool negative;
    Bool ok;
};

static Whole whole(U64 magnitude, Bool negative) {
    return (Whole){.magnitude = magnitude, .negative = negative && magnitude != 0, .ok = true};
}

static Whole lost() {
    return (Whole){.ok = false};
}

static Whole whole_add(Whole a, Whole b) {
    if (a.negative == b.negative) {
        if (a.magnitude > most - b.magnitude) return lost();
        return whole(a.magnitude + b.magnitude, a.negative);
    }
    if (a.magnitude >= b.magnitude) return whole(a.magnitude - b.magnitude, a.negative);
    return whole(b.magnitude - a.magnitude, b.negative);
}

static Whole whole_multiply(Whole a, Whole b) {
    if (a.magnitude != 0 && b.magnitude > most / a.magnitude) return lost();
    return whole(a.magnitude * b.magnitude, a.negative != b.negative);
}

// -1, 0 or 1 as `a` is below, equal to or above `b`.
static I32 whole_order(Whole a, Whole b) {
    if (a.negative != b.negative) return a.negative ? -1 : 1;
    if (a.magnitude == b.magnitude) return 0;
    Bool below = a.magnitude < b.magnitude;
    if (a.negative) below = !below;
    return below ? -1 : 1;
}

// Whether `w` is a value of the integer type `t`; any whole number is one of a literal with no type yet.
static Bool fits(types::TypeRef t, Whole w) {
    if (t == nullptr || t->kind != .integer) return true;
    U32 bits = types::bits_of(t);
    if (bits > 64) return true;
    if (types::signed_of(t)) {
        U64 limit = (U64)1 << (bits - 1);
        return w.negative ? w.magnitude <= limit : w.magnitude < limit;
    }
    if (w.negative) return false;
    return bits == 64 || w.magnitude < ((U64)1 << bits);
}

// The width the bits of an integer of type `t` are read in: its own up to 64, and 64 for a literal with no type.
static U32 width_of(types::TypeRef t) {
    if (t == nullptr || t->kind != .integer) return 64;
    U32 bits = types::bits_of(t);
    return bits > 64 ? 64 : bits;
}

static U64 mask_of(U32 bits) {
    if (bits >= 64) return most;
    return ((U64)1 << bits) - 1;
}

// The two's complement bits of `w` in `bits` bits.
static U64 pattern_of(Whole w, U32 bits) {
    U64 raw = w.negative ? 0 - w.magnitude : w.magnitude;
    return raw & mask_of(bits);
}

// The whole number that `raw` is as `bits` bits, signed or not.
static Whole from_pattern(U64 raw, U32 bits, Bool is_signed) {
    U64 kept = raw & mask_of(bits);
    if (is_signed && ((kept >> (bits - 1)) & 1) != 0) return whole(0 - (kept | ~mask_of(bits)), true);
    return whole(kept, false);
}

// ---------------------------------------------------------------------------------------------------------------
// A run: a stack of steps and a stack of values

// One step: the value of an expression (or of a statement that is one, `if c: a else: b`), and where the step is in
// it. `prefix` is the module whose names the expression reads; `type` and `mark` are what a later phase needs back.
struct Step {
    const ast::Expr *expr;
    const ast::Stmt *stmt;
    U32 phase;
    Str prefix;
    types::TypeRef type;
    Usize locals; // a block: where its locals and its scopes start, to end them with it
    Usize scopes;
};

// A name a function being run holds: a parameter or a local, with the type it was declared with (null: none). A name
// that holds a type is also a type name in the checker's scopes, so a type written with it (`[]t`) resolves.
struct Local {
    Str name;
    Value value;
    Bool is_mut;
    types::TypeRef type;
};

// A call being run: where its steps, values, locals, scopes and loops start, to leave it from anywhere inside
// (`return`). Its first `params` locals are its parameters, as a message shows the call (`fib(10)`).
struct Frame {
    Str name;
    const ast::Decl *decl;
    Usize params;
    Usize steps;
    Usize values;
    Usize locals;
    Usize scopes;
    Usize loops;
};

// A loop being run: its step, the phase that goes round again, and where it started, for `break` and `continue`. A
// `for i in range(a, b):` counts in `at` up to `limit`.
struct Loop {
    Step step;
    U32 again;
    Usize steps;
    Usize values;
    Usize locals;
    Usize scopes;
    Usize body; // where the locals of one turn start: `continue` ends them
    Whole at;
    Whole limit;
    types::TypeRef type;
};

struct Run {
    types::Checked *r;
    Step steps[:];
    Usize top;
    Value values[:];
    Usize have;
    U64 ran;
    Usize depth;  // the names and calls being read, one inside the other
    Usize scopes; // the scopes pushed for the parameters of the calls being read
    Bool stopped;
    Bool typed_only; // never ask the checker to type an operand: read only the types it recorded
    Bool lenient;    // nothing requires the value (the condition of an `if`): an error inside a call leaves it unknown
    Outcome out;
    Local locals[:];
    Usize local_count;
    Frame frames[:];
    Usize frame_count;
    Loop loops[:];
    Usize loop_count;
    Run *outer; // the run that asked the checker for something that needed this one (a type a function writes)
};

// A `Run` with every field written: empty stacks, nothing known, no outer run. The construction assigns what it needs.
static Run run_of(types::Checked *r, Bool typed_only, Bool lenient, Run *outer) {
    Outcome out = {.known = false, .value = nothing_value(), .failed = false, .at = {.start = 0, .end = 0}, .why = ""};
    Step steps[:] = {};
    Value values[:] = {};
    Local locals[:] = {};
    Frame frames[:] = {};
    Loop loops[:] = {};
    Run run = {.r = r,
               .steps = steps,
               .top = 0,
               .values = values,
               .have = 0,
               .ran = 0,
               .depth = 0,
               .scopes = 0,
               .stopped = false,
               .typed_only = typed_only,
               .lenient = lenient,
               .out = out,
               .locals = locals,
               .local_count = 0,
               .frames = frames,
               .frame_count = 0,
               .loops = loops,
               .loop_count = 0,
               .outer = outer};
    return run;
}

// The run in progress, so that a run started inside it (the checker resolving `[n]T` in a function being run) reads
// the function's locals.
static Run *current = nullptr;

static void push_step(Run *run, Step step) {
    if (run->top == countof(run->steps)) {
        Usize capacity = countof(run->steps) * 2;
        if (capacity < 32) capacity = 32;
        run->steps = mem::realloc(run->steps, capacity);
    }
    run->steps[run->top] = step;
    run->top += 1;
}

static void push_value(Run *run, Value value) {
    if (run->have == countof(run->values)) {
        Usize capacity = countof(run->values) * 2;
        if (capacity < 32) capacity = 32;
        run->values = mem::realloc(run->values, capacity);
    }
    run->values[run->have] = value;
    run->have += 1;
}

static Value pop_value(Run *run) {
    run->have -= 1;
    return run->values[run->have];
}

// The last name of a symbol's name: `fib` of `util::fib`.
static Str short_name(Str name) {
    for (Usize i = countof(name); i >= 2; i--) {
        if (name[i - 1] == ':' && name[i - 2] == ':') return name[i:];
    }
    return name;
}

// The call the frame `at` runs, as a message shows it: `fib(10)`, `slice_of(i32, 2)`.
static Str shown_call(const Run *run, Usize at) {
    Frame f = run->frames[at];
    char text[:] = format::push(short_name(f.name), "(");
    for (Usize i = 0; i < f.params && f.locals + i < run->local_count; i++)
        text = format::push(text, i > 0 ? ", " : "", show(run->locals[f.locals + i].value));
    return msg(format::push(text, ")"));
}

// The calls an error happened in, the innermost first: ` (in `c(3)`, called from `b(2)`)`. Empty outside a call.
static Str chain(const Run *run) {
    if (run->frame_count == 0) return "";
    char text[:] = format::push(" (in `", shown_call(run, run->frame_count - 1), "`");
    Usize shown = 1;
    for (Usize i = run->frame_count - 1; i > 0 && shown < 4; i--) {
        text = format::push(text, ", called from `", shown_call(run, i - 1), "`");
        shown += 1;
    }
    if (run->frame_count > shown) text = format::push(text, ", ...");
    return msg(format::push(text, ")"));
}

// Stops the run: `at` is not known at compile time, because `why`. Inside a call the reason is the call's: it cannot
// run at compile time.
static void unknown(Run *run, ast::Span at, Str why) {
    if (run->stopped) return;
    run->stopped = true;
    Str told = why;
    if (run->frame_count > 0) told = msg(format::push("`", shown_call(run, 0), "` cannot run at compile time: ", why));
    run->out = (Outcome){.known = false, .value = boolean_value(false), .failed = false, .at = at, .why = told};
}

static Bool starts_with(Str text, Str head) {
    return countof(text) >= countof(head) && same(text[0:countof(head)], head);
}

// Stops the run with an error of the evaluation itself (an overflow, a failed contract, a limit), with the calls it
// happened in. Where nothing requires the value, an error inside a call only leaves the value unknown: the program
// makes the call when it runs.
static void failed(Run *run, ast::Span at, Str why) {
    if (run->stopped) return;
    Bool inside = run->frame_count > 0;
    // a message that starts with the one call being run (`spin(1)` ran ...) has said where
    Bool said = run->frame_count == 1 && starts_with(why, msg(format::push("`", shown_call(run, 0), "`")));
    Str told = said ? why : msg(format::push(why, chain(run)));
    run->stopped = true;
    run->out = (Outcome){
        .known = false, .value = boolean_value(false), .failed = !(inside && run->lenient), .at = at, .why = told};
}

// A step of the same module as `from`, at phase 0.
static Step expr_step(const ast::Expr *e, Step from) {
    return (Step){.expr = e, .stmt = nullptr, .phase = 0, .prefix = from.prefix, .type = nullptr};
}

static Step stmt_step(const ast::Stmt *s, Step from) {
    return (Step){.expr = nullptr, .stmt = s, .phase = 0, .prefix = from.prefix, .type = nullptr};
}

// The step `from` again, at a later phase.
static Step later(Step from, U32 phase) {
    Step again = from;
    again.phase = phase;
    return again;
}

// ---------------------------------------------------------------------------------------------------------------
// The compile-time heap (step 3)
//
// A struct, an array or a tuple is an object: its type and its cells, one `Value` for each field or element. A value
// that is one (`aggregate`) names its object, and every place that keeps it (a local, a cell, an argument) keeps a copy
// (`copied`), so a write through one name is not seen through another. A slice (`str` is one) names a range of an
// object's cells and shares them. The heap belongs to the outermost evaluation: it starts empty with it, and what an
// `Outcome` holds is valid until the next evaluation starts. `memory_limit` is the most cells it holds (#3039).

struct Object {
    types::TypeRef type;
    Value cells[:];
};

struct Heap {
    Object items[:];
    Usize count;
    U64 cells;
};

static Heap heap = {};

export U64 memory_limit() {
    return 4194304;
}

static Bool is_open(const Run *run, types::TypeRef t);

// The cells of an object. A slice field reached through an element of another slice is read through a local.
static Usize cells_in(Usize object) {
    Value cells[:] = heap.items[object].cells;
    return countof(cells);
}

static Value cell_get(Usize object, Usize at) {
    Value cells[:] = heap.items[object].cells;
    return cells[at];
}

static void cell_set(Usize object, Usize at, Value v) {
    Value cells[:] = heap.items[object].cells;
    cells[at] = v;
}

// Whether a value of type `t` is an object: a struct, an array or a tuple.
static Bool is_aggregate_type(types::TypeRef t) {
    if (t == nullptr) return false;
    return t->kind == .array || t->kind == .tuple || (t->kind == .record && !t->kind.record.is_union);
}

static Usize cell_count(types::TypeRef t) {
    if (t->kind == .array) return (Usize)types::count_of(t);
    return countof(types::slots_of(t).items);
}

static types::TypeRef cell_type(types::TypeRef t, Usize i) {
    if (t->kind == .array) return types::element_of(t);
    return types::slots_of(t).items[i].type;
}

// A new object of `count` cells that nothing has written.
static Usize new_object(Run *run, ast::Span at, types::TypeRef type, Usize count) {
    if (heap.cells + count > memory_limit()) {
        failed(run, at,
               msg(format::push("compile-time code holds more than ", memory_limit(),
                                " values at once; the work belongs at run time")));
        return 0;
    }
    if (heap.count == countof(heap.items)) {
        Usize capacity = countof(heap.items) * 2;
        if (capacity < 32) capacity = 32;
        heap.items = mem::realloc(heap.items, capacity);
    }
    Value cells[:] = mem::alloc_slice(Value, count);
    for (Usize i = 0; i < count; i++) {
        cells[i] = unset_value();
    }
    heap.items[heap.count] = (Object){.type = type, .cells = cells};
    heap.cells += count;
    heap.count += 1;
    return heap.count - 1;
}

// A list of objects still to visit: the copies, comparisons and fills below walk nested objects with one of these, as
// nothing here recurses.
struct Queue {
    Usize items[:];
    Usize count;
};

static void queue_push(Queue *q, Usize object) {
    if (q->count == countof(q->items)) {
        Usize capacity = countof(q->items) * 2;
        if (capacity < 16) capacity = 16;
        q->items = mem::realloc(q->items, capacity);
    }
    q->items[q->count] = object;
    q->count += 1;
}

// A value of the type `t` that nothing has written: an object whose cells are unwritten too (`mut xs: [5]i32 =
// undefined`), or `unset` for a type that is not one.
static Value unset_of(Run *run, ast::Span at, types::TypeRef t) {
    if (!is_aggregate_type(t) || is_open(run, t)) return unset_value();
    Usize root = new_object(run, at, t, cell_count(t));
    Queue todo = {};
    queue_push(&todo, root);
    for (Usize next = 0; next < todo.count && !run->stopped; next++) {
        Usize at_object = todo.items[next];
        types::TypeRef type = heap.items[at_object].type;
        for (Usize i = 0; i < cells_in(at_object) && !run->stopped; i++) {
            types::TypeRef inner = cell_type(type, i);
            if (!is_aggregate_type(inner)) continue;
            Usize child = new_object(run, at, inner, cell_count(inner));
            cell_set(at_object, i, aggregate_value(child, inner));
            queue_push(&todo, child);
        }
    }
    return aggregate_value(root, t);
}

// A copy of an object and of every object inside it.
static Value copied(Run *run, ast::Span at, Value v) {
    if (v != .aggregate) return v;
    Usize from = v.aggregate.object;
    Usize root = new_object(run, at, heap.items[from].type, cells_in(from));
    for (Usize i = 0; i < cells_in(from) && !run->stopped; i++)
        cell_set(root, i, cell_get(from, i));
    Queue todo = {};
    queue_push(&todo, root);
    for (Usize next = 0; next < todo.count && !run->stopped; next++) {
        Usize here = todo.items[next];
        for (Usize i = 0; i < cells_in(here) && !run->stopped; i++) {
            Value cell = cell_get(here, i);
            if (cell != .aggregate) continue;
            Usize original = cell.aggregate.object;
            Usize child = new_object(run, at, heap.items[original].type, cells_in(original));
            for (Usize k = 0; k < cells_in(original) && !run->stopped; k++)
                cell_set(child, k, cell_get(original, k));
            cell_set(here, i, aggregate_value(child, cell.aggregate.type));
            queue_push(&todo, child);
        }
    }
    return aggregate_value(root, v.aggregate.type);
}

// Defined with the values with memory, below.
static Bool base_is_value(Run *run, const ast::Expr *e);
static void field_step(Run *run, Step s);
static void aggregate_equality(Run *run, const ast::Expr *e, ast::BinaryOp op, Value l, Value r);
static types::TypeRef constructed_type(Run *run, const ast::Expr *callee);
static void construct_step(Run *run, Step s, types::TypeRef t);

// ---------------------------------------------------------------------------------------------------------------
// Locals, frames and loops

// Ends the locals and the scopes above the marks: a block, a loop or a call is left.
static void restore(Run *run, Usize locals, Usize scopes) {
    run->local_count = locals;
    for (; run->scopes > scopes; run->scopes--)
        types::pop_scope(&run->r->scopes);
}

// Declares the name of a local that holds a type as a type name, where the checker's lookups find it.
static void declare_type(Run *run, Str name, types::TypeRef type) {
    types::Symbol held = {.name = name, .kind = .type_name, .type = type};
    (void)types::declare(&run->r->scopes, held);
}

static void add_local(Run *run, Str name, Value value, Bool is_mut, types::TypeRef type) {
    if (run->local_count == countof(run->locals)) {
        Usize capacity = countof(run->locals) * 2;
        if (capacity < 32) capacity = 32;
        run->locals = mem::realloc(run->locals, capacity);
    }
    Value kept = value;
    if (value == .aggregate) {
        kept = copied(run, (ast::Span){}, value); // a local is its own copy
    }
    run->locals[run->local_count] = (Local){.name = name, .value = kept, .is_mut = is_mut, .type = type};
    run->local_count += 1;
    if (value == .type_value) declare_type(run, name, value.type_value.type);
}

// Where the locals of the call being run start: 0 outside a call.
static Usize locals_base(const Run *run) {
    if (run->frame_count == 0) return 0;
    return run->frames[run->frame_count - 1].locals;
}

// The index of the local `name` of the call `run` is in, one more than it; 0 when it has none.
static Usize own_local(const Run *run, Str name) {
    Usize base = locals_base(run);
    for (Usize i = run->local_count; i > base; i--) {
        if (same(run->locals[i - 1].name, name)) return i;
    }
    return 0;
}

// The value of the local `name`: of the call being run, or, in a run the checker started from inside another
// (`[n]T` in a function being run), of that one's call.
static Bool local_value(const Run *run, Str name, Value *out) {
    const Run *at = run;
    for (Usize hops = 0; hops < 64 && at != nullptr; hops++) {
        Usize found = own_local(at, name);
        if (found > 0) {
            *out = at->locals[found - 1].value;
            return true;
        }
        if (at->frame_count > 0) return false;
        at = at->outer;
    }
    return false;
}

static void push_frame(Run *run, Frame frame) {
    if (run->frame_count == countof(run->frames)) {
        Usize capacity = countof(run->frames) * 2;
        if (capacity < 16) capacity = 16;
        run->frames = mem::realloc(run->frames, capacity);
    }
    run->frames[run->frame_count] = frame;
    run->frame_count += 1;
}

static void push_loop(Run *run, Loop loop) {
    if (run->loop_count == countof(run->loops)) {
        Usize capacity = countof(run->loops) * 2;
        if (capacity < 16) capacity = 16;
        run->loops = mem::realloc(run->loops, capacity);
    }
    run->loops[run->loop_count] = loop;
    run->loop_count += 1;
}

// ---------------------------------------------------------------------------------------------------------------
// Types

static Bool is_open(const Run *run, types::TypeRef t) {
    return t == nullptr || t == run->r->table.invalid || t->kind == .automatic || t->kind == .concept_type;
}

// A written type, resolved without reporting: a name the checker does not know leaves the value unknown, and the
// checker reports the name where it types the expression.
static types::TypeRef resolve_quiet(Run *run, const ast::TypeExpr *written) {
    types::Checked *r = run->r;
    Usize errors = r->error_count;
    Bool was_new = r->new_syntax;
    r->new_syntax = true;
    types::TypeRef made = types::resolve(r, written);
    r->new_syntax = was_new;
    r->error_count = errors;
    return made;
}

// The type a plain name stands for when no symbol has it (`u8`, `i32`), else null.
static types::TypeRef type_named(Run *run, const ast::Expr *e, ast::Path path) {
    ast::TypeExpr *written = mem::alloc(ast::TypeExpr);
    written->span = e->span;
    written->kind = (ast::TypeKind){.named = {.path = path}};
    types::TypeRef made = resolve_quiet(run, written);
    if (is_open(run, made)) return nullptr;
    return made;
}

// The type a value has, as `sizeof(x)` and a generic parameter worked out from an argument see it: the type a type
// value holds, an integer's type (`i32` for a literal none was given to), `bool`, `f64`. Null for a fact.
static types::TypeRef value_type(Run *run, Value v) {
    types::Table *table = &run->r->table;
    if (v == .type_value) return v.type_value.type;
    if (v == .boolean) return table->bool_type;
    if (v == .enumerator) return v.enumerator.type;
    if (v == .aggregate) return v.aggregate.type;
    if (v == .slice) return v.slice.type;
    if (v == .integer) {
        if (v.integer.type != nullptr) return v.integer.type;
        return types::builtin(table, "I32");
    }
    if (v == .floating) {
        if (v.floating.type != nullptr) return v.floating.type;
        return types::builtin(table, "F64");
    }
    return nullptr;
}

// The type of the operand of `sizeof`, `alignof`, `countof`: the type a name of a type stands for, the type the
// checker gave the expression, or the one it gives now. Null when it has none yet.
static types::TypeRef operand_type(Run *run, const ast::Expr *x) {
    types::Checked *r = run->r;
    if (x->kind == .type_value) return resolve_quiet(run, x->kind.type_value.type);
    ast::Path path = {};
    Value held = nothing_value();
    if (types::name_path(x, &path) && countof(path.segments) == 1 && local_value(run, path.segments[0].text, &held))
        return value_type(run, held); // a local of a function being run: the type it holds, or its value's type
    if (types::name_path(x, &path)) {
        const types::Symbol *s = types::type_through_modules(r, path);
        if (s != nullptr && s->kind == .type_name) return s->type;
        if (s != nullptr && s->kind == .variable && s->type != nullptr && s->type->kind != .type_type) return s->type;
        if (s == nullptr) return type_named(run, x, path);
    }
    types::TypeRef recorded = types::type_of(r, x);
    if (recorded != nullptr) return recorded;
    if (run->typed_only || r->options.expression == nullptr) return nullptr;
    Usize errors = r->error_count;
    types::TypeRef made = r->options.expression(r, x);
    r->error_count = errors;
    return made;
}

// Whether `text` is `Str` and `other` a read-only slice of `Char`: one type to `typeof(x) == T` (#2853).
static Bool text_and_chars(const Run *run, types::TypeRef text, types::TypeRef other) {
    if (text->kind != .text || other->kind != .slice) return false;
    return other->kind.slice.pointee_const && other->kind.slice.element == types::builtin(&run->r->table, "Char");
}

static Bool same_type(const Run *run, types::TypeRef a, types::TypeRef b) {
    return a == b || text_and_chars(run, a, b) || text_and_chars(run, b, a);
}

// The questions about a type that are built in: `is_slice(T)` and its family, and the concepts (`int(T)`, `num(T)`).
static Bool is_question(Str name) {
    return same(name, "is_slice") || same(name, "is_array") || same(name, "is_record") || same(name, "is_pointer") ||
           same(name, "is_integer") || same(name, "is_float") || same(name, "is_signed") || same(name, "is_bool") ||
           same(name, "is_enum");
}

static Bool is_concept(Str name) {
    return same(name, "int") || same(name, "signed") || same(name, "unsigned") || same(name, "float") ||
           same(name, "num") || same(name, "pointer");
}

static Bool question_answer(Str name, types::TypeRef t) {
    if (same(name, "is_slice")) return t->kind == .slice || t->kind == .text || t->kind == .block;
    if (same(name, "is_array")) return t->kind == .array;
    if (same(name, "is_record")) return t->kind == .record;
    if (same(name, "is_pointer")) return t->kind == .pointer;
    if (same(name, "is_integer")) return t->kind == .integer;
    if (same(name, "is_float")) return t->kind == .floating;
    if (same(name, "is_signed")) return t->kind == .integer && types::signed_of(t);
    if (same(name, "is_bool")) return t->kind == .bool_type;
    if (same(name, "is_enum")) return t->kind == .enumeration;
    return types::concept_holds(name, t);
}

// ---------------------------------------------------------------------------------------------------------------
// The target

static Bool set_flag(Bool value, Bool *out) {
    *out = value;
    return true;
}

// A fact of `target` that is a Bool, false when `fact` is not one.
static Bool flag_fact(Str fact, Bool *out) {
    if (same(fact, "static_analyzer"))
        return set_flag(false, out); // the new front end never runs under clang's analyzer
    if (same(fact, "address_sanitizer")) return set_flag(target::address_sanitizer, out);
    if (same(fact, "undefined_sanitizer")) return set_flag(target::undefined_sanitizer, out);
    if (same(fact, "thread_sanitizer")) return set_flag(target::thread_sanitizer, out);
    if (same(fact, "assertions")) return set_flag(target::assertions, out);
    if (same(fact, "fast_math")) return set_flag(__FINITE_MATH_ONLY__ != 0, out);
    return false;
}

// The value of `target.<fact>`, false when `target` has no such fact (#3039: which facts exist is the owner's
// question; these are the ones the checker read before). The system and the processor are the ones smith runs on
// (`when::host`), as `@when` reads them, until a compile names another target; the sanitizers and `assertions` are
// those of the build smith itself was made with, which is what the checker folded before (#2461).
export Bool target_fact(const types::Checked *r, Str fact, Value *out) {
    types::TypeRef number = types::builtin(&r->table, "I32");
    Bool flag = false;
    if (same(fact, "os")) {
        *out = fact_value("os", when::host() == when::os_macos ? "macos" : "linux");
    } else if (same(fact, "arch")) {
        *out = fact_value("arch", when::host_arch() == when::arch_aarch64 ? "aarch64" : "x86_64");
    } else if (same(fact, "float_radix")) {
        *out = integer_value(2, false, number);
    } else if (same(fact, "f32_mantissa_bits")) {
        *out = integer_value(24, false, number);
    } else if (same(fact, "f64_mantissa_bits")) {
        *out = integer_value(53, false, number);
    } else if (same(fact, "float_eval_method")) {
        *out = integer_value(0, false, number);
    } else if (flag_fact(fact, &flag)) {
        *out = boolean_value(flag);
    } else {
        return false;
    }
    return true;
}

// Whether `name` is a name the fact `family` can have (`.macos` and `.linux` of `os`).
static Bool fact_has(Str family, Str name) {
    if (same(family, "os")) return same(name, "macos") || same(name, "linux");
    return same(name, "aarch64") || same(name, "x86_64");
}

// ---------------------------------------------------------------------------------------------------------------
// Literals and names

static void literal_step(Run *run, const ast::Expr *e) {
    types::TypeRef t = types::type_of(run->r, e);
    if (e->kind == .integer) {
        if (t != nullptr && t->kind != .integer) t = nullptr;
        push_value(run, integer_value(e->kind.integer.value, false, t));
    } else if (e->kind == .character) {
        if (t != nullptr && t->kind != .integer) t = nullptr;
        push_value(run, integer_value(e->kind.character.value, false, t));
    } else if (e->kind == .boolean) {
        push_value(run, boolean_value(e->kind.boolean.value));
    } else if (e->kind == .floating) {
        if (t != nullptr && t->kind != .floating) t = nullptr;
        push_value(run, floating_value(e->kind.floating.value, t));
    }
}

// The module a symbol is declared in, as its name carries it (`std::math::` of `std::math::pi`); the module of the
// step that names it when its name has none (a local, a name of the module checked).
static Str module_of(Str name, Str inherited) {
    for (Usize i = countof(name); i >= 2; i--) {
        if (name[i - 1] == ':' && name[i - 2] == ':') return name[0:i];
    }
    return inherited;
}

// A name that is a symbol: a bound compile-time parameter, a type, or a constant, whose initializer is read next in
// the module that declares it, and given the constant's type after (`settle`).
static void symbol_step(Run *run, Step s, const types::Symbol *symbol) {
    const ast::Expr *e = s.expr;
    if (symbol->has_value) {
        push_value(run, integer_value(symbol->value, false, symbol->type));
        return;
    }
    if (symbol->kind == .type_name) {
        if (is_open(run, symbol->type)) {
            unknown(run, e->span, msg(format::push("`", symbol->name, "` is a type known only in an instance")));
            return;
        }
        push_value(run, type_value(symbol->type));
        return;
    }
    const ast::Expr *init = types::constant_initializer(symbol);
    if (init == nullptr) {
        Str what = "not known until the program runs";
        if (symbol->kind == .function_symbol) what = "a function";
        if (symbol->kind == .variable && !symbol->is_const) what = "a variable that can change";
        unknown(run, e->span, msg(format::push("`", symbol->name, "` is ", what)));
        return;
    }
    if (run->depth == depth_limit()) {
        unknown(run, e->span, msg(format::push("`", symbol->name, "` is defined by itself")));
        return;
    }
    run->depth += 1;
    Step settle = later(s, 1);
    settle.type = symbol->type;
    push_step(run, settle);
    Step read = expr_step(init, s);
    if (init->kind == .variant) read.type = symbol->type;
    read.prefix = module_of(symbol->name, s.prefix);
    push_step(run, read);
}

static void name_step(Run *run, Step s, ast::Path path) {
    Value held = nothing_value();
    if (countof(path.segments) == 1 && local_value(run, path.segments[0].text, &held)) {
        push_value(run, held);
        return;
    }
    const types::Symbol *symbol = types::type_through_modules(run->r, path);
    if (symbol != nullptr) {
        symbol_step(run, s, symbol);
        return;
    }
    types::TypeRef named = type_named(run, s.expr, path);
    if (named == nullptr) {
        unknown(run, s.expr->span, "this name is not known at compile time");
        return;
    }
    push_value(run, type_value(named));
}

// `v` as a value of the declared type: an integer must fit it, a number becomes a float, and a `type` holds a type.
// False, and the run is stopped, when it does not.
static Bool coerced_scalar(Run *run, ast::Span at, Value v, types::TypeRef declared, Value *out) {
    *out = v;
    if (declared == nullptr || is_open(run, declared)) return true;
    if (declared->kind == .type_type && v != .type_value) {
        unknown(run, at, "this is not a type known at compile time");
        return false;
    }
    if (v == .integer && declared->kind == .integer) {
        Whole w = whole(v.integer.magnitude, v.integer.negative);
        if (!fits(declared, w)) {
            failed(run, at,
                   msg(format::push("`", show(v), "` does not fit `", types::show(declared),
                                    "` at compile time; write `(", show(v), ").wrap(", types::show(declared),
                                    ")` to cut it to size, or use a type that holds it")));
            return false;
        }
        *out = integer_value(w.magnitude, w.negative, declared);
    } else if (v == .integer && declared->kind == .floating) {
        F64 real = (F64)v.integer.magnitude;
        *out = floating_value(v.integer.negative ? -real : real, declared);
    } else if (v == .floating && declared->kind == .floating) {
        *out = floating_value(v.floating.value, declared);
    }
    return true;
}

// As `coerced_scalar`, and a value with memory: `undefined` becomes an object of the declared type whose cells nothing
// has written, an array or a struct is fitted cell by cell to the declared one, and an array handed to a slice
// parameter becomes a slice of it.
static Bool coerced(Run *run, ast::Span at, Value v, types::TypeRef declared, Value *out) {
    *out = v;
    if (declared == nullptr || is_open(run, declared)) return true;
    if (v == .unset) {
        *out = unset_of(run, at, declared);
        return !run->stopped;
    }
    if (v == .aggregate && (declared->kind == .slice || declared->kind == .text) && v.aggregate.type->kind == .array) {
        Usize count = cells_in(v.aggregate.object);
        *out = slice_value(v.aggregate.object, 0, count, declared);
        return true;
    }
    if (v != .aggregate || !is_aggregate_type(declared)) return coerced_scalar(run, at, v, declared, out);
    if (v.aggregate.type == declared) return true;
    Usize count = cells_in(v.aggregate.object);
    Bool same_shape = (v.aggregate.type->kind == .array && declared->kind == .array) ||
                      (v.aggregate.type->kind == .tuple && declared->kind == .tuple) ||
                      (v.aggregate.type->kind == .record && declared->kind == .record);
    if (!same_shape || count != cell_count(declared)) {
        unknown(run, at, msg(format::push(show(v), " does not fit `", types::show(declared), "` at compile time")));
        return false;
    }
    for (Usize i = 0; i < count; i++) {
        Value cell = cell_get(v.aggregate.object, i);
        if (cell == .aggregate || cell == .slice || cell == .unset) continue;
        Value fitted = cell;
        if (!coerced_scalar(run, at, cell, cell_type(declared, i), &fitted)) return false;
        cell_set(v.aggregate.object, i, fitted);
    }
    heap.items[v.aggregate.object].type = declared;
    *out = aggregate_value(v.aggregate.object, declared);
    return true;
}

// The initializer of a constant is read: the value takes the constant's type, which it must fit.
static void settle_name(Run *run, Step s) {
    run->depth -= 1;
    Value v = pop_value(run);
    Value kept = v;
    if (coerced(run, s.expr->span, v, s.type, &kept)) push_value(run, kept);
}

// A path of names as the checker's lookups take it.
static ast::Path path_of(const types::Names *names, Usize count, ast::Span span) {
    ast::Identifier segments[:] = mem::alloc_slice(ast::Identifier, count);
    for (Usize i = 0; i < count; i++)
        segments[i] = (ast::Identifier){.text = names->items[i], .span = span};
    return (ast::Path){.segments = segments, .span = span};
}

// The index of the enumerator `name` of the enumeration `t`; false when it has none.
static Bool enumerator_index(types::TypeRef t, Str name, Usize *index) {
    if (t == nullptr || t->kind != .enumeration) return false;
    types::Slot slots[:] = types::slots_of(t).items;
    for (Usize i = 0; i < countof(slots); i++) {
        if (same(slots[i].name, name)) {
            *index = i;
            return true;
        }
    }
    return false;
}

// `a.b`: a fact of the target (`target.os`), an enumerator through its type (`Color.green`), or a name read through
// a module or a C header (`m.limit`, `k.SIDE`).
static void member_step(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    types::Checked *r = run->r;
    if (base_is_value(run, e)) {
        field_step(run, s); // a field of a struct
        return;
    }
    types::Names names = types::member_names(e);
    if (names.count < 2) {
        unknown(run, e->span, "a member of a value is not read at compile time");
        return;
    }
    Value fact = boolean_value(false);
    if (names.count == 2 && same(names.items[0], "target") && types::scoped(r, "target") == nullptr) {
        if (target_fact(r, names.items[1], &fact)) {
            push_value(run, fact);
        } else {
            unknown(run, e->span, msg(format::push("`target` has no fact `", names.items[1], "`")));
        }
        return;
    }
    const types::Symbol *owner = types::type_through_modules(r, path_of(&names, names.count - 1, e->span));
    Usize index = 0;
    if (owner != nullptr && owner->kind == .type_name && !types::is_payload_enum(owner->type) &&
        enumerator_index(owner->type, names.items[names.count - 1], &index)) {
        push_value(run, enumerator_value(owner->type, index));
        return;
    }
    const types::Symbol *symbol = types::type_through_modules(r, path_of(&names, names.count, e->span));
    if (symbol == nullptr) {
        unknown(run, e->span, "a member of a value is not read at compile time");
        return;
    }
    symbol_step(run, s, symbol);
}

// `.green` where the checker has given it its enumeration.
static void variant_step(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    types::TypeRef t = types::type_of(run->r, e);
    if (t == nullptr) t = s.type; // the initializer of `const c: Color = .green`: the constant's type
    Usize index = 0;
    if (t == nullptr || e->kind != .variant || e->kind.variant.payload != nullptr || types::is_payload_enum(t) ||
        !enumerator_index(t, e->kind.variant.name, &index)) {
        unknown(run, e->span, "this variant is not known at compile time");
        return;
    }
    push_value(run, enumerator_value(t, index));
}

// ---------------------------------------------------------------------------------------------------------------
// Operators

static Str op_text(ast::BinaryOp op) {
    if (op == .add) return "+";
    if (op == .subtract) return "-";
    if (op == .multiply) return "*";
    if (op == .divide) return "/";
    if (op == .remainder) return "%";
    if (op == .shift_left) return "<<";
    return ">>";
}

static Bool is_comparison(ast::BinaryOp op) {
    return op == .less || op == .greater || op == .less_equal || op == .greater_equal || op == .equal ||
           op == .not_equal;
}

static Bool compare(ast::BinaryOp op, I32 order) {
    if (op == .less) return order < 0;
    if (op == .greater) return order > 0;
    if (op == .less_equal) return order <= 0;
    if (op == .greater_equal) return order >= 0;
    if (op == .equal) return order == 0;
    return order != 0;
}

// The type of an operation on two integers: the one both have, or the one that has one beside a literal; none when
// the two differ (the checker reports that where it types the operation).
// The type a type value holds; null for any other value.
static types::TypeRef held_type(Value v) {
    if (v == .type_value) return v.type_value.type;
    return nullptr;
}

static types::TypeRef joined_type(types::TypeRef a, types::TypeRef b) {
    if (a == nullptr) return b;
    if (b == nullptr || a == b) return a;
    return nullptr;
}

// `+ - * / %` of two whole numbers; `ok` false for a result with no 64-bit magnitude. The caller has refused a zero
// divisor.
static Whole arithmetic(ast::BinaryOp op, Whole a, Whole b) {
    if (op == .add) return whole_add(a, b);
    if (op == .subtract) return whole_add(a, whole(b.magnitude, !b.negative));
    if (op == .multiply) return whole_multiply(a, b);
    if (op == .divide) return whole(a.magnitude / b.magnitude, a.negative != b.negative);
    return whole(a.magnitude % b.magnitude, a.negative);
}

// `<< >> & | ^` on the bits of the type, as the machine does them.
static Whole bitwise(ast::BinaryOp op, Whole a, Whole b, types::TypeRef t) {
    U32 bits = width_of(t);
    Bool is_signed = t != nullptr && types::signed_of(t);
    U64 left = pattern_of(a, bits);
    U64 right = pattern_of(b, bits);
    if (op == .bit_and) return from_pattern(left & right, bits, is_signed);
    if (op == .bit_or) return from_pattern(left | right, bits, is_signed);
    if (op == .bit_xor) return from_pattern(left ^ right, bits, is_signed);
    if (op == .shift_left) return from_pattern(left << b.magnitude, bits, is_signed);
    if (is_signed && a.negative) { // an arithmetic shift keeps the sign
        U64 filled = (left >> b.magnitude) | ~(mask_of(bits) >> b.magnitude);
        return from_pattern(filled, bits, true);
    }
    return from_pattern(left >> b.magnitude, bits, is_signed);
}

static void integer_binary(Run *run, const ast::Expr *e, ast::BinaryOp op, Value l, Value r) {
    if (l != .integer || r != .integer) return;
    Whole a = whole(l.integer.magnitude, l.integer.negative);
    Whole b = whole(r.integer.magnitude, r.integer.negative);
    types::TypeRef t = joined_type(l.integer.type, r.integer.type);
    if (is_comparison(op)) {
        push_value(run, boolean_value(compare(op, whole_order(a, b))));
        return;
    }
    Bool shift = op == .shift_left || op == .shift_right;
    if (shift) t = l.integer.type;
    if ((op == .divide || op == .remainder) && b.magnitude == 0) {
        failed(run, e->span, "this divides by zero at compile time");
        return;
    }
    if (shift && (b.negative || b.magnitude >= width_of(t))) {
        failed(run, e->span,
               msg(format::push("this shifts by ", show(r), " at compile time, which is not below the ", width_of(t),
                                " bits of the value")));
        return;
    }
    Bool on_bits = shift || op == .bit_and || op == .bit_or || op == .bit_xor;
    Whole result = on_bits ? bitwise(op, a, b, t) : arithmetic(op, a, b);
    if (!result.ok && t != nullptr && types::bits_of(t) > 64) {
        unknown(run, e->span, "a value wider than 64 bits is not computed at compile time yet");
        return;
    }
    if (!result.ok || !fits(t, result)) {
        Str of = t == nullptr ? msg(format::push("64 bits")) : msg(format::push("`", types::show(t), "`"));
        failed(run, e->span,
               msg(format::push("this overflows ", of, " at compile time: ", show(l), " ", op_text(op), " ", show(r))));
        return;
    }
    push_value(run, integer_value(result.magnitude, result.negative, t));
}

static F64 real_of(Value v) {
    if (v == .floating) return v.floating.value;
    if (v == .integer) return v.integer.negative ? -(F64)v.integer.magnitude : (F64)v.integer.magnitude;
    return 0.0;
}

static void floating_binary(Run *run, const ast::Expr *e, ast::BinaryOp op, Value l, Value r) {
    F64 a = real_of(l);
    F64 b = real_of(r);
    types::TypeRef t = l == .floating ? l.floating.type : nullptr;
    if (t == nullptr && r == .floating) t = r.floating.type;
    if (is_comparison(op)) {
        I32 order = a < b ? -1 : (a > b ? 1 : 0);
        if (a != a || b != b) { // not a number compares unequal to everything
            push_value(run, boolean_value(op == .not_equal));
            return;
        }
        push_value(run, boolean_value(compare(op, order)));
    } else if (op == .add) {
        push_value(run, floating_value(a + b, t));
    } else if (op == .subtract) {
        push_value(run, floating_value(a - b, t));
    } else if (op == .multiply) {
        push_value(run, floating_value(a * b, t));
    } else if (op == .divide) {
        push_value(run, floating_value(a / b, t));
    } else {
        unknown(run, e->span, "this operator is not computed on a float at compile time");
    }
}

// The number today's sources compare a named fact with (`target::os == target::linux`, `target::arch == 0`): the
// one `types_expr::fold_target_system` writes for the bare fact.
static U64 fact_number(Str family, Str name) {
    if (same(family, "os")) return (U64)(same(name, "macos") ? when::os_macos : when::os_linux);
    return (U64)(same(name, "aarch64") ? when::arch_aarch64 : when::arch_x86_64);
}

// `==` and `!=` of two values that are not numbers: booleans, types, enumerators, facts.
static void equality(Run *run, const ast::Expr *e, ast::BinaryOp op, Value l, Value r) {
    Bool equal = false;
    if (l == .boolean && r == .boolean) {
        equal = l.boolean.value == r.boolean.value;
    } else if (l == .type_value && r == .type_value) {
        equal = same_type(run, l.type_value.type, r.type_value.type);
    } else if (l == .enumerator && r == .enumerator && l.enumerator.type == r.enumerator.type) {
        equal = l.enumerator.index == r.enumerator.index;
    } else if (l == .fact && r == .fact && same(l.fact.family, r.fact.family)) {
        equal = same(l.fact.name, r.fact.name);
    } else if ((l == .aggregate && r == .aggregate) || (l == .slice && r == .slice)) {
        aggregate_equality(run, e, op, l, r);
        return;
    } else if (l == .fact && r == .integer) {
        equal = !r.integer.negative && fact_number(l.fact.family, l.fact.name) == r.integer.magnitude;
    } else if (l == .integer && r == .fact) {
        equal = !l.integer.negative && fact_number(r.fact.family, r.fact.name) == l.integer.magnitude;
    } else {
        unknown(run, e->span, "these two are not compared at compile time");
        return;
    }
    push_value(run, boolean_value(equal == (op == .equal)));
}

static void binary_values(Run *run, const ast::Expr *e, ast::BinaryOp op, Value l, Value r) {
    if (l == .unset || r == .unset) {
        unknown(run, e->span, "this reads a value that nothing has written");
    } else if (l == .integer && r == .integer) {
        integer_binary(run, e, op, l, r);
    } else if ((l == .floating || l == .integer) && (r == .floating || r == .integer)) {
        floating_binary(run, e, op, l, r);
    } else if (op == .equal || op == .not_equal) {
        equality(run, e, op, l, r);
    } else {
        unknown(run, e->span, "this operator is not computed on these values at compile time");
    }
}

// The name of `e` when it is a variant with no payload (`.linux`), else an empty text.
static Str bare_variant(const ast::Expr *e) {
    if (e->kind != .variant) return "";
    if (e->kind.variant.payload != nullptr) return "";
    return e->kind.variant.name;
}

// The variant `.name` as a value of what the other side of a comparison is: an enumerator of its enumeration, a name
// of its fact.
static Bool variant_like(Run *run, const ast::Expr *e, Str name, Value other, Value *out) {
    Usize index = 0;
    if (other == .enumerator && enumerator_index(other.enumerator.type, name, &index)) {
        *out = enumerator_value(other.enumerator.type, index);
        return true;
    }
    if (other == .fact && fact_has(other.fact.family, name)) {
        *out = fact_value(other.fact.family, name);
        return true;
    }
    if (other == .fact) {
        Bool os = same(other.fact.family, "os");
        unknown(run, e->span,
                msg(format::push("`.", name, "` is not a name of `target.", other.fact.family, "`; write ",
                                 os ? "`.macos` or `.linux`" : "`.aarch64` or `.x86_64`")));
        return false;
    }
    unknown(run, e->span, msg(format::push("`.", name, "` is not a variant of the value it is compared with")));
    return false;
}

// A binary operator. `and` and `or` read the left side first and the right only when the left does not decide; a
// comparison with a bare variant (`target.os == .linux`) reads the other side first, which says what the variant is.
static void binary_step(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .binary) return;
    ast::BinaryOp op = e->kind.binary.op;
    const ast::Expr *left = e->kind.binary.left;
    const ast::Expr *right = e->kind.binary.right;
    Bool equality_op = op == .equal || op == .not_equal;
    if (op == .logical_and || op == .logical_or) {
        push_step(run, later(s, 2));
        push_step(run, expr_step(left, s));
    } else if (equality_op && countof(bare_variant(right)) > 0) {
        push_step(run, later(s, 4));
        push_step(run, expr_step(left, s));
    } else if (equality_op && countof(bare_variant(left)) > 0) {
        push_step(run, later(s, 5));
        push_step(run, expr_step(right, s));
    } else {
        push_step(run, later(s, 1));
        push_step(run, expr_step(right, s));
        push_step(run, expr_step(left, s));
    }
}

static void binary_resume(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .binary) return;
    ast::BinaryOp op = e->kind.binary.op;
    if (s.phase == 1) {
        Value r = pop_value(run);
        Value l = pop_value(run);
        binary_values(run, e, op, l, r);
    } else if (s.phase == 2) { // the left side of `and`, `or`
        Value l = pop_value(run);
        if (l != .boolean) {
            unknown(run, e->kind.binary.left->span, "this is not a bool known at compile time");
        } else if (l.boolean.value == (op == .logical_or)) {
            push_value(run, l); // `false and x`, `true or x`: the right side is not read
        } else {
            push_step(run, later(s, 3));
            push_step(run, expr_step(e->kind.binary.right, s));
        }
    } else if (s.phase == 3) {
        Value r = pop_value(run);
        if (r != .boolean) {
            unknown(run, e->kind.binary.right->span, "this is not a bool known at compile time");
        } else {
            push_value(run, r);
        }
    } else { // 4: the variant is on the right; 5: on the left
        const ast::Expr *written = s.phase == 4 ? e->kind.binary.right : e->kind.binary.left;
        Value other = pop_value(run);
        Value variant = boolean_value(false);
        if (variant_like(run, written, bare_variant(written), other, &variant)) equality(run, e, op, other, variant);
    }
}

static void unary_resume(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .unary) return;
    ast::UnaryOp op = e->kind.unary.op;
    Value v = pop_value(run);
    if (op == .logical_not && v == .boolean) {
        push_value(run, boolean_value(!v.boolean.value));
    } else if (op == .plus && (v == .integer || v == .floating)) {
        push_value(run, v);
    } else if (op == .negate && v == .floating) {
        push_value(run, floating_value(-v.floating.value, v.floating.type));
    } else if (op == .negate && v == .integer) {
        Whole w = whole(v.integer.magnitude, !v.integer.negative);
        if (!fits(v.integer.type, w)) {
            failed(run, e->span,
                   msg(format::push("this overflows `", types::show(v.integer.type), "` at compile time: -", show(v))));
            return;
        }
        push_value(run, integer_value(w.magnitude, w.negative, v.integer.type));
    } else if (op == .bit_not && v == .integer) {
        types::TypeRef t = v.integer.type;
        U32 bits = width_of(t);
        Whole w = whole(v.integer.magnitude, v.integer.negative);
        Whole flipped = from_pattern(~pattern_of(w, bits), bits, t != nullptr && types::signed_of(t));
        push_value(run, integer_value(flipped.magnitude, flipped.negative, t));
    } else {
        unknown(run, e->span, "this operator is not computed on this value at compile time");
    }
}

// ---------------------------------------------------------------------------------------------------------------
// Conversions

// A whole number as a value of the integer type `to`: checked (`x.to(T)`), or its low bits (`x.wrap(T)`).
static void integer_cast(Run *run, const ast::Expr *e, Whole w, types::TypeRef to, Bool wrapping, Str shown) {
    if (wrapping) {
        U32 bits = width_of(to);
        Whole kept = from_pattern(pattern_of(w, 64), bits, types::signed_of(to));
        push_value(run, integer_value(kept.magnitude, kept.negative, to));
        return;
    }
    if (!fits(to, w)) {
        failed(run, e->span, msg(format::push("`", shown, "` does not fit `", types::show(to), "` at compile time")));
        return;
    }
    push_value(run, integer_value(w.magnitude, w.negative, to));
}

static void cast_resume(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .cast) return;
    Value v = pop_value(run);
    Bool wrapping = e->kind.cast.form == .wrapping;
    types::TypeRef to = resolve_quiet(run, e->kind.cast.type);
    if (is_open(run, to) || e->kind.cast.form == .reinterpret) {
        unknown(run, e->span, "this conversion is not known at compile time");
    } else if (to->kind == .integer && v == .integer) {
        integer_cast(run, e, whole(v.integer.magnitude, v.integer.negative), to, wrapping, show(v));
    } else if (to->kind == .integer && v == .enumerator) {
        types::Slot slots[:] = types::slots_of(v.enumerator.type).items;
        integer_cast(run, e, whole(slots[v.enumerator.index].value, false), to, wrapping, show(v));
    } else if (to->kind == .integer && v == .boolean) {
        push_value(run, integer_value(v.boolean.value ? 1 : 0, false, to));
    } else if (to->kind == .integer && v == .floating) {
        F64 real = v.floating.value;
        Bool negative = real < 0.0;
        F64 size = negative ? -real : real;
        if (real != real || size >= 18446744073709551616.0) {
            failed(run, e->span,
                   msg(format::push("`", show(v), "` does not fit `", types::show(to), "` at compile time")));
            return;
        }
        integer_cast(run, e, whole((U64)size, negative), to, wrapping, show(v));
    } else if (to->kind == .floating && (v == .integer || v == .floating)) {
        F64 real = real_of(v);
        if (types::bits_of(to) == 32) real = (F64)(F32)real;
        push_value(run, floating_value(real, to));
    } else {
        unknown(run, e->span, "this conversion is not computed at compile time");
    }
}

// ---------------------------------------------------------------------------------------------------------------
// sizeof, alignof, countof

// The callee of `fields(T)` and its one argument, else null.
static const ast::Expr *fields_argument(const ast::Expr *e) {
    if (e->kind != .call) return nullptr;
    const ast::Expr *callee = e->kind.call.callee;
    if (callee->kind != .name || countof(e->kind.call.args) != 1) return nullptr;
    ast::Path path = callee->kind.name.path;
    if (countof(path.segments) != 1 || !same(path.segments[0].text, "fields")) return nullptr;
    return e->kind.call.args[0];
}

// The number `countof` gives for a type: an array's length, a tuple's (a pack's) elements. False for a count known
// only at run time.
static Bool counted(types::TypeRef t, U64 *count) {
    if (t->kind == .array) {
        *count = types::count_of(t);
        return true;
    }
    if (t->kind == .tuple) {
        *count = (U64)countof(types::slots_of(t).items);
        return true;
    }
    return false;
}

static Bool makes_type(Run *run, const ast::Expr *e);

static void query_step(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .query) return;
    types::Checked *r = run->r;
    ast::QueryOp op = e->kind.query.op;
    const ast::Expr *operand = e->kind.query.operand;
    types::TypeRef size = types::builtin(&r->table, "Usize");
    const ast::Expr *reflected = (op == .count_of && operand != nullptr) ? fields_argument(operand) : nullptr;
    types::TypeRef t = nullptr;
    if (s.phase == 1) { // `sizeof(Pair(u8))`: the call was run, and its value is the type
        t = held_type(pop_value(run));
    } else if (operand != nullptr && reflected == nullptr && makes_type(run, operand)) {
        push_step(run, later(s, 1));
        push_step(run, expr_step(operand, s));
        return;
    } else if (e->kind.query.type != nullptr) {
        t = resolve_quiet(run, e->kind.query.type);
    } else if (reflected != nullptr) {
        t = operand_type(run, reflected);
    } else {
        t = operand_type(run, operand);
        if (op == .count_of && operand != nullptr && s.phase == 0 &&
            (t == nullptr || t->kind == .slice || t->kind == .text)) {
            push_step(run, later(s, 15)); // a slice or a string: its length is in the value
            push_step(run, expr_step(operand, s));
            return;
        }
    }
    if (is_open(run, t)) {
        unknown(run, e->span, "the type this asks about is not known yet");
        return;
    }
    U64 answer = 0;
    if (reflected != nullptr) {
        if (t->kind != .record) {
            unknown(run, e->span, "`fields` lists the fields of a struct");
            return;
        }
        answer = (U64)countof(types::slots_of(t).items);
    } else if (op == .count_of) {
        if (!counted(t, &answer)) {
            unknown(run, e->span, "this count is known only at run time");
            return;
        }
    } else {
        types::Layout layout = types::layout(&r->table.target, t);
        if (!layout.known) {
            unknown(run, e->span, msg(format::push("`", types::show(t), "` has no size")));
            return;
        }
        answer = op == .size_of ? layout.size : layout.align;
    }
    push_value(run, integer_value(answer, false, size));
}

// ---------------------------------------------------------------------------------------------------------------
// Calls

// Whether `d` is a concept function: every parameter a `type`, the result `bool`, the body one expression
// (`types::concept_body`). The checker answers a call of one where it types the call.
export Bool may_run(const ast::Decl *d) {
    return types::concept_body(d) != nullptr;
}

// The name a call names when its callee is one plain name, else an empty text.
static Str callee_name(const ast::Expr *callee) {
    ast::Path path = {};
    // `float(T)`, `signed(T)`: the parser reads a name of today's C types as a type
    if (callee->kind != .name && callee->kind != .type_value) return "";
    if (!types::names_a_constant(callee, &path) || countof(path.segments) != 1) return "";
    return path.segments[0].text;
}

// The function a call names, read through modules; null when its callee is no name of one.
static const types::Symbol *called(Run *run, const ast::Expr *callee) {
    types::Names names = types::member_names(callee);
    ast::Path path = {};
    const types::Symbol *symbol = nullptr;
    if (names.count >= 2) {
        symbol = types::type_through_modules(run->r, path_of(&names, names.count, callee->span));
    } else if (types::name_path(callee, &path)) {
        symbol = types::type_through_modules(run->r, path);
        // A question about a type read in the body of an instance of another module's generic is not hidden by a
        // function of the module being checked (#3600): `is_integer` of the caller is not the one `std.format` asks.
        if (symbol != nullptr && countof(path.segments) == 1) {
            Str asked = path.segments[0].text;
            if ((is_question(asked) || is_concept(asked)) && types::lookup_own(&run->r->scopes, asked) == nullptr) {
                return nullptr;
            }
        }
    }
    if (symbol == nullptr || symbol->kind != .function_symbol) return nullptr;
    return symbol;
}

static const ast::Decl *function_of(const types::Symbol *symbol) {
    if (symbol == nullptr) return nullptr;
    const ast::Decl *decl = symbol->decl;
    if (decl == nullptr || decl->kind != .function) return nullptr;
    return decl;
}

// The contract a call states (`contract.requires(c)`): `requires`, else an empty text.
static Str contract_of(const ast::Expr *callee) {
    types::Names names = types::member_names(callee);
    if (names.count != 2 || !same(names.items[0], "contract")) return "";
    return names.items[1];
}

// A contract: `requires`, `assert` and `invariant` are checked as the function runs; the others (`ensures`,
// `modifies`) say something to the prover and run nothing.
static void contract_step(Run *run, Step s, Str contract) {
    const ast::Expr *e = s.expr;
    if (e->kind != .call) return;
    ast::ExprRef args[:] = e->kind.call.args;
    Bool checked = same(contract, "requires") || same(contract, "assert") || same(contract, "invariant");
    if (!checked || countof(args) == 0) {
        push_value(run, nothing_value());
        return;
    }
    push_step(run, later(s, 2));
    push_step(run, expr_step(args[0], s));
}

static void contract_resume(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .call) return;
    Str contract = contract_of(e->kind.call.callee);
    Value held = pop_value(run);
    if (held != .boolean) {
        unknown(run, e->span, "this contract is not a bool known at compile time");
    } else if (!held.boolean.value) {
        failed(run, e->span, msg(format::push("`contract.", contract, "` fails at compile time")));
    } else {
        push_value(run, nothing_value());
    }
}

// The arguments of a call of a smith function are read first, in order, then the defaults of the parameters the call
// leaves out; `call_enter` runs the body next.
static void arguments_step(Run *run, Step s, const types::Symbol *symbol, const ast::Decl *decl) {
    const ast::Expr *e = s.expr;
    if (e->kind != .call || decl->kind != .function) return;
    ast::ExprRef args[:] = e->kind.call.args;
    ast::Param params[:] = decl->kind.function.params;
    Str name = short_name(symbol->name);
    if (decl->from_c || decl->is_extern || decl->kind.function.body == nullptr) {
        unknown(run, e->span,
                msg(format::push("`", name, "` is a C function; only smith functions run at compile time")));
        return;
    }
    // A C-variadic function (`Bool within(...)`) takes more arguments than it has parameters, and its body cannot
    // read them: they are not run, so a function name given to it (`effects::within(f, set)`) is plain.
    Bool variadic = decl->kind.function.variadic;
    Usize given_count = variadic && countof(args) > countof(params) ? countof(params) : countof(args);
    Bool plain = variadic || countof(args) <= countof(params);
    for (Usize i = 0; i < countof(args); i++) {
        const ast::Expr *given = args[i];
        plain = plain && given->kind != .named_arg && given->kind != .expand;
    }
    for (Usize i = 0; i < countof(params); i++) {
        plain = plain && !params[i].is_rest && !params[i].is_pack && !params[i].is_gather;
        plain = plain && (i < given_count || params[i].default_value != nullptr);
    }
    if (!plain) {
        unknown(run, e->span,
                msg(format::push("`", name, "(...)` passes its arguments in a way that is not run at compile time; ",
                                 "pass each one by position")));
        return;
    }
    Str module = module_of(symbol->name, s.prefix);
    push_step(run, later(s, 3));
    for (Usize i = countof(params); i > given_count; i--) {
        Step given = expr_step(params[i - 1].default_value, s);
        given.prefix = module;
        push_step(run, given);
    }
    for (Usize i = given_count; i > 0; i--)
        push_step(run, expr_step(args[i - 1], s));
}

// A call: a question about a type (`is_slice(T)`), a contract, or a smith function, whose arguments are read first.
static void call_step(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .call) return;
    const ast::Expr *callee = e->kind.call.callee;
    ast::ExprRef args[:] = e->kind.call.args;
    const types::Symbol *symbol = called(run, callee);
    const ast::Decl *decl = function_of(symbol);
    Str name = callee_name(callee);
    Str contract = contract_of(callee);
    types::TypeRef made = decl == nullptr ? constructed_type(run, callee) : nullptr;
    if (made != nullptr) {
        construct_step(run, s, made);
    } else if (decl == nullptr && countof(args) == 1 && (is_question(name) || is_concept(name))) {
        push_step(run, later(s, 1));
        push_step(run, expr_step(args[0], s));
    } else if (countof(contract) > 0) {
        contract_step(run, s, contract);
    } else if (symbol != nullptr && types::is_with_dims(symbol->name) && countof(args) == 2) {
        push_step(run, later(s, 5)); // built in: no function over types writes `[,]T`
        push_step(run, expr_step(args[1], s));
        push_step(run, expr_step(args[0], s));
    } else if (decl == nullptr || symbol == nullptr) {
        unknown(run, e->span, "this is not a call of a function, so it is not run at compile time");
    } else {
        arguments_step(run, s, symbol, decl);
    }
}

// `slice.with_dims(T, k)`: the element and the count are read.
static void with_dims_resume(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    Value count = pop_value(run);
    Value element = pop_value(run);
    if (element != .type_value || count != .integer || count.integer.negative) {
        unknown(run, e->span, "`slice.with_dims` takes an element type and a count known at compile time");
    } else if (count.integer.magnitude == 0) {
        failed(run, e->span,
               "`slice.with_dims` makes a slice of 1 or more dimensions, not 0; write the element type itself");
    } else {
        push_value(run, type_value(types::with_dims(run->r, element.type_value.type, count.integer.magnitude)));
    }
}

// The argument of a question about a type is read: the answer.
static void question_resume(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .call) return;
    const ast::Expr *callee = e->kind.call.callee;
    Value asked = pop_value(run);
    if (asked != .type_value) {
        unknown(run, e->span, "this argument is not a type known at compile time");
        return;
    }
    push_value(run, boolean_value(question_answer(callee_name(callee), held_type(asked))));
}

// Whether the written type is the one name `name`.
static Bool written_as(const ast::TypeExpr *written, Str name) {
    if (written == nullptr || written->kind != .named) return false;
    ast::Path path = written->kind.named.path;
    return countof(path.segments) == 1 && same(path.segments[0].text, name);
}

// The parameters in brackets (`fn add[T](a: T, b: T)`) take the type of the first argument whose parameter is written
// as the name. `first` is the first parameter's local.
static void bind_generics(Run *run, const ast::Decl *decl, Usize first) {
    if (decl->kind != .function) return;
    ast::Param params[:] = decl->kind.function.params;
    ast::Param generics[:] = decl->kind.function.generics;
    for (Usize g = 0; g < countof(generics); g++) {
        for (Usize i = 0; i < countof(params); i++) {
            if (!written_as(params[i].type, generics[g].name)) continue;
            types::TypeRef t = value_type(run, run->locals[first + i].value);
            if (t != nullptr) add_local(run, generics[g].name, type_value(t), false, nullptr);
            break;
        }
    }
}

// The arguments of a call are on the value stack: the function's body is run next, in its own module, with its
// parameters as locals, each fitted to its type.
static void call_enter(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .call) return;
    types::Checked *r = run->r;
    const types::Symbol *symbol = called(run, e->kind.call.callee);
    const ast::Decl *decl = function_of(symbol);
    if (symbol == nullptr || decl == nullptr || decl->kind != .function) return;
    ast::Param params[:] = decl->kind.function.params;
    const ast::Stmt *body = decl->kind.function.body;
    Usize base = run->have - countof(params);
    Usize first = run->local_count;
    push_frame(run, (Frame){.name = symbol->name,
                            .decl = decl,
                            .params = countof(params),
                            .values = base,
                            .locals = first,
                            .scopes = run->scopes,
                            .loops = run->loop_count});
    types::push_scope(&r->scopes);
    run->scopes += 1;
    r->prefix = module_of(symbol->name, s.prefix);
    for (Usize i = 0; i < countof(params); i++)
        add_local(run, params[i].name, run->values[base + i], params[i].is_mut, nullptr);
    run->have = base;
    if (run->frame_count > depth_limit()) {
        Str outermost = shown_call(run, 0);
        run->frame_count = 1; // the message names the first call; the 512 that follow say nothing more
        failed(run, e->span,
               msg(format::push("`", outermost, "` is ", depth_limit(),
                                " calls deep at compile time; the recursion does not end")));
        return;
    }
    bind_generics(run, decl, first);
    for (Usize i = 0; i < countof(params); i++) {
        types::TypeRef declared = resolve_quiet(run, params[i].type);
        Value kept = nothing_value();
        Bool fitted = coerced(run, e->span, run->locals[first + i].value, declared, &kept);
        if (!fitted) {
            return;
        }
        run->locals[first + i].value = kept;
        run->locals[first + i].type = declared;
    }
    Step leave = later(s, 4);
    leave.prefix = r->prefix;
    push_step(run, leave);
    run->frames[run->frame_count - 1].steps = run->top;
    push_step(run, stmt_step(body, leave));
}

// The body of a function is run: its value takes the result type, and its locals and scopes end.
static void call_leave(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    Value v = pop_value(run);
    Frame f = run->frames[run->frame_count - 1];
    const ast::Decl *decl = f.decl;
    if (decl->kind != .function) return;
    const ast::TypeExpr *written = decl->kind.function.result;
    types::TypeRef declared = written == nullptr ? run->r->table.void_type : resolve_quiet(run, written);
    Value kept = v;
    if (declared == run->r->table.void_type) {
        kept = nothing_value();
    } else if (v == .nothing) {
        unknown(run, e->span, "it ends without a value");
        return;
    } else if (!coerced(run, e->span, v, declared, &kept)) {
        return;
    }
    restore(run, f.locals, f.scopes);
    run->loop_count = f.loops;
    run->frame_count -= 1;
    push_value(run, kept);
}

// ---------------------------------------------------------------------------------------------------------------
// Values with memory (step 3): arrays, strings, structs, fields and elements

// `[a, b, c]`: the items are read, then the array is made.
static void array_step(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .array_lit) return;
    ast::ExprRef items[:] = e->kind.array_lit.items;
    push_step(run, later(s, 11));
    for (Usize i = countof(items); i > 0; i--)
        push_step(run, expr_step(items[i - 1], s));
}

static void array_resume(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .array_lit) return;
    Usize count = countof(e->kind.array_lit.items);
    types::TypeRef written = types::type_of(run->r, e);
    types::TypeRef element = nullptr;
    if (written != nullptr && written->kind == .array && types::count_of(written) == count) {
        element = types::element_of(written);
    } else if (count > 0) {
        element = value_type(run, run->values[run->have - count]);
    }
    if (element == nullptr) {
        unknown(run, e->span, "the type of this array is not known at compile time");
        return;
    }
    types::TypeRef type = types::array_of(&run->r->table, element, count, false);
    Usize object = new_object(run, e->span, type, count);
    if (run->stopped) return;
    for (Usize i = count; i > 0; i--) {
        Value fitted = pop_value(run);
        if (!coerced(run, e->span, fitted, element, &fitted)) return;
        cell_set(object, i - 1, copied(run, e->span, fitted));
    }
    push_value(run, aggregate_value(object, type));
}

// A string: a slice of `Char` cells (`str`).
static void string_step(Run *run, const ast::Expr *e) {
    if (e->kind != .string) return;
    types::Table *table = &run->r->table;
    Str bytes = e->kind.string.bytes;
    types::TypeRef chars = types::builtin(table, "Char");
    Usize count = countof(bytes);
    Usize object = new_object(run, e->span, types::array_of(table, chars, count, true), count);
    if (run->stopped) return;
    for (Usize i = 0; i < count; i++)
        cell_set(object, i, integer_value((U64)(U8)bytes[i], false, chars));
    push_value(run, slice_value(object, 0, count, table->text));
}

// The record a call constructs (`Point(x = 1, y = 2)`): the callee names a struct. Null for any other call.
static types::TypeRef constructed_type(Run *run, const ast::Expr *callee) {
    types::TypeRef t = nullptr;
    ast::Path path = {};
    if (callee->kind == .type_value) {
        t = resolve_quiet(run, callee->kind.type_value.type);
    } else if (types::name_path(callee, &path)) {
        const types::Symbol *symbol = types::type_through_modules(run->r, path);
        if (symbol != nullptr && symbol->kind == .type_name) t = symbol->type;
    }
    if (t == nullptr || is_open(run, t) || t->kind != .record || t->kind.record.is_union) return nullptr;
    return t;
}

// The field argument `i` fills: by its name (`y = 2`), else by its place. The field count when there is none.
static Usize argument_slot(types::Slot slots[:], ast::ExprRef args[:], Usize i) {
    const ast::Expr *given = args[i];
    if (given->kind != .named_arg) return i < countof(slots) ? i : countof(slots);
    for (Usize k = 0; k < countof(slots); k++) {
        if (same(slots[k].name, given->kind.named_arg.name)) return k;
    }
    return countof(slots);
}

static const ast::Expr *argument_value(const ast::Expr *given) {
    return given->kind == .named_arg ? given->kind.named_arg.value : given;
}

// Which fields the arguments fill; false, and the run is stopped, when one names no field or fills one twice.
static Bool fills(Run *run, const ast::Expr *e, types::TypeRef t, Bool filled[:]) {
    if (e->kind != .call) return false;
    ast::ExprRef args[:] = e->kind.call.args;
    types::Slot slots[:] = types::slots_of(t).items;
    for (Usize i = 0; i < countof(args); i++) {
        Usize at = argument_slot(slots, args, i);
        if (at == countof(slots) || filled[at]) {
            unknown(run, args[i]->span,
                    msg(format::push("`", types::show(t), "` has no field here for this argument")));
            return false;
        }
        filled[at] = true;
    }
    return true;
}

// `Point(x = n, y = n * 2)`: the arguments are read, then the defaults of the fields they leave out.
static void construct_step(Run *run, Step s, types::TypeRef t) {
    const ast::Expr *e = s.expr;
    if (e->kind != .call) return;
    ast::ExprRef args[:] = e->kind.call.args;
    types::Slot slots[:] = types::slots_of(t).items;
    Bool filled[:] = mem::alloc_slice(Bool, countof(slots));
    if (!fills(run, e, t, filled)) return;
    push_step(run, later(s, 12));
    for (Usize k = 0; k < countof(slots); k++) {
        if (filled[k]) continue;
        if (slots[k].default_value == nullptr) {
            unknown(run, e->span, msg(format::push("`", types::show(t), "` needs a value for `", slots[k].name, "`")));
            return;
        }
    }
    for (Usize k = countof(slots); k > 0; k--) {
        if (!filled[k - 1]) push_step(run, expr_step(slots[k - 1].default_value, s));
    }
    for (Usize i = countof(args); i > 0; i--)
        push_step(run, expr_step(argument_value(args[i - 1]), s));
}

static void construct_resume(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .call) return;
    types::TypeRef t = constructed_type(run, e->kind.call.callee);
    if (t == nullptr) return;
    ast::ExprRef args[:] = e->kind.call.args;
    types::Slot slots[:] = types::slots_of(t).items;
    Bool filled[:] = mem::alloc_slice(Bool, countof(slots));
    if (!fills(run, e, t, filled)) return;
    Usize object = new_object(run, e->span, t, countof(slots));
    if (run->stopped) return;
    for (Usize k = countof(slots); k > 0; k--) {
        if (filled[k - 1]) continue;
        Value fitted = pop_value(run);
        if (!coerced(run, e->span, fitted, slots[k - 1].type, &fitted)) return;
        cell_set(object, k - 1, copied(run, e->span, fitted));
    }
    for (Usize i = countof(args); i > 0; i--) {
        Usize at = argument_slot(slots, args, i - 1);
        Value fitted = pop_value(run);
        if (!coerced(run, args[i - 1]->span, fitted, slots[at].type, &fitted)) return;
        cell_set(object, at, copied(run, args[i - 1]->span, fitted));
    }
    push_value(run, aggregate_value(object, t));
}

// Whether the base of the member `e` is a value (a local, a variable, a call, an element) and not a module, a type or
// a C header: `p.x` reads a field, `std.math.pi` a name.
static Bool base_is_value(Run *run, const ast::Expr *e) {
    if (e->kind != .member) return false;
    const ast::Expr *base = e->kind.member.base;
    while (base->kind == .member) {
        base = base->kind.member.base;
    }
    ast::Path path = {};
    if (!types::name_path(base, &path)) return base->kind != .type_value && base->kind != .name;
    Value held = nothing_value();
    if (countof(path.segments) == 1 && local_value(run, path.segments[0].text, &held)) return true;
    const types::Symbol *symbol = types::type_through_modules(run->r, path);
    return symbol != nullptr && symbol->kind == .variable;
}

static void field_step(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .member) return;
    push_step(run, later(s, 13));
    push_step(run, expr_step(e->kind.member.base, s));
}

// The field `name` of the struct `v`: its object and the cell. False, and the run is stopped, when there is none.
static Bool field_cell(Run *run, ast::Span at, Value v, Str name, Usize *cell) {
    if (v == .unset) {
        unknown(run, at, "this reads a value that nothing has written");
        return false;
    }
    if (v != .aggregate || v.aggregate.type->kind == .array) {
        unknown(run, at, msg(format::push("`.", name, "` reads a field of a struct, and this is not one")));
        return false;
    }
    types::Slot slots[:] = types::slots_of(v.aggregate.type).items;
    for (Usize k = 0; k < countof(slots); k++) {
        if (same(slots[k].name, name)) {
            *cell = k;
            return true;
        }
    }
    unknown(run, at, msg(format::push("`", types::show(v.aggregate.type), "` has no field `", name, "`")));
    return false;
}

static void field_resume(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .member) return;
    Value v = pop_value(run);
    Usize cell = 0;
    if (!field_cell(run, e->span, v, e->kind.member.name, &cell)) return;
    if (v == .aggregate) push_value(run, cell_get(v.aggregate.object, cell));
}

static void index_step(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .index) return;
    push_step(run, later(s, 14));
    push_step(run, expr_step(e->kind.index.index, s));
    push_step(run, expr_step(e->kind.index.base, s));
}

// The element `index` of the array or slice `v`: its object and cell. False, and the run is stopped, when `index` is
// not one of its places.
static Bool element_cell(Run *run, ast::Span at, Value v, Value index, Usize *object, Usize *cell) {
    if (v == .unset) {
        unknown(run, at, "this reads a value that nothing has written");
        return false;
    }
    Bool array = v == .aggregate && v.aggregate.type->kind == .array;
    if (!array && v != .slice) {
        unknown(run, at, "this indexes something that is not an array, a slice or a string known at compile time");
        return false;
    }
    if (index != .integer || index.integer.negative) {
        if (index == .integer) {
            failed(run, at, msg(format::push("the index ", show(index), " is out of range at compile time")));
        } else {
            unknown(run, at, "this index is not a whole number known at compile time");
        }
        return false;
    }
    Usize holder = 0;
    Usize begin = 0;
    Usize end = 0;
    if (v == .aggregate) {
        holder = v.aggregate.object;
        end = cells_in(holder);
    } else if (v == .slice) {
        holder = v.slice.object;
        begin = v.slice.begin;
        end = v.slice.end;
    }
    if (index.integer.magnitude >= end - begin) {
        failed(run, at,
               msg(format::push("the index ", index.integer.magnitude, " is out of range for ", end - begin,
                                " elements at compile time")));
        return false;
    }
    *object = holder;
    *cell = begin + (Usize)index.integer.magnitude;
    return true;
}

static void index_resume(Run *run, Step s) {
    Value index = pop_value(run);
    Value base = pop_value(run);
    Usize object = 0;
    Usize cell = 0;
    if (!element_cell(run, s.expr->span, base, index, &object, &cell)) return;
    push_value(run, cell_get(object, cell));
}

// `countof(x)` of a value: the cells of an array, the range of a slice or a string.
static void count_resume(Run *run, Step s) {
    Value v = pop_value(run);
    types::TypeRef size = types::builtin(&run->r->table, "Usize");
    if (v == .aggregate && v.aggregate.type->kind == .array) {
        push_value(run, integer_value((U64)cells_in(v.aggregate.object), false, size));
    } else if (v == .slice) {
        push_value(run, integer_value((U64)(v.slice.end - v.slice.begin), false, size));
    } else {
        unknown(run, s.expr->span, "this count is known only at run time");
    }
}

// A pair of values still to compare.
struct Pairs {
    Value left[:];
    Value right[:];
    Usize count;
};

static void pairs_push(Pairs *p, Value a, Value b) {
    if (p->count == countof(p->left)) {
        Usize capacity = countof(p->left) * 2;
        if (capacity < 16) capacity = 16;
        p->left = mem::realloc(p->left, capacity);
        p->right = mem::realloc(p->right, capacity);
    }
    p->left[p->count] = a;
    p->right[p->count] = b;
    p->count += 1;
}

// Two values that are not objects, compared: 1 equal, 0 not, 2 not comparable at compile time.
static U32 scalar_equal(Value a, Value b) {
    if (a == .integer && b == .integer)
        return a.integer.magnitude == b.integer.magnitude && a.integer.negative == b.integer.negative ? 1 : 0;
    if (a == .boolean && b == .boolean) return a.boolean.value == b.boolean.value ? 1 : 0;
    if (a == .enumerator && b == .enumerator) return a.enumerator.index == b.enumerator.index ? 1 : 0;
    if (a == .floating && b == .floating) return a.floating.value == b.floating.value ? 1 : 0;
    return 2;
}

// `==` on structs, arrays and strings: cell by cell, nested objects included. The cells the two hold are compared in
// order and the first that differs ends it.
static void aggregate_equality(Run *run, const ast::Expr *e, ast::BinaryOp op, Value l, Value r) {
    Pairs todo = {};
    pairs_push(&todo, l, r);
    Bool equal = true;
    for (Usize next = 0; next < todo.count && equal; next++) {
        Value a = todo.left[next];
        Value b = todo.right[next];
        if (a == .aggregate && b == .aggregate) {
            Usize n = cells_in(a.aggregate.object);
            equal = n == cells_in(b.aggregate.object);
            for (Usize i = 0; i < n && equal; i++)
                pairs_push(&todo, cell_get(a.aggregate.object, i), cell_get(b.aggregate.object, i));
        } else if (a == .slice && b == .slice) {
            Usize n = a.slice.end - a.slice.begin;
            equal = n == b.slice.end - b.slice.begin;
            for (Usize i = 0; i < n && equal; i++)
                pairs_push(&todo, cell_get(a.slice.object, a.slice.begin + i),
                           cell_get(b.slice.object, b.slice.begin + i));
        } else {
            U32 same_cells = scalar_equal(a, b);
            if (same_cells == 2) {
                unknown(run, e->span, "these two are not compared at compile time");
                return;
            }
            equal = same_cells == 1;
        }
    }
    push_value(run, boolean_value(equal == (op == .equal)));
}

// ---------------------------------------------------------------------------------------------------------------
// Statements. Each leaves one value: its own (`if c: a else: b`, a block's last line), or `nothing`.

static void block_step(Run *run, Step s) {
    const ast::Stmt *st = s.stmt;
    if (st->kind != .block) return;
    ast::StmtRef items[:] = st->kind.block.items;
    Usize done = (Usize)s.phase;
    if (countof(items) == 0) {
        push_value(run, nothing_value());
    } else if (done == 0) {
        Step next = later(s, 1);
        next.locals = run->local_count;
        next.scopes = run->scopes;
        types::push_scope(&run->r->scopes);
        run->scopes += 1;
        push_step(run, next);
        push_step(run, stmt_step(items[0], s));
    } else if (done < countof(items)) {
        (void)pop_value(run);
        push_step(run, later(s, s.phase + 1));
        push_step(run, stmt_step(items[done], s));
    } else {
        restore(run, s.locals, s.scopes); // the value of the last line stays
    }
}

// The unnamed `enum:` or `struct:` a type function ends with: the type it makes for these arguments, one type however
// many times the call is written.
static void made_type_step(Run *run, Step s, const ast::Decl *d) {
    if (run->frame_count == 0) {
        unknown(run, s.stmt->span, "a type is declared here, outside a function that returns it");
        return;
    }
    Str name = msg(format::push(types::module_prefix(run->frames[run->frame_count - 1].name),
                                shown_call(run, run->frame_count - 1)));
    push_value(run, type_value(types::unnamed_type(run->r, d, name)));
}

// A local: its initializer is read, fitted to the type written for it, and held under its name.
static void declaration_step(Run *run, Step s) {
    const ast::Stmt *st = s.stmt;
    if (st->kind != .declaration) return;
    const ast::Decl *d = st->kind.declaration.decl;
    if (d->kind == .enumeration || d->kind == .record) {
        made_type_step(run, s, d);
        return;
    }
    if (d->kind != .variable) {
        unknown(run, st->span, "this declaration is not run at compile time");
        return;
    }
    const ast::Expr *init = d->kind.variable.init;
    const ast::TypeExpr *written = d->kind.variable.type;
    Str name = d->kind.variable.name;
    Bool is_mut = d->kind.variable.is_mut;
    if (init == nullptr) {
        unknown(run, st->span, msg(format::push("`", name, "` has no value")));
        return;
    }
    if (s.phase == 0) {
        push_step(run, later(s, 1));
        push_step(run, expr_step(init, s));
        return;
    }
    Value v = pop_value(run);
    types::TypeRef declared = nullptr;
    if (written != nullptr && written->kind != .auto_type) declared = resolve_quiet(run, written);
    Value kept = v;
    if (!coerced(run, init->span, v, declared, &kept)) return;
    add_local(run, name, kept, is_mut, declared);
    push_value(run, nothing_value());
}

static void if_step(Run *run, Step s) {
    const ast::Stmt *st = s.stmt;
    if (st->kind != .if_stmt) return;
    const ast::Expr *condition = st->kind.if_stmt.condition;
    const ast::Stmt *then_branch = st->kind.if_stmt.then_branch;
    const ast::Stmt *else_branch = st->kind.if_stmt.else_branch;
    if (s.phase == 0) {
        push_step(run, later(s, 1));
        push_step(run, expr_step(condition, s));
        return;
    }
    Value test = pop_value(run);
    if (test != .boolean) {
        unknown(run, condition->span, "this is not a bool known at compile time");
        return;
    }
    const ast::Stmt *taken = test.boolean.value ? then_branch : else_branch;
    if (taken == nullptr) {
        push_value(run, nothing_value());
    } else {
        push_step(run, stmt_step(taken, s));
    }
}

// A loop that starts here: where `break` and `continue` come back to.
static Loop loop_here(const Run *run, Step s, U32 again) {
    return (Loop){.step = s,
                  .again = again,
                  .steps = run->top,
                  .values = run->have,
                  .locals = run->local_count,
                  .scopes = run->scopes,
                  .body = run->local_count,
                  .at = whole(0, false),
                  .limit = whole(0, false),
                  .type = nullptr};
}

// `while c: body`. Phase 1 has the condition, phase 2 the body's value.
static void while_step(Run *run, Step s) {
    const ast::Stmt *st = s.stmt;
    if (st->kind != .while_stmt) return;
    const ast::Expr *condition = st->kind.while_stmt.condition;
    const ast::Stmt *body = st->kind.while_stmt.body;
    if (st->kind.while_stmt.binds) {
        unknown(run, st->span, "a `while` that binds a name is not run at compile time");
        return;
    }
    if (s.phase != 1) {
        if (s.phase == 0) push_loop(run, loop_here(run, s, 2));
        if (s.phase == 2) (void)pop_value(run);
        push_step(run, later(s, 1));
        push_step(run, expr_step(condition, s));
        return;
    }
    Value test = pop_value(run);
    if (test != .boolean) {
        unknown(run, condition->span, "this is not a bool known at compile time");
    } else if (!test.boolean.value) {
        run->loop_count -= 1;
        push_value(run, nothing_value());
    } else {
        push_step(run, later(s, 2));
        push_step(run, stmt_step(body, s));
    }
}

// Whether the expression is `range(a, b)` or `range(b)`.
static Bool is_range(const ast::Expr *iterable) {
    if (iterable->kind != .call) return false;
    const ast::Expr *callee = iterable->kind.call.callee;
    Usize count = countof(iterable->kind.call.args);
    types::Names names = types::member_names(callee);
    Bool named = same(callee_name(callee), "range");
    if (names.count >= 2) named = same(names.items[names.count - 1], "range");
    return named && count >= 1 && count <= 2;
}

// `for i in range(a, b): body`: the bounds are read (phase 1), then each turn tests the count (2) and runs the body,
// whose value phase 3 drops before the next turn.
static void for_turn(Run *run, Step s) {
    const ast::Stmt *st = s.stmt;
    if (st->kind != .for_in) return;
    const ast::Stmt *body = st->kind.for_in.body;
    Loop *loop = &run->loops[run->loop_count - 1];
    if (s.phase == 3) {
        (void)pop_value(run);
        loop->at = whole_add(loop->at, whole(1, false));
        restore(run, loop->body, loop->scopes);
    }
    if (whole_order(loop->at, loop->limit) >= 0) {
        restore(run, loop->locals, loop->scopes);
        run->loop_count -= 1;
        push_value(run, nothing_value());
        return;
    }
    run->locals[loop->locals].value = integer_value(loop->at.magnitude, loop->at.negative, loop->type);
    push_step(run, later(s, 3));
    push_step(run, stmt_step(body, s));
}

static void for_step(Run *run, Step s) {
    const ast::Stmt *st = s.stmt;
    if (st->kind != .for_in) return;
    ast::Identifier names[:] = st->kind.for_in.names;
    const ast::Expr *iterable = st->kind.for_in.iterable;
    if (!is_range(iterable) || iterable->kind != .call || countof(names) != 1 || st->kind.for_in.is_tuple) {
        unknown(run, st->span,
                "this loop is not run at compile time; a loop that is, is `for i in range(a, b):` or a `while`");
        return;
    }
    ast::ExprRef bounds[:] = iterable->kind.call.args;
    if (s.phase == 0) {
        push_step(run, later(s, 1));
        for (Usize i = countof(bounds); i > 0; i--)
            push_step(run, expr_step(bounds[i - 1], s));
    } else if (s.phase == 1) {
        Value limit = pop_value(run);
        Value start = countof(bounds) == 2 ? pop_value(run) : integer_value(0, false, nullptr);
        if (start != .integer || limit != .integer) {
            unknown(run, st->span, "the bounds of this `range` are not integers known at compile time");
            return;
        }
        Loop loop = loop_here(run, s, 3);
        loop.at = whole(start.integer.magnitude, start.integer.negative);
        loop.limit = whole(limit.integer.magnitude, limit.integer.negative);
        loop.type = joined_type(start.integer.type, limit.integer.type);
        loop.body = run->local_count + 1;
        push_loop(run, loop);
        add_local(run, names[0].text, start, false, nullptr);
        for_turn(run, later(s, 2));
    } else {
        for_turn(run, s);
    }
}

// The arm and the pattern at position `at` of a `match`, its patterns counted across its arms; false past the last.
static Bool pattern_at(ast::MatchArm arms[:], Usize at, Usize *arm, ast::Pattern *out) {
    Usize seen = 0;
    for (Usize a = 0; a < countof(arms); a++) {
        ast::Pattern patterns[:] = arms[a].patterns;
        if (at < seen + countof(patterns)) {
            *arm = a;
            *out = patterns[at - seen];
            return true;
        }
        seen += countof(patterns);
    }
    return false;
}

// Whether the value is the variant or the fact `.name`.
static Bool named_so(Value v, Str name) {
    if (v == .enumerator) {
        types::Slot slots[:] = types::slots_of(v.enumerator.type).items;
        return same(slots[v.enumerator.index].name, name);
    }
    if (v == .fact) return same(v.fact.name, name);
    return false;
}

static Bool same_value(const Run *run, Value a, Value b) {
    if (a == .integer && b == .integer) {
        Whole l = whole(a.integer.magnitude, a.integer.negative);
        return whole_order(l, whole(b.integer.magnitude, b.integer.negative)) == 0;
    }
    if (a == .boolean && b == .boolean) return a.boolean.value == b.boolean.value;
    if (a == .enumerator && b == .enumerator)
        return a.enumerator.type == b.enumerator.type && a.enumerator.index == b.enumerator.index;
    if (a == .fact && b == .fact) return same(a.fact.family, b.fact.family) && same(a.fact.name, b.fact.name);
    if (a == .type_value && b == .type_value) return same_type(run, a.type_value.type, b.type_value.type);
    return false;
}

// Tries the patterns of a `match` from position `from` against the value on the stack: the arm of the first that
// takes it is read next. A pattern that is a constant is read first, and `match_step` compares it.
static void match_try(Run *run, Step s, Usize from) {
    const ast::Stmt *st = s.stmt;
    if (st->kind != .match_stmt) return;
    ast::MatchArm arms[:] = st->kind.match_stmt.arms;
    Value subject = run->values[run->have - 1];
    for (Usize at = from; at < 65536; at++) {
        Usize arm = 0;
        ast::Pattern pattern = {};
        if (!pattern_at(arms, at, &arm, &pattern)) {
            unknown(run, st->span, "no arm of this `match` takes the value");
            return;
        }
        if (countof(pattern.binding) > 0) {
            unknown(run, pattern.span, "a pattern that binds a payload is not run at compile time");
            return;
        }
        if (pattern.constant != nullptr) {
            Step read = expr_step(pattern.constant, s);
            if (subject == .enumerator) read.type = subject.enumerator.type;
            push_step(run, later(s, 2 + (U32)at));
            push_step(run, read);
            return;
        }
        if (pattern.wildcard || named_so(subject, pattern.name)) {
            (void)pop_value(run);
            push_step(run, expr_step(arms[arm].value, s));
            return;
        }
    }
}

// `match v:` on a number, a bool, an enumerator or a type. Phase 1 has the value; phase 2 + n the constant of the
// pattern at position n.
static void match_step(Run *run, Step s) {
    const ast::Stmt *st = s.stmt;
    if (st->kind != .match_stmt) return;
    ast::MatchArm arms[:] = st->kind.match_stmt.arms;
    if (s.phase == 0) {
        push_step(run, later(s, 1));
        push_step(run, expr_step(st->kind.match_stmt.value, s));
    } else if (s.phase == 1) {
        match_try(run, s, 0);
    } else {
        Usize at = (Usize)s.phase - 2;
        Value constant = pop_value(run);
        Usize arm = 0;
        ast::Pattern pattern = {};
        if (same_value(run, run->values[run->have - 1], constant) && pattern_at(arms, at, &arm, &pattern)) {
            (void)pop_value(run);
            push_step(run, expr_step(arms[arm].value, s));
        } else {
            match_try(run, s, at + 1);
        }
    }
}

// `return v`: the call is left from wherever the statement is, with `v` as the body's value.
static void return_step(Run *run, Step s) {
    const ast::Stmt *st = s.stmt;
    if (st->kind != .return_stmt) return;
    const ast::Expr *value = st->kind.return_stmt.value;
    if (s.phase == 0 && value != nullptr) {
        push_step(run, later(s, 1));
        push_step(run, expr_step(value, s));
        return;
    }
    Value v = value == nullptr ? nothing_value() : pop_value(run);
    if (run->frame_count > 0) {
        Frame f = run->frames[run->frame_count - 1];
        run->top = f.steps;
        run->have = f.values;
        run->loop_count = f.loops;
        restore(run, run->local_count, f.scopes + 1); // the parameters stay for the result type
    }
    push_value(run, v);
}

// `break` leaves the innermost loop of the call; `continue` goes to its next turn.
static void jump_step(Run *run, Step s) {
    Bool leaves = s.stmt->kind == .break_stmt;
    Usize base = run->frame_count > 0 ? run->frames[run->frame_count - 1].loops : 0;
    if (run->loop_count <= base) {
        unknown(run, s.stmt->span, "this is outside a loop that runs at compile time");
        return;
    }
    Loop loop = run->loops[run->loop_count - 1];
    run->top = loop.steps;
    run->have = loop.values;
    push_value(run, nothing_value()); // what the loop leaves, or the value of the body that `continue` ends
    if (leaves) {
        restore(run, loop.locals, loop.scopes);
        run->loop_count -= 1;
    } else {
        restore(run, loop.body, loop.scopes);
        push_step(run, later(loop.step, loop.again));
    }
}

static void assert_step(Run *run, Step s) {
    const ast::Stmt *st = s.stmt;
    if (st->kind != .static_assert_stmt) return;
    const ast::Expr *condition = st->kind.static_assert_stmt.condition;
    if (s.phase == 0) {
        push_step(run, later(s, 1));
        push_step(run, expr_step(condition, s));
        return;
    }
    Value held = pop_value(run);
    if (held != .boolean) {
        unknown(run, condition->span, "this is not a bool known at compile time");
    } else if (!held.boolean.value) {
        failed(run, st->span, "static_assert failed");
    } else {
        push_value(run, nothing_value());
    }
}

static void statement_step(Run *run, Step s) {
    const ast::Stmt *st = s.stmt;
    if (st->kind == .block) {
        block_step(run, s);
    } else if (st->kind == .expression) {
        push_step(run, expr_step(st->kind.expression.value, s));
    } else if (st->kind == .declaration) {
        declaration_step(run, s);
    } else if (st->kind == .if_stmt) {
        if_step(run, s);
    } else if (st->kind == .while_stmt) {
        while_step(run, s);
    } else if (st->kind == .for_in) {
        for_step(run, s);
    } else if (st->kind == .match_stmt) {
        match_step(run, s);
    } else if (st->kind == .return_stmt) {
        return_step(run, s);
    } else if (st->kind == .break_stmt || st->kind == .continue_stmt) {
        jump_step(run, s);
    } else if (st->kind == .static_assert_stmt) {
        assert_step(run, s);
    } else if (st->kind == .empty) {
        push_value(run, nothing_value());
    } else {
        unknown(run, st->span, "this statement is not run at compile time");
    }
}

// ---------------------------------------------------------------------------------------------------------------
// Assignment and `if` as a value

static Bool binary_of(ast::AssignOp op, ast::BinaryOp *out) {
    ast::BinaryOp found = .add;
    if (op == .add) found = .add;
    if (op == .subtract) found = .subtract;
    if (op == .multiply) found = .multiply;
    if (op == .divide) found = .divide;
    if (op == .remainder) found = .remainder;
    if (op == .shift_left) found = .shift_left;
    if (op == .shift_right) found = .shift_right;
    if (op == .bit_and) found = .bit_and;
    if (op == .bit_xor) found = .bit_xor;
    if (op == .bit_or) found = .bit_or;
    *out = found;
    return op != .plain;
}

// An assignment's place: the local at its root and the member and index expressions from the root out, nearest the
// root last.
struct Place {
    Usize root; // one more than the index of the local; 0 when the target is none
    Usize depth;
    const ast::Expr *steps[8];
};

static Place place_of(Run *run, const ast::Expr *target) {
    Place place = {};
    const ast::Expr *at = target;
    while (at->kind == .member || at->kind == .index) {
        if (place.depth == 8) {
            unknown(run, target->span, "this place is more than 8 members and elements deep");
            return place;
        }
        place.steps[place.depth] = at;
        place.depth += 1;
        if (at->kind == .member) {
            at = at->kind.member.base;
        } else if (at->kind == .index) {
            at = at->kind.index.base;
        }
    }
    ast::Path path = {};
    if (types::names_a_constant(at, &path) && countof(path.segments) == 1)
        place.root = own_local(run, path.segments[0].text);
    return place;
}

// The cell of the struct or array `from` that the step `at` of a place names (`.x`, `[i]`), and the type its value has.
static Bool place_cell(Run *run, const ast::Expr *at, Value from, Value index, Usize *object, Usize *cell,
                       types::TypeRef *type) {
    if (at->kind == .member) {
        if (!field_cell(run, at->span, from, at->kind.member.name, cell)) return false;
        if (from != .aggregate) return false;
        *object = from.aggregate.object;
        *type = cell_type(from.aggregate.type, *cell);
        return true;
    }
    if (!element_cell(run, at->span, from, index, object, cell)) return false;
    if (from == .slice) {
        *type = types::element_of(from.slice.type);
    } else if (from == .aggregate) {
        *type = types::element_of(from.aggregate.type);
    }
    return true;
}

// The write of `v` (with `op`) into the place: the steps from the root are followed through the cells, and the last
// cell is written.
static void assign_into(Run *run, const ast::Expr *e, Place place, Value indexes[:], ast::AssignOp op, Value v) {
    if (e->kind != .assign) return;
    const ast::Expr *rhs = e->kind.assign.value;
    Value at = run->locals[place.root - 1].value;
    Usize object = 0;
    Usize cell = 0;
    types::TypeRef type = nullptr;
    for (Usize i = place.depth; i > 0; i--) {
        const ast::Expr *step = place.steps[i - 1];
        if (!place_cell(run, step, at, indexes[i - 1], &object, &cell, &type)) return;
        if (i > 1) at = cell_get(object, cell);
    }
    Value now = cell_get(object, cell);
    ast::BinaryOp joined = .add;
    Value written = v;
    if (binary_of(op, &joined)) {
        binary_values(run, e, joined, now, v);
        if (run->stopped) return;
        written = pop_value(run);
    }
    if (!coerced(run, rhs->span, written, type, &written)) return;
    cell_set(object, cell, copied(run, e->span, written));
    push_value(run, nothing_value());
}

// `x = v`, `x += v`, `p.x = v`, `xs[i] = v` on a `mut` local, or on the cells of a slice a local holds.
static void assign_step(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .assign) return;
    ast::AssignOp op = e->kind.assign.op;
    const ast::Expr *target = e->kind.assign.target;
    const ast::Expr *value = e->kind.assign.value;
    Place place = place_of(run, target);
    if (run->stopped) return;
    if (place.root == 0) {
        unknown(run, target->span, "it writes something that is not one of its locals");
        return;
    }
    Local *local = &run->locals[place.root - 1];
    Bool through_slice = place.depth > 0 && local->value == .slice;
    if (!local->is_mut && !through_slice) {
        unknown(run, target->span, msg(format::push("`", local->name, "` is not `mut`")));
        return;
    }
    if (s.phase == 0) {
        push_step(run, later(s, 1));
        for (Usize i = 0; i < place.depth; i++) {
            const ast::Expr *step = place.steps[i];
            if (step->kind == .index) push_step(run, expr_step(step->kind.index.index, s));
        }
        push_step(run, expr_step(value, s));
        return;
    }
    Value indexes[8] = {};
    for (Usize i = 0; i < place.depth; i++) {
        if (place.steps[i]->kind == .index) indexes[i] = pop_value(run);
    }
    Value v = pop_value(run);
    if (place.depth > 0) {
        assign_into(run, e, place, indexes[0:8], op, v);
        return;
    }
    ast::BinaryOp joined = .add;
    if (binary_of(op, &joined)) {
        binary_values(run, e, joined, local->value, v);
        if (run->stopped) return;
        v = pop_value(run);
    }
    Value kept = v;
    Bool fitted = coerced(run, value->span, v, local->type, &kept);
    if (!fitted) {
        return;
    }
    local->value = copied(run, value->span, kept);
    if (kept == .type_value) {
        // the name is a type name where the local was declared: that one changes, whatever block the write is in
        const types::Symbol *named = types::lookup(&run->r->scopes, local->name);
        if (named != nullptr && named->kind == .type_name) ((types::Symbol *)(Usize)named)->type = kept.type_value.type;
    }
    push_value(run, nothing_value());
}

static void conditional_resume(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind != .conditional) return;
    Value test = pop_value(run);
    if (test != .boolean) {
        unknown(run, e->kind.conditional.condition->span, "this is not a bool known at compile time");
        return;
    }
    push_step(run, expr_step(test.boolean.value ? e->kind.conditional.then_value : e->kind.conditional.else_value, s));
}

// ---------------------------------------------------------------------------------------------------------------
// The loop

// `t[:]` where `t` is a type: one more dimension, as `slice.with_dims` counts them (`T[:]` is `[]T`, `T[:][:]` is
// `[,]T`), so a function over types builds a slice type with a loop (`t = t[:]`).
static void type_slice_resume(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    Value base = pop_value(run);
    if (base != .type_value) {
        unknown(run, e->span, "this slices something that is not a type known at compile time");
        return;
    }
    types::TypeRef t = base.type_value.type;
    U64 dims = 1;
    types::TypeRef element = t;
    if (t->kind == .slice) {
        dims = 2;
        element = types::element_of(t);
    } else if (t->kind == .block) {
        dims = types::count_of(t) + 1;
        element = types::element_of(t);
    }
    push_value(run, type_value(types::with_dims(run->r, element, dims)));
}

static void resume(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    if (e->kind == .binary) {
        binary_resume(run, s);
    } else if (e->kind == .unary) {
        unary_resume(run, s);
    } else if (e->kind == .cast) {
        cast_resume(run, s);
    } else if (e->kind == .conditional) {
        conditional_resume(run, s);
    } else if (e->kind == .call && s.phase == 1) {
        question_resume(run, s);
    } else if (e->kind == .call && s.phase == 2) {
        contract_resume(run, s);
    } else if (e->kind == .call && s.phase == 3) {
        call_enter(run, s);
    } else if (e->kind == .call && s.phase == 5) {
        with_dims_resume(run, s);
    } else if (e->kind == .call && s.phase == 12) {
        construct_resume(run, s);
    } else if (e->kind == .array_lit) {
        array_resume(run, s);
    } else if (e->kind == .member && s.phase == 13) {
        field_resume(run, s);
    } else if (e->kind == .index) {
        index_resume(run, s);
    } else if (e->kind == .slice_of) {
        type_slice_resume(run, s);
    } else if (e->kind == .query && s.phase == 15) {
        count_resume(run, s);
    } else if (e->kind == .call) {
        call_leave(run, s);
    } else if (e->kind == .assign) {
        assign_step(run, s);
    } else if (e->kind == .query) {
        query_step(run, s);
    } else {
        settle_name(run, s); // a name or a member: its constant's initializer is read
    }
}

// Whether `e`, written like a type, names a variable: its path is in `path`.
static Bool names_variable(Run *run, const ast::Expr *e, ast::Path *path) {
    if (!types::names_a_constant(e, path)) return false;
    const types::Symbol *symbol = types::type_through_modules(run->r, *path);
    return symbol != nullptr && symbol->kind == .variable;
}

// Whether the expression makes or reads a value with memory, which step 3 of #3039 brings.
static Bool has_memory(const ast::Expr *e) {
    return e->kind == .array_lit || e->kind == .string || e->kind == .index || e->kind == .slice_of ||
           e->kind == .tuple_lit || (e->kind == .unary && e->kind.unary.op == .address_of);
}

static void enter(Run *run, Step s) {
    const ast::Expr *e = s.expr;
    ast::Path path = {};
    Value held = nothing_value();
    Bool is_local = e->kind == .type_value && types::names_a_constant(e, &path) && countof(path.segments) == 1;
    if (is_local) {
        is_local = local_value(run, path.segments[0].text, &held);
    }
    Bool unwritten = types::name_path(e, &path) && countof(path.segments) == 1 &&
                     same(path.segments[0].text, "undefined") && !local_value(run, "undefined", &held);
    if (e->kind == .integer || e->kind == .character || e->kind == .boolean || e->kind == .floating) {
        literal_step(run, e);
    } else if (unwritten) {
        push_value(run, unset_value()); // `x: [5]i32 = undefined`
    } else if (types::name_path(e, &path) || (e->kind == .type_value && names_variable(run, e, &path))) {
        name_step(run, s, path); // also `N` of `[N]u8`: the parser reads a capitalized name as a type
    } else if (e->kind == .member) {
        member_step(run, s);
    } else if (e->kind == .variant) {
        variant_step(run, s);
    } else if (is_local) {
        push_value(run, held); // a local with a capitalized name, which the parser reads as a type
    } else if (e->kind == .type_value) {
        types::TypeRef t = resolve_quiet(run, e->kind.type_value.type);
        if (is_open(run, t)) {
            unknown(run, e->span, "this type is not known yet");
        } else {
            push_value(run, type_value(t));
        }
    } else if (e->kind == .binary) {
        binary_step(run, s);
    } else if (e->kind == .unary) {
        push_step(run, later(s, 1));
        push_step(run, expr_step(e->kind.unary.operand, s));
    } else if (e->kind == .cast) {
        push_step(run, later(s, 1));
        push_step(run, expr_step(e->kind.cast.operand, s));
    } else if (e->kind == .conditional) {
        push_step(run, later(s, 1));
        push_step(run, expr_step(e->kind.conditional.condition, s));
    } else if (e->kind == .query) {
        query_step(run, s);
    } else if (e->kind == .array_lit) {
        array_step(run, s);
    } else if (e->kind == .string) {
        string_step(run, e);
    } else if (e->kind == .index) {
        index_step(run, s);
    } else if (e->kind == .call) {
        call_step(run, s);
    } else if (e->kind == .assign) {
        assign_step(run, s);
    } else if (e->kind == .stmt_expr) {
        push_step(run, stmt_step(e->kind.stmt_expr.stmt, s));
    } else if (e->kind == .slice_of && e->kind.slice_of.start == nullptr && e->kind.slice_of.end == nullptr) {
        push_step(run, later(s, 1)); // `t[:]` of a type
        push_step(run, expr_step(e->kind.slice_of.base, s));
    } else if (has_memory(e)) {
        unknown(run, e->span,
                "this is a value with memory (an array, a slice, a string, a struct or a pointer), and compile-time "
                "code holds only numbers, bools, enumerators and types");
    } else {
        unknown(run, e->span, "this is not known at compile time");
    }
}

static void take(Run *run, Step s) {
    if (s.stmt != nullptr) {
        statement_step(run, s);
    } else if (s.phase == 0) {
        enter(run, s);
    } else {
        resume(run, s);
    }
}

// The message for a run that passed the step limit.
static Str endless(const Run *run) {
    Str what = "this";
    if (run->frame_count > 0) what = msg(format::push("`", shown_call(run, 0), "`"));
    return msg(format::push(what, " ran ", step_limit(), " steps at compile time without finishing; a loop here does ",
                            "not end, or the work belongs at run time"));
}

// The value of `e` at compile time, in the scopes `r` is in. See the top of the file for what is read.
static Outcome compute(types::Checked *r, const ast::Expr *e, Bool typed_only, Bool lenient) {
    Run run = run_of(r, typed_only, lenient, current);
    if (current == nullptr) heap = (Heap){}; // the heap belongs to the outermost evaluation
    Str outside = r->prefix;
    if (e == nullptr) return (Outcome){.known = false, .value = boolean_value(false), .why = "there is no value here"};
    current = &run;
    push_step(&run, (Step){.expr = e, .stmt = nullptr, .phase = 0, .prefix = outside, .type = nullptr});
    while (run.top > 0 && !run.stopped) {
        if (run.ran == step_limit()) {
            failed(&run, e->span, endless(&run));
            break;
        }
        run.ran += 1;
        run.top -= 1;
        Step s = run.steps[run.top];
        r->prefix = s.prefix;
        take(&run, s);
    }
    current = run.outer;
    r->prefix = outside;
    for (; run.scopes > 0; run.scopes--)
        types::pop_scope(&r->scopes);
    if (run.stopped) return run.out;
    Value v = run.values[0];
    if (v == .nothing)
        return (Outcome){.known = false, .value = boolean_value(false), .at = e->span, .why = "this has no value"};
    return (Outcome){.known = true, .value = v, .failed = false, .at = e->span, .why = ""};
}

export Outcome value(types::Checked *r, const ast::Expr *e) {
    return compute(r, e, false, false);
}

// As `value`, but the type of an operand of `sizeof`, `alignof` or `countof` is only the one the checker recorded: an
// expression it has not typed yet leaves the value unknown. For a caller that types the expression itself afterwards
// (an `if` condition, whose reads the checker's notes follow in order), and asks again.
export Outcome typed(types::Checked *r, const ast::Expr *e) {
    return compute(r, e, true, false);
}

// As `typed`, where nothing requires the value (the condition of an `if`): an error inside a call the expression
// makes (a failed contract, a loop that does not end) leaves the value unknown, and the program makes the call when it
// runs.
export Outcome tried(types::Checked *r, const ast::Expr *e) {
    return compute(r, e, true, true);
}

// The type `e` is when it is one known at compile time (`typeof(xs[0])`, `u32`, `Pair(i32)`); null for a value,
// one that only reads like a type (`Pair(n, n)`) included.
export types::TypeRef type_held(types::Checked *r, const ast::Expr *e) {
    Outcome found = value(r, e);
    Value v = found.value;
    if (!found.known || v != .type_value) return nullptr;
    return v.type_value.type;
}

// `types::Options.applied`: the type an applied type is when its name is a function (`Pair(i32)`, `widen(T)`): the
// function is run with the arguments. Null when the name is no function.
export types::TypeRef applied_for(types::Checked *r, const ast::TypeExpr *applied) {
    if (applied->kind != .applied) return nullptr;
    ast::Path path = applied->kind.applied.name;
    ast::TypeArg given[:] = applied->kind.applied.args;
    const types::Symbol *symbol = types::type_through_modules(r, path);
    if (symbol == nullptr || symbol->kind != .function_symbol) return nullptr;
    ast::ExprRef *block =
        (ast::ExprRef *)mem::alloc_array_raw(sizeof(ast::ExprRef), countof(given), alignof(ast::ExprRef));
    ast::ExprRef args[:] = block[0:countof(given)];
    for (Usize i = 0; i < countof(given); i++) {
        ast::TypeArg one = given[i];
        if (one == .value) {
            args[i] = one.value.value;
        } else if (one == .type) {
            args[i] = ast::expr({.type_value = {.type = one.type.type}});
            args[i]->span = applied->span;
        }
    }
    ast::Expr *callee = ast::expr({.name = {.path = path}});
    callee->span = applied->span;
    ast::Expr *made = ast::call(callee, args);
    made->span = applied->span;
    Outcome found = compute(r, made, false, false);
    Value v = found.value;
    if (found.known && v == .type_value) return v.type_value.type;
    if (found.failed) {
        types::fail(r, found.at, found.why);
    } else if (found.known) {
        types::fail(r, applied->span,
                    msg(format::push("`", short_name(symbol->name), "(...)` is ", show(v), ", not a type")));
    } else {
        types::fail(r, found.at, msg(format::push("this type is not known at compile time: ", found.why)));
    }
    return r->table.invalid;
}

// Whether the function `d` returns a type (`-> type`): a type function, which runs at compile time only.
export Bool returns_type(const ast::Decl *d) {
    if (d == nullptr || d->kind != .function) return false;
    return written_as(d->kind.function.result, "type");
}

// Whether `e` is a call of a type function.
static Bool makes_type(Run *run, const ast::Expr *e) {
    if (e->kind != .call) return false;
    return returns_type(function_of(called(run, e->kind.call.callee)));
}

// `types::Options.held`: the type the call `e` is when it calls a type function (`Pair(i32)`); null when `e` is no
// such call. A call that gives no type is reported, and the invalid type given.
export types::TypeRef held_for(types::Checked *r, const ast::Expr *e) {
    Run look = run_of(r, false, false, nullptr);
    if (!makes_type(&look, e)) return nullptr;
    Outcome found = compute(r, e, false, false);
    Value v = found.value;
    if (found.known && v == .type_value) return v.type_value.type;
    if (found.failed) {
        types::fail(r, found.at, found.why);
    } else {
        types::fail(r, found.at, msg(format::push("this type is not known at compile time: ", found.why)));
    }
    return r->table.invalid;
}

// ---------------------------------------------------------------------------------------------------------------
// What the callers ask

// Whether `e` is known at compile time.
export Bool is_known(types::Checked *r, const ast::Expr *e) {
    return value(r, e).known;
}

// The value of `e` when it is an integer that is not negative: an array length, a count.
export Bool length(types::Checked *r, const ast::Expr *e, U64 *out) {
    Outcome found = value(r, e);
    if (!found.known || found.value != .integer || found.value.integer.negative) return false;
    *out = found.value.integer.magnitude;
    return true;
}

// The value of `e` when it is an integer, a character, a boolean or an enumerator, as the 64 bits a `match` compares
// (a negative number in two's complement).
// A struct or array a computation left in the heap, for the emitter to write into the program (#3039): how many cells
// it has (0 when `v` is not one), and cell `i` as a number (`is_float` false: `bits`), a float (`is_float`: `real`) or
// neither (false; a nested struct, a string and a pointer are not baked yet).
export Usize baked_cells(Value v) {
    if (v == .aggregate) return cells_in(v.aggregate.object);
    return 0;
}

export Bool baked_cell(Value v, Usize i, Bool *is_float, U64 *bits_out, F64 *real) {
    if (v == .aggregate) {
        Value cell = cell_get(v.aggregate.object, i);
        *is_float = false;
        if (cell == .integer) {
            *bits_out = cell.integer.negative ? 0 - cell.integer.magnitude : cell.integer.magnitude;
            return true;
        }
        if (cell == .boolean) {
            *bits_out = cell.boolean.value ? 1 : 0;
            return true;
        }
        if (cell == .floating) {
            *is_float = true;
            *real = cell.floating.value;
            return true;
        }
    }
    return false;
}

export Bool bits(types::Checked *r, const ast::Expr *e, U64 *out) {
    Outcome found = value(r, e);
    if (!found.known) return false;
    Value v = found.value;
    if (v == .integer) {
        *out = v.integer.negative ? 0 - v.integer.magnitude : v.integer.magnitude;
    } else if (v == .boolean) {
        *out = v.boolean.value ? 1 : 0;
    } else if (v == .enumerator) {
        *out = types::slots_of(v.enumerator.type).items[v.enumerator.index].value;
    } else {
        return false;
    }
    return true;
}

// The value of `e` when it is a boolean: the condition of a `static_assert` or of a compile-time `if`.
export Bool condition(types::Checked *r, const ast::Expr *e, Bool *out) {
    Outcome found = value(r, e);
    if (!found.known || found.value != .boolean) return false;
    *out = found.value.boolean.value;
    return true;
}

// ---------------------------------------------------------------------------------------------------------------
// Reporting

// Where to report `found` for the expression `e` that needed a value: the part of `e` that stopped it, or `e` itself
// when the reason is somewhere else (the initializer of a constant it names).
static ast::Span place(Outcome found, const ast::Expr *e) {
    if (found.at.start >= e->span.start && found.at.end <= e->span.end) return found.at;
    return e->span;
}

// Reports why `e` is not a value `what` can use ("an array length"): the error of the evaluation, or what is not
// known at compile time.
export void report(types::Checked *r, Outcome found, const ast::Expr *e, Str what) {
    if (found.failed) {
        types::failf(r, place(found, e), found.why);
    } else if (!found.known) {
        types::failf(r, place(found, e), what, " must be known at compile time: ", found.why);
    } else {
        types::failf(r, e->span, what, " cannot be `", show(found.value), "`");
    }
}

// `types::Options.length`: the value of `e` as an array length or a count. With a `what`, a value that is not one is
// reported.
export Bool length_for(types::Checked *r, const ast::Expr *e, Str what, U64 *out) {
    Outcome found = value(r, e);
    if (found.known && found.value == .integer && !found.value.integer.negative) {
        *out = found.value.integer.magnitude;
        return true;
    }
    if (countof(what) > 0) report(r, found, e, what);
    return false;
}

// `types::Options.constant`: the type of a constant written without one, from the value computed for its
// initializer. An integer no operand gave a type is an `i32`, or an `i64` when it does not fit; a float is an `f64`.
// Null when no value is computed, or it is a type or a fact, which are not stored.
export types::TypeRef type_for(types::Checked *r, const ast::Expr *init) {
    Outcome found = value(r, init);
    if (!found.known) return nullptr;
    Value v = found.value;
    if (v == .boolean) return r->table.bool_type;
    if (v == .enumerator) return v.enumerator.type;
    if (v == .aggregate) return v.aggregate.type;
    if (v == .slice) return v.slice.type;
    if (v == .floating) {
        if (v.floating.type != nullptr) return v.floating.type;
        return types::builtin(&r->table, "F64");
    }
    if (v != .integer) return nullptr;
    if (v.integer.type != nullptr) return v.integer.type;
    types::TypeRef narrow = types::builtin(&r->table, "I32");
    if (fits(narrow, whole(v.integer.magnitude, v.integer.negative))) return narrow;
    return types::builtin(&r->table, "I64");
}
