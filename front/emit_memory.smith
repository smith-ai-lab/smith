// front::emit_memory: pointers, arrays, records and globals for the emitter (B3b, #1133 of #1112). The protocol is at
// the top of front/emit.smith; this file only adds handlers.
//
// WHAT IT EMITS: the types `T *`, `T[N]` (N an integer literal) and a record of the module (`Decl.record`, an LLVM
// named struct `<module path>::<name>`, declared before use; a union and a bit-field are errors); `&`, `*`, `a[i]`
// (an array's index is checked against its count, a constant index in range is not; a pointer's is not checked),
// `.` (through one pointer too, as `->`) and `->`, `null`, compound literals with designators (unnamed fields are
// zero), casts between integer types, between pointers and between a pointer and an integer as wide as one, `sizeof`,
// `alignof` and `countof` (sizes from the target data, never from the host), assignment through all of them (B1's
// `assign` pushes a place; the `place_*` handlers answer it) and globals with a constant initializer. Pointer
// arithmetic, comparison of pointers, unions and function pointers are later tickets.
//
// HOW. Every lvalue is a PLACE: a Value whose `llvm` is the address and whose `ty` is the type stored there. A read
// of `*p`, `a[i]` or `s.f` is the place plus a load. The base of `a[i]` and `s.f` is pushed as a place when it is a
// name, a member, an index or a dereference (`state::push_place`), else it is evaluated and spilled to a temporary;
// whether it is an array or a pointer shows only on the Value (`ty.kind`), so no type is computed before the code.
// `sizeof(expr)` has no code to emit: `static_type` walks the chain of members, indexes and dereferences with a loop.
// A pointer or array `Ty` keeps its element in `Ty.element`, a block of the allocator in force.
//
// SLICES AND `str` (#1623): `{ ptr data, usize count }`; a string literal is a private constant with a zero byte after
// the count; `s[i]` and `xs[a:b]` are checked against the count in every build (the index report); `countof(s)` is the
// count. A slice of a pointer is `not emitted yet`.
//
// BLOCKS (#1710): `[,]T` and `[,,]T` are `{ ptr data, [N x usize] counts }`; `xs[i]` checks `i` against the first count
// and gives a row, a block of one dimension fewer (a slice for the last two) over the same elements; `countof(xs)` is
// the first count; a fixed array of arrays converts to a block by aliasing it. `[5,3]T` is nested arrays and `[,3]T` a
// slice.
//
// ARRAY LITERALS (#1624): `[a, b, c]` is an array value (items converted to the element type, inserted into a zero
// array); where a slice is expected the array is stored in a fresh entry-block slot and the Value is `{ slot, M }`.
// The hidden array lives as long as the function: a literal evaluated again (in a loop) overwrites the same slot, so a
// slice kept from an earlier turn sees the later contents. `[]` is `{ null, 0 }` or `[0]T`, and an Error with no type.
//
// A NAME THAT IS A GLOBAL is found by `&name`, by the bases of `name[i]`, `name.f` (through `push_place_of`) and, from
// emit.smith's dispatch, by its bare name (`is_global_name`, `name_ref`, `place_name`): a name that is not a local is
// tried here before it is reported unknown.
module front::emit_memory;

import front::ast;
import front::emit_arith as arith;
import front::emit_match as matching;
import front::emit_state as state;
import front::types;
import std::arena;
import std::format;
import std::mem;
import <llvm-c/Core.h>;
import <llvm-c/Target.h>;

// ---------------------------------------------------------------------------------------------------------------
// Small helpers

static state::TyResult ty_failf(ast::Span span, Str first, Str second) {
    state::Error error = {.message = state::msg(format::push(first, second)), .span = span};
    return {.error = error};
}

static state::Ty u64_type(state::Emitter *e) {
    state::Ty ty = {};
    state::scalar_type(e, "U64", &ty);
    return ty;
}

static state::Ty *own(state::Emitter *e, state::Ty element) {
    state::OwnedTy *block = mem::alloc(state::OwnedTy);
    block->ty = element;
    block->next = e->owned;
    e->owned = block;
    return &block->ty;
}

static state::Ty pointer_to(state::Emitter *e, state::Ty element, U32 space) {
    state::Ty *inner = own(e, element);
    state::Ty ty = {.kind = .pointer,
                    .llvm = state::pointer_type(e, space),
                    .name = "pointer",
                    .element = inner,
                    .address_space = space};
    return ty;
}

static state::Ty array_of(state::Emitter *e, state::Ty element, U64 count) {
    state::Ty *inner = own(e, element);
    state::Ty ty = {.kind = .array, .llvm = c::LLVMArrayType2(element.llvm, count), .name = "array", .element = inner};
    ty.count = count;
    return ty;
}

// `front::test` and `Point` as `front::test::Point`: the module's path and the name joined by `::`, in the allocator
// in force.
static Str qualified(const ast::Module *m, Str name) {
    Str symbol = state::msg(format::push(name));
    for (Usize i = countof(m->name.segments); i > 0; i--) {
        Str longer = state::msg(format::push(m->name.segments[i - 1].text, "::", symbol));
        state::free_text(symbol);
        symbol = longer;
    }
    return symbol;
}

static Bool find_record_named(state::Emitter *e, Str name, Usize *found) {
    for (Usize i = 0; i < e->record_count; i++) {
        if (state::same_text(e->records[i].name, name)) {
            *found = i;
            return true;
        }
    }
    return false;
}

static Usize field_count(state::Emitter *e, Usize at) {
    state::FieldInfo fields[:] = e->records[at].fields;
    return countof(fields);
}

// The record whose LLVM type is `ty.llvm`.
static Bool find_record_of(state::Emitter *e, state::Ty ty, Usize *found) {
    for (Usize i = 0; i < e->record_count; i++) {
        if (e->records[i].ty.llvm == ty.llvm) {
            *found = i;
            return true;
        }
    }
    return false;
}

// ---------------------------------------------------------------------------------------------------------------
// Types

// The integer type an index is widened to: the target's pointer width, else 64 bits.
static c::LLVMTypeRef index_word(state::Emitter *e) {
    if (e->target_data != nullptr) return c::LLVMIntPtrTypeInContext(e->context, e->target_data);
    return c::LLVMInt64TypeInContext(e->context);
}

// A slice of `element`: the literal struct `{ ptr data, usize count }` (today's `T[:]` and `Str` have this layout).
export state::Ty slice_type(state::Emitter *e, state::Ty element, Str name) {
    c::LLVMTypeRef parts[2] = {state::pointer_type(e, 0), index_word(e)};
    state::Ty *inner = own(e, element);
    state::Ty ty = {
        .kind = .slice, .llvm = c::LLVMStructTypeInContext(e->context, parts, 2, 0), .name = name, .element = inner};
    return ty;
}

// A block of `dimensions` run-time sizes of `cell`: the literal struct `{ ptr data, [dimensions x usize] counts }`.
export state::Ty block_type(state::Emitter *e, state::Ty cell, U64 dimensions) {
    c::LLVMTypeRef counts = c::LLVMArrayType2(index_word(e), dimensions);
    c::LLVMTypeRef parts[2] = {state::pointer_type(e, 0), counts};
    state::Ty *inner = own(e, cell);
    state::Ty ty = {.kind = .block,
                    .llvm = c::LLVMStructTypeInContext(e->context, parts, 2, 0),
                    .name = "block",
                    .element = inner,
                    .count = dimensions};
    return ty;
}

export state::TyResult type_block(state::Emitter *e, const ast::TypeExpr *t);

export void add_record(state::Emitter *e, state::RecordType record) {
    if (e->record_count == countof(e->records)) {
        Usize capacity = countof(e->records) * 2;
        if (capacity < 8) capacity = 8;
        e->records = mem::realloc(e->records, capacity);
    }
    e->records[e->record_count] = record;
    e->record_count += 1;
}

// Does a field of type `ty` hold the record `self` by value (directly or in an array)?
static Bool holds(state::Ty ty, c::LLVMTypeRef self) {
    state::Ty inner = ty;
    while (inner.kind == .array)
        inner = *inner.element;
    return inner.kind == .record && inner.llvm == self;
}

// The fields of a record, resolved in order; the record itself is already in the table so a field can point to it.
static state::Status record_fields(state::Emitter *e, const ast::Decl *d, Usize at, state::FieldInfo infos[:],
                                   c::LLVMTypeRef *types) {
    if (d->kind != .record) {
        return state::fail("not a record", d->span);
    }
    ast::FieldDecl fields[:] = d->kind.record.fields;
    for (Usize i = 0; i < countof(fields); i++) {
        ast::FieldDecl field = fields[i];
        if (field.bit_width != nullptr) return state::not_emitted("bit-field", field.span);
        for (Usize j = 0; j < i; j++) {
            if (state::same_text(infos[j].name, field.name))
                return state::failf(field.span, field.name, " is declared twice");
        }
        // Through the emitter's hook, not `resolve`: a field of an imported record may itself name a type, and a call
        // back into `leaf_type` would be a recursion in the module.
        state::TyResult made = state::type_of(e, field.type);
        if (made == .error) {
            return {.error = made.error};
        }
        if (holds(made.ok, e->records[at].ty.llvm)) {
            return state::failf(field.span, e->records[at].name, " contains itself; use a pointer");
        }
        infos[i] = (state::FieldInfo){.name = field.name, .ty = made.ok, .default_value = field.default_value};
        types[i] = made.ok.llvm;
    }
    return state::success();
}

// The record `d` under `name` in the table and `label` as its IR name.
static state::Status declare_record(state::Emitter *e, const ast::Decl *d, Str name, Str label) {
    if (d->kind != .record) {
        return state::fail("not a record", d->span);
    }
    Bool opaque = d->kind.record.opaque;
    Usize count = countof(d->kind.record.fields);
    if (d->kind.record.is_union) return state::not_emitted("union", d->span);
    Usize at = 0;
    if (find_record_named(e, name, &at)) return state::failf(d->span, name, " is declared twice");
    const char *text = label.data;
    c::LLVMTypeRef named = c::LLVMStructCreateNamed(e->context, text);
    state::Ty ty = {.kind = .record, .llvm = named, .name = name};
    at = e->record_count;
    add_record(e, (state::RecordType){.name = name, .ty = ty});
    if (opaque) {
        return state::success();
    }
    if (count > 64) {
        return state::not_emitted("record with more than 64 fields", d->span);
    }
    state::FieldInfo infos[:] = mem::alloc_slice(state::FieldInfo, count + 1);
    c::LLVMTypeRef types[64];
    state::Status status = record_fields(e, d, at, infos, types);
    if (status == .error) {
        mem::free(infos.data);
        return status;
    }
    c::LLVMStructSetBody(named, types, (U32)count, 0);
    e->records[at].fields = infos[0:count];
    return state::success();
}

// The record `decl` of an imported module (`v.Vec`), under the name the checker declared it by (`geom::vec::Vec`,
// which names the type in the IR too), declared when the first use needs it. Its fields are read in this module's
// scope, so a field that names another record of that module is not emitted yet.
export state::TyResult imported_record(state::Emitter *e, const ast::Decl *decl, Str name) {
    Usize index = 0;
    if (!find_record_named(e, name, &index)) {
        state::Status made = declare_record(e, decl, name, name);
        if (made == .error) return {.error = made.error};
        find_record_named(e, name, &index);
    }
    state::Ty ty = e->records[index].ty;
    return ty;
}

// The type at the bottom of a chain of pointers and arrays: a scalar, an enumeration, a record, `str` or a slice.
static state::TyResult leaf_type(state::Emitter *e, const ast::TypeExpr *base) {
    if (base->kind == .slice) {
        const ast::TypeExpr *element = base->kind.slice.element;
        state::TyResult inner = state::type_of(e, element);
        if (inner == .error) return inner;
        state::Ty made = slice_type(e, inner.ok, "slice");
        return made;
    }
    if (base->kind == .block_type) return type_block(e, base);
    if (base->kind == .tuple)
        return state::type_of(e, base); // `*mut (f64, f32)`: front::emit's type_of builds the tuple
    if (base->kind != .named) return ty_failf(base->span, "not emitted yet: this kind of type", "");
    ast::Path path = base->kind.named.path;
    if (countof(path.segments) == 2) return state::type_of(e, base); // `v.Vec`: front::emit's type_of reads the import
    if (countof(path.segments) != 1) return ty_failf(base->span, "not emitted yet: qualified type", "");
    Str name = path.segments[0].text;
    state::Ty ty = {};
    Usize index = 0;
    if (state::same_text(name, "str") || state::same_text(name, "Str")) {
        state::Ty character = {};
        state::scalar_type(e, "char", &character);
        state::Ty made = slice_type(e, character, "str");
        return made;
    }
    if (state::scalar_type(e, name, &ty) || matching::type_enum(e, name, &ty)) return ty;
    if (find_record_named(e, name, &index)) {
        ty = e->records[index].ty;
        return ty;
    }
    return ty_failf(base->span, "unknown type ", name);
}

// The length an array type writes: an integer literal, or constants the checker folded (`[k.SIDE * 2]u8`).
static Bool array_count(const state::Emitter *e, const ast::Expr *count, U64 *out) {
    if (count == nullptr) return false;
    if (count->kind == .integer) {
        *out = count->kind.integer.value;
        return true;
    }
    return e->options.checked != nullptr && types::length_of(e->options.checked, count, out);
}

// `[5,3]T` (nested arrays), `[,3]T` (a slice of `[3]T`), `[,]T` and `[,,]T` (a block): the checker's `build_block`.
export state::TyResult type_block(state::Emitter *e, const ast::TypeExpr *t) {
    if (t->kind != .block_type) {
        return ty_failf(t->span, "not a block type", "");
    }
    ast::ExprRef dims[:] = t->kind.block_type.dims;
    state::TyResult found = state::type_of(e, t->kind.block_type.element);
    if (found == .error) return found;
    Usize empty = 0;
    while (empty < countof(dims) && dims[empty] == nullptr)
        empty += 1;
    state::Ty cell = found.ok;
    for (Usize i = countof(dims); i > empty; i--) {
        const ast::Expr *size = dims[i - 1];
        U64 length = 0;
        if (!array_count(e, size, &length)) return ty_failf(t->span, "an array length is an integer literal", "");
        cell = array_of(e, cell, length);
    }
    if (empty == 0) {
        state::Ty whole = cell;
        return whole;
    }
    state::Ty made = {};
    if (empty == 1) {
        made = slice_type(e, cell, "slice");
    } else if (empty > 8) {
        return ty_failf(t->span, "a block has at most 8 dimensions", "");
    } else {
        made = block_type(e, cell, empty);
    }
    return made;
}

// The type `t` says. A chain of pointers and arrays is walked with a loop, then built from the inside.
static state::TyResult resolve(state::Emitter *e, const ast::TypeExpr *t) {
    const ast::TypeExpr *chain[16];
    Usize depth = 0;
    const ast::TypeExpr *base = t;
    while (base->kind == .pointer || base->kind == .array) {
        if (depth == countof(chain)) return ty_failf(t->span, "a type nested more than 16 deep", "");
        chain[depth] = base;
        depth += 1;
        if (base->kind == .pointer) {
            const ast::TypeExpr *pointee = base->kind.pointer.pointee;
            base = pointee;
        } else if (base->kind == .array) {
            const ast::TypeExpr *element = base->kind.array.element;
            base = element;
        }
    }
    state::TyResult found = leaf_type(e, base);
    if (found == .error) return found;
    state::Ty ty = found.ok;
    for (Usize i = depth; i > 0; i--) {
        const ast::TypeExpr *node = chain[i - 1];
        if (node->kind == .pointer) ty = pointer_to(e, ty, 0);
        if (node->kind == .array) {
            const ast::Expr *count = node->kind.array.count;
            U64 length = 0;
            if (!array_count(e, count, &length))
                return ty_failf(node->span, "an array length is an integer literal", "");
            ty = array_of(e, ty, length);
        }
    }
    return ty;
}

export state::TyResult type_pointer(state::Emitter *e, const ast::TypeExpr *t) {
    return resolve(e, t);
}

export state::TyResult type_array(state::Emitter *e, const ast::TypeExpr *t) {
    return resolve(e, t);
}

// A `named` type that is not a scalar: a record declared in the module.
// `[]T` and `str`.
export state::TyResult type_slice(state::Emitter *e, const ast::TypeExpr *t) {
    return resolve(e, t);
}

export state::TyResult type_record(state::Emitter *e, const ast::TypeExpr *t) {
    return resolve(e, t);
}

// ---------------------------------------------------------------------------------------------------------------
// Globals found by name (B1 keeps no table of them: the module's declarations are the table)

static const ast::Decl *find_global(state::Emitter *e, Str name) {
    for (Usize i = 0; i < countof(e->tree->decls); i++) {
        const ast::Decl *d = e->tree->decls[i];
        if (d->kind == .variable && state::same_text(d->kind.variable.name, name)) return d;
    }
    return nullptr;
}

// The type of a global: the written one, or for an untyped `const LIMIT = 10;` the type of its literal (i32, or bool).
static state::TyResult global_type(state::Emitter *e, const ast::Decl *d) {
    if (d->kind != .variable) return state::ty_fail("not a variable", d->span);
    const ast::TypeExpr *type = d->kind.variable.type;
    if (type->kind != .auto_type) return resolve(e, type);
    const ast::Expr *init = d->kind.variable.init;
    state::Ty ty = {};
    Str spelling = "i32";
    if (init != nullptr && init->kind == .boolean) spelling = "bool";
    if (!d->kind.variable.is_constexpr || init == nullptr || !state::scalar_type(e, spelling, &ty))
        return state::ty_fail("a global needs a written type", d->span);
    return {.ok = ty};
}

// The global `name` as a place.
static state::Status global_place_of(state::Emitter *e, Str name, ast::Span span, state::Value *place) {
    const ast::Decl *d = find_global(e, name);
    if (d == nullptr || d->kind != .variable) return state::failf(span, "unknown name ", name);
    state::TyResult made = global_type(e, d);
    if (made == .error) {
        return {.error = made.error};
    }
    Str own = state::c_name_of(d);
    Str symbol = countof(own) > 0 ? state::msg(format::push(own)) : qualified(e->tree, name);
    const char *label = symbol.data; // the text of `qualified` ends with a terminator
    c::LLVMValueRef global = c::LLVMGetNamedGlobal(e->module, label);
    state::free_text(symbol);
    if (global == nullptr) return state::failf(span, "the global ", name, " is not declared yet");
    *place = (state::Value){.llvm = global, .ty = made.ok};
    return state::success();
}

static state::Status global_place(state::Emitter *e, const state::Work *w) {
    if (w->expr->kind != .name) {
        return state::fail("not a name", w->span);
    }
    ast::Path path = w->expr->kind.name.path;
    state::Value place = {};
    try global_place_of(e, path.segments[0].text, w->span, &place);
    state::push_value(e, place);
    return state::success();
}

// Whether `x` is a bare name that is no local but a global of the module.
export Bool is_global_name(state::Emitter *e, const ast::Expr *x) {
    if (x->kind != .name) return false;
    ast::Path path = x->kind.name.path;
    state::Local local = {};
    return countof(path.segments) == 1 && !state::find_local(e, path.segments[0].text, &local) &&
           find_global(e, path.segments[0].text) != nullptr;
}

static state::Status global_read(state::Emitter *e, const state::Work *w) {
    try global_place(e, w);
    state::Value place = state::pop_value(e);
    c::LLVMValueRef loaded = c::LLVMBuildLoad2(e->builder, place.ty.llvm, place.llvm, "");
    state::push_value(e, (state::Value){.llvm = loaded, .ty = place.ty});
    return state::success();
}

// A global read by its bare name: the place plus a load.
export state::Status name_ref(state::Emitter *e, const ast::Expr *x) {
    state::Work w = {.expr = x, .span = x->span};
    return global_read(e, &w);
}

// A global as a place by its bare name.
export state::Status place_name(state::Emitter *e, const ast::Expr *x) {
    state::Work w = {.expr = x, .span = x->span};
    return global_place(e, &w);
}

// Push the place of `x`: a local's by B1, a global's here.
static void push_place_of(state::Emitter *e, const ast::Expr *x) {
    if (x->kind == .name) {
        ast::Path path = x->kind.name.path;
        state::Local local = {};
        if (countof(path.segments) == 1 && !state::find_local(e, path.segments[0].text, &local) &&
            find_global(e, path.segments[0].text) != nullptr) {
            state::push_then(e, (state::Work){.then = global_place, .expr = x, .span = x->span});
            return;
        }
    }
    state::push_place(e, x);
}

// ---------------------------------------------------------------------------------------------------------------
// Places and loads

static state::Status load_finish(state::Emitter *e, const state::Work *w) {
    state::Value place = state::pop_value(e);
    if (place.ty.kind == .array)
        return state::fail("an array is not a value yet; index it or take its address", w->span);
    c::LLVMValueRef loaded = c::LLVMBuildLoad2(e->builder, place.ty.llvm, place.llvm, "");
    state::push_value(e, (state::Value){.llvm = loaded, .ty = place.ty});
    return state::success();
}

// An rvalue that is the base of `.` or `[`: stored in a temporary so that it has an address.
static state::Status spill_finish(state::Emitter *e, const state::Work *_) {
    state::Value value = state::pop_value(e);
    c::LLVMValueRef slot = state::new_alloca(e, value.ty, "temporary");
    c::LLVMBuildStore(e->builder, value.llvm, slot);
    state::push_value(e, (state::Value){.llvm = slot, .ty = value.ty});
    return state::success();
}

static Bool is_lvalue(const ast::Expr *x) {
    if (x->kind == .name || x->kind == .member || x->kind == .index) return true;
    return x->kind == .unary && x->kind.unary.op == .dereference;
}

// Leave a Value (address, type stored) of `base`: its place, or a temporary holding its value.
static void push_address(state::Emitter *e, const ast::Expr *base) {
    if (is_lvalue(base)) {
        push_place_of(e, base);
        return;
    }
    state::push_then(e, (state::Work){.then = spill_finish, .span = base->span});
    state::push_eval(e, base, state::no_hint());
}

// ---------------------------------------------------------------------------------------------------------------
// Address, dereference, index, member

static state::Status address_finish(state::Emitter *e, const state::Work *_) {
    state::Value place = state::pop_value(e);
    state::push_value(e, (state::Value){.llvm = place.llvm, .ty = pointer_to(e, place.ty, 0)});
    return state::success();
}

export state::Status address_of(state::Emitter *e, const ast::Expr *x, state::Hint _) {
    if (x->kind != .unary) {
        return state::fail("not a unary expression", x->span);
    }
    const ast::Expr *operand = x->kind.unary.operand;
    state::push_then(e, (state::Work){.then = address_finish, .span = x->span});
    push_place_of(e, operand);
    return state::success();
}

static state::Status dereference_finish(state::Emitter *e, const state::Work *w) {
    state::Value pointer = state::pop_value(e);
    if (pointer.ty.kind != .pointer) return state::failf(w->span, "dereferencing ", pointer.ty.name);
    if (pointer.ty.element == nullptr) return state::fail("dereferencing a pointer to an unknown type", w->span);
    state::push_value(e, (state::Value){.llvm = pointer.llvm, .ty = *pointer.ty.element});
    return state::success();
}

export state::Status place_dereference(state::Emitter *e, const ast::Expr *x) {
    if (x->kind != .unary) {
        return state::fail("not a unary expression", x->span);
    }
    const ast::Expr *operand = x->kind.unary.operand;
    state::push_then(e, (state::Work){.then = dereference_finish, .span = x->span});
    state::push_eval(e, operand, state::no_hint());
    return state::success();
}

export state::Status dereference(state::Emitter *e, const ast::Expr *x, state::Hint _) {
    state::push_then(e, (state::Work){.then = load_finish, .span = x->span});
    return place_dereference(e, x);
}

// Is the index a constant inside `count`?
static Bool in_range_constant(state::Value at, U64 count) {
    if (c::LLVMIsAConstantInt(at.llvm) == nullptr) return false;
    if (at.ty.is_signed) {
        I64 value = c::LLVMConstIntGetSExtValue(at.llvm);
        return value >= 0 && (U64)value < count;
    }
    return c::LLVMConstIntGetZExtValue(at.llvm) < count;
}

// An index is checked against the count (a failed check calls `contract::fail_index`); a constant inside it is not.
static void check_index(state::Emitter *e, state::Value base, state::Value at, c::LLVMValueRef position) {
    c::LLVMTypeRef word = index_word(e);
    if (in_range_constant(at, base.ty.count)) return;
    c::LLVMValueRef count = c::LLVMConstInt(word, base.ty.count, 0);
    c::LLVMValueRef bad = c::LLVMBuildICmp(e->builder, c::LLVMIntUGE, position, count, "outside");
    c::LLVMTypeRef wide = c::LLVMInt64TypeInContext(e->context);
    c::LLVMValueRef args[3] = {c::LLVMBuildIntCast2(e->builder, at.llvm, wide, at.ty.is_signed, ""),
                               c::LLVMConstInt(c::LLVMInt32TypeInContext(e->context), at.ty.is_signed, 0),
                               c::LLVMConstInt(wide, base.ty.count, 0)};
    arith::report_if(e, bad, "smith_contract_fail_index", args, 3);
}

// An array's element, or a vector's lane.
static void array_element(state::Emitter *e, state::Value base, state::Value at, c::LLVMValueRef position) {
    check_index(e, base, at, position);
    c::LLVMTypeRef word = index_word(e);
    c::LLVMValueRef indices[2] = {c::LLVMConstInt(word, 0, 0), position};
    c::LLVMValueRef address = c::LLVMBuildInBoundsGEP2(e->builder, base.ty.llvm, base.llvm, indices, 2, "element");
    state::push_value(e, (state::Value){.llvm = address, .ty = *base.ty.element});
}

// The data and the count of the slice stored at `address`.
static void slice_parts(state::Emitter *e, state::Value place, c::LLVMValueRef *data, c::LLVMValueRef *count) {
    c::LLVMValueRef whole = c::LLVMBuildLoad2(e->builder, place.ty.llvm, place.llvm, "slice");
    *data = c::LLVMBuildExtractValue(e->builder, whole, 0, "data");
    *count = c::LLVMBuildExtractValue(e->builder, whole, 1, "count");
}

// The slice `{ data, count }` of type `ty`.
static state::Value make_slice(state::Emitter *e, state::Ty ty, c::LLVMValueRef data, c::LLVMValueRef count) {
    c::LLVMValueRef empty = c::LLVMGetUndef(ty.llvm);
    c::LLVMValueRef with_data = c::LLVMBuildInsertValue(e->builder, empty, data, 0, "");
    c::LLVMValueRef whole = c::LLVMBuildInsertValue(e->builder, with_data, count, 1, "slice");
    return (state::Value){.llvm = whole, .ty = ty};
}

// The index report of a failed check: the index, whether it is signed, and the count.
static void report_index(state::Emitter *e, c::LLVMValueRef bad, c::LLVMValueRef at, Bool is_signed,
                         c::LLVMValueRef count) {
    c::LLVMTypeRef wide = c::LLVMInt64TypeInContext(e->context);
    c::LLVMValueRef args[3] = {c::LLVMBuildIntCast2(e->builder, at, wide, is_signed, ""),
                               c::LLVMConstInt(c::LLVMInt32TypeInContext(e->context), is_signed, 0),
                               c::LLVMBuildIntCast2(e->builder, count, wide, 0, "")};
    arith::report_if(e, bad, "smith_contract_fail_index", args, 3);
}

// A slice's element: the index is checked against the count in every build.
static void slice_element(state::Emitter *e, state::Value base, state::Value at, c::LLVMValueRef position) {
    c::LLVMValueRef data = nullptr;
    c::LLVMValueRef count = nullptr;
    slice_parts(e, base, &data, &count);
    c::LLVMValueRef bad = c::LLVMBuildICmp(e->builder, c::LLVMIntUGE, position, count, "outside");
    report_index(e, bad, at.llvm, at.ty.is_signed, count);
    c::LLVMValueRef address =
        c::LLVMBuildInBoundsGEP2(e->builder, base.ty.element->llvm, data, &position, 1, "element");
    state::push_value(e, (state::Value){.llvm = address, .ty = *base.ty.element});
}

// The counts of a block: its sizes as words, one per dimension.
static void block_counts(state::Emitter *e, c::LLVMValueRef whole, U64 dimensions, c::LLVMValueRef counts[8]) {
    c::LLVMValueRef all = c::LLVMBuildExtractValue(e->builder, whole, 1, "counts");
    for (U64 i = 0; i < dimensions; i++)
        counts[i] = c::LLVMBuildExtractValue(e->builder, all, (U32)i, "count");
}

// The block `{ data, counts }` of type `ty`; `counts` has one word per dimension.
static state::Value make_block(state::Emitter *e, state::Ty ty, c::LLVMValueRef data, c::LLVMValueRef counts[8]) {
    c::LLVMTypeRef words = c::LLVMArrayType2(index_word(e), ty.count);
    c::LLVMValueRef all = c::LLVMGetUndef(words);
    for (U64 i = 0; i < ty.count; i++)
        all = c::LLVMBuildInsertValue(e->builder, all, counts[i], (U32)i, "");
    c::LLVMValueRef with_data = c::LLVMBuildInsertValue(e->builder, c::LLVMGetUndef(ty.llvm), data, 0, "");
    c::LLVMValueRef whole = c::LLVMBuildInsertValue(e->builder, with_data, all, 1, "block");
    return (state::Value){.llvm = whole, .ty = ty};
}

// A block's row `xs[i]`, checked against the first count: a block of one dimension fewer (a slice for the last two)
// that shares the elements. The row is a value; it is spilled to a slot so that the next index finds a place.
static void block_row(state::Emitter *e, state::Value base, state::Value at, c::LLVMValueRef position) {
    c::LLVMValueRef whole = c::LLVMBuildLoad2(e->builder, base.ty.llvm, base.llvm, "block");
    c::LLVMValueRef data = c::LLVMBuildExtractValue(e->builder, whole, 0, "data");
    c::LLVMValueRef counts[8] = {};
    block_counts(e, whole, base.ty.count, counts);
    c::LLVMValueRef bad = c::LLVMBuildICmp(e->builder, c::LLVMIntUGE, position, counts[0], "outside");
    report_index(e, bad, at.llvm, at.ty.is_signed, counts[0]);
    c::LLVMValueRef stride = c::LLVMConstInt(index_word(e), 1, 0);
    for (U64 i = 1; i < base.ty.count; i++)
        stride = c::LLVMBuildMul(e->builder, stride, counts[i], "stride");
    c::LLVMValueRef start = c::LLVMBuildMul(e->builder, position, stride, "start");
    c::LLVMValueRef first = c::LLVMBuildInBoundsGEP2(e->builder, base.ty.element->llvm, data, &start, 1, "row");
    state::Value row = {};
    if (base.ty.count == 2) {
        row = make_slice(e, slice_type(e, *base.ty.element, "slice"), first, counts[1]);
    } else {
        c::LLVMValueRef inner[8] = {};
        for (U64 i = 1; i < base.ty.count; i++)
            inner[i - 1] = counts[i];
        row = make_block(e, block_type(e, *base.ty.element, base.ty.count - 1), first, inner);
    }
    c::LLVMValueRef slot = state::new_alloca(e, row.ty, "row");
    c::LLVMBuildStore(e->builder, row.llvm, slot);
    state::push_value(e, (state::Value){.llvm = slot, .ty = row.ty});
}

// A lane of a vector of Bools (a comparison's result) is one bit, with no address: it is read into a temporary.
static void flag_lane(state::Emitter *e, state::Value base, state::Value at, c::LLVMValueRef position) {
    check_index(e, base, at, position);
    c::LLVMValueRef whole = c::LLVMBuildLoad2(e->builder, base.ty.llvm, base.llvm, "");
    c::LLVMValueRef lane = c::LLVMBuildExtractElement(e->builder, whole, position, "lane");
    c::LLVMValueRef slot = state::new_alloca(e, *base.ty.element, "lane");
    c::LLVMBuildStore(e->builder, lane, slot);
    state::push_value(e, (state::Value){.llvm = slot, .ty = *base.ty.element});
}

static state::Status index_finish(state::Emitter *e, const state::Work *w) {
    state::Value at = state::pop_value(e);
    state::Value base = state::pop_value(e);
    if (at.ty.kind != .integer) return state::failf(w->span, "an index is an integer, not ", at.ty.name);
    c::LLVMValueRef position = c::LLVMBuildIntCast2(e->builder, at.llvm, index_word(e), at.ty.is_signed, "");
    if (base.ty.kind == .vector && base.ty.element->kind == .boolean) {
        flag_lane(e, base, at, position);
        return state::success();
    }
    if (base.ty.kind == .array || base.ty.kind == .vector) {
        array_element(e, base, at, position);
        return state::success();
    }
    if (base.ty.kind == .slice) {
        slice_element(e, base, at, position);
        return state::success();
    }
    if (base.ty.kind == .block) {
        block_row(e, base, at, position);
        return state::success();
    }
    if (base.ty.kind != .pointer || base.ty.element == nullptr) return state::failf(w->span, "indexing ", base.ty.name);
    c::LLVMValueRef pointer = c::LLVMBuildLoad2(e->builder, base.ty.llvm, base.llvm, "");
    c::LLVMValueRef address = c::LLVMBuildGEP2(e->builder, base.ty.element->llvm, pointer, &position, 1, "element");
    state::push_value(e, (state::Value){.llvm = address, .ty = *base.ty.element});
    return state::success();
}

export state::Status place_index(state::Emitter *e, const ast::Expr *x) {
    if (x->kind != .index) {
        return state::fail("not an index", x->span);
    }
    const ast::Expr *base = x->kind.index.base;
    const ast::Expr *at = x->kind.index.index;
    state::push_then(e, (state::Work){.then = index_finish, .span = x->span});
    state::push_eval(e, at, state::no_hint());
    push_address(e, base);
    return state::success();
}

export state::Status index(state::Emitter *e, const ast::Expr *x, state::Hint _) {
    state::push_then(e, (state::Work){.then = load_finish, .span = x->span});
    return place_index(e, x);
}

// The index in the record's field list of the field called `name`.
static state::Status field_index(state::Emitter *e, state::Ty record, Str name, ast::Span span, Usize *found) {
    Usize at = 0;
    if (record.kind != .record || !find_record_of(e, record, &at))
        return state::failf(span, record.name, " is not a record");
    for (Usize i = 0; i < field_count(e, at); i++) {
        if (state::same_text(e->records[at].fields[i].name, name)) {
            *found = i;
            return state::success();
        }
    }
    return state::failf(span, "no field ", name, " in ", record.name);
}

// The place of a field of the record stored at `address`.
static state::Status push_field(state::Emitter *e, state::Ty record, c::LLVMValueRef address, Str name,
                                ast::Span span) {
    Usize field = 0;
    try field_index(e, record, name, span, &field);
    Usize at = 0;
    find_record_of(e, record, &at);
    c::LLVMValueRef gep = c::LLVMBuildStructGEP2(e->builder, record.llvm, address, (U32)field, "field");
    state::push_value(e, (state::Value){.llvm = gep, .ty = e->records[at].fields[field].ty});
    return state::success();
}

static state::Status member_finish(state::Emitter *e, const state::Work *w) {
    if (w->expr->kind != .member) {
        return state::fail("not a member access", w->span);
    }
    Str name = w->expr->kind.member.name;
    state::Value base = state::pop_value(e);
    state::Ty record = base.ty;
    if (w->flag) {
        if (base.ty.kind != .pointer || base.ty.element == nullptr)
            return state::failf(w->span, "`->` on ", base.ty.name);
        record = *base.ty.element;
    } else if (base.ty.kind == .pointer) {
        // `p.x` follows one pointer, as `p->x`: the base is the place of `p`, so load the pointer first.
        if (base.ty.element == nullptr) return state::failf(w->span, "`.` on ", base.ty.name);
        if (base.ty.element->kind == .pointer) return state::fail("`.` follows one pointer; write `pp.*.x`", w->span);
        base.llvm = c::LLVMBuildLoad2(e->builder, base.ty.llvm, base.llvm, "pointer");
        record = *base.ty.element;
    }
    return push_field(e, record, base.llvm, name, w->span);
}

export state::Status place_member(state::Emitter *e, const ast::Expr *x) {
    if (x->kind != .member) {
        return state::fail("not a member access", x->span);
    }
    const ast::Expr *base = x->kind.member.base;
    Bool arrow = x->kind.member.arrow;
    state::push_then(e, (state::Work){.then = member_finish, .expr = x, .flag = arrow, .span = x->span});
    if (arrow)
        state::push_eval(e, base, state::no_hint());
    else
        push_address(e, base);
    return state::success();
}

export state::Status member(state::Emitter *e, const ast::Expr *x, state::Hint _) {
    state::push_then(e, (state::Work){.then = load_finish, .span = x->span});
    return place_member(e, x);
}

// ---------------------------------------------------------------------------------------------------------------
// null and casts

export state::Status null_pointer(state::Emitter *e, const ast::Expr *_, state::Hint hint) {
    if (hint.present && hint.ty.kind == .pointer) {
        state::push_value(e, (state::Value){.llvm = c::LLVMConstNull(hint.ty.llvm), .ty = hint.ty});
        return state::success();
    }
    // No pointer is expected here: a pointer to nothing in particular, which any pointer type takes.
    state::Ty ty = {.kind = .pointer, .llvm = state::pointer_type(e, 0), .name = "null"};
    state::push_value(e, (state::Value){.llvm = c::LLVMConstNull(ty.llvm), .ty = ty});
    return state::success();
}

static Bool is_integer_like(state::Ty ty) {
    return ty.kind == .integer || ty.kind == .boolean;
}

// A cast the checker marked asserts that the value fits the target: lost when the value does not survive the trip to
// the target and back, or when a signed value is negative and the target unsigned, or the result negative and the
// source unsigned. A failed assertion calls `contract::fail_cast` with the value and the target type's name, which
// reports and stops (K6, #1389).
static void check_fits(state::Emitter *e, state::Value from, state::Ty to, c::LLVMValueRef converted) {
    c::LLVMValueRef lost = c::LLVMConstInt(c::LLVMInt1TypeInContext(e->context), 0, 0);
    if (from.ty.bits != to.bits) {
        c::LLVMValueRef back = c::LLVMBuildIntCast2(e->builder, converted, from.ty.llvm, to.is_signed, "");
        lost = c::LLVMBuildICmp(e->builder, c::LLVMIntNE, back, from.llvm, "lost");
    }
    if (from.ty.is_signed && !to.is_signed) {
        c::LLVMValueRef zero = c::LLVMConstInt(from.ty.llvm, 0, 0);
        c::LLVMValueRef negative = c::LLVMBuildICmp(e->builder, c::LLVMIntSLT, from.llvm, zero, "negative");
        lost = c::LLVMBuildOr(e->builder, lost, negative, "lost");
    }
    if (!from.ty.is_signed && to.is_signed) {
        c::LLVMValueRef zero = c::LLVMConstInt(to.llvm, 0, 0);
        c::LLVMValueRef negative = c::LLVMBuildICmp(e->builder, c::LLVMIntSLT, converted, zero, "negative");
        lost = c::LLVMBuildOr(e->builder, lost, negative, "lost");
    }
    c::LLVMTypeRef wide = c::LLVMInt64TypeInContext(e->context);
    char *target = format::push(to.name).data;
    c::LLVMValueRef args[3] = {c::LLVMBuildIntCast2(e->builder, from.llvm, wide, from.ty.is_signed, ""),
                               c::LLVMConstInt(c::LLVMInt32TypeInContext(e->context), from.ty.is_signed, 0),
                               c::LLVMBuildGlobalStringPtr(e->builder, target, "type")};
    arith::report_if(e, lost, "smith_contract_fail_cast", args, 3);
}

// A pointer and an integer as wide as a pointer: `ptrtoint` and `inttoptr`, with no run-time check.
static state::Status pointer_integer_cast(state::Emitter *e, const state::Work *w, state::Value from, state::Ty to) {
    state::Ty integer = from.ty.kind == .integer ? from.ty : to;
    U64 width = e->target_data != nullptr ? (U64)c::LLVMPointerSize(e->target_data) * 8 : 64;
    if (integer.bits != width) {
        return state::failf(w->span, "cannot cast ", from.ty.name, " to ", to.name,
                            ": a pointer casts only to an integer as wide as a pointer (`usize`, `isize`)");
    }
    c::LLVMValueRef out = nullptr;
    if (to.kind == .integer)
        out = c::LLVMBuildPtrToInt(e->builder, from.llvm, to.llvm, "");
    else
        out = c::LLVMBuildIntToPtr(e->builder, from.llvm, to.llvm, "");
    state::push_value(e, (state::Value){.llvm = out, .ty = to});
    return state::success();
}

static state::Status cast_finish(state::Emitter *e, const state::Work *w) {
    state::Value from = state::pop_value(e);
    state::Ty to = w->ty;
    if (is_integer_like(from.ty) && is_integer_like(to)) {
        c::LLVMValueRef out = nullptr;
        if (to.kind == .boolean && from.ty.kind != .boolean) {
            c::LLVMValueRef zero = c::LLVMConstInt(from.ty.llvm, 0, 0);
            out = c::LLVMBuildICmp(e->builder, c::LLVMIntNE, from.llvm, zero, "");
        } else {
            out = c::LLVMBuildIntCast2(e->builder, from.llvm, to.llvm, from.ty.is_signed, "");
            if (w->flag && from.ty.kind == .integer) check_fits(e, from, to, out);
        }
        state::push_value(e, (state::Value){.llvm = out, .ty = to});
        return state::success();
    }
    if (from.ty.kind == .pointer && to.kind == .pointer) {
        if (from.ty.address_space != to.address_space)
            return state::not_emitted("cast between address spaces", w->span);
        state::push_value(e, (state::Value){.llvm = from.llvm, .ty = to});
        return state::success();
    }
    if ((from.ty.kind == .pointer && to.kind == .integer) || (from.ty.kind == .integer && to.kind == .pointer))
        return pointer_integer_cast(e, w, from, to);
    return state::failf(w->span, "cannot cast ", from.ty.name, " to ", to.name);
}

export state::Status cast(state::Emitter *e, const ast::Expr *x, state::Hint _) {
    if (x->kind != .cast) {
        return state::fail("not a cast", x->span);
    }
    const ast::TypeExpr *type = x->kind.cast.type;
    const ast::Expr *operand = x->kind.cast.operand;
    state::TyResult made = resolve(e, type);
    if (made == .error) {
        return {.error = made.error};
    }
    state::Hint hint = state::no_hint();
    if (operand->kind == .null_pointer) hint = state::hint_of(made.ok);
    Bool checked = e->options.checked != nullptr && types::cast_checked(e->options.checked, x).needed;
    state::push_then(e, (state::Work){.then = cast_finish, .ty = made.ok, .flag = checked, .span = x->span});
    state::push_eval(e, operand, hint);
    return state::success();
}

// ---------------------------------------------------------------------------------------------------------------
// sizeof, alignof, countof

static Bool is_step(const ast::Expr *x) {
    if (x->kind == .member || x->kind == .index) return true;
    return x->kind == .unary && (x->kind.unary.op == .dereference || x->kind.unary.op == .address_of);
}

static const ast::Expr *inner_of(const ast::Expr *x) {
    if (x->kind == .member) return x->kind.member.base;
    if (x->kind == .index) return x->kind.index.base;
    if (x->kind == .unary) return x->kind.unary.operand;
    return x;
}

// The type of the root of a chain: a local, a global or an integer literal.
static state::Status root_type(state::Emitter *e, const ast::Expr *x, state::Ty *out) {
    if (x->kind == .integer) {
        state::scalar_type(e, "I32", out);
        return state::success();
    }
    if (x->kind != .name) return state::not_emitted("sizeof of this expression", x->span);
    ast::Path path = x->kind.name.path;
    if (countof(path.segments) != 1) return state::not_emitted("qualified name", x->span);
    Str name = path.segments[0].text;
    state::Local local = {};
    if (state::find_local(e, name, &local)) {
        *out = local.ty;
        return state::success();
    }
    state::Value place = {};
    try global_place_of(e, name, x->span, &place);
    *out = place.ty;
    return state::success();
}

// One step of a chain applied to the type so far.
static state::Status step_type(state::Emitter *e, const ast::Expr *node, state::Ty *ty) {
    if (node->kind == .member) {
        Str name = node->kind.member.name;
        state::Ty record = *ty;
        if (node->kind.member.arrow) {
            if (ty->kind != .pointer || ty->element == nullptr) return state::failf(node->span, "`->` on ", ty->name);
            record = *ty->element;
        }
        Usize field = 0;
        Usize at = 0;
        try field_index(e, record, name, node->span, &field);
        find_record_of(e, record, &at);
        *ty = e->records[at].fields[field].ty;
        return state::success();
    }
    if (node->kind == .index || (node->kind == .unary && node->kind.unary.op == .dereference)) {
        if ((ty->kind != .pointer && ty->kind != .array) || ty->element == nullptr)
            return state::failf(node->span, "indexing or dereferencing ", ty->name);
        *ty = *ty->element;
        return state::success();
    }
    *ty = pointer_to(e, *ty, 0); // `&`
    return state::success();
}

// The type of an expression without emitting it: the root's type, then the chain of members, indexes and
// dereferences from the inside out. The chain is walked with loops.
static state::Status static_type(state::Emitter *e, const ast::Expr *x, state::Ty *out) {
    const ast::Expr *chain[32];
    Usize depth = 0;
    const ast::Expr *root = x;
    while (is_step(root)) {
        if (depth == countof(chain)) return state::fail("an expression nested more than 32 deep", x->span);
        chain[depth] = root;
        depth += 1;
        root = inner_of(root);
    }
    try root_type(e, root, out);
    for (Usize i = depth; i > 0; i--)
        try step_type(e, chain[i - 1], out);
    return state::success();
}

// Whether the checker typed `x` as a slice or `str`.
static Bool checked_slice(state::Emitter *e, const ast::Expr *x) {
    if (e->options.checked == nullptr) return false;
    types::TypeRef t = types::type_of(e->options.checked, x);
    return t != nullptr && (t->kind == .slice || t->kind == .text || t->kind == .block);
}

// `countof` of a slice: its count, a `usize`.
static state::Status count_finish(state::Emitter *e, const state::Work *w) {
    state::Value slice = state::pop_value(e);
    if (slice.ty.kind == .block) {
        c::LLVMValueRef counts[8] = {};
        block_counts(e, slice.llvm, slice.ty.count, counts);
        state::Ty first = {};
        state::scalar_type(e, "usize", &first);
        state::push_value(
            e, (state::Value){.llvm = c::LLVMBuildIntCast2(e->builder, counts[0], first.llvm, 0, ""), .ty = first});
        return state::success();
    }
    if (slice.ty.kind != .slice) return state::failf(w->span, "countof of ", slice.ty.name, ", which is not a slice");
    state::Ty word = {};
    state::scalar_type(e, "usize", &word);
    c::LLVMValueRef count = c::LLVMBuildExtractValue(e->builder, slice.llvm, 1, "count");
    c::LLVMValueRef sized = c::LLVMBuildIntCast2(e->builder, count, word.llvm, 0, "");
    state::push_value(e, (state::Value){.llvm = sized, .ty = word});
    return state::success();
}

// `sizeof`, `alignof` and `countof`.
export state::Status query(state::Emitter *e, const ast::Expr *x, state::Hint _) {
    if (x->kind != .query) {
        return state::fail("not a query", x->span);
    }
    ast::QueryOp op = x->kind.query.op;
    const ast::TypeExpr *type = x->kind.query.type;
    const ast::Expr *operand = x->kind.query.operand;
    if (op == .count_of && operand != nullptr && checked_slice(e, operand)) {
        state::push_then(e, (state::Work){.then = count_finish, .span = x->span});
        state::push_eval(e, operand, state::no_hint());
        return state::success();
    }
    state::Ty subject = {};
    if (type != nullptr) {
        state::TyResult made = resolve(e, type);
        if (made == .error) {
            return {.error = made.error};
        }
        subject = made.ok;
    } else {
        try static_type(e, operand, &subject);
    }
    state::Ty word = u64_type(e);
    U64 number = 0;
    if (op == .count_of) {
        if (subject.kind != .array && subject.kind != .tuple)
            return state::failf(x->span, "countof of ", subject.name, ", which is not an array or a tuple");
        number = subject.kind == .tuple ? subject.part_count : subject.count;
    } else {
        if (e->target_data == nullptr) return state::fail("sizeof and alignof need the target's data layout", x->span);
        if (op == .size_of)
            number = c::LLVMABISizeOfType(e->target_data, subject.llvm);
        else
            number = c::LLVMABIAlignmentOfType(e->target_data, subject.llvm);
    }
    state::push_value(e, (state::Value){.llvm = c::LLVMConstInt(word.llvm, number, 0), .ty = word});
    return state::success();
}

// ---------------------------------------------------------------------------------------------------------------
// Slices and `str`

// A string literal: a private constant `[N+1 x i8]` (the zero byte is not in the count), and `{ ptr, N }` of type
// `str`.
export state::Status string_literal(state::Emitter *e, const ast::Expr *x, state::Hint hint) {
    if (x->kind != .string) {
        return state::fail("not a string literal", x->span);
    }
    Str bytes = x->kind.string.bytes;
    if (hint.present && hint.ty.kind == .array) { // a literal given to `[N]char`: the bytes and the zero byte
        c::LLVMValueRef whole = c::LLVMConstStringInContext2(e->context, bytes.data, countof(bytes), 0);
        state::push_value(e, (state::Value){.llvm = whole, .ty = hint.ty});
        return state::success();
    }
    c::LLVMTypeRef byte = c::LLVMInt8TypeInContext(e->context);
    c::LLVMValueRef text = c::LLVMConstStringInContext2(e->context, bytes.data, countof(bytes), 0);
    c::LLVMValueRef global = c::LLVMAddGlobal(e->module, c::LLVMArrayType2(byte, countof(bytes) + 1), ".str");
    c::LLVMSetInitializer(global, text);
    c::LLVMSetGlobalConstant(global, 1);
    c::LLVMSetLinkage(global, c::LLVMPrivateLinkage);
    c::LLVMSetUnnamedAddr(global, 1);
    if (hint.present && hint.ty.kind == .pointer) { // a literal given to `const char *`: the address of the bytes
        state::push_value(e, (state::Value){.llvm = global, .ty = hint.ty});
        return state::success();
    }
    state::Ty character = {};
    state::scalar_type(e, "char", &character);
    state::Ty ty = slice_type(e, character, "str");
    c::LLVMValueRef count = c::LLVMConstInt(index_word(e), countof(bytes), 0);
    state::push_value(e, make_slice(e, ty, global, count));
    return state::success();
}

// A fixed array of arrays as the block `to`: `{ address, sizes }`, the sizes the first dimensions of the array's type.
static state::Value array_as_block(state::Emitter *e, state::Ty to, c::LLVMValueRef address, state::Ty array) {
    c::LLVMValueRef counts[8] = {};
    state::Ty inner = array;
    for (U64 i = 0; i < to.count; i++) {
        counts[i] = c::LLVMConstInt(index_word(e), inner.count, 0);
        inner = *inner.element;
    }
    return make_block(e, to, address, counts);
}

static state::Status array_slice_finish(state::Emitter *e, const state::Work *w) {
    state::Value place = state::pop_value(e);
    if (place.ty.kind != .array) return state::failf(w->span, "a slice of ", place.ty.name, ", which is not an array");
    if (w->ty.kind == .block) {
        state::push_value(e, array_as_block(e, w->ty, place.llvm, place.ty));
        return state::success();
    }
    c::LLVMValueRef count = c::LLVMConstInt(index_word(e), place.ty.count, 0);
    state::push_value(e, make_slice(e, w->ty, place.llvm, count));
    return state::success();
}

// An array that is a place where a slice is expected: `{ address, N }`; the slice ALIASES the array.
export state::Status array_as_slice(state::Emitter *e, const ast::Expr *x, state::Hint hint) {
    state::push_then(e, (state::Work){.then = array_slice_finish, .ty = hint.ty, .span = x->span});
    push_place_of(e, x);
    return state::success();
}

// An array value (a call's result) as a slice: stored in a fresh slot, which the slice points to.
export state::Status array_value_as_slice(state::Emitter *e, state::Value value, state::Ty to) {
    c::LLVMValueRef slot = state::new_alloca(e, value.ty, "temporary");
    c::LLVMBuildStore(e->builder, value.llvm, slot);
    if (to.kind == .block) {
        state::push_value(e, array_as_block(e, to, slot, value.ty));
        return state::success();
    }
    c::LLVMValueRef count = c::LLVMConstInt(index_word(e), value.ty.count, 0);
    state::push_value(e, make_slice(e, to, slot, count));
    return state::success();
}

// The bound of `xs[a:b]` as a word: the written value, else `fallback`.
static c::LLVMValueRef slice_bound(state::Emitter *e, const ast::Expr *written, c::LLVMValueRef fallback) {
    if (written == nullptr) return fallback;
    state::Value at = state::pop_value(e);
    return c::LLVMBuildIntCast2(e->builder, at.llvm, index_word(e), at.ty.is_signed, "");
}

static state::Status slice_of_finish(state::Emitter *e, const state::Work *w) {
    if (w->expr->kind != .slice_of) {
        return state::fail("not a slice", w->span);
    }
    const ast::Expr *start_written = w->expr->kind.slice_of.start;
    const ast::Expr *end_written = w->expr->kind.slice_of.end;
    // The values were pushed base, start, end: the last on top.
    c::LLVMValueRef zero = c::LLVMConstInt(index_word(e), 0, 0);
    c::LLVMValueRef end = nullptr;
    if (end_written != nullptr) end = slice_bound(e, end_written, nullptr);
    c::LLVMValueRef start = slice_bound(e, start_written, zero);
    state::Value base = state::pop_value(e);
    c::LLVMValueRef data = nullptr;
    c::LLVMValueRef count = nullptr;
    state::Ty result = base.ty;
    if (base.ty.kind == .slice) {
        slice_parts(e, base, &data, &count);
    } else if (base.ty.kind == .array) {
        data = base.llvm;
        count = c::LLVMConstInt(index_word(e), base.ty.count, 0);
        result = slice_type(e, *base.ty.element, "slice");
    } else {
        return state::not_emitted("a slice of a pointer", w->span);
    }
    if (end == nullptr) end = count;
    c::LLVMValueRef backwards = c::LLVMBuildICmp(e->builder, c::LLVMIntUGT, start, end, "backwards");
    c::LLVMValueRef past = c::LLVMBuildICmp(e->builder, c::LLVMIntUGT, end, count, "past");
    c::LLVMValueRef bad = c::LLVMBuildOr(e->builder, backwards, past, "outside");
    report_index(e, bad, end, 0, count);
    c::LLVMValueRef first = c::LLVMBuildGEP2(e->builder, base.ty.element->llvm, data, &start, 1, "first");
    c::LLVMValueRef length = c::LLVMBuildSub(e->builder, end, start, "length");
    state::push_value(e, make_slice(e, result, first, length));
    return state::success();
}

// `xs[a:b]` of a slice, a `str` or an array that is a place; either end may be missing.
export state::Status slice_of(state::Emitter *e, const ast::Expr *x, state::Hint _) {
    if (x->kind != .slice_of) {
        return state::fail("not a slice", x->span);
    }
    const ast::Expr *base = x->kind.slice_of.base;
    const ast::Expr *start = x->kind.slice_of.start;
    const ast::Expr *end = x->kind.slice_of.end;
    state::push_then(e, (state::Work){.then = slice_of_finish, .expr = x, .span = x->span});
    if (end != nullptr) state::push_eval(e, end, state::no_hint());
    if (start != nullptr) state::push_eval(e, start, state::no_hint());
    push_address(e, base);
    return state::success();
}

// ---------------------------------------------------------------------------------------------------------------
// Compound literals

// Which field (or element, for an array) the `position`th initializer sets, and its type: the one its designator
// names, else the next in order.
static state::Status item_target(state::Emitter *e, state::Ty whole, ast::Initializer item, Usize position,
                                 Usize *found, state::Ty *want) {
    ast::Span span = item.value->span;
    ast::Designator designators[:] = item.designators;
    Usize at = 0;
    if (whole.kind == .array) {
        if (countof(designators) > 0) return state::not_emitted("designator in an array", span);
        if (position >= whole.count) return state::failf(span, "too many initializers for ", whole.name);
        *found = position;
        *want = *whole.element;
        return state::success();
    }
    if (whole.kind != .record || !find_record_of(e, whole, &at))
        return state::failf(span, whole.name, " is not a record or an array");
    if (countof(designators) == 0) {
        if (position >= field_count(e, at)) return state::failf(span, "too many initializers for ", whole.name);
        *found = position;
    } else {
        ast::Designator first = designators[0];
        if (countof(designators) > 1 || first != .field) return state::not_emitted("this designator", span);
        try field_index(e, whole, first.field.name, span, found);
    }
    *want = e->records[at].fields[*found].ty;
    return state::success();
}

// The address of field or element `index` of the record or array stored at `slot`.
static c::LLVMValueRef part_address(state::Emitter *e, state::Ty whole, c::LLVMValueRef slot, Usize index) {
    if (whole.kind == .record) return c::LLVMBuildStructGEP2(e->builder, whole.llvm, slot, (U32)index, "field");
    c::LLVMTypeRef word = index_word(e);
    c::LLVMValueRef indices[2] = {c::LLVMConstInt(word, 0, 0), c::LLVMConstInt(word, index, 0)};
    return c::LLVMBuildInBoundsGEP2(e->builder, whole.llvm, slot, indices, 2, "element");
}

static state::Status compound_step(state::Emitter *e, const state::Work *w);

// The value is evaluated: stored into its field, then the next initializer.
static state::Status compound_store(state::Emitter *e, const state::Work *w) {
    if (w->expr->kind != .compound) {
        return state::fail("not a compound literal", w->span);
    }
    ast::Initializer items[:] = w->expr->kind.compound.items;
    Usize position = (Usize)w->number;
    Usize part = 0;
    state::Ty want = {};
    try item_target(e, w->ty, items[position], position, &part, &want);
    state::Value value = state::pop_value(e);
    if (!state::same_type(want, value.ty))
        return state::failf(items[position].value->span, "initializing ", want.name, " with ", value.ty.name);
    c::LLVMBuildStore(e->builder, value.llvm, part_address(e, w->ty, w->value, part));
    state::push_then(e, (state::Work){.then = compound_step,
                                      .expr = w->expr,
                                      .ty = w->ty,
                                      .number = w->number + 1,
                                      .value = w->value,
                                      .span = w->span});
    return state::success();
}

// Initializer number `w->number` is next: evaluated with its part's type, or the literal is finished.
static state::Status compound_step(state::Emitter *e, const state::Work *w) {
    if (w->expr->kind != .compound) {
        return state::fail("not a compound literal", w->span);
    }
    ast::Initializer items[:] = w->expr->kind.compound.items;
    Usize position = (Usize)w->number;
    if (position >= countof(items)) {
        c::LLVMValueRef whole = c::LLVMBuildLoad2(e->builder, w->ty.llvm, w->value, "");
        state::push_value(e, (state::Value){.llvm = whole, .ty = w->ty});
        return state::success();
    }
    Usize part = 0;
    state::Ty want = {};
    try item_target(e, w->ty, items[position], position, &part, &want);
    state::push_then(e, (state::Work){.then = compound_store,
                                      .expr = w->expr,
                                      .ty = w->ty,
                                      .number = w->number,
                                      .value = w->value,
                                      .span = w->span});
    state::push_eval(e, items[position].value, state::hint_of(want));
    return state::success();
}

// `(Point){.x = 1, .y = 2}` and `{1, 2, 3}` for an array: a zeroed temporary, each initializer stored into its part,
// the whole loaded.
export state::Status compound(state::Emitter *e, const ast::Expr *x, state::Hint hint) {
    if (x->kind != .compound) {
        return state::fail("not a compound literal", x->span);
    }
    const ast::TypeExpr *type = x->kind.compound.type;
    state::Ty ty = {};
    if (type != nullptr) {
        state::TyResult made = resolve(e, type);
        if (made == .error) {
            return {.error = made.error};
        }
        ty = made.ok;
    } else if (hint.present) {
        ty = hint.ty;
    } else {
        return state::fail("a compound literal needs a type", x->span);
    }
    if (ty.kind != .record && ty.kind != .array) return state::not_emitted("compound literal of this type", x->span);
    c::LLVMValueRef slot = state::new_alloca(e, ty, "compound");
    c::LLVMBuildStore(e->builder, c::LLVMConstNull(ty.llvm), slot);
    state::push_then(e, (state::Work){.then = compound_step, .expr = x, .ty = ty, .value = slot, .span = x->span});
    return state::success();
}

// ---------------------------------------------------------------------------------------------------------------
// Array literals

// The items are evaluated (first on the bottom of the value stack): each converted to the element type and inserted
// into the array value; as a slice, the array is stored in a fresh slot of the entry block and the Value is
// `{ slot, M }`. `w->ty` is the array type, `w->hint` the slice type when the literal stands where a slice is wanted
// (`w->flag`).
static state::Status array_literal_finish(state::Emitter *e, const state::Work *w) {
    state::Ty array = w->ty;
    c::LLVMValueRef built = c::LLVMConstNull(array.llvm);
    for (Usize i = (Usize)w->number; i > 0; i--) {
        state::Value item = state::pop_value(e);
        if (!state::same_type(item.ty, *array.element)) {
            try state::convert(e, item, *array.element, w->span, .initialize);
            item = state::pop_value(e);
        }
        built = c::LLVMBuildInsertValue(e->builder, built, item.llvm, (U32)(i - 1), "");
    }
    if (!w->flag) {
        state::push_value(e, (state::Value){.llvm = built, .ty = array});
        return state::success();
    }
    if (w->number == 0) {
        c::LLVMValueRef none = c::LLVMConstNull(state::pointer_type(e, 0));
        state::push_value(e, make_slice(e, w->hint.ty, none, c::LLVMConstInt(index_word(e), 0, 0)));
        return state::success();
    }
    return array_value_as_slice(e, (state::Value){.llvm = built, .ty = array}, w->hint.ty);
}

// `[1, 2, 3]` as a fixed array `[N]T` or, where a slice is expected, as `[]T` over a hidden array kept in the entry
// block (it lives as long as the function; a literal evaluated again overwrites the same slot). `[]` is `{ null, 0 }`
// for a slice and `[0]T` for an array; with no type to say which, an Error.
export state::Status array_literal(state::Emitter *e, const ast::Expr *x, state::Hint hint) {
    if (x->kind != .array_lit) {
        return state::fail("not an array literal", x->span);
    }
    ast::ExprRef items[:] = x->kind.array_lit.items;
    state::Ty want = {};
    if (hint.present && (hint.ty.kind == .array || hint.ty.kind == .slice)) {
        want = hint.ty;
    } else if (countof(items) == 0) {
        return state::fail("`[]` needs its type; write it", x->span);
    } else {
        state::TyResult made = state::type_of_node(e, x);
        if (made == .error) return {.error = made.error};
        want = made.ok;
    }
    if (want.kind != .array && want.kind != .slice) {
        return state::failf(x->span, "an array literal where ", want.name, " is expected");
    }
    state::Ty array = want;
    if (want.kind == .slice) array = array_of(e, *want.element, countof(items));
    if (array.count != countof(items)) {
        return state::failf(x->span, "the array has ", array.count, " elements, the literal ", countof(items));
    }
    state::push_then(e, (state::Work){.then = array_literal_finish,
                                      .hint = state::hint_of(want),
                                      .ty = array,
                                      .flag = want.kind == .slice,
                                      .number = countof(items),
                                      .span = x->span});
    for (Usize i = countof(items); i > 0; i--)
        state::push_eval(e, items[i - 1], state::hint_of(*array.element));
    return state::success();
}

// ---------------------------------------------------------------------------------------------------------------
// Declarations

// `Decl.record` (file scope or a block).
export state::Status record_decl(state::Emitter *e, const ast::Decl *d) {
    if (d->kind != .record) {
        return state::fail("not a record", d->span);
    }
    Str name = d->kind.record.name;
    Str label = qualified(e->tree, name);
    state::Status made = declare_record(e, d, name, label);
    state::free_text(label);
    return made;
}

// An integer constant of type `ty`; `negative` for `-literal`.
static state::Status integer_constant(state::Ty ty, U64 value, Bool negative, ast::Span span, c::LLVMValueRef *out) {
    U32 usable = ty.bits;
    if (ty.is_signed) usable -= 1;
    Bool fits = ty.bits == 64 && !ty.is_signed;
    if (!fits) fits = value < (1ULL << usable) || (negative && ty.is_signed && value == (1ULL << usable));
    if (!fits) return state::failf(span, "integer literal ", value, " does not fit ", ty.name);
    *out = c::LLVMConstInt(ty.llvm, value, 0);
    if (negative) *out = c::LLVMConstNeg(*out);
    return state::success();
}

// A scalar constant of type `ty`: an integer literal (negated or not), `true`/`false` or `null`.
static state::Status scalar_constant(state::Ty ty, const ast::Expr *x, c::LLVMValueRef *out) {
    if (x->kind == .null_pointer && ty.kind == .pointer) {
        *out = c::LLVMConstNull(ty.llvm);
        return state::success();
    }
    if (x->kind == .boolean && ty.kind == .boolean) {
        *out = c::LLVMConstInt(ty.llvm, x->kind.boolean.value ? 1 : 0, 0);
        return state::success();
    }
    if (ty.kind == .integer && x->kind == .integer)
        return integer_constant(ty, x->kind.integer.value, false, x->span, out);
    if (ty.kind == .integer && x->kind == .unary && x->kind.unary.op == .negate) {
        const ast::Expr *inner = x->kind.unary.operand;
        if (inner->kind == .integer) return integer_constant(ty, inner->kind.integer.value, true, x->span, out);
    }
    return state::failf(x->span, "the initializer of a global is a constant of type ", ty.name);
}

// An array's constant from an array literal of scalar constants or a string literal; elements left out are zero.
static state::Status array_constant(state::Ty ty, const ast::Expr *x, c::LLVMValueRef *out) {
    if (x->kind == .string && ty.element->kind == .integer && ty.element->bits == 8) {
        Str bytes = x->kind.string.bytes;
        if (countof(bytes) + 1 > ty.count) return state::failf(x->span, "the string does not fit ", ty.name);
        if (ty.count > 256) return state::not_emitted("array constant of more than 256 elements", x->span);
        c::LLVMValueRef values[256]; // the bytes, then zeros up to the length
        for (Usize i = 0; i < ty.count; i++)
            values[i] = c::LLVMConstInt(ty.element->llvm, i < countof(bytes) ? (U64)(U8)bytes[i] : 0, 0);
        *out = c::LLVMConstArray2(ty.element->llvm, values, ty.count);
        return state::success();
    }
    if (x->kind != .array_lit)
        return state::failf(x->span, "the initializer of a global is a constant of type ", ty.name);
    ast::ExprRef items[:] = x->kind.array_lit.items;
    if (countof(items) > ty.count)
        return state::failf(x->span, "the array has ", ty.count, " elements, the literal ", countof(items));
    if (ty.count > 256) return state::not_emitted("array constant of more than 256 elements", x->span);
    c::LLVMValueRef values[256];
    for (Usize i = 0; i < ty.count; i++) {
        values[i] = c::LLVMConstNull(ty.element->llvm);
        if (i < countof(items)) try scalar_constant(*ty.element, items[i], &values[i]);
    }
    *out = c::LLVMConstArray2(ty.element->llvm, values, ty.count);
    return state::success();
}

// A record's constant from a compound of scalar constants; fields left out are zero.
static state::Status compound_constant(state::Emitter *e, state::Ty ty, const ast::Expr *x, c::LLVMValueRef *out) {
    if (ty.kind == .array) return array_constant(ty, x, out);
    if (x->kind != .compound) {
        return scalar_constant(ty, x, out);
    }
    ast::Initializer items[:] = x->kind.compound.items;
    Usize at = 0;
    if (ty.kind != .record || !find_record_of(e, ty, &at))
        return state::failf(x->span, "a compound initializer for ", ty.name);
    Usize count = field_count(e, at);
    if (count > 64) {
        return state::not_emitted("record with more than 64 fields", x->span);
    }
    c::LLVMValueRef values[64];
    for (Usize i = 0; i < count; i++)
        values[i] = c::LLVMConstNull(e->records[at].fields[i].ty.llvm);
    for (Usize i = 0; i < countof(items); i++) {
        Usize field = 0;
        state::Ty want = {};
        state::Status found = item_target(e, ty, items[i], i, &field, &want);
        if (found == .error) {
            return found;
        }
        state::Status made = scalar_constant(e->records[at].fields[field].ty, items[i].value, &values[field]);
        if (made == .error) {
            return made;
        }
    }
    *out = c::LLVMConstNamedStruct(ty.llvm, values, (U32)count);
    return state::success();
}

// `Decl.variable` at file scope: a global. Exported is external linkage, the rest internal.
export state::Status global_variable(state::Emitter *e, const ast::Decl *d) {
    if (d->kind != .variable) {
        return state::fail("not a variable", d->span);
    }
    Str name = d->kind.variable.name;
    const ast::Expr *init = d->kind.variable.init;
    if (d->kind.variable.is_thread_local) return state::not_emitted("this kind of global", d->span);
    Bool constant = d->kind.variable.is_constexpr;
    state::TyResult made = global_type(e, d);
    if (made == .error) {
        return {.error = made.error};
    }
    state::Ty ty = made.ok;
    c::LLVMValueRef initial = c::LLVMConstNull(ty.llvm);
    if (init != nullptr && !d->is_extern) try compound_constant(e, ty, init, &initial);
    Str own = state::c_name_of(d); // `@c_name("enzyme_out")` on an extern marker: the symbol is the C name
    Str symbol = countof(own) > 0 ? state::msg(format::push(own)) : qualified(e->tree, name);
    const char *label = symbol.data; // the text of `qualified` ends with a terminator
    state::Status result = state::success();
    if (c::LLVMGetNamedGlobal(e->module, label) != nullptr) {
        result = state::failf(d->span, name, " is declared twice");
    } else {
        c::LLVMValueRef global = c::LLVMAddGlobal(e->module, ty.llvm, label);
        // `extern` declares: the definition is in another module, so no initializer and external linkage.
        if (!d->is_extern) c::LLVMSetInitializer(global, initial);
        if (constant && !d->is_extern) c::LLVMSetGlobalConstant(global, 1);
        if (d->is_extern || (d->exported && !d->is_static))
            c::LLVMSetLinkage(global, c::LLVMExternalLinkage);
        else
            c::LLVMSetLinkage(global, c::LLVMInternalLinkage);
    }
    state::free_text(symbol);
    return result;
}

// Give back the record table, its field lists and the `Ty.element` blocks. `emit::module` calls it.
export void release(state::Emitter *e) {
    while (e->owned != nullptr) {
        state::OwnedTy *next = e->owned->next;
        mem::free(e->owned);
        e->owned = next;
    }
    for (Usize i = 0; i < e->record_count; i++)
        mem::free(e->records[i].fields.data);
    mem::free(e->records.data);
}
