// front::fix_blocks, the last step of `smith lint --fix` for blocks (#2014, part of #1845): the fixer's other fixes
// keep the braces of the source (`fn f() -> i32 {` ... `}`), and this writes them as smith's own blocks, `:` and an
// indented body. It reads tokens only, so it does not depend on which parser reads the text.
//
//   fix_blocks::convert(source)   the text with every brace block written as `:` and indentation; the text itself when
//                                 it has none, or when it does not lex as smith's own syntax
//
// A `{` is a block unless it follows `=`, `(`, `[`, `,` or `return` (a list), or starts its line. The forms:
//
//   header {          header:          the closing `}` line is removed
//   } else {          else:            the `}` and the space after it are removed
//   header { a }      header:          a body on the line of the header moves to its own line, 4 deeper
//   struct S { a: i32, b: i32 }        one field to a line
//   f(fn(a) { b })    f(fn(a): b)      a block inside parentheses stays on its line, and a multi-line one is left
//   header {          header:          a `}` that ends the last statement's line goes without a line of its own
//   for (T i = a; c; s) { b }          `mut i: T = a`, then `while c:` with `s` as the last line of the body
//   (#2225);
//                                      the names already declared in the scope get an assignment instead of a
//                                      declaration; a loop with a `continue`, a comma, or a body on the header's line
//                                      is left
//   "a"\n"b"          ("a"\n"b")        adjacent literals on several lines are one parenthesized expression
//   void f(auto x) {                   a C signature the fixer did not convert is left with its braces, all of it:
//                                      a signature is converted whole or not at all
module front::fix_blocks;

import front::lex;
import std::format;
import std::mem;

constexpr Usize step = 4;

struct Cut {
    Usize start;
    Usize end;
    Str text;
};

typedef typeof(Cut[:]) Cuts;

static Str as_str(char chars[:]) {
    return chars;
}

static void add_cut(Cuts *cuts, Usize start, Usize end, Str text) {
    *cuts = mem::realloc(*cuts, countof(*cuts) + 1);
    (*cuts)[countof(*cuts) - 1] = (Cut){.start = start, .end = end, .text = text};
}

// The offset of the start of the line that holds `at`.
static Usize line_start(Str source, Usize at) {
    while (at > 0 && source[at - 1] != '\n')
        at -= 1;
    return at;
}

// The spaces at the start of the line that holds `at`.
static Usize indent_of(Str source, Usize at) {
    Usize from = line_start(source, at);
    Usize n = 0;
    while (from + n < countof(source) && source[from + n] == ' ')
        n += 1;
    return n;
}

// Where the spaces before `at` start.
static Usize spaces_before(Str source, Usize at) {
    while (at > 0 && source[at - 1] == ' ')
        at -= 1;
    return at;
}

static Str spaces(Usize n) {
    Str out = "";
    for (Usize i = 0; i < n; i++)
        out = as_str(format::push(out, " "));
    return out;
}

// One `{` of the text: its token, the token of its `}`, and what it is.
struct Brace {
    Usize open;
    Usize close;
    Bool block;  // not a list
    Bool inside; // inside parentheses or brackets
    Bool skip;   // in a function whose signature is still C's: left as it is
    Str tail;    // the line a `for` loop's step becomes, placed where the closing `}` was
};

typedef typeof(Brace[:]) Braces;

static Bool starts_list(lex::TokenKind before) {
    return before == lex::equal || before == lex::left_paren || before == lex::left_bracket || before == lex::comma ||
           before == lex::kw_return || before == lex::left_brace;
}

// Whether the `{` at `open` follows a parenthesized type that is itself a value: `(Stream){}` and `(typeof(a)){0}` are
// compound literals, never a block (#2520). The `(` is a value's when it follows `=`, `(`, `[`, `,`, `return`
// or `try`, or starts a statement; after a name, a keyword or an operator (`if (c) {`, `f(x) {`, `fn(a) {`, `a && (b)
// {`) the `{` is a block.
static Bool compound_literal(lex::Tokens tokens, Usize open) {
    if (open < 3 || tokens[open - 1].kind != lex::right_paren) return false;
    Usize nest = 0;
    Usize i = open;
    Bool found = false;
    for (Usize back = 0; back < open && !found; back++) {
        i = open - 1 - back;
        if (tokens[i].kind == lex::right_paren) nest += 1;
        if (tokens[i].kind == lex::left_paren) {
            nest -= 1;
            found = nest == 0;
        }
    }
    if (!found) return false;
    if (i == 0) return false;
    lex::TokenKind before = tokens[i - 1].kind;
    return starts_list(before) || before == lex::semicolon || before == lex::kw_try;
}

static Bool any_group(const Bool group[:]) {
    for (Usize g = 0; g < countof(group); g++) {
        if (group[g]) return true;
    }
    return false;
}

// Every `{` with its `}`, in the order of the `{`. Empty when the braces do not balance.
static Braces braces_of(lex::Tokens tokens) {
    Braces out = {};
    Braces none = {};
    Usize open[:] = {};
    Bool group[:] = {};
    for (Usize i = 0; i < countof(tokens); i++) {
        lex::TokenKind kind = tokens[i].kind;
        if (kind == lex::left_brace || kind == lex::left_paren || kind == lex::left_bracket) {
            Bool list = kind == lex::left_brace && (i == 0 || starts_list(tokens[i - 1].kind) ||
                                                    tokens[i - 1].line_break || compound_literal(tokens, i));
            if (kind == lex::left_brace) {
                out = mem::realloc(out, countof(out) + 1);
                out[countof(out) - 1] = (Brace){.open = i, .block = !list};
            }
            open = mem::realloc(open, countof(open) + 1);
            open[countof(open) - 1] = kind == lex::left_brace ? countof(out) : 0;
            group = mem::realloc(group, countof(group) + 1);
            group[countof(group) - 1] = kind != lex::left_brace;
            continue;
        }
        if (kind != lex::right_brace && kind != lex::right_paren && kind != lex::right_bracket) continue;
        if (countof(open) == 0) return none;
        Usize which = open[countof(open) - 1];
        open = mem::realloc(open, countof(open) - 1);
        group = mem::realloc(group, countof(group) - 1);
        if (kind == lex::right_brace) {
            if (which == 0) {
                return none;
            }
            out[which - 1].close = i;
            out[which - 1].inside = any_group(group);
        }
    }
    return countof(open) == 0 ? out : none;
}

static Bool same_line(lex::Tokens tokens, Usize from, Usize to) {
    for (Usize i = from; i < to; i++) {
        if (tokens[i].line_break) return false;
    }
    return true;
}

// Whether the tokens of the line that holds the `{` start a `struct`, `enum` or `union`.
static Bool declares_fields(lex::Tokens tokens, Usize open) {
    Usize i = open;
    while (i > 0 && !tokens[i - 1].line_break)
        i -= 1;
    while (i < open) {
        lex::TokenKind kind = tokens[i].kind;
        if (kind == lex::kw_struct || kind == lex::kw_enum || kind == lex::kw_union) return true;
        i += 1;
    }
    return false;
}

// The `}` ends its line or is followed by `else` and the rest.
static Bool closes_cleanly(lex::Tokens tokens, Usize close) {
    if (close + 1 >= countof(tokens) || tokens[close + 1].kind == lex::end_of_file) return true;
    if (tokens[close].line_break) return true;
    return tokens[close + 1].kind == lex::kw_else;
}

// The end of the line of the `}`, after its newline.
static Usize after_line(Str source, Usize at) {
    while (at < countof(source) && source[at] != '\n')
        at += 1;
    return at < countof(source) ? at + 1 : at;
}

static Bool open_ends_line(lex::Tokens tokens, Usize open) {
    return tokens[open].line_break;
}

// Whether a block that spans lines can be written as `:`: its `{` ends its line and its `}` ends a line (the last
// statement's or its own) or is followed by `else`.
static Bool multi_line_ready(lex::Tokens tokens, Brace brace) {
    if (!open_ends_line(tokens, brace.open) || !closes_cleanly(tokens, brace.close)) return false;
    if (tokens[brace.close - 1].line_break) return true;
    return !(brace.close + 1 < countof(tokens) && !tokens[brace.close].line_break);
}

// Whether the `{` ends the header `enum Name : u8 {`: the underlying type is one token between the `:` and the `{`.
static Bool enum_base(lex::Tokens tokens, Usize open) {
    if (open < 4) return false;
    return tokens[open - 4].kind == lex::kw_enum && tokens[open - 2].kind == lex::colon && !tokens[open - 1].line_break;
}

// `enum Name : u8 {` is `enum Name(u8):` (#2334): the `(` takes the place of the ` : `, and `colon_for` closes it.
static void enum_base_cut(lex::Tokens tokens, Brace brace, Cuts *cuts) {
    if (!enum_base(tokens, brace.open)) return;
    add_cut(cuts, tokens[brace.open - 3].span.end, tokens[brace.open - 1].span.start, "(");
}

// What the `{` becomes: `:`, or nothing after the `:` of a `case .a: {` label, which already ends the header.
static Str colon_for(lex::Tokens tokens, Usize open) {
    Str none = "";
    Str colon = ":";
    if (enum_base(tokens, open)) return "):";
    return open > 0 && tokens[open - 1].kind == lex::colon ? none : colon;
}

// Whether the block is the arms of a `match`: its header line starts with `match`.
static Bool match_header(lex::Tokens tokens, Usize open) {
    Usize i = open;
    while (i > 0 && !tokens[i - 1].line_break)
        i -= 1;
    while (i < open && tokens[i].kind == lex::right_brace)
        i += 1;
    return tokens[i].kind == lex::kw_match;
}

// The arms of a `match { .a => x }` as `match:` arms: each line is indented one step more than the header (when it is
// not already), and an arm's `=>` is `:`.
static void match_arms(Str source, lex::Tokens tokens, Brace brace, Cuts *cuts) {
    if (brace.close == brace.open + 1 || !match_header(tokens, brace.open)) return;
    Bool shift =
        indent_of(source, tokens[brace.open + 1].span.start) <= indent_of(source, tokens[brace.open].span.start);
    Usize nest = 0;
    for (Usize i = brace.open + 1; i < brace.close; i++) {
        lex::TokenKind kind = tokens[i].kind;
        Bool closer = kind == lex::right_brace && tokens[i + 1].kind != lex::kw_else; // its line goes
        if (shift && tokens[i - 1].line_break && !closer) {
            Usize at = line_start(source, tokens[i].span.start);
            add_cut(cuts, at, at, spaces(step));
        }
        if (kind == lex::left_paren || kind == lex::left_bracket || kind == lex::left_brace) nest += 1;
        if (kind == lex::right_paren || kind == lex::right_bracket || kind == lex::right_brace) nest -= 1;
        if (kind == lex::fat_arrow && nest == 0)
            add_cut(cuts, spaces_before(source, tokens[i].span.start), tokens[i].span.end, ":");
    }
}

// `else { g(2,\n 3) }`: the braces the parser gave the unbraced body of an `else` hold one statement that starts on
// the `{`'s line and ends on the `}`'s, which ends its line.
static Bool else_one_statement(lex::Tokens tokens, Brace brace) {
    if (brace.open == 0 || tokens[brace.open - 1].kind != lex::kw_else) return false;
    if (open_ends_line(tokens, brace.open) || tokens[brace.close - 1].line_break) return false;
    return closes_cleanly(tokens, brace.close) && tokens[brace.close].line_break;
}

// The `{` becomes `:` and the statement moves to a line of its own, one step in; the ` }` goes.
static void else_statement(Str source, lex::Tokens tokens, Brace brace, Cuts *cuts) {
    lex::Token open = tokens[brace.open];
    lex::Token close = tokens[brace.close];
    Usize indent = indent_of(source, open.span.start);
    Str head = as_str(format::push(":\n", spaces(indent + step)));
    add_cut(cuts, spaces_before(source, open.span.start), tokens[brace.open + 1].span.start, head);
    add_cut(cuts, spaces_before(source, close.span.start), close.span.end, "");
}

// Whether a token that ends a line makes the next line continue it: a binary operator.
static Bool operator_ends_line(lex::TokenKind kind) {
    switch (kind) {
    case lex::ampersand_ampersand:
    case lex::pipe_pipe:
    case lex::equal_equal:
    case lex::bang_equal:
    case lex::less:
    case lex::greater:
    case lex::less_equal:
    case lex::greater_equal:
    case lex::plus:
    case lex::minus:
    case lex::star:
    case lex::slash:
    case lex::percent:
    case lex::ampersand:
    case lex::pipe:
    case lex::caret:
        return true;
    default:
        return false;
    }
}

// Whether the `{` closes a statement header (`while`, `for`, `if`, `else`) whose empty body needs a statement.
static Bool does_nothing_body(lex::Tokens tokens, Usize open) {
    Usize i = open;
    for (Usize lines = 0; lines < 64; lines++) {
        while (i > 0 && !tokens[i - 1].line_break)
            i -= 1;
        // A condition that goes on over several lines (`while f() !=\n 0 {`) starts on the line before (#2643).
        if (i > 0 && operator_ends_line(tokens[i - 1].kind)) {
            i -= 1;
            continue;
        }
        break;
    }
    if (i < open && tokens[i].kind == lex::right_brace) i += 1;
    lex::TokenKind kind = tokens[i].kind;
    return kind == lex::kw_while || kind == lex::kw_for || kind == lex::kw_if || kind == lex::kw_else;
}

// A block that spans lines: the `{` becomes `:` and the line of the `}` goes (or its `}` and the space after it when
// `else` follows, or the `}` alone when it ends the last statement's line).
static void multi_line(Str source, lex::Tokens tokens, Brace brace, Cuts *cuts) {
    lex::Token open = tokens[brace.open];
    lex::Token close = tokens[brace.close];
    if (else_one_statement(tokens, brace)) {
        else_statement(source, tokens, brace, cuts);
        return;
    }
    if (!multi_line_ready(tokens, brace)) return;
    enum_base_cut(tokens, brace, cuts);
    Str colon = colon_for(tokens, brace.open);
    if (brace.close == brace.open + 1 && does_nothing_body(tokens, brace.open))
        colon = as_str(format::push(colon, " ()"));
    add_cut(cuts, spaces_before(source, open.span.start), open.span.end, colon);
    if (!tokens[brace.close - 1].line_break) {
        add_cut(cuts, spaces_before(source, close.span.start), close.span.end, brace.tail);
        return;
    }
    Bool other = brace.close + 1 < countof(tokens) && !close.line_break && tokens[brace.close + 1].kind == lex::kw_else;
    if (other) {
        add_cut(cuts, close.span.start, tokens[brace.close + 1].span.start, "");
        return;
    }
    add_cut(cuts, line_start(source, close.span.start), after_line(source, close.span.end), brace.tail);
}

// The token of the `fn` that starts the lambda whose body opens at `open`: `fn(a: T) -> R {`. None (`open`) when the
// header is not a lambda that is an argument: the token before `fn` must be the `(` or the `,` of the call.
static Usize lambda_head(lex::Tokens tokens, Usize open) {
    Usize nest = 0;
    for (Usize back = 1; back < open; back++) {
        Usize i = open - back;
        lex::TokenKind kind = tokens[i].kind;
        if (kind == lex::right_paren) nest += 1;
        if (kind == lex::left_paren && nest > 0) nest -= 1;
        if (nest == 0 && kind == lex::kw_fn && tokens[i + 1].kind == lex::left_paren) {
            lex::TokenKind before = tokens[i - 1].kind;
            return before == lex::comma || before == lex::left_paren ? i : open;
        }
        if (tokens[i - 1].line_break) return open;
    }
    return open;
}

// A lambda with a body of several lines, the last argument of a call, is written after the call's parentheses
// (smith-dev-syntax-functions): `f(a, fn(x) {` ... `})` is `f(a) fn(x):` and the body, its `)` and the line of the
// `}` going (#3317). Left as it is when anything else follows the `)`, or the `}` shares its line with a statement.
static void trailing_lambda(Str source, lex::Tokens tokens, Brace brace, Cuts *cuts) {
    Usize head = lambda_head(tokens, brace.open);
    if (head == brace.open || brace.close + 2 >= countof(tokens)) return;
    if (tokens[brace.close - 1].line_break == false || tokens[brace.close + 1].kind != lex::right_paren) return;
    Usize last = brace.close + 1;
    if (tokens[last + 1].kind == lex::semicolon) last += 1;
    if (!tokens[last].line_break && tokens[last + 1].kind != lex::end_of_file) return;
    lex::Token before = tokens[head - 1];
    lex::Token fn_word = tokens[head];
    if (before.kind == lex::comma) {
        add_cut(cuts, before.span.start, fn_word.span.start, ") ");
    } else {
        add_cut(cuts, fn_word.span.start, fn_word.span.start, ") ");
    }
    lex::Token open = tokens[brace.open];
    add_cut(cuts, spaces_before(source, open.span.start), open.span.end, ":");
    add_cut(cuts, line_start(source, tokens[brace.close].span.start), after_line(source, tokens[last].span.end), "");
}

static Usize statement_start(lex::Tokens tokens, Usize at);

// Whether the `:` at `colon` ends the header of a lambda (`fn(a: T) -> R:`): going back over the parameters and the
// result, a `fn` that is followed by `(`.
static Bool ends_lambda_header(lex::Tokens tokens, Usize colon) {
    Usize nest = 0;
    for (Usize back = 1; back < colon; back++) {
        Usize i = colon - back;
        lex::TokenKind kind = tokens[i].kind;
        if (kind == lex::right_paren) nest += 1;
        if (kind == lex::left_paren && nest > 0) nest -= 1;
        if (nest == 0 && kind == lex::kw_fn) return tokens[i + 1].kind == lex::left_paren;
        if (nest == 0 && (kind == lex::equal || kind == lex::colon || kind == lex::semicolon)) return false;
        if (tokens[i - 1].line_break) return false;
    }
    return false;
}

// A statement expression `({ a: i32 = 5; a * 2 })` on one line (#3275) is a block value, `do:` with the statements and
// the last line as the value (smith-dev-syntax-values). A block cannot be written inside parentheses, where lines do
// not end a statement, so it goes on the lines before the statement that holds it, as the value of a name that takes
// its place: `block_value_N := do:` and the lines. Only a plain statement is rewritten: not a header (`if`, `while`,
// `for`, ...), whose condition would then be evaluated once, before the loop or the branch.
static Bool plain_statement(lex::TokenKind kind) {
    switch (kind) {
    case lex::kw_if:
    case lex::kw_else:
    case lex::kw_while:
    case lex::kw_for:
    case lex::kw_match:
    case lex::kw_fn:
    case lex::kw_defer:
    case lex::kw_errdefer:
        return false;
    default:
        return true;
    }
}

// The offsets of the `;` that end a statement between the braces `open` and `close`, at the level of the block; the
// last one is `close` itself when the text ends without a `;`. Empty when there is none.
static Usize statements_in(lex::Tokens tokens, Usize open, Usize close, Usize ends[:]) {
    Usize nest = 0;
    Usize n = 0;
    Usize from = open + 1;
    for (Usize i = open + 1; i < close; i++) {
        lex::TokenKind kind = tokens[i].kind;
        if (kind == lex::left_paren || kind == lex::left_bracket || kind == lex::left_brace) nest += 1;
        if (kind == lex::right_paren || kind == lex::right_bracket || kind == lex::right_brace) nest -= 1;
        if (nest == 0 && kind == lex::semicolon) {
            if (i > from) {
                ends[n] = i;
                n += 1;
            }
            from = i + 1;
        }
    }
    if (from < close) {
        ends[n] = close;
        n += 1;
    }
    return n;
}

static void statement_expressions(Str source, lex::Tokens tokens, Braces braces, Cuts *cuts) {
    for (Usize b = 0; b < countof(braces); b++) {
        Brace brace = braces[b];
        if (brace.skip || brace.block || brace.close == brace.open + 1 || brace.open == 0) continue;
        if (tokens[brace.open - 1].kind != lex::left_paren || brace.close + 1 >= countof(tokens)) continue;
        if (tokens[brace.close + 1].kind != lex::right_paren || !same_line(tokens, brace.open, brace.close)) continue;
        Usize first = statement_start(tokens, brace.open);
        if (!plain_statement(tokens[first].kind) || (first > 0 && !tokens[first - 1].line_break)) continue;
        Usize ends[:] = {};
        ends = mem::realloc(ends, brace.close - brace.open);
        Usize n = statements_in(tokens, brace.open, brace.close, ends);
        // One expression is no block: it stays, and so does a text with a statement ending in `}` that another cut
        // owns.
        if (n < 2) continue;
        Usize indent = indent_of(source, tokens[first].span.start);
        Str name = as_str(format::push("block_value_", tokens[brace.open].span.start));
        Str lines = as_str(format::push(spaces(indent), name, " := do:\n"));
        Usize from = brace.open + 1;
        for (Usize k = 0; k < n; k++) {
            Usize last = ends[k];
            Str text = source[tokens[from].span.start:tokens[last - 1].span.end];
            lines = as_str(format::push(lines, spaces(indent + step), text, "\n"));
            from = last + 1;
        }
        add_cut(cuts, line_start(source, tokens[first].span.start), line_start(source, tokens[first].span.start),
                lines);
        add_cut(cuts, tokens[brace.open - 1].span.start, tokens[brace.close + 1].span.end, name);
    }
}

// A one-line lambda whose body discards a value, `fn(): _ := f()`, is a declaration, and a declaration is a line of its
// own: the body moves to the next line, one step deeper than the statement (#3317).
static void discard_bodies(Str source, lex::Tokens tokens, Cuts *cuts) {
    Str underscore = "_";
    for (Usize i = 1; i + 2 < countof(tokens); i++) {
        if (tokens[i].kind != lex::colon || tokens[i].line_break || tokens[i + 1].kind != lex::name) continue;
        if (tokens[i + 2].kind != lex::colon_equal || !mem::equal(lex::text(source, tokens[i + 1]), underscore))
            continue;
        if (!ends_lambda_header(tokens, i)) continue;
        Usize indent = indent_of(source, tokens[statement_start(tokens, i)].span.start);
        add_cut(cuts, tokens[i].span.end, tokens[i + 1].span.start, as_str(format::push("\n", spaces(indent + step))));
    }
}

// Whether the token at `at` starts a field that follows another one with no separator between them (an earlier fixer
// drops the `;`): `pub`, or a name followed by `:`, after anything but a separator, a `:` or `pub` (#2520).
static Bool starts_field(lex::Tokens tokens, Usize at, Usize open) {
    if (at <= open + 1) return false;
    lex::TokenKind kind = tokens[at].kind;
    lex::TokenKind before = tokens[at - 1].kind;
    if (before == lex::comma || before == lex::semicolon || before == lex::colon || before == lex::kw_pub ||
        before == lex::colon_colon)
        return false;
    if (kind == lex::kw_pub) return true;
    return (kind == lex::name || kind == lex::type_name) && tokens[at + 1].kind == lex::colon;
}

// Whether a statement starts at the token after a `}` that closed a braced statement on the same line (`for ... { ... }
// return n`, #3275): a keyword that starts a statement, or a name. `else` and an operator continue the statement.
static Bool starts_statement(lex::TokenKind kind) {
    switch (kind) {
    case lex::kw_return:
    case lex::kw_if:
    case lex::kw_for:
    case lex::kw_while:
    case lex::kw_match:
    case lex::kw_defer:
    case lex::kw_errdefer:
    case lex::kw_break:
    case lex::kw_continue:
    case lex::name:
    case lex::type_name:
        return true;
    default:
        return false;
    }
}

// The fields or statements between the braces of a one-line block, one to a line at `depth` spaces. A statement that
// follows a `}` closing a braced statement starts a line of its own (#3275).
static Str lines_of(Str source, lex::Tokens tokens, Brace brace, Usize depth) {
    Str out = "";
    Usize from = tokens[brace.open + 1].span.start;
    Usize to = tokens[brace.close].span.start;
    Bool fields = declares_fields(tokens, brace.open);
    Usize start = from;
    Usize nest = 0;
    for (Usize i = brace.open + 1; i < brace.close; i++) {
        lex::TokenKind kind = tokens[i].kind;
        if (kind == lex::left_paren || kind == lex::left_bracket || kind == lex::left_brace) nest += 1;
        if (kind == lex::right_paren || kind == lex::right_bracket || kind == lex::right_brace) nest -= 1;
        if (fields && nest == 0 && starts_field(tokens, i, brace.open)) {
            out = as_str(format::push(out, "\n", spaces(depth), source[start:tokens[i - 1].span.end]));
            start = tokens[i].span.start;
        }
        if (!fields && nest == 0 && kind == lex::right_brace && i + 1 < brace.close &&
            starts_statement(tokens[i + 1].kind)) {
            out = as_str(format::push(out, "\n", spaces(depth), source[start:tokens[i].span.end]));
            start = tokens[i + 1].span.start;
        }
        if (fields && nest == 0 && (kind == lex::comma || kind == lex::semicolon)) {
            out = as_str(format::push(out, "\n", spaces(depth), source[start:tokens[i].span.start]));
            start = tokens[i + 1].span.start;
        }
    }
    if (start < to)
        out = as_str(format::push(out, "\n", spaces(depth), source[start:tokens[brace.close - 1].span.end]));
    return out;
}

// Whether the line of the `{` starts a statement or a declaration (`if`, `fn`, `struct`, ...), not a value: a block of
// `c := if a { b } else { d }` stays on its line.
static Bool statement_line(lex::Tokens tokens, Usize open) {
    Usize i = open;
    while (i > 0 && !tokens[i - 1].line_break)
        i -= 1;
    // `} else {`: the line is the `else` after the closers (#2225).
    while (i < open && tokens[i].kind == lex::right_brace)
        i += 1;
    switch (tokens[i].kind) {
    case lex::kw_if:
    case lex::kw_else:
    case lex::kw_while:
    case lex::kw_for:
    case lex::kw_match:
    case lex::kw_defer:
    case lex::kw_errdefer:
    case lex::kw_fn:
    case lex::kw_struct:
    case lex::kw_enum:
    case lex::kw_union:
    case lex::kw_pub:
    case lex::kw_static:
    case lex::kw_extern:
    case lex::kw_export:
    case lex::at:
        return true;
    default:
        return false;
    }
}

// The first token of the statement that ends just before token `at`: back to a token that starts a line outside every
// bracket.
static Usize statement_start(lex::Tokens tokens, Usize at) {
    Usize nest = 0;
    Usize t = at - 1;
    while (t > 0) {
        lex::TokenKind kind = tokens[t].kind;
        if (kind == lex::right_paren || kind == lex::right_bracket || kind == lex::right_brace) nest += 1;
        if ((kind == lex::left_paren || kind == lex::left_bracket || kind == lex::left_brace) && nest > 0) nest -= 1;
        lex::TokenKind before = tokens[t - 1].kind;
        // A condition goes on after a line that ends in `&&` or `||`, or that the next one opens with.
        Bool goes_on = before == lex::ampersand_ampersand || before == lex::pipe_pipe ||
                       kind == lex::ampersand_ampersand || kind == lex::pipe_pipe;
        if (nest == 0 && tokens[t - 1].line_break && !goes_on) break;
        t -= 1;
    }
    return t;
}

// A block whose body is on the line of its header. Inside parentheses it stays there (`fn(a): b`); elsewhere the body
// moves to its own line.
static void one_line(Str source, lex::Tokens tokens, Brace brace, Cuts *cuts) {
    lex::Token open = tokens[brace.open];
    lex::Token close = tokens[brace.close];
    Usize indent = indent_of(source, tokens[statement_start(tokens, brace.open)].span.start);
    Usize before = spaces_before(source, open.span.start);
    brace.inside = brace.inside || !statement_line(tokens, brace.open);
    Bool empty = brace.close == brace.open + 1;
    Bool else_next =
        brace.close + 1 < countof(tokens) && !close.line_break && tokens[brace.close + 1].kind == lex::kw_else;
    if (!brace.inside && !closes_cleanly(tokens, brace.close)) return;
    enum_base_cut(tokens, brace, cuts);
    Str body = "";
    if (!brace.inside && !empty) body = lines_of(source, tokens, brace, indent + step);
    // An empty loop or `if` body is written `()`, as an arm that does nothing is (#2328); a function or a type may be
    // empty.
    if (!brace.inside && empty && does_nothing_body(tokens, brace.open)) body = " ()";
    if (brace.inside) {
        add_cut(cuts, before, open.span.end, ":");
        // The body of a lambda in a call is an expression, and its value is the lambda's: `return` goes.
        if (!empty && tokens[brace.open + 1].kind == lex::kw_return && brace.close > brace.open + 2)
            add_cut(cuts, tokens[brace.open + 1].span.start, tokens[brace.open + 2].span.start, "");
        if (!empty) add_cut(cuts, tokens[brace.close - 1].span.end, close.span.end, "");
        // A lambda that does nothing has the body `()`, as an arm that does nothing has (#2328, #3317).
        if (empty) add_cut(cuts, open.span.end, close.span.end, " ()");
        return;
    }
    add_cut(cuts, before, close.span.end, as_str(format::push(colon_for(tokens, brace.open), body)));
    if (else_next)
        add_cut(cuts, close.span.end, tokens[brace.close + 1].span.start, as_str(format::push("\n", spaces(indent))));
}

// Whether the line of the `{` is a C signature that the fixer left as it is (`void f(auto x) {`, `pub usize g(auto y)
// {`): it has parentheses and no `fn`, `struct`, `enum` or `union`.
static Bool c_signature(lex::Tokens tokens, Usize open) {
    Usize i = open;
    while (i > 0 && !tokens[i - 1].line_break)
        i -= 1;
    Bool paren = false;
    Usize first = i;
    // A statement on the line of a one-line body (`for i in range(0, n) { ... }`, #3275) is no signature, which has a
    // type before its name; `if constexpr (...) {` and `for constexpr (...) {` at the top stay as they were.
    lex::TokenKind head = tokens[first].kind;
    Bool statement = head == lex::kw_for || head == lex::kw_while || head == lex::kw_if || head == lex::kw_else;
    if (statement && !(first + 1 < open && tokens[first + 1].kind == lex::kw_constexpr)) return false;
    for (; i < open; i++) {
        lex::TokenKind kind = tokens[i].kind;
        if (kind == lex::kw_fn || kind == lex::kw_struct || kind == lex::kw_enum || kind == lex::kw_union) return false;
        // A value, not a signature: `return if g() == 1 { a } else { b }` has `(` and no `fn` (#2328). A statement that
        // starts the line (`if constexpr (...) {` at the top) stays as it was.
        if (kind == lex::kw_return || kind == lex::kw_if || kind == lex::kw_match) {
            if (kind == lex::kw_return || i > first) return false;
        }
        if (kind == lex::left_paren) paren = true;
    }
    return paren;
}

// Marks every top-level block with a C signature, and the blocks inside it, as left alone.
static void mark_c_functions(lex::Tokens tokens, Braces braces) {
    Usize top = 0;
    Usize skipped = 0;
    for (Usize i = 0; i < countof(braces); i++) {
        if (braces[i].open < top) {
            braces[i].skip = braces[i].open < skipped;
            continue;
        }
        top = braces[i].close;
        if (braces[i].block && c_signature(tokens, braces[i].open)) {
            braces[i].skip = true;
            skipped = braces[i].close;
        }
    }
}

// Whether the block is the cases of a `switch` the fixer did not turn into a `match`: its header line starts with
// `switch`. The parser reads `switch (v) {` and not `switch (v):` (#2382), so it keeps its braces.
static Bool switch_header(lex::Tokens tokens, Usize open) {
    Usize i = open;
    while (i > 0 && !tokens[i - 1].line_break)
        i -= 1;
    while (i < open && tokens[i].kind == lex::right_brace)
        i += 1;
    return tokens[i].kind == lex::kw_switch;
}

// Marks every `switch` block, and the blocks inside it, as left alone.
static void mark_switches(lex::Tokens tokens, Braces braces) {
    Usize skipped = 0;
    for (Usize i = 0; i < countof(braces); i++) {
        if (braces[i].open < skipped) {
            braces[i].skip = true;
        } else if (braces[i].block && switch_header(tokens, braces[i].open)) {
            braces[i].skip = true;
            skipped = braces[i].close;
        }
    }
}

static Bool in_skipped(Braces braces, Usize at) {
    for (Usize i = 0; i < countof(braces); i++) {
        if (braces[i].skip && braces[i].open <= at && at <= braces[i].close) return true;
    }
    return false;
}

// Adjacent string literals on several lines are one expression; the lexer ends a statement after each, so they are
// wrapped in parentheses, where a line break is not a statement's end.
static void string_runs(lex::Tokens tokens, Braces braces, Cuts *cuts) {
    Bool group[:] = {};
    Usize i = 0;
    while (i < countof(tokens)) {
        lex::TokenKind kind = tokens[i].kind;
        if (kind == lex::string) {
            Usize last = i;
            while (last + 1 < countof(tokens) && tokens[last].line_break && tokens[last + 1].kind == lex::string)
                last += 1;
            Bool inside = countof(group) > 0 && group[countof(group) - 1];
            if (last > i && !inside && !in_skipped(braces, i)) {
                add_cut(cuts, tokens[i].span.start, tokens[i].span.start, "(");
                add_cut(cuts, tokens[last].span.end, tokens[last].span.end, ")");
            }
            i = last + 1;
            continue;
        }
        if (kind == lex::left_paren || kind == lex::left_bracket || kind == lex::left_brace) {
            group = mem::realloc(group, countof(group) + 1);
            group[countof(group) - 1] = kind != lex::left_brace;
        }
        if ((kind == lex::right_paren || kind == lex::right_bracket || kind == lex::right_brace) && countof(group) > 0)
            group = mem::realloc(group, countof(group) - 1);
        i += 1;
    }
}

// The first token of kind `kind` between `from` and `to` that is not inside brackets of its own, else `to`.
static Usize find_flat(lex::Tokens tokens, Usize from, Usize to, lex::TokenKind kind) {
    Usize nest = 0;
    for (Usize i = from; i < to; i++) {
        lex::TokenKind here = tokens[i].kind;
        if (nest == 0 && here == kind) return i;
        if (here == lex::left_paren || here == lex::left_bracket || here == lex::left_brace) nest += 1;
        if (here == lex::right_paren || here == lex::right_bracket || here == lex::right_brace) nest -= 1;
    }
    return to;
}

// The `)` that closes the `(` at `open`.
static Usize close_paren(lex::Tokens tokens, Usize open) {
    Usize nest = 0;
    for (Usize i = open; i < countof(tokens); i++) {
        if (tokens[i].kind == lex::left_paren) nest += 1;
        if (tokens[i].kind == lex::right_paren) {
            nest -= 1;
            if (nest == 0) return i;
        }
    }
    return open;
}

// A further declarator of the init: `chunk = 0` of `usize at = 0, chunk = 0`.
struct Init {
    Str name;
    Str value;
    Bool pointer; // written `*name = value`: its type is the first one's base type and a `*`
};

typedef typeof(Init[:]) Inits;

// The header of a C `for (init; condition; step)`.
struct Header {
    Bool ok;
    Usize close; // the `)`
    Bool has_init;
    Bool has_type; // the init declares its name: `usize i = 0`
    Bool raw;      // the init is a statement written as it is
    Str name;
    Str type;
    Str value;
    Inits more; // the declarators after the first, which share its type
    Str condition;
    Str step; // the steps of the header, one to a line
};

// The step as the new syntax writes it: `i++` is `i += 1`.
static Str step_text(Str source, lex::Tokens tokens, Usize from, Usize to) {
    if (from >= to) return "";
    Usize n = to - from;
    lex::TokenKind a = tokens[from].kind;
    lex::TokenKind b = tokens[to - 1].kind;
    Str name = "";
    if (n == 2) name = source[tokens[from + 1].span.start:tokens[from + 1].span.end];
    if (n == 2 && a == lex::name && b == lex::plus_plus)
        return as_str(format::push(source[tokens[from].span.start:tokens[from].span.end], " += 1"));
    if (n == 2 && a == lex::name && b == lex::minus_minus)
        return as_str(format::push(source[tokens[from].span.start:tokens[from].span.end], " -= 1"));
    if (n == 2 && a == lex::plus_plus) return as_str(format::push(name, " += 1"));
    if (n == 2 && a == lex::minus_minus) return as_str(format::push(name, " -= 1"));
    return source[tokens[from].span.start:tokens[to - 1].span.end];
}

// The steps `a++, b--` between `from` and `to`, one to a line.
static Str steps_text(Str source, lex::Tokens tokens, Usize from, Usize to) {
    Str out = "";
    while (from < to) {
        Usize comma = find_flat(tokens, from, to, lex::comma);
        Str one = step_text(source, tokens, from, comma);
        out = countof(out) == 0 ? one : as_str(format::push(out, "\n", one));
        from = comma + 1;
    }
    return out;
}

// The declarators `b = 1, c = 2` after the first one of an init, from `from` to `to`; false for any other form.
static Bool read_more(Str source, lex::Tokens tokens, Usize from, Usize to, Header *h) {
    while (from < to) {
        Usize comma = find_flat(tokens, from, to, lex::comma);
        Usize skip = tokens[from].kind == lex::star ? 1 : 0;
        if (comma < from + skip + 3 || tokens[from + skip].kind != lex::name ||
            tokens[from + skip + 1].kind != lex::equal)
            return false;
        Usize n = from + skip;
        h->more = mem::realloc(h->more, countof(h->more) + 1);
        h->more[countof(h->more) - 1] = (Init){.name = source[tokens[n].span.start:tokens[n].span.end],
                                               .value = source[tokens[n + 2].span.start:tokens[comma - 1].span.end],
                                               .pointer = skip == 1};
        from = comma + 1;
    }
    return true;
}

// The init `T name = value` (or `name = value`) of the header, between `from` and `to`.
static void read_init(Str source, lex::Tokens tokens, Usize from, Usize to, Header *h) {
    if (from >= to) {
        h->ok = true;
        return;
    }
    Usize equal = find_flat(tokens, from, to, lex::equal);
    Usize comma = find_flat(tokens, from, to, lex::comma);
    if (comma != to && (equal >= comma || !read_more(source, tokens, comma + 1, to, h))) return;
    to = comma;
    if (equal == to) {
        // A statement that is not a declaration (`at += 7`): written as it is, before the loop.
        h->has_init = true;
        h->raw = true;
        h->value = source[tokens[from].span.start:tokens[to - 1].span.end];
        h->ok = true;
        return;
    }
    if (equal == from || equal + 1 >= to) return;
    lex::TokenKind kind = tokens[equal - 1].kind;
    if (kind != lex::name && kind != lex::type_name) return;
    h->has_init = true;
    h->has_type = equal - 1 > from;
    h->name = source[tokens[equal - 1].span.start:tokens[equal - 1].span.end];
    if (h->has_type) h->type = source[tokens[from].span.start:spaces_before(source, tokens[equal - 1].span.start)];
    h->value = source[tokens[equal + 1].span.start:tokens[to - 1].span.end];
    h->ok = true;
}

// Reads `for (init; condition; step)` at the `for` token `at`; not `ok` for any other header.
static Header read_header(Str source, lex::Tokens tokens, Usize at) {
    Header h = {};
    if (at + 1 >= countof(tokens) || tokens[at + 1].kind != lex::left_paren) return h;
    Usize close = close_paren(tokens, at + 1);
    Usize first = find_flat(tokens, at + 2, close, lex::semicolon);
    Usize second = find_flat(tokens, first + 1, close, lex::semicolon);
    if (close == at + 1 || first == close || second == close) return h;
    if (find_flat(tokens, second + 1, close, lex::semicolon) != close) return h;
    h.close = close;
    read_init(source, tokens, at + 2, first, &h);
    h.condition = "true";
    if (second > first + 1) h.condition = source[tokens[first + 1].span.start:tokens[second - 1].span.end];
    h.step = steps_text(source, tokens, second + 1, close);
    return h;
}

// A name a loop declared, and the innermost block it is in (1 + the index in the list of braces, 0 for none).
struct Declared {
    Str name;
    Usize scope;
};

typedef typeof(Declared[:]) Declareds;

static Usize scope_of(Braces braces, Usize at) {
    Usize found = 0;
    for (Usize i = 0; i < countof(braces); i++) {
        if (braces[i].open < at && at < braces[i].close) found = i + 1;
    }
    return found;
}

static Bool visible(Braces braces, Usize earlier, Usize here) {
    if (earlier == here || earlier == 0) return true;
    if (here == 0) return false;
    return braces[earlier - 1].open < braces[here - 1].open && braces[here - 1].close < braces[earlier - 1].close;
}

static Bool declared_before(Braces braces, Declareds seen, Str name, Usize scope) {
    for (Usize i = 0; i < countof(seen); i++) {
        if (mem::equal(seen[i].name, name) && visible(braces, seen[i].scope, scope)) return true;
    }
    return false;
}

static Bool has_continue(lex::Tokens tokens, Usize from, Usize to) {
    for (Usize i = from; i < to; i++) {
        if (tokens[i].kind == lex::kw_continue) return true;
    }
    return false;
}

// The brace of the block that opens at the token `open`, or the length of the list.
static Usize brace_at(Braces braces, Usize open) {
    for (Usize i = 0; i < countof(braces); i++) {
        if (braces[i].open == open) return i;
    }
    return countof(braces);
}

// The lines of an unbraced body: those after the header's line that are blank or indented deeper than the `for`. The
// offset after the last one that holds text, or 0 when there is none; `indent` is the first one's indentation.
static Usize unbraced_end(Str source, Usize header_end, Usize indent, Usize *body_indent) {
    Usize at = after_line(source, header_end);
    Usize end = 0;
    *body_indent = 0;
    while (at < countof(source)) {
        Usize n = indent_of(source, at);
        Bool blank = at + n >= countof(source) || source[at + n] == '\n';
        if (!blank && n <= indent) break;
        if (!blank && end == 0) *body_indent = n;
        at = after_line(source, at);
        if (!blank) end = at;
    }
    return end;
}

// The type of the declarators after the first: the first one's type without its `*`s, and a `*` for `*name`.
static Str more_type(Str first, Bool pointer) {
    Usize end = countof(first);
    while (end > 0 && (first[end - 1] == '*' || first[end - 1] == ' '))
        end -= 1;
    Str base = first[0:end];
    return pointer ? as_str(format::push(base, " *")) : base;
}

// What the header becomes: the declaration of the counter on its own line, then `while condition`.
static Str while_head(Header h, Bool declare, Usize indent) {
    Str out = "";
    if (h.has_init) {
        Str line = as_str(format::push(h.name, " = ", h.value));
        if (h.raw) line = h.value;
        if (declare) {
            Str automatic = "auto";
            Str kind = "";
            if (h.has_type && !mem::equal(h.type, automatic)) kind = as_str(format::push(": ", h.type));
            line = as_str(format::push("mut ", h.name, kind, " = ", h.value));
            for (Usize i = 0; i < countof(h.more); i++) {
                Str more = "";
                if (h.has_type && !mem::equal(h.type, automatic))
                    more = as_str(format::push(": ", more_type(h.type, h.more[i].pointer)));
                line = as_str(
                    format::push(line, "\n", spaces(indent), "mut ", h.more[i].name, more, " = ", h.more[i].value));
            }
        } else {
            for (Usize i = 0; i < countof(h.more); i++)
                line = as_str(format::push(line, "\n", spaces(indent), h.more[i].name, " = ", h.more[i].value));
        }
        out = as_str(format::push(line, "\n", spaces(indent)));
    }
    return as_str(format::push(out, "while ", h.condition));
}

static Bool has_continue_before(lex::Tokens tokens, Usize from, Usize offset) {
    for (Usize i = from; i < countof(tokens) && tokens[i].span.start < offset; i++) {
        if (tokens[i].kind == lex::kw_continue) return true;
    }
    return false;
}

// Whether the header line of the block opened at `open` starts with `for` or `while`.
static Bool loop_block(lex::Tokens tokens, Usize open) {
    Usize at = open;
    while (at > 0 && !tokens[at - 1].line_break)
        at -= 1;
    return tokens[at].kind == lex::kw_for || tokens[at].kind == lex::kw_while;
}

// Whether the `continue` at `at` belongs to the loop whose block opens at `open`: no loop between them holds it.
static Bool continues_loop(lex::Tokens tokens, Braces braces, Usize open, Usize at) {
    for (Usize i = 0; i < countof(braces); i++) {
        Brace inner = braces[i];
        if (inner.open > open && inner.open < at && at < inner.close && loop_block(tokens, inner.open)) return false;
    }
    return true;
}

// The step is written before each `continue` of the loop, since the jump would skip the step at the end. False when
// one of them does not start its line, where nothing can be put before it.
// The steps, one to a line, each line indented `indent`.
static Str step_lines(Str steps, Usize indent) {
    Str out = "";
    Usize from = 0;
    for (Usize i = 0; i < countof(steps); i++) {
        if (steps[i] != '\n') continue;
        out = as_str(format::push(out, steps[from:i], "\n", spaces(indent)));
        from = i + 1;
    }
    return as_str(format::push(out, steps[from:countof(steps)]));
}

static Bool step_before_continues(Str source, lex::Tokens tokens, Braces braces, Header h, Usize which, Cuts *cuts) {
    Usize open = braces[which].open;
    for (Usize i = open + 1; i < braces[which].close; i++) {
        if (tokens[i].kind != lex::kw_continue || !continues_loop(tokens, braces, open, i)) continue;
        if (!tokens[i - 1].line_break) return false;
    }
    for (Usize i = open + 1; i < braces[which].close; i++) {
        if (tokens[i].kind != lex::kw_continue || !continues_loop(tokens, braces, open, i)) continue;
        Usize at_indent = indent_of(source, tokens[i].span.start);
        Str line = as_str(format::push(step_lines(h.step, at_indent), "\n", spaces(at_indent)));
        add_cut(cuts, tokens[i].span.start, tokens[i].span.start, line);
    }
    return true;
}

// The body in braces: it is converted by the block pass, and the step becomes its tail. False when the loop is left.
static Bool braced_for(Str source, lex::Tokens tokens, Braces braces, Header h, Cuts *cuts) {
    Usize which = brace_at(braces, h.close + 1);
    if (which == countof(braces) || !braces[which].block || braces[which].skip) return false;
    Usize open = braces[which].open;
    Usize close = braces[which].close;
    Bool one_line = same_line(tokens, open, close);
    if (countof(h.step) == 0) return one_line || multi_line_ready(tokens, braces[which]);
    if (one_line || !multi_line_ready(tokens, braces[which])) return false;
    if (has_continue(tokens, open, close) && !step_before_continues(source, tokens, braces, h, which, cuts))
        return false;
    Usize body_at = indent_of(source, tokens[open + 1].span.start);
    Str line = as_str(format::push(spaces(body_at), step_lines(h.step, body_at)));
    braces[which].tail =
        tokens[close - 1].line_break ? as_str(format::push(line, "\n")) : as_str(format::push("\n", line));
    return true;
}

// The body of the lines under the header: the step is added after the last of them. False when the loop is left.
static Bool unbraced_for(Str source, lex::Tokens tokens, Header h, Usize indent, Cuts *cuts) {
    if (!tokens[h.close].line_break) return false;
    Usize body_indent = 0;
    Usize end = unbraced_end(source, tokens[h.close].span.end, indent, &body_indent);
    if (end == 0) return false;
    if (countof(h.step) == 0) return true;
    if (has_continue_before(tokens, h.close, end)) return false;
    add_cut(cuts, end, end, as_str(format::push(spaces(body_indent), step_lines(h.step, body_indent), "\n")));
    return true;
}

// One C `for` at the token `at`, written as `while`: the cut of its header, and the line of the step.
static void one_for(Str source, lex::Tokens tokens, Braces braces, Usize at, Declareds *seen, Cuts *cuts) {
    Header h = read_header(source, tokens, at);
    if (!h.ok) return;
    Usize indent = indent_of(source, tokens[at].span.start);
    Usize scope = scope_of(braces, at);
    Bool declare = h.has_type && !declared_before(braces, *seen, h.name, scope);
    Str head = while_head(h, declare, indent);
    if (h.close + 1 < countof(tokens) && tokens[h.close + 1].kind == lex::left_brace) {
        if (!braced_for(source, tokens, braces, h, cuts)) return;
    } else {
        if (!unbraced_for(source, tokens, h, indent, cuts)) return;
        head = as_str(format::push(head, ":"));
    }
    add_cut(cuts, tokens[at].span.start, tokens[h.close].span.end, head);
    if (!declare) return;
    *seen = mem::realloc(*seen, countof(*seen) + 1);
    (*seen)[countof(*seen) - 1] = (Declared){.name = h.name, .scope = scope};
    for (Usize i = 0; i < countof(h.more); i++) {
        *seen = mem::realloc(*seen, countof(*seen) + 1);
        (*seen)[countof(*seen) - 1] = (Declared){.name = h.more[i].name, .scope = scope};
    }
}

// A `for constexpr (init; condition; step)` with its body on the lines under it: the header stays (it is unrolled at
// compile time, never a `while`), and gets the `:` that starts the indented body.
static void constexpr_for(Str source, lex::Tokens tokens, Usize at, Cuts *cuts) {
    if (at + 2 >= countof(tokens) || tokens[at + 1].kind != lex::kw_constexpr) return;
    if (tokens[at + 2].kind != lex::left_paren) return;
    Usize close = close_paren(tokens, at + 2);
    if (close == at + 2 || close + 1 >= countof(tokens)) return;
    if (tokens[close + 1].kind == lex::left_brace || !tokens[close].line_break) return;
    Usize body_indent = 0;
    Usize indent = indent_of(source, tokens[at].span.start);
    if (unbraced_end(source, tokens[close].span.end, indent, &body_indent) == 0) return;
    add_cut(cuts, tokens[close].span.end, tokens[close].span.end, ":");
}

// Every C `for (init; condition; step)` that starts its line, outside the functions left alone.
static void c_for_loops(Str source, lex::Tokens tokens, Braces braces, Cuts *cuts) {
    Declareds seen = {};
    for (Usize i = 0; i < countof(tokens); i++) {
        if (tokens[i].kind != lex::kw_for || in_skipped(braces, i)) continue;
        if (i > 0 && !tokens[i - 1].line_break) continue;
        constexpr_for(source, tokens, i, cuts);
        one_for(source, tokens, braces, i, &seen, cuts);
    }
}

static Str apply(Str source, Cuts cuts) {
    Str out = "";
    Usize from = 0;
    for (Usize i = 0; i < countof(cuts); i++) {
        Usize best = i;
        for (Usize j = i + 1; j < countof(cuts); j++) {
            if (cuts[j].start < cuts[best].start) best = j;
        }
        Cut taken = cuts[best];
        cuts[best] = cuts[i];
        cuts[i] = taken;
        // A cut inside the text of an earlier one (a one-line block in the body of another) waits for the next round
        // (#2310).
        if (taken.start < from) continue;
        out = as_str(format::push(out, source[from:taken.start], taken.text));
        from = taken.end;
    }
    return as_str(format::push(out, source[from:countof(source)]));
}

// Whether the line that starts at the `.` is the arm of a `match` (`.b => x`, `.b(v), .c: x`): a `=>` or a `:` outside
// every bracket before the line ends.
static Bool arm_line(lex::Tokens tokens, Usize dot) {
    Usize nest = 0;
    for (Usize i = dot; i < countof(tokens); i++) {
        lex::TokenKind kind = tokens[i].kind;
        if (kind == lex::left_paren || kind == lex::left_bracket || kind == lex::left_brace) nest += 1;
        if ((kind == lex::right_paren || kind == lex::right_bracket || kind == lex::right_brace) && nest > 0) nest -= 1;
        if (nest == 0 && (kind == lex::fat_arrow || kind == lex::colon)) return true;
        if (nest == 0 && tokens[i].line_break) return false;
    }
    return false;
}

// Whether the `.` starts a line that goes on the line before it: `.name` after a `)`, `]` or a name. The first token
// of a `match` arm (`.b => x`) starts its own line.
static Bool continues_line(lex::Tokens tokens, Usize dot) {
    if (dot == 0 || dot + 1 >= countof(tokens) || !tokens[dot - 1].line_break) return false;
    if (tokens[dot].kind != lex::dot) return false;
    lex::TokenKind before = tokens[dot - 1].kind;
    if (before != lex::right_paren && before != lex::right_bracket && before != lex::name) return false;
    return tokens[dot + 1].kind == lex::name && !arm_line(tokens, dot);
}

// A `{ continue }` on one line is put on lines of its own, so that the loop it is in can write its step before the
// `continue` (`if (c) continue;` in a C `for` is this after the braces are added, #2224).
static void lonely_continues(Str source, lex::Tokens tokens, Braces braces, Cuts *cuts) {
    for (Usize i = 0; i < countof(braces); i++) {
        Brace brace = braces[i];
        if (!brace.block || brace.inside || brace.close != brace.open + 2) continue;
        if (tokens[brace.open + 1].kind != lex::kw_continue || !same_line(tokens, brace.open, brace.close)) continue;
        Usize indent = indent_of(source, tokens[brace.open].span.start);
        add_cut(cuts, tokens[brace.open].span.end, tokens[brace.open + 1].span.start,
                as_str(format::push("\n", spaces(indent + step))));
        add_cut(cuts, tokens[brace.open + 1].span.end, tokens[brace.close].span.start,
                as_str(format::push("\n", spaces(indent))));
    }
}

// The indentation of the header that the block opening at the token `open` belongs to. A `} else {` that follows a body
// on the same line (`d = 1 } else if c {`) belongs to the header of the block that closed there, not to the line.
static Usize header_indent(Str source, lex::Tokens tokens, Braces braces, Usize open) {
    Usize at = open;
    Usize t = at;
    while (t > 0 && !tokens[t - 1].line_break) {
        t -= 1;
        if (tokens[t].kind != lex::right_brace) continue;
        for (Usize j = 0; j < countof(braces); j++) {
            if (braces[j].close != t) continue;
            at = braces[j].open;
            t = at;
            break;
        }
    }
    // A condition over several lines puts the `{` on its last line: the header starts on the first.
    return indent_of(source, tokens[statement_start(tokens, at)].span.start);
}

// The text with the forms that stop `convert` from reading a block made plain (#2225): a `}` that follows the last
// statement of a multi-line block on the same line (`g(i) } }`, `low = m } else {`) goes to a line of its own, at the
// indentation of the block's header; and a line that starts with `.name` after a `)`, `]` or a name
// (`format.push(a,\n b)\n    .data`) joins the line before it. The same text when neither is there.
static Str plain_forms(Str source) {
    lex::Lexed lexed = lex::tokenize_new(source);
    if (lexed == .error) return source;
    lex::Tokens tokens = lexed.ok;
    Braces braces = braces_of(tokens);
    Cuts cuts = {};
    for (Usize i = 0; i < countof(braces); i++) {
        Brace brace = braces[i];
        if (!brace.block || brace.inside || !open_ends_line(tokens, brace.open)) continue;
        if (tokens[brace.close - 1].line_break) continue;
        lex::Token close = tokens[brace.close];
        Usize indent = header_indent(source, tokens, braces, brace.open);
        add_cut(&cuts, spaces_before(source, close.span.start), close.span.start,
                as_str(format::push("\n", spaces(indent))));
    }
    for (Usize i = 1; i < countof(tokens); i++) {
        if (!continues_line(tokens, i)) continue;
        // `.ok(n)` on a line less indented than the one before is a variant of its own, the value of the last line
        // (#2575); a chain goes on the line before it only when it is indented under it.
        if (indent_of(source, tokens[i].span.start) <= indent_of(source, tokens[statement_start(tokens, i)].span.start))
            continue;
        add_cut(&cuts, tokens[i - 1].span.end, tokens[i].span.start, "");
    }
    lonely_continues(source, tokens, braces, &cuts);
    if (countof(cuts) == 0) return source;
    return apply(source, cuts);
}

static Usize line_end(Str source, Usize at) {
    while (at < countof(source) && source[at] != '\n')
        at += 1;
    return at;
}

static Usize leading_spaces(Str source, Usize from, Usize to) {
    Usize n = 0;
    while (from + n < to && source[from + n] == ' ')
        n += 1;
    return n;
}

// Whether the line from `from` to `to` ends with an assignment (`=`, `+=`), not a comparison, and holds nothing else
// that could be a comment.
static Bool ends_with_assign(Str source, Usize from, Usize to) {
    while (to > from && source[to - 1] == ' ')
        to -= 1;
    if (to - from < 2 || source[to - 1] != '=') return false;
    char before = source[to - 2];
    if (before == '=' || before == '!' || before == '<' || before == '>') return false;
    for (Usize i = from; i < to; i++) {
        if (source[i] == '#' || source[i] == '"') return false;
    }
    return true;
}

// Whether the line from `from` to `to`, at `indent`, is `if ...:`.
static Bool is_if_header(Str source, Usize from, Usize to, Usize indent) {
    Str keyword = "if ";
    if (to - from < indent + 4 || source[to - 1] != ':') return false;
    return mem::equal(source[from + indent:from + indent + 3], keyword);
}

// The end of the lines that follow `from` (the start of a line) and are indented more than `indent`, with the blank
// line and the end of the text stopping them; `from` itself when a line in them is indented less than `least`.
static Usize chain_end(Str source, Usize from, Usize indent, Usize least) {
    Usize at = from;
    while (at < countof(source)) {
        Usize end = line_end(source, at);
        Usize spaces_here = leading_spaces(source, at, end);
        if (end == at || spaces_here == end - at || spaces_here <= indent) break;
        if (spaces_here < least) return from;
        at = end < countof(source) ? end + 1 : end;
    }
    return at;
}

// A value written as an `if` on the lines after an assignment (`x =\n    if a:\n        1\n    else:\n        2`) is
// not read by the parser; the `if` goes on the line of the `=` and its lines come out one step, so the `else` is at the
// indentation of the statement (#2225). The same text when no line has this form.
static Str join_value_ifs(Str source) {
    Str out = "";
    Usize at = 0;
    // The lines from `kept` to `at` are unchanged: one push when a rewrite comes, not one per line (each copies `out`).
    Usize kept = 0;
    Bool changed = false;
    while (at < countof(source)) {
        Usize end = line_end(source, at);
        Usize next = end < countof(source) ? end + 1 : end;
        Usize indent = leading_spaces(source, at, end);
        Usize head_end = line_end(source, next);
        Usize stop = next;
        if (next < countof(source) && ends_with_assign(source, at, end) &&
            is_if_header(source, next, head_end, indent + step) &&
            leading_spaces(source, next, head_end) == indent + step) {
            stop = chain_end(source, next, indent, indent + step);
        }
        if (stop == next) {
            at = next;
            continue;
        }
        changed = true;
        out = as_str(format::push(out, source[kept:at]));
        Usize trimmed = end;
        while (source[trimmed - 1] == ' ')
            trimmed -= 1;
        out = as_str(format::push(out, source[at:trimmed], " ", source[next + indent + step:head_end], "\n"));
        at = head_end < countof(source) ? head_end + 1 : head_end;
        while (at < stop) {
            Usize line_to = line_end(source, at);
            Usize after = line_to < countof(source) ? line_to + 1 : line_to;
            out = as_str(format::push(out, source[at + step:after]));
            at = after;
        }
        kept = at;
    }
    if (!changed) return source;
    return as_str(format::push(out, source[kept:at]));
}

static Str convert_once(Str source) {
    for (Usize round = 0; round < 8; round++) {
        Str plain = plain_forms(source);
        if (mem::equal(plain, source)) break;
        source = plain;
    }
    lex::Lexed lexed = lex::tokenize_new(source);
    if (lexed == .error) return source;
    lex::Tokens tokens = lexed.ok;
    Braces braces = braces_of(tokens);
    mark_c_functions(tokens, braces);
    mark_switches(tokens, braces);
    // The arms of a `match` come first, alone: they move lines, which the other cuts read where they stand.
    Cuts arms = {};
    for (Usize i = 0; i < countof(braces); i++) {
        Brace brace = braces[i];
        if (!brace.block || brace.skip || brace.inside || same_line(tokens, brace.open, brace.close)) continue;
        if (multi_line_ready(tokens, brace)) match_arms(source, tokens, brace, &arms);
    }
    if (countof(arms) > 0) return apply(source, arms);
    Cuts cuts = {};
    string_runs(tokens, braces, &cuts);
    c_for_loops(source, tokens, braces, &cuts);
    statement_expressions(source, tokens, braces, &cuts);
    discard_bodies(source, tokens, &cuts);
    for (Usize i = 0; i < countof(braces); i++) {
        Brace brace = braces[i];
        if (!brace.block || brace.skip) continue;
        if (same_line(tokens, brace.open, brace.close)) {
            one_line(source, tokens, brace, &cuts);
        } else if (!brace.inside) {
            multi_line(source, tokens, brace, &cuts);
        } else {
            trailing_lambda(source, tokens, brace, &cuts);
        }
    }
    if (countof(cuts) == 0) return join_value_ifs(source);
    return join_value_ifs(apply(source, cuts));
}

// `convert_once` until the text stops changing: a one-line block inside another one-line block is cut in a later round.
export Str convert(Str source) {
    for (Usize round = 0; round < 8; round++) {
        Str next = convert_once(source);
        if (mem::equal(next, source)) break;
        source = next;
    }
    return source;
}
