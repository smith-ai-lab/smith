// front::emit_match: enumerations, `.red` and `match` (#1585 of #1428).
//
// An enumeration (`enum_decl`, pass 1). Its `Ty` is an integer of the underlying type (`enum Small: u8` is `u8`; with
// none written, `i32`, the checker's default), kind `integer`, `name` the enumeration's name. Being an integer is what
// makes `==`, `!=`, `c as u8` and `n as Color` and a zero value work with no change elsewhere; the checker keeps an
// enumeration apart from integers. Enumerators take their values in order from 0, or the written value (an integer
// literal); each one after a written value is the previous plus one. The enumeration goes in `Emitter.enums`.
// A payload enumeration (`circle: Circle`) is the kind `variant_enum`: `{ i32 tag, [N x i64] }`, the tag the variant's
// position, the payload stored through a pointer to the second field (#2140). `.circle(c)` builds one; `match` and
// `if let` read the tag and bind the payload.
//
// `.red` (`variant`) is the enumerator's value as a constant of the enumeration expected: the hint's type, else the
// checker's type of the node. With neither it is an Error that asks for the type.
//
// `match` (`match_stmt`, `value_of`) evaluates the scrutinee once and keeps it on the value stack (under the result
// slot, when the match is a value) while the arms run.
//   enumeration  one LLVM `switch`; a block per arm, each of the arm's patterns a case of that block
//                (`.green, .blue => ..`); a `_` arm is the default, else the default is a block with `unreachable`
//                (the checker proved every enumerator is named).
//   constants    a number, `char` or `bool` (#2336): the constant patterns are evaluated first with the scrutinee's
//   type
//                as hint; one `switch` when all are LLVM constants, else a chain of `icmp eq` in arm order; the
//                default is the `_` arm, else `unreachable` (the checker made sure the arms cover every value).
//   `?T`         a branch on `option::is_some`; `.some(x)` runs in a new scope with `x` a constant local holding
//                `option::payload`; `.some(_)` and `.none` bind nothing.
// As a statement each arm's value is evaluated and dropped. As a value each arm's value is evaluated with the hint
// (the match's expected type, else the checker's type of the first arm's value), converted, and stored in one slot
// that is loaded where the arms meet; one Value is pushed. An arm that already ended (`return`) gets no branch.
//
// An arm that is a statement (`return c`, or a block in a `match` that is a statement) runs as one and gives no value.
// Not here: `match` over `Result`, `switch`.
module front::emit_match;

import front::ast;
import front::emit_option as optional;
import front::emit_state as state;
import front::types;
import std::arena;
import std::mem;
import <llvm-c/Core.h>;

// The enumeration named `name`.
static Bool find_enum(state::Emitter *e, Str name, Usize *at) {
    for (Usize i = 0; i < e->enum_count; i++) {
        if (state::same_text(e->enums[i].name, name)) {
            *at = i;
            return true;
        }
    }
    return false;
}

// Names an enumeration of the module: false when `name` is none.
export Bool type_enum(state::Emitter *e, Str name, state::Ty *ty) {
    Usize at = 0;
    if (!find_enum(e, name, &at)) return false;
    *ty = e->enums[at].ty;
    return true;
}

// Frees `e->enums`.
export void release(state::Emitter *e) {
    for (Usize i = 0; i < e->enum_count; i++)
        mem::free(e->enums[i].items.data);
    mem::free(e->enums.data);
}

static void add_enum(state::Emitter *e, state::EnumType made) {
    if (e->enum_count == countof(e->enums)) {
        Usize capacity = countof(e->enums) * 2;
        if (capacity < 8) capacity = 8;
        e->enums = mem::realloc(e->enums, capacity);
    }
    e->enums[e->enum_count] = made;
    e->enum_count += 1;
}

// The values of `items`, in order from 0 or as written.
static state::Status enumerator_values(state::Emitter *e, const ast::Decl *d, state::Enumerator out[:]) {
    if (d->kind != .enumeration) {
        return state::fail("not an enumeration", d->span);
    }
    ast::Enumerator items[:] = d->kind.enumeration.items;
    U64 next = 0;
    for (Usize i = 0; i < countof(items); i++) {
        const ast::Expr *written = items[i].value;
        if (written != nullptr) {
            if (written->kind != .integer)
                return state::not_emitted("an enumerator value that is not an integer literal", written->span);
            next = written->kind.integer.value;
        }
        for (Usize j = 0; j < i; j++) {
            if (state::same_text(items[j].name, items[i].name))
                return state::failf(items[i].span, items[i].name, " is declared twice");
        }
        out[i] = (state::Enumerator){.name = items[i].name, .value = next};
        if (items[i].payload != nullptr) {
            state::TyResult made = state::type_of(e, items[i].payload);
            if (made == .error) {
                return {.error = made.error};
            }
            out[i].has_payload = true;
            out[i].payload = made.ok;
        }
        next += 1;
    }
    return state::success();
}

static Bool any_payload(state::Enumerator items[:]) {
    for (Usize i = 0; i < countof(items); i++) {
        if (items[i].has_payload) return true;
    }
    return false;
}

// A payload enumeration: `{ i32 tag, [N x i64] }`, N words holding the largest payload (the tag is the variant's
// position; the payload is read and written through a pointer to the second field).
static state::Ty variant_enum_type(state::Emitter *e, Str name, state::Enumerator items[:]) {
    U64 bytes = 8;
    for (Usize i = 0; i < countof(items); i++) {
        if (!items[i].has_payload) continue;
        U64 size = 64;
        if (e->target_data != nullptr) size = c::LLVMABISizeOfType(e->target_data, items[i].payload.llvm);
        if (size > bytes) bytes = size;
    }
    c::LLVMTypeRef fields[2];
    fields[0] = c::LLVMInt32TypeInContext(e->context);
    fields[1] = c::LLVMArrayType(c::LLVMInt64TypeInContext(e->context), (U32)((bytes + 7) / 8));
    state::Ty ty = {.kind = .variant_enum, .llvm = c::LLVMStructTypeInContext(e->context, fields, 2, false)};
    ty.name = name;
    return ty;
}

export state::Status enum_decl(state::Emitter *e, const ast::Decl *d) {
    if (d->kind != .enumeration) {
        return state::fail("not an enumeration", d->span);
    }
    Str name = d->kind.enumeration.name;
    Usize at = 0;
    if (find_enum(e, name, &at)) return state::failf(d->span, name, " is declared twice");
    state::Ty base = {};
    if (d->kind.enumeration.underlying == nullptr) {
        state::scalar_type(e, "i32", &base);
    } else {
        state::TyResult made = state::type_of(e, d->kind.enumeration.underlying);
        if (made == .error) {
            return {.error = made.error};
        }
        base = made.ok;
    }
    if (base.kind != .integer) {
        return state::failf(d->span, "an enumeration is an integer type, not ", base.name);
    }
    Usize count = countof(d->kind.enumeration.items);
    state::Enumerator items[:] = mem::alloc_slice(state::Enumerator, count + 1);
    state::Status status = enumerator_values(e, d, items);
    if (status == .error) {
        mem::free(items.data);
        return status;
    }
    if (any_payload(items[0:count])) base = variant_enum_type(e, name, items[0:count]);
    base.name = name;
    add_enum(e, (state::EnumType){.name = name, .ty = base, .items = items[0:count]});
    return state::success();
}

// The enumerator `name` of the enumeration `at`.
static Bool find_enumerator(state::Emitter *e, Usize at, Str name, U64 *value) {
    state::Enumerator items[:] = e->enums[at].items;
    for (Usize i = 0; i < countof(items); i++) {
        if (state::same_text(items[i].name, name)) {
            *value = items[i].value;
            return true;
        }
    }
    return false;
}

// The position of the enumerator `name` in the enumeration `at`.
static Usize enumerator_index(state::Emitter *e, Usize at, Str name) {
    state::Enumerator items[:] = e->enums[at].items;
    for (Usize i = 0; i < countof(items); i++) {
        if (state::same_text(items[i].name, name)) return i;
    }
    return 0;
}

// The enumeration `.red` stands for: the hint's type, else the checker's.
static Bool enum_expected(state::Emitter *e, const ast::Expr *x, state::Hint hint, Usize *at) {
    if (hint.present && (hint.ty.kind == .integer || hint.ty.kind == .variant_enum) && find_enum(e, hint.ty.name, at))
        return true;
    state::TyResult checked = state::type_of_node(e, x);
    if (checked == .error) {
        state::free_text(checked.error.message);
        return false;
    }
    return (checked.ok.kind == .integer || checked.ok.kind == .variant_enum) && find_enum(e, checked.ok.name, at);
}

static c::LLVMValueRef tag_constant(state::Emitter *e, U64 value) {
    return c::LLVMConstInt(c::LLVMInt32TypeInContext(e->context), value, 0);
}

// The payload is on the value stack: convert it, store the tag and the payload in a slot, load the enumeration.
static state::Status variant_finish(state::Emitter *e, const state::Work *w) {
    state::Value value = state::pop_value(e);
    Usize at = 0;
    if (!find_enum(e, w->ty.name, &at)) return state::fail("not an enumeration", w->span);
    try state::convert(e, value, e->enums[at].items[w->number].payload, w->span, .initialize);
    state::Value converted = state::pop_value(e);
    c::LLVMValueRef slot = state::new_alloca(e, w->ty, "variant");
    c::LLVMBuildStore(e->builder, c::LLVMConstNull(w->ty.llvm), slot);
    c::LLVMValueRef tag = c::LLVMBuildStructGEP2(e->builder, w->ty.llvm, slot, 0, "tag");
    c::LLVMBuildStore(e->builder, tag_constant(e, w->number), tag);
    c::LLVMValueRef data = c::LLVMBuildStructGEP2(e->builder, w->ty.llvm, slot, 1, "payload");
    c::LLVMBuildStore(e->builder, converted.llvm, data);
    c::LLVMValueRef loaded = c::LLVMBuildLoad2(e->builder, w->ty.llvm, slot, "variant");
    state::push_value(e, (state::Value){.llvm = loaded, .ty = w->ty});
    return state::success();
}

// `.red`.
export state::Status variant(state::Emitter *e, const ast::Expr *x, state::Hint hint) {
    if (x->kind != .variant) {
        return state::fail("not a variant", x->span);
    }
    Str name = x->kind.variant.name;
    const ast::Expr *inner = x->kind.variant.payload;
    Usize at = 0;
    if (!enum_expected(e, x, hint, &at))
        return state::failf(x->span, ".", name, " needs the enumeration it names; write the type");
    U64 value = 0;
    if (!find_enumerator(e, at, name, &value))
        return state::failf(x->span, e->enums[at].name, " has no enumerator ", name);
    state::Ty ty = e->enums[at].ty;
    Usize position = enumerator_index(e, at, name);
    state::Enumerator item = e->enums[at].items[position];
    if (inner != nullptr && !item.has_payload) return state::failf(x->span, ".", name, " has no value");
    if (inner == nullptr && item.has_payload) return state::failf(x->span, ".", name, " needs a value");
    if (ty.kind == .variant_enum) {
        if (inner == nullptr) {
            c::LLVMValueRef zero = c::LLVMConstNull(ty.llvm);
            c::LLVMValueRef tagged = c::LLVMBuildInsertValue(e->builder, zero, tag_constant(e, position), 0, "variant");
            state::push_value(e, (state::Value){.llvm = tagged, .ty = ty});
            return state::success();
        }
        state::push_then(e, (state::Work){.then = variant_finish, .ty = ty, .number = position, .span = x->span});
        state::push_eval(e, inner, state::hint_of(item.payload));
        return state::success();
    }
    state::push_value(e, (state::Value){.llvm = c::LLVMConstInt(ty.llvm, value, 0), .ty = ty});
    return state::success();
}

// ---------------------------------------------------------------------------------------------------------------
// `match`

static void jump(state::Emitter *e, c::LLVMBasicBlockRef block) {
    c::LLVMBasicBlockRef here = c::LLVMGetInsertBlock(e->builder);
    if (c::LLVMGetBasicBlockTerminator(here) == nullptr) c::LLVMBuildBr(e->builder, block);
}

// The scrutinee sits under the result slot when the match is a value.
static state::Value scrutinee(state::Emitter *e, Bool is_value) {
    Usize below = is_value ? 2 : 1;
    return e->values[e->value_count - below];
}

// The arm's value is on the stack: store it in the slot (a value) or drop it (a statement), leave for the end.
static state::Status arm_finish(state::Emitter *e, const state::Work *w) {
    state::Value value = state::pop_value(e);
    if (w->flag) {
        try state::convert(e, value, w->ty, w->span, .initialize);
        state::Value converted = state::pop_value(e);
        state::Value slot = state::peek_value(e);
        c::LLVMBuildStore(e->builder, converted.llvm, slot.llvm);
    }
    state::end_scope(e);
    jump(e, w->blocks[1]);
    return state::success();
}

// An arm that ran as a statement is done: its scope ends, and it goes on at the end unless it left (`return`).
static state::Status arm_done(state::Emitter *e, const state::Work *w) {
    state::end_scope(e);
    jump(e, w->blocks[1]);
    return state::success();
}

// Whether an arm's statement leaves the match: `return`, `break` or `continue`.
static Bool leaves(const ast::Stmt *s) {
    return s->kind == .return_stmt || s->kind == .break_stmt || s->kind == .continue_stmt;
}

// The payload of the variant `name` of `o`, a payload enumeration's value (undefined when its tag is another).
static state::Value variant_payload(state::Emitter *e, state::Value o, Str name) {
    Usize at = 0;
    _ = find_enum(e, o.ty.name, &at);
    state::Ty payload = e->enums[at].items[enumerator_index(e, at, name)].payload;
    c::LLVMValueRef slot = state::new_alloca(e, o.ty, "scrutinee");
    c::LLVMBuildStore(e->builder, o.llvm, slot);
    c::LLVMValueRef data = c::LLVMBuildStructGEP2(e->builder, o.ty.llvm, slot, 1, "payload");
    return (state::Value){.llvm = c::LLVMBuildLoad2(e->builder, payload.llvm, data, "payload"), .ty = payload};
}

// Binds `binding` to the payload of the variant `name` of `o`, if the variant has one and the binding is not `_`.
static void bind_variant(state::Emitter *e, state::Value o, Str name, Str binding) {
    if (countof(binding) == 0 || state::same_text(binding, "_")) return;
    state::Value inner = variant_payload(e, o, name);
    c::LLVMValueRef slot = state::new_alloca(e, inner.ty, binding);
    c::LLVMBuildStore(e->builder, inner.llvm, slot);
    state::add_local(e, (state::Local){.name = binding, .ty = inner.ty, .address = slot});
}

// An arm starts: its block, a scope, the payload bound, then its value.
static state::Status arm_start(state::Emitter *e, const state::Work *w) {
    const ast::Stmt *s = w->stmt;
    if (s->kind != .match_stmt) {
        return state::fail("not a match", s->span);
    }
    const ast::MatchArm *arm = &s->kind.match_stmt.arms[w->number];
    c::LLVMPositionBuilderAtEnd(e->builder, w->blocks[0]);
    state::begin_scope(e);
    ast::Pattern first = arm->patterns[0];
    if (state::same_text(first.name, "some") && countof(first.binding) > 0 && !state::same_text(first.binding, "_")) {
        state::Value inner = optional::payload(e, scrutinee(e, w->flag));
        c::LLVMValueRef slot = state::new_alloca(e, inner.ty, first.binding);
        c::LLVMBuildStore(e->builder, inner.llvm, slot);
        state::add_local(e, (state::Local){.name = first.binding, .ty = inner.ty, .address = slot});
    }
    if (scrutinee(e, w->flag).ty.kind == .variant_enum)
        bind_variant(e, scrutinee(e, w->flag), first.name, first.binding);
    state::Work finish = *w;
    const ast::Expr *value = arm->value;
    if (value->kind == .stmt_expr && (!w->flag || leaves(value->kind.stmt_expr.stmt))) {
        finish.then = arm_done; // `return c`, a block of statements: run as a statement, no value
        state::push_then(e, finish);
        state::push_statement(e, value->kind.stmt_expr.stmt);
        return state::success();
    }
    finish.then = arm_finish;
    state::push_then(e, finish);
    state::Hint hint = w->flag ? state::hint_of(w->ty) : state::no_hint();
    state::push_eval(e, arm->value, hint);
    return state::success();
}

// All arms are done: go on in the end block; a value is loaded from its slot.
static state::Status match_end(state::Emitter *e, const state::Work *w) {
    c::LLVMPositionBuilderAtEnd(e->builder, w->blocks[1]);
    if (!w->flag) {
        _ = state::pop_value(e);
        return state::success();
    }
    state::Value slot = state::pop_value(e);
    _ = state::pop_value(e);
    c::LLVMValueRef loaded = c::LLVMBuildLoad2(e->builder, w->ty.llvm, slot.llvm, "match");
    state::push_value(e, (state::Value){.llvm = loaded, .ty = w->ty});
    return state::success();
}

static c::LLVMBasicBlockRef unreachable_block(state::Emitter *e, Str name) {
    c::LLVMBasicBlockRef block = c::LLVMAppendBasicBlockInContext(e->context, e->function, name.data);
    c::LLVMBasicBlockRef here = c::LLVMGetInsertBlock(e->builder);
    c::LLVMPositionBuilderAtEnd(e->builder, block);
    c::LLVMBuildUnreachable(e->builder);
    c::LLVMPositionBuilderAtEnd(e->builder, here);
    return block;
}

// The enumerator a pattern names: `.name`, or a constant pattern that is a name (`name`, `lex.name`, as the fixer
// writes a C `case` label); empty for a literal.
static Str case_name(ast::Pattern p) {
    if (p.constant == nullptr) return p.name;
    const ast::Expr *e = p.constant;
    if (e->kind == .member) return e->kind.member.name;
    ast::Path path = {};
    if (e->kind == .name) path = e->kind.name.path;
    if (e->kind == .type_value && e->kind.type_value.type != nullptr && e->kind.type_value.type->kind == .named)
        path = e->kind.type_value.type->kind.named.path;
    if (countof(path.segments) == 0) return "";
    return path.segments[countof(path.segments) - 1].text;
}

// The block of the first arm with a pattern named `name`, else of the `_` arm, else null.
static c::LLVMBasicBlockRef arm_for(const ast::Stmt *s, c::LLVMBasicBlockRef blocks[64], Str name) {
    if (s->kind != .match_stmt) {
        return nullptr;
    }
    ast::MatchArm arms[:] = s->kind.match_stmt.arms;
    c::LLVMBasicBlockRef wild = nullptr;
    for (Usize i = 0; i < countof(arms); i++) {
        ast::Pattern patterns[:] = arms[i].patterns;
        for (Usize k = 0; k < countof(patterns); k++) {
            Str got = case_name(patterns[k]);
            Bool any = patterns[k].wildcard || state::same_text(got, "_");
            if (!any && state::same_text(got, name)) return blocks[i];
            if (any && wild == nullptr) wild = blocks[i];
        }
    }
    return wild;
}

// The switch over an enumeration's value.
static state::Status switch_enum(state::Emitter *e, const ast::Stmt *s, state::Value o, Usize at,
                                 c::LLVMBasicBlockRef blocks[64]) {
    c::LLVMValueRef subject = o.llvm;
    c::LLVMTypeRef subject_type = o.ty.llvm;
    if (o.ty.kind == .variant_enum) {
        subject = c::LLVMBuildExtractValue(e->builder, o.llvm, 0, "tag");
        subject_type = c::LLVMInt32TypeInContext(e->context);
    }
    if (s->kind != .match_stmt) {
        return state::fail("not a match", s->span);
    }
    ast::MatchArm arms[:] = s->kind.match_stmt.arms;
    c::LLVMBasicBlockRef fallback = arm_for(s, blocks, "_");
    if (fallback == nullptr) fallback = unreachable_block(e, "match_default");
    c::LLVMValueRef chosen = c::LLVMBuildSwitch(e->builder, subject, fallback, (U32)countof(arms));
    for (Usize i = 0; i < countof(arms); i++) {
        ast::Pattern patterns[:] = arms[i].patterns;
        for (Usize k = 0; k < countof(patterns); k++) {
            ast::Pattern p = patterns[k];
            if (p.wildcard || state::same_text(p.name, "_")) continue;
            Str name = case_name(p);
            U64 value = 0;
            if (!find_enumerator(e, at, name, &value))
                return state::failf(p.span, e->enums[at].name, " has no enumerator ", name);
            c::LLVMAddCase(chosen, c::LLVMConstInt(subject_type, value, 0), blocks[i]);
        }
    }
    return state::success();
}

// The branch on an option's tag.
static state::Status branch_option(state::Emitter *e, const ast::Stmt *s, state::Value o,
                                   c::LLVMBasicBlockRef blocks[64]) {
    c::LLVMBasicBlockRef some = arm_for(s, blocks, "some");
    c::LLVMBasicBlockRef none = arm_for(s, blocks, "none");
    if (some == nullptr) some = unreachable_block(e, "match_no_some");
    if (none == nullptr) none = unreachable_block(e, "match_no_none");
    c::LLVMBuildCondBr(e->builder, optional::is_some(e, o), some, none);
    return state::success();
}

// The type a match used as a value has: the hint, else the checker's type of the first arm's value.
static state::Status result_type(state::Emitter *e, const ast::Stmt *s, state::Hint hint, state::Ty *ty) {
    if (hint.present) {
        *ty = hint.ty;
        return state::success();
    }
    if (s->kind != .match_stmt) {
        return state::fail("not a match", s->span);
    }
    state::TyResult checked = state::type_of_node(e, s->kind.match_stmt.arms[0].value);
    if (checked == .error) {
        return {.error = checked.error};
    }
    *ty = checked.ok;
    return state::success();
}

// The number of constant patterns of `s` (`_` is none).
static Usize constant_count(const ast::Stmt *s) {
    if (s->kind != .match_stmt) return 0;
    Usize count = 0;
    ast::MatchArm arms[:] = s->kind.match_stmt.arms;
    for (Usize i = 0; i < countof(arms); i++) {
        ast::Pattern patterns[:] = arms[i].patterns;
        for (Usize k = 0; k < countof(patterns); k++) {
            if (patterns[k].constant != nullptr) count += 1;
        }
    }
    return count;
}

// The value of a constant pattern, as the scrutinee's type.
static c::LLVMValueRef case_value(state::Emitter *e, state::Value value, state::Value o) {
    if (c::LLVMTypeOf(value.llvm) == o.ty.llvm) return value.llvm;
    return c::LLVMBuildIntCast2(e->builder, value.llvm, o.ty.llvm, value.ty.is_signed, "case");
}

// The constant patterns are on the value stack above the scrutinee, in order: one `switch` when every one is a
// constant LLVM knows (a literal), else a chain of comparisons in the order of the arms (a header's constant, a
// global). With no `_` arm the default is `unreachable`: the checker made sure the arms cover every value.
static state::Status branch_constants(state::Emitter *e, const ast::Stmt *s, c::LLVMBasicBlockRef blocks[64]) {
    if (s->kind != .match_stmt) return state::fail("not a match", s->span);
    ast::MatchArm arms[:] = s->kind.match_stmt.arms;
    Usize count = constant_count(s);
    c::LLVMValueRef values[256];
    if (count > countof(values)) return state::not_emitted("a match with over 256 constant patterns", s->span);
    for (Usize i = count; i > 0; i--)
        values[i - 1] = state::pop_value(e).llvm;
    state::Value o = state::peek_value(e);
    Bool constant = true;
    for (Usize i = 0; i < count; i++) {
        values[i] = case_value(e, (state::Value){.llvm = values[i], .ty = o.ty}, o);
        constant = constant && c::LLVMIsAConstantInt(values[i]) != nullptr;
    }
    c::LLVMBasicBlockRef fallback = arm_for(s, blocks, "_");
    if (fallback == nullptr) fallback = unreachable_block(e, "match_default");
    c::LLVMValueRef chosen = constant ? c::LLVMBuildSwitch(e->builder, o.llvm, fallback, (U32)count) : nullptr;
    Usize next = 0;
    for (Usize i = 0; i < countof(arms); i++) {
        ast::Pattern patterns[:] = arms[i].patterns;
        for (Usize k = 0; k < countof(patterns); k++) {
            if (patterns[k].constant == nullptr) continue;
            c::LLVMValueRef value = values[next];
            next += 1;
            if (constant) {
                c::LLVMAddCase(chosen, value, blocks[i]);
                continue;
            }
            c::LLVMBasicBlockRef other = c::LLVMAppendBasicBlockInContext(e->context, e->function, "case_next");
            c::LLVMValueRef same = c::LLVMBuildICmp(e->builder, c::LLVMIntEQ, o.llvm, value, "case");
            c::LLVMBuildCondBr(e->builder, same, blocks[i], other);
            c::LLVMPositionBuilderAtEnd(e->builder, other);
        }
    }
    if (!constant) c::LLVMBuildBr(e->builder, fallback);
    return state::success();
}

static state::Status dispatch_arms(state::Emitter *e, const state::Work *w);

// The scrutinee is on the value stack: a match over a number, a `char` or a `bool` evaluates its constant patterns
// first, with the scrutinee's type as their hint; the arms are dispatched once they are on the stack.
static state::Status dispatch(state::Emitter *e, const state::Work *w) {
    const ast::Stmt *s = w->stmt;
    if (s->kind != .match_stmt) {
        return state::fail("not a match", s->span);
    }
    state::Value o = state::peek_value(e);
    Usize at = 0;
    Bool scalar = o.ty.kind == .boolean || (o.ty.kind == .integer && !find_enum(e, o.ty.name, &at));
    state::Work next = *w;
    next.then = dispatch_arms;
    next.flag = w->flag;
    next.number = scalar ? 1 : 0;
    state::push_then(e, next);
    if (!scalar) return state::success();
    ast::MatchArm arms[:] = s->kind.match_stmt.arms;
    for (Usize i = countof(arms); i > 0; i--) {
        ast::Pattern patterns[:] = arms[i - 1].patterns;
        for (Usize k = countof(patterns); k > 0; k--) {
            if (patterns[k - 1].constant != nullptr)
                state::push_eval(e, patterns[k - 1].constant, state::hint_of(o.ty));
        }
    }
    return state::success();
}

// Dispatches to the arm blocks and queues the arms.
static state::Status dispatch_arms(state::Emitter *e, const state::Work *w) {
    const ast::Stmt *s = w->stmt;
    if (s->kind != .match_stmt) {
        return state::fail("not a match", s->span);
    }
    ast::MatchArm arms[:] = s->kind.match_stmt.arms;
    if (countof(arms) == 0 || countof(arms) > 64) return state::not_emitted("a match with no arms or over 64", s->span);
    state::Ty result = {};
    if (w->flag) try result_type(e, s, w->hint, &result);
    c::LLVMBasicBlockRef blocks[64];
    for (Usize i = 0; i < countof(arms); i++)
        blocks[i] = c::LLVMAppendBasicBlockInContext(e->context, e->function, "arm");
    c::LLVMBasicBlockRef end_block = c::LLVMAppendBasicBlockInContext(e->context, e->function, "match_end");
    Usize at = 0;
    if (w->number == 1) {
        try branch_constants(e, s, blocks);
    } else {
        state::Value o = state::peek_value(e);
        if (o.ty.kind == .option)
            try branch_option(e, s, o, blocks);
        else if ((o.ty.kind == .integer || o.ty.kind == .variant_enum) && find_enum(e, o.ty.name, &at))
            try switch_enum(e, s, o, at, blocks);
        else
            return state::failf(s->span, "match needs an enumeration, an option, a number or a bool, not ", o.ty.name);
    }
    if (w->flag) {
        c::LLVMValueRef slot = state::new_alloca(e, result, "match");
        state::push_value(e, (state::Value){.llvm = slot, .ty = result});
    }
    state::Work end = {.then = match_end, .flag = w->flag, .ty = result, .span = s->span};
    end.blocks[1] = end_block;
    state::push_then(e, end);
    for (Usize i = countof(arms); i > 0; i--) {
        state::Work arm = {
            .then = arm_start, .stmt = s, .number = i - 1, .flag = w->flag, .ty = result, .span = arms[i - 1].span};
        arm.blocks[0] = blocks[i - 1];
        arm.blocks[1] = end_block;
        state::push_then(e, arm);
    }
    return state::success();
}

static state::Status begin(state::Emitter *e, const ast::Stmt *s, state::Hint hint, Bool is_value) {
    if (s->kind != .match_stmt) {
        return state::fail("not a match", s->span);
    }
    state::push_then(e, (state::Work){.then = dispatch, .stmt = s, .hint = hint, .flag = is_value, .span = s->span});
    state::push_eval(e, s->kind.match_stmt.value, state::no_hint());
    return state::success();
}

export state::Status match_stmt(state::Emitter *e, const ast::Stmt *s) {
    return begin(e, s, state::no_hint(), false);
}

// A `match` used as a value.
export state::Status value_of(state::Emitter *e, const ast::Stmt *s, state::Hint hint) {
    return begin(e, s, hint, true);
}

// ---------------------------------------------------------------------------------------------------------------
// `if let` over an enumeration

static void jump_to(state::Emitter *e, c::LLVMBasicBlockRef block) {
    jump(e, block);
}

static state::Status let_after_then(state::Emitter *e, const state::Work *w) {
    state::end_scope(e);
    jump_to(e, w->blocks[1]);
    c::LLVMPositionBuilderAtEnd(e->builder, w->flag ? w->blocks[0] : w->blocks[1]);
    return state::success();
}

static state::Status let_branch_end(state::Emitter *e, const state::Work *w) {
    jump_to(e, w->blocks[0]);
    c::LLVMPositionBuilderAtEnd(e->builder, w->blocks[0]);
    return state::success();
}

// The scrutinee is on the value stack: compare its tag with the pattern's variant, bind the payload, run the branches.
static state::Status let_branch(state::Emitter *e, const state::Work *w) {
    const ast::Stmt *s = w->stmt;
    if (s->kind != .if_let) {
        return state::fail("not an if let", s->span);
    }
    state::Value o = state::peek_value(e);
    if (o.ty.kind == .option) {
        return optional::if_let_branch(e, w);
    }
    _ = state::pop_value(e);
    Usize at = 0;
    if (!(o.ty.kind == .integer || o.ty.kind == .variant_enum) || !find_enum(e, o.ty.name, &at))
        return state::failf(s->span, "if let needs an enumeration or an option, not ", o.ty.name);
    ast::Pattern pattern = s->kind.if_let.pattern;
    U64 value = 0;
    if (!find_enumerator(e, at, pattern.name, &value))
        return state::failf(pattern.span, e->enums[at].name, " has no enumerator ", pattern.name);
    c::LLVMValueRef tag = o.llvm;
    c::LLVMTypeRef tag_type = o.ty.llvm;
    if (o.ty.kind == .variant_enum) {
        tag = c::LLVMBuildExtractValue(e->builder, o.llvm, 0, "tag");
        tag_type = c::LLVMInt32TypeInContext(e->context);
    }
    const ast::Stmt *else_branch = s->kind.if_let.else_branch;
    Bool has_else = else_branch != nullptr;
    c::LLVMBasicBlockRef then_block = c::LLVMAppendBasicBlockInContext(e->context, e->function, "let_then");
    c::LLVMBasicBlockRef else_block = nullptr;
    if (has_else) else_block = c::LLVMAppendBasicBlockInContext(e->context, e->function, "let_else");
    c::LLVMBasicBlockRef end_block = c::LLVMAppendBasicBlockInContext(e->context, e->function, "let_end");
    if (!has_else) else_block = end_block;
    c::LLVMValueRef same =
        c::LLVMBuildICmp(e->builder, c::LLVMIntEQ, tag, c::LLVMConstInt(tag_type, value, 0), "is_variant");
    c::LLVMBuildCondBr(e->builder, same, then_block, else_block);
    c::LLVMPositionBuilderAtEnd(e->builder, then_block);
    state::begin_scope(e);
    if (o.ty.kind == .variant_enum) bind_variant(e, o, pattern.name, pattern.binding);
    if (has_else) {
        state::Work end = {.then = let_branch_end, .span = s->span};
        end.blocks[0] = end_block;
        state::push_then(e, end);
        state::push_statement(e, else_branch);
    }
    state::Work after = {.then = let_after_then, .flag = has_else, .span = s->span};
    after.blocks[0] = else_block;
    after.blocks[1] = end_block;
    state::push_then(e, after);
    state::push_statement(e, s->kind.if_let.then_branch);
    return state::success();
}

// `if let .circle(c) = s { .. } else { .. }` over an enumeration.
export state::Status if_let(state::Emitter *e, const ast::Stmt *s) {
    if (s->kind != .if_let) {
        return state::fail("not an if let", s->span);
    }
    state::push_then(e, (state::Work){.then = let_branch, .stmt = s, .span = s->span});
    state::push_eval(e, s->kind.if_let.value, state::no_hint());
    return state::success();
}
