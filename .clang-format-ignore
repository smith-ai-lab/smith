# Files `smith fmt` leaves as they are (clang-format reads this file itself; globs, relative to this folder).
# The tree-sitter parser `smith build` generates into tree-sitter/src/ (gitignored).
tree-sitter/src/*
tree-sitter/src/tree_sitter/*
# Inputs and expectations of the tests, written as the case needs them (some are broken or oddly formatted on purpose).
tests/smith-lang/cases/**
tests/tree_sitter_cases/*
tests/prove/**
# The owner's scan reference, copied as it is (the hash of each file is in tests/autodiff/scan/COPIED.sha256).
tests/autodiff/scan/**
tests/build_fixtures/**
# Negative fixtures and sub-projects, found by `smith lint` (the gate reads this list too): the inputs of the checks' own
# tests (each .expected says what the check must report), and the autodiff programs, each a project with its own flags.
tests/affine/**
tests/effects/**
tests/smith-fmt/**
tests/autodiff/**
