// smith::autodiff, <smith/autodiff.h>: Enzyme's own interface, as Enzyme documents it, declared and never defined, and
// `gradient` and `map`, the typed calls built on it (the last exports; a .smith file's, since they are generic).
// Enzyme differentiates LLVM IR: it finds a call to __enzyme_autodiff (reverse mode) or __enzyme_fwddiff (forward mode)
// when smith links the program, writes the derivative of the function it is given, and replaces the call with it. So
// no declaration of Enzyme's has a body, and none may: a marker that had a definition would be folded to its value
// before Enzyme reads it. A program that imports this module (or includes the header) is an autodiff program, and smith builds it as
// one (the smith-autodiff skill): full LTO, each file compiled with the profile's -O level and no optimization passes.
//
// The names follow Enzyme's; a .smith file writes the module's (autodiff::reverse), C the names of the header.
//
//   double f(double x, double y);
//   double dx = 0, dy = 0;
//   autodiff::reverse(f, autodiff::out, x, autodiff::out, y);   // C: __enzyme_autodiff((void *)f, enzyme_out, x, ...)
//
// Each argument of the differentiated function is written after a marker that says how it is differentiated:
//
//   autodiff::constant  the argument is not differentiated: it follows as it is
//   autodiff::dup       a pointer: the pointer, then a pointer of the same shape that receives its derivative
//                       (reverse mode adds the derivative into it, so zero it first; forward mode reads the tangent
//                       from it and writes the derivative of the result's matching memory)
//   autodiff::out       a scalar whose derivative the call returns (reverse mode only; the argument is a double)
//   autodiff::dup_no_need   as dup, for a result the caller does not read
//
// The calls are declared to return double: the derivative of the first autodiff::out argument (reverse mode) or the
// tangent of a double result (forward mode); the value is meaningless when there is neither, and may be ignored. Enzyme
// builds the return value from the call's own type, so for a struct of several derivatives, or a float, call through a
// pointer of the type you want, `((Pair (*)(void *, ...))autodiff::reverse)(...)`. The first argument is the function,
// as `void *`: cast a function pointer to it. The markers are variables of type int that nothing defines, and the
// functions are variadic, so the compiler checks no argument after the first. A float passed after a marker is
// promoted to double by C's rules for variadic calls: pass the types the function takes (a double for a double).
module smith::autodiff;

import smith::arena;
import smith::contract;

// <smith/autodiff.h>: the reverse mode derivative of a function: `autodiff::reverse(f, marker, argument, ...)`.
// C: __enzyme_autodiff(void *function, ...)
[[smith::c_name("__enzyme_autodiff")]] export f64 reverse(void *function, ...); // NOLINT(bugprone-reserved-identifier)

// The forward mode derivative of a function: the tangent of each autodiff::dup argument is read from its shadow, and
// the call returns the tangent of the result. C: __enzyme_fwddiff(void *function, ...)
[[smith::c_name("__enzyme_fwddiff")]] export f64 forward(void *function, ...); // NOLINT(bugprone-reserved-identifier)

// The markers. C: enzyme_const, enzyme_dup, enzyme_out, enzyme_dupnoneed.
[[smith::c_name("enzyme_const")]] export extern i32 constant;
[[smith::c_name("enzyme_dup")]] export extern i32 dup;
[[smith::c_name("enzyme_out")]] export extern i32 out;
[[smith::c_name("enzyme_dupnoneed")]] export extern i32 dup_no_need;
[[smith::c_name("enzyme_interleave")]] export extern i32 interleave;

// The shape of a gradient: `proto` is a copy of what `p` points to, `n` of them in a row, all set to zero, and each
// `[:]` field given a new block of the same length from the arena (a `[:]` of structs is walked element by element, a
// fixed array of structs too). `proto` carries the type for `fields` and is read only when a slice has an element.
void shadow_walk(arena::Arena *a, auto proto, auto p, usize n) {
    (void)a;
    (void)proto;
    if constexpr (is_record(typeof(proto))) {
        for (; n > 0; n--) {
            for constexpr (usize i = 0; i < countof(fields(typeof(proto))); i++) {
                constexpr Field f = fields(typeof(proto))[i];
                (void)f;
                if constexpr (is_array(typeof(proto.[f]))) {
                    shadow_walk(a, p->[f][0], &p->[f][0], sizeof(p->[f]) / sizeof(p->[f][0]));
                } else if constexpr (is_slice(typeof(proto.[f]))) {
                    if (p->[f].count[0] > 0) { // an empty slice has no element to read
                        typeof(p->[f].data) old = p->[f].data;
                        p->[f].data = (typeof(old))arena::push_array_raw(a, sizeof(*old), p->[f].count[0], alignof(typeof(*old)));
                        __builtin_memcpy(p->[f].data, old, p->[f].count[0] * sizeof(*old));
                        shadow_walk(a, *p->[f].data, p->[f].data, p->[f].count[0]);
                    }
                } else {
                    shadow_walk(a, p->[f], &p->[f], 1);
                }
            }
            p += 1;
        }
    } else if constexpr (is_pointer(typeof(proto))) {
        static_assert(false, "gradient: a field is a pointer; use a [:] slice");
    } else {
        __builtin_memset(p, 0, n * sizeof(*p));
    }
}

// A copy of *x in the shape of a gradient.
typeof(v) shadow(arena::Arena *a, auto v) {
    shadow_walk(a, v, &v, 1);
    return v;
}

// The gradient of `f` with respect to `*x`, with every other argument held constant: `autodiff::gradient(&arena, loss,
// &params, &batch)` is the derivative of `loss(&params, &batch)` with respect to what `&params` points to, a value of
// the type of `*x`. The arena comes first even when nothing is allocated. The result has the shape of `*x`: a float
// field is differentiated, an integer, bool or enum field comes back zero, a fixed array of floats is filled, a nested
// struct is walked, and a `[:]` field (one dimension) gets a new array of the same length from the arena, as does each
// element of a `[:]` of structs. A pointer field is an error that says to use `[:]`. `f` is the name of a function (a
// compile time argument), `x` a pointer, and `rest` anything `f` takes after it; a pointer in `rest` is read, never
// differentiated. A call `f` does not accept is an error at the call. A generic function: only .smith calls it (C
// writes `__enzyme_autodiff` with `enzyme_interleave`).
export typeof(*x) gradient(arena::Arena *a, constexpr auto f, auto x, auto... rest) {
    (void)sizeof(f(x, rest...));
    typeof_unqual(*x) dx = shadow(a, *x);
    if constexpr (countof(rest) == 0) {
        reverse((void *)f, dup, x, interleave, &dx);
    } else {
        reverse((void *)f, dup, x, constant, rest..., interleave, &dx);
    }
    return dx;
}

// The walkers of `map`, one for each number of inputs (a generic has four parameters at most, so the inputs are `typeof(out)`
// parameters and not a list): `proto` is a copy of what `out` points to, for its type, and `n` how many are in a row.
void map_walk1(constexpr auto f, auto proto, usize n, auto out, typeof(out) a) {
    (void)n;
    (void)out;
    (void)a;
    (void)proto;
    if constexpr (is_record(typeof(proto))) {
        for (; n > 0; n--) {
            for constexpr (usize i = 0; i < countof(fields(typeof(proto))); i++) {
                constexpr Field fld = fields(typeof(proto))[i];
                (void)fld;
                if constexpr (is_array(typeof(proto.[fld]))) {
                    map_walk1(f, out->[fld][0], sizeof(out->[fld]) / sizeof(out->[fld][0]), &out->[fld][0], &a->[fld][0]);
                } else if constexpr (is_slice(typeof(proto.[fld]))) {
                    contract::assert(a->[fld].count[0] == out->[fld].count[0]);
                    if (out->[fld].count[0] > 0) { // an empty slice has no element to read
                        map_walk1(f, *out->[fld].data, out->[fld].count[0], out->[fld].data, a->[fld].data);
                    }
                } else {
                    map_walk1(f, out->[fld], 1, &out->[fld], &a->[fld]);
                }
            }
            out += 1;
            a += 1;
        }
    } else if constexpr (is_float(typeof(proto))) {
        for (; n > 0; n--) {
            *out = (typeof(*out))f(*a);
            out += 1;
            a += 1;
        }
    } else if constexpr (is_pointer(typeof(proto)) || is_array(typeof(proto))) {
        static_assert(false, "map: a field is a pointer or an array of arrays; use a [:] slice");
    }
}

void map_walk2(constexpr auto f, auto proto, usize n, auto out, typeof(out) a, typeof(out) b) {
    (void)n;
    (void)out;
    (void)a;
    (void)b;
    (void)proto;
    if constexpr (is_record(typeof(proto))) {
        for (; n > 0; n--) {
            for constexpr (usize i = 0; i < countof(fields(typeof(proto))); i++) {
                constexpr Field fld = fields(typeof(proto))[i];
                (void)fld;
                if constexpr (is_array(typeof(proto.[fld]))) {
                    map_walk2(f, out->[fld][0], sizeof(out->[fld]) / sizeof(out->[fld][0]), &out->[fld][0], &a->[fld][0], &b->[fld][0]);
                } else if constexpr (is_slice(typeof(proto.[fld]))) {
                    contract::assert(a->[fld].count[0] == out->[fld].count[0]);
                    contract::assert(b->[fld].count[0] == out->[fld].count[0]);
                    if (out->[fld].count[0] > 0) { // an empty slice has no element to read
                        map_walk2(f, *out->[fld].data, out->[fld].count[0], out->[fld].data, a->[fld].data, b->[fld].data);
                    }
                } else {
                    map_walk2(f, out->[fld], 1, &out->[fld], &a->[fld], &b->[fld]);
                }
            }
            out += 1;
            a += 1;
            b += 1;
        }
    } else if constexpr (is_float(typeof(proto))) {
        for (; n > 0; n--) {
            *out = (typeof(*out))f(*a, *b);
            out += 1;
            a += 1;
            b += 1;
        }
    } else if constexpr (is_pointer(typeof(proto)) || is_array(typeof(proto))) {
        static_assert(false, "map: a field is a pointer or an array of arrays; use a [:] slice");
    }
}

void map_walk3(constexpr auto f, auto proto, usize n, auto out, typeof(out) a, typeof(out) b, typeof(out) c) {
    (void)n;
    (void)out;
    (void)a;
    (void)b;
    (void)c;
    (void)proto;
    if constexpr (is_record(typeof(proto))) {
        for (; n > 0; n--) {
            for constexpr (usize i = 0; i < countof(fields(typeof(proto))); i++) {
                constexpr Field fld = fields(typeof(proto))[i];
                (void)fld;
                if constexpr (is_array(typeof(proto.[fld]))) {
                    map_walk3(f, out->[fld][0], sizeof(out->[fld]) / sizeof(out->[fld][0]), &out->[fld][0], &a->[fld][0], &b->[fld][0], &c->[fld][0]);
                } else if constexpr (is_slice(typeof(proto.[fld]))) {
                    contract::assert(a->[fld].count[0] == out->[fld].count[0]);
                    contract::assert(b->[fld].count[0] == out->[fld].count[0]);
                    contract::assert(c->[fld].count[0] == out->[fld].count[0]);
                    if (out->[fld].count[0] > 0) { // an empty slice has no element to read
                        map_walk3(f, *out->[fld].data, out->[fld].count[0], out->[fld].data, a->[fld].data, b->[fld].data, c->[fld].data);
                    }
                } else {
                    map_walk3(f, out->[fld], 1, &out->[fld], &a->[fld], &b->[fld], &c->[fld]);
                }
            }
            out += 1;
            a += 1;
            b += 1;
            c += 1;
        }
    } else if constexpr (is_float(typeof(proto))) {
        for (; n > 0; n--) {
            *out = (typeof(*out))f(*a, *b, *c);
            out += 1;
            a += 1;
            b += 1;
            c += 1;
        }
    } else if constexpr (is_pointer(typeof(proto)) || is_array(typeof(proto))) {
        static_assert(false, "map: a field is a pointer or an array of arrays; use a [:] slice");
    }
}

void map_walk4(constexpr auto f, auto proto, usize n, auto out, typeof(out) a, typeof(out) b, typeof(out) c, typeof(out) d) {
    (void)n;
    (void)out;
    (void)a;
    (void)b;
    (void)c;
    (void)d;
    (void)proto;
    if constexpr (is_record(typeof(proto))) {
        for (; n > 0; n--) {
            for constexpr (usize i = 0; i < countof(fields(typeof(proto))); i++) {
                constexpr Field fld = fields(typeof(proto))[i];
                (void)fld;
                if constexpr (is_array(typeof(proto.[fld]))) {
                    map_walk4(f, out->[fld][0], sizeof(out->[fld]) / sizeof(out->[fld][0]), &out->[fld][0], &a->[fld][0], &b->[fld][0], &c->[fld][0], &d->[fld][0]);
                } else if constexpr (is_slice(typeof(proto.[fld]))) {
                    contract::assert(a->[fld].count[0] == out->[fld].count[0]);
                    contract::assert(b->[fld].count[0] == out->[fld].count[0]);
                    contract::assert(c->[fld].count[0] == out->[fld].count[0]);
                    contract::assert(d->[fld].count[0] == out->[fld].count[0]);
                    if (out->[fld].count[0] > 0) { // an empty slice has no element to read
                        map_walk4(f, *out->[fld].data, out->[fld].count[0], out->[fld].data, a->[fld].data, b->[fld].data, c->[fld].data, d->[fld].data);
                    }
                } else {
                    map_walk4(f, out->[fld], 1, &out->[fld], &a->[fld], &b->[fld], &c->[fld], &d->[fld]);
                }
            }
            out += 1;
            a += 1;
            b += 1;
            c += 1;
            d += 1;
        }
    } else if constexpr (is_float(typeof(proto))) {
        for (; n > 0; n--) {
            *out = (typeof(*out))f(*a, *b, *c, *d);
            out += 1;
            a += 1;
            b += 1;
            c += 1;
            d += 1;
        }
    } else if constexpr (is_pointer(typeof(proto)) || is_array(typeof(proto))) {
        static_assert(false, "map: a field is a pointer or an array of arrays; use a [:] slice");
    }
}

// `map` writes `*out` from `f` applied to each set of matching float leaves of the structs it is given: `autodiff::map(f,
// &out, &a, &b)` is `out.leaf = f(a.leaf, b.leaf)` for every float leaf of the same type as `*out`, walking nested
// structs, fixed arrays and `[:]` fields (each of `a` and `b` as long as `out`'s, checked), element by element; an
// integer, bool or enum leaf is left as it is. One to four input structs; `out` may be one of them (`map(sgd, &params,
// &params, &g)`). `f` is the name of an ordinary function of one float per input, so a step is `map` and one small
// function (`f64 sgd(f64 p, f64 g)`); an `f32` leaf is converted to `f` parameters and the result back. A generic
// function cannot be passed. The walkers are one function for each number of inputs.
export void map(constexpr auto f, auto out, auto... rest) {
    static_assert(countof(rest) >= 1 && countof(rest) <= 4, "map takes one to four input structs after the output");
    if constexpr (countof(rest) == 1) {
        map_walk1(f, *out, 1, out, rest...);
    } else if constexpr (countof(rest) == 2) {
        map_walk2(f, *out, 1, out, rest...);
    } else if constexpr (countof(rest) == 3) {
        map_walk3(f, *out, 1, out, rest...);
    } else {
        map_walk4(f, *out, 1, out, rest...);
    }
}
