// Tests of smith::task: tasks on stacks of their own, groups, the inline scheduler, a scheduler of the test's own, and
// what a task keeps for itself (errno, the handlers).
module smith::task_test;

import <errno.h>;
import smith::clock;
import smith::task;
import smith::test;

// A job is a struct whose first member is a task::Job; the task casts `self` back, as a handler does.
typedef struct {
    task::Job base;
    char *log; // the marks the tasks write, in order
    usize *length;
    char name;
    usize rounds;
} Marker;

void log_mark(Marker *job, char mark) {
    job->log[*job->length] = mark;
    *job->length += 1;
}

// Writes its name `rounds` times, yielding after each.
void run_marker(task::Job *self) {
    Marker *job = (Marker *)self;
    for (usize i = 0; i < job->rounds; i++) {
        log_mark(job, job->name);
        task::yield();
    }
}

Marker make_marker(char *log, usize *length, char name, usize rounds) {
    Marker job = {};
    job.base.run = run_marker;
    job.log = log;
    job.length = length;
    job.name = name;
    job.rounds = rounds;
    return job;
}

export void test_task_a_spawned_task_runs_at_once_and_wait_returns() {
    char log[8] = {};
    usize length = 0;
    Marker job = make_marker(log, &length, 'a', 1);
    task::Group group = {};
    task::spawn(&group, &job.base);
    test::check_equal(length, (usize)1); // the inline scheduler ran it up to its first yield
    task::wait(&group);
    test::check_equal(group.pending, (usize)0);
}

export void test_task_yielding_tasks_take_turns() {
    char log[16] = {};
    usize length = 0;
    Marker a = make_marker(log, &length, 'a', 3);
    Marker b = make_marker(log, &length, 'b', 3);
    task::Group group = {};
    task::spawn(&group, &a.base);
    task::spawn(&group, &b.base);
    task::wait(&group);
    test::check_equal(length, (usize)6);
    test::check_equal((i32)log[0], (i32)'a');
    test::check_equal((i32)log[1], (i32)'b');
    test::check_equal((i32)log[2], (i32)'a');
    test::check_equal((i32)log[3], (i32)'b');
    test::check_equal((i32)log[4], (i32)'a');
    test::check_equal((i32)log[5], (i32)'b');
}

export void test_task_main_is_the_first_task_and_yield_runs_the_others() {
    test::check(!task::in_spawned());
    char log[8] = {};
    usize length = 0;
    Marker job = make_marker(log, &length, 'x', 2);
    task::Group group = {};
    defer task::wait(&group);
    task::spawn(&group, &job.base);
    test::check_equal(length, (usize)1);
    task::yield(); // main offers the worker: the parked task runs its second round
    test::check_equal(length, (usize)2);
}

typedef struct {
    task::Job base;
    bool *inside;
} Inside;

void run_inside(task::Job *self) {
    *((Inside *)self)->inside = task::in_spawned();
}

export void test_task_a_spawned_task_knows_it_is_one() {
    bool inside = false;
    Inside job = {.base = {.run = run_inside}, .inside = &inside};
    task::Group group = {};
    task::spawn(&group, &job.base);
    task::wait(&group);
    test::check(inside);
    test::check(!task::in_spawned());
}

typedef struct {
    task::Job base;
    i32 *seen;
} Errno;

constexpr i32 main_error = 7;
constexpr i32 task_error = 9;

void run_errno(task::Job *self) {
    Errno *job = (Errno *)self;
    *c::__error() = task_error;
    task::yield();
    *job->seen = *c::__error(); // main set its own in between
}

export void test_task_each_task_has_its_own_errno() {
    i32 seen = 0;
    Errno job = {.base = {.run = run_errno}, .seen = &seen};
    task::Group group = {};
    *c::__error() = main_error;
    task::spawn(&group, &job.base);
    test::check_equal(*c::__error(), main_error); // the task's write stayed in the task
    *c::__error() = main_error + 1;
    task::wait(&group);
    test::check_equal(seen, task_error);
    test::check_equal(*c::__error(), main_error + 1);
}

typedef struct {
    clock::Handler base;
    u64 time;
} Fake;

i64 fake_now(clock::Handler *self, i32 which) {
    (void)which;
    return (i64)((Fake *)self)->time;
}

void fake_sleep(clock::Handler *self, u64 ns) {
    ((Fake *)self)->time += ns;
}

Fake make_fake(u64 time) {
    Fake fake = {};
    fake.base.now = fake_now;
    fake.base.sleep = fake_sleep;
    fake.time = time;
    return fake;
}

typedef struct {
    task::Job base;
    Fake *own;
    u64 *inherited; // what the clock said when the task began
    u64 *later;     // and after it set its own and yielded
} Clocked;

void run_clocked(task::Job *self) {
    Clocked *job = (Clocked *)self;
    *job->inherited = clock::monotonic();
    clock::set_handler(&job->own->base);
    task::yield();
    *job->later = clock::monotonic();
}

export void test_task_a_task_starts_with_its_spawners_handlers_and_sets_its_own() {
    Fake mine = make_fake(100);
    Fake theirs = make_fake(5000);
    clock::Handler *before = clock::set_handler(&mine.base);
    defer clock::set_handler(before);
    u64 inherited = 0;
    u64 later = 0;
    Clocked job = {.base = {.run = run_clocked}, .own = &theirs, .inherited = &inherited, .later = &later};
    task::Group group = {};
    task::spawn(&group, &job.base);
    test::check_equal(inherited, (u64)100);          // the spawner's clock
    test::check_equal(clock::monotonic(), (u64)100); // what the task set did not reach main
    mine.time = 200;
    task::wait(&group);
    test::check_equal(later, (u64)5000); // the task's own, kept while it was parked
    test::check_equal(clock::monotonic(), (u64)200);
}

typedef struct {
    task::Job base;
    usize depth; // returned back, plus 3
    usize *reached;
} Deep;

// A frame of 128 KB, half of the stack, touched at both ends.
usize use_stack(usize n) {
    volatile u8 big[131072];
    big[0] = 1;
    big[131071] = 2;
    return n + big[0] + big[131071];
}

void run_deep(task::Job *self) {
    Deep *job = (Deep *)self;
    *job->reached = use_stack(job->depth);
}

export void test_task_a_task_has_a_stack_of_256_kilobytes() {
    usize reached = 0;
    Deep job = {.base = {.run = run_deep}, .depth = 100, .reached = &reached};
    task::Group group = {};
    task::spawn(&group, &job.base);
    task::wait(&group);
    test::check_equal(reached, (usize)103);
}

typedef struct {
    task::Job base;
    usize *count;
} Count;

void run_count(task::Job *self) {
    *((Count *)self)->count += 1;
}

export void test_task_many_tasks_come_and_go() {
    usize count = 0;
    Count job = {.base = {.run = run_count}, .count = &count};
    task::Group group = {};
    for (usize i = 0; i < 2000; i++)
        task::spawn(&group, &job.base);
    task::wait(&group);
    test::check_equal(count, (usize)2000);
    test::check_equal(group.pending, (usize)0);
}

typedef struct {
    task::Job base;
    char *log;
    usize *length;
    Marker *inner;
} Parent;

// A task spawns tasks of its own into a group of its own and waits for them.
void run_parent(task::Job *self) {
    Parent *job = (Parent *)self;
    task::Group children = {};
    defer task::wait(&children);
    task::spawn(&children, &job->inner->base);
    job->log[*job->length] = 'p';
    *job->length += 1;
}

export void test_task_a_task_spawns_and_waits_in_a_group_of_its_own() {
    char log[8] = {};
    usize length = 0;
    Marker inner = make_marker(log, &length, 'i', 2);
    Parent parent = {.base = {.run = run_parent}, .log = log, .length = &length, .inner = &inner};
    task::Group group = {};
    task::spawn(&group, &parent.base);
    task::wait(&group);
    test::check_equal(length, (usize)3);
    test::check_equal((i32)log[0], (i32)'i');
    test::check_equal((i32)log[1], (i32)'p');
    test::check_equal((i32)log[2], (i32)'i');
}

// A scheduler of the test's own: it runs a task when it is spawned like the inline one, and counts what it was asked.
typedef struct {
    task::Scheduler base;
    usize spawns;
    usize yields;
    usize waits;
    Marker *queued[4]; // unused: tasks it cannot run are kept by the test
} Counting;

void counting_spawn(task::Scheduler *self, task::Group *group, task::Task *t) {
    (void)group;
    ((Counting *)self)->spawns += 1;
    (void)task::resume(t); // the test's jobs never yield under it
}

void counting_yield(task::Scheduler *self) {
    ((Counting *)self)->yields += 1;
}

void counting_wait(task::Scheduler *self, task::Group *group) {
    (void)group;
    ((Counting *)self)->waits += 1;
}

export void test_task_set_scheduler_returns_the_previous_and_decides_what_runs() {
    Counting counting = {};
    counting.base.spawn = counting_spawn;
    counting.base.yield = counting_yield;
    counting.base.wait = counting_wait;
    test::check(task::set_scheduler(nullptr) == nullptr);
    task::Scheduler *before = task::set_scheduler(&counting.base);
    test::check(before == nullptr);
    test::check(task::scheduler() == &counting.base);
    usize count = 0;
    Count job = {.base = {.run = run_count}, .count = &count};
    task::Group group = {};
    task::spawn(&group, &job.base);
    task::spawn(&group, &job.base);
    task::yield();
    task::wait(&group);
    task::Scheduler *restored = task::set_scheduler(before);
    test::check(restored == &counting.base);
    test::check_equal(counting.spawns, (usize)2);
    test::check_equal(counting.yields, (usize)1);
    test::check_equal(counting.waits, (usize)1);
    test::check_equal(count, (usize)2);
    test::check(task::scheduler() != &counting.base); // the inline one again
}
