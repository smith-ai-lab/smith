// Tests of smith::task: tasks on stacks of their own, groups, pause, the default scheduler on worker threads and the
// inline scheduler (the tests that assert an order run under it). The spawn that starts a
// task is private to the module until the language can type it (#316), so these tests reach it through the module's own
// private name, `task::spawn_raw`.
module smith::task_test;

import <dirent.h>;
import <errno.h>;
import <smith/handlers.h>;
import <time.h>;
import <sys/wait.h>;
import <unistd.h>;
import smith::arena;
import smith::console;
import smith::mem;
import smith::task;
import smith::test;
import target;

if constexpr (target::os == target::macos) {
    import <libproc.h>;
}

// What the marker tasks share: the marks they write, in order.
struct Log {
    char marks[64];
    usize length;
};

struct Marker {
    Log *log;
    char name;
    usize rounds;
};

void log_mark(Log *log, char mark) {
    log->marks[log->length] = mark;
    log->length += 1;
}

// Writes its name `rounds` times, pausing after each.
void run_marker(Marker *marker) {
    for (usize i = 0; i < marker->rounds; i++) {
        log_mark(marker->log, marker->name);
        task::pause();
    }
}

void check_marks(const Log *log, const char *expected) {
    test::check_equal(log->length, (usize)__builtin_strlen(expected));
    for (usize i = 0; i < log->length; i++)
        test::check_equal((i32)log->marks[i], (i32)expected[i]);
}

export void test_task_a_spawned_task_runs_at_once_and_wait_returns() {
    task::Scheduler *previous = task::use(task::inline_scheduler()); // the order of the marks is the inline one's
    defer task::use(previous);
    Log log = {};
    Marker a = {.log = &log, .name = 'a', .rounds = 1};
    task::Group group = {};
    task::spawn(&group, run_marker, &a);
    test::check_equal(log.length, (usize)1); // it ran up to its first pause
    test::check_equal(group.pending, (usize)1);
    task::wait(&group);
    test::check_equal(group.pending, (usize)0);
}

export void test_task_a_group_waits_for_three_tasks_that_each_pause_twice() {
    task::Scheduler *previous = task::use(task::inline_scheduler()); // the order of the marks is the inline one's
    defer task::use(previous);
    Log log = {};
    Marker a = {.log = &log, .name = 'a', .rounds = 2};
    Marker b = {.log = &log, .name = 'b', .rounds = 2};
    Marker c = {.log = &log, .name = 'c', .rounds = 2};
    task::Group group = {};
    task::spawn(&group, run_marker, &a);
    task::spawn(&group, run_marker, &b);
    task::spawn(&group, run_marker, &c);
    check_marks(&log, "abc"); // each ran at once up to its first pause
    task::wait(&group);
    check_marks(&log, "abcabc"); // and the others in the order they paused
    test::check_equal(group.pending, (usize)0);
}

export void test_task_main_pauses_and_the_others_run_a_round() {
    task::Scheduler *previous = task::use(task::inline_scheduler()); // the order of the marks is the inline one's
    defer task::use(previous);
    Log log = {};
    Marker a = {.log = &log, .name = 'x', .rounds = 2};
    task::Group group = {};
    defer task::wait(&group);
    test::check(log.length == 0);
    task::spawn(&group, run_marker, &a);
    test::check_equal(log.length, (usize)1);
    task::pause(); // main offers the thread: the paused task writes its second mark
    test::check_equal(log.length, (usize)2);
}

export void test_task_pause_with_no_other_task_returns_at_once() {
    task::pause();
    task::pause();
}

struct Parent {
    Log *log;
    Marker *inner;
};

// A task spawns a task of its own into a group of its own and waits for it.
void run_parent(Parent *parent) {
    task::Group children = {};
    defer task::wait(&children);
    task::spawn(&children, run_marker, parent->inner);
    log_mark(parent->log, 'p');
}

export void test_task_a_task_spawns_into_a_nested_group() {
    task::Scheduler *previous = task::use(task::inline_scheduler()); // the order of the marks is the inline one's
    defer task::use(previous);
    Log log = {};
    Marker inner = {.log = &log, .name = 'i', .rounds = 2};
    Parent parent = {.log = &log, .inner = &inner};
    task::Group group = {};
    task::spawn(&group, run_parent, &parent);
    task::wait(&group);
    check_marks(&log, "ipi");
    test::check_equal(group.pending, (usize)0);
}

struct Deep {
    usize depth;
    usize reached;
};

// A frame of 128 KB, half of the stack, touched at both ends.
usize use_stack(usize n) {
    volatile u8 big[131072];
    big[0] = 1;
    big[131071] = 2;
    return n + big[0] + big[131071];
}

void run_deep(Deep *deep) {
    deep->reached = use_stack(deep->depth);
}

export void test_task_a_task_has_a_stack_of_256_kilobytes() {
    Deep deep = {.depth = 100};
    task::Group group = {};
    task::spawn(&group, run_deep, &deep);
    task::wait(&group);
    test::check_equal(deep.reached, (usize)103);
}

void run_count(usize *count) {
    __atomic_fetch_add(count, 1, __ATOMIC_RELAXED); // tasks of the default scheduler run at the same time
}

// Each task ends at once, so its two mappings (guard and stack) are gone before the next is made: the count is far
// below Linux's default vm.max_map_count of 65530, which caps the tasks that are alive at one time (about 32,000).
export void test_task_ten_thousand_tasks_come_and_go_in_one_group() {
    usize count = 0;
    task::Group group = {};
    for (usize i = 0; i < 10000; i++)
        task::spawn(&group, run_count, &count);
    task::wait(&group);
    test::check_equal(count, (usize)10000);
    test::check_equal(group.pending, (usize)0);
}

// Writes just below the end of the stack it runs on, which is the guard page.
void run_overflow(u8 *unused) {
    (void)unused;
    volatile u8 here = 0;
    volatile u8 *below = (volatile u8 *)&here - 262144;
    *below = 1;
}

// NOLINTBEGIN(smith-effects): a forked child of the test is the only way to survive a fault
// A child process runs the overflow and must die of it; the test process is not hurt.
export void test_task_a_write_below_the_stack_faults() {
    i32 child = c::fork();
    test::check(child >= 0);
    if (child == 0) {
        u8 unused = 0;
        task::Group group = {};
        task::spawn(&group, run_overflow, &unused);
        task::wait(&group);
        c::_exit(0); // reached only if the write did not fault
    }
    i32 status = 0;
    test::check_equal(c::waitpid(child, &status, 0), child);
    test::check(status != 0);
}
// NOLINTEND(smith-effects)

// A console that counts the bytes written to it, for telling whose handlers a task sees.
struct CountingConsole {
    console::Handler base; // first: &x.base is what set_handler takes
    usize written;
};

isize counting_write(console::Handler *self, i32 fd, const void *buffer, usize size) {
    (void)fd;
    (void)buffer;
    ((CountingConsole *)self)->written += size;
    return (isize)size;
}

CountingConsole make_console() {
    CountingConsole fake = {};
    fake.base.write = counting_write;
    return fake;
}

// NOLINTBEGIN(smith-preprocessor)
constexpr i32 error_badf = c::EBADF;
constexpr i32 error_noent = c::ENOENT;
// NOLINTEND(smith-preprocessor)

constexpr usize arena_bytes = 4096;

struct Seen {
    CountingConsole *console;         // A's fake
    arena::Arena *arena;              // A's arena, under its allocator
    mem::Allocator *thread_allocator; // the thread's own (the test runner's checker), which B must still see
    bool a_installed;
    bool b_saw_no_console;
    bool b_saw_no_allocator;
    bool b_allocated;
    bool a_kept_console;
    bool a_kept_allocator;
    usize a_written;
    bool child_inherited_console;
    bool child_inherited_allocator;
    bool a_kept_after_child;
    i32 a_errno;
    i32 b_errno;
};

// Task A installs a fake console and an arena allocator, pauses, and checks they are still its own when it resumes.
void run_installer(Seen *seen) {
    arena::ArenaAllocator allocator = arena::allocator(seen->arena);
    mem::Allocator *before_allocator = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(before_allocator);
    console::Handler *before_console = console::set_handler(&seen->console->base);
    defer console::set_handler(before_console);
    seen->a_installed = c::smith_handlers_console() == &seen->console->base;
    task::pause();
    seen->a_kept_console = c::smith_handlers_console() == &seen->console->base;
    seen->a_kept_allocator = mem::allocator() == &allocator.base;
    void *block = mem::alloc_raw(16, 1); // the arena's, not the thread's
    seen->a_kept_allocator = seen->a_kept_allocator && arena::fits(seen->arena, 16, 1) && block != nullptr;
    mem::free(block);
    console::print("hello");
    seen->a_written = seen->console->written;
}

// Task B shares A's thread and sees none of A's handlers: libc's console and the thread's allocator.
void run_bystander(Seen *seen) {
    seen->b_saw_no_console = c::smith_handlers_console() == nullptr;
    seen->b_saw_no_allocator = mem::allocator() == seen->thread_allocator;
    void *block = mem::alloc_raw(32, 1);
    seen->b_allocated = block != nullptr;
    mem::free(block);
    task::pause();
}

export void test_task_each_task_has_its_own_handlers_across_a_switch() {
    task::Scheduler *previous = task::use(task::inline_scheduler()); // the order of the marks is the inline one's
    defer task::use(previous);
    static u8 memory[arena_bytes];
    arena::Arena local = arena::fixed(memory, arena_bytes);
    CountingConsole fake = make_console();
    Seen seen = {.console = &fake, .arena = &local, .thread_allocator = mem::allocator()};
    task::Group group = {};
    defer task::wait(&group);
    task::spawn(&group, run_installer, &seen);
    test::check(seen.a_installed);
    test::check(c::smith_handlers_console() == nullptr); // main's table is untouched
    task::spawn(&group, run_bystander, &seen);
    test::check(seen.b_saw_no_console);
    test::check(seen.b_saw_no_allocator);
    test::check(seen.b_allocated);
    task::wait(&group);
    test::check(seen.a_kept_console);
    test::check(seen.a_kept_allocator);
    test::check_equal(seen.a_written, (usize)5);
    test::check(c::smith_handlers_console() == nullptr);
}

void run_child(Seen *seen) {
    seen->child_inherited_console = c::smith_handlers_console() == &seen->console->base;
    seen->child_inherited_allocator = mem::allocator() != nullptr;
    mem::Allocator *none = mem::set_allocator(nullptr); // what it sets stays its own
    (void)none;
}

void run_spawner(Seen *seen) {
    arena::ArenaAllocator allocator = arena::allocator(seen->arena);
    mem::Allocator *before = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(before);
    console::Handler *before_console = console::set_handler(&seen->console->base);
    defer console::set_handler(before_console);
    task::Group children = {};
    task::spawn(&children, run_child, seen);
    task::wait(&children);
    seen->a_kept_after_child = mem::allocator() == &allocator.base;
}

export void test_task_a_spawned_task_starts_with_its_spawners_handlers() {
    static u8 memory[arena_bytes];
    arena::Arena local = arena::fixed(memory, arena_bytes);
    CountingConsole fake = make_console();
    Seen seen = {.console = &fake, .arena = &local};
    task::Group group = {};
    task::spawn(&group, run_spawner, &seen);
    task::wait(&group);
    test::check(seen.child_inherited_console);
    test::check(seen.child_inherited_allocator);
    test::check(seen.a_kept_after_child);
}

i32 *errno_slot() {
    if constexpr (target::os == target::macos) {
        return c::__error();
    } else {
        return c::__errno_location();
    }
}

void set_errno(i32 code) {
    *errno_slot() = code;
}

i32 get_errno() {
    return *errno_slot();
}

void run_errno_a(Seen *seen) {
    set_errno(error_badf);
    task::pause();
    seen->a_errno = get_errno();
}

void run_errno_b(Seen *seen) {
    set_errno(error_noent);
    task::pause();
    seen->b_errno = get_errno();
}

export void test_task_each_task_has_its_own_errno_across_a_switch() {
    Seen seen = {};
    task::Group group = {};
    defer task::wait(&group);
    task::spawn(&group, run_errno_a, &seen);
    task::spawn(&group, run_errno_b, &seen);
    task::wait(&group);
    test::check_equal(seen.a_errno, error_badf);
    test::check_equal(seen.b_errno, error_noent);
}

// A scheduler that counts what it is asked and hands each call to the inline one.
struct Counting {
    task::Scheduler base; // first, so a pointer to the scheduler is a pointer to the counter
    task::Scheduler *inner;
    i32 spawns;
    i32 pauses;
    i32 waits;
};

void counting_spawn(task::Scheduler *self, task::Group *group, void (*entry)(void *context), void *context) {
    Counting *counting = (Counting *)self;
    counting->spawns += 1;
    counting->inner->spawn(counting->inner, group, entry, context);
}

void counting_pause(task::Scheduler *self) {
    Counting *counting = (Counting *)self;
    counting->pauses += 1;
    counting->inner->pause(counting->inner);
}

void counting_wait(task::Scheduler *self, task::Group *group) {
    Counting *counting = (Counting *)self;
    counting->waits += 1;
    counting->inner->wait(counting->inner, group);
}

Counting make_counting() {
    return (Counting){.base = {.spawn = counting_spawn, .pause = counting_pause, .wait = counting_wait},
                      .inner = task::inline_scheduler()};
}

struct Nested {
    Log *log;
    task::Group *group;
};

void run_nested_child(Log *log) {
    log_mark(log, 'c');
}

void run_nested_parent(Nested *nested) {
    log_mark(nested->log, 'p');
    task::spawn(nested->group, run_nested_child, nested->log);
}

export void test_task_a_counting_scheduler_sees_each_spawn_pause_and_wait() {
    Counting counting = make_counting();
    task::Scheduler *previous = task::use(&counting.base);
    defer task::use(previous);
    Log log = {};
    Marker a = {.log = &log, .name = 'a', .rounds = 1};
    Marker b = {.log = &log, .name = 'b', .rounds = 1};
    task::Group group = {};
    task::spawn(&group, run_marker, &a);
    task::spawn(&group, run_marker, &b);
    task::wait(&group);
    check_marks(&log, "ab");
    test::check_equal(counting.spawns, 2);
    test::check_equal(counting.waits, 1);
    test::check_equal(counting.pauses, 2); // each marker pauses once, through the scheduler it was spawned under
    test::check_equal(group.pending, (usize)0);
}

export void test_task_use_returns_the_previous_and_defer_restores_it() {
    Counting outer = make_counting();
    Counting inner = make_counting();
    task::Scheduler *original = task::use(&outer.base);
    defer task::use(original);
    {
        task::Scheduler *previous = task::use(&inner.base);
        defer task::use(previous);
        test::check(previous == &outer.base);
        test::check(c::smith_handlers_scheduler() == &inner.base);
    }
    test::check(c::smith_handlers_scheduler() == &outer.base);
    task::pause();
    test::check_equal(outer.pauses, 1);
    test::check_equal(inner.pauses, 0);
}

export void test_task_a_task_spawned_under_a_scheduler_that_spawns_again_is_counted() {
    Counting counting = make_counting();
    task::Scheduler *previous = task::use(&counting.base);
    defer task::use(previous);
    Log log = {};
    task::Group group = {};
    Nested nested = {.log = &log, .group = &group};
    task::spawn(&group, run_nested_parent, &nested);
    task::wait(&group);
    check_marks(&log, "pc");
    test::check_equal(counting.spawns, 2);
}

// The threads of this process, counted through the system.
usize thread_count() {
    // NOLINTBEGIN(smith-effects): the system is asked, which is the point
    if constexpr (target::os == target::macos) {
        struct c::proc_taskinfo info = {};
        c::proc_pidinfo(c::getpid(), c::PROC_PIDTASKINFO, 0, &info, (i32)sizeof(info));
        return (usize)info.pti_threadnum;
    } else {
        c::DIR *folder = c::opendir("/proc/self/task");
        usize count = 0;
        for (struct c::dirent *entry = c::readdir(folder); entry != nullptr; entry = c::readdir(folder)) {
            if (entry->d_name[0] != '.') count += 1;
        }
        c::closedir(folder);
        return count;
    }
    // NOLINTEND(smith-effects)
}

// NOLINTBEGIN(smith-preprocessor)
constexpr i32 processors_name = c::_SC_NPROCESSORS_ONLN;
constexpr i32 monotonic_clock = c::CLOCK_MONOTONIC;
// NOLINTEND(smith-preprocessor)

usize processors() {
    return (usize)c::sysconf(processors_name); // NOLINT(smith-effects)
}

void run_count_threads(usize *seen) {
    *seen = thread_count();
    task::pause();
}

export void test_task_a_program_that_never_spawns_has_one_thread() {
    test::check_equal(thread_count(), (usize)1);
    task::pause();
    task::Group group = {};
    task::wait(&group);
    test::check_equal(thread_count(), (usize)1);
}

export void test_task_workers_start_at_the_first_spawn_and_end_with_the_last_task() {
    test::check_equal(thread_count(), (usize)1);
    usize seen = 0;
    {
        task::Group group = {};
        defer task::wait(&group);
        task::spawn(&group, run_count_threads, &seen);
    }
    test::check_equal(seen, processors()); // one thread per core, the first being main's
    test::check_equal(thread_count(), (usize)1);
}

// CPU time of the calling thread, in nanoseconds.
u64 thread_nanoseconds() {
    struct c::timespec now = {};
    c::clock_gettime(monotonic_clock, &now); // NOLINT(smith-effects)
    return (u64)now.tv_sec * 1000000000U + (u64)now.tv_nsec;
}

void spin_50_milliseconds(usize *unused) {
    (void)unused;
    u64 began = thread_nanoseconds();
    while (thread_nanoseconds() - began < 50000000U) { // NOLINT(smith-bounded-loop): a fixed time
    }
}

export void test_task_eight_tasks_that_spin_run_on_every_core() {
    if (processors() < 4) return;
    usize unused = 0;
    u64 began = thread_nanoseconds();
    {
        task::Group group = {};
        defer task::wait(&group);
        for (usize i = 0; i < 8; i++)
            task::spawn(&group, spin_50_milliseconds, &unused);
    }
    u64 elapsed = thread_nanoseconds() - began;
    test::check(elapsed < 300000000U); // eight in series would be 400 ms; four at a time is about 100
}

// The address of this is different on every thread: it names the thread a task is running on.
thread_local u8 thread_marker;

struct Home {
    const u8 *began; // the thread marker where the task began
    bool same_thread;
};

void run_stay(Home *home) {
    home->began = &thread_marker;
    home->same_thread = true;
    for (usize round = 0; round < 5; round++) {
        task::pause();
        if (home->began != &thread_marker) home->same_thread = false;
    }
}

export void test_task_every_task_ends_on_the_thread_it_began_on() {
    Home homes[64] = {};
    {
        task::Group group = {};
        defer task::wait(&group);
        for (usize i = 0; i < 64; i++)
            task::spawn(&group, run_stay, &homes[i]);
    }
    for (usize i = 0; i < 64; i++)
        test::check(homes[i].same_thread);
}

export void test_task_a_hundred_thousand_tasks_in_one_group_finish() {
    usize count = 0;
    task::Group group = {};
    for (usize i = 0; i < 100000; i++)
        task::spawn(&group, run_count, &count);
    task::wait(&group);
    test::check_equal(count, (usize)100000);
    test::check_equal(group.pending, (usize)0);
}

struct Waiter {
    task::Group *inner;
    usize *count;
    usize done;
};

void run_waiting_parent(Waiter *waiter) {
    task::Group children = {};
    for (usize i = 0; i < 20; i++)
        task::spawn(&children, run_count, waiter->count);
    task::wait(&children); // parks this task; the last child wakes it on its own worker
    waiter->done = *waiter->count;
}

export void test_task_a_task_waits_for_its_children_and_is_woken_on_its_worker() {
    usize count = 0;
    Waiter waiters[16] = {};
    task::Group group = {};
    for (usize i = 0; i < 16; i++) {
        waiters[i].count = &count;
        task::spawn(&group, run_waiting_parent, &waiters[i]);
    }
    task::wait(&group);
    test::check_equal(count, (usize)320);
    for (usize i = 0; i < 16; i++)
        test::check(waiters[i].done >= 20);
}
