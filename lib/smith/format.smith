// smith::format, <smith/format.h>: formatted text into a buffer or an arena, in place of snprintf. Written in .smith
// only: a generic function has no C spelling, so the header declares the types and C keeps snprintf.
module smith::format;

import smith::arena;
import smith::contract;
import smith::io;

// <smith/format.h>: a type-checked formatter. There is no format string: the arguments are the pieces of the text, in
// order, and the type of each one picks how it is written, when the call is compiled. A type it has no rule for is a
// compile-time error at the call (the note names the instance, `format::to(char *, usize, Point)`).
//
//   format::Written written = format::to(buffer, sizeof buffer, "count: ", n, " of ", total, "\n");
//   if (!written.fits) ...                                   // the text was cut; written.length is what it needed
//   char path[:] = format::push(&arena, folder, "/", name, ".smith");       // path.data is terminated too
//
// What each type is written as, with no locale and no C library function:
//   bool                      true or false
//   char                      the character
//   i8..i64, u8..u64, usize   decimal digits, a leading - for a negative number (i8 is a number, char is a character)
//   f32, f64                  the shortest digits that read back as the same value
//                             (0.1f is 0.1, 1e22, 5e-324); inf, -inf and nan for what has no number
//   char *, const char *      the terminated string; a null pointer is (null)
//   char[:], const char[:]    its count of characters, which need no terminator
//   format::Hex               lowercase hexadecimal, zero-padded to a width: format::hex(value, 16), format::hex(x, 0)
//   format::Fixed             a fixed number of places, rounded as printf's %.Nf does: format::fixed(value, 3)
//   format::General           printf's %.Ng: format::general(value, 6), format::Scientific is %.Ne: scientific(value,
//   3) format::Padded            any of the above in a column of width characters: format::pad(n, 5) is %5d,
//                             format::left(name, 16) is %-16s, format::pad(format::fixed(x, 1), 6) is %6.1f
//   a struct                  {m = 1, b = 2}: each field by the rule of its type, a nested struct the same way, a
//                             fixed array as [1, 2, 3]; the fields come from fields(T) at compile time. A union or a
//                             struct with an anonymous member is an error (fields(T) has none).
// Anything else (a pointer, an enum) is an error: convert it to what it means, (u64)(usize)pointer.
//
// Writing never stops. The text is cut where the buffer ends, the buffer is always terminated (when it has room for
// the terminator), and the result says how long the whole text is, so a caller can retry with room, as snprintf does.
// format::push asks the arena for exactly that room (a push the arena cannot serve stops, as every arena push does).

// Room for write_u64 and write_i64: a 64-bit number has at most 20 characters, with a sign 20 as well (u64 is the
// longest unsigned; i64's longest is 20 with its minus). Writes have no terminator.
export constexpr usize number_capacity = 20;

// Room for write_f64.
export constexpr usize f64_capacity = 32;

// Room for write_f32.
export constexpr usize f32_capacity = 24;

// A check that stays in every build and is no contract the prover reads: the bignum arithmetic and the float text of
// this module cost the prover far more than they are worth, so a proof of a caller assumes the check held. Trusted, its
// body is never read, so the assert is a run-time check: it writes the failure report (the line of the call and the
// stack) in every build.
void check(bool holds) {
    contract::trusted();
    contract::assert(holds);
    if (!holds) __builtin_trap();
}

// ---------------------------------------------------------------------------------------------------------------
// Whole numbers

constexpr u64 u64_max = ~(u64)0;
constexpr i64 i64_max = (i64)(u64_max >> 1);

// Whole numbers: decimal digits, with an optional leading - for the signed one, or lowercase hexadecimal digits.
// Leading zeros of any number are fine. Each returns false for an empty word, a stray character (a +, a space, a
// capital hex digit) or a value that doesn't fit.
// The digits of word from start on (start is 0, or 1 after a minus sign).
bool parse_digits(const char word[:], usize start, u64 *value) {
    if (start >= countof(word)) return false;
    u64 result = 0;
    for (usize i = start; i < countof(word); i++) {
        char c = word[i];
        if (c < '0' || c > '9') return false;
        u64 digit = (u64)(c - '0');
        if (result > (u64_max - digit) / 10) return false;
        result = result * 10 + digit;
    }
    *value = result;
    return true;
}

bool read_u64(const char word[:], u64 *value) {
    return parse_digits(word, 0, value);
}

bool read_i64(const char word[:], i64 *value) {
    bool negative = countof(word) > 0 && word[0] == '-';
    u64 magnitude = 0;
    if (!parse_digits(word, negative ? 1 : 0, &magnitude)) return false;
    u64 limit = negative ? (u64)i64_max + 1 : (u64)i64_max;
    if (magnitude > limit) return false;
    *value = negative ? (i64)(0 - magnitude) : (i64)magnitude;
    return true;
}

// ---------------------------------------------------------------------------------------------------------------
// Decimal to f32 or f64, correctly rounded. A decimal is digits D (an integer) times 10^exp10. Two paths give the
// nearest value:
//  - the fast path, for D below 10^15 and a power of ten up to 22, where D and the power are exact f64s, so one
//    multiply or divide is the f64 nearest the number. For a f64 that is the answer; for a f32, rounding it
//    again is right unless it sits exactly halfway between two floats (which it hands to the slow path);
//  - the slow path, exact: the number as a ratio of two big integers, divided to p + 2 bits and rounded by hand.
// Digits past the first 800 cannot change a result: a f64, or the point halfway between two, has at most 767
// significant digits (a f32's, 115), so any longer decimal differs from all of them, and the value between D and
// D + 1 rounds like D followed by a 1, which is what a nonzero tail becomes.

constexpr usize digits_max = 800;
constexpr usize big_limbs = 128; // 4096 bits; the largest number below is about 3800, for a f64
constexpr i64 exponent_max = 1'000'000;
constexpr usize fast_digits_max = 15;
constexpr i64 fast_exponent_max = 22;
constexpr u32 chunk_digits = 9;

// What differs between the two formats the slow path rounds to.
typedef struct {
    u32 mantissa_bits;     // 24 for a f32, 53 for a f64
    i64 smallest_exponent; // the last place of a subnormal is 2^smallest_exponent
    i64 field_offset;      // the exponent field of kept * 2^e is e + field_offset
    i64 field_infinity;    // the field of infinity
} Format;

constexpr u32 infinity_bits = 0x7f800000;
constexpr u64 double_infinity_bits = 0x7ff0000000000000;

constexpr Format float_format = {24, -149, 150, 255};
constexpr Format double_format = {53, -1074, 1075, 2047};

const f64 powers[fast_exponent_max + 1] = {
    1e0,  1e1,  1e2,  1e3,  1e4,  1e5,  1e6,  1e7,  1e8,  1e9,  1e10, 1e11,
    1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22,
};

constexpr u32 powers_u32[chunk_digits + 1] = {
    1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000,
};

// An unsigned integer of up to 1024 bits, little-endian in 32-bit limbs. `count` limbs are in use, the top one nonzero.
typedef struct {
    u32 limb[big_limbs];
    usize count;
} Big;

// big = big * multiplier + addend.
void big_mul_add(Big *big, u32 multiplier, u32 addend) {
    u64 carry = addend;
    for (usize i = 0; i < big->count; i++) {
        u64 product = (u64)big->limb[i] * multiplier + carry;
        big->limb[i] = (u32)product;
        carry = product >> 32;
    }
    if (carry != 0) {
        check(big->count < big_limbs); // a number grew past its limbs
        big->limb[big->count] = (u32)carry;
        big->count += 1;
    }
}

// big = big * 10^power.
void big_mul_pow10(Big *big, u64 power) {
    while (power >= chunk_digits) {
        big_mul_add(big, powers_u32[chunk_digits], 0);
        power -= chunk_digits;
    }
    big_mul_add(big, powers_u32[power], 0);
}

u64 big_bits(const Big *big) {
    if (big->count == 0) return 0;
    u32 top = big->limb[big->count - 1];
    u64 bits = (u64)(big->count - 1) * 32;
    while (top != 0) {
        bits += 1;
        top >>= 1;
    }
    return bits;
}

void big_shift_left(Big *big, u64 shift) {
    if (big->count == 0 || shift == 0) return;
    usize whole = (usize)(shift / 32);
    u32 part = (u32)(shift % 32);
    check(big->count + whole + 1 <= big_limbs); // a shift grew a number past its limbs
    big->limb[big->count + whole] = 0;
    for (usize i = big->count; i-- > 0;) {
        u64 moved = (u64)big->limb[i] << part;
        big->limb[i + whole + 1] |= (u32)(moved >> 32);
        big->limb[i + whole] = (u32)moved;
    }
    for (usize i = 0; i < whole; i++) {
        big->limb[i] = 0;
    }
    big->count += whole + 1;
    while (big->count > 0 && big->limb[big->count - 1] == 0) {
        big->count -= 1;
    }
}

void big_shift_right_one(Big *big) {
    for (usize i = 0; i < big->count; i++) {
        u32 above = i + 1 < big->count ? big->limb[i + 1] : 0;
        big->limb[i] = (big->limb[i] >> 1) | (above << 31);
    }
    for (usize pass = 0; pass < big_limbs && big->count > 0 && big->limb[big->count - 1] == 0; pass++) {
        big->count -= 1;
    }
}

bool big_at_least(const Big *a, const Big *b) {
    if (a->count != b->count) return a->count > b->count;
    for (usize i = a->count; i-- > 0;) {
        if (a->limb[i] != b->limb[i]) return a->limb[i] > b->limb[i];
    }
    return true;
}

// a = a - b, where a >= b.
void big_subtract(Big *a, const Big *b) {
    u64 borrow = 0;
    for (usize i = 0; i < a->count; i++) {
        u64 take = (i < b->count ? b->limb[i] : 0) + borrow;
        borrow = a->limb[i] < take ? 1 : 0;
        a->limb[i] = (u32)((u64)a->limb[i] - take);
    }
    check(borrow == 0); // a subtraction went below zero
    while (a->count > 0 && a->limb[a->count - 1] == 0) {
        a->count -= 1;
    }
}

// The bits nearest to numerator / denominator in a format, ties to even, or the infinity bits if that is out of range.
u64 ratio_to_bits(const Format *format, Big numerator, Big denominator) {
    // Scale so that numerator / denominator, times 2^scale, lies in (2^p, 2^(p+2)) for p mantissa bits: its integer
    // part q has p + 1 or p + 2 bits, and the remainder says what is left of the last one.
    i64 p = format->mantissa_bits;
    i64 scale = p + 1 - ((i64)big_bits(&numerator) - (i64)big_bits(&denominator));
    if (scale >= 0)
        big_shift_left(&numerator, (u64)scale);
    else
        big_shift_left(&denominator, (u64)(0 - scale));
    Big step = denominator;
    big_shift_left(&step, (u64)(p + 1));
    u64 q = 0;
    for (u32 bit = format->mantissa_bits + 2; bit-- > 0;) {
        if (big_at_least(&numerator, &step)) {
            big_subtract(&numerator, &step);
            q |= (u64)1 << bit;
        }
        big_shift_right_one(&step);
    }
    // The number is (q + numerator / denominator) * 2^-scale. Keep p bits, or fewer where the result is subnormal,
    // and round by the bits dropped.
    i64 drop = (q >> (format->mantissa_bits + 1)) != 0 ? 2 : 1;
    if (scale + format->smallest_exponent > drop) drop = scale + format->smallest_exponent;
    if (drop > p + 2) return 0;
    u64 shift = (u64)drop;
    u64 kept = q >> shift;
    u64 low = q & (((u64)1 << shift) - 1);
    u64 half = (u64)1 << (shift - 1);
    if (low > half || (low == half && (numerator.count != 0 || (kept & 1) != 0))) kept += 1;
    i64 exponent = drop - scale; // the number is kept * 2^exponent
    u64 one = (u64)1 << (format->mantissa_bits - 1);
    if (exponent + format->field_offset >= format->field_infinity) return (u64)format->field_infinity * one;
    // A normal number's top bit carries into the exponent field, which also rounds 2^p up to the next power of two.
    return (u64)(exponent + format->field_offset) * one + kept - one;
}

// What the scan of a decimal found.
typedef struct {
    Big digits;
    u64 small; // the digits as an integer, good while there are at most 19
    usize significant;
    u32 chunk;
    u32 chunk_length;
    i64 exp10;
    bool sticky; // nonzero digits were dropped past the 800th
} Decimal;

// An empty decimal. The limbs are left alone: only the first `count` of them are ever read, and zeroing 512 bytes
// would cost more than the whole parse of a short number.
void decimal_init(Decimal *decimal) {
    decimal->digits.count = 0;
    decimal->small = 0;
    decimal->significant = 0;
    decimal->chunk = 0;
    decimal->chunk_length = 0;
    decimal->exp10 = 0;
    decimal->sticky = false;
}

void decimal_add_digit(Decimal *decimal, u32 digit, bool in_fraction) {
    if (decimal->significant == 0 && digit == 0) { // a leading zero adds nothing but a place
        if (in_fraction) decimal->exp10 -= 1;
        return;
    }
    if (decimal->significant >= digits_max) {
        if (digit != 0) decimal->sticky = true;
        if (!in_fraction) decimal->exp10 += 1;
        return;
    }
    decimal->significant += 1;
    decimal->small = decimal->small * 10 + digit;
    decimal->chunk = decimal->chunk * 10 + digit;
    decimal->chunk_length += 1;
    if (decimal->chunk_length == chunk_digits) {
        big_mul_add(&decimal->digits, powers_u32[chunk_digits], decimal->chunk);
        decimal->chunk = 0;
        decimal->chunk_length = 0;
    }
    if (in_fraction) decimal->exp10 -= 1;
}

// Reads digits with at most one point from word[*index], and returns whether there was a digit.
bool decimal_scan_mantissa(const char word[:], usize *index, Decimal *decimal) {
    bool in_fraction = false;
    bool any = false;
    usize i = *index;
    for (; i < countof(word); i++) {
        char c = word[i];
        if (c == '.' && !in_fraction) {
            in_fraction = true;
        } else if (c >= '0' && c <= '9') {
            decimal_add_digit(decimal, (u32)(c - '0'), in_fraction);
            any = true;
        } else {
            break;
        }
    }
    *index = i;
    return any;
}

// Reads an optional exponent at word[*index] into exp10, and returns false for an e with no digits.
bool decimal_scan_exponent(const char word[:], usize *index, Decimal *decimal) {
    usize i = *index;
    if (i >= countof(word)) return true;
    char marker = word[i];
    if (marker != 'e' && marker != 'E') return true;
    i += 1;
    bool negative = i < countof(word) && word[i] == '-';
    if (i < countof(word) && (word[i] == '-' || word[i] == '+')) i += 1;
    u64 magnitude = 0; // unsigned: at most exponent_max * 10 + 9, which no checked signed arithmetic needs to show
    usize digits = 0;
    for (; i < countof(word) && word[i] >= '0' && word[i] <= '9'; i++) {
        if (magnitude < (u64)exponent_max) magnitude = magnitude * 10 + (u64)(word[i] - '0');
        digits += 1;
    }
    if (digits == 0) return false;
    decimal->exp10 =
        (i64)((u64)decimal->exp10 + (negative ? 0 - magnitude : magnitude)); // two's complement, no overflow
    *index = i;
    return true;
}

// The exact path: the digits over a power of ten, as a ratio of big integers.
u64 decimal_exact(const Decimal *decimal, const Format *format) {
    Big numerator = decimal->digits;
    Big denominator = {.limb = {1}, .count = 1};
    if (decimal->exp10 >= 0)
        big_mul_pow10(&numerator, (u64)decimal->exp10);
    else
        big_mul_pow10(&denominator, (u64)(0 - decimal->exp10));
    return ratio_to_bits(format, numerator, denominator);
}

// Whether the decimal is a number of at most 15 digits times an exactly represented power of ten.
bool decimal_is_fast(const Decimal *decimal) {
    return !decimal->sticky && decimal->significant <= fast_digits_max && decimal->exp10 >= -fast_exponent_max &&
           decimal->exp10 <= fast_exponent_max;
}

// The f64 nearest the decimal when it is_fast: one multiply or divide of two exact f64s.
f64 decimal_fast(const Decimal *decimal) {
    f64 exact = (f64)decimal->small;
    f64 power = powers[decimal->exp10 < 0 ? -decimal->exp10 : decimal->exp10];
    return decimal->exp10 < 0 ? exact / power : exact * power;
}

// Finishes the digits of a decimal that the scan left in a partial chunk, and adds the sticky digit.
void decimal_finish(Decimal *decimal) {
    if (decimal->chunk_length != 0) big_mul_add(&decimal->digits, powers_u32[decimal->chunk_length], decimal->chunk);
    if (decimal->sticky) {
        big_mul_add(&decimal->digits, 10, 1);
        decimal->exp10 -= 1;
        decimal->significant += 1;
    }
}

// The f32 for a scanned decimal, as bits, or nothing for a number that would be infinity.
bool decimal_to_f32_bits(Decimal *decimal, u32 *bits) {
    if (decimal->significant == 0) {
        *bits = 0;
        return true;
    }
    decimal_finish(decimal);
    i64 magnitude = (i64)decimal->significant + decimal->exp10; // the number lies below 10^magnitude
    if (magnitude >= 40) return false;                          // at least 10^39, above the largest f32
    if (magnitude <= -47) {                                     // below 10^-47, under half the smallest
        *bits = 0;
        return true;
    }
    if (decimal_is_fast(decimal)) {
        f64 nearest = decimal_fast(decimal);
        u64 nearest_bits = __builtin_bit_cast(u64, nearest);
        bool halfway = (nearest_bits & 0x1fffffff) == 0x10000000; // between two floats: look closer
        if (nearest >= (f64)__FLT_MIN__ && nearest <= 1e38 && !halfway) {
            *bits = __builtin_bit_cast(u32, (f32)nearest);
            return true;
        }
    }
    *bits = (u32)decimal_exact(decimal, &float_format);
    return *bits < infinity_bits;
}

// The same for a f64.
bool decimal_to_f64_bits(Decimal *decimal, u64 *bits) {
    if (decimal->significant == 0) {
        *bits = 0;
        return true;
    }
    decimal_finish(decimal);
    i64 magnitude = (i64)decimal->significant + decimal->exp10;
    if (magnitude >= 310) return false; // at least 10^309, above the largest f64
    if (magnitude <= -325) {            // below 10^-325, under half the smallest
        *bits = 0;
        return true;
    }
    if (decimal_is_fast(decimal)) {
        f64 nearest = decimal_fast(decimal); // one rounding of exact operands: the answer
        if (nearest >= __DBL_MIN__ && nearest <= 1e300) {
            *bits = __builtin_bit_cast(u64, nearest);
            return true;
        }
    }
    *bits = decimal_exact(decimal, &double_format);
    return *bits < double_infinity_bits;
}

// Scans a whole word: a sign, digits and an exponent. Returns whether it is a number, and whether it is negative.
bool decimal_scan(const char word[:], Decimal *decimal, bool *negative) {
    usize index = 0;
    *negative = countof(word) > 0 && word[0] == '-';
    if (countof(word) > 0 && (word[0] == '-' || word[0] == '+')) index = 1;
    if (!decimal_scan_mantissa(word, &index, decimal)) return false;
    if (!decimal_scan_exponent(word, &index, decimal)) return false;
    return index == countof(word);
}

// A decimal number: an optional sign, digits with an optional fraction (-90, 0.25, .5, 5.), and an optional exponent
// (1e-5, 2.5E+3). The result is the f32 nearest to the number, ties to even, as strtof gives in the C locale, for
// any number of digits; "-0" is negative zero. It returns false for no digits, a stray character, or a number too
// large for an f32 (it would round to infinity). One too small rounds to zero or to a subnormal. No inf or nan.
bool read_f32(const char word[:], f32 *value) {
    Decimal decimal;
    decimal_init(&decimal);
    bool negative = false;
    if (!decimal_scan(word, &decimal, &negative)) return false;
    u32 bits = 0;
    if (!decimal_to_f32_bits(&decimal, &bits)) return false;
    if (negative) bits |= 0x80000000;
    *value = __builtin_bit_cast(f32, bits);
    return true;
}

// The same for an f64: the f64 nearest the number, ties to even, as strtod gives in the C locale, for any number
// of digits. It returns false for a number that would round to infinity (above about 1.7976931348623157e308).
bool read_f64(const char word[:], f64 *value) {
    Decimal decimal;
    decimal_init(&decimal);
    bool negative = false;
    if (!decimal_scan(word, &decimal, &negative)) return false;
    u64 bits = 0;
    if (!decimal_to_f64_bits(&decimal, &bits)) return false;
    if (negative) bits |= (u64)1 << 63;
    *value = __builtin_bit_cast(f64, bits);
    return true;
}

// ---------------------------------------------------------------------------------------------------------------
// Writing numbers

[[smith::c_name("smith_format_write_u64")]] export usize write_u64(char out[:], u64 value) {
    contract::requires(countof(out) >= number_capacity);
    char reversed[number_capacity];
    usize count = 0;
    do {
        reversed[count++] = (char)('0' + value % 10);
        value /= 10;
    } while (value != 0 && count < number_capacity);
    check(value == 0);                                      // a number has more digits than number_capacity
    for (usize i = 0; i < count && i < countof(out); i++) { // the requires holds, the guard shows it to the prover
        out[i] = reversed[count - 1 - i];
    }
    contract::ensures(count >= 1 && count <= number_capacity);
    return count;
}

[[smith::c_name("smith_format_write_i64")]] export usize write_i64(char out[:], i64 value) {
    contract::requires(countof(out) >= number_capacity);
    if (value >= 0) return write_u64(out, (u64)value);
    char text[number_capacity + 1] = {'-'};
    usize count = write_u64(text[1:number_capacity + 1], 0 - (u64)value);
    for (usize i = 0; i <= count && i < countof(out) && i <= number_capacity; i++) {
        out[i] = text[i];
    }
    return count + 1;
}

// write_i64 at a pointer: the callers below have room for it by the capacities they keep.
usize append_i64(char *out, i64 value) {
    char digits[number_capacity];
    usize count = write_i64(digits, value);
    for (usize i = 0; i < count && i < number_capacity; i++) {
        out[i] = digits[i];
    }
    return count;
}

// A f64, as the fewest digits (at most 17) that read back as the same f64. With the value m * 2^e, the p-digit
// decimal nearest it is q * 10^s: q = round(m * 2^e / 10^s), ties to even, found with the big integers above. The
// number of digits is the least p that parses back to the same bits (more digits only come nearer, so a binary search
// over 1..17 finds it), and the exponent of the first digit decides between positional and scientific text.

constexpr u32 f64_digits_max = 17;
constexpr i64 f64_positional_max = 16;
constexpr i64 f64_positional_min = -5;
static_assert(f64_capacity >= 1 + f64_digits_max + 1 + 5, "sign, digits, a point and e-324");

// q = floor(numerator / denominator), which has at most 63 bits; the remainder is left in numerator.
u64 big_divide(Big *numerator, const Big *denominator) {
    i64 shift = (i64)big_bits(numerator) - (i64)big_bits(denominator);
    if (shift < 0) return 0;
    check(shift < 63); // a quotient has more than 63 bits
    Big step = *denominator;
    big_shift_left(&step, (u64)shift);
    u64 q = 0;
    for (u32 bit = (u32)shift + 1; bit-- > 0;) {
        if (big_at_least(numerator, &step)) {
            big_subtract(numerator, &step);
            q |= (u64)1 << bit;
        }
        big_shift_right_one(&step);
    }
    return q;
}

// The quotient of m * 2^e / 10^s, rounded to the nearest integer, ties to even.
u64 f64_scaled(u64 m, i64 e, i64 s, bool round) {
    Big numerator = {.limb = {(u32)m, (u32)(m >> 32)}, .count = (m >> 32) != 0 ? 2U : 1U};
    Big denominator = {.limb = {1}, .count = 1};
    if (e >= 0)
        big_shift_left(&numerator, (u64)e);
    else
        big_shift_left(&denominator, (u64)(0 - e));
    if (s >= 0)
        big_mul_pow10(&denominator, (u64)s);
    else
        big_mul_pow10(&numerator, (u64)(0 - s));
    u64 q = big_divide(&numerator, &denominator);
    if (!round) return q;
    big_shift_left(&numerator, 1); // twice the remainder against the divisor
    bool above = big_at_least(&numerator, &denominator);
    bool equal = above && big_at_least(&denominator, &numerator);
    if (above && (!equal || (q & 1) != 0)) q += 1;
    return q;
}

u64 pow10_u64(u32 power) {
    u64 result = 1;
    for (u32 i = 0; i < power; i++) {
        result *= 10;
    }
    return result;
}

// The p-digit decimal nearest m * 2^e, as q * 10^s, given the decimal exponent of the first digit.
u64 f64_round_to(u64 m, i64 e, i64 first, u32 p, i64 *s) {
    *s = first - (i64)p + 1;
    u64 q = f64_scaled(m, e, *s, true);
    if (q == pow10_u64(p)) { // 9.99 rounded up to 10.0
        q = pow10_u64(p - 1);
        *s += 1;
    }
    return q;
}

// The decimal exponent of the first digit of m * 2^e: floor(log10), from the binary exponent and then corrected.
i64 f64_first_exponent(u64 m, i64 e) {
    i64 binary = e + (i64)(64 - (u32)__builtin_clzll(m)) - 1;
    i64 first = (binary * 78913) / 262144; // binary * log10(2), within one of the floor
    for (i32 attempt = 0; attempt < 4; attempt++) {
        u64 q = f64_scaled(m, e, first, false);
        if (q == 0)
            first -= 1;
        else if (q >= 10)
            first += 1;
        else
            return first;
    }
    check(false); // no first digit found for a finite number
    return first;
}

bool f64_reads_back(u64 q, i64 s, u64 bits) {
    char text[number_capacity * 2];
    usize length = write_u64(text, q);
    text[length++] = 'e';
    length += append_i64(text + length, s);
    f64 back = 0;
    if (length > sizeof text) return false;
    return read_f64(text[0:length], &back) && __builtin_bit_cast(u64, back) == bits;
}

// Writes the digits q (p of them, the first one of exponent `first`) as positional or scientific text.
usize f64_format(char *out, u64 q, u32 p, i64 first) {
    char digits[number_capacity];
    usize count = write_u64(digits, q);
    check(count == p); // the digits are not the precision
    usize used = 0;
    if (first >= f64_positional_min && first <= f64_positional_max) {
        if (first < 0) {
            out[used++] = '0';
            out[used++] = '.';
            for (i64 i = 0; i < -first - 1; i++) {
                out[used++] = '0';
            }
        }
        for (usize i = 0; i < count; i++) {
            if (first >= 0 && (i64)i == first + 1) out[used++] = '.';
            out[used++] = digits[i];
        }
        for (i64 i = (i64)count; i < first + 1; i++) { // an integer with zeros after its digits
            out[used++] = '0';
        }
        return used;
    }
    out[used++] = digits[0];
    if (count > 1) out[used++] = '.';
    for (usize i = 1; i < count; i++) {
        out[used++] = digits[i];
    }
    out[used++] = 'e';
    return used + append_i64(out + used, first);
}

// Writes the text of a f64 at out, which has room for f64_capacity.
usize f64_write(char *out, f64 value) {
    u64 bits = __builtin_bit_cast(u64, value);
    u64 field = (bits >> 52) & 0x7ff;
    check(field != 0x7ff); // infinity and nan have no text
    usize used = 0;
    if ((bits >> 63) != 0) out[used++] = '-';
    u64 fraction = bits & 0xfffffffffffffULL;
    if (field == 0 && fraction == 0) {
        out[used++] = '0';
        return used;
    }
    u64 m = field == 0 ? fraction : fraction | ((u64)1 << 52);
    i64 e = field == 0 ? -1074 : (i64)field - 1075;
    u64 positive = bits & ~((u64)1 << 63);
    i64 first = f64_first_exponent(m, e);
    u32 low = 1;
    u32 high = f64_digits_max;
    while (low < high) {
        u32 middle = (low + high) / 2;
        i64 s = 0;
        u64 q = f64_round_to(m, e, first, middle, &s);
        if (f64_reads_back(q, s, positive))
            high = middle;
        else
            low = middle + 1;
    }
    i64 s = 0;
    u64 q = f64_round_to(m, e, first, low, &s);
    return used + f64_format(out + used, q, low, s + (i64)low - 1);
}

// An f64 in the fewest digits, at most 17, that parse_f64 reads back as the same bits, signs of zero
// included: 0.1 is "0.1", 1e22 is "1e22", 5e-324 is "5e-324". It writes digits with an optional point and an optional
// exponent (no plus), always valid JSON. Room for f64_capacity characters; no terminator. The value must be
// finite (checked): infinity and nan have no text.
[[smith::c_name("smith_format_write_f64")]] export usize write_f64(char out[:], f64 value) {
    check(
        countof(out) >=
        f64_capacity); // a run-time check, not a contract: the arithmetic below costs the prover more than it is worth
    char text[f64_capacity];
    usize count = f64_write(text, value);
    for (usize i = 0; i < count && i < f64_capacity && i < countof(out); i++) {
        out[i] = text[i];
    }
    return count;
}

constexpr u32 f32_digits_max = 9;
static_assert(f32_capacity >= 1 + f64_positional_max + 2 + 5, "sign, a positional integer, a point and e-45");

bool f32_reads_back(u64 q, i64 s, u32 bits) {
    char text[number_capacity * 2];
    usize length = write_u64(text, q);
    text[length++] = 'e';
    length += append_i64(text + length, s);
    f32 back = 0;
    if (length > sizeof text) return false;
    return read_f32(text[0:length], &back) && __builtin_bit_cast(u32, back) == bits;
}

// Writes the text of a f32 at out, which has room for f32_capacity.
usize f32_write(char *out, f32 value) {
    u32 bits = __builtin_bit_cast(u32, value);
    u32 field = (bits >> 23) & 0xff;
    check(field != 0xff); // infinity and nan have no text
    usize used = 0;
    if ((bits >> 31) != 0) out[used++] = '-';
    u32 fraction = bits & 0x7fffff;
    if (field == 0 && fraction == 0) {
        out[used++] = '0';
        return used;
    }
    u64 m = field == 0 ? fraction : fraction | ((u64)1 << 23);
    i64 e = field == 0 ? -149 : (i64)field - 150;
    u32 positive = bits & 0x7fffffffU;
    i64 first = f64_first_exponent(m, e);
    u32 low = 1;
    u32 high = f32_digits_max;
    while (low < high) {
        u32 middle = (low + high) / 2;
        i64 s = 0;
        u64 q = f64_round_to(m, e, first, middle, &s);
        if (f32_reads_back(q, s, positive))
            high = middle;
        else
            low = middle + 1;
    }
    i64 s = 0;
    u64 q = f64_round_to(m, e, first, low, &s);
    return used + f64_format(out + used, q, low, s + (i64)low - 1);
}

// An f32 in the fewest digits, at most 9, that parse_f32 reads back as the same bits: 0.1f is "0.1", where its f64
// value is 0.10000000149011612. Written as write_f64 writes (positional or scientific, no plus), so a f32's text and
// its widened f64's differ only in the digits. Room for f32_capacity characters; no terminator. The value must be
// finite (checked).
[[smith::c_name("smith_format_write_f32")]] export usize write_f32(char out[:], f32 value) {
    check(
        countof(out) >=
        f32_capacity); // a run-time check, not a contract: the arithmetic below costs the prover more than it is worth
    char text[f32_capacity];
    usize count = f32_write(text, value);
    for (usize i = 0; i < count && i < f32_capacity && i < countof(out); i++) {
        out[i] = text[i];
    }
    return count;
}

// NOLINTBEGIN(readability-identifier-naming)
// An enum's constants are written short in a module (format::Empty, C's SmithFormatError_Empty).

// Why a parse refused its text.
[[smith::c_name("SmithFormatError")]] export typedef enum {
    Empty,   // there is no text, or no digit in it
    Invalid, // a stray character: a +, a space, a capital hex digit, the text of inf or nan
    Range,   // the number does not fit the type (for a float: it would round to infinity)
} Error;
// NOLINTEND(readability-identifier-naming)

export typedef result(u64, Error) U64Result;
export typedef result(i64, Error) I64Result;
export typedef result(f32, Error) F32Result;
export typedef result(f64, Error) F64Result;

// Why a whole number was refused: no digit, a stray character, or a value that does not fit.
Error classify(const char word[:], usize start) {
    if (start >= countof(word)) return Empty;
    for (usize i = start; i < countof(word); i++) {
        if (word[i] < '0' || word[i] > '9') return Invalid;
    }
    return Range;
}

// Why a decimal was refused: no digit, a stray character, or a value that rounds to infinity.
Error classify_float(const char word[:]) {
    Decimal decimal;
    decimal_init(&decimal);
    bool negative = false;
    if (decimal_scan(word, &decimal, &negative)) return Range;
    for (usize i = 0; i < countof(word); i++) {
        if (word[i] >= '0' && word[i] <= '9') return Invalid;
    }
    return Empty;
}

// The whole numbers: decimal digits, with an optional leading - for the signed one. Leading zeros are fine. A +, a
// space or any other character is `Invalid`, no text is `Empty`, and a value that does not fit is `Range`.
[[smith::c_name("smith_format_parse_u64")]] export [[nodiscard]] U64Result parse_u64(const char word[:]) {
    u64 value = 0;
    if (read_u64(word, &value)) return {.ok = value};
    return {.error = classify(word, 0)};
}

[[smith::c_name("smith_format_parse_i64")]] export [[nodiscard]] I64Result parse_i64(const char word[:]) {
    i64 value = 0;
    if (read_i64(word, &value)) return {.ok = value};
    return {.error = classify(word, countof(word) > 0 && word[0] == '-' ? 1 : 0)};
}

// A decimal number: an optional sign, digits with an optional fraction (-90, 0.25, .5, 5.), and an optional exponent
// (1e-5, 2.5E+3), the f32 or f64 nearest to it, ties to even, as strtof and strtod give in the C locale, for any
// number of digits; "-0" is negative zero. A number that would round to infinity is `Range`; one too small rounds to
// zero or a subnormal. No inf or nan.
[[smith::c_name("smith_format_parse_f32")]] export [[nodiscard]] F32Result parse_f32(const char word[:]) {
    f32 value = 0;
    if (read_f32(word, &value)) return {.ok = value};
    return {.error = classify_float(word)};
}

[[smith::c_name("smith_format_parse_f64")]] export [[nodiscard]] F64Result parse_f64(const char word[:]) {
    f64 value = 0;
    if (read_f64(word, &value)) return {.ok = value};
    return {.error = classify_float(word)};
}

// The text of a terminated string, without its terminator: for C, which has no string literal that is a slice. It
// points into the string; nothing is copied.
[[smith::c_name("smith_format_string")]] export [[nodiscard]] typeof(const char[:]) string(const char *string) {
    usize length = 0;
    while (string[length] != '\0') {
        length += 1;
    }
    return string[0:length];
}

// Whether word is exactly the terminated string: for C.
[[smith::c_name("smith_format_is")]] export [[nodiscard]] bool is(const char word[:], const char *string) {
    for (usize i = 0; i < countof(word); i++) {
        if (string[i] != word[i]) return false; // a shorter string ends in its terminator, which no word has
    }
    return string[countof(word)] == '\0';
}

// The parts of parse a generic cannot write: whether the whole number in word fits [low, high], its value, and why not.
bool signed_fits(const char word[:], i64 low, i64 high) {
    i64 value = 0;
    return read_i64(word, &value) && value >= low && value <= high;
}

i64 signed_value(const char word[:]) {
    i64 value = 0;
    return read_i64(word, &value) ? value : 0;
}

Error signed_error(const char word[:]) {
    i64 value = 0;
    return read_i64(word, &value) ? Range : classify(word, countof(word) > 0 && word[0] == '-' ? 1 : 0);
}

bool unsigned_fits(const char word[:], u64 high) {
    u64 value = 0;
    return read_u64(word, &value) && value <= high;
}

u64 unsigned_value(const char word[:]) {
    u64 value = 0;
    return read_u64(word, &value) ? value : 0;
}

Error unsigned_error(const char word[:]) {
    u64 value = 0;
    return read_u64(word, &value) ? Range : classify(word, 0);
}

// The number in word as the type T, in one call: `format::parse(word, i64)` is a `result(i64, format::Error)`. T is any
// integer or f32 or f64; a whole number that does not fit T is `Range`.
export [[nodiscard]] result(T, Error) parse(const char word[:], constexpr type T) {
    if constexpr (T == f32) {
        return parse_f32(word);
    } else if constexpr (T == f64) {
        return parse_f64(word);
    } else if constexpr (is_integer(T) && is_signed(T)) {
        constexpr i64 low = 0 - (i64)((u64)1 << (sizeof(T) * 8 - 1));
        constexpr i64 high = ~low;
        if (signed_fits(word, low, high)) return {.ok = (T)signed_value(word)};
        return {.error = signed_error(word)};
    } else {
        constexpr u64 high = ~(u64)0 >> (64 - sizeof(T) * 8);
        if (unsigned_fits(word, high)) return {.ok = (T)unsigned_value(word)};
        return {.error = unsigned_error(word)};
    }
}

// How a write went. length is the characters of the whole text, whether or not they fit, without the terminator;
// fits is length < capacity, that is, every character and the terminator were written.
[[smith::c_name("SmithFormatWritten")]] export typedef struct {
    usize length;
    bool fits;
} Written;

// A number in lowercase hexadecimal, at least width digits (at most 16), zero-padded; made by hex().
[[smith::c_name("SmithFormatHex")]] export typedef struct {
    u64 value;
    u32 width;
} Hex;

// A f64 with places digits after the point (at most 20), made by fixed().
[[smith::c_name("SmithFormatFixed")]] export typedef struct {
    f64 value;
    u32 places;
} Fixed;

// value in hexadecimal, width digits at least: hex(255, 4) is 00ff, hex(255, 0) is ff, and hex(0, 0) is 0.
[[smith::c_name("smith_format_hex")]] export [[nodiscard]] Hex hex(u64 value, u32 width) {
    return (Hex){value, width};
}

// value to places digits after the point, correctly rounded from its exact binary value (ties to even), as printf's
// %.Nf: fixed(2.5, 0) is 2 and fixed(0.125, 2) is 0.12. A negative number that rounds to zero keeps its sign (-0.00),
// as printf does. A number of 2^63 or more has no fixed rule here and is written as with no wrapper.
[[smith::c_name("smith_format_fixed")]] export [[nodiscard]] Fixed fixed(f64 value, u32 places) {
    return (Fixed){value, places};
}

// The text of length characters at begin, for what a printf wrote as %.*s.
[[smith::c_name("smith_format_bytes")]] export [[nodiscard]] typeof(const char[:]) bytes(const char *begin,
                                                                                         usize length) {
    return begin[0:length];
}

[[smith::c_name("SmithFormatWriter")]] export typedef struct {
    char *out;
    usize capacity;
    usize length;
} Writer;

// A writer over buffer, which has room for capacity characters (0 and a null buffer measure only). The Writer is what
// `to` is made of, and C can use it: each put below is a piece of the text, and finish ends it.
[[smith::c_name("smith_format_make")]] export [[nodiscard]] Writer make(char *buffer, usize capacity) {
    return (Writer){buffer, capacity, 0};
}

// One character.
[[smith::c_name("smith_format_put_char")]] export void put_char(Writer *writer, char c) {
    if (writer->capacity > 0 && writer->length < writer->capacity - 1) writer->out[writer->length] = c;
    writer->length += 1;
}

// The characters of text.
[[smith::c_name("smith_format_put_bytes")]] export void put_bytes(Writer *writer, const char text[:]) {
    for (usize i = 0; i < countof(text); i++) {
        put_char(writer, text[i]);
    }
}

// length characters at begin (a generic's body cannot cut a pointer, so it calls this).
void put_chars(Writer *writer, const char *begin, usize characters) {
    put_bytes(writer, begin[0:characters]);
}

// A terminated string; a null pointer is (null).
[[smith::c_name("smith_format_put_string")]] export void put_string(Writer *writer, const char *string) {
    if (string == nullptr) string = "(null)";
    for (usize i = 0; string[i] != '\0'; i++) {
        put_char(writer, string[i]);
    }
}

// A terminated string, or, with a count, a char array of a struct: up to its end or its terminator.
[[maybe_unused]] void put_c_string(Writer *writer, const char *string, usize count) {
    if (count == 0) {
        put_string(writer, string);
        return;
    }
    usize length = 0;
    while (length < count && string[length] != '\0')
        length += 1;
    put_chars(writer, string, length);
}

// Decimal digits.
[[smith::c_name("smith_format_put_u64")]] export void put_u64(Writer *writer, u64 value) {
    char digits[number_capacity];
    usize length = write_u64(digits, value);
    put_bytes(writer, digits[0:length]);
}

// Decimal digits with a leading - for a negative number.
[[smith::c_name("smith_format_put_i64")]] export void put_i64(Writer *writer, i64 value) {
    char digits[number_capacity + 1];
    usize length = write_i64(digits, value);
    put_bytes(writer, digits[0:length]);
}

bool is_finite(f64 value) {
    u64 bits = __builtin_bit_cast(u64, value);
    return ((bits >> 52) & 0x7ff) != 0x7ff;
}

// inf, -inf and nan, which write_f64 refuses; nan has no sign here.
void put_unfinite(Writer *writer, f64 value) {
    if (value != value) {
        put_string(writer, "nan");
    } else if (value < 0) {
        put_string(writer, "-inf");
    } else {
        put_string(writer, "inf");
    }
}

// As write_f64, and inf, -inf or nan for a value with no number.
[[smith::c_name("smith_format_put_f64")]] export void put_f64(Writer *writer, f64 value) {
    if (!is_finite(value)) {
        put_unfinite(writer, value);
        return;
    }
    char digits[f64_capacity];
    usize length = write_f64(digits, value);
    put_bytes(writer, digits[0:length]);
}

// As write_f32: the shortest digits that read back as the same f32, and inf, -inf or nan.
[[smith::c_name("smith_format_put_f32")]] export void put_f32(Writer *writer, f32 value) {
    if (!is_finite((f64)value)) {
        put_unfinite(writer, (f64)value);
        return;
    }
    char digits[f32_capacity];
    usize length = write_f32(digits, value);
    put_bytes(writer, digits[0:length]);
}

// A Hex, as hex() made it.
[[smith::c_name("smith_format_put_hex")]] export void put_hex(Writer *writer, Hex hex) {
    char digits[16];
    usize count = 0;
    u64 rest = hex.value;
    do {
        u64 digit = rest & 0xf;
        digits[count++] = (char)(digit < 10 ? '0' + digit : 'a' + (digit - 10));
        rest >>= 4;
    } while (rest != 0);
    u32 width = hex.width < 16 ? hex.width : 16;
    for (usize pad = count; pad < width; pad++) {
        put_char(writer, '0');
    }
    for (usize i = count; i-- > 0;) {
        put_char(writer, digits[i]);
    }
}

constexpr u32 places_max = 20;
constexpr u64 whole_limit = (u64)1 << 63;
constexpr u32 fraction_bits_max = 120;

typedef __uint128_t Wide;

// |value| as a whole part and a fraction n / 2^bits, exactly. A value below 2^-68 has a fraction past 120 bits, but no
// digit of at most 20 places can then be other than zero (half of 10^-20 is above 2^-68), so it is written as zero.
typedef struct {
    u64 whole;
    Wide fraction;
    u32 bits;
} Split;

Split split(f64 value) {
    u64 abs = __builtin_bit_cast(u64, value) & ~((u64)1 << 63);
    u64 field = abs >> 52;
    u64 m = field == 0 ? abs : (abs & 0xfffffffffffffULL) | ((u64)1 << 52);
    i64 e = field == 0 ? -1074 : (i64)field - 1075;
    Split result = {0, 0, 0};
    if (e >= 0) {
        result.whole = m << (u32)e;
    } else {
        u32 shift = (u32)(0 - e);
        if (shift < 64) {
            result.whole = m >> shift;
            result.fraction = m & (((u64)1 << shift) - 1);
            result.bits = shift;
        } else if (shift <= fraction_bits_max) {
            result.fraction = m;
            result.bits = shift;
        }
    }
    return result;
}

// places digits of the fraction, rounded to nearest with ties to even; a carry out of the first digit goes to *whole.
void fraction_digits(Split split, u32 places, char *digits, u64 *whole) {
    Wide n = split.fraction;
    for (u32 i = 0; i < places; i++) {
        n *= 10;
        digits[i] = (char)('0' + (u32)(n >> split.bits));
        n &= ((Wide)1 << split.bits) - 1;
    }
    if (split.bits == 0) return;
    Wide half = (Wide)1 << (split.bits - 1);
    u64 last = places > 0 ? (u64)(digits[places - 1] - '0') : *whole;
    if (n < half || (n == half && (last & 1) == 0)) return;
    u32 i = places;
    while (i > 0 && digits[i - 1] == '9') {
        digits[i - 1] = '0';
        i -= 1;
    }
    if (i > 0)
        digits[i - 1] += 1;
    else
        *whole += 1;
}

// A Fixed, as fixed() made it.
[[smith::c_name("smith_format_put_fixed")]] export void put_fixed(Writer *writer, Fixed fixed) {
    if (!is_finite(fixed.value)) {
        put_unfinite(writer, fixed.value);
        return;
    }
    u64 bits = __builtin_bit_cast(u64, fixed.value);
    if ((bits & ~((u64)1 << 63)) >= __builtin_bit_cast(u64, (f64)whole_limit)) {
        put_f64(writer, fixed.value);
        return;
    }
    u32 places = fixed.places < places_max ? fixed.places : places_max;
    Split parts = split(fixed.value);
    char digits[places_max];
    u64 whole = parts.whole;
    fraction_digits(parts, places, digits, &whole);
    if ((bits >> 63) != 0) put_char(writer, '-');
    put_u64(writer, whole);
    if (places > 0) put_char(writer, '.');
    put_bytes(writer, digits[0:places]);
}

// Ends the text: terminates the buffer where it ends and says how it went (see Written).
[[smith::c_name("smith_format_finish")]] export [[nodiscard]] Written finish(Writer *writer) {
    if (writer->capacity > 0) {
        usize end = writer->length < writer->capacity - 1 ? writer->length : writer->capacity - 1;
        writer->out[end] = '\0';
    }
    return (Written){writer->length, writer->length < writer->capacity};
}

// A f64 as printf's %.Ng: digits significant digits (1 to 40; 0 is 1), correctly rounded from the exact binary value
// (ties to even), in the fixed style when the decimal exponent is from -4 up to digits - 1 and in the e style
// otherwise, with the trailing zeros and a bare point removed: general(0.1, 6) is 0.1, general(1e22, 6) is 1e+22.
[[smith::c_name("SmithFormatGeneral")]] export typedef struct {
    f64 value;
    u32 digits;
} General;

// A f64 as printf's %.Ne: one digit, a point and places more (at most 40), then e, a sign and at least two exponent
// digits, correctly rounded as General is: scientific(12345.678, 2) is 1.23e+04.
[[smith::c_name("SmithFormatScientific")]] export typedef struct {
    f64 value;
    u32 places;
} Scientific;

// A piece in a column of width characters, made by pad() or left(). The piece is already text: a string or a text is
// referenced (it must outlive the call that writes it), any other piece is held in the 64 characters of the value.
export constexpr usize padded_capacity = 64;
[[smith::c_name("SmithFormatPadded")]] export typedef struct {
    const char *begin;
    usize length;
    u32 width;
    bool left;
    char characters[padded_capacity];
} Padded;

[[smith::c_name("smith_format_general")]] export [[nodiscard]] General general(f64 value, u32 digits) {
    return (General){value, digits};
}

[[smith::c_name("smith_format_scientific")]] export [[nodiscard]] Scientific scientific(f64 value, u32 places) {
    return (Scientific){value, places};
}

constexpr u32 significant_max = 40;
constexpr usize exact_capacity = 800;
constexpr usize limbs_capacity = 100;
constexpr u32 limb_base = 1000000000;

// A natural number in base 10^9, least significant limb first.
typedef struct {
    u32 limb[limbs_capacity];
    usize count;
} Base10;

void big_multiply(Base10 *big, u32 factor) {
    u64 carry = 0;
    for (usize i = 0; i < big->count; i++) {
        u64 product = (u64)big->limb[i] * factor + carry;
        big->limb[i] = (u32)(product % limb_base);
        carry = product / limb_base;
    }
    while (carry != 0) {
        big->limb[big->count++] = (u32)(carry % limb_base);
        carry /= limb_base;
    }
}

// The exact decimal digits of the integer m * 2^e (e >= 0) or m * 5^-e (e < 0), most significant first; returns how
// many.
usize exact_digits(u64 m, i32 e, char *digits) {
    Base10 big = {};
    big.limb[0] = (u32)(m % limb_base);
    big.limb[1] = (u32)((m / limb_base) % limb_base);
    big.limb[2] = (u32)(m / limb_base / limb_base);
    big.count = 3;
    i32 left = e < 0 ? -e : e;
    u32 step = e < 0 ? 13 : 30;
    while (left > 0) {
        u32 now = (u32)left < step ? (u32)left : step;
        u32 factor = 1;
        for (u32 j = 0; j < now; j++) {
            factor *= e < 0 ? 5 : 2;
        }
        big_multiply(&big, factor);
        left -= (i32)now;
    }
    while (big.count > 1 && big.limb[big.count - 1] == 0) {
        big.count -= 1;
    }
    usize length = 0;
    for (usize i = big.count; i-- > 0;) {
        char chunk[9];
        u32 rest = big.limb[i];
        for (usize j = 9; j-- > 0;) {
            chunk[j] = (char)('0' + rest % 10);
            rest /= 10;
        }
        usize from = 0;
        while (length == 0 && from < 8 && chunk[from] == '0') {
            from += 1;
        }
        for (usize j = from; j < 9; j++) {
            digits[length++] = chunk[j];
        }
    }
    return length;
}

// The first want significant digits of value (finite, not zero), correctly rounded, ties to even, in out; *exponent is
// the decimal exponent of the first digit (1234.5 with want 3 is 123 and 3).
void significant_digits(f64 value, u32 want, char *out, i32 *exponent) {
    u64 abs = __builtin_bit_cast(u64, value) & ~((u64)1 << 63);
    u64 field = abs >> 52;
    u64 m = field == 0 ? abs : (abs & 0xfffffffffffffULL) | ((u64)1 << 52);
    i32 e = field == 0 ? -1074 : (i32)field - 1075;
    char exact[exact_capacity];
    usize count = exact_digits(m, e, exact);
    *exponent = (i32)count - 1 - (e < 0 ? -e : 0);
    for (u32 i = 0; i < want; i++) {
        out[i] = i < count ? exact[i] : '0';
    }
    if (count <= want) return;
    bool tail_zero = true;
    for (usize i = want + 1; i < count; i++) {
        tail_zero = tail_zero && exact[i] == '0';
    }
    char next = exact[want];
    bool odd = (out[want - 1] - '0') % 2 != 0;
    if (next < '5' || (next == '5' && tail_zero && !odd)) return;
    u32 i = want;
    while (i > 0 && out[i - 1] == '9') {
        out[i - 1] = '0';
        i -= 1;
    }
    if (i > 0) {
        out[i - 1] += 1;
    } else {
        out[0] = '1';
        *exponent += 1;
    }
}

void put_exponent(Writer *writer, i32 exponent) {
    put_char(writer, 'e');
    put_char(writer, exponent < 0 ? '-' : '+');
    u32 magnitude = (u32)(exponent < 0 ? -exponent : exponent);
    if (magnitude < 10) put_char(writer, '0');
    put_u64(writer, magnitude);
}

// The digits as d.ddd and the exponent; a bare point is left out.
void put_scientific_digits(Writer *writer, const char *digits, u32 count, i32 exponent) {
    put_char(writer, digits[0]);
    if (count > 1) {
        put_char(writer, '.');
        put_bytes(writer, digits[1:count]);
    }
    put_exponent(writer, exponent);
}

// Sign and digits of a finite value: the first want significant digits (all zeros for zero) and their exponent.
bool prepare_digits(Writer *writer, f64 value, u32 want, char *digits, i32 *exponent) {
    if (!is_finite(value)) {
        put_unfinite(writer, value);
        return false;
    }
    if ((__builtin_bit_cast(u64, value) >> 63) != 0) put_char(writer, '-');
    *exponent = 0;
    if (value == 0) {
        for (u32 i = 0; i < want; i++) {
            digits[i] = '0';
        }
    } else {
        significant_digits(value, want, digits, exponent);
    }
    return true;
}

// A Scientific, as scientific() made it.
[[smith::c_name("smith_format_put_scientific")]] export void put_scientific(Writer *writer, Scientific scientific) {
    u32 want = (scientific.places < significant_max ? scientific.places : significant_max) + 1;
    char digits[significant_max + 1];
    i32 exponent = 0;
    if (!prepare_digits(writer, scientific.value, want, digits, &exponent)) return;
    put_scientific_digits(writer, digits, want, exponent);
}

// A General, as general() made it.
[[smith::c_name("smith_format_put_general")]] export void put_general(Writer *writer, General general) {
    u32 want = general.digits == 0 ? 1 : (general.digits < significant_max ? general.digits : significant_max);
    char digits[significant_max];
    i32 exponent = 0;
    if (!prepare_digits(writer, general.value, want, digits, &exponent)) return;
    u32 count = want;
    while (count > 1 && digits[count - 1] == '0') {
        count -= 1;
    }
    if (exponent < -4 || exponent >= (i32)want) {
        put_scientific_digits(writer, digits, count, exponent);
    } else if (exponent >= 0) {
        for (u32 i = 0; i <= (u32)exponent; i++) {
            put_char(writer, i < count ? digits[i] : '0');
        }
        if (count > (u32)exponent + 1) {
            put_char(writer, '.');
            put_bytes(writer, digits[(u32)exponent + 1:count]);
        }
    } else {
        put_string(writer, "0.");
        for (i32 i = 1; i < -exponent; i++) {
            put_char(writer, '0');
        }
        put_bytes(writer, digits[0:count]);
    }
}

// A Padded, as pad() or left() made it: spaces to the width, on the left of the piece or, for left(), after it.
[[smith::c_name("smith_format_put_padded")]] export void put_padded(Writer *writer, Padded padded) {
    const char *characters = padded.begin != nullptr ? padded.begin : padded.characters;
    usize spaces = padded.width > padded.length ? padded.width - padded.length : 0;
    if (!padded.left) {
        for (usize i = 0; i < spaces; i++) {
            put_char(writer, ' ');
        }
    }
    put_bytes(writer, characters[0:padded.length]);
    if (padded.left) {
        for (usize i = 0; i < spaces; i++) {
            put_char(writer, ' ');
        }
    }
}

// One piece by the rule of its type. `to` is this for each of its arguments; a type with no rule is an error here, and
// at the position of the piece in `to`. A struct is `{m = 1, b = 2}`: each field by the rule of its type (a nested
// struct the same way, a fixed array as `[1, 2, 3]`: a field that is an array arrives as the pointer it decays to, with
// its count), the fields being the compile-time list `fields(typeof(piece))`.
void put(Writer *writer, auto piece, usize count) {
    (void)count;
    if constexpr (is_bool(typeof(piece))) {
        put_string(writer, piece ? "true" : "false");
    } else if constexpr (typeof(piece) == char) {
        put_char(writer, piece);
    } else if constexpr (is_integer(typeof(piece)) && is_signed(typeof(piece))) {
        put_i64(writer, (i64)piece);
    } else if constexpr (is_integer(typeof(piece))) {
        put_u64(writer, (u64)piece);
    } else if constexpr (typeof(piece) == f32) {
        put_f32(writer, piece);
    } else if constexpr (is_float(typeof(piece))) {
        put_f64(writer, (f64)piece);
    } else if constexpr (typeof(piece) == char * || typeof(piece) == const char *) {
        put_c_string(writer, piece, count);
    } else if constexpr (typeof(piece) == struct smith_array_char_n ||
                         typeof(piece) == struct smith_array_const_char_n) {
        put_bytes(writer, piece);
    } else if constexpr (typeof(piece) == Hex) {
        put_hex(writer, piece);
    } else if constexpr (typeof(piece) == Fixed) {
        put_fixed(writer, piece);
    } else if constexpr (typeof(piece) == General) {
        put_general(writer, piece);
    } else if constexpr (typeof(piece) == Scientific) {
        put_scientific(writer, piece);
    } else if constexpr (typeof(piece) == Padded) {
        put_padded(writer, piece);
    } else if constexpr (is_pointer(typeof(piece))) {
        put_char(writer, '[');
        for (usize j = 0; j < count; j++) {
            if (j > 0) {
                put_string(writer, ", ");
            }
            put(writer, *piece, 0);
            piece += 1;
        }
        put_char(writer, ']');
    } else if constexpr (is_record(typeof(piece))) {
        put_char(writer, '{');
        for constexpr (usize i = 0; i < countof(fields(typeof(piece))); i++) {
            if constexpr (i > 0) {
                put_string(writer, ", ");
            }
            put_string(writer, fields(typeof(piece))[i].name);
            put_string(writer, " = ");
            if constexpr (is_array(typeof(piece.[fields(typeof(piece))[i]]))) {
                put(writer, piece.[fields(typeof(piece))[i]],
                    sizeof(piece.[fields(typeof(piece))[i]]) / sizeof(piece.[fields(typeof(piece))[i]][0]));
            } else if constexpr (is_pointer(typeof(piece.[fields(typeof(piece))[i]])) &&
                                 typeof(piece.[fields(typeof(piece))[i]]) !=
                                     char *&&typeof(piece.[fields(typeof(piece))[i]]) != const char *) {
                static_assert(false, "format: a pointer field has no rule; see the instance in the note");
            } else {
                put(writer, piece.[fields(typeof(piece))[i]], 0);
            }
        }
        put_char(writer, '}');
    } else {
        static_assert(false, "format: no rule for the type of a piece; see the instance in the note");
    }
}

// The piece as text, to be put in a column of width characters (on the right, or on the left when left is true).
Padded make_padded(auto piece, u32 width, bool left) {
    Padded padded = {};
    padded.width = width;
    padded.left = left;
    if constexpr (typeof(piece) == char * || typeof(piece) == const char *) {
        padded.begin = piece != nullptr ? piece : "(null)";
        padded.length = __builtin_strlen(padded.begin);
    } else if constexpr (typeof(piece) == struct smith_array_char_n ||
                         typeof(piece) == struct smith_array_const_char_n) {
        padded.begin = piece.data;
        padded.length = countof(piece);
    } else {
        Writer writer = make(padded.characters, padded_capacity);
        if constexpr (is_pointer(typeof(piece)) && typeof(piece) != char *&&typeof(piece) != const char *) {
            static_assert(false, "format: no rule for the type of a piece; see the instance in the note");
        } else {
            put(&writer, piece, 0);
        }
        padded.length = writer.length < padded_capacity - 1 ? writer.length : padded_capacity - 1;
    }
    return padded;
}

// The piece in a column of width characters, spaces on its left: pad(n, 5) is printf's %5d, pad(name, 12) is %12s, and
// pad(format::fixed(x, 1), 6) is %6.1f. A piece wider than the column is written whole. The piece is any of the types
// `to` has a rule for except a Padded; a string or a text is read when the Padded is written, not when it is made.
export [[nodiscard]] Padded pad(auto piece, u32 width) {
    return make_padded(piece, width, false);
}

// The piece in a column of width characters, spaces after it: left(name, 16) is printf's %-16s.
export [[nodiscard]] Padded left(auto piece, u32 width) {
    return make_padded(piece, width, true);
}

// The error for a piece `to` has no rule for: Slot is char[n] for the n-th piece, counting from 1, so the message can
// name it (a static_assert message is a literal, and a number cannot be a compile-time parameter).
void no_rule(constexpr type Slot) {
    if constexpr (sizeof(Slot) == 1) {
        static_assert(false, "format: no rule for the type of piece 1; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 2) {
        static_assert(false, "format: no rule for the type of piece 2; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 3) {
        static_assert(false, "format: no rule for the type of piece 3; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 4) {
        static_assert(false, "format: no rule for the type of piece 4; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 5) {
        static_assert(false, "format: no rule for the type of piece 5; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 6) {
        static_assert(false, "format: no rule for the type of piece 6; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 7) {
        static_assert(false, "format: no rule for the type of piece 7; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 8) {
        static_assert(false, "format: no rule for the type of piece 8; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 9) {
        static_assert(false, "format: no rule for the type of piece 9; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 10) {
        static_assert(false, "format: no rule for the type of piece 10; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 11) {
        static_assert(false, "format: no rule for the type of piece 11; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 12) {
        static_assert(false, "format: no rule for the type of piece 12; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 13) {
        static_assert(false, "format: no rule for the type of piece 13; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 14) {
        static_assert(false, "format: no rule for the type of piece 14; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 15) {
        static_assert(false, "format: no rule for the type of piece 15; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 16) {
        static_assert(false, "format: no rule for the type of piece 16; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 17) {
        static_assert(false, "format: no rule for the type of piece 17; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 18) {
        static_assert(false, "format: no rule for the type of piece 18; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 19) {
        static_assert(false, "format: no rule for the type of piece 19; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 20) {
        static_assert(false, "format: no rule for the type of piece 20; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 21) {
        static_assert(false, "format: no rule for the type of piece 21; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 22) {
        static_assert(false, "format: no rule for the type of piece 22; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 23) {
        static_assert(false, "format: no rule for the type of piece 23; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 24) {
        static_assert(false, "format: no rule for the type of piece 24; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 25) {
        static_assert(false, "format: no rule for the type of piece 25; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 26) {
        static_assert(false, "format: no rule for the type of piece 26; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 27) {
        static_assert(false, "format: no rule for the type of piece 27; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 28) {
        static_assert(false, "format: no rule for the type of piece 28; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 29) {
        static_assert(false, "format: no rule for the type of piece 29; the note lists the types in order");
    } else if constexpr (sizeof(Slot) == 30) {
        static_assert(false, "format: no rule for the type of piece 30; the note lists the types in order");
    } else {
        static_assert(false, "format: no rule for the type of a piece past the 30th");
    }
}

// The arguments as text into buffer, which has room for capacity characters; a capacity of 0 writes nothing (buffer may
// be null) and only measures. See the rules at the top of this file. A piece with no rule is an error that says which
// one it is (piece 3 is the third piece after buffer and capacity, counting from 1).
export Written to(char *buffer, usize capacity, auto... args) {
    Writer writer = {buffer, capacity, 0};
    for constexpr (usize i = 0; i < countof(args); i++) {
        if constexpr (is_bool(typeof(args[i])) || is_integer(typeof(args[i])) || is_float(typeof(args[i]))) {
            put(&writer, args[i], 0);
        } else if constexpr (typeof(args[i]) == char * || typeof(args[i]) == const char * ||
                             typeof(args[i]) == struct smith_array_char_n ||
                             typeof(args[i]) == struct smith_array_const_char_n) {
            put(&writer, args[i], 0);
        } else if constexpr (typeof(args[i]) == Hex || typeof(args[i]) == Fixed || typeof(args[i]) == General) {
            put(&writer, args[i], 0);
        } else if constexpr (typeof(args[i]) == Scientific || typeof(args[i]) == Padded) {
            put(&writer, args[i], 0);
        } else if constexpr (is_record(typeof(args[i]))) {
            put(&writer, args[i], 0);
        } else {
            no_rule(char[i + 1]);
        }
    }
    return finish(&writer);
}

// How many characters the arguments make, without the terminator.
export usize length(auto... args) {
    return to(nullptr, 0, args...).length;
}

// What push returns: a `char[:]`. (The header pass cannot yet write a generic whose result is spelled
// `typeof(char[:])`, so the type has a name.)
export typedef typeof(char[:]) Chars;

// length characters at memory (a generic's body cannot cut a pointer).
Chars cut(char *memory, usize characters) {
    Chars chars = memory[0:characters];
    return chars;
}

// The arguments as text pushed on the arena, with a terminator after it that the slice's count does not count.
export Chars push(arena::Arena *arena, auto... args) {
    usize characters = length(args...);
    char *memory =
        arena::push_array_raw(arena, sizeof(char), characters + 1, alignof(char)); // a generic's local has no type yet
    Written written = to(memory, characters + 1, args...);
    return cut(memory, written.length);
}

constexpr i32 emsgsize = 40; // EMSGSIZE on macOS, which smith runs on

// The text print made, written to stdout or stderr; too long to have fitted is EMSGSIZE and prints nothing.
[[smith::c_name("smith_format_print_text")]] export io::Error print_text(io::Console *console, bool errors,
                                                                         const char *characters, Written written) {
    if (!written.fits) return io::error_make(emsgsize, "print", errors ? "stderr" : "stdout");
    return errors ? io::console_print_error(console, characters) : io::console_print(console, characters);
}

// The arguments printed on stdout: print(&io->console, "x = ", x, "\n") is io::console_printf(&io->console, "x = %d\n",
// x) with the pieces typed. The text is at most 4096 characters, as console_printf's; a longer one prints nothing and
// is an error (EMSGSIZE). The error is not [[nodiscard]]: a program that prints a report has nowhere else to say that
// stdout is closed.
export io::Error print(io::Console *console, auto... args) {
    char characters[4096];
    return print_text(console, false, characters, to(characters, sizeof characters, args...));
}

// As print, on stderr.
export io::Error print_error(io::Console *console, auto... args) {
    char characters[4096];
    return print_text(console, true, characters, to(characters, sizeof characters, args...));
}
