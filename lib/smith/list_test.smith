// Tests of smith::list through its exported API: the zero value, push and pop, the growth under a fixed arena (it
// stops at the budget), a growing arena (the last block extends in place) and the heap, items and finish.
module smith::list_test;

import smith::arena;
import smith::list;
import smith::mem;
import smith::test;

typedef list::List(i32) Ints;

export void test_list_zero_value_is_empty() {
    Ints xs = {};
    test::check_equal(list::count(&xs), 0);
    i32 nothing[:] = list::items(&xs);
    test::check_equal(countof(nothing), 0);
    option(i32) none = list::pop(&xs);
    test::check_condition(none == .none);
}

static void fill_and_check(Ints *xs, i32 n) {
    for (i32 i = 0; i < n; i++) {
        list::push(xs, i * 3);
    }
    test::check_equal(list::count(xs), (usize)n);
    i32 all[:] = list::items(xs);
    test::check_equal(countof(all), (usize)n);
    for (usize i = 0; i < (usize)n; i++) {
        test::check_equal(all[i], (i32)i * 3);
    }
}

export void test_list_under_a_fixed_arena() {
    arena::Arena a = test::memory(1 << 14);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *before = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(before);
    Ints xs = {};
    fill_and_check(&xs, 100);
    test::check_condition(a.used > 0);
    option(i32) last = list::pop(&xs);
    test::check_condition(last == .some);
    test::check_equal(last.some, 297);
    test::check_equal(list::count(&xs), 99);
}

export void test_list_over_a_fixed_arena_budget_is_a_checked_failure() {
    arena::Arena a = test::memory(64);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *before = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(before);
    test::expect_abort();
    Ints xs = {};
    fill_and_check(&xs, 1000);
}

export void test_list_under_a_growing_arena() {
    arena::Arena a = arena::growing(1 << 12, nullptr);
    defer arena::release(&a);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *before = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(before);
    Ints xs = {};
    fill_and_check(&xs, 5000); // more than the first chunk
    test::check_condition(a.grown > 0);
}

export void test_list_grows_in_place_at_the_top_of_an_arena() {
    arena::Arena a = test::memory(1 << 16);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *before = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(before);
    Ints xs = {};
    list::push(&xs, 1);
    i32 *first = xs.data;
    for (i32 i = 0; i < 100; i++) {
        list::push(&xs, i);
    }
    test::check_equal(xs.data, first); // the list's block is the arena's last: it extended
}

export void test_list_under_the_heap() {
    Ints xs = {};
    fill_and_check(&xs, 1000);
    list::free(&xs);
    test::check_equal(list::count(&xs), 0);
    test::check_condition(xs.data == nullptr);
}

export void test_list_finish_hands_the_items_over() {
    arena::Arena a = test::memory(1 << 12);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *before = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(before);
    Ints xs = {};
    list::push(&xs, 7);
    list::push(&xs, 8);
    i32 all[:] = list::finish(&xs);
    test::check_equal(countof(all), 2);
    test::check_equal(all[1], 8);
    test::check_equal(list::count(&xs), 0);
}

typedef list::List(f64) Reals;

export void test_list_of_another_type() {
    Reals ys = {};
    list::push(&ys, 1.5);
    list::push(&ys, 2.5);
    f64 all[:] = list::items(&ys);
    test::check_equal(all[0] + all[1], 4.0);
    list::free(&ys);
}
