// smith-build: header
// smith::checked, <smith/checked.h>: arithmetic that reports an overflow as `.none` instead of failing the task
// (issue #351). `checked::add(a, b)` is `.some` of the sum, or `.none` when it does not fit the type of a.
//
//   option(i32) sum = checked::add(a, b);
module smith::checked;

// a + b, or `.none` when it overflows.
export option(T) add(constexpr type T, T a, T b) {
    T result = 0;
    if (__builtin_add_overflow(a, b, &result)) return .none;
    return result;
}

// a - b, or `.none` when it overflows.
export option(T) sub(constexpr type T, T a, T b) {
    T result = 0;
    if (__builtin_sub_overflow(a, b, &result)) return .none;
    return result;
}

// a * b, or `.none` when it overflows.
export option(T) mul(constexpr type T, T a, T b) {
    T result = 0;
    if (__builtin_mul_overflow(a, b, &result)) return .none;
    return result;
}
