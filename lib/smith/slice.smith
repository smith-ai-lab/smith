// smith::slice, <smith/slice.h>: what a program does with a slice that is not an element access: compare, search, copy,
// fill, reverse and cut one. Every export is a generic function, so it has no C spelling (the header holds only its
// record). Nothing allocates: a result is a cut of an input, an index, or is written into a slice the caller passes.
//
//   str s = "key=value";
//   option(usize) at = slice::find(s, '=');
//   if (at == .some) key = s[0:at.some];
module smith::slice;

import smith::contract;

// Whether a and b have the same count and the same elements.
export bool equal(const auto a[:], typeof(a) b) {
    if (countof(a) != countof(b)) return false;
    for (usize i = 0; i < countof(a); i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// Negative when a sorts before b, zero when they are equal, positive after: the first differing element decides, and
// the shorter slice sorts first when it is a prefix of the other.
export i32 compare(const auto a[:], typeof(a) b) {
    usize shorter = countof(a) < countof(b) ? countof(a) : countof(b);
    for (usize i = 0; i < shorter; i++) {
        if (a[i] < b[i]) return -1;
        if (a[i] > b[i]) return 1;
    }
    if (countof(a) < countof(b)) return -1;
    return countof(a) > countof(b) ? 1 : 0;
}

// Whether xs begins with prefix.
export bool starts_with(const auto xs[:], typeof(xs) prefix) {
    if (countof(prefix) > countof(xs)) return false;
    return equal(xs[0:countof(prefix)], prefix);
}

// Whether xs ends with suffix.
export bool ends_with(const auto xs[:], typeof(xs) suffix) {
    if (countof(suffix) > countof(xs)) return false;
    return equal(xs[countof(xs) - countof(suffix):countof(xs)], suffix);
}

// The index of the first element equal to v, or `.none`.
export option(usize) find(const auto xs[:], typeof(xs[0]) v) {
    for (usize i = 0; i < countof(xs); i++) {
        if (xs[i] == v) return {.some = i};
    }
    return .none;
}

// The index of the last element equal to v, or `.none`.
export option(usize) find_last(const auto xs[:], typeof(xs[0]) v) {
    for (usize i = countof(xs); i > 0; i--) {
        if (xs[i - 1] == v) return {.some = i - 1};
    }
    return .none;
}

// How many elements equal v.
export usize count(const auto xs[:], typeof(xs[0]) v) {
    usize n = 0;
    for (usize i = 0; i < countof(xs); i++) {
        if (xs[i] == v) n += 1;
    }
    return n;
}

// Sets every element to v.
export void fill(auto xs[:], typeof(xs[0]) v) {
    for (usize i = 0; i < countof(xs); i++) {
        xs[i] = v;
    }
}

// Puts the elements in the opposite order, in place.
export void reverse(auto xs[:]) {
    for (usize i = 0; i < countof(xs) / 2; i++) {
        usize j = countof(xs) - 1 - i;
        typeof(xs[0]) held = xs[i];
        xs[i] = xs[j];
        xs[j] = held;
    }
}

// The index of the first element for which pred is true, or `.none`.
export option(usize) find_if(const auto xs[:], constexpr auto pred) {
    for (usize i = 0; i < countof(xs); i++) {
        if (pred(xs[i])) return {.some = i};
    }
    return .none;
}

// The index where needle first occurs in xs as a run of elements, or `.none`. An empty needle is at 0.
export option(usize) find_slice(const auto xs[:], typeof(xs) needle) {
    if (countof(needle) > countof(xs)) return .none;
    for (usize i = 0; i + countof(needle) <= countof(xs); i++) {
        if (equal(xs[i:i + countof(needle)], needle)) return {.some = i};
    }
    return .none;
}

// xs without the elements at both ends for which pred is true: a cut of xs, nothing is copied.
export typeof(xs) trim(const auto xs[:], constexpr auto pred) {
    usize start = 0;
    while (start < countof(xs) && pred(xs[start])) {
        start += 1;
    }
    usize end = countof(xs);
    while (end > start && pred(xs[end - 1])) {
        end -= 1;
    }
    return xs[start:end];
}

// Writes src over the start of dst; the rest of dst is left alone. The slices do not overlap (restrict) and dst has
// room for all of src.
export void copy(auto dst[restrict :], const typeof(dst[0]) src[restrict :]) {
    contract::requires(countof(src) <= countof(dst));
    for (usize i = 0; i < countof(src); i++) {
        dst[i] = src[i];
    }
}

// The first n elements of *xs, which the caller's slice then no longer holds: a cursor, nothing is copied.
export typeof((*xs)[0:0]) take(const auto (*xs)[:], usize n) {
    contract::requires(n <= countof(*xs));
    typeof((*xs)[0:0]) head = (*xs)[0:n];
    *xs = (*xs)[n:countof(*xs)];
    return head;
}

// The elements of *xs before the first v, and the caller's slice then starts after that v, as strsep does. With no v
// it returns all of *xs and leaves it empty.
export typeof((*xs)[0:0]) take_until(const auto (*xs)[:], typeof((*xs)[0]) v) {
    usize n = 0;
    while (n < countof(*xs) && (*xs)[n] != v) {
        n += 1;
    }
    typeof((*xs)[0:0]) head = (*xs)[0:n];
    *xs = (*xs)[n < countof(*xs) ? n + 1 : n:countof(*xs)];
    return head;
}

// The leading elements of *xs for which pred is true; the caller's slice then starts at the first one that is not.
export typeof((*xs)[0:0]) take_while(const auto (*xs)[:], constexpr auto pred) {
    usize n = 0;
    while (n < countof(*xs) && pred((*xs)[n])) {
        n += 1;
    }
    typeof((*xs)[0:0]) head = (*xs)[0:n];
    *xs = (*xs)[n:countof(*xs)];
    return head;
}
