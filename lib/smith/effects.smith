// smith::effects, <smith/effects.h>: what a function may do to the world, as a library states it of a function it is
// given. The sets are masks, one bit for each kind of handler, and `|` makes a set of them:
//
//   static_assert(effects::within(f, effects::alloc), "gradient: f may only allocate");
//   static_assert(effects::within(f, effects::alloc | effects::files), "f may allocate and read files");
//
// `within(f, set)` is true when the function `f` (a `constexpr auto f` parameter, so its name) has no effect beyond
// `set`. Its answer does not exist while the file is being read: smith infers the effects of every function after the
// whole file is read (and of a function in another file when the program is linked). So the call is always true as
// far as the compiler's reading goes, and smith's effect check judges it afterwards: a function with an effect beyond
// the set is an error that shows the assertion's message, the effects and the chain of calls that brought them in
// (`loss -> log_it (log.c:12) -> printf (log.c:5)`), at the assertion, with the note of the call that asked for it. A
// function with no source and no attribute has every effect (`unknown`), so `within` rejects it. Failing is an effect
// (`fails`): `within(f, effects::none)` also rejects a function with a checked index.
//
// The function must be written in a `static_assert`, where smith reads it; anywhere else it is true and checks nothing.
module smith::effects;

// <smith/effects.h>: the empty set, a function with none is `[[smith::pure]]`.
export constexpr u32 none = 0;
// <smith/effects.h>: allocating and freeing memory.
export constexpr u32 alloc = 1;
// <smith/effects.h>: reading and writing files.
export constexpr u32 files = 2;
// <smith/effects.h>: the network.
export constexpr u32 net = 4;
// <smith/effects.h>: the console, standard input, output and error.
export constexpr u32 console = 8;
// <smith/effects.h>: the clock and sleeping.
export constexpr u32 clock = 16;
// <smith/effects.h>: processes and threads.
export constexpr u32 process = 32;
// <smith/effects.h>: the environment.
export constexpr u32 env = 64;
// <smith/effects.h>: OS randomness.
export constexpr u32 entropy = 128;
// <smith/effects.h>: writing a global or a function-local `static`.
export constexpr u32 globals = 256;
// <smith/effects.h>: unknown: code smith cannot see into, a function with no source and no attribute.
export constexpr u32 unknown = 512;
// <smith/effects.h>: a failure point, a checked index or slice, a contract or an assert, `abort` or a trap, or a call
// to a function that has one. A proved check is not one.
export constexpr u32 fails = 1024;
// <smith/effects.h>: making memory executable (`mmap` or `mprotect` with PROT_EXEC), code smith cannot read.
export constexpr u32 code = 2048;

// <smith/effects.h>: whether the function `f` has no effect beyond `set`. Written in a `static_assert` (see above).
export inline bool within(...) {
    return true;
}

// Every set, so that the compiler sees each constant used: a constant a module exports and does not use is a warning in
// the project that compiles the module.
[[maybe_unused]] u32 everything() {
    (void)within(none, none);
    return none | alloc | files | net | console | clock | process | env | entropy | globals | unknown | fails | code;
}
