// smith::arena, <smith/arena.h>: memory without malloc. Its C API is the generated header include/smith/arena.h
// (a build output, not in git). Every export has a short name here and a C name (the attribute
// before it): `arena::push_raw` is `smith_arena_push`, `arena::Arena` is `SmithArena`. The comments above an export are
// the header's doc comments, so they name the Smith names; the first one says how a C name follows from them.
module smith::arena;

import smith::contract;
import smith::math;
import target;
import <sanitizer/asan_interface.h>; // the poisoning calls; ASAN_POISON_MEMORY_REGION is one of them
import <smith/handlers.h>;           // SmithAllocator: arena::allocator
import <smith/trace.h>;              // smith_failure: the stop below is the report a failed contract writes
import <stdint.h>;
import <sys/mman.h>; // mmap and munmap: the operating system as the default backing of a growing arena

// <smith/arena.h>: a block of memory with a cursor, for programs that do not call malloc. Nothing is freed on its own;
// a reset frees everything, and a scope frees what was pushed since it began.
//
// Two kinds (owner, 2026-10-25). A fixed arena (arena::fixed) is over memory the caller gives and never
// grows: a push that does not fit is a checked failure naming the budget. A growing arena (arena::growing) takes
// another chunk from its backing allocator (the operating system by default) when the current one is full, so a push
// never fails; the chunks are kept across scopes and resets (a second pass over the same work reuses them), `grown` is
// the bytes beyond the first chunk, and the operating system refusing is a checked failure naming the size.
// arena::try_push_raw (null) and arena::try_push (an `option`) are the forms of a push for code that
// refuses.
//
// The project compiles lib/smith/arena.smith itself (build.c: smith_library(b, "arena")), so the library is built with
// the project's own flags, sanitizers included.
//
// Names. The module's names are short (arena::reset, arena::Arena); C calls them smith_arena_reset and SmithArena.
// The raw pushes are arena::push_raw and arena::push_array_raw, which C calls smith_arena_push and
// smith_arena_push_array; the generics arena::push and arena::push_slice have no C spelling.
//
// Typed pushes. A .smith file writes the type as an argument, so the size and the alignment cannot disagree and the
// result is typed:
//   Foo *foo = arena::push(&arena, Foo);
//   Foo foos[:] = arena::push_slice(&arena, Foo, count);        // a slice: the pointer and the count together
//   f32 grid[:][:] = arena::push_slice(&arena, f32, rows, cols); // a size for each [:], one block, row-major
//   f32 rows[:][2] = arena::push_slice(&arena, f32[2], count);   // rows of 2
// C and C++ cannot call a generic. C passes the type's size and alignment to the functions that return a void *,
// converted with no cast:
//   Foo *foo = smith_arena_push(arena, sizeof(Foo), alignof(Foo));
//   Foo *foos = smith_arena_push_array(arena, sizeof(Foo), count, alignof(Foo));
//
// The alignment an arena's memory must start at, and the largest a push may ask for. Pushes then lay out the same way
// whatever the addresses, so a run is deterministic.
[[smith::c_name("smith_arena_align_max")]] export constexpr usize align_max = 64;

// A chunk of a growing arena: a header (its body is private, below) followed by the memory a push lands in.
[[smith::c_name("SmithArenaChunk")]] export typedef struct SmithArenaChunk Chunk;

// A block of memory and a cursor. A growing arena's block is its current chunk.
[[smith::c_name("SmithArena")]] export typedef struct {
    u8 *memory;
    usize capacity;
    usize used;
    usize scopes;  // scopes begun and not yet ended
    usize touched; // AddressSanitizer builds: the poison high-water mark, see lib/smith/arena.smith; otherwise unused
    usize grown;   // bytes of the chunks beyond the first, kept until release
    Chunk *chunk;  // the current chunk of a growing arena (null: a fixed arena)
    Chunk *spare;  // the chunk after the current one, kept for the next time the arena fills
    c::SmithAllocator *backing; // where a growing arena gets its chunks (null: the operating system)
    bool growing;
} Arena;

// A scope: ending it returns the cursor to where it began. Scopes end in the reverse order they began, and an arena is
// reset only with none open; both are required.
[[smith::c_name("SmithArenaScope")]] export typedef struct {
    Arena *arena;
    usize used;
    usize depth;  // the arena's scopes before this one began
    Chunk *chunk; // the arena's current chunk when it began: ending it leaves the chunks entered since
} Scope;

// Sanitizer builds start each push on an ASan granule and leave a poisoned gap after it, and poison the memory past the
// cursor, so ASan catches a read or write outside the pushes. The poison is lazy. An arena may be a 64 GiB reservation,
// and poisoning all of it would commit its shadow (an eighth of it, 8 GiB) before the program pushed anything. So the
// arena keeps a high-water mark `touched`, with the invariant that [used, touched) is poisoned and the memory past
// `touched` has not been poisoned by this arena. Every push keeps touched >= used + window by poisoning [touched,
// used + window) (capped at the capacity); reset and the end of a scope poison [used, touched) again. Shadow memory
// then grows with what the program has used, not with the capacity. The window is 64 KiB: an overflow past the top
// of the arena lands in poison unless it runs more than 64 KiB past the last push, which is longer than the overruns
// that come from off-by-one, off-by-a-row and short-array mistakes, while the shadow it costs is 8 KiB.
//
// Whether this build has the sanitizer is a fact of the target (target::address_sanitizer, which the compiler's
// preprocessor answers). Everything below is ordinary code guarded by it, so a build without the sanitizer
// type-checks the poisoning too and the compiler drops it.
constexpr bool sanitized = target::address_sanitizer;

constexpr usize poison_granule = 8;       // ASan tracks memory in 8-byte granules
constexpr usize poison_gap = 16;          // poisoned bytes left after each push
constexpr usize poison_window = 64 << 10; // poisoned past the cursor after each push

// Poisons [used, touched) again, after a reset or the end of a scope.
void poison_unused(const Arena *arena) {
    contract::trusted(); // the sanitizer's runtime is the edge; a build without it never calls this
    contract::requires(arena->used <= arena->touched && arena->touched <= arena->capacity);
    c::__asan_poison_memory_region(arena->memory + arena->used, arena->touched - arena->used);
}

// Keeps touched >= used + window, poisoning what is new.
void poison_ahead(Arena *arena) {
    usize room = arena->capacity - arena->used;
    usize target = arena->used + (room < poison_window ? room : poison_window);
    if (target <= arena->touched) return;
    c::__asan_poison_memory_region(arena->memory + arena->touched, target - arena->touched);
    arena->touched = target;
}

static_assert((align_max & (align_max - 1)) == 0); // a power of two

[[maybe_unused]] bool align_valid(usize align) {
    return align > 0 && align <= align_max && (align & (align - 1)) == 0;
}

// The alignment a push really uses: a sanitizer build starts every push on a granule.
usize effective_align(usize align) {
    if (sanitized && align < poison_granule) return poison_granule;
    return align;
}

// Whether size bytes at align fit; the bytes of padding go to *padding. Written so that no sum can overflow.
bool measure(const Arena *arena, usize size, usize align, usize *padding) {
    contract::requires(arena->used <= arena->capacity);
    contract::requires(align_valid(align));
    align = effective_align(align);
    *padding = (align - (arena->used & (align - 1))) & (align - 1);
    usize room = arena->capacity - arena->used;
    return *padding <= room && size <= room - *padding;
}

// A push that cannot be served stops here in every build, as every check does. Only a fixed arena gets here:
// its budget is spent.
[[noreturn]] void stop(const Arena *arena, usize size, usize align) {
    c::smith_failure_format(c::SmithFailure_Capacity, "push of %zu bytes (align %zu) with %zu of %zu bytes used", size,
                            align, arena->used, arena->capacity);
}

// A growing arena whose backing refused a chunk: the operating system out of memory, or the allocator it was given
// returning null. The report names the size and the backing.
[[noreturn]] void refuse(const Arena *arena, usize size) {
    c::smith_failure_format(c::SmithFailure_Capacity,
                            "growing arena: its %s refused a chunk for a push of %zu bytes (%zu bytes grown so far)",
                            arena->backing != nullptr ? "backing allocator" : "operating system", size, arena->grown);
}

// An arena over memory, which must be aligned to align_max and hold capacity bytes. It never grows: a push that does
// not fit is a checked failure naming the budget (arena::try_push_raw is the form that returns null).
[[smith::c_name("smith_arena_fixed")]] export [[nodiscard]] Arena fixed(void *memory, usize capacity) {
    contract::requires(((usize)memory & (align_max - 1)) == 0);
    contract::requires(capacity > 0);
    return (Arena){.memory = (u8 *)memory, .capacity = capacity}; // nothing is poisoned until the first push
}

// A chunk's header, a multiple of align_max so the memory after it is aligned as an arena's must be. A chunk is one
// piece from the backing (a mapping or an allocation); the chunks of an arena are a list: `previous` leads back to the
// first, `next` to the ones kept for reuse. A chunk holds what the arena's block was before it, so that ending a scope
// (or a reset) puts it back.
struct Chunk {
    Chunk *previous;
    Chunk *next;
    usize size;    // bytes of the piece, this header included
    usize touched; // the poison mark of its memory while it is not the arena's block
    u8 *memory_before;
    usize capacity_before;
    usize used_before;
    usize touched_before;
};

constexpr usize chunk_header = sizeof(struct Chunk);
constexpr usize chunk_round = 16 << 10; // a chunk is a whole number of pages
static_assert(chunk_header == align_max);

// NOLINTBEGIN(smith-preprocessor, bugprone-signed-bitwise)
constexpr i32 protect_both = c::PROT_READ | c::PROT_WRITE;
constexpr i32 map_anonymous = c::MAP_PRIVATE | c::MAP_ANON;
// NOLINTEND(smith-preprocessor, bugprone-signed-bitwise)

// A new piece of size bytes (a multiple of chunk_round), or null.
Chunk *chunk_new(const Arena *arena, usize size) {
    contract::trusted(); // the operating system, or the allocator the arena was given, is the edge
    void *memory = nullptr;
    if (arena->backing != nullptr) {
        memory = arena->backing->alloc(arena->backing, size, align_max);
    } else {
        memory =
            c::mmap(nullptr, size, protect_both, map_anonymous, -1, 0); // NOLINT(smith-effects): the default backing
        if (memory == (void *)-1) memory = nullptr;                     // NOLINT(performance-no-int-to-ptr): MAP_FAILED
    }
    if (memory == nullptr) return nullptr;
    Chunk *chunk = (Chunk *)memory;
    *chunk = (Chunk){.size = size};
    return chunk;
}

void chunk_free(const Arena *arena, Chunk *chunk) {
    contract::trusted();
    if (sanitized) // the arena poisoned part of the memory, and a later mapping at the same address must not inherit it
        c::__asan_unpoison_memory_region((u8 *)chunk + chunk_header, chunk->touched);
    if (arena->backing != nullptr) {
        arena->backing->free(arena->backing, chunk);
    } else {
        (void)c::munmap(chunk, chunk->size); // NOLINT(smith-effects): the default backing
    }
}

// The bytes of a piece that hold a push.
usize chunk_capacity(const Chunk *chunk) {
    return chunk->size - chunk_header;
}

// Makes chunk the arena's block, with its predecessor's state saved in it.
void chunk_enter(Arena *arena, Chunk *chunk) {
    contract::trusted();
    if (arena->chunk != nullptr) arena->chunk->next = chunk;
    chunk->previous = arena->chunk;
    chunk->memory_before = arena->memory;
    chunk->capacity_before = arena->capacity;
    chunk->used_before = arena->used;
    chunk->touched_before = arena->touched;
    arena->chunk = chunk;
    arena->spare = chunk->next;
    arena->memory = (u8 *)chunk + chunk_header;
    arena->capacity = chunk_capacity(chunk);
    arena->used = 0;
    arena->touched = chunk->touched;
}

// Makes the chunk before the current one the arena's block again, as it was; the current one is kept as the spare.
void chunk_leave(Arena *arena) {
    contract::trusted();
    Chunk *chunk = arena->chunk;
    arena->used = 0;
    if (sanitized) poison_unused(arena); // everything the chunk held is dead
    chunk->touched = arena->touched;
    arena->chunk = chunk->previous;
    arena->spare = chunk;
    arena->memory = chunk->memory_before;
    arena->capacity = chunk->capacity_before;
    arena->used = chunk->used_before;
    arena->touched = chunk->touched_before;
}

// The size of a new piece for a push of size bytes at align when the current block is full: twice the current block, or
// what the push needs, rounded to chunk_round; zero when that overflows.
usize chunk_size_for(const Arena *arena, usize size, usize align) {
    usize need = 0;
    if (__builtin_add_overflow(size, align + poison_gap, &need) || __builtin_add_overflow(need, chunk_header, &need))
        return 0;
    usize wanted = arena->capacity > math::max(usize) / 4 ? 0 : arena->capacity * 2 + chunk_header;
    if (wanted > need) need = wanted;
    if (need > math::max(usize) - chunk_round) return 0;
    return (need + chunk_round - 1) & ~(chunk_round - 1);
}

// Makes room in a growing arena for a push of size bytes at align: enters the spare chunk when it holds the push, else
// takes a new one from the backing (kept chunks too small for it go back). False when the backing refuses.
bool grow(Arena *arena, usize size, usize align) {
    contract::trusted();
    usize minimum = 0;
    if (__builtin_add_overflow(size, effective_align(align) + poison_gap, &minimum)) return false;
    Chunk *spare = arena->spare;
    if (spare != nullptr && chunk_capacity(spare) >= minimum) {
        chunk_enter(arena, spare);
        return true;
    }
    usize needed = chunk_size_for(arena, size, align);
    if (needed == 0) return false;
    arena->spare = nullptr;
    arena->chunk->next = nullptr;
    while (spare != nullptr) {
        Chunk *next = spare->next;
        arena->grown -= spare->size;
        chunk_free(arena, spare);
        spare = next;
    }
    Chunk *chunk = chunk_new(arena, needed);
    if (chunk == nullptr) return false;
    arena->grown += chunk->size;
    chunk_enter(arena, chunk);
    return true;
}

// A growing arena over chunks from backing (null: the operating system), the first holding at least `first` bytes. A
// push never fails: when a chunk is full the arena takes another, and keeps them for the next pass. The first chunk is
// taken here; the backing refusing it is a checked failure. release gives the chunks back.
[[smith::c_name("smith_arena_growing")]] export [[nodiscard]] Arena growing(usize first, c::SmithAllocator *backing) {
    contract::trusted(); // the first chunk comes from the backing
    contract::requires(first > 0);
    Arena arena = {.growing = true, .backing = backing};
    bool overflow = first > math::max(usize) - chunk_header - chunk_round;
    usize size = overflow ? 0 : (first + chunk_header + chunk_round - 1) & ~(chunk_round - 1);
    Chunk *chunk = size == 0 ? nullptr : chunk_new(&arena, size);
    if (chunk == nullptr) refuse(&arena, first);
    arena.chunk = chunk;
    arena.memory = (u8 *)chunk + chunk_header;
    arena.capacity = chunk_capacity(chunk);
    return arena;
}

// Gives back to the backing every chunk of a growing arena, the first included; the arena is empty after, and a push to
// it is a failure. Requires no scope open. A fixed arena has nothing to give back.
[[smith::c_name("smith_arena_release")]] export void release(Arena *arena) {
    contract::trusted();
    contract::requires(arena->scopes == 0);
    if (!arena->growing || arena->chunk == nullptr) return;
    while (arena->chunk->previous != nullptr)
        chunk_leave(arena);
    Chunk *chunk = arena->chunk;
    chunk->touched = arena->touched;
    c::SmithAllocator *backing = arena->backing;
    Arena gone = *arena;
    *arena = (Arena){.backing = backing};
    while (chunk != nullptr) {
        Chunk *next = chunk->next;
        chunk_free(&gone, chunk);
        chunk = next;
    }
}

// Memory for size bytes at align (a power of two, at most align_max), NOT zeroed, or null when a fixed arena's memory,
// or the backing of a growing one, cannot hold it. try_push_raw zeroes it, push_uninit_raw does not.
void *take(Arena *arena, usize size, usize align) {
    contract::trusted(); // it writes the memory it hands out, whose extent a proof does not know
    contract::requires(arena->used <= arena->capacity);
    contract::requires(align_valid(align));
    contract::ensures(arena->used <= arena->capacity);
    usize padding = 0;
    if (!measure(arena, size, align, &padding)) {
        if (!arena->growing || !grow(arena, size, align) || !measure(arena, size, align, &padding)) return nullptr;
    }

    u8 *result = arena->memory + arena->used + padding;
    arena->used += padding + size;
    if (sanitized) {
        usize gap = arena->capacity - arena->used;
        arena->used += gap < poison_gap ? gap : poison_gap;
        poison_ahead(arena);                            // poisons the padding, the new memory and the gap...
        c::__asan_unpoison_memory_region(result, size); // ...and the push alone is made addressable
    }
    return result;
}

// Zeroed memory for size bytes at align (a power of two, at most align_max), or null when a fixed arena's memory, or
// the backing of a growing one, cannot hold it. For code that refuses; push_raw stops instead.
[[smith::c_name("smith_arena_try_push")]] export [[nodiscard]] void *try_push_raw(Arena *arena, usize size,
                                                                                  usize align) {
    contract::trusted(); // it writes the memory it hands out, whose extent a proof does not know
    contract::requires(arena->used <= arena->capacity);
    contract::requires(align_valid(align));
    contract::ensures(arena->used <= arena->capacity);
    void *result = take(arena, size, align);
    if (result != nullptr) {
        __builtin_memset(result, 0, size); // memset is a macro in a fortified SDK; the builtin is a function
    }
    return result;
}

// Memory for size bytes at align that is NOT zeroed, never null (a refusal is a checked failure as push_raw's). The
// opt-out of zero-is-initialization (issue #415) for a block the caller writes whole before it reads any of it: a
// large buffer whose zeroing was measured to cost more than 2% of a frame or a step. Say the measurement in a comment
// at the call; without one, push is the call.
[[smith::c_name("smith_arena_push_uninit")]] export [[nodiscard]] void *push_uninit_raw(Arena *arena, usize size,
                                                                                        usize align) {
    contract::trusted();
    contract::requires(arena->used <= arena->capacity);
    contract::requires(align_valid(align));
    contract::ensures(arena->used <= arena->capacity);
    void *result = take(arena, size, align);
    if (result != nullptr) return result;
    if (arena->growing) refuse(arena, size);
    stop(arena, size, align);
}

// Zeroed memory for size bytes at align (a power of two, at most align_max). A growing arena takes another chunk when
// the current one is full, so this never returns null; the backing refusing is a checked failure naming the size. A
// fixed arena running out of memory stops the program with a message naming the request and the budget, in every
// build: it is a single comparison, and without it a build with NDEBUG would write past the memory.
[[smith::c_name("smith_arena_push")]] export [[nodiscard]] void *push_raw(Arena *arena, usize size, usize align) {
    contract::trusted(); // a failure ends in the report, which is the edge
    contract::requires(arena->used <= arena->capacity);
    contract::requires(align_valid(align));
    contract::ensures(arena->used <= arena->capacity);
    void *result = try_push_raw(arena, size, align);
    if (result != nullptr) return result;
    if (arena->growing) refuse(arena, size);
    stop(arena, size, align);
}

// An overflowing count * size is the same stop.
[[noreturn]] void stop_overflow(const Arena *arena, usize size, usize count) {
    c::smith_failure_format(c::SmithFailure_Capacity, "%zu items of %zu bytes overflow size_t (capacity %zu)", count,
                            size, arena->capacity);
}

// count items of size bytes.
[[smith::c_name("smith_arena_push_array")]] export [[nodiscard]] void *push_array_raw(Arena *arena, usize size,
                                                                                      usize count, usize align) {
    contract::trusted(); // a count that overflows ends in the failure report, which is the edge
    contract::requires(arena->used <= arena->capacity);
    contract::requires(align_valid(align));
    contract::ensures(arena->used <= arena->capacity);
    if (size > 0 && count > math::max(usize) / size) stop_overflow(arena, size, count);
    return push_raw(arena, size * count, align);
}

// count items of size bytes, or null when they do not fit (or their size overflows).
[[smith::c_name("smith_arena_try_push_array")]] export [[nodiscard]] void *
try_push_array_raw(Arena *arena, usize size, usize count, usize align) {
    contract::trusted();
    contract::requires(arena->used <= arena->capacity);
    contract::requires(align_valid(align));
    contract::ensures(arena->used <= arena->capacity);
    if (size > 0 && count > math::max(usize) / size) return nullptr;
    return try_push_raw(arena, size * count, align);
}

// Whether a push of size at align would fit in the arena's current block; a growing arena takes a chunk when it does
// not (try_push_raw says whether the backing agrees).
[[smith::c_name("smith_arena_fits")]] export [[nodiscard]] bool fits(const Arena *arena, usize size, usize align) {
    contract::requires(arena->used <= arena->capacity);
    contract::requires(align_valid(align));
    usize padding = 0;
    return measure(arena, size, align, &padding);
}

// A zeroed T, the size and the alignment of the type. For .smith; C passes sizeof and alignof to smith_arena_push.
[[smith::c_name("smith_arena_push_type")]] export [[nodiscard]] T *push(Arena *arena, constexpr type T) {
    return (T *)push_raw(arena, sizeof(T), alignof(T));
}

// A T that is NOT zeroed, the size and the alignment of the type: `push` with the opt-out of push_uninit_raw.
[[smith::c_name("smith_arena_push_uninit_type")]] export [[nodiscard]] T *push_uninit(Arena *arena, constexpr type T) {
    return (T *)push_uninit_raw(arena, sizeof(T), alignof(T));
}

// A zeroed T, or `.none` when the arena cannot hold it (a fixed arena out of space, the backing of a growing one
// refusing): the form for code that refuses, where push is a checked failure. A refusal pushes nothing.
[[smith::c_name("smith_arena_try_push_type")]] export [[nodiscard]] option(T *) try_push(Arena *a, constexpr type T) {
    void *memory = try_push_raw(a, sizeof(T), alignof(T));
    if (memory != nullptr) {
        return {.some = (T *)memory};
    } else {
        return .none;
    }
}

// `T[:]` written `count` times in front of T (the element), the type of a slice of that many run-time dimensions:
// `slice_of(f32, 2)` is `f32[:][:]` and `slice_of(f32[2], 1)` is `f32[:][2]`. An ordinary function over types, run by
// the compiler wherever a type is computed; `t[:]` is the slice of the type value t.
export type slice_of(type element, usize count) {
    type t = element;
    for (usize i = 0; i < count; i++)
        t = t[:];
    return t;
}

// A zeroed array of T with a size for each `[:]`, as a slice: `push_slice(&a, f32, n)` is `f32[:]`, `push_slice(&a,
// f32, n, m)` is `f32[:][:]` (one contiguous block, row-major) and `push_slice(&a, f32[2], n)` is `f32[:][2]`: the type
// is `slice_of(T, countof(dims))`. A size whose product overflows, like a count that overflows size_t, is the same stop
// as in push_array_raw (the product is then the largest size_t, which no count of any type fits). For .smith; C passes
// sizeof, the count and alignof to smith_arena_push_array.
[[smith::c_name("smith_arena_push_slice_type")]] export [[nodiscard]] slice_of(T, countof(dims))
    push_slice(Arena *arena, constexpr type T, auto... dims) {
    static_assert(countof(dims) > 0, "push_slice needs a size for each `[:]` of the result: push_slice(&a, T, n)");
    // The body is written as tokens before T is known, so it names the slice's struct (the one the result type
    // makes) as `smith_array_T_n`; an instance spells the result's.
    struct smith_array_T_n result = {};
    usize total = 1;
    for constexpr (usize i = 0; i < countof(dims); i++) {
        usize size = (usize)dims[i];
        if (__builtin_mul_overflow(total, size, &total))
            total = ~(usize)0; // the largest usize: push_array_raw stops on it
        result.count[i] = size;
    }
    result.data = push_array_raw(arena, sizeof(T), total, alignof(T));
    return result;
}

// A second arena of capacity bytes out of the memory the parent has not used: the next capacity bytes after its cursor,
// aligned to align_max, and the parent's cursor moves past them. Nothing in them is touched or poisoned, so when the
// parent is a reservation of address space (the 64 GiB mmap of smith_io_make) the carved arena commits pages only as it
// is used, and a program can carve hundreds of MiB at start for arenas with different lifetimes (one reset every frame,
// one for the run). Running out of the parent's capacity is the same stop as a push. Requires that the parent has no
// scope open, since the end of the scope would hand the carved memory back.
[[smith::c_name("smith_arena_carve")]] export [[nodiscard]] Arena carve(Arena *parent, usize capacity) {
    contract::trusted(); // a push that does not fit ends in smith_failure_format, a variable argument list a proof
                         // cannot read
    contract::requires(capacity > 0);
    contract::requires(parent->scopes == 0); // ending a scope would give the carved memory back
    usize start = (parent->used + align_max - 1) & ~(align_max - 1);
    if (start > parent->capacity || capacity > parent->capacity - start) stop(parent, capacity, align_max);
    u8 *memory = parent->memory + start;
    parent->used = start + capacity;
    if (sanitized) {
        // The parent poisoned a window past its old cursor, which the carved memory now covers: it is the new arena's,
        // and it poisons for itself. The parent's poison resumes past the carve.
        if (parent->touched > start)
            c::__asan_unpoison_memory_region(memory,
                                             (parent->touched < parent->used ? parent->touched : parent->used) - start);
        if (parent->touched < parent->used) parent->touched = parent->used;
    }
    return fixed(memory, capacity);
}

// Back to the first chunk of a growing arena.
void leave_to_first(Arena *arena) {
    contract::trusted(); // the chunks are a list a proof does not know
    while (arena->chunk->previous != nullptr)
        chunk_leave(arena);
}

// Frees everything. Requires that no scope is open. A growing arena keeps the chunks it grew, so the next pass over the
// same work takes none.
[[smith::c_name("smith_arena_reset")]] export void reset(Arena *arena) {
    contract::requires(arena->used <= arena->capacity);
    contract::requires(arena->scopes == 0); // a scope still open would restore a cursor past the reset
    if (arena->chunk != nullptr) leave_to_first(arena);
    arena->used = 0;
    if (sanitized) poison_unused(arena);
}

// Begins a scope.
[[smith::c_name("smith_arena_scope_begin")]] export [[nodiscard]] Scope scope_begin(Arena *arena) {
    contract::requires(arena->used <= arena->capacity);
    contract::requires(arena->scopes < math::max(usize));
    Scope scope = {.arena = arena, .used = arena->used, .depth = arena->scopes, .chunk = arena->chunk};
    arena->scopes += 1;
    return scope;
}

// Ends a scope: frees what was pushed since it began. The chunks a growing arena took inside it stay, for reuse.
[[smith::c_name("smith_arena_scope_end")]] export void scope_end(Scope scope) {
    contract::trusted(); // the arena is a pointer inside a struct passed by value, which a proof does not know to be
                         // valid
    contract::requires(scope.arena->scopes > 0);                // more ends than begins
    contract::requires(scope.depth == scope.arena->scopes - 1); // ends come last in, first out
    contract::requires(scope.chunk != scope.arena->chunk || scope.used <= scope.arena->used);
    scope.arena->scopes -= 1;
    while (scope.arena->chunk != scope.chunk) // chunks entered inside the scope are kept for the next time
        chunk_leave(scope.arena);
    scope.arena->used = scope.used;
    if (sanitized) poison_unused(scope.arena);
}

// The arena as an allocator (include/smith/handlers.h): what malloc, calloc, realloc and free reach while it is set
// with smith_handlers_set_allocator, `defer`-restored. Every block has a 32-byte header before it (its size, the cursor
// after it and the header's own size), and starts at the larger of 16 and the requested alignment (at most align_max).
// A request that does not fit is null, as malloc's, never the stop of a push. free of the arena's last block gives it
// back (with no scope open); any other free does nothing until a reset. realloc of a block that grows copies it.
// The allocator is a struct that starts with the SmithAllocator (handlers.h's own convention: the callbacks get it as
// `self`), followed by the arena it allocates from.
[[smith::c_name("SmithArenaAllocator")]] export typedef struct {
    c::SmithAllocator base;
    Arena *arena;
} ArenaAllocator;

typedef struct {
    usize size;
    usize after;  // the arena's cursor once the block was pushed: the block is the last when it still is
    usize header; // bytes from the start of the block's memory to the block, a multiple of its alignment
    usize reserved;
} Block;

void *allocator_alloc(c::SmithAllocator *self, usize size, usize align) {
    contract::trusted(); // the header is written into memory the arena just handed out
    Arena *arena = ((ArenaAllocator *)self)->arena;
    if (align < 16) align = 16;
    if (!align_valid(align)) return nullptr;
    usize header = align > sizeof(Block) ? align : sizeof(Block);
    if (size > math::max(usize) - header) return nullptr;
    u8 *start =
        (u8 *)try_push_raw(arena, header + size, align); // a growing arena takes a chunk; null when the backing refuses
    if (start == nullptr) return nullptr;
    Block *block = (Block *)(start + header - sizeof(Block));
    block->size = size;
    block->after = arena->used;
    block->header = header;
    return start + header;
}

bool in_block(const Arena *arena, const void *block) {
    return (const u8 *)block >= arena->memory && (const u8 *)block < arena->memory + arena->capacity;
}

bool allocator_owns(c::SmithAllocator *self, const void *block) {
    contract::trusted();
    const Arena *arena = ((ArenaAllocator *)self)->arena;
    if (in_block(arena, block)) return true;
    for (const Chunk *chunk = arena->chunk; chunk != nullptr; chunk = chunk->previous) { // an earlier chunk's block
        const u8 *memory = (const u8 *)chunk + chunk_header;
        if ((const u8 *)block >= memory && (const u8 *)block < memory + chunk_capacity(chunk)) return true;
    }
    return false;
}

usize allocator_size([[maybe_unused]] c::SmithAllocator *self, const void *block) {
    contract::trusted();
    return ((const Block *)((const u8 *)block - sizeof(Block)))->size;
}

void allocator_free(c::SmithAllocator *self, void *block) {
    contract::trusted();
    Arena *arena = ((ArenaAllocator *)self)->arena;
    if (block == nullptr || !allocator_owns(self, block)) return;
    Block *header = (Block *)((u8 *)block - sizeof(Block));
    if (!in_block(arena, block) || arena->used != header->after || arena->scopes != 0) return;
    arena->used = (usize)((u8 *)block - header->header - arena->memory);
    if (sanitized) poison_unused(arena);
}

void *allocator_realloc(c::SmithAllocator *self, void *block, usize size, usize align) {
    contract::trusted();
    if (block == nullptr) return allocator_alloc(self, size, align);
    usize old = allocator_size(self, block);
    if (size <= old) return block;
    void *result = allocator_alloc(self, size, align);
    if (result == nullptr) return nullptr;
    __builtin_memcpy(result, block, old);
    allocator_free(self, block);
    return result;
}

// An allocator over the arena, for smith_handlers_set_allocator(&allocator.base); the arena must outlive it and the
// allocator must not move while it is set.
[[smith::c_name("smith_arena_allocator")]] export [[nodiscard]] ArenaAllocator allocator(Arena *arena) {
    return (ArenaAllocator){.base = {.alloc = allocator_alloc,
                                     .realloc = allocator_realloc,
                                     .free = allocator_free,
                                     .owns = allocator_owns,
                                     .size = allocator_size},
                            .arena = arena};
}
