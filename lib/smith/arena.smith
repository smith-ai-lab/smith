// smith::arena, <smith/arena.h>: memory without malloc. Its C API is the generated header include/smith/arena.h
// (committed; `smith build headers` regenerates it). Every export has a short name here and a C name (the attribute
// before it): `arena::push_raw` is `smith_arena_push`, `arena::Arena` is `SmithArena`. The comments above an export are
// the header's doc comments, so they name the Smith names; the first one says how a C name follows from them.
module smith::arena;

import smith::contract;
import smith::math;
import target;
import <sanitizer/asan_interface.h>; // the poisoning calls; ASAN_POISON_MEMORY_REGION is one of them
import <smith/trace.h>;               // smith_failure: the stop below is the report a failed contract writes
import <stdint.h>;
import <stdio.h>;
import <string.h>;

// <smith/arena.h>: a fixed block of memory with a cursor, for programs that do not call malloc. Nothing is freed on its
// own; a reset frees everything, and a scope frees what was pushed since it began.
//
// The project compiles lib/smith/arena.smith itself (build.c: smith_library(b, "arena")), so the library is built with
// the project's own flags, sanitizers included.
//
// Names. The module's names are short (arena::reset, arena::Arena); C calls them smith_arena_reset and SmithArena.
// The raw pushes are arena::push_raw and arena::push_array_raw, which C calls smith_arena_push and
// smith_arena_push_array; the generics arena::push and arena::push_array have no C spelling.
//
// Typed pushes. A .smith file writes the type as an argument, so the size and the alignment cannot disagree and the
// result is typed:
//   Foo *foo = arena::push(&arena, Foo);
//   Foo *foos = arena::push_array(&arena, Foo, count);
// C and C++ cannot call a generic. C passes the type's size and alignment to the functions that return a void *,
// converted with no cast:
//   Foo *foo = smith_arena_push(arena, sizeof(Foo), alignof(Foo));
//   Foo *foos = smith_arena_push_array(arena, sizeof(Foo), count, alignof(Foo));
//
// The alignment an arena's memory must start at, and the largest a push may ask for. Pushes then lay out the same way
// whatever the addresses, so a run is deterministic.
[[smith::c_name("smith_arena_align_max")]] export constexpr usize align_max = 64;

// A block of memory and a cursor.
[[smith::c_name("SmithArena")]] export typedef struct {
    u8 *memory;
    usize capacity;
    usize used;
    usize scopes;  // scopes begun and not yet ended
    usize touched; // AddressSanitizer builds: the poison high-water mark, see lib/smith/arena.smith; otherwise unused
} Arena;

// A scope: ending it returns the cursor to where it began. Scopes end in the reverse order they began, and an arena is
// reset only with none open; both are asserted.
[[smith::c_name("SmithArenaScope")]] export typedef struct {
    Arena *arena;
    usize used;
    usize depth; // the arena's scopes before this one began
} Scope;

// Sanitizer builds start each push on an ASan granule and leave a poisoned gap after it, and poison the memory past the
// cursor, so ASan catches a read or write outside the pushes. The poison is lazy. An arena may be a 64 GiB reservation,
// and poisoning all of it would commit its shadow (an eighth of it, 8 GiB) before the program pushed anything. So the
// arena keeps a high-water mark `touched`, with the invariant that [used, touched) is poisoned and the memory past
// `touched` has not been poisoned by this arena. Every push keeps touched >= used + window by poisoning [touched,
// used + window) (capped at the capacity); reset and the end of a scope poison [used, touched) again. Shadow memory
// then grows with what the program has used, not with the capacity. The window is 64 KiB: an overflow past the top
// of the arena lands in poison unless it runs more than 64 KiB past the last push, which is longer than the overruns
// that come from off-by-one, off-by-a-row and short-array mistakes, while the shadow it costs is 8 KiB.
//
// Whether this build has the sanitizer is a fact of the target (target::address_sanitizer, which the compiler's
// preprocessor answers). Everything below is ordinary code guarded by it, so a build without the sanitizer
// type-checks the poisoning too and the compiler drops it.
constexpr bool sanitized = target::address_sanitizer;

constexpr usize poison_granule = 8;       // ASan tracks memory in 8-byte granules
constexpr usize poison_gap = 16;          // poisoned bytes left after each push
constexpr usize poison_window = 64 << 10; // poisoned past the cursor after each push

// Poisons [used, touched) again, after a reset or the end of a scope.
void poison_unused(const Arena *arena) {
    contract::assert(arena->used <= arena->touched && arena->touched <= arena->capacity);
    c::__asan_poison_memory_region(arena->memory + arena->used, arena->touched - arena->used);
}

// Keeps touched >= used + window, poisoning what is new.
void poison_ahead(Arena *arena) {
    usize room = arena->capacity - arena->used;
    usize target = arena->used + (room < poison_window ? room : poison_window);
    if (target <= arena->touched) return;
    c::__asan_poison_memory_region(arena->memory + arena->touched, target - arena->touched);
    arena->touched = target;
}

static_assert((align_max & (align_max - 1)) == 0); // a power of two

[[maybe_unused]] bool align_valid(usize align) {
    return align > 0 && align <= align_max && (align & (align - 1)) == 0;
}

// The alignment a push really uses: a sanitizer build starts every push on a granule.
usize effective_align(usize align) {
    if (sanitized && align < poison_granule) return poison_granule;
    return align;
}

// Whether size bytes at align fit; the bytes of padding go to *padding. Written so that no sum can overflow.
bool measure(const Arena *arena, usize size, usize align, usize *padding) {
    contract::assert(arena != nullptr);
    contract::assert(arena->used <= arena->capacity);
    contract::assert(align_valid(align));
    align = effective_align(align);
    *padding = (align - (arena->used & (align - 1))) & (align - 1);
    usize room = arena->capacity - arena->used;
    return *padding <= room && size <= room - *padding;
}

// A push that cannot be served stops here in every build, so a build with NDEBUG never writes past the memory.
[[noreturn]] void stop(const Arena *arena, usize size, usize align) {
    char details[160];
    c::snprintf(details, sizeof details, "push of %zu bytes (align %zu) with %zu of %zu bytes used", size, align,
                arena->used, arena->capacity);
    c::smith_failure_detail(c::SmithFailure_Capacity, details);
}

// An arena over memory, which must be aligned to align_max and hold capacity bytes.
[[smith::c_name("smith_arena_make")]] export [[nodiscard]] Arena make(void *memory, usize capacity) {
    contract::assert(memory != nullptr);
    contract::assert(((usize)memory & (align_max - 1)) == 0);
    contract::assert(capacity > 0);
    return (Arena){.memory = memory, .capacity = capacity}; // nothing is poisoned until the first push
}

// Zeroed memory for size bytes at align (a power of two, at most align_max). Running out of capacity stops the program
// with a message naming the request and the capacity, in every build: it is a single comparison, and without it a
// build with NDEBUG would write past the memory.
[[smith::c_name("smith_arena_push")]] export [[nodiscard]] void *push_raw(Arena *arena, usize size, usize align) {
    usize padding = 0;
    if (!measure(arena, size, align, &padding)) stop(arena, size, align);

    u8 *result = arena->memory + arena->used + padding;
    arena->used += padding + size;
    if (sanitized) {
        usize gap = arena->capacity - arena->used;
        arena->used += gap < poison_gap ? gap : poison_gap;
        poison_ahead(arena);                            // poisons the padding, the new memory and the gap...
        c::__asan_unpoison_memory_region(result, size); // ...and the push alone is made addressable
    }
    c::memset(result, 0, size);

    contract::assert(arena->used <= arena->capacity);
    return result;
}

// An overflowing count * size is the same stop.
[[noreturn]] void stop_overflow(const Arena *arena, usize size, usize count) {
    char details[160];
    c::snprintf(details, sizeof details, "%zu items of %zu bytes overflow size_t (capacity %zu)", count, size,
                arena->capacity);
    c::smith_failure_detail(c::SmithFailure_Capacity, details);
}

// count items of size bytes.
[[smith::c_name("smith_arena_push_array")]] export [[nodiscard]] void *push_array_raw(Arena *arena, usize size,
                                                                                      usize count, usize align) {
    contract::assert(arena != nullptr);
    if (size > 0 && count > math::max(usize) / size) stop_overflow(arena, size, count);
    return push_raw(arena, size * count, align);
}

// Whether a push of size at align would fit.
[[smith::c_name("smith_arena_fits")]] export [[nodiscard]] bool fits(const Arena *arena, usize size, usize align) {
    usize padding = 0;
    return measure(arena, size, align, &padding);
}

// A zeroed T, the size and the alignment of the type. For .smith; C passes sizeof and alignof to smith_arena_push.
[[smith::c_name("smith_arena_push_type")]] export [[nodiscard]] T *push(Arena *arena, constexpr type T) {
    return (T *)push_raw(arena, sizeof(T), alignof(T));
}

// count zeroed Ts; a count that overflows is the same stop as in push_array_raw. For .smith; C passes sizeof, the count
// and alignof to smith_arena_push_array.
[[smith::c_name("smith_arena_push_array_type")]] export [[nodiscard]] T *push_array(Arena *arena, constexpr type T,
                                                                                    usize count) {
    return (T *)push_array_raw(arena, sizeof(T), count, alignof(T));
}

// A second arena of capacity bytes out of the memory the parent has not used: the next capacity bytes after its cursor,
// aligned to align_max, and the parent's cursor moves past them. Nothing in them is touched or poisoned, so when the
// parent is a reservation of address space (the 64 GiB mmap of smith_io_make) the carved arena commits pages only as it
// is used, and a program can carve hundreds of MiB at start for arenas with different lifetimes (one reset every frame,
// one for the run). Running out of the parent's capacity is the same stop as a push. Asserts that the parent has no
// scope open, since the end of the scope would hand the carved memory back.
[[smith::c_name("smith_arena_carve")]] export [[nodiscard]] Arena carve(Arena *parent, usize capacity) {
    contract::assert(parent != nullptr && capacity > 0);
    contract::assert(parent->scopes == 0); // ending a scope would give the carved memory back
    usize start = (parent->used + align_max - 1) & ~(align_max - 1);
    if (start > parent->capacity || capacity > parent->capacity - start) stop(parent, capacity, align_max);
    u8 *memory = parent->memory + start;
    parent->used = start + capacity;
    if (sanitized) {
        // The parent poisoned a window past its old cursor, which the carved memory now covers: it is the new arena's,
        // and it poisons for itself. The parent's poison resumes past the carve.
        if (parent->touched > start)
            c::__asan_unpoison_memory_region(memory,
                                             (parent->touched < parent->used ? parent->touched : parent->used) - start);
        if (parent->touched < parent->used) parent->touched = parent->used;
    }
    return make(memory, capacity);
}

// Frees everything. Asserts no scope is open.
[[smith::c_name("smith_arena_reset")]] export void reset(Arena *arena) {
    contract::assert(arena != nullptr);
    contract::assert(arena->used <= arena->capacity);
    contract::assert(arena->scopes == 0); // a scope still open would restore a cursor past the reset
    arena->used = 0;
    if (sanitized) poison_unused(arena);
}

// Begins a scope.
[[smith::c_name("smith_arena_scope_begin")]] export [[nodiscard]] Scope scope_begin(Arena *arena) {
    contract::assert(arena != nullptr);
    contract::assert(arena->used <= arena->capacity);
    contract::assert(arena->scopes < math::max(usize));
    Scope scope = {.arena = arena, .used = arena->used, .depth = arena->scopes};
    arena->scopes += 1;
    return scope;
}

// Ends a scope: frees what was pushed since it began.
[[smith::c_name("smith_arena_scope_end")]] export void scope_end(Scope scope) {
    contract::assert(scope.arena != nullptr);
    contract::assert(scope.arena->scopes > 0);                // more ends than begins
    contract::assert(scope.depth == scope.arena->scopes - 1); // ends come last in, first out
    contract::assert(scope.used <= scope.arena->used);
    scope.arena->scopes -= 1;
    scope.arena->used = scope.used;
    if (sanitized) poison_unused(scope.arena);
}
