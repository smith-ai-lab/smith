// Tests of smith::categorical through its exported API, in smith's own test library: frequencies by chi-square, the
// pinned table and samples (the numbers are part of the API, as random's), the zero word, and that building a table
// allocates only through the current allocator.
module smith::categorical_test;

import smith::arena;
import smith::categorical;
import smith::effects;
import smith::mem;
import smith::random;
import smith::test;

constexpr usize draws = 10000; // per key
constexpr u64 seed = 20260101;

// Wilson-Hilferty at z = 5, about 3e-7 in the tail: a correct draw passes.
static f64 chi_limit(usize degrees) {
    f64 d = (f64)degrees;
    f64 t = 1.0 - 2.0 / (9.0 * d) + 5.0 * __builtin_sqrt(2.0 / (9.0 * d));
    return d * t * t * t;
}

static f64 chi_square(const usize *observed, const f64 *expected, usize cells) {
    f64 sum = 0;
    for (usize i = 0; i < cells; i++) {
        f64 difference = (f64)observed[i] - expected[i];
        sum += difference * difference / expected[i];
    }
    return sum;
}

// The next key of a stream: `stream` moves on (the reassignment pattern) and the key returned is for one use.
static random::Key take(random::Key *stream) {
    random::Key next[2];
    random::split(*stream, next);
    *stream = next[0];
    return next[1];
}

static u64 double_bits(f64 value) {
    return __builtin_bit_cast(u64, value);
}

// Frequencies by chi-square, a zero weight never drawn, one category, and a deterministic table.
export void test_categorical_frequencies_and_tables(random::Key key) {
    random::Key *stream = &key;
    arena::Arena a = test::memory(1 << 14);
    arena::ArenaAllocator allocator = arena::allocator(&a); // the tables live in the current allocator's region
    mem::Allocator *before = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(before);
    const f64 weights[_] = {1.0, 2.0, 3.0, 0.0, 4.0, 0.5, 9.5};
    constexpr usize count = 7;
    categorical::Table categorical = categorical::make(weights, count);
    test::check_equal(categorical.count, count);
    test::check_condition(a.used > 0); // from the allocator in force
    usize observed[count] = {};
    for (u64 i = 0; i < draws; i++) {
        usize index = categorical::sample(take(stream), categorical);
        test::check_less(index, count);
        observed[index]++;
    }
    test::check_equal(observed[3], 0);
    f64 expected[count - 1];
    usize cells[count - 1];
    usize used = 0;
    for (usize i = 0; i < count; i++) {
        if (weights[i] == 0.0) {
            continue;
        }
        expected[used] = (f64)(draws)*weights[i] / 20.0;
        cells[used++] = observed[i];
    }
    test::check_less(chi_square(cells, expected, used), chi_limit(used - 1));
    categorical::Table one = categorical::make((const f64[_]){3.5}, 1);
    for (u64 i = 0; i < 100; i++) {
        test::check_equal(categorical::sample(take(stream), one), 0);
    }
    categorical::Table same = categorical::make(weights, count); // construction is deterministic
    for (usize i = 0; i < count; i++) {
        test::check_equal(same.probability[i], categorical.probability[i]);
        test::check_equal(same.alias[i], categorical.alias[i]);
    }
    categorical::Table tiny = categorical::make((const f64[_]){0.0, 1.0}, 2);
    for (u64 i = 0; i < 1000; i++) {
        test::check_equal(categorical::sample(take(stream), tiny), 1);
    }
}

// The pinned values: the table of five weights (probability bits and alias) and the sample of four keys. The numbers
// are part of the API: a change to any of them is a breaking change.
static constexpr u64 pinned_values[_] = {
    0x3fe0000000000000, // categorical probability
    0x0000000000000004, // categorical alias
    0x3ff0000000000000, // categorical probability
    0x0000000000000001, // categorical alias
    0x3ff0000000000000, // categorical probability
    0x0000000000000002, // categorical alias
    0x0000000000000000, // categorical probability
    0x0000000000000004, // categorical alias
    0x3fe0000000000000, // categorical probability
    0x0000000000000002, // categorical alias
    0x0000000000000002, // categorical
    0x0000000000000000, // categorical
    0x0000000000000000, // categorical
    0x0000000000000002, // categorical
};

export void test_categorical_pinned_values() {
    arena::Arena a = test::memory(1 << 12);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *before = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(before);
    const f64 weights[_] = {1.0, 2.0, 3.0, 0.0, 4.0};
    categorical::Table table = categorical::make(weights, 5);
    usize at = 0;
    for (usize i = 0; i < 5; i++) {
        test::check_equal(double_bits(table.probability[i]), pinned_values[at++]);
        test::check_equal((u64)table.alias[i], pinned_values[at++]);
    }
    random::Key cases[4];
    random::split(random::key_make(42), cases);
    for (usize i = 0; i < 4; i++) {
        test::check_equal((u64)categorical::sample(random::key_make(cases[i].bits), table), pinned_values[at++]);
    }
    test::check_equal(at, 14);
}

typedef struct {
    random::Tap tap;
    u64 word;
} ConstantTap;

static u64 tap_constant(const random::Tap *tap, u64 key, u64 n, u64 bits) {
    (void)key;
    (void)n;
    (void)bits;
    return ((const ConstantTap *)tap)->word;
}

// The zero word gives the simplest value: column 0 and its own coin, as without a hook.
export void test_categorical_zero_word_gives_column_0() {
    ConstantTap zero = {.tap = {tap_constant}, .word = 0};
    arena::Arena a = test::memory(1 << 12);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *before = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(before);
    categorical::Table table = categorical::make((const f64[_]){1.0, 2.0, 3.0}, 3);
    random::Key key = random::key_make(seed + 13);
    key.tap = &zero.tap;
    test::check_equal(categorical::sample(key, table), 0);
}

// categorical::make allocates only through the current allocator (and fails, checked, when it refuses; the refusal
// reads the allocator's handler, which is `c` in mem's own body): no arena of its own, no files, no net, no globals.
void make_stays_within(constexpr auto f) {
    static_assert(effects::within(f, effects::alloc | effects::fails | effects::c),
                  "categorical::make: the current allocator and a checked failure only");
}

export void test_categorical_make_allocates_only_through_the_current_allocator() {
    make_stays_within(categorical::make);
}
