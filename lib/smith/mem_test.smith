// Tests of smith::mem, in smith's own test library (build.c's `test-units` runner links them with the module). A
// refusal that stops the process (a fixed arena's budget under set_allocator) needs a process of its own and is
// tests/arena.sh's.
module smith::mem_test;

import smith::arena;
import smith::mem;
import smith::random;
import smith::test;

constexpr usize capacity = 4096;

typedef struct {
    alignas(arena::align_max) u8 bytes[capacity];
} Memory;

typedef struct {
    u8 bytes[2 * capacity];
} Huge;

typedef struct {
    f64 value;
    i32 count;
} Record;

typedef option(Huge *) MaybeHuge;
typedef option(Record *) MaybeRecord;

// Allocates inside a scope that sets the allocator and restores it with `defer`.
void allocate_from(arena::ArenaAllocator *allocator, Record **record, u64 *sum) {
    mem::Allocator *before = mem::set_allocator(&allocator->base);
    defer mem::set_allocator(before);
    test::check_condition(mem::allocator() == &allocator->base);
    *record = mem::alloc(Record);
    u64 numbers[:] = mem::alloc_slice(u64, 5);
    test::check_equal(countof(numbers), 5);
    for (usize i = 0; i < countof(numbers); i++) {
        test::check_equal(numbers[i], 0);
        numbers[i] = i + 1;
        *sum += numbers[i];
    }
    test::check_condition(allocator->base.owns(&allocator->base, numbers.data));
}

export void test_mem_alloc_reaches_the_allocator_in_force_and_defer_restores_it() {
    static Memory memory;
    arena::Arena a = arena::fixed(memory.bytes, sizeof memory.bytes);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *outside = mem::allocator();
    Record *record = nullptr;
    u64 sum = 0;
    allocate_from(&allocator, &record, &sum);
    test::check_equal(sum, 15);
    test::check_condition(mem::allocator() == outside);                  // the defer put the old one back
    test::check_condition(allocator.base.owns(&allocator.base, record)); // from the arena
    test::check_equal(record->count, 0);                                 // zeroed
    test::check_condition(a.used > 0);
}

export void test_mem_alloc_without_an_allocator_set_is_the_systems_and_never_null() {
    Record *record = mem::alloc(Record);
    test::check_condition(record != nullptr);
    test::check_equal(record->value, 0.0);
    f32 grid[:][:] = mem::alloc_slice(f32, 3, 4);
    test::check_equal(countof(grid), 3);
    test::check_equal(countof(grid[2]), 4);
    grid[2][3] = 5.0f;
    void *aligned = mem::alloc_raw(100, 64);
    test::check_equal((usize)aligned & 63, 0);
    mem::free(aligned);
    mem::free(grid.data);
    mem::free(record);
}

// The tests of an option sit in functions with no generic call: a `== .some` after a call to a generic in the same
// function does not find the option's type (smith issue #353).
MaybeRecord try_record() {
    return mem::try_alloc(Record);
}

MaybeHuge try_huge() {
    return mem::try_alloc(Huge);
}

i32 count_of(MaybeRecord record) {
    if (record == .some) return record.some->count;
    return -1;
}

bool is_some(MaybeHuge huge) {
    return huge == .some;
}

export void test_mem_try_alloc_is_an_option() {
    static Memory memory;
    arena::Arena a = arena::fixed(memory.bytes, sizeof memory.bytes);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *before = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(before);
    test::check_equal(count_of(try_record()), 0); // some, zeroed
    test::check_condition(!is_some(try_huge()));  // 8 KB in a 4 KB arena: the allocator answers null, so none
    test::check_condition(mem::try_alloc_raw(2 * capacity, 16) == nullptr);
}

// ---- failing -------------------------------------------------------------------------------------------------------

constexpr usize calls = 200;

// Asks calls times for 64 bytes through try_alloc_raw under f, frees what it got, and records which were refused.
usize ask(mem::Failing *f, bool refused[calls]) {
    mem::Allocator *before = mem::set_allocator(&f->base);
    defer mem::set_allocator(before);
    usize count = 0;
    for (usize i = 0; i < calls; i++) {
        void *block = mem::try_alloc_raw(64, 16);
        refused[i] = block == nullptr;
        if (block == nullptr) {
            count += 1;
        } else {
            mem::free(block);
        }
    }
    return count;
}

export void test_mem_failing_every_allocation_refused_reaches_each_none_path() {
    mem::Failing f = mem::failing(nullptr, random::key_make(1));
    f.one_in = 1;
    mem::Allocator *before = mem::set_allocator(&f.base);
    defer mem::set_allocator(before);
    test::check_condition(mem::try_alloc_raw(64, 16) == nullptr);
    test::check_condition(mem::try_alloc_raw(64, 64) == nullptr); // the aligned path
    test::check_condition(!is_some(try_huge()));
    test::check_condition(f.base.realloc(&f.base, nullptr, 64, 16) == nullptr);
    test::check_equal(f.refused, 4);
    test::check_equal(f.calls, 4);
}

export void test_mem_failing_with_a_rate_of_zero_refuses_nothing() {
    mem::Failing f = mem::failing(nullptr, random::key_make(2));
    f.one_in = 0;
    bool refused[calls];
    test::check_equal(ask(&f, refused), 0);
    test::check_equal(f.calls, calls);
    test::check_equal(f.refused, 0);
}

export void test_mem_failing_the_same_key_refuses_the_same_allocations() {
    bool first[calls];
    bool second[calls];
    bool other[calls];
    mem::Failing a = mem::failing(nullptr, random::key_make(7));
    mem::Failing b = mem::failing(nullptr, random::key_make(7));
    mem::Failing c = mem::failing(nullptr, random::key_make(8));
    a.one_in = 4;
    b.one_in = 4;
    c.one_in = 4;
    usize refused_first = ask(&a, first);
    usize refused_second = ask(&b, second);
    ask(&c, other);
    test::check_equal(refused_first, refused_second);
    test::check_condition(refused_first > 0 && refused_first < calls); // a quarter, give or take
    bool differs = false;
    for (usize i = 0; i < calls; i++) {
        test::check_condition(first[i] == second[i]);
        differs = differs || first[i] != other[i];
    }
    test::check_condition(differs); // another key is another set of refusals
}

export void test_mem_failing_the_default_rate_is_one_in_eight() {
    mem::Failing f = mem::failing(nullptr, random::key_make(3));
    test::check_equal(f.one_in, 8);
}

export void test_mem_failing_alloc_after_a_refusal_is_a_checked_failure() {
    mem::Failing f = mem::failing(nullptr, random::key_make(4));
    f.one_in = 1;
    mem::set_allocator(&f.base);
    test::expect_abort();
    Record *record = mem::alloc(Record);
    test::check_condition(record == nullptr);
}

// The runner gives a test a Failing beside its key: the allocator in force is that one, and it refuses by the key's
// draws.
export void test_mem_failing_the_runner_installs_the_one_it_gives(random::Key key, mem::Failing *f) {
    (void)random::key_bits(key); // the test's own key, not the allocator's
    test::check_condition(mem::allocator() == &f->base);
    bool refused[calls];
    usize count = ask(f, refused);
    test::check_equal(f->refused, count);
    test::check_condition(count < calls); // one in eight: never all of them
}

// ---- copy, move, zero, fill, equal, bytes and view -----------------------------------------------------------------

export void test_mem_copy_moves_elements_between_slices_of_one_length() {
    i32 from[4] = {1, 2, 3, 4};
    i32 to[4] = {};
    i32 source[:] = from;
    i32 target[:] = to;
    mem::copy(target, source);
    test::check_condition(mem::equal(target, source));
    test::check_equal(to[3], 4);
    mem::copy(target[0:0], source[0:0]); // empty to empty is nothing
}

export void test_mem_copy_with_unequal_lengths_is_a_failed_check() {
    i32 from[4] = {1, 2, 3, 4};
    i32 to[3] = {};
    i32 source[:] = from;
    i32 target[:] = to;
    test::expect_abort();
    mem::copy(target, source);
}

export void test_mem_move_allows_overlap() {
    u8 data[6] = {1, 2, 3, 4, 5, 6};
    u8 all[:] = data;
    mem::move(all[1:6], all[0:5]);
    test::check_equal(data[0], 1);
    test::check_equal(data[1], 1);
    test::check_equal(data[5], 5);
    mem::move(all[0:5], all[1:6]);
    test::check_equal(data[0], 1);
    test::check_equal(data[4], 5);
}

export void test_mem_move_with_unequal_lengths_is_a_failed_check() {
    u8 data[6] = {};
    u8 all[:] = data;
    test::expect_abort();
    mem::move(all[1:6], all[0:4]);
}

export void test_mem_zero_clears_a_slice_or_one_value() {
    f64 values[3] = {1.5, 2.5, 3.5};
    f64 all[:] = values;
    mem::zero(all[1:3]);
    test::check_equal(values[0], 1.5);
    test::check_equal(values[1], 0.0);
    test::check_equal(values[2], 0.0);
    Record record = {.value = 2.0, .count = 7};
    mem::zero(&record);
    test::check_equal(record.value, 0.0);
    test::check_equal(record.count, 0);
}

export void test_mem_fill_sets_every_element() {
    f32 values[4] = {};
    f32 all[:] = values;
    mem::fill(all, 1.5f);
    test::check_equal(values[0], 1.5f);
    test::check_equal(values[3], 1.5f);
    mem::fill(all[1:3], 0.0f);
    test::check_equal(values[0], 1.5f);
    test::check_equal(values[1], 0.0f);
    test::check_equal(values[3], 1.5f);
}

export void test_mem_equal_compares_lengths_first_then_bytes() {
    u8 a[3] = {1, 2, 3};
    u8 b[3] = {1, 2, 3};
    u8 c[3] = {1, 2, 4};
    u8 sa[:] = a;
    u8 sb[:] = b;
    u8 sc[:] = c;
    test::check_condition(mem::equal(sa, sb));
    test::check_condition(!mem::equal(sa, sc));
    test::check_condition(!mem::equal(sa, sb[0:2])); // a prefix is not equal
    test::check_condition(mem::equal(sa[0:0], sc[0:0]));
}

export void test_mem_bytes_carries_the_size_of_the_value() {
    u32 value = 0x01020304;
    u8 as_bytes[:] = mem::bytes(&value);
    test::check_equal(countof(as_bytes), 4);
    as_bytes[0] ^= 0xff;
    test::check_equal(value, 0x010203fb); // the write went through the view (little-endian targets)
    const u8 read[:] = mem::read_bytes(&value);
    test::check_equal(countof(read), 4);
    Record record = {};
    u8 record_bytes[:] = mem::bytes(&record);
    test::check_equal(countof(record_bytes), sizeof(Record));
}

export void test_mem_view_is_a_typed_slice_for_whole_aligned_elements() {
    alignas(16) u8 storage[17] = {};
    f32 source[2] = {1.5f, -2.0f};
    const u8 raw[:] = mem::read_bytes(&source);
    mem::copy(storage[0:8], raw);
    u8 whole[:] = storage[0:8];
    test::check_condition(mem::can_view(whole, f32));
    f32 floats[:] = mem::view(whole, f32);
    test::check_equal(countof(floats), 2);
    test::check_equal(floats[1], -2.0f);
    test::check_condition(!mem::can_view(storage[0:7], f32)); // not a whole number of elements
    test::check_condition(!mem::can_view(storage[1:9], f32)); // misaligned for f32
    test::check_condition(mem::can_view(storage[0:0], f32));  // zero elements
    f32 none[:] = mem::view(storage[0:0], f32);
    test::check_equal(countof(none), 0);
}

export void test_mem_view_of_a_partial_element_is_a_failed_check() {
    alignas(16) u8 storage[8] = {};
    test::expect_abort();
    f32 floats[:] = mem::view(storage[0:7], f32);
    test::check_equal(countof(floats), 1);
}

export void test_mem_view_of_misaligned_bytes_is_a_failed_check() {
    alignas(16) u8 storage[9] = {};
    test::expect_abort();
    f32 floats[:] = mem::view(storage[1:9], f32);
    test::check_equal(countof(floats), 2);
}
