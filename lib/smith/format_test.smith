// Tests of smith::format, in smith's own test library (the units runner links every *_test.smith). The C library's
// snprintf in the C locale is the reference for integers, hexadecimal and fixed places (this program never sets a
// locale); the shortest float text is checked by reading it back with smith::text and against known strings.
module smith::format_test;

import smith::arena;
import smith::format;
import smith::io;
import smith::math;
import smith::random;
import smith::test;
import smith::text;
import scratch;
import <stdint.h>;
import smith::mem;

constexpr usize capacity = 256;
constexpr i64 i64_max = 9223372036854775807;
constexpr i64 i64_min = -9223372036854775807 - 1;
constexpr u64 u64_max = 18446744073709551615ULL;

static bool is(const char *text, const char *expected) {
    return __builtin_strcmp(text, expected) == 0;
}

// The next key of a stream: `stream` moves on (the reassignment pattern) and the key returned is for one use.
static random::Key take(random::Key *stream) {
    random::Key next[2];
    random::split(*stream, next);
    *stream = next[0];
    return next[1];
}

static u64 test_format_draw(random::Key key) {
    random::Key *key_stream = &key;
    u64 shift = random::key_bits(take(key_stream)) % 64;
    return random::key_bits(take(key_stream)) >> shift;
}

typedef struct {
    i32 m;
    f32 b;
} Pair;

typedef struct {
    Pair pair;
    u8 flags : 3;
    u8 mode : 5;
    i32 values[3];
    const char *name;
    bool on;
} Nested;

// A struct is written field by field from fields(T): {m = 1, b = 2}, a nested struct and a fixed array the same way.
export void test_format_struct_is_its_fields() {
    char out[capacity];
    Pair pair = {1, 2};
    format::Written written = format::to(out, sizeof out, pair);
    test::check(written.fits);
    test::check(is(out, "{m = 1, b = 2}"));
    Nested nested = {{-3, 0.5f}, 5, 17, {7, 8, 9}, "box", true};
    (void)format::to(out, sizeof out, "n = ", nested, "!");
    test::check(
        is(out, "n = {pair = {m = -3, b = 0.5}, flags = 5, mode = 17, values = [7, 8, 9], name = box, on = true}!"));
    test::check_equal(format::length(pair), 14);
}

export void test_format_pieces_in_order() {
    char out[capacity];
    u32 n = 3;
    usize total = 10;
    format::Written written = format::to(out, sizeof out, "count: ", n, " of ", total, "\n");
    test::check(written.fits);
    test::check(is(out, "count: 3 of 10\n"));
    test::check_equal(written.length, __builtin_strlen(out));
    test::check_equal(format::to(out, sizeof out).length, 0);
    test::check(is(out, ""));
}

export void test_format_bool_and_char() {
    char out[capacity];
    bool yes = true;
    bool no = false;
    char letter = 'q';
    char nul = '\0';
    (void)format::to(out, sizeof out, yes, " ", no, " ", letter, "|", letter, letter);
    test::check(is(out, "true false q|qq"));
    format::Written written = format::to(out, sizeof out, "a", nul, "b"); // a character is a character, a nul too
    test::check_equal(written.length, 3);
    test::check_equal(out[1], '\0');
    test::check_equal(out[2], 'b');
}

export void test_format_strings_and_text() {
    char out[capacity];
    const char *path = "src/main.smith";
    char *mutable_string = out + 128;
    mutable_string[0] = 'x';
    mutable_string[1] = '\0';
    const char *nothing = nullptr;
    const char whole[:] = "hello world";
    const char word[:] = whole[0:5];
    (void)format::to(out, 128, path, ":", mutable_string, ":", word, ":", format::bytes("abcdef", 3), ":", nothing);
    test::check(is(out, "src/main.smith:x:hello:abc:(null)"));
    const char empty[:] = {};
    test::check_equal(format::to(out, sizeof out, empty).length, 0);
    char letters[4] = "src";
    char mutable_text[:] = letters[0:3];
    (void)format::to(out, sizeof out, "[", mutable_text, "]");
    test::check(is(out, "[src]")); // #168: a char[:] is its characters, never {data = ..., count = [3]}
}

// Every width, signed and unsigned, at its ends, against snprintf.
export void test_format_integers_at_their_limits() {
    char out[capacity];
    char expected[capacity];
    i8 a = -128;
    i16 b = -32768;
    i32 c = -2147483647 - 1;
    i64 d = i64_min;
    u8 e = 255;
    u16 f = 65535;
    u32 g = 4294967295U;
    u64 h = u64_max;
    usize i = (usize)u64_max;
    isize j = (isize)i64_max;
    (void)format::to(out, sizeof out, a, " ", b, " ", c, " ", d, " ", e, " ", f, " ", g, " ", h, " ", i, " ", j);
    __builtin_snprintf(expected, sizeof expected, "%d %d %d %jd %u %u %u %ju %zu %zd", a, b, c, (c::intmax_t)d, e, f, g,
                       (c::uintmax_t)h, i, j);
    test::check(is(out, expected));
    (void)format::to(out, sizeof out, (i8)0, (u64)0, (i64)-1, (i64)i64_max);
    test::check(is(out, "00-19223372036854775807"));
}

export void test_format_signed_matches_libc(random::Key key) {
    random::Key *key_stream = &key;
    char out[capacity];
    char expected[capacity];
    i64 value = (i64)test_format_draw(take(key_stream));
    if ((random::key_bits(take(key_stream)) & 1) != 0) value = -value;
    (void)format::to(out, sizeof out, value);
    __builtin_snprintf(expected, sizeof expected, "%jd", (c::intmax_t)value);
    test::check(is(out, expected));
}

export void test_format_unsigned_matches_libc(random::Key key) {
    char out[capacity];
    char expected[capacity];
    u64 value = test_format_draw(key);
    (void)format::to(out, sizeof out, value, "/", (u32)value, "/", (u16)value, "/", (u8)value);
    __builtin_snprintf(expected, sizeof expected, "%ju/%u/%u/%u", (c::uintmax_t)value, (u32)value, (u16)value,
                       (u8)value);
    test::check(is(out, expected));
}

export void test_format_hex_matches_libc(random::Key key) {
    random::Key *key_stream = &key;
    char out[capacity];
    char expected[capacity];
    u64 value = test_format_draw(take(key_stream));
    u32 width = (u32)(random::key_bits(take(key_stream)) % 20); // past 16 stops at 16
    (void)format::to(out, sizeof out, format::hex(value, width));
    u32 libc_width = width < 16 ? width : 16;
    __builtin_snprintf(expected, sizeof expected, "%0*jx", (i32)libc_width, (c::uintmax_t)value);
    test::check(is(out, expected));
}

export void test_format_hex_known() {
    char out[capacity];
    (void)format::to(out, sizeof out, "0x", format::hex(255, 0), " ", format::hex(255, 4), " ", format::hex(0, 0), " ",
                     format::hex(u64_max, 16), " ", format::hex(0xabc, 2));
    test::check(is(out, "0xff 00ff 0 ffffffffffffffff abc"));
}

// The shortest text that reads back as the same value, and the strings smith::text documents.
export void test_format_floats_known() {
    char out[capacity];
    f64 tiny = 5e-324;
    f64 big = 1e22;
    f64 negative_zero = -0.0;
    f32 half = 0.5F;
    (void)format::to(out, sizeof out, 0.1, " ", 2.5, " ", -3.0, " ", big, " ", tiny, " ", negative_zero, " ", half);
    test::check(is(out, "0.1 2.5 -3 1e22 5e-324 -0 0.5"));
    f32 tenth = 0.1F;
    (void)format::to(out, sizeof out, tenth, " ", 16777216.0F, " ", 3.14159265F);
    test::check(is(out, "0.1 16777216 3.1415927")); // a f32's own shortest digits, not its f64 value's
    (void)format::to(out, sizeof out, math::infinity(f64), " ", -math::infinity(f64), " ", math::nan(f64), " ",
                     math::infinity(f32));
    test::check(is(out, "inf -inf nan inf"));
}

export void test_format_floats_read_back(random::Key key) {
    random::Key *key_stream = &key;
    u64 bits = random::key_bits(take(key_stream));
    f64 value = __builtin_bit_cast(f64, bits);
    if (!math::is_finite(value)) return;
    char out[capacity];
    format::Written written = format::to(out, sizeof out, value);
    f64 back = 0;
    test::check(text::parse_f64(out[0:written.length], &back));
    test::check_same_bits(back, value);
}

static void check_fixed(f64 value, u32 places) {
    char out[capacity];
    char expected[capacity];
    (void)format::to(out, sizeof out, format::fixed(value, places));
    __builtin_snprintf(expected, sizeof expected, "%.*f", (i32)places, value);
    if (!is(out, expected)) {
        test::check_equal(countof(text::make(out)), countof(text::make(expected))); // the failure shows both lengths
        test::check(is(out, expected));
    }
}

export void test_format_fixed_known() {
    char out[capacity];
    (void)format::to(out, sizeof out, format::fixed(3.14159, 2), " ", format::fixed(2.5, 0), " ", format::fixed(3.5, 0),
                     " ", format::fixed(0.125, 2), " ", format::fixed(-0.001, 2), " ", format::fixed(9.999, 2), " ",
                     format::fixed(1.0, 3), " ", format::fixed(100, 1));
    test::check(is(out, "3.14 2 4 0.12 -0.00 10.00 1.000 100.0"));
}

// Ties, and the numbers just either side of them: a halfway case rounds to even, and one binary digit off does not.
export void test_format_fixed_ties_match_libc() {
    for (u32 places = 0; places <= 12; places++) {
        for (u32 k = 0; k < 4096; k++) {
            check_fixed((f64)k / 1024.0, places);
            check_fixed(-(f64)k / 1024.0, places);
            check_fixed((f64)k / 8.0 + 0.5, places);
        }
    }
}

export void test_format_fixed_places_up_to_the_limit() {
    f64 values[] = {0.0,   1.0,        0.1,    0.2,          0.3,   1.0 / 3.0, 2.0 / 3.0,          1e-5,
                    1e-10, 123456.789, 99.995, 0.9999999999, 4.35,  1e15,      4503599627370496.5, 9007199254740993.0,
                    1e18,  9.2e18,     3e-20,  2e-20,        4e-21, 5.5e-300};
    for (usize v = 0; v < sizeof values / sizeof values[0]; v++) {
        for (u32 places = 0; places <= 20; places++) {
            check_fixed(values[v], places);
            check_fixed(-values[v], places);
        }
    }
}

export void test_format_fixed_matches_libc(random::Key key) {
    random::Key *key_stream = &key;
    u64 bits = random::key_bits(take(key_stream));
    f64 value = __builtin_bit_cast(f64, bits);
    u32 places = (u32)(random::key_bits(take(key_stream)) % 21);
    if (!math::is_finite(value)) return;
    f64 magnitude = value < 0 ? -value : value;
    if (magnitude >= 9.2e18) return; // past 2^63 is written as a float
    check_fixed(value, places);
    // A value spread over the useful range, which random bits rarely give: a mantissa times a small power of two.
    u64 mantissa = random::key_bits(take(key_stream)) >> 11;
    i32 exponent = (i32)(random::key_bits(take(key_stream)) % 80) - 70;
    f64 near = (f64)mantissa * __builtin_ldexp(1.0, exponent);
    check_fixed(near, places);
}

export void test_format_fixed_special_values() {
    char out[capacity];
    f64 big = 1e30;
    (void)format::to(out, sizeof out, format::fixed(math::infinity(f64), 2), " ",
                     format::fixed(-math::infinity(f64), 2), " ", format::fixed(math::nan(f64), 2), " ",
                     format::fixed(big, 2), " ", format::fixed(-0.0, 1));
    test::check(is(out, "inf -inf nan 1e30 -0.0"));
    (void)format::to(out, sizeof out, format::fixed(1.5, 30)); // more than 20 places is 20
    test::check(is(out, "1.50000000000000000000"));
}

export void test_format_cut_at_the_capacity() {
    char out[16];
    mem::fill(out[0:sizeof out], 'x');
    format::Written written = format::to(out, 5, "hello", " world");
    test::check(!written.fits);
    test::check_equal(written.length, 11); // what the whole text needs
    test::check(is(out, "hell"));
    test::check_equal(out[5], 'x');        // nothing past the capacity is written
    written = format::to(out, 6, "hello"); // the characters and the terminator
    test::check(written.fits);
    test::check_equal(written.length, 5);
    test::check(is(out, "hello"));
    written = format::to(out, 5, "hello"); // the characters but no room for the terminator
    test::check(!written.fits);
    test::check_equal(written.length, 5);
    test::check(is(out, "hell"));
    written = format::to(out, 1, "hello");
    test::check(!written.fits);
    test::check_equal(out[0], '\0');
}

export void test_format_capacity_zero_measures() {
    format::Written written = format::to(nullptr, 0, "value ", (i64)-12345, " ", format::hex(255, 4), " ", 1.5);
    test::check(!written.fits);
    test::check_equal(written.length, 6 + 6 + 1 + 4 + 1 + 3);
    test::check_equal(format::length("abc", 12345), 8);
    test::check_equal(format::length(), 0);
    char sentinel = 'x';
    written = format::to(&sentinel, 0, "abc");
    test::check_equal(sentinel, 'x');
    test::check_equal(written.length, 3);
}

// A number cut in the middle keeps the digits before the cut, and the length is the whole number's.
export void test_format_cut_in_a_number(random::Key key) {
    random::Key *key_stream = &key;
    u64 value = test_format_draw(take(key_stream));
    char whole[capacity];
    usize length = format::to(whole, sizeof whole, value).length;
    usize room = (usize)(random::key_bits(take(key_stream)) % (length + 2));
    char out[capacity];
    format::Written written = format::to(out, room, value);
    test::check_equal(written.length, length);
    test::check_equal(written.fits, room > length);
    if (room > 0) {
        usize kept = room - 1 < length ? room - 1 : length;
        test::check_condition(mem::equal(out[0:kept], whole[0:kept]));
        test::check_equal(out[kept], '\0');
    }
}

export void test_format_push_on_an_arena() {
    static struct {
        alignas(arena::align_max) u8 bytes[1024];
    } memory;
    arena::Arena a = arena::fixed(memory.bytes, sizeof memory.bytes);
    char path[:] = format::push(&a, "build/meshes/", "ship", ".mesh");
    test::check_equal(countof(path), 22);
    test::check(is(path.data, "build/meshes/ship.mesh")); // terminated after its length
    usize used = a.used;
    char number[:] = format::push(&a, (u64)42);
    test::check_equal(countof(number), 2);
    test::check(is(number.data, "42"));
    test::check(a.used > used);
    char nothing[:] = format::push(&a);
    test::check_equal(countof(nothing), 0);
    test::check_equal(nothing.data[0], '\0');
    arena::reset(&a);
    test::check_equal(a.used, 0);
}

// What the callers of snprintf wrote, as pieces. Each pair is the old call and the new one.
export void test_format_callers() {
    char out[capacity];
    char expected[capacity];
    const char *folder = "/tmp";
    const char *name = "build.c";
    __builtin_snprintf(expected, sizeof expected, "%s/%s", folder, name);
    (void)format::to(out, sizeof out, folder, "/", name);
    test::check(is(out, expected));
    const char *line = "a line";
    usize length = 4;
    __builtin_snprintf(expected, sizeof expected, "%.*s", (i32)length, line);
    (void)format::to(out, sizeof out, format::bytes(line, length));
    test::check(is(out, expected));
    u64 key = 0x0123456789abcdefULL;
    __builtin_snprintf(expected, sizeof expected, "%016jx", (c::uintmax_t)key);
    (void)format::to(out, sizeof out, format::hex(key, 16));
    test::check(is(out, expected));
    f64 ratio = 12.0 / 7.0;
    __builtin_snprintf(expected, sizeof expected, "%.1f (%.0f, %.0f)", ratio, ratio * 3, ratio * 5);
    (void)format::to(out, sizeof out, format::fixed(ratio, 1), " (", format::fixed(ratio * 3, 0), ", ",
                     format::fixed(ratio * 5, 0), ")");
    test::check(is(out, expected));
    u32 jobs = 8;
    __builtin_snprintf(expected, sizeof expected, "%u", jobs);
    (void)format::to(out, sizeof out, jobs);
    test::check(is(out, expected));
    __builtin_snprintf(expected, sizeof expected, "push of %zu bytes (align %zu) with %zu of %zu bytes used", (usize)8,
                       (usize)16, (usize)100, (usize)4096);
    (void)format::to(out, sizeof out, "push of ", (usize)8, " bytes (align ", (usize)16, ") with ", (usize)100, " of ",
                     (usize)4096, " bytes used");
    test::check(is(out, expected));
}

// %g without the trailing zeros the standard says to remove: macOS's printf leaves them after a tie that rounded down
// (%.2g of 10500 is 1.0e+04), so the reference removes them from the mantissa itself.
static void remove_trailing_zeros(char *text) {
    char *point = __builtin_strchr(text, '.');
    if (point == nullptr) return;
    char *end = point + __builtin_strcspn(point, "e");
    char tail[16];
    __builtin_strcpy(tail, end);
    char *last = end;
    while (last > point + 1 && last[-1] == '0') {
        last -= 1;
    }
    if (last == point + 1) last = point;
    __builtin_strcpy(last, tail);
}

static void check_general(f64 value, u32 digits) {
    char out[capacity];
    char expected[capacity];
    (void)format::to(out, sizeof out, format::general(value, digits));
    __builtin_snprintf(expected, sizeof expected, "%.*g", (i32)(digits == 0 ? 1 : (digits < 40 ? digits : 40)), value);
    remove_trailing_zeros(expected);
    if (!is(out, expected)) {
        test::check_equal(countof(text::make(out)), countof(text::make(expected))); // the failure shows both lengths
        test::check(is(out, expected));
    }
}

static void check_scientific(f64 value, u32 places) {
    char out[capacity];
    char expected[capacity];
    (void)format::to(out, sizeof out, format::scientific(value, places));
    __builtin_snprintf(expected, sizeof expected, "%.*e", (i32)(places < 40 ? places : 40), value);
    if (!is(out, expected)) {
        test::check_equal(countof(text::make(out)), countof(text::make(expected)));
        test::check(is(out, expected));
    }
}

export void test_format_general_known() {
    char out[capacity];
    (void)format::to(out, sizeof out, format::general(0.1, 6), " ", format::general(1e22, 6), " ",
                     format::general(100000.0, 6), " ", format::general(1000000.0, 6), " ", format::general(0.0001, 6),
                     " ", format::general(0.00001, 6), " ", format::general(-0.0, 6), " ",
                     format::general(3.14159265358979, 9), " ", format::general(0.1, 17), " ",
                     format::general(math::infinity(f64), 6), " ", format::general(2.5, 0));
    test::check(is(out, "0.1 1e+22 100000 1e+06 0.0001 1e-05 -0 3.14159265 0.10000000000000001 inf 2"));
}

export void test_format_scientific_known() {
    char out[capacity];
    (void)format::to(out, sizeof out, format::scientific(12345.678, 2), " ", format::scientific(0.0, 3), " ",
                     format::scientific(1e300, 0), " ", format::scientific(5e-324, 5), " ",
                     format::scientific(9.9995, 3), " ", format::scientific(-1.0, 1));
    test::check(is(out, "1.23e+04 0.000e+00 1e+300 4.94066e-324 9.999e+00 -1.0e+00"));
}

// Ties: values with an exact binary fraction halfway between two rounded outputs round to even, as printf does.
export void test_format_general_and_scientific_ties_match_libc() {
    for (u32 digits = 0; digits <= 12; digits++) {
        for (u32 k = 0; k < 2048; k++) {
            f64 values[] = {(f64)k / 1024.0, (f64)k / 8.0 + 0.5, (f64)k * 125.0, (f64)k / 64.0 / 1024.0, (f64)k * 1e15};
            for (usize v = 0; v < sizeof values / sizeof values[0]; v++) {
                check_general(values[v], digits);
                check_general(-values[v], digits);
                check_scientific(values[v], digits);
            }
        }
    }
}

export void test_format_general_and_scientific_extremes_match_libc() {
    f64 values[] = {0.0,
                    1.0,
                    0.1,
                    1.0 / 3.0,
                    1e-5,
                    99999.95,
                    999999.5,
                    1e15,
                    1e22,
                    1.7976931348623157e308,
                    2.2250738585072014e-308,
                    5e-324,
                    4.9406564584124654e-324,
                    123456789.0,
                    0.5,
                    9.5,
                    0.95,
                    4.35};
    for (usize v = 0; v < sizeof values / sizeof values[0]; v++) {
        for (u32 digits = 0; digits <= 42; digits++) {
            check_general(values[v], digits);
            check_general(-values[v], digits);
            check_scientific(values[v], digits);
            check_scientific(-values[v], digits);
        }
    }
}

export void test_format_general_and_scientific_match_libc(random::Key key) {
    random::Key *key_stream = &key;
    u64 bits = random::key_bits(take(key_stream));
    f64 value = __builtin_bit_cast(f64, bits);
    u32 digits = (u32)(random::key_bits(take(key_stream)) % 25);
    if (!math::is_finite(value)) return;
    check_general(value, digits);
    check_scientific(value, digits);
    f64 near =
        (f64)(random::key_bits(take(key_stream)) % 100000) / 1000.0; // values with few digits, where rounding is near
    check_general(near, digits);
    check_scientific(near, digits);
}

static void check_padded(const char *expected, format::Padded padded) {
    char out[capacity];
    (void)format::to(out, sizeof out, padded);
    test::check(is(out, expected));
}

export void test_format_padding_known() {
    check_padded("   42", format::pad(42, 5));
    check_padded("42   ", format::left(42, 5));
    check_padded("12345678", format::pad(12345678, 5)); // wider than the column: whole
    check_padded("  ab", format::pad("ab", 4));
    check_padded("ab  ", format::left("ab", 4));
    check_padded("(null) ", format::left((const char *)nullptr, 7));
    check_padded("   abc", format::pad(format::bytes("abcdef", 3), 6));
    check_padded("  12.3", format::pad(format::fixed(12.34, 1), 6));
    check_padded("   0.1", format::pad(0.1, 6));
    check_padded("  true", format::pad(true, 6));
    char letter = 'q';
    check_padded("  q", format::pad(letter, 3));
    check_padded("   ff", format::pad(format::hex(255, 0), 5));
    check_padded("  1e+22", format::pad(format::general(1e22, 6), 7));
    check_padded("", format::pad("", 0));
    check_padded("   ", format::left("", 3));
}

// The printf forms the callers use, each against snprintf.
export void test_format_padding_matches_libc(random::Key key) {
    random::Key *key_stream = &key;
    char out[capacity];
    char expected[capacity];
    u32 width = (u32)(random::key_bits(take(key_stream)) % 14);
    i64 number = (i64)(random::key_bits(take(key_stream)) >> (random::key_bits(take(key_stream)) % 64));
    u64 unsigned_number = random::key_bits(take(key_stream)) >> (random::key_bits(take(key_stream)) % 64);
    f64 value = (f64)(random::key_bits(take(key_stream)) % 2000000) / 1000.0 - 1000.0;
    const char *words[] = {"", "a", "knight", "a longer name than most"};
    const char *word = words[random::key_bits(take(key_stream)) % 4];
    __builtin_snprintf(expected, sizeof expected, "[%*jd|%-*jd|%*ju|%*s|%-*s|%*.2f|%*.0f|%*g]", (i32)width,
                       (c::intmax_t)number, (i32)width, (c::intmax_t)number, (i32)width, (c::uintmax_t)unsigned_number,
                       (i32)width, word, (i32)width, word, (i32)width, value, (i32)width, value, (i32)width, value);
    (void)format::to(out, sizeof out, "[", format::pad(number, width), "|", format::left(number, width), "|",
                     format::pad(unsigned_number, width), "|", format::pad(word, width), "|", format::left(word, width),
                     "|", format::pad(format::fixed(value, 2), width), "|", format::pad(format::fixed(value, 0), width),
                     "|", format::pad(format::general(value, 6), width), "]");
    test::check(is(out, expected));
}

// What the callers in game and learner write: columns of a report.
export void test_format_report_rows_match_libc() {
    char out[capacity];
    char expected[capacity];
    const char *label = "health taken off the other";
    u32 a = 12;
    u32 b = 7;
    __builtin_snprintf(expected, sizeof expected, "  %-34s %10u %10u\n", label, a, b);
    (void)format::to(out, sizeof out, "  ", format::left(label, 34), " ", format::pad(a, 10), " ", format::pad(b, 10),
                     "\n");
    test::check(is(out, expected));
    f64 percent = 56.789;
    __builtin_snprintf(expected, sizeof expected, "    %-16s %5.1f%%  %s\n", "knight", percent, "ok");
    (void)format::to(out, sizeof out, "    ", format::left("knight", 16), " ",
                     format::pad(format::fixed(percent, 1), 5), "%  ", "ok", "\n");
    test::check(is(out, expected));
    __builtin_snprintf(expected, sizeof expected, "%.9g %g", 0.1F + 0.2F, 1e-7);
    (void)format::to(out, sizeof out, format::general((f64)(0.1F + 0.2F), 9), " ", format::general(1e-7, 6));
    test::check(is(out, expected));
}

export void test_format_print_goes_to_the_console() {
    alignas(arena::align_max) static u8 memory[1 << 20];
    io::Io io = io::make_test((io::Test){.memory = memory, .capacity = sizeof memory, .seed = 7});
    io::Error ok = format::print(&io.console, "n = ", 3, ", half = ", format::fixed(0.5, 1), "\n");
    test::check_equal(ok.code, 0);
    io::Error bad = format::print_error(&io.console, "row ", format::left("a", 3), "|", format::pad(9, 3));
    test::check_equal(bad.code, 0);
    test::check(is(io::test_output(&io), "n = 3, half = 0.5\n"));
    test::check(is(io::test_errors(&io), "row a  |  9"));
}

export void test_format_print_too_long_prints_nothing() {
    alignas(arena::align_max) static u8 memory[1 << 20];
    io::Io io = io::make_test((io::Test){.memory = memory, .capacity = sizeof memory, .seed = 7});
    char long_text[5000];
    mem::fill(long_text[0:sizeof long_text - 1], 'x');
    long_text[sizeof long_text - 1] = '\0';
    io::Error error = format::print(&io.console, long_text);
    test::check(error.code != 0);
    test::check(is(io::test_output(&io), ""));
}

// A piece with no rule is a compile-time error that names its position (the instance note lists the types in order).
export void test_format_no_rule_error_names_the_piece(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "lang_project");
    scratch::write(&p, "bad.smith",
                   "import smith::format;\n"
                   "typedef void *Point;\n"
                   "i32 main(void) {\n"
                   "    char buffer[64];\n"
                   "    Point point = nullptr;\n"
                   "    (void)format::to(buffer, sizeof buffer, \"a\", 1, point, 2);\n"
                   "    return 0;\n"
                   "}\n");
    scratch::Run run = scratch::sh(&p, "\"$SMITH_SELF\" cc -I \"$SMITH_REPO/.smith/include\" -fsyntax-only bad.smith 2>&1");
    scratch::expect_contains("format: a piece with no rule is an error", run.out, "static assertion failed");
    scratch::expect_contains("format: and it names the third piece", run.out,
                             "format: no rule for the type of piece 3; the note lists the types in order");
    scratch::expect_contains("format: and the note lists the types", run.out,
                             "in instance smith::format::to(char *, int, Point, int)");
}
