// smith::contract, <smith/contract.h>: contracts written as calls. Its C API is the generated header
// include/smith/contract.h (committed; `smith build headers` regenerates it). Every export has a short name here and a
// C name (the attribute before it): `contract::requires` is `smith_requires`. The comments above an export are the
// header's doc comments, so they name the Smith names; the first one says how a C name follows from them.
module smith::contract;

import target;
import <smith/trace.h>;

// <smith/contract.h>: contracts written as calls. Each is a check that stops the program when its condition is false,
// as an assert does, and `smith prove` proves the same statements on LLVM IR. In a .smith file:
//
//   export i32 clamp(i32 x, i32 low, i32 high) {
//       contract::requires(low <= high);                     // the caller's job
//       i32 result = x < low ? low : x > high ? high : x;
//       contract::ensures(low <= result && result <= high);  // this function's promise
//       return result;
//   }
//
//   for (u8 square = 0; square < squares; square++) {
//       contract::invariant(moves->len <= 2 * square);       // the first statement of a loop body
//       ...
//   }
//
// C calls them smith_requires, smith_ensures, smith_invariant, smith_assert and smith_trusted; a C name that was a
// macro (`assert`) would clash with C's, so the assert is smith_assert.
//
// contract::requires(c)   the start of a function: a caller must make c true.
// contract::ensures(c)    just before a `return`: the function makes c true. An old value is a `const` local saved at
//                         the top, and the result is the variable about to be returned.
// contract::invariant(c)  the first statement of a loop body: c is true on every pass.
// contract::assert(c)     anywhere in a body: c is true here. It is the statement `assert` was, as a function, and
//                         `smith prove` proves it the same way.
// contract::trusted()     the first statement of a function at the program's edge (io, inline assembly, a library with
//                         no source): `smith prove` does not prove it. Its requires is proved at each call and its
//                         ensures assumed, as for any function with a contract, but nothing in its body is read, and
//                         the report lists it as trusted, never as proved. It checks nothing at run time.
//
// A condition must be free of side effects: it is evaluated by the check, and not at all when assertions are off
// (target::assertions, which NDEBUG turns off; the fast profile does).
//
// They are functions of the header that always inline, with an empty body when assertions are off, so the optimizer
// removes the arguments they leave unused. With assertions on each is one call of a function of the library (build.c:
// smith_library(b, "contract")), at every optimization level, since that function is external and the optimizer cannot
// see into it, which is how `smith prove` finds the contracts in the IR without a flag:
//   void smith_contract_requires(bool condition);
//   void smith_contract_ensures(bool condition);
//   void smith_contract_invariant(bool condition);
//   void smith_contract_assert(bool condition);
//   void smith_contract_trusted(void);
// A failed check is smith_failure(kind) (<smith/trace.h>): it records the stack and writes `smith-trace begin requires
// failed` and the frames to standard error, then calls abort(); in a test it fails the test with the same report as a
// failed check, the failing line and the call chain. Where and what come from the stack and the source line, not from
// the library, which links with the trace library (smith_library(b, "trace")).
//
// clang's static analyzer (clang-tidy's clang-analyzer-*, `smith lint`) cannot see what a call means, so without help
// it reports every index a contract bounds. Under target::static_analyzer (true only there) each is an assumption, as
// the failure path of `assert` is for it, and nothing else changes: a compile, `smith prove` and the checks are as
// above.
[[smith::c_name("smith_contract_requires")]] export void check_requires(bool condition) {
    if (!condition) c::smith_failure(c::SmithFailure_Requires);
}

[[smith::c_name("smith_contract_ensures")]] export void check_ensures(bool condition) {
    if (!condition) c::smith_failure(c::SmithFailure_Ensures);
}

[[smith::c_name("smith_contract_invariant")]] export void check_invariant(bool condition) {
    if (!condition) c::smith_failure(c::SmithFailure_Invariant);
}

[[smith::c_name("smith_contract_assert")]] export void check_assert(bool condition) {
    if (!condition) c::smith_failure(c::SmithFailure_Assert);
}

// A marker for `smith prove`, which reads the call in the IR: a trusted function is assumed, not proved. It checks
// nothing, at run time or anywhere else.
[[smith::c_name("smith_contract_trusted")]] export void check_trusted(void) {}


[[smith::c_name("smith_requires")]] export [[gnu::always_inline, maybe_unused]] inline void requires(bool condition) {
    if constexpr (target::static_analyzer) {
        __builtin_assume(condition);
    } else if constexpr (target::assertions) {
        check_requires(condition);
    } else {
        (void)condition;
    }
}

[[smith::c_name("smith_ensures")]] export [[gnu::always_inline, maybe_unused]] inline void ensures(bool condition) {
    if constexpr (target::static_analyzer) {
        __builtin_assume(condition);
    } else if constexpr (target::assertions) {
        check_ensures(condition);
    } else {
        (void)condition;
    }
}

[[smith::c_name("smith_invariant")]] export [[gnu::always_inline, maybe_unused]] inline void
invariant(bool condition) {
    if constexpr (target::static_analyzer) {
        __builtin_assume(condition);
    } else if constexpr (target::assertions) {
        check_invariant(condition);
    } else {
        (void)condition;
    }
}

[[smith::c_name("smith_assert")]] export [[gnu::always_inline, maybe_unused]] inline void assert(bool condition) {
    if constexpr (target::static_analyzer) {
        __builtin_assume(condition);
    } else if constexpr (target::assertions) {
        check_assert(condition);
    } else {
        (void)condition;
    }
}

[[smith::c_name("smith_trusted")]] export [[gnu::always_inline, maybe_unused]] inline void trusted(void) {
    if constexpr (target::static_analyzer) {
    } else if constexpr (target::assertions) {
        check_trusted();
    }
}
