// Tests of std::random through its exported API, in smith's own test library. The statistical checks take a key
// (a property test: 100 keys, a failure prints the seed that replays it). What reaches the module's private functions
// (Philox's known answers, the zigzag and the index order, the inverse CDF, the digest across build configurations, the
// refusals) stays in tests/random.c, run by tests/random_c_test.smith.
module std::random_test;

import std::random;
import std::test;
import <math.h>;

constexpr U64 seed = 20260101;
constexpr Usize draws = 10000; // per key: a hundred keys make the million draws the C program made once
constexpr I64 i64_max = 9223372036854775807;
constexpr I64 i64_min = -9223372036854775807 - 1;

// Wilson-Hilferty at z = 5, about 3e-7 in the tail: a correct draw passes.
static F64 chi_limit(Usize degrees) {
    F64 d = (F64)degrees;
    F64 t = 1.0 - 2.0 / (9.0 * d) + 5.0 * __builtin_sqrt(2.0 / (9.0 * d));
    return d * t * t * t;
}

static F64 chi_square(const Usize *observed, const F64 *expected, Usize cells) {
    F64 sum = 0;
    for (Usize i = 0; i < cells; i++) {
        F64 difference = (F64)observed[i] - expected[i];
        sum += difference * difference / expected[i];
    }
    return sum;
}

// Distance in representable values between two finite doubles / floats.
static I64 ulps_double(F64 a, F64 b) {
    I64 x = __builtin_bit_cast(I64, a);
    I64 y = __builtin_bit_cast(I64, b);
    if (x < 0) {
        x = i64_min - x;
    }
    if (y < 0) {
        y = i64_min - y;
    }
    return x > y ? x - y : y - x;
}

static I64 ulps_float(F32 a, F32 b) {
    I64 x = __builtin_bit_cast(I32, a);
    I64 y = __builtin_bit_cast(I32, b);
    if (x < 0) {
        x = -2147483648 - x;
    }
    if (y < 0) {
        y = -2147483648 - y;
    }
    return x > y ? x - y : y - x;
}

// The next key of a stream: `stream` moves on (the reassignment pattern) and the key returned is for one use.
static random::Key take(random::Key *stream) {
    random::Key next[2];
    random::split(*stream, next);
    *stream = next[0];
    return next[1];
}

static random::UniformInt64 range(I64 low, I64 high) {
    return (random::UniformInt64){.low = low, .high = high};
}

// ---------------------------------------------------------------------------------------------------------------
// Keys and the uniform distributions

export void test_random_keys_are_pure_and_distinct(random::Key key) {
    U64 seed_of_key = key.bits; // a read of the key's bits: its one use
    test::check_equal(random::key_bits(random::key_make(seed_of_key)), random::key_bits(random::key_make(seed_of_key)));
    random::Key parts[3];
    random::split(random::key_make(seed_of_key), parts);
    U64 part_0 = parts[0].bits;
    U64 part_1 = parts[1].bits;
    U64 part_2 = parts[2].bits;
    test::check_not_equal(part_0, part_1);
    test::check_not_equal(part_1, part_2);
    random::Key again[3];
    random::split(random::key_make(seed_of_key), again);
    test::check_equal(again[1].bits, part_1); // split is pure
    U64 again_0 = again[0].bits;
    test::check_not_equal(again_0, seed_of_key); // split's domain is not the words'
    test::check_not_equal(random::key_make(1).bits, random::key_make(2).bits);
    random::Key root = random::key_make(seed_of_key);
    random::Key *stream = &root;
    U64 top = 0;
    for (U64 n = 0; n < 1000; n++) {
        random::Key unit[3];
        random::split(take(stream), unit);
        F32 f = random::key_unit_float(unit[0]);
        F64 d = random::key_unit_double(unit[1]);
        test::check(f >= 0.0F && f < 1.0F);
        test::check(d >= 0.0 && d < 1.0);
        test::check(1.0 - d > 0.0);
        top += random::key_bits(unit[2]) >> 63;
    }
    test::check(top > 400 && top < 600); // the top bit is fair
}

export void test_random_uniform_int64_is_uniform_and_in_range(random::Key key) {
    random::Key *stream = &key;
    Usize observed[10] = {};
    for (U64 i = 0; i < draws; i++) {
        I64 value = random::uniform_int64_sample(take(stream), range(-3, 6));
        test::check(value >= -3 && value <= 6);
        observed[value + 3]++;
    }
    F64 expected[10];
    for (Usize i = 0; i < 10; i++) {
        expected[i] = (F64)draws / 10.0;
    }
    test::check_less(chi_square(observed, expected, 10), chi_limit(9));
    for (U64 i = 0; i < 100; i++) {
        test::check_equal(random::uniform_int64_sample(take(stream), range(5, 5)), 5);
        test::check_equal(random::uniform_int64_sample(take(stream), range(i64_min, i64_min)), i64_min);
        test::check_equal(random::uniform_int64_sample(take(stream), range(i64_max, i64_max)), i64_max);
    }
    // The full range has both signs.
    Usize negative = 0;
    for (U64 i = 0; i < draws; i++) {
        negative += random::uniform_int64_sample(take(stream), range(i64_min, i64_max)) < 0 ? 1 : 0;
    }
    test::check(negative > draws * 47 / 100 && negative < draws * 53 / 100);
}

// A span of 2^63 + 1 rejects about half of the candidates (2^64 mod span is 2^63 - 1); the offsets must still be
// uniform, so the half above span / 2 is hit half of the time.
export void test_random_uniform_int64_wide_span() {
    random::Key root = random::key_make(seed + 1);
    random::Key *stream = &root;
    I64 high = 0; // [INT64_MIN, 0] has 2^63 + 1 values
    constexpr Usize count = 400000;
    Usize upper = 0;
    Usize retried = 0;
    for (U64 i = 0; i < count; i++) {
        U64 word = random::key_bits(take(stream)); // two keys of the same seed: the draw and the check of its word
        I64 value = random::uniform_int64_sample(random::key_make(word), range(i64_min, high));
        test::check(value <= high);
        upper += (U64)value - (U64)i64_min >= ((U64)1 << 62) ? 1 : 0;
        unsigned _BitInt(128) product =
            (unsigned _BitInt(128))random::key_bits(random::key_make(word)) * (((U64)1 << 63) + 1);
        retried += (U64)product >= ((U64)1 << 63) + 1 ? 1 : 0; // the first candidate is rejected
    }
    F64 deviation = __builtin_sqrt((F64)count * 0.25);
    test::check_less(__builtin_fabs((F64)upper - (F64)count / 2.0), 5.0 * deviation);
    test::check_greater(retried, 0);
}

export void test_random_uniform_real_moments(random::Key key) {
    random::Key *stream = &key;
    F64 sum = 0;
    F64 square = 0;
    for (U64 i = 0; i < draws; i++) {
        F64 value = random::uniform_double_sample(take(stream), (random::UniformDouble){2.0, 5.0});
        test::check(value >= 2.0 && value < 5.0);
        sum += value;
        square += (value - 3.5) * (value - 3.5);
    }
    F64 n = (F64)draws;
    test::check_less(__builtin_fabs(sum / n - 3.5), 5.5 * 0.866 / __builtin_sqrt(n)); // sigma / sqrt(n)
    test::check_less(__builtin_fabs(square / n - 0.75), 6.0 * 0.75 * 0.895 / __builtin_sqrt(n));
    sum = 0;
    square = 0;
    for (U64 i = 0; i < draws; i++) {
        F32 value = random::uniform_float_sample(take(stream), (random::UniformFloat){-1.0F, 3.0F});
        test::check(value >= -1.0F && value < 3.0F);
        sum += (F64)value;
        square += ((F64)value - 1.0) * ((F64)value - 1.0);
    }
    test::check_less(__builtin_fabs(sum / n - 1.0), 5.5 * 1.1547 / __builtin_sqrt(n));
    test::check_less(__builtin_fabs(square / n - 4.0 / 3.0), 6.0 * (4.0 / 3.0) * 0.895 / __builtin_sqrt(n));
}

export void test_random_unit_values_are_on_their_grid(random::Key key) {
    random::Key *stream = &key;
    for (U64 i = 0; i < 1000; i++) { // the unit scaled by 2^24 / 2^53 is an integer
        F32 f = random::key_unit_float(take(stream));
        test::check_equal(f, __builtin_floorf(f * 0x1p24F) / 0x1p24F);
        F64 d = random::key_unit_double(take(stream));
        test::check_equal(d, __builtin_floor(d * 0x1p53) / 0x1p53);
    }
}

// Ranges built so that low + (high - low) * unit rounds up to high: high is a power of two just above low's magnitude
// gap, so a unit near 1 rounds to high. The result must still be below high.
export void test_random_uniform_real_stays_below_high_when_rounding_reaches_it() {
    random::Key root = random::key_make(seed + 3);
    random::Key *stream = &root;
    const F32 lows[_] = {1.0F, -0x1p-30F, 16777216.0F, -1.0F, 0.0F};
    const F32 highs[_] = {1.0000001F, 0.0F, 16777218.0F, -0.99999994F, 0x1p-149F};
    Usize reached = 0;
    for (Usize r = 0; r < 5; r++) {
        for (U64 i = 0; i < 200000; i++) {
            U64 word = random::key_bits(take(stream)); // two keys of one seed: the draw and its unit
            F32 value = random::uniform_float_sample(random::key_make(word), (random::UniformFloat){lows[r], highs[r]});
            test::check(value >= lows[r] && value < highs[r]);
            reached +=
                lows[r] + (highs[r] - lows[r]) * random::key_unit_float(random::key_make(word)) >= highs[r] ? 1 : 0;
        }
    }
    test::check_greater(reached, 0); // the rounding case happened, and was handled
    const F64 dlows[_] = {1.0, -0x1p-60, 9007199254740992.0, -1.0};
    const F64 dhighs[_] = {1.0000000000000002, 0.0, 9007199254740994.0, -0.9999999999999999};
    for (Usize r = 0; r < 4; r++) {
        for (U64 i = 0; i < 200000; i++) {
            F64 value = random::uniform_double_sample(take(stream), (random::UniformDouble){dlows[r], dhighs[r]});
            test::check(value >= dlows[r] && value < dhighs[r]);
        }
    }
}

// ---------------------------------------------------------------------------------------------------------------
// Normal, Bernoulli, permutation

export void test_random_normal_moments(random::Key key) {
    random::Key *stream = &key;
    F64 sum = 0;
    F64 square = 0;
    F64 sum_float = 0;
    F64 square_float = 0;
    for (U64 i = 0; i < draws; i++) {
        F64 d = random::normal_double_sample(take(stream), (random::NormalDouble){1.0, 2.0});
        F32 f = random::normal_float_sample(take(stream), (random::NormalFloat){-3.0F, 0.5F});
        sum += d;
        square += (d - 1.0) * (d - 1.0);
        sum_float += (F64)f;
        square_float += ((F64)f + 3.0) * ((F64)f + 3.0);
    }
    F64 n = (F64)draws;
    test::check_less(__builtin_fabs(sum / n - 1.0), 5.5 * 2.0 / __builtin_sqrt(n));
    test::check_less(__builtin_fabs(square / n - 4.0), 5.5 * 4.0 * __builtin_sqrt(2.0 / n));
    test::check_less(__builtin_fabs(sum_float / n + 3.0), 5.5 * 0.5 / __builtin_sqrt(n));
    test::check_less(__builtin_fabs(square_float / n - 0.25), 5.5 * 0.25 * __builtin_sqrt(2.0 / n));
}

// The documented reach: every value finite and within the grid's extremes (about 8.2 and 5.3 deviations).
export void test_random_normal_stays_within_its_reach(random::Key key) {
    random::Key *stream = &key;
    for (U64 i = 0; i < draws; i++) {
        test::check_less(__builtin_fabs(random::normal_double_sample(take(stream), (random::NormalDouble){0.0, 1.0})),
                         8.3);
        test::check_less(__builtin_fabsf(random::normal_float_sample(take(stream), (random::NormalFloat){0.0F, 1.0F})),
                         5.4F);
    }
}

export void test_random_bernoulli_frequency(random::Key key) {
    random::Key *stream = &key;
    Usize hits = 0;
    for (U64 i = 0; i < draws; i++) {
        random::Key k[3];
        random::split(take(stream), k);
        test::check(!random::bernoulli_sample(k[0], (random::Bernoulli){0.0}));
        test::check(random::bernoulli_sample(k[1], (random::Bernoulli){1.0}));
        hits += random::bernoulli_sample(k[2], (random::Bernoulli){0.3}) ? 1 : 0;
    }
    F64 n = (F64)draws;
    test::check_less(__builtin_fabs((F64)hits - 0.3 * n), 5.5 * __builtin_sqrt(n * 0.3 * 0.7));
}

export void test_random_permutations_are_permutations(random::Key key) {
    Usize out[16];
    random::Key *stream = &key;
    random::permutation_sample(take(stream), (random::Permutation){}, nullptr); // writes nothing
    random::permutation_sample(take(stream), (random::Permutation){1}, out);
    test::check_equal(out[0], 0);
    for (U64 i = 0; i < 100; i++) {
        random::permutation_sample(take(stream), (random::Permutation){16}, out);
        Bool seen[16] = {false};
        for (Usize j = 0; j < 16; j++) {
            test::check(out[j] < 16 && !seen[out[j]]);
            seen[out[j]] = true;
        }
    }
}

export void test_random_permutations_of_four_are_uniform(random::Key key) {
    random::Key *stream = &key;
    Usize out[16];
    Usize orders[24] = {};
    constexpr Usize count = 6000;
    for (U64 i = 0; i < count; i++) {
        random::permutation_sample(take(stream), (random::Permutation){4}, out);
        Usize rank = 0; // the Lehmer code gives each of the 24 orders its own number
        for (Usize a = 0; a < 4; a++) {
            Usize smaller = 0;
            for (Usize b = a + 1; b < 4; b++) {
                smaller += out[b] < out[a] ? 1 : 0;
            }
            rank = rank * (4 - a) + smaller;
        }
        test::check_less(rank, 24);
        orders[rank]++;
    }
    F64 expected[24];
    for (Usize i = 0; i < 24; i++) {
        expected[i] = (F64)count / 24.0;
    }
    test::check_less(chi_square(orders, expected, 24), chi_limit(23));
}

// ---------------------------------------------------------------------------------------------------------------
// The logarithm: within 1 ulp of libm's log and logf over about 1e6 inputs, across exponents and subnormals.

static I64 log_worst_double() {
    I64 worst = 0;
    random::Key root = random::key_make(seed + 11);
    random::Key *stream = &root;
    for (U64 i = 0; i < 1000000; i++) {
        random::Key parts[2];
        random::split(take(stream), parts);
        U64 bits = random::key_bits(parts[0]);
        F64 x = 0;
        switch (i % 4) {
        case 0:
            x = __builtin_bit_cast(F64, bits & 0x7fffffffffffffffULL); // every exponent
            break;
        case 1:
            x = __builtin_bit_cast(F64, bits & 0x000fffffffffffffULL); // subnormals (and 0)
            break;
        case 2:
            x = 0.5 + 1.5 * random::key_unit_double(parts[1]); // around 1
            break;
        default:
            x = 1.0 + c::ldexp(random::key_unit_double(parts[1]), -(I32)(bits % 50));
            break;
        }
        if (!__builtin_isfinite(x) || x == 0.0) {
            continue;
        }
        I64 distance = ulps_double(random::log_double(x), c::log(x));
        if (distance > worst) {
            worst = distance;
        }
    }
    return worst;
}

static I64 log_worst_float() {
    I64 worst = 0;
    random::Key root = random::key_make(seed + 12);
    random::Key *stream = &root;
    for (U64 i = 0; i < 1000000; i++) {
        random::Key parts[2];
        random::split(take(stream), parts);
        U64 bits = random::key_bits(parts[0]);
        F32 x = 0;
        switch (i % 4) {
        case 0:
            x = __builtin_bit_cast(F32, (U32)bits & 0x7fffffffU);
            break;
        case 1:
            x = __builtin_bit_cast(F32, (U32)bits & 0x007fffffU); // subnormals
            break;
        case 2:
            x = 0.5F + 1.5F * random::key_unit_float(parts[1]);
            break;
        default:
            x = 1.0F + c::ldexpf(random::key_unit_float(parts[1]), -(I32)(bits % 24));
            break;
        }
        if (!__builtin_isfinite(x) || x == 0.0F) {
            continue;
        }
        I64 distance = ulps_float(random::log_float(x), c::logf(x));
        if (distance > worst) {
            worst = distance;
        }
    }
    return worst;
}

export void test_random_log_double_is_within_one_ulp() {
    test::check_less_equal(log_worst_double(), 1);
}

export void test_random_log_float_is_within_one_ulp() {
    test::check_less_equal(log_worst_float(), 1);
}

export void test_random_log_special_values() {
    F64 infinity = __builtin_inf();
    F32 infinity_float = __builtin_inff();
    test::check_equal(random::log_double(0.0), -infinity);
    test::check_equal(random::log_double(-0.0), -infinity);
    test::check_equal(random::log_float(0.0F), -infinity_float);
    test::check_equal(random::log_float(-0.0F), -infinity_float);
    test::check(__builtin_isnan(random::log_double(-1.0)));
    test::check(__builtin_isnan(random::log_double(-infinity)));
    test::check(__builtin_isnan(random::log_double(-0x1p-1074)));
    test::check(__builtin_isnan(random::log_float(-1.0F)));
    test::check(__builtin_isnan(random::log_float(-infinity_float)));
    test::check(__builtin_isnan(random::log_float(-0x1p-149F)));
    test::check_equal(random::log_double(infinity), infinity);
    test::check_equal(random::log_float(infinity_float), infinity_float);
    test::check(__builtin_isnan(random::log_double(__builtin_nan(""))));
    test::check(__builtin_isnan(random::log_float(__builtin_nanf(""))));
    test::check_equal(random::log_double(1.0), 0.0);
    test::check_equal(random::log_float(1.0F), 0.0F);
    test::check_less_equal(ulps_double(random::log_double(0x1p-1074), c::log(0x1p-1074)), 1); // the smallest subnormal
    test::check_less_equal(ulps_float(random::log_float(0x1p-149F), c::logf(0x1p-149F)), 1);
    test::check_less_equal(ulps_double(random::log_double(0x1.fffffffffffffp+1023), c::log(0x1.fffffffffffffp+1023)),
                           1);
    test::check_less_equal(ulps_float(random::log_float(0x1.fffffep+127F), c::logf(0x1.fffffep+127F)), 1);
}

// ---------------------------------------------------------------------------------------------------------------
// The pinned values: bits of key_bits for seeds 0, 1 and UINT64_MAX, split, and every distribution for one key (floats
// as their bits). The numbers are part of the API: a change to any of them is a breaking change.

static constexpr U64 pinned_values[_] = {
    0xe169c58d6627e8d5, // bits
    0xf08d6eaa844515e1, // split
    0xd9c77dedca7cf69e, // split
    0xbe4bbd74c5fa1393, // split
    0xe50a0ebce3e80670, // bits
    0x428264b607071c12, // split
    0xf04a50803b539b4f, // split
    0xa9b8bbe87d34a749, // split
    0x1547473972a47709, // bits
    0x7e853102a74236ed, // split
    0xb9575d3a213c880d, // split
    0x71cfe040fa00339a, // split
    0x000000003ef30fa6, // unit_float
    0x3fde61f4fa7e2600, // unit_double
    0x00000000bf97e9c8, // uniform_float
    0x3ff2fd391c8ed7c0, // uniform_double
    0x0000000000000002, // uniform_int64
    0x00000000be8a7c9c, // normal_float
    0x400229f29201b1cb, // normal_double
    0x0000000000000000, // bernoulli
    0x00000000bea4d7a8, // log_float
    0xbfd49af4a1babd83, // log_double
    0x000000003f6f5147, // unit_float
    0x3fedea28f42121bc, // unit_double
    0x00000000402b2598, // uniform_float
    0x400564b331296a2c, // uniform_double
    0x0000000000000006, // uniform_int64
    0x00000000c02c0c06, // normal_float
    0x4012c0c0ac77efea, // normal_double
    0x0000000000000001, // bernoulli
    0x000000003e2dac53, // log_float
    0x3fc5b58a44f624ee, // log_double
    0x000000003f77aa93, // unit_float
    0x3feef552732b2b7a, // unit_double
    0x0000000040359538, // uniform_float
    0x4006b2a70ff5f658, // uniform_double
    0x0000000000000006, // uniform_int64
    0x00000000c0519b22, // normal_float
    0xc00a33655f8a9c90, // normal_double
    0x0000000000000001, // bernoulli
    0x000000003e497a52, // log_float
    0x3fc92f4a290f0e12, // log_double
    0x000000003f6c4500, // unit_float
    0x3fed88a0125f909b, // unit_double
    0x0000000040275640, // uniform_float
    0x4004eac816f774c2, // uniform_double
    0x0000000000000006, // uniform_int64
    0x00000000409125d2, // normal_float
    0xc00449741659234a, // normal_double
    0x0000000000000001, // bernoulli
    0x000000003e2354c6, // log_float
    0x3fc46a98ed1913b5, // log_double
    0x0000000000000004, // permutation
    0x0000000000000005, // permutation
    0x0000000000000003, // permutation
    0x0000000000000000, // permutation
    0x0000000000000006, // permutation
    0x0000000000000002, // permutation
    0x0000000000000001, // permutation
    0x0000000000000007, // permutation
};

typedef struct {
    Usize count;
} Pins;

static void pin(Pins *pins, U64 value) {
    test::check_less(pins->count, 60);
    test::note("pinned value number %zu", pins->count);
    test::check_equal(value, pinned_values[pins->count]);
    pins->count++;
}

static U64 float_bits(F32 value) {
    return __builtin_bit_cast(U32, value);
}

static U64 double_bits(F64 value) {
    return __builtin_bit_cast(U64, value);
}

export void test_random_pinned_values() {
    Pins pins = {};
    const U64 seeds[_] = {0, 1, 18446744073709551615ULL};
    for (Usize s = 0; s < 3; s++) {
        pin(&pins, random::key_bits(random::key_make(seeds[s])));
        random::Key parts[3];
        random::split(random::key_make(seeds[s]), parts);
        for (Usize i = 0; i < 3; i++) {
            pin(&pins, parts[i].bits);
        }
    }
    random::Key cases[4];
    random::split(random::key_make(42), cases);
    for (Usize i = 0; i < 4; i++) {
        U64 word = cases[i].bits; // every draw below is made from a key of this seed
        pin(&pins, float_bits(random::key_unit_float(random::key_make(word))));
        pin(&pins, double_bits(random::key_unit_double(random::key_make(word))));
        pin(&pins,
            float_bits(random::uniform_float_sample(random::key_make(word), (random::UniformFloat){-2.0F, 3.0F})));
        pin(&pins,
            double_bits(random::uniform_double_sample(random::key_make(word), (random::UniformDouble){-2.0, 3.0})));
        pin(&pins, (U64)random::uniform_int64_sample(random::key_make(word), range(-3, 6)));
        pin(&pins, float_bits(random::normal_float_sample(random::key_make(word), (random::NormalFloat){1.0F, 2.0F})));
        pin(&pins, double_bits(random::normal_double_sample(random::key_make(word), (random::NormalDouble){1.0, 2.0})));
        pin(&pins, random::bernoulli_sample(random::key_make(word), (random::Bernoulli){0.3}) ? 1 : 0);
        pin(&pins, float_bits(random::log_float(random::key_unit_float(random::key_make(word)) + 0.25F)));
        pin(&pins, double_bits(random::log_double(random::key_unit_double(random::key_make(word)) + 0.25)));
    }
    Usize order[8];
    random::permutation_sample(random::key_make(42), (random::Permutation){8}, order);
    for (Usize i = 0; i < 8; i++) {
        pin(&pins, order[i]);
    }
    test::check_equal(pins.count, 60);
}

// ---------------------------------------------------------------------------------------------------------------
// Shrinking: the zero word gives the simplest value. A tap replaces every word a key hands out; the word is kept
// beside the tap, so tests running side by side share nothing.

typedef struct {
    random::Tap tap;
    U64 word;
} ConstantTap;

static U64 tap_constant(const random::Tap *tap, U64 key, U64 n, U64 bits) {
    (void)key;
    (void)n;
    (void)bits;
    return ((const ConstantTap *)tap)->word;
}

static random::Key tapped(const ConstantTap *tap) {
    random::Key key = random::key_make(seed + 13);
    key.tap = &tap->tap;
    return key;
}

// The word that makes Lemire's index equal `index` for a span: the smallest word whose high half is the index.
static U64 word_for_index(U64 index, U64 span) {
    unsigned _BitInt(128) shifted = (unsigned _BitInt(128))index << 64;
    return (U64)((shifted + span - 1) / span);
}

export void test_random_zero_word_gives_the_simplest_value() {
    ConstantTap zero = {.tap = {tap_constant}, .word = 0};
    test::check_equal(random::uniform_int64_sample(tapped(&zero), range(-3, 6)), 0);
    test::check_equal(random::uniform_int64_sample(tapped(&zero), range(5, 9)), 5);
    test::check_equal(random::uniform_int64_sample(tapped(&zero), range(-9, -5)), -5);
    test::check_equal(random::uniform_int64_sample(tapped(&zero), range(i64_min, i64_max)), 0);
    test::check_equal(random::uniform_int64_sample(tapped(&zero), range(i64_min, 1)), 0);
    test::check_equal(random::uniform_int64_sample(tapped(&zero), range(i64_max - 1, i64_max)), i64_max - 1);
    test::check_equal(random::uniform_double_sample(tapped(&zero), (random::UniformDouble){2.0, 5.0}), 2.0);
    test::check_equal(random::uniform_float_sample(tapped(&zero), (random::UniformFloat){2.0F, 5.0F}), 2.0F);
    test::check_equal(random::uniform_double_sample(tapped(&zero), (random::UniformDouble){0.0, 5.0}), 0.0);
    F64 d =
        random::uniform_double_sample(tapped(&zero), (random::UniformDouble){-1.0, 3.0}); // within one grid step of 0
    test::check_less_equal(__builtin_fabs(d), 4.0 * 0x1p-53);
    F32 f = random::uniform_float_sample(tapped(&zero), (random::UniformFloat){-1.0F, 3.0F});
    test::check_less_equal(__builtin_fabsf(f), 4.0F * 0x1p-24F);
    d = random::uniform_double_sample(tapped(&zero),
                                      (random::UniformDouble){-5.0, -1.0}); // the bound nearest 0: just below -1
    test::check(d < -1.0 && d >= -1.0 - 4.0 * 0x1p-53 * 4.0);
    f = random::uniform_float_sample(tapped(&zero), (random::UniformFloat){-5.0F, -1.0F});
    test::check(f < -1.0F && f >= -1.0F - 4.0F * 0x1p-24F * 4.0F);
    F64 nd = random::normal_double_sample(tapped(&zero), (random::NormalDouble){10.0, 2.0});
    test::check(nd >= 10.0 && nd - 10.0 < 2.0 * 1e-15);
    F32 nf = random::normal_float_sample(tapped(&zero), (random::NormalFloat){10.0F, 2.0F});
    test::check(nf >= 10.0F && nf - 10.0F < 2.0F * 1e-6F);
    test::check(!random::bernoulli_sample(tapped(&zero), (random::Bernoulli){0.3}));
    test::check(!random::bernoulli_sample(tapped(&zero), (random::Bernoulli){0.0}));
    test::check(random::bernoulli_sample(tapped(&zero), (random::Bernoulli){1.0}));
    Usize order[9];
    random::permutation_sample(tapped(&zero), (random::Permutation){9}, order);
    for (Usize i = 0; i < 9; i++) {
        test::check_equal(order[i], i);
    }
}

export void test_random_one_step_off_the_identity_moves_a_position() {
    ConstantTap step = {.tap = {tap_constant}, .word = word_for_index(1, 4)};
    Usize out[4];
    random::permutation_sample(tapped(&step), (random::Permutation){4}, out);
    Usize moved = 0;
    for (Usize i = 0; i < 4; i++) {
        moved += out[i] != i ? 1 : 0;
    }
    test::check_greater(moved, 0);
}

// Words 1, 2 and 3 move the integer away from the simplest value in the zigzag order.
export void test_random_small_words_walk_out_from_zero() {
    const U64 words[_] = {0, 1, 2, 3, 4};
    const I64 full[_] = {0, -1, 1, -2, 2};
    for (Usize i = 0; i < 5; i++) {
        ConstantTap full_tap = {.tap = {tap_constant}, .word = words[i]};
        test::check_equal(random::uniform_int64_sample(tapped(&full_tap), range(i64_min, i64_max)), full[i]);
        ConstantTap span_tap = {.tap = {tap_constant}, .word = word_for_index(i, 10)}; // indices 0 to 4 of [-3, 6]
        test::check_equal(random::uniform_int64_sample(tapped(&span_tap), range(-3, 6)), full[i]);
    }
}

// The real uniform: grid points 0, then steps away from 0.
export void test_random_small_words_walk_the_real_grid() {
    F64 previous = -1.0;
    for (U64 w = 0; w < 5; w++) {
        ConstantTap tap = {.tap = {tap_constant}, .word = w << 11};
        F64 d = random::uniform_double_sample(tapped(&tap), (random::UniformDouble){0.0, 1.0});
        test::check_equal(d, (F64)w * 0x1p-53);
        test::check_greater(d, previous);
        previous = d;
    }
}

// The Bernoulli: only the last grid index is true, at probability 1 - 2^-53.
export void test_random_bernoulli_under_a_tap() {
    ConstantTap low = {.tap = {tap_constant}, .word = (U64)1 << 11};
    test::check(!random::bernoulli_sample(tapped(&low), (random::Bernoulli){0.5}));
    test::check(random::bernoulli_sample(tapped(&low), (random::Bernoulli){1.0}));
    ConstantTap high = {.tap = {tap_constant}, .word = 18446744073709551615ULL};
    test::check(random::bernoulli_sample(tapped(&high), (random::Bernoulli){0.5}));
}
