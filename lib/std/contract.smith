// smith-build: link
// std::contract, <smith/contract.h>: contracts written as calls. Its C API is the generated header
// include/smith/contract.h (a build output, not in git). Every export has a short name here and a
// C name (the attribute before it): `contract::requires` is `smith_requires`. The comments above an export are the
// header's doc comments, so they name the Smith names; the first one says how a C name follows from them.
module std::contract;

import target;
import <smith/trace.h>;

// <smith/contract.h>: contracts written as calls. Each is a check that stops the program when its condition is false,
// as an assert does, and `smith prove` proves the same statements on LLVM IR. In a .smith file:
//
//   export I32 clamp(I32 x, I32 low, I32 high) {
//       contract::requires(low <= high);                     // the caller's job
//       I32 result = x < low ? low : x > high ? high : x;
//       contract::ensures(low <= result && result <= high);  // this function's promise
//       return result;
//   }
//
//   for (U8 square = 0; square < squares; square++) {
//       contract::invariant(moves->len <= 2 * square);       // the first statement of a loop body
//       ...
//   }
//
// C calls them smith_requires, smith_ensures, smith_invariant, smith_assert and smith_trusted; a C name that was a
// macro (`assert`) would clash with C's, so the assert is smith_assert.
//
// contract::requires(c)   the start of a function: a caller must make c true.
// contract::ensures(c)    just before a `return`: the function makes c true. An old value is a `const` local saved at
//                         the top, and the result is the variable about to be returned.
// contract::invariant(c)  the first statement of a loop body: c is true on every pass.
// contract::assert(c)     anywhere in a body: c is true here. It is the statement `assert` was, as a function, and
//                         `smith prove` proves it the same way.
// contract::trusted()     the first statement of a function at the program's edge (io, inline assembly, a library with
//                         no source): `smith prove` does not prove it. Its requires is proved at each call and its
//                         ensures assumed, as for any function with a contract, but nothing in its body is read, and
//                         the report lists it as trusted, never as proved. It checks nothing at run time.
// contract::modifies(&x, xs, ...)  the start of a function, after its requires: the function writes nothing but the
//                         objects named (and its own locals), and a caller keeps everything else it knew across the
//                         call. Each argument is a pointer to one object (`&moves->jumps`: the size is the pointee's)
//                         or a slice, a range (`xs`, `p[a:b]`: its count times the element's size). With no argument
//                         the function writes nothing outside its locals. A function with no modifies may write
//                         whatever its pointer parameters reach. C: smith_modifies(p, size), one call for each range.
//
// Checks run in every build: debug, release and fast, NDEBUG or not (owner, 2026-10-25). Only `smith prove` removes
// one. A condition must be free of side effects: the check evaluates it.
//
// They are functions of the header that always inline. Each is one call of a function of the library (build.c:
// smith_library(b, "contract")), at every optimization level, since that function is external and the optimizer cannot
// see into it, which is how `smith prove` finds the contracts in the IR without a flag:
//   void smith_contract_requires(bool condition);
//   void smith_contract_ensures(bool condition);
//   void smith_contract_invariant(bool condition);
//   void smith_contract_assert(bool condition);
//   void smith_contract_trusted();
//   void smith_contract_may_write(const void *p, size_t size);
// A failed check is smith_failure(kind) (<smith/trace.h>): it records the stack and writes `smith-trace begin requires
// failed` and the frames to standard error, then calls abort(); in a test it fails the test with the same report as a
// failed check, the failing line and the call chain. Where and what come from the stack and the source line, not from
// the library, which links with the trace library (smith_library(b, "trace")).
//
// clang's static analyzer (clang-tidy's clang-analyzer-*, `smith lint`) cannot see what a call means, so without help
// it reports every index a contract bounds. Under target::static_analyzer (true only there) each is an assumption, as
// the failure path of `assert` is for it, and nothing else changes: a compile, `smith prove` and the checks are as
// above.
[[std::c_name("smith_contract_requires")]] export [[clang::annotate("smith_compile_check")]] void
check_requires(Bool condition) {
    if (!condition) c::smith_failure(c::SmithFailure_Requires);
}

[[std::c_name("smith_contract_ensures")]] export [[clang::annotate("smith_compile_check")]] void
check_ensures(Bool condition) {
    if (!condition) c::smith_failure(c::SmithFailure_Ensures);
}

[[std::c_name("smith_contract_invariant")]] export [[clang::annotate("smith_compile_check")]] void
check_invariant(Bool condition) {
    if (!condition) c::smith_failure(c::SmithFailure_Invariant);
}

[[std::c_name("smith_contract_assert")]] export [[clang::annotate("smith_compile_check")]] void
check_assert(Bool condition) {
    if (!condition) c::smith_failure(c::SmithFailure_Assert);
}

// What an optimized build writes in place of `ensures`, `invariant` and `assert` when `smith prove` proved the check
// holds (issue #325, `.smith/proved/<source>.pts`): the lowering names it where the call stood, never you. It checks
// nothing and has no effect, so a function whose only failure point was that check does not `fail`.
[[std::c_name("smith_proved")]] export [[gnu::always_inline, maybe_unused]] inline void proved(Bool condition) {
    (void)condition;
}

// What a debug build (or any build that keeps its checks) writes in place of `ensures`, `invariant` and `assert` that
// `smith prove` proved (issue #325): the check stays as a safety net, but the proof says it cannot fail, so it is not a
// failure point and a `fails` ceiling gives the same verdict as in an optimized build. The lowering names these where
// the call stood, never you.
// (declared here too, since the smith that builds this one reads the <smith/trace.h> it embeds: the lag rule; these
// are not inline, so the generated header, which that trace.h serves, needs no declaration)
[[noreturn]] extern void smith_failure_proved(c::SmithFailureKind kind);

[[std::c_name("smith_contract_proved_ensures")]] export void kept_ensures(Bool condition) {
    if (!condition) smith_failure_proved(c::SmithFailure_Ensures);
}

[[std::c_name("smith_contract_proved_invariant")]] export void kept_invariant(Bool condition) {
    if (!condition) smith_failure_proved(c::SmithFailure_Invariant);
}

[[std::c_name("smith_contract_proved_assert")]] export void kept_assert(Bool condition) {
    if (!condition) smith_failure_proved(c::SmithFailure_Assert);
}

// A marker for `smith prove`, which reads the call in the IR: a trusted function is assumed, not proved. It checks
// nothing, at run time or anywhere else.
[[std::c_name("smith_contract_trusted")]] export void check_trusted() {}

[[std::c_name("smith_requires")]] export [[gnu::always_inline, maybe_unused]] inline void requires(Bool condition) {
    if constexpr (target::static_analyzer) {
        __builtin_assume(condition);
    } else {
        check_requires(condition);
    }
}

[[std::c_name("smith_ensures")]] export [[gnu::always_inline, maybe_unused]] inline void ensures(Bool condition) {
    if constexpr (target::static_analyzer) {
        __builtin_assume(condition);
    } else {
        check_ensures(condition);
    }
}

[[std::c_name("smith_invariant")]] export [[gnu::always_inline, maybe_unused]] inline void invariant(Bool condition) {
    if constexpr (target::static_analyzer) {
        __builtin_assume(condition);
    } else {
        check_invariant(condition);
    }
}

[[std::c_name("smith_assert")]] export [[gnu::always_inline, maybe_unused]] inline void assert(Bool condition) {
    if constexpr (target::static_analyzer) {
        __builtin_assume(condition);
    } else {
        check_assert(condition);
    }
}

[[std::c_name("smith_trusted")]] export [[gnu::always_inline, maybe_unused]] inline void trusted() {
    if constexpr (!target::static_analyzer) {
        check_trusted();
    }
}

// A marker for `smith prove`, which reads the call in the IR: the range [p, p + size) is one the function may write. It
// checks nothing at run time. (With no range at all, `modifies()` is one call with size 0.)
[[std::c_name("smith_contract_may_write")]] export void check_modifies(const void *p, Usize size) {
    (void)p;
    (void)size;
}

[[std::c_name("smith_modifies")]] export [[gnu::always_inline, maybe_unused]] inline void modifies_range(const void *p,
                                                                                                         Usize size) {
    if constexpr (target::static_analyzer) {
        (void)p;
        (void)size;
    } else {
        check_modifies(p, size);
    }
}

// One slice of `modifies`: its range is the count times the element's size, none for an empty one.
inline void modifies_slice(auto xs) {
    modifies_range(countof(xs) ? &xs[0] : nullptr, countof(xs) * sizeof(xs[0]));
}

export inline void modifies(auto... rest) {
    modifies_range(nullptr, 0); // the marker `modifies()` is: a range of no bytes
    for constexpr (Usize i = 0; i < countof(rest); i++) {
        if constexpr (is_pointer(typeof(rest[i]))) {
            modifies_range(rest[i], sizeof(*rest[i]));
        } else if constexpr (is_slice(typeof(rest[i]))) {
            modifies_slice(rest[i]);
        } else {
            static_assert(false,
                          "contract::modifies takes &x (a pointer to one object) or a slice xs, p[a:b] (a range)");
        }
    }
}
