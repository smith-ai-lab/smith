// smith-build: link
// std::env, <smith/env.h>: the environment of the process, read through the environment handler of the thread
// (include/smith/handlers.h), so a test can stand in for it. Called directly, with no capability value to pass:
//
//   env::Value home = env::get("HOME");
//   if (home == .some) { ... home.some ... }
//
// Its C API is the generated header include/smith/env.h (committed; `smith build headers` regenerates it); the names
// follow the rule of arena.smith: `env::get` is `smith_env_get`.
module std::env;

import std::contract;
import <smith/handlers.h>; // SmithEnvHandler, smith_handlers_set_env
import <stdlib.h>;         // getenv: the function the handler of the thread answers
import <string.h>;

// The value of a variable: its characters, which the environment owns.
export typedef typeof(const char[:]) Text;
export typedef option(Text) Value;

// The environment handler of the thread (include/smith/handlers.h): `get` answers a name with its value or null.
[[std::c_name("SmithEnvHandler")]] export typedef c::SmithEnvHandler Handler;

// The longest name `get` reads: a name is a few letters, and a longer one is a bug.
export constexpr usize name_max = 1023;

// Sets the environment of the calling thread (null: the process's) and returns the one it had, as signal() does.
// Restore it with `defer`:
//   env::Handler *before = env::set_handler(&fake.base);
//   defer env::set_handler(before);
[[std::c_name("smith_env_set_handler")]] export Handler *set_handler(Handler *handler) {
    return c::smith_handlers_set_env(handler);
}

// The value of the variable `name`, or `.none` when it is not set. An empty value is `.some` of an empty slice. The
// text belongs to the environment: it stays valid until the variable changes, and it is never freed. A name that is
// empty, holds `=` or a NUL, or is longer than `env::name_max` is a bug: a checked failure.
[[std::c_name("smith_env_get")]] export [[nodiscard]] Value get(const char name[:]) {
    contract::trusted(); // a call into the system, the edge a proof cannot read; its callers prove what it requires
    contract::requires(countof(name) > 0 && countof(name) <= name_max);
    char terminated[name_max + 1];
    for (usize i = 0; i < countof(name); i++) {
        contract::requires(name[i] != '=' && name[i] != 0);
        terminated[i] = name[i];
    }
    terminated[countof(name)] = 0;
    const char *value = c::getenv(terminated); // NOLINT(smith-effects): the edge, as the handler answers it
    if (value == nullptr) return .none;
    return {.some = value[0:c::strlen(value)]};
}
