// smith-build: link
// std::env, <smith/env.h>: the environment of the process, read through the environment handler of the thread
// (include/smith/handlers.h), so a test can stand in for it. Called directly, with no capability value to pass:
//
//   env::Value home = env::get("HOME");
//   if (home == .some) { ... home.some ... }
//
// and writes it with env::set and env::remove, which a test fakes the same way.
//
// Its C API is the generated header include/smith/env.h (committed; `smith build headers` regenerates it); the names
// follow the rule of arena.smith: `env::get` is `smith_env_get`.
module std::env;

import std::contract;
import <smith/handlers.h>; // SmithEnvHandler, smith_handlers_set_env
import <stdlib.h>;         // getenv: the function the handler of the thread answers
import <string.h>;

// The value of a variable: its characters, which the environment owns.
export typedef typeof(const char[:]) Text;
export typedef Option(Text) Value;

// The environment handler of the thread (include/smith/handlers.h): `get` answers a name with its value or null.
[[std::c_name("SmithEnvHandler")]] export typedef c::SmithEnvHandler Handler;

// The longest name `get` reads: a name is a few letters, and a longer one is a bug.
export constexpr Usize name_max = 1023;

// Sets the environment of the calling thread (null: the process's) and returns the one it had, as signal() does.
// Restore it with `defer`:
//   env::Handler *before = env::set_handler(&fake.base);
//   defer env::set_handler(before);
[[std::c_name("smith_env_set_handler")]] export Handler *set_handler(Handler *handler) {
    return c::smith_handlers_set_env(handler);
}

// The value of the variable `name`, or `.none` when it is not set. An empty value is `.some` of an empty slice. The
// text belongs to the environment: it stays valid until the variable changes, and it is never freed. A name that is
// empty, holds `=` or a NUL, or is longer than `env::name_max` is a bug: a checked failure.
[[std::c_name("smith_env_get")]] export [[nodiscard]] Value get(const char name[:]) {
    contract::trusted(); // a call into the system, the edge a proof cannot read; its callers prove what it requires
    contract::requires(countof(name) > 0 && countof(name) <= name_max);
    char terminated[name_max + 1];
    for (Usize i = 0; i < countof(name); i++) {
        contract::requires(name[i] != '=' && name[i] != 0);
        terminated[i] = name[i];
    }
    terminated[countof(name)] = 0;
    const char *value = c::getenv(terminated); // NOLINT(smith-effects): the edge, as the handler answers it
    if (value == nullptr) return .none;
    return {.some = value[0:c::strlen(value)]};
}

// Why `set` or `remove` did not change the environment.
// NOLINTBEGIN(readability-identifier-naming)
[[std::c_name("SmithEnvError")]] export typedef enum {
    BadName, // the name is empty, holds `=` or a NUL, or is longer than `env::name_max`
    NoSpace, // the system has no memory for the variable
    Other,   // the system, or the handler, refused
} Error;
// NOLINTEND(readability-identifier-naming)

export typedef Option(Error) Done;

constexpr I32 out_of_memory =
    12; // ENOMEM on Linux and macOS; <errno.h> stays out of this header (files.smith's `errno`)

Done done_from(I32 code) {
    if (code == 0) return .none;
    if (code == out_of_memory) return {.some = NoSpace};
    return {.some = Other};
}

Bool name_ok(const char name[:]) {
    if (countof(name) == 0 || countof(name) > name_max) return false;
    for (Usize i = 0; i < countof(name); i++)
        if (name[i] == '=' || name[i] == 0) return false;
    return true;
}

// Sets the variable `name` to `value` (an empty value is allowed; an old value is replaced) in the environment of
// the thread: its handler's `set`, or the process's. `.none` on success, `.some` of the reason otherwise. A bad
// name is `BadName`, not a bug. The value may hold anything but a NUL (a NUL is `BadName` too).
[[std::c_name("smith_env_set")]] export Done set(const char name[:], const char value[:]) {
    contract::trusted(); // a call into the system, the edge a proof cannot read
    if (!name_ok(name) || countof(value) > name_max * 64) return {.some = BadName};
    char terminated_name[name_max + 1];
    for (Usize i = 0; i < countof(name); i++)
        terminated_name[i] = name[i];
    terminated_name[countof(name)] = 0;
    char terminated_value[name_max * 64 + 1];
    for (Usize i = 0; i < countof(value); i++) {
        if (value[i] == 0) return {.some = BadName};
        terminated_value[i] = value[i];
    }
    terminated_value[countof(value)] = 0;
    Handler *handler = c::smith_handlers_env();
    if (handler == nullptr)
        return done_from(c::setenv(terminated_name, terminated_value, 1) == 0 ? 0
                                                                              : -1); // NOLINT(smith-effects): the edge
    if (handler->set == nullptr) return done_from(-1);
    return done_from(handler->set(handler, terminated_name, terminated_value));
}

// Removes the variable `name` from the environment of the thread. Removing one that is not set succeeds. `.none` on
// success, `.some` of the reason otherwise.
[[std::c_name("smith_env_remove")]] export Done remove(const char name[:]) {
    contract::trusted(); // a call into the system, the edge a proof cannot read
    if (!name_ok(name)) return {.some = BadName};
    char terminated[name_max + 1];
    for (Usize i = 0; i < countof(name); i++)
        terminated[i] = name[i];
    terminated[countof(name)] = 0;
    Handler *handler = c::smith_handlers_env();
    if (handler == nullptr) return done_from(c::unsetenv(terminated) == 0 ? 0 : -1); // NOLINT(smith-effects): the edge
    if (handler->remove == nullptr) return done_from(-1);
    return done_from(handler->remove(handler, terminated));
}
