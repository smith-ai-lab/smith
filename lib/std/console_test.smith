// Tests of std::console, with a fake console set on the thread: it captures what a function prints and answers what
// it reads, as a test of a program's output does. A checked failure (a read into no room) stops the process and is not
// a test here.
module std::console_test;

import <errno.h>; // first: std::test's header includes it, and then `errno` in this line is the macro
import std::console;
import std::mem;
import std::test;
import target;
import <string.h>;

constexpr usize capacity = 16384;

typedef struct {
    console::Handler base; // first: &fake.base is what set_handler takes
    char out[capacity];
    usize out_size;
    char err[capacity];
    usize err_size;
    const char *input;
    usize input_size;
    usize input_position;
    i32 fail_with; // not 0: every write fails with this errno
} Fake;

// NOLINTBEGIN(smith-preprocessor, bugprone-signed-bitwise)
constexpr i32 epipe = c::EPIPE;
constexpr i32 enospc = c::ENOSPC;
constexpr i32 eio = c::EIO;
// NOLINTEND(smith-preprocessor, bugprone-signed-bitwise)

void set_errno(i32 code) {
    if constexpr (target::os == target::macos) {
        *c::__error() = code;
    } else {
        *c::__errno_location() = code;
    }
}

isize fake_write(console::Handler *self, i32 fd, const void *buffer, usize size) {
    Fake *fake = (Fake *)self;
    if (fake->fail_with != 0) {
        set_errno(fake->fail_with);
        return -1;
    }
    char *to = fd == 1 ? fake->out : fake->err;
    usize *used = fd == 1 ? &fake->out_size : &fake->err_size;
    test::check_condition(*used + size < capacity);
    u8 *destination = (u8 *)to + *used;
    const u8 *source = (const u8 *)buffer;
    mem::copy(destination[0:size], source[0:size]);
    *used += size;
    to[*used] = 0;
    return (isize)size;
}

isize fake_read(console::Handler *self, void *buffer, usize size) {
    Fake *fake = (Fake *)self;
    usize left = fake->input_size - fake->input_position;
    usize n = left < size ? left : size;
    u8 *destination = (u8 *)buffer;
    const u8 *source = (const u8 *)fake->input + fake->input_position;
    mem::copy(destination[0:n], source[0:n]);
    fake->input_position += n;
    return (isize)n;
}

Fake make_fake(const char *input) {
    Fake fake = {};
    fake.base.write = fake_write;
    fake.base.read = fake_read;
    fake.input = input;
    fake.input_size = c::strlen(input);
    return fake;
}

bool succeeded(console::Written written) {
    return written == .ok;
}

bool is_error(console::Written written, console::Error error) {
    return written == .error && written.error == error;
}

export void test_console_print_writes_its_typed_pieces_to_stdout() {
    Fake fake = make_fake("");
    console::Handler *before = console::set_handler(&fake.base);
    defer console::set_handler(before);
    test::check_condition(succeeded(console::print("x = ", 42, " y = ", true, "\n")));
    test::check_condition(c::strcmp(fake.out, "x = 42 y = true\n") == 0);
    test::check_equal(fake.err_size, 0);
}

export void test_console_print_error_writes_to_stderr() {
    Fake fake = make_fake("");
    console::Handler *before = console::set_handler(&fake.base);
    defer console::set_handler(before);
    test::check_condition(succeeded(console::print_error("bad: ", 7, "\n")));
    test::check_condition(c::strcmp(fake.err, "bad: 7\n") == 0);
    test::check_equal(fake.out_size, 0);
}

export void test_console_print_has_no_4_kib_limit() {
    static char big[10001];
    for (usize i = 0; i < 10000; i++) {
        big[i] = (char)('a' + i % 26);
    }
    Fake fake = make_fake("");
    console::Handler *before = console::set_handler(&fake.base);
    defer console::set_handler(before);
    test::check_condition(succeeded(console::print("[", (const char *)big, "]")));
    test::check_equal(fake.out_size, 10002);
    test::check_condition(fake.out[0] == '[' && fake.out[1] == 'a' && fake.out[10001] == ']');
}

export void test_console_write_takes_bytes_and_repeats_calls_in_order() {
    Fake fake = make_fake("");
    console::Handler *before = console::set_handler(&fake.base);
    defer console::set_handler(before);
    u8 bytes[3] = {'o', 'n', 'e'};
    test::check_condition(succeeded(console::write(bytes[0:3])));
    test::check_condition(succeeded(console::write_error(bytes[0:2])));
    test::check_condition(succeeded(console::write(bytes[0:0]))); // nothing is a write that succeeds
    test::check_condition(c::strcmp(fake.out, "one") == 0);
    test::check_condition(c::strcmp(fake.err, "on") == 0);
}

export void test_console_a_failing_stream_is_a_value_not_a_failure() {
    Fake fake = make_fake("");
    console::Handler *before = console::set_handler(&fake.base);
    defer console::set_handler(before);
    fake.fail_with = epipe;
    test::check_condition(is_error(console::print("x"), console::Closed));
    fake.fail_with = enospc;
    test::check_condition(is_error(console::print("x"), console::Full));
    fake.fail_with = eio;
    test::check_condition(is_error(console::print_error("x"), console::Failed));
}

export void test_console_read_answers_what_is_available_then_zero_at_the_end() {
    Fake fake = make_fake("abc");
    console::Handler *before = console::set_handler(&fake.base);
    defer console::set_handler(before);
    u8 buffer[2] = {};
    console::Count first = console::read(buffer[0:2]);
    test::check_condition(first == .ok && first.ok == 2 && buffer[0] == 'a' && buffer[1] == 'b');
    console::Count second = console::read(buffer[0:2]);
    test::check_condition(second == .ok && second.ok == 1 && buffer[0] == 'c');
    console::Count third = console::read(buffer[0:2]);
    test::check_condition(third == .ok && third.ok == 0);
}

// The line read, copied: the text is the caller's to free, so a test frees it.
bool line_is(console::LineResult result, const char *expected, bool end) {
    if (result != .ok) return false;
    console::Line line = result.ok;
    bool same = countof(line.text) == c::strlen(expected) && c::strcmp(line.text.data, expected) == 0;
    mem::free(line.text.data);
    return same && line.end == end;
}

// The length of the line read, which is then given back; 0 for an error.
usize line_length(console::LineResult result) {
    if (result != .ok) return 0;
    usize length = countof(result.ok.text);
    mem::free(result.ok.text.data);
    return length;
}

export void test_console_read_line_splits_lines_and_marks_the_end() {
    Fake fake = make_fake("one\ntwo\n\nlast");
    console::Handler *before = console::set_handler(&fake.base);
    defer console::set_handler(before);
    test::check_condition(line_is(console::read_line(), "one", false));
    test::check_condition(line_is(console::read_line(), "two", false));
    test::check_condition(line_is(console::read_line(), "", false));
    test::check_condition(line_is(console::read_line(), "last", false)); // no newline at the end
    test::check_condition(line_is(console::read_line(), "", true));
}

export void test_console_read_line_grows_for_a_long_line() {
    static char input[1001];
    for (usize i = 0; i < 1000; i++) {
        input[i] = 'z';
    }
    Fake fake = make_fake(input);
    console::Handler *before = console::set_handler(&fake.base);
    defer console::set_handler(before);
    test::check_equal(line_length(console::read_line()), 1000);
}

export void test_console_set_handler_returns_the_previous_one() {
    Fake outer = make_fake("");
    Fake inner = make_fake("");
    console::Handler *none = console::set_handler(&outer.base);
    test::check_condition(none == nullptr);
    console::Handler *back = console::set_handler(&inner.base);
    test::check_condition(back == &outer.base);
    test::check_condition(succeeded(console::print("in")));
    console::set_handler(back);
    test::check_condition(succeeded(console::print("out")));
    console::set_handler(none);
    test::check_condition(c::strcmp(inner.out, "in") == 0);
    test::check_condition(c::strcmp(outer.out, "out") == 0);
}
