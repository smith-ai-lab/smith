// Tests of std::process, in smith's own test library (build.c's `test-units` runner links them with the module): the
// calls over the fake process handler, which a test sets and restores with `defer`, and a few over real programs
// (/bin/sh, cat). The memory a call returns is the current allocator's, so each test installs an arena first (a test
// runs under mem::checked, which fails a block that is not freed). The checked failures (a double close, a wait twice,
// a fake that would wait for ever) stop the process and are not tested here.
module std::process_test;

import std::arena;
import std::mem;
import std::process;
import std::test;

// Unwrapping for the checks: the value of a result (a zero when it is an error: the test checked `== .ok` before) and
// the error (a zero when it is a value).
process::Child value_child(process::ChildResult r) {
    switch (r) {
    case .ok:
        return r.ok;
    case .error:
        return (process::Child){};
    }
}

process::Output value_output(process::OutputResult r) {
    switch (r) {
    case .ok:
        return r.ok;
    case .error:
        return (process::Output){};
    }
}

process::Exit value_exit(process::ExitResult r) {
    switch (r) {
    case .ok:
        return r.ok;
    case .error:
        return (process::Exit){.status = -1, .signal = -1};
    }
}

Usize value_count(process::CountResult r) {
    switch (r) {
    case .ok:
        return r.ok;
    case .error:
        return ~(Usize)0;
    }
}

process::Error failure_output(process::OutputResult r) {
    switch (r) {
    case .ok:
        return process::Other;
    case .error:
        return r.error;
    }
}

process::Error failure_child(process::ChildResult r) {
    switch (r) {
    case .ok:
        return process::Other;
    case .error:
        return r.error;
    }
}

// Whether the bytes are the text.
bool is_text(process::Bytes got, const char *text) {
    Usize length = __builtin_strlen(text);
    if (countof(got) != length) return false;
    for (Usize i = 0; i < length; i++) {
        if (got[i] != (U8)text[i]) return false;
    }
    return true;
}

const U8 *bytes_of(const char *text) {
    return (const U8 *)text;
}

// Reads a piped child's stdout to its end.
Usize read_all(process::Child *child, U8 buffer[:]) {
    Usize filled = 0;
    for (Usize rounds = 0; rounds < 64; rounds++) { // a test's child writes a few pieces
        U8 room[:] = buffer[filled:];
        process::CountResult step = process::read(child, room);
        Usize count = value_count(step);
        if (step == .error || count == 0) break;
        filled += count;
    }
    return filled;
}

export void test_process_run_captures_both_streams_and_the_status_of_a_scripted_program() {
    arena::Arena a = test::memory(1 << 16);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    process::Fake fake = process::fake();
    process::fake_add(
        &fake, (process::Script){.program = "build", .output = "compiled\n", .errors = "warning\n", .status = 3});
    process::Handler *before = process::set_handler(&fake.base);
    defer process::set_handler(before);

    const char *const argv[_] = {"build", "--fast"};
    process::OutputResult done = process::run(argv[0:2]);
    test::check_condition(done == .ok);
    process::Output result = value_output(done);
    test::check_equal(result.exit.status, 3);
    test::check_equal(result.exit.signal, 0);
    test::check_condition(is_text(result.output, "compiled\n"));
    test::check_condition(is_text(result.errors, "warning\n"));
    test::check_condition(allocator.base.owns(&allocator.base, result.output.data));
}

export void test_process_a_program_with_no_script_is_not_found() {
    process::Fake fake = process::fake();
    process::Handler *before = process::set_handler(&fake.base);
    defer process::set_handler(before);

    const char *const argv[_] = {"nothing"};
    process::OutputResult ran = process::run(argv[0:1]);
    test::check_condition(ran == .error);
    test::check_condition(failure_output(ran) == process::NotFound);
    process::ChildResult spawned = process::spawn(argv[0:1]);
    test::check_condition(spawned == .error);
    test::check_condition(failure_child(spawned) == process::NotFound);
}

export void test_process_two_children_of_one_program_use_two_scripts() {
    arena::Arena a = test::memory(1 << 16);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    process::Fake fake = process::fake();
    process::fake_add(&fake, (process::Script){.program = "job", .output = "first"});
    process::fake_add(&fake, (process::Script){.program = "job", .output = "second", .status = 1});
    process::Handler *before = process::set_handler(&fake.base);
    defer process::set_handler(before);

    const char *const argv[_] = {"job"};
    process::Output one = value_output(process::run(argv[0:1]));
    process::Output two = value_output(process::run(argv[0:1]));
    test::check_condition(is_text(one.output, "first"));
    test::check_condition(is_text(two.output, "second"));
    test::check_equal(two.exit.status, 1);
    process::OutputResult third = process::run(argv[0:1]); // no third script
    test::check_condition(third == .error);
}

export void test_process_a_started_child_reads_what_it_is_written_until_its_input_is_closed() {
    arena::Arena a = test::memory(1 << 16);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    process::Fake fake = process::fake();
    process::fake_add(&fake, (process::Script){.program = "cat", .output = "hello", .exit_on = process::InputClosed});
    process::Handler *before = process::set_handler(&fake.base);
    defer process::set_handler(before);

    const char *const argv[_] = {"cat"};
    process::ChildResult started = process::start(argv[0:1]);
    test::check_condition(started == .ok);
    process::Child child = value_child(started);
    process::CountResult sent = process::write(&child, bytes_of("hi there")[0:8]);
    test::check_equal(value_count(sent), 8);
    process::close_input(&child);
    process::close_input(&child); // a second close of the input does nothing
    U8 buffer[:] = mem::alloc_slice(U8, 16);
    Usize got = read_all(&child, buffer);
    test::check_condition(is_text(buffer[0:got], "hello"));
    process::ExitResult ended = process::wait(&child);
    test::check_condition(ended == .ok);
    test::check_equal(value_exit(ended).status, 0);
    process::close(&child);
    test::check_condition(is_text(process::fake_input(&fake, 0), "hi there"));
}

export void test_process_a_child_that_has_exited_takes_no_more_input() {
    arena::Arena a = test::memory(1 << 16);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    process::Fake fake = process::fake();
    process::fake_add(&fake, (process::Script){.program = "true", .exit_on = process::Start});
    process::Handler *before = process::set_handler(&fake.base);
    defer process::set_handler(before);

    const char *const argv[_] = {"true"};
    process::Child child = value_child(process::start(argv[0:1]));
    process::CountResult sent = process::write(&child, bytes_of("x")[0:1]);
    test::check_condition(sent == .error && sent.error == process::Broken);
    process::close(&child);
}

export void test_process_reads_come_in_pieces_of_the_scripted_size() {
    arena::Arena a = test::memory(1 << 16);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    process::Fake fake = process::fake();
    process::fake_add(
        &fake, (process::Script){.program = "emit", .output = "abcdefg", .chunk = 3, .exit_on = process::OutputRead});
    process::Handler *before = process::set_handler(&fake.base);
    defer process::set_handler(before);

    const char *const argv[_] = {"emit"};
    process::Child child = value_child(process::start(argv[0:1]));
    U8 buffer[:] = mem::alloc_slice(U8, 16);
    process::CountResult first = process::read(&child, buffer);
    test::check_equal(value_count(first), 3);
    Usize rest = read_all(&child, buffer[3:]);
    test::check_equal(rest, 4);
    test::check_condition(is_text(buffer[0:7], "abcdefg"));
    test::check_equal(value_exit(process::wait(&child)).status, 0);
    process::close(&child);
}

export void test_process_kill_ends_a_child_that_would_not_end_and_a_second_kill_is_gone() {
    arena::Arena a = test::memory(1 << 16);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    process::Fake fake = process::fake();
    process::fake_add(&fake, (process::Script){.program = "server", .exit_on = process::Never});
    process::Handler *before = process::set_handler(&fake.base);
    defer process::set_handler(before);

    const char *const argv[_] = {"server"};
    process::Child child = value_child(process::start(argv[0:1]));
    process::DoneResult killed = process::kill(&child, 9);
    test::check_condition(killed == .ok);
    process::DoneResult again = process::kill(&child, 9);
    test::check_condition(again == .error && again.error == process::Gone);
    process::Exit ended = value_exit(process::wait(&child));
    test::check_equal(ended.signal, 9);
    test::check_equal(ended.status, 0);
    process::DoneResult late = process::kill(&child, 9);
    test::check_condition(late == .error && late.error == process::Gone);
    process::close(&child);
}

export void test_process_cores_are_the_fakes_and_then_the_machines() {
    process::Fake fake = process::fake();
    process::Handler *before = process::set_handler(&fake.base);
    test::check_equal(process::cores(), 1);
    process::fake_set_cores(&fake, 6);
    test::check_equal(process::cores(), 6);
    process::set_handler(before);
    test::check_condition(process::cores() >= 1);
}

export void test_process_the_handler_setter_returns_the_one_before_it() {
    process::Fake one = process::fake();
    process::Fake two = process::fake();
    process::Handler *outside = process::set_handler(&one.base);
    test::check_condition(process::current_handler() == &one.base);
    process::Handler *middle = process::set_handler(&two.base);
    test::check_condition(middle == &one.base);
    test::check_condition(process::set_handler(outside) == &two.base);
    test::check_condition(process::current_handler() == outside);
}

export void test_process_run_of_a_real_program_captures_its_streams_and_status() {
    arena::Arena a = test::memory(1 << 16);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);

    const char *const argv[_] = {"/bin/sh", "-c", "printf out; printf err >&2; exit 3"};
    process::OutputResult done = process::run(argv[0:3]);
    test::check_condition(done == .ok);
    process::Output result = value_output(done);
    test::check_equal(result.exit.status, 3);
    test::check_condition(is_text(result.output, "out"));
    test::check_condition(is_text(result.errors, "err"));

    const char *const missing[_] = {"/nonexistent/program"};
    process::OutputResult none = process::run(missing[0:1]);
    test::check_condition(none == .error);
    test::check_condition(failure_output(none) == process::NotFound);
}

export void test_process_a_real_child_with_pipes_echoes_what_it_is_written() {
    arena::Arena a = test::memory(1 << 16);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);

    const char *const argv[_] = {"cat"};
    process::ChildResult started = process::start(argv[0:1]);
    test::check_condition(started == .ok);
    process::Child child = value_child(started);
    test::check_equal(value_count(process::write(&child, bytes_of("ping")[0:4])), 4);
    process::close_input(&child);
    U8 buffer[:] = mem::alloc_slice(U8, 16);
    Usize got = read_all(&child, buffer);
    test::check_condition(is_text(buffer[0:got], "ping"));
    test::check_equal(value_exit(process::wait(&child)).status, 0);
    process::close(&child);
}

export void test_process_a_real_spawned_child_is_waited_for_and_a_kill_after_it_is_gone() {
    const char *const argv[_] = {"/bin/sh", "-c", "exit 7"};
    process::ChildResult started = process::spawn(argv[0:3]);
    test::check_condition(started == .ok);
    process::Child child = value_child(started);
    test::check_equal(value_exit(process::wait(&child)).status, 7);
    process::DoneResult late = process::kill(&child, 15);
    test::check_condition(late == .error && late.error == process::Gone);
    process::close(&child);
}
