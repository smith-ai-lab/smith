// smith-build: link
// std::files, <smith/files.h>: files and folders by direct calls, with no capability value to pass: open, read, write
// and close a file, read or write a whole one, ask about a path, list a folder, make, remove and rename, map a file.
// Its C API is the generated header include/smith/files.h (committed; `smith build headers` regenerates it); the names
// follow the rule of arena.smith with one difference: the functions are `smith_fs_*` (`files::read_file` is
// `smith_fs_read_file`) (the types are `SmithFiles*`).
//
// Every call goes through the files handler of the calling thread (include/smith/handlers.h): none set is the real
// file system, and `files::fake()` is an in-memory one a test sets with `files::set_handler`, so the code under test
// runs unchanged. The open, read, write and close of a descriptor reach the handler as libc's functions do (the
// runtime interposes them); the other members of the handler (stat, mkdir, remove, rename, list, map, unmap) are called
// here, and a null member is libc's own call.
//
// What goes wrong in the world is a value: a call returns `Result(T, files::Error)` and the error is one of the
// real conditions (not found, exists, denied...). What is a bug is a checked failure that names the call: a mode a
// call does not take, a descriptor that is not open (files owns its descriptors, so a read, write or close of one that
// is not open is a double close or a stray number) and a limit of the fake. Memory a call returns (the bytes of a
// whole file, the entries of a folder) comes from the current allocator (std::mem) and belongs to the caller's
// region: it is never freed one object at a time (#439). Issue #240; knowledge/files.md.
module std::files;

import std::arena;
import std::contract;
import std::env;
import std::mem;
import target;
import <dirent.h>;
import <errno.h>;
import <fcntl.h>;
import <limits.h>;
import <smith/handlers.h>;
import <smith/trace.h>;
import <stdio.h>;
import <stdlib.h>;
import <string.h>;
import <sys/mman.h>;
import <sys/stat.h>;
import <unistd.h>;

// The files capability's own module: its calls into the system are the edge, as std::mem's are.
// NOLINTBEGIN(smith-effects)

// The platform's numbers. A C macro is the preprocessor's, and a .smith file has none: each is read once, here.
// NOLINTBEGIN(smith-preprocessor, bugprone-signed-bitwise)
constexpr I32 ebadf = c::EBADF;
constexpr I32 eexist = c::EEXIST;
constexpr I32 eintr = c::EINTR;
constexpr I32 einval = c::EINVAL;
constexpr I32 eisdir = c::EISDIR;
constexpr I32 emfile = c::EMFILE;
constexpr I32 enametoolong = c::ENAMETOOLONG;
constexpr I32 enfile = c::ENFILE;
constexpr I32 enoent = c::ENOENT;
constexpr I32 enospc = c::ENOSPC;
constexpr I32 enotdir = c::ENOTDIR;
constexpr I32 enotempty = c::ENOTEMPTY;
constexpr I32 eacces = c::EACCES;
constexpr I32 eperm = c::EPERM;
constexpr I32 erofs = c::EROFS;
constexpr I32 access_mask = c::O_ACCMODE;
constexpr I32 open_read = c::O_RDONLY | c::O_CLOEXEC;
constexpr I32 open_replace = c::O_WRONLY | c::O_CREAT | c::O_TRUNC | c::O_CLOEXEC;
constexpr I32 open_append = c::O_WRONLY | c::O_CREAT | c::O_APPEND | c::O_CLOEXEC;
constexpr I32 open_new = c::O_WRONLY | c::O_CREAT | c::O_EXCL | c::O_CLOEXEC;
constexpr I32 flag_write_only = c::O_WRONLY;
constexpr I32 flag_read_write = c::O_RDWR;
constexpr I32 flag_create = c::O_CREAT;
constexpr I32 flag_truncate = c::O_TRUNC;
constexpr I32 flag_append = c::O_APPEND;
constexpr I32 flag_exclusive = c::O_EXCL;
constexpr I32 write_ok = c::W_OK;
constexpr I32 protect_both = c::PROT_READ | c::PROT_WRITE;
constexpr I32 map_file = c::MAP_PRIVATE;
constexpr Usize path_max = c::PATH_MAX;
constexpr U32 mode_kind_mask = 0xF000;
constexpr U32 mode_folder = 0x4000;
// NOLINTEND(smith-preprocessor, bugprone-signed-bitwise)
constexpr I32 folder_mode = 0b111111111; // rwxrwxrwx, before the umask
constexpr I32 file_mode = 0b110100100;   // rw-r--r--, before the umask
constexpr Usize chunk = 4096;
export constexpr Usize fake_files_max = 64;
export constexpr Usize fake_path_max = 256;
export constexpr Usize fake_open_max = 16;
constexpr Usize first_descriptor = 3; // the handlers' files start here (0, 1 and 2 are the console's)

// errno, which is a macro for the system's function.
if constexpr (target::os == target::macos) {
    I32 *errno_slot() {
        return c::__error();
    }
} else {
    I32 *errno_slot() {
        return c::__errno_location();
    }
}

I32 errno_now() {
    return *errno_slot();
}

// NOLINTBEGIN(readability-identifier-naming)
// An enum's constants are written short in a module (files::NotFound, C's SmithFilesError_NotFound), and the check
// wants C's Type_Value.

// What the world refused, as a value. The codes of a bug (a bad descriptor, an invalid argument) are not here: they
// stop the program (see the top of the file).
[[std::c_name("SmithFilesError")]] export typedef enum {
    NotFound,    // nothing is at the path
    Exists,      // something is there already (Mode New, make_folder over a file)
    Denied,      // permissions
    IsFolder,    // the path is a folder and the call wants a file
    NotFolder,   // a part of the path is a file, or the path is a file and the call wants a folder
    NotEmpty,    // the folder to remove has things in it
    NameTooLong, // the path does not fit
    NoSpace,     // the disk is full
    ReadOnly,    // the file system does not take writes
    TooManyOpen, // the process or the system has no more descriptors
    Other,       // the system said something else
} Error;

// How a file is opened, and how write_file puts bytes in a file.
[[std::c_name("SmithFilesMode")]] export typedef enum {
    Read,    // open: an existing file, to read
    Replace, // creates the file or replaces what it held
    Append,  // adds to the end, creating the file if it is not there
    New,     // creates the file only if there is none: Exists otherwise, which is how a program makes a unique name
    Atomic,  // write_file only: the bytes go to "<path>.tmp" and are renamed over the path, so nobody sees half a file
} Mode;
// NOLINTEND(readability-identifier-naming)

// An open file. It is the caller's to close, once.
[[std::c_name("SmithFilesFile")]] export typedef struct {
    I32 descriptor;
} File;

// What a path is.
[[std::c_name("SmithFilesInfo")]] export typedef struct {
    Bool folder;
    Bool writable; // the program may write here: to a file, or make files in a folder
    Usize size;    // bytes of a file; 0 for a folder
} Info;

// One thing in a folder.
[[std::c_name("SmithFilesEntry")]] export typedef struct {
    char name[:]; // the name alone (with a NUL after it, not counted), not the path
    Bool folder;
    Usize size; // bytes of a file; 0 for a folder
} Entry;

// What a call that has nothing to return returns on success.
[[std::c_name("SmithFilesDone")]] export typedef struct {
    U8 unused;
} Done;

export typedef Result(File, Error) OpenResult;
export typedef Result(Usize, Error) CountResult;
export typedef Result(Done, Error) DoneResult;
export typedef Result(Info, Error) InfoResult;
export typedef typeof(U8[:]) Bytes;
export typedef typeof(Entry[:]) Entries;
export typedef Result(Bytes, Error) BytesResult;
export typedef Result(Entries, Error) EntriesResult;
export typedef Option(Error) CloseResult;

// The handler type (the files of include/smith/handlers.h) and its setter, which returns the one the thread had:
//   files::Handler *before = files::set_handler(&fake.base);
//   defer files::set_handler(before);
[[std::c_name("SmithFileHandler")]] export typedef c::SmithFileHandler Handler;

// Sets the files of the calling thread (null: the real file system) and returns the ones it had.
[[std::c_name("smith_fs_set_handler")]] export Handler *set_handler(Handler *handler) {
    return c::smith_handlers_set_files(handler);
}

// The files of the calling thread, null when the real file system is in force.
[[std::c_name("smith_fs_handler")]] export [[nodiscard]] Handler *current_handler() {
    return c::smith_handlers_files();
}

// A bug stops here, in every build, naming the call.
[[noreturn]] void misuse(const char *message) {
    contract::trusted(); // it stops the program
    c::smith_failure_format(c::SmithFailure_Check, "%s", message);
}

// The value of an errno the world can answer. The codes of a bug stop the program.
Error error_from(I32 code) {
    if (code == ebadf) misuse("files: a descriptor that is not open (a double close, or a number files did not give)");
    if (code == einval) misuse("files: an invalid argument (a mode the call does not take)");
    if (code == enoent) return NotFound;
    if (code == eexist) return Exists;
    if (code == eacces || code == eperm) return Denied;
    if (code == eisdir) return IsFolder;
    if (code == enotdir) return NotFolder;
    if (code == enotempty) return NotEmpty;
    if (code == enametoolong) return NameTooLong;
    if (code == enospc) return NoSpace;
    if (code == erofs) return ReadOnly;
    if (code == emfile || code == enfile) return TooManyOpen;
    return Other;
}

// Copies count bytes (the one place bytes behind a pointer become a slice).
void put(void *to, const void *from, Usize count) {
    contract::trusted(); // it makes slices of the two pointers
    if (count == 0) {
        return;
    }
    U8 destination[:] = ((U8 *)to)[0:count];
    const U8 source[:] = ((const U8 *)from)[0:count];
    mem::copy(destination, source);
}

// A path as C wants it, with its NUL.
typedef struct {
    char text[path_max];
    Bool fits;
} Path;

Path path_make(const char path[:]) {
    Path result = {};
    if (countof(path) >= path_max) return result;
    put(result.text, path.data, countof(path));
    result.fits = true;
    return result;
}

// ---------------------------------------------------------------- the operations, real or the handler's

// Each of these returns 0 for success and otherwise the errno, so a caller turns it into an Error once.

I32 raw_stat(const char *path, c::SmithFileStatus *status) {
    c::SmithFileHandler *handler = c::smith_handlers_files();
    if (handler != nullptr && handler->stat != nullptr)
        return handler->stat(handler, path, status) == 0 ? 0 : errno_now();
    struct c::stat info = {};
    if (c::stat(path, &info) != 0) return errno_now();
    status->folder = (info.st_mode & mode_kind_mask) == mode_folder;
    status->size = status->folder ? 0 : (Usize)info.st_size;
    status->writable = c::access(path, write_ok) == 0;
    return 0;
}

I32 raw_mkdir(const char *path) {
    c::SmithFileHandler *handler = c::smith_handlers_files();
    if (handler != nullptr && handler->mkdir != nullptr) return handler->mkdir(handler, path) == 0 ? 0 : errno_now();
    return c::mkdir(path, folder_mode) == 0 ? 0 : errno_now();
}

I32 raw_remove(const char *path) {
    c::SmithFileHandler *handler = c::smith_handlers_files();
    if (handler != nullptr && handler->remove != nullptr) return handler->remove(handler, path) == 0 ? 0 : errno_now();
    return c::unlink(path) == 0 ? 0 : errno_now();
}

I32 raw_rename(const char *from, const char *to) {
    c::SmithFileHandler *handler = c::smith_handlers_files();
    if (handler != nullptr && handler->rename != nullptr)
        return handler->rename(handler, from, to) == 0 ? 0 : errno_now();
    return c::rename(from, to) == 0 ? 0 : errno_now();
}

// The entries of one folder, one at a time: the handler's list or the system's readdir.
typedef struct {
    c::SmithFileHandler *handler;
    c::DIR *directory;
    const char *folder;
    Usize index;
} Lister;

I32 lister_open(Lister *lister, const char *folder) {
    contract::trusted(); // the edge: it asks the handler of the thread and opens the folder
    lister->handler = c::smith_handlers_files();
    lister->folder = folder;
    lister->index = 0;
    lister->directory = nullptr;
    if (lister->handler != nullptr && lister->handler->list != nullptr) {
        c::SmithFileItem probe = {};
        I32 found = lister->handler->list(lister->handler, folder, 0, &probe);
        return found < 0 ? errno_now() : 0;
    }
    lister->handler = nullptr;
    lister->directory = c::opendir(folder);
    return lister->directory == nullptr ? errno_now() : 0;
}

// 1 when item is filled, 0 past the last entry, -1 on an error (the errno is in `code`).
I32 lister_next(Lister *lister, c::SmithFileItem *item, I32 *code) {
    contract::trusted(); // the edge: it calls the handler's list or readdir
    if (lister->handler != nullptr) {
        I32 found = lister->handler->list(lister->handler, lister->folder, lister->index++, item);
        if (found < 0) *code = errno_now();
        return found;
    }
    for (Usize tries = 0; tries < 3; tries++) { // "." and ".." are skipped: at most two reads are theirs
        struct c::dirent *entry = c::readdir(lister->directory);
        if (entry == nullptr) return 0;
        if (c::strcmp(entry->d_name, ".") == 0 || c::strcmp(entry->d_name, "..") == 0) continue;
        Usize length = c::strlen(entry->d_name);
        if (length >= sizeof item->name) length = sizeof item->name - 1;
        put(item->name, entry->d_name, length);
        item->name[length] = 0;
        struct c::stat status = {};
        Bool known = c::fstatat(c::dirfd(lister->directory), entry->d_name, &status, 0) == 0;
        item->folder = known && (status.st_mode & mode_kind_mask) == mode_folder;
        item->size = known && !item->folder ? (Usize)status.st_size : 0;
        return 1;
    }
    return 0;
}

void lister_close(Lister *lister) {
    contract::trusted(); // the edge: it calls the handler's list or closedir
    if (lister->directory != nullptr) c::closedir(lister->directory);
}

// ---------------------------------------------------------------- one file

// The flags of an open mode; Atomic is a way of writing a whole file, not of opening one.
I32 open_flags(Mode mode) {
    switch (mode) {
    case Read:
        return open_read;
    case Replace:
        return open_replace;
    case Append:
        return open_append;
    case New:
        return open_new;
    case Atomic:
        break;
    }
    misuse("files: open takes Read, Replace, Append or New");
}

// `smith test --changed` (issue #739, knowledge/coverage-selection.md): with SMITH_READS_LOG set, a file this process
// opens to read, a file it maps and a folder it lists are appended to that file, one absolute path a line (a folder's
// ends in `/`: its listing, not what is in it), so the record of the test that ran names the data it read. Children
// inherit the variable (read through std::env, so a test stands in for it on its own thread). Nothing happens
// without it, and nothing while a files handler answers: its paths are not the real file system's.
void reads_log_append(const char *log, const char *path) {
    if (log[0] == '\0') return;
    char resolved[path_max];
    if (c::realpath(path, resolved) == nullptr) return; // a path that is not there has nothing to hash
    Usize length = c::strlen(resolved);
    if (length + 3 >= path_max) return;
    struct c::stat status = {};
    Bool folder = c::stat(resolved, &status) == 0 && (status.st_mode & mode_kind_mask) == mode_folder;
    if (folder) resolved[length++] = '/';
    resolved[length++] = '\n';
    I32 descriptor = c::open(log, open_append, file_mode);
    if (descriptor < 0) return;
    Isize written = c::write(descriptor, resolved, length);
    (void)written; // a line lost makes the record a path short; the next change to it is judged by the graph
    c::close(descriptor);
}

void reads_log(const char *path) {
    contract::trusted(); // the edge: it asks the handler of the thread and the environment
    if (c::smith_handlers_files() != nullptr) return;
    env::Value named = env::get("SMITH_READS_LOG");
    if (named == .some) reads_log_append(named.some.data, path); // the environment's text ends with a NUL
}

// Opens the file. A mode the call does not take is a checked failure.
[[std::c_name("smith_fs_open")]] export [[nodiscard]] OpenResult open(const char path[:], Mode mode) {
    I32 flags = open_flags(mode);
    Path where = path_make(path);
    if (!where.fits) {
        return {.error = NameTooLong};
    }
    I32 descriptor = c::open(where.text, flags, file_mode);
    if (descriptor < 0) {
        return {.error = error_from(errno_now())};
    }
    if (mode == Read) reads_log(where.text);
    return (File){.descriptor = descriptor};
}

// Reads up to the length of the buffer into it and returns how many bytes it read: 0 is the end of the file.
[[std::c_name("smith_fs_read")]] export [[nodiscard]] CountResult read(File file, U8 buffer[:]) {
    contract::trusted(); // the edge: it calls the system's read
    if (countof(buffer) == 0) return (Usize)0;
    for (Usize tries = 0; tries < 64; tries++) { // a signal may interrupt the read
        Isize count = c::read(file.descriptor, buffer.data, countof(buffer));
        if (count >= 0) return (Usize)count;
        if (errno_now() != eintr) {
            return {.error = error_from(errno_now())};
        }
    }
    return {.error = Other};
}

// Writes all of data and returns how many bytes it wrote (all of them, or an error).
[[std::c_name("smith_fs_write")]] export [[nodiscard]] CountResult write(File file, const U8 data[:]) {
    Usize done = 0;
    for (Usize tries = 0; done < countof(data) && tries < countof(data) + 64; tries++) { // each round writes or ends
        const U8 rest[:] = data[done:];
        Isize count = c::write(file.descriptor, rest.data, countof(rest));
        if (count > 0) {
            done += (Usize)count;
        } else if (count < 0 && errno_now() != eintr) {
            return {.error = error_from(errno_now())};
        }
    }
    return done;
}

// Closes the file; the error of the close (the disk refusing the last bytes) is a value. Closing a file twice is a
// checked failure.
[[std::c_name("smith_fs_close")]] export CloseResult close(File file) {
    if (c::close(file.descriptor) != 0) {
        I32 code = errno_now();
        if (code != eintr) return error_from(code);
    }
    return .none;
}

// ---------------------------------------------------------------- whole files

// Reads the open file to its end into a block of the current allocator; hint is the size to start with.
BytesResult read_open(File file, Usize hint) {
    contract::trusted(); // reads to the end of the file: its passes are the file's size
    U8 buffer[:] = mem::alloc_slice(U8, hint);
    Usize filled = 0;
    Bool ended = false;
    for (Usize rounds = 0; rounds < ~(Usize)0 && !ended; rounds++) { // each round reads a byte or ends
        if (filled == countof(buffer)) {
            U8 bigger[:] = mem::alloc_slice(U8, countof(buffer) * 2);
            mem::copy(bigger[0:filled], buffer[0:filled]);
            buffer = bigger; // the old block stays in the region
        }
        U8 room[:] = buffer[filled:];
        CountResult step = read(file, room);
        switch (step) {
        case .error:
            return {.error = step.error};
        case .ok:
            ended = step.ok == 0;
            filled += step.ok;
            break;
        }
    }
    U8 whole[:] = buffer[0:filled];
    return {.ok = whole};
}

// The whole file, in a block of the current allocator that the caller's region holds.
[[std::c_name("smith_fs_read_file")]] export [[nodiscard]] BytesResult read_file(const char path[:]) {
    OpenResult opened = open(path, Read);
    Usize hint = chunk;
    Path where = path_make(path);
    c::SmithFileStatus status = {};
    if (raw_stat(where.text, &status) == 0 && !status.folder) hint = status.size + 1; // one more to see the end
    switch (opened) {
    case .error:
        return {.error = opened.error};
    case .ok:
        BytesResult whole = read_open(opened.ok, hint);
        CloseResult closed = close(opened.ok);
        if (whole == .ok && closed == .some) {
            return {.error = closed.some};
        }
        return whole;
    }
}

// Opens, writes all of data and closes: Replace, Append or New.
CountResult write_in_place(const char path[:], const U8 data[:], Mode mode) {
    OpenResult opened = open(path, mode);
    switch (opened) {
    case .error:
        return {.error = opened.error};
    case .ok:
        CountResult written = write(opened.ok, data);
        CloseResult closed = close(opened.ok);
        if (written == .ok && closed == .some) {
            return {.error = closed.some};
        }
        return written;
    }
}

// Writes all of data to the path as the mode says (Replace, Append, New or Atomic) and returns the bytes written.
[[std::c_name("smith_fs_write_file")]] export [[nodiscard]] CountResult write_file(const char path[:], const U8 data[:],
                                                                                   Mode mode) {
    if (mode != Atomic) return write_in_place(path, data, mode);
    char temporary[path_max];
    I32 length = __builtin_snprintf(temporary, sizeof temporary, "%.*s.tmp", (I32)countof(path), path.data);
    if (length < 0 || (Usize)length >= sizeof temporary) {
        return {.error = NameTooLong};
    }
    const char temporary_name[:] = temporary[0:(Usize)length];
    Usize count = try write_in_place(temporary_name, data, Replace);
    Path from = path_make(temporary_name);
    Path to = path_make(path);
    I32 code = to.fits ? raw_rename(from.text, to.text) : enametoolong;
    if (code != 0) {
        raw_remove(from.text);
        return {.error = error_from(code)};
    }
    return count;
}

// ---------------------------------------------------------------- paths and folders

// What is at the path.
[[std::c_name("smith_fs_info")]] export [[nodiscard]] InfoResult info(const char path[:]) {
    Path where = path_make(path);
    if (!where.fits) {
        return {.error = NameTooLong};
    }
    c::SmithFileStatus status = {};
    I32 code = raw_stat(where.text, &status);
    if (code != 0) {
        return {.error = error_from(code)};
    }
    return (Info){.folder = status.folder, .writable = status.writable, .size = status.size};
}

// Makes the folder and the ones above it that are missing, like `mkdir -p`; one that is there already is success.
[[std::c_name("smith_fs_make_folder")]] export [[nodiscard]] DoneResult make_folder(const char path[:]) {
    Path where = path_make(path);
    if (!where.fits || countof(path) == 0) {
        return {.error = countof(path) == 0 ? NotFound : NameTooLong};
    }
    for (Usize at = 1; at <= countof(path); at++) {
        if (where.text[at] != '/' && where.text[at] != 0) continue;
        char kept = where.text[at];
        where.text[at] = 0;
        I32 code = raw_mkdir(where.text);
        if (code != 0) {
            c::SmithFileStatus status = {};
            if (code != eexist || raw_stat(where.text, &status) != 0 || !status.folder) {
                return {.error = error_from(code)};
            }
        }
        where.text[at] = kept;
    }
    return (Done){};
}

// Deletes a file (a folder is Denied).
[[std::c_name("smith_fs_remove")]] export [[nodiscard]] DoneResult remove(const char path[:]) {
    Path where = path_make(path);
    if (!where.fits) {
        return {.error = NameTooLong};
    }
    I32 code = raw_remove(where.text);
    if (code != 0) {
        return {.error = error_from(code)};
    }
    return (Done){};
}

// Moves a file or a folder to a new path, replacing a file that is there.
[[std::c_name("smith_fs_move")]] export [[nodiscard]] DoneResult move(const char from[:], const char to[:]) {
    Path source = path_make(from);
    Path target_path = path_make(to);
    if (!source.fits || !target_path.fits) {
        return {.error = NameTooLong};
    }
    I32 code = raw_rename(source.text, target_path.text);
    if (code != 0) {
        return {.error = error_from(code)};
    }
    return (Done){};
}

I32 entry_compare(const void *a, const void *b) {
    return c::strcmp(((const Entry *)a)->name.data, ((const Entry *)b)->name.data);
}

// What is in a folder, sorted by name, without "." and "..". The entries and their names are in the current allocator.
[[std::c_name("smith_fs_list")]] export [[nodiscard]] EntriesResult list(const char folder[:]) {
    contract::trusted(); // the edge: it lists a folder and sorts the names with qsort
    Path where = path_make(folder);
    if (!where.fits) {
        return {.error = NameTooLong};
    }
    Lister counter = {};
    I32 code = lister_open(&counter, where.text);
    if (code != 0) {
        return {.error = error_from(code)};
    }
    reads_log(where.text);
    Usize total = 0;
    c::SmithFileItem item = {};
    for (Usize rounds = 0; rounds < ((Usize)1 << 20); rounds++) { // each round reads an entry or ends
        I32 found = lister_next(&counter, &item, &code);
        if (found <= 0) break;
        total++;
    }
    lister_close(&counter);
    if (code != 0) {
        return {.error = error_from(code)};
    }
    Entry entries[:] = mem::alloc_slice(Entry, total);
    Lister lister = {};
    code = lister_open(&lister, where.text);
    if (code != 0) {
        return {.error = error_from(code)};
    }
    Usize filled = 0;
    while (filled < total && lister_next(&lister, &item, &code) > 0) {
        Usize length = c::strlen(item.name);
        char name[:] = mem::alloc_slice(char, length + 1);
        put(name.data, item.name, length);
        entries[filled++] = (Entry){.name = name[0:length], .folder = item.folder, .size = item.size};
    }
    lister_close(&lister);
    if (code != 0) {
        return {.error = error_from(code)};
    }
    Entry found[:] = entries[0:filled];
    if (filled > 1) c::qsort(found.data, filled, sizeof(Entry), entry_compare);
    return found;
}

// Maps the file into the address space instead of reading it: nothing is read until the memory is touched, so a large
// file costs only the pages used. The mapping is private, writes change the memory and never the file, and it lasts
// until unmap. An empty file is an empty slice. The fake gives a view of its bytes.
[[std::c_name("smith_fs_map")]] export [[nodiscard]] BytesResult map(const char path[:]) {
    Path where = path_make(path);
    if (!where.fits) {
        return {.error = NameTooLong};
    }
    c::SmithFileHandler *handler = c::smith_handlers_files();
    if (handler != nullptr && handler->map != nullptr) {
        Usize size = 0;
        void *bytes = handler->map(handler, where.text, &size);
        if (bytes == nullptr) {
            return {.error = error_from(errno_now())};
        }
        U8 view[:] = ((U8 *)bytes)[0:size];
        return {.ok = view};
    }
    I32 descriptor = c::open(where.text, open_read);
    if (descriptor < 0) {
        return {.error = error_from(errno_now())};
    }
    reads_log(where.text);
    struct c::stat info_of = {};
    I32 code = c::fstat(descriptor, &info_of) == 0 ? 0 : errno_now();
    Bool is_folder = code == 0 && (info_of.st_mode & mode_kind_mask) == mode_folder;
    Usize size = code == 0 ? (Usize)info_of.st_size : 0;
    void *bytes = nullptr;
    if (code == 0 && !is_folder && size > 0) {
        bytes = c::mmap(nullptr, size, protect_both, map_file, descriptor, 0);
        if (bytes == (void *)-1) { // NOLINT(performance-no-int-to-ptr): MAP_FAILED
            code = errno_now();
        }
    }
    c::close(descriptor);
    if (code != 0) {
        return {.error = error_from(code)};
    }
    if (is_folder) {
        return {.error = IsFolder};
    }
    U8 view[:] = ((U8 *)(size == 0 ? (void *)where.text : bytes))[0:size];
    return {.ok = view};
}

// Gives a mapping back. An empty slice is nothing to give back.
[[std::c_name("smith_fs_unmap")]] export void unmap(U8 bytes[:]) {
    if (countof(bytes) == 0) {
        return;
    }
    c::SmithFileHandler *handler = c::smith_handlers_files();
    if (handler != nullptr && handler->unmap != nullptr) {
        handler->unmap(handler, bytes.data, countof(bytes));
        return;
    }
    if (handler == nullptr || handler->map == nullptr) c::munmap(bytes.data, countof(bytes));
}

// ---------------------------------------------------------------- the fake: files in memory

[[std::c_name("SmithFilesFakeFile")]] export typedef struct {
    char path[fake_path_max];
    Bool used;
    Bool folder; // a folder made by make_folder; the folders of a file's path need no entry
    U8 *data;
    Usize size;
    Usize capacity;
} FakeFile;

[[std::c_name("SmithFilesFakeOpen")]] export typedef struct {
    Bool open;
    Usize file;
    Usize offset;
    Bool can_read;
    Bool can_write;
    Bool append;
} FakeOpen;

// A files handler over files in memory: `files::fake()` makes one, `files::fake_add` puts a file in it and
// `files::set_handler(&fake.base)` puts it in force. It holds up to 64 files and folders, with paths up to 255 bytes,
// and 16 open files; more is a checked failure (a limit of the fixture). The bytes of its files come from the
// allocator in force when they are written, so a test sets an arena first.
[[std::c_name("SmithFilesFake")]] export typedef struct {
    c::SmithFileHandler base; // first, so &fake.base is the handler
    FakeFile files[fake_files_max];
    FakeOpen opens[fake_open_max];
} Fake;

void fake_fail(I32 code) {
    *errno_slot() = code;
}

// The index of the entry at the path, or the size of the table when there is none.
Usize fake_find(const Fake *fake, const char *path) {
    for (Usize i = 0; i < fake_files_max; i++) {
        if (fake->files[i].used && c::strcmp(fake->files[i].path, path) == 0) return i;
    }
    return fake_files_max;
}

// Whether a folder is at the path: made on purpose, or the start of the path of a file or folder of the fake.
Bool fake_folder_exists(const Fake *fake, const char *path) {
    Usize length = c::strlen(path);
    for (Usize i = 0; i < fake_files_max; i++) {
        const FakeFile *file = &fake->files[i];
        if (!file->used) continue;
        if (file->folder && c::strcmp(file->path, path) == 0) return true;
        if (c::strncmp(file->path, path, length) == 0 && file->path[length] == '/') return true;
    }
    return false;
}

// A free slot of the table for the path (checked: the fixture's limits).
Usize fake_new(Fake *fake, const char *path) {
    Usize length = c::strlen(path);
    if (length >= fake_path_max) misuse("files fake: a path longer than 255 bytes");
    for (Usize i = 0; i < fake_files_max; i++) {
        if (fake->files[i].used) continue;
        fake->files[i] = (FakeFile){.used = true};
        put(fake->files[i].path, path, length);
        return i;
    }
    misuse("files fake: more than 64 files and folders");
}

// The capacity to grow to: double the old one (a chunk at first) until size fits.
Usize grown(Usize capacity, Usize size) {
    Usize result = capacity == 0 ? chunk : capacity * 2;
    while (result < size)
        result *= 2;
    return result;
}

// Makes sure the file holds room for size bytes, in the allocator in force.
void fake_reserve(FakeFile *file, Usize size) {
    if (size <= file->capacity) {
        return;
    }
    Usize capacity = grown(file->capacity, size);
    U8 bigger[:] = mem::alloc_slice(U8, capacity);
    put(bigger.data, file->data, file->size);
    file->data = bigger.data; // the old block stays in the region
    file->capacity = capacity;
}

// NOLINTBEGIN(bugprone-signed-bitwise): the flags of open are ints OR-ed together
I32 fake_open(c::SmithFileHandler *self, const char *path, I32 flags, I32 mode) {
    (void)mode; // the creating mode means nothing in memory
    Fake *fake = (Fake *)self;
    Usize slot = fake_files_max;
    for (Usize i = 0; i < fake_open_max; i++) {
        if (!fake->opens[i].open) {
            slot = i;
            break;
        }
    }
    if (slot == fake_files_max) misuse("files fake: more than 16 files open at once");
    I32 access = flags & access_mask;
    Bool writing = access == flag_write_only || access == flag_read_write;
    Usize found = fake_find(fake, path);
    if (found != fake_files_max && fake->files[found].folder) {
        fake_fail(eisdir);
        return -1;
    }
    if (found == fake_files_max && fake_folder_exists(fake, path)) {
        fake_fail(eisdir);
        return -1;
    }
    if (found != fake_files_max && (flags & flag_create) != 0 && (flags & flag_exclusive) != 0) {
        fake_fail(eexist);
        return -1;
    }
    if (found == fake_files_max) {
        if ((flags & flag_create) == 0) {
            fake_fail(enoent);
            return -1;
        }
        found = fake_new(fake, path);
    } else if ((flags & flag_truncate) != 0 && writing) {
        fake->files[found].size = 0;
    }
    fake->opens[slot] = (FakeOpen){
        .open = true,
        .file = found,
        .can_read = access != flag_write_only,
        .can_write = writing,
        .append = (flags & flag_append) != 0,
    };
    return (I32)(first_descriptor + slot);
}

// NOLINTEND(bugprone-signed-bitwise)

// The open file of a descriptor, or null (and EBADF) when it is not one.
FakeOpen *fake_descriptor(Fake *fake, I32 descriptor) {
    if (descriptor < (I32)first_descriptor || (Usize)descriptor >= first_descriptor + fake_open_max) {
        fake_fail(ebadf);
        return nullptr;
    }
    FakeOpen *open_file = &fake->opens[(Usize)descriptor - first_descriptor];
    if (!open_file->open) {
        fake_fail(ebadf);
        return nullptr;
    }
    return open_file;
}

Isize fake_read(c::SmithFileHandler *self, I32 descriptor, void *buffer, Usize size) {
    Fake *fake = (Fake *)self;
    FakeOpen *open_file = fake_descriptor(fake, descriptor);
    if (open_file == nullptr) return -1;
    if (!open_file->can_read) {
        fake_fail(ebadf);
        return -1;
    }
    const FakeFile *file = &fake->files[open_file->file];
    if (open_file->offset >= file->size) return 0;
    Usize count = file->size - open_file->offset;
    if (count > size) count = size;
    put(buffer, file->data + open_file->offset, count);
    open_file->offset += count;
    return (Isize)count;
}

Isize fake_write(c::SmithFileHandler *self, I32 descriptor, const void *buffer, Usize size) {
    Fake *fake = (Fake *)self;
    FakeOpen *open_file = fake_descriptor(fake, descriptor);
    if (open_file == nullptr) return -1;
    if (!open_file->can_write) {
        fake_fail(ebadf);
        return -1;
    }
    FakeFile *file = &fake->files[open_file->file];
    if (open_file->append) open_file->offset = file->size;
    fake_reserve(file, open_file->offset + size);
    put(file->data + open_file->offset, buffer, size);
    open_file->offset += size;
    if (open_file->offset > file->size) file->size = open_file->offset;
    return (Isize)size;
}

I32 fake_close(c::SmithFileHandler *self, I32 descriptor) {
    FakeOpen *open_file = fake_descriptor((Fake *)self, descriptor);
    if (open_file == nullptr) return -1;
    *open_file = (FakeOpen){};
    return 0;
}

I32 fake_stat(c::SmithFileHandler *self, const char *path, c::SmithFileStatus *status) {
    const Fake *fake = (const Fake *)self;
    Usize found = fake_find(fake, path);
    if (found != fake_files_max && !fake->files[found].folder) {
        *status = (c::SmithFileStatus){.folder = false, .writable = true, .size = fake->files[found].size};
        return 0;
    }
    if (found != fake_files_max || fake_folder_exists(fake, path)) {
        *status = (c::SmithFileStatus){.folder = true, .writable = true, .size = 0};
        return 0;
    }
    fake_fail(enoent);
    return -1;
}

I32 fake_mkdir(c::SmithFileHandler *self, const char *path) {
    Fake *fake = (Fake *)self;
    if (fake_find(fake, path) != fake_files_max || fake_folder_exists(fake, path)) {
        fake_fail(eexist);
        return -1;
    }
    fake->files[fake_new(fake, path)].folder = true;
    return 0;
}

I32 fake_remove(c::SmithFileHandler *self, const char *path) {
    Fake *fake = (Fake *)self;
    Usize found = fake_find(fake, path);
    if (found == fake_files_max && !fake_folder_exists(fake, path)) {
        fake_fail(enoent);
        return -1;
    }
    if (found == fake_files_max || fake->files[found].folder) {
        fake_fail(eperm);
        return -1;
    }
    fake->files[found] = (FakeFile){};
    return 0;
}

I32 fake_rename(c::SmithFileHandler *self, const char *from, const char *to) {
    Fake *fake = (Fake *)self;
    Usize found = fake_find(fake, from);
    if (found == fake_files_max) {
        fake_fail(enoent);
        return -1;
    }
    Usize length = c::strlen(to);
    if (length >= fake_path_max) misuse("files fake: a path longer than 255 bytes");
    Usize target_found = fake_find(fake, to);
    if (target_found != fake_files_max && target_found != found) fake->files[target_found] = (FakeFile){};
    fake->files[found].path[0] = 0;
    put(fake->files[found].path, to, length);
    fake->files[found].path[length] = 0;
    return 0;
}

// What the file shows in the listed folder: the first name of its path below the folder, a folder if the path goes on
// (or is a folder). False when the file is not inside the folder.
Bool fake_child(const FakeFile *file, const char *folder, c::SmithFileItem *item) {
    Usize length = c::strlen(folder);
    const char *rest = file->path;
    if (length > 0) {
        if (c::strncmp(file->path, folder, length) != 0 || file->path[length] != '/') return false;
        rest = file->path + length + 1;
    }
    Usize name = 0;
    while (rest[name] != 0 && rest[name] != '/')
        name++;
    if (name == 0) return false;
    if (name >= sizeof item->name) misuse("files fake: a name longer than 255 bytes");
    put(item->name, rest, name);
    item->name[name] = 0;
    Bool deeper = rest[name] == '/';
    item->folder = deeper || file->folder;
    item->size = item->folder ? 0 : file->size;
    return true;
}

I32 fake_list(c::SmithFileHandler *self, const char *folder, Usize index, c::SmithFileItem *item) {
    const Fake *fake = (const Fake *)self;
    if (!fake_folder_exists(fake, folder) && c::strlen(folder) > 0) {
        Usize found = fake_find(fake, folder);
        fake_fail(found != fake_files_max && !fake->files[found].folder ? enotdir : enoent);
        return -1;
    }
    Usize seen = 0;
    for (Usize i = 0; i < fake_files_max; i++) {
        c::SmithFileItem child = {};
        if (!fake->files[i].used || !fake_child(&fake->files[i], folder, &child)) continue;
        Bool again = false; // a folder shown by an earlier file is one entry
        for (Usize j = 0; j < i && !again; j++) {
            c::SmithFileItem earlier = {};
            again = fake->files[j].used && fake_child(&fake->files[j], folder, &earlier) &&
                    c::strcmp(earlier.name, child.name) == 0;
        }
        if (again) continue;
        if (seen++ == index) {
            *item = child;
            return 1;
        }
    }
    return 0;
}

void *fake_map(c::SmithFileHandler *self, const char *path, Usize *size) {
    Fake *fake = (Fake *)self;
    Usize found = fake_find(fake, path);
    if (found == fake_files_max || fake->files[found].folder) {
        fake_fail(found == fake_files_max && !fake_folder_exists(fake, path) ? enoent : eisdir);
        return nullptr;
    }
    *size = fake->files[found].size;
    fake_reserve(&fake->files[found], 1); // a file that never held bytes still has an address
    return fake->files[found].data;
}

void fake_unmap(c::SmithFileHandler *self, void *data, Usize size) {
    (void)self; // the view is the file's own bytes: nothing to give back
    (void)data;
    (void)size;
}

// An empty fake. Put it in force with `files::set_handler(&fake.base)`.
[[std::c_name("smith_fs_fake")]] export [[nodiscard]] Fake fake() {
    Fake result = {};
    result.base = (c::SmithFileHandler){
        .open = fake_open,
        .read = fake_read,
        .write = fake_write,
        .close = fake_close,
        .stat = fake_stat,
        .mkdir = fake_mkdir,
        .remove = fake_remove,
        .rename = fake_rename,
        .list = fake_list,
        .map = fake_map,
        .unmap = fake_unmap,
    };
    return result;
}

// Puts a file in the fake (the bytes are copied, from the allocator in force), replacing one of the same path.
[[std::c_name("smith_fs_fake_add")]] export void fake_add(Fake *fake, const char path[:], const U8 data[:]) {
    Path where = path_make(path);
    if (!where.fits) misuse("files fake: a path longer than 255 bytes");
    Usize found = fake_find(fake, where.text);
    if (found == fake_files_max) found = fake_new(fake, where.text);
    FakeFile *file = &fake->files[found];
    file->folder = false;
    file->size = 0;
    fake_reserve(file, countof(data));
    put(file->data, data.data, countof(data));
    file->size = countof(data);
}
// NOLINTEND(smith-effects)
