// smith-build: link
// std::random, <smith/random.h>: random numbers from keys. Its C API is the generated header include/smith/random.h
// (a build output, not in git). Every export has a short name here and a C name (the attribute
// before it): `random::key_make` is `smith_key_make`, `random::Key` is `SmithKey`. The comments above an export are the
// header's doc comments, so they name the Smith names; the first one says how a C name follows from them.
module std::random;

import target;
import std::contract;
import std::math;
import std::optimize;

// <smith/random.h>: random numbers from keys, as in JAX. A key is an immutable value, and every draw is a pure function
// of a key: the same key gives the same numbers on every platform, in any thread and in any order. There is no global
// state and no generator that advances, so nothing can interleave, and a test that fails once fails every time.
//
// Names. The module's names are short (random::key_make, random::Key, random::uniform_double_sample). In C a function
// is smith_<name> (smith_key_make) and a type has Smith in front (SmithKey, SmithUniformDouble); the tap is the one
// exception: random::Tap is SmithRandomTap.
//
//   random::Key key = random::key_make(seed);
//   F64 x = random::uniform_double_sample(key, (random::UniformDouble){.low = 0, .high = 1});
//
// In C, the same:
//   SmithKey key = smith_key_make(seed);
//   double x = smith_uniform_double_sample(key, (SmithUniformDouble){.low = 0, .high = 1});
//
// A key is used once. Drawing twice from the same key repeats the same numbers, which is a bug, so a key is affine
// ([[std::affine]]): a second use of one is a compile error naming the first. split(key, keys) uses key and fills an
// array or a slice with independent keys, each for one use:
//   random::Key keys[2];
//   random::split(key, keys);
//   F64 a = random::normal_double_sample(keys[0], n);
//   F64 b = random::normal_double_sample(keys[0], n);   // error: 'keys[0]' is used again; it was already used at line
//   N
//
// Filling an array is the plain loop over keys, which works for any distribution and parallelizes, since no draw
// depends on another:
//   random::Key per_item[count];
//   random::split(key, per_item);
//   for (Usize i = 0; i < countof(per_item); i++)
//       out[i] = random::normal_float_sample(per_item[i], (random::NormalFloat){.mean = 0, .deviation = 1});
//
// A loop that needs a key for each turn reassigns it:
//   for (Usize i = 0; i < count; i++) {
//       random::Key next[2];
//       random::split(key, next);
//       key = next[0];
//       out[i] = random::uniform_double_sample(next[1], u);
//   }
//
// A distribution is a struct of its parameters and a function `<name>_sample(key, d)` built only from the public
// primitives below, so your own is written exactly like smith's. It takes a key and spends it once, with key_bits,
// key_unit_float or key_unit_double, or splits it for its parts. An exponential distribution with a rate, where
// 1 - unit lies in (0, 1], so the log is safe:
//   F64 exponential_sample(random::Key key, F64 rate) {
//       return -random::log_double(1.0 - random::key_unit_double(key)) / rate;
//   }
//
// A draw is a pure function of its key, so it does not depend on the draws before it: part i of a split is the same
// however many parts came with it, and changing one draw never shifts another.
//
// Every distribution maps the zero word to its simplest value, and values move away from it as the word grows, so a
// test runner that makes the words of a failing test smaller (as unsigned integers) finds a simple failure. A
// distribution of your own should do the same: let bits 0 give the simplest value. The simplest values are: 0, or the
// bound nearest 0, for the uniforms (then 0 - 1, 0 + 1, 0 - 2... in that order); the mean, to within one grid step, for
// the normals; false for the Bernoulli; column 0 for std::categorical; the identity for the permutation. This changes
// no distribution, since any bijection of uniform words is uniform; it only changes which word gives which value.
//
// Real distributions come in f32 and f64 (float and double in C, named as <math.h> names sqrtf and sqrt), and integer
// ones use i64. An f32 distribution computes in f32, so a GPU kernel can mirror it; Metal has no f64.
//
// The numbers are part of the API: smith never changes what a key gives. To keep that true on every machine, the
// library keeps a multiply from fusing with an add whatever -ffp-contract says, and refuses -ffast-math, and its
// logarithm is its own (log_float and log_double), the same bits everywhere; only sqrt and sqrtf come from libm, and
// IEEE requires those to be exactly rounded.
// On platforms where sqrt is not inlined, link libm (-lm).
//
// A tap watches the words a key hands out. For smith's test runner, and nothing else: a key made by the runner carries
// one, and a draw passes each word through its `word` (the key's bits, the draw's number and the word), so the runner
// can record a failing test's words and replace them with smaller ones. The tap travels with the key, through
// split, so there is no global to set and a program's own keys, which carry none, stay pure functions of their
// bits. `word` is given the tap it is called through, to find the runner's state around it.
[[std::c_name("SmithRandomTap")]] export typedef struct Tap {
    U64 (*word)(const struct Tap *tap, U64 key, U64 n, U64 bits);
} Tap;

// A key: a 64-bit value that names a stream of random bits, and the tap of the runner that made it, if any. A key is
// affine: each key is used at most once, a second use is a compile error naming the first, and split(key, keys) is how
// one key becomes many. The mark is written [[clang::annotate("std::affine")]], which is what [[std::affine]] makes
// and which every clang accepts, so a program that includes this header with another compiler gets no warning.
[[std::c_name("SmithKey")]] export [[clang::annotate("std::affine")]] typedef struct {
    U64 bits;
    const Tap *tap; // nullptr, except for a key the test runner made
} Key;

// [low, high)
[[std::c_name("SmithUniformFloat")]] export typedef struct {
    F32 low, high;
} UniformFloat;

// [low, high)
[[std::c_name("SmithUniformDouble")]] export typedef struct {
    F64 low, high;
} UniformDouble;

// [low, high], each value exactly as likely
[[std::c_name("SmithUniformInt64")]] export typedef struct {
    I64 low, high;
} UniformInt64;

// The normal distribution by inverse CDF (Wichura's AS241), from a grid of probabilities that never reaches 0 or 1, so
// a draw is finite and the distribution is exactly symmetric. A draw reaches about +-8.2 deviations for f64 and
// about +-5.3 for f32.
[[std::c_name("SmithNormalFloat")]] export typedef struct {
    F32 mean, deviation;
} NormalFloat;

[[std::c_name("SmithNormalDouble")]] export typedef struct {
    F64 mean, deviation;
} NormalDouble;

// True with that probability.
[[std::c_name("SmithBernoulli")]] export typedef struct {
    F64 probability;
} Bernoulli;

[[std::c_name("SmithPermutation")]] export typedef struct {
    Usize count;
} Permutation;

// The same bits on every platform: a fused multiply-add rounds once where the standard rounds twice, and changes the
// last bit of a draw. The library declares -ffp-contract=off (the registry in smith.c), which `smith build` adds after
// the project's own flags whenever it compiles this file, so it wins over the project's -ffp-contract=fast and over
// clang's default (on). Compiled by hand, with no such flag, every product that feeds a sum also goes through mul_*,
// whose empty asm makes the product opaque to the optimizer: nothing fuses, in any flags. -ffast-math, which also
// reorders, is refused.
static_assert(!__FINITE_MATH_ONLY__, "smith/random: -ffast-math changes floating-point results, so a key would stop "
                                     "giving the same numbers; compile lib/std/random.smith without it");

static_assert(target::float_radix == 2 && target::f32_mantissa_bits == 24 && target::f64_mantissa_bits == 53,
              "f32 and f64 must be IEEE");
static_assert(target::float_eval_method == 0, "f32 arithmetic must happen in f32");

// A value the compiler cannot see through (optimize::opaque), so a product is not fused into a following addition.
// A value passed through it is opaque to the optimizer, which then cannot fold it into immediates: the Philox
// constants stay in registers (left alone the key schedule becomes ten immediates, three instructions each, where an
// add of a register is one), and the polynomial coefficients are loaded (rebuilt from immediates they cost four
// instructions each). This only changes how the same bits are computed.
inline F64 opaque_double(F64 value) {
    return optimize::opaque(value);
}

inline F32 opaque_float(F32 value) {
    return optimize::opaque(value);
}

inline U32 register_u32(U32 value) {
    return optimize::opaque(value);
}

inline const F64 *register_doubles(const F64 *value) {
    return optimize::opaque(value);
}

inline const F32 *register_floats(const F32 *value) {
    return optimize::opaque(value);
}

inline F64 mul_double(F64 a, F64 b) {
    return opaque_double(a * b);
}

inline F32 mul_float(F32 a, F32 b) {
    return opaque_float(a * b);
}

// The polynomial c[0] + c[1] x + ... + c[count - 1] x^(count - 1) by Horner's rule: one rounded product and one rounded
// sum per step.
F64 horner_double(const F64 *c, Usize count, F64 x) {
    c = register_doubles(c); // the coefficients are loaded, not rebuilt from immediates (4 instructions each)
    F64 sum = c[count - 1];
    for (Usize i = count - 1; i > 0; i--)
        sum = mul_double(sum, x) + c[i - 1];
    return sum;
}

F32 horner_float(const F32 *c, Usize count, F32 x) {
    c = register_floats(c); // the coefficients are loaded, not rebuilt from immediates (4 instructions each)
    F32 sum = c[count - 1];
    for (Usize i = count - 1; i > 0; i--)
        sum = mul_float(sum, x) + c[i - 1];
    return sum;
}

// ---------------------------------------------------------------------------------------------------------------
// Philox4x32-10: Salmon, Moraes, Dror and Shaw, "Parallel Random Numbers: As Easy as 1, 2, 3", SC'11 (Random123). A
// counter-based generator: a 64-bit key and a 128-bit counter give four 32-bit words, with no state between calls.

constexpr U32 philox_multiplier_0 = 0xD2511F53;
constexpr U32 philox_multiplier_1 = 0xCD9E8D57;
constexpr U32 philox_increment_0 = 0x9E3779B9;
constexpr U32 philox_increment_1 = 0xBB67AE85;
constexpr I32 philox_rounds = 10;

typedef struct {
    U32 word[4];
} Block;

// One Philox round on the counter words c[0..3] with the round key k0, k1.
inline void philox_round(U32 *c0, U32 *c1, U32 *c2, U32 *c3, U32 k0, U32 k1, U32 m0, U32 m1) {
    U64 product_0 = (U64)m0 * *c0;
    U64 product_1 = (U64)m1 * *c2;
    *c0 = (U32)((U64)(*c1 ^ k0) ^ (product_1 >> 32));
    *c1 = (U32)product_1;
    *c2 = (U32)((U64)(*c3 ^ k1) ^ (product_0 >> 32));
    *c3 = (U32)product_0;
}

// Philox4x32-10 for a counter and a key. The first nine rounds are the same for every caller; the tenth is done by the
// caller, which usually needs only two of the four words (the rest of that round is then skipped).
typedef struct {
    U32 word[4];
    U32 key_0, key_1;
} Rounds;

inline Rounds nine_rounds(Block counter, U32 key_0, U32 key_1) {
    U32 multiplier_0 = philox_multiplier_0;
    U32 multiplier_1 = philox_multiplier_1;
    U32 increment_0 = philox_increment_0;
    U32 increment_1 = philox_increment_1;
    multiplier_0 = register_u32(multiplier_0);
    multiplier_1 = register_u32(multiplier_1);
    increment_0 = register_u32(increment_0);
    increment_1 = register_u32(increment_1);
    U32 c0 = counter.word[0];
    U32 c1 = counter.word[1];
    U32 c2 = counter.word[2];
    U32 c3 = counter.word[3];
    for (I32 round = 0; round < philox_rounds - 1; round++) {
        philox_round(&c0, &c1, &c2, &c3, key_0, key_1, multiplier_0, multiplier_1);
        key_0 += increment_0;
        key_1 += increment_1;
    }
    return (Rounds){{c0, c1, c2, c3}, key_0, key_1};
}

// The whole block, with all ten rounds: the library draws through the two halves below, and the tests check this one
// against Random123's known answers.
[[maybe_unused]] Block philox(Block counter, U32 key_0, U32 key_1) {
    Rounds r = nine_rounds(counter, key_0, key_1);
    philox_round(&r.word[0], &r.word[1], &r.word[2], &r.word[3], r.key_0, r.key_1, philox_multiplier_0,
                 philox_multiplier_1);
    return (Block){{r.word[0], r.word[1], r.word[2], r.word[3]}};
}

// Output words 0 and 1 as one 64-bit value, which the tenth round makes from the second product alone.
U64 philox_low(Block counter, U32 key_0, U32 key_1) {
    Rounds r = nine_rounds(counter, key_0, key_1);
    U64 product_1 = (U64)philox_multiplier_1 * r.word[2];
    return (U64)((U32)(product_1 >> 32) ^ r.word[1] ^ r.key_0) | (product_1 << 32);
}

// Output words 2 and 3 as one 64-bit value, from the first product alone.
U64 philox_high(Block counter, U32 key_0, U32 key_1) {
    Rounds r = nine_rounds(counter, key_0, key_1);
    U64 product_0 = (U64)philox_multiplier_0 * r.word[0];
    return (U64)((U32)(product_0 >> 32) ^ r.word[3] ^ r.key_1) | (product_0 << 32);
}

// The key for a seed. Seeds that differ in one bit give unrelated streams.
[[std::c_name("smith_key_make")]] export [[nodiscard]] Key key_make(U64 seed) {
    return (Key){.bits = seed};
}

// Counter word 2 separates split's domain (1) from the words' domain (0). The key for part i of key (JAX's fold_in).
Key derive(const Key *key, U64 i) {
    contract::trusted(); // Philox is 64 multiplications a draw, which a proof of its callers should not repeat
    Block counter = {{(U32)i, (U32)(i >> 32), 1, 0}};
    return (Key){.bits = philox_low(counter, (U32)key->bits, (U32)(key->bits >> 32)), .tap = key->tap};
}

// split for C: a pointer and a count.
[[std::c_name("smith_key_split_n")]] export void split_n(Key key, Key *keys, Usize count) {
    contract::trusted(); // its loop runs over the count, which has no bound a proof can use
    contract::requires(keys != nullptr || count == 0);
    const Key *parent = &key;
    for (Usize i = 0; i < count; i++)
        keys[i] = derive(parent, i);
}

// Uses key and fills keys with countof(keys) new keys, independent of each other and of key: the way one key becomes
// many, each then used once. The keys of a count are the first keys of a larger count, so adding a part never changes
// the others. An array or a slice (a plain loop gives each item its key):
//   random::Key keys[3];
//   random::split(key, keys);
//   for (Usize i = 0; i < countof(keys); i++) out[i] = random::uniform_double_sample(keys[i], u);
[[std::c_name("smith_key_split")]] export void split(Key key, Key keys[:]) {
    split_n(key, keys.data, keys.count[0]);
}

// The key's n-th 64 random bits, through the tap, if the key carries one: every distribution draws through here, so the
// runner's tap sees every word. Draws n = 0, 1, 2... of one key are different numbers, a stream a distribution may
// spend inside the library; a program gives each use its own key, from split.
U64 word(const Key *key, U64 n) {
    contract::trusted(); // the runner's tap is a call through a function pointer, the edge a proof cannot read
    U64 block = n >> 1;
    Block counter = {{(U32)block, (U32)(block >> 32), 0, 0}};
    U32 key_0 = (U32)key->bits;
    U32 key_1 = (U32)(key->bits >> 32);
    U64 bits = (n & 1) == 0 ? philox_low(counter, key_0, key_1) : philox_high(counter, key_0, key_1);
    return key->tap != nullptr ? key->tap->word(key->tap, key->bits, n, bits) : bits;
}

// 64 random bits: a key is one draw.
[[std::c_name("smith_key_bits")]] export [[nodiscard]] U64 key_bits(Key key) {
    return word(&key, 0);
}

// A real in [0, 1) on a grid of 2^-24. 1 - unit is then exact and lies in (0, 1]: the safe way to take a log.
[[std::c_name("smith_key_unit_float")]] export [[nodiscard]] F32 key_unit_float(Key key) {
    return (F32)(word(&key, 0) >> 40) * 0x1p-24f;
}

// A real in [0, 1) on a grid of 2^-53. 1 - unit is exact and lies in (0, 1].
[[std::c_name("smith_key_unit_double")]] export [[nodiscard]] F64 key_unit_double(Key key) {
    return (F64)(word(&key, 0) >> 11) * 0x1p-53;
}

// ---------------------------------------------------------------------------------------------------------------
// The logarithm: fdlibm's e_log.c and e_logf.c (Copyright (C) 1993 by Sun Microsystems, Inc., permission to use, copy,
// modify and distribute is granted provided this notice is preserved), in the FreeBSD msun version. The exponent is
// split off through the bits, then an odd polynomial in s = f / (2 + f) gives log(1 + f). No tables.

U64 double_bits(F64 x) {
    return __builtin_bit_cast(U64, x);
}

F64 bits_double(U64 bits) {
    return __builtin_bit_cast(F64, bits);
}

U32 float_bits(F32 x) {
    return __builtin_bit_cast(U32, x);
}

F32 bits_float(U32 bits) {
    return __builtin_bit_cast(F32, bits);
}

constexpr F64 log_double_ln2_hi = 6.93147180369123816490e-01; // 3fe62e42 fee00000
constexpr F64 log_double_ln2_lo = 1.90821492927058770002e-10; // 3dea39ef 35793c76
constexpr F64 log_double_two54 = 1.80143985094819840000e+16;  // 2^54
constexpr F64 log_double_lg1 = 6.666666666666735130e-01;
constexpr F64 log_double_lg2 = 3.999999999940941908e-01;
constexpr F64 log_double_lg3 = 2.857142874366239149e-01;
constexpr F64 log_double_lg4 = 2.222219843214978396e-01;
constexpr F64 log_double_lg5 = 1.818357216161805012e-01;
constexpr F64 log_double_lg6 = 1.531383769920937332e-01;
constexpr F64 log_double_lg7 = 1.479819860511658591e-01;

// log(1 + f) for f in the range after reduction, with the exponent k added back.
F64 log_double_finish(F64 f, I32 k, U32 hx) {
    F64 s = f / (2.0 + f);
    F64 dk = (F64)k;
    F64 z = mul_double(s, s);
    F64 w = mul_double(z, z);
    U32 mixed =
        (hx - 0x6147a) | (0x6b851 - hx); // positive as a signed value: the range where log(1+f) = f - hfsq + ...
    static const F64 even[3] = {log_double_lg2, log_double_lg4, log_double_lg6};
    static const F64 odd[4] = {log_double_lg1, log_double_lg3, log_double_lg5, log_double_lg7};
    F64 t1 = mul_double(w, horner_double(even, 3, w));
    F64 t2 = mul_double(z, horner_double(odd, 4, w));
    F64 r = t2 + t1;
    if (mixed != 0 && mixed < 0x80000000U) {
        F64 hfsq = mul_double(mul_double(0.5, f), f);
        F64 inner = mul_double(s, hfsq + r);
        if (k == 0) return f - (hfsq - inner);
        return mul_double(dk, log_double_ln2_hi) - ((hfsq - (inner + mul_double(dk, log_double_ln2_lo))) - f);
    }
    F64 inner = mul_double(s, f - r);
    if (k == 0) return f - inner;
    return mul_double(dk, log_double_ln2_hi) - ((inner - mul_double(dk, log_double_ln2_lo)) - f);
}

[[std::c_name("smith_log_double")]] export [[nodiscard]] F64 log_double(F64 x) {
    U64 bits = double_bits(x);
    U32 hx = (U32)(bits >> 32); // fdlibm's signed hx is negative when hx >= 0x80000000 here
    U32 lx = (U32)bits;
    I32 k = 0;
    if (hx < 0x00100000 || hx >= 0x80000000U) { // x < 2^-1022, or negative
        if (((hx & 0x7fffffffU) | lx) == 0) return -math::infinity(F64);
        if (hx >= 0x80000000U) return math::nan(F64);
        k -= 54; // subnormal: scale up
        x *= log_double_two54;
        bits = double_bits(x);
        hx = (U32)(bits >> 32);
    }
    if (hx >= 0x7ff00000) return x + x; // inf or NaN
    k += (I32)(hx >> 20) - 1023;
    hx &= 0x000fffff;
    U32 half = (hx + 0x95f64) & 0x100000; // 0x100000 when x is above sqrt(2): use x/2
    bits = (bits & 0xffffffffULL) | ((U64)(hx | (half ^ 0x3ff00000)) << 32); // x or x/2, in [sqrt(2)/2, sqrt(2))
    x = bits_double(bits);
    k += (I32)(half >> 20);
    F64 f = x - 1.0;
    if ((0x000fffff & (2 + hx)) < 3) { // -2^-20 <= f < 2^-20
        if (f == 0.0) {
            if (k == 0) return 0.0;
            F64 dk = (F64)k;
            return mul_double(dk, log_double_ln2_hi) + mul_double(dk, log_double_ln2_lo);
        }
        F64 r = mul_double(mul_double(f, f), 0.5 - mul_double(0.33333333333333333, f));
        if (k == 0) return f - r;
        F64 dk = (F64)k;
        return mul_double(dk, log_double_ln2_hi) - ((r - mul_double(dk, log_double_ln2_lo)) - f);
    }
    return log_double_finish(f, k, hx);
}

constexpr F32 log_float_ln2_hi = 6.9313812256e-01f; // 0x3f317180
constexpr F32 log_float_ln2_lo = 9.0580006145e-06f; // 0x3717f7d1
constexpr F32 log_float_two25 = 3.355443200e+07f;   // 2^25
constexpr F32 log_float_lg1 = 0xaaaaaa.0p-24f;      // 0.66666662693
constexpr F32 log_float_lg2 = 0xccce13.0p-25f;      // 0.40000972152
constexpr F32 log_float_lg3 = 0x91e9ee.0p-25f;      // 0.28498786688
constexpr F32 log_float_lg4 = 0xf89e26.0p-26f;      // 0.24279078841

F32 log_float_finish(F32 f, I32 k, U32 ix) {
    F32 s = f / (2.0f + f);
    F32 dk = (F32)k;
    F32 z = mul_float(s, s);
    F32 w = mul_float(z, z);
    U32 mixed = (ix - (0x6147aU << 3)) | ((0x6b851U << 3) - ix);
    F32 t1 = mul_float(w, log_float_lg2 + mul_float(w, log_float_lg4));
    F32 t2 = mul_float(z, log_float_lg1 + mul_float(w, log_float_lg3));
    F32 r = t2 + t1;
    if (mixed != 0 && mixed < 0x80000000U) {
        F32 hfsq = mul_float(mul_float(0.5f, f), f);
        F32 inner = mul_float(s, hfsq + r);
        if (k == 0) return f - (hfsq - inner);
        return mul_float(dk, log_float_ln2_hi) - ((hfsq - (inner + mul_float(dk, log_float_ln2_lo))) - f);
    }
    F32 inner = mul_float(s, f - r);
    if (k == 0) return f - inner;
    return mul_float(dk, log_float_ln2_hi) - ((inner - mul_float(dk, log_float_ln2_lo)) - f);
}

// The natural logarithm the distributions use, fdlibm's algorithm: within 1 ulp of the true value and the same bits on
// every platform, which libm's log does not promise. 0 gives -inf, a negative gives NaN, inf gives inf, NaN gives NaN,
// and subnormals work.
[[std::c_name("smith_log_float")]] export [[nodiscard]] F32 log_float(F32 x) {
    U32 ix = float_bits(x);
    I32 k = 0;
    if (ix < 0x00800000 || ix >= 0x80000000U) { // x < 2^-126, or negative
        if ((ix & 0x7fffffffU) == 0) return -math::infinity(F32);
        if (ix >= 0x80000000U) return math::nan(F32);
        k -= 25; // subnormal: scale up
        x *= log_float_two25;
        ix = float_bits(x);
    }
    if (ix >= 0x7f800000) return x + x; // inf or NaN
    k += (I32)(ix >> 23) - 127;
    ix &= 0x007fffff;
    U32 half = (ix + (0x95f64U << 3)) & 0x800000; // 0x800000 when x is above sqrt(2): use x/2
    x = bits_float(ix | (half ^ 0x3f800000U));
    k += (I32)(half >> 23);
    F32 f = x - 1.0f;
    if ((0x007fffffU & (0x8000U + ix)) < 0xc000U) { // -2^-9 <= f < 2^-9
        if (f == 0.0f) {
            if (k == 0) return 0.0f;
            F32 dk = (F32)k;
            return mul_float(dk, log_float_ln2_hi) + mul_float(dk, log_float_ln2_lo);
        }
        F32 r = mul_float(mul_float(f, f), 0.5f - mul_float(0.33333333333333333f, f));
        if (k == 0) return f - r;
        F32 dk = (F32)k;
        return mul_float(dk, log_float_ln2_hi) - ((r - mul_float(dk, log_float_ln2_lo)) - f);
    }
    return log_float_finish(f, k, ix);
}

// ---------------------------------------------------------------------------------------------------------------
// Zigzag decoding: 0, 1, 2, 3, 4... give 0, -1, 1, -2, 2... so a word moves away from 0 as it grows.
I64 zigzag(U64 word) {
    I64 half = (I64)(word >> 1);
    return (word & 1) != 0 ? -half - 1 : half;
}

// The position in [0, count) that comes index-th when the positions are ordered by their distance from origin: origin,
// origin - 1, origin + 1, origin - 2, origin + 2... until one side runs out, then the rest of the other side in order.
// A bijection of [0, count), so a uniform index gives a uniform position, and index 0 gives the origin.
U64 around(U64 index, U64 origin, U64 count) {
    contract::requires(origin < count && index < count);
    U64 below = origin;
    U64 above = count - 1 - origin;
    U64 both = below < above ? below : above; // positions come in pairs this many times
    if (index <= 2 * both) return origin + (U64)zigzag(index);
    return below > above ? origin - (index - both) : origin + (index - both);
}

// ---------------------------------------------------------------------------------------------------------------
// An index below n, unbiased: Lemire's multiply-and-reject, "Fast Random Integer Generation in an Interval", 2019. The
// high half of bits * n is the index, so the index grows with the word and word 0 gives index 0. Each index owns a run
// of words, and a run is one word longer than the others when 2^64 mod n is not 0; that extra word is the one with the
// largest low half, and it is rejected (Lemire rejects the one with the smallest, which would reject word 0 and spend
// the next draw; this rejects the same number of words, so the index is as uniform). A rejection has probability below
// 1/2. Attempt k uses bits k of the key. Needing all 64 attempts has probability below 2^-64; after the 64th the last
// candidate is returned, which is then biased by less than that.

constexpr U64 attempts = 64;

typedef unsigned _BitInt(128) Wide; // the product of two words, whose high half is the index

U64 draw_index(const Key *key, U64 n) {
    contract::trusted(); // 64 attempts of a 128-bit product: callers use the promise, which the tests check
    contract::requires(n > 0);
    U64 threshold = (0 - n) % n; // 2^64 mod n
    U64 index = 0;
    for (U64 attempt = 0; attempt < attempts; attempt++) {
        Wide product = (Wide)word(key, attempt) * n;
        index = (U64)(product >> 64);
        if (threshold == 0 || (U64)product < 0 - threshold) break;
    }
    contract::ensures(index < n);
    return index;
}

// The value that comes index-th, in [low, high], ordered by distance from 0 clamped into the range. span is high - low
// + 1, which is not 0 here.
I64 int_value(I64 low, I64 high, U64 index) {
    U64 span = (U64)high - (U64)low + 1;
    U64 origin = 0; // the position of 0, clamped
    if (high < 0) {
        origin = span - 1;
    } else if (low <= 0) {
        origin = 0 - (U64)low;
    }
    return (I64)((U64)low + around(index, origin, span));
}

[[std::c_name("smith_uniform_int64_sample")]] export [[nodiscard]] I64 uniform_int64_sample(Key key,
                                                                                            UniformInt64 uniform) {
    contract::requires(uniform.low <= uniform.high);
    U64 span = (U64)uniform.high - (U64)uniform.low + 1;
    if (span == 0) return zigzag(word(&key, 0)); // the whole i64 range
    return int_value(uniform.low, uniform.high, draw_index(&key, span));
}

// ---------------------------------------------------------------------------------------------------------------
// Real uniforms: low + (high - low) * unit, which rounding can push up to high; that value becomes the largest one
// below high, found from the bits (no nextafter).

F32 below_float(F32 high) {
    U32 bits = float_bits(high);
    if (high > 0.0f) return bits_float(bits - 1);
    if (high == 0.0f) return bits_float(0x80000001U); // -the smallest subnormal
    return bits_float(bits + 1);
}

F64 below_double(F64 high) {
    U64 bits = double_bits(high);
    if (high > 0.0) return bits_double(bits - 1);
    if (high == 0.0) return bits_double(0x8000000000000001ULL);
    return bits_double(bits + 1);
}

// The grid index nearest 0: where the zigzag starts. 0 when low >= 0, the last index when high <= 0.
U64 origin_float(F32 low, F32 high) {
    constexpr U64 last = ((U64)1 << 24) - 1;
    if (low >= 0.0f) return 0;
    if (high <= 0.0f) return last;
    F32 scaled = mul_float(-low / (high - low), 0x1p24f);
    U64 origin = (U64)(scaled + 0.5f);
    return origin < last ? origin : last;
}

U64 origin_double(F64 low, F64 high) {
    constexpr U64 last = ((U64)1 << 53) - 1;
    if (low >= 0.0) return 0;
    if (high <= 0.0) return last;
    F64 scaled = mul_double(-low / (high - low), 0x1p53);
    U64 origin = (U64)(scaled + 0.5);
    return origin < last ? origin : last;
}

// Each draws from the key's bits 0 (and derived keys, for the permutation), and the zero word gives
// the simplest value (see the top). Parameters are
// required: low < high and both finite, deviation > 0, a probability in [0, 1].
[[std::c_name("smith_uniform_float_sample")]] export [[nodiscard]] F32 uniform_float_sample(Key key,
                                                                                            UniformFloat uniform) {
    contract::trusted(); // the floating-point arithmetic of a draw costs a proof far more than it is worth; the tests
                         // cover the values
    contract::requires(__builtin_isfinite(uniform.low) && __builtin_isfinite(uniform.high) &&
                       uniform.low < uniform.high);
    contract::requires(__builtin_isfinite(uniform.high - uniform.low));
    U64 origin = origin_float(uniform.low, uniform.high);
    U64 grid = around(word(&key, 0) >> 40, origin, (U64)1 << 24);
    F32 value = uniform.low + mul_float(uniform.high - uniform.low, (F32)grid * 0x1p-24f);
    return value < uniform.high ? value : below_float(uniform.high);
}

[[std::c_name("smith_uniform_double_sample")]] export [[nodiscard]] F64 uniform_double_sample(Key key,
                                                                                              UniformDouble uniform) {
    contract::trusted(); // the floating-point arithmetic of a draw costs a proof far more than it is worth; the tests
                         // cover the values
    contract::requires(__builtin_isfinite(uniform.low) && __builtin_isfinite(uniform.high) &&
                       uniform.low < uniform.high);
    contract::requires(__builtin_isfinite(uniform.high - uniform.low));
    U64 origin = origin_double(uniform.low, uniform.high);
    U64 grid = around(word(&key, 0) >> 11, origin, (U64)1 << 53);
    F64 value = uniform.low + mul_double(uniform.high - uniform.low, (F64)grid * 0x1p-53);
    return value < uniform.high ? value : below_double(uniform.high);
}

// ---------------------------------------------------------------------------------------------------------------
// The normal distribution by inverse CDF: Michael J. Wichura, "The Percentage Points of the Normal Distribution",
// Algorithm AS 241, Applied Statistics 37 (3), 1988, pages 477-484. PPND16 (about 1e-16 relative) is in f64, with
// the coefficients as in R's src/nmath/qnorm.c; PPND7 (about 1e-7) is in f32, with the paper's coefficients. The
// probability comes from a midpoint grid, so it is never 0 or 1 and p and 1 - p are exact mirrors: the results are
// exact negatives. Reach: the smallest p is 2^-53 (about 8.2 deviations) for f64 and 2^-24 (about 5.3) for f32.

// The coefficients of AS241's rational approximations, lowest power first, as in R's qnorm.c: the centre in r =
// 0.180625
// - q^2, then the tails in r = sqrt(-log(p)) - 1.6 (p above exp(-25)) and r - 5 beyond.
const F64 ppnd16_a[8] = {3.387132872796366608,  133.14166789178437745, 1971.5909503065514427, 13731.693765509461125,
                         45921.953931549871457, 67265.770927008700853, 33430.575583588128105, 2509.0809287301226727};
const F64 ppnd16_b[8] = {1.0,
                         42.313330701600911252,
                         687.1870074920579083,
                         5394.1960214247511077,
                         21213.794301586595867,
                         39307.89580009271061,
                         28729.085735721942674,
                         5226.495278852854561};
const F64 ppnd16_c[8] = {1.42343711074968357734,   4.6303378461565452959,   5.7694972214606914055,
                         3.64784832476320460504,   1.27045825245236838258,  0.24178072517745061177,
                         0.0227238449892691845833, 7.7454501427834140764e-4};
const F64 ppnd16_d[8] = {1.0,
                         2.05319162663775882187,
                         1.6763848301838038494,
                         0.68976733498510000455,
                         0.14810397642748007459,
                         0.0151986665636164571966,
                         5.475938084995344946e-4,
                         1.05075007164441684324e-9};
const F64 ppnd16_e[8] = {6.6579046435011037772,     5.4637849111641143699,    1.7848265399172913358,
                         0.29656057182850489123,    0.026532189526576123093,  0.0012426609473880784386,
                         2.71155556874348757815e-5, 2.01033439929228813265e-7};
const F64 ppnd16_f[8] = {1.0,
                         0.59983220655588793769,
                         0.13692988092273580531,
                         0.0148753612908506148525,
                         7.868691311456132591e-4,
                         1.8463183175100546818e-5,
                         1.4215117583164458887e-7,
                         2.04426310338993978564e-15};

F64 ppnd16(F64 p) {
    F64 q = p - 0.5;
    if (__builtin_elementwise_abs(q) <= 0.425) {
        F64 r = 0.180625 - mul_double(q, q);
        return mul_double(q, horner_double(ppnd16_a, 8, r)) / horner_double(ppnd16_b, 8, r);
    }
    F64 tail = q < 0 ? p : 1.0 - p;
    F64 r = __builtin_elementwise_sqrt(-log_double(tail));
    F64 value = 0;
    if (r <= 5.0) {
        r += -1.6;
        value = horner_double(ppnd16_c, 8, r) / horner_double(ppnd16_d, 8, r);
    } else {
        r += -5.0;
        value = horner_double(ppnd16_e, 8, r) / horner_double(ppnd16_f, 8, r);
    }
    return q < 0 ? -value : value;
}

// PPND7: the paper's f32 coefficients, lowest power first (c and d for the tail to r = 5 and e and f beyond it, which
// the grid never reaches).
const F32 ppnd7_a[4] = {3.3871327179f, 50.434271938f, 159.29113202f, 59.109374720f};
const F32 ppnd7_b[4] = {1.0f, 17.895169469f, 78.757757664f, 67.187563600f};
const F32 ppnd7_c[4] = {1.4234372777f, 2.7568153900f, 1.3067284816f, 0.17023821103f};
const F32 ppnd7_d[3] = {1.0f, 0.73700164250f, 0.12021132975f};
const F32 ppnd7_e[4] = {6.6579051150f, 3.0812263860f, 0.42868294337f, 0.017337203997f};
const F32 ppnd7_f[3] = {1.0f, 0.24197894225f, 0.012258202635f};

F32 ppnd7(F32 p) {
    F32 q = p - 0.5f;
    if (__builtin_elementwise_abs(q) <= 0.425f) {
        F32 r = 0.180625f - mul_float(q, q);
        return mul_float(q, horner_float(ppnd7_a, 4, r)) / horner_float(ppnd7_b, 4, r);
    }
    F32 tail = q < 0 ? p : 1.0f - p;
    F32 r = __builtin_elementwise_sqrt(-log_float(tail));
    F32 value = 0;
    if (r <= 5.0f) {
        r -= 1.6f;
        value = horner_float(ppnd7_c, 4, r) / horner_float(ppnd7_d, 3, r);
    } else { // not reached by the grid, which stops at 2^-24; kept so the function is AS241's
        r -= 5.0f;
        value = horner_float(ppnd7_e, 4, r) / horner_float(ppnd7_f, 3, r);
    }
    return q < 0 ? -value : value;
}

// The midpoint-grid index is ordered by distance from the centre, so word 0 gives the u just above 0.5 (about the
// mean), word 1 the u just below it, and so on outwards. Only which word gives which u changes, not the u's.
F64 normal_u_double(Key key) {
    U64 grid = around(word(&key, 0) >> 12, (U64)1 << 51, (U64)1 << 52);
    return (F64)(grid * 2 + 1) * 0x1p-53;
}

F32 normal_u_float(Key key) {
    U64 grid = around(word(&key, 0) >> 41, (U64)1 << 22, (U64)1 << 23);
    return (F32)(grid * 2 + 1) * 0x1p-24f;
}

[[std::c_name("smith_normal_double_sample")]] export [[nodiscard]] F64 normal_double_sample(Key key,
                                                                                            NormalDouble normal) {
    contract::trusted(); // the polynomial of the normal quantile costs a proof far more than it is worth; the tests
                         // cover the values
    contract::requires(__builtin_isfinite(normal.mean) && __builtin_isfinite(normal.deviation) && normal.deviation > 0);
    return normal.mean + mul_double(normal.deviation, ppnd16(normal_u_double(key)));
}

[[std::c_name("smith_normal_float_sample")]] export [[nodiscard]] F32 normal_float_sample(Key key, NormalFloat normal) {
    contract::trusted(); // the polynomial of the normal quantile costs a proof far more than it is worth; the tests
                         // cover the values
    contract::requires(__builtin_isfinite(normal.mean) && __builtin_isfinite(normal.deviation) && normal.deviation > 0);
    return normal.mean + mul_float(normal.deviation, ppnd7(normal_u_float(key)));
}

// ---------------------------------------------------------------------------------------------------------------

[[std::c_name("smith_bernoulli_sample")]] export [[nodiscard]] Bool bernoulli_sample(Key key, Bernoulli bernoulli) {
    contract::requires(bernoulli.probability >= 0.0 && bernoulli.probability <= 1.0);
    U64 grid = word(&key, 0) >> 11; // the unit's grid index; reversed, so word 0 gives false
    return (F64)(((U64)1 << 53) - 1 - grid) * 0x1p-53 < bernoulli.probability;
}

// Writes 0..count-1 to out in a uniformly random order (Fisher-Yates); a count of 0 writes nothing.
[[std::c_name("smith_permutation_sample")]] export void permutation_sample(Key key, Permutation permutation,
                                                                           Usize *out) {
    contract::trusted(); // its loops run over the count, which has no bound a proof can use
    contract::requires(out != nullptr || permutation.count == 0);
    for (Usize i = 0; i < permutation.count; i++)
        out[i] = i;
    const Key *root = &key;
    for (Usize i = permutation.count; i > 1; i--) { // step i swaps position i - 1 with a position in [0, i)
        Key step = derive(root, i - 1);
        Usize j = i - 1 - (Usize)draw_index(&step, i); // index 0 swaps with itself
        Usize swap = out[i - 1];
        out[i - 1] = out[j];
        out[j] = swap;
    }
}
