// smith-build: link
// std::math, <smith/math.h>: the numbers a program asks of the machine, as functions of a type. Every export is a
// generic function, so it has no C spelling (the header holds only its record): C includes <math.h> and <stdint.h>,
// which are macros it can use. The functions are built on clang's builtins (a builtin is a function, not a macro), so a
// .smith file needs no `c::` name that is a C macro for any of them.
//
// A library joins when a caller needs it, never on speculation: this one holds what smith's own libraries
// ask today, and the first thing a second project needs beside it is the place to add it.
module std::math;

import std::math_trig;
import std::optimize;

// <smith/math.h>: whether x is neither infinite nor not-a-number. The type is x's: f32 or f64.
//
//   if (math::is_finite(x)) ...
//
// The constants are functions of a type no argument carries, called with the type where a value goes, as
// `arena::push(&a, Point)` is:
//
//   math::max(Usize)       the largest value of an unsigned integer type
//   math::infinity(F64)    positive infinity of a floating type (negate it for the other)
//   math::nan(F32)         a quiet not-a-number of a floating type
//
// They are always-inline functions of no arguments, so the optimizer folds each to the literal. A generic call is not a
// constant expression in C: in a `static_assert` or an array size write the number or a `constexpr` of the file.
export inline Bool is_finite(auto x) {
    return __builtin_isfinite(x);
}

// The square root of x, correctly rounded: the same bits as libm's sqrt for f64 and sqrtf for f32, which is what an
// IEEE machine's square root instruction gives. The result has the type of x, f32 or f64.
export inline typeof(x) sqrt(auto x) {
    return __builtin_elementwise_sqrt(x);
}

// The absolute value of x, the sign bit cleared (so the same as libm's fabs and fabsf). The type is x's: f32 or f64.
export inline typeof(x) abs(auto x) {
    return __builtin_elementwise_abs(x);
}

// x raised to the power y, the type is x's (f32 or f64): libm's pow and powf.
export inline typeof(x) pow(auto x, typeof(x) y) {
    return __builtin_elementwise_pow(x, y);
}

// The sine of x in radians. An f32 is std::math_trig's: within 1 ulp for |x| <= 2^20 and the same bits on every
// machine; an f64 is libm's sin. The type is x's.
export inline typeof(x) sin(auto x) {
    return math_trig::sin(x);
}

// The cosine of x in radians, as sin is. The type is x's.
export inline typeof(x) cos(auto x) {
    return math_trig::cos(x);
}

// The tangent of x in radians, as sin is (std::math_trig). The type is x's.
export inline typeof(x) tan(auto x) {
    return math_trig::tan(x);
}

// The angle equivalent to `angle` within [-pi, pi], for |angle| <= 2^20 (f32).
export F32 wrap(F32 angle) {
    return math_trig::wrap(angle);
}

// x limited to [low, high] (low <= high); a not-a-number x stays one. The type is x's.
export inline typeof(x) clamp(auto x, typeof(x) low, typeof(x) high) {
    return math_trig::clamp(x, low, high);
}

// a * (1 - t) + b * t: a at t = 0 and b at t = 1. The type is a's.
export inline typeof(a) lerp(auto a, typeof(a) b, typeof(a) t) {
    return math_trig::lerp(a, b, t);
}

// x times two to the power exponent: libm's ldexp and ldexpf. The type is x's; an f32 goes through
// f64 and back, which is exact.
export inline typeof(x) ldexp(auto x, I32 exponent) {
    return (typeof(x))__builtin_ldexp(x, exponent);
}

// The larger of a and b; when one is not-a-number the number wins, as fmax does. The type is a's.
export inline typeof(a) maximum(auto a, typeof(a) b) {
    return __builtin_elementwise_maxnum(a, b);
}

// The smaller of a and b; when one is not-a-number the number wins, as fmin does. The type is a's.
export inline typeof(a) minimum(auto a, typeof(a) b) {
    return __builtin_elementwise_minnum(a, b);
}

// The largest value of the unsigned integer type T: `math::max(Usize)` is what `SIZE_MAX` is.
export inline T max(constexpr Type T) {
    static_assert((T)-1 > 0, "math::max: the type is unsigned");
    return (T)-1;
}

// Positive infinity of the floating type T.
export inline T infinity(constexpr Type T) {
    return (T)__builtin_inf();
}

// A quiet not-a-number of the floating type T.
export inline T nan(constexpr Type T) {
    return (T)__builtin_nan("");
}

// ---------------------------------------------------------------------------------------------------------------
// The logarithm: fdlibm's e_log.c and e_logf.c (Copyright (C) 1993 by Sun Microsystems, Inc., permission to use, copy,
// modify and distribute is granted provided this notice is preserved), in the FreeBSD msun version. The exponent is
// split off through the bits, then an odd polynomial in s = f / (2 + f) gives log(1 + f). No tables. Within 1 ulp of
// the true value and the same bits on every platform, which libm's log does not promise. optimize::opaque is the
// barrier that keeps a product from being fused into the following addition.

inline F64 mul_double(F64 a, F64 b) {
    return optimize::opaque_f64(a * b);
}

inline F32 mul_float(F32 a, F32 b) {
    return optimize::opaque_f32(a * b);
}

F64 horner_double(const F64 *c, Usize count, F64 x) {
    c = (const F64 *)optimize::opaque_pointer(c);
    F64 sum = c[count - 1];
    for (Usize i = count - 1; i > 0; i--)
        sum = mul_double(sum, x) + c[i - 1];
    return sum;
}

U64 double_bits(F64 x) {
    return __builtin_bit_cast(U64, x);
}

F64 bits_double(U64 bits) {
    return __builtin_bit_cast(F64, bits);
}

U32 float_bits(F32 x) {
    return __builtin_bit_cast(U32, x);
}

F32 bits_float(U32 bits) {
    return __builtin_bit_cast(F32, bits);
}

constexpr F64 log_double_ln2_hi = 6.93147180369123816490e-01; // 3fe62e42 fee00000
constexpr F64 log_double_ln2_lo = 1.90821492927058770002e-10; // 3dea39ef 35793c76
constexpr F64 log_double_two54 = 1.80143985094819840000e+16;  // 2^54
constexpr F64 log_double_lg1 = 6.666666666666735130e-01;
constexpr F64 log_double_lg2 = 3.999999999940941908e-01;
constexpr F64 log_double_lg3 = 2.857142874366239149e-01;
constexpr F64 log_double_lg4 = 2.222219843214978396e-01;
constexpr F64 log_double_lg5 = 1.818357216161805012e-01;
constexpr F64 log_double_lg6 = 1.531383769920937332e-01;
constexpr F64 log_double_lg7 = 1.479819860511658591e-01;

// log(1 + f) for f in the range after reduction, with the exponent k added back.
F64 log_double_finish(F64 f, I32 k, U32 hx) {
    F64 s = f / (2.0 + f);
    F64 dk = (F64)k;
    F64 z = mul_double(s, s);
    F64 w = mul_double(z, z);
    U32 mixed =
        (hx - 0x6147a) | (0x6b851 - hx); // positive as a signed value: the range where log(1+f) = f - hfsq + ...
    static const F64 even[3] = {log_double_lg2, log_double_lg4, log_double_lg6};
    static const F64 odd[4] = {log_double_lg1, log_double_lg3, log_double_lg5, log_double_lg7};
    F64 t1 = mul_double(w, horner_double(even, 3, w));
    F64 t2 = mul_double(z, horner_double(odd, 4, w));
    F64 r = t2 + t1;
    if (mixed != 0 && mixed < 0x80000000U) {
        F64 hfsq = mul_double(mul_double(0.5, f), f);
        F64 inner = mul_double(s, hfsq + r);
        if (k == 0) return f - (hfsq - inner);
        return mul_double(dk, log_double_ln2_hi) - ((hfsq - (inner + mul_double(dk, log_double_ln2_lo))) - f);
    }
    F64 inner = mul_double(s, f - r);
    if (k == 0) return f - inner;
    return mul_double(dk, log_double_ln2_hi) - ((inner - mul_double(dk, log_double_ln2_lo)) - f);
}

[[std::c_name("smith_log_double")]] export [[nodiscard]] F64 log_double(F64 x) {
    U64 bits = double_bits(x);
    U32 hx = (U32)(bits >> 32); // fdlibm's signed hx is negative when hx >= 0x80000000 here
    U32 lx = (U32)bits;
    I32 k = 0;
    if (hx < 0x00100000 || hx >= 0x80000000U) { // x < 2^-1022, or negative
        if (((hx & 0x7fffffffU) | lx) == 0) return -infinity(F64);
        if (hx >= 0x80000000U) return nan(F64);
        k -= 54; // subnormal: scale up
        x *= log_double_two54;
        bits = double_bits(x);
        hx = (U32)(bits >> 32);
    }
    if (hx >= 0x7ff00000) return x + x; // inf or NaN
    k += (I32)(hx >> 20) - 1023;
    hx &= 0x000fffff;
    U32 half = (hx + 0x95f64) & 0x100000; // 0x100000 when x is above sqrt(2): use x/2
    bits = (bits & 0xffffffffULL) | ((U64)(hx | (half ^ 0x3ff00000)) << 32); // x or x/2, in [sqrt(2)/2, sqrt(2))
    x = bits_double(bits);
    k += (I32)(half >> 20);
    F64 f = x - 1.0;
    if ((0x000fffff & (2 + hx)) < 3) { // -2^-20 <= f < 2^-20
        if (f == 0.0) {
            if (k == 0) return 0.0;
            F64 dk = (F64)k;
            return mul_double(dk, log_double_ln2_hi) + mul_double(dk, log_double_ln2_lo);
        }
        F64 r = mul_double(mul_double(f, f), 0.5 - mul_double(0.33333333333333333, f));
        if (k == 0) return f - r;
        F64 dk = (F64)k;
        return mul_double(dk, log_double_ln2_hi) - ((r - mul_double(dk, log_double_ln2_lo)) - f);
    }
    return log_double_finish(f, k, hx);
}

constexpr F32 log_float_ln2_hi = 6.9313812256e-01f; // 0x3f317180
constexpr F32 log_float_ln2_lo = 9.0580006145e-06f; // 0x3717f7d1
constexpr F32 log_float_two25 = 3.355443200e+07f;   // 2^25
constexpr F32 log_float_lg1 = 0xaaaaaa.0p-24f;      // 0.66666662693
constexpr F32 log_float_lg2 = 0xccce13.0p-25f;      // 0.40000972152
constexpr F32 log_float_lg3 = 0x91e9ee.0p-25f;      // 0.28498786688
constexpr F32 log_float_lg4 = 0xf89e26.0p-26f;      // 0.24279078841

F32 log_float_finish(F32 f, I32 k, U32 ix) {
    F32 s = f / (2.0f + f);
    F32 dk = (F32)k;
    F32 z = mul_float(s, s);
    F32 w = mul_float(z, z);
    U32 mixed = (ix - (0x6147aU << 3)) | ((0x6b851U << 3) - ix);
    F32 t1 = mul_float(w, log_float_lg2 + mul_float(w, log_float_lg4));
    F32 t2 = mul_float(z, log_float_lg1 + mul_float(w, log_float_lg3));
    F32 r = t2 + t1;
    if (mixed != 0 && mixed < 0x80000000U) {
        F32 hfsq = mul_float(mul_float(0.5f, f), f);
        F32 inner = mul_float(s, hfsq + r);
        if (k == 0) return f - (hfsq - inner);
        return mul_float(dk, log_float_ln2_hi) - ((hfsq - (inner + mul_float(dk, log_float_ln2_lo))) - f);
    }
    F32 inner = mul_float(s, f - r);
    if (k == 0) return f - inner;
    return mul_float(dk, log_float_ln2_hi) - ((inner - mul_float(dk, log_float_ln2_lo)) - f);
}

// The natural logarithm the distributions use, fdlibm's algorithm: within 1 ulp of the true value and the same bits on
// every platform, which libm's log does not promise. 0 gives -inf, a negative gives NaN, inf gives inf, NaN gives NaN,
// and subnormals work.
[[std::c_name("smith_log_float")]] export [[nodiscard]] F32 log_float(F32 x) {
    U32 ix = float_bits(x);
    I32 k = 0;
    if (ix < 0x00800000 || ix >= 0x80000000U) { // x < 2^-126, or negative
        if ((ix & 0x7fffffffU) == 0) return -infinity(F32);
        if (ix >= 0x80000000U) return nan(F32);
        k -= 25; // subnormal: scale up
        x *= log_float_two25;
        ix = float_bits(x);
    }
    if (ix >= 0x7f800000) return x + x; // inf or NaN
    k += (I32)(ix >> 23) - 127;
    ix &= 0x007fffff;
    U32 half = (ix + (0x95f64U << 3)) & 0x800000; // 0x800000 when x is above sqrt(2): use x/2
    x = bits_float(ix | (half ^ 0x3f800000U));
    k += (I32)(half >> 23);
    F32 f = x - 1.0f;
    if ((0x007fffffU & (0x8000U + ix)) < 0xc000U) { // -2^-9 <= f < 2^-9
        if (f == 0.0f) {
            if (k == 0) return 0.0f;
            F32 dk = (F32)k;
            return mul_float(dk, log_float_ln2_hi) + mul_float(dk, log_float_ln2_lo);
        }
        F32 r = mul_float(mul_float(f, f), 0.5f - mul_float(0.33333333333333333f, f));
        if (k == 0) return f - r;
        F32 dk = (F32)k;
        return mul_float(dk, log_float_ln2_hi) - ((r - mul_float(dk, log_float_ln2_lo)) - f);
    }
    return log_float_finish(f, k, ix);
}

// ---------------------------------------------------------------------------------------------------------------

// The natural logarithm of x, fdlibm's algorithm: within 1 ulp of the true value and the same bits on every platform.
// 0 gives -inf, a negative gives NaN, inf gives inf, NaN gives NaN, and subnormals work. The type is x's: f32 or f64.
// C calls math::log_float and math::log_double: smith_log_float and smith_log_double.
export typeof(x) log(auto x) {
    if constexpr (typeof(x) == F32) {
        return log_float(x);
    } else {
        return log_double(x);
    }
}
