// Tests of std::contract, in smith's own test library; tests/contract_header_test.smith builds them in a scratch
// project as lib/std/contract_test.smith. A failed contract stops the program as an assert does, which
// test::expect_abort expects.
module std::contract_test;

import std::contract;
import std::test;

static I32 clamp(I32 x, I32 low, I32 high) {
    contract::requires(low <= high);
    const I32 result = x < low ? low : x > high ? high : x;
    contract::ensures(low <= result && result <= high);
    return result;
}

static I32 wrong(I32 x) {
    const I32 result = x + 1;
    contract::ensures(result == x);
    return result;
}

static I32 sum(I32 count) {
    I32 total = 0;
    for (I32 i = 0; i < count; i++) {
        contract::invariant(total == i * 2);
        total += 2;
        if (i == 2) total += 1; // breaks the invariant on the next pass
    }
    return total;
}

export void test_contract_true_contracts_pass() {
    test::check_equal(clamp(5, 1, 3), 3);
    test::check_equal(clamp(-5, 1, 3), 1);
    test::check_equal(clamp(2, 1, 3), 2);
    test::check_equal(sum(2), 4);
}

export void test_contract_a_false_requires_stops() {
    test::expect_abort();
    (void)clamp(0, 3, 1);
}

export void test_contract_a_false_ensures_stops() {
    test::expect_abort();
    (void)wrong(1);
}

export void test_contract_a_false_invariant_stops() {
    test::expect_abort();
    (void)sum(5);
}

// The front end's arithmetic checks (#1542): each stops as a failed contract does.
export void test_contract_a_failed_overflow_stops() {
    test::expect_abort();
    contract::fail_overflow("+", 2147483647, 1, "I32", " at t.smith:2:12");
}

export void test_contract_a_failed_negate_stops() {
    test::expect_abort();
    contract::fail_negate(0xFFFFFFFF80000000ULL, "I32", " at t.smith:2:12");
}

export void test_contract_a_failed_divide_stops() {
    test::expect_abort();
    contract::fail_divide("/", 7, 1, " at t.smith:2:12");
}

export void test_contract_a_failed_shift_stops() {
    test::expect_abort();
    contract::fail_shift("<<", 1, 40, 1, 32, "I32", " at t.smith:2:12");
}
