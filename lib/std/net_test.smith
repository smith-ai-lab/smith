// Tests of std::net, in smith's own test library (build.c's `test-units` runner links them with the module): the
// calls over the fake net handler, which a test sets and restores with `defer`, and a few over real loopback sockets
// (a listener on 127.0.0.1 and a client of it in the same thread; no test needs the internet, and the real TLS stack
// is not exercised, since a handshake needs a server with a certificate). The memory the fake keeps is the current
// allocator's, so each test installs an arena first (a test runs under mem::checked, which fails a block that is not
// freed). The checked failures (a double close, a read that would wait for ever) stop the process and are not tested
// here.
module std::net_test;

import std::arena;
import std::clock;
import std::mem;
import std::net;
import std::test;

// Unwrapping for the checks: the value of a result (a zero when it is an error: the test checked `== .ok` before) and
// the error (a zero when it is a value).
net::Connection value_connection(net::ConnectionResult r) {
    switch (r) {
    case .ok:
        return r.ok;
    case .error:
        return (net::Connection){.descriptor = -1};
    }
}

net::Listener value_listener(net::ListenerResult r) {
    switch (r) {
    case .ok:
        return r.ok;
    case .error:
        return (net::Listener){.descriptor = -1};
    }
}

Usize value_count(net::CountResult r) {
    switch (r) {
    case .ok:
        return r.ok;
    case .error:
        return ~(Usize)0;
    }
}

net::Error failure_connection(net::ConnectionResult r) {
    switch (r) {
    case .ok:
        return net::Other;
    case .error:
        return r.error;
    }
}

net::Error failure_listener(net::ListenerResult r) {
    switch (r) {
    case .ok:
        return net::Other;
    case .error:
        return r.error;
    }
}

net::Error failure_count(net::CountResult r) {
    switch (r) {
    case .ok:
        return net::Other;
    case .error:
        return r.error;
    }
}

// Whether the bytes are the text.
bool is_text(net::Bytes got, const char *text) {
    Usize length = __builtin_strlen(text);
    if (countof(got) != length) return false;
    for (Usize i = 0; i < length; i++) {
        if (got[i] != (U8)text[i]) return false;
    }
    return true;
}

const U8 *bytes_of(const char *text) {
    return (const U8 *)text;
}

// Reads a connection to its end (a test's peer sends a few pieces).
Usize read_all(net::Connection *connection, U8 buffer[:]) {
    Usize filled = 0;
    for (Usize rounds = 0; rounds < 64; rounds++) {
        U8 room[:] = buffer[filled:];
        net::CountResult step = net::read(connection, room);
        Usize count = value_count(step);
        if (step == .error || count == 0) break;
        filled += count;
    }
    return filled;
}

export void test_net_a_scripted_server_answers_a_request_in_pieces_and_records_it() {
    arena::Arena a = test::memory(1 << 16);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    net::Fake fake = net::fake();
    net::fake_add(&fake, (net::Server){.host = "example.com", .port = 443, .response = "HTTP/1.1 200 OK", .chunk = 4});
    net::Handler *before = net::set_handler(&fake.base);
    defer net::set_handler(before);

    net::ConnectionResult made = net::connect_tls("example.com", 443);
    test::check_condition(made == .ok);
    net::Connection connection = value_connection(made);
    test::check_equal(value_count(net::write(&connection, bytes_of("GET /")[0:5])), 5);
    U8 buffer[:] = mem::alloc_slice(U8, 32);
    net::CountResult first = net::read(&connection, buffer);
    test::check_equal(value_count(first), 4);
    Usize rest = read_all(&connection, buffer[4:]);
    test::check_equal(rest, 11);
    test::check_condition(is_text(buffer[0:15], "HTTP/1.1 200 OK"));
    net::CountResult end = net::read(&connection, buffer);
    test::check_equal(value_count(end), 0);
    test::check_condition(is_text(net::fake_sent(&fake, connection.id), "GET /"));
    net::close(&connection);
}

export void test_net_a_host_with_no_script_is_refused_and_a_script_can_fail_a_connect() {
    net::Fake fake = net::fake();
    net::fake_add(&fake, (net::Server){.host = "down", .port = 80, .fails = true, .error = net::TimedOut});
    net::fake_add(&fake, (net::Server){.host = "old", .port = 443, .fails = true, .error = net::Expired});
    net::fake_add(&fake, (net::Server){.host = "other", .port = 443, .fails = true, .error = net::WrongHost});
    net::Handler *before = net::set_handler(&fake.base);
    defer net::set_handler(before);

    test::check_condition(failure_connection(net::connect("nothing", 80)) == net::Refused);
    test::check_condition(failure_connection(net::connect("down", 80)) == net::TimedOut);
    test::check_condition(failure_connection(net::connect_tls("old", 443)) == net::Expired);
    test::check_condition(failure_connection(net::connect_tls("other", 443)) == net::WrongHost);
    test::check_condition(failure_connection(net::connect("down", 80)) == net::Refused); // its script is used
}

export void test_net_two_connects_to_one_host_use_two_scripts() {
    arena::Arena a = test::memory(1 << 16);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    net::Fake fake = net::fake();
    net::fake_add(&fake, (net::Server){.host = "api", .port = 80, .response = "one"});
    net::fake_add(&fake, (net::Server){.host = "api", .port = 80, .response = "two"});
    net::Handler *before = net::set_handler(&fake.base);
    defer net::set_handler(before);

    net::Connection first = value_connection(net::connect("api", 80));
    net::Connection second = value_connection(net::connect("api", 80));
    U8 buffer[:] = mem::alloc_slice(U8, 8);
    Usize got = read_all(&first, buffer);
    test::check_condition(is_text(buffer[0:got], "one"));
    got = read_all(&second, buffer);
    test::check_condition(is_text(buffer[0:got], "two"));
    net::close(&first);
    net::close(&second);
    net::ConnectionResult third = net::connect("api", 80); // no third script
    test::check_condition(third == .error);
}

export void test_net_a_fake_listener_pairs_a_client_with_the_accepted_connection() {
    arena::Arena a = test::memory(1 << 16);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    net::Fake fake = net::fake();
    net::Handler *before = net::set_handler(&fake.base);
    defer net::set_handler(before);

    net::ListenerResult listening = net::listen("127.0.0.1", 0);
    test::check_condition(listening == .ok);
    net::Listener listener = value_listener(listening);
    test::check_condition(listener.port != 0);
    net::Connection client = value_connection(net::connect("127.0.0.1", listener.port));
    net::Connection server = value_connection(net::accept(&listener));
    test::check_equal(value_count(net::write(&client, bytes_of("ping")[0:4])), 4);
    U8 buffer[:] = mem::alloc_slice(U8, 16);
    test::check_equal(value_count(net::read(&server, buffer)), 4);
    test::check_condition(is_text(buffer[0:4], "ping"));
    test::check_equal(value_count(net::write(&server, bytes_of("pong!")[0:5])), 5);
    test::check_equal(value_count(net::read(&client, buffer)), 5);
    test::check_condition(is_text(net::fake_sent(&fake, server.id), "pong!"));
    net::close(&client);
    test::check_equal(value_count(net::read(&server, buffer)), 0); // the end: the client has closed
    net::CountResult late = net::write(&server, bytes_of("x")[0:1]);
    test::check_condition(late == .error && failure_count(late) == net::Reset);
    net::close(&server);
    net::stop(&listener);
}

export void test_net_a_port_held_by_a_listener_is_in_use_until_it_stops() {
    net::Fake fake = net::fake();
    net::Handler *before = net::set_handler(&fake.base);
    defer net::set_handler(before);

    net::Listener one = value_listener(net::listen("127.0.0.1", 8080));
    test::check_equal(one.port, 8080);
    test::check_condition(failure_listener(net::listen("127.0.0.1", 8080)) == net::InUse);
    net::stop(&one);
    net::Listener again = value_listener(net::listen("127.0.0.1", 8080));
    test::check_equal(again.port, 8080);
    net::stop(&again);
}

export void test_net_the_handler_setter_returns_the_one_before_it() {
    net::Fake one = net::fake();
    net::Fake two = net::fake();
    net::Handler *outside = net::set_handler(&one.base);
    test::check_condition(net::current_handler() == &one.base);
    net::Handler *middle = net::set_handler(&two.base);
    test::check_condition(middle == &one.base);
    test::check_condition(net::set_handler(outside) == &two.base);
    test::check_condition(net::current_handler() == outside);
}

export void test_net_real_loopback_sockets_carry_bytes_both_ways_and_end_when_closed() {
    net::ListenerResult listening = net::listen("127.0.0.1", 0);
    test::check_condition(listening == .ok);
    net::Listener listener = value_listener(listening);
    test::check_condition(listener.port != 0);
    net::ConnectionResult dialed = net::connect("127.0.0.1", listener.port);
    test::check_condition(dialed == .ok);
    net::Connection client = value_connection(dialed);
    net::ConnectionResult accepted = net::accept(&listener);
    test::check_condition(accepted == .ok);
    net::Connection server = value_connection(accepted);

    test::check_equal(value_count(net::write(&client, bytes_of("hello")[0:5])), 5);
    U8 buffer[16];
    test::check_equal(value_count(net::read(&server, buffer[0:16])), 5);
    test::check_condition(is_text(buffer[0:5], "hello"));
    test::check_equal(value_count(net::write(&server, bytes_of("hi")[0:2])), 2);
    test::check_equal(value_count(net::read(&client, buffer[0:16])), 2);
    test::check_condition(is_text(buffer[0:2], "hi"));

    net::close(&server);
    test::check_equal(value_count(net::read(&client, buffer[0:16])), 0); // the end
    net::close(&client);
    net::stop(&listener);
}

export void test_net_a_real_connect_to_a_port_nobody_listens_on_is_refused() {
    net::Listener listener = value_listener(net::listen("127.0.0.1", 0));
    U16 port = listener.port;
    net::stop(&listener); // the port is free again
    net::ConnectionResult dialed = net::connect("127.0.0.1", port);
    test::check_condition(dialed == .error);
    test::check_condition(failure_connection(dialed) == net::Refused);
}

export void test_net_a_real_listener_on_a_taken_port_is_in_use() {
    net::Listener one = value_listener(net::listen("127.0.0.1", 0));
    net::ListenerResult second = net::listen("127.0.0.1", one.port);
    test::check_condition(second == .error);
    test::check_condition(failure_listener(second) == net::InUse);
    net::stop(&one);
}

export void test_net_a_real_write_to_a_closed_peer_is_reset_and_never_a_signal() {
    net::Listener listener = value_listener(net::listen("127.0.0.1", 0));
    net::Connection client = value_connection(net::connect("127.0.0.1", listener.port));
    net::Connection server = value_connection(net::accept(&listener));
    net::close(&server);
    bool reset = false;
    for (Usize attempt = 0; attempt < 64 && !reset;
         attempt++) { // the first writes may be taken before the reset arrives
        clock::sleep(1'000'000);
        net::CountResult sent = net::write(&client, bytes_of("data")[0:4]);
        reset = sent == .error && failure_count(sent) == net::Reset;
    }
    test::check_condition(reset);
    net::close(&client);
    net::stop(&listener);
}

export void test_net_read_within_on_the_fake_returns_what_is_there_and_times_out_at_once_when_nothing_is_left() {
    arena::Arena a = test::memory(1 << 16);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    net::Fake fake = net::fake();
    net::fake_add(&fake, (net::Server){.host = "quiet", .port = 80, .response = "partial", .stalls = true});
    net::fake_add(&fake, (net::Server){.host = "done", .port = 80, .response = "all"});
    net::fake_add(&fake, (net::Server){.host = "broken", .port = 80, .response = "x", .resets = true});
    net::Handler *before = net::set_handler(&fake.base);
    defer net::set_handler(before);

    U8 buffer[:] = mem::alloc_slice(U8, 16);
    net::Connection quiet = value_connection(net::connect("quiet", 80));
    test::check_equal(value_count(net::read_within(&quiet, buffer, 1'000'000'000)), 7);
    net::CountResult silent = net::read_within(&quiet, buffer, 1'000'000'000);
    test::check_condition(silent == .error && failure_count(silent) == net::TimedOut);
    net::close(&quiet);

    net::Connection done = value_connection(net::connect("done", 80));
    test::check_equal(value_count(net::read_within(&done, buffer, 1'000'000'000)), 3);
    test::check_equal(value_count(net::read_within(&done, buffer, 1'000'000'000)), 0); // the end is not a timeout
    net::close(&done);

    net::Connection broken = value_connection(net::connect("broken", 80));
    test::check_equal(value_count(net::read_within(&broken, buffer, 1'000'000'000)), 1);
    net::CountResult reset = net::read_within(&broken, buffer, 1'000'000'000);
    test::check_condition(reset == .error && failure_count(reset) == net::Reset);
    net::close(&broken);
}

export void test_net_read_within_on_a_real_socket_times_out_when_the_peer_sends_nothing_and_reads_what_comes() {
    net::Listener listener = value_listener(net::listen("127.0.0.1", 0));
    net::Connection client = value_connection(net::connect("127.0.0.1", listener.port));
    net::Connection server = value_connection(net::accept(&listener));
    U8 buffer[16];
    net::CountResult silent = net::read_within(&client, buffer[0:16], 20'000'000); // 20 ms
    test::check_condition(silent == .error && failure_count(silent) == net::TimedOut);

    test::check_equal(value_count(net::write(&server, bytes_of("late")[0:4])), 4);
    test::check_equal(value_count(net::read_within(&client, buffer[0:16], 5'000'000'000)), 4);
    test::check_condition(is_text(buffer[0:4], "late"));

    net::close(&server);
    test::check_equal(value_count(net::read_within(&client, buffer[0:16], 5'000'000'000)), 0); // the end
    net::close(&client);
    net::stop(&listener);
}
