// smith-build: link
// std::text, <smith/text.h>: reading and writing small text formats by hand. Its C API is the generated header
// include/smith/text.h (a build output, not in git). Every export has a short name here and a C
// name (the attribute before it): `text::make` is `smith_text_make`. The comments above an
// export are the header's doc comments, so they name the Smith names; the first one says how a C name follows from
// them.
module std::text;

import std::contract;
import <errno.h>;
import std::mem;

// <smith/text.h>: reading and writing small text formats by hand, such as replays, scripts, configs and logs. It calls
// no C library function and no locale, so a number written here reads back as the same value on any machine. Text is a
// `char[:]`, a pointer and a count, never a terminated string, so a file read into memory is read where it lies, and
// every loop is bounded by a length.
//
// Names. The module's names are short (text::make, text::take_line, text::parse_u64). In C a function is
// smith_text_<name> (smith_text_make) and text is the slice struct `struct smith_array_const_char_n` (`.data`,
// `.count[0]`); the capacities are smith_text_number_capacity and smith_text_f64_capacity.
//
//   const char text[:] = "move 3 4\nturn -90 # left\n";
//   const char line[:];
//   const char word[:];
//   while (text::take_line(&text, &line)) {
//       if (!text::take_word(&line, &word)) continue;      // a blank line
//       if (text::is(word, "move")) { ... }
//   }
//
// In C, the same:
//   struct smith_array_const_char_n text = smith_text_make("move 3 4\nturn -90 # left\n");
//   struct smith_array_const_char_n line, word;
//   while (smith_text_take_line(&text, &line)) {
//       if (!smith_text_take_word(&line, &word)) continue;      // a blank line
//       if (smith_text_is(word, "move")) { ... }
//   }
//
// A parse that fails returns false and writes nothing to its result. A write never fails: the caller gives room for
// number_capacity characters.
//
// Writes a number into out, which has room for number_capacity characters, and returns how many it wrote.
// There is no terminator.
export constexpr Usize number_capacity = 20;

// Room for write_f64.
export constexpr Usize f64_capacity = 32;

// Room for write_f32.
export constexpr Usize f32_capacity = 24;

// The text of a terminated string, without its terminator. It points into the string; nothing is copied.
[[std::c_name("smith_text_make")]] export [[nodiscard]] typeof(const char[:]) make(const char *string) {
    Usize length = 0;
    while (string[length] != '\0') {
        length += 1;
    }
    return string[0:length];
}

// A check that stays in every build and is no contract the prover reads: the bignum arithmetic and the float text of
// this module cost the prover far more than they are worth, so a proof of a caller assumes the check held. Trusted, its
// body is never read, so the assert is a run-time check: it writes the failure report (the line of the call and the
// stack) in every build.
void check(Bool holds) {
    contract::trusted();
    contract::assert(holds);
    if (!holds) __builtin_trap();
}

Bool is_space(char c) {
    return c == ' ' || c == '\t';
}

// Takes the next line off text into line, without its newline, a trailing carriage return, or a # comment and the
// spaces before it. Returns false once text is empty.
[[std::c_name("smith_text_take_line")]] export [[nodiscard]] Bool take_line(typeof(const char[:]) *text,
                                                                            typeof(const char[:]) *line) {
    const char all[:] = *text; // locals: a write through `line` cannot change what the checks below read
    Usize count = countof(all);
    if (count == 0) return false;
    Usize length = 0;
    while (length < count && all[length] != '\n') {
        length += 1;
    }
    // The minimums say what the loops show (at most count, at most length), in a form the prover reads: the checks of
    // the cuts below are then plain facts, and the function has nothing left to prove about a loop.
    length = __builtin_elementwise_min(length, count);
    const char whole[:] = all[0:length];
    *text = all[__builtin_elementwise_min(length + 1, count):]; // the newline too
    Usize end = 0; // one past the last character before a comment that is not a space, a tab or a carriage return
    for (Usize i = 0; i < length && whole[i] != '#'; i++) {
        if (!is_space(whole[i]) && whole[i] != '\r') end = i + 1;
    }
    *line = whole[0:__builtin_elementwise_min(end, length)];
    return true;
}

// Takes the next word off line, a run without spaces or tabs, into word. Returns false when only spaces are left.
[[std::c_name("smith_text_take_word")]] export [[nodiscard]] Bool take_word(typeof(const char[:]) *line,
                                                                            typeof(const char[:]) *word) {
    const char rest[:] = *line;
    while (countof(rest) > 0 && is_space(rest[0])) {
        rest = rest[1:];
    }
    Usize length = 0;
    while (length < countof(rest) && !is_space(rest[length])) {
        length += 1;
    }
    length = __builtin_elementwise_min(length, countof(rest));
    *line = rest[length:];
    *word = rest[0:length];
    return length > 0;
}

// Whether word is exactly the terminated string.
[[std::c_name("smith_text_is")]] export [[nodiscard]] Bool is(const char word[:], const char *string) {
    for (Usize i = 0; i < countof(word); i++) {
        if (string[i] != word[i]) return false; // a shorter string ends in its terminator, which no word has
    }
    return string[countof(word)] == '\0';
}

// ---------------------------------------------------------------------------------------------------------------
// Whole numbers

constexpr U64 u64_max = ~(U64)0;
constexpr I64 i64_max = (I64)(u64_max >> 1);

// Whole numbers: decimal digits, with an optional leading - for the signed one, or lowercase hexadecimal digits.
// Leading zeros of any number are fine. Each returns false for an empty word, a stray character (a +, a space, a
// capital hex digit) or a value that doesn't fit.
// The digits of word from start on (start is 0, or 1 after a minus sign).
Bool parse_digits(const char word[:], Usize start, U64 *value) {
    if (start >= countof(word)) return false;
    U64 result = 0;
    for (Usize i = start; i < countof(word); i++) {
        char c = word[i];
        if (c < '0' || c > '9') return false;
        U64 digit = (U64)(c - '0');
        if (result > (u64_max - digit) / 10) return false;
        result = result * 10 + digit;
    }
    *value = result;
    return true;
}

[[std::c_name("smith_text_parse_u64")]] export [[nodiscard]] Bool parse_u64(const char word[:], U64 *value) {
    return parse_digits(word, 0, value);
}

[[std::c_name("smith_text_parse_i64")]] export [[nodiscard]] Bool parse_i64(const char word[:], I64 *value) {
    Bool negative = countof(word) > 0 && word[0] == '-';
    U64 magnitude = 0;
    if (!parse_digits(word, negative ? 1 : 0, &magnitude)) return false;
    U64 limit = negative ? (U64)i64_max + 1 : (U64)i64_max;
    if (magnitude > limit) return false;
    *value = negative ? (I64)(0 - magnitude) : (I64)magnitude;
    return true;
}

[[std::c_name("smith_text_parse_hex")]] export [[nodiscard]] Bool parse_hex(const char word[:], U64 *value) {
    if (countof(word) == 0) return false;
    U64 result = 0;
    for (Usize i = 0; i < countof(word); i++) {
        char c = word[i];
        U64 digit = 0;
        if (c >= '0' && c <= '9')
            digit = (U64)(c - '0');
        else if (c >= 'a' && c <= 'f')
            digit = (U64)(c - 'a') + 10;
        else
            return false;
        if ((result >> 60) != 0) return false; // another digit would push a one out of the top
        result = (result << 4) | digit;
    }
    *value = result;
    return true;
}

// ---------------------------------------------------------------------------------------------------------------
// Decimal to f32 or f64, correctly rounded. A decimal is digits D (an integer) times 10^exp10. Two paths give the
// nearest value:
//  - the fast path, for D below 10^15 and a power of ten up to 22, where D and the power are exact f64s, so one
//    multiply or divide is the F64 nearest the number. For a F64 that is the answer; for a F32, rounding it
//    again is right unless it sits exactly halfway between two floats (which it hands to the slow path);
//  - the slow path, exact: the number as a ratio of two big integers, divided to p + 2 bits and rounded by hand.
// Digits past the first 800 cannot change a result: a f64, or the point halfway between two, has at most 767
// significant digits (a f32's, 115), so any longer decimal differs from all of them, and the value between D and
// D + 1 rounds like D followed by a 1, which is what a nonzero tail becomes.

constexpr Usize digits_max = 800;
constexpr Usize big_limbs = 128; // 4096 bits; the largest number below is about 3800, for a f64
constexpr I64 exponent_max = 1'000'000;
constexpr Usize fast_digits_max = 15;
constexpr I64 fast_exponent_max = 22;
constexpr U32 chunk_digits = 9;

// What differs between the two formats the slow path rounds to.
typedef struct {
    U32 mantissa_bits;     // 24 for a f32, 53 for a f64
    I64 smallest_exponent; // the last place of a subnormal is 2^smallest_exponent
    I64 field_offset;      // the exponent field of kept * 2^e is e + field_offset
    I64 field_infinity;    // the field of infinity
} Format;

constexpr U32 infinity_bits = 0x7f800000;
constexpr U64 double_infinity_bits = 0x7ff0000000000000;

constexpr Format float_format = {24, -149, 150, 255};
constexpr Format double_format = {53, -1074, 1075, 2047};

const F64 powers[fast_exponent_max + 1] = {
    1e0,  1e1,  1e2,  1e3,  1e4,  1e5,  1e6,  1e7,  1e8,  1e9,  1e10, 1e11,
    1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22,
};

constexpr U32 powers_u32[chunk_digits + 1] = {
    1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000, 1000000000,
};

// An unsigned integer of up to 1024 bits, little-endian in 32-bit limbs. `count` limbs are in use, the top one nonzero.
typedef struct {
    U32 limb[big_limbs];
    Usize count;
} Big;

// big = big * multiplier + addend.
void big_mul_add(Big *big, U32 multiplier, U32 addend) {
    U64 carry = addend;
    for (Usize i = 0; i < big->count; i++) {
        U64 product = (U64)big->limb[i] * multiplier + carry;
        big->limb[i] = (U32)product;
        carry = product >> 32;
    }
    if (carry != 0) {
        check(big->count < big_limbs); // a number grew past its limbs
        big->limb[big->count] = (U32)carry;
        big->count += 1;
    }
}

// big = big * 10^power.
void big_mul_pow10(Big *big, U64 power) {
    while (power >= chunk_digits) {
        big_mul_add(big, powers_u32[chunk_digits], 0);
        power -= chunk_digits;
    }
    big_mul_add(big, powers_u32[power], 0);
}

U64 big_bits(const Big *big) {
    if (big->count == 0) return 0;
    U32 top = big->limb[big->count - 1];
    U64 bits = (U64)(big->count - 1) * 32;
    while (top != 0) {
        bits += 1;
        top >>= 1;
    }
    return bits;
}

void big_shift_left(Big *big, U64 shift) {
    if (big->count == 0 || shift == 0) return;
    Usize whole = (Usize)(shift / 32);
    U32 part = (U32)(shift % 32);
    check(big->count + whole + 1 <= big_limbs); // a shift grew a number past its limbs
    big->limb[big->count + whole] = 0;
    for (Usize i = big->count; i-- > 0;) {
        U64 moved = (U64)big->limb[i] << part;
        big->limb[i + whole + 1] |= (U32)(moved >> 32);
        big->limb[i + whole] = (U32)moved;
    }
    for (Usize i = 0; i < whole; i++) {
        big->limb[i] = 0;
    }
    big->count += whole + 1;
    while (big->count > 0 && big->limb[big->count - 1] == 0) {
        big->count -= 1;
    }
}

void big_shift_right_one(Big *big) {
    for (Usize i = 0; i < big->count; i++) {
        U32 above = i + 1 < big->count ? big->limb[i + 1] : 0;
        big->limb[i] = (big->limb[i] >> 1) | (above << 31);
    }
    for (Usize pass = 0; pass < big_limbs && big->count > 0 && big->limb[big->count - 1] == 0; pass++) {
        big->count -= 1;
    }
}

Bool big_at_least(const Big *a, const Big *b) {
    if (a->count != b->count) return a->count > b->count;
    for (Usize i = a->count; i-- > 0;) {
        if (a->limb[i] != b->limb[i]) return a->limb[i] > b->limb[i];
    }
    return true;
}

// a = a - b, where a >= b.
void big_subtract(Big *a, const Big *b) {
    U64 borrow = 0;
    for (Usize i = 0; i < a->count; i++) {
        U64 take = (i < b->count ? b->limb[i] : 0) + borrow;
        borrow = a->limb[i] < take ? 1 : 0;
        a->limb[i] = (U32)((U64)a->limb[i] - take);
    }
    check(borrow == 0); // a subtraction went below zero
    while (a->count > 0 && a->limb[a->count - 1] == 0) {
        a->count -= 1;
    }
}

// The bits nearest to numerator / denominator in a format, ties to even, or the infinity bits if that is out of range.
U64 ratio_to_bits(const Format *format, Big numerator, Big denominator) {
    // Scale so that numerator / denominator, times 2^scale, lies in (2^p, 2^(p+2)) for p mantissa bits: its integer
    // part q has p + 1 or p + 2 bits, and the remainder says what is left of the last one.
    I64 p = format->mantissa_bits;
    I64 scale = p + 1 - ((I64)big_bits(&numerator) - (I64)big_bits(&denominator));
    if (scale >= 0)
        big_shift_left(&numerator, (U64)scale);
    else
        big_shift_left(&denominator, (U64)(0 - scale));
    Big step = denominator;
    big_shift_left(&step, (U64)(p + 1));
    U64 q = 0;
    for (U32 bit = format->mantissa_bits + 2; bit-- > 0;) {
        if (big_at_least(&numerator, &step)) {
            big_subtract(&numerator, &step);
            q |= (U64)1 << bit;
        }
        big_shift_right_one(&step);
    }
    // The number is (q + numerator / denominator) * 2^-scale. Keep p bits, or fewer where the result is subnormal,
    // and round by the bits dropped.
    I64 drop = (q >> (format->mantissa_bits + 1)) != 0 ? 2 : 1;
    if (scale + format->smallest_exponent > drop) drop = scale + format->smallest_exponent;
    if (drop > p + 2) return 0;
    U64 shift = (U64)drop;
    U64 kept = q >> shift;
    U64 low = q & (((U64)1 << shift) - 1);
    U64 half = (U64)1 << (shift - 1);
    if (low > half || (low == half && (numerator.count != 0 || (kept & 1) != 0))) kept += 1;
    I64 exponent = drop - scale; // the number is kept * 2^exponent
    U64 one = (U64)1 << (format->mantissa_bits - 1);
    if (exponent + format->field_offset >= format->field_infinity) return (U64)format->field_infinity * one;
    // A normal number's top bit carries into the exponent field, which also rounds 2^p up to the next power of two.
    return (U64)(exponent + format->field_offset) * one + kept - one;
}

// What the scan of a decimal found.
typedef struct {
    Big digits;
    U64 small; // the digits as an integer, good while there are at most 19
    Usize significant;
    U32 chunk;
    U32 chunk_length;
    I64 exp10;
    Bool sticky; // nonzero digits were dropped past the 800th
} Decimal;

// An empty decimal. The limbs are left alone: only the first `count` of them are ever read, and zeroing 512 bytes
// would cost more than the whole parse of a short number.
void decimal_init(Decimal *decimal) {
    decimal->digits.count = 0;
    decimal->small = 0;
    decimal->significant = 0;
    decimal->chunk = 0;
    decimal->chunk_length = 0;
    decimal->exp10 = 0;
    decimal->sticky = false;
}

void decimal_add_digit(Decimal *decimal, U32 digit, Bool in_fraction) {
    if (decimal->significant == 0 && digit == 0) { // a leading zero adds nothing but a place
        if (in_fraction) decimal->exp10 -= 1;
        return;
    }
    if (decimal->significant >= digits_max) {
        if (digit != 0) decimal->sticky = true;
        if (!in_fraction) decimal->exp10 += 1;
        return;
    }
    decimal->significant += 1;
    decimal->small = decimal->small * 10 + digit;
    decimal->chunk = decimal->chunk * 10 + digit;
    decimal->chunk_length += 1;
    if (decimal->chunk_length == chunk_digits) {
        big_mul_add(&decimal->digits, powers_u32[chunk_digits], decimal->chunk);
        decimal->chunk = 0;
        decimal->chunk_length = 0;
    }
    if (in_fraction) decimal->exp10 -= 1;
}

// Reads digits with at most one point from word[*index], and returns whether there was a digit.
Bool decimal_scan_mantissa(const char word[:], Usize *index, Decimal *decimal) {
    Bool in_fraction = false;
    Bool any = false;
    Usize i = *index;
    for (; i < countof(word); i++) {
        char c = word[i];
        if (c == '.' && !in_fraction) {
            in_fraction = true;
        } else if (c >= '0' && c <= '9') {
            decimal_add_digit(decimal, (U32)(c - '0'), in_fraction);
            any = true;
        } else {
            break;
        }
    }
    *index = i;
    return any;
}

// Reads an optional exponent at word[*index] into exp10, and returns false for an e with no digits.
Bool decimal_scan_exponent(const char word[:], Usize *index, Decimal *decimal) {
    Usize i = *index;
    if (i >= countof(word)) return true;
    char marker = word[i];
    if (marker != 'e' && marker != 'E') return true;
    i += 1;
    Bool negative = i < countof(word) && word[i] == '-';
    if (i < countof(word) && (word[i] == '-' || word[i] == '+')) i += 1;
    U64 magnitude = 0; // unsigned: at most exponent_max * 10 + 9, which no checked signed arithmetic needs to show
    Usize digits = 0;
    for (; i < countof(word) && word[i] >= '0' && word[i] <= '9'; i++) {
        if (magnitude < (U64)exponent_max) magnitude = magnitude * 10 + (U64)(word[i] - '0');
        digits += 1;
    }
    if (digits == 0) return false;
    decimal->exp10 =
        (I64)((U64)decimal->exp10 + (negative ? 0 - magnitude : magnitude)); // two's complement, no overflow
    *index = i;
    return true;
}

// The exact path: the digits over a power of ten, as a ratio of big integers.
U64 decimal_exact(const Decimal *decimal, const Format *format) {
    Big numerator = decimal->digits;
    Big denominator = {.limb = {1}, .count = 1};
    if (decimal->exp10 >= 0)
        big_mul_pow10(&numerator, (U64)decimal->exp10);
    else
        big_mul_pow10(&denominator, (U64)(0 - decimal->exp10));
    return ratio_to_bits(format, numerator, denominator);
}

// Whether the decimal is a number of at most 15 digits times an exactly represented power of ten.
Bool decimal_is_fast(const Decimal *decimal) {
    return !decimal->sticky && decimal->significant <= fast_digits_max && decimal->exp10 >= -fast_exponent_max &&
           decimal->exp10 <= fast_exponent_max;
}

// The f64 nearest the decimal when it is_fast: one multiply or divide of two exact f64s.
F64 decimal_fast(const Decimal *decimal) {
    F64 exact = (F64)decimal->small;
    F64 power = powers[decimal->exp10 < 0 ? -decimal->exp10 : decimal->exp10];
    return decimal->exp10 < 0 ? exact / power : exact * power;
}

// Finishes the digits of a decimal that the scan left in a partial chunk, and adds the sticky digit.
void decimal_finish(Decimal *decimal) {
    if (decimal->chunk_length != 0) big_mul_add(&decimal->digits, powers_u32[decimal->chunk_length], decimal->chunk);
    if (decimal->sticky) {
        big_mul_add(&decimal->digits, 10, 1);
        decimal->exp10 -= 1;
        decimal->significant += 1;
    }
}

// The f32 for a scanned decimal, as bits, or nothing for a number that would be infinity.
Bool decimal_to_f32_bits(Decimal *decimal, U32 *bits) {
    if (decimal->significant == 0) {
        *bits = 0;
        return true;
    }
    decimal_finish(decimal);
    I64 magnitude = (I64)decimal->significant + decimal->exp10; // the number lies below 10^magnitude
    if (magnitude >= 40) return false;                          // at least 10^39, above the largest f32
    if (magnitude <= -47) {                                     // below 10^-47, under half the smallest
        *bits = 0;
        return true;
    }
    if (decimal_is_fast(decimal)) {
        F64 nearest = decimal_fast(decimal);
        U64 nearest_bits = __builtin_bit_cast(U64, nearest);
        Bool halfway = (nearest_bits & 0x1fffffff) == 0x10000000; // between two floats: look closer
        if (nearest >= (F64)__FLT_MIN__ && nearest <= 1e38 && !halfway) {
            *bits = __builtin_bit_cast(U32, (F32)nearest);
            return true;
        }
    }
    *bits = (U32)decimal_exact(decimal, &float_format);
    return *bits < infinity_bits;
}

// The same for a f64.
Bool decimal_to_f64_bits(Decimal *decimal, U64 *bits) {
    if (decimal->significant == 0) {
        *bits = 0;
        return true;
    }
    decimal_finish(decimal);
    I64 magnitude = (I64)decimal->significant + decimal->exp10;
    if (magnitude >= 310) return false; // at least 10^309, above the largest f64
    if (magnitude <= -325) {            // below 10^-325, under half the smallest
        *bits = 0;
        return true;
    }
    if (decimal_is_fast(decimal)) {
        F64 nearest = decimal_fast(decimal); // one rounding of exact operands: the answer
        if (nearest >= __DBL_MIN__ && nearest <= 1e300) {
            *bits = __builtin_bit_cast(U64, nearest);
            return true;
        }
    }
    *bits = decimal_exact(decimal, &double_format);
    return *bits < double_infinity_bits;
}

// Scans a whole word: a sign, digits and an exponent. Returns whether it is a number, and whether it is negative.
Bool decimal_scan(const char word[:], Decimal *decimal, Bool *negative) {
    Usize index = 0;
    *negative = countof(word) > 0 && word[0] == '-';
    if (countof(word) > 0 && (word[0] == '-' || word[0] == '+')) index = 1;
    if (!decimal_scan_mantissa(word, &index, decimal)) return false;
    if (!decimal_scan_exponent(word, &index, decimal)) return false;
    return index == countof(word);
}

// A decimal number: an optional sign, digits with an optional fraction (-90, 0.25, .5, 5.), and an optional exponent
// (1e-5, 2.5E+3). The result is the f32 nearest to the number, ties to even, as strtof gives in the C locale, for
// any number of digits; "-0" is negative zero. It returns false for no digits, a stray character, or a number too
// large for an f32 (it would round to infinity). One too small rounds to zero or to a subnormal. No inf or nan.
[[std::c_name("smith_text_parse_f32")]] export [[nodiscard]] Bool parse_f32(const char word[:], F32 *value) {
    Decimal decimal;
    decimal_init(&decimal);
    Bool negative = false;
    if (!decimal_scan(word, &decimal, &negative)) return false;
    U32 bits = 0;
    if (!decimal_to_f32_bits(&decimal, &bits)) return false;
    if (negative) bits |= 0x80000000;
    *value = __builtin_bit_cast(F32, bits);
    return true;
}

// The same for an f64: the f64 nearest the number, ties to even, as strtod gives in the C locale, for any number
// of digits. It returns false for a number that would round to infinity (above about 1.7976931348623157e308).
[[std::c_name("smith_text_parse_f64")]] export [[nodiscard]] Bool parse_f64(const char word[:], F64 *value) {
    Decimal decimal;
    decimal_init(&decimal);
    Bool negative = false;
    if (!decimal_scan(word, &decimal, &negative)) return false;
    U64 bits = 0;
    if (!decimal_to_f64_bits(&decimal, &bits)) return false;
    if (negative) bits |= (U64)1 << 63;
    *value = __builtin_bit_cast(F64, bits);
    return true;
}

// ---------------------------------------------------------------------------------------------------------------
// Writing numbers

[[std::c_name("smith_text_write_u64")]] export Usize write_u64(char out[:], U64 value) {
    contract::requires(countof(out) >= number_capacity);
    char reversed[number_capacity];
    Usize count = 0;
    do {
        reversed[count++] = (char)('0' + value % 10);
        value /= 10;
    } while (value != 0 && count < number_capacity);
    check(value == 0);                                      // a number has more digits than number_capacity
    for (Usize i = 0; i < count && i < countof(out); i++) { // the requires holds, the guard shows it to the prover
        out[i] = reversed[count - 1 - i];
    }
    contract::ensures(count >= 1 && count <= number_capacity);
    return count;
}

[[std::c_name("smith_text_write_i64")]] export Usize write_i64(char out[:], I64 value) {
    contract::requires(countof(out) >= number_capacity);
    if (value >= 0) return write_u64(out, (U64)value);
    char text[number_capacity + 1] = {'-'};
    Usize count = write_u64(text[1:number_capacity + 1], 0 - (U64)value);
    for (Usize i = 0; i <= count && i < countof(out) && i <= number_capacity; i++) {
        out[i] = text[i];
    }
    return count + 1;
}

// 16 digits, so every hash lines up.
[[std::c_name("smith_text_write_hex")]] export Usize write_hex(char out[:], U64 value) {
    contract::requires(countof(out) >= 16);
    for (Usize i = 0; i < 16 && i < countof(out); i++) {
        U64 digit = (value >> (60 - 4 * i)) & 0xf;
        out[i] = (char)(digit < 10 ? '0' + digit : 'a' + (digit - 10));
    }
    return 16;
}

// write_i64 at a pointer: the callers below have room for it by the capacities they keep.
Usize append_i64(char *out, I64 value) {
    char digits[number_capacity];
    Usize count = write_i64(digits, value);
    for (Usize i = 0; i < count && i < number_capacity; i++) {
        out[i] = digits[i];
    }
    return count;
}

// A f64, as the fewest digits (at most 17) that read back as the same f64. With the value m * 2^e, the p-digit
// decimal nearest it is q * 10^s: q = round(m * 2^e / 10^s), ties to even, found with the big integers above. The
// number of digits is the least p that parses back to the same bits (more digits only come nearer, so a binary search
// over 1..17 finds it), and the exponent of the first digit decides between positional and scientific text.

constexpr U32 f64_digits_max = 17;
constexpr I64 f64_positional_max = 16;
constexpr I64 f64_positional_min = -5;
static_assert(f64_capacity >= 1 + f64_digits_max + 1 + 5, "sign, digits, a point and e-324");

// q = floor(numerator / denominator), which has at most 63 bits; the remainder is left in numerator.
U64 big_divide(Big *numerator, const Big *denominator) {
    I64 shift = (I64)big_bits(numerator) - (I64)big_bits(denominator);
    if (shift < 0) return 0;
    check(shift < 63); // a quotient has more than 63 bits
    Big step = *denominator;
    big_shift_left(&step, (U64)shift);
    U64 q = 0;
    for (U32 bit = (U32)shift + 1; bit-- > 0;) {
        if (big_at_least(numerator, &step)) {
            big_subtract(numerator, &step);
            q |= (U64)1 << bit;
        }
        big_shift_right_one(&step);
    }
    return q;
}

// The quotient of m * 2^e / 10^s, rounded to the nearest integer, ties to even.
U64 f64_scaled(U64 m, I64 e, I64 s, Bool round) {
    Big numerator = {.limb = {(U32)m, (U32)(m >> 32)}, .count = (m >> 32) != 0 ? 2U : 1U};
    Big denominator = {.limb = {1}, .count = 1};
    if (e >= 0)
        big_shift_left(&numerator, (U64)e);
    else
        big_shift_left(&denominator, (U64)(0 - e));
    if (s >= 0)
        big_mul_pow10(&denominator, (U64)s);
    else
        big_mul_pow10(&numerator, (U64)(0 - s));
    U64 q = big_divide(&numerator, &denominator);
    if (!round) return q;
    big_shift_left(&numerator, 1); // twice the remainder against the divisor
    Bool above = big_at_least(&numerator, &denominator);
    Bool equal = above && big_at_least(&denominator, &numerator);
    if (above && (!equal || (q & 1) != 0)) q += 1;
    return q;
}

U64 pow10_u64(U32 power) {
    U64 result = 1;
    for (U32 i = 0; i < power; i++) {
        result *= 10;
    }
    return result;
}

// The p-digit decimal nearest m * 2^e, as q * 10^s, given the decimal exponent of the first digit.
U64 f64_round_to(U64 m, I64 e, I64 first, U32 p, I64 *s) {
    *s = first - (I64)p + 1;
    U64 q = f64_scaled(m, e, *s, true);
    if (q == pow10_u64(p)) { // 9.99 rounded up to 10.0
        q = pow10_u64(p - 1);
        *s += 1;
    }
    return q;
}

// The decimal exponent of the first digit of m * 2^e: floor(log10), from the binary exponent and then corrected.
I64 f64_first_exponent(U64 m, I64 e) {
    I64 binary = e + (I64)(64 - (U32)__builtin_clzll(m)) - 1;
    I64 first = (binary * 78913) / 262144; // binary * log10(2), within one of the floor
    for (I32 attempt = 0; attempt < 4; attempt++) {
        U64 q = f64_scaled(m, e, first, false);
        if (q == 0)
            first -= 1;
        else if (q >= 10)
            first += 1;
        else
            return first;
    }
    check(false); // no first digit found for a finite number
    return first;
}

Bool f64_reads_back(U64 q, I64 s, U64 bits) {
    char text[number_capacity * 2];
    Usize length = write_u64(text, q);
    text[length++] = 'e';
    length += append_i64(text + length, s);
    F64 back = 0;
    if (length > sizeof text) return false;
    return parse_f64(text[0:length], &back) && __builtin_bit_cast(U64, back) == bits;
}

// Writes the digits q (p of them, the first one of exponent `first`) as positional or scientific text.
Usize f64_format(char *out, U64 q, U32 p, I64 first) {
    char digits[number_capacity];
    Usize count = write_u64(digits, q);
    check(count == p); // the digits are not the precision
    Usize used = 0;
    if (first >= f64_positional_min && first <= f64_positional_max) {
        if (first < 0) {
            out[used++] = '0';
            out[used++] = '.';
            for (I64 i = 0; i < -first - 1; i++) {
                out[used++] = '0';
            }
        }
        for (Usize i = 0; i < count; i++) {
            if (first >= 0 && (I64)i == first + 1) out[used++] = '.';
            out[used++] = digits[i];
        }
        for (I64 i = (I64)count; i < first + 1; i++) { // an integer with zeros after its digits
            out[used++] = '0';
        }
        return used;
    }
    out[used++] = digits[0];
    if (count > 1) out[used++] = '.';
    for (Usize i = 1; i < count; i++) {
        out[used++] = digits[i];
    }
    out[used++] = 'e';
    return used + append_i64(out + used, first);
}

// Writes the text of a f64 at out, which has room for f64_capacity.
Usize f64_write(char *out, F64 value) {
    U64 bits = __builtin_bit_cast(U64, value);
    U64 field = (bits >> 52) & 0x7ff;
    check(field != 0x7ff); // infinity and nan have no text
    Usize used = 0;
    if ((bits >> 63) != 0) out[used++] = '-';
    U64 fraction = bits & 0xfffffffffffffULL;
    if (field == 0 && fraction == 0) {
        out[used++] = '0';
        return used;
    }
    U64 m = field == 0 ? fraction : fraction | ((U64)1 << 52);
    I64 e = field == 0 ? -1074 : (I64)field - 1075;
    U64 positive = bits & ~((U64)1 << 63);
    I64 first = f64_first_exponent(m, e);
    U32 low = 1;
    U32 high = f64_digits_max;
    while (low < high) {
        U32 middle = (low + high) / 2;
        I64 s = 0;
        U64 q = f64_round_to(m, e, first, middle, &s);
        if (f64_reads_back(q, s, positive))
            high = middle;
        else
            low = middle + 1;
    }
    I64 s = 0;
    U64 q = f64_round_to(m, e, first, low, &s);
    return used + f64_format(out + used, q, low, s + (I64)low - 1);
}

// An f64 in the fewest digits, at most 17, that parse_f64 reads back as the same bits, signs of zero
// included: 0.1 is "0.1", 1e22 is "1e22", 5e-324 is "5e-324". It writes digits with an optional point and an optional
// exponent (no plus), always valid JSON. Room for f64_capacity characters; no terminator. The value must be
// finite (checked): infinity and nan have no text.
[[std::c_name("smith_text_write_f64")]] export Usize write_f64(char out[:], F64 value) {
    check(
        countof(out) >=
        f64_capacity); // a run-time check, not a contract: the arithmetic below costs the prover more than it is worth
    char text[f64_capacity];
    Usize count = f64_write(text, value);
    for (Usize i = 0; i < count && i < f64_capacity && i < countof(out); i++) {
        out[i] = text[i];
    }
    return count;
}

constexpr U32 f32_digits_max = 9;
static_assert(f32_capacity >= 1 + f64_positional_max + 2 + 5, "sign, a positional integer, a point and e-45");

Bool f32_reads_back(U64 q, I64 s, U32 bits) {
    char text[number_capacity * 2];
    Usize length = write_u64(text, q);
    text[length++] = 'e';
    length += append_i64(text + length, s);
    F32 back = 0;
    if (length > sizeof text) return false;
    return parse_f32(text[0:length], &back) && __builtin_bit_cast(U32, back) == bits;
}

// Writes the text of a f32 at out, which has room for f32_capacity.
Usize f32_write(char *out, F32 value) {
    U32 bits = __builtin_bit_cast(U32, value);
    U32 field = (bits >> 23) & 0xff;
    check(field != 0xff); // infinity and nan have no text
    Usize used = 0;
    if ((bits >> 31) != 0) out[used++] = '-';
    U32 fraction = bits & 0x7fffff;
    if (field == 0 && fraction == 0) {
        out[used++] = '0';
        return used;
    }
    U64 m = field == 0 ? fraction : fraction | ((U64)1 << 23);
    I64 e = field == 0 ? -149 : (I64)field - 150;
    U32 positive = bits & 0x7fffffffU;
    I64 first = f64_first_exponent(m, e);
    U32 low = 1;
    U32 high = f32_digits_max;
    while (low < high) {
        U32 middle = (low + high) / 2;
        I64 s = 0;
        U64 q = f64_round_to(m, e, first, middle, &s);
        if (f32_reads_back(q, s, positive))
            high = middle;
        else
            low = middle + 1;
    }
    I64 s = 0;
    U64 q = f64_round_to(m, e, first, low, &s);
    return used + f64_format(out + used, q, low, s + (I64)low - 1);
}

// An f32 in the fewest digits, at most 9, that parse_f32 reads back as the same bits: 0.1f is "0.1", where its f64
// value is 0.10000000149011612. Written as write_f64 writes (positional or scientific, no plus), so a f32's text and
// its widened f64's differ only in the digits. Room for f32_capacity characters; no terminator. The value must be
// finite (checked).
[[std::c_name("smith_text_write_f32")]] export Usize write_f32(char out[:], F32 value) {
    check(
        countof(out) >=
        f32_capacity); // a run-time check, not a contract: the arithmetic below costs the prover more than it is worth
    char text[f32_capacity];
    Usize count = f32_write(text, value);
    for (Usize i = 0; i < count && i < f32_capacity && i < countof(out); i++) {
        out[i] = text[i];
    }
    return count;
}

char *copy_block(const char word[:]) {
    Usize count = countof(word);
    char *block = (char *)mem::alloc_raw(count + 1, 1);
    for (Usize i = 0; i < count; i++) {
        block[i] = word[i];
    }
    block[count] = 0;
    return block;
}

// The word copied into the current allocator, with a NUL after the last character that count does not include, so the
// copy is also a C string for the edges. The caller frees it with mem::free. Allocation never fails.
[[std::c_name("smith_text_copy")]] export typeof(const char[:]) copy(const char word[:]) {
    char *block = copy_block(word);
    return block[0:countof(word)];
}

// The same copy as the pointer C calls need, for a boundary only: the pointer ends in a NUL, and the caller frees it
// with mem::free.
[[std::c_name("smith_text_terminated")]] export const char *terminated(const char word[:]) {
    return copy_block(word);
}

// NOLINTBEGIN(smith-preprocessor): the errno values are macros of <errno.h>, read once as constants
constexpr I32 os_enoent = c::ENOENT;
constexpr I32 os_eexist = c::EEXIST;
constexpr I32 os_eacces = c::EACCES;
constexpr I32 os_eperm = c::EPERM;
constexpr I32 os_eisdir = c::EISDIR;
constexpr I32 os_enotdir = c::ENOTDIR;
constexpr I32 os_enotempty = c::ENOTEMPTY;
constexpr I32 os_einval = c::EINVAL;
constexpr I32 os_enomem = c::ENOMEM;
constexpr I32 os_emfile = c::EMFILE;
constexpr I32 os_enfile = c::ENFILE;
constexpr I32 os_eintr = c::EINTR;
constexpr I32 os_eagain = c::EAGAIN;
constexpr I32 os_epipe = c::EPIPE;
constexpr I32 os_econnrefused = c::ECONNREFUSED;
constexpr I32 os_econnreset = c::ECONNRESET;
constexpr I32 os_etimedout = c::ETIMEDOUT;
// NOLINTEND(smith-preprocessor)

// What a raw errno says, as a constant text for a message: the common ones by name, every other code "an unknown
// error". No libc function is called.
[[std::c_name("smith_text_os_error")]] export typeof(const char[:]) os_error(I32 code) {
    if (code == os_enoent) return "nothing is at the path";
    if (code == os_eexist) return "something is there already";
    if (code == os_eacces || code == os_eperm) return "permission denied";
    if (code == os_eisdir) return "the path is a folder";
    if (code == os_enotdir) return "a part of the path is not a folder";
    if (code == os_enotempty) return "the folder is not empty";
    if (code == os_einval) return "an argument is invalid";
    if (code == os_enomem) return "out of memory";
    if (code == os_emfile || code == os_enfile) return "too many files are open";
    if (code == os_eintr) return "the call was interrupted";
    if (code == os_eagain) return "try again";
    if (code == os_epipe) return "the other end is closed";
    if (code == os_econnrefused) return "the connection was refused";
    if (code == os_econnreset) return "the connection was reset";
    if (code == os_etimedout) return "the call timed out";
    return "an unknown error";
}
