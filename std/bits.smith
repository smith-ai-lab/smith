pub trait Bits[T] {
  fn bit_and(a: T, b: T) -> T
  fn bit_or(a: T, b: T) -> T
  fn bit_xor(a: T, b: T) -> T
  fn bit_not(a: T) -> T
  fn shift_left(a: T, by: Byte) -> T
  fn shift_right(a: T, by: Byte) -> T
}

pub fn bit_and[T: Bits](a: T, b: T) -> T {
  __bit_and(a, b)
}

pub fn bit_or[T: Bits](a: T, b: T) -> T {
  __bit_or(a, b)
}

pub fn bit_xor[T: Bits](a: T, b: T) -> T {
  __bit_xor(a, b)
}

pub fn bit_not[T: Bits](a: T) -> T {
  __bit_not(a)
}

pub fn shift_left[T: Bits](a: T, by: Byte) -> T {
  __shift_left(a, by)
}

pub fn shift_right[T: Bits](a: T, by: Byte) -> T {
  __shift_right(a, by)
}
