use std.serialize (Serialize, Writer, write)
use std.deserialize (Deserialize, Reader, ReadError, Problem, read, raw, fail)

pub enum Cases {
  key
  tag: str
}

pub enum Names {
  written
  camel
}

pub struct Clash {
  pub of: str
  pub case: str
  pub member: str
}

pub enum Unknown {
  ignore
  refuse
}

pub struct Json {
  pub cases: Cases
  pub names: Names
  pub unknown: Unknown = .ignore
}

// A case whose value is being written, and which is closed when the value
// ends: the depth the value is at, and the case below it.
struct Open {
  depth: Nat
  below: Nat
}

struct Out {
  settings: Json
  bytes: List[u8]
  depth: Nat
  comma: bool
  tagged: bool
  opens: List[Open]
  top: Nat
}

fn put(to: take Out, b: u8) -> Out ! alloc {
  var w = to
  w.bytes = push(w.bytes, b)
  w
}

fn put_text(to: take Out, s: str) -> Out ! alloc {
  var w = to
  loop i in 0..s.size { w.bytes = push(w.bytes, s[i]) }
  w
}

fn hex_digit(d: u8) -> u8 {
  if d < 10 { wrapping_add(d, '0') } else { wrapping_add(d, 87) }
}

// The text as a string of JSON: `"`, `\`, and the bytes below a space are
// written as escapes, and every other byte as it is.
fn quote(to: take Out, s: str) -> Out ! alloc {
  var w = put(to, '"')
  loop i in 0..s.size {
    b = s[i]
    if b == '"' {
      w = put(put(w, '\\'), '"')
    } else if b == '\\' {
      w = put(put(w, '\\'), '\\')
    } else if b == '\n' {
      w = put(put(w, '\\'), 'n')
    } else if b == '\t' {
      w = put(put(w, '\\'), 't')
    } else if b == 13 {
      w = put(put(w, '\\'), 'r')
    } else if b == 8 {
      w = put(put(w, '\\'), 'b')
    } else if b == 12 {
      w = put(put(w, '\\'), 'f')
    } else if b < 32 {
      w = put(put(put(put(put(put(w, '\\'), 'u'), '0'), '0'), hex_digit(shift_right(b, 4))), hex_digit(bit_and(b, 15)))
    } else {
      w = put(w, b)
    }
  }
  put(w, '"')
}


// A name with each `_` that is followed by a lower case letter taken out, and
// the letter in upper case. A `_` that follows a `_`, that ends the name, or
// that is followed by anything else stays, so two names written with lower
// case letters, digits, and `_` are never made one.
fn camel_case(to: take Out, name: str) -> Out ! alloc {
  var w = to
  var up = false
  var before: u8 = 0
  loop i in 0..name.size {
    b = name[i]
    if up {
      w = put(w, wrapping_sub(b, 32))
      up = false
    } else if b == '_' and before != '_' and i + 1 < name.size and name[i + 1] >= 'a' and name[i + 1] <= 'z' {
      up = true
    } else {
      w = put(w, b)
    }
    before = b
  }
  w
}

// Starts a value: a `,` where the value follows another, or what a case
// that holds a value gives before it.
fn start(to: take Out) -> Out ! alloc {
  var w = to
  if w.tagged {
    w = put_text(w, ",\"value\":")
    w.opens = push(w.opens, Open(depth: w.depth, below: w.top))
    w.top = w.opens.size
    w.tagged = false
  } else if w.comma {
    w = put(w, ',')
  }
  w.comma = false
  w
}

// Ends a value, and closes each case whose value it is.
fn finish(to: take Out) -> Out ! alloc {
  var w = to
  w.comma = true
  loop j in 0..w.top {
    t = w.top
    if t > 0 and t <= w.opens.size {
      frame = w.opens[t - 1]
      if frame.depth == w.depth {
        w = put(w, '}')
        w.top = frame.below
      } else {
        break
      }
    } else {
      break
    }
  }
  w
}

fn scalar(to: take Out, s: str) -> Out ! alloc { finish(put_text(start(to), s)) }

fn open(to: take Out, b: u8) -> Out ! alloc {
  var w = put(start(to), b)
  w.depth = saturating_add(w.depth, 1)
  w
}

fn close(to: take Out, b: u8) -> Out ! alloc {
  var w = put(to, b)
  w.depth = saturating_sub(w.depth, 1)
  finish(w)
}

impl Writer[Out] {
  fn boolean(w: take Out, value: bool) -> Out ! alloc {
    if value { scalar(w, "true") } else { scalar(w, "false") }
  }
  fn signed(w: take Out, value: i64) -> Out ! alloc { scalar(w, fmt(value)) }
  fn unsigned(w: take Out, value: u64) -> Out ! alloc { scalar(w, fmt(value)) }
  fn text(w: take Out, value: str) -> Out ! alloc { finish(quote(start(w), value)) }
  fn nothing(w: take Out) -> Out ! alloc { scalar(w, "null") }
  fn absent(w: take Out) -> Out ! alloc { scalar(w, "null") }
  fn present(w: take Out) -> Out ! alloc { if w.tagged { start(w) } else { w } }
  fn sequence(w: take Out, size: Nat) -> Out ! alloc { open(w, '[') }
  fn end_sequence(w: take Out) -> Out ! alloc { close(w, ']') }
  fn tuple(w: take Out, size: Nat) -> Out ! alloc { open(w, '[') }
  fn end_tuple(w: take Out) -> Out ! alloc { close(w, ']') }
  fn structure(w: take Out, name: str, fields: Nat) -> Out ! alloc {
    if w.tagged {
      var v = w
      v.tagged = false
      v.depth = saturating_add(v.depth, 1)
      v
    } else {
      open(w, '{')
    }
  }
  fn field(w: take Out, name: str) -> Out ! alloc {
    var v = w
    if v.comma { v = put(v, ',') }
    match v.settings.names {
      .written { v = quote(v, name) }
      .camel { v = put(camel_case(put(v, '"'), name), '"') }
    }
    v.comma = false
    put(v, ':')
  }
  fn end_structure(w: take Out) -> Out ! alloc { close(w, '}') }
  fn case(w: take Out, of: str, name: str, holds: bool) -> Out ! alloc {
    match w.settings.cases {
      .key {
        if holds {
          var v = put(quote(put(start(w), '{'), name), ':')
          v.opens = push(v.opens, Open(depth: v.depth, below: v.top))
          v.top = v.opens.size
          v
        } else {
          finish(quote(start(w), name))
        }
      }
      .tag(t) {
        var v = quote(put(quote(put(start(w), '{'), t), ':'), name)
        if holds {
          v.tagged = true
          v.comma = true
          v
        } else {
          finish(put(v, '}'))
        }
      }
    }
  }
  fn map(w: take Out, size: Nat) -> Out ! alloc { open(w, '[') }
  fn end_map(w: take Out) -> Out ! alloc { close(w, ']') }
}

// Finds a tag that is also a member, which `Out` does not look for, so that
// `to_json` pays nothing for it. It writes nothing and follows the depth of
// the value as `Out` does.

// A struct whose members are written beside a tag: the depth its members are
// at, the case, and the struct below it.
struct Beside {
  depth: Nat
  of: str
  case: str
  below: Nat
}

struct Check {
  tag: str
  camel: bool
  depth: Nat
  // Whether a case that holds a value has been written and the value is not
  // yet begun, and which case it is.
  held: bool
  of: str
  case: str
  frames: List[Beside]
  top: Nat
  clash: Option[Clash]
}

fn note_clash(to: take Check, of: str, case: str, member: str) -> Check ! alloc {
  var w = to
  match w.clash {
    .none { w.clash = Option.some(Clash(of: of, case: case, member: member)) }
    .some(c) { }
  }
  w
}

// A value that is not a struct, held by a case, is written under `value`.
fn begin(to: take Check) -> Check ! alloc {
  var w = to
  if w.held {
    w.held = false
    if w.tag == "value" {
      of = w.of
      case = w.case
      w = note_clash(w, of, case, "value")
    }
  }
  w
}

fn deeper(to: take Check) -> Check ! alloc {
  var w = begin(to)
  w.depth = saturating_add(w.depth, 1)
  w
}

fn shallower(to: take Check) -> Check ! alloc {
  var w = to
  w.depth = saturating_sub(w.depth, 1)
  w
}

fn same_bytes(bytes: List[u8], t: str) -> bool {
  var same = bytes.size == t.size
  if same {
    loop i in 0..t.size {
      if i < bytes.size and bytes[i] != t[i] { same = false }
    }
  }
  same
}

// The name of a field as `Out` writes it.
fn written_name(name: str, camel: bool) -> List[u8] ! alloc {
  var w = Out(settings: Json(cases: .key, names: .camel), bytes: [], depth: 0, comma: false, tagged: false, opens: [], top: 0)
  if camel {
    w = camel_case(w, name)
  } else {
    w = put_text(w, name)
  }
  w.bytes
}

impl Writer[Check] {
  fn boolean(w: take Check, value: bool) -> Check ! alloc { begin(w) }
  fn signed(w: take Check, value: i64) -> Check ! alloc { begin(w) }
  fn unsigned(w: take Check, value: u64) -> Check ! alloc { begin(w) }
  fn text(w: take Check, value: str) -> Check ! alloc { begin(w) }
  fn nothing(w: take Check) -> Check ! alloc { begin(w) }
  fn absent(w: take Check) -> Check ! alloc { begin(w) }
  fn present(w: take Check) -> Check ! alloc { begin(w) }
  fn sequence(w: take Check, size: Nat) -> Check ! alloc { deeper(w) }
  fn end_sequence(w: take Check) -> Check ! alloc { shallower(w) }
  fn tuple(w: take Check, size: Nat) -> Check ! alloc { deeper(w) }
  fn end_tuple(w: take Check) -> Check ! alloc { shallower(w) }
  fn map(w: take Check, size: Nat) -> Check ! alloc { deeper(w) }
  fn end_map(w: take Check) -> Check ! alloc { shallower(w) }
  fn structure(w: take Check, name: str, fields: Nat) -> Check ! alloc {
    var v = w
    if v.held {
      v.held = false
      v.frames = push(v.frames, Beside(depth: saturating_add(v.depth, 1), of: v.of, case: v.case, below: v.top))
      v.top = v.frames.size
      v.depth = saturating_add(v.depth, 1)
      v
    } else {
      deeper(v)
    }
  }
  fn field(w: take Check, name: str) -> Check ! alloc {
    var v = w
    m = v.top
    if m > 0 and m <= v.frames.size {
      frame = v.frames[m - 1]
      if frame.depth == v.depth and same_bytes(written_name(name, v.camel), v.tag) {
        tag = v.tag
        v = note_clash(v, frame.of, frame.case, tag)
      }
    }
    v
  }
  fn end_structure(w: take Check) -> Check ! alloc {
    var v = w
    m = v.top
    if m > 0 and m <= v.frames.size {
      frame = v.frames[m - 1]
      if frame.depth == v.depth { v.top = frame.below }
    }
    shallower(v)
  }
  fn case(w: take Check, of: str, name: str, holds: bool) -> Check ! alloc {
    var v = begin(w)
    if holds {
      v.held = true
      v.of = of
      v.case = name
    }
    v
  }
}

fn clash_in[T: Serialize](value: T, json: Json) -> Option[Clash] ! alloc {
  match json.cases {
    .key { Option.none }
    .tag(t) {
      camel = match json.names {
        .written { false }
        .camel { true }
      }
      w = write(value, Check(tag: t, camel: camel, depth: 0, held: false, of: "", case: "", frames: [], top: 0, clash: .none))
      w.clash
    }
  }
}

fn render[T: Serialize](value: T, json: Json) -> str ! alloc {
  w = write(value, Out(settings: json, bytes: [], depth: 0, comma: false, tagged: false, opens: [], top: 0))
  match utf8(freeze(w.bytes)) {
    .ok(t) { t }
    .err(e) { "" }
  }
}

pub fn to_json_as[T: Serialize](value: T, json: Json) -> Result[str, Clash] ! alloc {
  match clash_in(value, json) {
    .none { Result.ok(render(value, json)) }
    .some(c) { Result.err(c) }
  }
}

pub fn to_json[T: Serialize](value: T) -> str ! alloc {
  render(value, Json(cases: .key, names: .written))
}

// Reading.
//
// Everything below the reader walks the bytes of the input with a position
// and gives the position it ended at, so that a read that succeeds works acc
// nothing of its path, its line, or its column.

// What is wrong, and the byte it is at.
struct Bad {
  at: Nat
  problem: Problem
}

fn is_space(b: u8) -> bool { b == ' ' or b == '\n' or b == 13 or b == '\t' }

fn is_digit(b: u8) -> bool { b >= '0' and b <= '9' }

// The byte at `at`, which is 0 beyond the end, and no JSON has a 0.
fn byte(b: Slice[u8], at: Nat) -> u8 {
  if at < b.size { b[at] } else { 0 }
}

fn skip_space(b: Slice[u8], from: Nat) -> Nat {
  loop i in from..b.size {
    if not is_space(b[i]) { return i }
  }
  b.size
}

// The last byte before `at` that is not a space, or 0.
fn last_before(b: Slice[u8], at: Nat) -> u8 {
  var i = at
  loop k in 0..at {
    if i == 0 { return 0 }
    i = i - 1
    if i < b.size and not is_space(b[i]) { return b[i] }
  }
  0
}

fn malformed(at: Nat) -> Bad { Bad(at: at, problem: .malformed) }

// How the input describes the value that starts at `at`, or `.none` where
// no value starts.
fn found(b: Slice[u8], at: Nat) -> Option[str] {
  c = byte(b, at)
  if c == '"' { Option.some("a text") } else if c == '-' or is_digit(c) { Option.some("a number") } else if c == 't' or c == 'f' { Option.some("a boolean") } else if c == 'n' { Option.some("null") } else if c == '[' { Option.some("a list") } else if c == '{' { Option.some("an object") } else { Option.none }
}

// The error for a value of another kind than the one wanted.
fn wrong(b: Slice[u8], at: Nat, wanted: str) -> Bad {
  match found(b, at) {
    .some(f) { Bad(at: at, problem: .shape((wanted, f))) }
    .none { malformed(at) }
  }
}

// The end of the word `w` that is at `at`.
fn word(b: Slice[u8], at: Nat, w: str) -> Result[Nat, Bad] {
  var ok = saturating_add(at, w.size) <= b.size
  if ok {
    loop i in 0..w.size {
      j = saturating_add(at, i)
      if j < b.size and b[j] != w[i] { ok = false }
    }
  }
  if ok { Result.ok(saturating_add(at, w.size)) } else { Result.err(malformed(at)) }
}

// A number as the input holds it.
struct Num {
  end: Nat
  negative: bool
  from: Nat
  whole: bool
}

// The number that starts at `at`, which is checked against the grammar of
// JSON: a `-`, a `0` or a digit other than `0` and digits, a fraction, and an
// exponent. `from` is where its digits start.
fn number(b: Slice[u8], at: Nat) -> Result[Num, Bad] {
  var i = at
  negative = byte(b, i) == '-'
  if negative { i = saturating_add(i, 1) }
  from = i
  c = byte(b, i)
  if not is_digit(c) { return Result.err(malformed(i)) }
  if c == '0' {
    i = saturating_add(i, 1)
  } else {
    loop k in 0..b.size {
      if is_digit(byte(b, i)) { i = saturating_add(i, 1) } else { break }
    }
  }
  var whole = true
  if byte(b, i) == '.' {
    whole = false
    i = saturating_add(i, 1)
    if not is_digit(byte(b, i)) { return Result.err(malformed(i)) }
    loop k in 0..b.size {
      if is_digit(byte(b, i)) { i = saturating_add(i, 1) } else { break }
    }
  }
  e = byte(b, i)
  if e == 'e' or e == 'E' {
    whole = false
    i = saturating_add(i, 1)
    s = byte(b, i)
    if s == '+' or s == '-' { i = saturating_add(i, 1) }
    if not is_digit(byte(b, i)) { return Result.err(malformed(i)) }
    loop k in 0..b.size {
      if is_digit(byte(b, i)) { i = saturating_add(i, 1) } else { break }
    }
  }
  Result.ok(Num(end: i, negative: negative, from: from, whole: whole))
}

// The value of the digits of a whole number, or `.none` when it is more than a
// `u64` holds.
fn magnitude(b: Slice[u8], from: Nat, end: Nat) -> Option[u64] {
  var m: u64 = 0
  loop i in from..end {
    if i < b.size {
      d: u64 = convert(wrapping_sub(b[i], '0'))
      match checked_mul(m, 10) {
        .some(t) {
          match checked_add(t, d) {
            .some(v) { m = v }
            .none { return Option.none }
          }
        }
        .none { return Option.none }
      }
    }
  }
  Option.some(m)
}

fn hex_value(c: u8) -> Option[u32] {
  if is_digit(c) { Option.some(convert(wrapping_sub(c, '0'))) } else if c >= 'a' and c <= 'f' { Option.some(convert(wrapping_sub(c, 87))) } else if c >= 'A' and c <= 'F' { Option.some(convert(wrapping_sub(c, 55))) } else { Option.none }
}

// The four hexadecimal digits at `at`.
fn hex4(b: Slice[u8], at: Nat) -> Option[u32] {
  var v: u32 = 0
  loop i in 0..4 {
    match hex_value(byte(b, saturating_add(at, i))) {
      .some(d) { v = wrapping_add(wrapping_mul(v, 16), d) }
      .none { return Option.none }
    }
  }
  Option.some(v)
}

// A string that starts at `at` with `"`: where it ends, after the closing
// `"`, and whether it holds an escape. Each escape is one JSON has, a `\u` is
// a character or the two halves of one, and no byte below a space is bare.
struct Quoted {
  end: Nat
  escaped: bool
}

fn quoted(b: Slice[u8], at: Nat) -> Result[Quoted, Bad] {
  var i = saturating_add(at, 1)
  var escaped = false
  loop k in 0..b.size {
    if i >= b.size { return Result.err(malformed(i)) }
    c = b[i]
    if c == '"' { return Result.ok(Quoted(end: saturating_add(i, 1), escaped: escaped)) }
    if c < 32 { return Result.err(malformed(i)) }
    if c == '\\' {
      escaped = true
      e = byte(b, saturating_add(i, 1))
      if e == 'u' {
        match hex4(b, saturating_add(i, 2)) {
          .some(v) {
            if v >= 55296 and v < 56320 {
              if byte(b, saturating_add(i, 6)) == '\\' and byte(b, saturating_add(i, 7)) == 'u' {
                match hex4(b, saturating_add(i, 8)) {
                  .some(w) {
                    if w >= 56320 and w < 57344 { i = saturating_add(i, 12) } else { return Result.err(malformed(i)) }
                  }
                  .none { return Result.err(malformed(i)) }
                }
              } else {
                return Result.err(malformed(i))
              }
            } else if v >= 56320 and v < 57344 {
              return Result.err(malformed(i))
            } else {
              i = saturating_add(i, 6)
            }
          }
          .none { return Result.err(malformed(i)) }
        }
      } else if e == '"' or e == '\\' or e == '/' or e == 'b' or e == 'f' or e == 'n' or e == 'r' or e == 't' {
        i = saturating_add(i, 2)
      } else {
        return Result.err(malformed(i))
      }
    } else {
      i = saturating_add(i, 1)
    }
  }
  Result.err(malformed(i))
}

// A container that is open: the byte that opened it, the container below it,
// as a place in the list that holds them from 1, and the member of that
// container which this one is the value of, as the place of its key or its
// number in an array.
struct Frame {
  kind: u8
  below: Nat
  key: Nat
  index: Nat
}

// Where a walk ended: after the value it walked, or at the byte that
// `target` said to stop at, with the containers that are open there and the
// member of the innermost, and whether that member is its own or the place
// is in the container itself, as a `]` or a byte after a value is.
struct Walk {
  end: Nat
  frames: List[Frame]
  top: Nat
  key: Nat
  index: Nat
  inside: bool
  bad: Option[Bad]
}

fn walked(end: Nat, frames: take List[Frame], top: Nat, key: Nat, index: Nat, inside: bool) -> Result[Walk, Bad] {
  Result.ok(Walk(end: end, frames: frames, top: top, key: key, index: index, inside: inside, bad: Option.none))
}

// Where a walk met what is not JSON: at the member it was in.
fn broke(e: Bad, frames: take List[Frame], top: Nat, key: Nat, index: Nat) -> Result[Walk, Bad] {
  Result.ok(Walk(end: e.at, frames: frames, top: top, key: key, index: index, inside: false, bad: Option.some(e)))
}

fn frame_at(frames: List[Frame], at: Nat) -> Frame {
  if at >= 1 and at <= frames.size { frames[at - 1] } else { Frame(kind: 0, below: 0, key: 0, index: 0) }
}

// Walks the value that starts at `start`, which is checked to be one whole
// JSON value, and stops at the first place that is `target` or beyond, where
// it says which containers are open. The containers are kept as the byte that
// opened each, so a value that holds none asks for no memory.
fn walk(b: Slice[u8], start: Nat, target: Nat) -> Result[Walk, Bad] ! alloc {
  var frames: List[Frame] = []
  var top: Nat = 0
  var key: Nat = 0
  var index: Nat = 0
  var at = start
  // Whether a value is wanted at `at`, or one has just ended.
  var wanted = true
  loop k in 0..saturating_add(b.size, 2) {
    if wanted {
      at = skip_space(b, at)
      c = byte(b, at)
      if at >= target { return walked(at, frames, top, key, index, c == ']' or c == '}') }
      if c == '[' or c == '{' {
        frames = push(frames, Frame(kind: c, below: top, key: key, index: index))
        top = frames.size
        key = 0
        index = 0
        at = skip_space(b, saturating_add(at, 1))
        close = if c == '[' { ']' } else { '}' }
        if byte(b, at) == close {
          if at >= target { return walked(at, frames, top, key, index, true) }
          f = frame_at(frames, top)
          top = f.below
          key = f.key
          index = f.index
          at = saturating_add(at, 1)
          wanted = false
        } else if c == '{' {
          if at >= target { return walked(at, frames, top, at, index, byte(b, at) != '"') }
          key = at
          match member(b, at) {
            .ok(next) { at = next }
            .err(e) { return broke(e, frames, top, key, index) }
          }
        }
      } else if c == '"' {
        match quoted(b, at) {
          .ok(q) { at = q.end }
          .err(e) { return broke(e, frames, top, key, index) }
        }
        wanted = false
      } else if c == '-' or is_digit(c) {
        match number(b, at) {
          .ok(n) { at = n.end }
          .err(e) { return broke(e, frames, top, key, index) }
        }
        wanted = false
      } else if c == 't' {
        match word(b, at, "true") {
          .ok(next) { at = next }
          .err(e) { return broke(e, frames, top, key, index) }
        }
        wanted = false
      } else if c == 'f' {
        match word(b, at, "false") {
          .ok(next) { at = next }
          .err(e) { return broke(e, frames, top, key, index) }
        }
        wanted = false
      } else if c == 'n' {
        match word(b, at, "null") {
          .ok(next) { at = next }
          .err(e) { return broke(e, frames, top, key, index) }
        }
        wanted = false
      } else {
        return broke(malformed(at), frames, top, key, index)
      }
    } else {
      if top == 0 or top > frames.size { return walked(at, frames, top, key, index, true) }
      at = skip_space(b, at)
      c = byte(b, at)
      if at >= target { return walked(at, frames, top, key, index, true) }
      f = frame_at(frames, top)
      if c == ',' {
        at = skip_space(b, saturating_add(at, 1))
        if f.kind == '{' {
          if at >= target { return walked(at, frames, top, at, index, byte(b, at) != '"') }
          key = at
          match member(b, at) {
            .ok(next) { at = next }
            .err(e) { return broke(e, frames, top, key, index) }
          }
        } else {
          index = saturating_add(index, 1)
        }
        wanted = true
      } else if (c == ']' and f.kind == '[') or (c == '}' and f.kind == '{') {
        top = f.below
        key = f.key
        index = f.index
        at = saturating_add(at, 1)
      } else {
        return broke(malformed(at), frames, top, key, index)
      }
    }
  }
  broke(malformed(at), frames, top, key, index)
}

// The end of the value that starts at `start`, which is checked to be one
// whole JSON value.
fn scan(b: Slice[u8], start: Nat) -> Result[Nat, Bad] ! alloc {
  match walk(b, start, saturating_add(b.size, 1)) {
    .ok(w) {
      match w.bad {
        .some(e) { Result.err(e) }
        .none { Result.ok(w.end) }
      }
    }
    .err(e) { Result.err(e) }
  }
}

// The `:` after the name of a member that starts at `at`, passed: where the
// member's value is to start.
fn member(b: Slice[u8], at: Nat) -> Result[Nat, Bad] {
  if byte(b, at) != '"' { return Result.err(malformed(at)) }
  match quoted(b, at) {
    .ok(q) {
      colon = skip_space(b, q.end)
      if byte(b, colon) == ':' { Result.ok(saturating_add(colon, 1)) } else { Result.err(malformed(colon)) }
    }
    .err(e) { Result.err(e) }
  }
}

// A character of the number `code`, as bytes.
fn put_char(to: take List[u8], code: u32) -> List[u8] ! alloc {
  var acc = to
  if code < 128 {
    acc = push(acc, wrapping_narrow(code))
  } else if code < 2048 {
    acc = push(acc, wrapping_narrow(bit_or(192, shift_right(code, 6))))
    acc = push(acc, wrapping_narrow(bit_or(128, bit_and(code, 63))))
  } else if code < 65536 {
    acc = push(acc, wrapping_narrow(bit_or(224, shift_right(code, 12))))
    acc = push(acc, wrapping_narrow(bit_or(128, bit_and(shift_right(code, 6), 63))))
    acc = push(acc, wrapping_narrow(bit_or(128, bit_and(code, 63))))
  } else {
    acc = push(acc, wrapping_narrow(bit_or(240, shift_right(code, 18))))
    acc = push(acc, wrapping_narrow(bit_or(128, bit_and(shift_right(code, 12), 63))))
    acc = push(acc, wrapping_narrow(bit_or(128, bit_and(shift_right(code, 6), 63))))
    acc = push(acc, wrapping_narrow(bit_or(128, bit_and(code, 63))))
  }
  acc
}

// Takes the bytes of a string that `quoted` checked from `at` to `end`, with
// its escapes undone.
fn unescape(b: Slice[u8], at: Nat, end: Nat) -> List[u8] ! alloc {
  var acc: List[u8] = []
  var i = saturating_add(at, 1)
  loop k in 0..b.size {
    if saturating_add(i, 1) >= end { break }
    c = byte(b, i)
    var made: u8 = c
    var step: Nat = 1
    var code: u32 = 0
    var is_code = false
    if c == '\\' {
      e = byte(b, saturating_add(i, 1))
      step = 2
      if e == 'n' { made = '\n' } else if e == 't' { made = '\t' } else if e == 'r' { made = 13 } else if e == 'b' { made = 8 } else if e == 'f' { made = 12 } else if e == 'u' {
        step = 6
        is_code = true
        match hex4(b, saturating_add(i, 2)) {
          .some(v) { code = v }
          .none { }
        }
        if code >= 55296 and code < 56320 {
          match hex4(b, saturating_add(i, 8)) {
            .some(w) { code = wrapping_add(wrapping_add(65536, wrapping_mul(wrapping_sub(code, 55296), 1024)), wrapping_sub(w, 56320)) }
            .none { }
          }
          step = 12
        }
      } else { made = e }
    }
    if is_code and code < 128 {
      made = wrapping_narrow(code)
      is_code = false
    }
    if is_code {
      acc = put_char(acc, code)
    } else {
      acc = push(acc, made)
    }
    i = saturating_add(i, step)
  }
  acc
}

// The text that the string at `at`, which ends at `end`, stands for. A string
// with nothing to undo is a piece of the input, so nothing is copied for it.
fn text_at(b: Slice[u8], q: Quoted, at: Nat) -> str ! alloc {
  lo = saturating_add(at, 1)
  hi = saturating_sub(q.end, 1)
  if not q.escaped and lo <= hi and hi <= b.size {
    match utf8(b[lo..hi]) {
      .ok(t) { return t }
      .err(e) { return "" }
    }
  }
  match utf8(freeze(unescape(b, at, q.end))) {
    .ok(t) { t }
    .err(e) { "" }
  }
}

// The byte before or after the one at `i`, or 0.
fn byte_of(name: List[u8], i: Nat, before: bool) -> u8 {
  at = if before { saturating_sub(i, 1) } else { saturating_add(i, 1) }
  if at < name.size and (i > 0 or not before) { name[at] } else { 0 }
}

// Whether a name is one that `Names.camel` writes, and whether it has an upper
// case letter: a `_` that is followed by a lower case letter and does not follow
// a `_` is taken out when a name is written, and an upper case letter is the
// letter after one, so a name that has either is not written.
fn written_camel(name: List[u8]) -> (bool, bool) {
  var ok = true
  var upper = false
  loop i in 0..name.size {
    c = name[i]
    previous = byte_of(name, i, true)
    next = byte_of(name, i, false)
    if c >= 'A' and c <= 'Z' {
      upper = true
      if previous == '_' { ok = false }
    }
    if c == '_' and previous != '_' and next >= 'a' and next <= 'z' { ok = false }
  }
  (ok, upper)
}

// The name of the field that the member at `at` is, under `Names.camel`: the
// field that is written as the member's name, with each upper case letter read
// as a `_` and the letter in lower case. A member that is not a name that is
// written is given with a space before it, which is no name of a field.
fn field_name(b: Slice[u8], q: Quoted, at: Nat) -> str ! alloc {
  lo = saturating_add(at, 1)
  hi = saturating_sub(q.end, 1)
  if not q.escaped and lo <= hi and hi <= b.size {
    (ok, upper) = written_camel(b[lo..hi])
    if ok and not upper { return text_at(b, q, at) }
  }
  raw = unescape(b, at, q.end)
  (ok, upper) = written_camel(raw)
  var acc: List[u8] = []
  if not ok { acc = push(acc, ' ') }
  loop i in 0..raw.size {
    c = raw[i]
    if ok and c >= 'A' and c <= 'Z' {
      acc = push(push(acc, '_'), saturating_add(c, 32))
    } else {
      acc = push(acc, c)
    }
  }
  match utf8(freeze(acc)) {
    .ok(t) { t }
    .err(e) { "" }
  }
}

// The path to the place `at`, which is the way to the value there from the
// top, as `tools[2].timeout`.
fn path_at(b: Slice[u8], at: Nat) -> str ! alloc {
  match walk(b, skip_space(b, 0), at) {
    .ok(w) { render_path(b, w) }
    .err(e) { "" }
  }
}

fn put_member(b: Slice[u8], to: take List[u8], kind: u8, key: Nat, index: Nat) -> List[u8] ! alloc {
  var acc = to
  if kind == '{' {
    match quoted(b, key) {
      .ok(q) {
        if acc.size > 0 { acc = push(acc, '.') }
        name = unescape(b, key, q.end)
        loop i in 0..name.size { acc = push(acc, name[i]) }
      }
      .err(e) { }
    }
  } else {
    acc = push(acc, '[')
    digits = "{index}"
    loop i in 0..digits.size { acc = push(acc, digits[i]) }
    acc = push(acc, ']')
  }
  acc
}

fn render_path(b: Slice[u8], w: Walk) -> str ! alloc {
  // The open containers, innermost first.
  var chain: List[Nat] = []
  var t = w.top
  loop k in 0..w.frames.size {
    if t == 0 or t > w.frames.size { break }
    chain = push(chain, t)
    t = frame_at(w.frames, t).below
  }
  var acc: List[u8] = []
  loop j in 0..chain.size {
    f = frame_at(w.frames, chain[chain.size - 1 - j])
    if f.below != 0 and f.below <= w.frames.size {
      acc = put_member(b, acc, frame_at(w.frames, f.below).kind, f.key, f.index)
    }
  }
  if w.top != 0 and w.top <= w.frames.size and not w.inside {
    acc = put_member(b, acc, frame_at(w.frames, w.top).kind, w.key, w.index)
  }
  match utf8(freeze(acc)) {
    .ok(text) { text }
    .err(e) { "" }
  }
}

// The line and the column of the byte `at`, each counted from 1, the column in
// bytes.
fn place(b: Slice[u8], at: Nat) -> (Nat, Nat) {
  var line: Nat = 1
  var row: Nat = 0
  loop i in 0..b.size {
    if i >= at { break }
    if b[i] == '\n' {
      line = saturating_add(line, 1)
      row = saturating_add(i, 1)
    }
  }
  (line, saturating_add(saturating_sub(at, row), 1))
}

fn read_error(b: Slice[u8], bad: Bad) -> ReadError ! alloc {
  (line, column) = place(b, bad.at)
  ReadError(path: path_at(b, bad.at), problem: bad.problem, line: line, column: column)
}

fn grown_nat(items: Slice[Nat], item: Nat) -> Slice[Nat] ! alloc {
  var acc: List[Nat] = []
  loop i in 0..items.size { acc = push(acc, items[i]) }
  freeze(push(acc, item))
}

fn grown_byte(items: Slice[u8], item: u8) -> Slice[u8] ! alloc {
  var acc: List[u8] = []
  loop i in 0..items.size { acc = push(acc, items[i]) }
  freeze(push(acc, item))
}

fn without_last_nat(items: Slice[Nat]) -> Slice[Nat] {
  n = items.size
  if n >= 1 {
    k = n - 1
    items[..k]
  } else {
    items
  }
}

fn without_last_byte(items: Slice[u8]) -> Slice[u8] {
  n = items.size
  if n >= 1 {
    k = n - 1
    items[..k]
  } else {
    items
  }
}

// The place of the name of the tag in the object of the innermost case that is
// open and is written with one, which is no place when none is.
fn tag_at(r: In) -> Nat {
  n = r.tags.size
  if n >= 1 {
    k = n - 1
    r.tags[k]
  } else {
    18446744073709551615
  }
}

// The reader with the tag of a case that is open at `at`.
fn tagged(r: take In, at: Nat) -> Result[In, Bad] ! alloc {
  var w = r
  w.tags = grown_nat(w.tags, at)
  Result.ok(w)
}

// Whether closing the case that is innermost takes a `}`: the bit of its
// level, which is in `forms` for the first 64 levels and in `deep` for the
// rest.
fn top_closes(r: In) -> bool {
  n = saturating_sub(r.cases, 1)
  if r.cases == 0 {
    false
  } else if n < 64 {
    by: u8 = narrow(n)
    bit_and(shift_right(r.forms, by), 1) == 1
  } else {
    m = r.deep.size
    if m >= 1 {
      k = m - 1
      r.deep[k] == 1
    } else {
      false
    }
  }
}

// The reader with the innermost case not taking a `}` to close.
fn top_not_closing(r: take In) -> In ! alloc {
  var w = r
  n = saturating_sub(w.cases, 1)
  if w.cases == 0 {
    w
  } else if n < 64 {
    by: u8 = narrow(n)
    one: u64 = 1
    w.forms = bit_and(w.forms, bit_not(shift_left(one, by)))
    w
  } else {
    w.deep = grown_byte(without_last_byte(w.deep), 0)
    w
  }
}

// The reader with the innermost case closed.
fn left_case(r: take In) -> In {
  var w = r
  n = saturating_sub(w.cases, 1)
  if w.cases == 0 {
    w
  } else if n < 64 {
    by: u8 = narrow(n)
    one: u64 = 1
    w.forms = bit_and(w.forms, bit_not(shift_left(one, by)))
    w.cases = n
    w
  } else {
    w.deep = without_last_byte(w.deep)
    w.cases = n
    w
  }
}

// The reader of JSON text. `cases` says how many cases are open, and whether
// closing each takes a `}` is a bit of `forms`, and of `deep` past the 64th.
// The places of the tags of the cases that are open and written with one are
// `tags`. A case written with a tag is `pending` from its name until what it
// holds is begun.
struct In {
  bytes: Slice[u8]
  at: Nat
  mark: Nat
  json: Json
  forms: u64
  deep: Slice[u8]
  cases: Nat
  pending: bool
  tags: Slice[Nat]
}

fn failed_bool(r: take In, bad: Bad) -> (In, Result[bool, ReadError]) ! alloc {
  (r, Result.err(read_error(r.bytes, bad)))
}

fn failed_i64(r: take In, bad: Bad) -> (In, Result[i64, ReadError]) ! alloc {
  (r, Result.err(read_error(r.bytes, bad)))
}

fn failed_u64(r: take In, bad: Bad) -> (In, Result[u64, ReadError]) ! alloc {
  (r, Result.err(read_error(r.bytes, bad)))
}

fn failed_str(r: take In, bad: Bad) -> (In, Result[str, ReadError]) ! alloc {
  (r, Result.err(read_error(r.bytes, bad)))
}

fn failed_bytes(r: take In, bad: Bad) -> (In, Result[Slice[u8], ReadError]) ! alloc {
  (r, Result.err(read_error(r.bytes, bad)))
}

fn failed_unit(r: take In, bad: Bad) -> (In, Result[(), ReadError]) ! alloc {
  (r, Result.err(read_error(r.bytes, bad)))
}

fn failed_name(r: take In, bad: Bad) -> (In, Result[Option[str], ReadError]) ! alloc {
  (r, Result.err(read_error(r.bytes, bad)))
}


fn ends_value(c: u8) -> bool {
  c == '"' or is_digit(c) or c == 'e' or c == 'l' or c == ']' or c == '}'
}

// Where the value that is asked for starts, past what comes before it: the
// `,` between two elements of a tuple, and the `"value":` of a case that holds
// a value and is written with a tag.
fn value_start(r: In) -> Result[Nat, Bad] ! alloc {
  b = r.bytes
  a = skip_space(b, r.at)
  c = byte(b, a)
  if r.pending {
    // The members of the object of a case, after its `{`, of which the tag is
    // one: the other is `value`.
    tag = tag_at(r)
    var at = a
    var first = true
    loop k in 0..saturating_add(b.size, 1) {
      if byte(b, at) == '}' { return Result.err(Bad(at: at, problem: .missing("value"))) }
      if not first {
        if byte(b, at) != ',' { return Result.err(malformed(at)) }
        at = skip_space(b, saturating_add(at, 1))
      }
      first = false
      match member(b, at) {
        .err(e) { return Result.err(e) }
        .ok(v) {
          if at == tag {
            match scan(b, skip_space(b, v)) {
              .err(e) { return Result.err(e) }
              .ok(e) { at = skip_space(b, e) }
            }
          } else {
            match quoted(b, at) {
              .err(e) { return Result.err(e) }
              .ok(q) {
                if text_at(b, q, at) == "value" { return Result.ok(skip_space(b, v)) }
                return Result.err(malformed(at))
              }
            }
          }
        }
      }
    }
    Result.err(malformed(at))
  } else if ends_value(last_before(b, a)) {
    if c == ',' {
      Result.ok(skip_space(b, saturating_add(a, 1)))
    } else if c == ']' {
      Result.err(Bad(at: a, problem: .shape(("a value", "the end of the list"))))
    } else {
      Result.err(malformed(a))
    }
  } else {
    Result.ok(a)
  }
}

fn moved(r: take In, at: Nat, mark: Nat) -> In {
  var w = r
  w.at = at
  w.mark = mark
  w.pending = false
  w
}

fn range_of(a: Nat, of: str) -> Bad { Bad(at: a, problem: .range(of)) }

fn not_whole(a: Nat) -> Bad {
  Bad(at: a, problem: .shape(("a whole number", "a number that is not whole")))
}

// The number at `a` as a whole number, with its sign apart from its size.
struct Whole {
  end: Nat
  negative: bool
  size: u64
}

fn whole(b: Slice[u8], a: Nat, of: str) -> Result[Whole, Bad] {
  c = byte(b, a)
  if c != '-' and not is_digit(c) { return Result.err(wrong(b, a, "a whole number")) }
  match number(b, a) {
    .err(e) { Result.err(e) }
    .ok(n) {
      if not n.whole { return Result.err(not_whole(a)) }
      match magnitude(b, n.from, n.end) {
        .some(m) { Result.ok(Whole(end: n.end, negative: n.negative, size: m)) }
        .none { Result.err(Bad(at: a, problem: .range(of))) }
      }
    }
  }
}

fn literal(r: take In, a: Nat, w: str, wanted: str) -> (In, Result[(), ReadError]) ! alloc {
  match word(r.bytes, a, w) {
    .ok(e) { (moved(r, e, a), Result.ok(())) }
    .err(e) { failed_unit(moved(r, r.at, a), wrong(r.bytes, a, wanted)) }
  }
}

fn pushed(r: take In, form: u64) -> Result[In, Bad] ! alloc {
  var w = r
  n = w.cases
  if n < 64 {
    by: u8 = narrow(n)
    w.forms = bit_or(w.forms, shift_left(form, by))
  } else {
    w.deep = grown_byte(w.deep, wrapping_narrow(form))
  }
  w.cases = saturating_add(n, 1)
  Result.ok(w)
}

// Where the tag of the case is in the object that opens at `open`.
struct Found {
  key: Nat
  name_at: Nat
  name: Quoted
}

// Looks for the member named `tag` among the members of the object that opens
// at `open`, in any place, passing over the others. It gives the `missing` of
// the tag at the `}` that ends an object that has none.
fn find_tag(b: Slice[u8], open: Nat, tag: str) -> Result[Found, Bad] ! alloc {
  var at = skip_space(b, saturating_add(open, 1))
  var first = true
  loop k in 0..saturating_add(b.size, 1) {
    if byte(b, at) == '}' { return Result.err(Bad(at: at, problem: .missing(tag))) }
    if not first {
      if byte(b, at) != ',' { return Result.err(malformed(at)) }
      at = skip_space(b, saturating_add(at, 1))
    }
    first = false
    match member(b, at) {
      .err(e) { return Result.err(e) }
      .ok(v) {
        match quoted(b, at) {
          .err(e) { return Result.err(e) }
          .ok(q) {
            n = skip_space(b, v)
            if text_at(b, q, at) == tag {
              if byte(b, n) != '"' { return Result.err(wrong(b, n, "a text")) }
              match quoted(b, n) {
                .err(e) { return Result.err(e) }
                .ok(name) { return Result.ok(Found(key: at, name_at: n, name: name)) }
              }
            }
            match scan(b, n) {
              .err(e) { return Result.err(e) }
              .ok(e) { at = skip_space(b, e) }
            }
          }
        }
      }
    }
  }
  Result.err(malformed(at))
}

impl Reader[In] {
  fn boolean(r: take In) -> (In, Result[bool, ReadError]) ! alloc {
    match value_start(r) {
      .err(e) { failed_bool(r, e) }
      .ok(a) {
        c = byte(r.bytes, a)
        if c == 't' {
          match word(r.bytes, a, "true") {
            .ok(e) { (moved(r, e, a), Result.ok(true)) }
            .err(e) { failed_bool(moved(r, r.at, a), e) }
          }
        } else if c == 'f' {
          match word(r.bytes, a, "false") {
            .ok(e) { (moved(r, e, a), Result.ok(false)) }
            .err(e) { failed_bool(moved(r, r.at, a), e) }
          }
        } else {
          failed_bool(moved(r, r.at, a), wrong(r.bytes, a, "a boolean"))
        }
      }
    }
  }
  fn signed(r: take In) -> (In, Result[i64, ReadError]) ! alloc {
    match value_start(r) {
      .err(e) { failed_i64(r, e) }
      .ok(a) {
        match whole(r.bytes, a, "i64") {
          .err(e) { failed_i64(moved(r, r.at, a), e) }
          .ok(n) {
            w = moved(r, n.end, a)
            if n.negative {
              if n.size <= 9223372036854775807 {
                v: i64 = narrow(n.size)
                (w, Result.ok(0 - v))
              } else if n.size == 9223372036854775808 {
                (w, Result.ok(wrapping_sub(0 - 9223372036854775807, 1)))
              } else {
                failed_i64(w, range_of(a, "i64"))
              }
            } else if n.size <= 9223372036854775807 {
              (w, Result.ok(narrow(n.size)))
            } else {
              failed_i64(w, range_of(a, "i64"))
            }
          }
        }
      }
    }
  }
  fn unsigned(r: take In) -> (In, Result[u64, ReadError]) ! alloc {
    match value_start(r) {
      .err(e) { failed_u64(r, e) }
      .ok(a) {
        match whole(r.bytes, a, "u64") {
          .err(e) { failed_u64(moved(r, r.at, a), e) }
          .ok(n) {
            w = moved(r, n.end, a)
            if n.negative and n.size != 0 {
              failed_u64(w, range_of(a, "u64"))
            } else {
              (w, Result.ok(n.size))
            }
          }
        }
      }
    }
  }
  fn text(r: take In) -> (In, Result[str, ReadError]) ! alloc {
    match value_start(r) {
      .err(e) { failed_str(r, e) }
      .ok(a) {
        if byte(r.bytes, a) != '"' {
          failed_str(moved(r, r.at, a), wrong(r.bytes, a, "a text"))
        } else {
          match quoted(r.bytes, a) {
            .ok(q) { (moved(r, q.end, a), Result.ok(text_at(r.bytes, q, a))) }
            .err(e) { failed_str(moved(r, r.at, a), e) }
          }
        }
      }
    }
  }
  fn nothing(r: take In) -> (In, Result[(), ReadError]) ! alloc {
    match value_start(r) {
      .err(e) { failed_unit(r, e) }
      .ok(a) { literal(r, a, "null", "null") }
    }
  }
  fn present(r: take In) -> (In, Result[bool, ReadError]) ! alloc {
    match value_start(r) {
      .err(e) { failed_bool(r, e) }
      .ok(a) {
        if byte(r.bytes, a) == 'n' {
          match word(r.bytes, a, "null") {
            .ok(e) { (moved(r, e, a), Result.ok(false)) }
            .err(e) { failed_bool(moved(r, r.at, a), e) }
          }
        } else {
          (moved(r, a, a), Result.ok(true))
        }
      }
    }
  }
  fn sequence(r: take In) -> (In, Result[(), ReadError]) ! alloc {
    match value_start(r) {
      .err(e) { failed_unit(r, e) }
      .ok(a) {
        if byte(r.bytes, a) == '[' {
          (moved(r, saturating_add(a, 1), a), Result.ok(()))
        } else {
          failed_unit(moved(r, r.at, a), wrong(r.bytes, a, "a list"))
        }
      }
    }
  }
  fn more(r: take In) -> (In, Result[bool, ReadError]) ! alloc {
    b = r.bytes
    a = skip_space(b, r.at)
    c = byte(b, a)
    if last_before(b, a) == '[' {
      if c == ']' { (moved(r, saturating_add(a, 1), a), Result.ok(false)) } else { (moved(r, a, a), Result.ok(true)) }
    } else if c == ']' {
      (moved(r, saturating_add(a, 1), a), Result.ok(false))
    } else if c == ',' {
      (moved(r, saturating_add(a, 1), a), Result.ok(true))
    } else {
      failed_bool(moved(r, r.at, a), malformed(a))
    }
  }
  fn tuple(r: take In, size: Nat) -> (In, Result[(), ReadError]) ! alloc {
    match value_start(r) {
      .err(e) { failed_unit(r, e) }
      .ok(a) {
        if byte(r.bytes, a) == '[' {
          (moved(r, saturating_add(a, 1), a), Result.ok(()))
        } else {
          failed_unit(moved(r, r.at, a), wrong(r.bytes, a, "a list"))
        }
      }
    }
  }
  fn end_tuple(r: take In) -> (In, Result[(), ReadError]) ! alloc {
    a = skip_space(r.bytes, r.at)
    c = byte(r.bytes, a)
    if c == ']' {
      (moved(r, saturating_add(a, 1), a), Result.ok(()))
    } else if c == ',' {
      failed_unit(moved(r, r.at, a), Bad(at: a, problem: .shape(("the end of the list", "a value"))))
    } else {
      failed_unit(moved(r, r.at, a), malformed(a))
    }
  }
  fn structure(r: take In, name: str) -> (In, Result[(), ReadError]) ! alloc {
    if r.pending {
      w = top_not_closing(moved(r, r.at, r.mark))
      (w, Result.ok(()))
    } else {
      match value_start(r) {
        .err(e) { failed_unit(r, e) }
        .ok(a) {
          if byte(r.bytes, a) == '{' {
            (moved(r, saturating_add(a, 1), a), Result.ok(()))
          } else {
            failed_unit(moved(r, r.at, a), wrong(r.bytes, a, "an object"))
          }
        }
      }
    }
  }
  fn field(r: take In) -> (In, Result[Option[str], ReadError]) ! alloc {
    b = r.bytes
    tag = tag_at(r)
    var at = r.at
    loop k in 0..saturating_add(b.size, 1) {
      var a = skip_space(b, at)
      c = byte(b, a)
      if c == '}' { return (moved(r, saturating_add(a, 1), a), Result.ok(Option.none)) }
      if last_before(b, a) != '{' {
        if c != ',' { return failed_name(moved(r, r.at, a), malformed(a)) }
        a = skip_space(b, saturating_add(a, 1))
      }
      if byte(b, a) != '"' { return failed_name(moved(r, r.at, a), malformed(a)) }
      match quoted(b, a) {
        .err(e) { return failed_name(moved(r, r.at, a), e) }
        .ok(q) {
          colon = skip_space(b, q.end)
          if byte(b, colon) != ':' { return failed_name(moved(r, r.at, a), malformed(colon)) }
          if a == tag {
            // The tag of the case is not a field of what the case holds.
            match scan(b, skip_space(b, saturating_add(colon, 1))) {
              .err(e) { return failed_name(moved(r, r.at, a), e) }
              .ok(e) { at = e }
            }
          } else {
            name = match r.json.names {
              .written { text_at(b, q, a) }
              .camel { field_name(b, q, a) }
            }
            return (moved(r, saturating_add(colon, 1), a), Result.ok(Option.some(name)))
          }
        }
      }
    }
    failed_name(moved(r, r.at, at), malformed(at))
  }
  fn unknown(r: take In, name: str) -> (In, Result[(), ReadError]) ! alloc {
    // The member as the text has it, which is not `name` when that was made
    // from it.
    given = match quoted(r.bytes, r.mark) {
      .ok(q) { text_at(r.bytes, q, r.mark) }
      .err(e) { name }
    }
    match r.json.unknown {
      .refuse { failed_unit(r, Bad(at: r.mark, problem: .unknown(given))) }
      .ignore {
        a = skip_space(r.bytes, r.at)
        match scan(r.bytes, a) {
          .err(e) { failed_unit(moved(r, r.at, a), e) }
          .ok(e) {
            match again(r.bytes, e, given) {
              .some(bad) { failed_unit(moved(r, e, r.mark), bad) }
              .none { (moved(r, e, r.mark), Result.ok(())) }
            }
          }
        }
      }
    }
  }
  fn case(r: take In, of: str) -> (In, Result[str, ReadError]) ! alloc {
    match value_start(r) {
      .err(e) { failed_str(r, e) }
      .ok(a) {
        b = r.bytes
        c = byte(b, a)
        match r.json.cases {
          .key {
            if c == '"' {
              match quoted(b, a) {
                .err(e) { failed_str(moved(r, r.at, a), e) }
                .ok(q) {
                  match pushed(moved(r, q.end, a), 0) {
                    .ok(w) { (w, Result.ok(text_at(b, q, a))) }
                    .err(e) { failed_str(moved(r, r.at, a), e) }
                  }
                }
              }
            } else if c == '{' {
              k = skip_space(b, saturating_add(a, 1))
              match member(b, k) {
                .err(e) { failed_str(moved(r, r.at, a), e) }
                .ok(v) {
                  match quoted(b, k) {
                    .err(e) { failed_str(moved(r, r.at, a), e) }
                    .ok(q) {
                      match pushed(moved(r, v, k), 1) {
                        .ok(w) { (w, Result.ok(text_at(b, q, k))) }
                        .err(e) { failed_str(moved(r, r.at, a), e) }
                      }
                    }
                  }
                }
              }
            } else {
              failed_str(moved(r, r.at, a), wrong(b, a, "a case"))
            }
          }
          .tag(t) {
            if c != '{' {
              failed_str(moved(r, r.at, a), wrong(b, a, "an object"))
            } else {
              match find_tag(b, a, t) {
                .err(e) { failed_str(moved(r, r.at, a), e) }
                .ok(f) {
                  match pushed(moved(r, saturating_add(a, 1), f.name_at), 1) {
                    .err(e) { failed_str(moved(r, r.at, a), e) }
                    .ok(w) {
                      match tagged(w, f.key) {
                        .err(e) { failed_str(moved(r, r.at, a), e) }
                        .ok(held) {
                          var open = held
                          open.pending = true
                          (open, Result.ok(text_at(b, f.name, f.name_at)))
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  fn end_case(r: take In) -> (In, Result[(), ReadError]) ! alloc {
    var w = r
    closes = top_closes(w)
    empty = w.pending
    tag = tag_at(w)
    w = left_case(w)
    w.pending = false
    var at = skip_space(w.bytes, w.at)
    match w.json.cases {
      .key { }
      .tag(t) { w.tags = without_last_nat(w.tags) }
    }
    if not closes { return (w, Result.ok(())) }
    match w.json.cases {
      .key { }
      .tag(t) {
        // What is left of the object: the tag, when it is not before the
        // value, and the end.
        if empty and at == tag {
          match member(w.bytes, at) {
            .err(e) { return failed_unit(moved(w, w.at, at), e) }
            .ok(v) {
              match scan(w.bytes, skip_space(w.bytes, v)) {
                .err(e) { return failed_unit(moved(w, w.at, at), e) }
                .ok(e) { at = skip_space(w.bytes, e) }
              }
            }
          }
        } else if not empty and byte(w.bytes, at) == ',' {
          at = skip_space(w.bytes, saturating_add(at, 1))
          if at != tag { return failed_unit(moved(w, w.at, at), malformed(at)) }
          match member(w.bytes, at) {
            .err(e) { return failed_unit(moved(w, w.at, at), e) }
            .ok(v) {
              match scan(w.bytes, skip_space(w.bytes, v)) {
                .err(e) { return failed_unit(moved(w, w.at, at), e) }
                .ok(e) { at = skip_space(w.bytes, e) }
              }
            }
          }
        }
      }
    }
    if byte(w.bytes, at) == '}' {
      w.at = saturating_add(at, 1)
      w.mark = at
      (w, Result.ok(()))
    } else {
      failed_unit(moved(w, w.at, at), malformed(at))
    }
  }
  fn raw(r: take In) -> (In, Result[Slice[u8], ReadError]) ! alloc {
    match value_start(r) {
      .err(e) { failed_bytes(r, e) }
      .ok(a) {
        match scan(r.bytes, a) {
          .err(e) { failed_bytes(moved(r, r.at, a), e) }
          .ok(e) {
            if a <= e and e <= r.bytes.size {
              (moved(r, e, a), Result.ok(r.bytes[a..e]))
            } else {
              failed_bytes(moved(r, r.at, a), malformed(a))
            }
          }
        }
      }
    }
  }
  fn fail(r: take In, problem: Problem) -> (In, ReadError) ! alloc {
    (r, read_error(r.bytes, Bad(at: r.mark, problem: problem)))
  }
}

// Looks in the members of the object from `from`, after the value of a member
// named `name`, for another of that name, and gives it as `twice` at its name.
fn again(b: Slice[u8], from: Nat, name: str) -> Option[Bad] ! alloc {
  var at = from
  loop k in 0..b.size {
    at = skip_space(b, at)
    if byte(b, at) != ',' { return Option.none }
    at = skip_space(b, saturating_add(at, 1))
    match quoted(b, at) {
      .err(e) { return Option.none }
      .ok(q) {
        if text_at(b, q, at) == name {
          return Option.some(Bad(at: at, problem: .twice(name)))
        }
        match member(b, at) {
          .err(e) { return Option.none }
          .ok(v) {
            match scan(b, skip_space(b, v)) {
              .err(e) { return Option.none }
              .ok(e) { at = e }
            }
          }
        }
      }
    }
  }
  Option.none
}

pub trait FromJson[T] {
  fn from_json_as(text: str, json: Json) -> Result[T, ReadError] ! alloc
  fn from_json(text: str) -> Result[T, ReadError] ! alloc
}

impl[T] FromJson[T]
  requires Deserialize[T]
  requires Discard[T]
{
  fn from_json_as(text: str, json: Json) -> Result[T, ReadError] ! alloc {
    bytes = text.bytes
    r = In(bytes: bytes, at: 0, mark: 0, json: json, forms: 0, deep: [], cases: 0, pending: false, tags: [])
    (w, result): (In, Result[T, ReadError]) = read(r)
    match result {
      .err(e) { Result.err(e) }
      .ok(v) {
        a = skip_space(bytes, w.at)
        if a < bytes.size {
          Result.err(read_error(bytes, malformed(a)))
        } else {
          Result.ok(v)
        }
      }
    }
  }
  fn from_json(text: str) -> Result[T, ReadError] ! alloc {
    from_json_as(text, Json(cases: .key, names: .written))
  }
}

// A part of the text that is not taken apart: one whole JSON value, as the
// input holds it.
pub struct RawJson {
  pub text: str
}

without Serialize for RawJson

impl Deserialize[RawJson] {
  fn read[R: Reader](from: take R) -> (R, Result[RawJson, ReadError]) ! alloc {
    (r, got) = raw(from)
    match got {
      .err(e) { (r, Result.err(e)) }
      .ok(bytes) {
        match utf8(bytes) {
          .ok(t) { (r, Result.ok(RawJson(text: t))) }
          .err(u) {
            (w, e) = fail(r, .malformed)
            (w, Result.err(e))
          }
        }
      }
    }
  }
}

// What the error says, as `1:57: tools[2].timeout: expected a whole number,
// found a text`: the line and the column, the path when there is one, and the
// problem.
pub fn describe(e: ReadError) -> str ! alloc {
  what = match e.problem {
    .malformed { "not valid JSON" }
    .missing(n) { "missing `{n}`" }
    .shape((wanted, found)) { "expected {wanted}, found {found}" }
    .range(of) { "a number that does not fit {of}" }
    .case(n) { "`{n}` is not a case" }
    .unknown(n) { "unknown `{n}`" }
    .twice(n) { "`{n}` is given twice" }
  }
  if e.path.size == 0 { "{e.line}:{e.column}: {what}" } else { "{e.line}:{e.column}: {e.path}: {what}" }
}
