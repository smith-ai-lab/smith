pub fn push[T](list: take List[T], item: take T) -> List[T] ! alloc {
  __push(list, item)
}

pub fn append[T](a: take List[T], b: List[T]) -> List[T] ! alloc {
  __append(a, b)
}

pub fn copy[T: Copy](list: List[T]) -> List[T] ! alloc {
  var made: List[T] = []
  loop x in list { made = push(made, x) }
  made
}

pub fn freeze[T](list: take List[T]) -> Slice[T] {
  __freeze(list)
}
