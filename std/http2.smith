// How many symbols have a code of each length of bits, from 0 to 30. The code is canonical: of one length, the codes follow one another in the order of the symbols.
fn huffman_counts() -> Slice[Byte] {
  [
    0, 0, 0, 0, 0, 10, 26, 32, 6, 0, 5, 3, 2, 6, 2, 3, 0, 0, 0, 3, 8, 13, 26, 29, 12, 4, 15, 19,
    29, 0, 4
  ]
}

