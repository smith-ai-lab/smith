use std.bits (bit_and, bit_or, shift_left, shift_right, u32, u64)
use std.http1 (Read)
use std.int (saturating_sub, wrapping_add, wrapping_mul, wrapping_narrow, wrapping_sub)
use std.list (freeze, push)
use std.utf8 (utf8)

// The frames.

pub struct Dependency {
  pub exclusive: bool
  pub stream: 0..2147483648
  pub weight: Byte
}

pub struct Data {
  pub stream: 0..2147483648
  pub end_stream: bool
  pub padding: Option[Byte]
  pub data: Slice[Byte]
}

pub struct Headers {
  pub stream: 0..2147483648
  pub end_stream: bool
  pub end_headers: bool
  pub padding: Option[Byte]
  pub priority: Option[Dependency]
  pub block: Slice[Byte]
}

pub struct Reset {
  pub stream: 0..2147483648
  pub code: u32
}

pub struct Promise {
  pub stream: 0..2147483648
  pub end_headers: bool
  pub padding: Option[Byte]
  pub promised: 0..2147483648
  pub block: Slice[Byte]
}

pub struct Ping {
  pub ack: bool
  pub data: u64
}

pub struct GoAway {
  pub last: 0..2147483648
  pub code: u32
  pub debug: Slice[Byte]
}

pub struct Window {
  pub stream: 0..2147483648
  pub increment: 0..2147483648
}

pub struct Continuation {
  pub stream: 0..2147483648
  pub end_headers: bool
  pub block: Slice[Byte]
}

pub enum Frame {
  data: Data
  headers: Headers
  priority: Nat
  reset: Reset
  settings: List[(Nat, Nat)]
  settings_ack
  push_promise: Promise
  ping: Ping
  go_away: GoAway
  window_update: Window
  continuation: Continuation
  unknown: Nat
}

fn nat(b: Byte) -> Nat { convert(b) }

// The byte at `i`, which is 0 beyond the end.
fn at(b: Slice[Byte], i: Nat) -> Byte {
  if i < b.size { b[i] } else { 0 }
}

// The bytes from `from` up to `to`, which are none where that is no piece.
fn piece(b: Slice[Byte], from: Nat, to: Nat) -> Slice[Byte] {
  if from <= to and to <= b.size { b[from..to] } else { b[0..0] }
}

fn be16(b: Slice[Byte], i: Nat) -> Nat {
  wrapping_add(wrapping_mul(nat(at(b, i)), 256), nat(at(b, wrapping_add(i, 1))))
}

fn be24(b: Slice[Byte], i: Nat) -> Nat {
  wrapping_add(wrapping_mul(nat(at(b, i)), 65536), be16(b, wrapping_add(i, 1)))
}

fn be32(b: Slice[Byte], i: Nat) -> Nat {
  wrapping_add(wrapping_mul(be16(b, i), 65536), be16(b, wrapping_add(i, 2)))
}

fn be64(b: Slice[Byte], i: Nat) -> Nat {
  wrapping_add(wrapping_mul(be32(b, i), 4294967296), be32(b, wrapping_add(i, 4)))
}

// A stream, which is the low 31 bits: the highest is reserved and is ignored.
fn stream_of(x: Nat) -> 0..2147483648 {
  y = bit_and(x, 2147483647)
  if y < 2147483648 { y } else { 0 }
}

fn word_of(x: Nat) -> u32 {
  y = bit_and(x, 4294967295)
  if y < 4294967296 { y } else { 0 }
}

fn shl(x: Nat, by: Byte) -> Nat { if by < 64 { shift_left(x, by) } else { 0 } }

fn shr(x: Nat, by: Byte) -> Nat { if by < 64 { shift_right(x, by) } else { 0 } }

fn low(x: Nat) -> Byte { wrapping_narrow(bit_and(x, 255)) }

fn put16(to: take List[Byte], x: Nat) -> List[Byte] ! alloc {
  push(push(to, low(shift_right(x, 8))), low(x))
}

fn put24(to: take List[Byte], x: Nat) -> List[Byte] ! alloc {
  push(put16(to, shift_right(x, 8)), low(x))
}

fn put32(to: take List[Byte], x: Nat) -> List[Byte] ! alloc {
  put16(put16(to, shift_right(x, 16)), x)
}

fn put64(to: take List[Byte], x: Nat) -> List[Byte] ! alloc {
  put32(put32(to, shift_right(x, 32)), x)
}

fn put_all(to: take List[Byte], s: Slice[Byte]) -> List[Byte] ! alloc {
  var w = to
  loop x in s { w = push(w, x) }
  w
}

fn put_zeros(to: take List[Byte], n: Nat) -> List[Byte] ! alloc {
  var w = to
  loop i in 0..n { w = push(w, 0) }
  w
}

fn is_padded(padding: Option[Byte]) -> bool {
  match padding {
    .some(p) { true }
    .none { false }
  }
}

fn has_dependency(priority: Option[Dependency]) -> bool {
  match priority {
    .some(d) { true }
    .none { false }
  }
}

fn flag(on: bool, bit: Byte) -> Byte { if on { bit } else { 0 } }

fn has(flags: Byte, bit: Byte) -> bool { bit_and(flags, bit) != 0 }

// The nine bytes that start a frame.
fn head(to: take List[Byte], length: Nat, kind: Byte, flags: Byte, stream: Nat) -> List[Byte] ! alloc {
  put32(push(push(put24(to, length), kind), flags), stream)
}

// The bytes a padding takes: its length and what it says.
fn padded_by(padding: Option[Byte]) -> Nat {
  match padding {
    .some(p) { wrapping_add(nat(p), 1) }
    .none { 0 }
  }
}

fn put_pad_length(to: take List[Byte], padding: Option[Byte]) -> List[Byte] ! alloc {
  match padding {
    .some(p) { push(to, p) }
    .none { to }
  }
}

fn put_padding(to: take List[Byte], padding: Option[Byte]) -> List[Byte] ! alloc {
  match padding {
    .some(p) { put_zeros(to, nat(p)) }
    .none { to }
  }
}

fn put_dependency(to: take List[Byte], d: Dependency) -> List[Byte] ! alloc {
  s: Nat = d.stream
  x = if d.exclusive { wrapping_add(s, 2147483648) } else { s }
  push(put32(to, x), d.weight)
}

pub fn write_frame(to: take List[Byte], frame: Frame) -> List[Byte] ! alloc {
  match frame {
    .data(f) {
      length = wrapping_add(f.data.size, padded_by(f.padding))
      flags = bit_or(flag(f.end_stream, 1), flag(is_padded(f.padding), 8))
      put_padding(put_all(put_pad_length(head(to, length, 0, flags, f.stream), f.padding), f.data), f.padding)
    }
    .headers(f) {
      fixed = match f.priority {
        .some(d) { 5 }
        .none { 0 }
      }
      length = wrapping_add(wrapping_add(f.block.size, padded_by(f.padding)), fixed)
      flags = bit_or(bit_or(flag(f.end_stream, 1), flag(f.end_headers, 4)), bit_or(flag(is_padded(f.padding), 8), flag(has_dependency(f.priority), 32)))
      w = put_pad_length(head(to, length, 1, flags, f.stream), f.padding)
      v = match f.priority {
        .some(d) { put_dependency(w, d) }
        .none { w }
      }
      put_padding(put_all(v, f.block), f.padding)
    }
    .priority(s) { push(put32(head(to, 5, 2, 0, s), 0), 0) }
    .reset(f) { put32(head(to, 4, 3, 0, f.stream), f.code) }
    .settings(pairs) {
      var w = head(to, wrapping_mul(pairs.size, 6), 4, 0, 0)
      loop (id, value) in pairs { w = put32(put16(w, id), value) }
      w
    }
    .settings_ack { head(to, 0, 4, 1, 0) }
    .push_promise(f) {
      length = wrapping_add(wrapping_add(f.block.size, padded_by(f.padding)), 4)
      flags = bit_or(flag(f.end_headers, 4), flag(is_padded(f.padding), 8))
      w = put32(put_pad_length(head(to, length, 5, flags, f.stream), f.padding), f.promised)
      put_padding(put_all(w, f.block), f.padding)
    }
    .ping(f) { put64(head(to, 8, 6, flag(f.ack, 1), 0), f.data) }
    .go_away(f) { put_all(put32(put32(head(to, wrapping_add(f.debug.size, 8), 7, 0, 0), f.last), f.code), f.debug) }
    .window_update(f) { put32(head(to, 4, 8, 0, f.stream), f.increment) }
    .continuation(f) { put_all(head(to, f.block.size, 9, flag(f.end_headers, 4), f.stream), f.block) }
    .unknown(kind) { head(to, 0, low(kind), 0, 0) }
  }
}

// The fields a frame has before its padding: where its data starts and ends,
// and the padding it says.
struct Body {
  from: Nat
  to: Nat
  padding: Option[Byte]
}

// A payload of `n` bytes that start at `start`, with `fixed` bytes of fields
// before the data, and the padding it has when `padded`. The padding may not
// be longer than the payload leaves room for.
fn body(b: Slice[Byte], start: Nat, n: Nat, padded: bool, fixed: Nat) -> Result[Body, str] {
  if not padded {
    if n < fixed { return Result.err("a frame too short for its fields") }
    return Result.ok(Body(from: start, to: wrapping_add(start, n), padding: .none))
  }
  if n == 0 { return Result.err("a padded frame with no length of padding") }
  p = at(b, start)
  if wrapping_add(nat(p), fixed) > wrapping_sub(n, 1) {
    return Result.err("padding longer than the frame")
  }
  Result.ok(Body(from: wrapping_add(start, 1), to: wrapping_sub(wrapping_add(start, n), nat(p)), padding: .some(p)))
}

fn refused(why: str) -> Read[Frame] { Read.refused(why) }

fn done(f: take Frame, end: Nat) -> Read[Frame] { Read.complete((f, end)) }

// A frame that is on a stream, or the connection, as its kind needs.
fn needs_stream(kind: Byte) -> bool {
  kind == 0 or kind == 1 or kind == 2 or kind == 3 or kind == 5 or kind == 9
}

fn needs_connection(kind: Byte) -> bool { kind == 4 or kind == 6 or kind == 7 }

// `n` divided by 6, which is the high bits of its product with the closest
// whole number to 2 to the 34 over 6, exact for any `n` below 2 to the 32.
fn sixths(n: Nat) -> Nat { shift_right(wrapping_mul(n, 2863311531), 34) }

pub fn frame(bytes: Slice[Byte], largest: Nat = 16384) -> Read[Frame] ! alloc {
  if bytes.size < 9 { return Read.incomplete }
  n = be24(bytes, 0)
  if n > largest { return refused("a frame longer than the most that is read") }
  kind = bytes[3]
  flags = bytes[4]
  s = be32(bytes, 5)
  stream = stream_of(s)
  if needs_stream(kind) and stream == 0 { return refused("a frame that must be on a stream is on stream 0") }
  if needs_connection(kind) and stream != 0 { return refused("a frame that must be on stream 0 is on a stream") }
  if kind == 2 and n != 5 { return refused("a PRIORITY that is not 5 bytes") }
  if kind == 3 and n != 4 { return refused("a RST_STREAM that is not 4 bytes") }
  if kind == 6 and n != 8 { return refused("a PING that is not 8 bytes") }
  if kind == 8 and n != 4 { return refused("a WINDOW_UPDATE that is not 4 bytes") }
  if kind == 4 and has(flags, 1) and n != 0 { return refused("a SETTINGS with ACK that holds settings") }
  if kind == 4 and wrapping_sub(n, wrapping_mul(sixths(n), 6)) != 0 { return refused("a SETTINGS that is not a whole number of settings") }
  if kind == 7 and n < 8 { return refused("a GOAWAY of fewer than 8 bytes") }
  end = wrapping_add(9, n)
  if bytes.size < end { return Read.incomplete }
  if kind == 0 {
    match body(bytes, 9, n, has(flags, 8), 0) {
      .err(why) { return refused(why) }
      .ok(r) { return done(.data(Data(stream: stream, end_stream: has(flags, 1), padding: r.padding, data: piece(bytes, r.from, r.to))), end) }
    }
  }
  if kind == 1 {
    prio = has(flags, 32)
    fixed: Nat = if prio { 5 } else { 0 }
    match body(bytes, 9, n, has(flags, 8), fixed) {
      .err(why) { return refused(why) }
      .ok(r) {
        dependency: Option[Dependency] = if prio {
          w = be32(bytes, r.from)
          .some(Dependency(exclusive: w >= 2147483648, stream: stream_of(w), weight: at(bytes, wrapping_add(r.from, 4))))
        } else { .none }
        return done(.headers(Headers(stream: stream, end_stream: has(flags, 1), end_headers: has(flags, 4), padding: r.padding, priority: dependency, block: piece(bytes, wrapping_add(r.from, fixed), r.to))), end)
      }
    }
  }
  if kind == 2 { return done(.priority(stream), end) }
  if kind == 3 { return done(.reset(Reset(stream: stream, code: word_of(be32(bytes, 9)))), end) }
  if kind == 4 {
    if has(flags, 1) { return done(.settings_ack, end) }
    var pairs: List[(Nat, Nat)] = []
    loop i in 0..sixths(n) {
      at_ = wrapping_add(9, wrapping_mul(i, 6))
      pairs = push(pairs, (be16(bytes, at_), be32(bytes, wrapping_add(at_, 2))))
    }
    return done(.settings(pairs), end)
  }
  if kind == 5 {
    match body(bytes, 9, n, has(flags, 8), 4) {
      .err(why) { return refused(why) }
      .ok(r) { return done(.push_promise(Promise(stream: stream, end_headers: has(flags, 4), padding: r.padding, promised: stream_of(be32(bytes, r.from)), block: piece(bytes, wrapping_add(r.from, 4), r.to))), end) }
    }
  }
  if kind == 6 { return done(.ping(Ping(ack: has(flags, 1), data: be64(bytes, 9))), end) }
  if kind == 7 { return done(.go_away(GoAway(last: stream_of(be32(bytes, 9)), code: word_of(be32(bytes, 13)), debug: piece(bytes, 17, end))), end) }
  if kind == 8 { return done(.window_update(Window(stream: stream, increment: stream_of(be32(bytes, 9)))), end) }
  if kind == 9 { return done(.continuation(Continuation(stream: stream, end_headers: has(flags, 4), block: piece(bytes, 9, end))), end) }
  done(.unknown(nat(kind)), end)
}

// The headers.

struct Entry {
  name: str
  value: str
}

// The size of an entry in the table, which is the bytes of its text and 32.
fn entry_size(e: Entry) -> Nat {
  wrapping_add(wrapping_add(e.name.size, e.value.size), 32)
}

// The dynamic table: the entries that were added, oldest first, from `first`,
// which are those before it and gone, and `size`, the sum of their sizes, kept
// within `working`, which the encoder may change up to `limit`.
struct Table {
  entries: List[Entry]
  first: Nat
  size: Nat
  working: Nat
  limit: Nat
}

fn table_new(limit: Nat) -> Table {
  working = if limit < 4096 { limit } else { 4096 }
  Table(entries: [], first: 0, size: 0, working: working, limit: limit)
}

fn table_get(t: Table, d: Nat) -> Option[Entry] {
  at_ = wrapping_sub(t.entries.size, d)
  if d >= 1 and d <= wrapping_sub(t.entries.size, t.first) and at_ < t.entries.size {
    .some(t.entries[at_])
  } else { .none }
}

// The table with the entries that are gone taken out of the list.
fn table_packed(t: take Table) -> Table ! alloc {
  var w = t
  if w.first >= 32 and wrapping_mul(w.first, 2) >= w.entries.size {
    var kept: List[Entry] = []
    loop i in w.first..w.entries.size {
      if i < w.entries.size { kept = push(kept, w.entries[i]) }
    }
    w.entries = kept
    w.first = 0
  }
  w
}

// The table with its oldest entries gone until it holds no more than `room`.
fn table_evict(t: take Table, room: Nat) -> Table ! alloc {
  var w = t
  loop k in 0..w.entries.size {
    if w.size <= room or w.first >= w.entries.size { break }
    e = w.entries[w.first]
    w.size = wrapping_sub(w.size, entry_size(e))
    w.first = wrapping_add(w.first, 1)
  }
  table_packed(w)
}

fn table_resize(t: take Table, to: Nat) -> Table ! alloc {
  var w = t
  w.working = to
  table_evict(w, to)
}

// The table with `e` as its newest entry. An entry that is more than the table
// may hold leaves it empty.
fn table_add(t: take Table, e: Entry) -> Table ! alloc {
  size = entry_size(e)
  working = t.working
  var w = table_evict(t, saturating_sub(working, size))
  if size <= working {
    w.entries = push(w.entries, e)
    w.size = wrapping_add(w.size, size)
  }
  w
}

// The entry at `i`, where the static table is 1 to 61 and the dynamic table
// follows.
fn entry_at(t: Table, i: Nat) -> Option[Entry] {
  if i == 0 { return .none }
  if i <= 61 {
    (n, v) = static_entry(i)
    return .some(Entry(name: n, value: v))
  }
  table_get(t, wrapping_sub(i, 61))
}

pub struct Decoder {
  table: Table
}

pub struct Encoder {
  table: Table
  update: bool
}

pub fn decoder(table: Nat = 4096) -> Decoder { Decoder(table: table_new(table)) }

pub fn encoder(table: Nat = 4096) -> Encoder {
  Encoder(table: table_new(table), update: table != 4096)
}

fn code_at(codes: Slice[u32], i: Nat) -> Nat {
  if i < codes.size { codes[i] } else { 0 }
}

// A number of `mask` and fewer, then of more bytes, as HPACK writes it.
struct Num {
  value: Nat
  next: Nat
}

fn read_num(b: Slice[Byte], start: Nat, mask: Byte) -> Result[Num, str] {
  if start >= b.size { return Result.err("a block that ends before a number") }
  m = nat(mask)
  first = nat(bit_and(at(b, start), mask))
  if first < m { return Result.ok(Num(value: first, next: wrapping_add(start, 1))) }
  var v = m
  var shift: Byte = 0
  var i = wrapping_add(start, 1)
  loop k in 0..5 {
    if i >= b.size { return Result.err("a number that does not end") }
    c = at(b, i)
    v = wrapping_add(v, shl(nat(bit_and(c, 127)), shift))
    i = wrapping_add(i, 1)
    if c < 128 {
      if v > 4294967295 { return Result.err("a number that is too great") }
      return Result.ok(Num(value: v, next: i))
    }
    shift = wrapping_add(shift, 7)
  }
  Result.err("a number that does not end")
}

// The text that the Huffman code of HPACK gives for `b`, of no more than
// `room` bytes. The code is canonical, so a symbol is found from the number of
// codes of each length, with no table of codes: `first` is the first code of
// the length being read, and `index` is where its symbols start in `order`.
// What is left after the last symbol must be padding of up to 7 bits, which
// are the first bits of the end of a text, all of them 1.
fn huffman(b: Slice[Byte], room: Nat) -> Result[List[Byte], str] ! alloc {
  counts = huffman_counts()
  order = huffman_order()
  var acc: List[Byte] = []
  var code: Nat = 0
  var first: Nat = 0
  var index: Nat = 0
  var len: Byte = 0
  var ones = true
  loop i in 0..b.size {
    c = b[i]
    loop j in 0..8 {
      bit = nat(bit_and(shr(nat(c), wrapping_narrow(wrapping_sub(7, j))), 1))
      code = wrapping_add(code, bit)
      len = wrapping_add(len, 1)
      ones = ones and bit == 1
      count = nat(at(counts, nat(len)))
      if code < wrapping_add(first, count) {
        found = wrapping_add(index, wrapping_sub(code, first))
        if found >= order.size { return Result.err("a text in the short code that holds its end") }
        if acc.size >= room { return Result.err("headers of more bytes than are read") }
        acc = push(acc, order[found])
        code = 0
        first = 0
        index = 0
        len = 0
        ones = true
      } else {
        index = wrapping_add(index, count)
        first = wrapping_mul(wrapping_add(first, count), 2)
        code = wrapping_mul(code, 2)
      }
    }
  }
  if len > 7 { return Result.err("a text in the short code that ends with more than 7 bits of padding") }
  if len > 0 and not ones { return Result.err("a text in the short code that ends with padding that is not the end of a text") }
  Result.ok(acc)
}

// A text of the block that starts at `start`: its length, and its bytes as
// they are or in the short code. It gives the text and where it ends, and is
// refused where it is of more than `room` bytes.
fn read_text(b: Slice[Byte], start: Nat, room: Nat) -> Result[(str, Nat), str] ! alloc {
  if start >= b.size { return Result.err("a block that ends before a text") }
  short = has(at(b, start), 128)
  match read_num(b, start, 127) {
    .err(why) { Result.err(why) }
    .ok(n) {
      end = wrapping_add(n.next, n.value)
      if end > b.size or end < n.next { return Result.err("a text that is longer than the block") }
      bytes = piece(b, n.next, end)
      if short {
        match huffman(bytes, room) {
          .err(why) { Result.err(why) }
          .ok(list) {
            match utf8(freeze(list)) {
              .ok(t) { Result.ok((t, end)) }
              .err(e) { Result.err("a text that is not UTF-8") }
            }
          }
        }
      } else {
        if n.value > room { return Result.err("headers of more bytes than are read") }
        match utf8(bytes) {
          .ok(t) { Result.ok((t, end)) }
          .err(e) { Result.err("a text that is not UTF-8") }
        }
      }
    }
  }
}

// What a block has made so far.
struct Run {
  table: Table
  acc: List[(str, str)]
  used: Nat
  at: Nat
  updates: bool
}

// The run with a header added and the block read up to `next`, or why not.
fn emit(r: take Run, name: str, value: str, next: Nat, largest: Nat) -> (Run, Option[str]) ! alloc {
  var w = r
  used = wrapping_add(w.used, wrapping_add(name.size, value.size))
  if used > largest { return (w, .some("headers of more bytes than are read")) }
  w.used = used
  w.acc = push(w.acc, (name, value))
  w.at = next
  (w, .none)
}

// One representation of the block.
fn step(r: take Run, b: Slice[Byte], largest: Nat) -> (Run, Option[str]) ! alloc {
  var w = r
  c = at(b, w.at)
  if c >= 128 {
    w.updates = false
    match read_num(b, w.at, 127) {
      .err(why) { return (w, .some(why)) }
      .ok(n) {
        match entry_at(w.table, n.value) {
          .none { return (w, .some("an index that names no header")) }
          .some(e) { return emit(w, e.name, e.value, n.next, largest) }
        }
      }
    }
  }
  if c >= 32 and c < 64 {
    if not w.updates { return (w, .some("a change of the table's size that is not at the start of a block")) }
    match read_num(b, w.at, 31) {
      .err(why) { return (w, .some(why)) }
      .ok(n) {
        if n.value > w.table.limit { return (w, .some("a change of the table's size to more than was agreed")) }
        w.table = table_resize(w.table, n.value)
        w.at = n.next
        return (w, .none)
      }
    }
  }
  w.updates = false
  indexed = c >= 64
  mask: Byte = if indexed { 63 } else { 15 }
  match read_num(b, w.at, mask) {
    .err(why) { return (w, .some(why)) }
    .ok(n) {
      room = saturating_sub(largest, w.used)
      var name = ""
      var next = n.next
      if n.value == 0 {
        match read_text(b, next, room) {
          .err(why) { return (w, .some(why)) }
          .ok(t) {
            (text, end) = t
            name = text
            next = end
          }
        }
      } else {
        match entry_at(w.table, n.value) {
          .none { return (w, .some("an index that names no header")) }
          .some(e) { name = e.name }
        }
      }
      match read_text(b, next, saturating_sub(room, name.size)) {
        .err(why) { return (w, .some(why)) }
        .ok(t) {
          (value, end) = t
          if indexed { w.table = table_add(w.table, Entry(name: name, value: value)) }
          return emit(w, name, value, end, largest)
        }
      }
    }
  }
}

pub fn decode(d: take Decoder, block: Slice[Byte], largest: Nat = 65536) -> (Decoder, Result[List[(str, str)], str]) ! alloc {
  var r = Run(table: d.table, acc: [], used: 0, at: 0, updates: true)
  loop k in 0..block.size {
    if r.at >= block.size { break }
    (next, bad) = step(r, block, largest)
    r = next
    match bad {
      .some(why) { return (Decoder(table: r.table), Result.err(why)) }
      .none { }
    }
  }
  (Decoder(table: r.table), Result.ok(r.acc))
}
// A number as HPACK writes it, in a byte that starts with the bits of `prefix`
// and has room for `mask`, and more bytes if it is more.
fn write_num(to: take List[Byte], prefix: Byte, mask: Byte, value: Nat) -> List[Byte] ! alloc {
  m = nat(mask)
  if value < m { return push(to, bit_or(prefix, low(value))) }
  var w = push(to, bit_or(prefix, mask))
  var rest = wrapping_sub(value, m)
  loop k in 0..10 {
    if rest < 128 { return push(w, low(rest)) }
    w = push(w, bit_or(128, low(bit_and(rest, 127))))
    rest = shift_right(rest, 7)
  }
  w
}

// How many bytes the short code gives for `s`.
fn huffman_size(s: str) -> Nat {
  lengths = huffman_lengths()
  var bits: Nat = 0
  loop i in 0..s.size { bits = wrapping_add(bits, nat(at(lengths, nat(s[i])))) }
  shift_right(wrapping_add(bits, 7), 3)
}

// The short code of `s`, with the first bits of the end of a text to fill its
// last byte.
fn write_huffman(to: take List[Byte], s: str) -> List[Byte] ! alloc {
  codes = huffman_codes()
  lengths = huffman_lengths()
  var w = to
  var acc: Nat = 0
  var pending: Byte = 0
  loop i in 0..s.size {
    sym = nat(s[i])
    len = at(lengths, sym)
    acc = bit_or(shl(acc, len), code_at(codes, sym))
    pending = wrapping_add(pending, len)
    loop k in 0..4 {
      if pending < 8 { break }
      pending = wrapping_sub(pending, 8)
      w = push(w, low(shr(acc, pending)))
    }
    acc = bit_and(acc, wrapping_sub(shl(1, pending), 1))
  }
  if pending > 0 {
    fill = wrapping_sub(8, pending)
    w = push(w, low(bit_or(shl(acc, fill), wrapping_sub(shl(1, fill), 1))))
  }
  w
}

fn write_text(to: take List[Byte], s: str) -> List[Byte] ! alloc {
  short = huffman_size(s)
  if short <= s.size { return write_huffman(write_num(to, 128, 127, short), s) }
  var w = write_num(to, 0, 127, s.size)
  loop i in 0..s.size { w = push(w, s[i]) }
  w
}

// A header written as a literal, with its name by its index when it has one.
fn write_literal(to: take List[Byte], prefix: Byte, mask: Byte, name_at: Nat, name: str, value: str) -> List[Byte] ! alloc {
  var w = write_num(to, prefix, mask, name_at)
  if name_at == 0 { w = write_text(w, name) }
  write_text(w, value)
}

// Where a header is in the tables: the index of one with its name and value,
// and of one with its name, or 0.
struct Found {
  whole: Nat
  name: Nat
}

fn find(t: Table, name: str, value: str) -> Found {
  var whole: Nat = 0
  var by_name: Nat = 0
  loop i in 1..62 {
    (n, v) = static_entry(i)
    if n == name {
      if by_name == 0 { by_name = i }
      if v == value {
        whole = i
        break
      }
    }
  }
  if whole == 0 {
    loop d in 1..wrapping_add(wrapping_sub(t.entries.size, t.first), 1) {
      match table_get(t, d) {
        .some(e) {
          if e.name == name {
            if by_name == 0 { by_name = wrapping_add(d, 61) }
            if e.value == value {
              whole = wrapping_add(d, 61)
              break
            }
          }
        }
        .none { }
      }
    }
  }
  Found(whole: whole, name: by_name)
}

// A header whose value is a secret of the one who sends it: the length of what
// follows it in the table would tell a guess of it that was right.
fn is_secret(name: str) -> bool {
  name == "authorization" or name == "cookie" or name == "set-cookie"
}

pub fn encode(e: take Encoder, to: take List[Byte], headers: List[(str, str)]) -> (Encoder, List[Byte]) ! alloc {
  var t = e.table
  var w = to
  if e.update {
    limit = t.limit
    w = write_num(w, 32, 31, limit)
    t = table_resize(t, limit)
  }
  loop (name, value) in headers {
    f = find(t, name, value)
    if is_secret(name) {
      w = write_literal(w, 16, 15, f.name, name, value)
    } else if f.whole != 0 {
      w = write_num(w, 128, 127, f.whole)
    } else {
      w = write_literal(w, 64, 63, f.name, name, value)
      t = table_add(t, Entry(name: name, value: value))
    }
  }
  (Encoder(table: t, update: false), w)
}

// The static table of HPACK, from the index 1.
fn static_entry(i: Nat) -> (str, str) {
  match i {
    1 { (":authority", "") }
    2 { (":method", "GET") }
    3 { (":method", "POST") }
    4 { (":path", "/") }
    5 { (":path", "/index.html") }
    6 { (":scheme", "http") }
    7 { (":scheme", "https") }
    8 { (":status", "200") }
    9 { (":status", "204") }
    10 { (":status", "206") }
    11 { (":status", "304") }
    12 { (":status", "400") }
    13 { (":status", "404") }
    14 { (":status", "500") }
    15 { ("accept-charset", "") }
    16 { ("accept-encoding", "gzip, deflate") }
    17 { ("accept-language", "") }
    18 { ("accept-ranges", "") }
    19 { ("accept", "") }
    20 { ("access-control-allow-origin", "") }
    21 { ("age", "") }
    22 { ("allow", "") }
    23 { ("authorization", "") }
    24 { ("cache-control", "") }
    25 { ("content-disposition", "") }
    26 { ("content-encoding", "") }
    27 { ("content-language", "") }
    28 { ("content-length", "") }
    29 { ("content-location", "") }
    30 { ("content-range", "") }
    31 { ("content-type", "") }
    32 { ("cookie", "") }
    33 { ("date", "") }
    34 { ("etag", "") }
    35 { ("expect", "") }
    36 { ("expires", "") }
    37 { ("from", "") }
    38 { ("host", "") }
    39 { ("if-match", "") }
    40 { ("if-modified-since", "") }
    41 { ("if-none-match", "") }
    42 { ("if-range", "") }
    43 { ("if-unmodified-since", "") }
    44 { ("last-modified", "") }
    45 { ("link", "") }
    46 { ("location", "") }
    47 { ("max-forwards", "") }
    48 { ("proxy-authenticate", "") }
    49 { ("proxy-authorization", "") }
    50 { ("range", "") }
    51 { ("referer", "") }
    52 { ("refresh", "") }
    53 { ("retry-after", "") }
    54 { ("server", "") }
    55 { ("set-cookie", "") }
    56 { ("strict-transport-security", "") }
    57 { ("transfer-encoding", "") }
    58 { ("user-agent", "") }
    59 { ("vary", "") }
    60 { ("via", "") }
    61 { ("www-authenticate", "") }
    _ { ("", "") }
  }
}

