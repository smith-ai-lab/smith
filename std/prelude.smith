enum Option[T] {
  some: T
  none
}

enum Result[T, E] {
  ok: T
  err: E
}

enum bool {
  false
  true
}

enum Order {
  less
  equal
  greater
}

enum Flow[T = (), R = ()] {
  go: T
  stop: R
}

struct Utf8Error {
  at: u64
}

trait Eq[T] {
  fn eq(a: T, b: T) -> bool
}

trait Ord[T] {
  fn compare(a: T, b: T) -> Order
}

trait Hash[T] {
  fn hash(value: T) -> u64
}

trait Convert[A, B] {
  fn convert(a: A) -> B
}

trait Fmt[T] {
  fn fmt(value: T) -> str ! alloc
}

trait Repr[T] {
  fn repr(value: T) -> str ! alloc
}

impl Fmt[str] {
  fn fmt(value: str) -> str ! alloc { value }
}

trait Exit[T] {
  fn exit(value: T) -> u8 ! console, alloc
}

impl Exit[()] {
  fn exit(value: ()) -> u8 ! console, alloc { 0 }
}

impl[T: Exit, E: Fmt] Exit[Result[T, E]] {
  fn exit(value: Result[T, E]) -> u8 ! console, alloc {
    match value {
      .ok(x) { Exit.exit(x) }
      .err(e) {
        __eprint(fmt(e))
        1
      }
    }
  }
}

trait Try[C, R, out T] {
  fn split(c: take C) -> Flow[T, R]
}

impl[T, U, E] Try[Result[T, E], Result[U, E], T] {
  fn split(c: take Result[T, E]) -> Flow[T, Result[U, E]] {
    match c {
      .ok(x) { .go(x) }
      .err(e) { .stop(.err(e)) }
    }
  }
}

impl[T, U] Try[Option[T], Option[U], T] {
  fn split(c: take Option[T]) -> Flow[T, Option[U]] {
    match c {
      .some(x) { .go(x) }
      .none { .stop(.none) }
    }
  }
}

impl[T, U, R] Try[Flow[T, R], Flow[U, R], T] {
  fn split(c: take Flow[T, R]) -> Flow[T, Flow[U, R]] {
    match c {
      .go(x) { .go(x) }
      .stop(r) { .stop(.stop(r)) }
    }
  }
}

trait Iterate[C, out T] {
  fn each(c: C, body: fn(T) -> Flow) -> Flow
}

impl[T] Iterate[List[T], T] {
  fn each(c: List[T], body: fn(T) -> Flow) -> Flow {
    loop i in 0..c.size {
      match body(c[i]) {
        .stop { return .stop }
        .go { }
      }
    }
    .go
  }
}

trait Wrapping[T] {
  fn wrapping_add(a: T, b: T) -> T
  fn wrapping_sub(a: T, b: T) -> T
  fn wrapping_mul(a: T, b: T) -> T
}

trait Saturating[T] {
  fn saturating_add(a: T, b: T) -> T
  fn saturating_sub(a: T, b: T) -> T
  fn saturating_mul(a: T, b: T) -> T
}

trait Checked[T] {
  fn checked_add(a: T, b: T) -> Option[T]
  fn checked_sub(a: T, b: T) -> Option[T]
  fn checked_mul(a: T, b: T) -> Option[T]
}

trait Bits[T] {
  fn bit_and(a: T, b: T) -> T
  fn bit_or(a: T, b: T) -> T
  fn bit_xor(a: T, b: T) -> T
  fn bit_not(a: T) -> T
  fn shift_left(a: T, by: u8) -> T
  fn shift_right(a: T, by: u8) -> T
}


impl Eq[i8] {
  fn eq(a: i8, b: i8) -> bool { __equal(a, b) }
}

impl Ord[i8] {
  fn compare(a: i8, b: i8) -> Order { __compare(a, b) }
}

impl Fmt[i8] {
  fn fmt(value: i8) -> str ! alloc { __decimal(value) }
}

impl Repr[i8] {
  fn repr(value: i8) -> str ! alloc { __decimal(value) }
}

impl Wrapping[i8] {
  fn wrapping_add(a: i8, b: i8) -> i8 { __wrapping_add(a, b) }
  fn wrapping_sub(a: i8, b: i8) -> i8 { __wrapping_sub(a, b) }
  fn wrapping_mul(a: i8, b: i8) -> i8 { __wrapping_mul(a, b) }
}

impl Saturating[i8] {
  fn saturating_add(a: i8, b: i8) -> i8 { __saturating_add(a, b) }
  fn saturating_sub(a: i8, b: i8) -> i8 { __saturating_sub(a, b) }
  fn saturating_mul(a: i8, b: i8) -> i8 { __saturating_mul(a, b) }
}

impl Checked[i8] {
  fn checked_add(a: i8, b: i8) -> Option[i8] { __checked_add(a, b) }
  fn checked_sub(a: i8, b: i8) -> Option[i8] { __checked_sub(a, b) }
  fn checked_mul(a: i8, b: i8) -> Option[i8] { __checked_mul(a, b) }
}

impl Convert[i8, i16] {
  fn convert(a: i8) -> i16 { __convert(a) }
}

impl Convert[i8, i32] {
  fn convert(a: i8) -> i32 { __convert(a) }
}

impl Convert[i8, i64] {
  fn convert(a: i8) -> i64 { __convert(a) }
}

impl Bits[i8] {
  fn bit_and(a: i8, b: i8) -> i8 { __bit_and(a, b) }
  fn bit_or(a: i8, b: i8) -> i8 { __bit_or(a, b) }
  fn bit_xor(a: i8, b: i8) -> i8 { __bit_xor(a, b) }
  fn bit_not(a: i8) -> i8 { __bit_not(a) }
  fn shift_left(a: i8, by: u8) -> i8 { __shift_left(a, by) }
  fn shift_right(a: i8, by: u8) -> i8 { __shift_right(a, by) }
}

