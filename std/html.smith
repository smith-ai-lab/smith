use std.text (Text, append, finish, text as new_text)
use std.utf8 (utf8)

// The bytes of `s` from `from` up to `end`, which are whole characters, as
// they are. The piece lies between two escaped bytes, which are ASCII, or at an
// end of `s`, so `utf8` never refuses it. It is written with `utf8` until
// `s[from..end]` is built (#778), which makes the piece with nothing read again.
fn run(to: take Text, s: str, from: Nat, end: Nat) -> Text ! alloc {
  var t = to
  if from == 0 and end == s.size {
    t = append(t, s)
  } else if from < end and end <= s.size {
    match utf8(s.bytes[from..end]) {
      .ok(piece) { t = append(t, piece) }
      .err(e) { }
    }
  }
  t
}

// How HTML writes a byte that is not text where it stands, or nothing for a
// byte that is.
fn entity(b: Byte) -> str {
  if b == '<' {
    "&lt;"
  } else if b == '>' {
    "&gt;"
  } else if b == '&' {
    "&amp;"
  } else if b == '"' {
    "&quot;"
  } else if b == '\'' {
    "&#39;"
  } else {
    ""
  }
}

// The text as HTML holds it as text and nothing else: `<`, `>`, `&`, `"`, and
// `'` are written as entities, and every other byte as it is. The bytes between
// two that are escaped are written together.
// A page, which only `render` makes.
pub struct Html {
  page: str
}

// What a page is written through, as it runs. A tag is left open until
// something that is not an attribute is written, so that `attribute` may
// follow `start`. A handler writes what it is given as it is: the texts are
// escaped by `text` and by the elements, before they reach it.
pub effect markup {
  fn start(tag: str)
  fn attribute(name: str, value: str)
  fn emit(escaped: str)
  fn include(page: Html)
  fn void()
  fn end(tag: str)
}

// The text as HTML holds it as text and nothing else: `<`, `>`, `&`, `"`, and
// `'` are written as entities, and every other byte as it is. The bytes between
// two that are escaped are written together.
pub fn escape(s: str) -> str ! alloc {
  var t = new_text()
  var from: Nat = 0
  loop i in 0..s.size {
    written = entity(s[i])
    if written.size > 0 {
      t = append(run(t, s, from, i), written)
      from = i + 1
    }
  }
  finish(run(t, s, from, s.size))
}

// A text among other elements, written so that it is text and nothing else.
pub fn text(s: str) ! markup, alloc {
  emit(escape(s))
}

// A page put inside the one that is being written.
pub fn insert(page: Html) ! markup {
  include(page)
}

// The page so far, with the `>` of the tag that is open written.
fn closed(t: take Text, open: bool) -> Text ! alloc {
  if open {
    append(t, ">")
  } else {
    t
  }
}

// The handler of `markup`: it runs `writes`, gathers what it writes into one
// text, and gives it as an `Html`. The parameter is not called `body`, which is
// the name of an element: a name is found among the module's functions before
// the function's own bindings, so `body: body` below is the element in a file
// that does not import it (#642).
pub fn render(writes: fn() ! markup) -> Html ! alloc {
  var acc = new_text()
  var open = false
  markup(
    start: fn(tag) {
      acc = append(append(closed(acc, open), "<"), tag)
      open = true
    },
    attribute: fn(name, value) {
      acc = append(append(append(append(acc, " "), name), "=\""), value)
      acc = append(acc, "\"")
    },
    emit: fn(escaped) {
      acc = append(closed(acc, open), escaped)
      open = false
    },
    include: fn(page) {
      acc = append(closed(acc, open), page.page)
      open = false
    },
    void: {
      acc = closed(acc, open)
      open = false
    },
    end: fn(tag) {
      acc = append(append(append(closed(acc, open), "</"), tag), ">")
      open = false
    },
    body: writes,
  )
  Html(page: finish(acc))
}

// An attribute written only when it is given, with its value escaped.
fn given(name: str, value: str) ! markup, alloc {
  if value.size > 0 {
    attribute(name, escape(value))
  }
}

// What every element holds after its attributes: the attributes every element
// may have, the text, what the block writes, and the end of the tag.
fn finish_element(tag: str, inside: str, class: str, id: str, block: fn() ! markup) ! markup, alloc {
  given("class", class)
  given("id", id)
  if inside.size > 0 {
    text(inside)
  }
  block()
  end(tag)
}

// An element with no attributes of its own.
fn element(tag: str, inside: str, class: str, id: str, block: fn() ! markup) ! markup, alloc {
  start(tag)
  finish_element(tag, inside, class, id, block)
}

// An element that holds nothing, which is a tag with its attributes.
fn empty_element(tag: str, class: str, id: str) ! markup, alloc {
  start(tag)
  given("class", class)
  given("id", id)
  void()
}

pub fn html(inside: str = "", class: str = "", id: str = "", block: fn() ! markup = { }) ! markup, alloc {
  element("html", inside, class, id, block)
}

pub fn head(inside: str = "", class: str = "", id: str = "", block: fn() ! markup = { }) ! markup, alloc {
  element("head", inside, class, id, block)
}

pub fn title(inside: str = "", class: str = "", id: str = "", block: fn() ! markup = { }) ! markup, alloc {
  element("title", inside, class, id, block)
}

pub fn body(inside: str = "", class: str = "", id: str = "", block: fn() ! markup = { }) ! markup, alloc {
  element("body", inside, class, id, block)
}

pub fn h1(inside: str = "", class: str = "", id: str = "", block: fn() ! markup = { }) ! markup, alloc {
  element("h1", inside, class, id, block)
}

pub fn h2(inside: str = "", class: str = "", id: str = "", block: fn() ! markup = { }) ! markup, alloc {
  element("h2", inside, class, id, block)
}

pub fn p(inside: str = "", class: str = "", id: str = "", block: fn() ! markup = { }) ! markup, alloc {
  element("p", inside, class, id, block)
}

pub fn b(inside: str = "", class: str = "", id: str = "", block: fn() ! markup = { }) ! markup, alloc {
  element("b", inside, class, id, block)
}

pub fn span(inside: str = "", class: str = "", id: str = "", block: fn() ! markup = { }) ! markup, alloc {
  element("span", inside, class, id, block)
}

pub fn ul(inside: str = "", class: str = "", id: str = "", block: fn() ! markup = { }) ! markup, alloc {
  element("ul", inside, class, id, block)
}

pub fn li(inside: str = "", class: str = "", id: str = "", block: fn() ! markup = { }) ! markup, alloc {
  element("li", inside, class, id, block)
}

pub fn article(inside: str = "", class: str = "", id: str = "", block: fn() ! markup = { }) ! markup, alloc {
  element("article", inside, class, id, block)
}

pub fn a(inside: str = "", href: str = "", class: str = "", id: str = "", block: fn() ! markup = { }) ! markup, alloc {
  start("a")
  given("href", href)
  finish_element("a", inside, class, id, block)
}

pub fn br(class: str = "", id: str = "") ! markup, alloc {
  empty_element("br", class, id)
}

pub fn input(name: str = "", placeholder: str = "", type: str = "", value: str = "", class: str = "", id: str = "") ! markup, alloc {
  start("input")
  given("name", name)
  given("placeholder", placeholder)
  given("type", type)
  given("value", value)
  given("class", class)
  given("id", id)
  void()
}

// A page is written as its text, so that a program can print it and hand it on.
impl Fmt[Html] {
  fn fmt(value: Html) -> str ! alloc { value.page }
}
