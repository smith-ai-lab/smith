// Tests of `for x in xs` in the emitter (#1586 of #1428): `range`, a fixed array and `refs`, from source text in
// smith's own syntax through the parser's hooks, the checker, front::emit and the JIT; golden IR; and the `not emitted
// yet` Errors at the iterable. The tree and the checker's table are in an arena; the emitter and LLVM use the system's
// allocator.
module front_emit_for_test;

import front::ast;
import front::emit;
import front::emit_jit;
import front::lex;
import front::parse;
import front::parse_decl;
import front::parse_expr;
import front::parse_stmt;
import front::parse_type;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;
import <llvm-c/Core.h>;
import <string.h>;

typedef I32 (*Unary)(I32);
typedef I32 (*Binary)(I32, I32);
typedef U32 (*BinaryU)(U32, U32);
typedef U32 (*ByteBinary)(U8, U8);
typedef I32 (*Nullary)();

struct Scenario {
    arena::Arena memory;
    arena::ArenaAllocator allocator;
    parser::Parsed parsed;
    types::Checked checked;
    Bool has_checked;
};

// The module of `source`, read in smith's own syntax.
static parser::Parsed parse_new(Str source) {
    parser::Parsed result = {};
    result.module.file = "t.smith";
    lex::Lexed lexed = lex::tokenize_new(source);
    switch (lexed) {
    case .ok:
        parse::Parser p = parse::make(lexed.ok, source);
        p.new_syntax = true;
        p.hooks.expression = parse_expr::expression;
        p.hooks.type = parse_type::type;
        p.hooks.statement = parse_stmt::statement;
        p.hooks.declaration = parse_decl::declaration;
        result.module = parse_decl::file(&p, "t.smith");
        result.errors = p.errors;
        break;
    case .error:
        Str expected = "no error";
        test::check_equal(lexed.error.message, expected);
    }
    return result;
}

static void begin(Scenario *s, Str source, Bool with_checker) {
    s->memory = test::memory(1U << 22);
    s->allocator = arena::allocator(&s->memory);
    mem::Allocator *outside = mem::set_allocator(&s->allocator.base);
    s->parsed = parse_new(source);
    test::check_equal(countof(s->parsed.errors), (Usize)0);
    if (with_checker) {
        s->checked = types_decl::check_module(&s->parsed.module, types::lp64());
        s->has_checked = true;
        if (s->checked.error_count > 0) {
            Str none = "no error";
            test::check_equal(s->checked.errors[0].message, none);
        }
        test::check_equal(s->checked.error_count, (Usize)0);
    }
    mem::set_allocator(outside);
}

static emit::Options options_for(emit::Target target, const Scenario *s) {
    emit::Options options = {};
    options.target = target;
    if (s->has_checked) options.checked = &s->checked;
    return options;
}

static emit_jit::Jit start_jit() {
    emit_jit::JitResult started = emit_jit::start();
    test::check_equal(started == .ok, true);
    emit_jit::Jit host = {};
    if (started == .ok) host = started.ok;
    return host;
}

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        Bool same = true;
        for (Usize k = 0; k < countof(needle); k++) {
            if (text[i + k] != needle[k]) {
                same = false;
                break;
            }
        }
        if (same) return true;
    }
    return false;
}

// The text of `source` from `start`.
static Bool starts_at(Str source, U32 start, Str needle) {
    if (start > countof(source)) return false;
    return has(
        source[start:start + (countof(needle) < countof(source) - start ? countof(needle) : countof(source) - start)],
        needle);
}

static Usize symbol_of(emit_jit::Jit *host, Str symbol) {
    emit_jit::AddressResult found = emit_jit::lookup(host, symbol);
    test::check_equal(found == .ok, true);
    Usize address = 0;
    if (found == .ok) address = found.ok;
    return address;
}

// Emits `source` and adds it to the JIT; the IR text (to free with LLVMDisposeMessage), or null with the failure
// counted.
static char *emit_source(Str source, emit_jit::Jit *host, Scenario *s) {
    begin(s, source, true);
    c::LLVMContextRef context = c::LLVMContextCreate();
    emit::ModuleResult emitted = emit::module(context, &s->parsed.module, options_for(host->target, s));
    test::check_equal(emitted == .ok, true);
    char *text = nullptr;
    if (emitted == .ok) {
        text = c::LLVMPrintModuleToString(emitted.ok);
        emit_jit::BoolResult added = emit_jit::add(host, context, emitted.ok);
        test::check_equal(added == .ok, true);
    } else {
        Str none = "no error";
        test::check_equal(emitted.error.message, none);
    }
    return text;
}

// Emits `source` and checks that it stops with "not emitted yet: <what>" at a span that starts with `at`.
static void stops_at(Str source, Str what, Str at) {
    Scenario s = {};
    begin(&s, source, false);
    emit_jit::Jit host = start_jit();
    c::LLVMContextRef context = c::LLVMContextCreate();
    emit::ModuleResult emitted = emit::module(context, &s.parsed.module, options_for(host.target, &s));
    test::check_equal(emitted == .error, true);
    if (emitted == .error) {
        test::check_equal(has(emitted.error.message, "not emitted yet: "), true);
        test::check_equal(has(emitted.error.message, what), true);
        test::check_equal(starts_at(source, emitted.error.span.start, at), true);
        emit::free_error(emitted.error);
    } else {
        c::LLVMDisposeModule(emitted.ok);
    }
    c::LLVMContextDispose(context);
    emit_jit::stop(&host);
}

// ---------------------------------------------------------------------------------------------------------------
// range

export void test_front_emit_for_range_counts_from_zero_and_an_empty_range_runs_no_turn() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    emit_source(
        "pub fn sum_to(n: i32) -> i32 {\n    mut total := 0\n    for i in range(n) {\n        total += i\n    }\n"
        "    total\n}\n",
        &host, &s);
    Unary sum_to = (Unary)symbol_of(&host, "sum_to");
    test::check_equal(sum_to(5), (I32)10);
    test::check_equal(sum_to(0), (I32)0);
    test::check_equal(sum_to(-3), (I32)0);
    emit_jit::stop(&host);
}

export void test_front_emit_for_range_with_two_bounds_signed_and_unsigned() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    emit_source("pub fn between(a: i32, b: i32) -> i32 {\n    mut total := 0\n    for i in range(a, b) {\n"
                "        total += i\n    }\n    total\n}\n"
                "pub fn count(a: u32, b: u32) -> u32 {\n    mut n: u32 = 0\n    for _ in range(a, b) {\n"
                "        n += 1\n    }\n    n\n}\n",
                &host, &s);
    Binary between = (Binary)symbol_of(&host, "between");
    BinaryU count = (BinaryU)symbol_of(&host, "count");
    test::check_equal(between(-3, 3), (I32)-3);
    test::check_equal(between(4, 4), (I32)0);
    test::check_equal(between(5, 2), (I32)0);
    test::check_equal(count(2, 9), (U32)7);
    test::check_equal(count(0xFFFFFFF0U, 0xFFFFFFFFU), (U32)15);
    test::check_equal(count(9, 2), (U32)0);
    emit_jit::stop(&host);
}

export void test_front_emit_for_range_with_a_step_ends_on_and_past_the_bound() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    emit_source("pub fn by_three(a: u32, b: u32) -> u32 {\n    mut n: u32 = 0\n    for _ in range(a, b, 3) {\n"
                "        n += 1\n    }\n    n\n}\n"
                "pub fn bytes(a: u8, b: u8) -> u32 {\n    mut n: u32 = 0\n    for _ in range(a, b, 2) {\n"
                "        n += 1\n    }\n    n\n}\n",
                &host, &s);
    BinaryU by_three = (BinaryU)symbol_of(&host, "by_three");
    ByteBinary bytes = (ByteBinary)symbol_of(&host, "bytes");
    test::check_equal(by_three(0, 9), (U32)3);  // 0 3 6, ends on 9
    test::check_equal(by_three(0, 10), (U32)4); // 0 3 6 9, ends past 10
    test::check_equal(bytes(0, 255), (U32)128); // 0 2 .. 254, then 256 overflows the byte and ends the loop
    test::check_equal(bytes(250, 255), (U32)3);
    emit_jit::stop(&host);
}

export void test_front_emit_for_break_and_continue_work_in_a_range() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    emit_source("pub fn f(n: i32) -> i32 {\n    mut total := 0\n    for i in range(n) {\n        if i == 2 {\n"
                "            continue\n        }\n        if i == 6 {\n            break\n        }\n"
                "        total += i\n    }\n    total\n}\n",
                &host, &s);
    Unary f = (Unary)symbol_of(&host, "f");
    test::check_equal(f(100), (I32)(0 + 1 + 3 + 4 + 5));
    test::check_equal(f(4), (I32)(0 + 1 + 3));
    emit_jit::stop(&host);
}

export void test_front_emit_for_nested_loops_keep_their_own_targets() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    emit_source("pub fn f(n: i32) -> i32 {\n    mut total := 0\n    for i in range(n) {\n"
                "        for j in range(n) {\n            if j > i {\n                break\n            }\n"
                "            total += 1\n        }\n    }\n    total\n}\n",
                &host, &s);
    Unary f = (Unary)symbol_of(&host, "f");
    test::check_equal(f(4), (I32)10);
    emit_jit::stop(&host);
}

// ---------------------------------------------------------------------------------------------------------------
// Arrays

export void test_front_emit_for_an_array_is_read_by_value_and_written_through_refs() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    emit_source("pub fn f(v: i32) -> i32 {\n    mut xs: [4]i32\n    for p in refs(xs) {\n        p.* = v\n    }\n"
                "    mut total := 0\n    for x in xs {\n        total += x\n    }\n    total\n}\n"
                "pub fn first_big(limit: i32) -> i32 {\n    mut xs: [4]i32\n    mut k := 0\n"
                "    for p in refs(xs) {\n        p.* = k * 10\n        k += 1\n    }\n    mut seen := 0\n"
                "    for x in xs {\n        if x < 10 {\n            continue\n        }\n"
                "        if x > limit {\n            break\n        }\n        seen += 1\n    }\n    seen\n}\n",
                &host, &s);
    Unary f = (Unary)symbol_of(&host, "f");
    Unary first_big = (Unary)symbol_of(&host, "first_big");
    test::check_equal(f(3), (I32)12);
    test::check_equal(first_big(100), (I32)3);
    test::check_equal(first_big(15), (I32)1);
    emit_jit::stop(&host);
}

export void test_front_emit_for_an_array_field_and_an_array_parameter_are_places() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    emit_source("struct Box {\n    items: [3]i32\n}\n"
                "pub fn f(v: i32) -> i32 {\n    mut b: Box\n    for p in refs(b.items) {\n        p.* = v\n    }\n"
                "    mut total := 0\n    for x in b.items {\n        if x == 0 {\n            break\n        }\n"
                "        total += x\n    }\n    total\n}\n",
                &host, &s);
    Unary f = (Unary)symbol_of(&host, "f");
    test::check_equal(f(5), (I32)15);
    test::check_equal(f(0), (I32)0);
    emit_jit::stop(&host);
}

// ---------------------------------------------------------------------------------------------------------------
// The IR

export void test_front_emit_for_range_is_a_plain_loop_with_no_bounds_check_and_no_call() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    char *ir = emit_source("pub fn f(a: i32, b: i32) -> i32 {\n    mut last := 0\n    for i in range(a, b) {\n"
                           "        last = i\n    }\n    last\n}\n",
                           &host, &s);
    test::check_equal(ir != nullptr, true);
    if (ir != nullptr) {
        test::check_equal(c::strstr(ir, "forcond:") != nullptr, true);
        test::check_equal(c::strstr(ir, "icmp slt i32 %counter") != nullptr, true);
        test::check_equal(c::strstr(ir, "add nuw i32 %counter") != nullptr, true);
        test::check_equal(c::strstr(ir, "forstep:") != nullptr, true);
        // No call at all: no overflow intrinsic, no failure helper, no bounds check.
        test::check_equal(c::strstr(ir, "call ") == nullptr, true);
        c::LLVMDisposeMessage(ir);
    }
    emit_jit::stop(&host);
}

// ---------------------------------------------------------------------------------------------------------------
// Not emitted yet

export void test_front_emit_for_enumerate_a_slice_and_a_run_time_step_are_not_emitted_yet() {
    stops_at("fn f(xs: [3]i32) -> i32 {\n    for x in enumerate(xs) {\n        _ := x\n    }\n    0\n}\n", "enumerate",
             "enumerate(xs)");
    stops_at("fn f(xs: []i32) -> i32 {\n    for x in xs {\n        _ := x\n    }\n    0\n}\n", "this kind of type",
             "[]i32"); // a slice cannot be named yet: it stops at its type, before the loop
    stops_at("fn f(a: u32, n: u32, k: u32) -> i32 {\n    for i in range(a, n, k) {\n        _ := i\n    }\n    0\n}\n",
             "range with a step that is not a positive constant", "range(a, n, k)");
    stops_at("fn f(a: u32, n: u32) -> i32 {\n    for i in range(a, n, 0) {\n        _ := i\n    }\n    0\n}\n",
             "range with a step that is not a positive constant", "range(a, n, 0)");
}

export void test_front_emit_for_an_array_value_must_be_stored_in_a_local_first() {
    stops_at("fn g() -> [3]i32 {\n    mut a: [3]i32\n    a\n}\n"
             "fn f() -> i32 {\n    for x in g() {\n        _ := x\n    }\n    0\n}\n",
             "store it in a local first", "g()");
}
