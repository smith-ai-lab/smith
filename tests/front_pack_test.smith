// Tests of `rest...` (#1821): the leftover positional arguments are gathered into a tuple, and each list of argument
// types is its own instance.
module front_pack_test;

import front::ast;
import front::emit;
import front::emit_jit;
import front::parse;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;
import <llvm-c/Core.h>;

static parser::Parsed parse_new(Str source) {
    return parser::parse_new("t.smith", source);
}

typedef I32 (*Run)();

// Parses and checks under the arena as front_emit_option_test.smith does; emission and the JIT use the system's
// allocator, and the arena stays alive until the function has run.
static I32 run(Str source, Str symbol) {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    parser::Parsed parsed = parse_new(source);
    test::check_equal(countof(parsed.errors), (Usize)0);
    ast::Module m = ast::new_module("front::test", parsed.module.decls);
    types::Checked checked = types_decl::check_module(&m, types::lp64());
    mem::set_allocator(outside);
    test::check_equal(checked.error_count, (Usize)0);
    emit_jit::JitResult started = emit_jit::start();
    test::check_equal(started == .ok, true);
    emit_jit::Jit host = {};
    if (started == .ok) host = started.ok;
    emit::Options options = {};
    options.target = host.target;
    options.checked = &checked;
    c::LLVMContextRef context = c::LLVMContextCreate();
    emit::ModuleResult emitted = emit::module(context, &m, options);
    test::check_equal(emitted == .ok, true);
    I32 result = -1;
    if (emitted == .ok) {
        emit_jit::BoolResult added = emit_jit::add(&host, context, emitted.ok);
        test::check_equal(added == .ok, true);
        emit_jit::AddressResult found = emit_jit::lookup(&host, symbol);
        test::check_equal(found == .ok, true);
        if (added == .ok && found == .ok) result = ((Run)found.ok)();
    }
    emit_jit::stop(&host);
    return result;
}

export void test_front_kw_gather_leftovers_are_a_named_tuple() {
    Str source = "fn info(msg: i32; ctx...) -> i32:\n"
                 "    msg + ctx.count * 10 + ctx.ms * 100\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    let n = 2\n"
                 "    let ms = 3\n"
                 "    info(1, count = n, ms = ms)\n";
    test::check_equal(run(source, "front::test::run"), (I32)321);
}

export void test_front_kw_gather_no_leftovers_is_an_empty_tuple() {
    Str source = "fn info(msg: i32; ctx...) -> i32:\n"
                 "    msg\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    info(7)\n";
    test::check_equal(run(source, "front::test::run"), (I32)7);
}

export void test_front_kw_gather_each_call_site_is_its_own_instance() {
    Str source = "fn total(base: i32; extra...) -> i32:\n"
                 "    base + extra.a\n"
                 "\n"
                 "fn total2(base: i32; extra...) -> i32:\n"
                 "    base + extra.b\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    total(1, a = 2) + total(10, a = 20, b = 0) + total2(100, b = 200)\n";
    test::check_equal(run(source, "front::test::run"), (I32)333);
}

export void test_front_kw_gather_a_named_parameter_is_not_a_leftover() {
    Str source = "fn info(msg: i32; level: i32 = 1, ctx...) -> i32:\n"
                 "    msg + level * 1000 + ctx.n\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    info(5, level = 2, n = 6)\n";
    test::check_equal(run(source, "front::test::run"), (I32)2011);
}

static Usize errors_of(Str source) {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    parser::Parsed parsed = parse_new(source);
    test::check_equal(countof(parsed.errors), (Usize)0);
    ast::Module m = ast::new_module("front::test", parsed.module.decls);
    types::Checked checked = types_decl::check_module(&m, types::lp64());
    mem::set_allocator(outside);
    return checked.error_count;
}

export void test_front_pack_leftovers_are_a_tuple() {
    Str source = "fn add(base: i32, rest...) -> i32:\n"
                 "    base + rest.0 * 10 + rest.1 * 100\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    add(1, 2, 3)\n";
    test::check_equal(run(source, "front::test::run"), (I32)321);
}

export void test_front_pack_each_list_of_types_is_an_instance() {
    Str source = "fn first(rest...) -> i32:\n"
                 "    rest.0.to(i32)\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    first(4, 'x') + first(5.0, 1)\n";
    test::check_equal(run(source, "front::test::run"), (I32)9);
}

export void test_front_pack_countof() {
    Str source = "fn n(rest...) -> usize:\n"
                 "    countof(rest)\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    (n() * 100 + n(1) * 10 + n(1, 2, 3)).to(i32)\n";
    test::check_equal(run(source, "front::test::run"), (I32)13);
}

export void test_front_pack_a_named_argument_is_an_error() {
    Str source = "fn f(rest...) -> i32:\n"
                 "    1\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    f(1, x = 2)\n";
    test::check_equal(errors_of(source) > 0, true);
}

export void test_front_pack_for_unrolls_over_mixed_types() {
    Str source = "fn total(rest...) -> i32:\n"
                 "    let mut sum = 0\n"
                 "    for x in rest:\n"
                 "        sum = sum + x.to(i32)\n"
                 "    sum\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    total(1, 'a', 2.0) + total() + total(10)\n";
    test::check_equal(run(source, "front::test::run"), (I32)(1 + 97 + 2 + 10));
}

export void test_front_pack_for_over_an_empty_pack_runs_no_body() {
    Str source = "fn count(rest...) -> i32:\n"
                 "    let mut n = 0\n"
                 "    for _ in rest:\n"
                 "        n = n + 1\n"
                 "    n\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    count() * 100 + count(1, 2, 3)\n";
    test::check_equal(run(source, "front::test::run"), (I32)3);
}

export void test_front_pack_spread_forwards_the_pack() {
    Str source = "fn add3(a: i32, b: i32, c: i32) -> i32:\n"
                 "    a + b * 10 + c * 100\n"
                 "\n"
                 "fn forward(rest...) -> i32:\n"
                 "    add3(rest...)\n"
                 "\n"
                 "fn forward_more(first: i32, rest...) -> i32:\n"
                 "    add3(first, rest...)\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    forward(1, 2, 3) + forward_more(1, 2, 3)\n";
    test::check_equal(run(source, "front::test::run"), (I32)642);
}

export void test_front_pack_index_out_of_range_is_an_error() {
    Str source = "fn f(rest...) -> i32:\n"
                 "    rest.2\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    f(1, 2)\n";
    test::check_equal(errors_of(source) > 0, true);
}

export void test_front_pack_for_over_a_runtime_value_is_still_an_error() {
    Str source = "fn f(n: i32) -> i32:\n"
                 "    let mut s = 0\n"
                 "    for x in n:\n"
                 "        s = s + 1\n"
                 "    s\n";
    test::check_equal(errors_of(source) > 0, true);
}

export void test_front_pack_typed_converts_each_argument() {
    Str source = "fn sum(nums: i64...) -> i64:\n"
                 "    nums.0 + nums.1 * 10 + nums.2 * 100\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    let small: i32 = 5\n"
                 "    sum(small, 2, 3).to(i32)\n";
    test::check_equal(run(source, "front::test::run"), (I32)325);
}

export void test_front_pack_typed_a_failed_conversion_is_an_error() {
    Str source = "fn sum(nums: i32...) -> i32:\n"
                 "    nums.0\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    let wide: i64 = 5\n"
                 "    sum(1, wide)\n";
    test::check_equal(errors_of(source) > 0, true);
}

export void test_front_pack_concept_keeps_each_type() {
    Str source = "fn total(nums: int...) -> i64:\n"
                 "    nums.0.to(i64) + nums.1.to(i64) * 10\n"
                 "\n"
                 "fn width(nums: int...) -> usize:\n"
                 "    let x = nums.0\n"
                 "    let y = nums.1\n"
                 "    sizeof(x) * 100 + sizeof(y)\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    let a: u8 = 3\n"
                 "    let b: i64 = 4\n"
                 "    (total(a, b) + width(a, b).to(i64) * 1000).to(i32)\n";
    test::check_equal(run(source, "front::test::run"), (I32)108043);
}

export void test_front_pack_concept_rejects_a_value_outside_it() {
    Str source = "fn total(nums: int...) -> i32:\n"
                 "    1\n"
                 "\n"
                 "pub fn run() -> i32:\n"
                 "    total(1, 2.5)\n";
    test::check_equal(errors_of(source) > 0, true);
}

static void expect_text(Str got, Str want) {
    test::check_equal(mem::equal(got, want), true);
}

static parser::Parsed parse_text(Str source) {
    return parse_new(source);
}

export void test_front_pack_old_dots_have_a_fix() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "fn f(a: i32, rest: ...) -> i32:\n"
                 "    a\n";
    parser::Parsed parsed = parse_text(source);
    test::check_equal(countof(parsed.errors), (Usize)1);
    parse::Edits fix = parsed.errors[0].fix;
    test::check_equal(countof(fix), (Usize)1);
    Str before = source[0:fix[0].span.start];
    Str after = source[fix[0].span.end:countof(source)];
    expect_text(before, "fn f(a: i32, rest");
    expect_text(fix[0].text, "...");
    expect_text(after, ") -> i32:\n    a\n");
}
