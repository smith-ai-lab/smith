// Tests of the parser for gathered and spread arguments (piece 3a of #1914, part of #1820): `xs...` and `; kw...` in a
// declaration, `; s...` in a call. The checker does not use them yet: it reports "not yet".
module front_kw_gather_parse_test;

import front::ast;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;

static Bool has(Str text, Str word) {
    for (Usize i = 0; i + countof(word) <= countof(text); i++) {
        Bool same = true;
        for (Usize k = 0; k < countof(word) && same; k++) {
            if (text[i + k] != word[k]) same = false;
        }
        if (same) return true;
    }
    return false;
}

// The parser's first error for `source` in smith's own syntax ("" when it has none), or its dump when `dumped`.
static Str parsed(Str source, Bool dumped) {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed p = parser::parse_new("t.smith", source);
    if (dumped) return ast::dump(&p.module);
    Str message = "";
    if (countof(p.errors) > 0) message = p.errors[0].message;
    return message;
}

export void test_front_kw_gather_declaration_parses() {
    Str dump = parsed("fn info(msg: str; ctx...):\n", true);
    test::check_equal(has(dump, "gather"), true);
    test::check_equal(has(dump, "pack"), false);
}

export void test_front_positional_pack_parses() {
    Str dump = parsed("fn f(x: str, xs...; kw...):\n", true);
    test::check_equal(has(dump, "pack"), true);
    test::check_equal(has(dump, "gather"), true);
}

export void test_front_gather_is_the_last_parameter() {
    Str message = parsed("fn f(x: str; kw..., y: i32 = 1):\n", false);
    Str expected = "`name...` after the `;` gathers the named arguments: it is the last parameter";
    test::check_equal(message, expected);
}

export void test_front_spread_after_semicolon_parses() {
    Str dump = parsed("fn g():\n    f(1; opts..., retry = 3)\n", true);
    test::check_equal(has(dump, "expand named"), true);
    test::check_equal(has(dump, "named_arg retry"), true);
}

export void test_front_a_call_has_one_semicolon() {
    Str message = parsed("fn g():\n    f(1; a...; b...)\n", false);
    Str expected = "a call has one `;`: put every spread after it";
    test::check_equal(message, expected);
}

export void test_front_checker_declares_packs_and_gathers_as_templates() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed p = parser::parse_new("t.smith", "fn f(x: str, xs...):\nfn g(x: str; kw...):\n");
    test::check_equal(countof(p.errors), (Usize)0);
    types::Checked c = types_decl::check_module(&p.module, types::lp64());
    test::check_equal(c.error_count, (Usize)0); // `rest...` (#1821) and `; kw...` (#1985) make templates
}
