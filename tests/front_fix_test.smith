// Tests of fix-its in parse errors and the `smith lint --fix` engine (#1442, S6 of #1428): an error records its edits,
// the edits are applied together or not at all, overlapping fixes apply the first, a file reaches a fixed point, and
// `smith lint --fix` on the real parser applies nothing yet.
module front_fix_test;

import front::fix;
import front::parse as syntax;
import front::parser;
import std::arena;
import std::files;
import std::format;
import std::mem;
import std::process;
import std::slice;
import std::test;
import <stdlib.h>;

// The name of the file in a test that needs none, and the first place the type `Str` is written, which defines it at
// file scope, so a function pointer to `reader` has the same parameter types as the one in front::fix.
static Str file_name;

static void check_text(Str got, Str want) {
    test::check_equal(got, want);
}

static void check_count(Usize got, Usize want) {
    test::check_equal(got, want);
}

static void check_signed(I64 got, I64 want) {
    test::check_equal(got, want);
}

static void check_flag(Bool got, Bool want) {
    test::check_equal(got, want);
}

static syntax::Errors errors_of(Usize n) {
    syntax::Errors errors = {};
    errors = mem::realloc(errors, n);
    for (Usize i = 0; i < n; i++)
        errors[i] = (syntax::ParseError){};
    return errors;
}

static syntax::Errors none_of() {
    syntax::Errors none = {};
    return none;
}

static syntax::Edits fix_of(Usize n) {
    syntax::Edits edits = {};
    return mem::realloc(edits, n);
}

static syntax::Edit edit(U32 start, U32 end, Str text) {
    return (syntax::Edit){.span = {.start = start, .end = end}, .text = text};
}

// A parser that finds the first `OLD` of the text and records `new` as the fix of the error it reports there.
static parser::Parsed reader(Str file, Str source) {
    parser::Parsed result = {};
    result.module.file = file;
    syntax::Parser p = {};
    for (Usize i = 0; i + 3 <= countof(source); i++) {
        if (source[i] == 'O' && source[i + 1] == 'L' && source[i + 2] == 'D') {
            U32 start = (U32)i;
            U32 end = (U32)(i + 3);
            syntax::Edits edits = fix_of(1);
            edits[0] = edit(start, end, "new");
            syntax::error_fix(&p, edits[0].span, "OLD is the old form", edits);
            break;
        }
    }
    result.errors = p.errors;
    return result;
}

export void test_error_fix_records_its_edits() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed parsed = reader("x.smith", "OLD");
    check_count(countof(parsed.errors), 1);
    syntax::Edits made = parsed.errors[0].fix;
    check_count(countof(made), 1);
    check_text(made[0].text, "new");
    check_count(countof(parsed.warnings), 0);
}

export void test_error_without_a_fix_has_none() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed parsed = parser::parse_file(file_name, "module a; int");
    check_flag(countof(parsed.errors) > 0, true);
    syntax::Edits none = parsed.errors[0].fix;
    check_count(countof(none), 0);
}

export void test_fixes_apply_in_order_of_position() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    syntax::Errors errors = errors_of(2);
    errors[0].fix = fix_of(1);
    errors[0].fix[0] = edit(6, 7, "B");
    errors[1].fix = fix_of(1);
    errors[1].fix[0] = edit(0, 1, "A");
    fix::Fixed fixed = fix::apply_fixes("a bcd b", errors, none_of());
    check_text(fixed.text, "A bcd B");
    check_count(fixed.applied, 2);
    check_count(fixed.skipped, 0);
}

export void test_overlapping_fix_is_skipped() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    syntax::Errors errors = errors_of(2);
    errors[0].fix = fix_of(1);
    errors[0].fix[0] = edit(0, 3, "xyz");
    errors[1].fix = fix_of(2);
    errors[1].fix[0] = edit(5, 6, "Q");
    errors[1].fix[1] = edit(2, 4, "zz");
    fix::Fixed fixed = fix::apply_fixes("abcdefg", errors, none_of());
    check_text(fixed.text, "xyzdefg");
    check_count(fixed.applied, 1);
    check_count(fixed.skipped, 1);
}

// An insertion and a deletion that starts at the same offset are both taken, the insertion first (#1742: `n` then the
// `;` that goes); two insertions at one offset have no order, so the second is skipped.
export void test_insertion_beside_a_deletion_at_one_offset() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    syntax::Errors errors = errors_of(3);
    errors[0].fix = fix_of(1);
    errors[0].fix[0] = edit(3, 4, "");
    errors[1].fix = fix_of(1);
    errors[1].fix[0] = edit(3, 3, " as T");
    errors[2].fix = fix_of(1);
    errors[2].fix[0] = edit(3, 3, "!");
    fix::Fixed fixed = fix::apply_fixes("abc;d", errors, none_of());
    check_text(fixed.text, "abc as Td");
    check_count(fixed.applied, 2);
    check_count(fixed.skipped, 1);
}

export void test_insertion_and_deletion() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    syntax::Errors errors = errors_of(1);
    errors[0].fix = fix_of(2);
    errors[0].fix[0] = edit(1, 1, "-");
    errors[0].fix[1] = edit(2, 3, "");
    fix::Fixed fixed = fix::apply_fixes("abc", errors, none_of());
    check_text(fixed.text, "a-b");
}

export void test_text_reaches_a_fixed_point() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "x OLD y OLD z\n";
    Usize total = 0;
    for (Usize pass = 0; pass < 8; pass++) {
        parser::Parsed parsed = reader("x.smith", source);
        fix::Fixed fixed = fix::apply_fixes(source, parsed.errors, none_of());
        if (fixed.applied == 0) break;
        total += fixed.applied;
        source = fixed.text;
    }
    check_text(source, "x new y new z\n");
    check_count(total, 2);
}

export void test_a_file_is_stored_and_a_second_run_applies_nothing() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str path = "/tmp/front_fix_test_scratch.smith";
    check_flag(fix::store(path, "a := 1\n"), true);
    check_signed(fix::fix_file(path), 0);
    files::BytesResult back = files::read_file(path);
    if (back == .error) {
        check_text("cannot read back", "the file");
        return;
    }
    char chars[:] = mem::view(back.ok, char);
    Str got = chars;
    check_text(got, "a := 1\n");
    check_signed(fix::fix_file("/tmp/front_fix_test_missing.smith"), -1);
}

export void test_a_warning_is_kept_apart_and_its_fix_applies() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    syntax::Parser p = {};
    syntax::Edits edits = fix_of(1);
    edits[0] = edit(1, 2, "X");
    syntax::warning_fix(&p, edits[0].span, "old form", edits);
    check_count(countof(p.errors), 0);
    check_count(countof(p.warnings), 1);
    fix::Fixed fixed = fix::apply_fixes("abc", p.errors, p.warnings);
    check_count(fixed.applied, 1);
    check_text(fixed.text, "aXc");
}

export void test_a_source_without_old_forms_has_no_warnings() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed parsed = parser::parse_file(file_name, "a := 1\n");
    check_count(countof(parsed.errors), 0);
    check_count(countof(parsed.warnings), 0);
}

export void test_define_and_include_lines_get_one_fix() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    // The header binding is the spelling of #1428; the new parser reads it once #1678 lands, so only the text is
    // checked.
    fix::Fixed fixed = fix::fix_text("t.smith", "#include <sys/stat.h>\n#define LIMIT 4\nconst X = LIMIT\n");
    check_text(fixed.text, "import c <sys/stat.h>\nconst LIMIT = 4\nconst X = LIMIT\n");
    check_count(fixed.applied, 1);
}

// `#if defined(__APPLE__) ... #else ... #endif` around declarations is `@when` on each declaration (#1801).
export void test_an_if_around_declarations_becomes_when() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    // The `@when` lines come from this fix; the rest of each line is mended by the passes after it.
    fix::Fixed fixed = fix::fix_text("t.smith", "#if defined(__APPLE__)\nint open_window() {\n    return 1;\n}\n"
                                                "// closes it\nint close_window() {\n    return 3;\n}\n#else\n"
                                                "int open_window() {\n    return 2;\n}\n#endif\n"
                                                "#ifdef __linux__\nint only_linux() {\n    return 4;\n}\n#endif\n");
    check_text(fixed.text, "@when(target.os == .macos)\nfn open_window() -> i32:\n    return 1\n"
                           "# closes it\n@when(target.os == .macos)\nfn close_window() -> i32:\n    return 3\n"
                           "@when(target.os != .macos)\nfn open_window() -> i32:\n    return 2\n"
                           "@when(target.os == .linux)\nfn only_linux() -> i32:\n    return 4\n");
    parser::Parsed again = parser::parse_new("t.smith", fixed.text);
    check_count(countof(again.errors), 0);
}

// A top-level `if constexpr` is `@when` on each declaration of its branches (#2142).
export void test_a_top_level_if_constexpr_becomes_when() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text(
        "t.smith", "import target;\n\nif constexpr (target::os == target::macos) {\n"
                   "    import <sys/types.h>;\n    int a = 1;\n} else if constexpr (target::os == target::linux) {\n"
                   "    int a = 2;\n} else {\n    int a = 3;\n}\nint after = 4;\n");
    check_text(fixed.text, "\n@when(target.os == .macos)\nimport c <sys/types.h>\n@when(target.os == .macos)\n"
                           "mut a: i32 = 1\n@when(target.os != .macos and target.os == .linux)\nmut a: i32 = 2\n"
                           "@when(target.os != .macos and target.os != .linux)\nmut a: i32 = 3\nmut after: i32 = 4\n");
}

// A declaration of the block that has a fix of its own to apply first (a struct member that is a function pointer)
// left the block with no `@when` for it: the block waits for the next pass, which reads it whole (lib/std/net.smith).
export void test_a_declaration_with_its_own_fix_in_an_if_constexpr_still_gets_its_when() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "if constexpr (target::os == target::macos) {\n    typedef struct {\n"
                                                "        I32 (*f)(void *x);\n    } Api;\n}\n");
    test::check_condition(fixed.text[0] == '@');
}

static Bool contains_text(const char text[:], const char *word) {
    Usize n = 0;
    while (word[n] != 0)
        n += 1;
    for (Usize i = 0; i + n <= countof(text); i++) {
        Usize k = 0;
        while (k < n && text[i + k] == word[k])
            k += 1;
        if (k == n) return true;
    }
    return false;
}

// The same with two branches: the failed declaration of the else branch is written with its `@when` too, so the
// block is mended in one pass and no `else:` is left beside a brace.
export void test_a_two_branch_if_constexpr_with_a_failed_declaration_is_mended() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed =
        fix::fix_text("t.smith", "if constexpr (target::os == target::macos) {\n    constexpr U64 b = 1;\n} else {\n"
                                 "    constexpr U64 a = 1 << 7; // a peer\n    typedef struct {\n"
                                 "        void (*clear)();\n    } Api;\n}\n");
    test::check_condition(!contains_text(fixed.text, "constexpr"));
    test::check_condition(!contains_text(fixed.text, "else"));
}

// `export` on a line of its own, then an attribute and the declaration: the text of the attribute took the next line,
// leaving `pub` alone before an indented `fn` that never read (runtime/io.smith `make`).
export void test_an_attribute_on_the_line_after_export_joins_it() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "export\n    [[nodiscard]] Io make(I32 a) {\n    return io;\n}\n");
    check_text(fixed.text, "pub fn make(a: i32) -> Io:\n    return io\n");
}

// An empty or positional compound literal left in a text that already reads as the indented syntax (a `#` comment makes
// the old reader refuse it) is mended by the new reader (lib/std/task.smith `init_task`).
export void test_an_empty_compound_literal_in_the_indented_syntax_is_mended() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed =
        fix::fix_text("t.smith", "fn f(task: *Task):\n    task.* = (Task){} # reset\n    x = (P){1, 2}\n");
    check_text(fixed.text, "fn f(task: *Task):\n    task.* = Task() # reset\n    x = P(1, 2)\n");
}

// A cast whose type only had its name lowered by an earlier pass, `(usize)c::f(n)`, is a cast to the new reader too:
// the declaration around it stayed unmended (lib/std/task.smith `make_task`).
export void test_a_cast_to_a_lowered_builtin_type_is_mended() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "fn f(n: i32):\n    usize page = (usize)g(n); # a\n");
    check_text(fixed.text, "fn f(n: i32):\n    page: usize = g(n).to(usize) # a\n");
}

// Two statements on a line: the `;` after a declaration separates them and stays, or they ran together as
// `x: u32 = 1 return x` (tests/build_fixtures/neovim/project/main.smith).
export void test_a_declaration_followed_by_a_statement_on_its_line_keeps_the_separator() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "I32 f() { U32 x = 1; return x; }\n");
    check_text(fixed.text, "fn f() -> i32:\n    x: u32 = 1; return x.to(i32)\n");
}

// A cast to a named type, and one to a function type with a result, `(fn() -> i32)(usize)address`, left by a pass that
// only mended the types around them (tests/front_emit_float_test.smith, tests/front_emit_test.smith).
export void test_a_cast_to_a_named_or_function_type_is_mended_in_the_indented_syntax() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed named = fix::fix_text("t.smith", "fn f(n: usize):\n    t: ToInt = (ToInt)g(n) # a\n");
    check_text(named.text, "fn f(n: usize):\n    t: ToInt = g(n).to(ToInt) # a\n");
}

// A capitalized name that ends a line is a value, not the type of a declaration whose name never came: `else: Other`
// as the last of a function (tests/skills_test.smith `block_of`).
export void test_a_capitalized_value_ending_an_if_expression_is_no_declaration() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed parsed = fix::parse_for_fix(
        "t.smith", "fn f(a: i32) -> i32:\n    return if a == 0: 1 else: Other\n\nfn g() -> i32:\n    return 2\n");
    test::check_equal(countof(parsed.errors), 0);
}

// A cast to a pointer to const of an address, `(const char *)&x`, was read in the second pass as a type and a bit-and:
// the type was mended and the cast never (lib/std/net.smith `symbol`).
export void test_a_cast_to_a_const_pointer_of_an_address_is_mended() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "void f(I32 x) {\n    put((const char *)&x);\n}\n");
    check_text(fixed.text, "fn f(x: i32):\n    put((&x).cast(*char))\n");
}

// Two `else if` branches with `&&` conditions: the second chain frame used to share the first one's list of earlier
// conditions and grow it with realloc, which freed the block the first frame still read (a crash, #2565).
export void test_a_chain_of_two_else_if_constexpr_with_and_becomes_when() {
    // No arena: its realloc never frees the old block, which hides the use after free of #2565.
    fix::Fixed fixed = fix::fix_text(
        "t.smith",
        "import target;\n\nif constexpr (target::os == target::macos) {\n    int a = 1;\n"
        "} else if constexpr (target::arch == target::aarch64 && target::os == target::linux) {\n"
        "    int a = 2;\n} else if constexpr (target::arch == target::x86_64 && target::os == target::linux) {\n"
        "    int a = 3;\n} else {\n    int a = 4;\n}\nint after = 5;\n");
    check_text(fixed.text,
               "\n@when(target.os == .macos)\nmut a: i32 = 1\n"
               "@when(target.os != .macos and target.arch == .aarch64 and target.os == .linux)\nmut a: i32 = 2\n"
               "@when(target.os != .macos and not (target.arch == .aarch64 and target.os == .linux) and "
               "target.arch == .x86_64 and target.os == .linux)\nmut a: i32 = 3\n"
               "@when(target.os != .macos and not (target.arch == .aarch64 and target.os == .linux) and "
               "not (target.arch == .x86_64 and target.os == .linux))\nmut a: i32 = 4\nmut after: i32 = 5\n");
}

// `target::arch == target::aarch64` is `target.arch == .aarch64` and the `else` is its `!=` (#2142).
export void test_a_top_level_if_constexpr_on_the_processor_becomes_when() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "import target;\n\nif constexpr (target::arch == target::aarch64) {\n"
                                                "    int a = 1;\n} else {\n    int a = 2;\n}\n");
    check_text(fixed.text, "\n@when(target.arch == .aarch64)\nmut a: i32 = 1\n"
                           "@when(target.arch != .aarch64)\nmut a: i32 = 2\n");
}

// A condition that names a constant is kept as written, and its `else` is `!(...)` (#2142).
export void test_a_top_level_if_constexpr_on_a_constant_becomes_when() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "constexpr bool wide = true;\n\nif constexpr (wide) {\n"
                                                "    int a = 1;\n} else {\n    int a = 2;\n}\n");
    check_text(fixed.text, "const wide: bool = true\n\n@when(wide)\nmut a: i32 = 1\n"
                           "@when(not (wide))\nmut a: i32 = 2\n");
}

// In a file in smith's own syntax a top-level `if constexpr` is an error (#2142); a condition that is not about the
// system keeps the block of the old syntax (its declarations mended, the block not).
export void test_a_top_level_if_constexpr_is_an_error_in_the_new_syntax() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed new_file = parser::parse_new("t.smith", "if constexpr (target.os == .macos) {\n    a: i32 = 1\n}\n");
    check_count(countof(new_file.errors) > 0 ? 1 : 0, 1);
    fix::Fixed kept = fix::fix_text("t.smith", "if constexpr (sizeof(int) == 4) {\n    int a = 1;\n}\n");
    check_text(kept.text, "if constexpr (sizeof(i32) == 4) {\n    mut a: i32 = 1\n}\n");
}

// An `#if` that is not about the system, is inside a function or holds another directive stays as it is.
export void test_an_if_that_is_not_about_the_system_has_no_fix() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed none = parser::parse_file(file_name, "#if defined(DEBUG)\nint f();\n#endif\n");
    check_count(countof(none.errors), 1);
    syntax::Edits no_edits = none.errors[0].fix;
    check_count(countof(no_edits), 0);
    parser::Parsed inside =
        parser::parse_file(file_name, "int f() {\n#if defined(__APPLE__)\n    return 1;\n#endif\n}\n");
    syntax::Edits inside_edits = inside.errors[0].fix;
    check_count(countof(inside_edits), 0);
    parser::Parsed other = parser::parse_file(file_name, "#if defined(__APPLE__)\n#define A 1\n#endif\n");
    syntax::Edits other_edits = other.errors[0].fix;
    check_count(countof(other_edits), 1);
}

export void test_a_fixed_define_reads_in_smiths_own_syntax() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "#define LIMIT 4\nconst X = LIMIT\n");
    check_text(fixed.text, "const LIMIT = 4\nconst X = LIMIT\n");
    parser::Parsed again = parser::parse_new("t.smith", fixed.text);
    check_count(countof(again.errors), 0);
}

export void test_other_directives_stay_errors_without_a_fix() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed parsed = parser::parse_file(file_name, "#if 1\n#define F(x) x\n#include \"h.h\"\n");
    check_count(countof(parsed.errors), 1);
    syntax::Edits none = parsed.errors[0].fix;
    check_count(countof(none), 0);
}

// `(P){}` is `P()`, with the fields C zeroes given their zero values (#2329): an empty compound literal of a named type
// is rewritten, and the text reads in the new syntax.
export void test_an_empty_compound_literal_is_rewritten_to_a_call() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text(
        "t.smith", "module m;\ntypedef struct { int a; } Node;\nstatic Node make(void) { return (Node){}; }\n");
    check_text(fixed.text, "struct Node:\n    a: i32 = 0\nfn make() -> Node:\n    return Node()\n");
    parser::Parsed again = fix::parse_for_fix("t.smith", fixed.text);
    check_count(countof(again.errors), 0);
}

// `typedef void (*Callback)(void);` is `let Callback = fn()`: the capitalized name of the alias stays, `(void)` is no
// parameters, and the text reads in the new syntax (#1769).
export void test_a_typedef_of_a_function_pointer_keeps_its_name() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "module m;\ntypedef void (*Callback)(void);\n"
                                                "typedef int (*Binary)(int, int);\n");
    check_text(fixed.text, "Callback := fn()\nBinary := fn(i32, i32) -> i32\n");
    parser::Parsed again = fix::parse_for_fix("t.smith", fixed.text);
    check_count(countof(again.errors), 0);
}

// C's three-part `for` with no init is a `while` (the spec removes it): the step ends the body, and the result reads
// in smith's own syntax. A body with a `continue` would skip the step, and an init needs a block around the loop for
// its scope, which smith's own syntax has only as a value (`do:`, #2014): those `for`s have no fix.
export void test_a_three_part_for_is_rewritten_to_while() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text(
        "t.smith", "module m;\nstatic void f(int n) {\n    for (; n * 2 < 9; n += 3) {\n        n -= 1;\n    }\n}\n");
    parser::Parsed again = fix::parse_for_fix("t.smith", fixed.text);
    check_count(countof(again.errors), 0);
    check_text(fixed.text, "fn f(mut n: i32):\n    while n * 2 < 9:\n        n -= 1\n        n += 3\n");
}

export void test_a_three_part_for_with_an_init_becomes_a_while() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text(
        "t.smith", "static void f(int n) {\n    for (int i = 0; i * 2 < n; i += 3) {\n        n -= 1;\n    }\n}\n");
    Str word = "while";
    check_flag(slice::find_slice(fixed.text, word) == .some, true);
}

export void test_a_for_with_a_continue_gets_a_while_with_the_step_before_it() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text(
        "t.smith", "static void f(int n) {\n    for (int i = 0; i * 2 < n; i += 3) {\n        continue;\n    }\n}\n");
    Str word = "while";
    Str step = "i += 3\n        continue";
    check_flag(slice::find_slice(fixed.text, step) == .some, true);
    check_flag(slice::find_slice(fixed.text, word) == .some, true);
}

// `Node n = {.a = 1};` is `let n = Node(a = 1)`: a variable of a named type whose untyped list only has
// field designators, and the text reads in the new syntax (#1767).
export void test_a_variable_with_a_designated_list_is_rewritten_to_a_call() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "module m;\ntypedef struct { int a; } Node;\nstatic Node "
                                                "make(void) {\n    Node n = {.a = 1};\n    return n;\n}\n");
    check_text(fixed.text, "struct Node:\n    a: i32\nfn make() -> Node:\n    n := Node(a = 1)\n    return n\n");
    parser::Parsed again = fix::parse_for_fix("t.smith", fixed.text);
    check_count(countof(again.errors), 0);
}

// A `//` comment is `#` in the revised syntax: the lexer error carries the edit, and fix_text writes it at the end.
export void test_a_slash_comment_becomes_a_hash_comment() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed own = parser::parse_new("t.smith", "fn f() -> i32:\n    return 1 //one\n");
    check_count(countof(own.errors), 1);
    syntax::Edits edits = own.errors[0].fix;
    check_count(countof(edits), 1);
    check_text(edits[0].text, "# ");
    fix::Fixed fixed = fix::fix_text("t.smith", "int f() {\n    return 1; // \"x\" // a\n}\n// end\n");
    check_text(fixed.text, "fn f() -> i32:\n    return 1 # \"x\" // a\n# end\n");
}

// Comments are written as `#` even when a form the fixer cannot mend stays (an array suffix here), so `//` and
// `/* */` do not hide the other causes of the file; a `/* */` comment over two lines becomes two `#` lines.
export void test_comments_are_written_when_another_form_stays() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "int f() {\n    return 1; // one\n}\nStr a[3];\n/* two\n   lines */\n");
    check_text(fixed.text, "fn f() -> i32:\n    return 1 # one\nstr a[3];\n# two\n#   lines \n");
}

// A function type written with the names of its parameters (`Fn(void (Key key))`) is `fn(Key)`: the names are dropped,
// in a field and a parameter alike (#1957).
export void test_a_function_type_with_parameter_names_is_rewritten() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "module m;\ntypedef struct {\n    Fn(void (Key key, U32 n)) hook;\n"
                                                "    Fn(Node * (Node *)) make;\n} Hooks;\n"
                                                "static void run(Fn(void (Key key)) f) {\n}\n");
    check_text(fixed.text, "struct Hooks:\n    hook: fn(Key, u32)\n    make: fn(*mut Node) -> *mut Node\n"
                           "fn run(f: fn(Key)):\n");
}

// The same in a typedef: the name goes with the parameter, and no `Fn(` is left.
export void test_a_typedef_of_a_function_type_with_parameter_names_is_rewritten() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "module m;\ntypedef Fn(U32 (U32 x)) Callback;\n"
                                                "typedef Fn(int (int)) Plain;\n"
                                                "typedef Fn(Node * (Node *, U32 n)) Make;\n");
    parser::Parsed again = fix::parse_for_fix("t.smith", fixed.text);
    check_count(countof(again.errors), 0);
    check_flag(fixed.applied > 0, true);
    check_text(fixed.text, "Callback := fn(u32) -> u32\nPlain := fn(i32) -> i32\n"
                           "Make := fn(*mut Node, u32) -> *mut Node\n");
}

// `c.printf` with no `c` bound, after `import c <stdio.h>`, is mended to the binding: `stdio.printf` (#1678).
static Str as_str(char chars[:]) {
    return chars;
}

static void use_header_flags() {
    const char *self = c::getenv("SMITH_SELF");
    const char *const argv[3] = {self != nullptr ? self : "smith", "cc", "-print-resource-dir"};
    process::OutputResult done = process::run(argv[0:3]);
    if (done != .ok) return;
    Usize n = countof(done.ok.output);
    while (n > 0 && done.ok.output[n - 1] == '\n')
        n -= 1;
    Str dir = as_str(format::push(format::bytes((const char *)done.ok.output.data, n)));
    Str flags = as_str(format::push("-resource-dir\n", dir, "\n"));
    c::setenv("SMITH_FRONT_CIMPORT_FLAGS", flags.data, 1);
}

export void test_a_bare_c_member_becomes_the_header_binding() {
    use_header_flags(); // clang reads the header with smith's resource directory, as `smith cc` passes it
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "import c <stdlib.h>\n\npub fn f() -> i32:\n    c.abs(-1)\n");
    check_text(fixed.text, "import c <stdlib.h>\n\npub fn f() -> i32:\n    stdlib.abs(-1)\n");
    check_count(fixed.applied, 1);
}

// A bare `abs` that `import c <stdlib.h>` declares is written `stdlib.abs` (#2287); a name no header has is left.
export void test_a_bare_c_function_becomes_the_header_binding() {
    use_header_flags();
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "import c <stdlib.h>\n\npub fn f() -> i32:\n    abs(-1)\n");
    check_text(fixed.text, "import c <stdlib.h>\n\npub fn f() -> i32:\n    stdlib.abs(-1)\n");
    check_count(fixed.applied, 1);
}

// An opaque tag and its alias is the opaque `struct Name`, the C name kept by `@c_name` (#2091).
export void test_a_typedef_of_an_opaque_tag_is_rewritten() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed =
        fix::fix_text("t.smith", "module m;\n@c_name(\"SmithChunk\") pub typedef struct SmithChunk Chunk;\n"
                                 "typedef struct Node Node;\n");
    check_text(fixed.text, "@c_name(\"SmithChunk\") pub struct Chunk\nstruct Node\n");
}

// A forward declaration `export struct Name;` is the opaque `pub struct Name`: a type ends with the line (#2312).
export void test_a_forward_declared_struct_loses_its_semicolon() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "module m;\nexport struct Expr;\nexport struct Expr { I32 a; };\n");
    check_text(fixed.text, "pub struct Expr\npub struct Expr:\n    pub a: i32\n");
}

// A value cast to `void` as a statement is `_ := x`, whether it was written `(void)x` or `x.to(void)`: the second
// form has nothing before the operand, so the fix must remove the cast after it too (#2224).
export void test_a_cast_to_void_becomes_a_discard() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "pub fn f(x: i32):\n    x.to(void)\n");
    check_text(fixed.text, "pub fn f(x: i32):\n    _ := x\n");
}

// Unbraced bodies that end together close together, so the inner `if` is mended in the same pass (#2224).
export void test_nested_unbraced_bodies_are_braced_in_one_pass() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed =
        fix::fix_text("t.smith", "void f(int *b) {\n    for (int i = 0; i < 3; i++)\n        if (i == 1)\n"
                                 "            if (i == 2)\n                b[i] = 1;\n}\n");
    check_text(fixed.text, "fn f(b: *mut i32):\n    for i in range(0, 3):\n        if i == 1:\n"
                           "            if i == 2:\n                b[i] = 1\n");
}

// A C `for` over a pointer, with an unbraced body, and a `continue` in it (#2224).
export void test_a_for_over_a_pointer_with_an_unbraced_body_becomes_while() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "typedef struct R {\n    struct R *next;\n    int state;\n} R;\n"
                                                "void f(R *head, int *n) {\n    for (R *r = head; r != nullptr; "
                                                "r = r->next)\n        if (r->state == 1) {\n            *n += 1;\n"
                                                "        }\n    for (R *r = head; r != nullptr; r = r->next) {\n"
                                                "        if (r->state == 2) continue;\n        *n += 1;\n    }\n}\n");
    parser::Parsed again = parser::parse_new("t.smith", fixed.text);
    check_count(countof(again.errors), 0);
    check_count(countof(fixed.text) > 0 ? 1 : 0, 1);
}

// `struct tag name = v` of a C tag is mended with the rest of the function, not by an error that stops it (#2224).
export void test_a_plain_c_tag_declaration_is_mended_with_its_function() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "void f(Usize *dims) {\n    struct smith_array_T_n result = {};\n"
                                                "    for (Usize i = 0; i < 3; i++)\n"
                                                "        result.count[i] = (Usize)dims[i];\n}\n");
    check_text(fixed.text, "fn f(dims: *usize):\n    result: c.smith_array_T_n = {}\n    for i in range(0, 3):\n"
                           "        result.count[i] = dims[i].to(usize)\n");
}

// `c.name` in a generic function nothing calls is written with the header's binding (#2303): the checker reads such a
// body only through its instances.
export void test_a_bare_c_member_in_a_generic_function_becomes_the_header_binding() {
    use_header_flags();
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "import c <stdlib.h>\n\npub fn f(x: auto) -> i32:\n    c.abs(x)\n");
    check_text(fixed.text, "import c <stdlib.h>\n\npub fn f(x: auto) -> i32:\n    stdlib.abs(x)\n");
}

// A lone `[[maybe_unused]]` on an exported function is deleted and the name stays public (#2303); a static one still
// gets the `_` of an unused name.
export void test_maybe_unused_on_an_export_keeps_the_name() {
    fix::Fixed fixed =
        fix::fix_text("t.smith", "module m;\nexport [[maybe_unused]] inline I32 f(I32 x) {\n    return x;\n}\n");
    check_flag(fixed.text.data != nullptr, true);
    check_text(fixed.text, "pub inline fn f(x: i32) -> i32:\n    return x\n");
}

// A static `[[maybe_unused]]` function that the module calls keeps its name: `_` would break the call (#2386).
export void test_maybe_unused_on_a_called_static_keeps_the_name() {
    fix::Fixed fixed = fix::fix_text("t.smith", "module m;\n[[maybe_unused]] static Bool ok(I32 x) {\n    return x > "
                                                "0;\n}\nBool g(I32 x) {\n    return ok(x);\n}\n");
    check_flag(fixed.text.data != nullptr, true);
    check_text(fixed.text, "fn ok(x: i32) -> bool:\n    return x > 0\nfn g(x: i32) -> bool:\n    return ok(x)\n");
}

// A call whose result is dropped is written `_ := f(x)` (#2311): the checker knows the result is not `Void`.
export void test_a_call_statement_with_an_unused_result_is_discarded() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text(
        "t.smith", "module m;\nstatic int f(int x) { return x; }\nstatic void g(int x) {\n    f(x);\n}\n");
    check_text(fixed.text, "fn f(x: i32) -> i32:\n    return x\nfn g(x: i32):\n    _ := f(x)\n");
    fix::Fixed again = fix::fix_text("t.smith", fixed.text);
    check_text(again.text, fixed.text);
}

// A C `for` with several steps and no init is a `while`: the steps run at the end of the body, one to a line. (With
// an init, front::fix_blocks writes the loop from the text.)
export void test_a_for_with_comma_steps_becomes_a_while() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text(
        "t.smith",
        "module m;\nstatic void g(int a, int b) {\n    for (; a < b; a++, b--) {\n        g(a, b);\n    }\n}\n");
    test::check_condition(contains_text(fixed.text, "while"));
    test::check_condition(!contains_text(fixed.text, "for "));
    test::check_condition(contains_text(fixed.text, "b -= 1"));
}

// A compound literal of a tuple type is the tuple's own value: `(struct { I32, F32 }){1, 2.0f}` is `(1, 2.0f)`.
export void test_a_compound_literal_of_a_tuple_type_is_a_tuple_value() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text(
        "t.smith", "module m;\nstatic struct { I32, F32 } make() {\n    return (struct { I32, F32 }){1, 2.0f};\n}\n");
    test::check_condition(contains_text(fixed.text, "(1, 2.0f)"));
    test::check_condition(!contains_text(fixed.text, "{"));
}

// An `if constexpr` inside a branch of another one: its declarations are under both conditions, one `@when` each.
export void test_a_nested_if_constexpr_is_mended_with_both_conditions() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text(
        "t.smith", "module m;\nif constexpr (target::os == target::macos) {\n    if constexpr (target::arch == "
                   "target::aarch64) {\n"
                   "        Bool g() {\n            return true;\n        }\n    } else {\n        Bool g() {\n"
                   "            return false;\n        }\n    }\n}\n");
    test::check_condition(!contains_text(fixed.text, "constexpr"));
    test::check_condition(contains_text(fixed.text, "@when(target.os == .macos and target.arch == .aarch64)"));
    test::check_condition(contains_text(fixed.text, "@when(target.os == .macos and target.arch != .aarch64)"));
}

// `&&` written with no blank after it is `and` with one: `andarena` is not a word the lexer reads as two.
export void test_logical_and_glued_to_its_operand_keeps_a_blank() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "module m;\nstatic Bool f(Bool a, Bool b) {\n    return a &&b;\n}\n");
    test::check_condition(contains_text(fixed.text, "a and b"));
}

// The text `smith lint --fix lib/std/format.smith` segfaulted on: the body of a function that did not read, left as
// top-level `if constexpr` blocks, one of them with no condition. The fix reads no condition that is not there.
export void test_a_top_level_block_whose_condition_did_not_read_does_not_crash() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed =
        fix::fix_text("t.smith", "[[std::c_name(\"a\")]] export void put_bytes(Writer *writer, const char text[:]) {\n"
                                 "    for (Usize i = 0; i < countof(text); i++) {\n    }\n}\n"
                                 "[[std::c_name(\"b\")]] export void put_hex(Writer *writer, Hex hex) {\n"
                                 "    for (Usize place = 0; place < 16; place++) {\n    }\n}\n"
                                 "[[std::c_name(\"c\")]] export typedef struct {\n    if constexpr (T == F32) {\n"
                                 "        return read_f32(word);\n    } else if constexpr (T == F64) {\n"
                                 "        if (!m.ok) return {.error = m.error};\n"
                                 "        if (m.value > (m.negative ? half : half - 1)) return {.error = Range};\n"
                                 "        if (m.value > high) return {.error = Range};\n    }\n}\n");
    test::check_condition(countof(fixed.text) > 0);
}
