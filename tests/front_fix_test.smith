// Tests of fix-its in parse errors and the `smith lint --fix` engine (#1442, S6 of #1428): an error records its edits,
// the edits are applied together or not at all, overlapping fixes apply the first, a file reaches a fixed point, and
// `smith lint --fix` on the real parser applies nothing yet.
module front_fix_test;

import front::fix;
import front::parse as syntax;
import front::parser;
import std::arena;
import std::files;
import std::format;
import std::mem;
import std::process;
import std::slice;
import std::test;
import <stdlib.h>;

// The name of the file in a test that needs none, and the first place the type `Str` is written, which defines it at
// file scope, so a function pointer to `reader` has the same parameter types as the one in front::fix.
static Str file_name;

static void check_text(Str got, Str want) {
    test::check_equal(got, want);
}

static void check_count(Usize got, Usize want) {
    test::check_equal(got, want);
}

static void check_signed(I64 got, I64 want) {
    test::check_equal(got, want);
}

static void check_flag(Bool got, Bool want) {
    test::check_equal(got, want);
}

static syntax::Errors errors_of(Usize n) {
    syntax::Errors errors = {};
    errors = mem::realloc(errors, n);
    for (Usize i = 0; i < n; i++)
        errors[i] = (syntax::ParseError){};
    return errors;
}

static syntax::Errors none_of() {
    syntax::Errors none = {};
    return none;
}

static syntax::Edits fix_of(Usize n) {
    syntax::Edits edits = {};
    return mem::realloc(edits, n);
}

static syntax::Edit edit(U32 start, U32 end, Str text) {
    return (syntax::Edit){.span = {.start = start, .end = end}, .text = text};
}

// A parser that finds the first `OLD` of the text and records `new` as the fix of the error it reports there.
static parser::Parsed reader(Str file, Str source) {
    parser::Parsed result = {};
    result.module.file = file;
    syntax::Parser p = {};
    for (Usize i = 0; i + 3 <= countof(source); i++) {
        if (source[i] == 'O' && source[i + 1] == 'L' && source[i + 2] == 'D') {
            U32 start = (U32)i;
            U32 end = (U32)(i + 3);
            syntax::Edits edits = fix_of(1);
            edits[0] = edit(start, end, "new");
            syntax::error_fix(&p, edits[0].span, "OLD is the old form", edits);
            break;
        }
    }
    result.errors = p.errors;
    return result;
}

export void test_error_fix_records_its_edits() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed parsed = reader("x.smith", "OLD");
    check_count(countof(parsed.errors), 1);
    syntax::Edits made = parsed.errors[0].fix;
    check_count(countof(made), 1);
    check_text(made[0].text, "new");
    check_count(countof(parsed.warnings), 0);
}

export void test_error_without_a_fix_has_none() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed parsed = parser::parse(file_name, "module a; int");
    check_flag(countof(parsed.errors) > 0, true);
    syntax::Edits none = parsed.errors[0].fix;
    check_count(countof(none), 0);
}

export void test_fixes_apply_in_order_of_position() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    syntax::Errors errors = errors_of(2);
    errors[0].fix = fix_of(1);
    errors[0].fix[0] = edit(6, 7, "B");
    errors[1].fix = fix_of(1);
    errors[1].fix[0] = edit(0, 1, "A");
    fix::Fixed fixed = fix::apply_fixes("a bcd b", errors, none_of());
    check_text(fixed.text, "A bcd B");
    check_count(fixed.applied, 2);
    check_count(fixed.skipped, 0);
}

export void test_overlapping_fix_is_skipped() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    syntax::Errors errors = errors_of(2);
    errors[0].fix = fix_of(1);
    errors[0].fix[0] = edit(0, 3, "xyz");
    errors[1].fix = fix_of(2);
    errors[1].fix[0] = edit(5, 6, "Q");
    errors[1].fix[1] = edit(2, 4, "zz");
    fix::Fixed fixed = fix::apply_fixes("abcdefg", errors, none_of());
    check_text(fixed.text, "xyzdefg");
    check_count(fixed.applied, 1);
    check_count(fixed.skipped, 1);
}

// An insertion and a deletion that starts at the same offset are both taken, the insertion first (#1742: `n` then the
// `;` that goes); two insertions at one offset have no order, so the second is skipped.
export void test_insertion_beside_a_deletion_at_one_offset() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    syntax::Errors errors = errors_of(3);
    errors[0].fix = fix_of(1);
    errors[0].fix[0] = edit(3, 4, "");
    errors[1].fix = fix_of(1);
    errors[1].fix[0] = edit(3, 3, " as T");
    errors[2].fix = fix_of(1);
    errors[2].fix[0] = edit(3, 3, "!");
    fix::Fixed fixed = fix::apply_fixes("abc;d", errors, none_of());
    check_text(fixed.text, "abc as Td");
    check_count(fixed.applied, 2);
    check_count(fixed.skipped, 1);
}

export void test_insertion_and_deletion() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    syntax::Errors errors = errors_of(1);
    errors[0].fix = fix_of(2);
    errors[0].fix[0] = edit(1, 1, "-");
    errors[0].fix[1] = edit(2, 3, "");
    fix::Fixed fixed = fix::apply_fixes("abc", errors, none_of());
    check_text(fixed.text, "a-b");
}

export void test_text_reaches_a_fixed_point() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "x OLD y OLD z\n";
    Usize total = 0;
    for (Usize pass = 0; pass < 8; pass++) {
        parser::Parsed parsed = reader("x.smith", source);
        fix::Fixed fixed = fix::apply_fixes(source, parsed.errors, none_of());
        if (fixed.applied == 0) break;
        total += fixed.applied;
        source = fixed.text;
    }
    check_text(source, "x new y new z\n");
    check_count(total, 2);
}

export void test_a_file_is_stored_and_a_second_run_applies_nothing() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str path = "/tmp/front_fix_test_scratch.smith";
    check_flag(fix::store(path, "let a = 1\n"), true);
    check_signed(fix::fix_file(path), 0);
    files::BytesResult back = files::read_file(path);
    if (back == .error) {
        check_text("cannot read back", "the file");
        return;
    }
    char chars[:] = mem::view(back.ok, char);
    Str got = chars;
    check_text(got, "let a = 1\n");
    check_signed(fix::fix_file("/tmp/front_fix_test_missing.smith"), -1);
}

export void test_a_warning_is_kept_apart_and_its_fix_applies() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    syntax::Parser p = {};
    syntax::Edits edits = fix_of(1);
    edits[0] = edit(1, 2, "X");
    syntax::warning_fix(&p, edits[0].span, "old form", edits);
    check_count(countof(p.errors), 0);
    check_count(countof(p.warnings), 1);
    fix::Fixed fixed = fix::apply_fixes("abc", p.errors, p.warnings);
    check_count(fixed.applied, 1);
    check_text(fixed.text, "aXc");
}

export void test_a_source_without_old_forms_has_no_warnings() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed parsed = parser::parse(file_name, "let a = 1\n");
    check_count(countof(parsed.errors), 0);
    check_count(countof(parsed.warnings), 0);
}

export void test_define_and_include_lines_get_one_fix() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    // The header binding is the spelling of #1428; the new parser reads it once #1678 lands, so only the text is
    // checked.
    fix::Fixed fixed = fix::fix_text("t.smith", "#include <sys/stat.h>\n#define LIMIT 4\nconst X = LIMIT\n");
    check_text(fixed.text, "import c <sys/stat.h>\nconst LIMIT = 4\nconst X = LIMIT\n");
    check_count(fixed.applied, 1);
}

// `#if defined(__APPLE__) ... #else ... #endif` around declarations is `@when` on each declaration (#1801).
export void test_an_if_around_declarations_becomes_when() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    // The `@when` lines come from this fix; the rest of each line is mended by the passes after it.
    fix::Fixed fixed = fix::fix_text("t.smith", "#if defined(__APPLE__)\nint open_window() {\n    return 1;\n}\n"
                                                "// closes it\nint close_window() {\n    return 3;\n}\n#else\n"
                                                "int open_window() {\n    return 2;\n}\n#endif\n"
                                                "#ifdef __linux__\nint only_linux() {\n    return 4;\n}\n#endif\n");
    check_text(fixed.text, "@when(target.os == .macos)\nfn open_window() -> i32:\n    return 1\n"
                           "# closes it\n@when(target.os == .macos)\nfn close_window() -> i32:\n    return 3\n"
                           "@when(target.os != .macos)\nfn open_window() -> i32:\n    return 2\n"
                           "@when(target.os == .linux)\nfn only_linux() -> i32:\n    return 4\n");
    parser::Parsed again = parser::parse_new("t.smith", fixed.text);
    check_count(countof(again.errors), 0);
}

// An `#if` that is not about the system, is inside a function or holds another directive stays as it is.
export void test_an_if_that_is_not_about_the_system_has_no_fix() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed none = parser::parse(file_name, "#if defined(DEBUG)\nint f();\n#endif\n");
    check_count(countof(none.errors), 1);
    syntax::Edits no_edits = none.errors[0].fix;
    check_count(countof(no_edits), 0);
    parser::Parsed inside = parser::parse(file_name, "int f() {\n#if defined(__APPLE__)\n    return 1;\n#endif\n}\n");
    syntax::Edits inside_edits = inside.errors[0].fix;
    check_count(countof(inside_edits), 0);
    parser::Parsed other = parser::parse(file_name, "#if defined(__APPLE__)\n#define A 1\n#endif\n");
    syntax::Edits other_edits = other.errors[0].fix;
    check_count(countof(other_edits), 1);
}

export void test_a_fixed_define_reads_in_smiths_own_syntax() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "#define LIMIT 4\nconst X = LIMIT\n");
    check_text(fixed.text, "const LIMIT = 4\nconst X = LIMIT\n");
    parser::Parsed again = parser::parse_new("t.smith", fixed.text);
    check_count(countof(again.errors), 0);
}

export void test_other_directives_stay_errors_without_a_fix() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed parsed = parser::parse(file_name, "#if 1\n#define F(x) x\n#include \"h.h\"\n");
    check_count(countof(parsed.errors), 1);
    syntax::Edits none = parsed.errors[0].fix;
    check_count(countof(none), 0);
}

// `(P){}` is `P()`: an empty compound literal of a named type is rewritten, and the text reads in the new syntax.
export void test_an_empty_compound_literal_is_rewritten_to_a_call() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text(
        "t.smith", "module m;\ntypedef struct { int a; } Node;\nstatic Node make(void) { return (Node){}; }\n");
    check_text(fixed.text, "struct Node:\n    a: i32\nstatic fn make() -> Node:\n    return Node()\n");
    parser::Parsed again = fix::parse_for_fix("t.smith", fixed.text);
    check_count(countof(again.errors), 0);
}

// `typedef void (*Callback)(void);` is `let Callback = fn()`: the capitalized name of the alias stays, `(void)` is no
// parameters, and the text reads in the new syntax (#1769).
export void test_a_typedef_of_a_function_pointer_keeps_its_name() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "module m;\ntypedef void (*Callback)(void);\n"
                                                "typedef int (*Binary)(int, int);\n");
    check_text(fixed.text, "let Callback = fn()\nlet Binary = fn(i32, i32) -> i32\n");
    parser::Parsed again = fix::parse_for_fix("t.smith", fixed.text);
    check_count(countof(again.errors), 0);
}

// C's three-part `for` with no init is a `while` (the spec removes it): the step ends the body, and the result reads
// in smith's own syntax. A body with a `continue` would skip the step, and an init needs a block around the loop for
// its scope, which smith's own syntax has only as a value (`do:`, #2014): those `for`s have no fix.
export void test_a_three_part_for_is_rewritten_to_while() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text(
        "t.smith", "module m;\nstatic void f(int n) {\n    for (; n * 2 < 9; n += 3) {\n        n -= 1;\n    }\n}\n");
    parser::Parsed again = fix::parse_for_fix("t.smith", fixed.text);
    check_count(countof(again.errors), 0);
    check_text(fixed.text, "static fn f(mut n: i32):\n    while n * 2 < 9:\n        n -= 1\n        n += 3\n");
}

export void test_a_three_part_for_with_an_init_gets_no_while() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text(
        "t.smith", "static void f(int n) {\n    for (int i = 0; i * 2 < n; i += 3) {\n        n -= 1;\n    }\n}\n");
    Str word = "while";
    check_flag(slice::find_slice(fixed.text, word) == .some, false);
}

export void test_a_for_with_a_continue_gets_no_while() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text(
        "t.smith", "static void f(int n) {\n    for (int i = 0; i * 2 < n; i += 3) {\n        continue;\n    }\n}\n");
    Str word = "while";
    check_flag(slice::find_slice(fixed.text, word) == .some, false);
}

// `Node n = {.a = 1};` is `let n = Node(a = 1)`: a variable of a named type whose untyped list only has
// field designators, and the text reads in the new syntax (#1767).
export void test_a_variable_with_a_designated_list_is_rewritten_to_a_call() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "module m;\ntypedef struct { int a; } Node;\nstatic Node "
                                                "make(void) {\n    Node n = {.a = 1};\n    return n;\n}\n");
    check_text(fixed.text,
               "struct Node:\n    a: i32\nstatic fn make() -> Node:\n    let n = Node(a = 1)\n    return n\n");
    parser::Parsed again = fix::parse_for_fix("t.smith", fixed.text);
    check_count(countof(again.errors), 0);
}

// A `//` comment is `#` in the revised syntax: the lexer error carries the edit, and fix_text writes it at the end.
export void test_a_slash_comment_becomes_a_hash_comment() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed own = parser::parse_new("t.smith", "fn f() -> i32:\n    return 1 //one\n");
    check_count(countof(own.errors), 1);
    syntax::Edits edits = own.errors[0].fix;
    check_count(countof(edits), 1);
    check_text(edits[0].text, "# ");
    fix::Fixed fixed = fix::fix_text("t.smith", "int f() {\n    return 1; // \"x\" // a\n}\n// end\n");
    check_text(fixed.text, "fn f() -> i32:\n    return 1 # \"x\" // a\n# end\n");
}

// Comments are written as `#` even when a form the fixer cannot mend stays (an array suffix here), so `//` and
// `/* */` do not hide the other causes of the file; a `/* */` comment over two lines becomes two `#` lines.
export void test_comments_are_written_when_another_form_stays() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "int f() {\n    return 1; // one\n}\nint a[3];\n/* two\n   lines */\n");
    check_text(fixed.text, "fn f() -> i32:\n    return 1 # one\ni32 a[3];\n# two\n#   lines \n");
}

// A function type written with the names of its parameters (`Fn(void (Key key))`) is `fn(Key)`: the names are dropped,
// in a field and a parameter alike (#1957).
export void test_a_function_type_with_parameter_names_is_rewritten() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "module m;\ntypedef struct {\n    Fn(void (Key key, U32 n)) hook;\n"
                                                "    Fn(Node * (Node *)) make;\n} Hooks;\n"
                                                "static void run(Fn(void (Key key)) f) {\n}\n");
    check_text(fixed.text, "struct Hooks:\n    hook: fn(Key, u32)\n    make: fn(*Node) -> *Node\n"
                           "static fn run(f: fn(Key)):\n");
}

// The same in a typedef: the name goes with the parameter, and no `Fn(` is left.
export void test_a_typedef_of_a_function_type_with_parameter_names_is_rewritten() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "module m;\ntypedef Fn(U32 (U32 x)) Callback;\n"
                                                "typedef Fn(int (int)) Plain;\n"
                                                "typedef Fn(Node * (Node *, U32 n)) Make;\n");
    parser::Parsed again = fix::parse_for_fix("t.smith", fixed.text);
    check_count(countof(again.errors), 0);
    check_flag(fixed.applied > 0, true);
    check_text(fixed.text, "let Callback = fn(u32) -> u32\nlet Plain = fn(i32) -> i32\n"
                           "let Make = fn(*Node, u32) -> *Node\n");
}

// `c.printf` with no `c` bound, after `import c <stdio.h>`, is mended to the binding: `stdio.printf` (#1678).
static Str as_str(char chars[:]) {
    return chars;
}

static void use_header_flags() {
    const char *self = c::getenv("SMITH_SELF");
    const char *const argv[3] = {self != nullptr ? self : "smith", "cc", "-print-resource-dir"};
    process::OutputResult done = process::run(argv[0:3]);
    if (done != .ok) return;
    Usize n = countof(done.ok.output);
    while (n > 0 && done.ok.output[n - 1] == '\n')
        n -= 1;
    Str dir = as_str(format::push(format::bytes((const char *)done.ok.output.data, n)));
    Str flags = as_str(format::push("-resource-dir\n", dir, "\n"));
    c::setenv("SMITH_FRONT_CIMPORT_FLAGS", flags.data, 1);
}

export void test_a_bare_c_member_becomes_the_header_binding() {
    use_header_flags(); // clang reads the header with smith's resource directory, as `smith cc` passes it
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", "import c <stdlib.h>\n\npub fn f() -> i32:\n    c.abs(-1)\n");
    check_text(fixed.text, "import c <stdlib.h>\n\npub fn f() -> i32:\n    stdlib.abs(-1)\n");
    check_count(fixed.applied, 1);
}
