// The wiring of `smith fetch` around the archive readers (issue #292): a refused archive is a failing status, a message
// with the reason that names the archive, and nothing left in the cache; a gzip of one file becomes a package folder
// holding it. One case of each, with the system's tar and gzip. What the readers accept and refuse (every format, the
// hostile and the damaged archives, the single .gz) is tested as functions in tests/untar_readers_test.smith, which
// replaced the other cases of this file (issue #646); the readers under the sanitizers are
// tests/untar_sanitizers_test.smith. Every fetch has a cache of its own; the shell functions are those of
// tests/build_fixtures/untar/prelude. A test's texts are pushed on its test::memory arena, which is also the current
// allocator, so what scratch returns goes back with it.
module untar_refuse_test;

import smith::arena;
import smith::format;
import smith::test;
import scratch;
import <string.h>;
import smith::mem;

static scratch::Project untar_project() {
    scratch::Project p = scratch::make("p", "untar");
    scratch::copy_tree(&p, "tests/untar.c", "tests/untar.c");
    scratch::copy_tree(&p, "tests/xz.py", "tests/xz.py");
    scratch::copy_tree(&p, "lib", "lib");
    scratch::copy_tree(&p, "runtime", "runtime");
    return p;
}

static scratch::Run run(const scratch::Project *p, const char *body) {
    return scratch::sh(p, format::push(". ./prelude; ", body).data);
}

static const char *text(const scratch::Project *p, const char *body) {
    return scratch::capture(p, format::push(". ./prelude; ", body).data);
}

// A setup command that must succeed.
static void setup(const scratch::Project *p, const char *body) {
    scratch::Run made = run(p, body);
    scratch::expect_status("the setup of the case", 0, &made);
}

static const char *join(const char *a, const char *b) {
    return format::push(a, b).data;
}

// Fetches an archive (a path in the project) into a cache of its own; the package folder is in *package, or
// "/nonexistent" when it failed.
static scratch::Run fetch(arena::Arena *memory, const scratch::Project *p, const char *cache, const char *archive,
                          const char **package) {
    scratch::Run fetched = run(
        p, format::push("XDG_CACHE_HOME=\"$PWD/cache-", cache, "\" smith fetch \"file://$PWD/", archive, "\"").data);
    *package = "/nonexistent";
    const char *start = fetched.status == 0 ? c::strstr(fetched.out, "\"sha256:") : nullptr;
    if (start != nullptr) {
        char *hash = arena::push_slice(memory, char, 65).data;
        mem::copy(hash[0:64], start[8:8 + 64]);
        hash[64] = '\0';
        *package = format::push(p->dir, "/cache-", cache, "/smith/packages/", hash).data;
    }
    return fetched;
}

// An archive that must be refused: a failing status, a message with the reason, and nothing left in the cache.
static void refuse(arena::Arena *memory, const scratch::Project *p, const char *name, const char *archive,
                   const char *needle) {
    const char *package = nullptr;
    scratch::Run fetched = fetch(memory, p, "r", archive, &package);
    scratch::expect_failure(join(name, ": fails"), &fetched);
    scratch::expect_contains(join(name, ": says why"), fetched.err, needle);
    scratch::expect_contains(join(name, ": names the archive"), fetched.err,
                             format::push("cannot extract file://", text(p, "pwd"), "/", archive).data);
    scratch::expect_text(join(name, ": leaves no package"), "0",
                         text(p, "ls \"$PWD/cache-r/smith/packages\" 2>/dev/null | grep -c '^[0-9a-f]\\{64\\}$'"));
    scratch::expect_text(join(name, ": and no temporary"), "0",
                         text(p, "ls -A \"$PWD/cache-r/smith/packages\" 2>/dev/null | grep -c '^\\.tmp'"));
}

// A refusal of a tar made from the hostile tree by one tar command, run in the tree's folder.
static void refuse_hostile(arena::Arena *memory, const scratch::Project *p, const char *name, const char *archive,
                           const char *tar_arguments, const char *needle) {
    setup(p, format::push("hostile_tree; (cd \"$h\" && tar -cf \"$arc/", archive, "\" ", tar_arguments, ")").data);
    refuse(memory, p, name, join("arc/", archive), needle);
}

// Hostile archives, made with tar's -P and -s so that it writes the names it would normally refuse. This one is refused
// with the reason and leaves nothing in the cache.
export void test_untar_refuses_traversal() {
    scratch::Project p = untar_project(); // before the arena: clean frees what make holds
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    refuse_hostile(&memory, &p, "traversal", "up.tar", "-P -s ',^pkg-1.0/a.txt$,../evil,' pkg-1.0/a.txt",
                   "goes up out of the package");
}

// A gz of one file that is no tar (a release binary, as tree-sitter's): the package is a folder holding that file,
// named after the URL without ".gz", with the bytes as they were and mode 0644.
constexpr char make_single[_] =
    "mkdir -p single; head -c 200000 /dev/urandom >single/tool-bin; "
    "awk 'BEGIN { for (i = 0; i < 3000; i++) printf \"line %d of a text that repeats\\n\", i % 11 }' >single/text; "
    "printf 'tiny\\n' >single/tiny; : >single/nothing; "
    "for f in tool-bin text; do gzip -c \"single/$f\" >\"$arc/$f.gz\"; done; ";

static void single_gz_extracts(arena::Arena *memory, const scratch::Project *p, const char *f) {
    setup(p, make_single);
    const char *package = nullptr;
    scratch::Run fetched = fetch(memory, p, "a", join(join("arc/", f), ".gz"), &package);
    const char *name = join("single gz ", f);
    scratch::expect_status(join(name, ": extracts"), 0, &fetched);
    scratch::expect_text(join(name, ": one file, named without .gz"), f, text(p, join("ls 2>/dev/null ", package)));
    scratch::expect_text(join(name, ": the same bytes"), text(p, join("shasum -a 256 <single/", f)),
                         text(p, format::push("shasum -a 256 <\"", package, "/", f, "\" 2>/dev/null").data));
    scratch::expect_text(join(name, ": mode 0644"), "-rw-r--r--",
                         text(p, format::push("f=\"", package, "/", f,
                                              "\"; stat -c %A \"$f\" 2>/dev/null || stat -f %Sp \"$f\" 2>/dev/null")
                                     .data));
}

export void test_untar_single_gz_text() {
    scratch::Project p = untar_project(); // before the arena: clean frees what make holds
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    single_gz_extracts(&memory, &p, "text");
}
