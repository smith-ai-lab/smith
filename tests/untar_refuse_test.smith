// Archives smith's own extraction must refuse, and the single .gz it accepts, from tests/untar.sh sections 3 and 4
// (issue #292): hostile archives made with tar's -P and -s (names it would normally refuse), damaged and truncated
// archives, and changed bytes only a check can notice. Each refusal is a failing status, a message with the reason, the
// archive named, and nothing left in the cache. Every fetch has a cache of its own; the shell functions are those of
// tests/build_fixtures/untar/prelude.
module untar_refuse_test;

import smith::arena;
import smith::format;
import smith::io;
import smith::test;
import scratch;
import <string.h>;

static scratch::Project untar_project(io::Io *io) {
    return scratch::project(io, "p", "untar");
}

static scratch::Run run(const scratch::Project *p, const char *body) {
    return scratch::sh(p, format::push(&p->io->arena, ". ./prelude; ", body).data);
}

static const char *text(const scratch::Project *p, const char *body) {
    return scratch::capture(p, format::push(&p->io->arena, ". ./prelude; ", body).data);
}

// A setup command that must succeed.
static void setup(const scratch::Project *p, const char *body) {
    scratch::Run made = run(p, body);
    scratch::expect_status("the setup of the case", 0, &made);
}

static const char *join(const scratch::Project *p, const char *a, const char *b) {
    return format::push(&p->io->arena, a, b).data;
}

// Fetches an archive (a path in the project) into a cache of its own; the package folder is in *package, or
// "/nonexistent" when it failed.
static scratch::Run fetch(const scratch::Project *p, const char *cache, const char *archive, const char **package) {
    scratch::Run fetched = run(p, format::push(&p->io->arena, "XDG_CACHE_HOME=\"$PWD/cache-", cache,
                                               "\" smith fetch \"file://$PWD/", archive, "\"")
                                      .data);
    *package = "/nonexistent";
    const char *start = fetched.status == 0 ? c::strstr(fetched.out, "\"sha256:") : nullptr;
    if (start != nullptr) {
        char *hash = arena::push_slice(&p->io->arena, char, 65).data;
        __builtin_memcpy(hash, start + 8, 64);
        hash[64] = '\0';
        *package = format::push(&p->io->arena, p->dir, "/cache-", cache, "/smith/packages/", hash).data;
    }
    return fetched;
}

// An archive that must be refused: a failing status, a message with the reason, and nothing left in the cache.
static void refuse(const scratch::Project *p, const char *name, const char *archive, const char *needle) {
    const char *package = nullptr;
    scratch::Run fetched = fetch(p, "r", archive, &package);
    scratch::expect_failure(join(p, name, ": fails"), &fetched);
    scratch::expect_contains(join(p, name, ": says why"), fetched.err, needle);
    scratch::expect_contains(join(p, name, ": names the archive"), fetched.err,
                             format::push(&p->io->arena, "cannot extract file://", text(p, "pwd"), "/", archive).data);
    scratch::expect_text(join(p, name, ": leaves no package"), "0",
                         text(p, "ls \"$PWD/cache-r/smith/packages\" 2>/dev/null | grep -c '^[0-9a-f]\\{64\\}$'"));
    scratch::expect_text(join(p, name, ": and no temporary"), "0",
                         text(p, "ls -A \"$PWD/cache-r/smith/packages\" 2>/dev/null | grep -c '^\\.tmp'"));
}

// A refusal of a tar made from the hostile tree by one tar command, run in the tree's folder.
static void refuse_hostile(io::Io *io, const char *name, const char *archive, const char *tar_arguments,
                           const char *needle) {
    scratch::Project p = untar_project(io);
    setup(&p,
          format::push(&io->arena, "hostile_tree; (cd \"$h\" && tar -cf \"$arc/", archive, "\" ", tar_arguments, ")")
              .data);
    refuse(&p, name, join(&p, "arc/", archive), needle);
}

// 3. Hostile archives, made with tar's -P and -s so that it writes the names it would normally refuse. Each is refused
// with the reason, leaves nothing in the cache, and writes nothing outside the extraction folder.
export void test_untar_refuses_traversal(io::Io *io) {
    refuse_hostile(io, "traversal", "up.tar", "-P -s ',^pkg-1.0/a.txt$,../evil,' pkg-1.0/a.txt",
                   "goes up out of the package");
}

export void test_untar_refuses_traversal_inside_a_path(io::Io *io) {
    refuse_hostile(io, "traversal inside a path", "up-deep.tar",
                   "-P -s ',^pkg-1.0/a.txt$,pkg-1.0/x/../../../evil,' pkg-1.0/a.txt", "goes up out of the package");
}

export void test_untar_refuses_a_name_that_is_dotdot(io::Io *io) {
    refuse_hostile(io, "a name that is ..", "dotdot-only.tar", "-P -s ',^pkg-1.0/a.txt$,..,' pkg-1.0/a.txt",
                   "goes up out of the package");
}

export void test_untar_refuses_an_absolute_path(io::Io *io) {
    refuse_hostile(io, "an absolute path", "absolute.tar",
                   "-P -s \",^pkg-1.0/a.txt\\$,$work/target/abs-evil,\" pkg-1.0/a.txt", "absolute path");
}

export void test_untar_refuses_a_symlink_out_of_the_package(io::Io *io) {
    refuse_hostile(io, "a symlink out of the package", "escape.tar", "-P pkg-1.0/escape", "points outside the package");
}

export void test_untar_refuses_an_absolute_symlink(io::Io *io) {
    refuse_hostile(io, "an absolute symlink", "absolute-link.tar", "-P pkg-1.0/absolute", "absolute path");
}

export void test_untar_refuses_a_symlink_that_goes_up_after_going_down(io::Io *io) {
    refuse_hostile(io, "a symlink that goes up after going down", "dotdot-link.tar", "-P pkg-1.0/dotdot",
                   "goes up after going down");
}

export void test_untar_refuses_a_symlink_far_above(io::Io *io) {
    refuse_hostile(io, "a symlink far above", "far-link.tar", "-P pkg-1.0/far", "points outside the package");
}

export void test_untar_refuses_a_file_written_through_a_symlink(io::Io *io) {
    refuse_hostile(io, "a file written through a symlink", "through.tar",
                   "-P -s ',^pkg-1.0/a.txt$,pkg-1.0/self/under,' pkg-1.0/self pkg-1.0/a.txt", "through a symlink");
}

// tar warns that it cannot pack the extended attributes of these two, and still writes them.
export void test_untar_refuses_a_fifo(io::Io *io) {
    refuse_hostile(io, "a FIFO", "fifo.tar", "-P pkg-1.0/fifo 2>/dev/null; true", "special file");
}

export void test_untar_refuses_a_device(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "tar -cf \"$arc/device.tar\" -P -s ',^/dev/null$,pkg-1.0/null,' /dev/null 2>/dev/null; true");
    refuse(&p, "a device", "arc/device.tar", "special file");
}

// Nothing is written outside the extraction folder, whichever of them is fetched.
export void test_untar_hostile_archives_write_nothing_beside_the_caches_folders(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "hostile_tree; abs=$work/target/abs-evil; cd \"$h\" && "
              "tar -cf \"$arc/up.tar\" -P -s ',^pkg-1.0/a.txt$,../evil,' pkg-1.0/a.txt && "
              "tar -cf \"$arc/up-deep.tar\" -P -s ',^pkg-1.0/a.txt$,pkg-1.0/x/../../../evil,' pkg-1.0/a.txt && "
              "tar -cf \"$arc/absolute.tar\" -P -s \",^pkg-1.0/a.txt\\$,$abs,\" pkg-1.0/a.txt && "
              "tar -cf \"$arc/through.tar\" -P -s ',^pkg-1.0/a.txt$,pkg-1.0/self/under,' pkg-1.0/self pkg-1.0/a.txt");
    for (usize i = 0; i < 4; i++) {
        const char *names[] = {"up", "up-deep", "absolute", "through"};
        const char *package = nullptr;
        scratch::Run fetched = fetch(&p, names[i], join(&p, join(&p, "arc/", names[i]), ".tar"), &package);
        scratch::expect_failure(join(&p, "hostile: refused: ", names[i]), &fetched);
    }
    scratch::expect_text("hostile: nothing was written beside the cache's folders", "0",
                         text(&p, "find \"$PWD/..\" -name 'evil*' -o -name 'abs-evil' | wc -l | tr -d ' '"));
}

// A symlink that stays in its top-level folder is fine, and one that reaches the folder above it is refused only when
// the package is that one folder, since it then leaves the package.
constexpr char make_top[] =
    "mkdir -p top/pkg-1.0/a/b top/other; echo data >top/pkg-1.0/a/data; ln -s ../data top/pkg-1.0/a/b/inside; "
    "ln -s ../../../other top/pkg-1.0/a/b/sibling; ";

export void test_untar_symlinks_one_inside_the_package_is_kept(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_top,
                   "(cd top && tar -n -cf \"$arc/inside.tar\" pkg-1.0/a pkg-1.0/a/b pkg-1.0/a/data "
                   "pkg-1.0/a/b/inside)"));
    const char *package = nullptr;
    scratch::Run fetched = fetch(&p, "a", "arc/inside.tar", &package);
    scratch::expect_status("symlinks: the archive extracts", 0, &fetched);
    scratch::expect_text("symlinks: one inside the package is kept", "../data",
                         text(&p, join(&p, "readlink 2>/dev/null ", join(&p, package, "/a/b/inside"))));
}

export void test_untar_symlinks_one_that_leaves_the_single_top_level_folder_is_refused(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_top,
                   "(cd top && tar -n -cf \"$arc/sibling-one.tar\" pkg-1.0/a pkg-1.0/a/b pkg-1.0/a/data "
                   "pkg-1.0/a/b/sibling)"));
    refuse(&p, "symlinks: one that leaves the single top-level folder", "arc/sibling-one.tar",
           "points outside the package folder");
}

export void test_untar_symlinks_the_same_link_beside_a_second_top_level_entry_is_kept(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_top,
                   "(cd top && tar -n -cf \"$arc/sibling-two.tar\" pkg-1.0/a pkg-1.0/a/b "
                   "pkg-1.0/a/b/sibling other)"));
    const char *package = nullptr;
    scratch::Run fetched = fetch(&p, "a", "arc/sibling-two.tar", &package);
    scratch::expect_status("symlinks: the archive extracts", 0, &fetched);
    scratch::expect_text("symlinks: the same link beside a second top-level entry is kept", "../../../other",
                         text(&p, join(&p, "readlink 2>/dev/null ", join(&p, package, "/pkg-1.0/a/b/sibling"))));
}

// Hard links to an earlier entry.
export void test_untar_hard_links_both_names_have_the_bytes(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "mkdir -p hard/pkg-1.0 && echo shared >hard/pkg-1.0/one && ln hard/pkg-1.0/one hard/pkg-1.0/two && "
              "(cd hard && tar -cf \"$arc/hard.tar\" pkg-1.0)");
    const char *package = nullptr;
    scratch::Run fetched = fetch(&p, "a", "arc/hard.tar", &package);
    scratch::expect_status("hard links: the archive extracts", 0, &fetched);
    scratch::expect_text("hard links: both names have the bytes", "shared shared",
                         text(&p, format::push(&p.io->arena, "cat 2>/dev/null \"", package, "/one\" \"", package,
                                               "/two\" | tr '\\n' ' ' | sed 's/ $//'")
                                      .data));
}

// macOS tar writes extended attributes as "._name" entries in the AppleDouble format and bsdtar turns them back into
// attributes, so they never become files, and the package is still one folder. smith drops them too, by the format's
// magic number; a "._" file of anything else is a file like any other.
constexpr char make_apple[] =
    "mkdir -p apple/pkg-1.0 apple-plain/pkg-1.0; echo first >apple/pkg-1.0/a; echo second >apple/pkg-1.0/b; "
    "printf 'a plain file that only has a name like metadata\\n' >apple-plain/pkg-1.0/dot_plain; "
    "printf 'tiny\\n' >apple-plain/pkg-1.0/dot_tiny; "
    "xattr -w com.example.test value apple/pkg-1.0/a 2>/dev/null; xattr -w com.example.test value apple/pkg-1.0/b "
    "2>/dev/null; "
    "(cd apple && env -u COPYFILE_DISABLE tar -cf \"$arc/apple.tar\" pkg-1.0); "
    "(cd apple-plain && tar -rf \"$arc/apple.tar\" -s ',dot_,._,' pkg-1.0/dot_plain pkg-1.0/dot_tiny); "
    "mkdir -p apple-expect; cp -R apple/pkg-1.0 apple-expect/ && xattr -cr apple-expect; "
    "cp apple-plain/pkg-1.0/dot_plain apple-expect/pkg-1.0/._plain; cp apple-plain/pkg-1.0/dot_tiny "
    "apple-expect/pkg-1.0/._tiny; ";

// True when this tar writes AppleDouble entries (tar -t hides them, so look at the bytes).
static bool apple_tar_made(const scratch::Project *p) {
    setup(p, make_apple);
    scratch::Run found = run(p, "grep -a -c '\\._a' \"$arc/apple.tar\"");
    if (found.out[0] == '0') {
        test::note("skip  AppleDouble entries: this tar writes none");
        return false;
    }
    return true;
}

export void test_untar_appledouble_entries_become_no_files(io::Io *io) {
    scratch::Project p = untar_project(io);
    if (!apple_tar_made(&p)) {
        return;
    }
    const char *package = nullptr;
    scratch::Run fetched = fetch(&p, "a", "arc/apple.tar", &package);
    scratch::expect_status("AppleDouble entries: the archive extracts", 0, &fetched);
    scratch::expect_text("AppleDouble entries become no files, and the package is still one folder",
                         text(&p, "listing apple-expect/pkg-1.0"),
                         text(&p, join(&p, join(&p, "listing \"", package), "\" 2>/dev/null")));
}

export void test_untar_appledouble_entries_in_a_tar_gz(io::Io *io) {
    scratch::Project p = untar_project(io);
    if (!apple_tar_made(&p)) {
        return;
    }
    setup(&p, "gzip -c \"$arc/apple.tar\" >\"$arc/apple.tar.gz\"");
    const char *package = nullptr;
    scratch::Run fetched = fetch(&p, "a", "arc/apple.tar.gz", &package);
    scratch::expect_status("AppleDouble entries in a tar.gz: extracts", 0, &fetched);
    scratch::expect_text("AppleDouble entries in a tar.gz: the same tree, modes and bytes",
                         text(&p, "listing apple-expect/pkg-1.0"),
                         text(&p, join(&p, join(&p, "listing \"", package), "\" 2>/dev/null")));
}

// 4. Damaged archives.
export void test_untar_refuses_not_an_archive(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_src");
    refuse(&p, "not an archive", "src/pkg-1.0/hello.txt", "not a tar, tar.gz, tar.xz or gzip archive");
}

export void test_untar_refuses_an_empty_file(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, ": >\"$arc/empty\"");
    refuse(&p, "an empty file", "arc/empty", "the archive is empty");
}

export void test_untar_refuses_a_zip(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_src; (cd src && zip -qr \"$arc/pkg.zip\" pkg-1.0)");
    refuse(&p, "a zip", "arc/pkg.zip", "zip archives are not supported");
}

export void test_untar_refuses_a_bzip2(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_a_tar; bzip2 -c \"$arc/a.tar\" >\"$arc/a.tar.bz2\"");
    refuse(&p, "a bzip2", "arc/a.tar.bz2", "bzip2 archives are not supported");
}

constexpr char make_gz[] =
    "make_a_tar; gzip -c \"$arc/a.tar\" >\"$arc/a.tar.gz\"; size=$(wc -c <\"$arc/a.tar.gz\" | tr -d ' '); ";
constexpr char make_xz[] =
    "make_a_tar; xz -c \"$arc/a.tar\" >\"$arc/a.tar.xz\"; size=$(wc -c <\"$arc/a.tar.xz\" | tr -d ' '); ";

export void test_untar_refuses_a_truncated_gzip(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_gz, "head -c $((size / 2)) \"$arc/a.tar.gz\" >\"$arc/cut.tar.gz\""));
    refuse(&p, "a truncated gzip", "arc/cut.tar.gz", "gzip:");
}

export void test_untar_refuses_a_gzip_without_its_trailer(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_gz, "head -c $((size - 4)) \"$arc/a.tar.gz\" >\"$arc/cut-trailer.tar.gz\""));
    refuse(&p, "a gzip without its trailer", "arc/cut-trailer.tar.gz", "the data is cut off");
}

export void test_untar_refuses_a_truncated_xz(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_xz, "head -c $((size / 2)) \"$arc/a.tar.xz\" >\"$arc/cut.tar.xz\""));
    refuse(&p, "a truncated xz", "arc/cut.tar.xz", "xz:");
}

export void test_untar_refuses_an_xz_without_its_footer(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_xz, "head -c $((size - 6)) \"$arc/a.tar.xz\" >\"$arc/cut-footer.tar.xz\""));
    refuse(&p, "an xz without its footer", "arc/cut-footer.tar.xz", "footer");
}

export void test_untar_refuses_a_truncated_tar(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_a_tar; head -c 3000 \"$arc/a.tar\" >\"$arc/cut.tar\"");
    refuse(&p, "a truncated tar", "arc/cut.tar", "cut off");
}

// A .gz of one file that is no tar (a release binary, as tree-sitter's): the package is a folder holding that file,
// named after the URL without ".gz", with the bytes as they were and mode 0644. A gzip of a tar is still a tar.
constexpr char make_single[] =
    "mkdir -p single; head -c 200000 /dev/urandom >single/tool-bin; "
    "awk 'BEGIN { for (i = 0; i < 3000; i++) printf \"line %d of a text that repeats\\n\", i % 11 }' >single/text; "
    "printf 'tiny\\n' >single/tiny; : >single/nothing; "
    "for f in tool-bin text tiny nothing; do gzip -c \"single/$f\" >\"$arc/$f.gz\"; done; ";

static void single_gz_extracts(io::Io *io, const char *f) {
    scratch::Project p = untar_project(io);
    setup(&p, make_single);
    const char *package = nullptr;
    scratch::Run fetched = fetch(&p, "a", join(&p, join(&p, "arc/", f), ".gz"), &package);
    const char *name = join(&p, "single gz ", f);
    scratch::expect_status(join(&p, name, ": extracts"), 0, &fetched);
    scratch::expect_text(join(&p, name, ": one file, named without .gz"), f,
                         text(&p, join(&p, "ls 2>/dev/null ", package)));
    scratch::expect_text(
        join(&p, name, ": the same bytes"), text(&p, join(&p, "shasum -a 256 <single/", f)),
        text(&p, format::push(&p.io->arena, "shasum -a 256 <\"", package, "/", f, "\" 2>/dev/null").data));
    scratch::expect_text(
        join(&p, name, ": mode 0644"), "-rw-r--r--",
        text(&p, format::push(&p.io->arena, "stat -f %Sp \"", package, "/", f, "\" 2>/dev/null").data));
}

export void test_untar_single_gz_tool_bin(io::Io *io) {
    single_gz_extracts(io, "tool-bin");
}

export void test_untar_single_gz_text(io::Io *io) {
    single_gz_extracts(io, "text");
}

export void test_untar_single_gz_tiny(io::Io *io) {
    single_gz_extracts(io, "tiny");
}

export void test_untar_single_gz_nothing(io::Io *io) {
    single_gz_extracts(io, "nothing");
}

export void test_untar_single_gz_with_no_gz_in_its_name_keeps_the_name(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_single, "cp \"$arc/text.gz\" \"$arc/noext\""));
    const char *package = nullptr;
    scratch::Run fetched = fetch(&p, "a", "arc/noext", &package);
    scratch::expect_status("single gz with no .gz in its name: extracts", 0, &fetched);
    scratch::expect_text("single gz with no .gz in its name keeps the name", "noext",
                         text(&p, join(&p, "ls 2>/dev/null ", package)));
}

export void test_untar_a_gz_of_a_tar_is_still_a_tar(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_a_tar; gzip -c \"$arc/a.tar\" >\"$arc/a.tar.gz\"");
    const char *package = nullptr;
    scratch::Run fetched = fetch(&p, "a", "arc/a.tar.gz", &package);
    scratch::expect_status("a gz of a tar: extracts", 0, &fetched);
    scratch::expect_text("a gz of a tar is still a tar", "yes",
                         text(&p, join(&p, join(&p, "[ -f \"", package), "/hello.txt\" ] && echo yes || echo no")));
}

constexpr char make_single_size[] = "size=$(wc -c <\"$arc/tool-bin.gz\" | tr -d ' '); ";

export void test_untar_refuses_a_truncated_single_gz(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, join(&p, make_single, make_single_size),
                   "head -c $((size / 2)) \"$arc/tool-bin.gz\" >\"$arc/cut-single.gz\""));
    refuse(&p, "a truncated single gz", "arc/cut-single.gz", "gzip:");
}

export void test_untar_refuses_a_single_gz_without_its_trailer(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, join(&p, make_single, make_single_size),
                   "head -c $((size - 4)) \"$arc/tool-bin.gz\" >\"$arc/cut-single-trailer.gz\""));
    refuse(&p, "a single gz without its trailer", "arc/cut-single-trailer.gz", "the data is cut off");
}

export void test_untar_refuses_a_single_gz_with_a_wrong_crc(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p,
          join(&p, join(&p, make_single, make_single_size),
               "{ head -c $((size - 8)) \"$arc/tool-bin.gz\"; printf '\\1\\2\\3\\4'; tail -c 4 \"$arc/tool-bin.gz\"; } "
               ">\"$arc/crc-single.gz\""));
    refuse(&p, "a single gz with a wrong CRC", "arc/crc-single.gz", "checksum of the data does not match");
}

export void test_untar_refuses_a_single_gz_with_a_wrong_size(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, join(&p, make_single, make_single_size),
                   "{ head -c $((size - 4)) \"$arc/tool-bin.gz\"; printf '\\1\\2\\3\\4'; } >\"$arc/len-single.gz\""));
    refuse(&p, "a single gz with a wrong size", "arc/len-single.gz", "size of the data");
}

// A byte changed at a place that only a check can notice: gzip's CRC-32 and size, and xz's check of each kind. The
// random archive stores its data, so a changed byte in the middle is still well-formed LZMA2 or DEFLATE.
export void test_untar_refuses_a_gzip_with_a_wrong_crc32(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_gz, "flip \"$arc/a.tar.gz\" -8 \"$arc/bad-crc.tar.gz\""));
    refuse(&p, "a gzip with a wrong CRC-32", "arc/bad-crc.tar.gz", "checksum of the data does not match");
}

export void test_untar_refuses_a_gzip_with_a_wrong_size(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_gz, "flip \"$arc/a.tar.gz\" -4 \"$arc/bad-size.tar.gz\""));
    refuse(&p, "a gzip with a wrong size", "arc/bad-size.tar.gz", "size of the data does not match");
}

export void test_untar_refuses_a_gzip_with_a_changed_byte_in_a_stored_block(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_rand; gzip -c \"$arc/rand.tar\" >\"$arc/rand.tar.gz\"; flip \"$arc/rand.tar.gz\" 100000 "
              "\"$arc/bad-stored.tar.gz\"");
    refuse(&p, "a gzip with a changed byte in a stored block", "arc/bad-stored.tar.gz",
           "checksum of the data does not match");
}

static void xz_check_changed(io::Io *io, const char *check) {
    scratch::Project p = untar_project(io);
    setup(&p, format::push(&io->arena, "make_rand; xz --check=", check, " -c \"$arc/rand.tar\" >\"$arc/rand-", check,
                           ".tar.xz\"; flip \"$arc/rand-", check, ".tar.xz\" 100000 \"$arc/bad-", check, ".tar.xz\"")
                  .data);
    refuse(&p, join(&p, "an xz with a changed byte under ", check), join(&p, join(&p, "arc/bad-", check), ".tar.xz"),
           "check does not match its data");
}

export void test_untar_refuses_an_xz_with_a_changed_byte_under_crc32(io::Io *io) {
    xz_check_changed(io, "crc32");
}

export void test_untar_refuses_an_xz_with_a_changed_byte_under_crc64(io::Io *io) {
    xz_check_changed(io, "crc64");
}

export void test_untar_refuses_an_xz_with_a_changed_byte_under_sha256(io::Io *io) {
    xz_check_changed(io, "sha256");
}

export void test_untar_refuses_an_xz_with_a_damaged_stream_header(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_xz, "flip \"$arc/a.tar.xz\" 7 \"$arc/bad-flags.tar.xz\""));
    refuse(&p, "an xz with a damaged stream header", "arc/bad-flags.tar.xz", "stream header");
}

export void test_untar_refuses_an_xz_with_a_damaged_block_header(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_xz, "flip \"$arc/a.tar.xz\" 13 \"$arc/bad-block.tar.xz\""));
    refuse(&p, "an xz with a damaged block header", "arc/bad-block.tar.xz", "block header");
}

export void test_untar_refuses_an_xz_with_a_damaged_index(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_xz, "flip \"$arc/a.tar.xz\" -14 \"$arc/bad-index.tar.xz\""));
    refuse(&p, "an xz with a damaged index", "arc/bad-index.tar.xz", "index");
}

export void test_untar_refuses_a_tar_with_a_damaged_header(io::Io *io) {
    scratch::Project p = untar_project(io);
    // In the second header, since the first decides that this is a tar.
    setup(&p, "make_a_tar; flip \"$arc/a.tar\" 522 \"$arc/bad-header.tar\"");
    refuse(&p, "a tar with a damaged header", "arc/bad-header.tar", "checksum does not match");
}
