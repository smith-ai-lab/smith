# Names that were keywords once stay names where the syntax allows a name.
import c <stdio.h>

struct S:
    pub module: i32
    pub export: i32
    pub kind: i32

fn throw_it(new: i32, class: i32) -> i32:
    let u8 = new + class
    u8 + 1

pub fn main() -> i32:
    let s = S(module = 1, export = 2, kind = 3)
    let value = throw_it(s.module, s.export)
    stdio.printf("%d %d\n", value, s.kind)
    0
