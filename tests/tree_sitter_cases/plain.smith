// Plain C in a .smith file: the new words are names where C allows names.
#include <stdio.h>

typedef int import;
struct S { int module; int export; int type; };

static int throw_it(int new, int class) {
    int u8 = new + class;
    return u8 + 1;
}

int main(void) {
    struct S s = {.module = 1, .export = 2, .type = 3};
    import import_value = throw_it(s.module, s.export);
    printf("%d %d\n", import_value, s.type);
    return 0;
}
