# Run-time arrays `[]T` and their slices: every form parses as an ordinary declaration or expression.
import std.mem

pub struct Layer:
    pub weights: []f32
    pub name: []u8

pub fn total(xs: []i32, skip: usize) -> usize:
    let mut sum: usize = 0
    for x in xs[skip:]:
        sum += x.to(usize)
    sum

pub fn middle(xs: []i32, p: *i32, n: usize) -> []i32:
    let head = xs[:2]
    let tail = xs[2:]
    let mid = xs[1:countof(xs) - 1]
    let view = p[0:n]
    let word: []u8 = "abc"
    let inside = if n > 0: true else: false
    if inside: head else: view

# Many dimensions and read-only elements: the same types, with a fixed size after the comma.
pub fn corner(rows: [, 2]f32, grid: [, ]f32, label: []u8) -> f32:
    let first = rows[1:]
    let cell = grid[0][0] + rows[0][1]
    cell + first[0][0] + countof(label).to(f32)
