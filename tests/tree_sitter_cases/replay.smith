# A module with imports, exported types and values, a C header and a conditional declaration.
import c <string.h>
import c <local.h>
import lib.text as tx

pub struct Replay:
    pub frames: u64
    pub name: tx.Text

pub const version: u32 = 3
pub let mut counter: u32 = 7

pub struct Handle:
    pub fd: i32

pub enum Mode:
    fast
    slow

fn helper() -> u32:
    version + counter

pub fn open(handle: *Handle, path: *u8) -> Replay:
    let mut replay = Replay(frames = 0, name = tx.make(path))
    replay.frames = helper().to(u64) + handle.fd.to(u64)
    counter += 1
    replay

pub fn checksum(data: *u8, size: usize) -> u64

pub fn say(text: *u8) -> i32:
    let root = math.sqrtf(81.0)
    stdio.puts(text) + root.to(i32) + stdio.EOF
