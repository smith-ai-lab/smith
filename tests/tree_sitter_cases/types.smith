# Types as ordinary arguments, compile-time `if` on a type, and the sized types.
import std.arena

pub fn push(a: *arena.Arena, T: type) -> *T:
    push_bytes(a, sizeof(T), alignof(T)).cast(*T)

pub fn write_value(w: *Writer, T: type, value: T):
    if T == f32 || T == f64:
        write_float(w, value.to(f64))
    else if sizeof(T) == 8:
        write_u64(w, value.to(u64))
    else:
        write_u32(w, value.to(u32))

fn use(a: *arena.Arena):
    let p = push(a, Point)
    let xs = push_array(a, f32, 1024)
    let small: i16 = 3
    let signed_size: isize = -1
    let half: f16 = 1
