// mem::checked (issue #239, lib/smith/mem.smith): the allocator the test runner sets around every test, which finds a
// leak (naming its allocation site), a double free, a free of a foreign block and a use after free. The runner cases
// use the fixture tests/build_fixtures/runner_checked; the arena cases a C program, tests/mem_checked/main.c.
module mem_checked_test;

import smith::io;
import smith::test;
import runner;
import scratch;

static scratch::Project checked_project(io::Io *io) {
    scratch::Project p = runner::project(io, "runner_base", "runner_checked");
    scratch::Run run = runner::build(&p, "");
    scratch::expect_status("checked: the runner builds", 0, &run);
    return p;
}

export void test_mem_checked_a_leaking_test_fails_naming_its_allocation_site(io::Io *io) {
    scratch::Project p = checked_project(io);
    scratch::Run run = runner::tests(&p, "", "--test checked_2_leaks --trace");
    scratch::expect_status("checked: a leaking test fails the run", 1, &run);
    scratch::expect_contains("checked: ... as a memory leak", run.out, "smith-trace begin memory leaked");
    scratch::expect_contains("checked: ... with the allocation in the test's frame", run.out, "test_checked_2_leaks");
    if (runner::can_symbolize(&p)) {
        const char *report = runner::symbolized(&p, "", "--test checked_2_leaks");
        scratch::expect_contains("checked: the report names the line that allocated", report,
                                 "tests/test_checked.smith:17");
        scratch::expect_contains("checked: ... and the leak", report, "1 blocks (4 bytes) were never freed");
    }
}

export void test_mem_checked_a_test_that_frees_what_it_allocates_passes(io::Io *io) {
    scratch::Project p = checked_project(io);
    scratch::Run run = runner::tests(&p, "", "--test checked_1_clean --verbose");
    scratch::expect_contains("checked: a clean test passes", run.out, "PASS checked_1_clean");
    scratch::Run leaks = runner::tests(&p, "", "--test checked_2_leaks --unchecked");
    scratch::expect_contains("checked: --unchecked lets a leak pass", leaks.out, "1 passed, 0 failed");
}

export void test_mem_checked_a_double_free_is_reported_with_both_sites(io::Io *io) {
    scratch::Project p = checked_project(io);
    scratch::Run run = runner::tests(&p, "", "--test checked_3_double_free --trace");
    scratch::expect_contains("checked: a double free fails the test", run.out, "smith-trace begin memory error");
    scratch::expect_contains("checked: ... saying so", run.out, "a block already freed: a double free");
    scratch::expect_contains("checked: ... with the allocation", run.out, "smith-trace begin allocated here");
    scratch::expect_contains("checked: ... and the first free", run.out, "smith-trace begin first freed here");
}

export void test_mem_checked_a_free_of_a_foreign_block_is_reported(io::Io *io) {
    scratch::Project p = checked_project(io);
    scratch::Run run = runner::tests(&p, "", "--test checked_4_foreign_free --trace");
    scratch::expect_contains("checked: a foreign free fails the test", run.out, "smith-trace begin memory error");
    scratch::expect_contains("checked: ... saying so", run.out, "a block this allocator did not make");
}

export void test_mem_checked_a_use_after_free_and_an_overflow_are_sanitizer_reports(io::Io *io) {
    scratch::Project p = checked_project(io);
    scratch::Run after = runner::tests(&p, "", "--test checked_5_use_after_free");
    scratch::expect_contains("checked: a write after free is a use-after-poison", after.out, "use-after-poison");
    scratch::Run past = runner::tests(&p, "", "--test checked_6_overflow");
    scratch::expect_contains("checked: a write past a block is ASan's own heap-buffer-overflow", past.out,
                             "heap-buffer-overflow");
}

static scratch::Project arena_project(io::Io *io) {
    scratch::Project p = scratch::project(io, "arena_reset", nullptr);
    scratch::copy_tree(&p, "tests/mem_checked/main.c", "main.c");
    scratch::Run built = scratch::sh(&p, "smith build >build.log 2>&1");
    scratch::expect_status("checked: the arena program builds", 0, &built);
    return p;
}

export void test_mem_checked_an_arena_used_after_reset_is_an_asan_report(io::Io *io) {
    scratch::Project p = arena_project(io);
    scratch::Run run = scratch::sh(&p, "./build/debug/arena_reset 2>&1");
    scratch::expect_contains("checked: debug: a read after an arena reset is use-after-poison", run.out,
                             "use-after-poison");
}

export void test_mem_checked_outside_a_test_a_double_free_aborts_with_its_report_and_a_leak_is_listed(io::Io *io) {
    scratch::Project p = arena_project(io);
    scratch::Run twice = scratch::sh(&p, "./build/debug/arena_reset double 2>&1");
    scratch::expect_contains("checked: a double free outside a test is reported", twice.out, "a double free");
    scratch::expect_contains("checked: ... with the allocation site", twice.out, "smith-trace begin allocated here");
    scratch::Run leak = scratch::sh(&p, "./build/debug/arena_reset leak 2>&1");
    scratch::expect_contains("checked: a leak is listed", leak.out, "smith-trace begin memory leaked");
    scratch::expect_contains("checked: ... and counted", leak.out, "live: 1");
}
