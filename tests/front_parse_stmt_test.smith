// Tests of front::parse_stmt (#1146, A4 of track A of #1112): statements read through stubs for the expression and
// declaration hooks, with golden dumps in tests/front/parse_stmt (`smith test --update` writes a changed one). The stub
// expression is the tokens up to the end of the expression (a `;`, `)`, `,` or `:` outside brackets) as one name, and
// the stub declaration is the tokens up to its `;` as a variable, so a dump shows what the statement parser decided.
module front_parse_stmt_test;

import front::ast;
import front::lex;
import front::parse;
import front::fix;
import front::parse_decl;
import front::parse_expr;
import front::parse_stmt;
import front::parse_type;
import std::arena;
import std::format;
import std::mem;
import std::test;

static Bool ends_expression(lex::TokenKind kind) {
    return kind == lex::semicolon || kind == lex::right_paren || kind == lex::comma || kind == lex::colon ||
           kind == lex::right_brace || kind == lex::kw_else || kind == lex::end_of_file;
}

static Bool opens(lex::TokenKind kind) {
    return kind == lex::left_paren || kind == lex::left_bracket || kind == lex::left_brace;
}

static Bool closes(lex::TokenKind kind) {
    return kind == lex::right_paren || kind == lex::right_bracket || kind == lex::right_brace;
}

// The tokens of an expression as one name; an error and null when there are none.
static ast::Expr *stub_expression(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    Usize depth = 0;
    while (depth > 0 || !ends_expression(parse::peek(p).kind)) {
        lex::TokenKind kind = parse::peek(p).kind;
        if (kind == lex::end_of_file) break;
        // A `{` after a name starts a block, never part of the expression (the new `if c {`).
        if (depth == 0 && kind == lex::left_brace && p->position > 0 &&
            (p->tokens[p->position - 1].kind == lex::name || p->tokens[p->position - 1].kind == lex::kw_in))
            break;
        if (opens(kind)) depth += 1;
        if (closes(kind) && depth > 0) depth -= 1;
        parse::advance(p);
        // A line break ends the expression (Go's rule), as the real expression parser would.
        if (depth == 0 && lex::ends_statement(p->tokens[p->position - 1])) break;
    }
    if (p->position == 0 || parse::span_from(p, start).end == start) {
        parse::expect(p, lex::name, "an expression");
        return nullptr;
    }
    return ast::name(p->source[start:parse::span_from(p, start).end]);
}

// A declaration up to its `;`: the name is the last token before `=` or `;`, the text before it is the type, and the
// text after `=` is the initializer. The `;` is taken.
static ast::Decl *stub_declaration(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    U32 name_start = start;
    U32 name_end = start;
    ast::Expr *init = nullptr;
    Usize depth = 0;
    while (!parse::at(p, lex::end_of_file)) {
        lex::Token token = parse::peek(p);
        if (depth == 0 && token.kind == lex::semicolon) break;
        if (depth == 0 && token.kind == lex::equal) {
            parse::advance(p);
            init = stub_expression(p);
            break;
        }
        if (opens(token.kind)) depth += 1;
        if (closes(token.kind) && depth > 0) depth -= 1;
        if (token.kind == lex::name) {
            name_start = token.span.start;
            name_end = token.span.end;
        }
        parse::advance(p);
    }
    parse::expect(p, lex::semicolon, "`;`");
    Str type_text = p->source[start:name_start];
    while (countof(type_text) > 0 && type_text[countof(type_text) - 1] == ' ')
        type_text = type_text[0:countof(type_text) - 1];
    return ast::variable(p->source[name_start:name_end], ast::named(type_text), init);
}

static parse::Parser parser_in(Str source, Bool new_syntax) {
    lex::Lexed lexed = lex::tokenize(source);
    if (new_syntax) lexed = lex::tokenize_new(source);
    lex::Tokens tokens = {};
    switch (lexed) {
    case .ok:
        tokens = lexed.ok;
        break;
    case .error:
        Str expected = "no error";
        test::check_equal(lexed.error.message, expected);
    }
    parse::Parser p = parse::make(tokens, source);
    p.hooks.expression = stub_expression;
    p.hooks.declaration = stub_declaration;
    p.hooks.statement = parse_stmt::statement;
    return p;
}

static parse::Parser parser_of(Str source) {
    return parser_in(source, false);
}

// The statement of source (a block, usually) as the body of a function of a module, dumped.
static Str dump_of(parse::Parser *p) {
    ast::Stmt *body = parse::statement(p);
    ast::Param no_params[:] = {};
    ast::DeclRef decls[1] = {ast::function("f", no_params, ast::named("Void"), body)};
    ast::Module m = ast::new_module("m", decls);
    return ast::dump(&m);
}

// The dump of a source that parses with no error and to its end.
static Str clean_dump_in(Str source, Bool new_syntax) {
    parse::Parser p = parser_in(source, new_syntax);
    Str dump = dump_of(&p);
    test::check_equal(countof(p.errors), 0);
    test::check_equal(parse::at(&p, lex::end_of_file), true);
    return dump;
}

static Str clean_dump(Str source) {
    return clean_dump_in(source, false);
}

export void test_parse_stmt_every_form() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source =
        "{ ; x; return; return 1; goto done; done: x; defer f(x); static_assert(x, \"why\"); static_assert(y); "
        "break; continue; while (x) y; do y; while (x); for (I32 i = 0; i; i) z; for (;;) ; for (x; y; z) { } "
        "for constexpr (I32 i = 0; i; i) z; if (x) y; else z; if constexpr (x) y; }";
    test::golden("tests/front/parse_stmt/forms.txt", clean_dump(source));
}

export void test_parse_stmt_switch_with_grouped_labels() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "{ switch (v) { case 1: case 2: a; b; case .circle: return 1; case .square: default: if (x) { y; } "
                 "} switch (w) { } }";
    test::golden("tests/front/parse_stmt/switch.txt", clean_dump(source));
}

export void test_parse_stmt_nested_blocks_and_dangling_else() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "{ { { a; } b; } if (p) if (q) x; else y; if (p) { if (q) x; } else y; "
                 "if (p) x; else if (q) y; else z; l: while (c) for (;;) defer w; }";
    test::golden("tests/front/parse_stmt/nesting.txt", clean_dump(source));
}

export void test_parse_stmt_a_very_deep_nesting_does_not_use_the_call_stack() {
    arena::Arena memory = test::memory(1U << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Usize depth = 20000;
    char text[:] = mem::alloc_slice(char, 2 * depth + 2);
    for (Usize i = 0; i < depth; i++) {
        text[i] = '{';
        text[depth + i] = '}';
    }
    text[2 * depth] = ';';
    parse::Parser p = parser_of(text[0:2 * depth]);
    ast::Stmt *whole = parse::statement(&p);
    test::check_equal(countof(p.errors), 0);
    test::check_equal(whole != nullptr, true);
    test::check_equal(whole->kind == .block, true);
    test::check_equal(parse::at(&p, lex::end_of_file), true);
}

export void test_parse_stmt_declaration_or_expression() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "{ Point p; geometry::Box b = x; Option(I32) o; x * y; f(x); const I32 n = 1; static auto z = 2; "
                 "struct Pair q; int k; [[maybe_unused]] I32 u; c::size_t len; c::stat *info; c::printf(x); "
                 "c::EOF; geometry::area(b); x = y; }";
    test::golden("tests/front/parse_stmt/declaration_or_expression.txt", clean_dump(source));
}

export void test_parse_stmt_recovery_two_broken_statements_give_two_errors() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "{ a; break 1; b; if x) y; goto ; c; }";
    parse::Parser p = parser_of(source);
    Str dump = dump_of(&p);
    test::check_equal(countof(p.errors), 3);
    test::check_equal(parse::at(&p, lex::end_of_file), true);
    test::golden("tests/front/parse_stmt/recovery.txt", dump);
    char messages[:] = format::push(p.errors[0].message, "\n", p.errors[1].message, "\n", p.errors[2].message, "\n");
    test::golden("tests/front/parse_stmt/recovery_errors.txt", messages);
}

export void test_parse_stmt_a_missing_close_brace_is_one_error() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parse::Parser p = parser_of("{ a; if (x) { b; ");
    ast::Stmt *whole = parse::statement(&p);
    test::check_equal(whole != nullptr, true);
    test::check_equal(countof(p.errors) >= 1, true);
    test::check_equal(parse::at(&p, lex::end_of_file), true);
}

export void test_parse_stmt_a_long_block_is_read_in_linear_time() {
    arena::Arena memory = test::memory(1U << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Usize count = 20000;
    char text[:] = mem::alloc_slice(char, 2 * count + 2);
    text[0] = '{';
    for (Usize i = 0; i < count; i++) {
        text[1 + 2 * i] = 'x';
        text[2 + 2 * i] = ';';
    }
    text[2 * count + 1] = '}';
    parse::Parser p = parser_of(text);
    ast::Stmt *whole = parse::statement(&p);
    test::check_equal(countof(p.errors), 0);
    if (whole->kind == .block) test::check_equal(countof(whole->kind.block.items), count);
    test::check_equal(whole->kind == .block, true);
}

export void test_parse_stmt_the_new_forms() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "{\n"
                 "if a {\n x\n }\n"
                 "if a {\n x\n } else if b {\n y\n } else {\n z\n }\n"
                 "while a {\n x\n break\n continue\n }\n"
                 "for x in xs {\n f\n }\n"
                 "for (i, x) in es {\n f\n }\n"
                 "match s {\n .a => v\n .b(x) => w\n .c, .d => u\n }\n"
                 "if let .some(x) = e {\n x\n } else {\n y\n }\n"
                 "if let .none = e {\n x\n }\n"
                 "defer f\n"
                 "if (a) < b {\n x\n }\n"
                 "return\n"
                 "}";
    test::golden("tests/front/parse_stmt/new_forms.txt", clean_dump_in(source, true));
}

export void test_parse_stmt_old_and_new_forms_mix() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "{\nif (a) {\n x\n }\nif (a) y;\nwhile (a) {\n x\n }\nfor (I32 i = 0; i; i) z;\n"
                 "if a {\n if (b) c; else d;\n }\nreturn 1\n}";
    test::golden("tests/front/parse_stmt/new_and_old.txt", clean_dump_in(source, true));
}

// One error for each malformed new form, and the statement after it parses.
static Str first_error(Str source) {
    parse::Parser p = parser_in(source, true);
    ast::Stmt *whole = parse::statement(&p);
    test::check_equal(whole != nullptr, true);
    char all[:] = {};
    for (Usize i = 0; i < countof(p.errors); i++)
        all = format::push(all, p.errors[i].message, " | ");
    return all;
}

static Str malformed(Usize which) {
    switch (which) {
    case 0:
        return "{\nif a {\n x\n } else y\n}";
    case 1:
        return "{\nfor x in {\n f\n }\n}";
    case 2:
        return "{\nfor (i, ) in xs {\n f\n }\n}";
    case 3:
        return "{\nfor x in xs\n}";
    case 4:
        return "{\nmatch s {\n a => v\n }\n}";
    case 5:
        return "{\nmatch s {\n .a v\n }\n}";
    case 6:
        return "{\nmatch s {\n .a => v\n .b\n }\n}";
    case 7:
        return "{\nif let .a x = e {\n x\n }\n}";
    case 8:
        return "{\nif let .a() = e {\n x\n }\n}";
    case 9:
        return "{\nreturn 1 )\n}";
    case 10:
        return "{\nyield\n}";
    default:
        return "";
    }
}

export void test_parse_stmt_a_malformed_new_form_is_one_error() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    char all[:] = {};
    for (Usize i = 0; i < 11; i++) {
        all = format::push(all, first_error(malformed(i)), "\n");
    }
    test::golden("tests/front/parse_stmt/new_forms_errors.txt", all);
}

export void test_parse_stmt_yield_in_smith_syntax() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "{\nwhile n {\n yield n\n if n {\n yield n + 1\n }\n }\nyield 2; return\n}";
    test::golden("tests/front/parse_stmt/new_yield.txt", clean_dump_in(source, true));
}

// Bindings in smith's own syntax inside a body: the declaration parser's binding parser reads them, `is_new` set.
export void test_parse_stmt_bindings_in_smith_syntax() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "{\na := 3\nb: i32 = 4\nmut c := 0\nmut d: i32 = 1\n_ := f()\n(q, r) := g()\nmut (s, t) := h()\nx\n}";
    parse::Parser p = parser_in(source, true);
    p.hooks.declaration = parse_decl::declaration;
    p.hooks.type = parse_type::type;
    p.new_syntax = true;
    Str dump = dump_of(&p);
    test::check_equal(countof(p.errors), 0);
    test::check_equal(parse::at(&p, lex::end_of_file), true);
    test::golden("tests/front/parse_stmt/new_bindings.txt", dump);
}

// ---- the old forms (#1508, F3 of #1428): each parses to the node of its new form, records a warning with a fix, and
// `smith lint --fix` writes the new form. The real expression, type and declaration parsers read these.

static parse::Parser real_parser(Str source) {
    parse::Parser p = parser_in(source, true);
    p.hooks.expression = parse_expr::expression;
    p.hooks.type = parse_type::type;
    p.hooks.declaration = parse_decl::declaration;
    p.new_syntax = true;
    return p;
}

// What the file has after fixes, the pass at a time until none applies (as fix::fix_text does), with the warnings of
// the first pass and the warnings left at the end.
static Str fixed_dump(Str source) {
    parse::Parser first = real_parser(source);
    parse::statement(&first);
    test::check_equal(countof(first.errors), 0);
    char out[:] = {};
    for (Usize i = 0; i < countof(first.warnings); i++) {
        parse::Edits edits = first.warnings[i].fix;
        Str kind = "fix";
        if (countof(edits) == 0) kind = "no fix";
        Str message = first.warnings[i].message;
        out = format::push(out, "warning (", kind, "): ", message, "\n");
    }
    Str text = source;
    Usize applied = 1;
    for (Usize pass = 0; pass < 8 && applied > 0; pass++) {
        parse::Parser p = real_parser(text);
        parse::statement(&p);
        fix::Fixed fixed = fix::apply_fixes(text, p.errors, p.warnings);
        applied = fixed.applied;
        text = fixed.text;
    }
    parse::Parser last = real_parser(text);
    parse::statement(&last);
    test::check_equal(countof(last.errors), 0);
    Usize left = 0;
    for (Usize i = 0; i < countof(last.warnings); i++) {
        parse::Edits edits = last.warnings[i].fix;
        if (countof(edits) > 0) left += 1;
    }
    test::check_equal(left, 0);
    char whole[:] = format::push(out, "---\n", text, "\n");
    return whole;
}

// ---- trailing blocks (#961): `f(x) { ... }` passes the block as the last argument.

export void test_parse_stmt_trailing_blocks() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "{\n"
                 "f(x) { a }\n"
                 "f() { a }\n"
                 "if ready() {\n a\n }\n"
                 "while ready() {\n a\n }\n"
                 "for x in items() {\n a\n }\n"
                 "match pick() {\n .a => b\n }\n"
                 "if (any(xs) { a }) {\n b\n }\n"
                 "g(y)\n{\n a\n }\n"
                 "}";
    parse::Parser p = real_parser(source);
    Str dump = dump_of(&p);
    test::check_equal(countof(p.errors), 0);
    test::check_equal(parse::at(&p, lex::end_of_file), true);
    test::golden("tests/front/parse_stmt/trailing_blocks.txt", dump);
}

export void test_parse_stmt_capture_list_is_a_warning_with_a_fix() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    test::golden("tests/front/parse_stmt/trailing_captures.txt", fixed_dump("{\nf(fn[a, b](x) { x })\n}"));
}

static Str old_name(Usize which) {
    switch (which) {
    case 0:
        return "semicolons";
    case 1:
        return "if";
    case 2:
        return "else";
    case 3:
        return "while";
    case 4:
        return "constexpr_and_nesting";
    case 5:
        return "for";
    case 6:
        return "switch_and_goto";
    case 7:
        return "switch_match";
    default:
        return "switch_no_match";
    }
}

static Str old_source(Usize which) {
    switch (which) {
    case 0:
        return "{\nx = 1;\nreturn;\n}";
    case 1:
        return "{\nif (a > 0) x = 1;\nif (a) { x = 2; }\nif (a)\n    x = 3;\nelse\n    x = 4;\n}";
    case 2:
        return "{\nif (a) {\n x = 1\n}\nelse if (b) {\n x = 2\n}\nelse {\n x = 3\n}\n}";
    case 3:
        return "{\nwhile (a > 0) a = a - 1;\nwhile (b) {\n b = 0\n}\n}";
    case 4:
        return "{\nif constexpr (a) x = 1;\nif (a) if (b) x = 2;\n}";
    case 5:
        return "{\nfor (I32 i = 0; i < n; i++) x = i;\nfor (I32 i = 1; i <= n; i += 1) {\n x = i\n}\n"
               "for constexpr (I32 i = 0; i < 4; ++i) x = i;\nfor (U8 c : cs) x = c;\nfor (;;) break;\n}";
    case 6:
        return "{\nswitch (v) {\ncase 1:\n x = 1;\n break;\n}\ngoto done;\n}";
    case 7:
        return "{\nswitch (v) {\n case .a:\n  x = f(1);\n  break;\n case .b:\n case .c:\n  y = g(2);\n  break;\n}\n}";
    case 8:
        return "{\nswitch (v) {\ncase .a:\n x = 1;\n break;\ndefault:\n x = 2;\n break;\n}\n"
               "switch (w) {\ncase .a:\n return 1;\n}\nswitch (u) {\ncase 1:\n x = 1;\n break;\n}\n}";
    default:
        return "";
    }
}

export void test_parse_stmt_old_forms_have_warnings_with_fixes() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    for (Usize i = 0; i < 9; i++) {
        Str name = old_name(i);
        char path[:] = format::push("tests/front/parse_stmt/old_", name, ".txt");
        Str source = old_source(i);
        char golden[:] = format::push(source, "\n===\n", fixed_dump(source));
        test::golden(path, golden);
    }
}

// Habits from other languages at the start of a statement are warnings that name the smith form (#1428, Adoption).
static Str habit_source(Usize which) {
    if (which == 0) return "{\nimpl Shape {\n}\n}";
    if (which == 1) return "{\n&mut x\n}";
    return "{\n? x\n}";
}

static Str habit_message(Usize which) {
    if (which == 0) return "smith has no `impl`: write a function that takes the value, `fn area(s: Shape)`";
    if (which == 1) return "smith has no `&mut`: write `&x`, which is a `*mut T` when `x` is `mut`";
    return "smith has no `?` operator: write `try f()` to return the error of a `Result`";
}

export void test_parse_stmt_habits_from_other_languages_warn() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    for (Usize i = 0; i < 3; i++) {
        parse::Parser p = real_parser(habit_source(i));
        parse::statement(&p);
        Bool found = false;
        for (Usize j = 0; j < countof(p.warnings); j++) {
            if (mem::equal(p.warnings[j].message, habit_message(i))) found = true;
        }
        test::check_equal(found, true);
    }
}

// ---- blocks are `:` and indentation (#1856): the tokens go through lex::layout and the parser has `layout` set. The
// source starts with the `:` of the function that owns the body, which is taken here.

static parse::Parser layout_parser(Str source) {
    lex::Lexed lexed = lex::tokenize_new(source);
    lex::Tokens tokens = {};
    switch (lexed) {
    case .ok:
        tokens = lexed.ok;
        break;
    case .error:
        Str expected = "no error";
        test::check_equal(lexed.error.message, expected);
    }
    lex::Lexed laid = lex::layout(source, tokens);
    switch (laid) {
    case .ok:
        tokens = laid.ok;
        break;
    case .error:
        Str expected = "no error";
        test::check_equal(laid.error.message, expected);
    }
    parse::Parser p = parse::make(tokens, source);
    p.hooks.expression = stub_expression;
    p.hooks.declaration = stub_declaration;
    p.hooks.statement = parse_stmt::statement;
    p.new_syntax = true;
    p.layout = true;
    parse::accept(&p, lex::colon);
    return p;
}

export void test_parse_stmt_layout_blocks() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = ":\n"
                 "    if a:\n        x\n"
                 "    if a:\n        x\n    else if b:\n        y\n    else:\n        z\n"
                 "    if a: x else: y\n"
                 "    while a:\n        x\n        break\n        continue\n"
                 "    for x in xs:\n        f\n"
                 "    for (i, x) in es:\n        f\n"
                 "    match s:\n        .a: v\n        .b(x): w\n        .c, .d: u\n"
                 "    if let .some(x) = e:\n        x\n    else:\n        y\n"
                 "    if let .none = e:\n        x\n"
                 "    defer f\n"
                 "    defer:\n        g\n        h\n"
                 "    while n:\n        if n:\n            while m:\n                x\n        y\n"
                 "    return\n";
    parse::Parser p = layout_parser(source);
    Str dump = dump_of(&p);
    char problems[:] = {};
    for (Usize i = 0; i < countof(p.errors); i++)
        problems = format::push(problems, p.errors[i].message, " | ");
    char shown[:] = format::push(problems, "\n", dump);
    test::golden("tests/front/parse_stmt/layout_forms.txt", shown);
    test::check_equal(countof(p.errors), 0);
    test::check_equal(parse::at(&p, lex::end_of_file), true);
}

static Str layout_errors(Str source) {
    parse::Parser p = layout_parser(source);
    ast::Stmt *whole = parse::statement(&p);
    test::check_equal(whole != nullptr, true);
    char all[:] = {};
    for (Usize i = 0; i < countof(p.errors); i++)
        all = format::push(all, p.errors[i].message, " | ");
    return all;
}

static Str malformed_layout(Usize which) {
    switch (which) {
    case 0:
        return ":\n    if a x\n    y\n";
    case 1:
        return ":\n    if a:\n    y\n";
    case 2:
        return ":\n    if a:\n        x\n    else y\n";
    case 3:
        return ":\n    for x in:\n        f\n";
    case 4:
        return ":\n    match s:\n        a: v\n    z\n";
    case 5:
        return ":\n    match s:\n        .a v\n    z\n";
    case 6:
        return ":\n    if let .a x = e:\n        x\n    y\n";
    default:
        return "";
    }
}

export void test_parse_stmt_layout_malformed_forms_are_one_error() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    char all[:] = {};
    for (Usize i = 0; i < 7; i++) {
        all = format::push(all, layout_errors(malformed_layout(i)), "\n");
    }
    test::golden("tests/front/parse_stmt/layout_errors.txt", all);
}
