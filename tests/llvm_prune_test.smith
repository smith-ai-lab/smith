// The cleaning after `smith build llvm` (issue #618, scripts/llvm_prune.c): every LLVM folder of the cache goes, with
// its Enzyme, but the one just built and the previous release's. The whole tree is in the test's scratch folder; the
// real
// ~/.cache/smith/llvm is never read.
module llvm_prune_test;

import smith::io;
import smith::test;
import scratch;

constexpr char make_tree[_] =
    "mkdir -p c/smith/llvm c/smith/enzyme; for n in r8:none r9:bbb r10:aaa r11:ccc; do d=c/smith/llvm/23.1.3-${n%:*}; "
    "mkdir -p $d/install/lib $d/build; [ ${n#*:} = none ] || echo \"llvm-23.1.3 ${n#*:}\" "
    ">$d/install/lib/smith-clang.id; "
    "echo x >$d/build/big; mkdir -p c/smith/enzyme/0.0.303-23.1.3-${n%:*}/lib; done; "
    "smith cc -std=c23 \"$SMITH_REPO/scripts/llvm_prune.c\" -o prune && echo made";

export void test_llvm_prune_keeps_the_new_build_and_the_previous_releases_and_removes_the_rest(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::own_cache(&p);
    scratch::Run made = scratch::sh(&p, make_tree);
    scratch::expect_text("prune: the tree and the tool are made", "made", made.out);
    scratch::Run pruned = scratch::sh(&p, "./prune $PWD/c/smith/llvm 23.1.3-r11 'llvm-23.1.3 aaa'");
    scratch::expect_status("prune: the tool runs", 0, &pruned);
    scratch::expect_contains("prune: it says what it removed", pruned.out, "23.1.3-r9");
    scratch::expect_text("prune: the new build, the previous release's and one with no id (in progress) stay",
                         "23.1.3-r10 23.1.3-r11 23.1.3-r8",
                         scratch::capture(&p, "ls c/smith/llvm | tr '\\n' ' ' | sed 's/ $//'"));
    scratch::expect_text("prune: Enzyme of a removed build goes, the others stay",
                         "0.0.303-23.1.3-r10 0.0.303-23.1.3-r11 0.0.303-23.1.3-r8",
                         scratch::capture(&p, "ls c/smith/enzyme | tr '\\n' ' ' | sed 's/ $//'"));
}

export void test_llvm_prune_without_a_previous_identity_keeps_only_the_new_build(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::own_cache(&p);
    scratch::Run made = scratch::sh(&p, make_tree);
    scratch::expect_text("prune: the tree and the tool are made", "made", made.out);
    scratch::Run pruned = scratch::sh(&p, "./prune $PWD/c/smith/llvm 23.1.3-r11 ''");
    scratch::expect_status("prune: the tool runs", 0, &pruned);
    scratch::expect_text("prune: the new build and the one with no id stay", "23.1.3-r11 23.1.3-r8",
                         scratch::capture(&p, "ls c/smith/llvm | tr '\\n' ' ' | sed 's/ $//'"));
}
