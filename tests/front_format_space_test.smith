// Tests of front::format_space (#1888, part of #1886): the space between two tokens. The table cases check single
// pairs; the line cases lex a line already written in the style of the syntax tour, join its tokens with
// `space_between` (the way the formatter's driver does) and expect the same line back, and a line with every space
// squeezed out or doubled must come back the same.
module front_format_space_test;

import front::format_space;
import front::lex;
import std::arena;
import std::format;
import std::mem;
import std::test;

static void expect_space(lex::TokenKind prev, lex::TokenKind next, Bool expected) {
    format_space::SpaceContext context = {};
    test::check_equal(format_space::space_between(prev, next, context), expected);
}

export void test_format_space_pairs() {
    expect_space(lex::name, lex::name, true);
    expect_space(lex::name, lex::left_paren, false);
    expect_space(lex::kw_if, lex::left_paren, true);
    expect_space(lex::kw_fn, lex::left_paren, false);
    expect_space(lex::kw_countof, lex::left_paren, false);
    expect_space(lex::right_paren, lex::left_paren, false);
    expect_space(lex::name, lex::left_bracket, false);
    expect_space(lex::equal, lex::left_bracket, true);
    expect_space(lex::right_bracket, lex::type_name, false);
    expect_space(lex::right_bracket, lex::kw_mut, false);
    expect_space(lex::right_bracket, lex::plus, true);
    expect_space(lex::name, lex::comma, false);
    expect_space(lex::comma, lex::name, true);
    expect_space(lex::name, lex::colon, false);
    expect_space(lex::colon, lex::name, true);
    expect_space(lex::name, lex::dot, false);
    expect_space(lex::dot, lex::name, false);
    expect_space(lex::equal, lex::dot, true);
    expect_space(lex::left_paren, lex::dot, false);
    expect_space(lex::name, lex::dot_star, false);
    expect_space(lex::dot_star, lex::plus, true);
    expect_space(lex::name, lex::ellipsis, false);
    expect_space(lex::name, lex::arrow, true);
    expect_space(lex::arrow, lex::type_name, true);
    expect_space(lex::at, lex::name, false);
    expect_space(lex::question, lex::star, false);
    expect_space(lex::left_brace, lex::right_brace, false);
    expect_space(lex::left_brace, lex::name, true);
    expect_space(lex::name, lex::right_brace, true);
    expect_space(lex::name, lex::newline, false);
    expect_space(lex::indent, lex::name, false);
    expect_space(lex::name, lex::end_of_file, false);
}

export void test_format_space_context() {
    format_space::SpaceContext prefix = {.prev_unary = true};
    format_space::SpaceContext binary = {};
    format_space::SpaceContext slice = {.in_brackets = true};
    test::check_equal(format_space::space_between(lex::minus, lex::name, prefix), false);
    test::check_equal(format_space::space_between(lex::minus, lex::name, binary), true);
    test::check_equal(format_space::space_between(lex::star, lex::kw_mut, prefix), false);
    test::check_equal(format_space::space_between(lex::colon, lex::name, slice), false);
    test::check_equal(format_space::space_between(lex::colon, lex::name, binary), true);
}

export void test_format_space_operand_tables() {
    test::check_equal(format_space::ends_operand(lex::name), true);
    test::check_equal(format_space::ends_operand(lex::right_paren), true);
    test::check_equal(format_space::ends_operand(lex::plus), false);
    test::check_equal(format_space::ends_operand(lex::kw_return), false);
    test::check_equal(format_space::operand_expected(lex::newline), true);
    test::check_equal(format_space::operand_expected(lex::left_paren), true);
    test::check_equal(format_space::operand_expected(lex::integer), false);
    test::check_equal(format_space::is_spaced_operator(lex::plus_equal), true);
    test::check_equal(format_space::is_spaced_operator(lex::minus), false);
    test::check_equal(format_space::is_spaced_operator(lex::comma), false);
}

// The tokens of source joined by the rule, the way a driver walks a line. A lexing error is the result.
static Str joined(Str source) {
    lex::Lexed lexed = lex::tokenize_new(source);
    if (lexed == .error) return lexed.error.message;
    char shown[:] = format::push("");
    lex::TokenKind before = lex::newline;
    lex::TokenKind prev = lex::newline;
    Bool open_bracket[32] = {};
    Usize depth = 0;
    Bool prev_unary = false;
    for (lex::Token token : lexed.ok) {
        if (token.kind == lex::end_of_file) break;
        format_space::SpaceContext context = {.prev_unary = prev_unary,
                                              .in_brackets = depth > 0 && open_bracket[depth - 1]};
        if (prev != lex::newline && format_space::space_between(prev, token.kind, context)) {
            shown = format::push(shown, " ");
        }
        shown = format::push(shown, lex::text(source, token));
        if (token.kind == lex::left_bracket || token.kind == lex::left_paren) {
            // The `[` of `fn sum[T: num]` holds parameters, not an index: its `:` is a block head's.
            if (depth < 32) open_bracket[depth] = token.kind == lex::left_bracket && before != lex::kw_fn;
            depth += 1;
        } else if ((token.kind == lex::right_bracket || token.kind == lex::right_paren) && depth > 0) {
            depth -= 1;
        }
        prev_unary = format_space::operand_expected(prev);
        before = prev;
        prev = token.kind;
    }
    Str result = shown[0:countof(shown)];
    return result;
}

static void expect_line(Str line) {
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    test::check_equal(joined(line), line);
}

export void test_format_space_lines_keep_the_style_of_the_tour() {
    expect_line("let total = sum(for s in shapes.items(): s.area())");
    expect_line("shapes.push(.circle(Circle(radius = 2)))");
    expect_line("fn area(s: Shape) -> f64:");
    expect_line("pub fn main() -> i32:");
    expect_line("let mut shapes = list.init(Shape)");
    expect_line("x = a + b * -c");
    expect_line("let p = &x");
    expect_line("let y = p.* + 1");
    expect_line("return -1");
    expect_line("fn sum[T: num](xs: []T) -> T:");
    expect_line("let r = sum[f64](xs[1:n])");
    expect_line("let all = xs[:]");
    expect_line("let grid: [5, 3]u8 = undefined");
    expect_line("let table: [3][4]u8 = undefined");
    expect_line("fn view(xs: []mut u8, p: *mut T, q: ?*T) -> ?T:");
    expect_line("f(x; opts...)");
    expect_line("let n = countof(xs) + sizeof(T)");
    expect_line("let f = fn(x): x * 2");
    expect_line("x += 1");
    expect_line("a := b");
    expect_line("@inline");
    expect_line("@c_name(\"x\")");
    expect_line("if x == .red: y");
    expect_line("while !done: step()");
}

// A line with its spaces taken out or doubled comes back in the style (words stay apart where they must).
static void expect_normal(Str crooked, Str expected) {
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    test::check_equal(joined(crooked), expected);
}

export void test_format_space_crooked_lines_are_normalized() {
    expect_normal("x=a+b", "x = a + b");
    expect_normal("f( a ,b )", "f(a, b)");
    expect_normal("xs [ 0 ]", "xs[0]");
    expect_normal("let   y  =  - x", "let y = -x");
    expect_normal("a . b . c", "a.b.c");
    expect_normal("fn (x ) : x", "fn(x): x");
    expect_normal("if(x) : y", "if (x): y");
}
