// Tests of the last step of `smith lint --fix`, braces written as `:` and indentation (#2014, part of #1845).
module front_fix_blocks_test;

import front::fix_blocks;
import std::test;

static void check(Str before, Str want) {
    test::check_equal(fix_blocks::convert(before), want);
}

export void test_front_fix_blocks_a_function_body() {
    check("fn f() -> i32 {\n    return 1\n}\n", "fn f() -> i32:\n    return 1\n");
}

export void test_front_fix_blocks_else_if_and_else() {
    check("fn f(a: i32) {\n    if a > 1 {\n        g()\n    } else if a > 0 {\n        h()\n    } else {\n        "
          "k()\n    }\n}\n",
          "fn f(a: i32):\n    if a > 1:\n        g()\n    else if a > 0:\n        h()\n    else:\n        k()\n");
}

export void test_front_fix_blocks_a_one_line_body_moves_down() {
    check("fn make() -> Node { return Node() }\n", "fn make() -> Node:\n    return Node()\n");
    check("fn f(a: i32) {\n    if a { g() } else { h() }\n}\n",
          "fn f(a: i32):\n    if a:\n        g()\n    else:\n        h()\n");
}

export void test_front_fix_blocks_one_field_to_a_line() {
    check("struct Node { a: i32, b: i32 }\n", "struct Node:\n    a: i32\n    b: i32\n");
}

export void test_front_fix_blocks_an_empty_body() {
    check("fn f() {\n}\n", "fn f():\n");
    check("fn f() {}\n", "fn f():\n");
}

export void test_front_fix_blocks_a_lambda_in_a_call_stays_on_its_line() {
    check("fn f() {\n    run(fn(a: i32) { work(a) })\n}\n", "fn f():\n    run(fn(a: i32): work(a))\n");
    check("fn f() {\n    run(fn(a: i32) -> i32 { return a })\n}\n", "fn f():\n    run(fn(a: i32) -> i32: a)\n");
}

export void test_front_fix_blocks_a_list_is_not_a_block() {
    check("fn f() {\n    let a = [1, 2]\n    g({1, 2})\n}\n", "fn f():\n    let a = [1, 2]\n    g({1, 2})\n");
}

export void test_front_fix_blocks_a_text_with_no_braces_is_the_same() {
    check("fn f() -> i32:\n    return 1\n", "fn f() -> i32:\n    return 1\n");
}

export void test_front_fix_blocks_a_closing_brace_after_the_last_statement() {
    check("fn f(e: *E) {\n    for i in range(0, e.n) {\n        free(e.items[i]) }\n    free(e)\n}\n",
          "fn f(e: *E):\n    for i in range(0, e.n):\n        free(e.items[i])\n    free(e)\n");
}

export void test_front_fix_blocks_a_c_signature_is_left_whole() {
    check("pub usize count(auto x) {\n    if x { return 1 }\n    return 0\n}\n",
          "pub usize count(auto x) {\n    if x { return 1 }\n    return 0\n}\n");
}

export void test_front_fix_blocks_a_c_for_with_an_unbraced_body() {
    check("fn f(uri: str) {\n    let mut same: bool = true\n    for (usize k = 0; same && k < n; k++)\n        same = "
          "a[k] == uri[k]\n    done()\n}\n",
          "fn f(uri: str):\n    let mut same: bool = true\n    let mut k: usize = 0\n    while same && k < n:\n        "
          "same = a[k] == uri[k]\n        k += 1\n    done()\n");
}

export void test_front_fix_blocks_a_c_for_with_a_braced_body() {
    check("fn f(xs: []i32) {\n    for (usize i = countof(xs); i > 0; i--) {\n        use(xs[i - 1])\n    }\n}\n",
          "fn f(xs: []i32):\n    let mut i: usize = countof(xs)\n    while i > 0:\n        use(xs[i - 1])\n        i "
          "-= 1\n");
    check("fn f() {\n    for (usize i = 9; i > 0; i--) {\n        a()\n        b() }\n}\n",
          "fn f():\n    let mut i: usize = 9\n    while i > 0:\n        a()\n        b()\n        i -= 1\n");
}

export void test_front_fix_blocks_a_second_loop_with_the_same_counter_assigns() {
    check("fn f() {\n    for (usize i = 9; i > 0; i--) {\n        a()\n    }\n    for (usize i = 7; i > 0; i--) {\n    "
          "    b()\n    }\n}\n",
          "fn f():\n    let mut i: usize = 9\n    while i > 0:\n        a()\n        i -= 1\n    i = 7\n    while i > "
          "0:\n        b()\n        i -= 1\n");
}

export void test_front_fix_blocks_a_c_for_with_a_continue_steps_before_it() {
    check(
        "fn f() {\n    for (usize i = 9; i > 0; i--) {\n        if skip(i) {\n            continue\n        }\n        "
        "a(i)\n    }\n}\n",
        "fn f():\n    let mut i: usize = 9\n    while i > 0:\n        if skip(i):\n            i -= 1\n            "
        "continue\n        a(i)\n        i -= 1\n");
}

export void test_front_fix_blocks_a_continue_of_an_inner_loop_is_not_stepped() {
    check(
        "fn f() {\n    for (usize i = 9; i > 0; i--) {\n        for x in xs {\n            continue\n        }\n    "
        "}\n}\n",
        "fn f():\n    let mut i: usize = 9\n    while i > 0:\n        for x in xs:\n            continue\n        i -= "
        "1\n");
}

export void test_front_fix_blocks_a_continue_inside_a_one_line_block_leaves_the_for() {
    check("fn f() {\n    for (usize i = 9; i > 0; i--) {\n        if skip(i) { continue }\n        a(i)\n    }\n}\n",
          "fn f():\n    for (usize i = 9; i > 0; i--):\n        if skip(i):\n            continue\n        a(i)\n");
}

export void test_front_fix_blocks_adjacent_strings_on_several_lines_are_parenthesized() {
    check("fn f() -> str {\n    return \"ab \"\n           \"cd\"\n}\n",
          "fn f() -> str:\n    return (\"ab \"\n           \"cd\")\n");
    check("fn f() {\n    g(\"ab \"\n      \"cd\")\n}\n", "fn f():\n    g(\"ab \"\n      \"cd\")\n");
}

export void test_front_fix_blocks_a_c_for_with_an_assignment_as_its_init() {
    check("fn f(at: *char) {\n    for (at += 7; at.* > 0; at++)\n        count += 1\n}\n",
          "fn f(at: *char):\n    at += 7\n    while at.* > 0:\n        count += 1\n        at += 1\n");
}
