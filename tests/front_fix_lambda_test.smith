// Tests of the fix-it for an old lambda (#1771, part of #1428): `[factor](I32 a) -> I32 { ... }` goes through
// `smith lint --fix` to `fn(a: i32) -> i32 { ... }`, and the text it ends with parses with no error. Before, the
// bracket group stayed and the new parser read it as an array called with `(I32 a)`: "expected `)` to end the
// arguments, found `a`".
module front_fix_lambda_test;

import front::fix;
import front::parser;
import std::arena;
import std::mem;
import std::test;

static Usize errors_in(Str source) {
    parser::Parsed parsed = fix::parse_for_fix("t.smith", source);
    return countof(parsed.errors);
}

static void expect_fixed(Str before, Str want) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed first = fix::fix_text("t.smith", before);
    test::check_equal(first.text, want);
    test::check_equal(errors_in(first.text), (Usize)0);
    fix::Fixed second = fix::fix_text("t.smith", first.text);
    test::check_equal(second.applied, (Usize)0);
}

export void test_front_fix_lambda_a_capture_and_a_typed_parameter() {
    expect_fixed("module m;\nI32 f(I32 factor) {\n    return g([factor](I32 a) -> I32 { return a * factor; });\n}\n",
                 "fn f(factor: i32) -> i32:\n    return g(fn(a: i32) -> i32: a * factor)\n");
}

export void test_front_fix_lambda_no_parameters() {
    expect_fixed("module m;\nvoid f() {\n    run([] { work(); });\n}\n", "fn f():\n    run(fn(): work())\n");
}

export void test_front_fix_lambda_function_pointer_local_with_a_result() {
    expect_fixed("module m;\nI32 main() {\n    I32 (*f)(I32) = [](I32 a) { return a; };\n}\n",
                 "fn main() -> i32:\n    f: fn(i32) -> i32 = fn(a: i32): a\n");
}

export void test_front_fix_lambda_in_a_braced_initializer() {
    expect_fixed(
        "module m;\nstatic const struct Op ops[_] = {\n    {\"plus\", [](I32 a, I32 b) { return a + b; }},\n};\n",
        "static mut ops: [_]Op = [\n    [\"plus\", fn(a: i32, b: i32): a + b],\n]\n");
}

export void test_front_fix_lambda_among_the_arguments_of_a_construction() {
    expect_fixed("fn a(path: *char) -> Route:\n    r := Route(path, fn(x: i32) -> i32: x)\n    return r\n",
                 "fn a(path: *char) -> Route:\n    r := Route(path, fn(x: i32) -> i32: x)\n    return r\n");
}

export void test_front_fix_lambda_function_pointer_local_without_parameters() {
    expect_fixed("module m;\nI32 main() {\n    I32 (*seven)() = [] { return 7; };\n    return seven();\n}\n",
                 "fn main() -> i32:\n    seven: fn() -> i32 = fn(): 7\n    return seven()\n");
}

export void test_front_fix_lambda_function_pointer_local_with_no_result() {
    expect_fixed("module m;\nvoid main() {\n    void (*hello)() = [] { c::printf(\"hello\\n\"); };\n    hello();\n}\n",
                 "fn main():\n    hello: fn() = fn(): c.printf(\"hello\\n\")\n    hello()\n");
}

export void test_front_fix_lambda_function_pointer_local_with_a_void_parameter_list() {
    expect_fixed("module m;\nvoid main() {\n    void (*nothing)(void) = [] { };\n    nothing();\n}\n",
                 "fn main():\n    nothing: fn() = fn(): ()\n    nothing()\n");
}

export void test_front_fix_lambda_function_pointer_local_with_two_parameters() {
    expect_fixed("module m;\nI32 main() {\n    I32 (*add)(I32, I32) = [](I32 x, I32 y) { return x + y; };\n    return "
                 "add(1, 2);\n}\n",
                 "fn main() -> i32:\n    add: fn(i32, i32) -> i32 = fn(x: i32, y: i32): x + y\n    return add(1, 2)\n");
}

export void test_front_fix_lambda_nested() {
    expect_fixed("module m;\nI32 main() {\n    I32 (*outer)(I32) = [](I32 a) -> I32 {\n        I32 (*inner)(I32) = "
                 "[](I32 b) { return b + 1; };\n        return inner(a) * 2;\n    };\n    return outer(4);\n}\n",
                 "fn main() -> i32:\n    outer: fn(i32) -> i32 = fn(a: i32) -> i32:\n        inner: fn(i32) -> i32 = "
                 "fn(b: i32): b + 1\n        return inner(a) * 2\n    return outer(4)\n");
}

export void test_front_fix_lambda_passed_to_qsort() {
    expect_fixed(
        "module m;\nI32 main() {\n    c::qsort(values, 5, sizeof(I32), [](const void *a, const void *b) -> int "
        "{\n        const I32 *left = (const I32 *)a;\n        return *left;\n    });\n    return 0;\n}\n",
        "fn main() -> i32:\n    c.qsort(values, 5, sizeof(i32)) fn(a: *void, b: *void) -> i32:\n        left: *i32 = "
        "a.cast(*i32)\n        return left.*\n    return 0\n");
}

export void test_front_fix_lambda_generic_infer() {
    expect_fixed("module m;\nexport T sum(constexpr Type T, T a, T b) {\n    T (*add)(T, T) = [](T x, T y) { return x "
                 "+ y; };\n    void (*nothing)(void) = [] { };\n    nothing();\n    return add(a, b);\n}\n",
                 "pub fn sum(T: type, a: T, b: T) -> T:\n    add: fn(T, T) -> T = fn(x: T, y: T): x + y\n    nothing: "
                 "fn() = fn(): ()\n    nothing()\n    return add(a, b)\n");
}

export void test_front_fix_lambda_that_discards_a_result() {
    expect_fixed("module m;\nI32 g() { return 1; }\nvoid main() {\n    void (*h)() = [] { g(); };\n    h();\n}\n",
                 "fn g() -> i32:\n    return 1\nfn main():\n    h: fn() = fn():\n        _ := g()\n    h()\n");
}

export void test_front_fix_lambda_generic_infer_after_a_comment() {
    // A `//` comment keeps the text from lexing as smith's own syntax until the first pass is done (#3317).
    expect_fixed("module m;\n\n// The return type is inferred.\nexport T sum(constexpr Type T, T a, T b) {\n"
                 "    T (*add)(T, T) = [](T x, T y) { return x + y; };\n    void (*nothing)(void) = [] { };\n"
                 "    nothing();\n    return add(a, b);\n}\n",
                 "\n# The return type is inferred.\npub fn sum(T: type, a: T, b: T) -> T:\n"
                 "    add: fn(T, T) -> T = fn(x: T, y: T): x + y\n    nothing: fn() = fn(): ()\n    nothing()\n"
                 "    return add(a, b)\n");
}
