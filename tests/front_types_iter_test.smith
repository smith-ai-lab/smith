// Tests of front::types_iter (#1514, C3 of #1428, spec "Iteration"): `for x in xs` over the built-in iterables, the
// stream functions `range`, `enumerate`, `zip` and `refs`, and what is refused. Each scenario is source text in smith's
// own syntax, read by front::parser's hooks and checked by front::types_decl, and builds in an arena it sets as the
// current allocator. One test per rule: an accepted case and a refused one, the refusal with its message.
module front_types_iter_test;

import front::ast;
import front::lex;
import front::parse;
import front::parse_decl;
import front::parse_expr;
import front::parse_stmt;
import front::parse_type;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        Bool same = true;
        for (Usize k = 0; k < countof(needle); k++) {
            if (text[i + k] != needle[k]) {
                same = false;
                break;
            }
        }
        if (same) return true;
    }
    return false;
}

static Str join(Str a, Str b) {
    char out[:] = mem::alloc_slice(char, countof(a) + countof(b));
    for (Usize i = 0; i < countof(a); i++) {
        out[i] = a[i];
    }
    for (Usize i = 0; i < countof(b); i++) {
        out[countof(a) + i] = b[i];
    }
    return out;
}

// The module of `source`, read in smith's own syntax (parser::parse reads today's), with the real parsers' hooks.
static parser::Parsed parse_new(Str source) {
    parser::Parsed result = {};
    result.module.file = "t.smith";
    lex::Lexed lexed = lex::tokenize_new(source);
    switch (lexed) {
    case .ok:
        parse::Parser p = parse::make(lexed.ok, source);
        p.new_syntax = true;
        p.hooks.expression = parse_expr::expression;
        p.hooks.type = parse_type::type;
        p.hooks.statement = parse_stmt::statement;
        p.hooks.declaration = parse_decl::declaration;
        result.module = parse_decl::file(&p, "t.smith");
        result.errors = p.errors;
        break;
    case .error:
        Str expected = "no error";
        test::check_equal(lexed.error.message, expected);
    }
    return result;
}

static types::Checked check_text(Str source) {
    parser::Parsed p = parse_new(source);
    test::check_equal(countof(p.errors), (Usize)0);
    return types_decl::check_module(&p.module, types::lp64());
}

// The errors, one per line.
static Str errors_of(const types::Checked *r) {
    Str text = "";
    for (Usize i = 0; i < r->error_count; i++) {
        text = join(text, join(r->errors[i].message, "\n"));
    }
    return text;
}

// `source` checks with no error.
static void clean(Str source) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_text(source);
    Str errors = errors_of(&r);
    test::check_equal(r.error_count, (Usize)0);
    test::check_condition(has(errors, ""));
}

// `source` gives exactly one error, which says `first` and `second`.
static void fails(Str source, Str first, Str second) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_text(source);
    Str errors = errors_of(&r);
    test::check_equal(r.error_count, (Usize)1);
    test::check_condition(has(errors, first));
    test::check_condition(has(errors, second));
}

// ---------------------------------------------------------------------------------------------------------------
// Built-in iterables

export void test_front_types_iter_array_yields_its_elements() {
    clean("fn run(xs: [3]i32) -> i32 {\n    mut total := 0\n    for x in xs {\n        total = total + x\n    }\n    "
          "total\n}\n");
}

export void test_front_types_iter_slice_yields_its_elements() {
    clean("fn run(xs: []i32) -> i32 {\n    mut total := 0\n    for x in xs {\n        total = total + x\n    }\n    "
          "total\n}\n");
}

export void test_front_types_iter_element_has_the_element_type() {
    fails("fn run(xs: []i32) {\n    for x in xs {\n        s: str = x\n    }\n}\n", "found I32", "expected Str");
}

export void test_front_types_iter_str_yields_bytes() {
    clean("fn run(s: str) -> u8 {\n    mut last: u8 = 0\n    for b in s {\n        last = b\n    }\n    last\n}\n");
    fails("fn run(s: str) {\n    for b in s {\n        c: str = b\n    }\n}\n", "found U8", "expected Str");
}

export void test_front_types_iter_integer_is_not_iterable() {
    fails("fn run(n: i32) {\n    for i in n {\n    }\n}\n", "`I32` is not iterable", "range(n)");
}

export void test_front_types_iter_pointer_is_not_iterable() {
    fails("fn run(p: *i32) {\n    for x in p {\n    }\n}\n", "is not iterable", "p[0:n]");
}

export void test_front_types_iter_loop_name_may_not_shadow() {
    fails("fn run(xs: []i32) {\n    x := 1\n    for x in xs {\n    }\n}\n", "`x` hides", "shadowing is an error");
}

export void test_front_types_iter_loop_name_ends_with_the_loop() {
    fails("fn run(xs: []i32) -> i32 {\n    for x in xs {\n    }\n    x\n}\n", "x", "");
}

// ---------------------------------------------------------------------------------------------------------------
// Stream functions

export void test_front_types_iter_range_yields_its_integers() {
    clean("fn run(n: i32) -> i32 {\n    mut total := 0\n    for i in range(n) {\n        total = total + i\n    }\n    "
          "total\n}\n");
    clean("fn run() {\n    for i in range(2, 10) {\n    }\n}\n");
}

export void test_front_types_iter_range_of_a_string_is_refused() {
    fails("fn run(s: str) {\n    for i in range(s) {\n    }\n}\n", "`range` counts integers", "`Str`");
}

export void test_front_types_iter_refs_yields_pointers() {
    clean("fn run(xs: []i32) {\n    for p in refs(xs) {\n        q: *i32 = p\n    }\n}\n");
}

export void test_front_types_iter_zip_needs_two_iterables() {
    fails("fn run(xs: []i32) {\n    for p in zip(xs) {\n    }\n}\n", "`zip` takes at least two", "directly");
}

export void test_front_types_iter_zip_of_an_integer_is_refused() {
    fails("fn run(xs: []i32, n: i32) {\n    for p in zip(xs, n) {\n    }\n}\n", "`I32` is not iterable", "range(n)");
}

export void test_front_types_iter_zip_yields_tuples_so_one_name_is_refused() {
    fails("fn run(xs: []i32, ys: []i32) {\n    for p in zip(xs, ys) {\n    }\n}\n", "`zip` yields tuples",
          "for (i, x) in zip");
}

export void test_front_types_iter_enumerate_one_name_is_refused() {
    fails("fn run(xs: []i32) {\n    for p in enumerate(xs) {\n    }\n}\n", "`enumerate` yields tuples", "for (i, x)");
}

export void test_front_types_iter_tuple_pattern_is_not_yet_typed() {
    fails("fn run(xs: []i32) {\n    for (i, x) in enumerate(xs) {\n    }\n}\n", "not yet typed: a tuple pattern",
          "#1557");
}
