// `smith lint` on .smith files: clang-tidy run by smith reads them as `smith cc` does (the token hook, and `-x c` with
// `-std=gnu2y`), shows what it finds as the source wrote it, at the source's lines and columns, and judges the names of
// a module as written (`area`, `Box`), never as the lowering makes them (`geometry_box_area`). A scratch project
// (tests/build_fixtures/lint_smith) with the template's .clang-tidy: a module and its importer with real findings in
// both, a clean module, the fixes, a compile error of the lowering's, and plain C beside .smith in one run. The long
// lists of findings are the golden files of tests/lint-smith.
module lint_smith_test;

import std::format;
import std::io;
import std::test;
import <string.h>;
import scratch;

static typeof(const char[:]) slice_of(const char *text) {
    return text[0:c::strlen(text)];
}

// The shell functions every command uses: the findings of a run, one line each as the tool prints them (the rest of its
// output is the carets and the fixes), with the project's folder left off; `run` is `smith lint` on files; `idiom` is
// one check alone, and `idiom_findings` a finding without the check's name.
constexpr char prelude[_] =
    "findings() { grep -E '^/.*:[0-9]+:[0-9]+: (error|warning):' | sed -e \"s|^$PWD/||\" -e \"s|^$(pwd -P)/||\"; }; "
    "flags='-I. -I.smith/include'; "
    "run() { smith lint --quiet \"$@\" -- $flags 2>&1; }; "
    "idiom() { check=$1; shift; smith lint --quiet --checks=\"-*,$check\" \"$@\" -- -std=gnu2y $flags "
    "-I\"$SMITH_REPO/.smith/include\" 2>&1; }; "
    "idiom_findings() { findings | sed -e 's/ \\[smith-[a-z0-9-]*,-warnings-as-errors\\]$//'; }; ";

// The project: the fixture with the template's .clang-tidy. smith-module has its own tests below, so `full` is for
// them.
static scratch::Project prepared(io::Io *io, Bool full) {
    scratch::Project p = scratch::project(io, "p", "lint_smith");
    scratch::Run run =
        scratch::sh(&p, full ? "cp \"$SMITH_REPO/templates/defaults/clang-tidy\" .clang-tidy"
                             : "grep -v '^  smith-module,$' \"$SMITH_REPO/templates/defaults/clang-tidy\" "
                               ">.clang-tidy");
    scratch::expect_status("the project is prepared", 0, &run);
    return p;
}

static scratch::Run lint(const scratch::Project *p, const char *body) {
    return scratch::sh(p, format::push(&p->io->arena, prelude, body).data);
}

static const char *lint_text(const scratch::Project *p, const char *body) {
    return scratch::capture(p, format::push(&p->io->arena, prelude, body).data);
}

static void golden_of(io::Io *io, const char *name, const char *actual) {
    test::golden(io, slice_of(format::push(&io->arena, "tests/lint-smith/", name, ".expected").data), slice_of(actual));
}

// The text of the findings of a run in a fixture file, as the golden file `name` holds it.
static void findings_are(io::Io *io, const scratch::Project *p, const char *name, const char *body) {
    golden_of(io, name, lint(p, body).out);
}

constexpr char plain_findings[_] = "plain.c:1:5: error: invalid case style for function 'geometry_box_Odd' "
                                   "[readability-identifier-naming,-warnings-as-errors]\n"
                                   "plain.c:1:26: error: invalid case style for parameter 'Bad_Arg' "
                                   "[readability-identifier-naming,-warnings-as-errors]";
constexpr char bad_local[_] = "main.smith:5:9: error: invalid case style for variable 'BadLocal' "
                              "[readability-identifier-naming,-warnings-as-errors]";

// --- a module and its importer, in memory (no generated header yet) ------------------------------------------------

export void test_lint_findings_are_at_the_sources_lines_with_the_names_as_written(io::Io *io) {
    scratch::Project p = prepared(io, false);
    findings_are(io, &p, "box", "run geometry/box.smith main.smith >in-memory; findings <in-memory");
    scratch::expect_text("the lowering's names never appear in a finding", "0",
                         lint_text(&p, "grep -c 'geometry_box_' in-memory"));
    scratch::expect_text("the importer reports nothing of the module's names", "0",
                         lint_text(&p, "findings <in-memory | grep -c '^main.smith.*\\(area\\|Box\\)'"));
}

// --- with the headers `smith build` writes -------------------------------------------------------------------------

constexpr char make_header[_] = "mkdir -p .smith/include/geometry; "
                                "smith cc --smith-header geometry/box.smith -o .smith/include/geometry/box.h; ";

export void test_lint_the_same_findings_with_the_generated_header_on_disk(io::Io *io) {
    scratch::Project p = prepared(io, false);
    findings_are(
        io, &p, "box",
        format::push(&io->arena, make_header, "run geometry/box.smith main.smith >headers; findings <headers").data);
    scratch::expect_text("the lowering's names never appear with the header on disk", "0",
                         lint_text(&p, "grep -c 'geometry_box_' headers"));
}

export void test_lint_an_importer_alone_reports_its_own_and_nothing_in_the_modules_header(io::Io *io) {
    scratch::Project p = prepared(io, false);
    scratch::expect_text(
        "an importer alone reports its own and nothing in the module's header", bad_local,
        lint_text(&p, format::push(&io->arena, make_header, "run main.smith >importer; findings <importer").data));
}

// --- the carets and the fixes are the source's ---------------------------------------------------------------------

export void test_lint_a_finding_shows_the_source_line_its_fix_at_the_written_name(io::Io *io) {
    scratch::Project p = prepared(io, false);
    scratch::expect_text(
        "a finding shows the source line, its fix at the written name",
        "   17 | export F32 Perimeter(Box b) {\n      |            ^~~~~~~~~\n      |            perimeter",
        lint_text(&p, "run geometry/box.smith >carets; grep -A2 ' 17 | export F32' carets"));
}

export void test_lint_fix_rewrites_the_written_names_in_the_source(io::Io *io) {
    scratch::Project p = prepared(io, false);
    (void)lint(&p, format::push(&io->arena, make_header,
                                "cp geometry/box.smith box.orig; cp main.smith main.orig; "
                                "run --fix geometry/box.smith main.smith >/dev/null")
                       .data);
    scratch::expect_text("--fix rewrites the written names in the source",
                         scratch::capture(&p, "sed -e 's/} bad_Type;/} BadType;/' -e 's/Perimeter/perimeter/' "
                                              "-e 's/bad_Helper/bad_helper/g' -e 's/Bad_Name/bad_name/g' box.orig"),
                         scratch::capture(&p, "cat geometry/box.smith"));
    scratch::expect_text("--fix rewrites an importer's own names",
                         scratch::capture(&p, "sed 's/BadLocal/bad_local/g' main.orig"),
                         scratch::capture(&p, "cat main.smith"));
}

// --- any check names things as written -----------------------------------------------------------------------------

export void test_lint_another_checks_message_has_the_written_name_too(io::Io *io) {
    scratch::Project p = prepared(io, false);
    (void)lint(&p,
               "smith lint --quiet --checks='-*,misc-no-recursion' geometry/recursive.smith -- $flags >recursion 2>&1");
    scratch::expect_text("another check's message has the written name too",
                         "geometry/recursive.smith:3:12: error: function 'fact' is within a recursive call chain "
                         "[misc-no-recursion,-warnings-as-errors]",
                         lint_text(&p, "findings <recursion | head -n 1"));
    scratch::expect_text(
        "and its note too",
        "geometry/recursive.smith:3:12: note: example recursive call chain, starting from function 'fact'",
        lint_text(&p, "grep 'note:.*example recursive' recursion | sed -e \"s|^$PWD/||\" "
                      "-e \"s|^$(pwd -P)/||\" | head -n 1"));
}

// --- every kind of name the lowering renames is judged as written --------------------------------------------------
// A typedef, a struct tag, an enumerator, a constant and a parameter, each well named (quiet) and badly named (flagged
// at the written name, never the lowering's `kinds_bad_type`).

export void test_lint_every_kind_of_name_is_judged_as_written(io::Io *io) {
    scratch::Project p = prepared(io, false);
    findings_are(io, &p, "kinds", "run kinds.smith >kinds; findings <kinds");
    scratch::expect_text("... and the lowering's names never appear", "0", lint_text(&p, "grep -c 'kinds_' kinds"));
}

