    scratch::expect_text(
        "the lowering's error is at the source, as written",
        "bad_call.smith:4:5: error: `printf` is a C name; write `c::printf` [clang-diagnostic-error]",
        lint_text(&p, "run bad_call.smith >errors; findings <errors | grep clang-diagnostic | head -n 1"));
}

