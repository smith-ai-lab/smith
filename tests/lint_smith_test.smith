// `(void)` as a parameter list is C's habit: in C23 `()` is no parameters. A finding with a fix in a module, none in a
// .c file or a .smith file with no `module` line, and none on a cast or on `sizeof(void)`.

export void test_lint_smith_c23_void_parameter_lists_in_a_module_and_not_a_cast_or_sizeof(io::Io *io) {
    scratch::Project p = prepared(io, false);
    findings_are(io, &p, "void_list", "idiom smith-c23 idiom/void_list.smith >void.out; idiom_findings <void.out");
}

export void test_lint_smith_c23_an_empty_list_in_a_module_is_clean_and_void_in_c_is_cs_own(io::Io *io) {
    scratch::Project p = prepared(io, false);
    scratch::expect_text("smith-c23: () in a module is clean, and (void) in a .c file or a .smith file with no module "
                         "line is C's own",
                         "",
                         lint_text(&p, "idiom smith-c23 idiom/void_list_ok.smith idiom/void_list_plain.smith "
                                       "idiom/void_list.c >void-ok.out; idiom_findings <void-ok.out"));
}

export void test_lint_smith_c23_fix_deletes_the_void_of_each_parameter_list_and_leaves_the_casts(io::Io *io) {
    scratch::Project p = prepared(io, false);
    scratch::Run run = lint(&p, "mkdir -p voidfix/idiom && cp idiom/void_list.smith voidfix/idiom/void_list.smith && "
                                "(cd voidfix && smith lint --fix --checks=\"-*,smith-c23\" idiom/void_list.smith -- "
                                "-std=gnu2y $flags -I\"$SMITH_REPO/.smith/include\" >/dev/null 2>&1); "
                                "cat voidfix/idiom/void_list.smith");
    golden_of(io, "void_list_fixed", run.out);
}

export void test_lint_smith_constexpr_a_file_scope_const_with_a_constant_initializer(io::Io *io) {
    scratch::Project p = prepared(io, false);
    findings_are(io, &p, "consts",
                 "idiom smith-constexpr idiom/consts.smith idiom/consts.c >consts.out; idiom_findings <consts.out");
}

// smith-module (issue #60): a .smith file with no module line gets the line its path implies; tests/ is a root of its
// own.
static void write_module_files(const scratch::Project *p) {
    scratch::Run made = scratch::sh(p, "mkdir -p tests mod");
    scratch::expect_status("made", 0, &made);
    scratch::write(p, "mod/loose.smith", "U32 helper(U32 n) {\n    return n + 1;\n}\n");
    scratch::write(p, "tests/loose_test.smith", "// The tests.\n\nvoid test_x(void) {}\n");
    scratch::write(p, "main.smith", "I32 main(I32 argc, char *argv[]) {\n    return argc - 1;\n}\n");
    scratch::write(p, "build.smith",
                   "import std::build;\n\nvoid build(build::Build *b) {\n    build::app(b, &(build::App){});\n}\n");
    scratch::write(p, "mod/fine.smith",
                   "// A comment first, then the line.\nmodule mod::fine;\n\nexport U32 helper(U32 n) {\n"
                   "    return n + 1;\n}\n");
    scratch::write(p, "mod/plain.c", "unsigned helper(unsigned n) { return n; }\n");
}

export void test_lint_smith_module_a_file_with_no_module_line_gets_the_one_its_path_implies(io::Io *io) {
    scratch::Project p = prepared(io, true);
    write_module_files(&p);
    findings_are(io, &p, "module",
                 "idiom smith-module mod/loose.smith tests/loose_test.smith main.smith build.smith mod/fine.smith "
                 "mod/plain.c >module.out; idiom_findings <module.out | sort");
}

export void test_lint_smith_module_is_on_in_smiths_defaults(io::Io *io) {
    scratch::Project p = prepared(io, true);
    write_module_files(&p);
    scratch::expect_text("smith-module: it is on in smith's defaults", "1",
                         lint_text(&p, "run mod/loose.smith >module-default.out; "
                                       "findings <module-default.out | grep -c 'smith-module,'"));
}

// The idiom checks are in the template's .clang-tidy, so a .smith file gets them by default.
export void test_lint_the_idiom_checks_are_on_in_smiths_defaults_and_a_clean_module_passes_them_all(io::Io *io) {
    scratch::Project p = prepared(io, true);
    scratch::expect_text("the idiom checks are on in smith's defaults, and a clean module passes them all", "",
                         lint_text(&p, "run idiom/all.smith >all-ok.out; findings <all-ok.out"));
    scratch::expect_text("... and report in a default run", "1",
                         lint_text(&p, "run idiom/sized.smith >all-sized.out; "
                                       "findings <all-sized.out | head -n 1 | grep -c 'smith-sized-types'"));
}

// Objective-C: a class with ivars, properties and methods has names that are not simple identifiers (selectors); the
// naming check skips them (it once asserted "Name is not a simple identifier", issue #115): no crash, no finding.
export void test_lint_objective_c_ivars_properties_and_methods_do_not_crash_lint(io::Io *io) {
    scratch::Project p = prepared(io, true);
    scratch::expect_text("Objective-C ivars, properties and methods: lint does not crash and reports nothing", "0 0",
                         scratch::capture(&p, "smith lint objc.m >objc.out 2>&1; s=$?; "
                                              "echo \"$s $(grep -c 'readability-identifier-naming' objc.out)\""));
}

// --- defer: a command that says `-x c`, as every build command does, still turns the defer TS on -----------------
// undeclared `_Defer` --------------

export void test_lint_a_module_that_uses_defer_lints_clean(io::Io *io) {
    scratch::Project p = prepared(io, false);
    (void)lint(&p, "smith lint --quiet defer/cleanup.smith -- -x c $flags >defer.out 2>&1; echo $? >defer.status");
    scratch::expect_text("a module that uses defer lints clean", "0", scratch::capture(&p, "cat defer.status"));
    scratch::expect_text("... with no finding about _Defer", "0", scratch::capture(&p, "grep -c '_Defer' defer.out"));
}
