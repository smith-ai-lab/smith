    scratch::Project p = prepared(io, false);
    scratch::expect_text("a C file's names are its own, underscores or not", plain_findings,
                         lint_text(&p, "run plain.c >plain-alone; findings <plain-alone"));
}

export void test_lint_plain_c_beside_a_smith_file_in_one_run_is_reported_the_same(io::Io *io) {
    scratch::Project p = prepared(io, false);
    scratch::expect_text("plain C beside a .smith file in one run is reported the same",
                         format::push(&io->arena, bad_local, "\n", plain_findings).data,
                         lint_text(&p, "run main.smith plain.c >mixed; findings <mixed"));
}

export void test_lint_plain_c_on_both_sides_of_a_smith_file_keeps_its_names(io::Io *io) {
    scratch::Project p = prepared(io, false);
    findings_are(io, &p, "plain_around", "run plain.c geometry/box.smith plain2.c >around; findings <around | sort");
}

// --- `smith lint` with no arguments lints the .smith sources a build compiles --------------------------------------

export void test_lint_with_no_arguments_lints_the_smith_sources_a_build_compiles(io::Io *io) {
    scratch::Project p = scratch::project(io, "q", "lint_verb");
    scratch::Run copied = scratch::sh(&p, "cp \"$SMITH_REPO/templates/defaults/clang-tidy\" .clang-tidy");
    scratch::expect_status("copied", 0, &copied);
    scratch::Run run = scratch::sh(&p, "smith lint >verb.out 2>verb.err");
    scratch::expect_status("smith lint with no arguments fails on a finding in a .smith file the build compiles", 1,
                           &run);
    scratch::expect_text(
        "... and reports it at the source, as written",
        "main.smith:2:9: error: invalid case style for variable 'BadLocal' "
        "[readability-identifier-naming,-warnings-as-errors]",
        scratch::capture(
            &p, "grep -h 'main.smith:2:9' verb.out verb.err | head -n 1 | sed 's|^.*/main.smith|main.smith|'"));
}

// A .smith source the build never compiles is linted too (with the command of the nearest compile), one that
// `.clang-format-ignore` names is not, and the line says how many files were linted (main.smith, build.c, unbuilt).
export void test_lint_with_no_arguments_lints_the_smith_sources_the_build_does_not_compile(io::Io *io) {
    scratch::Project p = scratch::project(io, "r", "lint_verb");
    scratch::Run prepared_run = scratch::sh(
        &p, "cp \"$SMITH_REPO/templates/defaults/clang-tidy\" .clang-tidy; git init -q . && "
            "printf 'int Bad_Unbuilt = 0;\\n' >unbuilt.smith; printf 'int Bad_Ignored = 0;\\n' >ignored.smith; "
            "printf 'ignored.smith\\n' >.clang-format-ignore; sed -i.bak 's/BadLocal/good_local/' main.smith; "
            "rm main.smith.bak; git add -A");
    scratch::expect_status("the project is prepared", 0, &prepared_run);
    scratch::Run run = scratch::sh(&p, "smith lint >gate.out 2>gate.err");
    scratch::expect_status("a finding in a .smith file the build does not compile fails smith lint", 1, &run);
    scratch::expect_text("... it is reported at the source", "1",
                         scratch::capture(&p,
                                          "cat gate.out gate.err .smith/log/lint.log 2>/dev/null | "
                                          "grep \"unbuilt.smith:1:.*'Bad_Unbuilt'\" | sed 's|^.*/unbuilt|unbuilt|' | "
                                          "sort -u | grep -c ."));
    scratch::expect_text(
        "... a file the ignore list names is left alone", "0",
        scratch::capture(&p, "cat gate.out gate.err .smith/log/lint.log 2>/dev/null | grep -c ignored.smith"));
    scratch::expect_text("... and the number of files linted is printed", "smith lint: linted 3 files",
                         scratch::capture(&p, "cat gate.out gate.err .smith/log/lint.log 2>/dev/null | "
                                              "grep -o 'smith lint: linted [0-9]* files' | sort -u"));
}

// --- a call to a generic: the instance is judged as the generic's name, not `push_array<F64>` ----------------------

export void test_lint_a_module_that_calls_a_generic_lints_clean(io::Io *io) {
    scratch::Project p = prepared(io, false);
    (void)lint(&p, "run generic/user.smith smith/pool.smith >generic.out; echo $? >generic.status");
    scratch::expect_text("a module that calls a generic lints clean", "0", scratch::capture(&p, "cat generic.status"));
    scratch::expect_text("... with no finding about the instance's name", "0",
                         scratch::capture(&p, "grep -c 'push_array<' generic.out"));
}

// --- tuples (issue #96): the struct a tuple lowers to and its fields `_0`, `_1` are named by the lowering
// --------------

export void test_lint_a_module_with_tuples_lints_clean(io::Io *io) {
    scratch::Project p = prepared(io, false);
    (void)lint(&p, "run tuples/pairs.smith tuples/user.smith >tuples.out; echo $? >tuples.status");
    scratch::expect_text("a module with tuples lints clean", "0", scratch::capture(&p, "cat tuples.status"));
    scratch::expect_text("... with no finding about the struct or the fields the lowering made", "0",
                         scratch::capture(&p, "grep -c \"smith_tuple_\\|'_[0-9]'\" tuples.out"));
}

// --- smith-preprocessor (issue #46): a .smith file has no preprocessor ----------------------------------------------

constexpr char preprocessor_only[_] =
    "preprocessor_only() { findings | grep -E 'smith-preprocessor' | sed -e 's/ "
    "\\[smith-preprocessor,-warnings-as-errors\\]$//' "
    "-e 's/: \\(`[^`]*`\\) is the preprocessor, and a .smith file has none: .*/: \\1/' "
    "-e 's/: \\(`c::[a-zA-Z_]*`\\) is a C macro, and a .smith file has no preprocessor: .*/: \\1 macro/'; }; ";

export void test_lint_smith_preprocessor_every_directive_and_c_macro_at_its_place(io::Io *io) {
    scratch::Project p = prepared(io, false);
    findings_are(
        io, &p, "preprocessor",
        format::push(&io->arena, preprocessor_only, "run pre/bad.smith >pre.out; preprocessor_only <pre.out").data);
}

export void test_lint_smith_preprocessor_each_directive_says_what_to_write(io::Io *io) {
    scratch::Project p = prepared(io, false);
    (void)lint(&p, "run pre/bad.smith >pre.out");
    scratch::expect_text("smith-preprocessor: #include says import", "1",
                         scratch::capture(&p, "grep -c 'write `import <header>;`' pre.out"));
    scratch::expect_text("smith-preprocessor: #define says constexpr", "1",
                         scratch::capture(&p, "grep -c 'a constant is `constexpr Usize name = value;`' pre.out"));
    scratch::expect_text("smith-preprocessor: #if, #else and #endif say if constexpr and target", "3",
                         scratch::capture(&p, "grep -c 'if constexpr (target::os == target::macos)' pre.out"));
    scratch::expect_text("smith-preprocessor: c::assert says contract::assert", "2",
                         scratch::capture(&p, "grep -c 'write `contract::assert(condition)`' pre.out"));
    scratch::expect_text("smith-preprocessor: c::isfinite says math::is_finite", "1",
                         scratch::capture(&p, "grep -c 'write `math::is_finite(x)`' pre.out"));
    scratch::expect_text("smith-preprocessor: c::SIZE_MAX says math::max(Usize)", "1",
                         scratch::capture(&p, "grep -c 'write `math::max(Usize)`' pre.out"));
}

export void test_lint_smith_preprocessor_nolint_opts_a_line_out(io::Io *io) {
    scratch::Project p = prepared(io, false);
    (void)lint(&p, "run pre/optout.smith >pre-optout.out");
    scratch::expect_text("smith-preprocessor: NOLINT(smith-preprocessor) opts a line out", "0",
                         scratch::capture(&p, "grep -c 'smith-preprocessor' pre-optout.out"));
}

export void test_lint_smith_preprocessor_a_c_file_is_left_alone(io::Io *io) {
    scratch::Project p = prepared(io, false);
    (void)lint(&p, "smith lint --quiet pre/plain.c -- -std=gnu2y >pre-plain.out 2>&1");
    scratch::expect_text("smith-preprocessor: a .c file is left alone", "0",
                         scratch::capture(&p, "grep -c 'smith-preprocessor' pre-plain.out"));
}

export void test_lint_smith_preprocessor_a_module_with_contract_math_target_and_constexpr_is_clean(io::Io *io) {
    scratch::Project p = prepared(io, false);
    (void)lint(&p, "run pre/good.smith >pre-good.out");
    scratch::expect_text("smith-preprocessor: a module with contract, math, target and constexpr is clean", "0",
                         scratch::capture(&p, "grep -c 'smith-preprocessor' pre-good.out"));
}

// --- the idiom checks (issue #47): sized types, libraries as modules, bounded loops, C23 spellings, constexpr
// ----------- Each check alone (--checks), a failing file and a passing one, and the message that names the fix.

export void test_lint_smith_sized_types_every_c_type_at_its_place_with_the_sized_type_to_write(io::Io *io) {
    scratch::Project p = prepared(io, false);
    findings_are(io, &p, "sized",
                 "idiom smith-sized-types idiom/sized.smith >sized.out; idiom_findings <sized.out | "
                 "sed -e 's/ (U8 U16 U32 U64, I8 I16 I32 I64, Usize, Isize, F32, F64)$//'");
    scratch::expect_text("smith-sized-types: char stays, and the C spelling of main is reported like any int", "2",
                         scratch::capture(&p, "grep -c 'sized.smith:\\(1[3-9]\\|2[0-9]\\)' sized.out"));
    scratch::expect_text(
        "smith-sized-types: the message lists the sized types", "14",
        scratch::capture(&p, "grep -c '(U8 U16 U32 U64, I8 I16 I32 I64, Usize, Isize, F32, F64)' sized.out"));
}

