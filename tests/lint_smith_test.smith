export void test_lint_a_module_that_follows_the_rules_reports_nothing(io::Io *io) {
    scratch::Project p = prepared(io, false);
    scratch::expect_text("a module that follows the rules, sized types and all, reports nothing", "",
                         lint_text(&p, "run clean/ok.smith >clean.out; echo $? >status; findings <clean.out"));
    scratch::expect_text("its exit status is 0", "0", scratch::capture(&p, "cat status"));
}

