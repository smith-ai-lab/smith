// Tests of the Neovim plugin (issue #24: plugin/smith.lua and editors/neovim; from tests/neovim.sh) in headless Neovim;
// they do nothing when nvim is absent. Each test of tests/neovim.lua (a fixture program in Lua, named by
// SMITH_NVIM_TEST) runs in a Neovim of its own, started as a user's would be: the repository on the runtimepath and
// `runtime plugin/smith.lua`, in a scratch home (XDG_*, the fixture tests/build_fixtures/neovim copied into the test's
// scratch folder) so that the user's configuration and data are never read or written. The plugin gets the parser from
// the smith under test (`smith cc --smith-tree-sitter`).
module neovim_test;

import std::arena;
import std::format;
import std::mem;
import std::test;
import <string.h>;
import scratch;

// The scratch home: the fixture (a project, a folder with a .smith file alone, and a nvim-dap that is only a table)
// and the compile database of the project.
constexpr char setup[_] =
    "d=$PWD; mkdir -p data config state cache home new empty-data && "
    "printf "
    "'[{\"directory\":\"%s\",\"file\":\"main.smith\",\"arguments\":[\"smith-cc\",\"-x\",\"c\",\"-c\",\"main.smith\"]}]"
    "\\n' "
    "\"$d/project\" >project/compile_commands.json && export HOME=$d/home GIT_CONFIG_NOSYSTEM=1";

// The projects smith new writes (no build file; the plugin finds them by their main), made only for the tests that
// read them: a C one that builds (hello), a C one whose main.c does not compile (broken), and one of the default
// language (fresh).
constexpr char make_new[_] =
    "mk() { smith new \"$@\" >new.log 2>&1 || { echo \"smith new $*: failed\" >&2; tail -n 40 new.log >&2; return 1; "
    "}; }; ";

constexpr char make_hello[_] = "(cd new && mk --language c hello)";
constexpr char make_broken[_] = "(cd new && mk --language c broken && printf 'this is an error\\n' >>broken/main.c)";
constexpr char make_fresh[_] = "(cd new && mk fresh)";

// Whether the test `name` is `other`.
static bool is(const char *name, const char *other) {
    return c::strcmp(name, other) == 0;
}

// The scratch home's setup for the test `name`: the base and the projects of smith new it reads.
static const char *setup_for(const char *name) {
    bool a = is(name, "dap_build_program") || is(name, "dap_test_under_cursor") || is(name, "dap_main_under_cursor") ||
             is(name, "neotest_is_test_file") || is(name, "neotest_discover_c") || is(name, "neotest_build_spec");
    bool b = is(name, "dap_build_fails");
    bool f = is(name, "dap_default_project");
    return format::push(setup, a || b || f ? "; " : "", a || b || f ? make_new : "", a ? make_hello : "",
                        a && (b || f) ? " && " : "", b ? make_broken : "", b && f ? " && " : "", f ? make_fresh : "")
        .data;
}

// A smith that prints a commit of our choosing and is the real one otherwise.
constexpr char shim[_] =
    "shim() { mkdir -p \"$1\"; printf '#!/bin/sh\\nif [ \"$1\" = version ]; then echo \"%s\"; exit 0; fi\\n"
    "exec \"%s\" \"$@\"\\n' \"$2\" \"$SMITH_SELF\" >\"$1/smith\"; chmod +x \"$1/smith\"; }; ";

constexpr char fakedap[_] = "--cmd \"set runtimepath+=$d/fakedap\"";

// How Neovim is started: the line the shim of smith says (nullptr for no shim), the PATH in front of the smith under
// test, whether the smith under test is on the PATH at all, the data folder (relative to the scratch home) and more
// arguments.
typedef struct {
    const char *version_line;
    const char *front;
    bool bare;
    bool needs_git;
    const char *data;
    const char *extra;
} Start;

// Runs the test `name` of tests/neovim.lua in a Neovim of its own, in a scratch home of its own.
static void nvim(const char *name, const Start *start) {
    scratch::Project p = scratch::make("nvim", "neovim");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (scratch::sh(&p, "command -v nvim >/dev/null").status != 0) {
        return;
    }
    if (start->needs_git && scratch::sh(&p, "git -C \"$SMITH_REPO\" rev-parse HEAD >/dev/null 2>&1").status != 0) {
        return; // the version tests need a git checkout of smith
    }
    scratch::Run made = scratch::sh(&p, setup_for(name));
    if (made.status != 0) {
        test::note("the setup said: %s", made.err); // `smith new`'s own output, so a failure explains itself (#456)
    }
    scratch::expect_status("neovim: the scratch home is made", 0, &made);
    const char *path = start->bare ? "/usr/bin:/bin" : format::push(start->front, p.tested, ":/usr/bin:/bin").data;
    const char *before =
        start->version_line == nullptr
            ? ""
            : format::push(shim, "shim \"$PWD/shimmed\" \"smith 0.0", start->version_line, "\"; ").data;
    const char *command =
        format::push(
            "nvim=$(command -v nvim); ", before, "d=$PWD; export XDG_DATA_HOME=$d/", start->data,
            " XDG_CONFIG_HOME=$d/config XDG_STATE_HOME=$d/state XDG_CACHE_HOME=$d/cache HOME=$d/home "
            "GIT_CONFIG_NOSYSTEM=1; ",
            "env PATH=\"", path, "\" SMITH_NVIM_TEST=", name,
            " SMITH_REPO=\"$SMITH_REPO\" SMITH_PROJECT=\"$d/project\" SMITH_ALONE=\"$d/alone\" "
            "SMITH_NEW=\"$d/new/hello\" "
            "SMITH_BROKEN=\"$d/new/broken\" SMITH_FRESH=\"$d/new/fresh\" \"$nvim\" --headless -u NONE -i NONE --cmd "
            "\"set runtimepath^=$SMITH_REPO\" --cmd \"filetype on\" --cmd \"let g:smith_no_version_check = 1\" ",
            start->extra,
            " --cmd \"runtime plugin/smith.lua\" -c \"lua vim.api.nvim_create_autocmd('VimEnter', {once = true, "
            "callback = "
            "function() vim.schedule(function() dofile('$SMITH_REPO/tests/neovim.lua') end) end})\" 2>&1")
            .data;
    scratch::Run run = scratch::sh(&p, command);
    // The plugin's `smith cc --smith-tree-sitter` can outlive Neovim and still be unpacking into the data folder, so
    // the scratch folder's removal found it half full (#1017). On Linux wait until no process has the scratch folder as
    // its working directory (the job inherits Neovim's); elsewhere removing the folder was never raced.
    scratch::sh(&p, "n=0; while [ $n -lt 100 ]; do busy=0; for c in /proc/[0-9]*/cwd; do "
                    "[ \"$c\" = /proc/$$/cwd ] && continue; case $(readlink \"$c\" 2>/dev/null) in \"$PWD\"*) busy=1;; "
                    "esac; done; [ $busy = 0 ] && break; n=$((n + 1)); sleep 0.1; done");
    if (run.status != 0 || !scratch::contains(run.out, "ok  ")) {
        test::note("%s (status %d)\n%s", name, run.status, run.out);
    }
    scratch::expect_status(format::push("neovim: ", name).data, 0, &run);
    scratch::expect_contains(format::push("neovim: ", name, " says ok").data, run.out, "ok  ");
}

// The usual: the smith under test first on PATH.
static void plain(const char *name, const char *extra) {
    Start start = {
        .version_line = nullptr, .front = "", .bare = false, .needs_git = false, .data = "data", .extra = extra};
    nvim(name, &start);
}

