// The commit of the plugin against the commit smith was built from: a smith that says the line and is the real one
// otherwise, first on PATH.
static void version(io::Io *io, const char *name, const char *line, const char *extra) {
    const char *before = format::push(&io->arena, shim, "shim \"$PWD/shimmed\" \"smith 0.0", line, "\"; ").data;
    Start start = {
        .before = before, .front = "$d/shimmed:", .bare = false, .needs_git = true, .data = "data", .extra = extra};
    nvim(io, name, &start);
}

export void test_neovim_version_same(io::Io *io) {
    version(io, "version_same", " commit $(git -C \"$SMITH_REPO\" rev-parse HEAD)", "");
}

export void test_neovim_version_different(io::Io *io) {
    version(io, "version_different", " commit 0123456789abcdef0123456789abcdef01234567", "");
}

export void test_neovim_version_unknown(io::Io *io) {
    version(io, "version_unknown", "", "");
}

export void test_neovim_version_at_startup(io::Io *io) {
    version(io, "version_at_startup", " commit 0123456789abcdef0123456789abcdef01234567",
            "--cmd \"lua _G.smith_notices = {}; vim.notify = function(message) table.insert(_G.smith_notices, message) "
            "end\" --cmd \"unlet g:smith_no_version_check\"");
}

export void test_neovim_no_smith(io::Io *io) {
    Start start = {.before = "", .front = "", .bare = true, .needs_git = false, .data = "empty-data", .extra = ""};
    nvim(io, "no_smith", &start);
}

// A smith built from a checkout names its commit, which is the plugin's way to compare.
export void test_neovim_smith_version_names_its_commit(io::Io *io) {
    scratch::Project p = scratch::project(io, "version", nullptr);
    const char *version_text = scratch::capture(&p, "smith version");
    if (!scratch::contains(version_text, " commit ")) {
        return; // this smith was built without a commit
    }
    scratch::expect_text(
        "smith version names its commit", "yes",
        scratch::capture(&p, "c=$(smith version); c=${c##* commit }; case $c in *[!0-9a-f]* | \"\") echo no ;; "
                             "*) echo yes ;; esac"));
}
