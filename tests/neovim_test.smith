// Tests of the Neovim plugin (issue #24: plugin/smith.lua and editors/neovim; from tests/neovim.sh) in headless Neovim;
// they do nothing when nvim is absent. Each test of tests/neovim.lua (a fixture program in Lua, named by
// SMITH_NVIM_TEST) runs in a Neovim of its own, started as a user's would be: the repository on the runtimepath and
// `runtime plugin/smith.lua`, in a scratch home (XDG_*, the fixture tests/build_fixtures/neovim copied into the test's
// scratch folder) so that the user's configuration and data are never read or written. The plugin gets the parser from
// the smith under test (`smith cc --smith-tree-sitter`).
module neovim_test;

import smith::format;
import smith::io;
import smith::test;
import scratch;

// The scratch home: the fixture (a project, a folder with a .smith file alone, and a nvim-dap that is only a table),
// the compile database of the project, and the projects smith new writes (no build file; the plugin finds them by
// their main): a C one that builds, a C one whose main.c does not compile, and one of the default language.
constexpr char setup[_] =
    "d=$PWD; mkdir -p data config state cache home new empty-data && "
    "printf "
    "'[{\"directory\":\"%s\",\"file\":\"main.smith\",\"arguments\":[\"smith-cc\",\"-x\",\"c\",\"-c\",\"main.smith\"]}]"
    "\\n' "
    "\"$d/project\" >project/compile_commands.json && export HOME=$d/home GIT_CONFIG_NOSYSTEM=1 && "
    "mk() { smith new \"$@\" >new.log 2>&1 || { echo \"smith new $*: failed\" >&2; tail -n 40 new.log >&2; return 1; "
    "}; }; "
    "(cd new && mk --language c hello && mk --language c broken && "
    "printf 'this is an error\\n' >>broken/main.c && mk fresh)";

// A smith that prints a commit of our choosing and is the real one otherwise.
constexpr char shim[_] =
    "shim() { mkdir -p \"$1\"; printf '#!/bin/sh\\nif [ \"$1\" = version ]; then echo \"%s\"; exit 0; fi\\n"
    "exec \"%s\" \"$@\"\\n' \"$2\" \"$SMITH_SELF\" >\"$1/smith\"; chmod +x \"$1/smith\"; }; ";

constexpr char fakedap[_] = "--cmd \"set runtimepath+=$d/fakedap\"";

// How Neovim is started: the shell that runs first (the shim of smith), the PATH in front of the smith under test,
// whether the smith under test is on the PATH at all, the data folder (relative to the scratch home) and more
// arguments.
typedef struct {
    const char *before;
    const char *front;
    bool bare;
    bool needs_git;
    const char *data;
    const char *extra;
} Start;

// Runs the test `name` of tests/neovim.lua in a Neovim of its own, in a scratch home of its own.
static void nvim(io::Io *io, const char *name, const Start *start) {
    scratch::Project p = scratch::project(io, "nvim", "neovim");
    if (scratch::sh(&p, "command -v nvim >/dev/null").status != 0) {
        return;
    }
    if (start->needs_git && scratch::sh(&p, "git -C \"$SMITH_REPO\" rev-parse HEAD >/dev/null 2>&1").status != 0) {
        return; // the version tests need a git checkout of smith
    }
    scratch::Run made = scratch::sh(&p, setup);
    if (made.status != 0) {
        test::note("the setup said: %s", made.err); // `smith new`'s own output, so a failure explains itself (#456)
    }
    scratch::expect_status("neovim: the scratch home is made", 0, &made);
    const char *path =
        start->bare ? "/usr/bin:/bin" : format::push(&io->arena, start->front, p.tested, ":/usr/bin:/bin").data;
    const char *command =
        format::push(
            &io->arena, "nvim=$(command -v nvim); ", start->before, "d=$PWD; export XDG_DATA_HOME=$d/", start->data,
            " XDG_CONFIG_HOME=$d/config XDG_STATE_HOME=$d/state XDG_CACHE_HOME=$d/cache HOME=$d/home "
            "GIT_CONFIG_NOSYSTEM=1; ",
            "env PATH=\"", path, "\" SMITH_NVIM_TEST=", name,
            " SMITH_REPO=\"$SMITH_REPO\" SMITH_PROJECT=\"$d/project\" SMITH_ALONE=\"$d/alone\" "
            "SMITH_NEW=\"$d/new/hello\" "
            "SMITH_BROKEN=\"$d/new/broken\" SMITH_FRESH=\"$d/new/fresh\" \"$nvim\" --headless -u NONE -i NONE --cmd "
            "\"set runtimepath^=$SMITH_REPO\" --cmd \"filetype on\" --cmd \"let g:smith_no_version_check = 1\" ",
            start->extra,
            " --cmd \"runtime plugin/smith.lua\" -c \"lua vim.api.nvim_create_autocmd('VimEnter', {once = true, "
            "callback = "
            "function() vim.schedule(function() dofile('$SMITH_REPO/tests/neovim.lua') end) end})\" 2>&1")
            .data;
    scratch::Run run = scratch::sh(&p, command);
    if (run.status != 0 || !scratch::contains(run.out, "ok  ")) {
        test::note("%s (status %d)\n%s", name, run.status, run.out);
    }
    scratch::expect_status(format::push(&io->arena, "neovim: ", name).data, 0, &run);
    scratch::expect_contains(format::push(&io->arena, "neovim: ", name, " says ok").data, run.out, "ok  ");
}

// The usual: the smith under test first on PATH.
static void plain(io::Io *io, const char *name, const char *extra) {
    Start start = {.before = "", .front = "", .bare = false, .needs_git = false, .data = "data", .extra = extra};
    nvim(io, name, &start);
}

