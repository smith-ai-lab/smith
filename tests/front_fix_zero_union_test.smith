// A field tested only through the member of a payload enum is an option for the file that declares it and for every
// file that imports it (#3621). The importer reads the module as it is on disk, so it decides from the text as written,
// where the test is `node.pat->constant != nullptr` and `node` is a `Node`, not a struct: the declaring file reaches
// the same decision only after its own passes have rewritten the test.
module front_fix_zero_union_test;

import front::fix;
import std::arena;
import <unistd.h>;
import std::files;
import std::mem;
import std::test;

static void check_text(Str got, Str want) {
    test::check_equal(got, want);
}

static Bool has(Str text, Str part) {
    for (Usize i = 0; i + countof(part) <= countof(text); i++) {
        if (mem::equal(text[i:i + countof(part)], part)) return true;
    }
    return false;
}

static Str read_text(Str path) {
    files::BytesResult back = files::read_file(path);
    switch (back) {
    case .error:
        return "";
    case .ok:
        files::Bytes bytes = back.ok;
        char chars[:] = mem::view(bytes, char);
        Str got = chars;
        return got;
    }
}

export void test_front_fix_zero_union_a_field_tested_through_a_union_member_is_an_option_in_an_importer() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str module_path = "/tmp/front_fix_zero_union_ast.smith";
    Str user_path = "/tmp/front_fix_zero_union_user.smith";
    test::check_equal(fix::store(module_path, "module front_fix_zero_union_ast;\n"
                                              "export struct Pat {\n    Pat *constant;\n    int v;\n};\n"
                                              "export typedef enum {\n    Pat *pat;\n    absent;\n} Node;\n"
                                              "export Pat make(int v) {\n    return (Pat){.v = v};\n}\n"
                                              "export int has(Node node) {\n"
                                              "    if (node == .pat) {\n"
                                              "        if (node.pat->constant != nullptr) return 1;\n"
                                              "    }\n    return 0;\n}\n"),
                      true);
    test::check_equal(fix::store(user_path, "module front_fix_zero_union_user;\nimport front_fix_zero_union_ast;\n"
                                            "struct Holder {\n    const front_fix_zero_union_ast::Pat *pat;\n};\n"
                                            "export int count(const Holder *h) {\n"
                                            "    if (h->pat->constant == nullptr) return 0;\n"
                                            "    return 1;\n}\n"),
                      true);
    const char *paths[1] = {user_path.data};
    (void)fix::fix_run(paths, 1);
    check_text(read_text(user_path), "import front_fix_zero_union_ast\n"
                                     "struct Holder:\n    pat: *front_fix_zero_union_ast.Pat\n"
                                     "pub fn count(h: *Holder) -> i32:\n"
                                     "    if h.pat.constant == .none:\n"
                                     "        return 0\n"
                                     "    return 1\n");
    // the declaring file reaches the same decision
    const char *own[1] = {module_path.data};
    (void)fix::fix_run(own, 1);
    Str fixed = read_text(module_path);
    check_text(fixed, "pub struct Pat:\n    pub constant: ?*Pat = .none\n    pub v: i32\n"
                      "pub enum Node:\n    pat: *Pat\n    absent\n"
                      "pub fn make(v: i32) -> Pat:\n    return Pat(v = v)\n"
                      "pub fn has(node: Node) -> i32:\n    if .pat(pat) := node:\n"
                      "        if pat.constant != .none:\n            return 1\n    return 0\n");
}

// A name that starts a line is a statement, not a by-value declaration (#3621): in `total += n.value` / `n = n.next`
// the word before `n` ends the line above and is not `n`'s type. A walk over a list tests the local `n`, so `next` is
// an option in the declaring file, when another file of the tree leaves it out.
export void test_front_fix_zero_union_a_statement_is_not_a_by_value_declaration() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    char home[4096];
    test::check(c::getcwd(home, sizeof home) != nullptr);
    (void)files::make_folder("/tmp/front_fix_zero_walk_tree");
    (void)files::make_folder("/tmp/front_fix_zero_walk_tree/geo");
    test::check(fix::store("/tmp/front_fix_zero_walk_tree/main.smith",
                           "module main;\n"
                           "\n"
                           "import <stdio.h>;\n"
                           "import geo::shapes;\n"
                           "\n"
                           "extern I32 user(void); // C names the same types (user.c)\n"
                           "\n"
                           "I32 main() {\n"
                           "    shapes::Point p = shapes::make(1, 2);\n"
                           "    shapes::Node b = {.value = 3};\n"
                           "    shapes::Node a = {.next = &b, .value = 4};\n"
                           "    struct shapes::Point q = p; // the keyword still works\n"
                           "    shapes::Shape s = shapes::round_at(q);\n"
                           "    shapes::Color c = shapes::next(shapes::red);\n"
                           "    c::printf(\"%g %g %d %d %d\\n\", p.x, p.y, shapes::sum(&a), s == .circle, (int)c);\n"
                           "    return user();\n"
                           "}\n"));
    test::check(fix::store("/tmp/front_fix_zero_walk_tree/geo/shapes.smith",
                           "module geo::shapes;\n"
                           "\n"
                           "export struct Point {\n"
                           "    F32 x;\n"
                           "    F32 y;\n"
                           "};\n"
                           "\n"
                           "export struct Node {\n"
                           "    Node *next;\n"
                           "    I32 value;\n"
                           "};\n"
                           "\n"
                           "export enum Color { red, green };\n"
                           "\n"
                           "export enum Shape {\n"
                           "    Point circle;\n"
                           "    empty;\n"
                           "};\n"
                           "\n"
                           "struct Hidden {\n"
                           "    I32 secret;\n"
                           "};\n"
                           "\n"
                           "export Point make(F32 x, F32 y) {\n"
                           "    Hidden h = {.secret = 1};\n"
                           "    return (Point){.x = x + (F32)h.secret - 1, .y = y};\n"
                           "}\n"
                           "\n"
                           "export I32 sum(Node *list) {\n"
                           "    I32 total = 0;\n"
                           "    for (Node *n = list; n != nullptr; n = n->next)\n"
                           "        total += n->value;\n"
                           "    return total;\n"
                           "}\n"
                           "\n"
                           "export Shape round_at(Point p) {\n"
                           "    return {.circle = p};\n"
                           "}\n"
                           "\n"
                           "export Color next(Color c) {\n"
                           "    return c == red ? green : red;\n"
                           "}\n"));
    test::check_equal(c::chdir("/tmp/front_fix_zero_walk_tree"), 0);
    const char *paths[1] = {"geo/shapes.smith"};
    (void)fix::fix_run(paths, 1);
    test::check_equal(c::chdir(home), 0);
    Str fixed_text = read_text("/tmp/front_fix_zero_walk_tree/geo/shapes.smith");
    test::check(has(fixed_text, "    pub next: ?*Node = .none\n"));
    // the walk assigns that option to its local, which holds it too
    test::check(has(fixed_text, "mut n: ?*Node = list"));
    test::check(has(fixed_text, "n = n.next"));
}
