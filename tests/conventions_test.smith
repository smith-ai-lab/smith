// #812: a project with no build.c once wrote a trailing comma, so the editor's strict parse refused the file. A real
// JSON parser (python3, on every machine that runs these tests) reads it and finds an entry for main.c.
export void test_conventions_compile_commands_of_a_project_with_no_build_file_is_json() {
    scratch::Project p = scratch::make("plain_json", "conv_plain");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = scratch::build(&p, "");
    scratch::expect_status("json: smith build", 0, &run);
    scratch::Run parsed =
        scratch::sh(&p, "python3 -I -c 'import json,sys; d = json.load(open(\".smith/compile_commands.json\")); "
                        "sys.exit(0 if any(e[\"file\"].endswith(\"main.c\") for e in d) else 3)' 2>&1");
    scratch::expect_status("json: .smith/compile_commands.json parses and lists main.c", 0, &parsed);
    if (parsed.status != 0) {
        test::note("json: the file is:\n%s\nparser said: %s", scratch::read(&p, ".smith/compile_commands.json"),
                   parsed.out);
    }
}

// --- 6. several programs, the defaults every program shares, folders' flags, includes found through -I
// -----------------

// One project for the build, the tool and the profiles, the flags, the build API and the tests: each used to be a test
// of its own with a project of its own, and each of those spent about 2 CPU-s building the build program. The
// assertions are the same.
export void test_conventions_multi_builds_runs_tests_and_reads_the_defaults() {
    scratch::Project p = scratch::make("multi", "conv_multi");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = scratch::build(&p, "");
    scratch::expect_status("multi: smith build", 0, &run);
    scratch::expect_text("multi: builds the project's program", "yes",
                         yes_no(scratch::exists(&p, "build/debug/multi")));
    scratch::expect_text("multi: ... and not the tool", "no", yes_no(scratch::exists(&p, "build/debug/tool")));
    scratch::expect_text("multi: smith run runs the program, found through -I", "21", last_line(&p, "smith run"));
    scratch::expect_text("multi: ... after the file its folder's compiles wait for was made", "yes",
                         yes_no(scratch::exists(&p, "build/gen.h")));

    const char *info = scratch::read(&p, "info.txt");
    scratch::expect_contains("multi: build::sources", info, "sources: src/base/value.c");
    scratch::expect_contains("multi: build::objects", info, "build/release/src/base/value.o");
    scratch::expect_contains("multi: build::profile_flags: the profile's own", info,
                             "-O2 -DNDEBUG -Wno-unused-variable -Wno-unused-but-set-variable -Wno-unused-function "
                             "-flto=thin -I src");
    scratch::expect_contains("multi: build::profile_link_flags", info, "link: -flto=thin -Wl,-rpath,/opt/multi");
    scratch::expect_contains("multi: build::source_flags: the folder's", info, "-DFROM_BASE=1");

    scratch::Run compile = scratch::build(&p, "-t commands build/release/src/base/value.o");
    scratch::expect_contains("multi: release compiles to ThinLTO", compile.out, "-flto=thin");
    scratch::Run link = scratch::build(&p, "-t commands build/release/multi");
    scratch::expect_contains("multi: ... and links with it", link.out, "-flto=thin");
    scratch::expect_contains("multi: ... and with the defaults' link flags", link.out, "-Wl,-rpath,/opt/multi");
    scratch::Run folder = scratch::build(&p, "-t commands build/debug/src/base/value.o");
    scratch::expect_contains("multi: a folder's flags reach its sources", folder.out, "-DFROM_BASE=1");
    scratch::Run main = scratch::build(&p, "-t commands build/debug/main.o");
    scratch::expect_lacks("multi: ... and no others", main.out, "FROM_BASE");

    scratch::Run tested = scratch::sh(&p, "smith test");
    scratch::expect_status("multi: smith test passes", 0, &tested);
    scratch::expect_contains("multi: ... the helper a test includes is linked", tested.out, "1 passed");
    scratch::expect_text("multi: ... and a helper nothing includes is compiled", "yes",
                         yes_no(scratch::exists(&p, "build/debug/tests/lonely.o")));

    (void)scratch::build(&p, "tools");
    scratch::expect_text("multi: smith build tools builds the tool", "yes",
                         yes_no(scratch::exists(&p, "build/debug/tool")));
    (void)scratch::build(&p, "release fast");
    scratch::expect_text("multi: release and fast build every program", "yes",
                         yes_no(scratch::exists(&p, "build/release/tool")));
    scratch::expect_text("multi: ... the fast one too", "yes", yes_no(scratch::exists(&p, "build/fast/tool")));
}

// Two programs may share a source only with the same flags.
export void test_conventions_multi_the_same_source_with_different_flags() {
    scratch::Project p = scratch::make("multi", "conv_multi");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write(&p, "build.c",
                   "#include <smith/build.h>\n"
                   "\n"
                   "void build(SmithBuild *b) {\n"
                   "    smith_defaults(b, &(SmithDefaults){.flags = smith_list(b, \"-I\", \"src\", nullptr)});\n"
                   "    smith_app(b, &(SmithApp){});\n"
                   "    smith_app(b, &(SmithApp){.entry = \"tools/tool.c\", .name = \"tool\", "
                   ".flags = smith_list(b, \"-DX=1\", nullptr)});\n"
                   "}\n");
    scratch::Run run = scratch::build(&p, "");
    scratch::expect_status("multi: the same source with different flags: status 2", 2, &run);
    scratch::expect_contains("multi: ... names the source", run.err,
                             "src/base/value.c is compiled twice with different flags");
}

export void test_conventions_multi_smith_defaults_after_smith_app_is_refused() {
    scratch::Project p = scratch::make("multi", "conv_multi");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write(&p, "build.c",
                   "#include <smith/build.h>\n"
                   "\n"
                   "void build(SmithBuild *b) {\n"
                   "    smith_app(b, &(SmithApp){});\n"
                   "    smith_defaults(b, &(SmithDefaults){});\n"
                   "}\n");
    scratch::Run run = scratch::build(&p, "");
    scratch::expect_contains("multi: smith_defaults after smith_app is refused", run.err,
                             "smith_defaults comes before smith_app");
}

// --- 7. property tests in a .smith file: the key is written c::SmithKey, random::Key or through an alias
// ---------------

export void test_conventions_keys_random_key_and_an_aliases_key_are_property_tests() {
    scratch::Project p = scratch::make("keys", "conv_keys");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = scratch::sh(&p, "smith test");
    scratch::expect_status("keys: random::Key and an alias's Key are property tests: smith test passes", 0, &run);
    scratch::expect_contains("keys: ... all three tests ran", run.out, "3 passed");
}
