export void test_conventions_c_smith_lint_reads_the_builds_compiles() {
    scratch::Project p = scratch::make("calc", "conv_calc");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, ".clang-tidy", ".clang-tidy");
    scratch::copy_tree(&p, ".clang-format", ".clang-format");
    scratch::Run run = scratch::sh(&p, "smith lint");
    scratch::expect_status("c: smith lint reads the build's compiles", 0, &run);
}

// The same two calls in a build.c are the same build: the same commands for every target.
export void test_conventions_explicit_the_same_two_calls_in_a_build_c_are_the_same_build() {
    scratch::Project p = scratch::make("calc", "conv_calc");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write(&p, "build.c",
                   "#include <smith/build.h>\n"
                   "\n"
                   "void build(SmithBuild *b) {\n"
                   "    smith_app(b, &(SmithApp){});\n"
                   "    smith_app_tests(b, &(SmithAppTests){});\n"
                   "}\n");
    constexpr char commands[_] =
        "smith build -t commands build/debug/calc build/release/calc build/fast/calc build/tests";
    const char *explicit_commands = scratch::capture(&p, commands);
    scratch::Run run = scratch::sh(&p, "smith test");
    scratch::expect_status("explicit: the two calls in a build.c: smith test passes", 0, &run);
    (void)scratch::sh(&p, "rm build.c && rm -rf .smith build");
    scratch::expect_text("explicit: ... give the commands of no build file", explicit_commands,
                         scratch::capture(&p, commands));
}

// .checked_allocator (issue #239): Off runs the tests with --unchecked, the default does not.
export void test_conventions_explicit_checked_allocator_off_runs_the_tests_unchecked() {
    scratch::Project p = scratch::make("calc", "conv_calc");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write(&p, "build.c",
                   "#include <smith/build.h>\n"
                   "\n"
                   "void build(SmithBuild *b) {\n"
                   "    smith_app(b, &(SmithApp){});\n"
                   "    smith_app_tests(b, &(SmithAppTests){.checked_allocator = SmithSetting_Off});\n"
                   "}\n");
    scratch::expect_text("checked_allocator: Off passes --unchecked to the runner", "1",
                         scratch::capture(&p, "smith build -t commands test | grep -c -e '--unchecked'"));
    scratch::write(&p, "build.c",
                   "#include <smith/build.h>\n"
                   "\n"
                   "void build(SmithBuild *b) {\n"
                   "    smith_app(b, &(SmithApp){});\n"
                   "    smith_app_tests(b, &(SmithAppTests){});\n"
                   "}\n");
    scratch::expect_text("checked_allocator: the default does not", "0",
                         scratch::capture(&p, "smith build -t commands test | grep -c -e '--unchecked' || true"));
}

