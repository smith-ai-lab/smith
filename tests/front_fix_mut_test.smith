// Tests of the checker's fix-its (#1516, M1 of #1428): `smith lint --fix` adds `mut` to a name that is assigned and
// `*mut` to a pointer that is written through, from the checker's own errors, in the same passes as the parse fixes.
// A second run applies nothing and the checker reports nothing.
module front_fix_mut_test;

import front::fix;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;

// Runs `body` with an arena as the current allocator.
static Str fixed(Str source, Usize *count) {
    Str file = "t.smith";
    fix::Fixed result = fix::fix_text(file, source);
    *count = result.applied;
    return result.text;
}

static Usize errors_in(Str source) {
    parser::Parsed parsed = fix::parse_for_fix("t.smith", source);
    if (countof(parsed.errors) != 0) return 1000;
    types::Checked checked = types_decl::check_module(&parsed.module, types::lp64());
    return checked.error_count;
}

static void expect(Str before, Str after, Usize applied) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Usize count = 0;
    Str got = fixed(before, &count);
    test::check_equal(got, after);
    test::check_equal(count, applied);
    Usize again = 0;
    Str twice = fixed(got, &again);
    test::check_equal(twice, after);
    test::check_equal(again, (Usize)0);
    test::check_equal(errors_in(after), (Usize)0);
}

export void test_front_fix_mut_an_assigned_local_gets_mut() {
    expect("fn f():\n    total := 0\n    total = total + 1\n", "fn f():\n    mut total := 0\n    total = total + 1\n",
           1);
}

export void test_front_fix_mut_an_assigned_parameter_gets_mut() {
    expect("fn f(n: i32):\n    n = 2\n", "fn f(mut n: i32):\n    n = 2\n", 1);
}

export void test_front_fix_mut_a_pointer_written_through_becomes_mut() {
    expect("fn f(p: *i32):\n    p.* = 1\n", "fn f(p: *mut i32):\n    p.* = 1\n", 1);
}

// A `*T` parameter handed to a function that takes `*mut T` (a C function whose pointer is not const) becomes `*mut T`.
export void test_front_fix_mut_a_pointer_passed_on_as_mut_becomes_mut() {
    expect("fn g(p: *mut i32):\n    p.* = 1\n\nfn f(p: *i32):\n    g(p)\n",
           "fn g(p: *mut i32):\n    p.* = 1\n\nfn f(p: *mut i32):\n    g(p)\n", 1);
}

// A `*T` field read and handed where `*mut T` is wanted: the field's declared type becomes `*mut T`.
export void test_front_fix_mut_a_field_passed_on_as_mut_becomes_mut() {
    expect("fn g(p: *mut i32):\n    p.* = 1\n\nstruct S:\n    p: *i32\n\nfn f(s: *S):\n    g(s.p)\n",
           "fn g(p: *mut i32):\n    p.* = 1\n\nstruct S:\n    p: *mut i32\n\nfn f(s: *S):\n    g(s.p)\n", 1);
}

export void test_front_fix_mut_a_pointer_to_a_constant_makes_it_mut_too() {
    expect("fn f():\n    x := 1\n    p := &x\n    p.* = 2\n", "fn f():\n    mut x := 1\n    p := &x\n    p.* = 2\n", 1);
}

// A name bound by a variant pattern is as writable as the variant's payload: `.item(p)` of a `*i32` payload handed
// where
// `*mut i32` is wanted makes the payload `*mut i32` (#2647).
export void test_front_fix_mut_a_pattern_bound_pointer_makes_its_payload_mut() {
    expect("fn g(p: *mut i32):\n    p.* = 1\n\nenum Node:\n    item: *i32\n    none\n\nfn f(n: Node):\n    if .item(p) "
           ":= n:\n        g(p)\n",
           "fn g(p: *mut i32):\n    p.* = 1\n\nenum Node:\n    item: *mut i32\n    none\n\nfn f(n: Node):\n    if "
           ".item(p) := n:\n        g(p)\n",
           1);
}

// The same through a `match` arm.
export void test_front_fix_mut_a_match_arm_bound_pointer_makes_its_payload_mut() {
    expect("fn g(p: *mut i32):\n    p.* = 1\n\nenum Node:\n    item: *i32\n    none\n\nfn f(n: Node):\n    match n:\n  "
           "      .item(p): g(p)\n        .none: return\n",
           "fn g(p: *mut i32):\n    p.* = 1\n\nenum Node:\n    item: *mut i32\n    none\n\nfn f(n: Node):\n    match "
           "n:\n        .item(p): g(p)\n        .none: return\n",
           1);
}

export void test_front_fix_mut_code_that_needs_nothing_is_left_alone() {
    expect("fn f(p: *mut i32):\n    mut n := 0\n    n = 2\n    p.* = n\n",
           "fn f(p: *mut i32):\n    mut n := 0\n    n = 2\n    p.* = n\n", 0);
}

// A C function-pointer declarator (#1743): the fix writes the function value as `Fn(R (A a))`, and the next passes drop
// the parameter name (#1957) and write the declaration, so the text is clean and a second run changes nothing.
export void test_front_fix_function_pointer_declarator_is_rewritten() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Usize count = 0;
    Str got = fixed("I32 (*f)(I32 x);\n", &count);
    Str want = "mut f: fn(i32) -> i32 = undefined\n";
    test::check_equal(got, want);
    Usize again = 0;
    Str twice = fixed(got, &again);
    test::check_equal(twice, want);
    test::check_equal(again, (Usize)0);
}

// A cast to a type keyword ends the statement at its line break (#1775): `(void)f(x);` is `f(x) as void`, and the next
// line starts a new statement instead of reading `expected ;`. The checker has its own say about the cast (#1775 only
// reads), so this checks the parse.
export void test_front_fix_mut_a_cast_to_void_ends_its_statement() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "fn f(n: i32) -> i32:\n    return n\nfn g():\n    f(1).to(void)\n    f(2).to(void)\n";
    parser::Parsed parsed = fix::parse_for_fix("t.smith", source);
    test::check_equal(countof(parsed.errors), (Usize)0);
}

// A pointer written `*T` on a local (#1899) becomes `*mut T`, and the constant it points at becomes `mut`.
export void test_front_fix_mut_a_written_pointer_local_becomes_mut() {
    expect("fn f() -> i32:\n    x: i32 = 0\n    q: *i32 = &x\n    q.* = 3\n    return x\n",
           "fn f() -> i32:\n    mut x: i32 = 0\n    q: *mut i32 = &x\n    q.* = 3\n    return x\n", 1);
}

// `&x` handed where a `*mut T` is wanted (#2368): the constant `x` becomes `mut x`, and its `*T` becomes `*mut T`.
export void test_front_fix_mut_an_address_argument_makes_the_local_mut() {
    expect("fn g(p: *mut *mut i32):\n    p.* = nullptr\nfn f():\n    q: *i32 = nullptr\n    g(&q)\n",
           "fn g(p: *mut *mut i32):\n    p.* = nullptr\nfn f():\n    mut q: *mut i32 = nullptr\n    g(&q)\n", 1);
}

// A local read-only pointer of a C loop, returned where `*mut T` is wanted (#2368): one run of the fixer writes the
// declaration in smith's syntax and then makes it `*mut T`, so a second run has nothing left.
export void test_front_fix_mut_a_c_loop_pointer_returned_becomes_mut() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Usize count = 0;
    Str got = fixed("struct R {\n    Usize x;\n    R *next;\n};\n\n"
                    "struct B {\n    void *buckets;\n};\n\n"
                    "R *find(const B *self) {\n    for (R *r = ((R **)self->buckets)[0]; r != nullptr; r = r->next)\n"
                    "        if (r->x == 1) return r;\n    return nullptr;\n}\n",
                    &count);
    Usize again = 0;
    Str twice = fixed(got, &again);
    test::check_equal(again, (Usize)0);
    test::check_equal(errors_in(got), (Usize)0);
    test::check_equal(twice, got);
}

// A fixed array handed where a bare pointer is wanted (C's decay, #2386): the fix writes the address of its first
// element.
export void test_front_fix_mut_an_array_passed_as_a_pointer_becomes_the_address_of_its_first_element() {
    expect(
        "fn g(p: *f64) -> f64:\n    return p.*\n\nfn f() -> f64:\n    xs: [3]f64 = [1.0, 2.0, 3.0]\n    return g(xs)\n",
        "fn g(p: *f64) -> f64:\n    return p.*\n\nfn f() -> f64:\n    xs: [3]f64 = [1.0, 2.0, 3.0]\n    return "
        "g(&xs[0])\n",
        1);
}

// A local written in today's syntax is mended in one run (#2386): the checker's `mut` needs the declaration in smith's
// own syntax, which the blocks pass writes last, so the fixer reads its own output once more.
export void test_front_fix_mut_a_local_of_todays_syntax_gets_mut_in_one_run() {
    expect("I32 f(I32 n) {\n    I32 total = 0;\n    total = total + n;\n    return total;\n}\n",
           "fn f(n: i32) -> i32:\n    mut total: i32 = 0\n    total = total + n\n    return total\n", 5);
}

// A `*T` parameter cast to `*mut U` (std.mem's `self: *Allocator` read as the `Checked` around it, #2427) becomes `*mut
// T`.
export void test_front_fix_mut_a_pointer_cast_to_mut_becomes_mut() {
    expect("struct A:\n    x: i32\n\nstruct B:\n    a: A\n\nfn f(p: *A) -> *mut B:\n    q: *mut B = p.cast(*mut B)\n   "
           " q\n",
           "struct A:\n    x: i32\n\nstruct B:\n    a: A\n\nfn f(p: *mut A) -> *mut B:\n    q: *mut B = p.cast(*mut "
           "B)\n    q\n",
           1);
}

// A local written `*mut *T` and given a `*mut *mut T` becomes `*mut *mut T`.
export void test_front_fix_mut_an_inner_pointer_of_a_local_becomes_mut() {
    expect("fn g(p: *mut *mut i32) -> *mut *mut i32:\n    p\n\nfn f(p: *mut *mut i32):\n    q: *mut *i32 = g(p)\n",
           "fn g(p: *mut *mut i32) -> *mut *mut i32:\n    p\n\nfn f(p: *mut *mut i32):\n    q: *mut *mut i32 = g(p)\n",
           1);
}

// A `Result` tested and left with `return made` (or `{.error = made.error}` under a loop) and then read twice as
// `made.ok`: one `ok` after the guard.
export void test_front_fix_mut_a_result_returned_whole_is_read_as_ok() {
    expect(
        "fn f(n: usize) -> Result(usize, usize):\n    .ok(n)\n\n"
        "fn g(n: usize) -> Result(usize, usize):\n    made: Result(usize, usize) = f(n)\n"
        "    if made == .error:\n        return made\n    a: usize = made.ok\n    b: usize = made.ok\n    .ok(a + b)\n",
        "fn f(n: usize) -> Result(usize, usize):\n    .ok(n)\n\n"
        "fn g(n: usize) -> Result(usize, usize):\n    ok := try f(n)\n"
        "    a: usize = ok\n    b: usize = ok\n    .ok(a + b)\n",
        2);
}

export void test_front_fix_mut_a_result_guard_in_a_loop_binds_ok() {
    expect("fn f(n: usize) -> Result(usize, usize):\n    .ok(n)\n\n"
           "fn g(n: usize) -> Result(usize, usize):\n    mut total: usize = 0\n    for i in range(0, n):\n"
           "        made: Result(usize, usize) = f(i)\n        if made == .error:\n            return made\n"
           "        total += made.ok\n        total += made.ok\n    .ok(total)\n",
           "fn f(n: usize) -> Result(usize, usize):\n    .ok(n)\n\n"
           "fn g(n: usize) -> Result(usize, usize):\n    mut total: usize = 0\n    for i in range(0, n):\n"
           "        ok := try f(i)\n        total += ok\n        total += ok\n    .ok(total)\n",
           2);
}

// The guard `if .error(error) := made: return .error(error)` (written by the first pass where the `try` was held back
// by old forms) followed by `made.ok` is `ok := try`, the same site as `if made == .error:`.
export void test_front_fix_mut_a_result_guard_in_pattern_form_is_a_try() {
    expect("fn f(n: usize) -> Result(usize, usize):\n    .ok(n)\n\n"
           "fn g(n: usize) -> Result(usize, usize):\n    made: Result(usize, usize) = f(n)\n"
           "    if .error(error) := made:\n        return .error(error)\n    a: usize = made.ok\n"
           "    b: usize = made.ok\n    .ok(a + b)\n",
           "fn f(n: usize) -> Result(usize, usize):\n    .ok(n)\n\n"
           "fn g(n: usize) -> Result(usize, usize):\n    ok := try f(n)\n"
           "    a: usize = ok\n    b: usize = ok\n    .ok(a + b)\n",
           2);
}
