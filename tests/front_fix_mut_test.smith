// Tests of the checker's fix-its (#1516, M1 of #1428): `smith lint --fix` adds `mut` to a name that is assigned and
// `*mut` to a pointer that is written through, from the checker's own errors, in the same passes as the parse fixes.
// A second run applies nothing and the checker reports nothing.
module front_fix_mut_test;

import front::fix;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;

// Runs `body` with an arena as the current allocator.
static Str fixed(Str source, Usize *count) {
    Str file = "t.smith";
    fix::Fixed result = fix::fix_text(file, source);
    *count = result.applied;
    return result.text;
}

static Usize errors_in(Str source) {
    parser::Parsed parsed = fix::parse_for_fix("t.smith", source);
    if (countof(parsed.errors) != 0) return 1000;
    types::Checked checked = types_decl::check_module(&parsed.module, types::lp64());
    return checked.error_count;
}

static void expect(Str before, Str after, Usize applied) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Usize count = 0;
    Str got = fixed(before, &count);
    test::check_equal(got, after);
    test::check_equal(count, applied);
    Usize again = 0;
    Str twice = fixed(got, &again);
    test::check_equal(twice, after);
    test::check_equal(again, (Usize)0);
    test::check_equal(errors_in(after), (Usize)0);
}

export void test_front_fix_mut_an_assigned_local_gets_mut() {
    expect("fn f():\n    total := 0\n    total = total + 1\n", "fn f():\n    mut total := 0\n    total = total + 1\n",
           1);
}

export void test_front_fix_mut_an_assigned_parameter_gets_mut() {
    expect("fn f(n: i32):\n    n = 2\n", "fn f(mut n: i32):\n    n = 2\n", 1);
}

export void test_front_fix_mut_a_pointer_written_through_becomes_mut() {
    expect("fn f(p: *i32):\n    p.* = 1\n", "fn f(p: *mut i32):\n    p.* = 1\n", 1);
}

export void test_front_fix_mut_a_pointer_to_a_constant_makes_it_mut_too() {
    expect("fn f():\n    x := 1\n    p := &x\n    p.* = 2\n", "fn f():\n    mut x := 1\n    p := &x\n    p.* = 2\n", 1);
}

export void test_front_fix_mut_code_that_needs_nothing_is_left_alone() {
    expect("fn f(p: *mut i32):\n    mut n := 0\n    n = 2\n    p.* = n\n",
           "fn f(p: *mut i32):\n    mut n := 0\n    n = 2\n    p.* = n\n", 0);
}

// A C function-pointer declarator (#1743): the fix writes the function value as `Fn(R (A a))`, and the next passes drop
// the parameter name (#1957) and write the declaration, so the text is clean and a second run changes nothing.
export void test_front_fix_function_pointer_declarator_is_rewritten() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Usize count = 0;
    Str got = fixed("I32 (*f)(I32 x);\n", &count);
    Str want = "mut f: fn(i32) -> i32 = undefined\n";
    test::check_equal(got, want);
    Usize again = 0;
    Str twice = fixed(got, &again);
    test::check_equal(twice, want);
    test::check_equal(again, (Usize)0);
}

// A cast to a type keyword ends the statement at its line break (#1775): `(void)f(x);` is `f(x) as void`, and the next
// line starts a new statement instead of reading `expected ;`. The checker has its own say about the cast (#1775 only
// reads), so this checks the parse.
export void test_front_fix_mut_a_cast_to_void_ends_its_statement() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "fn f(n: i32) -> i32:\n    return n\nfn g():\n    f(1).to(void)\n    f(2).to(void)\n";
    parser::Parsed parsed = fix::parse_for_fix("t.smith", source);
    test::check_equal(countof(parsed.errors), (Usize)0);
}

// A pointer written `*T` on a local (#1899) becomes `*mut T`, and the constant it points at becomes `mut`.
export void test_front_fix_mut_a_written_pointer_local_becomes_mut() {
    expect("fn f() -> i32:\n    x: i32 = 0\n    q: *i32 = &x\n    q.* = 3\n    return x\n",
           "fn f() -> i32:\n    mut x: i32 = 0\n    q: *mut i32 = &x\n    q.* = 3\n    return x\n", 1);
}
