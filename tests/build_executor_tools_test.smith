    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    refuses("twice", "build x: step\n  cmd = true\nbuild x: step\n  cmd = true\ndefault x", "",
            "multiple rules generate x");
}

export void test_build_executor_refuses_an_unknown_rule() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    refuses("rule", "build x: nothing\ndefault x", "", "unknown build rule");
}

export void test_build_executor_refuses_an_unknown_target() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    refuses("target", "build x: step\n  cmd = true\ndefault x", "nothere", "unknown target 'nothere'");
}

// 14g. What is kept between builds: a ninja tree is rebuilt once, a damaged log is never trusted.
export void test_build_executor_a_second_build_has_nothing_to_do_and_a_cut_log_line_is_not_read() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_state");
    defer scratch::clean(&p);
    (void)exec(&p, "");
    (void)exec(&p, "");
    scratch::expect_count("state: the second build has nothing to do", 1, scratch::lines(&p, "runs"));
    scratch::expect_contains("state: the log has its header", scratch::capture(&p, "head -n 1 .smith/.smith_log"),
                             "# smith log 1");
    scratch::expect_text("state: and a line for the output", "1",
                         scratch::capture(&p, "grep -c ' out$' .smith/.smith_log"));
    (void)scratch::sh(&p, "printf '0 0 0 0123456789abcdef ou' >>.smith/.smith_log");
    (void)exec(&p, "");
    scratch::expect_count("state: a line cut short is not read", 1, scratch::lines(&p, "runs"));
}

export void test_build_executor_a_log_of_another_version_or_no_log_runs_every_command() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_state");
    defer scratch::clean(&p);
    (void)exec(&p, "");
    (void)scratch::sh(&p, "printf '# smith log 2\\n' >.smith/.smith_log");
    (void)exec(&p, "");
    scratch::expect_count("state: a log of another version is not trusted", 2, scratch::lines(&p, "runs"));
    (void)exec(&p, "");
    scratch::expect_count("state: and is written again", 2, scratch::lines(&p, "runs"));
    (void)scratch::sh(&p, "rm .smith/.smith_log");
    (void)exec(&p, "");
    scratch::expect_count("state: no log means every command runs", 3, scratch::lines(&p, "runs"));
}

export void test_build_executor_a_changed_command_or_a_deleted_output_is_built_again() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_state");
    defer scratch::clean(&p);
    (void)exec(&p, "");
    (void)scratch::sh(&p, "sed -i.bak 's/echo ran/echo ran again/' build.ninja");
    (void)exec(&p, "");
    scratch::expect_count("state: a changed command reruns the step", 2, scratch::lines(&p, "runs"));
    (void)scratch::sh(&p, "rm out");
    (void)exec(&p, "");
    scratch::expect_count("state: a deleted output is built again", 3, scratch::lines(&p, "runs"));
}

export void test_build_executor_a_newer_input_is_built_again_and_a_newer_output_is_left_alone() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_state");
    defer scratch::clean(&p);
    (void)exec(&p, "");
    scratch::sleep(&p, 50);
    (void)scratch::sh(&p, "touch in");
    (void)exec(&p, "");
    scratch::expect_count("state: a newer input is built again", 2, scratch::lines(&p, "runs"));
    scratch::sleep(&p, 50);
    (void)scratch::sh(&p, "touch out");
    (void)exec(&p, "");
    scratch::expect_count("state: an output newer than its input is left alone", 2, scratch::lines(&p, "runs"));
}

static bool has_ninja(const scratch::Project *p) {
    return scratch::sh(p, "ninja --version").status == 0;
}

// A tree that ninja built has its own log, which smith does not read: the first smith build runs everything.
static scratch::Project ninja_tree() {
    scratch::Project p = scratch::make("p", "tail_ninja");
    scratch::write(&p, "input", "one\n");
    return p;
}

static scratch::Run build_with_ninja(const scratch::Project *p) {
    return scratch::sh(p, "SMITH_NINJA=\"$(command -v ninja)\" smith build");
}

static const char *status_and_output(const scratch::Project *p, const scratch::Run *run) {
    static char text[1024];
    (void)format::to(text, sizeof text, run->status, " ", scratch::read(p, "output"));
    return text;
}

export void test_build_executor_smith_ninja_runs_the_manifest_with_ninja() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = ninja_tree();
    defer scratch::clean(&p);
    if (!has_ninja(&p)) {
        return; // the checks of the SMITH_NINJA fallback need ninja
    }
    scratch::Run run = build_with_ninja(&p);
    scratch::expect_text("ninja: SMITH_NINJA runs the manifest with ninja", "0 one\n", status_and_output(&p, &run));
    scratch::expect_text("ninja: and ninja's own log is written", "yes", yes_no(&p, ".smith/.ninja_log"));
    scratch::expect_text("ninja: and smith's is not", "no", yes_no(&p, ".smith/.smith_log"));
}

export void test_build_executor_smith_takes_over_a_tree_ninja_built() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = ninja_tree();
    defer scratch::clean(&p);
    if (!has_ninja(&p)) {
        return; // the checks of the SMITH_NINJA fallback need ninja
    }
    (void)build_with_ninja(&p);
    scratch::write(&p, "input", "two\n");
    scratch::Run first = scratch::build(&p, "");
    scratch::expect_text("upgrade: the first smith build of a tree ninja built runs the command", "0 two\n",
                         status_and_output(&p, &first));
    scratch::Run second = scratch::build(&p, "");
    scratch::expect_contains("upgrade: then it has nothing to do", second.out, "no work to do");
    scratch::write(&p, "input", "three\n");
    scratch::Run again = build_with_ninja(&p);
    scratch::expect_text("upgrade: ninja can take over again, and builds what changed", "0 three\n",
                         status_and_output(&p, &again));
}
