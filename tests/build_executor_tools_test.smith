// The executor's tools, the manifests it refuses and what it keeps between builds, from tests/build.sh sections 14f and
// 14g: `smith --smith-exec <manifest>` with -t targets, commands, compdb, clean and cleandead, a damaged log that is
// never trusted, and a tree that ninja built (SMITH_NINJA).
module build_executor_tools_test;

import std::arena;
import std::mem;
import std::format;
import std::test;
import scratch;

static scratch::Run exec(const scratch::Project *p, const char *arguments) {
    char command[1024];
    (void)format::to(command, sizeof command, "smith --smith-exec build.ninja ", arguments);
    return scratch::sh(p, command);
}

static const char *yes_no(const scratch::Project *p, const char *name) {
    return scratch::exists(p, name) ? "yes" : "no";
}

// The two outputs of exec_tools: "app dir/one.o", each yes or no.
static const char *outputs(const scratch::Project *p) {
    static char text[16];
    (void)format::to(text, sizeof text, yes_no(p, "app"), " ", yes_no(p, "dir/one.o"));
    return text;
}

// 14f. The tools, and the manifests the executor refuses.
export void test_build_executor_output_folders_are_made_before_the_command_runs() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_tools");
    defer scratch::clean(&p);
    (void)exec(&p, "");
    scratch::expect_text("output folders: made before the command runs", "c", scratch::read(&p, "dir/one.o"));
}

export void test_build_executor_tools_list_targets_commands_and_the_compilation_database() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_tools");
    defer scratch::clean(&p);
    (void)exec(&p, "");
    scratch::expect_contains("tools: targets lists the roots", exec(&p, "-t targets").out, "all: phony");
    scratch::expect_contains("tools: targets all lists every output with its rule", exec(&p, "-t targets all").out,
                             "dir/one.o: cc");
    scratch::expect_text("tools: commands lists them in order",
                         "cp one.c dir/one.o; echo \"dir/one.o: one.c\" > dir/one.o.d\ncp dir/one.o app",
                         exec(&p, "-t commands app").out);
    scratch::Run compdb = exec(&p, "-t compdb cc");
    scratch::expect_contains("tools: compdb prints the JSON compilation database", compdb.out, "\"file\": \"one.c\"");
    scratch::expect_contains("tools: compdb names the output", compdb.out, "\"output\": \"dir/one.o\"");
    char directory[1024];
    (void)format::to(directory, sizeof directory, "\"directory\": \"", scratch::capture(&p, "pwd -P"), "\"");
    scratch::expect_contains("tools: compdb names the directory", compdb.out, directory);
    scratch::expect_contains("tools: an unknown tool names the known ones", exec(&p, "-t nothing").err,
                             "unknown tool 'nothing'");
}

export void test_build_executor_clean_removes_the_outputs_and_keeps_the_manifest() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_tools");
    defer scratch::clean(&p);
    (void)exec(&p, "");
    scratch::expect_contains("tools: clean says how many it removed", exec(&p, "-t clean").out, "Cleaning... 2 files.");
    scratch::expect_text("tools: clean removed the outputs", "no no", outputs(&p));
    scratch::expect_text("tools: and kept the manifest, a generator's output", "yes", yes_no(&p, "build.ninja"));
}

export void test_build_executor_clean_of_one_target_removes_only_what_it_needs() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_tools");
    defer scratch::clean(&p);
    (void)exec(&p, "");
    (void)exec(&p, "-t clean dir/one.o");
    scratch::expect_text("tools: clean of one target removes only what it needs", "yes no", outputs(&p));
}

export void test_build_executor_cleandead_removes_what_the_manifest_no_longer_makes() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_tools");
    defer scratch::clean(&p);
    (void)exec(&p, "");
    (void)scratch::sh(&p, "sed -i.bak '/^build app/,/^  cmd = cp dir/d' build.ninja");
    (void)scratch::sh(&p, "sed -i.bak 's/^build all: phony app/build all: phony dir\\/one.o/' build.ninja");
    scratch::expect_contains("tools: cleandead removes what the manifest no longer makes", exec(&p, "-t cleandead").out,
                             "Cleaning... 1 files.");
    scratch::expect_text("tools: and only that", "no yes", outputs(&p));
}

// A manifest the executor refuses: its reason on stderr and the status 1.
static void refuses(const char *name, const char *manifest, const char *argument, const char *reason) {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    char text[512];
    (void)format::to(text, sizeof text, "rule step\n  command = $cmd\n", manifest, "\n");
    scratch::write(&p, "build.ninja", text);
    scratch::Run run = exec(&p, argument);
    (void)format::to(text, sizeof text, "manifest: ", name, " is refused with its reason");
    scratch::expect_contains(text, run.err, reason);
    (void)format::to(text, sizeof text, "manifest: ... and the build fails (", name, ")");
    scratch::expect_status(text, 1, &run);
}

export void test_build_executor_refuses_a_dependency_cycle() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    refuses("cycle", "build a: step b\n  cmd = true\nbuild b: step a\n  cmd = true\ndefault a", "",
            "dependency cycle: a -> b -> a");
}

export void test_build_executor_refuses_a_missing_input_with_no_rule() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    refuses("missing", "build x: step nofile\n  cmd = true\ndefault x", "",
            "'nofile', needed by 'x', missing and no known rule to make it");
}

export void test_build_executor_refuses_two_rules_for_one_output() {
    arena::Arena memory = test::memory(1 << 26);
