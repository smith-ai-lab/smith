// Tests of a return type that is a call of a type function through a module (`arena.slice_of(T, n)`) and of a function
// named `type` (#1959, part of #1631): both parse in smith's own syntax without an error.
module front_parse_type_call_test;

import front::ast;
import front::parser;
import std::arena;
import std::mem;
import std::test;

// The first error of a file in smith's own syntax, or `no error`.
static Str first_error(Str source) {
    parser::Parsed parsed = parser::parse_new("x.smith", source);
    if (countof(parsed.errors) == 0) return "no error";
    return parsed.errors[0].message;
}

export void test_return_type_is_a_qualified_type_function() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "pub fn alloc_slice(T: type, dims: ...) -> arena.slice_of(T, countof(dims)):\n"
                 "    return undefined\n";
    Str got = first_error(source);
    Str want = "no error";
    test::check_equal(got, want);
}

export void test_function_named_type() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "pub fn type(p: *parser) -> *node:\n"
                 "    return undefined\n";
    Str got = first_error(source);
    Str want = "no error";
    test::check_equal(got, want);
}
