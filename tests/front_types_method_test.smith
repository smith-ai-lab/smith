// Tests of method calls in the checker (#1795 of #1793, #1428): `x.f(args)` is `f(x, args)`, or `f(&x, args)` when `f`
// takes a pointer, with `f` from the module that defines the type of `x` or from the current module. Each scenario is
// source text in smith's own syntax; the imported module is `lib.list`.
module front_types_method_test;

import front::ast;
import front::lex;
import front::parse;
import front::parse_decl;
import front::parse_expr;
import front::parse_stmt;
import front::parse_type;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;
import <string.h>;

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        Bool same = true;
        for (Usize k = 0; k < countof(needle); k++) {
            if (text[i + k] != needle[k]) {
                same = false;
                break;
            }
        }
        if (same) return true;
    }
    return false;
}

static Bool same(Str a, Str b) {
    return countof(a) == countof(b) && has(a, b);
}

static Str join(Str a, Str b) {
    char out[:] = mem::alloc_slice(char, countof(a) + countof(b));
    for (Usize i = 0; i < countof(a); i++) {
        out[i] = a[i];
    }
    for (Usize i = 0; i < countof(b); i++) {
        out[countof(a) + i] = b[i];
    }
    return out;
}

// A list type with a function that takes it by pointer and one that takes it by value, and a second module's type.
static Str list_source() {
    return "pub struct List {\n    pub count: i32\n}\n\n"
           "pub fn push(l: *mut List, x: i32) {\n    l.count += x\n}\n\n"
           "pub fn size(l: *List) -> i32 {\n    l.count\n}\n\n"
           "pub fn first(l: List) -> i32 {\n    l.count\n}\n\n"
           "pub fn make() -> List {\n    return List(count = 0)\n}\n\n"
           "pub struct Other {\n    n: i32\n}\n";
}

static const ast::Module *load(const char *name) {
    Str path = name[0:c::strlen(name)];
    if (!same(path, "lib.list")) return nullptr;
    parser::Parsed p = parser::parse_new("t.smith", list_source());
    test::check_equal(countof(p.errors), (Usize)0);
    ast::Module *copy = mem::alloc(ast::Module);
    *copy = p.module;
    return copy;
}

static types::Checked check_text(Str source) {
    parser::Parsed p = parser::parse_new("t.smith", source);
    test::check_equal(countof(p.errors), (Usize)0);
    return types_decl::check_module_with(&p.module, types::lp64(), load);
}

static Str errors_of(const types::Checked *r) {
    Str text = "";
    for (Usize i = 0; i < r->error_count; i++) {
        text = join(text, join(r->errors[i].message, "\n"));
    }
    return text;
}

static void clean(Str source) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_text(source);
    Str none = "";
    if (r.error_count > 0) test::check_equal(errors_of(&r), none);
    test::check_equal(r.error_count, (Usize)0);
}

static void fails(Str source, Str first, Str second) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_text(source);
    Str errors = errors_of(&r);
    Str one = "one error";
    if (r.error_count != 1) test::check_equal(errors, one);
    test::check_equal(r.error_count, (Usize)1);
    test::check_condition(has(errors, first));
    test::check_condition(has(errors, second));
}

static Str head() {
    return "import lib.list\n\n";
}

export void test_front_types_method_in_the_type_module_by_pointer() {
    clean(join(head(), "fn run() -> i32 {\n    mut xs := list.make()\n    xs.push(5)\n    xs.size()\n}\n"));
}

export void test_front_types_method_by_value_and_through_a_pointer() {
    clean(join(head(), "fn run(p: *list.List) -> i32 {\n    p.first() + p.size()\n}\n"));
}

export void test_front_types_method_in_the_current_module() {
    clean(join(head(), "fn twice(l: list.List) -> i32 {\n    l.count * 2\n}\n\n"
                       "fn run(l: list.List) -> i32 {\n    l.twice()\n}\n"));
}

export void test_front_types_method_on_a_built_in_type_is_current_module_only() {
    clean("fn triple(x: i32) -> i32 {\n    x * 3\n}\n\nfn run(n: i32) -> i32 {\n    n.triple()\n}\n");
}

export void test_front_types_method_arguments_are_checked() {
    fails(join(head(), "fn run(l: *mut list.List) {\n    l.push(true)\n}\n"), "Bool", "I32");
}

export void test_front_types_method_result_is_the_functions() {
    fails(join(head(), "fn run(l: list.List) -> str {\n    return l.first()\n}\n"), "I32", "Str");
}

export void test_front_types_method_that_is_missing_is_named() {
    fails(join(head(), "fn run(l: list.List) -> i32 {\n    l.nothing()\n}\n"), "has no method `nothing`",
          "this module");
}

export void test_front_types_method_of_another_type_is_not_a_method() {
    fails(join(head(), "fn run(o: list.Other) -> i32 {\n    o.first()\n}\n"), "does not take a", "first");
}

export void test_front_types_method_pointer_to_mut_needs_a_mut_base() {
    fails(join(head(), "fn run() {\n    xs := list.make()\n    xs.push(5)\n}\n"), "drops const", "");
}

export void test_front_types_method_a_field_and_a_function_of_one_name() {
    fails("struct S {\n    size: i32\n}\n\nfn size(s: S) -> i32 {\n    s.size\n}\n\nfn run(s: S) -> i32 {\n    "
          "s.size()\n}\n",
          "a field and a method of one type cannot share a name", "");
}

export void test_front_types_method_current_module_shadowing_the_type_module_is_an_error() {
    fails(
        join(head(), "fn first(l: list.List) -> i32 {\n    0\n}\n\nfn run(l: list.List) -> i32 {\n    l.first()\n}\n"),
        "would be ambiguous", "");
}

export void test_front_types_method_a_field_holding_a_function_is_called_as_before() {
    clean("struct S {\n    f: fn(i32) -> i32\n}\n\nfn run(s: S) -> i32 {\n    s.f(1)\n}\n");
}
