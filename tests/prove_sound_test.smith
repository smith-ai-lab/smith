// Soundness tests of `smith prove` (issue #64), from tests/prove_sound.sh (issue #292).
// 1. Run what was proved: tests/prove/sound/<case>.c is a harness that includes a case (or a library of smith) and
// calls
//    each function smith prove proves on random inputs that satisfy its smith_requires, under ASan and UBSan; a failed
//    ensures, invariant, assert or sanitizer report is a wrong "proved" (tests/prove/sound/sound.h). The test first
//    asks smith prove for `ok` on each function the harness lists on its `// proves:` line, so the harness tests what
//    was proved and not what merely compiles.
// 2. False claims: tests/prove/unsound/<case>.c holds functions whose contract is false, each with the input that
//    refutes it (`// unsound: <function> <text the refuting run prints>`). smith prove must fail the function and the
//    refuting run must die with the text.
// A test runs one harness or one corpus file on one seed of 2000 inputs, and with --full on 8 seeds of 50000 (about a
// minute; `smith build prove-sound-full`).
module prove_sound_test;

import std::arena;
import std::format;
import std::test;
import scratch;
import <string.h>;
import std::mem;

// The flags of the harnesses: the sanitizers, the includes of the library and of the raw lowering of two modules, and
// the files every harness links.
constexpr char cc_flags[_] = "-std=gnu23 -g -O0 -fsanitize=address,undefined -fno-sanitize-recover=all "
                             "-ftrivial-auto-var-init=pattern -I \"$SMITH_REPO/.smith/include\" -I lowered -w";
constexpr char cc_common[_] = "lib/trace.c lib/std/contract.smith";

// The files every harness links, in the project.
static void copy_common(const scratch::Project *p) {
    scratch::copy_tree(p, "tests/prove", "tests/prove"); // the harnesses include the programs beside them
    scratch::copy_tree(p, "lib", "lib");                 // the harnesses link its libraries and include its sources
    scratch::copy_tree(p, "runtime", "runtime");
}

// Two harnesses reach the modules' static functions by including their raw lowering (`smith cc --smith-lower`), made
// in process (issue #646).
static void lower_modules(const scratch::Project *p) {
    scratch::write_lowered(p, "lib/std/arena.smith", "lowered/arena_lowered.c");
    scratch::write_lowered(p, "lib/std/random.smith", "lowered/random_lowered.c");
}

// The values after `prefix` on each line of `text` that starts with it, joined by spaces.
static const char *directive(arena::Arena *memory, const char *text, const char *prefix) {
    usize prefix_length = c::strlen(prefix);
    const char *joined = "";
    for (const char *line = text; *line != '\0';) {
        usize length = 0;
        while (line[length] != '\n' && line[length] != '\0') {
            length++;
        }
        if (length >= prefix_length && c::strncmp(line, prefix, prefix_length) == 0) {
            const char *value = line + prefix_length;
            usize value_length = length - prefix_length;
            while (value_length > 0 && *value == ' ') {
                value++;
                value_length--;
            }
            char *copy = arena::push_slice(memory, char, value_length + 1).data;
            mem::copy(copy[0:value_length], value[0:value_length]);
            joined = format::push(joined, " ", copy).data;
        }
        line += length;
        if (*line == '\n') line++;
    }
    return joined;
}

// The word number `index` of a text separated by spaces, or nullptr.
static const char *word(arena::Arena *memory, const char *text, usize index) {
    usize at = 0;
    for (usize n = 0; n <= index; n++) {
        while (text[at] == ' ') {
            at++;
        }
        if (text[at] == '\0') return nullptr;
        usize start = at;
        while (text[at] != ' ' && text[at] != '\0') {
            at++;
        }
        if (n == index) {
            char *copy = arena::push_slice(memory, char, at - start + 1).data;
            mem::copy(copy[0:at - start], text[start:start + at - start]);
            copy[at - start] = '\0';
            return copy;
        }
    }
    return nullptr;
}

// The sources a harness links: a `.smith` module is copied (the header smith writes beside it is not written in the
// repository), anything else is named in the repository.
static const char *link_sources(arena::Arena *memory, const scratch::Project *p, const char *name, const char *links) {
    const char *sources = "";
    for (usize i = 0; word(memory, links, i) != nullptr; i++) {
        const char *source = word(memory, links, i);
        const char *kept = c::strncmp(source, "tests/prove/", 12) == 0 ? source + 12 : source;
        usize length = c::strlen(source);
        if (length > 6 && c::strcmp(source + length - 6, ".smith") == 0) {
            scratch::copy_tree(p, source, format::push(name, "/", kept).data);
            sources = format::push(sources, " ", name, "/", kept).data;
        } else {
            scratch::copy_tree(p, source, source);
            sources = format::push(sources, " ", source).data;
        }
    }
    return sources;
}

// The harness tests/prove/sound/<name>.c: smith prove says `ok` on each function it lists, then it is built under the
// sanitizers and run on the seeds.
static void sound(const char *name) {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena backing = test::memory(1U << 24);
    arena::Arena *memory = &backing;
    arena::ArenaAllocator allocator = arena::allocator(memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    lower_modules(&p);
    copy_common(&p);
    const char *source = format::push("tests/prove/sound/", name, ".c").data;
    scratch::copy_tree(&p, source, source);
    const char *text = scratch::read(&p, source);
    const char *proves = directive(memory, text, "// proves:");
    const char *files = directive(memory, text, "// prove-files:");
    const char *links = directive(memory, text, "// link:");
    const char *prove_files = c::strlen(files) > 0 ? files : source;
    const char *arguments = "";
    for (usize i = 0; word(memory, prove_files, i) != nullptr; i++) {
        scratch::copy_tree(&p, word(memory, prove_files, i), word(memory, prove_files, i));
        arguments = format::push(arguments, " ", word(memory, prove_files, i)).data;
    }
    scratch::Run proved = scratch::sh(
        &p, format::push("smith prove -v", arguments, " -- -I \"$SMITH_REPO/.smith/include\" -I lowered 2>&1").data);
    for (usize i = 0; word(memory, proves, i) != nullptr; i++) {
        const char *fn = word(memory, proves, i);
        if (!scratch::contains(proved.out, format::push("ok    ", fn, "  (").data)) {
            test::note("the prover does not prove %s any more (a harness tests what was proved):\n%s", fn, proved.out);
        }
        test::check_condition(scratch::contains(proved.out, format::push("ok    ", fn, "  (").data));
    }
    const char *sources = link_sources(memory, &p, name, links);
    scratch::Run built = scratch::sh(&p, format::push("mkdir -p ", name, " && smith cc ", cc_flags, " ", source,
                                                      sources, " ", cc_common, " -o ", name, "/run 2>&1")
                                             .data);
    scratch::expect_status("prove_sound: the harness builds", 0, &built);
    const char *seeds = test::full() ? "1 2 3 4 5 6 7 8" : "1";
    const char *count = test::full() ? "50000" : "2000";
    for (usize i = 0; word(memory, seeds, i) != nullptr; i++) {
        scratch::Run run =
            scratch::sh(&p, format::push("./", name, "/run ", word(memory, seeds, i), " ", count, " 2>&1").data);
        if (run.status != 0) {
            test::note("seed %s:\n%s", word(memory, seeds, i), run.out);
        }
        test::check_equal(run.status, 0);
    }
}

// The false claims of tests/prove/unsound/<name>.c: smith prove must fail each `unsound` function, and the run with
// that function's name must die with the text on its line.
static void unsound(const char *name) {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena backing = test::memory(1U << 24);
    arena::Arena *memory = &backing;
    arena::ArenaAllocator allocator = arena::allocator(memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    copy_common(&p);
    const char *source = format::push("tests/prove/unsound/", name, ".c").data;
    scratch::copy_tree(&p, source, source);
    const char *text = scratch::read(&p, source);
    scratch::Run proved =
        scratch::sh(&p, format::push("smith prove -v ", source, " -- -I \"$SMITH_REPO/.smith/include\" 2>&1").data);
    scratch::Run built =
        scratch::sh(&p, format::push("smith cc ", cc_flags, " ", source, " ", cc_common, " -o claims 2>&1").data);
    scratch::expect_status("prove_sound: the corpus builds", 0, &built);
    for (const char *line = text; *line != '\0';) {
        usize length = 0;
        while (line[length] != '\n' && line[length] != '\0') {
            length++;
        }
        if (c::strncmp(line, "// unsound", 10) == 0) {
            const char *colon = c::strchr(line, ':');
            usize kind_length = (usize)(colon - (line + 3));
            const char *rest = colon + 2;
            usize rest_length = length - (usize)(rest - line);
            char *claim = arena::push_slice(memory, char, rest_length + 1).data;
            mem::copy(claim[0:rest_length], rest[0:rest_length]);
            const char *function = word(memory, claim, 0);
            const char *expected = claim + c::strlen(function);
            while (*expected == ' ') {
                expected++;
            }
            if (kind_length == 7 && c::strncmp(line + 3, "unsound", 7) == 0) {
                const char *failed = format::push("FAIL  ", function, "  (").data;
                if (!scratch::contains(proved.out, failed)) {
                    test::note("%s: smith prove should fail it, and says: %s", function, proved.out);
                }
                test::check_condition(scratch::contains(proved.out, failed));
            }
            scratch::Run run = scratch::sh(&p, format::push("./claims ", function, " 2>&1").data);
            if (run.status == 0) {
                test::note("%s: the run that should refute it exits 0", function);
            }
            test::check_not_equal(run.status, 0);
            scratch::expect_contains(function, run.out, expected);
        }
        line += length;
        if (*line == '\n') line++;
    }
}

export void test_prove_sound_run_what_was_proved_alias() {
    sound("alias");
}

