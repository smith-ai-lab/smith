// Tests of array literals in the emitter (#1624 of #1428): `[1, 2, 3]` as a fixed array and as a slice over a hidden
// array, nested, widened, `[]`, and in a loop; from source text in smith's own syntax through the checker, front::emit
// and the JIT, with golden IR.
module front_emit_array_test;

import front::ast;
import front::emit;
import front::emit_jit;
import front::lex;
import front::parse;
import front::parse_decl;
import front::parse_expr;
import front::parse_stmt;
import front::parse_type;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;
import <llvm-c/Core.h>;
import <string.h>;

typedef I32 (*Nullary)();
typedef I32 (*Unary)(I32);

struct Scenario {
    arena::Arena memory;
    arena::ArenaAllocator allocator;
    parser::Parsed parsed;
    types::Checked checked;
};

static parser::Parsed parse_new(Str source) {
    parser::Parsed result = {};
    result.module.file = "t.smith";
    lex::Lexed lexed = lex::tokenize_new(source);
    switch (lexed) {
    case .ok:
        parse::Parser p = parse::make(lexed.ok, source);
        p.new_syntax = true;
        p.hooks.expression = parse_expr::expression;
        p.hooks.type = parse_type::type;
        p.hooks.statement = parse_stmt::statement;
        p.hooks.declaration = parse_decl::declaration;
        result.module = parse_decl::file(&p, "t.smith");
        result.errors = p.errors;
        break;
    case .error:
        Str expected = "no error";
        test::check_equal(lexed.error.message, expected);
    }
    return result;
}

static void begin(Scenario *s, Str source) {
    s->memory = test::memory(1U << 22);
    s->allocator = arena::allocator(&s->memory);
    mem::Allocator *outside = mem::set_allocator(&s->allocator.base);
    s->parsed = parse_new(source);
    test::check_equal(countof(s->parsed.errors), (Usize)0);
    s->checked = types_decl::check_module(&s->parsed.module, types::lp64());
    if (s->checked.error_count > 0) {
        Str none = "no error";
        test::check_equal(s->checked.errors[0].message, none);
    }
    test::check_equal(s->checked.error_count, (Usize)0);
    mem::set_allocator(outside);
}

static emit_jit::Jit start_jit() {
    emit_jit::JitResult started = emit_jit::start();
    test::check_equal(started == .ok, true);
    emit_jit::Jit host = {};
    if (started == .ok) host = started.ok;
    return host;
}

static Bool contains(const char *text, Str needle) {
    return text != nullptr && c::strstr(text, needle.data) != nullptr;
}

static Usize symbol_of(emit_jit::Jit *host, Str symbol) {
    emit_jit::AddressResult found = emit_jit::lookup(host, symbol);
    test::check_equal(found == .ok, true);
    Usize address = 0;
    if (found == .ok) address = found.ok;
    return address;
}

// Emits `source` into the JIT and returns the IR text (free with LLVMDisposeMessage), or null.
static char *emit_source(Str source, emit_jit::Jit *host, Scenario *s) {
    begin(s, source);
    c::LLVMContextRef context = c::LLVMContextCreate();
    emit::Options options = {};
    options.target = host->target;
    options.checked = &s->checked;
    emit::ModuleResult emitted = emit::module(context, &s->parsed.module, options);
    test::check_equal(emitted == .ok, true);
    char *text = nullptr;
    if (emitted == .ok) {
        text = c::LLVMPrintModuleToString(emitted.ok);
        emit_jit::BoolResult added = emit_jit::add(host, context, emitted.ok);
        test::check_equal(added == .ok, true);
    } else {
        Str none = "no error";
        test::check_equal(emitted.error.message, none);
    }
    return text;
}

export void test_front_emit_array_literal_fixed_nested_and_widened() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    emit_source("pub fn run() -> i32 {\n"
                "    primes: [4]i32 = [2, 3, 5, 7]\n"
                "    if primes[3] != 7 || primes[0] != 2 {\n        return 1\n    }\n"
                "    grid: [2][3]i64 = [[1, 2, 3], [4, 5, 6]]\n"
                "    if grid[1][2] != 6 || grid[0][1] != 2 {\n        return 2\n    }\n"
                "    wide: [3]i64 = [1, 2, 3]\n"
                "    if wide[2] != 3 {\n        return 3\n    }\n"
                "    inferred := [10, 20, 30]\n"
                "    if inferred[1] != 20 {\n        return 4\n    }\n"
                "    0\n}\n",
                &host, &s);
    Nullary run = (Nullary)symbol_of(&host, "run");
    test::check_equal(run(), (I32)0);
    emit_jit::stop(&host);
}

export void test_front_emit_array_literal_as_a_slice_has_its_array_in_the_entry_block() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    char *ir = emit_source(
        "fn total(xs: []i32) -> i32 {\n    mut sum := 0\n    for x in xs {\n        sum += x\n    }\n    sum\n}\n"
        "pub fn run() -> i32 {\n"
        "    kept: []i32 = [4, 5]\n"
        "    if total([1, 2, 3]) != 6 || total(kept) != 9 {\n        return 1\n    }\n"
        "    0\n}\n",
        &host, &s);
    test::check_equal(contains(ir, "alloca [3 x i32]"), true);
    test::check_equal(contains(ir, "alloca [2 x i32]"), true);
    if (ir != nullptr) c::LLVMDisposeMessage(ir);
    Nullary run = (Nullary)symbol_of(&host, "run");
    test::check_equal(run(), (I32)0);
    emit_jit::stop(&host);
}

export void test_front_emit_array_literal_empty_slice_and_each_turn_of_a_loop() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    emit_source(
        "fn total(xs: []i32) -> i32 {\n    mut sum := 0\n    for x in xs {\n        sum += x\n    }\n    sum\n}\n"
        "pub fn run() -> i32 {\n"
        "    empty: []i32 = []\n"
        "    if countof(empty) != 0 || total(empty) != 0 {\n        return 1\n    }\n"
        "    mut runs := 0\n"
        "    for i in range(0, 3) {\n        row := [i, i + 1]\n        runs += total(row)\n    }\n"
        "    if runs != 9 {\n        return 2\n    }\n"
        "    0\n}\n",
        &host, &s);
    Nullary run = (Nullary)symbol_of(&host, "run");
    test::check_equal(run(), (I32)0);
    emit_jit::stop(&host);
}

// The checker refuses `[]` with no type before the emitter sees it (the emitter's own Error is a guard).
export void test_front_emit_array_literal_empty_without_a_type_is_refused() {
    Scenario s = {};
    s.memory = test::memory(1U << 22);
    s.allocator = arena::allocator(&s.memory);
    mem::Allocator *outside = mem::set_allocator(&s.allocator.base);
    s.parsed = parse_new("pub fn run() -> i32 {\n    x := []\n    0\n}\n");
    s.checked = types_decl::check_module(&s.parsed.module, types::lp64());
    test::check_equal(s.checked.error_count > 0, true);
    mem::set_allocator(outside);
}
