// Tests of the fix-it for an option given to a pointer parameter that tests for null (#2648, front/fix_zero.smith).
module front_fix_zero_option_test;

import front::fix;
import std::arena;
import std::mem;
import std::test;

static void expect_fixed(Str before, Str want) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed first = fix::fix_text("t.smith", before);
    test::check_equal(first.text, want);
    fix::Fixed second = fix::fix_text("t.smith", first.text);
    test::check_equal(second.applied, (Usize)0);
}

export void test_front_fix_zero_option_a_field_given_to_a_parameter_that_tests_null_makes_it_an_option() {
    expect_fixed("module m;\nexport struct Node {\n    Node *next;\n    I32 v;\n};\n"
                 "static I32 count(const Node *n) {\n    if (n == nullptr) return 0;\n    return 1 + n->v;\n}\n"
                 "export Node make(I32 v) {\n    return (Node){.v = v};\n}\n"
                 "export I32 last(const Node *n) {\n    if (n->next == nullptr) return n->v;\n"
                 "    return last(n->next);\n}\n"
                 "export I32 f(const Node *n) {\n    return count(n->next);\n}\n",
                 "pub struct Node:\n"
                 "    pub next: ?*Node = .none\n"
                 "    pub v: i32\n"
                 "fn count(n: ?*Node) -> i32:\n"
                 "    if n == .none:\n"
                 "        return 0\n"
                 "    return 1 + n.v\n"
                 "pub fn make(v: i32) -> Node:\n"
                 "    return Node(v = v)\n"
                 "pub fn last(n: *Node) -> i32:\n"
                 "    if n.next == .none:\n"
                 "        return n.v\n"
                 "    return last(n.next)\n"
                 "pub fn f(n: *Node) -> i32:\n"
                 "    return count(n.next)\n");
}

// A local initialised from a field that a test above narrows keeps the narrowed type (#3621): the test is still
// `nullptr` when the read is checked, and the fix of the test is what narrows it on the next pass.
export void test_front_fix_zero_option_a_local_read_after_a_null_test_is_not_an_option() {
    expect_fixed("module m;\nexport struct Pat {\n    Pat *constant;\n    int v;\n};\n"
                 "export int has(const Pat *p) {\n    return p->constant != nullptr;\n}\n"
                 "export Pat make(void) {\n    return (Pat){.v = 1};\n}\n"
                 "export int use(const Pat *p) {\n    if (p->constant == nullptr) return 0;\n"
                 "    const Pat *e = p->constant;\n    return e->v;\n}\n",
                 "pub struct Pat:\n"
                 "    pub constant: ?*Pat = .none\n"
                 "    pub v: i32\n"
                 "pub fn has(p: *Pat) -> i32:\n"
                 "    return (p.constant != .none).to(i32)\n"
                 "pub fn make() -> Pat:\n"
                 "    return Pat(v = 1)\n"
                 "pub fn use(p: *Pat) -> i32:\n"
                 "    if p.constant == .none:\n"
                 "        return 0\n"
                 "    e: *Pat = p.constant\n"
                 "    return e.v\n");
}
