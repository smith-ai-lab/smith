// Tests of the fix-it for a local that C fills through its address (#2648): `mut` for `name: T = undefined` whose
// `&name` is taken later in the function.
module front_fix_const_test;

import front::fix_const;
import front::parse as core;
import std::arena;
import std::mem;
import std::test;

static void expect_inserts(Str source, Usize count, Usize at) {
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    core::Errors found = fix_const::edits(source);
    test::check_equal(countof(found), count);
    if (count > 0 && countof(found) > 0) {
        test::check_equal((Usize)found[0].span.start, at);
        Str word = "mut ";
        test::check_equal(found[0].fix[0].text, word);
    }
}

export void test_front_fix_const_an_undefined_local_whose_address_is_taken_is_mut() {
    expect_inserts("fn f(e: *state.Emitter) -> state.Ty:\n    ty: state.Ty = undefined\n"
                   "    state.scalar_type(e, \"Bool\", &ty)\n    return ty\n",
                   1, 41);
}

export void test_front_fix_const_a_local_whose_address_is_not_taken_stays() {
    expect_inserts("fn f() -> i32:\n    n: i32 = undefined\n    n = 3\n    return n\n", 0, 0);
}

export void test_front_fix_const_a_longer_name_is_not_the_local() {
    expect_inserts("fn f():\n    ty: i32 = undefined\n    g(&type)\n", 0, 0);
}

export void test_front_fix_const_a_mut_local_and_another_function_are_left() {
    expect_inserts("fn f():\n    mut ty: i32 = undefined\n    g(&ty)\nfn h():\n    g(&ty)\n", 0, 0);
}

export void test_front_fix_const_an_initialized_local_whose_field_address_is_taken_is_mut() {
    expect_inserts("fn f(s: str):\n    parsed: parser.Parsed = parser.parse_new(\"t\", s)\n"
                   "    types_decl.check_module(&parsed.module)\n",
                   1, 18);
}

export void test_front_fix_const_a_nullptr_out_parameter_local_is_mut() {
    expect_inserts("fn g(context: c.LLVMContextRef):\n    module: c.LLVMModuleRef = nullptr\n"
                   "    c.LLVMParseIRInContext(context, &module)\n",
                   1, 37);
}

export void test_front_fix_const_the_address_of_an_element_does_not_make_the_array_mut() {
    expect_inserts("fn f():\n    xs: [3]f64 = [1.0, 2.0, 3.0]\n    g(&xs[0])\n", 0, 0);
}
