// Tests of the C header the new front end writes (#1621): `compile::header` and `smith cc --front-end=new
// --smith-header`. The module is written in a scratch folder, its header compared byte for byte (a Linux triple and
// `arm64-apple-macosx`), linked from C, and the refusals checked.
module front_header_test;

import front::compile;
import front::roots;
import std::files;
import std::format;
import std::mem;
import std::process;
import std::test;
import <stdio.h>;
import <sys/stat.h>;
import <unistd.h>;

static Str as_str(char chars[:]) {
    return chars;
}

static const char *smith_path() {
    const char *self = c::getenv("SMITH_SELF");
    return self != nullptr ? self : "smith";
}

static Bool contains(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        if (roots::same(text[i:i + countof(needle)], needle)) return true;
    }
    return false;
}

static Str folder_for(Str name) {
    Str path = as_str(format::push("/tmp/front_header_", (I64)c::getpid(), "_", name));
    c::mkdir(path.data, 0o700);
    c::mkdir(as_str(format::push(path, "/src")).data, 0o700);
    c::mkdir(as_str(format::push(path, "/src/geometry")).data, 0o700);
    c::mkdir(as_str(format::push(path, "/include")).data, 0o700);
    c::mkdir(as_str(format::push(path, "/include/geometry")).data, 0o700);
    return path;
}

static void write_text(Str path, Str text) {
    c::FILE *file = c::fopen(path.data, "w");
    test::check_equal(file != nullptr, true);
    if (file == nullptr) return;
    c::fwrite(text.data, 1, countof(text), file);
    c::fclose(file);
}

static Str text_of(Str path) {
    files::BytesResult loaded = files::read_file(path);
    if (loaded == .error) return "";
    format::Chars chars = mem::view(loaded.ok, char);
    return chars;
}

static I32 sh_status(Str command) {
    const char *const argv[4] = {"sh", "-c", command.data, nullptr};
    process::OutputResult done = process::run(argv[0:3]);
    if (done != .ok || done.ok.exit.signal != 0) return -1;
    if (done.ok.exit.status != 0) {
        c::write(2, done.ok.errors.data, countof(done.ok.errors));
        c::write(2, done.ok.output.data, countof(done.ok.output));
    }
    return done.ok.exit.status;
}

static void remove_all(Str folder) {
    const char *const argv[4] = {"rm", "-rf", folder.data, nullptr};
    process::OutputResult done = process::run(argv[0:3]);
    test::check_equal(done == .ok, true);
}

// The stand-ins of the `smith_contract_fail_*` checks the object calls (as tests/front_emit_object_test.smith has
// them).
static Str stand_ins() {
    return as_str(format::push(
        "void smith_contract_fail_cast(unsigned long a, int b, const char *c) { __builtin_trap(); }\n",
        "void smith_contract_fail_index(unsigned long a, int b, unsigned long c) { __builtin_trap(); }\n",
        "void smith_contract_fail_overflow(const char *a, unsigned long b, unsigned long c, const char *d, ",
        "const char *e) { __builtin_trap(); }\n",
        "void smith_contract_fail_negate(unsigned long a, const char *b, const char *c) { __builtin_trap(); }\n",
        "void smith_contract_fail_divide(const char *a, unsigned long b, int c, const char *d) { __builtin_trap(); }\n",
        "void smith_contract_fail_shift(const char *a, unsigned long b, unsigned long c, int d, unsigned e, ",
        "const char *f, const char *g) { __builtin_trap(); }\n"));
}

static Str shapes_source() {
    return "pub struct Point:\n    x: f64\n    y: f64\n\n"
           "pub fn dot(a: *Point, b: *Point) -> f64:\n    a.x * b.x + a.y * b.y\n\n"
           "pub fn bump(p: *mut i64):\n    p.* = p.* + 1\n\n"
           "@c_name(\"shapes_count\")\npub fn count() -> u32:\n    3\n\n"
           "fn hidden() -> i32:\n    1\n";
}

static Str golden(Str label_prefix) {
    return as_str(format::push(
        "// clang-format off\n// Generated by smith from <dir>/src/geometry/shapes.smith. Do not edit.\n"
        "// clang-format on\n#pragma once\n#include <stddef.h>\n#include <stdint.h>\n#ifdef __cplusplus\n"
        "extern \"C\" {\n#endif\n"
        "typedef struct { double x; double y; } geometry_shapes_Point;\n\n"
        "double geometry_shapes_dot(const geometry_shapes_Point *a, const geometry_shapes_Point *b) __asm__(\"",
        label_prefix,
        "geometry::shapes::dot\");\n\n"
        "void geometry_shapes_bump(int64_t *p) __asm__(\"",
        label_prefix,
        "geometry::shapes::bump\");\n\n"
        "uint32_t shapes_count(void);\n#ifdef __cplusplus\n}\n#endif\n"));
}

// `<dir>` for the scratch folder, so a golden does not name it.
static Str with_dir(Str text, Str folder) {
    Str result = "";
    Str marker = "<dir>";
    Usize i = 0;
    while (i < countof(text)) {
        if (i + countof(marker) <= countof(text) && roots::same(text[i:i + countof(marker)], marker)) {
            result = as_str(format::push(result, folder));
            i += countof(marker);
        } else {
            result = as_str(format::push(result, text[i:i + 1]));
            i += 1;
        }
    }
    return result;
}

// The golden with the source named as the shell's command line names it (`src/geometry/shapes.smith`).
static Str replace_slash(Str text) {
    Str from = "from /src/geometry";
    Str result = "";
    Usize i = 0;
    while (i < countof(text)) {
        if (i + countof(from) <= countof(text) && roots::same(text[i:i + countof(from)], from)) {
            result = as_str(format::push(result, "from src/geometry"));
            i += countof(from);
        } else {
            result = as_str(format::push(result, text[i:i + 1]));
            i += 1;
        }
    }
    return result;
}

// The module with `i64` where it has `f64`.
static Str replace_f64(Str text) {
    Str result = "";
    Usize i = 0;
    while (i < countof(text)) {
        if (i + 3 <= countof(text) && roots::same(text[i:i + 3], "f64")) {
            result = as_str(format::push(result, "i64"));
            i += 3;
        } else {
            result = as_str(format::push(result, text[i:i + 1]));
            i += 1;
        }
    }
    return result;
}

static roots::Roots roots_of(Str folder) {
    return (roots::Roots){.source = as_str(format::push(folder, "/src")),
                          .library = as_str(format::push(folder, "/lib"))};
}

static Str shapes_path(Str folder) {
    return as_str(format::push(folder, "/src/geometry/shapes.smith"));
}

static Str header_path(Str folder) {
    return as_str(format::push(folder, "/include/geometry/shapes.h"));
}

export void test_front_header_linux_triple_golden() {
    Str folder = folder_for("linux");
    write_text(shapes_path(folder), shapes_source());
    compile::Report done =
        compile::header(shapes_path(folder), header_path(folder), "x86_64-unknown-linux-gnu", roots_of(folder));
    test::check_equal(done.ok, true);
    Str want = with_dir(golden(""), folder);
    Str got = text_of(header_path(folder));
    test::check_equal(got, want);
    remove_all(folder);
}

export void test_front_header_macos_triple_golden() {
    Str folder = folder_for("macos");
    write_text(shapes_path(folder), shapes_source());
    compile::Report done =
        compile::header(shapes_path(folder), header_path(folder), "arm64-apple-macosx", roots_of(folder));
    test::check_equal(done.ok, true);
    Str want = with_dir(golden("_"), folder);
    Str got = text_of(header_path(folder));
    test::check_equal(got, want);
    remove_all(folder);
}

// The header, the object and a C program that includes the one and links the other.
export void test_front_header_c_program_links_and_runs() {
    Str folder = folder_for("link");
    // f64 is not emitted yet (#1617 is not on main), so the program that links uses i64 fields.
    write_text(shapes_path(folder), replace_f64(shapes_source()));
    compile::Report header = compile::header(shapes_path(folder), header_path(folder), "", roots_of(folder));
    test::check_equal(header.ok, true);
    Str object = as_str(format::push(folder, "/shapes.o"));
    compile::Report built = compile::file(shapes_path(folder), object, "", roots_of(folder));
    test::check_equal(countof(built.text), 0);
    test::check_equal(built.ok, true);
    write_text(
        as_str(format::push(folder, "/main.c")),
        as_str(format::push(stand_ins(),
                            "#include \"geometry/shapes.h\"\n"
                            "int main(void) {\n"
                            "    geometry_shapes_Point a = {2, 3};\n"
                            "    geometry_shapes_Point b = {4, 5};\n"
                            "    int64_t n = 41;\n"
                            "    geometry_shapes_bump(&n);\n"
                            "    return geometry_shapes_dot(&a, &b) == 23 && n == 42 && shapes_count() == 3 ? 0 : 1;\n"
                            "}\n")));
    I32 linked = sh_status(as_str(format::push(smith_path(), " cc -I ", folder, "/include ", folder, "/main.c ", object,
                                               " -o ", folder, "/prog")));
    test::check_equal(linked, 0);
    if (linked == 0) test::check_equal(sh_status(as_str(format::push(folder, "/prog"))), 0);
    remove_all(folder);
}

export void test_front_header_an_option_parameter_is_an_error_and_writes_nothing() {
    Str folder = folder_for("option");
    write_text(shapes_path(folder), "pub fn f(o: ?i32) -> i32:\n    1\n");
    compile::Report done = compile::header(shapes_path(folder), header_path(folder), "", roots_of(folder));
    test::check_equal(done.ok, false);
    Str want = as_str(
        format::push(shapes_path(folder), ":1:10: error: `f` takes `?i32`, which has no C spelling in a header yet\n"));
    test::check_equal(done.text, want);
    test::check_equal(files::exists(header_path(folder)), false);
    remove_all(folder);
}

export void test_front_header_a_struct_by_value_is_an_error() {
    Str folder = folder_for("value");
    write_text(shapes_path(folder), "pub struct Point:\n    x: i64\n\npub fn dot(a: Point) -> i64:\n    a.x\n");
    compile::Report done = compile::header(shapes_path(folder), header_path(folder), "", roots_of(folder));
    test::check_equal(done.ok, false);
    Str want = as_str(format::push(shapes_path(folder),
                                   ":4:12: error: `dot` takes `Point` by value; C passes a struct by value by the "
                                   "target's ABI, which the emitter does not follow yet: take `*Point`\n"));
    test::check_equal(done.text, want);
    test::check_equal(files::exists(header_path(folder)), false);
    remove_all(folder);
}

export void test_front_header_a_file_in_todays_syntax_is_an_error() {
    Str folder = folder_for("today");
    write_text(shapes_path(folder), "module geometry::shapes;\n\nexport I32 one() {\n    return 1;\n}\n");
    compile::Report done = compile::header(shapes_path(folder), header_path(folder), "", roots_of(folder));
    test::check_equal(done.ok, false);
    Str want = as_str(format::push(
        shapes_path(folder), ": error: this file is in today's syntax; write its header without --front-end=new\n"));
    test::check_equal(done.text, want);
    test::check_equal(files::exists(header_path(folder)), false);
    remove_all(folder);
}

// A header whose bytes did not change is not written again: its modification time stays.
export void test_front_header_the_same_header_is_not_rewritten() {
    Str folder = folder_for("same");
    write_text(shapes_path(folder), shapes_source());
    compile::Report first = compile::header(shapes_path(folder), header_path(folder), "", roots_of(folder));
    test::check_equal(first.ok, true);
    // Read-only: a rewrite would fail to open the file, so `ok` would be false (st_mtimespec is macOS only).
    c::chmod(header_path(folder).data, 0o444);
    compile::Report second = compile::header(shapes_path(folder), header_path(folder), "", roots_of(folder));
    test::check_equal(second.ok, true);
    c::chmod(header_path(folder).data, 0o644);
    remove_all(folder);
}

// From a shell, in the folder that holds `src`: the same bytes through `smith cc --front-end=new --smith-header`.
export void test_front_header_the_driver_writes_the_same_header() {
    Str folder = folder_for("driver");
    write_text(shapes_path(folder), shapes_source());
    I32 status = sh_status(as_str(format::push("cd ", folder, " && ", smith_path(),
                                               " cc --front-end=new --smith-header src/geometry/shapes.smith -o ",
                                               "include/geometry/shapes.h --target=x86_64-unknown-linux-gnu")));
    test::check_equal(status, 0);
    Str want = with_dir(golden(""), as_str(format::push("")));
    Str got = text_of(header_path(folder));
    test::check_equal(got, replace_slash(want));
    remove_all(folder);
}

// `@when(cond)` on a function and on a field is `#if` in the header (#1801).
export void test_front_header_when_is_if() {
    Str folder = folder_for("when");
    Str source = "pub struct Point:\n    x: i64\n    @when(target.os == .macos)\n    y: i64\n\n"
                 "@when(target.os == .macos)\npub fn open_window() -> i64:\n    1\n\n"
                 "@when(target.os != .macos && target.os != .linux)\npub fn nothing() -> i64:\n    2\n\n"
                 "@when(target.os != .macos)\npub fn open_window() -> i64:\n    3\n";
    write_text(shapes_path(folder), source);
    compile::Report done =
        compile::header(shapes_path(folder), header_path(folder), "x86_64-unknown-linux-gnu", roots_of(folder));
    test::check_equal(done.ok, true);
    Str got = text_of(header_path(folder));
    Str want = "typedef struct { int64_t x; \n#if defined(__APPLE__)\nint64_t y; \n#endif\n} geometry_shapes_Point;\n";
    test::check_condition(contains(got, want));
    test::check_condition(contains(got, "#if defined(__APPLE__)\nint64_t geometry_shapes_open_window(void)"));
    test::check_condition(contains(got, "#if !defined(__APPLE__)\nint64_t geometry_shapes_open_window(void)"));
    test::check_condition(
        contains(got, "#if !defined(__APPLE__) && !defined(__linux__)\nint64_t geometry_shapes_nothing"));
    remove_all(folder);
}
