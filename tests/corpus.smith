// The report of a corpus test: it checks every case of its set, collects what differed, and fails once, naming each
// case that differed with its first differing line, so that one run shows every stale expectation and not only the
// first (#749).
module corpus;

import std::arena;
import std::format;
import std::files;
import std::mem;
import std::test;
import <string.h>;

constexpr usize shown_width = 60; // each side of a differing line is cut here

// `count` bytes of `from` copied to `to`.
static void copy_bytes(char *to, const char *from, usize count) {
    for (usize i = 0; i < count; i++)
        to[i] = from[i];
}

// The line of `text` that starts at `at`, cut at shown_width, in the arena.
static const char *line_at(arena::Arena *arena, const char *text, usize at) {
    usize length = 0;
    while (text[at + length] != '\0' && text[at + length] != '\n')
        length += 1;
    bool cut = length > shown_width;
    usize kept = cut ? shown_width : length;
    char *copy = arena::push_slice(arena, char, kept + 1).data;
    copy_bytes(copy, text + at, kept);
    copy[kept] = '\0';
    return cut ? format::push(copy, "...").data : copy;
}

// Nothing when `actual` is `expected`; else a line that names `what` and the first line that differs, with both
// sides. `expected` is null when the file is missing.
export const char *difference(arena::Arena *arena, const char *what, const char *expected, const char *actual) {
    if (expected == nullptr) return format::push(what, ": no file; run smith test --update\n").data;
    if (c::strcmp(expected, actual) == 0) return nullptr;
    usize at = 0;
    usize line = 1;
    usize start = 0;
    while (expected[at] != '\0' && expected[at] == actual[at]) {
        if (expected[at] == '\n') {
            line += 1;
            start = at + 1;
        }
        at += 1;
    }
    return format::push(what, ": line ", line, ": expected `", line_at(arena, expected, start), "` but got `",
                        line_at(arena, actual, start), "`\n")
        .data;
}

// The file at `path` (read through std::files), in the arena, or null.
export const char *read_file(arena::Arena *arena, const char *path) {
    files::BytesResult file = files::read_file(path[0:c::strlen(path)]);
    files::Bytes bytes = {};
    if (file == .ok) bytes = file.ok;
    if (file != .ok) return nullptr;
    usize size = countof(bytes);
    char *text = arena::push_slice(arena, char, size + 1).data;
    if (size > 0) copy_bytes(text, (const char *)bytes.data, size);
    text[size] = '\0';
    if (bytes.data != nullptr) mem::free(bytes.data);
    return text;
}

// `actual` against the golden file at `path`: appended to `differing` when it differs. Under `smith test --update`
// the file is written by test::golden, which passes.
export void golden(arena::Arena *arena, const char **differing, const char *path, const char *actual) {
    if (test::updating()) {
        test::golden(path[0:c::strlen(path)], actual[0:c::strlen(actual)]);
        return;
    }
    const char *found = difference(arena, path, read_file(arena, path), actual);
    if (found != nullptr) *differing = format::push(*differing, found).data;
}

// The end of the test: it fails once when any case differed, listing them all.
export void finish(const char *differing) {
    if (differing[0] == '\0') return;
    test::note("cases differ from their expected files:\n%s", differing);
    test::check(false);
}

// A file of sections, each opened by a line `==> name <==`: the section of `text` named `name` (its body, up to the
// next header or the end), or null.
static const char *section_of(arena::Arena *arena, const char *text, const char *name) {
    const char *header = format::push("==> ", name, " <==\n").data;
    const char *at = c::strstr(text, header);
    while (at != nullptr && at != text && at[-1] != '\n')
        at = c::strstr(at + 1, header);
    if (at == nullptr) return nullptr;
    const char *body = at + c::strlen(header);
    const char *next = c::strstr(body, "\n==> ");
    usize length = next != nullptr ? (usize)(next - body) + 1 : c::strlen(body);
    char *copy = arena::push_slice(arena, char, length + 1).data;
    copy_bytes(copy, body, length);
    copy[length] = '\0';
    return copy;
}

// A golden file of sections, one per case, against `actual`: each section that differs, is missing or is new is
// appended to `differing` under its case's name.
export void golden_sections(arena::Arena *arena, const char **differing, const char *path, const char *actual) {
    if (test::updating()) {
        test::golden(path[0:c::strlen(path)], actual[0:c::strlen(actual)]);
        return;
    }
    const char *expected = read_file(arena, path);
    if (expected == nullptr) {
        *differing = format::push(*differing, path, ": no file; run smith test --update\n").data;
        return;
    }
    for (const char *at = actual; at != nullptr; at = c::strstr(at + 1, "\n==> ")) {
        const char *header = at == actual ? at : at + 1;
        if (c::strncmp(header, "==> ", 4) != 0) continue;
        const char *end = c::strstr(header, " <==\n");
        if (end == nullptr) continue;
        usize length = (usize)(end - header) - 4;
        char *name = arena::push_slice(arena, char, length + 1).data;
        copy_bytes(name, header + 4, length);
        name[length] = '\0';
        const char *wanted = section_of(arena, expected, name);
        const char *found = wanted == nullptr ? format::push(name, ": not in ", path, "\n").data
                                              : difference(arena, name, wanted, section_of(arena, actual, name));
        if (found != nullptr) *differing = format::push(*differing, found).data;
    }
    for (const char *at = expected; at != nullptr; at = c::strstr(at + 1, "\n==> ")) {
        const char *header = at == expected ? at : at + 1;
        if (c::strncmp(header, "==> ", 4) != 0) continue;
        const char *end = c::strstr(header, " <==\n");
        if (end == nullptr) continue;
        usize length = (usize)(end - header) - 4;
        char *name = arena::push_slice(arena, char, length + 1).data;
        copy_bytes(name, header + 4, length);
        name[length] = '\0';
        if (section_of(arena, actual, name) == nullptr)
            *differing = format::push(*differing, name, ": expected, but no longer formatted\n").data;
    }
}
