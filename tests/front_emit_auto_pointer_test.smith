// Tests of a pointer to `auto` (`const auto *p`, `auto *p`) in the emitter (#3593, part of #1917): the template is
// instanced for the pointee type of the pointer the call passes, and the parameter's `const` is kept. Sources are
// today's syntax.
module front_emit_auto_pointer_test;

import front::ast;
import front::emit;
import front::emit_jit;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;
import <llvm-c/Core.h>;
import <string.h>;

typedef I32 (*Run)();

// Parses, checks, emits and runs `symbol`, as front_emit_auto_test.smith does; returns -1 when anything fails.
static I32 run(Str source, Str symbol) {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    parser::Parsed parsed = parser::parse_file("t.smith", source);
    test::check_equal(countof(parsed.errors), (Usize)0);
    ast::Module m = ast::new_module("front::test", parsed.module.decls);
    types::Checked checked = types_decl::check_module(&m, types::lp64());
    mem::set_allocator(outside);
    test::check_equal(checked.error_count, (Usize)0);
    emit_jit::JitResult started = emit_jit::start();
    test::check_equal(started == .ok, true);
    emit_jit::Jit host = {};
    if (started == .ok) host = started.ok;
    emit::Options options = {};
    options.target = host.target;
    options.checked = &checked;
    c::LLVMContextRef context = c::LLVMContextCreate();
    emit::ModuleResult emitted = emit::module(context, &m, options);
    test::check_equal(emitted == .ok, true);
    I32 result = -1;
    if (emitted == .ok) {
        emit_jit::BoolResult added = emit_jit::add(&host, context, emitted.ok);
        test::check_equal(added == .ok, true);
        emit_jit::AddressResult found = emit_jit::lookup(&host, symbol);
        test::check_equal(found == .ok, true);
        if (added == .ok && found == .ok) result = ((Run)found.ok)();
    }
    emit_jit::stop(&host);
    return result;
}

export void test_front_emit_auto_pointer_a_const_pointer_to_auto_takes_the_pointee_type() {
    Str source = "export I32 read(const auto *p) { return *p; }\n"
                 "export I32 run() {\n"
                 "    I32 a = 7;\n"
                 "    return read(&a);\n"
                 "}\n";
    test::check_equal(run(source, "front::test::run"), (I32)7);
}

export void test_front_emit_auto_pointer_a_mutable_pointer_to_auto_is_written_through() {
    Str source = "export void put(auto *p) { *p = 9; }\n"
                 "export I32 run() {\n"
                 "    I32 a = 7;\n"
                 "    put(&a);\n"
                 "    return a;\n"
                 "}\n";
    test::check_equal(run(source, "front::test::run"), (I32)9);
}

export void test_front_emit_auto_pointer_one_template_has_an_instance_for_each_pointee() {
    Str source = "export I32 read(const auto *p) { return (I32)*p; }\n"
                 "export I32 run() {\n"
                 "    I32 a = 7;\n"
                 "    U8 b = 5;\n"
                 "    return read(&a) + read(&b);\n"
                 "}\n";
    test::check_equal(run(source, "front::test::run"), (I32)12);
}
