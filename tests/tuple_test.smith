// Tests of tuples (issue #96), in smith's own test library: a struct whose fields have no names, returned, stored and
// passed as run-time values. The cases of the compiler's side (the lowering, the errors, the headers) are in
// tests/smith-lang/cases/tuple-*.
module tuple_test;

import std::test;

typedef struct { I32, F32 } Pair;

static struct { I32, F32 } make(I32 a, F32 b) {
    return {a, b};
}

static struct { I32, struct { F32, F32 } } nested() {
    return (struct { I32, struct { F32, F32 } }){7, {1.5f, 2.5f}};
}

static void bump(Pair *p) {
    (*p)[0] += 1;
    p->_1 *= 2.0f;
}

static I32 sum(Pair p) {
    return p[0] + (I32)p[1];
}

export void test_tuple_returned_from_a_function() {
    auto p = make(3, 4.5f);
    test::check_equal(p[0], 3);
    test::check_equal(p[1], 4.5f);
}

export void test_tuple_fields_are_written() {
    Pair p = make(1, 2.0f);
    p[0] = 10;
    p[1] += 0.5f;
    test::check_equal(p[0], 10);
    test::check_equal(p[1], 2.5f);
}

export void test_tuple_is_passed_by_value_and_by_pointer() {
    Pair p = make(2, 3.0f);
    test::check_equal(sum(p), 5);
    bump(&p);
    test::check_equal(p[0], 3);
    test::check_equal(p[1], 6.0f);
    test::check_equal(sum(p), 9); // the call before took a copy
}

export void test_tuple_nests() {
    auto n = nested();
    test::check_equal(n[0], 7);
    test::check_equal(n[1][0], 1.5f);
    test::check_equal(n[1][1], 2.5f);
    n[1][1] = 4.0f;
    test::check_equal(n[1][1], 4.0f);
}

export void test_tuple_has_a_count_and_the_size_of_a_struct() {
    Pair p = make(0, 0.0f);
    test::check_equal(countof(p), 2);
    test::check_equal(sizeof p, sizeof(struct { I32, F32 }));
    test::check_equal(countof(nested()[1]), 2);
}

export void test_tuples_of_one_shape_are_one_type() {
    struct { I32, F32 } a = make(4, 1.0f);
    Pair b = a;
    struct { I32, F32 } list[2] = {a, b};
    list[1][0] = 5;
    test::check_equal(list[0][0] + list[1][0], 9);
}
