// The corpus of the .smith language (tests/smith-lang/cases), run through the smith under test, which must have clang
// inside with the token hook. A case is a folder, and is one test here (`corpus_case(io, "name")`; a case added to the
// folder needs a test: `test_every_case_has_a_test` says which):
//   src/             the sources; module a.b is src/a/b.smith; src/main.smith (or main.c, main.cpp), if there, is
//   linked with
//                    the other .smith files and any .c or .cpp beside them (C++ as C++20), and run
//   expect/lower-error  the errors `smith cc --smith-lower` reports (it has no compiler, so a generic call whose type
//                    nothing writes is one); only a case with this file is checked
//   expect/stdout    what the program prints
//   expect/error     the errors the build must report, as `file:line:column: message`, one per line (the build must
//   fail) expect/lowered/  the C each file is lowered to (a.b.c), by `smith cc --smith-lower`: the lowering of the text
//   as
//                    written, with no macros and no parser (the build's own run is checked by the program, the symbols
//                    and the headers)
//   expect/header/   the generated header of each module (a.b.h)
//   expect/generics/ what the compile wrote for generic functions (a.b.c; SMITH_LANG_GENERICS): the calls, each as its
//                    statement expression, and the instances, in order. `--smith-lower` cannot show them, because it
//                    reads no header. Only a case with this folder is checked against it
//   expect/symbols   the symbols the objects define (nm -g), sorted
//   flags            extra compiler flags, if any
//   ask              types to ask the parser about at the end of each file (SMITH_LANG_ASK), and expect/ask its answers
//   cmd              the case is one command instead: `smith cc` with these arguments (@OUT@ is the case's scratch
//   folder,
//                    @REPO@ smith's own), run in src/ as a user would, with no flag of the harness's, so that smith's
//                    own defaults (the C2y standard, finding a module's source) are what is tested; the program, if the
//                    command made @OUT@/program, is run, and expect/stderr, if there, is the whole of the diagnostics
//   nostd            the case's compiles are given no -std (smith's default for a .smith file applies)
// Everything runs in the case's own folder (a copy in the test's scratch folder), so paths in messages are relative to
// it. The expectations are golden files: `smith test --update` writes what each case produced (read the diff).
module smith_lang_test;

import smith::arena;
import smith::format;
import smith::io;
import smith::test;
import <string.h>;
import scratch;
import smith::mem;

typedef struct {
    io::Io *io;
    const char *name;
    const scratch::Project *project;
} Case;

// What the compiles and the link made: 0 when all worked, and the objects (each after a space).
typedef struct {
    i32 status;
    const char *objects;
} Built;

static typeof(const char[:]) slice_of(const char *text) {
    return text[0:c::strlen(text)];
}

static const char *join(const Case *kase, const char *a, const char *b, const char *c, const char *d) {
    return format::push(&kase->io->arena, a, b, c, d).data;
}

// The next line of text, copied (a zero ends it), or nullptr at the end. `*at` moves past it.
static const char *next_line(io::Io *io, const char **at) {
    if (**at == '\0') return nullptr;
    const char *end = c::strchr(*at, '\n');
    usize length = end != nullptr ? (usize)(end - *at) : c::strlen(*at);
    char *copy = arena::push_slice(&io->arena, char, length + 1).data;
    const char *line = *at;
    mem::copy(copy[0:length], line[0:length]);
    *at += length + (end != nullptr ? 1 : 0);
    return copy;
}

// `a/b.smith` as the module `a.b`, `a/b` the stem.
static const char *module_of(io::Io *io, const char *file) {
    usize length = c::strlen(file);
    if (length > 6 && c::strcmp(file + length - 6, ".smith") == 0) length -= 6;
    char *copy = arena::push_slice(&io->arena, char, length + 1).data;
    for (usize i = 0; i < length; i++) {
        copy[i] = file[i] == '/' ? '.' : file[i];
    }
    return copy;
}

static const char *stem_of(io::Io *io, const char *file) {
    usize length = c::strlen(file);
    if (length > 6 && c::strcmp(file + length - 6, ".smith") == 0) length -= 6;
    char *copy = arena::push_slice(&io->arena, char, length + 1).data;
    mem::copy(copy[0:length], file[0:length]);
    return copy;
}

// The object of a file that is not a module: its path with the dots for slashes.
static const char *object_of(io::Io *io, const char *file) {
    usize length = c::strlen(file);
    char *copy = arena::push_slice(&io->arena, char, length + 1).data;
    for (usize i = 0; i < length; i++) {
        copy[i] = file[i] == '/' ? '.' : file[i];
    }
    return copy;
}

// The files a command lists, one a line.
static const char *listed(const Case *kase, const char *command) {
    return scratch::sh(kase->project, command).out;
}

// Every compile of the case, into out/.
static Built build_sources(const Case *kase) {
    io::Io *io = kase->io;
    const scratch::Project *p = kase->project;
    const char *flags = format::push(&io->arena, scratch::exists(p, "nostd") ? "" : "-std=gnu23",
                                     " -g0 -fno-color-diagnostics -Wno-unused-function -I out/include ",
                                     scratch::exists(p, "flags") ? scratch::capture(p, "cat flags") : "")
                            .data;
    const char *sources = listed(kase, "cd src && find . -name '*.smith' | sed 's|^\\./||' | LC_ALL=C sort");
    Built built = {.status = 0, .objects = ""};
    for (const char *at = sources, *file = next_line(io, &at); file != nullptr; file = next_line(io, &at)) {
        // the headers first, as the build will: no compile waits on another
        const char *stem = stem_of(io, file);
        const char *command =
            format::push(&io->arena, "mkdir -p \"out/include/$(dirname ", file, ")\" && smith cc --smith-header src/",
                         file, " -o out/include/", stem, ".h 2>>out/stderr; [ -f out/include/", stem,
                         ".h ] && cp out/include/", stem, ".h out/header/", module_of(io, file), ".h")
                .data;
        (void)scratch::sh(p, command);
    }
    const char *ask = scratch::exists(p, "ask") ? scratch::capture(p, "cat ask") : "";
    for (const char *at = sources, *file = next_line(io, &at); file != nullptr; file = next_line(io, &at)) {
        const char *module = module_of(io, file);
        const char *compile =
            format::push(&io->arena, "SMITH_LANG_GENERICS=out/generics/", module, ".c SMITH_LANG_ASK='", ask,
                         "' smith cc ", flags, " -c src/", file, " -o out/obj/", module, ".o 2>>out/stderr")
                .data;
        if (scratch::sh(p, compile).status != 0) built.status = 1;
        (void)scratch::sh(p, format::push(&io->arena, "smith cc --smith-lower src/", file, " >out/lowered/", module,
                                          ".c 2>>out/lower-stderr")
                                 .data);
        built.objects = format::push(&io->arena, built.objects, " out/obj/", module, ".o").data;
    }
    return built;
}

// The sources that are not modules (C and C++), compiled beside them, and the link and the run.
static void build_others(const Case *kase, Built *built) {
    io::Io *io = kase->io;
    const scratch::Project *p = kase->project;
    const char *flags = format::push(&io->arena, scratch::exists(p, "nostd") ? "" : "-std=gnu23",
                                     " -g0 -fno-color-diagnostics -Wno-unused-function -I out/include ",
                                     scratch::exists(p, "flags") ? scratch::capture(p, "cat flags") : "")
                            .data;
    const char *others =
        listed(kase, "cd src && find . -name '*.c' -o -name '*.cpp' | sed 's|^\\./||' | LC_ALL=C sort");
    const char *linker = "cc"; // the verb that links: C++ needs smith c++
    for (const char *at = others, *file = next_line(io, &at); file != nullptr; file = next_line(io, &at)) {
        const char *object = format::push(&io->arena, "out/obj/", object_of(io, file), ".o").data;
        bool cpp = c::strcmp(file + c::strlen(file) - 4, ".cpp") == 0;
        const char *compile =
            cpp ? format::push(&io->arena, "smith c++ -std=c++20 -g0 -fno-color-diagnostics -I out/include -c src/",
                               file, " -o ", object, " 2>>out/stderr")
                      .data
                : format::push(&io->arena, "smith cc ", flags, " -c src/", file, " -o ", object, " 2>>out/stderr").data;
        if (scratch::sh(p, compile).status != 0) built->status = 1;
        if (cpp) linker = "c++";
        built->objects = format::push(&io->arena, built->objects, " ", object).data;
    }
    (void)scratch::sh(p, ": >out/stdout");
    bool has_main =
        scratch::exists(p, "src/main.smith") || scratch::exists(p, "src/main.c") || scratch::exists(p, "src/main.cpp");
    if (built->status != 0 || !has_main) return;
    // -lm: glibc keeps libm apart; macOS's is in libSystem, which links anyway
    scratch::Run linked = scratch::sh(
        p, format::push(&io->arena, "smith ", linker, built->objects, " -lm -o out/program 2>>out/stderr").data);
    if (linked.status != 0) {
        built->status = 1;
        return;
    }
    (void)scratch::sh(p, "out/program >out/stdout 2>>out/stderr || echo \"(exit $?)\" >>out/stdout");
}

// The case is a single command, as a user would type it.
static Built build_command(const Case *kase) {
    const scratch::Project *p = kase->project;
    Built built = {.status = 0, .objects = ""};
    scratch::Run run = scratch::sh(p, "arguments=$(sed \"s|@OUT@|$PWD/out|g; s|@REPO@|$SMITH_REPO|g\" cmd); "
                                      "(cd src && smith cc -fno-color-diagnostics $arguments) 2>>out/stderr");
    if (run.status != 0) built.status = 1;
    (void)scratch::sh(p, ": >out/stdout");
    if (built.status == 0 && scratch::exists(p, "out/program")) {
        (void)scratch::sh(p, "out/program >out/stdout 2>>out/stderr || echo \"(exit $?)\" >>out/stdout");
    }
    return built;
}

// The golden file of the case.
static void golden_at(const Case *kase, const char *relative, const char *actual) {
    test::golden(kase->io, slice_of(join(kase, "tests/smith-lang/cases/", kase->name, "/", relative)),
                 slice_of(actual));
}

// The errors: file:line:column: message, and nothing else (no warnings, notes, source lines or counts).
static const char *errors_of(const Case *kase, const char *file) {
    return listed(kase, join(kase, "sed -n 's/^\\([^ :]*:[0-9]*:[0-9]*\\): error: \\(.*\\)$/\\1: \\2/p' ", file,
                             " 2>/dev/null | LC_ALL=C sort -u", ""));
}

// A case with no expect folder is new: an update writes what it made.
static bool fresh(const scratch::Project *p) {
    return !scratch::exists(p, "expect");
}

static void check_errors(const Case *kase, const Built *built, bool update) {
    const scratch::Project *p = kase->project;
    const char *errors = errors_of(kase, "out/stderr");
    bool wants_error = scratch::exists(p, "expect/error") || (update && errors[0] != '\0');
    if (wants_error) {
        golden_at(kase, "expect/error", errors);
        if (built->status == 0) {
            test::note("the build should have failed");
        }
        test::check_not_equal(built->status, 0);
    } else if (built->status != 0 || errors[0] != '\0') {
        test::note("the build failed:\n%s", scratch::read(p, "out/stderr"));
        test::check(false);
    }
    const char *lower_stderr = scratch::read(p, "out/lower-stderr");
    if (scratch::exists(p, "expect/lower-error") ||
        (update && fresh(p) && scratch::contains(lower_stderr, ": error: "))) {
        // The raw lowering (`--smith-lower`) has no compiler to type a generic call: it says so.
        golden_at(kase, "expect/lower-error", errors_of(kase, "out/lower-stderr"));
    }
}

static void check_outputs(const Case *kase, bool update) {
    const scratch::Project *p = kase->project;
    const char *stderr_text = scratch::read(p, "out/stderr");
    const char *stdout_text = scratch::read(p, "out/stdout");
    if (scratch::exists(p, "expect/stderr") || (update && scratch::exists(p, "cmd") && stderr_text[0] != '\0')) {
        golden_at(kase, "expect/stderr", stderr_text);
    }
    if (scratch::exists(p, "expect/stdout") || (update && stdout_text[0] != '\0')) {
        golden_at(kase, "expect/stdout", stdout_text);
    }
}

// The lowered C, the generated headers and what the compile wrote for generics, as the case holds them. A run to update
// takes the files a successful build made as the expectation.
static void check_files(const Case *kase, const Built *built, bool update) {
    io::Io *io = kase->io;
    const char *files;
    if (update && built->status != 0) return;
    if (update && fresh(kase->project)) { // a new case: what the build made, each file that is not empty
        files = listed(kase, "cd out && for f in lowered/*.c header/*.h; do [ -s \"$f\" ] && echo \"$f\"; done");
    } else { // the files the case holds, which an update rewrites
        files = listed(kase, "for f in expect/lowered/* expect/header/* expect/generics/*; do [ -f \"$f\" ] && echo "
                             "\"${f#expect/}\"; done");
    }
    for (const char *at = files, *file = next_line(io, &at); file != nullptr; file = next_line(io, &at)) {
        golden_at(kase, join(kase, "expect/", file, "", ""),
                  scratch::read(kase->project, join(kase, "out/", file, "", "")));
    }
}

static void check_asked_and_symbols(const Case *kase, const Built *built) {
    const scratch::Project *p = kase->project;
    if (scratch::exists(p, "ask")) { // what the parser answers about the types named in `ask`
        golden_at(kase, "expect/ask", listed(kase, "grep '^ask\\|^query\\|^value' out/stderr"));
    }
    if (scratch::exists(p, "expect/symbols")) {
        const char *command =
            format::push(&kase->io->arena, "for object in", built->objects,
                         "; do nm -g \"$object\" 2>/dev/null; done | grep -v ' U ' | awk '{print $2, $3}' | "
                         "LC_ALL=C sort")
                .data;
        golden_at(kase, "expect/symbols", listed(kase, command));
    }
}

static const char *join_name(io::Io *io, const char *name) {
    return format::push(&io->arena, "cases/", name).data;
}

static void corpus_case(io::Io *io, const char *name) {
    // The folder is cases/<name>, as in the corpus, so that a case names a sibling as ../../<other>/src/main.smith.
    scratch::Project p = scratch::project(io, join_name(io, name), nullptr);
    Case kase = {.io = io, .name = name, .project = &p};
    scratch::Run copied = scratch::sh(
        &p,
        join(&kase, "cp -R \"$SMITH_REPO/tests/smith-lang/cases/", name,
             "/.\" . && mkdir -p out/include out/lowered "
             "out/header out/generics out/obj && : >out/stderr && "
             "{ [ -e ../target-facts ] || ln -s \"$SMITH_REPO/tests/smith-lang/cases/target-facts\" ../target-facts; }",
             ""));
    scratch::expect_status("the case is copied", 0, &copied);
    bool update = test::updating();
    Built built;
    if (scratch::exists(&p, "cmd")) {
        built = build_command(&kase);
    } else {
        built = build_sources(&kase);
        build_others(&kase, &built);
    }
    check_errors(&kase, &built, update);
    check_outputs(&kase, update);
    check_files(&kase, &built, update);
    check_asked_and_symbols(&kase, &built);
}

// A case added to tests/smith-lang/cases needs a test here.
export void test_every_case_has_a_test(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run run =
        scratch::sh(&p, "cd \"$SMITH_REPO/tests/smith-lang/cases\" && for f in *; do "
                        "grep -q \"corpus_case(io, \\\"$f\\\")\" ../../smith_lang_test.smith || echo \"$f\"; done");
    scratch::expect_text("cases of tests/smith-lang/cases with no test", "", run.out);
}

