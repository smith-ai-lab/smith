// The corpus of the .smith language (tests/smith-lang/cases), run through the smith under test, which must have clang
// inside with the token hook. A case is a folder, and is one test here (`corpus_case(io, "name")`; a case added to the
// folder needs a test: `test_every_case_has_a_test` says which):
//   src/             the sources; module a.b is src/a/b.smith; src/main.smith (or main.c, main.cpp), if there, is
//   linked with
//                    the other .smith files and any .c or .cpp beside them (C++ as C++20), and run
//   expect/lower-error  the errors `smith cc --smith-lower` reports (it has no compiler, so a generic call whose type
//                    nothing writes is one); only a case with this file is checked, in process, by
//                    tests/smith_lang_lowering_test.smith
//   expect/stdout    what the program prints
//   expect/error     the errors the build must report, as `file:line:column: message`, one per line (the build must
//   fail) expect/lowered/  the C each file is lowered to (a.b.c), by `smith cc --smith-lower`: the lowering of the text
//   as
//                    written, with no macros and no parser (the build's own run is checked by the program, the symbols
//                    and the headers); checked in process by tests/smith_lang_lowering_test.smith
//   expect/header/   the generated header of each module (a.b.h); checked there too, but for the cases in
//                    `header_by_command` (below), whose header needs the compiler's answer and is made by
//                    `smith cc --smith-header` here
//   expect/generics/ what the compile wrote for generic functions (a.b.c; SMITH_LANG_GENERICS): the calls, each as its
//                    statement expression, and the instances, in order. `--smith-lower` cannot show them, because it
//                    reads no header. Only a case with this folder is checked against it
//   expect/symbols   the symbols the objects define (nm -g), sorted
//   flags            extra compiler flags, if any
//   ask              types to ask the parser about at the end of each file (SMITH_LANG_ASK), and expect/ask its answers
//   cmd              the case is one command instead: `smith cc` with these arguments (@OUT@ is the case's scratch
//   folder,
//                    @REPO@ a copy of the files of smith's own that it names, in `mirror/`), run in src/ as a user
//                    would, with no flag of the harness's, so that smith's own defaults (the C2y standard, finding a
//                    module's source) are what is tested; the program, if the command made @OUT@/program, is run, and
//                    expect/stderr, if there, is the whole of the diagnostics
//   nostd            the case's compiles are given no -std (smith's default for a .smith file applies)
// Everything runs in the case's own folder (a copy in the test's scratch folder), so paths in messages are relative to
// it. The expectations are golden files: `smith test --update` writes what each case produced (read the diff).
module smith_lang_test;

import smith::arena;
import smith::format;
import smith::io;
import smith::test;
import <string.h>;
import scratch;
import smith::mem;
import target;
import <smith_core.h>;

typedef struct {
    io::Io *io;
    const char *name;
    const scratch::Project *project;
} Case;

// What the compiles and the link made: 0 when all worked, and the objects (each after a space).
typedef struct {
    i32 status;
    const char *objects;
} Built;

// The raw lowering in process (include/smith_core.h): what `smith cc --smith-header` writes. The command asks the
// compiler which of a module's C imports declared a name when several are possible, and the function does not, so a
// case whose header is checked by its golden here, because it has several, is made by the command.
constexpr usize header_capacity = 1U << 21;
constexpr usize report_capacity = 1U << 16;

static char header_text[header_capacity];
static char report_text[report_capacity];

static bool header_by_command(const char *name) {
    static const char *const cases[_] = {"filescope-if-header", "filescope-if-reflect"};
    for (usize i = 0; i < countof(cases); i++) {
        if (c::strcmp(name, cases[i]) == 0) return true;
    }
    return false;
}

static typeof(const char[:]) slice_of(const char *text) {
    return text[0:c::strlen(text)];
}

static const char *join(const Case *kase, const char *a, const char *b, const char *c, const char *d) {
    return format::push(&kase->io->arena, a, b, c, d).data;
}

// The next line of text, copied (a zero ends it), or nullptr at the end. `*at` moves past it.
static const char *next_line(io::Io *io, const char **at) {
    if (**at == '\0') return nullptr;
    const char *end = c::strchr(*at, '\n');
    usize length = end != nullptr ? (usize)(end - *at) : c::strlen(*at);
    char *copy = arena::push_slice(&io->arena, char, length + 1).data;
    const char *line = *at;
    mem::copy(copy[0:length], line[0:length]);
    *at += length + (end != nullptr ? 1 : 0);
    return copy;
}

// `a/b.smith` as the module `a.b`, `a/b` the stem.
static const char *module_of(io::Io *io, const char *file) {
    usize length = c::strlen(file);
    if (length > 6 && c::strcmp(file + length - 6, ".smith") == 0) length -= 6;
    char *copy = arena::push_slice(&io->arena, char, length + 1).data;
    for (usize i = 0; i < length; i++) {
        copy[i] = file[i] == '/' ? '.' : file[i];
    }
    return copy;
}

static const char *stem_of(io::Io *io, const char *file) {
    usize length = c::strlen(file);
    if (length > 6 && c::strcmp(file + length - 6, ".smith") == 0) length -= 6;
    char *copy = arena::push_slice(&io->arena, char, length + 1).data;
    mem::copy(copy[0:length], file[0:length]);
    return copy;
}

// The object of a file that is not a module: its path with the dots for slashes.
static const char *object_of(io::Io *io, const char *file) {
    usize length = c::strlen(file);
    char *copy = arena::push_slice(&io->arena, char, length + 1).data;
    for (usize i = 0; i < length; i++) {
        copy[i] = file[i] == '/' ? '.' : file[i];
    }
    return copy;
}

// The files a command lists, one a line.
static const char *listed(const Case *kase, const char *command) {
    return scratch::sh(kase->project, command).out;
}

// The text of a file of the case without the newlines at its end, as $(cat file) gives it ("" when it is absent).
static const char *text_of(const Case *kase, const char *name) {
    const char *text = scratch::read(kase->project, name);
    usize length = c::strlen(text);
    while (length > 0 && text[length - 1] == '\n')
        length--;
    char *copy = arena::push_slice(&kase->io->arena, char, length + 1).data;
    mem::copy(copy[0:length], text[0:length]);
    copy[length] = '\0';
    return copy;
}

constexpr usize found_max = 512;
constexpr usize found_folders_max = 128;

static bool ends_with(const char *text, const char *suffix) {
    usize length = c::strlen(text);
    usize tail = suffix != nullptr ? c::strlen(suffix) : 0;
    return suffix != nullptr && length >= tail && c::strcmp(text + length - tail, suffix) == 0;
}

// The files below a folder of the case (`from`, "src" or "expect/generics") whose names end in `suffix_a` or `suffix_b`
// (every file when both are nullptr), as paths relative to it, in the order of LC_ALL=C sort, one a line. It does what
// `cd src && find . -name '*.smith' | LC_ALL=C sort` did, through io, in place of a process for each.
static const char *found(const Case *kase, const char *from, const char *suffix_a, const char *suffix_b,
                         bool files_only_here) {
    io::Io *io = kase->io;
    const char *names[found_max];
    usize count = 0;
    const char *folders[found_folders_max]; // relative to `from`; "" is `from` itself
    usize tail = 1;
    folders[0] = "";
    for (usize head = 0; head < tail; head++) {
        const char *where = folders[head][0] == '\0'
                                ? join(kase, kase->project->dir, "/", from, "")
                                : join(kase, kase->project->dir, "/", from, join(kase, "/", folders[head], "", ""));
        io::FileList list = io::files_list(&io->files, &io->arena, where);
        if (list.error.code != 0) continue;
        for (usize i = 0; i < list.count; i++) {
            const char *relative = folders[head][0] == '\0' ? list.entries[i].name
                                                            : join(kase, folders[head], "/", list.entries[i].name, "");
            if (list.entries[i].folder && !list.entries[i].link && !files_only_here) {
                test::check_less(tail, found_folders_max);
                folders[tail++] = relative;
                continue;
            }
            bool wanted = (suffix_a == nullptr && suffix_b == nullptr) || ends_with(list.entries[i].name, suffix_a) ||
                          ends_with(list.entries[i].name, suffix_b);
            if (!wanted || (list.entries[i].folder && !list.entries[i].link)) {
                continue;
            }
            test::check_less(count, found_max);
            usize at = count++;
            while (at > 0 && c::strcmp(names[at - 1], relative) > 0) { // insertion, bytewise
                names[at] = names[at - 1];
                at--;
            }
            names[at] = relative;
        }
    }
    const char *lines = "";
    for (usize i = 0; i < count; i++)
        lines = join(kase, lines, names[i], "\n", "");
    return lines;
}

// The header of a module, made in process into out/include, with the errors it reports added to out/stderr.
static void write_header(const Case *kase, const char *file, const char *stem) {
    io::Io *io = kase->io;
    const scratch::Project *p = kase->project;
    const char *source = format::push(&io->arena, "src/", file).data;
    bool made =
        c::smith_core_header(p->dir, source, nullptr, header_text, header_capacity, report_text, report_capacity);
    if (report_text[0] != '\0') {
        const u8 *bytes = (const u8 *)report_text;
        io::Error added = io::files_write(&io->files, format::push(&io->arena, p->dir, "/out/stderr").data,
                                          bytes[0:c::strlen(report_text)], io::Append);
        test::check_equal(added.code, 0);
    }
    if (!made) return;
    const char *path = format::push(&io->arena, p->dir, "/out/include/", stem, ".h").data;
    const char *slash = c::strrchr(path, '/');
    char *folder = arena::push_slice(&io->arena, char, (usize)(slash - path) + 1).data;
    mem::copy(folder[0:(usize)(slash - path)], path[0:(usize)(slash - path)]);
    folder[slash - path] = '\0';
    test::check_equal(io::files_make_folder(&io->files, folder).code, 0);
    const u8 *header = (const u8 *)header_text;
    io::Error written = io::files_write(&io->files, path, header[0:c::strlen(header_text)], io::Replace);
    test::check_equal(written.code, 0);
}

// Every compile of the case, into out/.
static Built build_sources(const Case *kase) {
    io::Io *io = kase->io;
    const scratch::Project *p = kase->project;
    const char *flags = format::push(&io->arena, scratch::exists(p, "nostd") ? "" : "-std=gnu23",
                                     " -g0 -fno-color-diagnostics -Wno-unused-function -I out/include ",
                                     scratch::exists(p, "flags") ? text_of(kase, "flags") : "")
                            .data;
    const char *sources = found(kase, "src", ".smith", nullptr, false);
    Built built = {.status = 0, .objects = ""};
    for (const char *at = sources, *file = next_line(io, &at); file != nullptr; file = next_line(io, &at)) {
        // the headers first, as the build will: no compile waits on another
        const char *stem = stem_of(io, file);
        if (header_by_command(kase->name)) {
            const char *command = format::push(&io->arena, "mkdir -p \"out/include/$(dirname ", file,
                                               ")\" && smith cc --smith-header src/", file, " -o out/include/", stem,
                                               ".h 2>>out/stderr; [ -f out/include/", stem, ".h ] && cp out/include/",
                                               stem, ".h out/header/", module_of(io, file), ".h")
                                      .data;
            (void)scratch::sh(p, command);
        } else {
            write_header(kase, file, stem);
        }
    }
    const char *ask = scratch::exists(p, "ask") ? text_of(kase, "ask") : "";
    for (const char *at = sources, *file = next_line(io, &at); file != nullptr; file = next_line(io, &at)) {
        const char *module = module_of(io, file);
        const char *compile =
            format::push(&io->arena, "SMITH_LANG_GENERICS=out/generics/", module, ".c SMITH_LANG_ASK='", ask,
                         "' smith cc ", flags, " -c src/", file, " -o out/obj/", module, ".o 2>>out/stderr")
                .data;
        if (scratch::sh(p, compile).status != 0) built.status = 1;
        built.objects = format::push(&io->arena, built.objects, " out/obj/", module, ".o").data;
    }
    return built;
}

// The sources that are not modules (C and C++), compiled beside them, and the link and the run.
static void build_others(const Case *kase, Built *built) {
    io::Io *io = kase->io;
    const scratch::Project *p = kase->project;
    const char *flags = format::push(&io->arena, scratch::exists(p, "nostd") ? "" : "-std=gnu23",
                                     " -g0 -fno-color-diagnostics -Wno-unused-function -I out/include ",
                                     scratch::exists(p, "flags") ? text_of(kase, "flags") : "")
                            .data;
    const char *others = found(kase, "src", ".c", ".cpp", false);
    const char *linker = "cc"; // the verb that links: C++ needs smith c++
    for (const char *at = others, *file = next_line(io, &at); file != nullptr; file = next_line(io, &at)) {
        const char *object = format::push(&io->arena, "out/obj/", object_of(io, file), ".o").data;
        bool cpp = c::strcmp(file + c::strlen(file) - 4, ".cpp") == 0;
        const char *compile =
            cpp ? format::push(&io->arena, "smith c++ -std=c++20 -g0 -fno-color-diagnostics -I out/include -c src/",
                               file, " -o ", object, " 2>>out/stderr")
                      .data
                : format::push(&io->arena, "smith cc ", flags, " -c src/", file, " -o ", object, " 2>>out/stderr").data;
        if (scratch::sh(p, compile).status != 0) built->status = 1;
        if (cpp) linker = "c++";
        built->objects = format::push(&io->arena, built->objects, " ", object).data;
    }
    scratch::write(p, "out/stdout", "");
    bool has_main =
        scratch::exists(p, "src/main.smith") || scratch::exists(p, "src/main.c") || scratch::exists(p, "src/main.cpp");
    if (built->status != 0 || !has_main) return;
    // -lm: glibc keeps libm apart; macOS's is in libSystem, which links anyway
    scratch::Run linked = scratch::sh(
        p, format::push(&io->arena, "smith ", linker, built->objects, " -lm -o out/program 2>>out/stderr").data);
    if (linked.status != 0) {
        built->status = 1;
        return;
    }
    (void)scratch::sh(p, "out/program >out/stdout 2>>out/stderr || echo \"(exit $?)\" >>out/stdout");
}

// The case is a single command, as a user would type it.
static Built build_command(const Case *kase) {
    const scratch::Project *p = kase->project;
    Built built = {.status = 0, .objects = ""};
    // smith's generated headers are a build output, not a file of the tree: they stay where the build wrote them
    scratch::Run run = scratch::sh(
        p,
        format::push(&kase->io->arena, "arguments=$(sed \"s|@OUT@|$PWD/out|g; s|@REPO@/.smith/|$SMITH_REPO/.smith/|g; ",
                     "s|@REPO@/tests/smith-lang/cases/", kase->name, "/|$PWD/|g; s|@REPO@|$PWD/mirror|g\" cmd); ",
                     "(cd src && smith cc -fno-color-diagnostics $arguments) 2>>out/stderr")
            .data);
    if (run.status != 0) built.status = 1;
    scratch::write(p, "out/stdout", "");
    if (built.status == 0 && scratch::exists(p, "out/program")) {
        (void)scratch::sh(p, "out/program >out/stdout 2>>out/stderr || echo \"(exit $?)\" >>out/stdout");
    }
    return built;
}

// The golden file of the case.
// A file the platform changes has a variant for Linux, `expect-linux/<same path>`: the program reads the machine
// (`__x86_64__` against `__aarch64__`), and `u64` is `unsigned long` there where macOS has `unsigned long long`.
static void golden_at(const Case *kase, const char *relative, const char *actual) {
    const char *shown = relative;
    if constexpr (target::os != target::macos) { // not `target::linux`: clang defines `linux` as 1 there (#382)
        if (c::strncmp(relative, "expect/", 7) == 0) {
            const char *variant = join(kase, "expect-linux/", relative + 7, "", "");
            if (scratch::exists(kase->project, variant)) shown = variant;
        }
    }
    test::golden(kase->io, slice_of(join(kase, "tests/smith-lang/cases/", kase->name, "/", shown)), slice_of(actual));
}

static usize digits_at(const char *line, usize at) {
    while (line[at] >= '0' && line[at] <= '9')
        at++;
    return at;
}

// The length of `file:line:column` at the start of a line that goes on with ": error: ", or 0.
static usize error_position(const char *line) {
    usize at = 0;
    while (line[at] != '\0' && line[at] != ' ' && line[at] != ':')
        at++;
    if (line[at] != ':') return 0;
    at = digits_at(line, at + 1);
    if (line[at] != ':') return 0;
    at = digits_at(line, at + 1);
    return c::strncmp(line + at, ": error: ", 9) == 0 ? at : 0;
}

constexpr usize errors_max = 512;

// The errors: file:line:column: message, and nothing else (no warnings, notes, source lines or counts), sorted bytewise
// without duplicates: what `sed -n 's/^\([^ :]*:[0-9]*:[0-9]*\): error: \(.*\)$/\1: \2/p' | LC_ALL=C sort -u` made of
// the file, read here in place of a process.
static const char *errors_of(const Case *kase, const char *file) {
    io::Io *io = kase->io;
    const char *text = scratch::read(kase->project, file);
    const char *lines[errors_max];
    usize count = 0;
    for (const char *at = text, *line = next_line(io, &at); line != nullptr; line = next_line(io, &at)) {
        usize position = error_position(line);
        if (position == 0) {
            continue;
        }
        const char *error = format::push(&io->arena, line[0:position], ": ", line + position + 9).data;
        usize place = 0;
        while (place < count && c::strcmp(lines[place], error) < 0)
            place++;
        if (place < count && c::strcmp(lines[place], error) == 0) {
            continue;
        }
        test::check_less(count, errors_max);
        for (usize k = count; k > place; k--)
            lines[k] = lines[k - 1];
        lines[place] = error;
        count++;
    }
    const char *sorted = "";
    for (usize k = 0; k < count; k++)
        sorted = join(kase, sorted, lines[k], "\n", "");
    return sorted;
}

// A case with no expect folder is new: an update writes what it made.
static bool fresh(const scratch::Project *p) {
    return !scratch::exists(p, "expect");
}

static void check_errors(const Case *kase, const Built *built, bool update) {
    const scratch::Project *p = kase->project;
    const char *errors = errors_of(kase, "out/stderr");
    bool wants_error = scratch::exists(p, "expect/error") || (update && errors[0] != '\0');
    if (wants_error) {
        golden_at(kase, "expect/error", errors);
        if (built->status == 0) {
            test::note("the build should have failed");
        }
        test::check_not_equal(built->status, 0);
    } else if (built->status != 0 || errors[0] != '\0') {
        test::note("the build failed:\n%s", scratch::read(p, "out/stderr"));
        test::check(false);
    }
}

static void check_outputs(const Case *kase, bool update) {
    const scratch::Project *p = kase->project;
    const char *stderr_text = scratch::read(p, "out/stderr");
    const char *stdout_text = scratch::read(p, "out/stdout");
    if (scratch::exists(p, "expect/stderr") || (update && scratch::exists(p, "cmd") && stderr_text[0] != '\0')) {
        golden_at(kase, "expect/stderr", stderr_text);
    }
    if (scratch::exists(p, "expect/stdout") || (update && stdout_text[0] != '\0')) {
        golden_at(kase, "expect/stdout", stdout_text);
    }
}

// The files the case holds in expect/<folder>, as `<folder>/<name>` one a line.
static const char *held(const Case *kase, const char *folder) {
    io::Io *io = kase->io;
    const char *names = found(kase, join(kase, "expect/", folder, "", ""), nullptr, nullptr, true);
    const char *lines = "";
    for (const char *at = names, *name = next_line(io, &at); name != nullptr; name = next_line(io, &at))
        lines = join(kase, lines, folder, "/", join(kase, name, "\n", "", ""));
    return lines;
}

// The generated headers of the cases in `header_by_command` and what the compile wrote for generics, as the case holds
// them. A run to update takes the files a successful build made as the expectation.
static void check_files(const Case *kase, const Built *built, bool update) {
    io::Io *io = kase->io;
    const char *files;
    if (update && built->status != 0) return;
    if (update && fresh(kase->project)) { // a new case: what the build made, each file that is not empty
        files = header_by_command(kase->name)
                    ? listed(kase, "cd out && for f in header/*.h; do [ -s \"$f\" ] && echo \"$f\"; done")
                    : "";
    } else { // the files the case holds, which an update rewrites (the lowering and most headers are checked in
             // process)
        const char *generics = held(kase, "generics");
        files = header_by_command(kase->name) ? join(kase, held(kase, "header"), generics, "", "") : generics;
    }
    for (const char *at = files, *file = next_line(io, &at); file != nullptr; file = next_line(io, &at)) {
        golden_at(kase, join(kase, "expect/", file, "", ""),
                  scratch::read(kase->project, join(kase, "out/", file, "", "")));
    }
}

static void check_asked_and_symbols(const Case *kase, const Built *built) {
    const scratch::Project *p = kase->project;
    if (scratch::exists(p, "ask")) { // what the parser answers about the types named in `ask`
        golden_at(kase, "expect/ask", listed(kase, "grep '^ask\\|^query\\|^value' out/stderr"));
    }
    if (scratch::exists(p, "expect/symbols")) {
        const char *command =
            format::push(&kase->io->arena, "for object in", built->objects,
                         "; do nm -g \"$object\" 2>/dev/null; done | grep -v ' U ' | awk '{print $2, $3}' | "
                         // the goldens are Mach-O's: C names have a leading underscore, a weak definition is T and
                         // zero-filled data is S
                         "if [ \"$(uname -s)\" = Darwin ]; then cat; else "
                         "awk '{ t = $1; n = $2; if (t == \"W\") t = \"T\"; if (t == \"B\") t = \"S\"; "
                         "if (n !~ /::|\\(/) n = \"_\" n; print t, n }'; fi | "
                         "LC_ALL=C sort")
                .data;
        golden_at(kase, "expect/symbols", listed(kase, command));
    }
}

static const char *join_name(io::Io *io, const char *name) {
    return format::push(&io->arena, "cases/", name).data;
}

static void corpus_case(io::Io *io, const char *name) {
    // The folder is cases/<name>, as in the corpus, so that a case names a sibling as ../../<other>/src/main.smith.
    scratch::Project p = scratch::project(io, join_name(io, name), nullptr);
    Case kase = {.io = io, .name = name, .project = &p};
    scratch::copy_tree(&p, join(&kase, "tests/smith-lang/cases/", name, "", ""), "");
    // A case that names the files of another (../../target-facts/src/main.smith) finds them beside its own folder.
    if (c::strncmp(name, "target-facts-", 13) == 0) {
        scratch::copy_tree(&p, "tests/smith-lang/cases/target-facts", "../target-facts");
    }
    // The folders of the output and its empty error file, through io: a process for them cost as much as a compile.
    const char *folders[5] = {"out", "out/include", "out/header", "out/generics", "out/obj"};
    for (usize i = 0; i < countof(folders); i++)
        test::check_equal(io::files_make_folder(&io->files, join(&kase, p.dir, "/", folders[i], "")).code, 0);
    scratch::write(&p, "out/stderr", "");
    if (scratch::exists(&p, "cmd")) { // the files of smith's own that a command may name, as @REPO@
        scratch::copy_tree(&p, "lib/smith/contract.smith", "mirror/lib/smith/contract.smith");
        scratch::copy_tree(&p, "lib/smith/text.smith", "mirror/lib/smith/text.smith");
        scratch::copy_tree(&p, "lib/trace.c", "mirror/lib/trace.c");
        scratch::copy_tree(&p, "include", "mirror/include");
    }
    bool update = test::updating();
    Built built;
    if (scratch::exists(&p, "cmd")) {
        built = build_command(&kase);
    } else {
        built = build_sources(&kase);
        build_others(&kase, &built);
    }
    check_errors(&kase, &built, update);
    check_outputs(&kase, update);
    check_files(&kase, &built, update);
    check_asked_and_symbols(&kase, &built);
}

// A case added to tests/smith-lang/cases needs a test here: the folder is listed and this file read through io.
export void test_every_case_has_a_test(io::Io *io) {
    scratch::expect_text("cases of tests/smith-lang/cases with no test", "",
                         scratch::untested_names(io, "tests/smith-lang/cases", "tests/smith_lang_test.smith",
                                                 "corpus_case(io, ", nullptr, nullptr));
}

