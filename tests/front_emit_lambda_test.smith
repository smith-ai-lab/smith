// Tests of `fn` types, lambdas and the call of a `fn` value in the emitter (#1620 of #1428). Each scenario is source
// text in smith's own syntax, read by front::parser's hooks, checked by front::types_decl and emitted, then run through
// the JIT.
module front_emit_lambda_test;

import front::ast;
import front::emit;
import front::emit_jit;
import front::emit_lambda;
import front::emit_state;
import front::lex;
import front::parse;
import front::parse_decl;
import front::parse_expr;
import front::parse_stmt;
import front::parse_type;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;
import <llvm-c/Core.h>;

struct Scenario {
    arena::Arena memory;
    arena::ArenaAllocator allocator;
    parser::Parsed parsed;
    types::Checked checked;
    Bool has_checked;
};

// The module of `source`, read in smith's own syntax.
static parser::Parsed parse_new(Str source) {
    parser::Parsed result = {};
    result.module.file = "t.smith";
    lex::Lexed lexed = lex::tokenize_new(source);
    switch (lexed) {
    case .ok:
        parse::Parser p = parse::make(lexed.ok, source);
        p.new_syntax = true;
        p.hooks.expression = parse_expr::expression;
        p.hooks.type = parse_type::type;
        p.hooks.statement = parse_stmt::statement;
        p.hooks.declaration = parse_decl::declaration;
        result.module = parse_decl::file(&p, "t.smith");
        result.errors = p.errors;
        break;
    case .error:
        Str expected = "no error";
        test::check_equal(lexed.error.message, expected);
    }
    return result;
}

static void begin(Scenario *s, Str source, Bool with_checker) {
    s->memory = test::memory(1U << 22);
    s->allocator = arena::allocator(&s->memory);
    mem::Allocator *outside = mem::set_allocator(&s->allocator.base);
    s->parsed = parse_new(source);
    test::check_equal(countof(s->parsed.errors), (Usize)0);
    if (with_checker) {
        s->checked = types_decl::check_module(&s->parsed.module, types::lp64());
        s->has_checked = true;
        test::check_equal(s->checked.error_count, (Usize)0);
    }
    mem::set_allocator(outside);
}

static emit::Options options_for(emit::Target target, const Scenario *s) {
    emit::Options options = {};
    options.target = target;
    if (s->has_checked) options.checked = &s->checked;
    return options;
}

static emit_jit::Jit start_jit() {
    emit_jit::JitResult started = emit_jit::start();
    test::check_equal(started == .ok, true);
    emit_jit::Jit host = {};
    if (started == .ok) host = started.ok;
    return host;
}

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        Bool same = true;
        for (Usize k = 0; k < countof(needle); k++) {
            if (text[i + k] != needle[k]) {
                same = false;
                break;
            }
        }
        if (same) return true;
    }
    return false;
}

// The text of `source` from `start`.
static Bool starts_at(Str source, U32 start, Str needle) {
    if (start > countof(source)) return false;
    return has(
        source[start:start + (countof(needle) < countof(source) - start ? countof(needle) : countof(source) - start)],
        needle);
}

static Bool contains(const char *text, Str needle) {
    return text != nullptr && c::strstr(text, needle.data) != nullptr;
}

static Usize symbol_of(emit_jit::Jit *host, Str symbol) {
    emit_jit::AddressResult found = emit_jit::lookup(host, symbol);
    test::check_equal(found == .ok, true);
    Usize address = 0;
    if (found == .ok) address = found.ok;
    return address;
}

// Emits `source` (with the checker's types), returns its IR text and adds it to `host`.
static char *ir_of(Str source, emit_jit::Jit *host, Scenario *s) {
    begin(s, source, true);
    c::LLVMContextRef context = c::LLVMContextCreate();
    emit::ModuleResult emitted = emit::module(context, &s->parsed.module, options_for(host->target, s));
    test::check_equal(emitted == .ok, true);
    char *text = nullptr;
    if (emitted == .ok) {
        text = c::LLVMPrintModuleToString(emitted.ok);
        emit_jit::BoolResult added = emit_jit::add(host, context, emitted.ok);
        test::check_equal(added == .ok, true);
    } else {
        Str expected = "no error";
        test::check_equal(emitted.error.message, expected);
    }
    return text;
}

// Emits `source` and checks that it stops with `what` in its message at a span that starts with `at`.
static void stops_with(Str source, Bool with_checker, Str what, Str at) {
    Scenario s = {};
    begin(&s, source, with_checker);
    emit_jit::Jit host = start_jit();
    c::LLVMContextRef context = c::LLVMContextCreate();
    emit::ModuleResult emitted = emit::module(context, &s.parsed.module, options_for(host.target, &s));
    test::check_equal(emitted == .error, true);
    if (emitted == .error) {
        test::check_equal(has(emitted.error.message, what), true);
        test::check_equal(starts_at(source, emitted.error.span.start, at), true);
        emit::free_error(emitted.error);
    } else {
        c::LLVMDisposeModule(emitted.ok);
    }
    c::LLVMContextDispose(context);
    emit_jit::stop(&host);
}

typedef I32 (*Run)(I32);
typedef I32 (*Check)();

// One program, run: its `check` returns 0.
static void passes(Str source) {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    char *ir = ir_of(source, &host, &s);
    test::check_equal(ir != nullptr, true);
    if (ir != nullptr) {
        Check check = (Check)symbol_of(&host, "check");
        test::check_equal(check(), (I32)0);
    }
    emit_jit::stop(&host);
}

export void test_front_emit_lambda_a_lambda_with_no_captures_is_called() {
    passes("fn apply(f: fn(i32) -> i32, x: i32) -> i32 {\n    f(x)\n}\n"
           "pub fn check() -> i32 {\n    if apply(fn(x: i32) -> i32 { x + 1 }, 4) != 5 {\n        return 1\n    }\n    "
           "0\n}\n");
}

export void test_front_emit_lambda_a_capture_is_read_and_a_mut_capture_is_written() {
    passes(
        "fn twice(x: i32, f: fn(i32) -> i32) -> i32 {\n    f(f(x))\n}\n"
        "fn repeat(n: i32, body: fn()) {\n    mut i := 0\n    while i < n {\n        body()\n        i += 1\n    }\n}\n"
        "pub fn check() -> i32 {\n    step := 10\n"
        "    if twice(1, fn(x: i32) -> i32 { x + step }) != 21 {\n        return 2\n    }\n"
        "    mut count := 0\n    repeat(3) {\n        count += 2\n    }\n"
        "    if count != 6 {\n        return 3\n    }\n    0\n}\n");
}

export void test_front_emit_lambda_a_stored_lambda_with_no_captures_is_called_through_a_local() {
    passes("fn apply(f: fn(i32) -> i32, x: i32) -> i32 {\n    f(x)\n}\n"
           "pub fn check() -> i32 {\n    step := 10\n    mut count := 0\n    count += step\n"
           "    dbl := fn(x: i32) -> i32 { x * 2 }\n"
           "    if dbl(21) != 42 {\n        return 4\n    }\n"
           "    if dbl(4) != 8 {\n        return 5\n    }\n    0\n}\n");
}

export void test_front_emit_lambda_return_leaves_only_the_lambda() {
    passes("fn apply(f: fn(i32) -> i32, x: i32) -> i32 {\n    f(x)\n}\n"
           "pub fn check() -> i32 {\n"
           "    r := apply(fn(x: i32) -> i32 {\n        if x > 2 {\n            return 100\n        }\n        x\n    "
           "}, 5)\n"
           "    if r != 100 {\n        return 1\n    }\n"
           "    if apply(fn(x: i32) -> i32 {\n        if x > 2 {\n            return 100\n        }\n        x\n    }, "
           "1) != 1 {\n        return 2\n    }\n    0\n}\n");
}

export void test_front_emit_lambda_a_loop_with_break_inside_a_lambda_inside_a_loop() {
    passes("fn apply(f: fn(i32) -> i32, x: i32) -> i32 {\n    f(x)\n}\n"
           "pub fn check() -> i32 {\n    mut total := 0\n    mut i := 0\n    while i < 3 {\n"
           "        total += apply(fn(n: i32) -> i32 {\n            mut k := 0\n            while true {\n"
           "                if k >= n {\n                    break\n                }\n                k += 1\n        "
           "    }\n"
           "            k\n        }, i + 1)\n        i += 1\n    }\n"
           "    if total != 6 {\n        return 1\n    }\n    0\n}\n");
}

export void test_front_emit_lambda_a_lambda_in_a_lambda_captures_through_it() {
    passes("fn apply(f: fn(i32) -> i32, x: i32) -> i32 {\n    f(x)\n}\n"
           "pub fn check() -> i32 {\n    base := 100\n"
           "    r := apply(fn(x: i32) -> i32 { apply(fn(y: i32) -> i32 { y + base }, x) }, 5)\n"
           "    if r != 105 {\n        return 1\n    }\n    0\n}\n");
}

export void test_front_emit_lambda_the_function_type_is_a_code_and_a_context() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    char *ir = ir_of("pub fn a(f: fn(i32) -> i32) -> i32 {\n    f(1)\n}\n", &host, &s);
    test::check_equal(contains(ir, "{ ptr, ptr }"), true);
    emit_jit::stop(&host);
}

export void test_front_emit_lambda_a_stored_lambda_with_captures_is_not_emitted_yet() {
    stops_with("pub fn check() -> i32 {\n    k := 3\n    f := fn(x: i32) -> i32 { x + k }\n    f(1)\n}\n", true,
               "not emitted yet: a stored lambda with captures", "fn(x: i32)");
}

export void test_front_emit_lambda_named_arguments_to_a_fn_value_are_an_error() {
    stops_with("fn apply(f: fn(i32) -> i32) -> i32 {\n    f(x = 1)\n}\n", false, "takes its arguments by position",
               "x = 1");
}

export void test_front_emit_lambda_the_wrong_argument_count_names_both() {
    stops_with("fn apply(f: fn(i32) -> i32) -> i32 {\n    f(1, 2)\n}\n", false,
               "a fn value takes 1 arguments, the call has 2", "f(1, 2)");
}
