// What a module's generated C header includes: exactly what its exported declarations need
// (knowledge/smith-module-headers.md).
//   1. the generated header of every library module (lib/std/*.smith; none is in git) compiles on its own, as
//      C and as C++; a library added there needs a test here: `test_every_library_module_has_a_header_test` says which;
//   2. the rule, on the small modules of tests/build_fixtures/headers: an import only a body uses stays out; an import
//   an
//      export's type uses goes in; of two imports the one that declares the name goes in; an imported module whose type
//      an export uses is included, and one only a body uses is not; an `#include` never goes in; and each of these
//      headers compiles on its own too;
//   3. a generic called with its type written in a body does not stop the header, and a chain of modules longer than
//   the
//      old limit of eight is read by source and by header, up to the limit that is an error naming it.
module headers_test;

import std::arena;
import std::env;
import std::files;
import std::format;
import std::mem;
import std::test;
import scratch;
import <string.h>;

constexpr Usize chain_length = 20;
constexpr Usize deep_length = 140;

// A project of the fixture, with the folders the headers go to; made before the test's memory, since scratch::clean
// frees what it holds and the run's texts are given back here.
static scratch::Project make_project() {
    scratch::Project p = scratch::make("p", "headers");
    scratch::Run made = scratch::sh(&p, "mkdir -p include/t include/u/deep include/chain deep");
    scratch::expect_status("the include folders are made", 0, &made);
    scratch::release(made.out);
    scratch::release(made.err);
    return p;
}

// The pieces as one text, in the current allocator: the test's memory, which is given back after the test.
const char *joined(auto... pieces) {
    Usize length = format::length(pieces...);
    char *text = mem::alloc_array_raw(sizeof(char), length + 1, alignof(char)); // a generic's local has no type yet
    (void)format::to(text, length + 1, pieces...);
    return text;
}

// The header of a module (`t/body` is t/body.smith) written to include/t/body.h; flags are extra compiler flags.
static void make_header(const scratch::Project *p, const char *module, const char *flags) {
    scratch::Run run =
        scratch::sh(p, joined("smith cc --smith-header ", module, ".smith -o include/", module, ".h ", flags));
    scratch::expect_status(joined(module, ": the header is written"), 0, &run);
}

// Whether a line (fixed text) is in the header, as `grep -x` finds it; the file is read in process.
static void has(const scratch::Project *p, const char *name, const char *header, const char *line, Bool wanted) {
    const char *text = scratch::read(p, header);
    Usize size = c::strlen(line);
    Bool found = false;
    for (const char *at = text; *at != '\0';) {
        Usize length = 0;
        while (at[length] != '\n' && at[length] != '\0') {
            length++;
        }
        found = found || (length == size && c::strncmp(at, line, size) == 0);
        at += length;
        if (*at == '\n') at++;
    }
    const char *label = joined(name, ": ", line, wanted ? " is in the header" : " is not in the header");
    if (found != wanted) {
        test::note("%s", label);
    }
    test::check_equal(found, wanted);
}

// The header compiles on its own, as C and as C++, with the include path (when given).
static void standalone(const scratch::Project *p, const char *name, const char *header, const char *includes) {
    const char *labels[2] = {"c", "c++"};
    const char *modes[2] = {"-x c -std=gnu23", "-x c++ -std=c++23"};
    for (Usize i = 0; i < 2; i++) {
        scratch::Run run = scratch::sh(p, joined("smith cc -fsyntax-only ", modes[i], " ", includes, " ", header));
        scratch::expect_status(joined(name, " compiles alone (", labels[i], ")"), 0, &run);
    }
}

// The header of every library module, written by the smith under test into generated/ (they include one another, so
// all are written), and the one named compiled on its own. This stays end to end: written in process, the twenty
// headers cost about 10 s of CPU a test in the sanitized runner, far more than the command's processes (issue #646).
// The headers are written once for each smith under test and set of library sources, in $SMITH_TEST_CACHE/headers-<key>
// (a lock folder makes one test the writer and the others wait, as runner.smith's shared build does), and each test
// compiles its own header from there: 28 tests that each wrote all twenty cost 1.2 s of CPU each (#638).
constexpr char generated_script[_] =
    "if [ \"$(uname -s)\" = Darwin ]; then sf='-f %N_%m_%z'; else sf='-c %n_%Y_%s'; fi; "
    "key=$( { stat $sf \"$SMITH_SELF\"; cat \"$SMITH_REPO\"/lib/std/*.smith; } | shasum -a 256 | cut -c1-20 ); "
    "c=$SMITH_TEST_CACHE/headers-$key; "
    "if [ ! -e \"$c/done\" ]; then "
    "if mkdir \"$c.lock\" 2>/dev/null; then "
    "rm -rf \"$c\"; mkdir -p \"$c/generated\" && cd \"$SMITH_REPO\" && "
    "for f in lib/std/*.smith; do case \"$f\" in *_test.smith) ;; "
    "*) \"$SMITH_SELF\" cc --smith-header \"$f\" -o \"$c/generated/$(basename \"$f\" .smith).h\" || "
    "{ rm -rf \"$c\" \"$c.lock\"; exit 1; };; esac; done && : >\"$c/done\"; rmdir \"$c.lock\"; "
    "else n=0; until [ -e \"$c/done\" ]; do "
    "[ -d \"$c.lock\" ] || { echo \"the headers were not written\"; exit 1; }; "
    "n=$((n + 1)); [ $n -lt 3000 ] || { echo \"timed out waiting for the headers\"; exit 1; }; "
    "perl -e 'select(undef, undef, undef, 0.2)'; done; fi; fi; echo \"$c/generated\"";

static void generated(const char *name) {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *folder = scratch::capture(&p, generated_script);
    scratch::expect_contains("the headers are written", folder, "/generated");
    standalone(&p, joined(name, ".h"), joined(folder, "/", name, ".h"),
               joined("-I ", folder, " -I \"$SMITH_REPO/.smith/include\""));
}

// The names in lib/std of the repository, one a line, listed through std::files so that the record of the test
// names the listing and a module added there selects the test.
static const char *library_names() {
    env::Value repo = env::get("SMITH_REPO");
    const char *folder = joined(repo == .some ? repo.some.data : ".", "/lib/std");
    files::EntriesResult listed = files::list(folder[0:c::strlen(folder)]);
    files::Entries entries = {};
    switch (listed) {
    case .ok:
        entries = listed.ok;
        break;
    case .error:
        test::note("%s cannot be listed", folder);
        test::check_condition(false); // ends the test
    }
    const char *names = "";
    for (Usize i = 0; i < countof(entries); i++) {
        names = joined(names, entries[i].name.data, "\n");
    }
    return names;
}

// 1. The headers of the libraries, which are build outputs and not in git.

export void test_every_library_module_has_a_header_test() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write(&p, "names", library_names());
    scratch::copy_tree(&p, "tests/headers_test.smith", "headers_test.smith");
    scratch::Run run =
        scratch::sh(&p, "for f in $(grep '[.]smith$' names | grep -v '_test.smith'); do "
                        "grep -q \"generated(\\\"${f%.smith}\\\")\" headers_test.smith || echo \"$f\"; done");
    scratch::expect_text("library modules with no header test", "", run.out);
}

// The lowering reads the shapes of `option` and `result` from two lines it carries itself (runtime/lang_enum.c),
// because their headers are not in git: the generated headers must say the same.
export void test_the_shapes_the_lowering_carries_are_the_ones_the_headers_write() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write_header_of(&p, "lib/std/option.smith", "option.h");
    scratch::write_header_of(&p, "lib/std/result.smith", "result.h");
    has(&p, "option", "option.h", "// smith-eshape: Option(T) { T some ; none ; }", true);
    has(&p, "result", "result.h", "// smith-eshape: Result(T,E) { T ok ; E error ; }", true);
}

