// 2. The rule.

export void test_an_import_only_a_body_uses_stays_out(io::Io *io) {
    scratch::Project p = make_project(io);
    make_header(&p, "t/body", "");
    has(&p, "body: an import only a body uses", "include/t/body.h", "#include <stdio.h>", false);
    has(&p, "every header: the sized types' headers", "include/t/body.h", "#include <stdint.h>", true);
    standalone(&p, "t/body.h", "include/t/body.h", "-I include");
}

export void test_an_import_an_exports_type_uses_goes_in(io::Io *io) {
    scratch::Project p = make_project(io);
    make_header(&p, "t/typed", "");
    has(&p, "typed: an import an export's type uses", "include/t/typed.h", "#include <stdio.h>", true);
    standalone(&p, "t/typed.h", "include/t/typed.h", "-I include");
}

export void test_an_include_never_goes_in(io::Io *io) {
    scratch::Project p = make_project(io);
    make_header(&p, "t/include", "");
    has(&p, "include: an #include", "include/t/include.h", "#include <stdio.h>", false);
    has(&p, "include: an #include", "include/t/include.h", "#include <string.h>", false);
    standalone(&p, "t/include.h", "include/t/include.h", "-I include");
}

export void test_of_two_imports_the_one_that_declares_the_name_goes_in(io::Io *io) {
    scratch::Project p = make_project(io);
    make_header(&p, "t/two", "");
    has(&p, "two: the import that declares the name", "include/t/two.h", "#include <stdio.h>", true);
    has(&p, "two: the one that does not", "include/t/two.h", "#include <string.h>", false);
    standalone(&p, "t/two.h", "include/t/two.h", "-I include");
}

export void test_of_two_imports_the_one_that_declares_the_tag_goes_in(io::Io *io) {
    scratch::Project p = make_project(io);
    make_header(&p, "t/tag", "");
    has(&p, "tag: the import that declares the tag", "include/t/tag.h", "#include <sys/stat.h>", true);
    has(&p, "tag: the one that does not", "include/t/tag.h", "#include <stdio.h>", false);
    standalone(&p, "t/tag.h", "include/t/tag.h", "-I include");
}

// A module is included relative to the header that includes it, so the headers of one tree find each other with no
// include path of their own (a stage0 compiling smith.c has none).
export void test_an_imported_module_an_export_uses_is_included(io::Io *io) {
    scratch::Project p = make_project(io);
    make_header(&p, "t/point", "");
    make_header(&p, "t/uses", "");
    has(&p, "uses: an imported module an export's type uses", "include/t/uses.h", "#include \"point.h\"", true);
    standalone(&p, "t/point.h", "include/t/point.h", "-I include");
    standalone(&p, "t/uses.h", "include/t/uses.h", "-I include");
}

export void test_an_imported_module_only_a_body_uses_is_not_included(io::Io *io) {
    scratch::Project p = make_project(io);
    make_header(&p, "t/point", "");
    make_header(&p, "t/body_module", "");
    has(&p, "body_module: an imported module only a body uses", "include/t/body_module.h", "#include \"point.h\"",
        false);
    standalone(&p, "t/body_module.h", "include/t/body_module.h", "-I include");
}

export void test_a_module_in_another_folder_is_included_relative(io::Io *io) {
    scratch::Project p = make_project(io);
    make_header(&p, "t/point", "");
    make_header(&p, "u/far", "");
    has(&p, "far: a module in another folder", "include/u/far.h", "#include \"../t/point.h\"", true);
    standalone(&p, "u/far.h", "include/u/far.h", "-I include");
}

export void test_modules_in_a_folder_above_and_beside_are_included_relative(io::Io *io) {
    scratch::Project p = make_project(io);
    make_header(&p, "t/point", "");
    make_header(&p, "u/far", "");
    make_header(&p, "u/deep/farther", "");
    has(&p, "farther: a module in a folder above", "include/u/deep/farther.h", "#include \"../../t/point.h\"", true);
    has(&p, "farther: a module beside the folder", "include/u/deep/farther.h", "#include \"../far.h\"", true);
    standalone(&p, "u/deep/farther.h", "include/u/deep/farther.h", "-I include");
    // and with no include path at all: the header finds the headers it includes beside itself
    const char *labels[2] = {"c", "c++"};
    const char *modes[2] = {"-x c -std=gnu23", "-x c++ -std=c++23"};
    for (usize i = 0; i < 2; i++) {
        scratch::Run run =
            scratch::sh(&p, join(&p, "smith cc -fsyntax-only ", join(&p, modes[i], " include/u/deep/farther.h")));
        scratch::expect_status(
            format::push(&p.io->arena, "u/deep/farther.h compiles with no include path (", labels[i], ")").data, 0,
            &run);
    }
}

// 3. A generic, and a long chain of modules.

// A generic called with its type written in a body needs no instance in a header: it stays a plain call.
export void test_a_generic_with_its_type_written_in_a_body_does_not_stop_the_header(io::Io *io) {
    scratch::Project p = make_project(io);
    make_header(&p, "t/typed_call", "-I \"$SMITH_REPO/include\"");
}

// The files chain/m0 to chain/m19, each importing the next.
static void write_chain(const scratch::Project *p) {
    for (usize i = 0; i < chain_length; i++) {
        const char *text =
            i + 1 < chain_length
                ? format::push(&p->io->arena, "module chain::m", i, ";\nimport chain::m", i + 1, ";\nexport u32 m", i,
                               "(void) { return m", i + 1, "::m", i + 1, "() + 1; }\n")
                      .data
                : format::push(&p->io->arena, "module chain::m", i, ";\nexport u32 m", i, "(void) { return 1; }\n")
                      .data;
        scratch::write(p, format::push(&p->io->arena, "chain/m", i, ".smith").data, text);
    }
}

// The headers of the chain from the last to the second, as a build makes them.
static void make_chain_headers(const scratch::Project *p) {
    for (usize i = chain_length; i-- > 1;) {
        scratch::Run run = scratch::sh(p, format::push(&p->io->arena, "smith cc --smith-header chain/m", i,
                                                       ".smith -o include/chain/m", i, ".h -I include")
                                              .data);
        scratch::expect_status("chain: a header of the chain", 0, &run);
    }
}

// A module's imports are read, and theirs: a chain longer than the old limit of eight modules, by source and by header.
export void test_a_chain_of_twenty_modules_is_read_by_source(io::Io *io) {
    scratch::Project p = make_project(io);
    write_chain(&p);
    scratch::Run run = scratch::sh(&p, "smith cc --smith-header chain/m0.smith -o chain-source.h");
    scratch::expect_status("chain: twenty modules read by source", 0, &run);
}

export void test_a_chain_of_twenty_modules_is_read_by_header(io::Io *io) {
    scratch::Project p = make_project(io);
    write_chain(&p);
    make_chain_headers(&p);
    scratch::Run run = scratch::sh(&p, "smith cc --smith-header chain/m0.smith -o chain-headers.h -I include");
    scratch::expect_status("chain: twenty modules read by header", 0, &run);
}

export void test_an_import_after_twenty_others_is_still_found(io::Io *io) {
    scratch::Project p = make_project(io);
    write_chain(&p);
    make_header(&p, "t/point", "");
    make_chain_headers(&p);
    scratch::Run run = scratch::sh(&p, "smith cc --smith-header chain/last.smith -o chain-last.h -I include");
    scratch::expect_status("chain: an import after twenty others is still found", 0, &run);
}

export void test_more_modules_than_the_limit_is_an_error_that_names_it(io::Io *io) {
    scratch::Project p = make_project(io);
    for (usize i = 0; i < deep_length; i++) {
        const char *text = i + 1 < deep_length
                               ? format::push(&io->arena, "module deep::m", i, ";\nimport deep::m", i + 1,
                                              ";\nexport u32 m", i, "(void);\n")
                                     .data
                               : format::push(&io->arena, "module deep::m", i, ";\nexport u32 m", i, "(void);\n").data;
        scratch::write(&p, format::push(&io->arena, "deep/m", i, ".smith").data, text);
    }
    scratch::Run run = scratch::sh(&p, "smith cc --smith-header deep/m0.smith -o deep.h");
    scratch::expect_failure("deep: more modules than the limit fails", &run);
    scratch::expect_contains("deep: and the error names the limit", run.err, "smith_raw_modules_max");
}
