// What a module's generated C header includes: exactly what its exported declarations need
// (knowledge/smith-module-headers.md).
//   1. the generated header of every library module (lib/smith/*.smith; none is in git) compiles on its own, as
//      C and as C++; a library added there needs a test here: `test_every_library_module_has_a_header_test` says which;
//   2. the rule, on the small modules of tests/build_fixtures/headers: an import only a body uses stays out; an import
//   an
//      export's type uses goes in; of two imports the one that declares the name goes in; an imported module whose type
//      an export uses is included, and one only a body uses is not; an `#include` never goes in; and each of these
//      headers compiles on its own too;
//   3. a generic called with its type written in a body does not stop the header, and a chain of modules longer than
//   the
//      old limit of eight is read by source and by header, up to the limit that is an error naming it.
module headers_test;

import smith::format;
import smith::io;
import smith::test;
import scratch;

constexpr usize chain_length = 20;
constexpr usize deep_length = 140;

// A project of the fixture, with the folders the headers go to.
static scratch::Project make_project(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "headers");
    scratch::Run made = scratch::sh(&p, "mkdir -p include/t include/u/deep include/chain deep");
    scratch::expect_status("the include folders are made", 0, &made);
    return p;
}

static const char *join(const scratch::Project *p, const char *a, const char *b) {
    return format::push(&p->io->arena, a, b).data;
}

// The header of a module (`t/body` is t/body.smith) written to include/t/body.h; flags are extra compiler flags.
static void make_header(const scratch::Project *p, const char *module, const char *flags) {
    const char *command =
        format::push(&p->io->arena, "smith cc --smith-header ", module, ".smith -o include/", module, ".h ", flags)
            .data;
    scratch::Run run = scratch::sh(p, command);
    scratch::expect_status(join(p, module, ": the header is written"), 0, &run);
}

// Whether a line (fixed text) is in the header, as `grep -x` finds it.
static void has(const scratch::Project *p, const char *name, const char *header, const char *line, bool wanted) {
    const char *command = format::push(&p->io->arena, "grep -qxF '", line, "' ", header).data;
    scratch::Run run = scratch::sh(p, command);
    const char *label =
        format::push(&p->io->arena, name, ": ", line, wanted ? " is in the header" : " is not in the header").data;
    scratch::expect_status(label, wanted ? 0 : 1, &run);
}

// The header compiles on its own, as C and as C++, with the include path (when given).
static void standalone(const scratch::Project *p, const char *name, const char *header, const char *includes) {
    const char *labels[2] = {"c", "c++"};
    const char *modes[2] = {"-x c -std=gnu23", "-x c++ -std=c++23"};
    for (usize i = 0; i < 2; i++) {
        const char *command =
            format::push(&p->io->arena, "smith cc -fsyntax-only ", modes[i], " ", includes, " ", header).data;
        scratch::Run run = scratch::sh(p, command);
        scratch::expect_status(format::push(&p->io->arena, name, " compiles alone (", labels[i], ")").data, 0, &run);
    }
}

// The header of every library module, written by the smith under test into generated/ (they include one another, so
// all are written), and the one named compiled on its own.
static void generated(io::Io *io, const char *name) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run made = scratch::sh(
        &p, "mkdir generated && for f in \"$SMITH_REPO\"/lib/smith/*.smith; do case \"$f\" in *_test.smith) ;; "
            "*) \"$SMITH_SELF\" cc --smith-header \"$f\" -o \"generated/$(basename \"$f\" .smith).h\" || exit 1;; "
            "esac; done");
    scratch::expect_status("the headers are written", 0, &made);
    const char *header = format::push(&io->arena, "generated/", name, ".h").data;
    standalone(&p, join(&p, name, ".h"), header, "-I generated -I \"$SMITH_REPO/.smith/include\"");
}

// 1. The headers of the libraries, which are build outputs and not in git.

export void test_every_library_module_has_a_header_test(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run run = scratch::sh(
        &p, "cd \"$SMITH_REPO/lib/smith\" && for f in $(ls *.smith | grep -v '_test.smith'); do "
            "grep -q \"generated(io, \\\"${f%.smith}\\\")\" ../../tests/headers_test.smith || echo \"$f\"; done");
    scratch::expect_text("library modules with no header test", "", run.out);
}

// The lowering reads the shapes of `option` and `result` from two lines it carries itself (runtime/lang_enum.c),
// because their headers are not in git: the generated headers must say the same.
export void test_the_shapes_the_lowering_carries_are_the_ones_the_headers_write(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run made =
        scratch::sh(&p, "\"$SMITH_SELF\" cc --smith-header \"$SMITH_REPO/lib/smith/option.smith\" -o option.h && "
                        "\"$SMITH_SELF\" cc --smith-header \"$SMITH_REPO/lib/smith/result.smith\" -o result.h");
    scratch::expect_status("the headers are written", 0, &made);
    has(&p, "option", "option.h", "// smith-eshape: option(T) { T some ; none ; }", true);
    has(&p, "result", "result.h", "// smith-eshape: result(T,E) { T ok ; E error ; }", true);
}

