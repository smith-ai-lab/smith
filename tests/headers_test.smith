// A module is included relative to the header that includes it, so the headers of one tree find each other with no
// include path of their own (a stage0 compiling smith.c has none).
export void test_an_imported_module_an_export_uses_is_included() {
    scratch::Project p = make_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write_header(&p, "t/point");
    scratch::write_header(&p, "t/uses");
    has(&p, "uses: an imported module an export's type uses", "include/t/uses.h", "#include \"point.h\"", true);
    standalone(&p, "t/point.h", "include/t/point.h", "-I include");
    standalone(&p, "t/uses.h", "include/t/uses.h", "-I include");
}

export void test_an_imported_module_only_a_body_uses_is_not_included() {
    scratch::Project p = make_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write_header(&p, "t/point");
    scratch::write_header(&p, "t/body_module");
    has(&p, "body_module: an imported module only a body uses", "include/t/body_module.h", "#include \"point.h\"",
        false);
    standalone(&p, "t/body_module.h", "include/t/body_module.h", "-I include");
}

export void test_a_module_in_another_folder_is_included_relative() {
    scratch::Project p = make_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write_header(&p, "t/point");
    scratch::write_header(&p, "u/far");
    has(&p, "far: a module in another folder", "include/u/far.h", "#include \"../t/point.h\"", true);
    standalone(&p, "u/far.h", "include/u/far.h", "-I include");
}

export void test_modules_in_a_folder_above_and_beside_are_included_relative() {
    scratch::Project p = make_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write_header(&p, "t/point");
    scratch::write_header(&p, "u/far");
    scratch::write_header(&p, "u/deep/farther");
    has(&p, "farther: a module in a folder above", "include/u/deep/farther.h", "#include \"../../t/point.h\"", true);
    has(&p, "farther: a module beside the folder", "include/u/deep/farther.h", "#include \"../far.h\"", true);
    standalone(&p, "u/deep/farther.h", "include/u/deep/farther.h", "-I include");
    // and with no include path at all: the header finds the headers it includes beside itself
    const char *labels[2] = {"c", "c++"};
    const char *modes[2] = {"-x c -std=gnu23", "-x c++ -std=c++23"};
    for (Usize i = 0; i < 2; i++) {
        scratch::Run run = scratch::sh(&p, joined("smith cc -fsyntax-only ", modes[i], " include/u/deep/farther.h"));
        scratch::expect_status(joined("u/deep/farther.h compiles with no include path (", labels[i], ")"), 0, &run);
    }
}

// 3. A generic, and a long chain of modules.

// A generic called with its type written in a body needs no instance in a header: it stays a plain call.
export void test_a_generic_with_its_type_written_in_a_body_does_not_stop_the_header() {
    scratch::Project p = make_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    make_header(&p, "t/typed_call", "-I \"$SMITH_REPO/.smith/include\"");
}

// The files chain/m0 to chain/m19, each importing the next.
static void write_chain(const scratch::Project *p) {
    for (Usize i = 0; i < chain_length; i++) {
        const char *text = i + 1 < chain_length
                               ? joined("module chain::m", i, ";\nimport chain::m", i + 1, ";\nexport U32 m", i,
                                        "(void) { return m", i + 1, "::m", i + 1, "() + 1; }\n")
                               : joined("module chain::m", i, ";\nexport U32 m", i, "(void) { return 1; }\n");
        scratch::write(p, joined("chain/m", i, ".smith"), text);
    }
}

// The headers of the chain from the last to the second, as a build makes them.
static void make_chain_headers(const scratch::Project *p) {
    for (Usize i = chain_length; i-- > 1;) {
        scratch::Run run = scratch::sh(
            p, joined("smith cc --smith-header chain/m", i, ".smith -o include/chain/m", i, ".h -I include"));
        scratch::expect_status("chain: a header of the chain", 0, &run);
    }
}

// A module's imports are read, and theirs: a chain longer than the old limit of eight modules, by source and by header.
export void test_a_chain_of_twenty_modules_is_read_by_source() {
    scratch::Project p = make_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    write_chain(&p);
    scratch::Run run = scratch::sh(&p, "smith cc --smith-header chain/m0.smith -o chain-source.h");
    scratch::expect_status("chain: twenty modules read by source", 0, &run);
}

export void test_a_chain_of_twenty_modules_is_read_by_header() {
    scratch::Project p = make_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    write_chain(&p);
    make_chain_headers(&p);
    scratch::Run run = scratch::sh(&p, "smith cc --smith-header chain/m0.smith -o chain-headers.h -I include");
    scratch::expect_status("chain: twenty modules read by header", 0, &run);
}

export void test_an_import_after_twenty_others_is_still_found() {
    scratch::Project p = make_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    write_chain(&p);
    make_chain_headers(&p);
    scratch::Run run = scratch::sh(&p, "smith cc --smith-header chain/last.smith -o chain-last.h -I include");
    scratch::expect_status("chain: an import after twenty others is still found", 0, &run);
}

export void test_more_modules_than_the_limit_is_an_error_that_names_it() {
    scratch::Project p = make_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    for (Usize i = 0; i < deep_length; i++) {
        const char *text = i + 1 < deep_length ? joined("module deep::m", i, ";\nimport deep::m", i + 1,
                                                        ";\nexport U32 m", i, "(void);\n")
                                               : joined("module deep::m", i, ";\nexport U32 m", i, "(void);\n");
        scratch::write(&p, joined("deep/m", i, ".smith"), text);
    }
    scratch::Run run = scratch::sh(&p, "smith cc --smith-header deep/m0.smith -o deep.h");
    scratch::expect_failure("deep: more modules than the limit fails", &run);
    scratch::expect_contains("deep: and the error names the limit", run.err, "smith_raw_modules_max");
}

// 4. The lines of a generic's record are relative to its first line (knowledge/smith-module-headers.md).

static const char *generic_source =
    "module g::gen;\n\nexport T twice(constexpr Type T, T x) {\n    T y = x + x;\n    return y + \"oops\";\n}\n";

// Adding lines above a generic changes no byte of its header but the one stored first line.
export void test_lines_added_above_a_generic_change_only_its_stored_first_line() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run made = scratch::sh(&p, "mkdir g");
    scratch::expect_status("the folder is made", 0, &made);
    scratch::write(&p, "g/gen.smith", generic_source);
    scratch::Run first = scratch::sh(&p, "smith cc --smith-header g/gen.smith -o first.h");
    scratch::expect_status("the first header is written", 0, &first);
    scratch::write(&p, "g/gen.smith", joined("// one\n// two\n// three\n\n", generic_source));
    scratch::Run second = scratch::sh(&p, "smith cc --smith-header g/gen.smith -o second.h");
    scratch::expect_status("the second header is written", 0, &second);
    scratch::expect_text("one line differs", "1", scratch::capture(&p, "diff first.h second.h | grep -c '^<'"));
    scratch::expect_text("the differing line is the record, with its first line stored",
                         "// smith-generic: g::gen twice g_gen_twice g/gen.smith -@7 1 2 9 10 |",
                         scratch::capture(&p, "grep -o '^// smith-generic: [^|]*|' second.h"));
}

// An error in a generic's body still points at its line of the source, whatever the lines above it.
export void test_an_error_in_a_generic_body_points_at_its_line() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run made = scratch::sh(&p, "mkdir g");
    scratch::expect_status("the folder is made", 0, &made);
    scratch::write(&p, "g/gen.smith", joined("// one\n// two\n// three\n\n", generic_source));
    scratch::write(&p, "u.smith", "import g::gen;\nI32 main(void) { return gen::twice(I32, 1); }\n");
    scratch::Run header =
        scratch::sh(&p, "mkdir -p include/g && smith cc --smith-header g/gen.smith -o include/g/gen.h");
    scratch::expect_status("the header is written", 0, &header);
    const char *text = scratch::capture(&p, "smith cc -fsyntax-only -I include u.smith 2>&1");
    scratch::expect_contains("the error is at line 9", text, "g/gen.smith:9:12: error:");
    scratch::expect_contains("the request is at line 2", text, "u.smith:2:30: note: in instance g::gen::twice(I32)");
}

// 5. `--smith-headers` writes several headers in one process (issue #639).

static const char *const batch_one = "module g::one;\n\nexport I32 one(void) { return 1; }\n";
static const char *const batch_two = "module g::two;\n\nexport I32 two(void) { return 2; }\n";

// The headers of a batch are the bytes `--smith-header` writes for each, and a second run writes none of them again.
export void test_a_batch_of_headers_is_the_bytes_of_each_header() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run made = scratch::sh(&p, "mkdir -p g one two");
    scratch::expect_status("the folders are made", 0, &made);
    scratch::write(&p, "g/one.smith", batch_one);
    scratch::write(&p, "g/two.smith", batch_two);
    scratch::Run alone = scratch::sh(
        &p, "smith cc --smith-header g/one.smith -o one/one.h -std=gnu23 && smith cc --smith-header g/two.smith -o "
            "one/two.h -std=gnu23");
    scratch::expect_status("each header is written alone", 0, &alone);
    scratch::Run batch =
        scratch::sh(&p, "smith cc --smith-headers -std=gnu23 -- g/one.smith two/one.h g/two.smith two/two.h");
    scratch::expect_status("the batch is written", 0, &batch);
    scratch::Run first = scratch::sh(&p, "cmp one/one.h two/one.h");
    scratch::expect_status("the first header is the same", 0, &first);
    scratch::Run second = scratch::sh(&p, "cmp one/two.h two/two.h");
    scratch::expect_status("the second header is the same", 0, &second);
    scratch::Run again = scratch::sh(
        &p, "cp -p two/one.h keep.h && smith cc --smith-headers -std=gnu23 -- g/one.smith two/one.h g/two.smith "
            "two/two.h && test ! two/one.h -nt keep.h");
    scratch::expect_status("a batch whose bytes are the same writes nothing", 0, &again);
}

// A header that fails is reported, the others of the batch are still written, and the status is not 0.
export void test_a_batch_with_a_bad_module_fails_and_writes_the_rest() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run made = scratch::sh(&p, "mkdir -p g out");
    scratch::expect_status("the folders are made", 0, &made);
    scratch::write(&p, "g/bad.smith", "I32 not_a_module(void) { return 0; }\n");
    scratch::write(&p, "g/two.smith", batch_two);
    scratch::Run run = scratch::sh(&p, "smith cc --smith-headers -- g/bad.smith out/bad.h g/two.smith out/two.h");
    scratch::expect_failure("the batch fails", &run);
    scratch::expect_contains("and says why", run.err, "not a module");
    scratch::Run written = scratch::sh(&p, "test -f out/two.h");
    scratch::expect_status("the good header is written", 0, &written);
}

// An odd list is a usage error.
export void test_a_batch_with_an_unpaired_file_is_a_usage_error() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = scratch::sh(&p, "smith cc --smith-headers -- a.smith");
    scratch::expect_failure("an odd list fails", &run);
    scratch::expect_contains("and shows the usage", run.err, "usage: smith cc --smith-headers");
}
