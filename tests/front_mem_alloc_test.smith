// Tests of `mem.alloc(T, n)` and `mem.alloc(T, [a, b])` in the new front end (#2527): the call is known to the
// checker and the emitter (front::types_builtin's `alloc`, front::emit_builtin's `shaped_alloc`). Each module is
// compiled in a bare folder by `smith cc --front-end=new`, as a user's is, so it imports the real std.mem and
// std.arena; a C `main` calls its `check()`, which returns 0 when every step worked (#2853: no stand-ins). The last
// tests are the checker's errors.
module front_mem_alloc_test;

import front::roots;
import std::console;
import std::format;
import std::process;
import std::test;
import <stdio.h>;
import <stdlib.h>;
import <sys/stat.h>;
import <unistd.h>;

static Str as_str(char chars[:]) {
    return chars;
}

static const char *smith_path() {
    const char *self = c::getenv("SMITH_SELF");
    return self != nullptr ? self : "smith";
}

static void write_text(Str path, Str text) {
    c::FILE *file = c::fopen(path.data, "w");
    test::check_equal(file != nullptr, true);
    if (file == nullptr) return;
    c::fwrite(text.data, 1, countof(text), file);
    c::fclose(file);
}

static I32 sh_status(Str command) {
    const char *const argv[4] = {"sh", "-c", command.data, nullptr};
    process::OutputResult done = process::run(argv[0:3]);
    if (done != .ok || done.ok.exit.signal != 0) return -1;
    return done.ok.exit.status;
}

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        if (roots::same(text[i:i + countof(needle)], needle)) return true;
    }
    return false;
}

static Str prefix() {
    return c::access("/System/Library/CoreServices", 0) == 0 ? "_" : "";
}

// Writes the module `name` with `body` in a bare folder (`src/<name>.smith`, no `lib/`) and runs `smith cc
// --front-end=new` there, as a user would: the real std.mem and std.arena come from the std smith embeds, and a link
// gets their objects. `then` is the rest of the command line; the compiler's errors are in `<folder>/errors`. A user's
// environment has none of what other tests on this worker set and leave: their cimport flags (paths of their own
// folders, without smith's headers) or a cache folder they removed.
static I32 smith_cc(Str folder, Str name, Str body, Str then) {
    c::mkdir(folder.data, 0o700);
    c::mkdir(as_str(format::push(folder, "/src")).data, 0o700);
    write_text(as_str(format::push(folder, "/src/", name, ".smith")), body);
    return sh_status(
        as_str(format::push("cd ", folder, " && env -u SMITH_FRONT_CIMPORT_FLAGS -u XDG_CACHE_HOME ", smith_path(),
                            " cc --front-end=new src/", name, ".smith ", then, " 2>errors")));
}

static Str folder_for(Str name) {
    return as_str(format::push("/tmp/front_mem_alloc_", (I64)c::getpid(), "_", name));
}

static void clean(Str folder) {
    const char *const argv[4] = {"rm", "-rf", folder.data, nullptr};
    process::OutputResult done = process::run(argv[0:3]);
    test::check_equal(done == .ok, true);
}

static Str text_of(Str path) {
    const char *const argv[3] = {"cat", path.data, nullptr};
    process::OutputResult done = process::run(argv[0:2]);
    if (done != .ok) return "";
    return as_str(format::push(format::bytes((const char *)done.ok.output.data, countof(done.ok.output))));
}

// `body` is a module whose `pub fn check() -> i32` returns 0 when the allocation did what it should; a C `main`
// calls it, linked as a user's program is.
static void passes(Str name, Str body) {
    Str folder = folder_for(name);
    c::mkdir(folder.data, 0o700);
    Str main_c = as_str(format::push("int check(void) __asm__(\"", prefix(), name, "::check\");\n",
                                     "int main(void) { return check(); }\n"));
    write_text(as_str(format::push(folder, "/main.c")), main_c);
    I32 linked = smith_cc(folder, name, body, "main.c -o prog");
    if (linked != 0) (void)console::print_error(text_of(as_str(format::push(folder, "/errors"))));
    test::check_equal(linked, 0);
    if (linked == 0) test::check_equal(sh_status(as_str(format::push(folder, "/prog"))), 0);
    clean(folder);
}

// `body` fails to compile with a message that has `needle`.
static void refused(Str name, Str body, Str needle) {
    Str folder = folder_for(name);
    test::check_equal(smith_cc(folder, name, body, as_str(format::push("-c -o ", name, ".o"))) != 0, true);
    Str errors = text_of(as_str(format::push(folder, "/errors")));
    if (!has(errors, needle)) test::check_equal(errors, needle);
    clean(folder);
}

// `mem.alloc(T, n)` is `[]T` of n zeroed elements that the caller writes.
export void test_front_mem_alloc_a_length_is_a_slice() {
    passes("length", "import std.mem\n\n"
                     "pub fn check() -> i32:\n"
                     "    n: usize = 4\n"
                     "    row := mem.alloc(u8, n)\n"
                     "    if countof(row) != 4 or row[3] != 0:\n        return 1\n"
                     "    row[3] = 7\n"
                     "    if row[3] != 7 or row[0] != 0:\n        return 2\n"
                     "    0\n");
}

// `mem.alloc(T, [a, b])` is one zeroed block `[,]T` indexed `x[i, j]`; each size is a `usize`.
export void test_front_mem_alloc_a_shape_is_one_block() {
    passes("shape", "import std.mem\n\n"
                    "pub fn check() -> i32:\n"
                    "    rows: u32 = 3\n"
                    "    grid := mem.alloc(f64, [rows.to(usize), 5])\n"
                    "    if grid[2, 4] != 0.0:\n        return 1\n"
                    "    grid[2, 4] = 1.5\n"
                    "    if grid[2, 4] != 1.5 or grid[0, 0] != 0.0:\n        return 2\n"
                    "    cube := mem.alloc(i32, [2, 3, 4])\n"
                    "    cube[1, 2, 3] = 9\n"
                    "    if cube[1, 2, 3] != 9 or cube[0, 0, 0] != 0:\n        return 3\n"
                    "    0\n");
}

// A block passes to a function that takes `[,]T`, and the result type is one a signature writes.
export void test_front_mem_alloc_a_block_is_passed_and_returned() {
    passes("passed", "import std.mem\n\n"
                     "fn grid(rows: usize, cols: usize) -> [,]f64:\n"
                     "    mem.alloc(f64, [rows, cols])\n\n"
                     "fn corner(g: [,]f64) -> f64:\n"
                     "    g[1, 2]\n\n"
                     "pub fn check() -> i32:\n"
                     "    g := grid(2, 3)\n"
                     "    g[1, 2] = 4.0\n"
                     "    if corner(g) != 4.0:\n        return 1\n"
                     "    0\n");
}

// In a generic, `T` is the element type of the instance and the size a run-time value.
export void test_front_mem_alloc_in_a_generic() {
    passes("generic", "import std.mem\n\n"
                      "fn sized(T: type, n: usize) -> []T:\n"
                      "    mem.alloc(T, n)\n\n"
                      "pub fn check() -> i32:\n"
                      "    words := sized(u16, 6)\n"
                      "    if countof(words) != 6 or words[5] != 0:\n        return 1\n"
                      "    wide := sized(f64, 2)\n"
                      "    if countof(wide) != 2:\n        return 2\n"
                      "    0\n");
}

// A size is a `usize`: a float is refused as it is anywhere a `usize` is expected.
export void test_front_mem_alloc_a_size_is_an_integer() {
    refused("float_size",
            "import std.mem\n\n"
            "pub fn check() -> i32:\n"
            "    x := mem.alloc(u8, 1.5)\n"
            "    0\n",
            "expected Usize, found F64");
}

// The first argument is a type.
export void test_front_mem_alloc_the_first_argument_is_a_type() {
    refused("value_first",
            "import std.mem\n\n"
            "pub fn check() -> i32:\n"
            "    n: usize = 2\n"
            "    x := mem.alloc(n, 4)\n"
            "    0\n",
            "is a type");
}

// `arena.push_slice(&a, T, n)` and `arena.push_slice(&a, T, [a, b])` are the same forms, pushed on the arena.
export void test_front_mem_alloc_arena_push_slice_takes_the_shape() {
    passes("arena", "import std.arena\n\n"
                    "pub fn check() -> i32:\n"
                    "    mut a := arena.growing(4096, nullptr)\n"
                    "    row := arena.push_slice(&a, u32, 3)\n"
                    "    if countof(row) != 3 or row[2] != 0:\n        return 1\n"
                    "    grid := arena.push_slice(&a, f32, [2, 4])\n"
                    "    grid[1, 3] = 2.0\n"
                    "    if grid[1, 3] != 2.0 or grid[0, 0] != 0.0:\n        return 2\n"
                    "    if row[0] != 0 or row[2] != 0:\n        return 3\n"
                    "    0\n");
}
