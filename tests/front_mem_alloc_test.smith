// Tests of `mem.alloc(T, n)` and `mem.alloc(T, [a, b])` in the new front end (#2527): the call is known to the
// checker and the emitter (front::types_builtin's `alloc`, front::emit_builtin's `shaped_alloc`) while
// lib/std/mem.smith is in today's syntax (#2539). A module in smith's own syntax imports a stand-in std.mem (the
// library folder of the test), is compiled by the driver, linked with a `main` whose `smith_mem_alloc_array` is
// calloc's, and run; `check()` returns 0 when every step worked. The last tests are the checker's errors.
module front_mem_alloc_test;

import front::compile;
import front::roots;
import std::format;
import std::process;
import std::test;
import <stdio.h>;
import <stdlib.h>;
import <sys/stat.h>;
import <unistd.h>;

static Str as_str(char chars[:]) {
    return chars;
}

static const char *smith_path() {
    const char *self = c::getenv("SMITH_SELF");
    return self != nullptr ? self : "smith";
}

static void write_text(Str path, Str text) {
    c::FILE *file = c::fopen(path.data, "w");
    test::check_equal(file != nullptr, true);
    if (file == nullptr) return;
    c::fwrite(text.data, 1, countof(text), file);
    c::fclose(file);
}

static I32 sh_status(Str command) {
    const char *const argv[4] = {"sh", "-c", command.data, nullptr};
    process::OutputResult done = process::run(argv[0:3]);
    if (done != .ok || done.ok.exit.signal != 0) return -1;
    return done.ok.exit.status;
}

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        if (roots::same(text[i:i + countof(needle)], needle)) return true;
    }
    return false;
}

static Str prefix() {
    return c::access("/System/Library/CoreServices", 0) == 0 ? "_" : "";
}

// The C side of the program: the checks a module's arithmetic and indexing can call, and the allocator std.mem's
// `smith_mem_alloc_array` is (zeroed memory of count items of size bytes).
static Str c_side() {
    return "#include <stdlib.h>\n"
           "void *smith_mem_alloc_array(unsigned long size, unsigned long count, unsigned long align) {\n"
           "    (void)align;\n    return calloc(count, size);\n}\n"
           "void *smith_arena_push_array(void *arena, unsigned long size, unsigned long count, unsigned long align) {\n"
           "    *(int *)arena += 1;\n    (void)align;\n    return calloc(count, size);\n}\n"
           "void smith_contract_fail_cast(unsigned long a, int b, const char *c) { __builtin_trap(); }\n"
           "void smith_contract_fail_index(unsigned long a, int b, unsigned long c) { __builtin_trap(); }\n"
           "void smith_contract_fail_overflow(const char *a, unsigned long b, unsigned long c, const char *d, "
           "const char *e) { __builtin_trap(); }\n"
           "void smith_contract_fail_negate(unsigned long a, const char *b, const char *c) { __builtin_trap(); }\n"
           "void smith_contract_fail_divide(const char *a, unsigned long b, int c, const char *d) { __builtin_trap(); "
           "}\n"
           "void smith_contract_fail_shift(const char *a, unsigned long b, unsigned long c, int d, unsigned e, "
           "const char *f, const char *g) { __builtin_trap(); }\n";
}

// The module `name` with `body`, a std.mem with the one-argument `alloc` (a generic nothing here instantiates) and a
// std.arena whose `Arena` counts the pushes of the C side.
static compile::Report compile_body(Str folder, Str name, Str body) {
    Str src = as_str(format::push(folder, "/src"));
    c::mkdir(folder.data, 0o700);
    c::mkdir(src.data, 0o700);
    c::mkdir(as_str(format::push(folder, "/lib")).data, 0o700);
    c::mkdir(as_str(format::push(folder, "/lib/std")).data, 0o700);
    write_text(as_str(format::push(folder, "/lib/std/mem.smith")), "pub fn alloc(T: type) -> *mut T:\n    nullptr\n");
    write_text(as_str(format::push(folder, "/lib/std/arena.smith")), "pub struct Arena:\n    pub pushes: i32\n");
    Str path = as_str(format::push(src, "/", name, ".smith"));
    write_text(path, body);
    roots::Roots folders = {.source = src, .library = as_str(format::push(folder, "/lib"))};
    return compile::file(path, as_str(format::push(folder, "/", name, ".o")), "", folders);
}

static Str folder_for(Str name) {
    return as_str(format::push("/tmp/front_mem_alloc_", (I64)c::getpid(), "_", name));
}

static void clean(Str folder) {
    const char *const argv[4] = {"rm", "-rf", folder.data, nullptr};
    process::OutputResult done = process::run(argv[0:3]);
    test::check_equal(done == .ok, true);
}

// `body` is a module whose `pub fn check() -> i32` returns 0 when the allocation did what it should.
static void passes(Str name, Str body) {
    Str folder = folder_for(name);
    compile::Report report = compile_body(folder, name, body);
    if (!report.ok) test::check_equal(report.text, as_str(format::push("")));
    if (report.ok) {
        Str main_c = as_str(format::push("int check(void) __asm__(\"", prefix(), name, "::check\");\n", c_side(),
                                         "int main(void) { return check(); }\n"));
        write_text(as_str(format::push(folder, "/main.c")), main_c);
        I32 linked = sh_status(as_str(
            format::push(smith_path(), " cc ", folder, "/main.c ", folder, "/", name, ".o -o ", folder, "/prog")));
        test::check_equal(linked, 0);
        if (linked == 0) test::check_equal(sh_status(as_str(format::push(folder, "/prog"))), 0);
    }
    clean(folder);
}

// `body` fails to compile with a message that has `needle`.
static void refused(Str name, Str body, Str needle) {
    Str folder = folder_for(name);
    compile::Report report = compile_body(folder, name, body);
    test::check_equal(report.ok, false);
    if (!has(report.text, needle)) test::check_equal(report.text, needle);
    clean(folder);
}

// `mem.alloc(T, n)` is `[]T` of n zeroed elements that the caller writes.
export void test_front_mem_alloc_a_length_is_a_slice() {
    passes("length", "import std.mem\n\n"
                     "pub fn check() -> i32:\n"
                     "    n: usize = 4\n"
                     "    row := mem.alloc(u8, n)\n"
                     "    if countof(row) != 4 || row[3] != 0:\n        return 1\n"
                     "    row[3] = 7\n"
                     "    if row[3] != 7 || row[0] != 0:\n        return 2\n"
                     "    0\n");
}

// `mem.alloc(T, [a, b])` is one zeroed block `[,]T` indexed `x[i, j]`; each size is a `usize`.
export void test_front_mem_alloc_a_shape_is_one_block() {
    passes("shape", "import std.mem\n\n"
                    "pub fn check() -> i32:\n"
                    "    rows: u32 = 3\n"
                    "    grid := mem.alloc(f64, [rows.to(usize), 5])\n"
                    "    if grid[2, 4] != 0.0:\n        return 1\n"
                    "    grid[2, 4] = 1.5\n"
                    "    if grid[2, 4] != 1.5 || grid[0, 0] != 0.0:\n        return 2\n"
                    "    cube := mem.alloc(i32, [2, 3, 4])\n"
                    "    cube[1, 2, 3] = 9\n"
                    "    if cube[1, 2, 3] != 9 || cube[0, 0, 0] != 0:\n        return 3\n"
                    "    0\n");
}

// A block passes to a function that takes `[,]T`, and the result type is one a signature writes.
export void test_front_mem_alloc_a_block_is_passed_and_returned() {
    passes("passed", "import std.mem\n\n"
                     "fn grid(rows: usize, cols: usize) -> [,]f64:\n"
                     "    mem.alloc(f64, [rows, cols])\n\n"
                     "fn corner(g: [,]f64) -> f64:\n"
                     "    g[1, 2]\n\n"
                     "pub fn check() -> i32:\n"
                     "    g := grid(2, 3)\n"
                     "    g[1, 2] = 4.0\n"
                     "    if corner(g) != 4.0:\n        return 1\n"
                     "    0\n");
}

// In a generic, `T` is the element type of the instance and the size a run-time value.
export void test_front_mem_alloc_in_a_generic() {
    passes("generic", "import std.mem\n\n"
                      "fn sized(T: type, n: usize) -> []T:\n"
                      "    mem.alloc(T, n)\n\n"
                      "pub fn check() -> i32:\n"
                      "    words := sized(u16, 6)\n"
                      "    if countof(words) != 6 || words[5] != 0:\n        return 1\n"
                      "    wide := sized(f64, 2)\n"
                      "    if countof(wide) != 2:\n        return 2\n"
                      "    0\n");
}

// A size is a `usize`: a float is refused as it is anywhere a `usize` is expected.
export void test_front_mem_alloc_a_size_is_an_integer() {
    refused("float_size",
            "import std.mem\n\n"
            "pub fn check() -> i32:\n"
            "    x := mem.alloc(u8, 1.5)\n"
            "    0\n",
            "expected Usize, found F64");
}

// The first argument is a type.
export void test_front_mem_alloc_the_first_argument_is_a_type() {
    refused("value_first",
            "import std.mem\n\n"
            "pub fn check() -> i32:\n"
            "    n: usize = 2\n"
            "    x := mem.alloc(n, 4)\n"
            "    0\n",
            "is a type");
}

// `arena.push_slice(&a, T, n)` and `arena.push_slice(&a, T, [a, b])` are the same forms, pushed on the arena.
export void test_front_mem_alloc_arena_push_slice_takes_the_shape() {
    passes("arena", "import std.arena\n\n"
                    "pub fn check() -> i32:\n"
                    "    mut a: arena.Arena = undefined\n"
                    "    a.pushes = 0\n"
                    "    row := arena.push_slice(&a, u32, 3)\n"
                    "    if countof(row) != 3 || row[2] != 0:\n        return 1\n"
                    "    grid := arena.push_slice(&a, f32, [2, 4])\n"
                    "    grid[1, 3] = 2.0\n"
                    "    if grid[1, 3] != 2.0 || grid[0, 0] != 0.0:\n        return 2\n"
                    "    if a.pushes != 2:\n        return 3\n"
                    "    0\n");
}
