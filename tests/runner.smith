// Helpers of the tests of smith_tests and of the runner it builds (tests/test_runner_*_test.smith, ported from
// tests/test.sh): a project made from the fixture `runner_base` (a build.c with smith_tests, the sanitizers on unless
// -DSAN=0) and the files of another fixture, the runner built in it, and its output read back without the timings.
// Every case runs the runner twice, as workers (the default) and with `--isolate` (a process per test), and both must
// give the same result. The texts the helpers
// return come from the allocator in force (a test's test::memory arena), and what they make for themselves they give
// back.
module runner;

import std::arena;
import std::format;
import std::mem;
import std::test;
import <string.h>;
import scratch;

// The runner's output without the timings: the slowest list is dropped and the summary's seconds are masked.
constexpr char plain_filter[_] = "sed -e '/^slowest:/,/^$/d' -e 's/ in [0-9.]* s$//' | sed '/./,$!d'";

// The shell filter that drops the timings from the runner's output.
export const char *plain_pipe() {
    return plain_filter;
}

// The arguments as a text of its own from the allocator in force.
const char *own(auto... args) {
    usize characters = format::length(args...);
    char *memory = (char *)mem::alloc_array_raw(sizeof(char), characters + 1, alignof(char));
    (void)format::to(memory, characters + 1, args...);
    return memory;
}

// The arguments as a text from the allocator in force.
const char *text_in(const scratch::Project *p, auto... args) {
    (void)p;
    return own(args...);
}

// Gives back a text from text_in.
static void done(const scratch::Project *p, const char *text) {
    (void)p;
    scratch::release(text);
}

// The output of a command run in the project, a text the caller keeps; the command is given back.
static const char *captured(const scratch::Project *p, const char *command) {
    const char *out = scratch::capture(p, command);
    done(p, command);
    return out;
}

// A command run in the project; the command is given back.
static scratch::Run run_text(const scratch::Project *p, const char *command) {
    scratch::Run run = scratch::sh(p, command);
    done(p, command);
    return run;
}

// A project: the build.c of `base` (runner_base, or runner_c for C only) with the files of the fixture `files` over it.
// The project is from scratch::make, which the test cleans (`defer scratch::clean(&p);`).
export scratch::Project project(const char *base, const char *files) {
    scratch::Project p = scratch::make("p", base);
    const char *from = own("tests/build_fixtures/", files);
    scratch::copy_tree(&p, from, "");
    scratch::release(from);
    return p;
}

// The script of `built_project`: the runner of a project is built once for every test of the run and of the runs after
// it (#639: each test of a file built the same runner, 3 s of CPU a test, 16 steps of which 14 compile the same
// libraries). The key is what the runner is made of: the project's files (and which build arguments), the libraries it
// compiles and the smith that compiles them. The first test to need one takes a lock by making a folder and builds a
// copy of the project in the cache; the others wait for its mark (the 600 s hang backstop, and a builder that failed
// removes the lock, which ends the wait); each test links `build/tests` (a copy would be a new program that macOS scans
// before it runs, seconds on a loaded host) and keeps the rest of its own project.
constexpr char shared_script[_] =
    "here=$SMITH_REPO; root=$SMITH_TEST_CACHE/runner; mkdir -p \"$root\"; "
    "if [ \"$(uname -s)\" = Darwin ]; then sf='-f %N_%m_%z'; else sf='-c %n_%Y_%s'; fi; "
    "key=$( { echo \"$ARGS\"; stat $sf \"$SMITH_SELF\" \"$here\"/lib/std/*.smith \"$here\"/lib/*.c \"$here\"/lib/*.h "
    "2>/dev/null; find . -name build -prune -o -name .smith -prune -o -type f -print | sort | while read -r f; do "
    "echo \"$f\"; cat \"$f\"; done; } | shasum -a 256 | cut -c1-20 ); c=$root/$key; "
    "if [ ! -e \"$c/done\" ]; then "
    "if mkdir \"$c.lock\" 2>/dev/null; then "
    "rm -rf \"$c\"; mkdir -p \"$c\" && cp -R . \"$c/proj\" && "
    "(cd \"$c/proj\" && env SMITH_OUTPUT=full smith build $ARGS >\"$c/log\" 2>&1) && : >\"$c/done\" || "
    "{ cp \"$c/log\" shared-build.log 2>/dev/null; cat shared-build.log; rm -rf \"$c\" \"$c.lock\"; exit 1; }; "
    "else n=0; until [ -e \"$c/done\" ]; do "
    "[ -d \"$c.lock\" ] || { echo \"the shared build of the runner failed\"; exit 1; }; "
    "n=$((n + 1)); [ $n -lt 3000 ] || { echo \"timed out waiting for the shared build\"; exit 1; }; "
    "perl -e 'select(undef, undef, undef, 0.2)'; done; fi; fi; ";

// The end of the script for a test that only runs `build/tests`: it links the runner of the shared build.
constexpr char link_script[_] = "mkdir -p build && ln -sf \"$c/proj/build/tests\" \"$c/proj/build/tests.stack\" "
                                "\"$c\"/proj/build/libsmith_handlers.dylib* build/";

// The end of the script for a test that runs `smith test` or `smith build` in the project: it copies the whole built
// project (times kept), so `smith build` there is a no-op that writes the copy's paths and not the 14 steps of a
// build (3 s of CPU) that the runner is made of; the way tests/lsp_test.smith copies its built folders.
constexpr char copy_script[_] = "cp -Rp \"$c/proj/.\" .";

// A project whose runner is built (or taken from the one an earlier test built): `project` and `build` in one, for a
// test that only runs `build/tests`; a test that builds again, or expects a failed build, uses those two.
// Builds the runner of a project with `script` (link_script or copy_script) after the shared one.
static void build_shared(const scratch::Project *p, const char *arguments, const char *script) {
    scratch::Run run = run_text(p, own("ARGS='", arguments, "'; ", shared_script, script, " 2>&1"));
    scratch::expect_status("runner: the runner builds", 0, &run);
    scratch::release(run.out);
    scratch::release(run.err);
}

export scratch::Project built_project(const char *base, const char *files, const char *arguments) {
    scratch::Project p = project(base, files);
    build_shared(&p, arguments, link_script);
    return p;
}

// `built_project`, for a test that runs `smith test` in the project: the project is a copy of the built one, so the
// build `smith test` starts with has nothing to do.
export scratch::Project built_copy(const char *base, const char *files, const char *arguments) {
    scratch::Project p = project(base, files);
    build_shared(&p, arguments, copy_script);
    return p;
}

// More files over a project: the files of another fixture.
export void add(const scratch::Project *p, const char *files) {
    const char *from = text_in(p, "tests/build_fixtures/", files);
    scratch::copy_tree(p, from, "");
    done(p, from);
}

// A character repeated.
export const char *repeated(char letter, usize count) {
    char *text = mem::alloc_slice(char, count + 1).data;
    for (usize i = 0; i < count; i++)
        text[i] = letter;
    text[count] = '\0';
    return text;
}

// The second argument of the runner for mode 0 (workers) and mode 1 (a process per test).
export const char *flag(usize mode) {
    return mode == 0 ? "" : "--isolate";
}

// A check's name, saying the mode when it is the isolated one.
// A text of its own in the isolated mode, else the name itself.
export const char *label(const char *iso, const char *name) {
    if (iso[0] == '\0') return name;
    return own(name, " (", iso, ")");
}

// `smith build` with the output of the build's own errors, stderr after stdout.
export scratch::Run build(const scratch::Project *p, const char *arguments) {
    return run_text(p, text_in(p, "env SMITH_OUTPUT=full smith build ", arguments, " 2>&1"));
}

// `smith test` of the project, as a task.
export scratch::Run smith_test(const scratch::Project *p, const char *iso, const char *arguments) {
    return run_text(p, text_in(p, "env SMITH_OUTPUT=full smith test ", iso, " ", arguments, " 2>&1"));
}

// The runner of the project, its two streams in one.
export scratch::Run tests(const scratch::Project *p, const char *iso, const char *arguments) {
    return run_text(p, text_in(p, "build/tests ", iso, " ", arguments, " 2>&1"));
}

// The runner's output through plain_filter.
export scratch::Run plain(const scratch::Project *p, const char *iso, const char *arguments) {
    return run_text(p, text_in(p, "build/tests ", iso, " ", arguments, " 2>&1 | ", plain_filter));
}

// The runner's trace turned into the report by smith symbolize, with the timings left out; the text is the same under
// the project's lines, spaces squeezed (the columns of the call chain follow the longest path).
export const char *report(const scratch::Project *p, const char *iso, const char *arguments) {
    return captured(p,
                    text_in(p, "build/tests ", iso, " --trace ", arguments, " 2>&1 | smith symbolize 2>&1 | ",
                            plain_filter, " | sed -e '/smith_test_execute/d' -e '/smith_test_run_key/d' | tr -s ' '"));
}

// The report of a trace saved in a file of the project, in the form `report` gives.
export const char *report_of(const scratch::Project *p, const char *file) {
    return captured(p, text_in(p, "smith symbolize 2>&1 <", file, " | ", plain_filter,
                               " | sed -e '/smith_test_execute/d' -e '/smith_test_run_key/d' | tr -s ' '"));
}

// The runner's trace through smith symbolize, whole.
export const char *symbolized(const scratch::Project *p, const char *iso, const char *arguments) {
    return captured(p, text_in(p, "build/tests ", iso, " ", arguments, " --trace 2>&1 | smith symbolize 2>&1"));
}

// Whether this smith can symbolize (it can when it was built with its debugger and symbolizer).
export bool can_symbolize(const scratch::Project *p) {
    scratch::Run run = scratch::sh(p, "smith symbolize --available");
    done(p, run.out);
    done(p, run.err);
    return run.status == 0;
}

// The text with every run of spaces made one space, as `tr -s ' '` does.
export const char *squeezed(const char *text) {
    usize length = c::strlen(text);
    char *copy = mem::alloc_slice(char, length + 1).data;
    usize at = 0;
    for (usize i = 0; i < length; i++) {
        if (text[i] == ' ' && at > 0 && copy[at - 1] == ' ') continue;
        copy[at++] = text[i];
    }
    copy[at] = '\0';
    return copy;
}

// The number a text starts with (digits only), 0 when it has none.
export usize number(const char *text) {
    usize value = 0;
    for (; *text >= '0' && *text <= '9'; text++)
        value = value * 10 + (usize)(*text - '0');
    return value;
}

// The number of the line (from 1) of the `occurrence`th line (from 1) of a project's file that holds the text.
export usize line_of_nth(const scratch::Project *p, const char *file, const char *text, usize occurrence) {
    const char *whole = scratch::read(p, file);
    usize size = c::strlen(whole);
    usize wanted = c::strlen(text);
    usize line = 1;
    usize seen = 0;
    usize start = 0;
    for (usize at = 0; at <= size; at++) {
        if (whole[at] != '\n' && whole[at] != '\0') continue;
        for (usize i = start; i + wanted <= at; i++) {
            if (c::strncmp(whole + i, text, wanted) == 0) {
                seen++;
                break;
            }
        }
        if (seen == occurrence) {
            done(p, whole);
            return line;
        }
        line++;
        start = at + 1;
    }
    test::note("%s: no line %zu holds: %s", file, occurrence, text);
    done(p, whole);
    test::check(false);
    return 0;
}

export usize line_of(const scratch::Project *p, const char *file, const char *text) {
    return line_of_nth(p, file, text, 1);
}

// The report of a failed check of a test, compared as the report smith test prints it. `source` is the text of the
// failing line (found in `file`), `values` the line under it, `extra` the lines after the chain (notes and output).
export void expect_failure_block(const scratch::Project *p, const char *iso, const char *name, const char *test_name,
                                 const char *file, const char *source, const char *values, const char *extra) {
    usize line = line_of(p, file, source);
    const char *wanted = text_in(p, "FAIL ", test_name, "\n  check failed at ", file, ":", line, "\n     ", line,
                                 " |     ", source, "\n           ", values, "\n  called from\n    ", file, ":", line,
                                 " test_", test_name, "\n", extra, "\n0 passed, 1 failed");
    const char *arguments = text_in(p, "--test ", test_name);
    const char *reported = report(p, iso, arguments);
    const char *labelled = label(iso, name);
    const char *squeeze = squeezed(wanted);
    scratch::expect_text(labelled, squeeze, reported);
    if (labelled != name) scratch::release(labelled);
    scratch::release(squeeze);
    scratch::release(reported);
    scratch::release(arguments);
    scratch::release(wanted);
}

// A run of the runner holds the text.
export void expect_has(const char *iso, const char *name, const scratch::Run *run, const char *needle) {
    const char *labelled = label(iso, name);
    scratch::expect_contains(labelled, run->out, needle);
    if (labelled != name) scratch::release(labelled);
}

// A run of the runner lacks the text.
export void expect_lacks(const char *iso, const char *name, const scratch::Run *run, const char *needle) {
    const char *labelled = label(iso, name);
    scratch::expect_lacks(labelled, run->out, needle);
    if (labelled != name) scratch::release(labelled);
}

// The forks the run made: the runner's `forks: N` line of --stats.
export usize forks_of(const scratch::Run *run) {
    const char *at = c::strstr(run->out, "forks: ");
    test::check_not_equal(at, nullptr);
    usize count = 0;
    for (at += 7; *at >= '0' && *at <= '9'; at++)
        count = count * 10 + (usize)(*at - '0');
    return count;
}
