// A project's build file written in .smith (issue #43, part 3), from tests/build-smith.sh: `import std::build;`, the
// verbs on it, `smith build --dump-config`, and the build file that does what the conventions do.
// smith-covers: smith.c runtime/build_runtime.c runtime/executor*.c runtime/slots.c runtime/lang*.c runtime/verbs.c
// smith-covers: runtime/cache.c runtime/sdk_cache.c runtime/platform_*.c runtime/quiet.c runtime/base.h
// smith-covers: include/smith/ lib/std/build.smith lib/std/test.smith tests/build_fixtures/
module build_smith_test;

import std::arena;
import std::format;
import std::mem;
import std::test;
import scratch;
import <string.h>;

constexpr Usize memory_size = 1U << 25; // a test's memory: what scratch returns goes back with it

// The last line of a text: the program's output follows the build's.
static const char *last_line(const char *text) {
    Usize end = c::strlen(text);
    while (end > 0 && text[end - 1] == '\n')
        end--;
    Usize start = end;
    while (start > 0 && text[start - 1] != '\n')
        start--;
    return text + start; // expect_text ignores the newlines at its end
}

static void expect_yes(const char *name, Bool yes) {
    scratch::expect_text(name, "yes", yes ? "yes" : "no");
}

static void expect_exists(const char *name, const scratch::Project *p, const char *file, Bool exists) {
    scratch::expect_text(name, exists ? "yes" : "no", scratch::exists(p, file) ? "yes" : "no");
}

// The commands smith would run for the conventions' three profiles and the tests of the project `name`.
static const char *commands_of(const scratch::Project *p, const char *name) {
    char command[512];
    (void)format::to(command, sizeof command, "smith build -t commands build/debug/", name, " build/release/", name,
                     " build/fast/", name, " build/tests");
    return scratch::sh(p, command).out;
}

// 1. A build.smith of the high-level calls builds, runs and tests.

// Builds and runs, tests, the other profiles and proves: four tests of one project, each of which used to make a
// project of its own and spend about 2 CPU-s building the build program. The assertions are the same; smith prove is
// last, as the one that a host without a prover fails.
export void test_build_smith_a_build_smith_of_the_high_level_calls_builds_runs_tests_and_proves() {
    scratch::Project p = scratch::make("shapes", "smith_shapes");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run built = scratch::build(&p, "");
    scratch::expect_status("build.smith: builds", 0, &built);
    expect_exists("build.smith: ... the debug program is build/debug/<folder>", &p, "build/debug/shapes", true);
    expect_exists("build.smith: ... smith's conventions are not used", &p, ".smith/conventions.c", false);
    scratch::expect_contains("build.smith: the compile command of the build file is in .smith/build.info",
                             scratch::read(&p, ".smith/build.info"), "compile\tbuild.smith");
    scratch::expect_contains("build.smith: ... and in the compile commands",
                             scratch::read(&p, ".smith/compile_commands.json"), "\"file\": \"build.smith\"");
    scratch::Run second = scratch::build(&p, "");
    scratch::expect_text("build.smith: a second build has nothing to do", "smith: no work to do.", second.out);
    scratch::Run run = scratch::sh(&p, "smith run");
    scratch::expect_text("build.smith: smith run runs the program", "12", last_line(run.out));
    scratch::Run tested = scratch::sh(&p, "env SMITH_OUTPUT=full smith test");
    scratch::expect_status("build.smith: smith test passes", 0, &tested);
    scratch::expect_contains("build.smith: ... its test", format::push(tested.out, tested.err).data,
                             "1 passed, 0 failed");
    scratch::Run profiles = scratch::build(&p, "release fast");
    scratch::expect_status("build.smith: the other profiles build", 0, &profiles);
    scratch::expect_text("build.smith: ... and run", "12", scratch::capture(&p, "build/release/shapes"));
    scratch::Run proved = scratch::sh(&p, "env SMITH_OUTPUT=full smith prove");
    scratch::expect_status("build.smith: smith prove runs", 0, &proved);
    scratch::expect_contains("build.smith: ... and says there is nothing to prove", proved.out, "nothing to prove");
}

// 2. A build.smith with a low-level step beside the high-level calls, and one with only low-level calls.

export void test_build_smith_a_low_level_task_beside_the_high_level_calls() {
    scratch::Project p = scratch::make("mixed", "smith_mixed");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run greet = scratch::build(&p, "greet");
    scratch::expect_status("low-level: a task in a build.smith runs", 0, &greet);
    scratch::expect_contains("low-level: ... and prints", greet.out,
                             format::push("hello from ", scratch::capture(&p, "uname -s")).data);
    scratch::Run tested = scratch::sh(&p, "env SMITH_OUTPUT=full smith test");
    scratch::expect_status("low-level: the tests of the high-level calls still pass", 0, &tested);
}

export void test_build_smith_only_low_level_calls_build_a_program() {
    scratch::Project p = scratch::make("plain", "smith_plain");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run built = scratch::build(&p, "");
    scratch::expect_status("low-level: only low-level calls: builds", 0, &built);
    scratch::Run program = scratch::sh(&p, "build/plain");
    scratch::expect_status("low-level: ... the program is the C file's", 7, &program);
    scratch::Run commands = scratch::build(&p, "-t commands build/main.o");
    scratch::expect_contains("low-level: ... compiled with the flags it was given", commands.out, " -O1 -Wall ");
}

// 3. build.smith beside build.c is an error that names both.

export void test_build_smith_beside_a_build_c_is_an_error_that_names_both() {
    scratch::Project p = scratch::make("both", "smith_both");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run built = scratch::build(&p, "");
    scratch::expect_status("both: build.smith and build.c: status 2", 2, &built);
    scratch::expect_contains("both: ... names both", built.err, "both build.c and build.smith are here");
    scratch::Run run = scratch::sh(&p, "smith run");
    scratch::expect_status("both: smith run says the same", 2, &run);
    scratch::Run tested = scratch::sh(&p, "env SMITH_OUTPUT=full smith test");
    scratch::expect_status("both: smith test says the same", 2, &tested);
}

// 5. --dump-config of a .smith project: a build.smith that builds as the conventions do.

export void test_build_smith_dump_config_of_a_smith_project_is_a_build_smith() {
    scratch::Project p = scratch::make("dump", "smith_dump");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run dump = scratch::sh(&p, "smith build --dump-config");
    scratch::expect_status("dump: a .smith project: status 0", 0, &dump);
    scratch::expect_contains("dump: ... is a build.smith of the high-level calls", dump.out, "import std::build;");
    scratch::expect_contains("dump: ... is the module build", dump.out, "module build;");
    scratch::expect_contains("dump: ... exports the entry point", dump.out, "export void build(build::Build *b) {");
    scratch::expect_contains("dump: ... names the entry", dump.out, ".entry = \"main.smith\",");
    scratch::expect_contains("dump: ... and the program", dump.out, ".name = \"dump\",");
    scratch::expect_contains("dump: ... and the tests folder", dump.out,
                             "build::app_tests(b, &(build::AppTests){.folder = \"tests\"});");
    scratch::expect_text("dump: ... writes only the file to stdout", "", dump.err);
    expect_exists("dump: ... and nothing to the folder", &p, "build.smith", false);
}

// The dumped build.smith is the project's build file; its commands must be those of no build file.
// The commands of no build file are returned, in the test's memory as everything scratch returns.
static const char *dump_smith_project(const scratch::Project *p) {
    const char *conventional = commands_of(p, "dump");
    scratch::Run dump = scratch::sh(p, "smith build --dump-config");
    scratch::expect_status("dump: a .smith project: status 0", 0, &dump);
    scratch::write(p, "build.smith", format::push(dump.out, "\n").data);
    (void)scratch::sh(p, "rm -rf .smith build");
    return conventional;
}

// The commands, building and running and testing, and the explicit message: three tests of one project, each of which
// used to make a project of its own and spend about 2 CPU-s building the build program. The assertions are the same.
export void test_build_smith_dump_config_gives_the_commands_of_no_build_file_and_builds_runs_and_tests() {
    scratch::Project p = scratch::make("dump", "smith_dump");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *conventional = dump_smith_project(&p);
    scratch::expect_text("dump: the build.smith gives the commands of no build file", conventional,
                         commands_of(&p, "dump"));
    scratch::Run built = scratch::build(&p, "");
    if (built.status != 0) {
        test::note("stdout: %s\nstderr: %s", built.out, built.err);
    }
    scratch::expect_status("dump: ... builds", 0, &built);
    scratch::Run run = scratch::sh(&p, "smith run");
    scratch::expect_text("dump: ... runs", "12", last_line(run.out));
    scratch::Run tested = scratch::sh(&p, "env SMITH_OUTPUT=full smith test");
    scratch::expect_contains("dump: ... and tests", format::push(tested.out, tested.err).data, "1 passed, 0 failed");
    scratch::Run again = scratch::sh(&p, "smith build --dump-config");
    scratch::expect_status("dump: a project with a build.smith: status 0", 0, &again);
    scratch::expect_text("dump: ... prints nothing to stdout", "", again.out);
    scratch::expect_contains("dump: ... says the file is already explicit", again.err,
                             "build.smith is already this project's build file");
}

// 6. --dump-config of a C project: a build.c through <smith/build.h>.

export void test_build_smith_dump_config_of_a_c_project_is_a_build_c() {
    scratch::Project p = scratch::make("cdump", "smith_cdump");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run dump = scratch::sh(&p, "smith build --dump-config");
    scratch::expect_status("dump: a C project: status 0", 0, &dump);
    scratch::expect_contains("dump: ... is a build.c", dump.out, "#include <smith/build.h>");
    scratch::expect_contains("dump: ... of smith_app", dump.out, "smith_app(b, &(SmithApp){");
    scratch::expect_contains("dump: ... with the entry", dump.out, ".entry = \"main.c\",");
    scratch::expect_contains("dump: ... and the tests", dump.out,
                             "smith_app_tests(b, &(SmithAppTests){.folder = \"tests\"});");
}

// The commands of no build file are returned, in the test's memory as everything scratch returns.
static const char *dump_c_project(const scratch::Project *p) {
    const char *conventional = commands_of(p, "cdump");
    scratch::Run dump = scratch::sh(p, "smith build --dump-config");
    scratch::expect_status("dump: a C project: status 0", 0, &dump);
    scratch::write(p, "build.c", format::push(dump.out, "\n").data);
    (void)scratch::sh(p, "rm -rf .smith build");
    return conventional;
}

// The commands and the tests, and the explicit message: two tests of one project, each of which used to make a project
// of its own and spend about 2 CPU-s building the build program. The assertions are the same.
export void test_build_smith_dump_config_of_a_c_project_gives_the_commands_tests_and_says_it_is_explicit() {
    scratch::Project p = scratch::make("cdump", "smith_cdump");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *conventional = dump_c_project(&p);
    scratch::expect_text("dump: the build.c gives the commands of no build file", conventional,
                         commands_of(&p, "cdump"));
    scratch::Run tested = scratch::sh(&p, "env SMITH_OUTPUT=full smith test");
    scratch::expect_contains("dump: ... and tests", format::push(tested.out, tested.err).data, "1 passed, 0 failed");
    scratch::Run again = scratch::sh(&p, "smith build --dump-config");
    scratch::expect_status("dump: a project with a build.c: status 0", 0, &again);
    scratch::expect_text("dump: ... prints nothing to stdout", "", again.out);
    scratch::expect_contains("dump: ... says the file is already explicit", again.err,
                             "build.c is already this project's build file");
}

// 7. --dump-config of a folder that follows no convention is the guidance error, and of both entry points is an error.

export void test_build_smith_dump_config_of_a_folder_with_nothing_to_build_is_the_guidance_error() {
    scratch::Project p = scratch::make("nothing", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run dump = scratch::sh(&p, "smith build --dump-config");
    scratch::expect_status("dump: nothing to build: status 2", 2, &dump);
    scratch::expect_text("dump: ... prints nothing to stdout", "", dump.out);
    scratch::expect_contains("dump: ... says what smith looked for", dump.err,
                             "no main.smith or main.c to build by convention");
}

export void test_build_smith_dump_config_of_main_smith_and_main_c_is_an_error() {
    scratch::Project p = scratch::make("twice", "smith_twice");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run dump = scratch::sh(&p, "smith build --dump-config");
    scratch::expect_status("dump: main.smith and main.c: status 2", 2, &dump);
    scratch::expect_contains("dump: ... names both", dump.err, "both main.smith and main.c are here");
}

// 8. smith lint lints a build.smith as written, as it lints a build.c.

export void test_build_smith_lint_reads_a_build_smith_as_written() {
    scratch::Project p = scratch::make("shapes", "smith_shapes");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, ".clang-format", ".clang-format");
    scratch::copy_tree(&p, ".clang-tidy", ".clang-tidy");
    scratch::Run clean = scratch::sh(&p, "env SMITH_OUTPUT=full smith lint");
    if (clean.status != 0) {
        test::note("lint said: %s%s", clean.out, clean.err);
    }
    scratch::expect_status("lint: a clean build.smith passes", 0, &clean);
    (void)scratch::sh(&p, "printf '\\nstatic int BadName(int x) {\\n    return x;\\n}\\n' >>build.smith");
    scratch::Run bad = scratch::sh(&p, "env SMITH_OUTPUT=full smith lint");
    scratch::expect_status("lint: a finding in build.smith fails", 1, &bad);
    scratch::expect_contains("lint: ... at its line, in the name as written", format::push(bad.out, bad.err).data,
                             "build.smith:10:12");
}

// smith check reads a build.smith too: with no build.c and no main, it still lints and tests.
export void test_build_smith_check_reads_a_build_smith_with_no_main() {
    scratch::Project p = scratch::make("checked", "smith_checked");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run checked = scratch::sh(&p, "env SMITH_OUTPUT=full smith check");
    const char *err = checked.err;
    const char *lint = c::strstr(err, "smith check: lint ");
    Bool ok =
        c::strstr(err, "are skipped") == nullptr && lint != nullptr && c::strstr(lint, "smith check: test ") != nullptr;
    expect_yes("check: a build.smith with no main is linted and tested", ok);
}

// 10. A mistake in a build.smith names build.smith, not build.c, and every name collision is reported in one run (#47).

export void test_build_smith_a_mistake_in_a_build_smith_names_build_smith_and_every_collision() {
    scratch::Project p = scratch::make("errors", "smith_errors");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run built = scratch::build(&p, "");
    scratch::expect_status("errors: a build.smith with mistakes fails", 2, &built);
    scratch::expect_contains("errors: the message names build.smith", built.err,
                             "smith: build.smith: task 'lint' is named after a verb");
    scratch::expect_contains("errors: the second collision is reported in the same run", built.err,
                             "smith: build.smith: alias 'fmt' is named after a verb");
    scratch::expect_contains("errors: the third, an alias the app makes against a task", built.err,
                             "smith_app: the alias release that every program adds to is the name of a task; name the "
                             "task another way");
    scratch::expect_text("errors: and never says build.c", "none",
                         scratch::contains(built.err, "build.c") ? "build.c" : "none");
}

export void test_build_smith_an_unknown_option_names_build_smith() {
    scratch::Project p = scratch::make("errors", "smith_errors");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    (void)scratch::sh(&p, "cp build.smith.fixed build.smith");
    scratch::Run built = scratch::build(&p, "-Dnope");
    scratch::expect_contains("errors: an unknown option names build.smith", built.err,
                             "smith: build.smith: unknown option -Dnope");
    scratch::expect_contains("errors: and says it declares none", built.err, "build.smith declares no options");
}

// 11. Relaxing a convention's warning (smith-build-levels): the example there builds, and without the flags it fails.

export void test_build_smith_relaxing_a_warning_in_flags_and_a_folders_list_builds() {
    scratch::Project p = scratch::make("relax", "smith_relax");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run strict = scratch::build(&p, "");
    scratch::expect_status("relax: without the flags the conventions' warnings fail the build", 1, &strict);
    scratch::expect_contains("relax: the diagnostic names the flag to turn off",
                             format::push(strict.out, strict.err).data, "[-Werror,-Wgnu-folding-constant]");
    (void)scratch::sh(&p, "cp build.smith.relaxed build.smith");
    scratch::Run relaxed = scratch::build(&p, "");
    scratch::expect_status("relax: with -Wno-... in .flags and a folder's list it builds", 0, &relaxed);
}
