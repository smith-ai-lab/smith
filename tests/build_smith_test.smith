// 8. smith lint lints a build.smith as written, as it lints a build.c.

export void test_build_smith_lint_reads_a_build_smith_as_written() {
    scratch::Project p = scratch::make("shapes", "smith_shapes");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, ".clang-format", ".clang-format");
    scratch::copy_tree(&p, ".clang-tidy", ".clang-tidy");
    scratch::Run clean = scratch::sh(&p, "env SMITH_OUTPUT=full smith lint");
    if (clean.status != 0) {
        test::note("lint said: %s%s", clean.out, clean.err);
    }
    scratch::expect_status("lint: a clean build.smith passes", 0, &clean);
    (void)scratch::sh(&p, "printf '\\nstatic int BadName(int x) {\\n    return x;\\n}\\n' >>build.smith");
    scratch::Run bad = scratch::sh(&p, "env SMITH_OUTPUT=full smith lint");
    scratch::expect_status("lint: a finding in build.smith fails", 1, &bad);
    scratch::expect_contains("lint: ... at its line, in the name as written", format::push(bad.out, bad.err).data,
                             "build.smith:12:12");
}

// smith check reads a build.smith too: with no build.c and no main, it still lints and tests.
export void test_build_smith_check_reads_a_build_smith_with_no_main() {
    scratch::Project p = scratch::make("checked", "smith_checked");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run checked = scratch::sh(&p, "env SMITH_OUTPUT=full smith check");
    const char *err = checked.err;
    const char *lint = c::strstr(err, "smith check: lint ");
    Bool ok =
        c::strstr(err, "are skipped") == nullptr && lint != nullptr && c::strstr(lint, "smith check: test ") != nullptr;
    expect_yes("check: a build.smith with no main is linted and tested", ok);
}

// smith check never passes a part silently (#3163): a part the host cannot run is named in its last lines, `--require`
// makes it a failure, and a wrong option is a usage error.
export void test_build_smith_check_names_the_parts_that_did_not_run_and_require_fails_them() {
    scratch::Project p = scratch::make("checked", "smith_checked");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run bad_part = scratch::sh(&p, "env SMITH_OUTPUT=full smith check --require nonsense");
    scratch::expect_status("check: --require names a part that exists", 2, &bad_part);
    scratch::expect_contains("check: ... and the message lists them", bad_part.err, "'nonsense' is no part");
    scratch::Run lonely = scratch::sh(&p, "env SMITH_OUTPUT=full smith check --base main");
    scratch::expect_status("check: --base alone is a usage error", 2, &lonely);
    scratch::expect_contains("check: ... that says what it needs", lonely.err, "--base needs --changed");
    // On Linux the macOS parts cannot run: they are named, and `--require all` fails the check for them.
    scratch::Run part_bad = scratch::sh(&p, "env SMITH_OUTPUT=full smith check --part nonsense");
    scratch::expect_status("check: --part names a part that exists", 2, &part_bad);
    scratch::expect_contains("check: ... and the message says which option", part_bad.err,
                             "--part: 'nonsense' is no part");
    // --part runs only the parts it names: the others are left out, and a macOS part it names is reported as not run
    scratch::Run part =
        scratch::sh(&p, "[ \"$(uname -s)\" = Linux ] || { echo 'smith check: not run here: macos-tests' >&2; "
                        "echo 'smith check: 0 ok, 0 failed, 1 not run here' >&2; exit 0; }; "
                        "env SMITH_OUTPUT=full smith check --part macos-tests");
    scratch::expect_status("check: a --part run of a part this host cannot run passes", 0, &part);
    scratch::expect_contains("check: ... it names it", part.err, "smith check: not run here: macos-tests");
    scratch::expect_contains("check: ... runs nothing else", part.err, "smith check: 0 ok, 0 failed, 1 not run here");
    scratch::Run linux = scratch::sh(
        &p,
        "[ \"$(uname -s)\" = Linux ] || { echo 'smith check: not run here: macos-lint, macos-tests' >&2; exit 1; }; "
        "env SMITH_OUTPUT=full smith check --require macos-tests");
    scratch::expect_status("check: a required part that did not run fails the check", 1, &linux);
    scratch::expect_contains("check: ... and the last lines name it", linux.err,
                             "smith check: not run here: macos-lint, macos-tests");
    scratch::expect_contains("check: ... with a count", linux.err, "not run here\n");
}

// smith check --plan reads the scope of a change from git (#3163): the one rule CI's `changes` job and the hook share.
export void test_build_smith_check_plan_prints_the_scope_of_the_change() {
    scratch::Project p = scratch::make("planned", "smith_checked");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run made = scratch::sh(
        &p,
        "git init -q . && git config user.email t@t && git config user.name t && mkdir -p knowledge .github/workflows "
        "&& "
        "echo a >README.md && git add -A && git commit -qm base && git tag base && "
        "echo b >>README.md && echo b >knowledge/a.md && git add -A && git commit -qm docs && git tag docs && "
        "echo c >LICENSE && echo d >.github/workflows/queue-heal.yml && git add -A && git commit -qm none && git tag "
        "none && "
        "echo e >x.c && git add -A && git commit -qm code && git tag code && "
        "git checkout -q none && echo y >.github/workflows/ci.yml && git add -A && git commit -qm own && git tag own "
        "&& "
        "git checkout -q -b notes && echo n >knowledge/b.md && git add -A && git commit -qm notes && git tag notes");
    scratch::expect_status("plan: the scratch repository is made", 0, &made);
    scratch::Run docs = scratch::sh(&p, "git checkout -q docs && smith check --plan --base base");
    scratch::expect_contains("plan: documentation only is scope docs", docs.out,
                             "scope=docs\ndocs_tests=true\ndocs_push=false\nmac_run=false\nchanged=2\n");
    scratch::Run quiet = scratch::sh(&p, "git checkout -q none && smith check --plan --base docs");
    scratch::expect_contains("plan: a license and another workflow run nothing", quiet.out,
                             "scope=none\ndocs_tests=false\ndocs_push=false\nmac_run=false\nchanged=2\n");
    scratch::Run code = scratch::sh(&p, "git checkout -q code && smith check --plan --base none");
    scratch::expect_contains("plan: a source file makes it full", code.out, "scope=full\n");
    scratch::Run own = scratch::sh(&p, "git checkout -q own && smith check --plan --base none");
    scratch::expect_contains("plan: ci.yml itself is code", own.out, "scope=full\n");
    scratch::Run unreadable = scratch::sh(&p, "smith check --plan --base nonsense");
    scratch::expect_contains("plan: a diff that cannot be read is full", unreadable.out, "scope=full\n");
    // the rules of the events: a push of only documents is none, a push of code is a release with the macOS jobs, the
    // nightly run of the whole check runs them too, and a queue entry or a pull request never does
    scratch::Run push_docs = scratch::sh(&p, "true; "
                                             "git checkout -q docs && smith check --plan --base base --event push");
    scratch::expect_contains("plan: a push of only documents is none", push_docs.out,
                             "scope=none\ndocs_tests=false\ndocs_push=true\nmac_run=false\n");
    scratch::Run push_code = scratch::sh(&p, "git checkout -q code && smith check --plan --base none --event push");
    scratch::expect_contains("plan: a push of code is a release with the macOS jobs", push_code.out,
                             "scope=release\ndocs_tests=false\ndocs_push=false\nmac_run=true\n");
    scratch::Run nightly = scratch::sh(&p, "smith check --plan --base none --event schedule");
    scratch::expect_contains("plan: the nightly run of code runs the macOS jobs", nightly.out,
                             "scope=full\ndocs_tests=false\ndocs_push=false\nmac_run=true\n");
    scratch::Run queued = scratch::sh(&p, "smith check --plan --base none --event merge_group");
    scratch::expect_contains("plan: a queue run has no macOS job", queued.out,
                             "scope=full\ndocs_tests=false\ndocs_push=false\nmac_run=false\n");
    scratch::expect_contains("plan: ... and the shape of the tests", queued.out,
                             "test_parts=8\nlinux_flags=--skip-macos\nmac_flags=--macos-only --shard 1/1\n");
    scratch::Run unread_push = scratch::sh(&p, "smith check --plan --base nonsense --event push");
    scratch::expect_contains("plan: a push whose range cannot be read stays a release", unread_push.out,
                             "scope=release\n");
    // smith check --changed leaves out the stages the plan does (#3163), and says so
    scratch::Run only_docs =
        scratch::sh(&p, "git checkout -q docs && env SMITH_OUTPUT=full smith check --changed --base base");
    scratch::expect_contains("plan: ... runs the docs check, and only it", only_docs.err, "smith check: docs ");
    scratch::expect_contains("plan: ... and, for README.md, the tests of README.md and the skills (#3160)",
                             only_docs.err, "smith check: test ");
    scratch::expect_contains(
        "plan: ... and names what the plan left out", only_docs.err,
        "smith check: skipped by the plan (scope docs, documentation only): fmt, lint, prove, macos-lint, macos-tests, "
        "and the other tests");
    scratch::Run notes =
        scratch::sh(&p, "git checkout -q notes && env SMITH_OUTPUT=full smith check --changed --base own");
    scratch::expect_contains(
        "plan: a change of knowledge/ alone runs no test", notes.err,
        "smith check: skipped by the plan (scope docs, documentation only): fmt, lint, test, prove");
    scratch::Run no_docs =
        scratch::sh(&p, "git checkout -q none && env SMITH_OUTPUT=full smith check --changed --base docs");
    scratch::expect_contains(
        "plan: a change of only non-built documents runs nothing", no_docs.err,
        "smith check: nothing to run: the change touches only documents no build reads (scope none)");
}

// 10. A mistake in a build.smith names build.smith, not build.c, and every name collision is reported in one run (#47).

export void test_build_smith_a_mistake_in_a_build_smith_names_build_smith_and_every_collision() {
    scratch::Project p = scratch::make("errors", "smith_errors");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run built = scratch::build(&p, "");
    scratch::expect_status("errors: a build.smith with mistakes fails", 2, &built);
    scratch::expect_contains("errors: the message names build.smith", built.err,
                             "smith: build.smith: task 'lint' is named after a verb");
    scratch::expect_contains("errors: the second collision is reported in the same run", built.err,
                             "smith: build.smith: alias 'fmt' is named after a verb");
    scratch::expect_contains("errors: the third, an alias the app makes against a task", built.err,
                             "smith_app: the alias release that every program adds to is the name of a task; name the "
                             "task another way");
    scratch::expect_text("errors: and never says build.c", "none",
                         scratch::contains(built.err, "build.c") ? "build.c" : "none");
}

export void test_build_smith_an_unknown_option_names_build_smith() {
    scratch::Project p = scratch::make("errors", "smith_errors");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    (void)scratch::sh(&p, "cp build.smith.fixed build.smith");
    scratch::Run built = scratch::build(&p, "-Dnope");
    scratch::expect_contains("errors: an unknown option names build.smith", built.err,
                             "smith: build.smith: unknown option -Dnope");
    scratch::expect_contains("errors: and says it declares none", built.err, "build.smith declares no options");
}

// 11. Relaxing a convention's warning (smith-build-levels): the example there builds, and without the flags it fails.

export void test_build_smith_relaxing_a_warning_in_flags_and_a_folders_list_builds() {
    scratch::Project p = scratch::make("relax", "smith_relax");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run strict = scratch::build(&p, "");
    scratch::expect_status("relax: without the flags the conventions' warnings fail the build", 1, &strict);
    scratch::expect_contains("relax: the diagnostic names the flag to turn off",
                             format::push(strict.out, strict.err).data, "[-Werror,-Wgnu-folding-constant]");
    (void)scratch::sh(&p, "cp build.smith.relaxed build.smith");
    scratch::Run relaxed = scratch::build(&p, "");
    scratch::expect_status("relax: with -Wno-... in .flags and a folder's list it builds", 0, &relaxed);
}
