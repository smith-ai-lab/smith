// front::cimport (#1114, #1112 track C): a C header's functions and structs, read through clang's C++ libraries
// (shim/cimport.cpp). The test runs in track B's front-end runner, which links clang. The headers are the fixture
// tests/front/cimport/fixture.h and the system's <string.h> and <stdio.h>; the fixture's full list is the golden file
// tests/front/cimport/fixture.golden (the system headers differ by platform, so they get checks, not goldens). `smith
// test --update` writes them.
module front_cimport_test;

import front::ast;
import front::cimport;
import std::arena;
import <stdlib.h>;
import <string.h>;
import std::format;
import std::mem;
import std::process;
import std::slice;
import std::test;

typedef cimport::Header Header;

static Str str_of(format::Chars text) {
    return format::bytes(text.data, countof(text));
}

// The spelling of a type along its one chain, in smith's terms: `*` for a pointer, `const` first, `Fn of` for a
// function pointer, a named type as its name (a typedef or a struct stays a name: the alias is its own declaration).
static Str type_text(const ast::TypeExpr *type) {
    Str out = "";
    const ast::TypeExpr *at = type;
    for (Usize guard = 0; guard < 16; guard++) {
        Str constant = at->qualifiers.is_const ? "const " : "";
        if (at->kind == .pointer) {
            out = str_of(format::push(out, constant, "*"));
            at = at->kind.pointer.pointee;
        } else if (at->kind == .array) {
            out = str_of(format::push(out, constant, "[]"));
            at = at->kind.array.element;
        } else if (at->kind == .applied) {
            ast::TypeArg arg = at->kind.applied.args[0];
            out = str_of(format::push(out, "Fn of "));
            if (arg != .type) return "other";
            at = arg.type.type;
        } else if (at->kind == .named) {
            return str_of(format::push(out, constant, at->kind.named.path.segments[0].text));
        } else if (at->kind == .function) {
            return str_of(format::push(out, "function"));
        } else {
            return str_of(format::push(out, "other"));
        }
    }
    return "cycle";
}

// The header's declarations as a module's dump, then what was not imported.
static Str dump(const Header *h) {
    if (countof(h->error) != 0) return str_of(format::push("error: ", h->error, "\n"));
    ast::Module m = ast::new_module("fixture", h->decls);
    Str out = ast::dump(&m);
    for (Usize i = 0; i < countof(h->not_imported); i++) {
        cimport::NotImported n = h->not_imported[i];
        out = str_of(format::push(out, "not imported ", n.kind == cimport::not_imported_attribute ? "attribute " : "",
                                  n.name, ": ", n.reason, "\n"));
    }
    return out;
}

static Str run_line(const char *const argv[:]) {
    process::OutputResult done = process::run(argv);
    switch (done) {
    case .ok: {
        Usize n = countof(done.ok.output);
        while (n > 0 && done.ok.output[n - 1] == '\n')
            n -= 1;
        return format::bytes((const char *)done.ok.output.data, n);
    }
    case .error:
        return "";
    }
}

// The flags a driver would give: smith's own clang resource folder (builtin headers such as <stddef.h>), and the SDK
// on macOS. The system's other include folders are clang's own defaults.
static Str driver_flags() {
    const char *self = c::getenv("SMITH_SELF");
    const char *smith = self != nullptr ? self : "smith";
    const char *const resource_argv[3] = {smith, "cc", "-print-resource-dir"};
    Str resource = run_line(resource_argv[0:3]);
    const char *const sdk_argv[2] = {"xcrun", "--show-sdk-path"};
    Str sdk = run_line(sdk_argv[0:2]);
    Str flags = str_of(format::push("-resource-dir\n", resource, "\n"));
    if (countof(sdk) == 0) {
        return flags;
    }
    return str_of(format::push(flags, "-isysroot\n", sdk, "\n"));
}

static Header read(arena::Arena *memory, const char *name, Bool quoted) {
    Str flags = driver_flags();
    return cimport::read(memory, name, quoted, "tests/front/cimport", flags.data);
}

static const ast::Decl *find(const Header *h, Str name) {
    for (Usize i = 0; i < countof(h->decls); i++) {
        const ast::Decl *d = h->decls[i];
        if (d->kind == .function && slice::equal(d->kind.function.name, name)) return d;
    }
    return nullptr;
}

export void test_cimport_the_fixture_header_is_read_exactly() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Header h = read(&memory, "fixture.h", true);
    test::golden("tests/front/cimport/fixture.golden", dump(&h));
}

export void test_cimport_string_h_has_strlen_returning_usize_of_a_const_char_pointer() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Header h = read(&memory, "string.h", false);
    test::check_equal(countof(h.error), 0);
    const ast::Decl *length_fn = find(&h, "strlen");
    if (length_fn == nullptr || length_fn->kind != .function) {
        test::check_condition(false);
        return;
    }
    test::check_condition(length_fn->from_c);
    // A system header's spelling differs by platform, so the checks are on what holds everywhere: the result is the
    // typedef's name, and the parameter a pointer to a const char.
    Str want_result = "size_t";
    Str result = type_text(length_fn->kind.function.result);
    test::check_condition(slice::equal(result, want_result));
    Str want_param = "*const I8";
    Str param = type_text(length_fn->kind.function.params[0].type);
    test::check_condition(slice::equal(param, want_param));
}

export void test_cimport_stdio_h_printf_is_variadic_and_fopen_returns_a_pointer_to_file() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Header h = read(&memory, "stdio.h", false);
    test::check_equal(countof(h.error), 0);
    const ast::Decl *printf_fn = find(&h, "printf");
    if (printf_fn == nullptr || printf_fn->kind != .function) {
        test::check_condition(false);
        return;
    }
    test::check_condition(printf_fn->kind.function.variadic);
    const ast::Decl *open_fn = find(&h, "fopen");
    if (open_fn == nullptr || open_fn->kind != .function) {
        test::check_condition(false);
        return;
    }
    Str want_file = "*FILE";
    Str file = type_text(open_fn->kind.function.result);
    test::check_condition(slice::equal(file, want_file));
}

// The constant `name` (a constexpr variable) of the header, or null.
static const ast::Decl *find_constant(const Header *h, Str name) {
    for (Usize i = 0; i < countof(h->decls); i++) {
        const ast::Decl *d = h->decls[i];
        if (d->kind == .variable && slice::equal(d->kind.variable.name, name)) return d;
    }
    return nullptr;
}

// Whether the constant is a constexpr of the named type whose value is the integer `magnitude`, negated or not.
static Bool is_integer_constant(const Header *h, Str name, Str type, U64 magnitude, Bool negative) {
    const ast::Decl *d = find_constant(h, name);
    if (d == nullptr || d->kind != .variable || !d->from_c || !d->kind.variable.is_constexpr) return false;
    Str spelled = type_text(d->kind.variable.type);
    if (!slice::equal(spelled, type)) return false;
    const ast::Expr *value = d->kind.variable.init;
    if (negative) {
        if (value->kind != .unary) return false;
        value = value->kind.unary.operand;
    }
    return value->kind == .integer && value->kind.integer.value == magnitude;
}

export void test_cimport_stdio_h_has_eof_seek_set_and_bufsiz_as_constants() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Header h = read(&memory, "stdio.h", false);
    test::check_equal(countof(h.error), 0);
    test::check_condition(is_integer_constant(&h, "EOF", "I32", 1, true));
    test::check_condition(is_integer_constant(&h, "SEEK_SET", "I32", 0, false));
    const ast::Decl *size = find_constant(&h, "BUFSIZ");
    test::check_condition(size != nullptr && size->kind == .variable);
    if (size == nullptr || size->kind != .variable) return;
    Str want_size = "I32";
    Str size_type = type_text(size->kind.variable.type);
    test::check_condition(slice::equal(size_type, want_size));
    test::check_condition(size->kind.variable.init->kind == .integer &&
                          size->kind.variable.init->kind.integer.value > 0);
}

export void test_cimport_limits_h_has_int_max_and_char_bit() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Header h = read(&memory, "limits.h", false);
    test::check_equal(countof(h.error), 0);
    test::check_condition(is_integer_constant(&h, "INT_MAX", "I32", 2147483647, false));
    test::check_condition(is_integer_constant(&h, "CHAR_BIT", "I32", 8, false));
}

export void test_cimport_math_h_has_pi_as_a_float() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Header h = read(&memory, "math.h", false);
    test::check_equal(countof(h.error), 0);
    const ast::Decl *pi = find_constant(&h, "M_PI");
    test::check_condition(pi != nullptr && pi->kind == .variable);
    if (pi == nullptr || pi->kind != .variable) return;
    Str want_pi = "F64";
    Str pi_type = type_text(pi->kind.variable.type);
    test::check_condition(slice::equal(pi_type, want_pi));
    test::check_condition(pi->kind.variable.init->kind == .floating);
}

export void test_cimport_a_missing_header_is_an_error_naming_the_header_and_the_folders() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Header h = read(&memory, "no_such_header_anywhere.h", false);
    test::check_condition(countof(h.error) != 0);
    test::check_equal(countof(h.decls), 0);
    test::check_condition(c::strstr(h.error.data, "no_such_header_anywhere.h") != nullptr);
    test::check_condition(c::strstr(h.error.data, "folders searched") != nullptr);
    test::check_condition(c::strstr(h.error.data, "/include") != nullptr);
}
