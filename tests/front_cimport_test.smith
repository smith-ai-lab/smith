// front::cimport (#1114, #1112 track C): a C header's functions and structs, read through clang's C++ libraries
// (shim/cimport.cpp). The test runs in track B's front-end runner, which links clang. The headers are the fixture
// tests/front/cimport/fixture.h and the system's <string.h> and <stdio.h>; the fixture's full list is the golden file
// tests/front/cimport/fixture.golden (the system headers differ by platform, so they get checks, not goldens). `smith
// test --update` writes them.
module front_cimport_test;

import front::cimport;
import std::arena;
import <stdlib.h>;
import <string.h>;
import std::format;
import std::mem;
import std::process;
import std::slice;
import std::test;

typedef cimport::Header Header;

static Str str_of(format::Chars text) {
    return format::bytes(text.data, countof(text));
}

// The spelling of a type, in smith's terms: sized types, `*` for a pointer, `const` first, `[n]` for an array, a
// typedef as `name = underlying`. A function type is `Fn#n`; its own line, in `dump`, says what it is (no recursion
// in a module, so a type is spelled along its one chain).
static Str type_text(const Header *h, U32 index) {
    Str out = "";
    U32 at = index;
    for (Usize guard = 0; guard <= countof(h->types); guard++) {
        cimport::CType t = h->types[at];
        Str constant = (t.flags & cimport::flag_const) != 0 ? "const " : "";
        if (t.kind == cimport::kind_pointer) {
            out = str_of(format::push(out, constant, "*"));
            at = t.a;
        } else if (t.kind == cimport::kind_fn_pointer) {
            out = str_of(format::push(out, constant, "Fn of "));
            at = t.a;
        } else if (t.kind == cimport::kind_array) {
            out = str_of(format::push(out, constant, "[", t.b, "]"));
            at = t.a;
        } else if (t.kind == cimport::kind_typedef) {
            out = str_of(format::push(out, constant, t.name, " = "));
            at = t.a;
        } else if (t.kind == cimport::kind_void) {
            return str_of(format::push(out, constant, "Void"));
        } else if (t.kind == cimport::kind_bool) {
            return str_of(format::push(out, constant, "Bool"));
        } else if (t.kind == cimport::kind_integer) {
            return str_of(format::push(out, constant, t.b == 1 ? "I" : "U", t.a));
        } else if (t.kind == cimport::kind_floating) {
            return str_of(format::push(out, constant, "F", t.a));
        } else if (t.kind == cimport::kind_struct) {
            return str_of(format::push(out, constant, "struct ", h->structs[t.a].name));
        } else if (t.kind == cimport::kind_function) {
            return str_of(format::push(out, "Fn#", at));
        } else {
            return str_of(format::push(out, constant, "unsupported(", t.name, ")"));
        }
    }
    return "cycle";
}

static Str parameters_text(const Header *h, const cimport::Parameter params[:], Bool variadic) {
    Str out = "";
    for (Usize i = 0; i < countof(params); i++) {
        out = str_of(format::push(out, i == 0 ? "" : ", ", type_text(h, params[i].type)));
    }
    return variadic ? str_of(format::push(out, ", ...")) : out;
}

static Str function_text(const Header *h, const cimport::Function *f) {
    Str params = "";
    for (Usize i = 0; i < countof(f->parameters); i++) {
        Str given = f->parameters[i].name;
        Str name = given;
        if (countof(given) == 0) {
            name = "_";
        }
        params = str_of(format::push(params, i == 0 ? "" : ", ", name, ": ", type_text(h, f->parameters[i].type)));
    }
    return str_of(
        format::push("fn ", f->name, "(", params, f->variadic ? ", ..." : "", ") -> ", type_text(h, f->result), "\n"));
}

static Str struct_text(const Header *h, const cimport::Record *s) {
    if (s->opaque) return str_of(format::push("struct ", s->name, " (opaque)\n"));
    Str out = str_of(format::push("struct ", s->name, " {\n"));
    for (Usize i = 0; i < countof(s->fields); i++)
        out = str_of(format::push(out, "    ", s->fields[i].name, ": ", type_text(h, s->fields[i].type), "\n"));
    return str_of(format::push(out, "}\n"));
}

// Everything the header declares, in order, then what was not imported.
static Str dump(const Header *h) {
    Str out = "";
    if (countof(h->error) != 0) return str_of(format::push("error: ", h->error, "\n"));
    for (Usize i = 0; i < countof(h->structs); i++) {
        out = str_of(format::push(out, struct_text(h, &h->structs[i])));
    }
    for (Usize i = 0; i < countof(h->functions); i++) {
        out = str_of(format::push(out, function_text(h, &h->functions[i])));
    }
    for (Usize i = 0; i < countof(h->types); i++) {
        cimport::CType t = h->types[i];
        if (t.kind == cimport::kind_function) {
            out = str_of(format::push(out, "Fn#", i, " = Fn(", parameters_text(h, t.parameters, t.variadic), ") -> ",
                                      type_text(h, t.a), "\n"));
        }
    }
    for (Usize i = 0; i < countof(h->not_imported); i++) {
        cimport::NotImported n = h->not_imported[i];
        out = str_of(format::push(out, "not imported ", n.kind == cimport::not_imported_attribute ? "attribute " : "",
                                  n.name, ": ", n.reason, "\n"));
    }
    return out;
}

static Str run_line(const char *const argv[:]) {
    process::OutputResult done = process::run(argv);
    switch (done) {
    case .ok: {
        Usize n = countof(done.ok.output);
        while (n > 0 && done.ok.output[n - 1] == '\n')
            n -= 1;
        return format::bytes((const char *)done.ok.output.data, n);
    }
    case .error:
        return "";
    }
}

// The flags a driver would give: smith's own clang resource folder (builtin headers such as <stddef.h>), and the SDK
// on macOS. The system's other include folders are clang's own defaults.
static Str driver_flags() {
    const char *self = c::getenv("SMITH_SELF");
    const char *smith = self != nullptr ? self : "smith";
    const char *const resource_argv[3] = {smith, "cc", "-print-resource-dir"};
    Str resource = run_line(resource_argv[0:3]);
    const char *const sdk_argv[2] = {"xcrun", "--show-sdk-path"};
    Str sdk = run_line(sdk_argv[0:2]);
    Str flags = str_of(format::push("-resource-dir\n", resource, "\n"));
    if (countof(sdk) == 0) {
        return flags;
    }
    return str_of(format::push(flags, "-isysroot\n", sdk, "\n"));
}

static Header read(arena::Arena *memory, const char *name, Bool quoted) {
    Str flags = driver_flags();
    return cimport::read(memory, name, quoted, "tests/front/cimport", flags.data);
}

static const cimport::Function *find(const Header *h, Str name) {
    for (Usize i = 0; i < countof(h->functions); i++)
        if (slice::equal(h->functions[i].name, name)) return &h->functions[i];
    return nullptr;
}

export void test_cimport_the_fixture_header_is_read_exactly() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Header h = read(&memory, "fixture.h", true);
    test::golden("tests/front/cimport/fixture.golden", dump(&h));
}

export void test_cimport_string_h_has_strlen_returning_usize_of_a_const_char_pointer() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Header h = read(&memory, "string.h", false);
    test::check_equal(countof(h.error), 0);
    const cimport::Function *length_fn = find(&h, "strlen");
    test::check_condition(length_fn != nullptr);
    // A system header's spelling differs by platform (macOS: size_t = __darwin_size_t = U64), so the checks are on
    // what holds everywhere: the typedef name first, the sized type last, and a pointer to a const char.
    Str result = type_text(&h, length_fn->result);
    test::check_condition(c::strncmp(result.data, "size_t = ", 9) == 0);
    test::check_condition(result[countof(result) - 3] == 'U' && result[countof(result) - 2] == '6');
    Str param = type_text(&h, length_fn->parameters[0].type);
    Str want_param = "*const I8";
    test::check_condition(slice::equal(param, want_param));
}

export void test_cimport_stdio_h_printf_is_variadic_and_file_is_a_typedef_of_a_struct() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Header h = read(&memory, "stdio.h", false);
    test::check_equal(countof(h.error), 0);
    const cimport::Function *printf_fn = find(&h, "printf");
    test::check_condition(printf_fn != nullptr && printf_fn->variadic);
    const cimport::Function *open_fn = find(&h, "fopen");
    test::check_condition(open_fn != nullptr);
    Str file = type_text(&h, open_fn->result);
    test::check_condition(c::strncmp(file.data, "*FILE = struct ", 15) == 0);
}

export void test_cimport_a_missing_header_is_an_error_naming_the_header_and_the_folders() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Header h = read(&memory, "no_such_header_anywhere.h", false);
    test::check_condition(countof(h.error) != 0);
    test::check_equal(countof(h.functions), 0);
    test::check_condition(c::strstr(h.error.data, "no_such_header_anywhere.h") != nullptr);
    test::check_condition(c::strstr(h.error.data, "folders searched") != nullptr);
    test::check_condition(c::strstr(h.error.data, "/include") != nullptr);
}
