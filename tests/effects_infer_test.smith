// A C file with the libc headers, compiled in the plugin's idiom mode (`SMITH_EFFECTS_IDIOMS=missing|list`).
static scratch::Run idiom_report(io::Io *io, const char *mode) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::write(&p, "headers.c",
                   "#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <strings.h>\n"
                   "#include <time.h>\n#include <locale.h>\n#include <pwd.h>\n#include <dlfcn.h>\n"
                   "#include <dirent.h>\n#include <netdb.h>\n#include <sys/mman.h>\n#include <unistd.h>\n"
                   "#include <libgen.h>\n#include <signal.h>\n#include <errno.h>\n#include <sys/socket.h>\n");
    return scratch::sh(&p, format::push(&io->arena, "SMITH_EFFECTS_IDIOMS=", mode,
                                        " smith cc -D_GNU_SOURCE -c headers.c -o /dev/null 2>&1 | grep smith-ownership")
                               .data);
}

// Every function of the table that a system header declares and that returns a pointer has an idiom; a name the
// platform does not declare (`__error`, `__errno_location`) is not looked for.
export void test_every_pointer_returning_function_of_the_table_has_an_idiom(io::Io *io) {
    scratch::Run run = idiom_report(io, "missing");
    scratch::expect_text("functions of the table that return a pointer and have no idiom", "", run.out);
}

export void test_the_table_records_the_idiom_of_a_returned_pointer(io::Io *io) {
    scratch::Run run = idiom_report(io, "list");
    scratch::expect_contains("strdup is owned, freed by free", run.out, "smith-ownership: strdup owned:free\n");
    scratch::expect_contains("strerror is internal", run.out, "smith-ownership: strerror internal\n");
    scratch::expect_contains("strchr points into argument 1", run.out, "smith-ownership: strchr borrowed:1\n");
    scratch::expect_contains("fopen is owned, freed by fclose", run.out, "smith-ownership: fopen owned:fclose\n");
    scratch::expect_contains("mmap is unmapped with its length", run.out, "smith-ownership: mmap owned:munmap:2\n");
    scratch::expect_contains("getcwd allocates when argument 1 is null", run.out,
                             "smith-ownership: getcwd null:1 owned:free\n");
    scratch::expect_contains("realpath allocates when argument 2 is null", run.out,
                             "smith-ownership: realpath null:2 owned:free\n");
    scratch::expect_contains("tmpnam is static when argument 1 is null", run.out,
                             "smith-ownership: tmpnam null:1 internal\n");
}

// effects::within in a generic (skill smith-lang-effects): a function of another module is judged by the link, which
// names the chain through that module; one that fits builds.
export void test_within_in_modules_the_link_judges_a_function_of_another_module_and_names_the_chain(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run made = scratch::sh(&p, "mkdir -p fx3");
    scratch::expect_status("the folder of the module", 0, &made);
    scratch::write(&p, "fx3/lib.smith",
                   "module fx3::lib;\nimport <stdio.h>;\nexport i32 plain(i32 x) { return x + 1; }\n"
                   "export i32 noisy(i32 x) { c::printf(\"%d\\n\", x); return x; }\n");
    scratch::write(&p, "main.smith",
                   "module main;\nimport fx3::lib as lib;\nimport smith::effects;\n"
                   "export i32 run(constexpr auto f, i32 x) {\n"
                   "    static_assert(effects::within(f, effects::alloc), \"run: f may only allocate\");\n"
                   "    return f(x);\n}\n"
                   "i32 main() { return run(lib::plain, 1) + run(lib::noisy, 1) - 4; }\n");
    scratch::Run run = scratch::sh(&p, "smith build 2>&1 | grep -E 'smith-effect' | sed 's/^main.smith:5:[0-9]*: //'");
    scratch::expect_text("within, modules: the link judges a function of another module and names the chain",
                         "error: smith-effect: static assertion failed: run: f may only allocate: `fx3::lib::noisy` "
                         "has the effects console, globals "
                         "beyond the allowed ones: fx3::lib::noisy -> printf (lib.smith:4)",
                         run.out);
}

// Promises: `smith check` lists what smith trusts and does not check, from the `P` lines of the summaries its own build
// leaves (an effects attribute on a declaration with no source, a function that calls smith_trusted()), a header's
// once.
export void test_promises_smith_check_lists_two_declared_promises_and_a_trusted_function(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::write(&p, "lib.h",
                   "[[smith::effects(alloc, net)]] int curl_perform(void *handle);\n[[smith::pure]] int twice(int);\n");
    scratch::write(
        &p, "main.c",
        "#include <smith/contract.h>\n#include \"lib.h\"\nstatic int edge(int x) { smith_trusted(); return x; }\n"
        "int main(void) { return edge(0); }\n");
    // No build first: `smith check` makes the summaries it lists (issue #311).
    scratch::Run run = scratch::sh(&p, "smith check -v 2>&1 | grep -E '^smith check: (promises|  )'");
    scratch::expect_text(
        "promises: smith check -v lists two declared promises and a trusted function",
        "smith check: promises: 3\nsmith check:   ./lib.h:1 curl_perform\nsmith check:   ./lib.h:2 twice\n"
        "smith check:   main.c:3 edge",
        run.out);
}

