// The idiom joins the function's entry in the summary (`O` a function, `T` a typedef) and the link reads the file.
export void test_ownership_is_recorded_in_the_summary(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::write(&p, "a.c",
                   "#include <stdlib.h>\n[[std::returns_owned(free)]] char *dup1(const char *s);\n"
                   "[[std::returns_borrowed(1)]] char *find1(const char *s, int c);\n"
                   "[[std::returns_internal]] char *note1(int n);\n"
                   "[[std::returns_internal]] typedef char *(*Describe)(int);\n"
                   "typedef char *(*Name)(int) [[clang::annotate_type(\"std::owns:internal\")]];\n"
                   "int main(void) { return 0; }\n");
    // the linkage name has Mach-O's leading underscore, ELF's has none
    scratch::Run run = scratch::sh(&p, "smith cc -c a.c -o a.o && grep -E '^[OT]' a.o.fx | cut -f1-3 | "
                                       "awk -F'\\t' 'BEGIN { OFS = \"\\t\" } $1 == \"O\" { sub(/^_/, \"\", $2) } "
                                       "{ print }' && smith cc a.o -o program && echo linked");
    scratch::expect_text("the ownership lines of the summary",
                         "O\tdup1\towned:free\nO\tfind1\tborrowed:1\nO\tnote1\tinternal\nT\tDescribe\tinternal\n"
                         "T\tName\tinternal\nlinked\n",
                         run.out);
}

