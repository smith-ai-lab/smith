// Effects, inferred (`shim/effects_infer.cpp`; issue #207, skill smith-lang-effects): each tests/effects/*.c and
// *.smith is compiled with `smith cc -c` and what it prints (the status, then each error and note, the path left off)
// is the golden file beside it, `<file>.expected`: a pure function over libc, the chain from a pure function to printf,
// a ceiling that fits and one that does not, a write to a global or a function-local static, a call through a function
// pointer, a declaration with no body, with a promise and without, in C and in a module; the editor shows the same
// error; and across files, the link of objects with summaries, an incremental build, the worst-case stack and the
// fix-it. A file added to tests/effects needs a test here: `test_every_file_has_a_test` says which.
module effects_infer_test;

import smith::format;
import smith::io;
import smith::mem;
import smith::test;
import <stdlib.h>;
import <string.h>;
import scratch;
import target;

static typeof(const char[:]) slice_of(const char *text) {
    return text[0:c::strlen(text)];
}

static const char *join(const scratch::Project *p, const char *a, const char *b, const char *c, const char *d) {
    return format::push(&p->io->arena, a, b, c, d).data;
}

// What a compile of the file prints, as tests/effects/<file>.expected holds it.
static void effects_case(io::Io *io, const char *file) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::copy_tree(&p, "tests/effects", "tests/effects");
    const char *command =
        format::push(&io->arena, "cd tests/effects && { smith cc -std=gnu2y -I \"$SMITH_REPO/.smith/include\" -c ",
                     file,
                     " -o /dev/null >\"$TMPDIR/out\" 2>&1; echo \"status $?\"; grep -E '^[^ ]+:[0-9]+:[0-9]+: "
                     "(error|note|warning):' "
                     "\"$TMPDIR/out\"; }")
            .data;
    scratch::Run run = scratch::sh(&p, command);
    test::golden(io, slice_of(format::push(&io->arena, "tests/effects/", file, ".expected").data), slice_of(run.out));
}

// The report-only pointer rule: the lines SMITH_EFFECTS_POINTERS gets, a call with the effects its type states.
export void test_effects_pointers_report(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::copy_tree(&p, "tests/effects_pointers", "tests/effects_pointers");
    scratch::Run run = scratch::sh(
        &p, "cd tests/effects_pointers && SMITH_EFFECTS_POINTERS=\"$TMPDIR/report\" smith cc "
            "-std=gnu2y -I \"$SMITH_REPO/.smith/include\" -c pointers.c -o /dev/null >\"$TMPDIR/out\" 2>&1; "
            "echo \"status $?\"; cat \"$TMPDIR/report\"");
    test::golden(io, slice_of("tests/effects_pointers/pointers.c.expected"), slice_of(run.out));
}

export void test_every_file_has_a_test(io::Io *io) {
    scratch::expect_text("files of tests/effects with no test", "",
                         scratch::untested_names(io, "tests/effects", "tests/effects_infer_test.smith",
                                                 "effects_case(io, ", ".c", ".smith"));
}

// The editor: clangd shows the same error, for C and for a module.
static void effects_editor(io::Io *io, const char *file) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::copy_tree(&p, "tests/effects", "tests/effects");
    scratch::Run run = scratch::sh(
        &p, format::push(&io->arena, "timeout -s KILL 120 smith lsp --check=tests/effects/", file, " 2>&1").data);
    scratch::expect_contains(file, run.out, "smith-effect: `bad` is [[smith::pure]]");
}

export void test_lsp_effects_chain_c(io::Io *io) {
    effects_editor(io, "effects_chain.c");
}

export void test_lsp_effects_chain_smith(io::Io *io) {
    effects_editor(io, "effects_chain.smith");
}

// Across files: each compile leaves a summary beside its object (`x.o.fx`), and the link of objects that have one
// checks the calls that cross files (smith-cc runs `--smith-effects`): an unannotated function of another file is
// inferred, a function nobody defines is `c`, in C and in modules (a build).
constexpr char cross_expected[_] =
    "a.c:3:52: error: smith-effect: `bad` is [[smith::pure]], but it has the effects console, globals: bad -> noisy "
    "(a.c:3) -> "
    "printf (b.c:4)\n"
    "a.c:4:41: error: smith-effect: `lost` is [[smith::pure]], but it has the effects c: lost -> ghost (a.c:4)";

static void write_cross(const scratch::Project *p) {
    scratch::write(p, "b.h", "int plain_add(int);\nint noisy(const char *);\nint ghost(void);\n");
    scratch::write(p, "b.c",
                   "#include <stdio.h>\n#include \"b.h\"\nint plain_add(int x) { return x + 1; }\n"
                   "int noisy(const char *text) { return printf(\"%s\\n\", text); }\n");
    scratch::write(p, "a.c",
                   "#include \"b.h\"\n[[smith::pure]] int fine(int x) { return plain_add(x); }\n"
                   "[[smith::pure]] int bad(const char *text) { return noisy(text); }\n"
                   "[[smith::pure]] int lost(void) { return ghost(); }\n"
                   "int main(void) { return fine(1) + bad(\"x\") + lost(); }\n");
}

export void test_across_files_in_c_the_link_names_the_chain_through_the_other_file(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    write_cross(&p);
    scratch::Run compiled = scratch::sh(&p, "smith cc -c b.c -o b.o && smith cc -c a.c -o a.o");
    scratch::expect_status("across files, C: the objects", 0, &compiled);
    scratch::Run linked = scratch::sh(&p, "smith cc a.o b.o -o program 2>&1 | grep -E 'smith-effect'");
    scratch::expect_text("across files, C: the link names the chain through the other file, and a function no file "
                         "defines is c",
                         cross_expected, linked.out);
}

// The same on one command that compiles and links, where clang's objects are temporary files with their summaries
// beside them (the linker the driver starts checks them).
export void test_across_files_in_c_one_command_that_compiles_and_links_names_the_same_chain(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    write_cross(&p);
    scratch::Run linked = scratch::sh(&p, "smith cc a.c b.c -o program_one 2>&1 | grep -E 'smith-effect'");
    scratch::expect_text("across files, C: one command that compiles and links names the same chain", cross_expected,
                         linked.out);
}

// A link of more objects than any fixed count the check once had (it skipped the objects past 128, so a function of the
// last one had no source and was `c`): the object that defines `noisy` comes last, after 200 others.
export void test_across_files_in_c_a_link_of_many_objects_reads_every_summary(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    write_cross(&p);
    scratch::Run compiled =
        scratch::sh(&p, "smith cc -c b.c -o b.o && smith cc -c a.c -o a.o && list= && for i in $(seq 1 200); do "
                        "echo \"int filler_$i(void) { return $i; }\" > f$i.c && smith cc -c f$i.c -o f$i.o && "
                        "list=\"$list f$i.o\"; done && echo \"$list\" > list.txt");
    scratch::expect_status("many objects: the objects", 0, &compiled);
    scratch::Run linked = scratch::sh(&p, "smith cc a.o $(cat list.txt) b.o -o program 2>&1 | grep -E 'smith-effect'");
    scratch::expect_text("many objects: the link still names the chain through the last object", cross_expected,
                         linked.out);
}

constexpr char loud_error[_] =
    "error: smith-effect: `bad` is [[smith::pure]], but it has the effects console, globals: bad -> "
    "fx::lib::noisy (main.smith:4) "
    "-> printf (lib.smith:4)";
constexpr char lib_loud[_] = "module fx::lib;\nimport <stdio.h>;\nexport i32 plain(i32 x) { return x + 1; }\n"
                             "export i32 noisy(i32 x) { c::printf(\"%d\\n\", x); return x; }\n";
constexpr char lib_quiet[_] = "module fx::lib;\nimport <stdio.h>;\nexport i32 plain(i32 x) { return x + 1; }\nexport "
                              "i32 noisy(i32 x) { return x; }\n";

static void write_modules(const scratch::Project *p) {
    scratch::Run made = scratch::sh(p, "mkdir -p fx");
    scratch::expect_status("the folder of the module", 0, &made);
    scratch::write(p, "fx/lib.smith", lib_loud);
    scratch::write(p, "main.smith",
                   "module main;\nimport fx::lib as lib;\n[[smith::pure]] i32 good(i32 x) { return lib::plain(x); }\n"
                   "[[smith::pure]] i32 bad(i32 x) { return lib::noisy(x); }\n"
                   "i32 main() { return good(1) + bad(1) - 4; }\n");
}

// The effect errors of a build.
static const char *rebuilt(const scratch::Project *p) {
    return scratch::sh(p, "smith build 2>&1 | grep -E 'smith-effect' | sed 's/^main.smith:4:[0-9]*: //'").out;
}

export void test_across_files_in_modules_a_builds_link_names_the_chain_through_the_other_module(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    write_modules(&p);
    scratch::expect_text("across files, modules: a build's link names the chain through the other module", loud_error,
                         rebuilt(&p));
}

// An incremental build gives the verdict of a clean one: only the callee's file is edited (to something pure and then
// back), and the importer, whose object is up to date, is judged by the summary of what changed.
export void test_an_incremental_build_gives_the_verdict_of_a_clean_one(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    write_modules(&p);
    scratch::expect_text("the first build has the error", loud_error, rebuilt(&p));
    scratch::write(&p, "fx/lib.smith", lib_quiet);
    scratch::expect_text("incremental: the callee edited to be pure, the importer is no longer in error", "",
                         rebuilt(&p));
    scratch::write(&p, "fx/lib.smith", lib_loud);
    scratch::expect_text("incremental: the callee edited back to print, the same error as a clean build", loud_error,
                         rebuilt(&p));
}

// The same in a C build (main.c and lib.c, the conventions): only lib.c is edited, to be pure and back, and a summary
// lost (the folder removed) is made again with the same verdict. smith has no object cache (its caches are modules and
// packages), so there is no cached object that could miss its summary: an object whose summary is gone is rebuilt.
export void test_a_c_build_gives_the_verdict_of_a_clean_one_when_lib_c_changes(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    constexpr char loud[_] =
        "#include <stdio.h>\n#include \"lib.h\"\nint noisy(int x) { printf(\"%d\\n\", x); return x; }\n";
    scratch::write(&p, "lib.h", "int noisy(int);\n");
    scratch::write(&p, "lib.c", loud);
    scratch::write(&p, "main.c",
                   "#include \"lib.h\"\n[[smith::pure]] static int bad(int x) { return noisy(x); }\n"
                   "int main(void) { return bad(1) - 1; }\n");
    const char *build = "smith build 2>&1 | grep -E 'smith-effect' | sed 's/^main.c:2:[0-9]*: //'";
    const char *expected = "error: smith-effect: `bad` is [[smith::pure]], but it has the effects console, globals: "
                           "bad -> noisy (main.c:2) -> "
                           "printf (lib.c:3)";
    scratch::expect_text("C build: the first build names the chain through lib.c", expected,
                         scratch::sh(&p, build).out);
    scratch::write(&p, "lib.c", "#include \"lib.h\"\nint noisy(int x) { return x; }\n");
    scratch::expect_text("C build, incremental: only lib.c became pure, and main.c is no longer in error", "",
                         scratch::sh(&p, build).out);
    scratch::write(&p, "lib.c", loud);
    scratch::expect_text("C build, incremental: lib.c edited back, the same error as the first build", expected,
                         scratch::sh(&p, build).out);
    scratch::Run removed = scratch::sh(&p, "rm -rf .smith/effects");
    scratch::expect_status("the summaries are removed", 0, &removed);
    scratch::expect_text("C build: the summaries removed, the next build gives the same verdict", expected,
                         scratch::sh(&p, build).out);
    scratch::Run made = scratch::sh(&p, "[ -f \"$(ls .smith/effects/*main.o.fx 2>/dev/null | head -n 1)\" ]");
    scratch::expect_status("C build: and makes the summaries again", 0, &made);
}

// The worst-case stack: `<program>.stack` beside a program linked from objects that have summaries, the frames from the
// backend (the numbers `-fstack-usage` gives), summed along the deepest call, a recursion unbounded, a tail call cycle
// not, a call of code with no source an "at least N + unknown" row.
constexpr char stack_a[_] =
    "#include <stdio.h>\nint g(int *);\nstatic int h(int x) { int a[100]; for (int i = 0; i < 100; i++) a[i] = x + i; "
    "return g(a); }\nint f(int x) { return h(x) + 1; }\nint rec(int n) { return n ? rec(n - 1) + 1 : 0; }\n"
    "int even(int n);\nint odd(int n) { if (n == 0) return 0; [[clang::musttail]] return even(n - 1); }\n"
    "int even(int n) { if (n == 0) return 1; [[clang::musttail]] return odd(n - 1); }\n"
    "int main(void) { printf(\"%d\\n\", f(1) + even(4)); return rec(3); }\n";
constexpr char stack_a_without_rec[_] =
    "#include <stdio.h>\nint g(int *);\nstatic int h(int x) { int a[100]; for (int i = 0; i < 100; i++) a[i] = x + i; "
    "return g(a); }\nint f(int x) { return h(x) + 1; }\n\n"
    "int even(int n);\nint odd(int n) { if (n == 0) return 0; [[clang::musttail]] return even(n - 1); }\n"
    "int even(int n) { if (n == 0) return 1; [[clang::musttail]] return odd(n - 1); }\n"
    "int main(void) { printf(\"%d\\n\", f(1) + even(4)); return 0; }\n";

// The project with a.c and b.c compiled, with the frames the backend gave as references, and linked as `p`.
static scratch::Project stack_project(io::Io *io, const char *source) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::write(&p, "a.c", source);
    scratch::write(&p, "b.c", "int g(int *p) { return p[3]; }\n");
    scratch::Run run =
        scratch::sh(&p, "smith cc -c a.c -o a.o && smith cc -c b.c -o b.o && smith cc -fstack-usage -c a.c "
                        "-o ref_a.o && smith cc -fstack-usage -c b.c -o ref_b.o && smith cc a.o b.o -o p");
    scratch::expect_status("the objects are made and linked", 0, &run);
    return p;
}

// The frame of a function in a reference's .su file, or -1.
static i64 frame(const scratch::Project *p, const char *reference, const char *name) {
    const char *command = format::push(&p->io->arena, "awk -F'\\t' -v n=", name,
                                       " '{ split($1, p, \":\"); if (p[length(p)] == n) print $2 }' ", reference, ".su")
                              .data;
    const char *text = scratch::sh(p, command).out;
    return text[0] == '\0' ? -1 : (i64)c::strtol(text, nullptr, 10);
}

// A column of a function's row in <program>.stack: 2 is its worst case, 3 the deepest call.
static const char *row(const scratch::Project *p, const char *program, const char *name, const char *column) {
    const char *command =
        format::push(&p->io->arena, "awk -F'\\t' -v n=", name, " '$1 == n { print $", column, " }' ", program, ".stack")
            .data;
    return scratch::sh(p, command).out;
}

static i64 number(const char *text) {
    return text[0] == '\0' ? -1 : (i64)c::strtol(text, nullptr, 10);
}

static i64 stack_want(const scratch::Project *p, const char *a, const char *b) {
    return frame(p, a, "f") + frame(p, a, "h") + frame(p, b, "g");
}

export void test_stack_f_h_g_is_the_sum_of_the_three_frames_the_backend_gave(io::Io *io) {
    scratch::Project p = stack_project(io, stack_a);
    i64 want = stack_want(&p, "ref_a", "ref_b");
    test::check_greater(want, (i64)0);
    test::check_equal(number(row(&p, "p", "f", "2")), want);
    scratch::expect_text("stack: the deepest call", "f -> h -> g", row(&p, "p", "f", "3"));
}

export void test_stack_recursion_is_unbounded(io::Io *io) {
    scratch::Project p = stack_project(io, stack_a);
    scratch::expect_text("stack: recursion is unbounded", "unbounded", row(&p, "p", "rec", "2"));
}

export void test_stack_a_cycle_of_musttail_calls_is_bounded(io::Io *io) {
    scratch::Project p = stack_project(io, stack_a);
    test::check_greater_equal(number(row(&p, "p", "even", "2")), (i64)0);
}

export void test_stack_a_call_of_code_with_no_source_is_at_least_n_plus_unknown(io::Io *io) {
    scratch::Project p = stack_project(io, stack_a_without_rec);
    const char *text = row(&p, "p", "main", "2");
    scratch::expect_contains("stack: main is 'at least N + unknown (calls: printf)', no number for printf", text,
                             "at least ");
    scratch::expect_contains("stack: and it says what is unknown", text, " + unknown (calls: printf)");
}

// One command that compiles and links writes the same file, and leaves no .su behind.
export void test_stack_one_command_that_compiles_and_links_writes_the_same_stack_and_no_su(io::Io *io) {
    scratch::Project p = stack_project(io, stack_a);
    scratch::Run run = scratch::sh(&p, "rm -f p.stack && smith cc a.c b.c -o p2");
    scratch::expect_status("stack: compile and link in one command", 0, &run);
    test::check_equal(number(row(&p, "p2", "f", "2")), stack_want(&p, "ref_a", "ref_b"));
    test::check(!scratch::exists(&p, "p2.su"));
}

// -O2: the frames are the optimized ones, and the file says so.
export void test_stack_o2_frames_are_the_optimized_ones_and_the_file_says_so(io::Io *io) {
    scratch::Project p = stack_project(io, stack_a);
    scratch::Run run = scratch::sh(&p, "smith cc -O2 -c a.c -o a2.o && smith cc -O2 -c b.c -o b2.o && smith cc -O2 "
                                       "-fstack-usage -c a.c -o ref2_a.o && "
                                       "smith cc -O2 -fstack-usage -c b.c -o ref2_b.o && smith cc -O2 a2.o b2.o -o p3");
    scratch::expect_status("stack: -O2 objects", 0, &run);
    scratch::Run header = scratch::sh(&p, "grep -q '^# build: \\[opt=2\\]' p3.stack");
    scratch::expect_status("stack: the file says opt=2", 0, &header);
    i64 sum = 0;
    const char *path = row(&p, "p3", "f", "3");
    for (const char *at = path; *at != '\0';) {
        usize length = c::strcspn(at, " \n");
        char step[128] = "";
        if (length > 0 && length < sizeof step) mem::copy(step[0:length], at[0:length]);
        if (length > 0 && c::strcmp(step, "->") != 0) {
            i64 n = frame(&p, "ref2_a", step);
            if (n < 0) n = frame(&p, "ref2_b", step);
            sum += n > 0 ? n : 0;
        }
        at += length;
        at += *at != '\0' ? 1 : 0;
    }
    test::check_equal(number(row(&p, "p3", "f", "2")), sum);
}

// A module: the frames of `.smith` functions, through smith build.
export void test_stack_a_modules_function_has_its_frame_and_its_callees_in_the_builds_stack(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run made = scratch::sh(&p, "mkdir -p fx");
    scratch::expect_status("the folder of the module", 0, &made);
    scratch::write(&p, "fx/lib.smith",
                   "module fx::lib;\nstatic i32 leaf(i32 x) { i32 a[64]; for (i32 i = 0; i < 64; i++) a[i] = x + i; "
                   "return a[x % 64]; }\n"
                   "export i32 deep(i32 x) { return leaf(x) + 1; }\n");
    scratch::write(&p, "main.smith",
                   "module main;\nimport fx::lib as lib;\ni32 main() { return lib::deep(1) - lib::deep(1); }\n");
    scratch::Run built = scratch::sh(&p, "smith build");
    scratch::expect_status("stack: the module builds", 0, &built);
    scratch::Run found = scratch::sh(&p, "awk -F'\\t' '$1 == \"fx::lib::deep\" && $2 + 0 > 256 && $3 ~ /^fx::lib::deep "
                                         "-> / { found = 1 } END { exit !found }' "
                                         "build/debug/p.stack");
    scratch::expect_status("stack: a module's function has its frame and its callee's in the build's .stack", 0,
                           &found);
}

// The link names every function as the source writes it: a private function of the importer (`bad2`, not `main_bad2`),
// an export of a module (`fx2::lib::loud`) and a private function of that module (`shout`).
export void test_names_the_link_shows_functions_as_written(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run made = scratch::sh(&p, "mkdir -p fx2");
    scratch::expect_status("the folder of the module", 0, &made);
    scratch::write(
        &p, "fx2/lib.smith",
        "module fx2::lib;\nimport <stdio.h>;\nstatic i32 shout(i32 x) { c::printf(\"%d\\n\", x); return x; }\n"
        "export i32 loud(i32 x) { return shout(x); }\n");
    scratch::write(&p, "main.smith",
                   "module main;\nimport fx2::lib as lib;\n[[smith::pure]] i32 bad2(i32 x) { return lib::loud(x); }\n"
                   "i32 main() { return bad2(1) - 1; }\n");
    scratch::Run run = scratch::sh(&p, "smith build 2>&1 | grep -E 'smith-effect' | sed 's/^main.smith:3:[0-9]*: //'");
    scratch::expect_text(
        "names: the link shows the importer's private function, the export and the module's private function as "
        "written",
        "error: smith-effect: `bad2` is [[smith::pure]], but it has the effects console, globals: bad2 -> "
        "fx2::lib::loud "
        "(main.smith:3) -> shout (lib.smith:4) -> printf (lib.smith:3)",
        run.out);
}

// The editor shows the same verdict as the link, for modules: with the summaries the build made, `smith lsp --check` of
// the importer shows the error and its chain; once the callee is pure (and its summary made), it is gone.
export void test_the_editor_shows_the_same_verdict_as_the_link_for_modules(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    write_modules(&p);
    scratch::Run first = scratch::sh(&p, "smith build >/dev/null 2>&1");
    (void)first; // the build fails on the error: the summaries are what the editor needs
    const char *check = "timeout -s KILL 120 smith lsp --check=\"$PWD/main.smith\" 2>&1 | grep -o 'smith-effect: .*' | "
                        "sed 's/^smith-effect: //'";
    scratch::expect_text(
        "editor, modules: lsp --check shows the error through the other module, with the chain",
        "`bad` is [[smith::pure]], but it has the effects console, globals: bad -> fx::lib::noisy (main.smith:4) "
        "-> printf (lib.smith:4)",
        scratch::sh(&p, check).out);
    scratch::write(&p, "fx/lib.smith", lib_quiet);
    scratch::Run second = scratch::sh(&p, "smith build >/dev/null 2>&1");
    (void)second;
    scratch::expect_text("editor, modules: and it is gone once the callee is pure and rebuilt", "",
                         scratch::sh(&p, check).out);
}

// The fix-it of an effects error: applied (clang's -fixit), the file compiles.
export void test_the_fix_it_of_an_effects_error_replaces_the_attribute_and_the_files_compile(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::copy_tree(&p, "tests/effects/effects_ceiling.c", "c.c");
    scratch::write(
        &p, "p.c",
        "[[smith::pure]] int twice(int x) { return x * 2; }\n"
        "[[smith::pure]] int noisy(int x) { puts(\"x\"); return x; }\n"
        "[[smith::alloc]] void *single(unsigned n) { FILE *f = fopen(\"d\", \"r\"); (void)f; return malloc(n); }\n");
    const char *flags = "-std=gnu2y -I \"$SMITH_REPO/.smith/include\" -include stdio.h -include stdlib.h";
    for (usize i = 0; i < 2; i++) {
        const char *file = i == 0 ? "c.c" : "p.c";
        (void)scratch::sh(&p, join(&p, "smith cc ", flags, " -Xclang -fixit -fsyntax-only ", file));
        scratch::Run compiled = scratch::sh(&p, join(&p, "smith cc ", flags, " -fsyntax-only ", file));
        scratch::expect_status(join(&p, "fix-it: ", file, " compiles", ""), 0, &compiled);
    }
    scratch::Run ceiling =
        scratch::sh(&p, "grep -q '^\\[\\[smith::effects(alloc, files, globals)\\]\\] void \\*too_much' c.c");
    scratch::expect_status("fix-it: the ceiling is replaced by the whole set", 0, &ceiling);
    scratch::Run noisy = scratch::sh(&p, "grep -q '^\\[\\[smith::effects(console, globals)\\]\\] int noisy' p.c");
    scratch::expect_status("fix-it: a pure function that prints gets console", 0, &noisy);
    scratch::Run twice = scratch::sh(&p, "grep -q '^\\[\\[smith::pure\\]\\] int twice' p.c");
    scratch::expect_status("fix-it: a pure function that is right stays pure", 0, &twice);
    scratch::Run single =
        scratch::sh(&p, "grep -q '^\\[\\[smith::effects(alloc, files, globals)\\]\\] void \\*single' p.c");
    scratch::expect_status("fix-it: a single effect's attribute gets the whole set", 0, &single);
}

