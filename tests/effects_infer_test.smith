    effects_case(io, "effects_fails.c");
}

export void test_fails_smith(io::Io *io) {
    effects_case(io, "effects_fails.smith");
}

// A callee in another file: the link judges it from the summary and the chain goes through the file.
export void test_fails_a_callee_in_another_file_reaches_a_pure_caller_at_the_link(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run made = scratch::sh(&p, "mkdir -p fx4");
    scratch::expect_status("the folder of the module", 0, &made);
    scratch::write(&p, "fx4/lib.smith",
                   "module fx4::lib;\nimport smith::contract;\nexport i32 plain(i32 x) { return x + 1; }\n"
                   "export i32 get(i32 xs[:], usize i) { return xs[i]; }\n"
                   "export i32 checked(i32 x) { contract::assert(x > 0); return x; }\n");
    scratch::write(
        &p, "main.smith",
        "module main;\nimport fx4::lib as lib;\nexport [[smith::pure]] i32 good(i32 x) { return lib::plain(x); }\n"
        "export [[smith::pure]] i32 bad(i32 xs[:], usize i) { return lib::get(xs, i); }\n"
        "export [[smith::pure]] i32 asserts(i32 x) { return lib::checked(x); }\n"
        "i32 main() { return good(1) - 2; }\n");
    scratch::Run run =
        scratch::sh(&p, "smith build 2>&1 | grep -E 'smith-effect' | sed 's/^main.smith:[45]:[0-9]*: //'");
    scratch::expect_contains(
        "fails: the chain through the other file", run.out,
        "`main::bad` is [[smith::pure]], but it has the effects fails: main::bad -> fx4::lib::get");
    scratch::expect_contains(
        "fails: an assert of another file", run.out,
        "`main::asserts` is [[smith::pure]], but it has the effects fails: main::asserts -> fx4::lib::checked");
}

// A proved contract check is not a failure point (issue #325), in every build: after `smith prove`, an optimized build
// leaves out the assert and debug keeps it under a name that is no failure point, so the function that only had it is
// [[smith::pure]] in both; with no proof the assert makes it `fails`.
export void test_fails_a_proved_assert_adds_no_fails_in_any_build(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::write(&p, "sure.smith",
                   "module sure;\nimport smith::contract;\n"
                   "export [[smith::pure]] i32 low(i32 x) { i32 y = x & 7; contract::assert(y < 8); return y; }\n");
    scratch::write(&p, "main.smith", "module main;\nimport sure;\ni32 main() { return sure::low(8); }\n");
    scratch::Run before = scratch::sh(&p, "smith build release 2>&1");
    scratch::expect_contains("no proof: the assert is a failure point", before.out,
                             "`sure::low` is [[smith::pure]], but it has the effects fails");
    scratch::Run proved = scratch::sh(&p, "smith prove 2>&1");
    scratch::expect_status("the assert is proved", 0, &proved);
    scratch::Run release = scratch::sh(&p, "smith build release 2>&1");
    scratch::expect_status("proved: the optimized build has no `fails` there", 0, &release);
    scratch::expect_lacks("and says nothing", release.out, "smith-effect");
    scratch::Run debug = scratch::sh(&p, "smith build 2>&1");
    scratch::expect_status("debug has the same verdict as release", 0, &debug);
    scratch::expect_lacks("and says nothing", debug.out, "smith-effect");
}

// A proved index is no failure point in any build (issue #325): the contract lets the prover prove `xs[i]`, so after
// `smith prove` a [[smith::pure]] function that only indexes passes in debug as well, where the check is still
// emitted, under the name `smith_failure_proved` that the effects table reads as no failure.
export void test_fails_a_proved_index_adds_no_fails_in_debug(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::write(&p, "pick.smith",
                   "module pick;\nimport bounds;\nimport smith::contract;\n"
                   "export [[smith::pure]] i32 at(usize i) {\n"
                   "    i32 buffer[8] = {1, 2, 3, 4, 5, 6, 7, 8};\n"
                   "    i32 window[:] = buffer;\n"
                   "    usize j = bounds::clamp(i);\n"
                   "    contract::ensures(true);\n"
                   "    return window[j];\n"
                   "}\n");
    scratch::write(&p, "bounds.smith",
                   "module bounds;\nimport smith::contract;\n"
                   "export [[smith::pure]] usize clamp(usize n) {\n"
                   "    usize r = n < 8 ? n : 7;\n"
                   "    contract::ensures(r < 8);\n"
                   "    return r;\n"
                   "}\n");
    scratch::write(&p, "main.smith", "module main;\nimport pick;\ni32 main() { return pick::at(1) - 2; }\n");
    scratch::Run before = scratch::sh(&p, "smith build 2>&1");
    scratch::expect_contains("no proof: the index is a failure point", before.out,
                             "`at` is [[smith::pure]], but it has the effects fails");
    scratch::Run proved = scratch::sh(&p, "smith prove 2>&1");
    scratch::expect_status("the index is proved", 0, &proved);
    scratch::Run debug = scratch::sh(&p, "smith build 2>&1");
    scratch::expect_status("proved: the debug build adds no `fails`", 0, &debug);
    scratch::expect_lacks("and says nothing", debug.out, "smith-effect");
    scratch::Run object = scratch::sh(&p, "smith cc -c pick.smith -O0 -I .smith/include -o pick.o 2>&1; nm pick.o");
    scratch::expect_contains("debug still emits the check, as a name that is no failure point", object.out,
                             "smith_failure_proved");
    scratch::expect_lacks("and no other failure call", object.out, "U _smith_failure\n");
}

