// End-to-end tests for `smith dbg` (lldb's driver) and `smith dap` (lldb-dap), both run in smith's own process from the
// LLVM it links, with the system's debugserver (from tests/dap.sh). The programs are the folders of
// tests/build_fixtures/dap; tests/dap_client.c, built by each test that needs it, writes the DAP messages and checks
// the replies. They launch real processes under a debugger, so they need Developer mode and the Developer Tools
// permission of the terminal running them (knowledge/debugger.md); a smith without clang or lldb inside (the stage0),
// or an account that may not debug, has nothing to test, and the tests do nothing.
// A test makes its project, then sets its own memory as the current allocator: what scratch returns to it (a Run's
// texts, a file it reads) is given back with that memory, and scratch::clean frees what make holds.
module dap_test;

import smith::format;
import smith::arena;
import smith::mem;
import smith::test;
import scratch;

constexpr usize memory_size = (usize)16 << 20; // 16 MiB

// A folder of the project, as a project of its own; it shares the root's folders, which the root's clean removes.
static scratch::Project folder(arena::Arena *memory, const scratch::Project *root, const char *name) {
    scratch::Project f = *root;
    f.dir = format::push(memory, root->dir, "/", name).data;
    return f;
}

// The client built in the project of the fixture, and prog built in src. False when this smith has no lldb, or this
// account may not debug.
static bool ready(arena::Arena *memory, const scratch::Project *root) {
    scratch::Run usable = scratch::sh(
        root, "[ \"$(smith cc --smith-which -c a.c | head -n 1 | cut -d ' ' -f 1,2)\" = 'clang in-process' ] && "
              "smith dbg --version >/dev/null 2>&1");
    if (usable.status != 0) {
        return false;
    }
    scratch::Project src = folder(memory, root, "src");
    scratch::Run built = scratch::sh(&src, "smith cc -g -O0 prog.c -o prog");
    scratch::expect_status("dap: prog.c builds", 0, &built);
    scratch::copy_tree(root, "tests/dap_client.c", "tests/dap_client.c");
    scratch::copy_tree(root, "tests/cpu_wait.h", "tests/cpu_wait.h");
    scratch::Run client = scratch::sh(root, "smith cc -std=gnu23 tests/dap_client.c -o dap_client");
    scratch::expect_status("dap: tests/dap_client.c builds", 0, &client);
    const char *probe = scratch::sh(&src, "smith dbg -b -o 'b prog.c:10' -o run -o 'frame variable sum' prog 2>&1").out;
    return !scratch::contains(probe, "Developer Tools") && !scratch::contains(probe, "not allowed") &&
           !scratch::contains(probe, "timed out") && !scratch::contains(probe, "unable to attach");
}

// Whether the smith has the token hook, so `.smith` names exist in the debugger.
static bool has_hook(const scratch::Project *p) {
    return scratch::sh(p, "smith cc --smith-which -x c 2>/dev/null | grep -q 'token-hook yes'").status == 0;
}

static scratch::Run dbg(arena::Arena *memory, const scratch::Project *p, const char *arguments) {
    return scratch::sh(p, format::push(memory, "smith dbg -b ", arguments, " 2>&1").data);
}

// smith dbg, in batch mode: a breakpoint by line, run, a variable, a struct field, a backtrace.
export void test_macos_dap_dbg_a_c_program() {
    scratch::Project root = scratch::make("dap", "dap");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&memory, &root)) {
        return;
    }
    scratch::Project src = folder(&memory, &root, "src");
    const char *out = dbg(&memory, &src,
                          "-o 'b prog.c:10' -o run -o 'frame variable sum' -o 'frame variable p' -o 'print p.x' -o bt "
                          "prog")
                          .out;
    scratch::expect_contains("dbg stops at the breakpoint", out, "stop reason = breakpoint 1.1");
    scratch::expect_contains("dbg prints a local", out, "(int) sum = 7");
    scratch::expect_contains("dbg prints a struct", out, "x = 3");
    scratch::expect_contains("dbg prints a field", out, "(int) 3");
    scratch::expect_contains("dbg prints a backtrace", out, "frame #0: ");
    scratch::expect_contains("dbg's backtrace has the caller", out, "main at prog.c");
}

// A payload enum (issue #198) shows its active variant and only that variant's payload, not every member of the union.
export void test_macos_dap_dbg_a_payload_enum() {
    scratch::Project root = scratch::make("dap", "dap");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&memory, &root) || !has_hook(&root)) {
        return;
    }
    scratch::Project p = folder(&memory, &root, "enumdir");
    scratch::Run built = scratch::sh(&p, "smith cc -g -O0 main.smith -o enum_prog");
    scratch::expect_status("the payload enum program builds", 0, &built);
    const char *out = dbg(&memory, &p, "-o 'b main.smith:17' -o run -o 'frame variable a b c' enum_prog").out;
    scratch::expect_contains("dbg shows a payload enum's active variant and its payload", out,
                             "a = circle {\n  circle = (r = 2)\n}");
    scratch::expect_contains("... a variant with no payload by its name", out, "b = empty {}");
    scratch::expect_contains("... and one with a number", out, "c = square {\n  square = 3\n}");
    scratch::expect_lacks("... the raw tag and the inactive members stay hidden", out, "tag = ");
}

// smith dap: a client writes DAP messages, and the adapter's replies are read back. A silent adapter (no output, no
// CPU) is reported as a missing permission after the idle limit, not waited out.
export void test_macos_dap_a_silent_adapter_is_a_missing_permission() {
    scratch::Project root = scratch::make("dap", "dap");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&memory, &root)) {
        return;
    }
    scratch::Run made = scratch::sh(&root, "printf '#!/bin/sh\\nexec sleep 30\\n' >silent && chmod +x silent");
    scratch::expect_status("dap: the silent adapter is made", 0, &made);
    scratch::Run run =
        scratch::sh(&root, "DAP_CLIENT_IDLE_SECONDS=1 ./dap_client \"$PWD/silent\" x x 1 x x 2>&1 >/dev/null");
    scratch::expect_contains("dap: a silent adapter fails as a missing Developer Tools permission", run.out,
                             "the debugger is waiting for permission (Developer Tools)");
}

export void test_macos_dap_a_session_on_a_c_program() {
    scratch::Project root = scratch::make("dap", "dap");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&memory, &root)) {
        return;
    }
    scratch::Run session =
        scratch::sh(&root, "./dap_client \"$(command -v smith)\" \"$PWD/src/prog\" \"$PWD/src/prog.c\" 10 sum 7 2>&1");
    if (session.status != 0) {
        test::note("dap session (status %d)\n%s", session.status, session.out);
    }
    scratch::expect_status("dap: initialize, launch, setBreakpoints, configurationDone, stopped, stackTrace, scopes, "
                           "variables, continue, terminated",
                           0, &session);
    scratch::expect_contains("dap reports the stop at the breakpoint", session.out, "\"reason\":\"breakpoint\"");
    scratch::expect_contains("dap lists the frame in add", session.out, "\"name\":\"add");
    scratch::expect_contains("dap lists the fields of the struct", session.out, "\"name\":\"x\"");
    scratch::expect_contains("dap reports the process ended", session.out, "\"event\":\"terminated\"");
}

// .smith names as written (issue #27): the debugger shows `geometry::box::area` and `geometry::box::Box`, never the C
// spelling `geometry_box_area`. A module's functions and variables are named so at the top; its types are `Box` in the
// namespaces `geometry` and `box`, so that an expression can name them.
constexpr char build_lang[_] =
    "mkdir -p include && smith cc --smith-header geometry/box.smith -o include/box.h && smith cc -g -O0 -I include -c "
    "geometry/box.smith -o box.o && smith cc -g -O0 -I include -c main.smith -o main.o && smith cc -g box.o main.o -o "
    "lang";

// The folder lang of the project, with its program built.
static bool lang(arena::Arena *memory, const scratch::Project *root, scratch::Project *p) {
    if (!ready(memory, root) || !has_hook(root)) {
        return false;
    }
    *p = folder(memory, root, "lang");
    scratch::Run built = scratch::sh(p, build_lang);
    scratch::expect_status("the .smith program builds", 0, &built);
    return built.status == 0;
}

export void test_macos_dap_dbg_stops_in_a_modules_function_named_as_written() {
    scratch::Project root = scratch::make("dap", "dap");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!lang(&memory, &root, &p)) {
        return;
    }
    const char *out = dbg(&memory, &p,
                          "-o 'b geometry::box::area' -o run -o bt -o 'frame variable' -o 'print b.w' -o 'print "
                          "(geometry::box::Box)b' -o 'type lookup geometry::box::Box' -o finish lang")
                          .out;
    scratch::expect_contains("dbg stops in the module's function", out, "stop reason = breakpoint 1.1");
    scratch::expect_contains("dbg's frame has the name as written", out, "frame #0: ");
    scratch::expect_contains("dbg's frame is geometry::box::area", out,
                             "lang`geometry::box::area(b=(w = 2, h = 3)) at box.smith");
    scratch::expect_contains("dbg's backtrace goes through main.smith", out, "main at main.smith:5");
    scratch::expect_contains("dbg prints a parameter's type as written", out,
                             "(geometry::box::Box) b = (w = 2, h = 3)");
    scratch::expect_contains("dbg reads a field", out, "(f32) 2");
    scratch::expect_contains("dbg casts to a type as written", out, "(geometry::box::Box)  (w = 2, h = 3)");
    scratch::expect_contains("dbg looks the type up by its name as written", out, "f32 w;");
    scratch::expect_contains("dbg's finish returns the value", out, "Return value: (f32) $0 = 6");
}

export void test_macos_dap_dbg_the_other_compile_unit_agrees_on_the_type() {
    scratch::Project root = scratch::make("dap", "dap");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!lang(&memory, &root, &p)) {
        return;
    }
    const char *out = dbg(&memory, &p, "-o 'b main.smith:5' -o run -o 'frame variable b' lang").out;
    scratch::expect_contains("dbg's other compile unit agrees on the type", out,
                             "(geometry::box::Box) b = (w = 2, h = 3)");
    scratch::expect_lacks("the C spelling does not show in dbg", out, "geometry_box");
}

export void test_macos_dap_a_smith_session_has_names_as_written() {
    scratch::Project root = scratch::make("dap", "dap");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!lang(&memory, &root, &p)) {
        return;
    }
    scratch::Run session = scratch::sh(&p, "../dap_client \"$(command -v smith)\" \"$PWD/lang\" "
                                           "\"$PWD/geometry/box.smith\" 5 r 0 2>&1");
    scratch::expect_status("dap: a .smith session", 0, &session);
    scratch::expect_contains("dap's frame has the name as written", session.out, "\"name\":\"geometry::box::area");
    scratch::expect_contains("dap's variable has the type as written", session.out, "\"type\":\"geometry::box::Box\"");
}

// A generic's instance (issue #15): the frame is `pick::larger<i32>` with the types it was asked for, and it is in the
// generic's own source, at the line written there, not in the compiler's copy of the tokens.
export void test_macos_dap_dbg_a_generics_instance() {
    scratch::Project root = scratch::make("dap", "dap");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&memory, &root) || !has_hook(&root)) {
        return;
    }
    scratch::Project p = folder(&memory, &root, "generic");
    scratch::Run built = scratch::sh(&p, "smith cc -g -O0 gmain.smith pick.smith -o generic");
    scratch::expect_status("the generic program builds", 0, &built);
    const char *out = dbg(&memory, &p, "-o 'br set -r larger' -o run -o bt -o 'frame variable' -o c -o bt generic").out;
    scratch::expect_contains("dbg stops in an instance", out, "stop reason = breakpoint 1.1");
    scratch::expect_contains("dbg's frame is the instance, named with its types", out,
                             "generic`pick::larger<i32>(a=3, b=8) at pick.smith:4");
    scratch::expect_contains("dbg's other instance has its own types", out,
                             "generic`pick::larger<f64>(a=2.5, b=1.5) at pick.smith:4");
    scratch::expect_contains("dbg lists the generic's own source", out, "typeof(a) result = a > b ? a : b;");
    scratch::expect_contains("dbg shows the parameter's type as written", out, "(i32) a = 3");
    scratch::expect_lacks("dbg shows no compiler-made file or warning for an instance (a checksum mismatch)", out,
                          "checksum mismatch");
    scratch::expect_lacks("dbg shows no compiler-made file or warning for an instance (the copy of the tokens)", out,
                          "smith-instance");
}

// The argument list and `for constexpr`: the loop is written out turn by turn, and each argument is the variable
// `rest_<index>`; the steps are at the lines of the generic's own source.
export void test_macos_dap_dbg_an_argument_list_and_for_constexpr() {
    scratch::Project root = scratch::make("dap", "dap");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&memory, &root) || !has_hook(&root)) {
        return;
    }
    scratch::Project p = folder(&memory, &root, "lists");
    scratch::Run built = scratch::sh(&p, "smith cc -g -O0 lmain.smith gather.smith -o lists");
    scratch::expect_status("the argument list program builds", 0, &built);
    const char *out =
        dbg(&memory, &p, "-o 'br set -r sum_with_marker' -o run -o next -o next -o 'frame variable' -o c lists").out;
    scratch::expect_contains("dbg steps a for constexpr at the generic's own lines", out, "total += (i32)rest[i];");
    scratch::expect_contains("dbg names the argument list's elements", out, "(int) rest_1 = 2");
    scratch::expect_contains("dbg names the first argument", out, "(int) rest_0 = 1");
}

// A run-time array `T xs[:]` (issue #106) is shown as its elements with its count and the type as written, by dbg and
// by the variables request of dap, not as a pointer and a count array. The formatters are lldb's own C++ ones.
constexpr char build_slice[_] = "smith cc -g -O0 -c main.smith -o main.o && smith cc -g main.o -o slice";

export void test_macos_dap_dbg_a_slice() {
    scratch::Project root = scratch::make("dap", "dap");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&memory, &root) || !has_hook(&root)) {
        return;
    }
    scratch::Project p = folder(&memory, &root, "slice");
    scratch::Run built = scratch::sh(&p, build_slice);
    scratch::expect_status("the slice program builds", 0, &built);
    const char *out =
        dbg(&memory, &p, "-o 'b main.smith:6' -o run -o 'frame variable xs name' -o 'frame variable xs[2]' slice").out;
    scratch::expect_contains("dbg shows a slice with its type as written and its count", out,
                             "(i32[:]) xs = count=3 {");
    scratch::expect_contains("dbg shows a slice's elements", out, "[2] = 6");
    scratch::expect_contains("dbg shows a char slice as text", out, "(char[:]) name = \"abc\" count=3");
    scratch::expect_contains("dbg indexes a slice", out, "(i32) xs[2] = 6");
}

export void test_macos_dap_a_slice_session() {
    scratch::Project root = scratch::make("dap", "dap");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&memory, &root) || !has_hook(&root)) {
        return;
    }
    scratch::Project p = folder(&memory, &root, "slice");
    scratch::Run built = scratch::sh(&p, build_slice);
    scratch::expect_status("the slice program builds", 0, &built);
    scratch::Run session = scratch::sh(&p, "../dap_client \"$(command -v smith)\" \"$PWD/slice\" \"$PWD/main.smith\" 6 "
                                           "xs count=3 2>&1");
    scratch::expect_status("dap: a slice session", 0, &session);
    scratch::expect_contains("dap shows a slice's count as its value and its elements as indexed children", session.out,
                             "\"evaluateName\":\"xs\",\"indexedVariables\":3");
}

// Many dimensions and the qualifier tags (issue #106): rows are children of children with the fixed sizes and every
// count, and the tags of `restrict` and `const` slices (written by hand here: their lowering is the compiler's) show
// their elements and the type as the language writes it.
export void test_macos_dap_dbg_many_dimensions_and_qualifier_tags() {
    scratch::Project root = scratch::make("dap", "dap");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&memory, &root) || !has_hook(&root)) {
        return;
    }
    scratch::Project p = folder(&memory, &root, "slices2");
    scratch::Run built = scratch::sh(&p, "smith cc -g -O0 -c main.smith -o main.o && smith cc -g main.o -o slices2");
    scratch::expect_status("the many-dimension slice program builds", 0, &built);
    const char *out = dbg(&memory, &p,
                          "-o 'b main.smith:11' -o run -o 'frame variable rows grid r c' -o 'frame variable "
                          "rows[1][0]' slices2")
                          .out;
    scratch::expect_contains("dbg shows f32[:][2] with its counts", out, "(f32[:][2]) rows = count=3x2 {");
    scratch::expect_contains("dbg shows the rows of a slice as children of children", out, "[2] = ([0] = 5, [1] = 6)");
    scratch::expect_contains("dbg shows f32[:][:] with its counts", out, "(f32[:][:]) grid = count=3x2 {");
    scratch::expect_contains("dbg indexes a row's element", out, "(float) rows[1][0] = 3");
    scratch::expect_contains("dbg shows a restrict slice as u8[restrict :]", out, "(u8[restrict :]) r = ");
    scratch::expect_contains("dbg shows a restrict slice's elements", out, "[3] = '\\n'");
    scratch::expect_contains("dbg shows a const slice as text with its written type", out,
                             "(const char[const :]) c = \"hey\" count=3");
}

// The io form of main (`i32 main` taking io's value) is the function `smith_user_main` to the compiler and `main` to
// the debugger, with a module line or without (the DWARF name; no debugger process runs).
static void check_io_main(const char *file) {
    scratch::Project root = scratch::make("dap", "dap");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&memory, &root) || !has_hook(&root)) {
        return;
    }
    if (scratch::sh(&root, "command -v dwarfdump >/dev/null").status != 0) {
        return;
    }
    scratch::Project p = folder(&memory, &root, "iomain");
    scratch::Run built = scratch::sh(
        &p, format::push(&memory, "smith cc -g -O0 -I \"$SMITH_REPO/.smith/include\" -c ", file, " -o o.o").data);
    scratch::expect_status("the io-form main builds", 0, &built);
    const char *names = scratch::capture(
        &p, "dwarfdump --debug-info o.o 2>/dev/null | grep -A1 'DW_AT_linkage_name.*smith_user_main' | tail -n 1");
    scratch::expect_contains(format::push(&memory, "the io-form main of ", file, " is main to the debugger").data,
                             names, "DW_AT_name\t(\"main\")");
}

export void test_macos_dap_the_io_main_without_a_module_line_is_main() {
    check_io_main("plain/a.smith");
}

export void test_macos_dap_the_io_main_with_a_module_line_is_main() {
    check_io_main("main.smith");
}
