// Tests of the fix-it for the operators written as words (D19, #2648): `&&` is `and`, `||` is `or`, `!x` is `not x`.
module front_fix_words_test;

import front::fix_words;
import front::parse as core;
import std::arena;
import std::format;
import std::mem;
import std::test;

static Str as_str(char chars[:]) {
    return chars;
}

static Str applied(Str source) {
    core::Errors found = fix_words::edits(source);
    Str text = source;
    for (Usize k = countof(found); k > 0; k--) {
        core::Edit edit = found[k - 1].fix[0];
        Str before = text[0:edit.span.start];
        Str after = text[edit.span.end:countof(text)];
        text = as_str(format::push(before, edit.text, after));
    }
    return text;
}

static void expect(Str before, Str want) {
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    test::check_equal(applied(before), want);
}

export void test_front_fix_words_and_or_and_not_replace_the_symbols() {
    expect("    return a && b || !c\n", "    return a and b or not c\n");
}

export void test_front_fix_words_not_equal_stays() {
    expect("    return a != b && c\n", "    return a != b and c\n");
}

export void test_front_fix_words_text_of_a_string_a_char_and_a_comment_stays() {
    expect("    f(\"a && b\", '!', x) // a || b\n", "    f(\"a && b\", '!', x) // a || b\n");
}

export void test_front_fix_words_a_not_before_an_operator_stays() {
    expect("    return !a == b && !f(x)\n", "    return !a == b and not f(x)\n");
}

export void test_front_fix_words_no_blanks_get_them() {
    expect("    return a&&b\n", "    return a and b\n");
}
