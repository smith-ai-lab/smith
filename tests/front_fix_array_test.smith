// Tests of the fixer's arrays with no length written (#2092, piece of #2053): `T xs[_] = {a, b};` is
// `xs: [2]T = [a, b]`, the count of the elements standing in for the `_` that smith has no spelling for.
module front_fix_array_test;

import front::fix;
import std::arena;
import std::mem;
import std::test;

static void expect(Str before, Str after) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed result = fix::fix_text("t.smith", before);
    test::check_equal(result.text, after);
    fix::Fixed again = fix::fix_text("t.smith", result.text);
    test::check_equal(again.text, after);
    test::check_equal(again.applied, (Usize)0);
}

export void test_front_fix_array_a_list_gives_the_length() {
    expect("void f(void) {\n    I32 xs[_] = {1, 2, 3};\n}\n", "fn f():\n    xs: [3]i32 = [1, 2, 3]\n");
}

export void test_front_fix_array_an_array_of_pointers_to_text() {
    expect("void f(void) {\n    const char *const argv[_] = {\"build\", \"--fast\"};\n}\n",
           "fn f():\n    argv: [2]*char = [\"build\", \"--fast\"]\n");
}

export void test_front_fix_array_a_trailing_comma_is_not_an_element() {
    expect("void f(void) {\n    I32 xs[_] = {1, 2,};\n}\n", "fn f():\n    xs: [2]i32 = [1, 2,]\n");
}

// A static or file-level array C zeroes, and `T xs[3] = {}`, are written with their zero values (#1901).
export void test_front_fix_array_a_static_array_is_zero_filled() {
    expect("static Bool seen[3];\n", "static mut seen: [3]bool = [false, false, false]\n");
}

export void test_front_fix_array_an_empty_list_is_zero_filled() {
    expect("void f(void) {\n    I32 xs[2] = {};\n}\n", "fn f():\n    mut xs: [2]i32 = [0, 0]\n");
}

// A text buffer C zeroes is written with its zero values; a prototype before its definition goes (#1901).
export void test_front_fix_array_a_char_buffer_is_zero_filled() {
    expect("void f(void) {\n    char name[4] = {};\n}\n", "fn f():\n    mut name: [4]char = [0, 0, 0, 0]\n");
}

export void test_front_fix_array_a_prototype_before_its_definition_goes() {
    expect("const char *name(I32 x);\nconst char *name(I32 x) {\n    return nullptr;\n}\n",
           "fn name(x: i32) -> *char:\n    return nullptr\n");
}

// An array parameter with no length is C's pointer: `I32 xs[]` is `xs: []i32` (#2649).
export void test_front_fix_array_an_unsized_array_parameter_is_a_slice() {
    expect("I32 sum(I32 xs[], Usize count) {\n    return xs[0] + (I32)count;\n}\n",
           "fn sum(xs: []i32, count: usize) -> i32:\n    return xs[0] + count.to(i32)\n");
}

// A switch arm written on one line loses its `;` with its `break` (#2649).
export void test_front_fix_array_a_one_line_switch_arm_has_no_semicolon() {
    expect("void f(Result r, I32 x) {\n    switch (r.kind) {\n    case .ok: x = 1; break;\n    case .err: x = 2; "
           "break;\n    }\n}\n",
           "fn f(r: Result, mut x: i32):\n    match r.kind:\n        .ok: x = 1\n        .err: x = 2\n        _: ()\n");
}

// A local `constexpr Type` with a lower-case name is `const n = T` (#2649).
export void test_front_fix_array_a_local_constexpr_type_is_a_const() {
    expect("void f(void) {\n    constexpr Type one = slice_of(I32);\n}\n", "fn f():\n    const one = slice_of(i32)\n");
}

// A cast to a built-in type before a dereference is a conversion of the pointee, also as an argument (#2649).
export void test_front_fix_array_a_cast_of_a_dereference_in_an_argument() {
    expect("void f(U64 *n) {\n    g((unsigned long long)*n, 1);\n}\n", "fn f(n: *u64):\n    g(n.*.to(u64), 1)\n");
}
