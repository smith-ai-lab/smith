// The checks `smith prove` proved can never fail are left out of an optimized build (issue #221): the proof file
// `.smith/proved/<source>.pts` (shim/proved.hpp), keyed by the source's text and the proving smith, is read by the
// lowering of a release build and is an input of its compile; the debug build keeps every check (under a name that is
// no failure point), and so does an edited source or a source nothing proved. The report of a compile is
// `SMITH_PROVED_REPORT=1`.
module prove_checks_test;

import smith::arena;
import smith::format;
import smith::mem;
import smith::test;
import scratch;

constexpr char edges[_] = "module edges;\n"
                          "\n"
                          "import smith::contract;\n"
                          "\n"
                          "export i32 first(const i32 xs[:]) {\n"
                          "    contract::requires(countof(xs) >= 1);\n"
                          "    contract::ensures(true);\n"
                          "    return xs[0];\n"
                          "}\n"
                          "\n"
                          "export i32 loose(const i32 xs[:], usize i) {\n"
                          "    contract::requires(i < countof(xs));\n"
                          "    contract::ensures(true);\n"
                          "    return xs[i];\n"
                          "}\n"
                          "\n"
                          "export i32 kept(const i32 xs[:], usize i) {\n"
                          "    return xs[i];\n"
                          "}\n";

constexpr char main_source[_] = "module main;\n"
                                "\n"
                                "import edges;\n"
                                "\n"
                                "i32 main() {\n"
                                "    i32 xs[3] = {1, 2, 3};\n"
                                "    i32 all[:] = xs;\n"
                                "    return edges::first(all) + edges::loose(all, 1) + edges::kept(all, 2) - 6;\n"
                                "}\n";

static void fresh(const scratch::Project *p) {
    scratch::write(p, "edges.smith", edges);
    scratch::write(p, "main.smith", main_source);
    scratch::Run built = scratch::build(p, "");
    scratch::expect_status("the project builds", 0, &built);
}

// What compiling edges.smith says about its checks; `flags` says debug (-O0) or optimized (-O2).
static const char *report(const scratch::Project *p, const char *flags) {
    char command[512];
    format::Written written = format::to(command, sizeof command, "SMITH_PROVED_REPORT=1 smith cc -c edges.smith ",
                                         flags, " -I .smith/include -o edges.o 2>&1");
    test::check_condition(written.fits);
    return scratch::sh(p, command).out;
}

export void test_prove_checks_nothing_is_left_out_before_a_proof() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fresh(&p);
    scratch::expect_contains("no proof file: every check stays", report(&p, "-O2"), "0 removed (proved), 5 kept");
}

export void test_prove_checks_a_proved_check_is_left_out_of_an_optimized_build_only() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fresh(&p);
    scratch::Run run = scratch::sh(&p, "smith prove 2>&1");
    scratch::expect_status("`kept` has a check it cannot prove, so the run fails", 1, &run);
    scratch::expect_contains("the proof file is written", scratch::read(&p, ".smith/proved/edges.smith.pts"),
                             "smith-proved ");
    scratch::expect_contains("the proved checks (two indexes, two ensures) are gone, the unproved index stays",
                             report(&p, "-O2"), "4 removed (proved), 1 kept");
    scratch::expect_contains("debug keeps every check", report(&p, "-O0"), "0 removed (proved), 5 kept");
}

export void test_prove_checks_an_edit_puts_the_checks_back_until_it_is_proved_again() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fresh(&p);
    scratch::sh(&p, "smith prove 2>&1");
    scratch::expect_contains("proved", report(&p, "-O2"), "4 removed (proved), 1 kept");
    scratch::write(&p, "edges.smith",
                   "// edited\n"
                   "module edges;\n"
                   "import smith::contract;\n"
                   "export i32 first(const i32 xs[:]) {\n"
                   "    contract::requires(countof(xs) >= 1);\n"
                   "    contract::ensures(true);\n"
                   "    return xs[0];\n"
                   "}\n"
                   "export i32 loose(const i32 xs[:], usize i) {\n"
                   "    contract::requires(i < countof(xs));\n"
                   "    contract::ensures(true);\n"
                   "    return xs[i];\n"
                   "}\n"
                   "export i32 kept(const i32 xs[:], usize i) {\n"
                   "    return xs[i];\n"
                   "}\n");
    scratch::expect_contains("edited: every check is back", report(&p, "-O2"), "0 removed (proved), 5 kept");
    scratch::sh(&p, "smith prove 2>&1");
    scratch::expect_contains("proved again", report(&p, "-O2"), "4 removed (proved), 1 kept");
}

export void test_prove_checks_the_proof_file_is_an_input_of_the_compile_in_a_release_build() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fresh(&p);
    scratch::Run before = scratch::build(&p, "release");
    scratch::expect_status("release builds", 0, &before);
    scratch::Run first_debug = scratch::build(&p, "");
    scratch::expect_status("so does debug", 0, &first_debug);
    scratch::expect_lacks("no proof file, no input", scratch::read(&p, ".smith/build.ninja"), "edges.smith.pts");
    scratch::sh(&p, "smith prove 2>&1");
    scratch::Run after = scratch::build(&p, "release -v");
    scratch::expect_status("release builds after a proof", 0, &after);
    scratch::expect_contains("the proof file is an input of edges' compile", scratch::read(&p, ".smith/build.ninja"),
                             ".smith/proved/edges.smith.pts");
    scratch::expect_contains("and the compile ran again", after.out, "-o build/release/edges.o");
    scratch::Run debug = scratch::build(&p, "-v");
    scratch::expect_contains("a debug build reads it too (the verdict of `fails` is the same)", debug.out,
                             "-o build/debug/edges.o");
}

// A proof assumes what a callee in another file promises: `user::at`'s check passes because `bounds::pick` ensures
// `r < 3`. The proof file's key covers that file, so changing the promise puts the check back (issue #221).
constexpr char bounds_source[_] = "module bounds;\n"
                                  "\n"
                                  "import smith::contract;\n"
                                  "\n"
                                  "export usize pick(usize n) {\n"
                                  "    contract::requires(n < 3);\n"
                                  "    usize r = n;\n"
                                  "    contract::ensures(r < 3);\n"
                                  "    return r;\n"
                                  "}\n";

constexpr char bounds_loose[_] = "module bounds;\n"
                                 "\n"
                                 "import smith::contract;\n"
                                 "\n"
                                 "export usize pick(usize n) {\n"
                                 "    contract::requires(n < 3);\n"
                                 "    usize r = n;\n"
                                 "    contract::ensures(r < 5);\n"
                                 "    return r;\n"
                                 "}\n";

constexpr char user_source[_] = "module user;\n"
                                "\n"
                                "import bounds;\n"
                                "import smith::contract;\n"
                                "\n"
                                "export i32 at(const i32 xs[:]) {\n"
                                "    contract::requires(countof(xs) == 3);\n"
                                "    contract::ensures(true);\n"
                                "    return xs[bounds::pick(1)];\n"
                                "}\n";

constexpr char user_main[_] = "module main;\n"
                              "\n"
                              "import user;\n"
                              "\n"
                              "i32 main() {\n"
                              "    i32 xs[3] = {1, 2, 3};\n"
                              "    i32 all[:] = xs;\n"
                              "    return user::at(all) - 2;\n"
                              "}\n";

static void across_files(const scratch::Project *p) {
    scratch::write(p, "bounds.smith", bounds_source);
    scratch::write(p, "user.smith", user_source);
    scratch::write(p, "main.smith", user_main);
    scratch::Run built = scratch::build(p, "");
    scratch::expect_status("the project builds", 0, &built);
}

static const char *report_of(const scratch::Project *p, const char *source) {
    char command[512];
    format::Written written = format::to(command, sizeof command, "SMITH_PROVED_REPORT=1 smith cc -c ", source,
                                         " -O2 -I .smith/include -o x.o 2>&1");
    test::check_condition(written.fits);
    return scratch::sh(p, command).out;
}

export void test_prove_checks_a_changed_callee_contract_puts_the_caller_checks_back() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    across_files(&p);
    scratch::Run run = scratch::sh(&p, "smith prove 2>&1");
    scratch::expect_status("both functions are proved", 0, &run);
    scratch::expect_contains("the proof names the callee's file", scratch::read(&p, ".smith/proved/user.smith.pts"),
                             "dep bounds.smith");
    scratch::expect_contains("proved: the check of the index is gone", report_of(&p, "user.smith"),
                             "2 removed (proved), 0 kept");
    scratch::write(&p, "bounds.smith", bounds_loose);
    scratch::expect_contains("the callee's promise changed, user.smith did not: the check is back",
                             report_of(&p, "user.smith"), "0 removed (proved), 2 kept");
}

export void test_prove_checks_a_changed_callee_compiles_the_caller_again() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    across_files(&p);
    scratch::sh(&p, "smith prove 2>&1");
    scratch::Run first = scratch::build(&p, "release -v");
    scratch::expect_status("release builds after a proof", 0, &first);
    scratch::expect_contains("the callee's file is an input of the caller's compile",
                             scratch::read(&p, ".smith/build.ninja"), "bounds.smith");
    scratch::write(&p, "bounds.smith", bounds_loose);
    scratch::Run second = scratch::build(&p, "release -v");
    scratch::expect_status("release builds after the callee changed", 0, &second);
    scratch::expect_contains("the caller compiled again", second.out, "-o build/release/user.o");
}

// The run-time checks of contracts are left out the same way (issue #325): a proved `assert`, `ensures` and
// `invariant` is replaced by `smith_proved`, which checks nothing, so a function whose only failure point was one does
// not `fail`; a `requires` is never left out, and an assert the prover cannot prove stays.
constexpr char contracts_source[_] = "module contracts;\n"
                                     "\n"
                                     "import smith::contract;\n"
                                     "\n"
                                     "export i32 sure(i32 x) {\n"
                                     "    contract::requires(x < 10);\n"
                                     "    contract::assert(x < 20);\n"
                                     "    return x;\n"
                                     "}\n"
                                     "\n"
                                     "export i32 count(void) {\n"
                                     "    i32 total = 0;\n"
                                     "    for (i32 i = 0; i < 4; i++) {\n"
                                     "        contract::invariant(i < 4);\n"
                                     "        total += i;\n"
                                     "    }\n"
                                     "    contract::ensures(total == 6);\n"
                                     "    return total;\n"
                                     "}\n"
                                     "\n"
                                     "export i32 unsure(i32 x) {\n"
                                     "    contract::assert(x < 20);\n"
                                     "    return x;\n"
                                     "}\n";

constexpr char contracts_main[_] = "module main;\n"
                                   "\n"
                                   "import contracts;\n"
                                   "\n"
                                   "i32 main() {\n"
                                   "    return contracts::sure(3) + contracts::count() + contracts::unsure(1) - 10;\n"
                                   "}\n";

static void with_contracts(const scratch::Project *p) {
    scratch::write(p, "contracts.smith", contracts_source);
    scratch::write(p, "main.smith", contracts_main);
    scratch::Run built = scratch::build(p, "");
    scratch::expect_status("the project builds", 0, &built);
}

export void test_prove_checks_a_proved_contract_check_is_left_out_of_an_optimized_build_only() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    with_contracts(&p);
    scratch::expect_contains("no proof: every check stays", report_of(&p, "contracts.smith"),
                             "0 removed (proved), 4 kept");
    scratch::Run run = scratch::sh(&p, "smith prove 2>&1");
    scratch::expect_status("`unsure`'s assert cannot be proved", 1, &run);
    scratch::expect_contains(
        "the assert of `sure`, the invariant and the ensures of `count` are gone, `unsure`'s stays",
        report_of(&p, "contracts.smith"), "3 removed (proved), 1 kept");
    scratch::Run debug =
        scratch::sh(&p, "SMITH_PROVED_REPORT=1 smith cc -c contracts.smith -O0 -I .smith/include -o x.o 2>&1");
    scratch::expect_contains("debug keeps every check", debug.out, "0 removed (proved), 4 kept");
}

export void test_prove_checks_an_edited_source_keeps_its_contract_checks() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    with_contracts(&p);
    scratch::sh(&p, "smith prove 2>&1");
    scratch::write(&p, "contracts.smith", format::push("// edited\n", contracts_source).data);
    scratch::expect_contains("stale: every check is back", report_of(&p, "contracts.smith"),
                             "0 removed (proved), 4 kept");
}

// The arithmetic checks (issue #1101, of #351) are recorded like an index: the lines of an addition, a division, a
// remainder, a shift and a float to int conversion that a proved function can never trip are in the proof file, and the
// same operations in a function that cannot prove them are not (`bare` fails, so its check stays).
constexpr char arithmetic_source[_] = "module arith;\n"
                                      "\n"
                                      "import smith::contract;\n"
                                      "\n"
                                      "export i32 sum(i32 x) {\n"
                                      "    contract::requires(x > 0 && x < 100);\n"
                                      "    contract::ensures(true);\n"
                                      "    return x + 1;\n"
                                      "}\n"
                                      "\n"
                                      "export i32 bare(i32 x) {\n"
                                      "    contract::ensures(true);\n"
                                      "    return x + 1;\n"
                                      "}\n"
                                      "\n"
                                      "export i32 quotient(i32 x, i32 y) {\n"
                                      "    contract::requires(y > 0);\n"
                                      "    contract::ensures(true);\n"
                                      "    return x / y;\n"
                                      "}\n"
                                      "\n"
                                      "export i32 remainder(i32 x, i32 y) {\n"
                                      "    contract::requires(y > 0);\n"
                                      "    contract::ensures(true);\n"
                                      "    return x % y;\n"
                                      "}\n"
                                      "\n"
                                      "export i32 shifted(i32 x) {\n"
                                      "    contract::requires(x >= 0 && x < 100);\n"
                                      "    contract::ensures(true);\n"
                                      "    return x << 2;\n"
                                      "}\n"
                                      "\n"
                                      "export i32 narrow(f32 x) {\n"
                                      "    contract::requires(x > 0.0f && x < 100.0f);\n"
                                      "    contract::ensures(true);\n"
                                      "    return (i32)x;\n"
                                      "}\n";

constexpr char arithmetic_main[_] =
    "module main;\n"
    "\n"
    "import arith;\n"
    "\n"
    "i32 main() {\n"
    "    return arith::sum(1) + arith::bare(1) + arith::quotient(4, 2) + arith::remainder(5, 2) +\n"
    "           arith::shifted(1) + arith::narrow(2.0f) - 15;\n"
    "}\n";

export void test_prove_checks_arithmetic_checks_are_recorded_when_proved() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write(&p, "arith.smith", arithmetic_source);
    scratch::write(&p, "main.smith", arithmetic_main);
    scratch::Run built = scratch::build(&p, "");
    scratch::expect_status("the project builds", 0, &built);
    scratch::Run run = scratch::sh(&p, "smith prove -v 2>&1");
    scratch::expect_status("`bare` cannot prove its addition, so the run fails", 1, &run);
    const char *pts = scratch::read(&p, ".smith/proved/arith.smith.pts");
    scratch::expect_contains("the proved addition", pts, "\n8\n");
    scratch::expect_lacks("the unproved addition stays a check", pts, "\n13\n");
    scratch::expect_contains("the division", pts, "\n19\n");
    scratch::expect_contains("the remainder", pts, "\n25\n");
    scratch::expect_contains("the shift", pts, "\n31\n");
    scratch::expect_contains("the float to int conversion", pts, "\n37\n");
    scratch::expect_contains("-v counts them", run.out,
                             "arithmetic checks (overflow, shift, division, float to int): 5 proved, 1 remain");
}
