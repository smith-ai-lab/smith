// Tests of run-time arrays of one dimension (issue #82), in smith's own test library: a slice declared, indexed, sliced
// and passed on. The cases of the compiler's side (the lowering, the errors, the headers) are in
// tests/smith-lang/cases/slice-*.
module slice_test;

import <string.h>;
import smith::test;

struct Bag {
    i32 items[:];
    char name[:];
};

static i32 sum(i32 xs[:]) {
    i32 total = 0;
    for (usize i = 0; i < countof(xs); i++) {
        total += xs[i];
    }
    return total;
}

static typeof(i32[:]) inner(i32 xs[:]) {
    return xs[1:countof(xs) - 1];
}

static typeof(i32[:]) fixed(void) {
    static i32 data[3] = {7, 8, 9};
    return data;
}

export void test_slice_a_fixed_array_converts_with_its_size(void) {
    i32 raw[5] = {1, 2, 3, 4, 5};
    i32 all[:] = raw;
    test::check_equal(countof(all), 5);
    test::check_equal(sum(all), 15);
    test::check_equal(sum(raw), 15);
}

export void test_slice_a_view_shares_the_elements(void) {
    i32 raw[5] = {1, 2, 3, 4, 5};
    i32 all[:] = raw;
    i32 mid[:] = all[1:4];
    test::check_equal(countof(mid), 3);
    mid[0] = 40;
    test::check_equal(raw[1], 40);
    test::check_equal(countof(all[:2]), 2);
    test::check_equal(countof(all[3:]), 2);
    test::check_equal(all[3:][0], 4);
}

export void test_slice_a_pointer_is_sliced_into_one(void) {
    i32 raw[4] = {1, 2, 3, 4};
    i32 *p = raw;
    i32 view[:] = p[1:3];
    test::check_equal(countof(view), 2);
    test::check_equal(view[0], 2);
    test::check_equal(sum(p[0:4]), 10);
}

export void test_slice_an_empty_slice_has_a_null_pointer(void) {
    i32 *none = nullptr;
    i32 empty[:] = none[0:0];
    test::check_equal(countof(empty), 0);
    test::check_equal(sum(empty), 0);
}

export void test_slice_a_text_literal_has_no_terminating_zero(void) {
    char word[:] = "abc";
    test::check_equal(countof(word), 3);
    char with_zero[] = "abc";
    char again[:] = with_zero;
    test::check_equal(countof(again), 4);
}

export void test_slice_results_fields_and_nested_chains(void) {
    i32 raw[4] = {1, 2, 3, 4};
    struct Bag bag = {};
    bag.items = raw;
    bag.name = "bag";
    bag.items[2] += 10;
    test::check_equal(raw[2], 13);
    test::check_equal(countof(bag.name), 3);
    test::check_equal(sum(inner(bag.items)), 15);
    test::check_equal(countof(fixed()), 3);
    test::check_equal(fixed()[2], 9);
}

export void test_slice_a_slice_passes_to_c_as_a_pointer(void) {
    char word[:] = "hello";
    test::check_equal(c::strncmp(word, "hello", countof(word)), 0);
    test::check_equal(c::strncmp(word, "help!", countof(word)) > 0, false);
}

export void test_slice_an_index_past_the_end_stops(void) {
    i32 raw[3] = {1, 2, 3};
    i32 all[:] = raw;
    usize far = 3;
    test::expect_abort();
    (void)all[far];
}

export void test_slice_a_view_past_the_end_stops(void) {
    i32 raw[3] = {1, 2, 3};
    i32 all[:] = raw;
    usize far = 4;
    test::expect_abort();
    i32 view[:] = all[1:far];
    (void)view;
}

export void test_slice_a_view_that_ends_before_it_begins_stops(void) {
    i32 raw[3] = {1, 2, 3};
    i32 all[:] = raw;
    usize low = 2;
    test::expect_abort();
    i32 view[:] = all[low:1];
    (void)view;
}

static i32 calls = 0;
static i32 backing[4] = {10, 20, 30, 40};

static typeof(i32[:]) counted(void) {
    calls += 1;
    return backing;
}

static i32 *counted_pointer(void) {
    calls += 1;
    return backing;
}

export void test_slice_the_array_of_an_index_is_evaluated_once(void) {
    calls = 0;
    i32 second = counted()[1];
    test::check_equal(second, 20);
    test::check_equal(calls, 1);
    counted()[2] = 33;
    test::check_equal(calls, 2);
    test::check_equal(backing[2], 33);
    backing[2] = 30; // the other tests may run in this process
}

export void test_slice_the_array_of_a_slice_is_evaluated_once(void) {
    calls = 0;
    i32 middle[:] = counted()[1:3];
    test::check_equal(countof(middle), 2);
    test::check_equal(calls, 1);
    i32 view[:] = counted_pointer()[0:2];
    test::check_equal(countof(view), 2);
    test::check_equal(calls, 2);
    i32 nested = counted()[1:4][1];
    test::check_equal(nested, 30);
    test::check_equal(calls, 3);
}

export void test_slice_a_braceless_loop_body_may_call_a_generic(void) {
    i32 raw[3] = {4, 5, 6};
    i32 all[:] = raw;
    for (usize i = 0; i < countof(all); i++)
        test::check_equal(all[i], raw[i]); // the loop head's `(` is no operand, so its body is not read ahead
}
