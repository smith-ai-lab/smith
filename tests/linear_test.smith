// `[[std::linear]]` (shim/linear.cpp; skill smith-lang-linear): a value of a linear type is used exactly once on every
// path, a compile error at the second use naming the first and at a way out (`return`, `break`, `continue`, `try`, the
// end of a block) that leaves it unused. Each tests/linear/*.c and *.smith is compiled with `smith cc -c` and what it
// prints (the status, then each error and note, the path left off) is the golden file beside it, `<file>.expected`: the
// rules (a second use, a missing use at each exit, `defer`, `&key`, a join, an assignment over an unused value, an
// element of an array, a member, a tuple, a slice moved to a call or borrowed through a `const` parameter, the plain
// loop, any other loop or index) and the issue's use cases, in C and in `.smith` (the slices and tuples are `.smith`
// only). The editor's case: `smith lsp --check` of one C and one `.smith`
// file shows the error. The enum_* files are the narrowing of a payload enum (#198): a read of `x.circle` is an error
// unless every path tested `x == .circle` or switched on x; an assignment, `&x` or a call with the pointer ends it;
// plain C is left alone. A file added to tests/linear needs a test here: `test_every_file_has_a_test` says which.
module linear_test;

import smith::format;
import smith::io;
import smith::test;
import <string.h>;
import scratch;

static typeof(const char[:]) slice_of(const char *text) {
    return text[0:c::strlen(text)];
}

// What a compile of the file prints, as tests/linear/<file>.expected holds it.
static void linear_case(io::Io *io, const char *file) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    const char *command =
        format::push(&io->arena,
                     "cd \"$SMITH_REPO/tests/linear\" && { smith cc -std=gnu2y -I \"$SMITH_REPO/.smith/include\" -c ",
                     file,
                     " -o /dev/null >\"$TMPDIR/out\" 2>&1; echo \"status $?\"; grep -E '^[^ ]+:[0-9]+:[0-9]+: "
                     "(error|note|warning):' \"$TMPDIR/out\"; }")
            .data;
    scratch::Run run = scratch::sh(&p, command);
    test::golden(io, slice_of(format::push(&io->arena, "tests/linear/", file, ".expected").data), slice_of(run.out));
}

// The editor: clangd shows the error, for C and for `.smith`.
static void linear_editor(io::Io *io, const char *file, const char *message) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run run =
        scratch::sh(&p, format::push(&io->arena, "timeout -s KILL 120 smith lsp --check=\"$SMITH_REPO/tests/linear/",
                                     file, "\" 2>&1")
                            .data);
    scratch::expect_contains(file, run.out, message);
}

export void test_every_file_has_a_test(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run run = scratch::sh(&p, "cd \"$SMITH_REPO/tests/linear\" && for f in *.c *.smith; do grep -q "
                                       "\"linear_case(io, \\\"$f\\\")\" ../linear_test.smith || echo \"$f\"; done");
    scratch::expect_text("files of tests/linear with no test", "", run.out);
}

export void test_lsp_second_use_c(io::Io *io) {
    linear_editor(io, "linear_second_use.c", "smith-linear: 'key' is used again");
}

export void test_lsp_second_use_smith(io::Io *io) {
    linear_editor(io, "linear_second_use.smith", "smith-linear: 'key' is used again");
}

// The narrowing of a payload enum (#198) shows in the editor too, for C and for `.smith` (clangd hung on the latter
// until #227).
export void test_lsp_enum_tagged_c(io::Io *io) {
    linear_editor(io, "enum_tagged.c", "smith-enum: 's.circle' is read where");
}

export void test_lsp_enum_read_unchecked_smith(io::Io *io) {
    linear_editor(io, "enum_read_unchecked.smith", "smith-enum: 's.circle' is read where");
}

