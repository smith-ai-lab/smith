// The translation of a Makefile into a build.c (issue #44, runtime/make*.c) as a function, in process (issue #646): a
// folder with a Makefile in, the build.c text and the report of what was not translated out, through
// `smith_core_make_translate` (include/smith_core.h, smith.c compiled as a library by tests/units/build.c). No process
// starts but scratch::make's: the fixtures of tests/build_fixtures/make_NN are copied into a scratch folder, the files
// a case adds are written through std::files, and the text is checked for what it says. What needs a real make, a
// compiler or the verb (the translation built and compared with make's, lint and format of the result, which Makefile
// `smith build --dump-config` picks) is in tests/make_test.smith. The text here is the translation before `smith fmt`
// has laid it out.
module make_translate_test;

import std::arena;
import std::files;
import std::format;
import std::mem;
import std::test;
import scratch;
import <smith_core.h>;
import <string.h>;

constexpr Usize build_capacity = 1U << 20;
constexpr Usize report_capacity = 1U << 16;

typedef struct {
    const char *build;  // the build.c
    const char *report; // standard error of `smith build --dump-config`
} Translation;

// The pieces one after another, from the current allocator (the test's arena).
const char *concatenated(auto... pieces) {
    Usize length = format::length(pieces...);
    char *joined = mem::alloc_slice(char, length + 1).data;
    (void)format::to(joined, length + 1, pieces...);
    return joined;
}

static const char *join(const char *folder, const char *name) {
    return concatenated(folder, "/", name);
}

static void copy_file(const char *from, const char *to) {
    files::BytesResult file = files::read_file(from[0:c::strlen(from)]);
    test::check_condition(file == .ok);
    if (file == .ok) {
        files::CountResult written = files::write_file(to[0:c::strlen(to)], file.ok, files::Replace);
        test::check_condition(written == .ok);
    }
}

// A project in a scratch folder (scratch::make, which `clean` removes): the files of tests/build_fixtures/<fixture>
// (none when it is nullptr), and the folders in it with their files.
static scratch::Project project(const char *name, const char *fixture) {
    return scratch::make(name, fixture);
}

// A file of the project, in a folder made for it.
static void write(const char *folder, const char *name, const char *contents) {
    const char *path = join(folder, name);
    const char *slash = c::strrchr(path, '/');
    files::DoneResult made = files::make_folder(path[0:(Usize)(slash - path)]);
    test::check_condition(made == .ok);
    const U8 *bytes = (const U8 *)contents;
    files::CountResult written =
        files::write_file(path[0:c::strlen(path)], bytes[0:c::strlen(contents)], files::Replace);
    test::check_condition(written == .ok);
}

// `main.c`, which most Makefiles name and the translation looks for.
static void main_c(const char *folder) {
    write(folder, "main.c", "int main(void) { return 0; }\n");
}

static Translation translate(const char *folder) {
    char *build = mem::alloc_slice(char, build_capacity).data;
    char *report = mem::alloc_slice(char, report_capacity).data;
    bool done = c::smith_core_make_translate(folder, nullptr, build, build_capacity, report, report_capacity);
    test::check_equal(done, true);
    return (Translation){.build = build, .report = report};
}

static void has(const char *name, const Translation *t, const char *text) {
    scratch::expect_contains(name, t->build, text);
}

static void lacks(const char *name, const Translation *t, const char *text) {
    scratch::expect_lacks(name, t->build, text);
}

// The compile flags `-D<name>="<value>"` the translation writes, as GNU make computes the values (the table is what
// `make -n -B` printed for the fixture).
typedef struct {
    const char *name;
    const char *value;
} Define;

static void defines(const char *label, const Translation *t, const Define *table, Usize count) {
    for (Usize i = 0; i < count; i++) {
        const char *flag = concatenated("\"-D", table[i].name, "=\\\"", table[i].value, "\\\"\"");
        scratch::expect_contains(concatenated(label, ": ", table[i].name), t->build, flag);
    }
}

// 1. Variables: their flavors, expansion, += and ?=, substitution references, ${X}, override.
export void test_variables() {
    scratch::Project p = project("p", "make_01");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 23);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *folder = p.dir;
    main_c(folder);
    Translation t = translate(folder);
    has("variables: the flags of the compile are written out", &t, "\"-DR1=\\\"2\\\"\"");
    has("variables: a command-line variable is an option", &t, "smith_option_value(b, \"UNDEFINED_VARIABLE\"");
    has("variables: the option has the Makefile's line", &t, "Makefile:");
    const Define table[_] = {{"R1", "2"}, {"R2", "1"}, {"R7", "2y"}, {"R8", "2-1"}, {"R9", "j"}, {"R10", "changed"}};
    defines("variables: the value make computes", &t, table, countof(table));
}

// 2. The functions of the subset.
export void test_functions() {
    scratch::Project p = project("p", "make_02");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 23);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *folder = p.dir;
    main_c(folder);
    Translation t = translate(folder);
    scratch::expect_text("functions: no construct is reported", "", t.report);
    const Define table[_] = {
        {"R1", "a_b_c"},       {"R2", "4"},          {"R3", "x.o_y.o_z.h"}, {"R4", "x.c_z.h"},   {"R5", "y.o_z.h"},
        {"R6", "pre-a_pre-b"}, {"R7", "a.x_b.x"},    {"R8", "a/b_d"},       {"R9", "b.c_e.h"},   {"R10", "a/_./"},
        {"R11", ".c_.h"},      {"R12", "b-a-a-a_c"}, {"R13", "a1_b2"},      {"R14", "11_22_33"}, {"R15", "yes-no-z-b"},
        {"R16", "bx"},         {"R17", "b_A_c_A"},   {"R18", "main.c"},     {"R19", "a b-a;b"},  {"R20", "a_b_c"},
    };
    defines("functions: the value make computes", &t, table, countof(table));
}

// 3. Rules: explicit and pattern rules, order-only prerequisites, the automatic variables, a recipe that is not a
// compile.
export void test_rules() {
    scratch::Project p = project("p", "make_03");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 23);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *folder = p.dir;
    main_c(folder);
    write(folder, "a.in", "one\n");
    write(folder, "b.in", "two\n");
    Translation t = translate(folder);
    has("rules: a pattern rule's compile is a smith_object", &t, "smith_object(b, &object_1);");
    has("rules: a link is a smith_program", &t, "smith_program(b, &program_1);");
    has("rules: another recipe is a smith_step", &t, "smith_step(b, &step_");
    has("rules: each block says where it came from", &t, "// Makefile:");
}

// 4. Recipes: @ and -, line continuations, several lines.
export void test_recipes() {
