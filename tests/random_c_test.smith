// <smith/random.h> from C, from tests/random.sh (issue #292): the program tests/random.c (Philox known answers, the
// distributions and the digest of a large batch of draws) built in several configurations, the module compiled under a
// new project's warnings, the refusals (-ffast-math, a normal with deviation 0) and a project that gets random and the
// arena with smith_library (tests/build_fixtures/random_project). tests/random.c reaches the module's static functions
// by including its raw lowering, what `smith cc --smith-lower` writes. The behavior of the library is
// lib/smith/random_test.smith.
module random_c_test;

import smith::format;
import smith::io;
import smith::test;
import scratch;

// The same bits everywhere: the digest of a large batch of draws, which is part of the API, in every configuration.
constexpr char expected_digest[] = "0453abcbd4531af9";
constexpr char warn[] = "-Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wimplicit-fallthrough -Wmissing-prototypes "
                        "-Wstrict-prototypes -Wvla -Werror";
constexpr char sources[] = "-I lowered \"$SMITH_REPO/tests/random.c\" \"$SMITH_REPO/lib/smith/arena.smith\" "
                           "\"$SMITH_REPO/lib/smith/contract.smith\" \"$SMITH_REPO/lib/trace.c\"";

static scratch::Project lowered_project(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run lowered =
        scratch::sh(&p, "mkdir lowered && smith cc --smith-lower \"$SMITH_REPO/lib/smith/random.smith\" "
                        ">lowered/random_lowered.c");
    scratch::expect_status("the raw lowering of random.smith", 0, &lowered);
    return p;
}

// Builds tests/random.c with the flags into `name`.
static scratch::Run compile(const scratch::Project *p, const char *warnings, const char *flags, const char *name) {
    return scratch::sh(p, format::push(&p->io->arena, "smith cc ", warnings, " -I \"$SMITH_REPO/.smith/include\" ", flags, " ",
                                       sources, " -o ", name)
                              .data);
}

static void checks_pass(io::Io *io, const char *name, const char *flags) {
    scratch::Project p = lowered_project(io);
    scratch::Run built = compile(&p, format::push(&io->arena, "-std=gnu23 ", warn).data, flags, "checks");
    scratch::expect_status("the checks build", 0, &built);
    scratch::Run checked = scratch::sh(&p, "./checks");
    scratch::expect_status(name, 0, &checked);
    scratch::expect_text(name, "random: all checks passed", checked.out);
}

export void test_random_c_checks_pass_at_o0_under_asan_and_ubsan(io::Io *io) {
    checks_pass(io, "checks: pass at -O0 under ASan and UBSan", "-O0 -g -fsanitize=address,undefined");
}

export void test_random_c_checks_pass_at_o2(io::Io *io) {
    checks_pass(io, "checks: pass at -O2", "-O2");
}

static void compiles_as(io::Io *io, const char *standard) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run built = scratch::sh(&p, format::push(&io->arena, "smith cc -std=", standard, " ", warn,
                                                      " -I \"$SMITH_REPO/.smith/include\" -c "
                                                      "\"$SMITH_REPO/lib/smith/random.smith\" -o r.o")
                                             .data);
    scratch::expect_status(
        format::push(&io->arena, "library: compiles as -std=", standard, " with the new project's warnings").data, 0,
        &built);
}

export void test_random_c_library_compiles_as_c23(io::Io *io) {
    compiles_as(io, "gnu23");
}

export void test_random_c_library_compiles_as_c2y(io::Io *io) {
    compiles_as(io, "gnu2y");
}

// Every configuration prints the same digest.
static void digest(io::Io *io, const char *name, const char *flags) {
    scratch::Project p = lowered_project(io);
    scratch::Run built = compile(&p, "-w", flags, "digest");
    scratch::expect_status(format::push(&io->arena, "digest: ", name, " builds").data, 0, &built);
    scratch::Run run = scratch::sh(&p, "./digest digest");
    scratch::expect_text(format::push(&io->arena, "digest: ", name).data, expected_digest, run.out);
}

export void test_random_c_digest_o0_sanitized(io::Io *io) {
    digest(io, "-O0 sanitized", "-std=gnu23 -O0 -g -fsanitize=address,undefined");
}

export void test_random_c_digest_o2(io::Io *io) {
    digest(io, "-O2", "-std=gnu23 -O2");
}

export void test_random_c_digest_o2_ndebug(io::Io *io) {
    digest(io, "-O2 -DNDEBUG", "-std=gnu23 -O2 -DNDEBUG");
}

export void test_random_c_digest_o3_ndebug(io::Io *io) {
    digest(io, "-O3 -DNDEBUG", "-std=gnu23 -O3 -DNDEBUG");
}

export void test_random_c_digest_gnu2y(io::Io *io) {
    digest(io, "-std=gnu2y", "-std=gnu2y -O2");
}

export void test_random_c_digest_fp_contract_fast_which_the_pragma_defeats(io::Io *io) {
    digest(io, "-ffp-contract=fast, which the pragma defeats", "-std=gnu23 -O2 -ffp-contract=fast");
}

export void test_random_c_digest_o3_march_native_fp_contract_fast(io::Io *io) {
    digest(io, "-O3 -march=native -ffp-contract=fast", "-std=gnu23 -O3 -march=native -ffp-contract=fast");
}

export void test_random_c_refusal_ffast_math_fails_to_compile(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run built = scratch::sh(&p, "smith cc -std=gnu23 -I \"$SMITH_REPO/.smith/include\" -ffast-math -c "
                                         "\"$SMITH_REPO/lib/smith/random.smith\" -o r.o");
    scratch::expect_failure("refusal: -ffast-math fails to compile", &built);
    scratch::expect_contains("refusal: ... with the reason", built.err, "-ffast-math changes floating-point results");
}

export void test_random_c_refusal_ofast_fails_to_compile(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run built = scratch::sh(&p, "smith cc -std=gnu23 -I \"$SMITH_REPO/.smith/include\" -Ofast -c "
                                         "\"$SMITH_REPO/lib/smith/random.smith\" -o r.o");
    scratch::expect_failure("refusal: -Ofast fails to compile", &built);
}

export void test_random_c_refusal_a_normal_with_deviation_0_aborts(io::Io *io) {
    scratch::Project p = lowered_project(io);
    scratch::Run built = compile(&p, format::push(&io->arena, "-std=gnu23 ", warn).data, "-O2", "checks");
    scratch::expect_status("the checks build", 0, &built);
    scratch::Run run = scratch::sh(&p, "./checks assert");
    scratch::expect_status("refusal: a normal with deviation 0 aborts", 134, &run);
    scratch::expect_contains("refusal: ... a failed requires, as a contract fails", run.err,
                             "smith-trace begin requires failed");
    scratch::expect_contains("refusal: ... in the function that asked", run.err, "smith_normal_double_sample");
}

static scratch::Project built_project(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "random_project");
    scratch::Run built = scratch::build(&p, "");
    scratch::expect_status("project: the build succeeds", 0, &built);
    return p;
}

export void test_random_c_project_gets_random_and_the_arena_with_smith_library(io::Io *io) {
    scratch::Project p = built_project(io);
    scratch::expect_text("project: the header is written", "yes",
                         scratch::capture(&p, "[ -f .smith/include/smith/random.h ] && echo yes"));
    scratch::expect_text("project: the source is written", "yes",
                         scratch::capture(&p, "[ -f .smith/lib/smith/random.smith ] && echo yes"));
    scratch::Run run = scratch::sh(&p, "./build/app");
    scratch::expect_status("project: the program runs", 0, &run);
    scratch::expect_text("project: the program runs (it prints)", "mean 0.5, normal 1, index 1", run.out);
}

export void test_random_c_project_unchanged_library_is_not_rewritten(io::Io *io) {
    scratch::Project p = built_project(io);
    const char *stamp =
        "stat -f %m .smith/lib/smith/random.smith 2>/dev/null || stat -c %Y .smith/lib/smith/random.smith";
    const char *before = scratch::capture(&p, stamp);
    scratch::sleep(&p, 1100);
    scratch::Run again = scratch::build(&p, "");
    scratch::expect_status("the second build succeeds", 0, &again);
    scratch::expect_text("project: an unchanged library is not rewritten", before, scratch::capture(&p, stamp));
}

export void test_random_c_project_clangd_reports_no_errors_in_main(io::Io *io) {
    scratch::Project p = built_project(io);
    if (scratch::sh(&p, "smith lsp --version").status != 0) return;
    // The sample prints with printf; this tests the build flags the editor gets, not smith-effects.
    scratch::write(&p, ".clang-tidy", "Checks: \"-*\"\n");
    scratch::expect_text("project: clangd reports no errors in main.c", "0",
                         scratch::capture(&p, "smith lsp --check=main.c 2>&1 | grep -c 'E\\[' || true"));
}
