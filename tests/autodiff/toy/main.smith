// Reverse and forward mode derivatives of toy::f and toy::loss, printed next to the analytic values.
module main;

import smith::autodiff;
import smith::io;
import toy;
import <math.h>;

// autodiff::gradient against the analytic values and the raw call: the same Enzyme call, so equal to the bit.
i32 gradients(io::Console *console) {
    toy::Params p = {.w = {0.5, -1.5, 2.0}, .b = 0.3};
    toy::Batch batch = {.x = {1.0, 2.0, 3.0}, .scale = 1.5};
    toy::Params g = autodiff::gradient(toy::model, &p, &batch);
    toy::Params raw = {};
    autodiff::reverse((void *)toy::model, autodiff::dup, &p, &raw, autodiff::constant, &batch);
    i32 status = 0;
    for (usize i = 0; i < 3; i++) {
        (void)io::console_printf(console, "gradient model dw[%zu] %.12f %.12f\n", i, g.w[i],
                                 2.0 * batch.scale * batch.x[i] * p.w[i]);
        if (g.w[i] != raw.w[i]) {
            status = 1;
        }
    }
    (void)io::console_printf(console, "gradient model db %.12f %.12f\n", g.b, 1.0);
    if (g.b != raw.b) {
        status = 1;
    }
    toy::Params one = autodiff::gradient(toy::product, &p);
    (void)io::console_printf(console, "gradient product dw0 %.12f %.12f\n", one.w[0], p.w[1]);
    (void)io::console_printf(console, "gradient product dw1 %.12f %.12f\n", one.w[1], p.w[0]);
    toy::Params readonly = autodiff::gradient(toy::first_square, &p);
    (void)io::console_printf(console, "gradient first_square dw0 %.12f %.12f\n", readonly.w[0], 2.0 * p.w[0]);
    f64 s = 1.7;
    f64 cube = autodiff::gradient(toy::cube, &s);
    (void)io::console_printf(console, "gradient cube ds %.12f %.12f\n", cube, 3.0 * s * s);
    return status;
}

i32 main(io::Io *io) {
    f64 x = 1.7;
    f64 y = 0.4;
    f64 dx = autodiff::reverse((void *)toy::f, autodiff::out, x, autodiff::out, y);
    f64 tx = autodiff::forward((void *)toy::f, autodiff::dup, x, 1.0, autodiff::dup, y, 0.0);
    f64 ty = autodiff::forward((void *)toy::f, autodiff::dup, x, 0.0, autodiff::dup, y, 1.0);
    f64 p[3] = {0.5, -1.5, 2.0};
    f64 dp[3] = {};
    autodiff::reverse((void *)toy::loss, autodiff::dup, p, dp, autodiff::constant, (usize)3);
    f64 analytic_x = 2.0 * x * c::sin(y) + 3.0 * y;
    f64 analytic_y = x * x * c::cos(y) + 3.0 * x;
    (void)io::console_printf(&io->console, "reverse dx %.12f %.12f\n", dx, analytic_x);
    (void)io::console_printf(&io->console, "forward dx %.12f %.12f\n", tx, analytic_x);
    (void)io::console_printf(&io->console, "forward dy %.12f %.12f\n", ty, analytic_y);
    for (usize i = 0; i < 3; i++) {
        (void)io::console_printf(&io->console, "loss dp[%zu] %.12f %.12f\n", i, dp[i], 2.0 * (f64)(i + 1) * p[i]);
    }
    i32 status = gradients(&io->console);
    return status;
}
