// A test that differentiates too: the tests of an autodiff program are built the same way.
module toy_test;

import smith::arena;
import smith::autodiff;
import smith::mem;
import smith::test;
import toy;

export void test_loss_gradient() {
    f64 p[2] = {1.0, 3.0};
    f64 dp[2] = {};
    autodiff::reverse((void *)toy::loss, autodiff::dup, p, dp, autodiff::constant, (usize)2);
    test::check_near(dp[0], 2.0, 1e-12);
    test::check_near(dp[1], 12.0, 1e-12);
}

export void test_gradient() {
    toy::Params p = {.w = {1.0, 2.0, 3.0}, .b = 0.0};
    toy::Batch batch = {.x = {1.0, 1.0, 1.0}, .scale = 1.0};
    toy::Params g = autodiff::gradient(toy::model, &p, &batch);
    test::check_near(g.w[0], 2.0, 1e-12);
    test::check_near(g.w[1], 4.0, 1e-12);
    test::check_near(g.w[2], 6.0, 1e-12);
    test::check_near(g.b, 1.0, 1e-12);
}

struct Line {
    f64 w[:];
    f64 b;
};

f64 line_loss(struct Line *line, f64 x) {
    f64 sum = line->b;
    for (usize i = 0; i < countof(line->w); i++) sum += line->w[i] * x;
    return sum * sum;
}

// A gradient with a `[:]` field and zeros allocate through the current allocator and only through it: an arena is
// installed, and every block is inside it (the test runner's checked allocator, outside, saw none).
export void test_gradient_and_zeros_allocate_only_through_the_current_allocator() {
    arena::Arena a = test::memory(1 << 12);
    arena::ArenaAllocator allocator = arena::allocator(&a);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);

    struct Line line = {.w = mem::alloc_slice(f64, 3), .b = 1.0};
    line.w[0] = 1.0;
    line.w[1] = 2.0;
    line.w[2] = 3.0;
    struct Line g = autodiff::gradient(line_loss, &line, 2.0);
    struct Line z = autodiff::zeros(line);
    test::check_equal(countof(g.w), 3);
    test::check_near(g.w[1], 2.0 * 13.0 * 2.0, 1e-12);
    test::check_near(g.b, 2.0 * 13.0, 1e-12);
    test::check_equal(countof(z.w), 3);
    test::check_near(z.w[2], 0.0, 0.0);
    test::check_condition(allocator.base.owns(&allocator.base, g.w.data));
    test::check_condition(allocator.base.owns(&allocator.base, z.w.data));
    mem::set_allocator(outside);
}
