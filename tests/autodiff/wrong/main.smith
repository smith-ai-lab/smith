// A template: tests/autodiff_test.smith replaces CALL with calls of autodiff::gradient that must not compile.
module main;

import std::autodiff;

typedef struct {
    F64 v[2];
} Data;

typedef struct {
    F64 *v;
} Pointers;

F64 through(Pointers *p) {
    return p->v[0];
}

F64 total(Data *d, F64 scale) {
    return d->v[0] * scale;
}

I32 main() {
    Data d = {};
    Pointers ptr = {};
    (void)d;
    (void)ptr;
    CALL;
    return 0;
}
