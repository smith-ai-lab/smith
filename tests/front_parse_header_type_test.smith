// Tests of a lowercase type under a header binding (#2052 of #1678): `let n: stdio.size_t`, `*stdlib.div_t` as a
// parameter. A type has no member access, so a `.` between two lowercase names continues the path there; in an
// expression `a.b` stays a member access.
module front_parse_header_type_test;

import front::ast;
import front::parser;
import std::arena;
import std::mem;
import std::test;

static Str dump_of(Str source) {
    parser::Parsed parsed = parser::parse_new("x.smith", source);
    if (countof(parsed.errors) > 0) {
        Str expected = "no error";
        test::check_equal(parsed.errors[0].message, expected);
    }
    return ast::dump(&parsed.module);
}

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        Bool same = true;
        for (Usize k = 0; k < countof(needle); k++) {
            if (text[i + k] != needle[k]) {
                same = false;
                break;
            }
        }
        if (same) return true;
    }
    return false;
}

export void test_a_lowercase_type_after_a_header_binding() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "import c <stdio.h>\nimport c <stdlib.h>\nfn f(d: *stdlib.div_t):\n    let n: stdio.size_t = 3\n";
    Str got = dump_of(source);
    test::check_condition(has(got, "stdio::size_t"));
    test::check_condition(has(got, "stdlib::div_t"));
}

export void test_a_member_access_in_an_expression_is_unchanged() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str got = dump_of("fn f(a: i32):\n    let n: i32 = a.b\n");
    test::check_condition(!has(got, "a.b"));
}
