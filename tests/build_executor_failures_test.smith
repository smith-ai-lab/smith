// The executor on manifests written by hand, from tests/build.sh sections 14a to 14c: `smith --smith-exec <manifest>`
// reads the same language as ninja and behaves as ninja did. A failed job and -k, the options, depfiles and restat.
// The executor is started as `smith --smith-exec`, dispatched in smith.c, so smith.c is declared.
// smith-covers: smith.c runtime/executor*.c runtime/slots.c runtime/quiet.c runtime/base.h runtime/platform_*.c
// smith-covers: tests/build_fixtures/
module build_executor_failures_test;

import std::mem;
import std::arena;
import std::format;
import std::test;
import scratch;

// The text with its newlines as spaces, for the order in which words were printed.
static const char *flat(arena::Arena *memory, const char *text) {
    Usize length = __builtin_strlen(text);
    char *copy = arena::push_slice(memory, char, length + 1).data;
    for (Usize i = 0; i < length; i++)
        copy[i] = text[i] == '\n' ? ' ' : text[i];
    copy[length] = '\0';
    return copy;
}

static scratch::Run exec(const scratch::Project *p, const char *arguments) {
    char command[1024];
    (void)format::to(command, sizeof command, "smith --smith-exec build.ninja ", arguments);
    return scratch::sh(p, command);
}

static const char *yes_no(const scratch::Project *p, const char *name) {
    return scratch::exists(p, name) ? "yes" : "no";
}

// 14a. A failed job: the status, the outputs, the command and what it printed; the first failure stops the build.
export void test_build_executor_a_failed_job_says_why_and_stops_the_build() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_failure");
    defer scratch::clean(&p);
    scratch::Run run = exec(&p, "-j1");
    scratch::expect_status("failure: the build fails", 1, &run);
    scratch::expect_contains("failure: FAILED names the status and the output", run.out, "FAILED: [code=3] bad ");
    scratch::expect_contains("failure: then the command", run.out, "echo to-out; echo to-err >&2; exit 3");
    scratch::expect_contains("failure: then what it printed, stdout and stderr in order", flat(&memory, run.out),
                             "to-out to-err");
    scratch::expect_contains("failure: the build says why it stopped", run.err,
                             "build stopped: subcommand failed (step ");
    char state[16];
    (void)format::to(state, sizeof state, yes_no(&p, "good"), " ", yes_no(&p, "after"));
    scratch::expect_text("failure: the first failure stops the others", "no no", state);
}

// A step killed by a signal says so, names the step and says a rerun resumes (#1254).
export void test_build_executor_a_killed_job_says_the_signal_and_that_a_rerun_resumes() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_killed");
    defer scratch::clean(&p);
    scratch::Run run = exec(&p, "-j1");
    scratch::expect_status("killed: the build fails", 1, &run);
    scratch::expect_contains("killed: FAILED names the status", run.out, "FAILED: [code=137] killed ");
    scratch::expect_contains("killed: the step and the signal", run.out, "step 1 of 1 was killed by signal 9");
    scratch::expect_contains("killed: out of memory is named", run.out, "probably out of memory");
    scratch::expect_contains("killed: a rerun resumes", run.out, "again resumes from the steps that are done");
}

export void test_build_executor_keep_going_builds_what_does_not_depend_on_the_failure() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_failure");
    defer scratch::clean(&p);
    scratch::Run keep = exec(&p, "-j1 -k 0");
    scratch::expect_status("keep going: the build still fails", 1, &keep);
    scratch::expect_text("keep going: -k 0 builds what does not depend on the failure", "G", scratch::read(&p, "good"));
    scratch::expect_text("keep going: and not what does", "no", yes_no(&p, "after"));
    scratch::expect_contains("keep going: it says it cannot go on", keep.err,
                             "cannot make progress due to previous errors (step ");
}

export void test_build_executor_keep_going_after_two_failures_stops_at_the_only_one() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_failure");
    defer scratch::clean(&p);
    (void)exec(&p, "-j1 -k 2");
    scratch::expect_text("keep going: -k 2 stops after the second failure, there is only one", "G",
                         scratch::read(&p, "good"));
}

export void test_build_executor_options_are_checked() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_failure");
    defer scratch::clean(&p);
    scratch::expect_contains("options: -j needs a number", exec(&p, "-j").err, "needs a value");
    scratch::expect_contains("options: -jx is not a number", exec(&p, "-jx").err, "needs a number");
    scratch::expect_contains("options: an unknown flag is refused", exec(&p, "--bogus").err, "unknown option");
}

// 14b. Depfiles: what the command read is kept, and the file is removed.
export void test_build_executor_a_depfile_is_read_and_removed() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_depfile");
    defer scratch::clean(&p);
    (void)exec(&p, "");
    scratch::expect_count("depfile: the first build runs", 1, scratch::lines(&p, "runs"));
    scratch::expect_text("depfile: the depfile is removed once read", "no", yes_no(&p, "obj.d"));
    scratch::Run deps = exec(&p, "-t deps obj");
    scratch::expect_contains("depfile: -t deps lists what it named", deps.out, "    hdr one.h");
    scratch::expect_contains("depfile: and says it is valid", deps.out, "(VALID)");
    scratch::expect_contains("depfile: an unchanged tree has no work", exec(&p, "").out, "no work to do");
}

export void test_build_executor_a_changed_header_reruns_the_step() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_depfile");
    defer scratch::clean(&p);
    (void)exec(&p, "");
    scratch::sleep(&p, 50);
    (void)scratch::sh(&p, "touch hdr");
    (void)exec(&p, "");
    scratch::expect_count("depfile: a changed header reruns the step", 2, scratch::lines(&p, "runs"));
    scratch::sleep(&p, 50);
    (void)scratch::sh(&p, "touch 'hdr one.h'");
    (void)exec(&p, "");
    scratch::expect_count("depfile: a header with a space in its name is read", 3, scratch::lines(&p, "runs"));
    (void)exec(&p, "");
    scratch::expect_count("depfile: and settles", 3, scratch::lines(&p, "runs"));
    (void)scratch::sh(&p, "rm hdr");
    (void)exec(&p, "");
    scratch::expect_count("depfile: a header that is gone reruns the step once", 4, scratch::lines(&p, "runs"));
}

export void test_build_executor_a_depfile_that_names_another_output_fails_the_step() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_depfile_wrong");
    defer scratch::clean(&p);
    scratch::Run run = exec(&p, "");
    scratch::expect_failure("depfile: a depfile that names another output fails the step", &run);
    scratch::expect_contains("depfile: and says what it expected", run.out,
                             "expected depfile 'obj.d' to mention 'obj', got 'wrong'");
}

static void counts(const scratch::Project *p, const char *name, const char *expected) {
    char actual[32];
    (void)format::to(actual, sizeof actual, scratch::lines(p, "gen.log"), " ", scratch::lines(p, "use.log"), " ",
                     scratch::lines(p, "last.log"));
    scratch::expect_text(name, expected, actual);
}

// 14c. restat: an output that did not change cleans what depended on it, and the time kept is the input's.
export void test_build_executor_restat_cleans_what_an_unchanged_output_feeds() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_restat");
    defer scratch::clean(&p);
    (void)exec(&p, "");
    counts(&p, "restat: the first build runs the chain", "1 1 1");
    scratch::sleep(&p, 50);
    scratch::write(&p, "seed", "one\nthree\n");
    (void)exec(&p, "");
    counts(&p, "restat: an input change reruns the step, but not what the unchanged output feeds", "2 1 1");
    scratch::expect_contains("restat: and the next build has nothing to do", exec(&p, "").out, "no work to do");
    scratch::write(&p, "seed", "uno\nthree\n");
    (void)exec(&p, "");
    counts(&p, "restat: a changed output reruns everything after it", "3 2 2");
}

export void test_build_executor_a_dry_run_lists_the_steps_and_runs_nothing() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_restat");
    defer scratch::clean(&p);
    (void)exec(&p, "");
    scratch::expect_contains("dry run: a settled tree says so", exec(&p, "-n").out, "no work to do");
    (void)scratch::sh(&p, "touch seed");
    scratch::Run dry = exec(&p, "-n");
    scratch::expect_contains("dry run: lists the steps it would run, the dependents included", dry.out,
                             "[1/3] echo gen >> gen.log");
    scratch::expect_count("dry run: and runs nothing", 1, scratch::lines(&p, "gen.log"));
}

export void test_build_executor_restat_checks_an_input_touched_after_the_output() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "exec_restat");
    defer scratch::clean(&p);
    (void)exec(&p, "");
    scratch::sleep(&p, 50);
    (void)scratch::sh(&p, "touch seed");
    (void)exec(&p, "");
    counts(&p, "restat: an input touched after the output is checked again", "2 1 1");
    scratch::expect_contains("restat: and then settles, the log has the input's time", exec(&p, "").out,
                             "no work to do");
}
