# smith-build: header
# std::ascii, <smith/ascii.h>: tests of one character, ASCII only and no locale, so they answer the same on every
# machine. Every export is a function of a `char`, which is what a predicate of `slice` is.

# A space, a tab, a newline or a carriage return.
pub fn space(c: char) -> bool {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

# A digit, 0 to 9.
pub fn digit(c: char) -> bool {
    return c >= '0' && c <= '9'
}

# A letter, a to z or A to Z.
pub fn alpha(c: char) -> bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}
