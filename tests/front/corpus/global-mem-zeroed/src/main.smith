# A global whose value is `mem.zeroed(T)`: the zero constant of its type (#3036).
import c <stdio.h>
import std.mem

pub struct Counter:
    pub count: i32
    pub total: i32

static mut counter: Counter = mem.zeroed(Counter)

fn main() -> i32:
    counter.count += 2
    _ := stdio.printf("%d %d\n", counter.count, counter.total)
    return 0
