import c <stdio.h>

# `f32` is a known type in an array parameter and in the elements of an array.
fn corner(m: [3][2]f32) -> f32:
    m[2][1]

fn ends(xs: [4]f32) -> f32:
    xs[0] + xs[3]

pub fn main() -> i32:
    let m: [3][2]f32 = [[0.0, 0.0], [0.0, 0.0], [1.5, 2.5]]
    let xs: [4]f32 = [1.0, 2.0, 3.0, 4.5]
    let _ = stdio.printf("%g %g\n", corner(m).to(f64), ends(xs).to(f64))
    0
