import c <stdio.h>

# A text array keeps its zero, a conditional inside brackets is the conditional, and a subscript is a subscript.
fn pick(a: [4]i32, x: i32) -> i32:
    if x != 0:
        a[1]
    else:
        a[2]

fn choose(v: i32) -> usize:
    if v != 0:
        2
    else:
        0

pub fn main() -> i32:
    let word = "abc"
    let xs: [4]i32 = [1, 2, 3, 0]
    let p = &xs[0]
    let bytes = countof(word) + 1
    let chosen = xs[choose(p.*)]
    let length = countof(word)
    let _ = stdio.printf("%d %d %zu %d\n", bytes, pick(xs, 1), length, chosen)
    0
