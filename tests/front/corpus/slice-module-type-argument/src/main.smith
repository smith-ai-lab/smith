import <stdio.h>;
import key

# A fixed array passed to a slice parameter of an imported module's type, in a file that imports a C header: the
# lowering's own spelling of the type is no C name of the user's (issue #203).
pub fn main() -> i32:
    let ks: [2]key.Key = [key.pair(1, 2), key.pair(3, 4)]
    let _ = c::printf("%llu\n", key.total(ks).to(u64))
    0
