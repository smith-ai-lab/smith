import <stdio.h>;
import <string.h>;

const width: usize = 5

# (Array lengths are literals here: a named length waits for #1918.) A parameter written as an array keeps its size: countof gives it, an index in range is fine, a local array of the
# same shape is passed on as it is.
fn sizes(xs: [5]i32, m: [3][2]i32) -> usize:
    countof(xs) + countof(m) * 10 + countof(m[0]) * 100

fn last(xs: [5]i32) -> i32:
    xs[width - 1] + xs[0]

fn sum(xs: [5]i32) -> i32:
    let mut total = 0
    for x in xs:
        total += x
    total

fn pass_on(xs: [5]i32) -> i32:
    last(xs) + sum(xs)

# A pointer is a pointer: the array it points into is any size.
fn walk(xs: []i32, count: usize) -> i32:
    let mut total = 0
    for i in range(0, count):
        total += xs[i]
    total

pub fn main() -> i32:
    let mut xs: [5]i32 = [1, 2, 3, 4, 5]
    let m: [3][2]i32 = [[0, 0], [0, 0], [0, 0]]
    let _ = c::printf("%zu %d %d %d\n", sizes(xs, m), last(xs), pass_on(xs), walk(xs[0:3], 3))
    0
