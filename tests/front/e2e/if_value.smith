fn word(c: bool) -> i32:
    let s = if c: 1 else: 2
    s

fn pick(n: i32) -> i32:
    let v = if n > 0:
        let doubled = n * 2
        doubled + 1
    else if n < 0:
        0 - n
    else:
        100
    v

pub fn check() -> i32:
    if word(true) != 1 || word(false) != 2:
        return 1
    if pick(3) != 7 || pick(-4) != 4 || pick(0) != 100:
        return 2
    0
