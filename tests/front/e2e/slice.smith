fn total(xs: []i32) -> i64 {
    mut sum: i64 = 0
    for x in xs {
        sum += x.to(i64)
    }
    sum
}

fn count_char(s: str, wanted: Char) -> usize {
    mut n: usize = 0
    for c in s {
        if c.to(Char) == wanted {
            n += 1
        }
    }
    n
}

fn first_word(s: str) -> str {
    mut i: usize = 0
    while i < countof(s) && s[i].to(Char) != ' ' {
        i += 1
    }
    s[0:i]
}

pub fn check() -> i32 {
    mut a: [4]i32
    a[0] = 1
    a[1] = 2
    a[2] = 3
    a[3] = 4
    if total(a) != 10 || total(a[1:3]) != 5 {
        return 1
    }
    s: []i32 = a
    s[0] = 40
    if a[0] != 40 {
        return 2
    }
    if count_char("banana", 'a') != 3 {
        return 3
    }
    w := first_word("hello world")
    if countof(w) != 5 || w[4].to(Char) != 'o' {
        return 4
    }
    0
}
