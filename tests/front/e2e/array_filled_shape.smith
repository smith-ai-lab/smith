import std.array

const rows: usize = 3
const cols: usize = 2

mut names: [5, 8]char = array.filled(char, [5, 8], 0)
mut ones: [2, 3]u8 = array.filled(u8, [2, 3], 1)
mut grid: [3, 6]i32 = array.filled(i32, [rows, cols * rows], 0)
mut cube: [2, 2, 2]u8 = array.filled(u8, [2, 2, 2], 9)

fn runtime_fill(v: i32) -> i32:
    xs := array.filled(i32, [2, 3], v)
    xs[0][0] + xs[1][2]

fn generic_fill(T: type, v: T) -> T:
    xs := array.filled(T, [2, 3], v)
    xs[1][2]

pub fn check() -> i32:
    if countof(names) != 5 || countof(names[0]) != 8 || names[4][7] != 0:
        return 1
    if ones[0][0] != 1 || ones[1][2] != 1 || countof(ones[1]) != 3:
        return 2
    if countof(grid) != 3 || countof(grid[2]) != 6 || grid[2][5] != 0:
        return 3
    if cube[1][1][1] != 9 || cube[0][0][0] != 9:
        return 4
    nested := array.filled([3]u8, 2, array.filled(u8, 3, 4))
    if nested[1][2] != 4 || nested[0][0] != 4:
        return 5
    local := array.filled(f64, [2, 2], 2.5)
    if local[1][1] != 2.5 || countof(local) != 2:
        return 6
    if runtime_fill(7) != 14:
        return 7
    if generic_fill(i32, 5) != 5:
        return 8
    0
