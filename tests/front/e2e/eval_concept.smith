# A concept is a function the compiler answers (#3039): in a `static_assert`, in a compile-time `if`, in a constant,
# combined with `and`, `or` and `not`, and through another concept.

fn small(T: type) -> bool:
    sizeof(T) <= 4

fn tiny(T: type) -> bool:
    small(T) and sizeof(T) == 1

static_assert(small(u32) and not small(u64));
static_assert(tiny(u8) and not tiny(u16), "u8 is tiny and u16 is not");

fits := small(i16) or tiny(i64)

fn width[T](x: T) -> i32:
    if tiny(T):
        return 1
    else if small(T):
        return 4
    else:
        return no_such_function(x)

pub fn check() -> i32:
    a: u8 = 1
    b: i32 = 2
    if width(a) != 1:
        return 1
    if width(b) != 4:
        return 2
    if not fits:
        return 3
    0
