## The forms the first count batch (#3430) made the front end take: the size of a struct that holds a function or an
## option (`sizeof` at compile time), `countof` and `sizeof` of a field read through a pointer, a `nullptr` given to a
## parameter whose type an earlier argument already fixed, and a `static mut` array that starts as `{}`.

import std.array

struct Callback:
    word: fn(*Callback, u64) -> u64

struct Maybe:
    first: ?*u64
    second: ?u64

struct Rows:
    count: usize
    out: [8]u8

static_assert(sizeof(Callback) == 8)
static_assert(sizeof(Maybe) == 24)

fn same_type[T](a: T, b: T) -> i32:
    if a == b:
        return 1
    0

fn row_count(r: *Rows) -> usize:
    countof(r.out)

fn row_bytes(r: *Rows) -> usize:
    sizeof r.out

fn table_sum() -> i32:
    static mut cells: [3][4]i32 = {}
    cells[1][2] = 5
    cells[2][3] = 7
    mut total: i32 = 0
    for i in range(0, 3):
        for j in range(0, 4):
            total += cells[i][j]
    total

pub fn check() -> i32:
    mut rows: Rows = Rows(count = 0, out = array.filled(u8, 8, 0))
    if row_count(&rows) != 8 or row_bytes(&rows) != 8:
        return 1
    mut value: u64 = 3
    p: *u64 = &value
    if same_type(p, nullptr) != 0:
        return 2
    if table_sum() != 12:
        return 3
    0
