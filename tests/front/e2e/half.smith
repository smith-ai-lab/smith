fn square(x: f16) -> f16 {
    x * x
}

fn scale(b: bf16) -> bf16 {
    b * 2.0
}

pub fn check() -> i32 {
    x: f16 = 1.5
    y := square(x)
    if (y.to(f32)) != 2.25 {
        return 1
    }
    b: bf16 = 3.0
    if !(b < ((4.0).to(bf16))) || scale(b).to(f32) != 6.0 {
        return 2
    }
    wide: f32 = x
    if wide != 1.5 {
        return 3
    }
    n: i8 = 7
    h: f16 = n
    if (h.to(i32)) != 7 {
        return 4
    }
    if ((x.to(bf16)).to(f32)) != 1.5 {
        return 5
    }
    mut z: f16 = 0
    z += 0.5
    z = -z
    if (z.to(f64)) != -0.5 {
        return 6
    }
    0
}
