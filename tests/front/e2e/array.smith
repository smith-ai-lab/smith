fn total(xs: []i32) -> i32 {
    let mut sum = 0
    for x in xs {
        sum += x
    }
    sum
}

pub fn check() -> i32 {
    let primes: [4]i32 = [2, 3, 5, 7]
    if primes[3] != 7 {
        return 1
    }
    if total([1, 2, 3]) != 6 {
        return 2
    }
    let grid: [2][3]i64 = [[1, 2, 3], [4, 5, 6]]
    if grid[1][2] != 6 {
        return 3
    }
    let empty: []i32 = []
    if countof(empty) != 0 || total(empty) != 0 {
        return 4
    }
    let mut runs = 0
    for i in range(0, 3) {
        let row = [i, i + 1]
        runs += total(row)
    }
    if runs != 9 {
        return 5
    }
    0
}
