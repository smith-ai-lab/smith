## The forms the F00 batch (#3478) made the front end take: a slice whose element is a `str` or a pointer to a record
## (`mem.realloc` of a `[]str`, of a `[]*Item`).

import std.mem

struct Item:
    n: i32

pub fn check() -> i32:
    mut names: []str = []
    names = mem.realloc(names, 2)
    names[0] = "ab"
    names[1] = "cde"
    if countof(names) != 2 or countof(names[1]) != 3:
        return 1
    mem.free(names.data)
    mut items: []*Item = []
    items = mem.realloc(items, 1)
    items[0] = nullptr
    if countof(items) != 1 or items[0] != nullptr:
        return 2
    mem.free(items.data)
    0
