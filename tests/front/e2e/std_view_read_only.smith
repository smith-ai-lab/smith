# The fixed form of mem.view (#3078) makes a read-only slice, `[]T`, whose pointer is `*T`: a write through it is
# refused, so the view never writes to bytes its caller may only read.
fn view(data: []u8, T: type) -> []T:
    mut result: []T = undefined
    result.data = data.data.cast(*T)
    result.count[0] = data.count[0] / sizeof(T)
    return result

fn clear(text: []u8):
    words := view(text, u32)
    words.data[0] = 0

pub fn check() -> i32:
    0
