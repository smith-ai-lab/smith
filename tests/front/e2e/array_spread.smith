# `[0, a..., 4]`: an array or a tuple spread into an array literal, element by element.
fn sum(xs: []i32) -> i32:
    mut total: i32 = 0
    for x in xs:
        total = total + x
    total

pub fn check() -> i32:
    a := [1, 2, 3]
    b := [0, a..., 4]
    if sum(b[:]) != 10: return 1
    if b[4] != 4: return 2
    if b[1] != 1: return 3
    t := (5, 6)
    c := [t..., 7]
    if c[0] != 5: return 4
    if c[2] != 7: return 5
    0
