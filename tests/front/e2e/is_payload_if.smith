# `s is .circle` in an `if`: one compare of the tag, and the name reads the payload inside (#3226).
struct Circle:
    radius: i32

struct Square:
    side: i32

enum Shape:
    circle: Circle
    square: Square
    empty

fn size_of(s: Shape) -> i32:
    if s is .circle:
        return s.radius
    else if s is .square:
        return s.side
    0

pub fn check() -> i32:
    if size_of(.circle(Circle(radius = 3))) != 3: return 1
    if size_of(.square(Square(side = 4))) != 4: return 2
    if size_of(.empty) != 0: return 3
    0
