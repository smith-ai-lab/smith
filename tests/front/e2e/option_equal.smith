# `==` and `!=` between two options: the same tag, and equal payloads when both are `.some`.
pub fn check() -> i32:
    a: ?i32 = 5
    b: ?i32 = 5
    c: ?i32 = .none
    d: ?i32 = .none
    e: ?i32 = 6
    if a != b: return 1
    if a == c: return 2
    if c != d: return 3
    if a == e: return 4
    if !(a != e): return 5
    0
