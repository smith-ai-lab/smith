fn sum_to(n: i32) -> i32:
    let mut total = 0
    for i in range(n):
        total += i
    total

fn evens(limit: u32) -> u32:
    let mut count: u32 = 0
    let zero: u32 = 0
    for i in range(zero, limit, 2):
        if i == 6:
            continue
        count += 1
    count

pub fn check() -> i32:
    if sum_to(5) != 10 || sum_to(0) != 0:
        return 1
    if evens(10) != 4:
        return 2
    let mut xs: [4]i32 = undefined
    for p in refs(xs):
        p.* = 3
    let mut total = 0
    for x in xs:
        if x != 3:
            break
        total += x
    if total != 12:
        return 3
    0
