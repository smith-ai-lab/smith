mut trace := 0

fn guarded(o: ?i32) -> i32:
    defer trace = trace + 100
    v := match o:
        .some(n): n
        .none:
            trace = trace + 1
            return 5
    v

fn lambda_leaves(n: i32) -> i32:
    f := fn(o: ?i32) -> i32:
        v := match o:
            .some(x): x
            .none:
                return 7
        v + 1
    r := f(.none)
    r + n

fn generic[T](o: ?T, d: T) -> T:
    v := match o:
        .some(x): x
        .none:
            return d
    v

pub fn check() -> i32:
    if guarded(.none) != 5 or trace != 101:
        return 1
    if guarded(.some(2)) != 2 or trace != 201:
        return 2
    if lambda_leaves(1) != 8:
        return 3
    none: ?i32 = .none
    some: ?i32 = .some(3)
    if generic(none, 9) != 9 or generic(some, 9) != 3:
        return 4
    0
