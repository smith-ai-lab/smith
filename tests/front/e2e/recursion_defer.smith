# A `return f(x)` under a `defer` is not a tail call: the defer still runs after it, and the call runs on a segment
# when the stack is nearly full.

fn note(log: *mut u64):
    log.* += 1

fn count(n: u64, log: *mut u64) -> u64:
    defer note(log)
    if n == 0:
        return 0
    return count(n - 1, log)

pub fn check() -> i32:
    mut log: u64 = 0
    if count(100000, &log) != 0:
        return 1
    if log != 100001:
        return 2
    0
