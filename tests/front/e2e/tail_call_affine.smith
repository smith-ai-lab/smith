# A value moved into a tail call is not dropped after it (#2709): the `@affine` token goes to the next turn of the loop.

@affine
struct Token:
    id: u64

fn spend(token: Token, n: u64) -> u64:
    if n == 0:
        return token.id
    return spend(token, n - 1)

pub fn check() -> i32:
    if spend(Token(id = 7), 1000000) != 7:
        return 1
    0
