// The proofs of a whole group, kept (#2994): a `smith prove` whose functions were all reused from the cache is not
// compiled the next time while the files its compile read, its flags and its options, and the compiler, are what they
// were; its summary line then says "(not compiled)". The record is kept by the run that reused every function, so a
// group proved afresh is replayed from its third run on. Anything else runs as before. The cache is the case's own.
module prove_group_cache_test;

import std::arena;
import std::format;
import std::mem;
import std::test;
import scratch;
import prove_cases;

static scratch::Project fresh() {
    scratch::Project p = scratch::make("p", "prove_cases");
    scratch::copy_tree(&p, "tests/prove", "cases");
    scratch::own_cache(&p); // before the arena: clean frees the path
    return p;
}

static void has(const char *name, const scratch::Run *run, const char *needle) {
    scratch::expect_contains(name, run->out, needle);
}

static void lacks(const char *name, const scratch::Run *run, const char *needle) {
    scratch::expect_lacks(name, run->out, needle);
}

// `smith prove` of clamp.c with the words after the file, `-- -I include` and more flags after them.
static scratch::Run again(const scratch::Project *p, const char *name, const char *before, const char *flags) {
    char command[1024];
    format::Written written = format::write(command, sizeof command, "smith prove ", before,
                                            " cases/clamp.c -- -I \"$SMITH_REPO/.smith/include\" ", flags, " 2>&1");
    test::check_condition(written.fits);
    scratch::Run run = scratch::sh(p, command);
    scratch::expect_status(name, 0, &run);
    return run;
}

export void test_prove_group_cache_a_group_proved_from_the_cache_is_not_compiled() {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run first = again(&p, "group: the first run proves", "", "");
    has("group: the first run proves both", &first, "2 proved, 0 failed");
    lacks("group: ... and compiles", &first, "(not compiled)");
    scratch::Run second = again(&p, "group: the second run", "", "");
    has("group: the second run reuses both", &second, "2 proved, 0 failed, 2 cached");
    lacks("group: ... and compiles, to know it", &second, "(not compiled)");
    scratch::Run third_run = again(&p, "group: the third run", "", "");
    has("group: the third run reports the same functions", &third_run, "2 proved, 0 failed, 2 cached");
    has("group: ... without compiling the group", &third_run, "(not compiled)");
    has("group: ... and the same coverage line", &third_run, "2 of 2 functions have contracts");
    scratch::Run third = again(&p, "group: -v lists the functions", "-v", "");
    has("group: -v compiles, to list them", &third, "ok    clamp  (");
    lacks("group: ... and is not replayed", &third, "(not compiled)");
}

export void test_prove_group_cache_a_changed_contract_flag_budget_or_cache_runs_the_group_again() {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run first = again(&p, "changed: the first run proves", "", "");
    lacks("changed: the first run compiles", &first, "(not compiled)");
    scratch::Run reuse = again(&p, "changed: the second run", "", "");
    lacks("changed: the second run reuses, compiling", &reuse, "(not compiled)");
    scratch::Run flag = again(&p, "changed: a flag", "", "-DEXTRA=1");
    lacks("changed: a flag is another group", &flag, "(not compiled)");
    scratch::Run budget = again(&p, "changed: a budget", "--budget=5", "");
    lacks("changed: a budget is another group", &budget, "(not compiled)");
    scratch::Run none = again(&p, "changed: --no-cache", "--no-cache", "");
    lacks("changed: --no-cache proves again", &none, "(not compiled)");
    scratch::Run same = again(&p, "changed: the same group", "", "");
    has("changed: the group of the first runs is still kept", &same, "(not compiled)");
    scratch::Run edit = scratch::sh(&p, "sed -i 's/max_health <= 1000/max_health <= 999/' cases/clamp.c");
    scratch::expect_status("changed: edit one contract", 0, &edit);
    scratch::Run edited = again(&p, "changed: after the edit", "", "");
    lacks("changed: one contract changed, the group is compiled", &edited, "(not compiled)");
    has("changed: ... and proved", &edited, "2 proved, 0 failed");
    scratch::Run reused = again(&p, "changed: after the edit, again", "", "");
    lacks("changed: ... reused once more", &reused, "(not compiled)");
    scratch::Run settled = again(&p, "changed: after the edit, a third time", "", "");
    has("changed: the edited group is kept in turn", &settled, "(not compiled)");
}

export void test_prove_group_cache_a_changed_header_runs_the_group_again() {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run made = scratch::sh(
        &p, "printf '#define LIMIT 1000\\n' > cases/limit.h; "
            "sed 's/max_health <= 1000/max_health <= LIMIT/; 1i #include \"limit.h\"' cases/clamp.c > cases/limited.c");
    scratch::expect_status("header: make a source that includes a header of its own", 0, &made);
    scratch::Run first = scratch::sh(&p, "smith prove cases/limited.c -- -I \"$SMITH_REPO/.smith/include\" 2>&1");
    scratch::expect_status("header: the first run", 0, &first);
    lacks("header: the first run compiles", &first, "(not compiled)");
    scratch::Run second = scratch::sh(&p, "smith prove cases/limited.c -- -I \"$SMITH_REPO/.smith/include\" 2>&1");
    lacks("header: the second run reuses the proofs", &second, "(not compiled)");
    scratch::Run kept = scratch::sh(&p, "smith prove cases/limited.c -- -I \"$SMITH_REPO/.smith/include\" 2>&1");
    has("header: the third run does not compile", &kept, "(not compiled)");
    scratch::Run edit = scratch::sh(&p, "printf '#define LIMIT 999\\n' > cases/limit.h");
    scratch::expect_status("header: change the header", 0, &edit);
    scratch::Run third = scratch::sh(&p, "smith prove cases/limited.c -- -I \"$SMITH_REPO/.smith/include\" 2>&1");
    scratch::expect_status("header: after the change", 0, &third);
    lacks("header: a changed header compiles the group", &third, "(not compiled)");
}

export void test_prove_group_cache_a_group_that_fails_keeps_no_record() {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run first = prove_cases::prove(&p, "\"$c/bad_caller.c\" \"$c/clamp.c\"");
    scratch::Run second = prove_cases::prove(&p, "\"$c/bad_caller.c\" \"$c/clamp.c\"");
    has("failed: the failure is reported", &first, "may break smith_requires(low <= high)");
    has("failed: ... again", &second, "may break smith_requires(low <= high)");
    lacks("failed: ... by compiling again", &second, "(not compiled)");
}
