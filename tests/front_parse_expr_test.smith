// One source of the fix goldens (#1509): the warnings of its first reading, the text once `smith lint --fix` has run to
// the end, and the warnings that text still has (the forms with no mechanical fix).
static Str fix_one(Str source) {
    char text[:] = format::push(source, "\n");
    Str current = source;
    Usize left = 0;
    for (Usize pass = 0; pass < 8; pass += 1) {
        parse::Parser p = parser_of(current);
        _ = parse::expression(&p);
        for (Usize i = 0; i < countof(p.warnings) && pass == 0; i += 1) {
            parse::ParseError warning = p.warnings[i];
            Str note = "";
            if (countof(warning.fix) == 0) note = " (no fix)";
            text = format::push(text, "  warning ", warning.span.start, "-", warning.span.end, ": ", warning.message,
                                note, "\n");
        }
        left = countof(p.warnings);
        fix::Fixed fixed = fix::apply_fixes(current, p.errors, p.warnings);
        if (fixed.applied == 0) break;
        current = fixed.text;
    }
    char done[:] = format::push(text, "  fixed: ", current, "\n  warnings left: ", left, "\n");
    return done;
}

static Str fix_all(Str lines) {
    char all[:] = {};
    Usize start = 0;
    for (Usize i = 0; i <= countof(lines); i += 1) {
        if (i < countof(lines) && lines[i] != '\n') continue;
        all = format::push(all, fix_one(lines[start:i]), "\n");
        start = i + 1;
    }
    return all;
}

static void check_fixes(Str path, Str lines) {
    arena::Arena memory = test::memory(1U << 23);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    test::golden(path, fix_all(lines));
}

export void test_parse_expr_old_casts_and_members_have_fixes() {
    check_fixes("tests/front/parse_expr/old_casts.txt",
                "(I32)x\n(Point *)p\n(I32)(U8)x\n-(I32)x\n(I32)-x\n(I32)x + 1\n*(Point *)p\n(t)x\np->x\np->a->b\n"
                "(*p).x\n*p\n*p = 3\n**pp\n*p->x\n*-x\n*p++\n(I32)*p\n*(I32 *)p\n(I32)(U8)(U16)x");
}

export void test_parse_expr_old_conditionals_and_lists_have_fixes() {
    check_fixes("tests/front/parse_expr/old_lists.txt",
                "c ? a : b\nx = c ? a : b\na ? b : c ? d : e\na + b ? c : d\n(P){.x = 1, .y = 2}\n(P){1, 2}\n(I32)c ? "
                "a : b\nc ? (I32)a : (U8)b\n"
                "(P){.a.b = 1}\n(P){}\n{1, 2, 3}\n{{1, 2}, {3, 4}}\n{.x = 1}\n{}\n{[2] = 1}");
}

export void test_parse_expr_old_increments_and_chains_have_fixes() {
    check_fixes("tests/front/parse_expr/old_steps.txt",
                "i++;\ni--;\n++i;\n--i;\nx = i++;\nf(i++)\na[i]++;\nxs.iter().map(f).collect()\nxs.iter()");
}

// A module that uses every old form with a fix: `smith lint --fix` rewrites it, and a second run applies nothing.
export void test_parse_expr_lint_fix_twice_on_every_old_form() {
    arena::Arena memory = test::memory(1U << 23);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "I32 f(Point *p, I32 n) {\n    I32 a = (I32)n;\n    I32 b = p->x + *p;\n    I32 c = n > 0 ? a : b;\n"
                 "    Point q = (Point){.x = 1, .y = 2};\n    n++;\n    return a + b + c + q.x;\n}\n";
    fix::Fixed first = fix::fix_text("m.smith", source);
    test::check_condition(first.applied >= 6);
    // The locals are mended too (#1742): the name first, and the expressions as smith's own.
    test::check_condition(contains(first.text, "a: i32 = n.to(i32)\n"));
    test::check_condition(contains(first.text, "b: i32 = p.x + p.*\n"));
    test::check_condition(contains(first.text, "c: i32 = if n > 0 { a } else { b }\n"));
    test::check_condition(contains(first.text, "q: Point = Point(x = 1, y = 2)\n"));
    test::check_condition(contains(first.text, "n += 1"));
    fix::Fixed second = fix::fix_text("m.smith", first.text);
    test::check_equal(second.applied, (Usize)0);
}

// A `.` that starts a line continues the call before it inside parentheses and brackets, where a line break ends
// nothing (#1773); at the top level of a statement it still ends the statement.
export void test_parse_expr_a_line_starting_with_a_dot_continues_inside_parentheses() {
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parse::Parser inside = parser_in("f(a, g(x)\n.name)", true);
    ast::Expr *call = parse::expression(&inside);
    test::check_condition(call != nullptr);
    test::check_equal(countof(inside.errors), 0);
    test::check_equal(parse::peek(&inside).kind == lex::end_of_file, true);
    parse::Parser bracket = parser_in("xs[g(x)\n.index]", true);
    test::check_condition(parse::expression(&bracket) != nullptr);
    test::check_equal(countof(bracket.errors), 0);
    parse::Parser top = parser_in("g(x)\n.name", true);
    test::check_condition(parse::expression(&top) != nullptr);
    test::check_equal(parse::peek(&top).kind == lex::dot, true);
}

// After `.` a keyword is a member name (#1770): `x.module`, `t.type`.
export void test_parse_expr_keyword_is_a_member_name() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parse::Parser p = parser_of("x.module.type");
    ast::Expr *e = parse::expression(&p);
    test::check_condition(e != nullptr);
    test::check_equal(countof(p.errors), 0UL);
}

// ---- lambdas, `do:` and trailing blocks read `:` and indentation (#1858): the tokens go through lex::layout, the
// parser has `layout` set and the real statement hook reads the bodies. Each source is one expression statement of a
// function.

static Str dump_layout(Str source) {
    lex::Lexed lexed = lex::tokenize_new(source);
    lex::Tokens tokens = {};
    switch (lexed) {
    case .ok:
        tokens = lexed.ok;
        break;
    case .error:
        Str expected = "no error";
        test::check_equal(lexed.error.message, expected);
    }
    lex::Lexed laid = lex::layout(source, tokens);
    switch (laid) {
    case .ok:
        tokens = laid.ok;
        break;
    case .error:
        Str expected = "no error";
        test::check_equal(laid.error.message, expected);
    }
    parse::Parser p = parse::make(tokens, source);
    p.new_syntax = true;
    p.layout = true;
    p.hooks.expression = parse_expr::expression;
    p.hooks.type = parse_type::type;
    p.hooks.statement = parse_stmt::statement;
    ast::Expr *e = parse::expression(&p);
    ast::StmtRef statements[1] = {ast::return_value(e)};
    ast::StmtRef none[:] = {};
    ast::Stmt *body = ast::block(none);
    if (e != nullptr) body = ast::block(statements);
    ast::Param params[:] = {};
    ast::DeclRef decls[1] = {ast::function("f", params, ast::named("I32"), body)};
    ast::Module m = ast::new_module("m", decls);
    char text[:] = format::push(source, "\n", ast::dump(&m));
    for (Usize i = 0; i < countof(p.errors); i += 1) {
        text = format::push(text, "error ", p.errors[i].span.start, "-", p.errors[i].span.end, ": ",
                            p.errors[i].message, "\n");
    }
    return text;
}

static Str layout_source(Usize which) {
    switch (which) {
    case 0:
        return "fn(x): x * 2\n";
    case 1:
        return "fn(x: i32, y) -> i32: x\n";
    case 2:
        return "fn(x):\n    g(x)\n    x\n";
    case 3:
        return "f(1, fn(x): x)\n";
    case 4:
        return "sort(xs) fn(a, b): a < b\n";
    case 5:
        return "retry(3):\n    fetch(url)\n";
    case 6:
        return "do: 1\n";
    case 7:
        return "do:\n    g(2)\n    w * w\n";
    case 8:
        return "fn(i32) -> i32\n";
    case 9:
        return "match s:\n    .a: do:\n        f(1)\n    .b: fn(x): x\n";
    case 10:
        return "fn(x)\n";
    case 11:
        return "do 1\n";
    default:
        return "";
    }
}

export void test_parse_expr_layout_lambdas_do_and_trailing_blocks() {
    arena::Arena memory = test::memory(1U << 23);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    char all[:] = {};
    for (Usize i = 0; i < 12; i += 1)
        all = format::push(all, dump_layout(layout_source(i)), "\n");
    test::golden("tests/front/parse_expr/layout_forms.txt", all);
}
