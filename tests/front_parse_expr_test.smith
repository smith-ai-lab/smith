export void test_parse_expr_a_comma_expression_names_the_fix() {
    Str message = first_error("(a, b)");
    test::check_condition(contains(message, "no comma operator"));
    test::check_condition(contains(message, "two statements"));
    Str index = first_error("xs[a, b]");
    test::check_condition(contains(index, "no comma operator"));
}

export void test_parse_expr_a_function_pointer_declarator_names_fn() {
    Str message = first_error("(I32 (*)(I32))x");
    test::check_condition(contains(message, "Fn(I32 (I32))"));
}

export void test_parse_expr_an_unclosed_paren() {
    same(first_error("(a + b"), "expected `)` to close the `(`, found the end of the file");
    same(first_error("f(a, b"), "expected `)` to end the arguments, found the end of the file");
}

export void test_parse_expr_missing_operands() {
    same(first_error("a +"), "expected an expression, found the end of the file");
    same(first_error(")"), "expected an expression, found `)`");
    same(first_error("a ? b"), "expected `:` of the conditional, found the end of the file");
}

export void test_parse_expr_literal_errors() {
    same(first_error("18446744073709551616"), "this integer literal does not fit in 64 bits");
    same(first_error("\"\\q\""), "unknown or malformed escape sequence in a literal");
    same(first_error("'ab'"), "a character literal holds one character");
}

export void test_parse_expr_an_expression_stops_before_what_it_cannot_continue() {
    parse::Parser p = parser_of("a + b; c");
    ast::Expr *e = parse::expression(&p);
    test::check_condition(e != nullptr);
    test::check_equal(countof(p.errors), 0);
    test::check_equal(parse::peek(&p).kind == lex::semicolon, true);
    test::check_equal(e->span.start, 0);
    test::check_equal(e->span.end, 5);
}

export void test_parse_expr_spans_cover_the_operands() {
    parse::Parser p = parser_of("  f(x, y)[2] + -z");
    ast::Expr *e = parse::expression(&p);
    test::check_condition(e != nullptr);
    test::check_equal(e->span.start, 2);
    test::check_equal(e->span.end, 17);
    test::check_condition(e->kind == .binary);
    if (e->kind == .binary) {
        test::check_equal(e->kind.binary.left->span.end, 12);
        test::check_equal(e->kind.binary.right->span.start, 15);
    }
}

export void test_parse_expr_a_hook_that_is_not_set_is_reported() {
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parse::Parser p = parser_of("(I32)x");
    p.hooks.type = nullptr;
    ast::Expr *e = parse::expression(&p);
    test::check_condition(e == nullptr);
    same(p.errors[0].message, "no parser for a type is installed");
}

