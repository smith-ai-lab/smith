// Tests of front::parse_expr (#1145, A3 of track A of #1112): expressions read from text, dumped through front::ast
// and compared with the golden files of tests/front/parse_expr (`smith test --update` writes a changed one), and one
// test for each error. The sources are written in the final spelling. The statement hook is a stub that skips a
// braced body, so a lambda can be read before A4 exists.
module front_parse_expr_test;

import std::arena;
import std::format;
import std::mem;
import std::test;
import std::text;
import front::ast;
import front::lex;
import front::parse;
import front::parse_expr;
import front::parse_stmt;
import front::fix;
import front::parse_type;

// The stub of the statement hook: skips a braced body and gives an empty block.
static ast::Stmt *stub_statement(parse::Parser *p) {
    Usize depth = 0;
    for (Usize i = 0; i < countof(p->tokens); i += 1) {
        lex::TokenKind kind = parse::peek(p).kind;
        if (kind == lex::end_of_file) break;
        if (kind == lex::left_brace) depth += 1;
        if (kind == lex::right_brace) depth -= 1;
        parse::advance(p);
        if (depth == 0) break;
    }
    ast::StmtRef none[:] = {};
    return ast::block(none);
}

// A parser over the tokens of source with the real hooks and the stub; a lexing error fails the test.
static parse::Parser parser_in(Str source, Bool new_syntax) {
    lex::Lexed lexed = new_syntax ? lex::tokenize_new(source) : lex::tokenize(source);
    lex::Tokens tokens = {};
    switch (lexed) {
    case .ok:
        tokens = lexed.ok;
        break;
    case .error:
        Str expected = "no error";
        test::check_equal(lexed.error.message, expected);
    }
    parse::Parser p = parse::make(tokens, source);
    p.new_syntax = new_syntax;
    p.hooks.expression = parse_expr::expression;
    p.hooks.type = parse_type::type;
    p.hooks.statement = stub_statement;
    return p;
}

static parse::Parser parser_of(Str source) {
    return parser_in(source, false);
}

// The dump of one expression, as the value returned by a function `f` of a module, then the errors, one a line, and
// what was left unread.
static Str dump_one(Str source, Bool new_syntax) {
    parse::Parser p = parser_in(source, new_syntax);
    ast::Expr *e = parse::expression(&p);
    ast::StmtRef statements[1] = {ast::return_value(e)};
    ast::StmtRef none[:] = {};
    ast::Stmt *body = ast::block(none);
    if (e != nullptr) {
        body = ast::block(statements);
    }
    ast::Param params[:] = {};
    ast::DeclRef decls[1] = {ast::function("f", params, ast::named("I32"), body)};
    ast::Module m = ast::new_module("m", decls);
    Str dumped = ast::dump(&m);
    char text[:] = format::push(source, "\n", dumped);
    for (Usize i = 0; i < countof(p.errors); i += 1) {
        text = format::push(text, "error ", p.errors[i].span.start, "-", p.errors[i].span.end, ": ",
                            p.errors[i].message, "\n");
    }
    if (parse::peek(&p).kind != lex::end_of_file) {
        text = format::push(text, "left over: `", parse::text(&p, parse::peek(&p)), "`\n");
    }
    return text;
}

// Every line of `lines` is a source, dumped one after the other with a blank line between.
static Str dump_all(Str lines, Bool new_syntax) {
    char all[:] = {};
    Usize start = 0;
    for (Usize i = 0; i <= countof(lines); i += 1) {
        if (i < countof(lines) && lines[i] != '\n') continue;
        all = format::push(all, dump_one(lines[start:i], new_syntax), "\n");
        start = i + 1;
    }
    return all;
}

static void check_golden_in(Str path, Str lines, Bool new_syntax) {
    arena::Arena memory = test::memory(1U << 23);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    test::golden(path, dump_all(lines, new_syntax));
}

static void check_golden(Str path, Str lines) {
    check_golden_in(path, lines, false);
}

// Two texts are the same (a literal converts to Str in a parameter, not in a generic).
static void same(Str actual, Str expected) {
    test::check_equal(actual, expected);
}

// The first error message of a source; the test fails when there is none.
static Str first_error(Str source) {
    parse::Parser p = parser_of(source);
    _ = parse::expression(&p);
    test::check_condition(countof(p.errors) > 0);
    return p.errors[0].message;
}

static Bool contains(Str text, Str piece) {
    if (countof(piece) > countof(text)) return false;
    for (Usize i = 0; i + countof(piece) <= countof(text); i += 1) {
        if (mem::equal(text[i:i + countof(piece)], piece)) return true;
    }
    return false;
}

export void test_parse_expr_precedence_and_associativity() {
    check_golden(
        "tests/front/parse_expr/precedence.txt",
        "a - b - c\na = b = c\na + b * c\na * b + c * d\n!a && b || c\na || b && c\na ? b : c ? d : e\n"
        "a ? b : c + 1\na = b ? c : d\na < b == c < d\na & b | c ^ d\na << 1 + 2\n-a * b\na - -b\n!!a\n!!!a\n-!-a + b\n"
        "x += y *= 2\na && b == c\na | b && c\na % b / c\na >> b << c\na <= b >= c != d");
}

