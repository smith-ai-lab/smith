    check_golden(
        "tests/front/parse_expr/errors.txt",
        "a +\n)\n(a + b\nf(a, \nxs[1\na ? b\nx.\n.\n18446744073709551616\n\"\\q\"\n'ab'\n'\\xfff'\n(a, b)\n"
        "xs[a, b]\n(I32 (*)(I32))x\n[x\n[]\n[] 1\nsizeof(Point\n}\n(c::size_t)x\n[](a, b) { }\nL\"w\"\nu'a'\nU\"x\"");
