// The examples in the plugin's skills (.agents/skills/*/SKILL.md) are compiled, not trusted. Every fenced block whose
// info string is exactly `smith` is a complete file: it is written to a folder of its own per skill (a block that
// starts `module a::b;` goes to a/b.smith, as the path rule needs; the others to example-N.smith), the headers of the
// skill's modules are made (`smith cc --smith-header`, as `smith build` does, twice so that a module may import
// another), and every file is syntax-checked with `smith cc -fsyntax-only` and warnings as errors. A block marked
// `smith fragment` is part of a file and is skipped; C is `c`. Also checked, so that an example teaches the idiom: a
// complete `smith` block has no #include, #define, or standard C type (uint32_t, size_t...), and a `c` block has no
// `module`, `import` or `c::`. There is a test for each skill that has such a block, `skill_case("<skill>")`; a
// skill that gets its first block needs one: `test_every_skill_with_a_block_has_a_test` says which.
module skills_test;

import smith::arena;
import smith::env;
import smith::files;
import smith::format;
import smith::test;
import <string.h>;
import scratch;
import smith::mem;

constexpr usize modules_max = 32;
constexpr usize memory_size = (usize)16 << 20; // 16 MiB: a test's texts, given back with its memory

// The modules a skill's complete blocks make: the file each is placed in and the line of its fence.
typedef struct {
    const char *paths[modules_max];
    usize lines[modules_max];
    usize count;
} Placed;

// The idiom a complete block follows: no preprocessor line, no standard C type name (no match is the pass).
constexpr char c_renamed[_] = "grep -nE '^[[:space:]]*#[[:space:]]*(include|define)|"
                              "\\<(u?int(8|16|32|64)_t|size_t|ptrdiff_t)\\>' raw";

// What a block is, from its info string.
typedef enum { Block_Smith, Block_Fragment, Block_C, Block_Bad, Block_Other } Block;

static Block block_of(const char *info) {
    if (c::strcmp(info, "smith") == 0) return Block_Smith;
    if (c::strcmp(info, "smith fragment") == 0) return Block_Fragment;
    if (c::strcmp(info, "c") == 0) return Block_C;
    return c::strncmp(info, "smith", 5) == 0 ? Block_Bad : Block_Other;
}

static const char *where(const char *name, usize line) {
    return format::push(name, "/SKILL.md:", line).data;
}

// A `c` block holds no .smith.
static void check_c_block(const scratch::Project *p, const char *name, usize line, const char *body) {
    scratch::write(p, "raw", body);
    scratch::Run run = scratch::sh(p, "grep -nE '^(module|import) |c::' raw");
    scratch::expect_status(format::push(where(name, line), ": a c block holds .smith (tag it smith)").data, 1, &run);
}

// A complete `smith` block is placed in the file its module line implies (example-N.smith without one), and is not
// C renamed.
static void place_smith_block(const scratch::Project *p, const char *name, usize line, const char *body,
                              Placed *placed) {
    const char *label = where(name, line);
    scratch::write(p, "raw", body);
    scratch::Run renamed = scratch::sh(p, c_renamed);
    scratch::expect_status(format::push(label, ": a smith block is C renamed (see smith-idiom)").data, 1, &renamed);
    if (renamed.status == 0) return;
    const char *module = scratch::capture(p, "sed -n 's/^module \\([A-Za-z0-9_:]*\\);.*/\\1/p' raw | head -n 1");
    const char *path =
        module[0] != '\0'
            ? format::push(scratch::capture(p, format::push("printf '%s' '", module, "' | sed 's|::|/|g'").data),
                           ".smith")
                  .data
            : format::push("example-", line, ".smith").data;
    bool twice = scratch::exists(p, path);
    if (twice) test::note("%s: module %s is defined by two blocks", label, module);
    test::check_condition(!twice);
    if (twice || placed->count == modules_max) return;
    scratch::Run copied =
        scratch::sh(p, format::push("mkdir -p \"$(dirname '", path, "')\" && cp raw '", path, "'").data);
    scratch::expect_status(label, 0, &copied);
    placed->paths[placed->count] = path;
    placed->lines[placed->count] = line;
    placed->count++;
}

// The next line of the text, in place: its end, past the newline.
static const char *line_end(const char *at) {
    const char *end = c::strchr(at, '\n');
    return end != nullptr ? end + 1 : at + c::strlen(at);
}

// Walks the fenced blocks of the file SKILL.md in the project: the `c` blocks are checked and the complete `smith`
// blocks are placed.
static void walk_blocks(arena::Arena *arena, const scratch::Project *p, const char *name, Placed *placed) {
    const char *at = scratch::read(p, "SKILL.md");
    char *body = arena::push_slice(arena, char, c::strlen(at) + 1).data;
    bool open = false;
    usize indent = 0;
    usize used = 0;
    usize fence = 0;
    Block kind = Block_Other;
    for (usize number = 1; *at != '\0'; number++) {
        const char *next = line_end(at);
        usize spaces = 0;
        while (at[spaces] == ' ') {
            spaces++;
        }
        if (c::strncmp(at + spaces, "```", 3) == 0) {
            if (!open) {
                usize length = (usize)(next - at) - spaces - 3;
                while (length > 0 && (at[spaces + 2 + length] == '\n' || at[spaces + 2 + length] == ' ')) {
                    length--;
                }
                char *info = arena::push_slice(arena, char, length + 1).data;
                mem::copy(info[0:length], at[spaces + 3:spaces + 3 + length]);
                kind = block_of(info);
                if (kind == Block_Bad) {
                    test::note("%s: unknown info string: must be exactly 'smith' or 'smith fragment', not '%s'",
                               where(name, number), info);
                    test::check_condition(false);
                }
                open = true;
                indent = spaces;
                fence = number;
                used = 0;
            } else {
                open = false;
                body[used] = '\0';
                if (kind == Block_C) check_c_block(p, name, fence, body);
                if (kind == Block_Smith) place_smith_block(p, name, fence, body, placed);
            }
        } else if (open) {
            usize skip = 0;
            while (skip < indent && at[skip] == ' ') {
                skip++;
            }
            usize length = (usize)(next - at) - skip;
            mem::copy(body[used:used + length], at[skip:skip + length]);
            used += length;
        }
        at = next;
    }
}

// The headers of the skill's modules, twice: the second pass has the headers the first made.
constexpr char headers_script[_] =
    "mkdir -p .smith/include; flags=\"-I $SMITH_REPO/.smith/include -I $PWD/.smith/include -I $PWD\"; "
    "for pass in 1 2; do while read -r path; do "
    "module=$(sed -n 's/^module \\([A-Za-z0-9_:]*\\);.*/\\1/p' \"$path\" | head -n 1); [ -n \"$module\" ] || continue; "
    "header=$PWD/.smith/include/$(printf '%s' \"$module\" | sed 's|::|/|g').h; mkdir -p \"$(dirname \"$header\")\"; "
    "smith cc --smith-header \"$path\" -o \"$header\" $flags >/dev/null 2>&1 || :; done <modules; done";

// A file with no `module` line is a program's file or a test's: smith build declares the tests there, and a `main`
// needs no prototype, so only a module's own functions are held to -Wmissing-prototypes.
static void check_module(const scratch::Project *p, const char *name, const char *path, usize line) {
    const char *strict = c::strncmp(path, "example-", 8) == 0 ? "-Wno-missing-prototypes" : "-Wmissing-prototypes";
    const char *command =
        format::push("flags=\"-I $SMITH_REPO/.smith/include -I $PWD/.smith/include -I $PWD\"; ",
                     "smith cc -fsyntax-only -std=gnu2y ", strict,
                     " -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Wimplicit-fallthrough "
                     "-Wstrict-prototypes -Wvla -Werror $flags '",
                     path,
                     "' 2>&1 && smith lint --quiet --checks=\"-*,smith-preprocessor,smith-sized-types,"
                     "smith-module-library,smith-bounded-loop,smith-c23,smith-constexpr\" '",
                     path, "' -- -std=gnu2y $flags 2>&1")
            .data;
    scratch::Run run = scratch::sh(p, command);
    scratch::expect_status(format::push(where(name, line), " (", path, ")").data, 0, &run);
}

// The test of one skill: its project, then its memory as the current allocator, so that what scratch returns (a Run's
// texts, a file read) is given back with that memory; scratch::clean frees what make holds.
static void skill_case(const char *name) {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    scratch::copy_tree(&p, format::push(".agents/skills/", name, "/SKILL.md").data, "SKILL.md");
    Placed placed = {};
    walk_blocks(arena, &p, name, &placed);
    if (placed.count == 0) return;
    for (usize i = 0; i < placed.count; i++) {
        const char *path = placed.paths[i];
        scratch::write(&p, "modules", format::push(scratch::read(&p, "modules"), path, "\n").data);
    }
    scratch::Run headers = scratch::sh(&p, headers_script);
    scratch::expect_status("the headers", 0, &headers);
    for (usize i = 0; i < placed.count; i++) {
        check_module(&p, name, placed.paths[i], placed.lines[i]);
    }
}

// Whether the text has a fence line "```c" or "```smith" (spaces before it, anything after a space), but not one that
// ends in "smith fragment".
static bool has_code_block(const char *text) {
    const char *line = text;
    for (usize guard = 0; guard < 100000 && *line != '\0'; guard++) { // each round is a line
        const char *end = c::strchr(line, '\n');
        usize length = end != nullptr ? (usize)(end - line) : c::strlen(line);
        usize at = 0;
        while (at < length && line[at] == ' ')
            at++;
        if (length - at >= 3 && c::strncmp(line + at, "```", 3) == 0) {
            const char *info = line + at + 3;
            usize info_length = length - at - 3;
            usize word = 0;
            while (word < info_length && info[word] != ' ')
                word++;
            bool code = (word == 1 && info[0] == 'c') || (word == 5 && c::strncmp(info, "smith", 5) == 0);
            bool fragment = info_length >= 14 && c::strncmp(info + info_length - 14, "smith fragment", 14) == 0;
            if (code && !fragment) return true;
        }
        if (end == nullptr) break;
        line = end + 1;
    }
    return false;
}

// A file of the repository as a terminated text in the arena, or nullptr when it cannot be read.
static const char *repo_file(arena::Arena *arena, const char *repo, const char *path, const char *name) {
    const char *full = format::push(repo, path, name).data;
    files::BytesResult file = files::read_file(full[0:c::strlen(full)]);
    switch (file) {
    case .error:
        return nullptr;
    case .ok:
        char *text = arena::push_slice(arena, char, countof(file.ok) + 1).data;
        for (usize i = 0; i < countof(file.ok); i++) {
            text[i] = (char)file.ok[i];
        }
        text[countof(file.ok)] = '\0';
        return text;
    }
}

// A skill with a `c` or `smith` block needs a test below. The folder and the files are read through smith::files, so a
// skill added to the folder selects the test.
export void test_every_skill_with_a_block_has_a_test() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    env::Value variable = env::get("SMITH_REPO");
    const char *repo = variable == .some ? format::push(variable.some).data : ".";
    const char *tests = repo_file(arena, repo, "/tests/skills_test.smith", "");
    test::check_condition(tests != nullptr);
    const char *folder = format::push(repo, "/.agents/skills").data;
    files::EntriesResult listed = files::list(folder[0:c::strlen(folder)]);
    files::Entries skills = {};
    switch (listed) {
    case .ok:
        skills = listed.ok;
        break;
    case .error:
        test::check_condition(false); // ends the test
    }
    const char *missing = "";
    for (usize i = 0; i < countof(skills); i++) {
        const char *name = skills[i].name.data;
        const char *skill = repo_file(arena, repo, "/.agents/skills/", format::push(name, "/SKILL.md").data);
        if (skill == nullptr || !has_code_block(skill)) continue;
        const char *wanted = format::push("skill_case(\"", name, "\")").data;
        if (c::strstr(tests, wanted) == nullptr) {
            missing = format::push(missing, name, "\n").data;
        }
    }
    scratch::expect_text("skills with a block and no test in tests/skills_test.smith", "", missing);
}

