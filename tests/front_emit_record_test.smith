// Tests of anonymous structs and unions used as types in the emitter (#2984 of #1631): the inline payload of an
// enumeration's variant, built, matched and read; a field whose type is an anonymous struct; a nest of them; an
// anonymous union; a payload whose field is a type parameter; and the messages of what is not emitted. Each scenario
// is source text in smith's own syntax, checked by front::types_decl and emitted, then run through the JIT.
module front_emit_record_test;

import front::ast;
import front::emit;
import front::emit_jit;
import front::emit_state;
import front::lex;
import front::parse;
import front::parse_decl;
import front::parse_expr;
import front::parse_stmt;
import front::parse_type;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;
import <llvm-c/Core.h>;

struct Scenario {
    arena::Arena memory;
    arena::ArenaAllocator allocator;
    parser::Parsed parsed;
    types::Checked checked;
};

static void begin(Scenario *s, Str source) {
    s->memory = test::memory(1U << 22);
    s->allocator = arena::allocator(&s->memory);
    mem::Allocator *outside = mem::set_allocator(&s->allocator.base);
    s->parsed = parser::parse_new("t.smith", source);
    test::check_equal(countof(s->parsed.errors), (Usize)0);
    s->checked = types_decl::check_module(&s->parsed.module, types::lp64());
    test::check_equal(s->checked.error_count, (Usize)0);
    if (s->checked.error_count > 0) test::check_equal(s->checked.errors[0].message, "no error");
    mem::set_allocator(outside);
}

static emit_jit::Jit start_jit() {
    emit_jit::JitResult started = emit_jit::start();
    test::check_equal(started == .ok, true);
    emit_jit::Jit host = {};
    if (started == .ok) host = started.ok;
    return host;
}

static Bool contains(const char *text, Str needle) {
    return text != nullptr && c::strstr(text, needle.data) != nullptr;
}

static Usize symbol_of(emit_jit::Jit *host, Str symbol) {
    emit_jit::AddressResult found = emit_jit::lookup(host, symbol);
    test::check_equal(found == .ok, true);
    Usize address = 0;
    if (found == .ok) address = found.ok;
    return address;
}

// Emits `source` with the checker's types, returns its IR text and adds it to `host`.
static char *ir_of(Str source, emit_jit::Jit *host, Scenario *s) {
    begin(s, source);
    c::LLVMContextRef context = c::LLVMContextCreate();
    emit::Options options = {.target = host->target, .checked = &s->checked};
    emit::ModuleResult emitted = emit::module(context, &s->parsed.module, options);
    test::check_equal(emitted == .ok, true);
    char *text = nullptr;
    if (emitted == .ok) {
        text = c::LLVMPrintModuleToString(emitted.ok);
        emit_jit::BoolResult added = emit_jit::add(host, context, emitted.ok);
        test::check_equal(added == .ok, true);
    } else {
        test::check_equal(emitted.error.message, "no error");
        emit::free_error(emitted.error);
    }
    return text;
}

typedef I64 (*Read)(I32);

// The inline payloads of front/ast.smith: a variant whose payload is `struct { ... }`, built by name and read back by
// `match` and by a field of the variant.
export void test_front_emit_record_an_inline_payload_is_built_matched_and_read() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    char *ir = ir_of("typedef enum {\n"
                     "    struct {\n"
                     "        i32 a;\n"
                     "        i64 b;\n"
                     "    } pair;\n"
                     "    struct {\n"
                     "        bool flag;\n"
                     "    } one;\n"
                     "    empty\n"
                     "} Kind;\n"
                     "fn make(n: i32) -> Kind:\n"
                     "    if n == 0:\n"
                     "        return Kind(one = (flag = true))\n"
                     "    if n < 0:\n"
                     "        return .empty\n"
                     "    Kind(pair = (a = n, b = 100))\n"
                     "pub fn read(n: i32) -> i64:\n"
                     "    k := make(n)\n"
                     "    match k:\n"
                     "        .pair(p): p.a.to(i64) + p.b\n"
                     "        .one(o): if o.flag: 7 else: 8\n"
                     "        .empty: -1\n"
                     "pub fn field(n: i32) -> i64:\n"
                     "    k := make(n)\n"
                     "    if k != .pair:\n"
                     "        return 0\n"
                     "    k.pair.b - k.pair.a.to(i64)\n",
                     &host, &s);
    test::check_equal(ir != nullptr, true);
    test::check_equal(contains(ir, "struct { a: i32; b: i64; }"), true);
    Read read = (Read)symbol_of(&host, "read");
    Read field = (Read)symbol_of(&host, "field");
    test::check_equal(read(5), (I64)105);
    test::check_equal(read(0), (I64)7);
    test::check_equal(read(-3), (I64)-1);
    test::check_equal(field(30), (I64)70);
    test::check_equal(field(0), (I64)0);
    emit_jit::stop(&host);
}

// A field of a record whose type is an anonymous struct, a nest of two, copied and passed by value.
export void test_front_emit_record_a_field_of_anonymous_struct_type_is_copied_and_passed_by_value() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    char *ir = ir_of("struct Box:\n"
                     "    inner: struct {\n"
                     "        i32 x;\n"
                     "        struct {\n"
                     "            i64 deep;\n"
                     "        } more;\n"
                     "    }\n"
                     "    tag: i32\n"
                     "fn sum(b: Box) -> i64:\n"
                     "    b.inner.x.to(i64) + b.inner.more.deep + b.tag.to(i64)\n"
                     "pub fn run(n: i32) -> i64:\n"
                     "    mut b: Box = undefined\n"
                     "    b.inner.x = n\n"
                     "    b.inner.more.deep = 1000\n"
                     "    b.tag = 1\n"
                     "    c := b\n"
                     "    b.inner.x = 0\n"
                     "    sum(c)\n",
                     &host, &s);
    test::check_equal(ir != nullptr, true);
    Read run = (Read)symbol_of(&host, "run");
    test::check_equal(run(20), (I64)1021);
    emit_jit::stop(&host);
}

// An anonymous union: every member at offset 0 of storage as big as the biggest, as a C union is.
export void test_front_emit_record_an_anonymous_union_shares_its_storage() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    char *ir = ir_of("struct Word:\n"
                     "    bits: union {\n"
                     "        u64 whole;\n"
                     "        u8 low;\n"
                     "    }\n"
                     "pub fn low(n: i32) -> i64:\n"
                     "    mut w: Word = undefined\n"
                     "    w.bits.whole = n.to(u64) + 256\n"
                     "    w.bits.low.to(i64)\n",
                     &host, &s);
    test::check_equal(ir != nullptr, true);
    test::check_equal(contains(ir, "union { whole: u64; low: u8; }"), true);
    Read low = (Read)symbol_of(&host, "low");
    test::check_equal(low(5), (I64)5);
    emit_jit::stop(&host);
}
