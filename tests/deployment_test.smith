// The floor of smith's own binary (#802, knowledge/deployment-target.md): built for macOS 26 and newer whatever macOS
// built it, so the release runs on the Macs people have and on the hosted runners. Reads the load commands of the
// smith under test, `$SMITH_SELF`.
// smith-covers: build.c smith.c runtime/platform_*.c
module deployment_test;

import std::arena;
import std::mem;
import std::test;
import scratch;
import target;

export void test_deployment_smith_runs_on_macos_26() {
    if constexpr (target::os == target::macos) { // on Linux there is no minos to read
        scratch::Project p = scratch::make("deployment", nullptr);
        defer scratch::clean(&p);
        arena::Arena memory = test::memory((Usize)1 << 20);
        arena::ArenaAllocator allocator = arena::allocator(&memory);
        mem::Allocator *outside = mem::set_allocator(&allocator.base);
        defer mem::set_allocator(outside);
        scratch::expect_text("minos: the oldest macOS smith runs on", "26.0",
                             scratch::capture(&p, "otool -l \"$SMITH_SELF\" | grep -A4 LC_BUILD_VERSION | "
                                                  "sed -n 's/^ *minos //p'"));
    }
}
