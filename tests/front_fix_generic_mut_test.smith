// Tests of the fix-it for a local that a generic function's body assigns (#2613): `total := 0` followed by
// `total += x` is written `mut total`, a member assigned through a plain value type too; a pointer's member is not.
module front_fix_generic_mut_test;

import front::fix;
import std::arena;
import std::mem;
import std::test;

static void expect_fixed(Str before, Str want) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed first = fix::fix_text("t.smith", before);
    test::check_equal(first.text, want);
}

export void test_front_fix_generic_mut_a_local_that_is_added_to_is_mut() {
    expect_fixed("module m;\nexport I32 total(auto... rest) {\n    I32 acc = 0;\n    for constexpr (auto x : rest) {\n"
                 "        acc += (I32)x;\n    }\n    return acc;\n}\n",
                 "pub fn total(rest...) -> i32:\n    mut acc: i32 = 0\n    for x in rest:\n        acc += x.to(i32)\n"
                 "    return acc\n");
}

export void test_front_fix_generic_mut_a_local_that_is_only_read_stays() {
    expect_fixed("module m;\nexport I32 first(auto xs) {\n    I32 n = 3;\n    return n + (I32)xs[0];\n}\n",
                 "pub fn first(xs: auto) -> i32:\n    n: i32 = 3\n    return n + xs[0].to(i32)\n");
}

export void test_front_fix_generic_mut_a_pointer_parameter_written_through_is_mut() {
    expect_fixed("module m;\nexport void fill(char *buffer, auto x) {\n    buffer[0] = (char)x;\n}\n",
                 "pub fn fill(buffer: *mut char, x: auto):\n    buffer[0] = x.to(char)\n");
}

export void test_front_fix_generic_mut_a_pointer_parameter_only_read_stays() {
    expect_fixed(
        "module m;\nexport Usize peek(const char *buffer, auto x) {\n    return (Usize)buffer[0] + (Usize)x;\n}\n",
        "pub fn peek(buffer: *char, x: auto) -> usize:\n    return buffer[0].to(usize) + x.to(usize)\n");
}

export void test_front_fix_generic_mut_a_pointer_handed_to_a_mut_field_in_a_pack_function_is_mut() {
    expect_fixed("module m;\nexport typedef struct {\n    char *out;\n    Usize capacity;\n} Writer;\n\n"
                 "static void put(Writer *writer, char c) {\n    writer->out[0] = c;\n}\n\n"
                 "export Usize write(char *buffer, Usize capacity, auto... args) {\n"
                 "    Writer writer = {buffer, capacity};\n    put(&writer, 'a');\n    return writer.capacity;\n}\n",
                 "pub struct Writer:\n    pub out: *mut char\n    pub capacity: usize\n\n"
                 "fn put(writer: *Writer, c: char):\n    writer.out[0] = c\n\n"
                 "pub fn write(buffer: *mut char, capacity: usize, args...) -> usize:\n"
                 "    writer := Writer(buffer, capacity)\n    put(&writer, 'a')\n    return writer.capacity\n");
}

export void test_front_fix_generic_mut_an_index_loop_over_a_pack_is_a_loop_over_its_elements() {
    expect_fixed(
        "module m;\nexport I32 total(auto... rest) {\n    I32 sum = 0;\n"
        "    for constexpr (Usize i = 0; i < countof(rest); i++)\n        sum += (I32)rest[i];\n    return sum;\n}\n",
        "pub fn total(rest...) -> i32:\n    mut sum: i32 = 0\n    for arg in rest:\n"
        "        sum += arg.to(i32)\n    return sum\n");
}

export void test_front_fix_generic_mut_an_index_loop_over_fields_names_each_field() {
    expect_fixed(
        "module m;\nexport F64 add_all(auto value) {\n    F64 total = 0;\n"
        "    for constexpr (Usize i = 0; i < countof(fields(typeof(value))); i++) {\n"
        "        if constexpr (is_float(typeof(value.[fields(typeof(value))[i]]))) {\n"
        "            total += (F64)value.[fields(typeof(value))[i]];\n        }\n    }\n    return total;\n}\n",
        "pub fn add_all(value: auto) -> f64:\n    mut total: f64 = 0\n    for f in fields(typeof(value)):\n"
        "        if is_float(typeof(value.[f])):\n            total += value.[f].to(f64)\n    return total\n");
}

export void test_front_fix_generic_mut_an_index_loop_that_uses_the_index_enumerates() {
    expect_fixed(
        "module m;\nexport I32 weighted(auto... rest) {\n    I32 weights[3] = {1, 2, 3};\n    I32 sum = 0;\n"
        "    for constexpr (Usize i = 0; i < countof(rest); i++) {\n        sum += (I32)rest[i] * weights[i];\n"
        "    }\n    return sum;\n}\n",
        "pub fn weighted(rest...) -> i32:\n    weights: [3]i32 = [1, 2, 3]\n    mut sum: i32 = 0\n"
        "    for (i, arg) in enumerate(rest):\n        sum += arg.to(i32) * weights[i]\n    return sum\n");
}

export void test_front_fix_generic_mut_a_parameter_the_body_assigns_is_mut() {
    expect_fixed("module m;\nexport void walk(auto p, Usize n) {\n    while (n > 0) {\n        p += 1;\n        n -= "
                 "1;\n    }\n}\n",
                 "pub fn walk(mut p: auto, mut n: usize):\n    while n > 0:\n        p += 1\n        n -= 1\n");
}

export void test_front_fix_generic_mut_the_field_bound_in_an_index_loop_names_the_loop() {
    expect_fixed(
        "module m;\nexport void each(auto v) {\n"
        "    for constexpr (Usize i = 0; i < countof(fields(typeof(v))); i++) {\n"
        "        constexpr Field f = fields(typeof(v))[i];\n        (void)f;\n        sink(v.[f]);\n    }\n}\n",
        "pub fn each(v: auto):\n    for f in fields(typeof(v)):\n        _ := f\n        sink(v.[f])\n");
}

// A function whose slice parameter is of `auto` elements (`const auto xs[:]`) is a template too: its assigned local is
// `mut`.
export void test_front_fix_generic_mut_a_slice_of_auto_makes_the_function_a_template() {
    expect_fixed("module m;\nexport I64 total(const auto xs[:]) {\n    I64 sum = 0;\n"
                 "    for (Usize i = 0; i < countof(xs); i++)\n        sum += xs[i];\n    return sum;\n}\n",
                 "pub fn total[T](xs: []T) -> i64:\n    mut sum: i64 = 0\n    for i in range(0, countof(xs)):\n"
                 "        sum += xs[i]\n    return sum\n");
}

export void test_front_fix_generic_mut_an_index_loop_over_fields_that_uses_the_index_enumerates() {
    expect_fixed("module m;\nexport void names(auto value) {\n"
                 "    for constexpr (Usize i = 0; i < countof(fields(typeof(value))); i++) {\n"
                 "        constexpr const Field f = fields(typeof(value))[i];\n        if (i > 0) put(\", \");\n"
                 "        put(f.name);\n    }\n}\n",
                 "pub fn names(value: auto):\n    for (i, f) in enumerate(fields(typeof(value))):\n        if i > 0:\n"
                 "            put(\", \")\n        put(f.name)\n");
}

// A pointer parameter whose name is longer than the rest of the body is not a slice past the end of the source.
export void test_front_fix_generic_mut_a_long_pointer_name_in_a_short_body_does_not_overrun() {
    expect_fixed("module m;\nexport I32 view(auto xs, void *memory, Usize n) {\n    return xs;\n}\n",
                 "pub fn view(xs: auto, memory: *void, n: usize) -> i32:\n    return xs\n");
}

export void test_front_fix_generic_mut_the_first_line_of_a_body_in_the_new_syntax_is_a_statement() {
    expect_fixed(
        "struct P:\n    width: usize\n\npub fn make(piece: auto, width: usize) -> P:\n    padded: P = P(width = 0)\n"
        "    padded.width = width\n    return padded\n",
        "struct P:\n    width: usize\n\npub fn make(piece: auto, width: usize) -> P:\n    mut padded: P = P(width = "
        "0)\n"
        "    padded.width = width\n    return padded\n");
}

export void test_front_fix_generic_mut_a_result_literal_in_a_generic_body_is_a_variant() {
    expect_fixed("enum Error:\n    bad\n\npub fn read(x: auto) -> Result(i32, Error):\n    if x == 0:\n"
                 "        return {.error = .bad}\n    return {.ok = x}\n",
                 "enum Error:\n    bad\n\npub fn read(x: auto) -> Result(i32, Error):\n    if x == 0:\n"
                 "        return .error(.bad)\n    return .ok(x)\n");
}

export void test_front_fix_generic_mut_a_result_literal_in_a_type_generic_is_a_variant() {
    expect_fixed("enum Error:\n    bad\n\npub fn read(x: i32, T: type) -> Result(T, Error):\n    if x == 0:\n"
                 "        return {.error = .bad}\n    return {.ok = x.to(T)}\n",
                 "enum Error:\n    bad\n\npub fn read(x: i32, T: type) -> Result(T, Error):\n    if x == 0:\n"
                 "        return .error(.bad)\n    return .ok(x.to(T))\n");
}

// A local handed to a `*mut` parameter in a generic body that no call of the module instantiates (#2992): the checker
// never types the call, so the fix is made from the text.
export void test_front_fix_generic_mut_a_pointer_local_handed_to_a_mut_parameter_is_mut() {
    expect_fixed("module m;\nstatic Usize fill(char *out, Usize n) {\n    out[0] = 'a';\n    return n;\n}\n\n"
                 "export Usize push(auto... args) {\n    char *memory = (char *)0;\n"
                 "    return fill(memory, countof(args));\n}\n",
                 "fn fill(out: *mut char, n: usize) -> usize:\n    out[0] = 'a'\n    return n\n\n"
                 "pub fn push(args...) -> usize:\n    memory: *mut char = 0.cast(*mut char)\n"
                 "    return fill(memory, countof(args))\n");
}

export void test_front_fix_generic_mut_a_value_local_whose_address_goes_to_a_mut_parameter_is_mut() {
    expect_fixed("module m;\ntypedef struct {\n    char *out;\n    Usize capacity;\n    Usize n;\n} Counter;\n\n"
                 "static void bump(Counter *counter, Usize by) {\n    counter->n += by;\n}\n\n"
                 "export Usize count(char *buffer, Usize capacity, auto... args) {\n"
                 "    Counter counter = {buffer, capacity, 0};\n"
                 "    bump(&counter, countof(args));\n    return counter.n;\n}\n",
                 "struct Counter:\n    out: *char\n    capacity: usize\n    n: usize\n\n"
                 "fn bump(counter: *mut Counter, by: usize):\n    counter.n += by\n\n"
                 "pub fn count(buffer: *char, capacity: usize, args...) -> usize:\n"
                 "    mut counter := Counter(buffer, capacity, 0)\n"
                 "    bump(&counter, countof(args))\n    return counter.n\n");
}
