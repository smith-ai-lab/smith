// Tests of the fix-it for a pointer parameter that is handed an option (#2648): a function that tests its pointer
// parameter against `nullptr` and is called with a field that is `?*T` takes `?*T`.
module front_fix_optional_test;

import front::fix;
import std::arena;
import std::format;
import std::mem;
import std::test;

static void check_text(Str got, Str want) {
    test::check_equal(got, want);
}

static Str as_str(char chars[:]) {
    return chars;
}

static Str fixed_text(Str source) {
    fix::Fixed fixed = fix::fix_text("t.smith", source);
    return fixed.text;
}

export void test_front_fix_optional_a_tested_parameter_handed_an_option_is_an_option() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str got = fixed_text("module m;\nstruct Node {\n    Node *next;\n    U32 v;\n};\n"
                         "static U32 size(Node *old) {\n    if (old == nullptr) {\n        return 0;\n    }\n"
                         "    return old->v;\n}\n"
                         "static U32 f(Node *n) {\n    if (n->next == nullptr) {\n        return 0;\n    }\n    return "
                         "size(n->next);\n}\n"
                         "static Node make() {\n    Node n = {.v = 1};\n    return n;\n}\n");
    check_text(got, "struct Node:\n    next: ?*Node = .none\n    v: u32\nfn size(old: ?*Node) -> u32:\n"
                    "    if old == .none:\n        return 0\n    return old.v\nfn f(n: *Node) -> u32:\n"
                    "    if n.next == .none:\n        return 0\n    return size(n.next)\nfn make() -> Node:\n"
                    "    n := Node(v = 1)\n    return n\n");
}

export void test_front_fix_optional_an_assigned_option_parameter_is_read_through_a_local() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str got = fixed_text("fn skip(mut old: ?*mut Node) -> *mut Node:\n    if old == .none:\n        return nullptr\n"
                         "    while old.v == 0:\n        old = old.next\n    return old\n");
    check_text(got, "fn skip(old: ?*mut Node) -> *mut Node:\n    if old == .none:\n        return nullptr\n"
                    "    mut old_some: *mut Node = old\n    while old_some.v == 0:\n        old_some = old_some.next\n"
                    "    return old_some\n");
}

// There is no `x.some` (#3083): a narrowed name is the value, and an option field tested with `.some` is bound.
export void test_front_fix_optional_a_some_read_is_the_value() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    check_text(fixed_text("fn get(o: ?i32) -> i32:\n    if o != .none:\n        return o.some\n    0\n"),
               "fn get(o: ?i32) -> i32:\n    if o != .none:\n        return o\n    0\n");
    Str box = "struct Box:\n    v: ?i32\n";
    check_text(fixed_text(as_str(format::push(box, "fn read(b: Box) -> i32:\n    if b.v == .some:\n"
                                                   "        return b.v.some\n    0\n"))),
               as_str(format::push(box, "fn read(b: Box) -> i32:\n    if v := b.v:\n        return v\n    0\n")));
}

// A `mut` name narrows like any other (#3438): the read of its payload loses `.some`, no copy is named.
export void test_front_fix_optional_a_mut_option_is_narrowed_by_its_test() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    check_text(fixed_text("fn read() -> i32:\n    i: ?i32 = find(1)\n    mut j: ?i32 = .none\n    j = find(2)\n"
                          "    if i != .none and j != .none:\n        return i + j.some\n    0\n"),
               "fn read() -> i32:\n    i: ?i32 = find(1)\n    mut j: ?i32 = .none\n    j = find(2)\n"
               "    if i != .none and j != .none:\n        return i + j\n    0\n");
}

export void test_front_fix_optional_a_match_arm_binds_the_option_value() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    check_text(fixed_text("fn read(n: ?i32) -> i32:\n    match n:\n        .some: n.some\n        .none: 0\n"),
               "fn read(n: ?i32) -> i32:\n    match n:\n        .some(some): some\n        .none: 0\n");
}

export void test_front_fix_optional_an_error_read_binds_error_value_where_error_is_a_local() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    check_text(
        fixed_text("struct Err:\n    code: i32\nfn failure(emitted: Result(i32, Err)) -> Err:\n"
                   "    mut error: Err = Err(code = 0)\n    if emitted == .error:\n        error = emitted.error\n"
                   "    error\n"),
        "struct Err:\n    code: i32\nfn failure(emitted: Result(i32, Err)) -> Err:\n"
        "    mut error: Err = Err(code = 0)\n    if .error(error_value) := emitted:\n"
        "        error = error_value\n    error\n");
}

// An option used as a value under its test (#3228): a `mut` name narrows, so the value is read as it is (#3438).
export void test_front_fix_optional_a_mut_option_used_as_a_value_under_its_test_is_read_as_it_is() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    check_text(fixed_text("fn second() -> usize:\n    mut c: Option(usize) = .some(3)\n    c = .none\n"
                          "    if c == .none:\n        c = .some(4)\n    if c != .none:\n        return c\n    0\n"),
               "fn second() -> usize:\n    mut c: Option(usize) = .some(3)\n    c = .none\n"
               "    if c == .none:\n        c = .some(4)\n    if c != .none:\n        return c\n    0\n");
}

// A function held in an option field is named first, the copy is tested and called (#3230).
export void test_front_fix_optional_a_call_of_an_option_field_is_named_before_its_test() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str shape = "struct E:\n    hook: ?fn(i32) -> i32 = .none\n";
    check_text(fixed_text(as_str(format::push(shape, "fn run(e: E, x: i32) -> i32:\n    if e.hook != .none:\n"
                                                     "        return e.hook(x)\n    0\n"))),
               as_str(format::push(shape, "fn run(e: E, x: i32) -> i32:\n    hook := e.hook\n"
                                          "    if hook != .none:\n        return hook(x)\n    0\n")));
}

// A parameter of option type that a test narrows is called directly (#3230).
export void test_front_fix_optional_a_tested_option_parameter_is_called_directly() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source =
        "fn run(hook: ?fn(i32) -> i32, x: i32) -> i32:\n    if hook != .none:\n        return hook(x)\n    0\n";
    check_text(fixed_text(source), source);
}
