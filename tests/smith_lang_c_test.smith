// Plain C in a .smith file means exactly what it means in a .c file: smith's own C sources, renamed to .smith, compile
// to the same code. Each source is compiled twice with the same flags, once as x.c and once as x.smith (in a copy of
// the tree, so that its #includes find what they found), and the two results must be identical. They are compared as
// assembly (-S), which is stricter than objects and shows where they differ; the one thing that may differ is the
// file's own name, where a program prints it (its extension): __FILE__ is set to one name, and the file's own name with
// ".smith" in a string is read as ".c" (only its own: other strings that end in ".smith" are code, and must match).
// Then each program in tests/smith-lang-c/ (array parameters and sizeof of one, a [*] prototype, the language's words
// as names, ordinary constructs, text arrays and `?:` in brackets, which run-time arrays must leave alone) is built and
// run as x.c and as x.smith, and both must print what x.out holds.
module smith_lang_c_test;

import smith::format;
import smith::io;
import smith::test;
import <string.h>;
import scratch;

constexpr char flags[] = "-std=gnu23 -O1 -g0 -Wno-builtin-macro-redefined -D'__FILE__=\"unit\"' -I include";
constexpr char in_process[] =
    "-DSMITH_IN_PROCESS -D'SMITH_CLANG_RESOURCE=\"tests/stub.c\"' -D'SMITH_CLANG_ID=\"llvm-0 0\"'";

static typeof(const char[:]) slice_of(const char *text) {
    return text[0:c::strlen(text)];
}

static const char *text(const scratch::Project *p, const char *a, const char *b, const char *c, const char *d) {
    return format::push(&p->io->arena, a, b, c, d).data;
}

// The sources are compiled in a copy of the tree, where a renamed file sits beside the original.
static scratch::Project tree_project(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run copied = scratch::sh(
        &p, "mkdir tree && for item in smith.c build.c include lib runtime scripts templates tests shim; do "
            "cp -R \"$SMITH_REPO/$item\" tree/; done");
    scratch::expect_status("the tree is copied", 0, &copied);
    return p;
}

// The two files are compiled to assembly as `stem.c` and as `stem.smith` with the same flags, and must be identical.
static void compare(io::Io *io, const char *stem, const char *extra, bool from_smith) {
    scratch::Project p = tree_project(io);
    if (from_smith) {
        scratch::Run copied =
            scratch::sh(&p, format::push(&io->arena, "cp tree/", stem, ".smith tree/", stem, ".c").data);
        scratch::expect_status("the .smith is copied to .c", 0, &copied);
    }
    const char *base = stem;
    for (const char *slash = c::strchr(base, '/'); slash != nullptr; slash = c::strchr(base, '/'))
        base = slash + 1;
    // The file's own name in a string is read as ".c" on the lowered side; any other ".smith" in a string is code.
    scratch::write(&p, "own.sed",
                   format::push(&io->arena, "s|\\([^A-Za-z0-9_/.-]\\)", base, "\\.smith\"|\\1", base, ".c\"|g\n").data);
    scratch::write(&p, "messages.sed", "s/\\.c\\([: ]\\)/.smith\\1/g\n");
    const char *plain_command = format::push(&io->arena, "cd tree && smith cc ", flags, " ", extra, " -S ", stem,
                                             ".c -o ../plain.s 2> ../plain.err")
                                    .data;
    scratch::Run plain = scratch::sh(&p, plain_command);
    scratch::expect_status("the .c compiles", 0, &plain);
    const char *lowered_command =
        format::push(&io->arena, "cd tree && cp ", stem, ".c ", stem, ".smith && { smith cc ", flags, " ", extra,
                     " -S ", stem, ".smith -o ../lowered.s 2> ../lowered.err; s=$?; rm -f ", stem, ".smith; exit $s; }")
            .data;
    scratch::Run lowered = scratch::sh(&p, lowered_command);
    if (plain.status != lowered.status) {
        test::note("exit %d as .c, %d as .smith:\n%s", plain.status, lowered.status, scratch::read(&p, "lowered.err"));
    }
    test::check_equal(plain.status, lowered.status);
    if (plain.status == 0) {
        scratch::Run same = scratch::sh(&p, "sed -f own.sed lowered.s > lowered.n && cmp plain.s lowered.n");
        scratch::expect_status("the code is identical as .c and as .smith", 0, &same);
    }
    scratch::Run messages = scratch::sh(&p, "[ \"$(sed -f messages.sed plain.err)\" = \"$(cat lowered.err)\" ]");
    scratch::expect_status("the messages are the same", 0, &messages);
}

export void test_smith_c_compiles_the_same_as_smith(io::Io *io) {
    compare(io, "smith", in_process, false);
}

export void test_build_c_compiles_the_same_as_smith(io::Io *io) {
    compare(io, "build", "", false);
}

export void test_the_build_runtime_compiles_the_same_as_smith(io::Io *io) {
    compare(io, "runtime/build_runtime", "", false);
}

export void test_the_stub_compiles_the_same_as_smith(io::Io *io) {
    compare(io, "tests/stub", "-DNAME='\"stub\"'", false);
}

export void test_pack_compiles_the_same_as_smith(io::Io *io) {
    compare(io, "scripts/pack", "", false);
}

// scripts/stage0.smith is plain C for the system's clang; as a .c file it is the same program.
export void test_stage0_compiles_the_same_as_smith(io::Io *io) {
    compare(io, "scripts/stage0", "", true);
}

export void test_the_http_library_compiles_the_same_as_smith(io::Io *io) {
    compare(io, "lib/http", "", false);
}

// Not tests/random.c: it includes the lowering of random, and both print the name "random.c", which the compiler makes
// one string; as random.smith it is two, so the constants after it are numbered differently. (Nothing else differs.)
export void test_the_arena_test_compiles_the_same_as_smith(io::Io *io) {
    compare(io, "tests/arena", "", false);
}

export void test_the_io_test_compiles_the_same_as_smith(io::Io *io) {
    compare(io, "tests/io", "", false);
}

