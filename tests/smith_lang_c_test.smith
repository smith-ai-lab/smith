// Plain C in a .smith file means exactly what it means in a .c file: smith's own C sources, renamed to .smith, compile
// to the same code. Each source is compiled twice with the same flags, once as x.c and once as x.smith (in a copy of
// the tree, so that its #includes find what they found), and the two results must be identical. They are compared as
// assembly (-S), which is stricter than objects and shows where they differ; the one thing that may differ is the
// file's own name, where a program prints it (its extension): __FILE__ is set to one name, and the file's own name with
// ".smith" in a string is read as ".c" (only its own: other strings that end in ".smith" are code, and must match).
// Then each program in tests/smith-lang-c/ (array parameters and sizeof of one, a [*] prototype, the language's words
// as names, ordinary constructs, C's loops (no range `for`), text arrays and `?:` in brackets, which run-time arrays
// must leave alone) is built and run as x.c and as x.smith, and both must print what x.out holds.
module smith_lang_c_test;

import smith::format;
import smith::io;
import smith::test;
import <string.h>;
import scratch;

// -O0: the optimizer is the same for both and costs most of a compile (smith.c: 7.7 s of CPU at -O1, 1 s at -O0); code
// that is identical before it is identical after, and the cases that are about it say -O2.
constexpr char flags[_] =
    "-std=gnu23 -O0 -g0 -Wno-builtin-macro-redefined -D'__FILE__=\"unit\"' -I include -I .smith/include";
// smith.c alone is compared at -O1: at -O0 `query.why != nullptr ? query.why : "..."` in lang_type.c is a branch as .c
// and a select as .smith (the same program; the optimizer makes the two one).
constexpr char in_process_o1[_] = "-O1 -DSMITH_IN_PROCESS -D'SMITH_CLANG_RESOURCE=\"tests/stub.c\"' "
                                  "-D'SMITH_CLANG_ID=\"llvm-0 0\"'";

static typeof(const char[:]) slice_of(const char *text) {
    return text[0:c::strlen(text)];
}

static const char *text(const scratch::Project *p, const char *a, const char *b, const char *c, const char *d) {
    return format::push(&p->io->arena, a, b, c, d).data;
}

// The sources are compiled in a tree where a renamed file sits beside the original. The tree is links to the
// repository's items (a copy of them was most of what each case cost); the folders on the way to `stem` are real
// folders of links, and the source itself is a real file, so that the .smith written beside it is a real file too.
static scratch::Project tree_project(io::Io *io, const char *stem) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    const char *command =
        format::push(&io->arena,
                     "mkdir tree && for item in smith.c build.c include lib runtime scripts templates tests "
                     "shim; do ln -s \"$SMITH_REPO/$item\" tree/$item; done && mkdir -p tree/.smith && "
                     "ln -s \"$SMITH_REPO/.smith/include\" tree/.smith/include && "
                     "dir=$(dirname ",
                     stem,
                     ") && rel= && if [ \"$dir\" != . ]; then "
                     "for part in $(echo \"$dir\" | tr / ' '); do rel=\"$rel$part\"; rm tree/$rel && "
                     "mkdir tree/$rel && for f in \"$SMITH_REPO/$rel\"/*; do ln -s \"$f\" tree/$rel/; done; "
                     "rel=\"$rel/\"; done; fi && rm tree/",
                     stem, ".c && cp \"$SMITH_REPO/", stem, ".c\" tree/", stem, ".c")
            .data;
    scratch::Run copied = scratch::sh(&p, command);
    scratch::expect_status("the tree is made", 0, &copied);
    return p;
}

// The two files are compiled to assembly as `stem.c` and as `stem.smith` with the same flags, and must be identical.
static void compare(io::Io *io, const char *stem, const char *extra, bool from_smith) {
    scratch::Project p = tree_project(io, stem);
    if (from_smith) {
        scratch::Run copied =
            scratch::sh(&p, format::push(&io->arena, "cp tree/", stem, ".smith tree/", stem, ".c").data);
        scratch::expect_status("the .smith is copied to .c", 0, &copied);
    }
    const char *base = stem;
    for (const char *slash = c::strchr(base, '/'); slash != nullptr; slash = c::strchr(base, '/'))
        base = slash + 1;
    // The file's own name in a string is read as ".c" on the lowered side; any other ".smith" in a string is code.
    scratch::write(&p, "own.sed",
                   format::push(&io->arena, "s|\\([^A-Za-z0-9_/.-]\\)", base, "\\.smith\"|\\1", base, ".c\"|g\n").data);
    scratch::write(&p, "messages.sed", "s/\\.c\\([: ]\\)/.smith\\1/g\n");
    // The two compiles run side by side (each in its own files; the .smith is a copy removed when it is done), and
    // each writes its exit status.
    const char *both = format::push(&io->arena, "cd tree; { smith cc ", flags, " ", extra, " -S ", stem,
                                    ".c -o ../plain.s 2> ../plain.err; echo $? > ../plain.status; } & "
                                    "cp ",
                                    stem, ".c ", stem, ".smith && { smith cc ", flags, " ", extra, " -S ", stem,
                                    ".smith -o ../lowered.s 2> ../lowered.err; echo $? > ../lowered.status; "
                                    "rm -f ",
                                    stem, ".smith; }; wait")
                           .data;
    scratch::Run compiled = scratch::sh(&p, both);
    scratch::expect_status("the compiles ran", 0, &compiled);
    const char *plain_status = scratch::read(&p, "plain.status");
    const char *lowered_status = scratch::read(&p, "lowered.status");
    bool plain_ok = c::strcmp(plain_status, "0\n") == 0;
    test::check(plain_ok); // the .c compiles
    if (c::strcmp(plain_status, lowered_status) != 0) {
        test::note("exit %s as .c, %s as .smith:\n%s", plain_status, lowered_status, scratch::read(&p, "lowered.err"));
    }
    test::check(c::strcmp(plain_status, lowered_status) == 0);
    if (plain_ok) {
        scratch::Run same = scratch::sh(&p, "sed -f own.sed lowered.s > lowered.n && cmp plain.s lowered.n");
        scratch::expect_status("the code is identical as .c and as .smith", 0, &same);
    }
    scratch::Run messages = scratch::sh(&p, "[ \"$(sed -f messages.sed plain.err)\" = \"$(cat lowered.err)\" ]");
    scratch::expect_status("the messages are the same", 0, &messages);
}

export void test_smith_c_compiles_the_same_as_smith(io::Io *io) {
    compare(io, "smith", in_process_o1, false);
}

