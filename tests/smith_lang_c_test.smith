// Where C requires a constant, a .smith file runs the function; a .c file reports the error it always did; the target
// is the target's own (a `long` of a Windows target is 4 bytes).
static void constexpr_c(io::Io *io, const char *width, const char *flags_for_target) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    const char *source = format::push(&io->arena,
                                      "static unsigned long width(void) { return sizeof(long); }\n"
                                      "static int fib(int n) { return n < 2 ? n : fib(n - 1) + fib(n - 2); }\n"
                                      "constexpr int x = fib(10);\nstatic_assert(x == 55);\nstatic_assert(width() == ",
                                      width, ");\n")
                             .data;
    scratch::write(&p, "x.c", source);
    scratch::write(&p, "x.smith", source);
    scratch::Run plain = scratch::sh(&p, text(&p, "smith cc -std=gnu23 -fsyntax-only ", flags_for_target, " x.c", ""));
    scratch::expect_failure("the .c reports the error it always did", &plain);
    scratch::Run lowered =
        scratch::sh(&p, text(&p, "smith cc -std=gnu23 -fsyntax-only ", flags_for_target, " x.smith", ""));
    scratch::expect_status("the .smith runs the function", 0, &lowered);
}

export void test_a_constexpr_call_in_c_runs_for_the_host(io::Io *io) {
    constexpr_c(io, "8", "");
}

export void test_a_constexpr_call_in_c_runs_for_a_windows_target(io::Io *io) {
    constexpr_c(io, "4", "--target=x86_64-pc-windows-msvc -nostdinc");
}

// A constexpr pointer into a string literal or a constexpr object (C23 requires null) is a value in a .smith file; a .c
// file still reports "constexpr pointer initializer is not null".
export void test_a_constexpr_pointer_into_a_string_is_a_value_in_smith(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    const char *source = "constexpr char hello[] = \"hello\";\nconstexpr const char *word = \"abc\";\n"
                         "constexpr const char *inside = &hello[1];\nstatic_assert(word[1] == 'b');\n"
                         "static_assert(inside[0] == 'e');\n";
    scratch::write(&p, "x.c", source);
    scratch::write(&p, "x.smith", source);
    scratch::Run plain = scratch::sh(&p, "smith cc -std=gnu23 -fsyntax-only x.c");
    scratch::expect_failure("the .c still reports the pointer", &plain);
    scratch::expect_contains("the .c says why", plain.err, "constexpr pointer initializer is not null");
    scratch::Run lowered = scratch::sh(&p, "smith cc -std=gnu23 -fsyntax-only x.smith");
    scratch::expect_status("the .smith takes the pointer as a value", 0, &lowered);
}

// A module's tag is a type name; in a file with no `module` line a tag and an ordinary name of one name are separate.
export void test_tags_and_ordinary_names_print_the_same_as_c(io::Io *io) {
    behave(io, "tags");
}
