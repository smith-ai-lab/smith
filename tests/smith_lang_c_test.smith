}

// A program that prints: the same output as .c and as .smith, and the one in its .out file.
static void behave(io::Io *io, const char *name) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::copy_tree(&p, format::push(&io->arena, "tests/smith-lang-c/", name, ".c").data,
                       format::push(&io->arena, name, ".c").data);
    scratch::Run copied = scratch::sh(&p, format::push(&io->arena, "cp ", name, ".c ", name, ".smith").data);
    scratch::expect_status("the program is copied", 0, &copied);
    const char *kinds[2] = {"c", "smith"};
    for (usize i = 0; i < 2; i++) {
        const char *build = format::push(&io->arena,
                                         "smith cc -std=gnu23 -O1 -g0 -Wno-builtin-macro-redefined "
                                         "-D'__FILE__=\"unit\"' -I \"$SMITH_REPO/.smith/include\" -w ",
                                         name, ".", kinds[i], " -o ", name, ".", kinds[i], ".bin")
                                .data;
        scratch::Run built = scratch::sh(&p, build);
        scratch::expect_status(text(&p, "the .", kinds[i], " builds", ""), 0, &built);
        scratch::Run ran = scratch::sh(&p, format::push(&io->arena, "./", name, ".", kinds[i], ".bin 2>&1").data);
        test::golden(io, slice_of(format::push(&io->arena, "tests/smith-lang-c/", name, ".out").data),
                     slice_of(ran.out));
    }
}

export void test_arrays_print_the_same_as_c(io::Io *io) {
    behave(io, "arrays");
}

