// What the tests of `smith prove` (tests/prove_*_test.smith, issue #292) share: the command that proves a file of
// tests/prove ($c in the arguments), and the checks that a list of functions of a file are all proved, or all refuted
// with a text, each failing name in the note of the failure.
module prove_cases;

import smith::format;
import smith::test;
import scratch;

// `smith prove args -- -I include`, both streams together. $c in args is tests/prove. The command is built in a buffer
// of its own, so a test with an io and one without can both call it.
export scratch::Run prove(const scratch::Project *p, const char *args) {
    char command[4096];
    format::Written written = format::to(command, sizeof command, "c=cases; smith prove ", args,
                                         " -- -I \"$SMITH_REPO/.smith/include\" 2>&1");
    test::check_condition(written.fits);
    return scratch::sh(p, command);
}

// The word number `index` of a text separated by spaces copied into `out`, or false when there are fewer.
static bool word(const char *text, usize index, char out[:]) {
    usize at = 0;
    for (usize n = 0; n <= index; n++) {
        while (text[at] == ' ') {
            at++;
        }
        if (text[at] == '\0') return false;
        usize start = at;
        while (text[at] != ' ' && text[at] != '\0') {
            at++;
        }
        if (n == index) {
            test::check_condition(at - start < countof(out));
            (void)format::to(out.data, countof(out), format::bytes(text + start, at - start));
            return true;
        }
    }
    return false;
}

static scratch::Run function(const scratch::Project *p, const char *file, const char *prefix, const char *name) {
    char args[1024];
    format::Written written = format::to(args, sizeof args, "--function=", prefix, name, " ", file);
    test::check_condition(written.fits);
    return prove(p, args);
}

// Every function of `names` (separated by spaces), with `prefix` before each, is proved in `file` (a shell word such as
// "$c/memory.c").
export void each_proved(const scratch::Project *p, const char *what, const char *file, const char *prefix,
                        const char *names) {
    bool failed = false;
    char name[256];
    for (usize i = 0; word(names, i, name); i++) {
        scratch::Run run = function(p, file, prefix, name);
        if (run.status != 0) {
            test::note("%s: %s is not proved (status %d)\n%s", what, name, run.status, run.out);
            failed = true;
        }
    }
    test::check_condition(!failed);
}

// Every function of `names` fails in `file` (status 1) with `needle` in its output.
export void each_refuted(const scratch::Project *p, const char *what, const char *file, const char *prefix,
                         const char *needle, const char *names) {
    bool failed = false;
    char name[256];
    for (usize i = 0; word(names, i, name); i++) {
        scratch::Run run = function(p, file, prefix, name);
        if (run.status != 1 || !scratch::contains(run.out, needle)) {
            test::note("%s: %s is not refuted with `%s` (status %d)\n%s", what, name, needle, run.status, run.out);
            failed = true;
        }
    }
    test::check_condition(!failed);
}

// Every function of `names` fails in `file` and its output says neither of poison nor of undefined behaviour: the
// counterexample is a value.
export void each_value_counterexample(const scratch::Project *p, const char *what, const char *file,
                                      const char *names) {
    bool failed = false;
    char name[256];
    for (usize i = 0; word(names, i, name); i++) {
        scratch::Run run = function(p, file, "", name);
        if (scratch::contains(run.out, "poison") || scratch::contains(run.out, "undefined behaviour")) {
            test::note("%s: %s names poison or undefined behaviour\n%s", what, name, run.out);
            failed = true;
        }
    }
    test::check_condition(!failed);
}
