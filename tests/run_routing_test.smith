// ---- the verbs that read the build need a build.c ----

constexpr char no_build[_] = "smith: no build.c in this folder, and no main.smith or main.c to build by convention";

static void needs_a_build(const char *verb) {
    scratch::Project p = scratch::make("empty", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    scratch::Run run = scratch::sh(&p, format::push("env SMITH_OUTPUT=full smith ", verb, " -DX=1").data);
    scratch::expect_text(format::push(verb, " -DX=1: the project's verb, which needs a build.c").data, no_build,
                         first_line(arena, run.err));
}

export void test_run_lint_with_an_option_needs_a_build_c() {
    needs_a_build("lint");
}

export void test_run_run_with_an_option_needs_a_build_c() {
    needs_a_build("run");
}

export void test_run_test_with_an_option_needs_a_build_c() {
    needs_a_build("test");
}

// The first line of the failure with the seconds it took taken off: `smith lint: FAILED (status 2, 0.1 s)`.
static const char *without_seconds(arena::Arena *arena, const char *line) {
    usize end = c::strlen(line);
    if (end >= 3 && c::strcmp(line + end - 3, " s)") == 0) {
        end -= 3;
        while (end > 0 && (line[end - 1] == '.' || (line[end - 1] >= '0' && line[end - 1] <= '9'))) {
            end--;
        }
    }
    return prefix(arena, line, end);
}

// Quiet output (#78): with SMITH_OUTPUT unset, a failing verb says it failed and still prints the error that tells the
// user what to do, with the path of the log.
static void quiet_failure(const char *verb) {
    scratch::Project p = scratch::make("empty", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    scratch::Run run = scratch::sh(&p, format::push("env -u SMITH_OUTPUT smith ", verb, " -DX=1").data);
    scratch::expect_text(format::push(verb, " -DX=1, quiet: says it failed").data,
                         format::push("smith ", verb, ": FAILED (status 2, ").data,
                         without_seconds(arena, first_line(arena, run.err)));
    scratch::expect_contains(format::push(verb, " -DX=1, quiet: ... and prints the error that says what to do").data,
                             run.err, no_build);
    scratch::expect_contains(format::push(verb, " -DX=1, quiet: ... and the log's path").data, run.err,
                             format::push(".smith/log/", verb, ".log").data);
}

export void test_run_lint_with_an_option_says_quietly_that_it_failed() {
    quiet_failure("lint");
}

export void test_run_test_with_an_option_says_quietly_that_it_failed() {
    quiet_failure("test");
}

// fmt lists the files git sees, and the folder is no repository.
export void test_run_fmt_outside_a_git_repository_says_to_name_the_files() {
    scratch::Project p = scratch::make("empty", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    scratch::Run run = scratch::sh(&p, format::push("env GIT_CEILING_DIRECTORIES='", p.root, "' smith fmt").data);
    scratch::expect_text(
        "fmt: outside a git repository it says to name the files",
        "smith: this folder is not a git repository, so smith fmt has no list of files; name them: smith "
        "fmt -i <files>",
        run.err);
}

// check formats and checks the docs first, then needs the build for the rest.
export void test_run_check_reports_every_part_in_order() {
    scratch::Project p = scratch::make("empty", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    scratch::Run run =
        scratch::sh(&p, format::push("env SMITH_OUTPUT=full GIT_CEILING_DIRECTORIES='", p.root, "' smith check").data);
    scratch::expect_status("check: a part that fails is reported, and the exit status is 1", 1, &run);
    const char *a = c::strstr(run.err, "smith check: fmt FAILED (status 2)");
    const char *b = a != nullptr ? c::strstr(a, "smith check: docs ok") : nullptr;
    const char *d = b != nullptr
                        ? c::strstr(b, "smith check: no build file and no main, so lint, test and prove are skipped")
                        : nullptr;
    const char *e = d != nullptr ? c::strstr(d, "smith check: failed: fmt") : nullptr;
    if (e == nullptr) {
        test::note("actual: %s", run.err);
    }
    test::check_condition(e != nullptr && ends_with(run.err, "smith check: failed: fmt\n"));
}

// A project verb is a verb, not a target of smith build.
static void verb_is_not_a_target(const char *verb) {
    scratch::Project p = scratch::make("empty", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    scratch::Run run = scratch::sh(&p, format::push("smith build ", verb).data);
    scratch::expect_text(
        format::push("build ", verb, ": refused, with a pointer to the verb").data,
        format::push("smith: ", verb, " is a verb, not a target of smith build; run `smith ", verb, "`").data, run.err);
}

export void test_run_build_run_is_refused_with_a_pointer_to_the_verb() {
    verb_is_not_a_target("run");
}

export void test_run_build_test_is_refused_with_a_pointer_to_the_verb() {
    verb_is_not_a_target("test");
}

export void test_run_build_check_is_refused_with_a_pointer_to_the_verb() {
    verb_is_not_a_target("check");
}

export void test_run_build_fmt_is_refused_with_a_pointer_to_the_verb() {
    verb_is_not_a_target("fmt");
}

export void test_run_build_lint_is_refused_with_a_pointer_to_the_verb() {
    verb_is_not_a_target("lint");
}

export void test_run_build_prove_is_refused_with_a_pointer_to_the_verb() {
    verb_is_not_a_target("prove");
}

export void test_run_build_docs_is_refused_with_a_pointer_to_the_verb() {
    verb_is_not_a_target("docs");
}
