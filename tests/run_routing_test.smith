// The routing tests of smith: the compiler verbs and their links (`smith cc` and `smith-cc`), the tools (fmt, lint,
// lsp, dbg, dap), the bare arguments, and the verbs that need a build. The routes are functions in process (issue #716,
// part of #646): `smith_core_route` (include/smith_core_route.h) returns the program and the arguments smith would
// run, so no compiler and no stub starts. What needs a process (the exec itself, a status, a signal, the real tools,
// the verbs that read a build) stays a `scratch::` test against the stub compilers of tests/stub.c, which report their
// name and every argument. A test makes its project, then sets its own memory as the current allocator: what scratch
// returns to it (a Run's texts, a file it reads) is given back with that memory, and scratch::clean frees what make
// holds.
module run_routing_test;

import smith::arena;
import smith::env;
import smith::format;
import smith::test;
import scratch;
import <smith_core_route.h>;
import <string.h>;
import smith::mem;
import target;

constexpr usize memory_size = (usize)4 << 20; // 4 MiB

// The first `length` bytes of a text, terminated.
static const char *prefix(arena::Arena *arena, const char *text, usize length) {
    char *copy = arena::push_slice(arena, char, length + 1).data;
    mem::copy(copy[0:length], text[0:length]);
    copy[length] = '\0';
    return copy;
}

// The stubs of a test: a project with the stub programs in bin/ and the links smith-cc, smith-c++, smith++, the
// programs folder's clang and clang++ (driver/) and bin/selfclang, all to the smith under test.
typedef struct {
    const scratch::Project *p;
    arena::Arena *arena; // the test's memory
    const char *dir;
    const char *cl;   // the stub clang
    const char *cc;   // the compiler form: `smith cc`, or the link smith-cc
    const char *plus; // and for C++
    const char *form; // verb or link
} Rig;

constexpr char stubs_script[_] =
    "mkdir -p bin driver && for n in $STUBS; do ${CC:-cc} -std=gnu23 -DNAME=\"\\\"$n\\\"\" "
    "tests/stub.c "
    "-o bin/$n || exit 1; done; ln -s \"$SMITH_SELF\" smith-cc && ln -s \"$SMITH_SELF\" smith-c++ && "
    "ln -s \"$SMITH_SELF\" 'smith++' && ln -s \"$SMITH_SELF\" bin/selfclang && ln -s \"$SMITH_SELF\" driver/clang && "
    "ln -s \"$SMITH_SELF\" driver/clang++";

static Rig make_rig(arena::Arena *arena, const scratch::Project *p, bool link, const char *stubs) {
    scratch::copy_tree(p, "tests/stub.c", "tests/stub.c");
    scratch::Run made = scratch::sh(p, format::push("STUBS='", stubs, "'; ", stubs_script).data);
    scratch::expect_status("the stub compilers are built", 0, &made);
    Rig r = {.p = p, .arena = arena, .dir = p->dir, .form = link ? "link" : "verb"};
    r.cl = format::push(p->dir, "/bin/clang").data;
    r.cc = link ? format::push(p->dir, "/smith-cc").data : "\"$SMITH_SELF\" cc";
    r.plus = link ? format::push(p->dir, "/smith-c++").data : "\"$SMITH_SELF\" c++";
    return r;
}

// A name with the form in front: `[verb] ...`.
static const char *nm(const Rig *r, const char *what) {
    return format::push("[", r->form, "] ", what).data;
}

// Runs `env <settings> <tool> <arguments>` in the rig's folder.
static scratch::Run go(const Rig *r, const char *settings, const char *tool, const char *arguments) {
    return scratch::sh(r->p, format::push("env ", settings, " ", tool, " ", arguments).data);
}

static scratch::Run go_clang(const Rig *r, const char *settings, const char *arguments) {
    return go(r, format::push("SMITH_CLANG=", r->cl, " ", settings).data, r->cc, arguments);
}

static bool starts_with(const char *text, const char *prefix) {
    return c::strncmp(text, prefix, c::strlen(prefix)) == 0;
}

static bool ends_with(const char *text, const char *suffix) {
    usize n = c::strlen(text);
    usize m = c::strlen(suffix);
    return n >= m && c::strcmp(text + n - m, suffix) == 0;
}

// The first line of a text.
static const char *first_line(arena::Arena *arena, const char *text) {
    usize length = 0;
    while (text[length] != '\0' && text[length] != '\n') {
        length++;
    }
    return prefix(arena, text, length);
}

static bool is_darwin(const Rig *r) {
    return scratch::same(scratch::capture(r->p, "uname -s"), "Darwin");
}

// ---- the routes, in process (smith_core_route) ----
//
// A route is a function of the name smith is run as, its arguments and its environment: the program and the arguments
// it would start, what it prints and its status. smith_core_route runs it in a child of the runner and stops where
// smith would exec, so the stubs here are files that exist, never programs that run.

// The unit-test rig: a project with the files a route looks for, and the smith under test, which a compiler may not
// be a link to.
typedef struct {
    const scratch::Project *p;
    arena::Arena *arena; // the test's memory
    const char *dir;
    const char *cl;   // the stub clang
    const char *self; // the smith under test ($SMITH_SELF)
    bool link;        // the links smith-cc and smith-c++, or the verbs cc and c++
    const char *form; // verb or link
} Unit;

static const char *self_path() {
    env::Value self = env::get("SMITH_SELF");
    test::check_condition(self == .some);
    return self == .some ? self.some.data : "";
}

// Stub files in bin/ (`stubs` are their names) and bin/selfclang, a link to the smith under test.
static Unit make_unit(arena::Arena *arena, const scratch::Project *p, bool link, const char *stubs) {
    const char *script = format::push("mkdir -p bin && for n in ", stubs,
                                      "; do printf '#!/bin/sh\\n[ -n \"$STUB_XCRUN_FAIL\" ] && exit 1\\necho "
                                      "\"$STUB_SDK\"\\n' > bin/$n && chmod +x bin/$n || exit 1; done; ln -s "
                                      "\"$SMITH_SELF\" bin/selfclang")
                             .data;
    scratch::Run made = scratch::sh(p, script);
    scratch::expect_status("the stub files are made", 0, &made);
    Unit u = {.p = p, .arena = arena, .dir = p->dir, .self = self_path(), .link = link, .form = link ? "link" : "verb"};
    u.cl = format::push(p->dir, "/bin/clang").data;
    return u;
}

static const char *um(const Unit *u, const char *what) {
    return format::push("[", u->form, "] ", what).data;
}

// A text in a vector: arena::push_slice of a pointer type would be a multilevel pointer conversion.
typedef struct {
    const char *text;
} Field;

// `a|b||c` is the three arguments a, b, "" and c; "" is none. The vector ends with nullptr and starts with `first`
// and `second` (when it is not null).
static const char *const *split(arena::Arena *arena, const char *first, const char *second, const char *text) {
    usize length = c::strlen(text);
    usize count = length > 0 ? 1 : 0;
    for (usize i = 0; i < length; i++) {
        count += text[i] == '|' ? 1 : 0;
    }
    usize head = (first != nullptr ? 1 : 0) + (second != nullptr ? 1 : 0);
    Field *vector = arena::push_slice(arena, Field, head + count + 1).data;
    char *copy = arena::push_slice(arena, char, length + 1).data;
    mem::copy(copy[0:length], text[0:length]);
    copy[length] = '\0';
    usize used = 0;
    if (first != nullptr) {
        vector[used++].text = first;
    }
    if (second != nullptr) {
        vector[used++].text = second;
    }
    char *start = copy;
    for (usize i = 0; length > 0 && i <= length; i++) {
        if (copy[i] == '|' || copy[i] == '\0') {
            copy[i] = '\0';
            vector[used++].text = start;
            start = copy + i + 1;
        }
    }
    vector[used].text = nullptr;
    return (const char *const *)vector;
}

// The route of `name second arguments` under `environment` (`A=b|-C`: set A, unset C).
static c::SmithCoreRouted *route_command(const Unit *u, const char *name, const char *second, const char *environment,
                                         const char *arguments, const char *const *show) {
    c::SmithCoreRouted *routed = arena::push(u->arena, c::SmithCoreRouted);
    c::SmithCoreRoute route = {.folder = u->dir,
                               .arguments = split(u->arena, name, second, arguments),
                               .self = u->self,
                               .environment = split(u->arena, nullptr, nullptr, environment),
                               .show = show};
    test::check_condition(c::smith_core_route(&route, routed));
    return routed;
}

// `smith cc` or `smith-cc` (`plus`: c++) with SMITH_CLANG the stub clang, in both forms.
static c::SmithCoreRouted *route_compiler(const Unit *u, bool plus, const char *environment, const char *arguments) {
    const char *name = u->link ? format::push(u->dir, plus ? "/smith-c++" : "/smith-cc").data : "smith";
    const char *second = u->link ? nullptr : (plus ? "c++" : "cc");
    return route_command(u, name, second, environment, arguments, nullptr);
}

static c::SmithCoreRouted *route_clang(const Unit *u, const char *environment, const char *arguments) {
    const char *settings = format::push("SMITH_CLANG=", u->cl, environment[0] != '\0' ? "|" : "", environment).data;
    return route_compiler(u, false, settings, arguments);
}

static void expect_status_is(const char *name, usize expected, const c::SmithCoreRouted *routed) {
    scratch::expect_count(name, expected, (usize)routed->status);
}

static void expect_nothing_ran(const char *name, usize status, const c::SmithCoreRouted *routed) {
    expect_status_is(name, status, routed);
    scratch::expect_text(name, "", &routed->exec[0]);
}

static void clang_route(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Unit u = make_unit(&memory, &p, link, "clang");
    c::SmithCoreRouted *run = route_clang(&u, "", "-c|a b.c||-DX=y z|-o|out.o");
    scratch::expect_text(um(&u, "clang route forwards every argument untouched"),
                         format::push("exec ", u.cl, "\n[-c]\n[a b.c]\n[]\n[-DX=y z]\n[-o]\n[out.o]").data,
                         &run->exec[0]);
    expect_status_is(um(&u, "clang route: status 0"), 0, run);
    c::SmithCoreRouted *version = route_clang(&u, "", "--version");
    scratch::expect_text(um(&u, "--version goes to the compiler"), format::push("exec ", u.cl, "\n[--version]").data,
                         &version->exec[0]);
    c::SmithCoreRouted *response = route_clang(&u, "", "@r.rsp|a.c");
    scratch::expect_text(um(&u, "response files are forwarded untouched"),
                         format::push("exec ", u.cl, "\n[@r.rsp]\n[a.c]").data, &response->exec[0]);
    c::SmithCoreRouted *flag = route_clang(&u, "", "-I|shaders.metal|-c|a.c");
    scratch::expect_text(um(&u, "a flag value ending in .metal is not an input"),
                         format::push("exec ", u.cl, "\n[-I]\n[shaders.metal]\n[-c]\n[a.c]").data, &flag->exec[0]);
}

export void test_run_verb_clang_route() {
    clang_route(false);
}

export void test_run_link_clang_route() {
    clang_route(true);
}

static const char *mixed_refusal =
    "smith: .metal and other inputs need different compilers and flags; compile the shaders in their own command\n";

static const char *path_with(const Unit *u) {
    env::Value path = env::get("PATH");
    return format::push("PATH=", u->dir, "/bin:", path == .some ? path.some.data : "").data;
}

static void metal_route(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Unit u = make_unit(&memory, &p, link, "clang xcrun metal");
    c::SmithCoreRouted *xcrun = route_compiler(&u, false, path_with(&u), "-o|shaders.metallib|a.metal|b.metal");
    scratch::expect_text(
        um(&u, "metal route goes through xcrun -sdk macosx metal"),
        format::push("exec ", u.dir,
                     "/bin/xcrun\n[-sdk]\n[macosx]\n[metal]\n[-o]\n[shaders.metallib]\n[a.metal]\n[b.metal]")
            .data,
        &xcrun->exec[0]);
    c::SmithCoreRouted *metal =
        route_compiler(&u, false, format::push("SMITH_METAL=", u.dir, "/bin/metal").data, "-E|a.metal");
    scratch::expect_text(um(&u, "SMITH_METAL replaces xcrun"),
                         format::push("exec ", u.dir, "/bin/metal\n[-E]\n[a.metal]").data, &metal->exec[0]);
    c::SmithCoreRouted *mixed = route_clang(&u, "", "a.metal|b.c");
    scratch::expect_text(um(&u, "mixed .metal and C inputs are refused"), mixed_refusal, &mixed->err[0]);
    expect_nothing_ran(um(&u, "mixed inputs: status 2 and nothing ran"), 2, mixed);
    c::SmithCoreRouted *smith_metal = route_clang(&u, "", "a.smith|b.metal");
    scratch::expect_text(um(&u, "a .smith input and a .metal input are refused"), mixed_refusal, &smith_metal->err[0]);
}

export void test_run_verb_metal_route() {
    metal_route(false);
}

export void test_run_link_metal_route() {
    metal_route(true);
}

// A .smith input needs a smith whose clang has the token hook; any other refuses it, and does not compile it as C.
static void smith_inputs(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Unit u = make_unit(&memory, &p, link, "clang");
    c::SmithCoreRouted *which = route_clang(&u, "", "--smith-which|-c|a.smith");
    if (which->status == 0) {
        c::SmithCoreRouted *plain = route_clang(&u, "", "-c|a.smith|-o|out.o");
        scratch::expect_text(
            um(&u, "a .smith input is compiled as C, and nothing else changes"),
            format::push("exec ", u.cl, "\n[-std=gnu2y]\n[-fdefer-ts]\n[-c]\n[-x]\n[c]\n[a.smith]\n[-o]\n[out.o]").data,
            &plain->exec[0]);
        c::SmithCoreRouted *mixed = route_clang(&u, "", "-c|-I|x.smith|a.smith|b.c|c.smith|-o|out.o");
        scratch::expect_text(
            um(&u, "the language is C for the .smith inputs only, and an option's value is no input"),
            format::push("exec ", u.cl,
                         "\n[-std=gnu2y]\n[-fdefer-ts]\n[-c]\n[-I]\n[x.smith]\n[-x]\n[c]\n[a.smith]\n[-x]\n[none]"
                         "\n[b.c]\n[-x]\n[c]\n[c.smith]\n[-o]\n[out.o]")
                .data,
            &mixed->exec[0]);
        c::SmithCoreRouted *standard = route_clang(&u, "", "-std=c23|-c|a.smith");
        scratch::expect_text(um(&u, "a .smith input is C2y unless the caller names a standard"),
                             format::push("exec ", u.cl, "\n[-fdefer-ts]\n[-std=c23]\n[-c]\n[-x]\n[c]\n[a.smith]").data,
                             &standard->exec[0]);
        c::SmithCoreRouted *cplus = route_clang(&u, "", "-c|a.smith|b.cpp");
        scratch::expect_text(um(&u, "no C standard is added beside a C++ input"),
                             format::push("exec ", u.cl, "\n[-c]\n[-x]\n[c]\n[a.smith]\n[-x]\n[none]\n[b.cpp]").data,
                             &cplus->exec[0]);
        c::SmithCoreRouted *language = route_clang(&u, "", "-x|c++|-c|a.smith");
        scratch::expect_text(um(&u, "a language named by the caller is left alone"),
                             format::push("exec ", u.cl, "\n[-x]\n[c++]\n[-c]\n[a.smith]").data, &language->exec[0]);
        c::SmithCoreRouted *kept = route_clang(&u, "", "-x|c|-c|a.smith");
        scratch::expect_text(
            um(&u, "-x c is kept, and the standard is C2y and defer is on as for any .smith input"),
            format::push("exec ", u.cl, "\n[-std=gnu2y]\n[-fdefer-ts]\n[-x]\n[c]\n[-c]\n[a.smith]").data,
            &kept->exec[0]);
    } else {
        c::SmithCoreRouted *refused = route_clang(&u, "", "-c|a.smith|-o|out.o");
        scratch::expect_text(um(&u, "a .smith input is refused by a smith without the token hook"),
                             "smith: .smith files need a smith whose clang has the token hook "
                             "(patches/clang-token-hook.patch, applied by `smith build llvm`); this one has none\n",
                             &refused->err[0]);
        expect_nothing_ran(um(&u, "a .smith input is refused: status 2 and nothing ran"), 2, refused);
    }
}

export void test_run_verb_smith_inputs() {
    smith_inputs(false);
}

export void test_run_link_smith_inputs() {
    smith_inputs(true);
}

static void plus_plus(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Unit u = make_unit(&memory, &p, link, "clang clang++");
    c::SmithCoreRouted *run =
        route_compiler(&u, true, format::push("SMITH_CLANGXX=", u.dir, "/bin/clang++").data, "-c|a.cpp");
    scratch::expect_text(um(&u, "smith++ uses clang++"),
                         format::push("exec ", u.dir, "/bin/clang++\n[-c]\n[a.cpp]").data, &run->exec[0]);
}

export void test_run_verb_smith_plus_plus() {
    plus_plus(false);
}

export void test_run_link_smith_plus_plus() {
    plus_plus(true);
}

// On a smith with clang inside, the default compiler is that one, run in smith's own process; SMITH_CLANG runs another.
static void in_process_default(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Unit u = make_unit(&memory, &p, link, "clang");
    c::SmithCoreRouted *run = route_compiler(&u, false, "-SMITH_CLANG", "-c|a.c");
    scratch::expect_text(um(&u, "in-process: the default is clang inside smith"), "in-process clang\n[-c]\n[a.c]",
                         &run->exec[0]);
    c::SmithCoreRouted *plus = route_compiler(&u, true, "-SMITH_CLANGXX", "-c|a.cpp");
    scratch::expect_text(um(&u, "in-process: smith++ is clang++ inside smith"), "in-process clang++\n[-c]\n[a.cpp]",
                         &plus->exec[0]);
    c::SmithCoreRouted *other =
        route_compiler(&u, false, format::push("-SMITH_CLANG|SMITH_CLANGXX=", u.dir, "/bin/clang++").data, "-c|a.c");
    scratch::expect_text(um(&u, "in-process: SMITH_CLANGXX does not affect smith"), "in-process clang\n[-c]\n[a.c]",
                         &other->exec[0]);
}

export void test_run_verb_in_process_default() {
    in_process_default(false);
}

export void test_run_link_in_process_default() {
    in_process_default(true);
}

// The SDK is chosen through the environment, never a flag, and only for what the caller left unset.
static void sdk_environment(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Unit u = make_unit(&memory, &p, link, "clang xcrun");
    if constexpr (target::os != target::macos) {
        test::note("not macOS: the SDK is not chosen");
        return;
    }
    static const char *const names[_] = {"SDKROOT", "CLANG_NO_DEFAULT_CONFIG", nullptr};
    const char *clang = format::push("exec ", u.cl, "\n[-c]\n[a.c]").data;
    const char *base =
        format::push("-SDKROOT|-CLANG_NO_DEFAULT_CONFIG|", path_with(&u), "|STUB_SDK=/stub/sdk|SMITH_CLANG=", u.cl)
            .data;
    const char *name = u.link ? format::push(u.dir, "/smith-cc").data : "smith";
    const char *second = u.link ? nullptr : "cc";
    c::SmithCoreRouted *chosen = route_command(&u, name, second, base, "-c|a.c", names);
    scratch::expect_text(um(&u, "macOS: SDKROOT comes from xcrun and the default config is off, with no flag added"),
                         format::push(clang, "\nenv SDKROOT=/stub/sdk\nenv CLANG_NO_DEFAULT_CONFIG=1").data,
                         &chosen->exec[0]);
    c::SmithCoreRouted *mine = route_command(
        &u, name, second,
        format::push("-CLANG_NO_DEFAULT_CONFIG|SDKROOT=/mine|", path_with(&u), "|STUB_SDK=/stub/sdk|SMITH_CLANG=", u.cl)
            .data,
        "-c|a.c", names);
    scratch::expect_text(um(&u, "macOS: the caller's SDKROOT wins, and the default config is still off"),
                         format::push(clang, "\nenv SDKROOT=/mine\nenv CLANG_NO_DEFAULT_CONFIG=1").data,
                         &mine->exec[0]);
    c::SmithCoreRouted *config = route_command(
        &u, name, second,
        format::push("-SDKROOT|CLANG_NO_DEFAULT_CONFIG=0|", path_with(&u), "|STUB_SDK=/stub/sdk|SMITH_CLANG=", u.cl)
            .data,
        "-c|a.c", names);
    scratch::expect_text(um(&u, "macOS: the caller's CLANG_NO_DEFAULT_CONFIG wins"),
                         format::push(clang, "\nenv SDKROOT=/stub/sdk\nenv CLANG_NO_DEFAULT_CONFIG=0").data,
                         &config->exec[0]);
    c::SmithCoreRouted *failed =
        route_command(&u, name, second, format::push(base, "|STUB_XCRUN_FAIL=1").data, "-c|a.c", names);
    scratch::expect_text(um(&u, "macOS: when xcrun fails SDKROOT stays unset"),
                         format::push(clang, "\nenv SDKROOT=(unset)\nenv CLANG_NO_DEFAULT_CONFIG=1").data,
                         &failed->exec[0]);
    c::SmithCoreRouted *sysroot = route_command(&u, name, second, base, "-isysroot|/mine/sdk|-c|a.c", names);
    scratch::expect_text(um(&u, "macOS: the caller's -isysroot is forwarded untouched"),
                         format::push("exec ", u.cl, "\n[-isysroot]\n[/mine/sdk]\n[-c]\n[a.c]",
                                      "\nenv SDKROOT=/stub/sdk\nenv CLANG_NO_DEFAULT_CONFIG=1")
                             .data,
                         &sysroot->exec[0]);
}

export void test_macos_run_verb_sdk_environment() {
    sdk_environment(false);
}

export void test_macos_run_link_sdk_environment() {
    sdk_environment(true);
}

// ---- fmt, lint, lsp, dbg and dap: the tool, with the arguments untouched, as the exact first argument ----

static void tool_routes(const char *command, const char *program, const char *variable) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Unit u = make_unit(&memory, &p, false, format::push("clang ", program).data);
    // The folder has the project's own configuration, as the repository where the script ran has: smith adds its
    // defaults to the tool's arguments only where a project has none.
    scratch::write(u.p, ".clang-tidy", "");
    scratch::write(u.p, ".clang-format", "");
    const char *stub = format::push(u.dir, "/bin/", program).data;
    const char *var = format::push(variable, "=", stub).data;
    c::SmithCoreRouted *run = route_command(&u, "smith", command, var, "-i|a b.c||--style=file|-DX=y z", nullptr);
    scratch::expect_text(format::push(command, ": runs ", program, " with every argument untouched").data,
                         format::push("exec ", stub, "\n[-i]\n[a b.c]\n[]\n[--style=file]\n[-DX=y z]").data,
                         &run->exec[0]);
    c::SmithCoreRouted *missing =
        route_command(&u, "smith", command, format::push(variable, "=/nonexistent/", program).data, "a.c", nullptr);
    scratch::expect_text(format::push(command, ": a missing tool is reported").data,
                         format::push("smith: not an executable: /nonexistent/", program, "\n").data, &missing->err[0]);
    expect_status_is(format::push(command, ": a missing tool is status 127").data, 127, missing);
    // Only as the exact first argument: after another argument it is a file name, for the compiler.
    c::SmithCoreRouted *after = route_command(&u, "smith", "cc", format::push("SMITH_CLANG=", u.cl, "|", var).data,
                                              format::push("-c|", command, "|a.c").data, nullptr);
    scratch::expect_text(format::push(command, ": after another argument it goes to clang").data,
                         format::push("exec ", u.cl, "\n[-c]\n[", command, "]\n[a.c]").data, &after->exec[0]);
}

