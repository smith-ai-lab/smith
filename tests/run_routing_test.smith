// ---- the refusals and --smith-which of both forms ----

static void compile_tail(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, link, "clang xcrun");
    scratch::Run self = go(&r, format::push(arena, "SMITH_CLANG=", r.dir, "/bin/selfclang").data, r.cc, "a.c");
    scratch::expect_text(nm(&r, "a compiler that is smith itself is refused"),
                         format::push(arena, "smith: refers to smith itself: ", r.dir, "/bin/selfclang").data,
                         self.err);
    scratch::expect_status(nm(&r, "self refusal: status 127"), 127, &self);
    scratch::Run missing = go(&r, "SMITH_CLANG=/nonexistent/clang", r.cc, "a.c");
    scratch::expect_text(nm(&r, "a missing compiler is reported"), "smith: not an executable: /nonexistent/clang",
                         missing.err);
    scratch::Run which = go_clang(&r, "", "--smith-which -c a.c");
    scratch::expect_text(nm(&r, "--smith-which names the clang backend"), format::push(arena, "clang ", r.cl).data,
                         which.out);
    scratch::Run metal =
        go(&r, format::push(arena, "PATH=\"", r.dir, "/bin:$PATH\"").data, r.cc, "--smith-which a.metal");
    scratch::expect_text(nm(&r, "--smith-which names the metal backend"),
                         format::push(arena, "metal ", r.dir, "/bin/xcrun -sdk macosx metal").data, metal.out);
    scratch::Run verbose = go_clang(&r, "SMITH_VERBOSE=1", "-c a.c");
    scratch::expect_text(nm(&r, "SMITH_VERBOSE shows the command"),
                         format::push(arena, "smith: exec ", r.cl, " -c a.c\nclang-stderr").data, verbose.err);
}

export void test_run_verb_refusals_and_which() {
    compile_tail(false);
}

export void test_run_link_refusals_and_which() {
    compile_tail(true);
}

// ---- the top level is only verbs ----

export void test_run_bare_arguments_are_an_error_with_the_hint() {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, false, "clang");
    const char *settings = format::push(arena, "SMITH_CLANG=", r.cl).data;
    scratch::Run file = go(&r, settings, "\"$SMITH_SELF\"", "foo.c -o foo");
    scratch::expect_text("bare: the compiler's arguments are an error with the hint",
                         "smith: foo.c is not a smith command; to compile, run `smith cc foo.c -o foo`", file.err);
    expect_nothing_ran("bare: status 2 and nothing ran", &file);
    scratch::Run flag = go(&r, settings, "\"$SMITH_SELF\"", "-c a.c");
    scratch::expect_text("bare: a flag first gets the same hint",
                         "smith: -c is not a smith command; to compile, run `smith cc -c a.c`", flag.err);
    scratch::Run which = go(&r, settings, "\"$SMITH_SELF\"", "--smith-which -c a.c");
    scratch::expect_text("bare: --smith-which is a flag of the compiler verbs",
                         "smith: --smith-which is not a smith command; to compile, run `smith cc --smith-which -c a.c`",
                         which.err);
    scratch::Run old = go(&r, settings, format::push(arena, "\"", r.dir, "/smith++\"").data, "-c a.cpp");
    scratch::expect_text("bare: the old smith++ name is no compiler",
                         "smith: -c is not a smith command; to compile, run `smith cc -c a.cpp`", old.err);
}

export void test_run_version_and_no_arguments() {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    scratch::Run version = scratch::sh(&p, "out=$(\"$SMITH_SELF\" version); rc=$?; printf '%s %s\\n' \"$rc\" "
                                           "\"$(printf '%s\\n' \"$out\" | sed 's/ commit [0-9a-f]*$//')\"");
    scratch::expect_text("version: the version line, status 0", "0 smith 0.0", version.out);
    scratch::Run bare = scratch::sh(&p, "\"$SMITH_SELF\"");
    scratch::expect_text("no arguments: usage, status 2", "2 usage: smith <command> [<arguments>]",
                         format::push(arena, bare.status, " ", first_line(arena, bare.err)).data);
}

