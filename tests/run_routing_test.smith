// ---- the refusals and --smith-which of both forms ----

static void compile_tail(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Unit u = make_unit(&memory, &p, link, "clang xcrun");
    c::SmithCoreRouted *self =
        route_compiler(&u, false, format::push("SMITH_CLANG=", u.dir, "/bin/selfclang").data, "a.c");
    scratch::expect_text(um(&u, "a compiler that is smith itself is refused"),
                         format::push("smith: refers to smith itself: ", u.dir, "/bin/selfclang\n").data,
                         &self->err[0]);
    expect_status_is(um(&u, "self refusal: status 127"), 127, self);
    c::SmithCoreRouted *missing = route_compiler(&u, false, "SMITH_CLANG=/nonexistent/clang", "a.c");
    scratch::expect_text(um(&u, "a missing compiler is reported"), "smith: not an executable: /nonexistent/clang\n",
                         &missing->err[0]);
    c::SmithCoreRouted *which = route_clang(&u, "", "--smith-which|-c|a.c");
    scratch::expect_text(um(&u, "--smith-which names the clang backend"), format::push("clang ", u.cl, "\n").data,
                         &which->out[0]);
    c::SmithCoreRouted *metal = route_compiler(&u, false, path_with(&u), "--smith-which|a.metal");
    scratch::expect_text(um(&u, "--smith-which names the metal backend"),
                         format::push("metal ", u.dir, "/bin/xcrun -sdk macosx metal\n").data, &metal->out[0]);
    c::SmithCoreRouted *verbose = route_clang(&u, "SMITH_VERBOSE=1", "-c|a.c");
    scratch::expect_text(um(&u, "SMITH_VERBOSE shows the command"),
                         format::push("smith: exec ", u.cl, " -c a.c\n").data, &verbose->err[0]);
}

export void test_run_verb_refusals_and_which() {
    compile_tail(false);
}

export void test_run_link_refusals_and_which() {
    compile_tail(true);
}

// ---- the top level is only verbs ----

export void test_run_bare_arguments_are_an_error_with_the_hint() {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Unit u = make_unit(&memory, &p, false, "clang");
    const char *settings = format::push("SMITH_CLANG=", u.cl).data;
    c::SmithCoreRouted *file = route_command(&u, "smith", "foo.c", settings, "-o|foo", nullptr);
    scratch::expect_text("bare: the compiler's arguments are an error with the hint",
                         "smith: foo.c is not a smith command; to compile, run `smith cc foo.c -o foo`\n",
                         &file->err[0]);
    expect_nothing_ran("bare: status 2 and nothing ran", 2, file);
    c::SmithCoreRouted *flag = route_command(&u, "smith", "-c", settings, "a.c", nullptr);
    scratch::expect_text("bare: a flag first gets the same hint",
                         "smith: -c is not a smith command; to compile, run `smith cc -c a.c`\n", &flag->err[0]);
    c::SmithCoreRouted *which = route_command(&u, "smith", "--smith-which", settings, "-c|a.c", nullptr);
    scratch::expect_text(
        "bare: --smith-which is a flag of the compiler verbs",
        "smith: --smith-which is not a smith command; to compile, run `smith cc --smith-which -c a.c`\n",
        &which->err[0]);
    c::SmithCoreRouted *old = route_command(&u, format::push(u.dir, "/smith++").data, "-c", settings, "a.cpp", nullptr);
    scratch::expect_text("bare: the old smith++ name is no compiler",
                         "smith: -c is not a smith command; to compile, run `smith cc -c a.cpp`\n", &old->err[0]);
}

export void test_run_version_and_no_arguments() {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Unit u = make_unit(&memory, &p, false, "clang");
    c::SmithCoreRouted *version = route_command(&u, "smith", "version", "", "", nullptr);
    expect_status_is("version: status 0", 0, version);
    // `smith 0.0`, then ` commit <hash>` when the commit is known.
    bool line = starts_with(&version->out[0], "smith 0.0") &&
                (version->out[9] == '\n' || starts_with(&version->out[9], " commit "));
    scratch::expect_text("version: the version line", "yes", line ? "yes" : &version->out[0]);
    c::SmithCoreRouted *bare = route_command(&u, "smith", nullptr, "", "", nullptr);
    expect_status_is("no arguments: status 2", 2, bare);
    scratch::expect_text("no arguments: usage", "usage: smith <command> [<arguments>]",
                         first_line(&memory, &bare->err[0]));
}

