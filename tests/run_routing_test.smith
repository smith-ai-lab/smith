// The driver runs its own program again with -cc1, as bin/clang and bin/clang++ of the programs folder, which are links
// to smith: those names act as the compiler, with the arguments as clang's.
export void test_run_the_names_clang_and_clang_plus_plus_act_as_the_compiler() {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Unit u = make_unit(&memory, &p, false, "clang clang++");
    c::SmithCoreRouted *clang = route_command(&u, format::push(u.dir, "/driver/clang").data, nullptr,
                                              format::push("SMITH_CLANG=", u.cl).data, "-c|a.c", nullptr);
    scratch::expect_text("the name clang acts as smith cc", format::push("exec ", u.cl, "\n[-c]\n[a.c]").data,
                         &clang->exec[0]);
    c::SmithCoreRouted *plus =
        route_command(&u, format::push(u.dir, "/driver/clang++").data, nullptr,
                      format::push("SMITH_CLANGXX=", u.dir, "/bin/clang++").data, "-c|a.cpp", nullptr);
    scratch::expect_text("the name clang++ acts as smith c++",
                         format::push("exec ", u.dir, "/bin/clang++\n[-c]\n[a.cpp]").data, &plus->exec[0]);
}

// ---- the wiring, with a process: what a unit test cannot show ----
// The routes above stop where smith would exec. What happens at the exec (the program is replaced, its status and its
// death by a signal become smith's, its standard error passes through) and the links by their names are the wiring.

static void wiring_of_the_compiler(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, link, "clang");
    scratch::Run run = go_clang(&r, "", "-c \"a b.c\" -o out.o");
    scratch::expect_text(nm(&r, "wiring: the stub clang runs with the arguments"),
                         format::push("clang argv0=", r.cl, "\n[-c]\n[a b.c]\n[-o]\n[out.o]").data, run.out);
    scratch::expect_text(nm(&r, "wiring: stderr passes through"), "clang-stderr", run.err);
    scratch::expect_status(nm(&r, "wiring: status 0"), 0, &run);
    scratch::Run exit_seven = go_clang(&r, "STUB_EXIT=7", "-c a.c");
    scratch::expect_status(nm(&r, "wiring: exit status is preserved"), 7, &exit_seven);
    scratch::Run signaled = go_clang(&r, "STUB_SIGNAL=15", "-c a.c");
    scratch::expect_status(nm(&r, "wiring: death by signal is preserved (128 + 15)"), 143, &signaled);
}

export void test_run_verb_wiring_of_the_compiler() {
    wiring_of_the_compiler(false);
}

export void test_run_link_wiring_of_the_compiler() {
    wiring_of_the_compiler(true);
}

// fmt stands for the tools: the same wiring (clang-format, clang-tidy, clangd, lldb and lldb-dap differ in a name).
export void test_run_tool_wiring_of_fmt() {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, false, "clang clang-format");
    scratch::write(r.p, ".clang-tidy", "");
    scratch::write(r.p, ".clang-format", "");
    const char *stub = format::push(r.dir, "/bin/clang-format").data;
    const char *var = format::push("SMITH_CLANG_FORMAT=", stub).data;
    scratch::Run run = go(&r, var, "\"$SMITH_SELF\"", "fmt -i \"a b.c\" --style=file");
    scratch::expect_text("fmt wiring: runs clang-format with the arguments",
                         format::push("clang-format argv0=", stub, "\n[-i]\n[a b.c]\n[--style=file]").data, run.out);
    scratch::expect_text("fmt wiring: stderr passes through", "clang-format-stderr", run.err);
    scratch::Run exited = go(&r, format::push("STUB_EXIT=3 ", var).data, "\"$SMITH_SELF\"", "fmt a.c");
    scratch::expect_status("fmt wiring: exit status is clang-format's", 3, &exited);
    scratch::Run signaled = go(&r, format::push("STUB_SIGNAL=15 ", var).data, "\"$SMITH_SELF\"", "fmt a.c");
    scratch::expect_status("fmt wiring: death by signal is preserved (128 + 15)", 143, &signaled);
}

// --smith-which names the clang inside, which only the real smith has (the units runner links none): the program's
// folder and identity, and Homebrew's clang for a smith without one.
static void in_process_which(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, link, "clang");
    if (!is_darwin(&r)) {
        test::note("not macOS: the default compiler is not checked");
        return;
    }
    scratch::Run which = go(&r, "-u SMITH_CLANG", r.cc, "--smith-which -c a.c");
    const char *head = first_line(arena, which.out);
    if (starts_with(head, "clang in-process ")) {
        const char *llvm_clang = head + c::strlen("clang in-process ");
        // The program is in the folder smith makes for itself on first use, which --smith-which does not make.
        bool found = scratch::contains(llvm_clang, "/smith/programs/") && ends_with(llvm_clang, "/bin/clang");
        scratch::expect_text(
            nm(&r, "in-process: the default is clang inside smith, run as the bin/clang of a folder of its own"), "yes",
            found ? "yes" : llvm_clang);
        const char *identity = c::strchr(which.out, '\n');
        bool named = identity != nullptr && starts_with(identity + 1, "identity llvm-") &&
                     c::strchr(identity + 1 + c::strlen("identity llvm-"), ' ') != nullptr;
        scratch::expect_text(nm(&r, "in-process: --smith-which names the identity of the clang inside"), "yes",
                             named ? "yes" : "identity llvm-<version> <hash>");
        scratch::Run plus = go(&r, "-u SMITH_CLANGXX", r.plus, "--smith-which -c a.cpp");
        scratch::expect_text(nm(&r, "in-process: smith++ is clang++ inside smith"),
                             format::push("clang in-process ", llvm_clang, "++").data, first_line(arena, plus.out));
        scratch::Run external = go_clang(&r, "", "--smith-which -c a.c");
        scratch::expect_text(nm(&r, "in-process: SMITH_CLANG still runs an external clang"),
                             format::push("clang ", r.cl).data, external.out);
        scratch::Run other = go(&r, format::push("-u SMITH_CLANG SMITH_CLANGXX=", r.dir, "/bin/clang++").data, r.cc,
                                "--smith-which -c a.c");
        scratch::expect_text(nm(&r, "in-process: SMITH_CLANGXX does not affect smith"), "yes",
                             starts_with(other.out, "clang in-process /") ? "yes" : other.out);
        return;
    }
    scratch::Run brew = scratch::sh(r.p, "test -x /opt/homebrew/opt/llvm/bin/clang");
    if (brew.status == 0) {
        scratch::expect_text(nm(&r, "on macOS the default is Homebrew's clang"),
                             "clang /opt/homebrew/opt/llvm/bin/clang", which.out);
        scratch::Run plus = go(&r, "-u SMITH_CLANGXX", r.plus, "--smith-which -c a.cpp");
        scratch::expect_text(nm(&r, "on macOS smith++ defaults to Homebrew's clang++"),
                             "clang /opt/homebrew/opt/llvm/bin/clang++", plus.out);
    }
    scratch::Run none =
        scratch::sh(r.p, "! test -x /opt/homebrew/opt/llvm/bin/clang && ! test -x /usr/local/opt/llvm/bin/clang");
    if (none.status == 0) {
        scratch::Run missing = go(&r, "-u SMITH_CLANG", r.cc, "-c a.c");
        scratch::expect_text(
            nm(&r, "macOS without Homebrew's llvm: the error names brew install llvm and SMITH_CLANG"),
            "smith: cannot find clang in /opt/homebrew/opt/llvm/bin: run `brew install llvm`, or set SMITH_CLANG",
            missing.err);
    }
}

export void test_run_verb_in_process_which() {
    in_process_which(false);
}

export void test_run_link_in_process_which() {
    in_process_which(true);
}

// The tools are inside smith: the same LLVM as the compiler, run on the arguments, in smith's process. Only a smith
// with clang inside has them (the default compiler says which), as on macOS. These run the real tool, so a unit test
// cannot show them.
static bool tools_inside(const Rig *r) {
    if (!is_darwin(r)) {
        return false;
    }
    scratch::Run which = go(r, "-u SMITH_CLANG", "\"$SMITH_SELF\" cc", "--smith-which -c a.c");
    return starts_with(which.out, "clang in-process ");
}

export void test_run_in_process_fmt_is_clang_format_23() {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, false, "clang");
    if (!tools_inside(&r)) {
        test::note("clang is not inside this smith");
        return;
    }
    scratch::Run version = go(&r, "-u SMITH_CLANG_FORMAT", "\"$SMITH_SELF\"", "fmt --version");
    scratch::expect_text("in-process: fmt is clang-format 23", "yes",
                         starts_with(version.out, "clang-format version 23.") ? "yes" : version.out);
    (void)scratch::sh(r.p, "mkdir tools");
    scratch::write(r.p, "tools/a.c", "int   main( ){return  0;}\n");
    scratch::Run stdin =
        go(&r, "-u SMITH_CLANG_FORMAT", "\"$SMITH_SELF\"",
           format::push("fmt --style=LLVM --assume-filename=\"", r.dir, "/tools/a.c\" <tools/a.c").data);
    scratch::expect_text("in-process: fmt formats standard input to stdout", "int main() { return 0; }", stdin.out);
    scratch::write(r.p, "tools/.clang-format",
                   "IndentWidth: 8\nUseTab: Never\nAllowShortFunctionsOnASingleLine: None\n");
    scratch::write(r.p, "tools/b.c", "int main() {\nreturn 0;\n}\n");
    scratch::Run formatted = go(&r, "-u SMITH_CLANG_FORMAT", "\"$SMITH_SELF\"",
                                format::push("fmt --assume-filename=\"", r.dir, "/tools/b.c\" <tools/b.c").data);
    scratch::expect_text("in-process: fmt reads the project's .clang-format", "int main() {\n        return 0;\n}",
                         formatted.out);
    (void)go(&r, "-u SMITH_CLANG_FORMAT", "\"$SMITH_SELF\"", format::push("fmt \"", r.dir, "/tools/b.c\"").data);
    scratch::expect_text("in-process: fmt of a named file rewrites it (as -i)", "int main() {\n        return 0;\n}",
                         scratch::read(r.p, "tools/b.c"));
}

export void test_run_in_process_lint_is_clang_tidy_23() {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, false, "clang");
    if (!tools_inside(&r)) {
        test::note("clang is not inside this smith");
        return;
    }
    scratch::Run version = go(&r, "-u SMITH_CLANG_TIDY", "\"$SMITH_SELF\"", "lint --version");
    scratch::expect_text("in-process: lint is clang-tidy 23", "yes",
                         scratch::contains(version.out, "LLVM version 23.") ? "yes" : version.out);
    scratch::Run listed =
        go(&r, "-u SMITH_CLANG_TIDY", "\"$SMITH_SELF\"", "lint --list-checks --checks='-*,readability-*'");
    scratch::expect_text("in-process: lint lists clang-tidy's checks", "yes",
                         scratch::contains(listed.out, "readability-identifier-naming") ? "yes" : listed.out);
    (void)scratch::sh(r.p, "mkdir tools");
    scratch::write(r.p, "tools/.clang-tidy",
                   "Checks: \"-*,readability-uppercase-literal-suffix\"\nWarningsAsErrors: \"*\"\n");
    scratch::write(r.p, "tools/c.c", "constexpr float x = 1.0f;\n");
    scratch::Run linted = go(&r, "-u SMITH_CLANG_TIDY", "\"$SMITH_SELF\"",
                             format::push("lint --quiet \"", r.dir, "/tools/c.c\" -- -std=gnu23").data);
    scratch::expect_text("in-process: lint reads the project's .clang-tidy and reports", "yes",
                         scratch::contains(linted.out, "floating point literal has suffix 'f'") ? "yes" : linted.out);
    scratch::expect_status("in-process: lint exits 1 on a finding that is an error", 1, &linted);
}

export void test_run_in_process_lsp_is_clangd_23() {
    scratch::Project p = scratch::make("r", nullptr);
