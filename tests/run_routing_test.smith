// The tools are inside smith: the same LLVM as the compiler, run on the arguments, in smith's process. Only a smith
// with clang inside has them (the default compiler says which), as on macOS.
static bool tools_inside(const Rig *r) {
    if (!is_darwin(r)) {
        return false;
    }
    scratch::Run which = go(r, "-u SMITH_CLANG", "\"$SMITH_SELF\" cc", "--smith-which -c a.c");
    return starts_with(which.out, "clang in-process ");
}

export void test_run_in_process_fmt_is_clang_format_23() {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, false, "clang");
    if (!tools_inside(&r)) {
        test::note("clang is not inside this smith");
        return;
    }
    scratch::Run version = go(&r, "-u SMITH_CLANG_FORMAT", "\"$SMITH_SELF\"", "fmt --version");
    scratch::expect_text("in-process: fmt is clang-format 23", "yes",
                         starts_with(version.out, "clang-format version 23.") ? "yes" : version.out);
    (void)scratch::sh(r.p, "mkdir tools");
    scratch::write(r.p, "tools/a.c", "int   main( ){return  0;}\n");
    scratch::Run stdin =
        go(&r, "-u SMITH_CLANG_FORMAT", "\"$SMITH_SELF\"",
           format::push(arena, "fmt --style=LLVM --assume-filename=\"", r.dir, "/tools/a.c\" <tools/a.c").data);
    scratch::expect_text("in-process: fmt formats standard input to stdout", "int main() { return 0; }", stdin.out);
    scratch::write(r.p, "tools/.clang-format",
                   "IndentWidth: 8\nUseTab: Never\nAllowShortFunctionsOnASingleLine: None\n");
    scratch::write(r.p, "tools/b.c", "int main() {\nreturn 0;\n}\n");
    scratch::Run formatted = go(&r, "-u SMITH_CLANG_FORMAT", "\"$SMITH_SELF\"",
                                format::push(arena, "fmt --assume-filename=\"", r.dir, "/tools/b.c\" <tools/b.c").data);
    scratch::expect_text("in-process: fmt reads the project's .clang-format", "int main() {\n        return 0;\n}",
                         formatted.out);
    (void)go(&r, "-u SMITH_CLANG_FORMAT", "\"$SMITH_SELF\"", format::push(arena, "fmt \"", r.dir, "/tools/b.c\"").data);
    scratch::expect_text("in-process: fmt of a named file rewrites it (as -i)", "int main() {\n        return 0;\n}",
                         scratch::read(r.p, "tools/b.c"));
}

export void test_run_in_process_lint_is_clang_tidy_23() {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, false, "clang");
    if (!tools_inside(&r)) {
        test::note("clang is not inside this smith");
        return;
    }
    scratch::Run version = go(&r, "-u SMITH_CLANG_TIDY", "\"$SMITH_SELF\"", "lint --version");
    scratch::expect_text("in-process: lint is clang-tidy 23", "yes",
                         scratch::contains(version.out, "LLVM version 23.") ? "yes" : version.out);
    scratch::Run listed =
        go(&r, "-u SMITH_CLANG_TIDY", "\"$SMITH_SELF\"", "lint --list-checks --checks='-*,readability-*'");
    scratch::expect_text("in-process: lint lists clang-tidy's checks", "yes",
                         scratch::contains(listed.out, "readability-identifier-naming") ? "yes" : listed.out);
    (void)scratch::sh(r.p, "mkdir tools");
    scratch::write(r.p, "tools/.clang-tidy",
                   "Checks: \"-*,readability-uppercase-literal-suffix\"\nWarningsAsErrors: \"*\"\n");
    scratch::write(r.p, "tools/c.c", "constexpr float x = 1.0f;\n");
    scratch::Run linted = go(&r, "-u SMITH_CLANG_TIDY", "\"$SMITH_SELF\"",
                             format::push(arena, "lint --quiet \"", r.dir, "/tools/c.c\" -- -std=gnu23").data);
    scratch::expect_text("in-process: lint reads the project's .clang-tidy and reports", "yes",
                         scratch::contains(linted.out, "floating point literal has suffix 'f'") ? "yes" : linted.out);
    scratch::expect_status("in-process: lint exits 1 on a finding that is an error", 1, &linted);
}

