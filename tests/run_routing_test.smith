// The routing tests of smith, from tests/run.sh: against stub compilers (tests/stub.c, which reports its name and every
// argument), so that no clang or Xcode is needed and no real build is touched. The compiler verbs and their links
// (`smith cc` and `smith-cc`), the tools (fmt, lint, lsp, dbg, dap), the bare arguments, and the verbs that need a
// build. A test makes its project, then sets its own memory as the current allocator: what scratch returns to it (a
// Run's texts, a file it reads) is given back with that memory, and scratch::clean frees what make holds.
module run_routing_test;

import smith::arena;
import smith::format;
import smith::test;
import scratch;
import <string.h>;
import smith::mem;

constexpr usize memory_size = (usize)4 << 20; // 4 MiB

// The first `length` bytes of a text, terminated.
static const char *prefix(arena::Arena *arena, const char *text, usize length) {
    char *copy = arena::push_slice(arena, char, length + 1).data;
    mem::copy(copy[0:length], text[0:length]);
    copy[length] = '\0';
    return copy;
}

// The stubs of a test: a project with the stub programs in bin/ and the links smith-cc, smith-c++, smith++, the
// programs folder's clang and clang++ (driver/) and bin/selfclang, all to the smith under test.
typedef struct {
    const scratch::Project *p;
    arena::Arena *arena; // the test's memory
    const char *dir;
    const char *cl;   // the stub clang
    const char *cc;   // the compiler form: `smith cc`, or the link smith-cc
    const char *plus; // and for C++
    const char *form; // verb or link
} Rig;

constexpr char stubs_script[_] =
    "mkdir -p bin driver && for n in $STUBS; do ${CC:-cc} -std=gnu23 -DNAME=\"\\\"$n\\\"\" "
    "tests/stub.c "
    "-o bin/$n || exit 1; done; ln -s \"$SMITH_SELF\" smith-cc && ln -s \"$SMITH_SELF\" smith-c++ && "
    "ln -s \"$SMITH_SELF\" 'smith++' && ln -s \"$SMITH_SELF\" bin/selfclang && ln -s \"$SMITH_SELF\" driver/clang && "
    "ln -s \"$SMITH_SELF\" driver/clang++";

static Rig make_rig(arena::Arena *arena, const scratch::Project *p, bool link, const char *stubs) {
    scratch::copy_tree(p, "tests/stub.c", "tests/stub.c");
    scratch::Run made = scratch::sh(p, format::push(arena, "STUBS='", stubs, "'; ", stubs_script).data);
    scratch::expect_status("the stub compilers are built", 0, &made);
    Rig r = {.p = p, .arena = arena, .dir = p->dir, .form = link ? "link" : "verb"};
    r.cl = format::push(arena, p->dir, "/bin/clang").data;
    r.cc = link ? format::push(arena, p->dir, "/smith-cc").data : "\"$SMITH_SELF\" cc";
    r.plus = link ? format::push(arena, p->dir, "/smith-c++").data : "\"$SMITH_SELF\" c++";
    return r;
}

// A name with the form in front: `[verb] ...`.
static const char *nm(const Rig *r, const char *what) {
    return format::push(r->arena, "[", r->form, "] ", what).data;
}

// Runs `env <settings> <tool> <arguments>` in the rig's folder.
static scratch::Run go(const Rig *r, const char *settings, const char *tool, const char *arguments) {
    return scratch::sh(r->p, format::push(r->arena, "env ", settings, " ", tool, " ", arguments).data);
}

static scratch::Run go_clang(const Rig *r, const char *settings, const char *arguments) {
    return go(r, format::push(r->arena, "SMITH_CLANG=", r->cl, " ", settings).data, r->cc, arguments);
}

static void expect_nothing_ran(const char *name, const scratch::Run *run) {
    scratch::expect_status(name, 2, run);
    scratch::expect_text(name, "", run->out);
}

static bool starts_with(const char *text, const char *prefix) {
    return c::strncmp(text, prefix, c::strlen(prefix)) == 0;
}

static bool ends_with(const char *text, const char *suffix) {
    usize n = c::strlen(text);
    usize m = c::strlen(suffix);
    return n >= m && c::strcmp(text + n - m, suffix) == 0;
}

// The first line of a text.
static const char *first_line(arena::Arena *arena, const char *text) {
    usize length = 0;
    while (text[length] != '\0' && text[length] != '\n') {
        length++;
    }
    return prefix(arena, text, length);
}

static bool is_darwin(const Rig *r) {
    return scratch::same(scratch::capture(r->p, "uname -s"), "Darwin");
}

// ---- the compiler, in both forms ----

static void clang_route(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, link, "clang");
    scratch::Run run = go_clang(&r, "", "-c \"a b.c\" \"\" -DX=\"y z\" -o out.o");
    scratch::expect_text(
        nm(&r, "clang route forwards every argument untouched"),
        format::push(arena, "clang argv0=", r.cl, "\n[-c]\n[a b.c]\n[]\n[-DX=y z]\n[-o]\n[out.o]").data, run.out);
    scratch::expect_text(nm(&r, "clang route: stderr passes through"), "clang-stderr", run.err);
    scratch::expect_status(nm(&r, "clang route: status 0"), 0, &run);
    scratch::Run exit_seven = go_clang(&r, "STUB_EXIT=7", "-c a.c");
    scratch::expect_status(nm(&r, "exit status is preserved"), 7, &exit_seven);
    scratch::Run signaled = go_clang(&r, "STUB_SIGNAL=15", "-c a.c");
    scratch::expect_status(nm(&r, "death by signal is preserved (128 + 15)"), 143, &signaled);
    scratch::Run version = go_clang(&r, "", "--version");
    scratch::expect_text(nm(&r, "--version goes to the compiler"),
                         format::push(arena, "clang argv0=", r.cl, "\n[--version]").data, version.out);
    scratch::Run response = go_clang(&r, "", "@r.rsp a.c");
    scratch::expect_text(nm(&r, "response files are forwarded untouched"),
                         format::push(arena, "clang argv0=", r.cl, "\n[@r.rsp]\n[a.c]").data, response.out);
    scratch::Run flag = go_clang(&r, "", "-I shaders.metal -c a.c");
    scratch::expect_text(nm(&r, "a flag value ending in .metal is not an input"),
                         format::push(arena, "clang argv0=", r.cl, "\n[-I]\n[shaders.metal]\n[-c]\n[a.c]").data,
                         flag.out);
}

export void test_run_verb_clang_route() {
    clang_route(false);
}

export void test_run_link_clang_route() {
    clang_route(true);
}

static const char *mixed_refusal =
    "smith: .metal and other inputs need different compilers and flags; compile the shaders in their own command";

static void metal_route(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, link, "clang xcrun metal");
    const char *path = format::push(arena, "PATH=\"", r.dir, "/bin:$PATH\"").data;
    scratch::Run xcrun = go(&r, path, r.cc, "-o shaders.metallib a.metal b.metal");
    scratch::expect_text(
        nm(&r, "metal route goes through xcrun -sdk macosx metal"),
        format::push(arena, "xcrun argv0=", r.dir,
                     "/bin/xcrun\n[-sdk]\n[macosx]\n[metal]\n[-o]\n[shaders.metallib]\n[a.metal]\n[b.metal]")
            .data,
        xcrun.out);
    scratch::Run metal = go(&r, format::push(arena, "SMITH_METAL=", r.dir, "/bin/metal").data, r.cc, "-E a.metal");
    scratch::expect_text(nm(&r, "SMITH_METAL replaces xcrun"),
                         format::push(arena, "metal argv0=", r.dir, "/bin/metal\n[-E]\n[a.metal]").data, metal.out);
    scratch::Run mixed = go_clang(&r, "", "a.metal b.c");
    scratch::expect_text(nm(&r, "mixed .metal and C inputs are refused"), mixed_refusal, mixed.err);
    expect_nothing_ran(nm(&r, "mixed inputs: status 2 and nothing ran"), &mixed);
    scratch::Run smith_metal = go_clang(&r, "", "a.smith b.metal");
    scratch::expect_text(nm(&r, "a .smith input and a .metal input are refused"), mixed_refusal, smith_metal.err);
}

export void test_macos_run_verb_metal_route() {
    metal_route(false);
}

export void test_macos_run_link_metal_route() {
    metal_route(true);
}

// A .smith input needs a smith whose clang has the token hook; any other refuses it, and does not compile it as C.
static void smith_inputs(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, link, "clang");
    scratch::Run which = go_clang(&r, "", "--smith-which -c a.smith");
    if (which.status == 0) {
        scratch::Run plain = go_clang(&r, "", "-c a.smith -o out.o");
        scratch::expect_text(nm(&r, "a .smith input is compiled as C, and nothing else changes"),
                             format::push(arena, "clang argv0=", r.cl,
                                          "\n[-std=gnu2y]\n[-fdefer-ts]\n[-c]\n[-x]\n[c]\n[a.smith]\n[-o]\n[out.o]")
                                 .data,
                             plain.out);
        scratch::Run mixed = go_clang(&r, "", "-c -I x.smith a.smith b.c c.smith -o out.o");
        scratch::expect_text(
            nm(&r, "the language is C for the .smith inputs only, and an option's value is no input"),
            format::push(arena, "clang argv0=", r.cl,
                         "\n[-std=gnu2y]\n[-fdefer-ts]\n[-c]\n[-I]\n[x.smith]\n[-x]\n[c]\n[a.smith]\n[-x]\n[none]"
                         "\n[b.c]\n[-x]\n[c]\n[c.smith]\n[-o]\n[out.o]")
                .data,
            mixed.out);
        scratch::Run standard = go_clang(&r, "", "-std=c23 -c a.smith");
        scratch::expect_text(
            nm(&r, "a .smith input is C2y unless the caller names a standard"),
            format::push(arena, "clang argv0=", r.cl, "\n[-fdefer-ts]\n[-std=c23]\n[-c]\n[-x]\n[c]\n[a.smith]").data,
            standard.out);
        scratch::Run cplus = go_clang(&r, "", "-c a.smith b.cpp");
        scratch::expect_text(
            nm(&r, "no C standard is added beside a C++ input"),
            format::push(arena, "clang argv0=", r.cl, "\n[-c]\n[-x]\n[c]\n[a.smith]\n[-x]\n[none]\n[b.cpp]").data,
            cplus.out);
        scratch::Run language = go_clang(&r, "", "-x c++ -c a.smith");
        scratch::expect_text(nm(&r, "a language named by the caller is left alone"),
                             format::push(arena, "clang argv0=", r.cl, "\n[-x]\n[c++]\n[-c]\n[a.smith]").data,
                             language.out);
        scratch::Run kept = go_clang(&r, "", "-x c -c a.smith");
        scratch::expect_text(
            nm(&r, "-x c is kept, and the standard is C2y and defer is on as for any .smith input"),
            format::push(arena, "clang argv0=", r.cl, "\n[-std=gnu2y]\n[-fdefer-ts]\n[-x]\n[c]\n[-c]\n[a.smith]").data,
            kept.out);
    } else {
        scratch::Run refused = go_clang(&r, "", "-c a.smith -o out.o");
        scratch::expect_text(nm(&r, "a .smith input is refused by a smith without the token hook"),
                             "smith: .smith files need a smith whose clang has the token hook "
                             "(patches/clang-token-hook.patch, applied by `smith build llvm`); this one has none",
                             refused.err);
        expect_nothing_ran(nm(&r, "a .smith input is refused: status 2 and nothing ran"), &refused);
    }
}

export void test_run_verb_smith_inputs() {
    smith_inputs(false);
}

export void test_run_link_smith_inputs() {
    smith_inputs(true);
}

static void plus_plus(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, link, "clang clang++");
    scratch::Run run = go(&r, format::push(arena, "SMITH_CLANGXX=", r.dir, "/bin/clang++").data, r.plus, "-c a.cpp");
    scratch::expect_text(nm(&r, "smith++ uses clang++"),
                         format::push(arena, "clang++ argv0=", r.dir, "/bin/clang++\n[-c]\n[a.cpp]").data, run.out);
}

export void test_run_verb_smith_plus_plus() {
    plus_plus(false);
}

export void test_run_link_smith_plus_plus() {
    plus_plus(true);
}

// On a smith with clang inside, the default compiler is that one, in a folder of its own; otherwise Homebrew's.
static void in_process_default(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, link, "clang");
    if (!is_darwin(&r)) {
        test::note("not macOS: the default compiler is not checked");
        return;
    }
    scratch::Run which = go(&r, "-u SMITH_CLANG", r.cc, "--smith-which -c a.c");
    const char *head = first_line(arena, which.out);
    if (starts_with(head, "clang in-process ")) {
        const char *llvm_clang = head + c::strlen("clang in-process ");
        // The program is in the folder smith makes for itself on first use, which --smith-which does not make.
        bool found = scratch::contains(llvm_clang, "/smith/programs/") && ends_with(llvm_clang, "/bin/clang");
        scratch::expect_text(
            nm(&r, "in-process: the default is clang inside smith, run as the bin/clang of a folder of its own"), "yes",
            found ? "yes" : llvm_clang);
        const char *identity = c::strchr(which.out, '\n');
        bool named = identity != nullptr && starts_with(identity + 1, "identity llvm-") &&
                     c::strchr(identity + 1 + c::strlen("identity llvm-"), ' ') != nullptr;
        scratch::expect_text(nm(&r, "in-process: --smith-which names the identity of the clang inside"), "yes",
                             named ? "yes" : "identity llvm-<version> <hash>");
        scratch::Run plus = go(&r, "-u SMITH_CLANGXX", r.plus, "--smith-which -c a.cpp");
        scratch::expect_text(nm(&r, "in-process: smith++ is clang++ inside smith"),
                             format::push(arena, "clang in-process ", llvm_clang, "++").data,
                             first_line(arena, plus.out));
        scratch::Run external = go_clang(&r, "", "--smith-which -c a.c");
        scratch::expect_text(nm(&r, "in-process: SMITH_CLANG still runs an external clang"),
                             format::push(arena, "clang ", r.cl).data, external.out);
        scratch::Run other = go(&r, format::push(arena, "-u SMITH_CLANG SMITH_CLANGXX=", r.dir, "/bin/clang++").data,
                                r.cc, "--smith-which -c a.c");
        scratch::expect_text(nm(&r, "in-process: SMITH_CLANGXX does not affect smith"), "yes",
                             starts_with(other.out, "clang in-process /") ? "yes" : other.out);
        return;
    }
    scratch::Run brew = scratch::sh(r.p, "test -x /opt/homebrew/opt/llvm/bin/clang");
    if (brew.status == 0) {
        scratch::expect_text(nm(&r, "on macOS the default is Homebrew's clang"),
                             "clang /opt/homebrew/opt/llvm/bin/clang", which.out);
        scratch::Run plus = go(&r, "-u SMITH_CLANGXX", r.plus, "--smith-which -c a.cpp");
        scratch::expect_text(nm(&r, "on macOS smith++ defaults to Homebrew's clang++"),
                             "clang /opt/homebrew/opt/llvm/bin/clang++", plus.out);
    }
    scratch::Run none =
        scratch::sh(r.p, "! test -x /opt/homebrew/opt/llvm/bin/clang && ! test -x /usr/local/opt/llvm/bin/clang");
    if (none.status == 0) {
        scratch::Run missing = go(&r, "-u SMITH_CLANG", r.cc, "-c a.c");
        scratch::expect_text(
            nm(&r, "macOS without Homebrew's llvm: the error names brew install llvm and SMITH_CLANG"),
            "smith: cannot find clang in /opt/homebrew/opt/llvm/bin: run `brew install llvm`, or set SMITH_CLANG",
            missing.err);
    }
}

export void test_run_verb_in_process_default() {
    in_process_default(false);
}

export void test_run_link_in_process_default() {
    in_process_default(true);
}

// The SDK is chosen through the environment, never a flag, and only for what the caller left unset.
static void sdk_environment(bool link) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, link, "clang xcrun");
    if (!is_darwin(&r)) {
        test::note("not macOS: the SDK is not chosen");
        return;
    }
    const char *path = format::push(arena, "PATH=\"", r.dir, "/bin:$PATH\"").data;
    const char *clang = format::push(arena, "clang argv0=", r.cl, "\n[-c]\n[a.c]").data;
    scratch::Run chosen = go(&r,
                             format::push(arena, "-u SDKROOT -u CLANG_NO_DEFAULT_CONFIG ", path,
                                          " STUB_SDK=/stub/sdk STUB_SHOW_ENV=1 SMITH_CLANG=", r.cl)
                                 .data,
                             r.cc, "-c a.c");
    scratch::expect_text(nm(&r, "macOS: SDKROOT comes from xcrun and the default config is off, with no flag added"),
                         format::push(arena, "env SDKROOT=/stub/sdk CLANG_NO_DEFAULT_CONFIG=1\n", clang).data,
                         chosen.out);
    scratch::Run mine = go(&r,
                           format::push(arena, "-u CLANG_NO_DEFAULT_CONFIG SDKROOT=/mine ", path,
                                        " STUB_SDK=/stub/sdk STUB_SHOW_ENV=1 SMITH_CLANG=", r.cl)
                               .data,
                           r.cc, "-c a.c");
    scratch::expect_text(nm(&r, "macOS: the caller's SDKROOT wins, and the default config is still off"),
                         format::push(arena, "env SDKROOT=/mine CLANG_NO_DEFAULT_CONFIG=1\n", clang).data, mine.out);
    scratch::Run config = go(&r,
                             format::push(arena, "-u SDKROOT CLANG_NO_DEFAULT_CONFIG=0 ", path,
                                          " STUB_SDK=/stub/sdk STUB_SHOW_ENV=1 SMITH_CLANG=", r.cl)
                                 .data,
                             r.cc, "-c a.c");
    scratch::expect_text(nm(&r, "macOS: the caller's CLANG_NO_DEFAULT_CONFIG wins"),
                         format::push(arena, "env SDKROOT=/stub/sdk CLANG_NO_DEFAULT_CONFIG=0\n", clang).data,
                         config.out);
    scratch::Run failed = go(&r,
                             format::push(arena, "-u SDKROOT -u CLANG_NO_DEFAULT_CONFIG ", path,
                                          " STUB_SDK=/stub/sdk STUB_XCRUN_FAIL=1 STUB_SHOW_ENV=1 SMITH_CLANG=", r.cl)
                                 .data,
                             r.cc, "-c a.c");
    scratch::expect_text(nm(&r, "macOS: when xcrun fails SDKROOT stays unset"),
                         format::push(arena, "env SDKROOT=(unset) CLANG_NO_DEFAULT_CONFIG=1\n", clang).data,
                         failed.out);
    scratch::Run sysroot = go(&r,
                              format::push(arena, "-u SDKROOT -u CLANG_NO_DEFAULT_CONFIG ", path,
                                           " STUB_SDK=/stub/sdk STUB_SHOW_ENV=1 SMITH_CLANG=", r.cl)
                                  .data,
                              r.cc, "-isysroot /mine/sdk -c a.c");
    scratch::expect_text(nm(&r, "macOS: the caller's -isysroot is forwarded untouched"),
                         format::push(arena, "env SDKROOT=/stub/sdk CLANG_NO_DEFAULT_CONFIG=1\nclang argv0=", r.cl,
                                      "\n[-isysroot]\n[/mine/sdk]\n[-c]\n[a.c]")
                             .data,
                         sysroot.out);
}

export void test_macos_run_verb_sdk_environment() {
    sdk_environment(false);
}

export void test_macos_run_link_sdk_environment() {
    sdk_environment(true);
}

// ---- fmt, lint, lsp, dbg and dap: the tool, with the arguments untouched, as the exact first argument ----

static void tool_routes(const char *command, const char *program, const char *variable) {
    scratch::Project p = scratch::make("r", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    arena::Arena *arena = &memory;
    Rig r = make_rig(arena, &p, false, format::push(arena, "clang ", program).data);
    // The folder has the project's own configuration, as the repository where the script ran has: smith adds its
    // defaults to the tool's arguments only where a project has none.
    scratch::write(r.p, ".clang-tidy", "");
    scratch::write(r.p, ".clang-format", "");
    const char *stub = format::push(arena, r.dir, "/bin/", program).data;
    const char *var = format::push(arena, variable, "=", stub).data;
    scratch::Run run = go(&r, var, "\"$SMITH_SELF\"",
                          format::push(arena, command, " -i \"a b.c\" \"\" --style=file -DX=\"y z\"").data);
    scratch::expect_text(
        format::push(arena, command, ": runs ", program, " with every argument untouched").data,
        format::push(arena, program, " argv0=", stub, "\n[-i]\n[a b.c]\n[]\n[--style=file]\n[-DX=y z]").data, run.out);
    scratch::expect_text(format::push(arena, command, ": stderr passes through").data,
                         format::push(arena, program, "-stderr").data, run.err);
    scratch::Run exited = go(&r, format::push(arena, "STUB_EXIT=3 ", var).data, "\"$SMITH_SELF\"",
                             format::push(arena, command, " a.c").data);
    scratch::expect_status(format::push(arena, command, ": exit status is ", program, "'s").data, 3, &exited);
    scratch::Run signaled = go(&r, format::push(arena, "STUB_SIGNAL=15 ", var).data, "\"$SMITH_SELF\"",
                               format::push(arena, command, " a.c").data);
    scratch::expect_status(format::push(arena, command, ": death by signal is preserved (128 + 15)").data, 143,
                           &signaled);
    scratch::Run missing = go(&r, format::push(arena, variable, "=/nonexistent/", program).data, "\"$SMITH_SELF\"",
                              format::push(arena, command, " a.c").data);
    scratch::expect_text(format::push(arena, command, ": a missing tool is reported").data,
                         format::push(arena, "smith: not an executable: /nonexistent/", program).data, missing.err);
    // Only as the exact first argument: after another argument it is a file name, for the compiler.
    scratch::Run after = go(&r, format::push(arena, "SMITH_CLANG=", r.cl, " ", var).data, "\"$SMITH_SELF\"",
                            format::push(arena, "cc -c ", command, " a.c").data);
    scratch::expect_text(format::push(arena, command, ": after another argument it goes to clang").data,
                         format::push(arena, "clang argv0=", r.cl, "\n[-c]\n[", command, "]\n[a.c]").data, after.out);
}

