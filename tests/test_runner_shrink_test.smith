// Shrinking a failed property test through built runners: a real failure is shrunk to the smallest case that still
// fails, and shrinking one test does not disturb another. Each case runs as workers and with --isolate. The search
// itself (the boundary, a failure that moves to another check, a list, a large word, the budget of runs) is tested
// without a runner in lib/std/test_shrink_test.smith. Fixtures: tests/build_fixtures/runner_shrink and _alongside.
module test_runner_shrink_test;

import std::arena;
import std::format;
import std::mem;
import std::test;
import runner;
import scratch;

// Each test's memory: what the helpers build and what the commands print, given back after the test.
constexpr usize memory_size = 1U << 22;

// A runner of its own build, for the cases that read symbolized paths, which a shared runner cannot give until #782.
static scratch::Project shrink_project(const char *files, const char *arguments) {
    scratch::Project p = runner::project("runner_base", files);
    scratch::Run run = runner::build(&p, arguments);
    scratch::expect_status("shrink: the runner builds", 0, &run);
    scratch::release(run.out);
    scratch::release(run.err);
    return p;
}

// The first number a sed expression finds in the runner's output.
static const char *number_in(const scratch::Project *p, const char *iso, const char *arguments, const char *sed) {
    const char *command =
        format::push("build/tests ", iso, " ", arguments, " 2>&1 | sed -n '", sed, "' | head -n 1").data;
    return scratch::capture(p, command);
}

static void case_a_uniform_failure_shrinks_to_the_boundary(usize mode) {
    scratch::Project p = shrink_project("runner_shrink", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    usize line = runner::line_of(&p, "tests/test_shrink.smith", "test::check_less(x, 500);");
    const char *iso = runner::flag(mode);
    // One run: its seed and its shrunk runs are read from the text it saved, which is also what is reported.
    (void)scratch::sh(
        &p, format::push("build/tests ", iso, " --trace --test shrink_int --shrink-seconds 3600 >raw.txt 2>&1").data);
    const char *seed =
        scratch::capture(&p, "sed -n 's/^FAIL shrink_int with seed \\([0-9]*\\),.*/\\1/p' raw.txt | head -n 1");
    const char *runs = scratch::capture(&p, "sed -n 's/.*shrunk in \\([0-9]*\\) runs.*/\\1/p' raw.txt | head -n 1");
    if (runner::can_symbolize(&p)) {
        const char *wanted = format::push("FAIL shrink_int with seed ", seed, ", shrunk in ", runs,
                                          " runs\n check failed at ", "tests/test_shrink.smith:", line, "\n ", line,
                                          " | test::check_less(x, 500);\n x = 500, 500 (i64)\n",
                                          " called from\n tests/test_shrink.smith:", line,
                                          " test_shrink_int\n rerun: smith test --test shrink_int ", "--seed ", seed,
                                          "\n\n0 passed, 1 failed")
                                 .data;
        scratch::expect_text(runner::label(iso, "shrink: a uniform [0, 1000] with x < 500 shrinks to 500"), wanted,
                             runner::report_of(&p, "raw.txt"));
    }
    scratch::Run alone = runner::tests(&p, iso, "--test shrink_int --shrink-seconds 3600");
    runner::expect_has(iso, "shrink: the runner on its own shows 500 and 500", &alone,
                       "    a = 500   (i64)\n    b = 500   (i64)");
    scratch::expect_count(runner::label(iso, "shrink: ... in at most 1000 runs"), 1,
                          (usize)(runs[0] != '\0' && runner::number(runs) <= 1000));

    scratch::Run unshrunk = runner::tests(&p, iso, "--test shrink_int --shrink 0");
    const char *first = number_in(&p, iso, "--test shrink_int --shrink 0", "s/^    a = \\([0-9]*\\) .*/\\1/p");
    scratch::expect_count(runner::label(iso, "shrink: --shrink 0 shows the unshrunk failure"), 1,
                          (usize)(first[0] != '\0' && runner::number(first) > 500));
    runner::expect_lacks(iso, "shrink: ... without 'shrunk'", &unshrunk, "shrunk");

    scratch::Run rerun = runner::smith_test(&p, iso, format::push("--test shrink_int --seed ", seed).data);
    runner::expect_has(iso, "shrink: the rerun line shrinks to the same case", &rerun, "    x = 500, 500   (i64)");
}

export void test_runner_shrink_a_uniform_failure_shrinks_to_the_boundary_workers() {
    case_a_uniform_failure_shrinks_to_the_boundary(0);
}

export void test_runner_shrink_a_uniform_failure_shrinks_to_the_boundary_isolated() {
    case_a_uniform_failure_shrinks_to_the_boundary(1);
}

// Shrinking does not make another test depend on it: while one test shrinks for seconds, a healthy test that writes
// more than 64 KiB, waits a second and writes more, still passes with --timeout 2.
static void case_a_healthy_test_is_not_disturbed_by_another_shrinking(usize mode) {
    scratch::Project p = runner::built_project("runner_base", "runner_alongside", "-DSAN=0");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *iso = runner::flag(mode);
    scratch::Run run = runner::tests(&p, iso, "--timeout 2 --jobs 2");
    runner::expect_has(iso, "alongside: the shrinking test fails and is shrunk", &run,
                       "FAIL a_shrinks_slowly with seed");
    runner::expect_lacks(iso, "alongside: ... and the other test is not a failure", &run, "FAIL b_writes_a_lot");
    runner::expect_has(iso, "alongside: ... it passes", &run, "1 passed, 1 failed");
}

export void test_runner_shrink_a_healthy_test_is_not_disturbed_by_another_shrinking_workers() {
    case_a_healthy_test_is_not_disturbed_by_another_shrinking(0);
}

export void test_runner_shrink_a_healthy_test_is_not_disturbed_by_another_shrinking_isolated() {
    case_a_healthy_test_is_not_disturbed_by_another_shrinking(1);
}
