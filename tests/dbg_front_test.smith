// A program written in the new syntax and compiled by the new front end with -g shows its source names, lines and
// locals in `smith dbg` (#1979, part of #1631): the breakpoint is set by the source name, the backtrace names the
// callers and the file with line and column, and `frame variable` lists the parameters and locals under their names.
// smith dbg is in the full smith only, so a smith without it skips these.
// smith-covers: smith.c runtime/verbs.c shim/lldb*.cpp shim/lldb/ shim/symbolize.cpp runtime/symbolize.c
// smith-covers: front/emit_debug.smith front/compile.smith
module dbg_front_test;

import scratch;
import std::arena;
import std::mem;
import std::test;

constexpr Usize memory_size = (Usize)16 << 20; // 16 MiB

constexpr char geometry[_] = "pub fn area(w: i32, h: i32) -> i32:\n"
                             "    let r = w * h\n"
                             "    r\n"
                             "\n"
                             "pub fn check() -> i32:\n"
                             "    area(2, 3) - 6\n";

// The stand-ins of the checks the new emitter calls, so the program links without smith's runtime.
constexpr char main_c[_] = "int check(void);\n"
                           "void smith_contract_fail_overflow(const char *a, unsigned long b, unsigned long c, "
                           "const char *d, const char *e) { __builtin_trap(); }\n"
                           "void smith_contract_fail_negate(unsigned long a, const char *b, const char *c) "
                           "{ __builtin_trap(); }\n"
                           "int main(void) { return check(); }\n";

static Bool made(scratch::Project *p) {
    if (scratch::sh(p, "smith dbg --version").status != 0) return false;
    scratch::write(p, "geometry.smith", geometry);
    scratch::write(p, "main.c", main_c);
    scratch::Run built = scratch::sh(p, "smith cc --front-end=new -g geometry.smith main.c -o prog 2>&1");
    scratch::expect_status("the program builds", 0, &built);
    return built.status == 0;
}

export void test_dbg_front_a_new_syntax_program_shows_source_names_lines_and_locals() {
    scratch::Project p = scratch::make("front_dbg", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!made(&p)) return;
    scratch::Run run = scratch::sh(&p, "smith dbg -b -o 'b area' -o run -o bt -o 'frame variable' prog 2>&1");
    scratch::expect_contains("the breakpoint is set by the source name", run.out, "Breakpoint 1: where = prog`area");
    scratch::expect_contains("frame 0 is the function and its file", run.out, "area(w=");
    scratch::expect_contains("... with its file", run.out, "geometry.smith:");
    scratch::expect_contains("the caller is named", run.out, "check at geometry.smith:6");
    scratch::expect_contains("a parameter shows under its name and type", run.out, "(int) w = ");
    scratch::expect_contains("a local shows under its name", run.out, "(int) r = ");
}
