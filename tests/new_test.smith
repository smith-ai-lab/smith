// The template exports a function over a slice, and `smith run` compiles it in the default debug profile, which has
// -fsanitize=function: clang overflowed its stack on that pair (issue #152).
export void test_new_hello_runs_an_exported_slice_function_in_debug() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    generated(&p, "generate hello");
    scratch::expect_contains("new hello: primes.smith exports a function over a slice",
                             scratch::read(&p, "hello/primes.smith"), "export i32 total(i32 xs[:])");
    scratch::Run ran = run_in(&p, "hello", "rm -rf build && smith run");
    scratch::expect_status("new hello: smith run builds the slice function in debug", 0, &ran);
    scratch::expect_contains("new hello: ... under -fsanitize=undefined",
                             capture(&p, "hello", "smith build -t commands build/debug/primes.o"),
                             "-fsanitize=address,undefined");
}

