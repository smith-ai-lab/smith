export void test_new_the_language_flag() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    (void)run(&p, "mkdir langs");
    scratch::Run eq = run_in(&p, "langs", "smith new --language=c eq");
    scratch::expect_status("new --language=c: exits 0", 0, &eq);
    expect_exists(&p, "new --language=c: writes the C program", "langs/eq/main.c", "yes");
    (void)run_in(&p, "langs", "smith new --language smith explicit");
    expect_exists(&p, "new --language smith: writes the .smith program", "langs/explicit/main.smith", "yes");
    (void)run_in(&p, "langs", "smith new explicit_first --language c");
    expect_exists(&p, "new <name> --language c: the flag may follow the name", "langs/explicit_first/main.c", "yes");
    scratch::Run bad = run_in(&p, "langs", "smith new --language rust bad");
    scratch::expect_status("new --language rust: exit status", 2, &bad);
    scratch::expect_contains("new --language rust: names both languages", bad.err, "--language is smith or c, not");
    scratch::expect_contains("new --language rust: ... and the value", bad.err, "rust");
    expect_exists(&p, "new --language rust: creates nothing", "langs/bad", "no");
    scratch::Run missing = run_in(&p, "langs", "smith new --language");
    scratch::expect_status("new --language with no value: exit status", 2, &missing);
    scratch::expect_contains("new --language with no value: says so", missing.err,
                             "--language needs a value: smith or c");
    scratch::Run help = run_in(&p, "langs", "smith new --help");
    scratch::expect_status("new --help: exits 0", 0, &help);
    scratch::expect_contains("new --help: shows the flag", help.out, "--language smith|c");
}

// 1b. assert(false) stops debug, release and fast (#326), in a scratch copy of each generated project.
static void assert_false_stops(const char *dir, const char *language_flag, const char *extension, const char *macro) {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    char command[1024];
    char label[256];
    __builtin_snprintf(command, sizeof command, "generate %s %s", dir, language_flag);
    generated(&p, command);
    __builtin_snprintf(command, sizeof command,
                       "sed \"s/%s(sum <= 28);/%s(false);/\" %s/main.%s >abort.new && mv abort.new %s/main.%s", macro,
                       macro, dir, extension, dir, extension);
    (void)run(&p, command);
    scratch::Run built = run_in(&p, dir, "smith build && smith build release fast");
    __builtin_snprintf(label, sizeof label, "assert(false) in %s: the three build", extension);
    scratch::expect_status(label, 0, &built);
    const char *modes[_] = {"debug", "release", "fast"};
    const char *statuses[_] = {"134", "134", "134"};
    const char *meanings[_] = {"debug stops", "release stops", "fast stops"};
    for (usize i = 0; i < _Countof(modes); i++) {
        __builtin_snprintf(command, sizeof command, "build/%s/%s >/dev/null 2>&1; echo $?", modes[i], dir);
        __builtin_snprintf(label, sizeof label, "assert(false) in %s: %s", extension, meanings[i]);
        scratch::expect_text(label, statuses[i], capture(&p, dir, command));
    }
}

export void test_new_assert_false_stops_every_build_in_smith() {
    assert_false_stops("hello", "", "smith", "contract::assert");
}

export void test_new_assert_false_stops_every_build_in_c() {
    assert_false_stops("hellc", "--language c", "c", "smith_assert");
}

