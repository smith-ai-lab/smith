// 1d. The verbs read what the build compiles, in a git copy of the generated C project: prove proves the contracts of
// the sources that are compiled, fmt formats what git sees (and leaves out .gitignore and .clang-format-ignore), lint
// reports what clang-tidy finds, and check reports every part that fails.
static void verbs_project(const scratch::Project *p) {
    generated(p, "generate hellc --language c && mkdir verbs && (cd hellc && tar cf - --exclude .git --exclude build "
                 "--exclude .smith .) | "
                 "(cd verbs && tar xf -)");
    (void)run_in(p, "verbs", "git init -q -b main && git add -A && git commit -q -m first");
    scratch::copy_tree(p, "tests/prove/clamp.c", "verbs/repo-clamp.c");
    (void)run_in(
        p, "verbs",
        "printf '#pragma once\\n#include <stdint.h>\\n\\nint32_t clamp(int32_t x, int32_t low, int32_t high);\\n"
        "int32_t draw_health(int32_t health, int32_t max_health);\\nint32_t pinned(int32_t x);\\n' >clamp.h; "
        "{ printf '#include \"clamp.h\"\\n'; cat repo-clamp.c; } >clamp.c; "
        "sed 's|#include \"primes.h\"|#include \"clamp.h\"\\n#include \"primes.h\"|' main.c >main.c.new && mv "
        "main.c.new main.c; rm repo-clamp.c");
}

export void test_new_the_verbs_prove_the_compiled_sources() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    verbs_project(&p);
    scratch::Run proved = run_in(&p, "verbs", "smith prove");
    if (!scratch::contains(proved.err, "has no prover")) {
        scratch::expect_status("new verbs: smith prove proves the contracts of the compiled sources", 0, &proved);
        scratch::expect_contains("new verbs: ... both functions, and the template's primes_sum and main", proved.out,
                                 "4 proved, 0 failed");
        (void)run_in(&p, "verbs",
                     "printf '#include <smith/contract.h>\\n\\n#include \"clamp.h\"\\n\\nint32_t pinned(int32_t x) "
                     "{\\n    smith_requires(x >= 0);\\n"
                     "    return clamp(x, 10, 5);\\n}\\n' >bad_caller.c; printf '#pragma once\\n#include "
                     "\"clamp.h\"\\n' >bad_caller.h; "
                     "sed 's|#include \"clamp.h\"|#include \"bad_caller.h\"\\n#include \"clamp.h\"|' main.c "
                     ">main.c.new && mv main.c.new main.c");
        scratch::Run bad = run_in(&p, "verbs", "smith prove");
        scratch::expect_status("new verbs: a caller that breaks a contract fails smith prove", 1, &bad);
        scratch::expect_contains("new verbs: ... at the call", bad.out,
                                 "bad_caller.c:7: the call of clamp may break smith_requires(low <= high)");
        (void)run_in(&p, "verbs",
                     "rm bad_caller.c bad_caller.h; sed '/#include \"bad_caller.h\"/d' main.c >main.c.new && mv "
                     "main.c.new main.c");
    }
}

export void test_new_the_verbs_format_lint_and_check_what_git_sees() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    verbs_project(&p);
    scratch::Run formatted = run_in(&p, "verbs", "smith fmt");
    scratch::expect_status("new verbs: smith fmt formats the files of a tree", 0, &formatted);
    (void)run_in(&p, "verbs",
                 "printf 'int   untracked_file;\\n' >extra.c; printf 'int   ignored_file;\\n' >ignored.c; "
                 "printf 'int   left_alone;\\n' >left.c; printf 'ignored.c\\n' >>.gitignore; printf 'left.c\\n' "
                 ">.clang-format-ignore; smith fmt");
    scratch::expect_text("new verbs: smith fmt formats a file git has not seen yet", "int untracked_file;",
                         scratch::read(&p, "verbs/extra.c"));
    scratch::expect_text("new verbs: ... not one .gitignore leaves out", "int   ignored_file;",
                         scratch::read(&p, "verbs/ignored.c"));
    scratch::expect_text("new verbs: ... nor one .clang-format-ignore names", "int   left_alone;",
                         scratch::read(&p, "verbs/left.c"));
    // Options alone are the project's verb (with standard input closed a clang-format waiting for it would fail, and
    // with a terminal it would hang); a .metal file is formatted too, as C++.
    (void)run_in(&p, "verbs",
                 "rm extra.c ignored.c left.c .clang-format-ignore; "
                 "printf 'kernel   void  f( device float*a [[buffer(0)]] ){ a[0]=1;}\\n' >shader.metal");
    scratch::Run dry = run_in(&p, "verbs", "smith fmt --dry-run </dev/null");
    scratch::expect_status("new verbs: smith fmt --dry-run is the project's check, and a .metal file fails it", 1,
                           &dry);
    char both[8192];
    __builtin_snprintf(both, sizeof both, "%s%s", dry.out, dry.err);
    scratch::expect_contains("new verbs: ... naming the .metal file", both, "shader.metal");
    (void)run_in(&p, "verbs", "smith fmt </dev/null");
    scratch::expect_text("new verbs: smith fmt formats a .metal file", "kernel void f(device float *a [[buffer(0)]]) {",
                         capture(&p, "verbs", "head -n 1 shader.metal"));
    scratch::Run again = run_in(&p, "verbs", "smith fmt --dry-run </dev/null");
    scratch::expect_status("new verbs: ... and then the dry run passes", 0, &again);
    scratch::Run quiet = run_in(&p, "verbs", "smith lint --quiet </dev/null");
    scratch::expect_status("new verbs: smith lint --quiet is the project's lint", 0, &quiet);
    (void)run_in(&p, "verbs",
                 "rm shader.metal; git checkout -q -- .gitignore; printf 'int   BadName = 0;\\n' >>primes.c");
    scratch::Run lint = run_in(&p, "verbs", "smith lint");
    scratch::expect_status("new verbs: smith lint fails on what clang-tidy finds", 1, &lint);
    __builtin_snprintf(both, sizeof both, "%s%s", lint.out, lint.err);
    scratch::expect_contains("new verbs: ... naming the check", both, "readability-identifier-naming");
    scratch::expect_contains("new verbs: ... and how many files", lint.err, "clang-tidy failed on 1 of");
    scratch::Run check = run_in(&p, "verbs", "smith check");
    scratch::expect_status("new verbs: smith check fails when parts do", 1, &check);
    scratch::expect_contains("new verbs: ... names the parts that failed, in order", check.err,
                             "smith check: failed: fmt lint");
    scratch::expect_contains("new verbs: ... and the parts that passed", check.err, "smith check: test ok");
}

// 1e. Two programs that link one source: each proof of it gets the full flags (the first once cut the compile's flags
// for every later proof of the same source, which then failed to find its header).
export void test_new_two_programs_that_link_one_source_are_each_proved_with_the_full_flags() {
    scratch::Project p = scratch::make("p", "new_shared");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run proved = run(&p, "smith prove");
    if (!scratch::contains(proved.err, "has no prover")) {
        scratch::expect_status("new shared: smith prove proves a source two programs link, both times", 0, &proved);
        scratch::expect_contains("new shared: ... the contract of shared.c is proved", proved.out,
                                 "1 proved, 0 failed");
        char both[8192];
        __builtin_snprintf(both, sizeof both, "%s%s", proved.out, proved.err);
        scratch::expect_lacks("new shared: ... and the header is found by both proofs", both, "file not found");
    }
}

// The check of smith docs on a folder of the project, in process: the summary line is all it says when it passes.
static void expect_docs_pass(const scratch::Project *p, const char *label, const char *name) {
    char *out = mem::alloc_slice(char, said_capacity).data;
    test::check_condition(c::smith_core_docs_check(joined(p->dir, "/", name), out, said_capacity));
    scratch::expect_contains(label, out, " 0 problems");
}

// 3. No argument: the folder's name, and its own main.c kept, with no program of the template beside it.
export void test_new_with_no_argument_the_folders_name_and_its_own_main() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Saved saved = {};
    git_isolate(&p, true, &saved);
    put(&p, "demo/main.c", "int main(void) { return 0; }\n");
    Said created = smith_new(&p, "demo", nullptr, nullptr, &saved);
    test::check_equal(created.status, 0);
    scratch::expect_text("no argument: keeps main.c", "int main(void) { return 0; }\n", slurp(&p, "demo/main.c"));
    scratch::expect_contains("no argument: names the program demo", created.out, "smith new: demo");
    scratch::expect_lacks("no argument: leaves out cd", created.out, "cd demo");
    expect_present(&p, "no argument: no concept about a main.c it did not write", "demo/knowledge/program.md", false);
    scratch::expect_lacks("no argument: the index lists no such concept", slurp(&p, "demo/knowledge/index.md"),
                          "program.md");
    expect_docs_pass(&p, "no argument: the docs pass", "demo");
    expect_present(&p, "no argument: writes no program beside the project's own", "demo/primes.c", false);
    expect_present(&p, "no argument: ... nor a .smith one", "demo/main.smith", false);
    expect_present(&p, "no argument: ... nor tests", "demo/tests", false);
    put(&p, "own_smith/main.smith", "int main(void) {\n    return 0;\n}\n");
    Said own = smith_new(&p, "", "own_smith", "c", &saved);
    test::check_equal(own.status, 0);
    expect_present(&p, "an own main.smith: --language c writes no C main beside it", "own_smith/main.c", false);
    expect_present(&p, "an own main.smith: ... nor its primes", "own_smith/primes.c", false);
}

// 4. Inside an existing repository. 5. No git identity.
export void test_new_inside_a_repository_and_with_no_git_identity() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Saved saved = {};
    git_isolate(&p, true, &saved);
    make_folder(&p, "outer");
    (void)run(&p, "git -C outer init -q -b main && git -C outer commit -q --allow-empty -m first");
    Said inner = smith_new(&p, "outer", "inner", nullptr, &saved);
    test::check_equal(inner.status, 0);
    expect_present(&p, "inside a repository: no new repository", "outer/inner/.git", false);
    scratch::expect_text("inside a repository: no commit", "1", capture(&p, ".", "git -C outer rev-list --count HEAD"));
    scratch::expect_text("inside a repository: nothing staged", "",
                         capture(&p, ".", "git -C outer diff --cached --name-only"));
    make_folder(&p, "noid");
    Saved without = {};
    git_isolate(&p, false, &without);
    Said noid = smith_new(&p, "noid", "proj", nullptr, &without);
    scratch::expect_text("no identity: exits 0", "0", joined(noid.status));
    expect_present(&p, "no identity: files written", "noid/proj/main.smith", true);
    scratch::expect_text(
        "no identity: files staged", "yes",
        capture(&p, ".", "git -C noid/proj diff --cached --name-only | grep -q '^main.smith$' && echo yes || echo no"));
    scratch::expect_text("no identity: no commit", "0",
                         capture(&p, ".", "git -C noid/proj rev-list --count HEAD 2>/dev/null || echo 0"));
    scratch::expect_contains("no identity: the message says the commit was skipped", noid.out, "commit skipped");
}

// 6. Errors (a second name and the flag's own errors are in test_new_the_language_flag).
export void test_new_errors() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Said bad = smith_new(&p, "", "-bad", nullptr, nullptr);
    test::check_equal(bad.status, 2);
    scratch::expect_text("bad name: message", "smith: -bad cannot name a program; use letters, digits, _, . and -\n",
                         bad.out);
    Said space = smith_new(&p, "", "a b", nullptr, nullptr);
    test::check_equal(space.status, 2);
    make_folder(&p, "bad name");
    Said folder = smith_new(&p, "bad name", nullptr, nullptr, nullptr);
    test::check_equal(folder.status, 2);
    scratch::expect_contains("bad folder name: names the parent folder way", folder.out,
                             "smith new <name> from the parent folder picks another name");
    expect_present(&p, "bad folder name: writes nothing", "bad name/main.smith", false);
    Said language = smith_new(&p, "", "bad", "rust", nullptr);
    test::check_equal(language.status, 2);
    scratch::expect_contains("new --language rust: names both languages", language.out,
                             "--language is smith or c, not: rust");
    expect_present(&p, "new --language rust: creates nothing", "bad", false);
}
// 9. An existing build.c is kept and gets no program; the first build is the project's own.
export void test_new_an_existing_build_c_is_kept() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    (void)run(&p, "mkdir has_build");
    scratch::write(&p, "has_build/build.c",
                   "#include <smith/build.h>\n\nvoid build(SmithBuild *b) {\n    SmithStep stamp = {\n"
                   "        .command = (const char *[]){\"touch\", \"$out\", nullptr},\n"
                   "        .outputs = (const char *[]){\"own.stamp\", nullptr},\n    };\n    smith_step(b, &stamp);\n"
                   "    smith_default(b, stamp.outputs);\n}\n");
    const char *before = scratch::read(&p, "has_build/build.c");
    scratch::Run created = run(&p, "smith new has_build");
    scratch::expect_status("existing build.c: exits 0", 0, &created);
    scratch::expect_text("existing build.c: kept", before, scratch::read(&p, "has_build/build.c"));
    expect_exists(&p, "existing build.c: no main.smith", "has_build/main.smith", "no");
    expect_exists(&p, "existing build.c: no config is written", "has_build/.clang-tidy", "no");
    expect_exists(&p, "existing build.c: the project's own build ran", "has_build/own.stamp", "yes");
}

// 10. Another build system: no program, no build file and no first build.
export void test_new_another_build_system_gets_no_program() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Saved saved = {};
    git_isolate(&p, true, &saved);
    put(&p, "has_make/Makefile", "all:\n\t@echo made\n");
    put(&p, "has_make/other.c", "int main(void) { return 0; }\n");
    Said created = smith_new(&p, "", "has_make", nullptr, &saved);
    test::check_equal(created.status, 0);
    expect_present(&p, "Makefile: writes no build.c", "has_make/build.c", false);
    expect_present(&p, "Makefile: no main.smith", "has_make/main.smith", false);
    expect_present(&p, "Makefile: no first build", "has_make/.smith", false);
    expect_present(&p, "Makefile: no concept about the program", "has_make/knowledge/program.md", false);
    scratch::expect_text("Makefile: the index lists nothing but is there", "okf_version",
                         scratch::capture(&p, "sed -n 's/^\\(okf_version\\):.*/\\1/p' has_make/knowledge/index.md"));
    scratch::expect_contains("Makefile: the index ends with its text, not a dangling item",
                             scratch::capture(&p, "tail -n 1 has_make/knowledge/index.md"), "Read only the concepts");
    expect_present(&p, "Makefile: writes no rules", "has_make/.clang-format", false);
    expect_present(&p, "Makefile: writes the plugin settings", "has_make/.claude/settings.json", true);
    scratch::expect_contains("Makefile: the message names the Makefile", created.out,
                             "This project builds with a Makefile, so smith new wrote no program");
    scratch::expect_contains("Makefile: the message says to port it", created.out,
                             "write a build.c that does what the Makefile does");
    scratch::expect_contains("Makefile: the message names the skill", created.out, "smith-build skill");
    scratch::expect_text("Makefile: commits only the files written",
                         ".agents/skills/has-make-docs/SKILL.md .claude/settings.json .claude/skills .gitignore "
                         "knowledge/index.md",
                         tracked(&p, "has_make"));
    expect_docs_pass(&p, "Makefile: the docs pass", "has_make");
    put(&p, "has_cmake/CMakeLists.txt", "");
    Said cmake = smith_new(&p, "", "has_cmake", nullptr, &saved);
    scratch::expect_contains("CMakeLists.txt: the message names it", cmake.out,
                             "This project builds with a CMakeLists.txt, so smith new wrote no program");
    expect_present(&p, "CMakeLists.txt: no main.smith", "has_cmake/main.smith", false);
}

// 11. An existing .gitignore is kept; the lines it lacks are reported. 11b. The same for .claude/settings.json.
export void test_new_an_existing_gitignore_and_settings_are_kept() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Saved saved = {};
    git_isolate(&p, true, &saved);
    put(&p, "has_ignore/.gitignore", "/build/  \nnode_modules/\n");
    Said created = smith_new(&p, "", "has_ignore", nullptr, &saved);
    scratch::expect_text("gitignore: kept untouched", "/build/  \nnode_modules/\n", slurp(&p, "has_ignore/.gitignore"));
    scratch::expect_contains("gitignore: reports /.cache/", created.out, "lacks /.cache/");
    scratch::expect_lacks("gitignore: does not report /build/ (trailing spaces ignored)", created.out, "lacks /build/");
    put(&p, "has_settings/.claude/settings.json", "{\"permissions\": {}}\n");
    Said settings = smith_new(&p, "", "has_settings", nullptr, &saved);
    scratch::expect_text("settings: kept untouched", "{\"permissions\": {}}\n",
                         slurp(&p, "has_settings/.claude/settings.json"));
    scratch::expect_contains("settings: reports the missing entry", settings.out, "lacks \"smith@smith\"");
    scratch::expect_contains("settings: says what to add", settings.out, "\"smith@smith\": true under enabledPlugins");
    put(&p, "has_settings2/.claude/settings.json", "{\"enabledPlugins\": {\"smith@smith\": false}}\n");
    Said second = smith_new(&p, "", "has_settings2", nullptr, &saved);
    scratch::expect_lacks("settings with the entry: no report", second.out, "lacks \"smith@smith\"");
}

// 13. Docs. The new project has knowledge and a skill, and smith docs and smith check hold them.
export void test_new_the_docs_of_a_new_project() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    generated(&p, "generate hello");
    scratch::expect_text("docs: the skill is named for the program", "name: hello-docs",
                         scratch::capture(&p, "grep '^name:' hello/.agents/skills/hello-docs/SKILL.md"));
    char expected[1024];
    __builtin_snprintf(expected, sizeof expected, "- [The program](program.md): %s",
                       scratch::capture(&p, "sed -n 's/^description: //p' hello/knowledge/program.md"));
    scratch::expect_text("docs: the index lists the concept with its own description", expected,
                         scratch::capture(&p, "grep '^- \\[' hello/knowledge/index.md"));
    scratch::Run docs = run_in(&p, "hello", "smith docs");
    scratch::expect_status("docs: smith docs passes on a new project", 0, &docs);
    scratch::expect_contains("docs: ... on the concept of the template", docs.out,
                             "smith docs: 1 concepts, 0 problems");
    scratch::expect_contains("docs: the allowed types are declared in the index",
                             scratch::read(&p, "hello/knowledge/index.md"),
                             "types: convention, architecture, contract, design");
    (void)run_in(
        &p, "hello",
        "sed 's/^types: .*/types: contract/' knowledge/index.md >index.new && mv index.new knowledge/index.md");
    scratch::Run refused = run_in(&p, "hello", "smith docs");
    scratch::expect_contains("docs: a type the index no longer declares is refused", refused.err,
                             "type 'architecture' is not one of contract");
    (void)run_in(&p, "hello", "git checkout -q -- knowledge/index.md");
    scratch::Run dot = run_in(&p, "hello", "smith docs .");
    scratch::expect_status("docs: smith docs . checks with the default types", 0, &dot);
    scratch::Run build_docs = run_in(&p, "hello", "smith build docs");
    scratch::expect_status("docs: smith build docs is refused, the verb runs it", 2, &build_docs);
    // smith check holds the docs: a conflict marker fails it.
    (void)run_in(&p, "hello", "printf '=======\\n' >>knowledge/program.md");
    scratch::Run marker = run_in(&p, "hello", "smith check");
    scratch::expect_text("docs: smith check fails on a document with a conflict marker", "yes",
                         yes_if(marker.status != 0));
    char both[16384];
    __builtin_snprintf(both, sizeof both, "%s%s", marker.out, marker.err);
    scratch::expect_contains("docs: ... and says where", both, "knowledge/program.md:");
    (void)run_in(&p, "hello", "git checkout -q -- knowledge/program.md");
    scratch::Run passes = run_in(&p, "hello", "smith check");
    scratch::expect_status("docs: smith check passes again", 0, &passes);
}

// Breaking each rule fails smith docs, in a copy.
static void broken(const scratch::Project *p, const char *name, const char *message, const char *commands) {
    char command[2048];
    char label[512];
    __builtin_snprintf(
        command, sizeof command,
        "rm -rf brk && mkdir brk && (cd hello && tar cf - --exclude .git --exclude build --exclude .smith .) | "
        "(cd brk && tar xf -) && (cd brk && %s) >/dev/null 2>&1; smith docs brk",
        commands);
    scratch::Run run_docs = run(p, command);
    __builtin_snprintf(label, sizeof label, "docs breaks: %s: exits 1", name);
    scratch::expect_status(label, 1, &run_docs);
    __builtin_snprintf(label, sizeof label, "docs breaks: %s: says so", name);
    scratch::expect_contains(label, run_docs.err, message);
}

export void test_new_breaking_each_docs_rule_fails_smith_docs() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    generated(&p, "generate hello");
    broken(&p, "a type the project does not allow",
           "knowledge/program.md: type 'poem' is not one of convention, architecture, contract, design",
           "sed 's/^type: .*/type: poem/' knowledge/program.md >p && mv p knowledge/program.md");
    broken(&p, "a concept without a title", "knowledge/program.md: frontmatter lacks title",
           "grep -v '^title:' knowledge/program.md >p && mv p knowledge/program.md");
    broken(&p, "a concept without a description", "knowledge/program.md: frontmatter lacks description",
           "grep -v '^description:' knowledge/program.md >p && mv p knowledge/program.md");
    broken(&p, "a concept without frontmatter", "knowledge/program.md: no frontmatter",
           "printf '# Program\\n' >knowledge/program.md");
    broken(&p, "a concept that is not kebab-case", "knowledge/Program_Two.md: file name is not kebab-case",
           "cp knowledge/program.md knowledge/Program_Two.md");
    broken(&p, "a concept the index does not list", "knowledge/index.md: does not list second.md",
           "cp knowledge/program.md knowledge/second.md");
    broken(&p, "an index item that is no concept", "knowledge/index.md: lists ghost.md, which is not a concept on disk",
           "printf -- '- [Ghost](ghost.md): Nothing.\\n' >>knowledge/index.md");
    broken(&p, "an index description that differs",
           "knowledge/index.md: description of program.md differs from its own",
           "sed 's/promise\\./promise, more./' knowledge/index.md >p && mv p knowledge/index.md");
    broken(&p, "an index without okf_version", "knowledge/index.md: frontmatter lacks okf_version",
           "grep -v '^okf_version' knowledge/index.md >p && mv p knowledge/index.md");
    broken(&p, "a skill whose name is not its folder",
           ".agents/skills/hello-docs/SKILL.md: name 'other' does not match its folder",
           "sed 's/^name: .*/name: other/' .agents/skills/hello-docs/SKILL.md >p && mv p "
           ".agents/skills/hello-docs/SKILL.md");
    broken(&p, "a skill without a description", ".agents/skills/hello-docs/SKILL.md: frontmatter lacks description",
           "grep -v '^description:' .agents/skills/hello-docs/SKILL.md >p && mv p .agents/skills/hello-docs/SKILL.md");
    broken(&p, "a broken link", "knowledge/program.md: broken link nowhere.md",
           "printf '[x](nowhere.md)\\n' >>knowledge/program.md");
    broken(&p, "a conflict marker", "knowledge/program.md:", "printf '<<<<<<< HEAD\\n' >>knowledge/program.md");
    broken(&p, "knowledge linking a skill",
           "knowledge/program.md: links the skill ../.agents/skills/hello-docs/SKILL.md; knowledge never links skills",
           "printf '[how](../.agents/skills/hello-docs/SKILL.md)\\n' >>knowledge/program.md");
    broken(&p, "no .claude/skills", ".claude/skills: missing; it must be a symlink to ../.agents/skills",
           "rm .claude/skills");
    broken(&p, "a .claude/skills that points elsewhere", ".claude/skills: links to ../skills, not ../.agents/skills",
           "rm .claude/skills && ln -s ../skills .claude/skills");
    broken(&p, "a .claude/skills that is a folder", ".claude/skills: is not a symlink",
           "rm .claude/skills && mkdir .claude/skills");
    // A name with more than letters: the skill's name is kebab-case and everything passes.
    scratch::Run named_run = run(&p, "smith new My_Proj.x");
    scratch::expect_status("docs: a name with _ and . exits 0", 0, &named_run);
    expect_exists(&p, "docs: ... its skill is my-proj-x-docs", "My_Proj.x/.agents/skills/my-proj-x-docs/SKILL.md",
                  "yes");
    scratch::expect_text("docs: ... its skill's name is its folder", "name: my-proj-x-docs",
                         scratch::capture(&p, "grep '^name:' My_Proj.x/.agents/skills/my-proj-x-docs/SKILL.md"));
    scratch::expect_contains("docs: ... its concept names the program",
                             scratch::read(&p, "My_Proj.x/knowledge/program.md"), "hello from My_Proj.x");
    scratch::Run docs = run_in(&p, "My_Proj.x", "smith docs");
    scratch::expect_status("docs: ... smith docs passes", 0, &docs);
}

// 12. The template's rules stay smith's: every rule and option of smith's own files is in the template's. Allowed
// differences: smith-only assert macro, typedef names, and unity-build include check.
constexpr char tidy_functions[_] =
    "tidy_items() { awk '/^Checks:/ { mode = \"checks\"; next } /^[A-Za-z]+:/ && !/^CheckOptions:/ { mode = \"\"; next "
    "} "
    "/^CheckOptions:/ { mode = \"options\"; next } mode == \"checks\" && /^  [^ #]/ { gsub(/[ ,]/, \"\"); print "
    "\"check \" $0 } "
    "mode == \"options\" && /^  [a-zA-Z]/ { sub(/:.*/, \"\"); gsub(/ /, \"\"); print \"option \" $0 }' \"$1\"; }; "
    "missing_rules() { tidy_items \"$1\" | grep -v -e 'bugprone-suspicious-include' -e "
    "'bugprone-assert-side-effect.AssertMacros' "
    "-e 'readability-identifier-naming.TypedefIgnoredRegexp' | while read -r kind item; do "
    "tidy_items \"$2\" | grep -qxF \"$kind $item\" || echo \"$kind $item\"; done; }; ";

export void test_new_the_templates_rules_stay_smiths() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, ".clang-tidy", "smith-clang-tidy");
    scratch::copy_tree(&p, "templates/defaults/clang-tidy", "template-clang-tidy");
    scratch::copy_tree(&p, ".clang-format", "smith-clang-format");
    scratch::copy_tree(&p, "templates/defaults/clang-format", "template-clang-format");
    char command[4096];
    __builtin_snprintf(command, sizeof command, "%s missing_rules smith-clang-tidy template-clang-tidy",
                       tidy_functions);
    scratch::expect_text("rules: the template keeps every rule of smith's .clang-tidy", "",
                         scratch::capture(&p, command));
    __builtin_snprintf(command, sizeof command,
                       "%s grep -v 'readability-function-size.LineThreshold' "
                       "template-clang-tidy >tidy-without; missing_rules smith-clang-tidy tidy-without",
                       tidy_functions);
    scratch::expect_contains("rules: a missing option is caught", scratch::capture(&p, command),
                             "readability-function-size.LineThreshold");
    __builtin_snprintf(command, sizeof command,
                       "%s grep -v 'misc-no-recursion' template-clang-tidy >tidy-without; "
                       "missing_rules smith-clang-tidy tidy-without",
                       tidy_functions);
    scratch::expect_contains("rules: a missing check is caught", scratch::capture(&p, command), "misc-no-recursion");
    scratch::expect_text("rules: the template's .clang-format has smith's rules, comments aside",
                         scratch::capture(&p, "grep -v '^#' smith-clang-format"),
                         scratch::capture(&p, "grep -v '^#' template-clang-format"));
}
