// `smith new` and the project it writes (issue #43), ported from tests/new.sh: what it creates and commits, the verbs
// on the new project (run, test, prove, fmt, lint, check, the three profiles), the libraries under the conventions'
// flags, a project with its own build file or another build system, git's states, the docs checks and the rules of the
// templates. Git is isolated from the user's configuration: HOME is a folder of the test, and the identity comes from
// the environment except in the no-identity case; SMITH_OUTPUT=full is set here too, as `smith test` sets it, so the
// cases read the nested verbs' full output (and fail on an empty one) however the runner is started. Each test is a
// project of its own, so they run side by side.
module new_test;

import std::arena;
import std::files;
import std::format;
import std::mem;
import std::test;
import scratch;
import <smith_core_docs.h>;
import <smith_core_new.h>;
import <string.h>;
import <sys/stat.h>;

constexpr char git_environment[_] =
    "export HOME=\"$PWD/.home\" GIT_CONFIG_NOSYSTEM=1 GIT_AUTHOR_NAME=Tester GIT_AUTHOR_EMAIL=tester@example.com "
    "GIT_COMMITTER_NAME=Tester GIT_COMMITTER_EMAIL=tester@example.com SMITH_OUTPUT=full; mkdir -p \"$HOME\"; ";

// `generate <name> [flags]` puts a copy of the project `smith new` makes in the folder, as `smith new` leaves it
// (built, committed): it is made once for each smith under test, in the tests' cache, so the tests that only need a
// project to work on do not each make one. The tests of `smith new` itself run it. Tests that start together all find
// the cache empty: each makes its own copy, and only the one whose mkdir of `.own` wins stores it (a mv onto a folder
// that a rival just stored moves into it, and every later test then copied a project holding another `hello`).
constexpr char generate_function[_] =
    "generate() { name=$1; shift; key=$(stat -c %Y-%s \"$SMITH_SELF\" 2>/dev/null || stat -f %m-%z \"$SMITH_SELF\"); "
    "t=$SMITH_TEST_CACHE/new-$key/$name; tmp=; src=$t; "
    "if [ ! -d \"$t\" ]; then find \"$SMITH_TEST_CACHE\" -maxdepth 1 -name 'new-*' -mtime +1 -exec rm -rf {} + "
    "2>/dev/null; "
    "tmp=$SMITH_TEST_CACHE/new-$key.$$; src=$tmp/$name; "
    "mkdir -p \"$tmp\" && (cd \"$tmp\" && smith new \"$@\" \"$name\" >/dev/null 2>&1) && "
    "mkdir -p \"$SMITH_TEST_CACHE/new-$key\" && "
    "if mkdir \"$t.own\" 2>/dev/null; then cp -Rp \"$src\" \"$t.part\" && mv \"$t.part\" \"$t\"; fi; fi; "
    "rm -rf \"./$name\"; { cp -Rpc \"$src\" \"./$name\" 2>/dev/null || cp -Rp \"$src\" \"./$name\"; }; "
    "[ -z \"$tmp\" ] || rm -rf \"$tmp\"; }; ";

static scratch::Run run(const scratch::Project *p, const char *command) {
    char text[8192];
    __builtin_snprintf(text, sizeof text, "%s%s", git_environment, command);
    return scratch::sh(p, text);
}

// The output of a command in the folder `in`, as $(...) gives it.
static void generated(const scratch::Project *p, const char *command) {
    char text[2048];
    __builtin_snprintf(text, sizeof text, "%s%s", generate_function, command);
    scratch::Run made = run(p, text);
    test::check_equal(made.status, 0);
}

static const char *capture(const scratch::Project *p, const char *in, const char *command) {
    char text[8192];
    __builtin_snprintf(text, sizeof text, "%scd \"%s\" && %s", git_environment, in, command);
    return scratch::capture(p, text);
}

static scratch::Run run_in(const scratch::Project *p, const char *in, const char *command) {
    char text[8192];
    __builtin_snprintf(text, sizeof text, "cd \"%s\" && %s", in, command);
    return run(p, text);
}

static const char *yes_if(bool condition) {
    return condition ? "yes" : "no";
}

static const char *exists_in(const scratch::Project *p, const char *path) {
    char text[1024];
    __builtin_snprintf(text, sizeof text, "if [ -e '%s' ] || [ -L '%s' ]; then echo yes; else echo no; fi", path, path);
    return scratch::capture(p, text);
}

static void expect_exists(const scratch::Project *p, const char *label, const char *path, const char *expected) {
    scratch::expect_text(label, expected, exists_in(p, path));
}

constexpr char smith_files[_] =
    ".agents/skills/hello-docs/SKILL.md .claude/settings.json .claude/skills .gitignore knowledge/index.md "
    "knowledge/program.md main.smith primes.smith primes_test.smith";
constexpr char c_files[_] =
    ".agents/skills/hellc-docs/SKILL.md .claude/settings.json .claude/skills .gitignore knowledge/index.md "
    "knowledge/program.md main.c primes.c primes.h primes_test.c";

// In process (issue #968): `smith new` as a function, through smith_core_new (include/smith_core_new.h), which writes
// the files and the commit and prints what the command prints, with no first build. The cases below that read which
// files it writes, with which contents, what it refuses and what it says, take it from there: no smith, no compiler.
// What needs the built project (its first build, `smith run`, the verbs) runs the command, further down.
constexpr usize said_capacity = 1U << 16;

typedef struct {
    i32 status;
    const char *out; // standard output and standard error together
} Said;

// The environment smith_core_new sets in its child: "NAME=value" and "-NAME", ended by nullptr. It stays where it is
// made (the entries point into it).
typedef struct {
    char home[1024];
    const char *entries[16];
} Saved;

static void ensure_folder(const char *path, usize length) {
    files::DoneResult made = files::make_folder(path[0:length]);
    test::check_condition(made == .ok);
}

// The pieces one after another, from the current allocator (the test's arena).
const char *joined(auto... pieces) {
    usize length = format::length(pieces...);
    char *text = mem::alloc_slice(char, length + 1).data;
    (void)format::to(text, length + 1, pieces...);
    return text;
}

// Git as the project's own: HOME a folder of the test, and the identity from the environment, or none at all.
static void git_isolate(const scratch::Project *p, bool identity, Saved *saved) {
    const char *folder = joined(p->root, "/.home");
    ensure_folder(folder, c::strlen(folder));
    (void)format::to(saved->home, sizeof saved->home, "HOME=", folder);
    usize n = 0;
    saved->entries[n++] = saved->home;
    saved->entries[n++] = "GIT_CONFIG_NOSYSTEM=1";
    if (identity) {
        saved->entries[n++] = "GIT_AUTHOR_NAME=Tester";
        saved->entries[n++] = "GIT_AUTHOR_EMAIL=tester@example.com";
        saved->entries[n++] = "GIT_COMMITTER_NAME=Tester";
        saved->entries[n++] = "GIT_COMMITTER_EMAIL=tester@example.com";
    } else {
        saved->entries[n++] = "-GIT_AUTHOR_NAME";
        saved->entries[n++] = "-GIT_AUTHOR_EMAIL";
        saved->entries[n++] = "-GIT_COMMITTER_NAME";
        saved->entries[n++] = "-GIT_COMMITTER_EMAIL";
        saved->entries[n++] = "-EMAIL";
        saved->entries[n++] = "GIT_CONFIG_COUNT=1";
        saved->entries[n++] = "GIT_CONFIG_KEY_0=user.useConfigOnly";
        saved->entries[n++] = "GIT_CONFIG_VALUE_0=true";
    }
    saved->entries[n] = nullptr;
}

// `smith new [--language <language>] [<name>]` in the folder `in` of the project ("" for the project's own), with git's
// environment of `saved` (nullptr: the runner's own).
static Said smith_new(const scratch::Project *p, const char *in, const char *name, const char *language,
                      const Saved *saved) {
    char *out = mem::alloc_slice(char, said_capacity).data;
    const char *folder = in[0] == '\0' ? p->dir : joined(p->dir, "/", in);
    const char *const *environment = saved != nullptr ? &saved->entries[0] : nullptr;
    i32 status = c::smith_core_new(folder, name, language, environment, out, said_capacity);
    return (Said){.status = status, .out = out};
}

static void make_folder(const scratch::Project *p, const char *name) {
    const char *folder = joined(p->dir, "/", name);
    ensure_folder(folder, c::strlen(folder));
}

// A file of the project with its text, in a folder made for it.
static void put(const scratch::Project *p, const char *name, const char *text) {
    const char *path = joined(p->dir, "/", name);
    const char *slash = c::strrchr(path, '/');
    ensure_folder(path, (usize)(slash - path));
    const u8 *bytes = (const u8 *)text;
    files::CountResult written = files::write_file(path[0:c::strlen(path)], bytes[0:c::strlen(text)], files::Replace);
    test::check_condition(written == .ok);
}

static bool present(const scratch::Project *p, const char *name) {
    struct c::stat info = {};
    return c::lstat(joined(p->dir, "/", name), &info) == 0;
}

static const char *slurp(const scratch::Project *p, const char *name) {
    const char *path = joined(p->dir, "/", name);
    files::BytesResult file = files::read_file(path[0:c::strlen(path)]);
    test::check_condition(file == .ok);
    if (file != .ok) return "";
    usize size = countof(file.ok);
    char *text = mem::alloc_slice(char, size + 1).data;
    for (usize i = 0; i < size; i++) {
        text[i] = (char)file.ok[i];
    }
    text[size] = '\0';
    return text;
}

static void expect_present(const scratch::Project *p, const char *label, const char *name, bool expected) {
    scratch::expect_text(label, yes_if(expected), yes_if(present(p, name)));
}

// What the program of a language is made of, in the folder `dir`, and the files its template leaves out.
static void expect_the_written_files(const scratch::Project *p, const char *label, const char *dir,
                                     const char *const present_files[:], const char *const absent_files[:]) {
    for (usize i = 0; i < countof(present_files); i++) {
        expect_present(p, joined(label, ": creates ", present_files[i]), joined(dir, "/", present_files[i]), true);
    }
    for (usize i = 0; i < countof(absent_files); i++) {
        expect_present(p, joined(label, ": writes no ", absent_files[i]), joined(dir, "/", absent_files[i]), false);
    }
}

static const char *tracked(const scratch::Project *p, const char *dir) {
    return capture(p, ".", joined("git -C ", dir, " ls-files | tr '\\n' ' ' | sed 's/ $//'"));
}

// 1. smith new hello: a .smith project, the default; what it writes and commits.
export void test_new_hello_the_smith_project_it_writes() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Saved saved = {};
    git_isolate(&p, true, &saved);
    Said created = smith_new(&p, "", "hello", nullptr, &saved);
    test::check_equal(created.status, 0);
    const char *const files[_] = {"main.smith",
                                  "primes.smith",
                                  "primes_test.smith",
                                  ".gitignore",
                                  ".claude/settings.json",
                                  "knowledge/index.md",
                                  "knowledge/program.md",
                                  ".agents/skills/hello-docs/SKILL.md"};
    const char *const absent[_] = {"build.c", "build.smith", ".clang-format", ".clang-tidy", "compile_commands.json",
                                   "main.c",  "primes.c",    "primes.h"};
    expect_the_written_files(&p, "new hello", "hello", files[0:countof(files)], absent[0:countof(absent)]);
    scratch::expect_contains("new hello: primes.smith names the program", slurp(&p, "hello/primes.smith"),
                             "console::print(\"hello from hello\\n\");");
    scratch::expect_text(
        "new hello: no placeholder is left", "",
        scratch::capture(
            &p, "grep -rF -e '@NAME@' -e '@KEBAB@' hello --exclude-dir=.git --exclude-dir=build --exclude-dir=.smith"));
    scratch::copy_tree(&p, "templates/new", "template");
    scratch::expect_text("new hello: the .smith template has no C or header file beside it, which an import would read",
                         "", scratch::capture(&p, "ls -A template | grep -E '[.][ch]$'"));
    scratch::expect_text("new hello: .gitignore is the template", slurp(&p, "template/gitignore"),
                         slurp(&p, "hello/.gitignore"));
    scratch::expect_text("new hello: .claude/settings.json is the template", slurp(&p, "template/claude-settings.json"),
                         slurp(&p, "hello/.claude/settings.json"));
    scratch::expect_text("new hello: .claude/settings.json is exactly the plugin settings",
                         "{\n  \"enabledPlugins\": {\n    \"smith@smith\": true\n  },\n  \"extraKnownMarketplaces\": "
                         "{\n    \"smith\": {\n"
                         "      \"source\": {\n        \"source\": \"github\",\n        \"repo\": "
                         "\"smith-ai-lab/smith\"\n      }\n    }\n  }\n}",
                         slurp(&p, "hello/.claude/settings.json"));
    scratch::expect_text("new hello: .claude/skills links to the skills", "../.agents/skills",
                         scratch::capture(&p, "readlink hello/.claude/skills"));
    expect_present(&p, "new hello: no CLAUDE.md", "hello/CLAUDE.md", false);
    expect_present(&p, "new hello: no AGENTS.md", "hello/AGENTS.md", false);
    scratch::expect_contains("new hello: the concept describes the .smith program",
                             slurp(&p, "hello/knowledge/program.md"), "primes::sum");
    scratch::expect_contains("new hello: the summary names the plugin", created.out,
                             "/plugin marketplace add smith-ai-lab/smith");
    scratch::expect_contains("new hello: the summary names the install", created.out, "/plugin install smith@smith");
    scratch::expect_lacks("new hello: no missing-entry report", created.out, "lacks \"smith@smith\"");
    scratch::expect_contains("new hello: the summary names the next step", created.out, "smith run");
    scratch::expect_contains("new hello: the summary says a repository was made", created.out,
                             "created a repository on main with one commit");
    scratch::expect_text("new hello: git is on main", "main",
                         capture(&p, ".", "git -C hello symbolic-ref --short HEAD"));
    scratch::expect_text("new hello: one commit", "1", capture(&p, ".", "git -C hello rev-list --count HEAD"));
    scratch::expect_text("new hello: the commit message", "chore: create hello with smith new",
                         capture(&p, ".", "git -C hello log -1 --format=%s"));
    scratch::expect_text("new hello: git tracks exactly the written files", smith_files, tracked(&p, "hello"));
    scratch::expect_text("new hello: the tree is clean after the commit", "",
                         capture(&p, ".", "git -C hello status --porcelain"));
}

// 1a. The same for smith new --language c hellc.
export void test_new_language_c_the_c_project_it_writes() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Saved saved = {};
    git_isolate(&p, true, &saved);
    Said created = smith_new(&p, "", "hellc", "c", &saved);
    test::check_equal(created.status, 0);
    const char *const files[_] = {"main.c",
                                  "primes.c",
                                  "primes.h",
                                  "primes_test.c",
                                  ".gitignore",
                                  ".claude/settings.json",
                                  "knowledge/index.md",
                                  "knowledge/program.md",
                                  ".agents/skills/hellc-docs/SKILL.md"};
    const char *const absent[_] = {"build.c",    "build.smith", ".clang-format", ".clang-tidy", "compile_commands.json",
                                   "main.smith", "primes.smith"};
    expect_the_written_files(&p, "new --language c", "hellc", files[0:countof(files)], absent[0:countof(absent)]);
    scratch::expect_contains("new --language c: main.c names the program", slurp(&p, "hellc/main.c"),
                             "hello from hellc\\n\", sum);");
    scratch::expect_contains("new --language c: the concept describes the C program",
                             slurp(&p, "hellc/knowledge/program.md"), "primes_sum");
    scratch::expect_text("new --language c: git tracks exactly the written files", c_files, tracked(&p, "hellc"));
    scratch::expect_text("new --language c: the tree is clean after the commit", "",
                         capture(&p, ".", "git -C hellc status --porcelain"));
}

// 1b. smith new hello: the first build, the program it makes and the greeting (a real compiler).
export void test_new_hello_a_smith_project_is_written_and_committed() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run created = run(&p, "smith new hello");
    scratch::expect_status("new hello: exits 0", 0, &created);
    expect_exists(&p, "new hello: the first build made the debug program", "hello/build/debug/hello", "yes");
    scratch::expect_text("new hello: the summary names the next step", "yes",
                         yes_if(scratch::contains(created.out, "smith run")));
    (void)run_in(&p, "hello", "smith run >../run.out 2>&1");
    scratch::expect_text("new hello: smith run prints the greeting", "hello from hello",
                         scratch::capture(&p, "tail -n 1 run.out"));
    scratch::expect_text("new hello: ... after the line of the sum", "the first 5 primes add up to 28",
                         scratch::capture(&p, "tail -n 2 run.out | head -n 1"));
}

// 2. A second run creates nothing.
export void test_new_a_second_run_creates_nothing() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Saved saved = {};
    git_isolate(&p, true, &saved);
    (void)smith_new(&p, "", "hello", nullptr,
                    &saved); // not a copy: the bytes of a project a second run leaves alone are the ones it made
    const char *sum =
        "cd hello && find . -path ./.git -prune -o \\( -type f -o -type l \\) -print | sort | while read -r f; do "
        "if [ -L \"$f\" ]; then echo \"$f -> $(readlink \"$f\")\"; else echo \"$f $(cksum <\"$f\")\"; fi; done";
    const char *before = scratch::capture(&p, sum);
    Said again = smith_new(&p, "", "hello", nullptr, &saved);
    test::check_equal(again.status, 0);
    scratch::expect_text("second run: changes no bytes", before, scratch::capture(&p, sum));
    scratch::expect_text("second run: no new commit", "1", capture(&p, ".", "git -C hello rev-list --count HEAD"));
    scratch::expect_contains("second run: everything is kept", again.out, "0 created, 9 kept");
}

// The label of a check on a new project: "<label>: <what>".
static const char *say(const char *label, const char *what) {
    static char text[1024];
    __builtin_snprintf(text, sizeof text, "%s: %s", label, what);
    return text;
}

static void in_folder(const scratch::Project *p, const char *dir, const char *format, const char *a, const char *b,
                      const char *c) {
    char command[2048];
    __builtin_snprintf(command, sizeof command, format, a, b, c);
    (void)run_in(p, dir, command);
}

// An assert in main that sum's ensures does not give fails smith prove, naming it.
static void a_wrong_assert_in_main_fails(const scratch::Project *p, const char *dir, const char *label,
                                         const char *main_file) {
    char command[1024];
    __builtin_snprintf(command, sizeof command, "sed 's/(sum <= 28);/(sum <= 27);/' %s >%s.new && mv %s.new %s",
                       main_file, main_file, main_file, main_file);
    (void)run_in(p, dir, command);
    scratch::Run wrong = run_in(p, dir, "smith prove");
    scratch::expect_status(say(label, "... an assert in main that sum's ensures does not give fails"), 1, &wrong);
    scratch::expect_contains(say(label, "... naming the assert"), wrong.out, "(sum <= 27) may fail");
    in_folder(p, dir, "cp %s.orig %s", main_file, main_file, "");
}

// smith prove on the new project: sum's contract, and main's assert from it.
static void prove_the_template(const scratch::Project *p, const char *dir, const char *label, const char *main_file) {
    scratch::Run proved = run_in(p, dir, "smith prove -v");
    if (!scratch::contains(proved.err, "has no prover")) {
        scratch::expect_status(say(label, "smith prove succeeds"), 0, &proved);
        scratch::expect_contains(say(label, "... and proves the contract of sum, and main's assert from it"),
                                 proved.out, "2 proved, 0 failed");
        scratch::expect_contains(say(label, "... main is in the proof set"), proved.out, "ok    main  (");
        scratch::expect_lacks(say(label, "... without skipping it"), proved.out, "nothing to prove");
        a_wrong_assert_in_main_fails(p, dir, label, main_file);
    }
}

// The verbs on a new project, in `dir`. Everything here ends with the files as they began, in git.
static void verbs_on_a_new_project(const scratch::Project *p, const char *dir, const char *label, bool smith_language) {
    const char *main_file = smith_language ? "main.smith" : "main.c";
    const char *test_file = smith_language ? "primes_test.smith" : "primes_test.c";
    const char *primes_file = smith_language ? "primes.smith" : "primes.c";
    char both[16384];
    in_folder(p, dir, "cp %s %s.orig", main_file, main_file, "");
    scratch::write(p, "args-main",
                   smith_language ? "import <stdio.h>;\n\ni32 main(i32 argc, char *argv[]) {\n    for (i32 i = 1; i < "
                                    "argc; i++)\n        c::puts(argv[i]);\n    return 0;\n}\n"
                                  : "#include <stdio.h>\n\nint main(int argc, char **argv) {\n    for (int i = 1; i < "
                                    "argc; i++)\n        puts(argv[i]);\n    return 0;\n}\n");
    in_folder(p, dir, "mv ../args-main %s", main_file, "", "");
    scratch::expect_text(say(label, "smith run passes its arguments to the program, -D after --"),
                         "a\nb c\nx;y\n5%\n-Dkeep",
                         capture(p, dir, "smith run a \"b c\" 'x;y' '5%' -- -Dkeep | grep -v '^\\['"));
    scratch::expect_text(say(label, "smith run with none passes none"), "",
                         capture(p, dir, "smith run | grep -v '^\\[' | tr -d '\\n'"));
    in_folder(p, dir, "cp %s.orig %s", main_file, main_file, "");
    scratch::Run tested = run_in(p, dir, "smith test");
    scratch::expect_status(say(label, "smith test passes out of the box"), 0, &tested);
    scratch::expect_contains(say(label, "... on the tests of the template"), tested.out,
                             smith_language ? "5 passed, 0 failed" : "2 passed, 0 failed");
    scratch::Run one = run_in(p, dir, "smith test --test 'no_primes*'");
    scratch::expect_contains(say(label, "smith test --test runs one test"), one.out, "1 passed, 0 failed");
    prove_the_template(p, dir, label, main_file);
    __builtin_snprintf(both, sizeof both, "sed 's/sum(5), 28/sum(5), 27/' %s >%s.new && mv %s.new %s", test_file,
                       test_file, test_file, test_file);
    (void)run_in(p, dir, both);
    scratch::Run failing = run_in(p, dir, "smith test");
    scratch::expect_status(say(label, "a failing test fails smith test"), 1, &failing);
    __builtin_snprintf(both, sizeof both, "%s%s", failing.out, failing.err);
    scratch::expect_contains(say(label, "... and shows both values"), both, "sum(5) = 28");
    scratch::Run check_failing = run_in(p, dir, "smith check");
    scratch::expect_text(say(label, "smith check fails when a test does"), "yes", yes_if(check_failing.status != 0));
    in_folder(p, dir, "git checkout -q -- %s", test_file, "", "");
    scratch::Run takes = run_in(p, dir, "smith check x");
    scratch::expect_contains(say(label, "smith check takes no arguments"), takes.err, "takes no arguments");
    scratch::Run refused = run_in(p, dir, "smith build check");
    scratch::expect_contains(say(label, "smith build check is refused for the verb"), refused.err,
                             "check is a verb, not a target of smith build; run `smith check`");
    scratch::Run checked = run_in(p, dir, "smith check");
    scratch::expect_status(say(label, "smith check passes on the new project"), 0, &checked);
    scratch::Run formatted = run_in(p, dir, "smith fmt --dry-run");
    scratch::expect_status(say(label, "smith fmt --dry-run is clean with smith's style"), 0, &formatted);
    scratch::Run linted = run_in(p, dir, "smith lint");
    scratch::expect_status(say(label, "smith lint is clean with smith's checks"), 0, &linted);
    in_folder(p, dir, "printf 'int   misformatted;\\n' >>%s", main_file, "", "");
    scratch::Run misformatted = run_in(p, dir, "smith check");
    __builtin_snprintf(both, sizeof both, "%s%s", misformatted.out, misformatted.err);
    scratch::expect_contains(say(label, "smith check fails on a misformatted file"), both, "misformatted");
    scratch::expect_text(say(label, "... with a nonzero status"), "yes", yes_if(misformatted.status != 0));
    scratch::Run rewritten = run_in(p, dir, "smith fmt");
    scratch::expect_status(say(label, "smith fmt rewrites the sources"), 0, &rewritten);
    char command[512];
    __builtin_snprintf(command, sizeof command, "tail -n 1 %s", main_file);
    scratch::expect_contains(say(label, "... to smith's style"), capture(p, dir, command), "int misformatted;");
    in_folder(p, dir, "cp %s.orig %s && rm %s.orig", main_file, main_file, main_file);
    in_folder(p, dir, "printf 'int   BadName = 0;\\n' >>%s", primes_file, "", "");
    scratch::Run bad_lint = run_in(p, dir, "smith lint");
    scratch::expect_status(say(label, "smith lint fails on what clang-tidy finds"), 1, &bad_lint);
    __builtin_snprintf(both, sizeof both, "%s%s", bad_lint.out, bad_lint.err);
    scratch::expect_contains(say(label, "... naming the check"), both, "readability-identifier-naming");
    in_folder(p, dir, "git checkout -q -- %s", primes_file, "", "");
}

// The three profiles of a new project and what each compiles with.
static void profiles_of_a_new_project(const scratch::Project *p, const char *dir, const char *label,
                                      bool smith_language) {
    char command[1024];
    char expected[256];
    char text[256];
    const char *main_file = smith_language ? "main.smith" : "main.c";
    (void)run_in(p, dir, "smith build"); // a copy of a generated project: its compile database names the paths again
    scratch::Run lsp = run_in(p, dir, "smith lsp --version");
    if (lsp.status == 0) {
        __builtin_snprintf(command, sizeof command, "smith lsp --check=%s 2>&1 | grep -c 'E\\['; true", main_file);
        scratch::expect_text(say(label, "clangd reports no errors in the main file, from .smith/compile_commands.json"),
                             "0", capture(p, dir, command));
        scratch::expect_text(say(label, "... with no compile_commands.json at the root"), "no",
                             capture(p, dir, "[ -e compile_commands.json ] && echo yes || echo no"));
    }
    scratch::Run built = run_in(p, dir, "smith build release fast");
    scratch::expect_status(say(label, "smith build release fast exits 0"), 0, &built);
    const char *modes[_] = {"debug", "release", "fast"};
    for (usize i = 0; i < _Countof(modes); i++) {
        __builtin_snprintf(command, sizeof command, "[ -e build/%s/$(basename \"$PWD\") ] && echo yes || echo no",
                           modes[i]);
        __builtin_snprintf(text, sizeof text, "the %s program exists", modes[i]);
        scratch::expect_text(say(label, text), "yes", capture(p, dir, command));
        __builtin_snprintf(command, sizeof command, "build/%s/$(basename \"$PWD\") | tail -n 1", modes[i]);
        __builtin_snprintf(text, sizeof text, "the %s program runs and prints its line", modes[i]);
        __builtin_snprintf(expected, sizeof expected, "hello from %s", dir);
        scratch::expect_text(say(label, text), expected, capture(p, dir, command));
    }
    __builtin_snprintf(command, sizeof command, "grep -q '\"%s\"' .smith/compile_commands.json && echo yes || echo no",
                       main_file);
    scratch::expect_text(say(label, "the commands are in .smith/compile_commands.json"), "yes",
                         capture(p, dir, command));
    const char *debug = capture(p, dir, "smith build -t commands build/debug/main.o");
    scratch::expect_contains(say(label, "debug has the sanitizers"), debug, "-fsanitize=address,undefined");
    scratch::expect_contains(say(label, "... compiles with -std=gnu2y"), debug, "-std=gnu2y");
    scratch::expect_lacks(say(label, "... and has no -DNDEBUG"), debug, "-DNDEBUG");
    const char *release = capture(p, dir, "smith build -t commands build/release/main.o");
    scratch::expect_contains(say(label, "release is -O2"), release, " -O2 ");
    scratch::expect_lacks(say(label, "... with assertions on"), release, "-DNDEBUG");
    scratch::expect_lacks(say(label, "... and no sanitizers"), release, "-fsanitize");
    scratch::expect_contains(say(label, "fast has -DNDEBUG"),
                             capture(p, dir, "smith build -t commands build/fast/main.o"), "-DNDEBUG");
}

