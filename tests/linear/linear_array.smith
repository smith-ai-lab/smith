module linear_array;

export [[std::linear]] typedef struct {
    u64 bits;
} Key;
export typedef struct {
    Key key;
    u64 n;
} Holder;
export u64 draw(Key key) {
    return key.bits;
}
export struct { Key, Key } split(Key key);
export typeof(Key[:]) split_many(Key key, usize count);
export u64 pair_sum(struct { Key, Key } pair);
export u64 total(Key keys[:]);
export u64 peek(const Key keys[:]);
export u64 take(Key *key);

u64 all(Key a, Key b) {
    Key keys[2] = {a, b};
    return draw(keys[0]) + draw(keys[1]);
}
u64 one_missing(Key a, Key b) {
    Key keys[2] = {a, b};
    return draw(keys[0]);
}
u64 element_twice(Key a, Key b) {
    Key keys[2] = {a, b};
    return draw(keys[0]) + draw(keys[0]) + draw(keys[1]);
}
u64 by_loop(Key a, Key b) {
    Key keys[2] = {a, b};
    u64 total = 0;
    for (usize i = 0; i < 2; i++)
        total += draw(keys[i]);
    return total;
}
