module linear_bad_index;

export [[std::linear]] typedef struct {
    u64 bits;
} Key;
export typedef struct {
    Key key;
    u64 n;
} Holder;
export u64 draw(Key key) {
    return key.bits;
}
export struct { Key, Key } split(Key key);
export typeof(Key[:]) split_many(Key key, usize count);
export u64 pair_sum(struct { Key, Key } pair);
export u64 total(Key keys[:]);
export u64 peek(const Key keys[:]);
export u64 take(Key *key);

u64 bad(Key a, Key b, usize j) {
    Key keys[2] = {a, b};
    u64 first = draw(keys[0]);
    return first + draw(keys[1]) + draw(keys[j]);
}
u64 shifted(Key a, Key b, Key c) {
    Key keys[3] = {a, b, c};
    u64 total = 0;
    for (usize i = 0; i < 2; i++)
        total += draw(keys[i + 1]);
    return total + draw(keys[0]);
}
