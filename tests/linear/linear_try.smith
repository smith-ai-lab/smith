module linear_try;

export [[std::linear]] typedef struct {
    u64 bits;
} Key;
export typedef struct {
    Key key;
    u64 n;
} Holder;
export u64 draw(Key key) {
    return key.bits;
}
export struct { Key, Key } split(Key key);
export typeof(Key[:]) split_many(Key key, usize count);
export u64 pair_sum(struct { Key, Key } pair);
export u64 total(Key keys[:]);
export u64 peek(const Key keys[:]);
export u64 take(Key *key);

export result(u64, i32) parse(i32 n);
export void sink(u64 value) {
    (void)value;
}

result(u64, i32) leaks(Key key) {
    u64 n = try parse(1);
    return n + draw(key);
}
result(u64, i32) covered(Key key) {
    defer sink(draw(key));
    u64 n = try parse(1);
    return n;
}
result(u64, i32) used_first(Key key) {
    u64 first = draw(key);
    u64 n = try parse(1);
    return n + first;
}
