module linear_tuple;

export [[std::linear]] typedef struct {
    u64 bits;
} Key;
export typedef struct {
    Key key;
    u64 n;
} Holder;
export u64 draw(Key key) {
    return key.bits;
}
export struct { Key, Key } split(Key key);
export typeof(Key[:]) split_many(Key key, usize count);
export u64 pair_sum(struct { Key, Key } pair);
export u64 total(Key keys[:]);
export u64 peek(const Key keys[:]);
export u64 take(Key *key);

u64 both(Key key) {
    struct { Key, Key } pair = split(key);
    return draw(pair[0]) + draw(pair[1]);
}
u64 one(Key key) {
    struct { Key, Key } pair = split(key);
    return draw(pair[0]);
}
u64 twice(Key key) {
    struct { Key, Key } pair = split(key);
    return draw(pair[0]) + draw(pair[0]) + draw(pair[1]);
}
u64 moved(Key key) {
    struct { Key, Key } pair = split(key);
    return pair_sum(pair);
}
u64 parameter(struct { Key, Key } pair) {
    return draw(pair[0]);
}
