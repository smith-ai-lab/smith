module linear_loop_outer;

export [[std::linear]] typedef struct {
    u64 bits;
} Key;
export typedef struct {
    Key key;
    u64 n;
} Holder;
export u64 draw(Key key) {
    return key.bits;
}
export struct { Key, Key } split(Key key);
export typeof(Key[:]) split_many(Key key, usize count);
export u64 pair_sum(struct { Key, Key } pair);
export u64 total(Key keys[:]);
export u64 peek(const Key keys[:]);
export u64 take(Key *key);

u64 loop(Key key, usize n) {
    u64 total = 0;
    for (usize i = 0; i < n; i++)
        total += draw(key);
    return total;
}
