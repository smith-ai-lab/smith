// `restrict` on a slice of rows is checked at the call as on a `[:]` (#65, #106): only the outermost bracket carries it,
// and the call proves the two ranges (the data and count * the rows' size) apart.
module geometry::restrict_grids;
import <smith/contract.h>;

void copy(u8 dst[restrict :][:], const u8 src[restrict :][:]) {
    c::smith_requires(countof(dst) <= countof(src));
    c::smith_ensures(true);
    if (countof(dst) > 0 && countof(dst[0]) > 0 && countof(src[0]) > 0) dst[0][0] = src[0][0];
}

export void apart() {
    c::smith_ensures(true);
    u8 a[4][2] = {0};
    u8 b[4][2] = {0};
    copy(a, b);
}

export void apart_slots(u8 m[:][:]) {
    c::smith_requires(countof(m) == 8);
    c::smith_ensures(true);
    u8 top[:][:] = m[0:4];
    u8 bottom[:][:] = m[4:8];
    copy(top, bottom);
}

export void overlapping(u8 m[:][:]) {
    c::smith_requires(countof(m) == 8);
    c::smith_ensures(true);
    u8 top[:][:] = m[0:4];
    u8 middle[:][:] = m[2:6];
    copy(top, middle);
}

export void same() {
    c::smith_ensures(true);
    u8 a[4][2] = {0};
    copy(a, a);
}
