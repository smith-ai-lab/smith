// An array parameter of a module is N objects: an index proved in range needs no other contract (#81).
module geometry::rows;
import <smith/contract.h>;

export I32 pick(I32 xs[4], Usize i) {
    c::smith_requires(i < 4);
    return xs[i];
}

export F32 corner(F32 m[3][2], Usize row) {
    c::smith_requires(row < 3);
    return m[row][1];
}

export I32 unchecked(I32 xs[4], Usize i) {
    return xs[i];
}
