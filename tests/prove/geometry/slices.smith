// A `T xs[:]` parameter points at countof(xs) elements: an index in range needs no contract (#106), and a view of a
// pointer is checked by what the pointer is known to hold.
module geometry::slices;
import <smith/contract.h>;

export I32 at(I32 xs[:], Usize i) {
    c::smith_ensures(true);
    if (i < countof(xs)) return xs[i];
    return 0;
}

export I32 unchecked(I32 xs[:], Usize i) {
    c::smith_ensures(true);
    return xs[i];
}

export I32 total(I32 xs[:]) {
    c::smith_requires(countof(xs) <= 5);
    c::smith_ensures(true);
    I32 sum = 0;
    for (Usize i = 0; i < countof(xs); i++) {
        if (xs[i] > 0 && xs[i] < 100) sum += xs[i];
    }
    return sum;
}

export I32 last_of_tail(I32 xs[:], Usize skip) {
    c::smith_requires(countof(xs) <= 8);
    c::smith_ensures(true);
    if (skip > countof(xs)) return 0;
    I32 rest[:] = xs[skip:];
    if (countof(rest) == 0) return 0;
    return rest[countof(rest) - 1];
}

export I32 first_of_one(I32 *p) {
    c::smith_ensures(true);
    I32 view[:] = p[0:1];
    return view[0];
}

export I32 second_of_one(I32 *p) {
    c::smith_ensures(true);
    I32 view[:] = p[0:2];
    return view[1];
}

export I32 of_four(I32 p[4]) {
    c::smith_ensures(true);
    I32 view[:] = p[0:4];
    return view[3];
}
