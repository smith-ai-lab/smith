// contract::modifies (#54): a slice names a range, `xs` or `p[a:b]`; what is outside it is kept.
module geometry::ranges;
import smith::contract;

// The first two elements of a slice, and nothing else.
export void set_two(i32 xs[:], i32 value) {
    contract::requires(2 <= countof(xs));
    contract::modifies(xs[0:2]);
    xs[0] = value;
    xs[1] = value;
    contract::ensures(true);
}

// A caller relies on an element the callee never named.
export void keeps_the_tail(i32 xs[:]) {
    contract::requires(3 <= countof(xs));
    const i32 third = xs[2];
    set_two(xs, 7);
    contract::assert(xs[2] == third);
}

// ... but not on one the range names.
export void relies_on_the_head(i32 xs[:]) {
    contract::requires(3 <= countof(xs));
    const i32 first = xs[0];
    set_two(xs, 7);
    contract::assert(xs[0] == first);
}

// A write one element past the range is refuted at its line.
export void writes_past(i32 xs[:]) {
    contract::requires(3 <= countof(xs));
    contract::modifies(xs[0:2]);
    xs[2] = 1;
    contract::ensures(true);
}

// The whole slice, and a write to another slice.
export void whole(i32 xs[:]) {
    contract::requires(1 <= countof(xs));
    contract::modifies(xs);
    xs[countof(xs) - 1] = 1;
    contract::ensures(true);
}

export void other_slice(i32 xs[:], i32 ys[:]) {
    contract::requires(1 <= countof(xs) && 1 <= countof(ys));
    contract::modifies(xs);
    ys[0] = 1;
    contract::ensures(true);
}

// A range of a pointer to an array of 4.
export void middle(i32 p[4]) {
    contract::modifies(p[1:3]);
    p[1] = 1;
    p[2] = 2;
    contract::ensures(p[1] == 1 && p[2] == 2);
}

export void keeps_the_ends(i32 p[4]) {
    const i32 first = p[0];
    const i32 last = p[3];
    middle(p);
    contract::assert(p[0] == first && p[3] == last);
}
