// Tests of `smith test --changed` in a project of its own (issue #456, knowledge/coverage-selection.md): it builds the
// tests and the program they run with the counters on, leaves a record for each test it runs in .smith/records, and
// the next run picks the tests whose record is stale. The project is the fixture tests/build_fixtures/record_project: a
// command line program, calc, and two end-to-end tests that each run it (the build graph sees no import between a test
// and ops.c). Nothing here is specific to smith. Each test makes its project with scratch::make and has a test::memory
// arena as the current allocator, so what scratch returns goes back with the arena.
module record_test;

import std::arena;
import std::format;
import std::mem;
import std::test;
import scratch;

// A repository of the fixture, committed on main. SMITH_OUTPUT=full for the messages of the nested smith.
constexpr char repository[_] = "export SMITH_OUTPUT=full; git init -q -b main . && printf "
                               "'build\\n.smith\\n*.profraw\\n' > .gitignore && git add -A && "
                               "git -c user.name=t -c user.email=t@t commit -q -m base; ";

// No records yet: every test runs once, instrumented, and each leaves its record, which names the functions it ran
// (the program's too) and not the other test's.
export void test_the_first_run_makes_a_record_for_each_test() {
    scratch::Project p = scratch::make("p", "record_project");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = scratch::sh(
        &p, format::push(repository, "smith test --changed --base HEAD 2>&1; "
                                     "echo ---; ls .smith/records; echo ---; cat .smith/records/add_runs.rec")
                .data);
    scratch::expect_status("the run", 0, &run);
    scratch::expect_contains("the reason", run.out, "no records yet, so every test runs once to make them");
    scratch::expect_contains("both ran", run.out, "2 passed");
    scratch::expect_contains("a record each", run.out, "add_runs.rec\nmul_runs.rec");
    scratch::expect_contains("the result", run.out, "result\tpass");
    scratch::expect_contains("the cpu seconds of the test", run.out, "\ncpu\t");
    scratch::expect_contains("the function the test ran", run.out, "fn\tops.c\tops_add");
    scratch::expect_contains("through the program it started", run.out, "fn\tmain.c\tmain");
    scratch::expect_contains("its own function", run.out, "fn\ttests/cli_test.c\ttest_add_runs");
    scratch::expect_contains("the header", run.out, "outside\tops.h");
    scratch::expect_lacks("not the other test's function", run.out, "ops_mul");
}

// A change inside a function reruns the test that ran it, and the record is rewritten; the other test is unchanged.
export void test_a_change_reruns_the_test_that_ran_it() {
    scratch::Project p = scratch::make("p", "record_project");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *edit = "sed 's/a \\* b/a * b + 0/' ops.c > next.c && mv next.c ops.c; ";
    scratch::Run run =
        scratch::sh(&p, format::push(repository, "smith test --changed --base HEAD >/dev/null 2>&1; ", edit,
                                     "smith test --changed --base HEAD --dry-run 2>&1; "
                                     "smith test --changed --base HEAD 2>&1; "
                                     "echo ---; cat .smith/records/mul_runs.rec")
                            .data);
    scratch::expect_status("the run", 0, &run);
    scratch::expect_contains("the stale record", run.out, "its record is stale: mul_runs");
    scratch::expect_contains("only that test", run.out, "--test mul_runs");
    scratch::expect_lacks("not the other", run.out, "add_runs");
    scratch::expect_lacks("not every test", run.out, "every test runs");
    scratch::expect_contains("it ran", run.out, "1 passed");
    scratch::expect_contains("the record names the new run", run.out, "fn\tops.c\tops_mul");
}

// A .c file that another includes (smith.c includes runtime/lang.c and the rest) is judged by function, not as a whole
// input (#638): a change inside the function one test ran selects that test, and a change to a line of a table selects
// every test that ran the program.
export void test_a_function_of_an_included_file_selects_the_tests_that_ran_it() {
    scratch::Project p = scratch::make("p", "record_project");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *unit =
        "printf 'static const int table[] = {\\n    1,\\n    2,\\n};\\n\\nstatic int more_add(int a, int b) {\\n"
        "    return a + b + table[0] - 1;\\n}\\n' > more.c; "
        "{ printf '#include \"more.c\"\\n'; sed 's/return a + b;/return more_add(a, b);/' ops.c; } > next.c && "
        "mv next.c ops.c; git add -A; git -c user.name=t -c user.email=t@t commit -q -m more; "
        "smith test --changed --base HEAD >/dev/null 2>&1; cat .smith/records/add_runs.rec; echo ---; ";
    const char *body = "sed 's/table\\[0\\] - 1/table[0] - 1 + 0/' more.c > next.c && mv next.c more.c; ";
    const char *entry = "git checkout -q more.c; sed 's/    2,/    3,/' more.c > next.c && mv next.c more.c; ";
    scratch::Run run = scratch::sh(&p, format::push(repository, unit, body,
                                                    "smith test --changed --base HEAD --dry-run 2>&1; echo ---; ",
                                                    entry, "smith test --changed --base HEAD --dry-run 2>&1")
                                           .data);
    scratch::expect_status("the run", 0, &run);
    scratch::expect_contains("the included file is judged by function", run.out, "fn\tmore.c\tops.c:more_add");
    scratch::expect_contains("and by what is outside its functions", run.out, "outside\tmore.c");
    scratch::expect_lacks("not as a whole", run.out, "input\tmore.c");
    scratch::expect_contains("the test that ran the function", run.out,
                             "its record is stale: add_runs, ops.c:more_add");
    scratch::expect_contains("a line of the table", run.out, "code outside functions changed");
    scratch::expect_contains("both ran the program", run.out, "--test add_runs,mul_runs");
}

// A test whose function is untouched by a change to the other is not selected, and a failed test is.
export void test_a_failed_test_reruns_and_the_rest_do_not() {
    scratch::Project p = scratch::make("p", "record_project");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *edit =
        "sed 's/return a \\* b;/return a * b + 1;/' ops.c > next.c && mv next.c ops.c; "
        "sed 's/mul 3 4 >/mul 3 4 \\&\\& false >/' tests/cli_test.c > next.c && mv next.c tests/cli_test.c; ";
    scratch::Run run =
        scratch::sh(&p, format::push(repository, "smith test --changed --base HEAD >/dev/null 2>&1; ", edit,
                                     "smith test --changed --base HEAD >/dev/null 2>&1; "
                                     "git checkout -q tests/cli_test.c; "
                                     "smith test --changed --base HEAD --dry-run 2>&1")
                            .data);
    scratch::expect_status("the run", 0, &run);
    scratch::expect_contains("the failed test is selected", run.out, "mul_runs");
    scratch::expect_lacks("the other is not", run.out, "add_runs");
}

// A plain `smith test` builds and records nothing.
export void test_a_plain_test_leaves_no_record() {
    scratch::Project p = scratch::make("p", "record_project");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = scratch::sh(&p, format::push(repository, "smith test 2>&1; ls .smith/records 2>&1").data);
    scratch::expect_contains("both ran", run.out, "2 passed");
    scratch::expect_lacks("no record", run.out, ".rec");
}

// A test that opens a file is stale when the file changes, and one that does not is not (#739): what a test opened is
// in its record (`read`, `readdir`), by what the process opened through io and not by a list or a scan of the commands
// it runs. A folder a test copies (scratch::copy_tree lists it and reads each file) names every file in it, and a file
// added to it changes its listing.
export void test_a_changed_file_selects_the_tests_that_opened_it() {
    scratch::Project p = scratch::make("p", "reads_project");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *list = "smith test --changed --list HEAD 2>/dev/null | paste -sd, -";
    const char *each = "; git checkout -q .; git clean -fdq data; ";
    scratch::Run run =
        scratch::sh(&p, format::push(repository, "smith test --changed --base HEAD >/dev/null 2>&1; ",
                                     "echo ---; cat .smith/records/reads_test__copies_a_folder.rec; echo ---; ",
                                     "echo more >> data/a.txt; echo \"file: $(", list, ")\"", each,
                                     "echo more >> data/b/y.txt; echo \"inside: $(", list, ")\"", each,
                                     "echo new > data/b/w.txt; echo \"added: $(", list, ")\"", each,
                                     "echo more >> data/c/z.txt; echo \"unread: $(", list, ")\"")
                            .data);
    scratch::expect_status("the run", 0, &run);
    scratch::expect_contains("the files of the folder", run.out, "read\tdata/b/y.txt\t");
    scratch::expect_contains("and its listing", run.out, "readdir\tdata/b/\t");
    scratch::expect_contains("a file io read", run.out, "file: reads_test::reads_a_file\n");
    scratch::expect_contains("a file in a folder the test copied", run.out, "inside: reads_test::copies_a_folder\n");
    scratch::expect_contains("a file added to that folder", run.out, "added: reads_test::copies_a_folder\n");
    scratch::expect_contains("a file no test opened", run.out, "unread: \n");
}
