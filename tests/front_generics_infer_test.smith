// Tests of bracketed generics worked out from the call's arguments (#1698, #2349): `fn f[T](xs: []T)` is a template
// whose `T` a call binds from the types of its arguments. Each scenario
// checks source text read by front::parser in an arena it sets as the current allocator.
module front_generics_infer_test;

import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        Bool same = true;
        for (Usize k = 0; k < countof(needle); k++) {
            if (text[i + k] != needle[k]) {
                same = false;
                break;
            }
        }
        if (same) return true;
    }
    return false;
}

static Str errors_of(const types::Checked *r) {
    Str text = "";
    for (Usize i = 0; i < r->error_count; i++) {
        Str line = r->errors[i].message;
        char joined[:] = mem::alloc_slice(char, countof(text) + countof(line) + 1);
        for (Usize k = 0; k < countof(text); k++) {
            joined[k] = text[k];
        }
        for (Usize k = 0; k < countof(line); k++) {
            joined[countof(text) + k] = line[k];
        }
        joined[countof(joined) - 1] = '\n';
        text = joined;
    }
    return text;
}

static types::Checked checked(Str source) {
    parser::Parsed p = parser::parse_new("t.smith", source);
    test::check_equal(countof(p.errors), (Usize)0);
    return types_decl::check_module(&p.module, types::lp64());
}

static Bool has_instance(const types::Checked *r, Str name) {
    for (Usize i = 0; i < r->instance_count; i++) {
        types::Instance x = r->instances[i];
        if (x.decl->kind == .function && has(x.decl->kind.function.name, name) &&
            countof(x.decl->kind.function.name) == countof(name)) {
            return true;
        }
    }
    return false;
}

export void test_front_generics_infer_a_slice_binds_the_element() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "fn first[T](xs: []T) -> T:\n    return xs[0]\n\nfn run(xs: []f64) -> f64:\n    return first(xs)\n";
    types::Checked r = checked(source);
    test::check_equal(countof(errors_of(&r)), (Usize)0);
    test::check_condition(has_instance(&r, "first.f64"));
}

export void test_front_generics_infer_a_pointer_binds_the_pointee() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "fn load[T](p: *T) -> T:\n    return p.*\n\nfn run(p: *i32) -> i32:\n    return load(p)\n";
    types::Checked r = checked(source);
    test::check_equal(countof(errors_of(&r)), (Usize)0);
    test::check_condition(has_instance(&r, "load.i32"));
}

export void test_front_generics_infer_two_parameters_bind_two_generics() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source =
        "fn pair[K, V](k: K, v: V) -> V:\n    return v\n\nfn run(a: i32, b: f64) -> f64:\n    return pair(a, b)\n";
    types::Checked r = checked(source);
    test::check_equal(countof(errors_of(&r)), (Usize)0);
    test::check_condition(has_instance(&r, "pair.i32.f64"));
}

export void test_front_generics_infer_an_array_length_binds_a_constant() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "fn first[T, n: usize](data: [n]T) -> T:\n    return data[0]\n\nfn run(a: [8]f64) -> f64:\n    return "
                 "first(a)\n";
    types::Checked r = checked(source);
    test::check_equal(countof(errors_of(&r)), (Usize)0);
    test::check_condition(has_instance(&r, "first.f64.8"));
}

export void test_front_generics_infer_a_nested_pointer_to_slice_binds() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "fn head[T](p: *[]T) -> T:\n    return p.*[0]\n\nfn run(p: *[]u8) -> u8:\n    return head(p)\n";
    types::Checked r = checked(source);
    test::check_equal(countof(errors_of(&r)), (Usize)0);
    test::check_condition(has_instance(&r, "head.u8"));
}

export void test_front_generics_infer_a_literal_binds_what_no_argument_does() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "fn same[T](a: T, b: T) -> T:\n    return a\n\nfn run(x: f64) -> f64:\n    return same(x, 2)\n";
    types::Checked r = checked(source);
    test::check_equal(countof(errors_of(&r)), (Usize)0);
    test::check_condition(has_instance(&r, "same.f64"));
}

export void test_front_generics_infer_one_instance_for_equal_bindings() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "fn first[T](xs: []T) -> T:\n    return xs[0]\n\nfn run(a: []i32, b: []i32) -> i32:\n    return "
                 "first(a) + first(b)\n";
    types::Checked r = checked(source);
    test::check_equal(countof(errors_of(&r)), (Usize)0);
    test::check_condition(has_instance(&r, "first.i32"));
}

export void test_front_generics_infer_an_unbound_generic_is_an_error() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "fn make[T](n: usize) -> usize:\n    return n\n\nfn run() -> usize:\n    return make(3)\n";
    types::Checked r = checked(source);
    test::check_condition(has(errors_of(&r), "cannot work out `T`"));
}

export void test_front_generics_infer_a_conflicting_binding_is_an_error() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source =
        "fn same[T](a: T, b: T) -> T:\n    return a\n\nfn run(x: i32, y: f64) -> i32:\n    return same(x, y)\n";
    types::Checked r = checked(source);
    test::check_condition(has(errors_of(&r), "from an earlier argument"));
}

export void test_front_generics_infer_a_concept_is_checked() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "fn twice[T: num](a: T) -> T:\n    return a\n\nfn run(s: str) -> str:\n    return twice(s)\n";
    types::Checked r = checked(source);
    test::check_condition(has(errors_of(&r), "which is not a"));
}

export void test_front_generics_infer_a_method_call_binds_from_its_receiver() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "fn put[T](xs: *mut []T, x: T):\n    xs.*[0] = x\n\nfn run(xs: *mut []u8):\n    xs.put(3)\n";
    types::Checked r = checked(source);
    test::check_equal(countof(errors_of(&r)), (Usize)0);
    test::check_condition(has_instance(&r, "put.u8"));
}

export void test_front_generics_infer_explicit_brackets_pin_the_generic() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "fn zero[T]() -> T:\n    return 0\n\nfn run() -> f32:\n    return zero[f32]()\n";
    types::Checked r = checked(source);
    test::check_equal(countof(errors_of(&r)), (Usize)0);
    test::check_condition(has_instance(&r, "zero.f32"));
}
