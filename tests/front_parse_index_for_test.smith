// Tests of the index form of `for` (#2512, from #2482): `for i, j: body` has no `in` and walks an array's shape. The
// parser reads it as a `for_index` statement; `for x in xs:` is unchanged. The checker and the emitter do not read it
// yet.
module front_parse_index_for_test;

import front::ast;
import front::parser;
import std::arena;
import std::mem;
import std::slice;
import std::test;

static Bool has(Str text, Str piece) {
    for (Usize i = 0; i + countof(piece) <= countof(text); i++) {
        if (slice::equal(text[i:i + countof(piece)], piece)) return true;
    }
    return false;
}

static Bool same(Str a, Str b) {
    return slice::equal(a, b);
}

// The first error of a file in the new syntax, or `no error`.
static Str first_error(Str source) {
    parser::Parsed parsed = parser::parse_new("t.smith", source);
    if (countof(parsed.errors) == 0) return "no error";
    return parsed.errors[0].message;
}

static Str dump_of(Str source) {
    parser::Parsed parsed = parser::parse_new("t.smith", source);
    test::check_equal(same(first_error(source), "no error"), true);
    return ast::dump(&parsed.module);
}

export void test_index_for_with_two_indices() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str got = dump_of("fn f():\n    for i, j:\n        g(a[j, i])\n");
    test::check_equal(has(got, "for_index"), true);
}

export void test_index_for_with_one_index_and_one_line() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str got = dump_of("fn f():\n    for i: g(i)\n");
    test::check_equal(has(got, "for_index"), true);
}

export void test_index_for_nested() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str got = dump_of("fn f():\n    for i, j:\n        for k:\n            g(i, j, k)\n");
    test::check_equal(has(got, "for_index"), true);
}

export void test_for_in_is_unchanged() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str got = dump_of("fn f():\n    for x in xs:\n        g(x)\n");
    test::check_equal(has(got, "for_in"), true);
    test::check_equal(has(got, "for_index"), false);
}

export void test_index_for_with_a_repeated_index_is_an_error() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    test::check_equal(same(first_error("fn f():\n    for i, i:\n        g(i)\n"), "the index name is repeated"), true);
}

export void test_index_for_with_an_empty_body_is_an_error() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    test::check_equal(same(first_error("fn f():\n    for i, j:\n    g()\n"), "no error"), false);
}
