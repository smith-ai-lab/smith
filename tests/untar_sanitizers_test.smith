// The AppleDouble tar, as in the section 3 tests, when this tar writes AppleDouble entries.
constexpr char make_apple[_] =
    "mkdir -p apple/pkg-1.0 apple-plain/pkg-1.0; echo first >apple/pkg-1.0/a; echo second >apple/pkg-1.0/b; "
    "printf 'a plain file that only has a name like metadata\\n' >apple-plain/pkg-1.0/dot_plain; "
    "printf 'tiny\\n' >apple-plain/pkg-1.0/dot_tiny; "
    "xattr -w com.example.test value apple/pkg-1.0/a 2>/dev/null; xattr -w com.example.test value apple/pkg-1.0/b "
    "2>/dev/null; (cd apple && env -u COPYFILE_DISABLE tar -cf \"$arc/apple.tar\" pkg-1.0); "
    "(cd apple-plain && tar -rf \"$arc/apple.tar\" -s ',dot_,._,' pkg-1.0/dot_plain pkg-1.0/dot_tiny); "
    "gzip -c \"$arc/apple.tar\" >\"$arc/apple.tar.gz\"";

export void test_untar_sanitizers_appledouble_entries_do_no_harm() {
    scratch::Project p = sanitized_project(); // before the arena: clean frees what make holds
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    setup(&p, make_apple);
    if (run(&p, "grep -a -c '\\._a' \"$arc/apple.tar\"").out[0] == '0') {
        test::note("skip  AppleDouble entries: this tar writes none");
        return;
    }
    scratch::Run gz = untar(&p, "prefixes \"$arc/apple.tar.gz\" \"$work/scratch\" $prefix_step");
    scratch::expect_contains("sanitizers: every shorter prefix of the AppleDouble tar.gz is refused",
                             status_and_out(&gz), "0 ");
    scratch::Run plain = untar(&p, "prefixes \"$arc/apple.tar\" \"$work/scratch\" $prefix_step");
    scratch::expect_contains("sanitizers: every shorter prefix of the AppleDouble tar is refused",
                             status_and_out(&plain), "0 ");
    scratch::Run fuzzed = untar(&p, "fuzz \"$arc/apple.tar\" \"$work/scratch\" 800 6");
    scratch::expect_contains("sanitizers: damaged AppleDouble entries do no harm", all_of(&fuzzed),
                             "0 800 damaged archives");
}

