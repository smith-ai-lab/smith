// The archive readers under AddressSanitizer and UndefinedBehaviorSanitizer, and no process running tar, from
// tests/untar.sh sections 5 and 6 (issue #292): tests/untar.c is compiled with the sanitizers against runtime/package.c
// and runs known answers, extraction, every shorter prefix of an archive refused, and random damage that may not crash,
// hang, write outside the folder or leave a symlink that points out. The shell functions are those of
// tests/build_fixtures/untar/prelude. By default every 5th prefix is tried (all the ones near a block boundary and in
// the first two blocks); UNTAR_FULL=1 tries every one (issue #31). A test's texts are pushed on its test::memory arena,
// which is also the current allocator, so what scratch returns goes back with it.
module untar_sanitizers_test;

import std::arena;
import std::format;
import std::mem;
import std::test;
import scratch;

static scratch::Project untar_project() {
    scratch::Project p = scratch::make("p", "untar");
    scratch::copy_tree(&p, "tests/untar.c", "tests/untar.c");
    scratch::copy_tree(&p, "tests/xz.py", "tests/xz.py");
    scratch::copy_tree(&p, "lib", "lib");
    scratch::copy_tree(&p, "runtime", "runtime");
    return p;
}

static scratch::Run run(const scratch::Project *p, const char *body) {
    return scratch::sh(p, format::push(". ./prelude; ", body).data);
}

// A setup command that must succeed.
static void setup(const scratch::Project *p, const char *body) {
    scratch::Run made = run(p, body);
    scratch::expect_status("the setup of the case", 0, &made);
}

// What the shell's "$rc $out $err" is: the status, the output and the errors of a run.
static const char *all_of(const scratch::Run *r) {
    return format::push(r->status, " ", r->out, " ", r->err).data;
}

// "$rc $out".
static const char *status_and_out(const scratch::Run *r) {
    return format::push(r->status, " ", r->out).data;
}

static const char *join(const char *a, const char *b) {
    return format::push(a, b).data;
}

// The program and the seeds are made once and shared (shared_untar in the prelude), not by each test.
static scratch::Project sanitized_project() {
    scratch::Project p = untar_project();
    scratch::Run made = scratch::sh(&p, ". ./prelude; shared_untar");
    scratch::expect_status("the setup of the case", 0, &made);
    scratch::release(made.out);
    scratch::release(made.err);
    return p;
}

// `./untar mode archive ...` on an archive of the project.
static scratch::Run untar(const scratch::Project *p, const char *arguments) {
    return run(p, join("./untar ", arguments));
}

static const char *seed_path(const char *seed) {
    return format::push("\"$work/seeds/", seed, "\"").data;
}

// A known archive of a small tree is extracted.
static void seed_extracts(const scratch::Project *p, const char *seed) {
    const char *archive = seed_path(seed);
    scratch::Run extracted = untar(p, format::push("extract ", archive, " \"$work/untar-out\"").data);
    scratch::expect_text(format::push("sanitizers: ", seed, " extracts").data, "0 ok", status_and_out(&extracted));
}

// Every shorter prefix of it is refused: the part `part` of `parts` of them (the parts run side by side as tests and
// together try all).
static void seed_prefixes_are_refused(const scratch::Project *p, const char *seed, Usize part, Usize parts) {
    const char *archive = seed_path(seed);
    scratch::Run prefixes =
        untar(p, format::push("prefixes ", archive, " \"$work/scratch\" $prefix_step ", part, " ", parts).data);
    scratch::expect_status(format::push("sanitizers: every shorter prefix of ", seed, " is refused").data, 0,
                           &prefixes);
    scratch::expect_contains(
        format::push("sanitizers: every shorter prefix of ", seed, " is refused (the output)").data, all_of(&prefixes),
        "0 ");
    scratch::expect_contains("sanitizers: ... and the count says so", prefixes.out, "prefixes refused");
}

// And 1500 damaged copies do no harm.
static void seed_damaged_copies_do_no_harm(const scratch::Project *p, const char *seed) {
    const char *archive = seed_path(seed);
    scratch::Run fuzzed = untar(p, format::push("fuzz ", archive, " \"$work/scratch\" 1500 1").data);
    scratch::expect_contains(format::push("sanitizers: 1500 damaged copies of ", seed, " do no harm").data,
                             all_of(&fuzzed), "0 1500 damaged archives");
}

// The five seeds: known archives of a small tree, each extracted, every shorter prefix refused, and 1500 damaged
// copies. The plain tar, whose prefixes are most of them, is three tests of its own.
static void seed_is_read_safely(const scratch::Project *p, const char *seed) {
    seed_extracts(p, seed);
    seed_prefixes_are_refused(p, seed, 0, 1);
    seed_damaged_copies_do_no_harm(p, seed);
}

export void test_untar_sanitizers_known_gzip_and_xz_streams_and_each_of_their_prefixes_refused() {
    scratch::Project p = sanitized_project(); // before the arena: clean frees what make holds
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run vectors = untar(&p, "vectors");
    scratch::expect_text("sanitizers: known gzip (fixed Huffman codes) and xz streams, and each of their prefixes "
                         "refused",
                         "0 vectors ok", status_and_out(&vectors));
}

export void test_untar_sanitizers_seed_tar() {
    scratch::Project p = sanitized_project(); // before the arena: clean frees what make holds
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    seed_extracts(&p, "seed.tar");
    seed_damaged_copies_do_no_harm(&p, "seed.tar");
}

