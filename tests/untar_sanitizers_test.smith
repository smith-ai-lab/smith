export void test_untar_sanitizers_damaged_headers_of_the_gnu_tar_do_no_harm() {
    scratch::Project p = sanitized_project(); // before the arena: clean frees what make holds
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    setup(&p, "d=pkg-1.0/$(printf 'a%.0s' $(seq 80))/$(printf 'b%.0s' $(seq 80))/$(printf 'c%.0s' $(seq 80)); "
              "mkdir -p \"long/$d\" long/pkg-1.0/ü; echo deep >\"long/$d/file.txt\"; "
              "echo accent >long/pkg-1.0/ü/é.txt; (cd long && tar --format gnutar -cf \"$arc/long-gnu.tar\" pkg-1.0)");
    scratch::Run fuzzed = untar(&p, "fuzz \"$arc/long-gnu.tar\" \"$work/scratch\" 800 3");
    scratch::expect_contains("sanitizers: damaged headers of the GNU tar do no harm", all_of(&fuzzed),
                             "0 800 damaged archives");
}

