// 6. No process runs tar: nothing in smith names it, and with tar forbidden to run the same extractions work.
export void test_untar_no_tar_nothing_in_smith_names_it() {
    scratch::Project p = untar_project(); // before the arena: clean frees what make holds
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, "smith.c", "sources/smith.c");
    scratch::copy_tree(&p, "runtime", "sources/runtime");
    scratch::expect_text("no tar: nothing in smith names it", "0",
                         scratch::capture(&p, "cat sources/smith.c sources/runtime/*.c | "
                                              "grep -c 'bin/tar\\|\"tar\"'"));
}

constexpr char sandbox_profile[_] =
    "profile='(version 1)(allow default)(deny process-exec (literal \"/usr/bin/tar\") (literal \"/usr/bin/bsdtar\") "
    "(literal \"/usr/bin/gzip\") (literal \"/usr/bin/gunzip\") (literal \"/opt/homebrew/bin/xz\") "
    "(literal \"/usr/bin/xz\"))'; export XDG_CACHE_HOME=$PWD/cache-sandbox; ";

// True when sandbox-exec exists and works here (it does not inside another sandbox).
static bool sandbox_ready(const scratch::Project *p) {
    setup(p, "make_a_tar; gzip -c \"$arc/a.tar\" >\"$arc/a.tar.gz\"; xz -c \"$arc/a.tar\" >\"$arc/a.tar.xz\"");
    scratch::Run found = scratch::sh(p, join(sandbox_profile, "command -v sandbox-exec >/dev/null 2>&1 && "
                                                              "sandbox-exec -p \"$profile\" /usr/bin/true"));
    if (found.status != 0) {
        test::note("skip  no tar: sandbox-exec is not available here");
        return false;
    }
    return true;
}

// The command under sandbox-exec with the profile.
static scratch::Run sandboxed(const scratch::Project *p, const char *command) {
    return run(p, join(join(sandbox_profile, "sandbox-exec -p \"$profile\" "), command));
}

export void test_untar_no_tar_the_sandbox_does_forbid_tar() {
    scratch::Project p = untar_project(); // before the arena: clean frees what make holds
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!sandbox_ready(&p)) {
        return;
    }
    scratch::Run forbidden = sandboxed(&p, "/usr/bin/tar -tf \"$arc/a.tar\"");
    scratch::expect_failure("no tar: the sandbox does forbid tar", &forbidden);
}

export void test_untar_no_tar_a_tar_xz_extracts_with_tar_gzip_and_xz_forbidden_to_run() {
    scratch::Project p = untar_project(); // before the arena: clean frees what make holds
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!sandbox_ready(&p)) {
        return;
    }
    scratch::Run fetched = sandboxed(&p, "smith fetch \"file://$arc/a.tar.xz\"");
    scratch::expect_status("no tar: a .tar.xz extracts with tar, gzip and xz forbidden to run", 0, &fetched);
}

