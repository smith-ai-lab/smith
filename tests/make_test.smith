// The translation of a Makefile into a build.c, end to end (issue #44, runtime/make*.c): `smith build --dump-config` in
// a folder with a Makefile and no build file, as a user runs it. Each case is a small project with one Makefile for a
// construct (tests/build_fixtures/make_NN): the build.c is built with `smith build`, and what it makes is compared
// with what make makes from the same Makefile. Needs make. What the translation says (its text, what it reports, the
// values of its flags as make computes them) is tests of a function in process, tests/make_translate_test.smith (issue
// #646); a case is here because it needs a real make, a compiler, or the verb (which Makefile `smith build` and
// `--dump-config` look at). Each case is a test of its own, so they run side by side. The lint and the format of the
// translations are one test (issue #1294): every case's Makefile is translated in process, and `smith fmt` and `smith
// lint` run once over all of the build files. A case that is only translated and linted there (the wildcard of an
// option, a rule under a test of the platform, what is outside the subset) is not built again: building a project
// costs a build program, about 1.5 CPU-s, and the text it checks is a test in process.
module make_test;

import std::arena;
import std::test;
import scratch;
import <smith_core.h>;
import <string.h>;
import std::mem;

// The environment make and smith are compared in.
constexpr char clean[_] = "unset CC CXX MAKEFLAGS MFLAGS; ";

static scratch::Run run(const scratch::Project *p, const char *command) {
    char text[4096];
    __builtin_snprintf(text, sizeof text, "%s%s", clean, command);
    return scratch::sh(p, text);
}

static scratch::Project project(const char *fixture) {
    return scratch::make("p", fixture);
}

// main.c prints R1 .. R<count> (strings, or "unset"), which the Makefile gives as -DRn='"value"'.
static void printer(const scratch::Project *p, I32 count) {
    char *text = mem::alloc_slice(char, 65536).data;
    Usize used = (Usize)__builtin_snprintf(text, 65536, "#include <stdio.h>\n");
    for (I32 i = 1; i <= count; i++)
        used +=
            (Usize)__builtin_snprintf(text + used, 65536 - used, "#ifndef R%d\n#define R%d \"unset\"\n#endif\n", i, i);
    used += (Usize)__builtin_snprintf(text + used, 65536 - used, "int main(void) {\n");
    for (I32 i = 1; i <= count; i++) {
        used += (Usize)__builtin_snprintf(text + used, 65536 - used, "    puts(\"R%d=\" R%d);\n", i, i);
    }
    used += (Usize)__builtin_snprintf(text + used, 65536 - used, "    return 0;\n}\n");
    scratch::write(p, "main.c", text);
}

// The translation as the verb writes it: build.c, and its status. Whether it passes `smith lint` and `smith fmt
// --dry-run` is test_make_every_translation_is_lint_clean_and_format_clean, once for all the cases.
static I32 translate(const scratch::Project *p) {
    return run(p, "smith build --dump-config >build.c 2>dump.err").status;
}

static void expect_zero(const char *name, I32 status) {
    scratch::expect_count(name, 0, (Usize)status);
}

// Builds the program with make, then with the translation, and compares what they print. `arguments` are the
// command-line variables of both (make's VAR=value, smith's -DVAR=value).
static void same_output(const scratch::Project *p, const char *name, const char *program, const char *arguments) {
    char command[1024];
    char label[512];
    // build/ and the program are removed, so that both builds make them; .smith is kept: it holds only the build
    // program and the plan of the build.c that was dumped (and linted) before, which this dump writes again byte for
    // byte, and building the build program again cost, for every case, about 2 CPU-s.
    __builtin_snprintf(command, sizeof command, "rm -rf build %s; make %s >make.log 2>&1; echo $?", program, arguments);
    __builtin_snprintf(label, sizeof label, "%s: make builds it", name);
    scratch::expect_text(label, "0", run(p, command).out);
    __builtin_snprintf(command, sizeof command, "./%s >make.out 2>&1; rm -rf build %s", program, program);
    (void)run(p, command);
    __builtin_snprintf(label, sizeof label, "%s: the translation exits 0", name);
    expect_zero(label, translate(p));
    __builtin_snprintf(
        command, sizeof command,
        "options=; for option in %s; do case $option in *=*) options=\"$options -D$option\" ;; esac; done; "
        "smith build $options >smith.log 2>&1; echo $?",
        arguments);
    __builtin_snprintf(label, sizeof label, "%s: smith build builds it", name);
    scratch::expect_text(label, "0", run(p, command).out);
    __builtin_snprintf(command, sizeof command, "./%s >smith.out 2>&1", program);
    (void)run(p, command);
    __builtin_snprintf(label, sizeof label, "%s: it prints what make's build prints", name);
    scratch::expect_text(label, scratch::read(p, "make.out"), scratch::read(p, "smith.out"));
}

// The compile and link commands of a build, each with the compiler called CC (or CXX) and the dependency flags out, as
// the shell reads them (quotes removed), one per line, sorted, without duplicates: what tests/build_fixtures/
// same_commands.sh (sed, eval and sort -u) made of `make -n -B` and of `smith build -t commands`.
constexpr Usize no_match = (Usize)-1;
constexpr Usize command_capacity = 8192;
constexpr Usize command_count = 512;

typedef struct {
    char *lines[command_count];
    Usize count;
} Commands;

static Usize find_text(const char *text, const char *needle) {
    const char *at = c::strstr(text, needle);
    return at != nullptr ? (Usize)(at - text) : no_match;
}

// Replaces text[from:to] with `replacement`.
static void cut(char *text, Usize from, Usize to, const char *replacement) {
    Usize length = c::strlen(replacement);
    mem::move(text[from + length:from + length + c::strlen(text + to) + 1], text[to:to + c::strlen(text + to) + 1]);
    mem::copy(text[from:from + length], replacement[0:length]);
}

static Usize word_end(const char *text, Usize from) {
    Usize end = from;
    while (text[end] != '\0' && text[end] != ' ') {
        end++;
    }
    return end;
}

static bool one_of(const char *word, const char *names[4]) {
    for (Usize i = 0; i < 4; i++)
        if (c::strcmp(word, names[i]) == 0) return true;
    return false;
}

// `^([^ ]*/)?(smith-cc|cc|clang|gcc) ` is CC and the same for the C++ compilers CXX.
static void name_the_compiler(char *line) {
    Usize end = word_end(line, 0);
    if (line[end] != ' ' || end >= 256) return;
    Usize start = end;
    while (start > 0 && line[start - 1] != '/') {
        start--;
    }
    char word[256];
    mem::copy(word[0:end - start], line[start:start + end - start]);
    word[end - start] = '\0';
    const char *c_compilers[4] = {"smith-cc", "cc", "clang", "gcc"};
    const char *cxx_compilers[4] = {"smith-c++", "c++", "g++", "clang++"};
    if (one_of(word, c_compilers)) {
        cut(line, 0, end, "CC");
    } else if (one_of(word, cxx_compilers)) {
        cut(line, 0, end, "CXX");
    }
}

// ` -MMD -MF <file>.d ` and ` -MD -MF <file>.d ` (smith's builds write the second, make's rules the first), ` -MMD `,
// ` -MD ` and ` -MP ` become a space (the first of each), and runs of spaces one.
static void drop_dependency_flags(char *line) {
    const char *with_file[2] = {" -MMD -MF ", " -MD -MF "};
    const char *alone[2] = {" -MMD ", " -MD "};
    for (Usize f = 0; f < countof(with_file); f++) {
        Usize length = c::strlen(with_file[f]);
        Usize at = find_text(line, with_file[f]);
        if (at != no_match) {
            Usize end = word_end(line, at + length);
            if (end >= at + length + 2 && line[end] == ' ' && c::strncmp(line + end - 2, ".d", 2) == 0)
                cut(line, at, end + 1, " ");
        }
        at = find_text(line, alone[f]);
        if (at != no_match) cut(line, at, at + c::strlen(alone[f]), " ");
    }
    Usize at = find_text(line, " -MP ");
    if (at != no_match) cut(line, at, at + 5, " ");
    for (Usize i = 0; line[i] != '\0'; i++)
        while (line[i] == ' ' && line[i + 1] == ' ') {
            cut(line, i, i + 1, "");
        }
}

// Copies the text up to the closing quote (the opening one is passed) into the words, as the shell does: nothing is
// special inside single quotes, and inside double quotes a backslash before $, `, " or a backslash is one. False when
// the quote is not closed.
static bool copy_quoted(const char *line, Usize *at, char quote, char *words, Usize *used, Usize capacity) {
    while (line[*at] != quote) {
        if (line[*at] == '\0' || *used + 2 >= capacity) return false;
        if (quote == '"' && line[*at] == '\\' && line[*at + 1] != '\0' &&
            c::strchr("$`\"\\", line[*at + 1]) != nullptr) {
            (*at)++;
        }
        words[(*used)++] = line[(*at)++];
    }
    (*at)++;
    return true;
}

// The words of the line as `eval "set -- $line"` gives them (single and double quotes and backslashes), joined by one
// space. False when a quote is not closed, which the shell refuses.
static bool unquote(const char *line, char *words, Usize capacity) {
    Usize used = 0;
    Usize i = 0;
    while (line[i] != '\0') {
        while (line[i] == ' ') {
            i++;
        }
        if (line[i] == '\0') break;
        if (used > 0) words[used++] = ' ';
        while (line[i] != '\0' && line[i] != ' ') {
            char ch = line[i++];
            bool quoted = ch == '\'' || ch == '"';
            if (quoted && !copy_quoted(line, &i, ch, words, &used, capacity)) return false;
            if (ch == '\\' && line[i] == '\0') return false;
            if (!quoted) words[used++] = ch == '\\' ? line[i++] : ch;
            if (used + 2 >= capacity) return false;
        }
    }
    words[used] = '\0';
    return true;
}

static bool ordered_before(const char *a, const char *b) {
    return c::strcmp(a, b) < 0;
}

// Adds a line to the sorted list unless it is in it already.
static void add_command(Commands *commands, char *line) {
    Usize at = 0;
    while (at < commands->count && ordered_before(commands->lines[at], line)) {
        at++;
    }
    if (at < commands->count && c::strcmp(commands->lines[at], line) == 0) {
        return;
    }
    test::check_less(commands->count, command_count);
    for (Usize i = commands->count; i > at; i--) {
        commands->lines[i] = commands->lines[i - 1];
    }
    commands->lines[at] = line;
    commands->count++;
}

// The canonical commands of the text of a build: only the lines of the compiler.
static void canonical(const char *text, Commands *commands) {
    *commands = (Commands){};
    Usize start = 0;
    while (text[start] != '\0') {
        Usize end = start;
        while (text[end] != '\0' && text[end] != '\n') {
            end++;
        }
        if (end - start < command_capacity) {
            char *line = mem::alloc_slice(char, command_capacity).data;
            mem::copy(line[0:end - start], text[start:start + end - start]);
            line[end - start] = '\0';
            name_the_compiler(line);
            drop_dependency_flags(line);
            if (c::strncmp(line, "CC ", 3) == 0 || c::strncmp(line, "CXX ", 4) == 0) {
                char *words = mem::alloc_slice(char, command_capacity).data;
                add_command(commands, unquote(line, words, command_capacity) ? words : line);
            }
        }
        start = text[end] == '\n' ? end + 1 : end;
    }
}

// Removes ` -L<dir> -lsmith_handlers` (and ` -Wl,-rpath,@executable_path` after it) and ` -L<dir>/lib/darwin` from a
// line.
static void drop_handlers_link(char *line) {
    Usize at = find_text(line, " -lsmith_handlers");
    if (at != no_match) {
        Usize start = at;
        while (start > 0 && line[start - 1] != ' ') {
            start--;
        }
        Usize end = at + 17;
        if (c::strncmp(line + end, " -Wl,-rpath,@executable_path", 28) == 0) end += 28;
        if (start > 1 && line[start] == '-' && line[start + 1] == 'L') cut(line, start - 1, end, "");
    }
    at = find_text(line, "/lib/darwin");
    if (at != no_match) {
        Usize start = at;
        while (start > 0 && line[start - 1] != ' ') {
            start--;
        }
        if (start > 1 && line[start] == '-' && line[start + 1] == 'L') cut(line, start - 1, at + 11, "");
    }
}

// Removes a word (with the space before it) from a line, where it is.
static void drop_word(char *line, const char *word) {
    Usize at = find_text(line, word);
    if (at != no_match && (line[at + c::strlen(word)] == ' ' || line[at + c::strlen(word)] == '\0')) {
        cut(line, at, at + c::strlen(word), "");
    }
}

// smith's link also builds and links the handlers runtime, which make's does not: on macOS a dylib beside the program,
// on Linux an object compiled from .smith/lib/handlers.c and linked in (with the build-id and the exported symbols
// that name an image in a failure's trace): the step and its arguments are taken out.
static void drop_handlers(Commands *commands) {
    Usize kept = 0;
    for (Usize i = 0; i < commands->count; i++) {
        if (c::strstr(commands->lines[i], " -dynamiclib ") != nullptr ||
            c::strstr(commands->lines[i], " .smith/lib/handlers.c ") != nullptr) {
            continue;
        }
        drop_word(commands->lines[i], " -Wl,--build-id=md5");
        drop_word(commands->lines[i], " -Wl,--export-dynamic");
        drop_word(commands->lines[i], " ./smith_handlers.o");
        drop_word(commands->lines[i], " -lm"); // glibc: smith's link adds libm, make's does not
        drop_handlers_link(commands->lines[i]);
        Usize at = find_text(commands->lines[i], " -lclang_rt.asan_osx_dynamic");
        if (at != no_match) cut(commands->lines[i], at, at + 28, "");
        commands->lines[kept++] = commands->lines[i];
    }
    commands->count = kept;
}

static const char *joined(const Commands *commands) {
    char *text = mem::alloc_slice(char, command_capacity * 8).data;
    Usize used = 0;
    for (Usize i = 0; i < commands->count; i++) {
        Usize length = c::strlen(commands->lines[i]);
        test::check_less(used + length + 2, command_capacity * 8);
        mem::copy(text[used:used + length], commands->lines[i][0:length]);
        text[used + length] = '\n';
        used += length + 1;
    }
    text[used] = '\0';
    return text;
}

// The commands of `smith build -t commands`: a line `sh .smith/command/<file>` stands for the commands in the file.
static const char *expand_commands(const scratch::Project *p, const char *raw) {
    char *text = mem::alloc_slice(char, command_capacity * 8).data;
    Usize used = 0;
    Usize start = 0;
    while (raw[start] != '\0') {
        Usize end = start;
        while (raw[end] != '\0' && raw[end] != '\n') {
            end++;
        }
        char line[1024];
        Usize length = end - start < sizeof line - 1 ? end - start : sizeof line - 1;
        mem::copy(line[0:length], raw[start:start + length]);
        line[length] = '\0';
        const char *shown = c::strncmp(line, "sh .smith/command/", 18) == 0 ? scratch::read(p, line + 3) : line;
        used += (Usize)__builtin_snprintf(text + used, command_capacity * 8 - used, "%s\n", shown);
        start = raw[end] == '\n' ? end + 1 : end;
    }
    return text;
}

// Compares the compile and link commands of `make -n -B` with the translation's for the targets.
static void same_commands(const scratch::Project *p, const char *name, const char *targets) {
    char command[512];
    char label[256];
    Commands made;
    Commands smith;
    canonical(run(p, "make -n -B 2>/dev/null").out, &made);
    __builtin_snprintf(command, sizeof command, "smith build -t commands %s 2>/dev/null", targets);
    canonical(expand_commands(p, run(p, command).out), &smith);
    drop_handlers(&smith);
    __builtin_snprintf(label, sizeof label, "%s: the same compile and link commands as make", name);
    scratch::expect_text(label, joined(&made), joined(&smith));
    __builtin_snprintf(label, sizeof label, "%s: and some", name);
    scratch::expect_contains(label, joined(&smith), "CC");
}

// 1. Variables: their flavors, expansion, += and ?=, substitution references, ${X}, override.
export void test_make_variables() {
    scratch::Project p = project("make_01");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    printer(&p, 12);
    same_output(&p, "variables", "prog", "");
    same_output(&p, "variables: C and D set on the command line", "prog", "C=cmd D=cmd2");
}

// 3. Rules: explicit and pattern rules, order-only prerequisites, the automatic variables, a recipe that is not a
// compile.
export void test_make_rules() {
    scratch::Project p = project("make_03");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    printer(&p, 1);
    (void)run(&p, "echo one >a.in; echo two >b.in");
    (void)run(&p, "rm -f main.o");
    same_output(&p, "rules", "prog", "");
    (void)run(&p, "rm -f both.txt a.txt b.txt main.o; make >/dev/null 2>&1; cat both.txt a.txt b.txt >make.files; "
                  "rm -f both.txt a.txt b.txt main.o prog; smith build >/dev/null 2>&1; cat both.txt a.txt b.txt "
                  ">smith.files 2>&1");
    scratch::expect_text("rules: automatic variables and the stem in recipes", scratch::read(&p, "make.files"),
                         scratch::read(&p, "smith.files"));
}

// 4. Recipes: @ and -, line continuations, several lines.
export void test_make_recipes() {
    scratch::Project p = project("make_04");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    (void)translate(&p);
    (void)run(&p, "make >/dev/null 2>&1; cp out.txt make.out; rm out.txt; smith build >/dev/null 2>&1");
    scratch::expect_text("recipes: the lines run in order, - ignores a failure, a continuation joins",
                         scratch::read(&p, "make.out"), scratch::read(&p, "out.txt"));
}

// 5. Phony targets, the default goal, and the names of smith's verbs.
export void test_make_phony_targets_and_the_default_goal() {
    scratch::Project p = project("make_05");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    printer(&p, 1);
    (void)translate(&p);
    (void)run(&p, "smith build >/dev/null 2>&1");
    scratch::expect_text("phony: the default builds the program", "ok", run(&p, "[ -x prog ] && echo ok").out);
    (void)run(&p, "smith build extra >/dev/null 2>&1");
    scratch::expect_text("phony: smith build extra runs the task", "extra", scratch::read(&p, "extra.txt"));
}

// 8. A test of the platform keeps both branches, as an if on b->os and b->arch.
export void test_make_platform() {
    scratch::Project p = project("make_08");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    printer(&p, 5);
    same_output(&p, "platform", "prog", "");
}

// 9. Command-line knobs are -D options of the build file.
export void test_make_knobs() {
    scratch::Project p = project("make_09");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    printer(&p, 3);
    same_output(&p, "knobs: the defaults", "prog", "");
    same_output(&p, "knobs: DEBUG=1", "prog", "DEBUG=1");
    same_output(&p, "knobs: DEBUG=1 VERBOSE=yes EXTRA=more", "prog", "DEBUG=1 VERBOSE=yes EXTRA=more");
}

// 11. An archive is a step, and the program that links it names it a library.
export void test_make_archive() {
    scratch::Project p = project("make_11");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    printer(&p, 1);
    scratch::write(&p, "lib.c", "const char *name(void) { return \"lib\"; }\n");
    same_output(&p, "archive", "prog", "");
}

// 12. Recursive make: a goal of the same Makefile, and -C another folder.
export void test_make_recursive_make() {
    scratch::Project p = project("make_12");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    printer(&p, 1);
    scratch::write(&p, "sub/lib.c", "const char *name(void) { return \"sub\"; }\n");
    (void)run(&p, "rm -f sub/lib.a sub/lib.o");
    same_output(&p, "recursive make", "prog", "");
    (void)run(&p, "rm -f sub/lib.a sub/lib.o");
}

// 14. The same commands as make for a small project with a flags variable and a pattern rule.
export void test_make_the_same_commands_as_make() {
    scratch::Project p = project("make_14");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    printer(&p, 1);
    (void)run(&p, "cp main.c second.c; sed -i.bak 's/int main(void) {/int second_main(void) {/' second.c");
    (void)translate(&p);
    (void)run(&p, "smith build >/dev/null 2>&1");
    same_commands(&p, "commands", "prog");
}

// 16. A folder with a build file is not translated (which Makefile comes first is in tests/make_translate_test.smith).
export void test_make_which_makefile_and_when() {
    scratch::Project p = project("make_17");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write(&p, "build.c", "#include <smith/build.h>\nvoid build(SmithBuild *b) { (void)b; }\n");
    (void)run(&p, "smith build --dump-config >dumped.txt 2>&1");
    scratch::expect_lacks("files: a folder with a build.c is not translated", scratch::read(&p, "dumped.txt"),
                          "translated from");
}

// 17. A Makefile and a main, and no build file: --dump-config translates the Makefile, and nothing builds by
// convention.
export void test_make_a_makefile_and_a_main_and_no_build_file() {
    scratch::Project p = project("make_18");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write(&p, "main.c", "int main(void) { return 0; }\n");
    scratch::Run dump = run(&p, "smith build --dump-config");
    scratch::expect_status("makefile and main: --dump-config exits 0", 0, &dump);
    scratch::expect_contains("makefile and main: it translates the Makefile", dump.out, "translated from Makefile");
    scratch::Run build = run(&p, "smith build");
    scratch::expect_status("makefile and main: smith build stops", 2, &build);
    scratch::expect_contains("makefile and main: and says to translate it", build.err,
                             "smith build --dump-config > build.c");
    scratch::expect_contains("makefile and main: or to delete it", build.err, "delete it to build by convention");
    scratch::Run verb = run(&p, "smith run");
    scratch::expect_status("makefile and main: a verb stops too", 2, &verb);
    scratch::expect_contains("makefile and main: with the same message", verb.err,
                             "smith build --dump-config > build.c");
    scratch::expect_text("makefile and main: nothing was built", "", run(&p, "ls prog build .smith 2>/dev/null").out);
    (void)run(&p, "rm Makefile");
    scratch::Run conventions = run(&p, "smith build --dump-config");
    scratch::expect_contains("no Makefile: the conventions are dumped", conventions.out, "smith_app");
}

static void empty_build_file_is_none(const char *file) {
    scratch::Project p = project(nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    char text[256];
    char label[256];
    scratch::write(&p, "main.c", "int main(void) { return 0; }\n");
    scratch::write(&p, "Makefile", "prog: main.c\n\tcc main.c -o prog\n");
    scratch::write(&p, file, "");
    scratch::Run dump = run(&p, "smith build --dump-config");
    __builtin_snprintf(label, sizeof label, "empty %s: the Makefile is translated", file);
    scratch::expect_status(label, 0, &dump);
    __builtin_snprintf(label, sizeof label, "empty %s: the output is the translation", file);
    scratch::expect_contains(label, dump.out, "translated from Makefile");
    scratch::Run build = run(&p, "smith build");
    __builtin_snprintf(label, sizeof label, "empty %s: smith build still sees the Makefile", file);
    scratch::expect_contains(label, build.err, "smith build --dump-config > build.c");
    (void)run(&p, "rm Makefile");
    scratch::Run again = run(&p, "smith build --dump-config");
    __builtin_snprintf(label, sizeof label, "empty %s: and with no Makefile the conventions are dumped", file);
    scratch::expect_contains(label, again.out, "smith_app");
    (void)text;
}

// 18. An empty build file is none, for build.c and for build.smith, in the translator and in the conventions.
export void test_make_an_empty_build_c_is_none() {
    empty_build_file_is_none("build.c");
}

export void test_make_an_empty_build_smith_is_none() {
    empty_build_file_is_none("build.smith");
}

// 19. A Makefile too big for one function of 70 lines: build.c is a function for each run of targets, the variables are
// statics, and it still passes lint and fmt (translate checks) and builds.
export void test_make_a_makefile_too_big_for_one_function() {
    scratch::Project p = project(nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    (void)run(&p, "i=1; while [ \"$i\" -le 45 ]; do : >\"src$i.dat\"; i=$((i + 1)); done; "
                  "{ echo 'DATA := $(sort $(wildcard src*.dat))'; echo 'PREFIX ?= out'; i=1; "
                  "while [ \"$i\" -le 30 ]; do printf 'step%s: $(DATA)\\n\\t@touch $(PREFIX)%s.txt $(DATA)\\n' \"$i\" "
                  "\"$i\"; i=$((i + 1)); done; "
                  "echo '.PHONY: all'; echo 'all: step1 step30'; } >Makefile");
    expect_zero("split: the Makefile is translated", translate(&p));
    scratch::Run built = run(&p, "smith build -DPREFIX=pre");
    scratch::expect_status("split: smith build builds it", 0, &built);
    scratch::expect_text("split: the option reaches a recipe", "pre1.txt", run(&p, "ls pre1.txt 2>/dev/null").out);
}

// The cases of the batch below: the folder each is translated in, made from tests/build_fixtures/make_NN.
constexpr Usize case_count = 14;
const char *const case_names[case_count] = {"01", "03", "04", "05", "05b", "08", "09",
                                            "11", "12", "13", "14", "15",  "16", "19"};

// The folders, with what the tests of the cases add to a fixture before they translate it (a printer's main.c, files a
// wildcard finds, a Makefile too big for one function). One process for all of them.
constexpr char batch_setup[_] =
    "for n in 01 03 04 05 08 09 11 12 13 14 15 16; do mkdir $n && cp -R \"$SMITH_REPO/tests/build_fixtures/make_$n/.\" "
    "$n; done; mkdir 05b 19 && cp -R \"$SMITH_REPO/tests/build_fixtures/make_05/.\" 05b && cp 05b/Makefile.default "
    "05b/Makefile; for n in 01 03 05 05b 08 09 11 12 13 14; do echo 'int main(void) { return 0; }' >$n/main.c; done; "
    "echo one >03/a.in; echo two >03/b.in; echo 'const char *name(void) { return \"lib\"; }' >11/lib.c; "
    "echo 'const char *name(void) { return \"sub\"; }' >12/sub/lib.c; echo other >13/other; "
    "cp 14/main.c 14/second.c; echo font >16/font.bdf; cd 19; "
    "i=1; while [ \"$i\" -le 45 ]; do : >\"src$i.dat\"; i=$((i + 1)); done; "
    "{ echo 'DATA := $(sort $(wildcard src*.dat))'; echo 'PREFIX ?= out'; i=1; "
    "while [ \"$i\" -le 30 ]; do printf 'step%s: $(DATA)\\n\\t@touch $(PREFIX)%s.txt $(DATA)\\n' \"$i\" \"$i\"; "
    "i=$((i + 1)); done; echo '.PHONY: all'; echo 'all: step1 step30'; } >Makefile";

// Translates the cases but the last in process and writes each build.c beside its Makefile. The text in process is the
// translation before `smith fmt` (the verb formats it), so the batch formats it the same way before it lints.
static void translate_cases(const scratch::Project *p) {
    char *build = mem::alloc_slice(char, 1U << 20).data;
    char *report = mem::alloc_slice(char, 1U << 16).data;
    for (Usize i = 0; i + 1 < case_count; i++) {
        char folder[512];
        char file[64];
        __builtin_snprintf(folder, sizeof folder, "%s/%s", p->dir, case_names[i]);
        bool done = c::smith_core_make_translate(folder, nullptr, build, 1U << 20, report, 1U << 16);
        test::check_equal(done, true);
        __builtin_snprintf(file, sizeof file, "%s/build.c", case_names[i]);
        scratch::write(p, file, build);
    }
}

// The build.c of all the cases pass smith's lint and format (a project with no .clang-tidy or .clang-format of its own:
// names in lower case, functions of at most 70 lines, formatted), in a few processes and not two for each case: one
// `smith fmt -i` over the in-process translations and one `smith lint` over all, with the flags of a build file
// (`-- -std=gnu23 -I .smith/include`, as the lint of a project has) and no build of a build program. The last case, the
// Makefile too big for one function, is the verb's own output (how build.c is split into functions depends on the
// formatter's measure of the lines, which only the verb's process can run), and `smith fmt --dry-run --Werror` checks
// that it needs no formatting. A failure names the file. The build of the translations is in the tests of the cases.
export void test_make_every_translation_is_lint_clean_and_format_clean() {
    scratch::Project p = scratch::make("all", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run set_up = run(&p, batch_setup);
    scratch::expect_status("batch: the folders are made", 0, &set_up);
    translate_cases(&p);
    scratch::Run verb = run(&p, "cd 19 && smith build --dump-config >build.c 2>dump.err");
    scratch::expect_status("batch: the big Makefile is translated by the verb", 0, &verb);
    scratch::Run formatted = run(&p, "smith fmt --dry-run --Werror 19/build.c 2>&1");
    scratch::expect_text("batch: the verb's build.c needs no formatting", "", formatted.out);
    scratch::expect_status("batch: smith fmt --dry-run exits 0", 0, &formatted);
    scratch::Run laid_out = run(&p, "smith fmt -i */build.c");
    scratch::expect_status("batch: smith fmt lays out the translations", 0, &laid_out);
    scratch::Run linted = run(&p, "smith lint */build.c -- -std=gnu23 -I \"$SMITH_REPO/.smith/include\" 2>&1");
    scratch::expect_lacks("batch: no build.c has an error", linted.out, "build.c:");
    scratch::expect_status("batch: smith lint exits 0", 0, &linted);
}
