// The translation of a Makefile into a build.c (issue #44, runtime/make*.c), ported from tests/make.sh: `smith build
// --dump-config` in a folder with a Makefile and no build file. Each case is a small project with one Makefile for a
// construct (tests/build_fixtures/make_NN): the translation is checked for what it says, the build.c passes `smith
// lint` and `smith fmt --dry-run`, is built with `smith build`, and what it makes is compared with what make makes from
// the same Makefile. Needs make. Each case is a test of its own, so they run side by side.
module make_test;

import smith::arena;
import smith::io;
import smith::test;
import scratch;
import <string.h>;

// The environment make and smith are compared in.
constexpr char clean[] = "unset CC CXX MAKEFLAGS MFLAGS; ";

static scratch::Run run(const scratch::Project *p, const char *command) {
    char text[4096];
    __builtin_snprintf(text, sizeof text, "%s%s", clean, command);
    return scratch::sh(p, text);
}

static const char *out_of(const scratch::Project *p, const char *command) {
    char text[4096];
    __builtin_snprintf(text, sizeof text, "%s%s", clean, command);
    return scratch::capture(p, text);
}

static scratch::Project project(io::Io *io, const char *fixture) {
    return scratch::project(io, "p", fixture);
}

// main.c prints R1 .. R<count> (strings, or "unset"), which the Makefile gives as -DRn='"value"'.
static void printer(const scratch::Project *p, i32 count) {
    char *text = arena::push_slice(&p->io->arena, char, 65536).data;
    usize used = (usize)__builtin_snprintf(text, 65536, "#include <stdio.h>\n");
    for (i32 i = 1; i <= count; i++)
        used +=
            (usize)__builtin_snprintf(text + used, 65536 - used, "#ifndef R%d\n#define R%d \"unset\"\n#endif\n", i, i);
    used += (usize)__builtin_snprintf(text + used, 65536 - used, "int main(void) {\n");
    for (i32 i = 1; i <= count; i++)
        used += (usize)__builtin_snprintf(text + used, 65536 - used, "    puts(\"R%d=\" R%d);\n", i, i);
    used += (usize)__builtin_snprintf(text + used, 65536 - used, "    return 0;\n}\n");
    scratch::write(p, "main.c", text);
}

// The translation: build.c, and what was said on standard error. Returns the status. A translation that succeeded
// passes `smith lint` and `smith fmt --dry-run` with smith's defaults (a project with no .clang-tidy or .clang-format
// of its own): names in lower case, functions of at most 70 lines, formatted.
static i32 translate(const scratch::Project *p, const char *name) {
    scratch::Run dumped = run(p, "smith build --dump-config >build.c 2>dump.err");
    if (dumped.status == 0) {
        const char *findings = out_of(
            p, "smith lint >lint.log 2>&1; findings=$(grep -E '^build\\.c:[0-9]+:[0-9]+: (warning|error)' lint.log); "
               "formatting=$(smith fmt --dry-run build.c 2>&1 | grep -c 'clang-format-violations'); "
               "echo \"${findings:-none} $formatting\"");
        char label[256];
        __builtin_snprintf(label, sizeof label, "translation %s: build.c is lint-clean and format-clean", name);
        scratch::expect_text(label, "none 0", findings);
    }
    return dumped.status;
}

static void has(const scratch::Project *p, const char *name, const char *text) {
    scratch::expect_contains(name, scratch::read(p, "build.c"), text);
}

static void lacks(const scratch::Project *p, const char *name, const char *text) {
    scratch::expect_lacks(name, scratch::read(p, "build.c"), text);
}

static void expect_zero(const char *name, i32 status) {
    scratch::expect_count(name, 0, (usize)status);
}

// Builds the program with make, then with the translation, and compares what they print. `arguments` are the
// command-line variables of both (make's VAR=value, smith's -DVAR=value).
static void same_output(const scratch::Project *p, const char *name, const char *program, const char *arguments,
                        const char *number) {
    char command[1024];
    char label[512];
    __builtin_snprintf(command, sizeof command, "rm -rf build .smith %s; make %s >make.log 2>&1; echo $?", program,
                       arguments);
    __builtin_snprintf(label, sizeof label, "%s: make builds it", name);
    scratch::expect_text(label, "0", run(p, command).out);
    __builtin_snprintf(command, sizeof command, "./%s >make.out 2>&1; rm -rf build %s", program, program);
    (void)run(p, command);
    __builtin_snprintf(label, sizeof label, "%s: the translation exits 0", name);
    expect_zero(label, translate(p, number));
    __builtin_snprintf(
        command, sizeof command,
        "options=; for option in %s; do case $option in *=*) options=\"$options -D$option\" ;; esac; done; "
        "smith build $options >smith.log 2>&1; echo $?",
        arguments);
    __builtin_snprintf(label, sizeof label, "%s: smith build builds it", name);
    scratch::expect_text(label, "0", run(p, command).out);
    __builtin_snprintf(command, sizeof command, "./%s >smith.out 2>&1", program);
    (void)run(p, command);
    __builtin_snprintf(label, sizeof label, "%s: it prints what make's build prints", name);
    scratch::expect_text(label, scratch::read(p, "make.out"), scratch::read(p, "smith.out"));
}

// The compile and link commands of a build, each with the compiler called CC (or CXX) and the dependency flags out, as
// the shell reads them (quotes removed), one per line, sorted, without duplicates: what tests/build_fixtures/
// same_commands.sh (sed, eval and sort -u) made of `make -n -B` and of `smith build -t commands`.
constexpr usize no_match = (usize)-1;
constexpr usize command_capacity = 8192;
constexpr usize command_count = 512;

typedef struct {
    char *lines[command_count];
    usize count;
} Commands;

static usize find_text(const char *text, const char *needle) {
    const char *at = c::strstr(text, needle);
    return at != nullptr ? (usize)(at - text) : no_match;
}

// Replaces text[from:to] with `replacement`.
static void cut(char *text, usize from, usize to, const char *replacement) {
    usize length = c::strlen(replacement);
    __builtin_memmove(text + from + length, text + to, c::strlen(text + to) + 1);
    __builtin_memcpy(text + from, replacement, length);
}

static usize word_end(const char *text, usize from) {
    usize end = from;
    while (text[end] != '\0' && text[end] != ' ')
        end++;
    return end;
}

static bool one_of(const char *word, const char *names[4]) {
    for (usize i = 0; i < 4; i++)
        if (c::strcmp(word, names[i]) == 0) return true;
    return false;
}

// `^([^ ]*/)?(smith-cc|cc|clang|gcc) ` is CC and the same for the C++ compilers CXX.
static void name_the_compiler(char *line) {
    usize end = word_end(line, 0);
    if (line[end] != ' ' || end >= 256) return;
    usize start = end;
    while (start > 0 && line[start - 1] != '/')
        start--;
    char word[256];
    __builtin_memcpy(word, line + start, end - start);
    word[end - start] = '\0';
    const char *c_compilers[4] = {"smith-cc", "cc", "clang", "gcc"};
    const char *cxx_compilers[4] = {"smith-c++", "c++", "g++", "clang++"};
    if (one_of(word, c_compilers))
        cut(line, 0, end, "CC");
    else if (one_of(word, cxx_compilers))
        cut(line, 0, end, "CXX");
}

// ` -MMD -MF <file>.d `, ` -MMD ` and ` -MP ` become a space (the first of each), and runs of spaces one.
static void drop_dependency_flags(char *line) {
    usize at = find_text(line, " -MMD -MF ");
    if (at != no_match) {
        usize end = word_end(line, at + 10);
        if (end >= at + 12 && line[end] == ' ' && c::strncmp(line + end - 2, ".d", 2) == 0) cut(line, at, end + 1, " ");
    }
    at = find_text(line, " -MMD ");
    if (at != no_match) cut(line, at, at + 6, " ");
    at = find_text(line, " -MP ");
    if (at != no_match) cut(line, at, at + 5, " ");
    for (usize i = 0; line[i] != '\0'; i++)
        while (line[i] == ' ' && line[i + 1] == ' ')
            cut(line, i, i + 1, "");
}

// Copies the text up to the closing quote (the opening one is passed) into the words, as the shell does: nothing is
// special inside single quotes, and inside double quotes a backslash before $, `, " or a backslash is one. False when
// the quote is not closed.
static bool copy_quoted(const char *line, usize *at, char quote, char *words, usize *used, usize capacity) {
    while (line[*at] != quote) {
        if (line[*at] == '\0' || *used + 2 >= capacity) return false;
        if (quote == '"' && line[*at] == '\\' && line[*at + 1] != '\0' && c::strchr("$`\"\\", line[*at + 1]) != nullptr)
            (*at)++;
        words[(*used)++] = line[(*at)++];
    }
    (*at)++;
    return true;
}

// The words of the line as `eval "set -- $line"` gives them (single and double quotes and backslashes), joined by one
// space. False when a quote is not closed, which the shell refuses.
static bool unquote(const char *line, char *words, usize capacity) {
    usize used = 0;
    usize i = 0;
    while (line[i] != '\0') {
        while (line[i] == ' ')
            i++;
        if (line[i] == '\0') break;
        if (used > 0) words[used++] = ' ';
        while (line[i] != '\0' && line[i] != ' ') {
            char ch = line[i++];
            bool quoted = ch == '\'' || ch == '"';
            if (quoted && !copy_quoted(line, &i, ch, words, &used, capacity)) return false;
            if (ch == '\\' && line[i] == '\0') return false;
            if (!quoted) words[used++] = ch == '\\' ? line[i++] : ch;
            if (used + 2 >= capacity) return false;
        }
    }
    words[used] = '\0';
    return true;
}

static bool ordered_before(const char *a, const char *b) {
    return c::strcmp(a, b) < 0;
}

// Adds a line to the sorted list unless it is in it already.
static void add_command(Commands *commands, char *line) {
    usize at = 0;
    while (at < commands->count && ordered_before(commands->lines[at], line))
        at++;
    if (at < commands->count && c::strcmp(commands->lines[at], line) == 0) {
        return;
    }
    test::check_less(commands->count, command_count);
    for (usize i = commands->count; i > at; i--)
        commands->lines[i] = commands->lines[i - 1];
    commands->lines[at] = line;
    commands->count++;
}

// The canonical commands of the text of a build: only the lines of the compiler.
static void canonical(io::Io *io, const char *text, Commands *commands) {
    *commands = (Commands){};
    usize start = 0;
    while (text[start] != '\0') {
        usize end = start;
        while (text[end] != '\0' && text[end] != '\n')
            end++;
        if (end - start < command_capacity) {
            char *line = arena::push_slice(&io->arena, char, command_capacity).data;
            __builtin_memcpy(line, text + start, end - start);
            line[end - start] = '\0';
            name_the_compiler(line);
            drop_dependency_flags(line);
            if (c::strncmp(line, "CC ", 3) == 0 || c::strncmp(line, "CXX ", 4) == 0) {
                char *words = arena::push_slice(&io->arena, char, command_capacity).data;
                add_command(commands, unquote(line, words, command_capacity) ? words : line);
            }
        }
        start = text[end] == '\n' ? end + 1 : end;
    }
}

// Removes ` -L<dir> -lsmith_handlers` (and ` -Wl,-rpath,@executable_path` after it) and ` -L<dir>/lib/darwin` from a
// line.
static void drop_handlers_link(char *line) {
    usize at = find_text(line, " -lsmith_handlers");
    if (at != no_match) {
        usize start = at;
        while (start > 0 && line[start - 1] != ' ')
            start--;
        usize end = at + 17;
        if (c::strncmp(line + end, " -Wl,-rpath,@executable_path", 28) == 0) end += 28;
        if (start > 1 && line[start] == '-' && line[start + 1] == 'L') cut(line, start - 1, end, "");
    }
    at = find_text(line, "/lib/darwin");
    if (at != no_match) {
        usize start = at;
        while (start > 0 && line[start - 1] != ' ')
            start--;
        if (start > 1 && line[start] == '-' && line[start + 1] == 'L') cut(line, start - 1, at + 11, "");
    }
}

// smith's link also builds and links the handlers runtime (a dylib beside the program), which make's does not: the step
// and its three arguments are taken out.
static void drop_handlers(Commands *commands) {
    usize kept = 0;
    for (usize i = 0; i < commands->count; i++) {
        if (c::strstr(commands->lines[i], " -dynamiclib ") != nullptr) continue;
        drop_handlers_link(commands->lines[i]);
        usize at = find_text(commands->lines[i], " -lclang_rt.asan_osx_dynamic");
        if (at != no_match) cut(commands->lines[i], at, at + 28, "");
        commands->lines[kept++] = commands->lines[i];
    }
    commands->count = kept;
}

static const char *joined(io::Io *io, const Commands *commands) {
    char *text = arena::push_slice(&io->arena, char, command_capacity * 8).data;
    usize used = 0;
    for (usize i = 0; i < commands->count; i++) {
        usize length = c::strlen(commands->lines[i]);
        test::check_less(used + length + 2, command_capacity * 8);
        __builtin_memcpy(text + used, commands->lines[i], length);
        text[used + length] = '\n';
        used += length + 1;
    }
    text[used] = '\0';
    return text;
}

// The commands of `smith build -t commands`: a line `sh .smith/command/<file>` stands for the commands in the file.
static const char *expand_commands(const scratch::Project *p, const char *raw) {
    char *text = arena::push_slice(&p->io->arena, char, command_capacity * 8).data;
    usize used = 0;
    usize start = 0;
    while (raw[start] != '\0') {
        usize end = start;
        while (raw[end] != '\0' && raw[end] != '\n')
            end++;
        char line[1024];
        usize length = end - start < sizeof line - 1 ? end - start : sizeof line - 1;
        __builtin_memcpy(line, raw + start, length);
        line[length] = '\0';
        const char *shown = c::strncmp(line, "sh .smith/command/", 18) == 0 ? scratch::read(p, line + 3) : line;
        used += (usize)__builtin_snprintf(text + used, command_capacity * 8 - used, "%s\n", shown);
        start = raw[end] == '\n' ? end + 1 : end;
    }
    return text;
}

// Compares the compile and link commands of `make -n -B` with the translation's for the targets.
static void same_commands(const scratch::Project *p, const char *name, const char *targets) {
    char command[512];
    char label[256];
    Commands made;
    Commands smith;
    canonical(p->io, run(p, "make -n -B 2>/dev/null").out, &made);
    __builtin_snprintf(command, sizeof command, "smith build -t commands %s 2>/dev/null", targets);
    canonical(p->io, expand_commands(p, run(p, command).out), &smith);
    drop_handlers(&smith);
    __builtin_snprintf(label, sizeof label, "%s: the same compile and link commands as make", name);
    scratch::expect_text(label, joined(p->io, &made), joined(p->io, &smith));
    __builtin_snprintf(label, sizeof label, "%s: and some", name);
    scratch::expect_contains(label, joined(p->io, &smith), "CC");
}

// 1. Variables: their flavors, expansion, += and ?=, substitution references, ${X}, override.
export void test_make_variables(io::Io *io) {
    scratch::Project p = project(io, "make_01");
    printer(&p, 12);
    (void)translate(&p, "1");
    same_output(&p, "variables", "prog", "", "1");
    has(&p, "variables: the flags of the compile are written out", "\"-DR1=\\\"2\\\"\"");
    has(&p, "variables: a command-line variable is an option", "smith_option_value(b, \"UNDEFINED_VARIABLE\"");
    has(&p, "variables: the option has the Makefile's line", "Makefile:");
    same_output(&p, "variables: C and D set on the command line", "prog", "C=cmd D=cmd2", "1");
}

// 2. The functions of the subset.
export void test_make_functions(io::Io *io) {
    scratch::Project p = project(io, "make_02");
    printer(&p, 20);
    (void)translate(&p, "2");
    same_output(&p, "functions", "prog", "", "2");
    scratch::expect_text("functions: no construct is reported", "", scratch::read(&p, "dump.err"));
}

// 3. Rules: explicit and pattern rules, order-only prerequisites, the automatic variables, a recipe that is not a
// compile.
export void test_make_rules(io::Io *io) {
    scratch::Project p = project(io, "make_03");
    printer(&p, 1);
    (void)run(&p, "echo one >a.in; echo two >b.in");
    (void)translate(&p, "3");
    (void)run(&p, "rm -f main.o");
    same_output(&p, "rules", "prog", "", "3");
    (void)run(&p, "rm -f both.txt a.txt b.txt main.o; make >/dev/null 2>&1; cat both.txt a.txt b.txt >make.files; "
                  "rm -f both.txt a.txt b.txt main.o prog; smith build >/dev/null 2>&1; cat both.txt a.txt b.txt "
                  ">smith.files 2>&1");
    scratch::expect_text("rules: automatic variables and the stem in recipes", scratch::read(&p, "make.files"),
                         scratch::read(&p, "smith.files"));
    has(&p, "rules: a pattern rule's compile is a smith_object", "smith_object(b, &object_1);");
    has(&p, "rules: a link is a smith_program", "smith_program(b, &program_1);");
    has(&p, "rules: another recipe is a smith_step", "smith_step(b, &step_");
    has(&p, "rules: each block says where it came from", "// Makefile:");
}

// 4. Recipes: @ and -, line continuations, several lines.
export void test_make_recipes(io::Io *io) {
    scratch::Project p = project(io, "make_04");
    (void)translate(&p, "4");
    (void)run(&p, "make >/dev/null 2>&1; cp out.txt make.out; rm out.txt; smith build >/dev/null 2>&1");
    scratch::expect_text("recipes: the lines run in order, - ignores a failure, a continuation joins",
                         scratch::read(&p, "make.out"), scratch::read(&p, "out.txt"));
    has(&p, "recipes: several lines are one script", "set -e");
}

// 5. Phony targets, the default goal, and the names of smith's verbs.
export void test_make_phony_targets_and_the_default_goal(io::Io *io) {
    scratch::Project p = project(io, "make_05");
    printer(&p, 1);
    (void)translate(&p, "5");
    has(&p, "phony: the first target is the default", "smith_default(b, (const char *[]){\"prog\", nullptr});");
    has(&p, "phony: clean is dropped, with the reason", "`clean` is dropped");
    has(&p, "phony: a verb's name becomes make-test, which smith test runs", "smith_task(b, \"make-test\", &");
    has(&p, "phony: and it is one of the tests", ".test = true,");
    has(&p, "phony: run is smith run", "`run` is `smith run`");
    has(&p, "phony: check is an alias of another name", "smith_alias(b, \"make-check\", ");
    has(&p, "phony: another phony target is a task", "smith_task(b, \"extra\", &");
    lacks(&p, "phony: no task named after a verb", "smith_task(b, \"test\"");
    (void)run(&p, "smith build >/dev/null 2>&1");
    scratch::expect_text("phony: the default builds the program", "ok", run(&p, "[ -x prog ] && echo ok").out);
    (void)run(&p, "smith build extra >/dev/null 2>&1");
    scratch::expect_text("phony: smith build extra runs the task", "extra", scratch::read(&p, "extra.txt"));
    (void)run(&p, "cp Makefile.default Makefile");
    (void)translate(&p, "5b");
    has(&p, ".DEFAULT_GOAL names the default", "smith_default(b, (const char *[]){\"second\", nullptr});");
}

// 6. include and -include.
export void test_make_include(io::Io *io) {
    scratch::Project p = project(io, "make_06");
    printer(&p, 3);
    (void)translate(&p, "6");
    (void)run(&p, "rm -f main.o");
    same_output(&p, "include", "prog", "", "6");
    scratch::expect_text("include: nothing is reported", "", scratch::read(&p, "dump.err"));
    has(&p, "include: dependency files are dropped, with a note", "smith tracks the headers");
    lacks(&p, "include: -MMD is not kept", "\"-MMD\"");
}

// 7. Conditionals: ifeq, ifneq, ifdef, ifndef, else, else ifeq.
export void test_make_conditionals(io::Io *io) {
    scratch::Project p = project(io, "make_07");
    printer(&p, 8);
    (void)translate(&p, "7");
    same_output(&p, "conditionals", "prog", "", "7");
    has(&p, "conditionals: a test of an option the Makefile never sets is an option", "build_never");
}

// 8. A test of the platform keeps both branches, as an if on b->os and b->arch.
export void test_make_platform(io::Io *io) {
    scratch::Project p = project(io, "make_08");
    printer(&p, 5);
    (void)translate(&p, "8");
    same_output(&p, "platform", "prog", "", "8");
    has(&p, "platform: Darwin is a test of b->os", "strcmp(b->os, \"Darwin\") == 0");
    has(&p, "platform: and Linux", "strcmp(b->os, \"Linux\") == 0");
    has(&p, "platform: OS == Windows_NT is a test of b->os too", "strcmp(b->os, \"Windows_NT\") == 0");
    has(&p, "platform: the architecture is b->arch", "b->arch");
    scratch::expect_text("platform: a test of the platform is not reported as unsupported", "",
                         scratch::read(&p, "dump.err"));
}

// 9. Command-line knobs are -D options of the build file.
export void test_make_knobs(io::Io *io) {
    scratch::Project p = project(io, "make_09");
    printer(&p, 3);
    (void)translate(&p, "9");
    has(&p, "knobs: the first line names the options", "// Options the Makefile reads from the command line");
    has(&p, "knobs: DEBUG", "-DDEBUG=...");
    has(&p, "knobs: VERBOSE", "-DVERBOSE=...");
    same_output(&p, "knobs: the defaults", "prog", "", "9");
    same_output(&p, "knobs: DEBUG=1", "prog", "DEBUG=1", "9");
    same_output(&p, "knobs: DEBUG=1 VERBOSE=yes EXTRA=more", "prog", "DEBUG=1 VERBOSE=yes EXTRA=more", "9");
}

// 10. make's built-in rules for C: a compile and a link nobody wrote.
export void test_make_built_in_rules(io::Io *io) {
    scratch::Project p = project(io, "make_10");
    printer(&p, 2);
    (void)run(&p, "mv main.c prog.c; printf 'int helper(void) { return 1; }\\n' >helper.c; "
                  "sed -i.bak 's/int main(void) {/int helper(void);\\nint main(void) {/' prog.c");
    (void)translate(&p, "10");
    same_output(&p, "built-in rules", "prog", "", "10");
    has(&p, "built-in rules: the compile is a smith_object", "smith_object(b, &object_1);");
    has(&p, "built-in rules: with the CFLAGS", "\"-O1\"");
    has(&p, "built-in rules: the link is a smith_program", "smith_program(b, &program_1);");
}

// 11. An archive is a step, and the program that links it names it a library.
export void test_make_archive(io::Io *io) {
    scratch::Project p = project(io, "make_11");
    printer(&p, 1);
    scratch::write(&p, "lib.c", "const char *name(void) { return \"lib\"; }\n");
    (void)translate(&p, "11");
    same_output(&p, "archive", "prog", "", "11");
    has(&p, "archive: ar is a step", "\"ar\", \"rcs\"");
    has(&p, "archive: the library of the link", ".libraries = (const char *[]){\"libx.a\", nullptr}");
}

// 12. Recursive make: a goal of the same Makefile, and -C another folder.
export void test_make_recursive_make(io::Io *io) {
    scratch::Project p = project(io, "make_12");
    printer(&p, 1);
    scratch::write(&p, "sub/lib.c", "const char *name(void) { return \"sub\"; }\n");
    (void)translate(&p, "12");
    (void)run(&p, "rm -f sub/lib.a sub/lib.o");
    same_output(&p, "recursive make", "prog", "", "12");
    (void)run(&p, "rm -f sub/lib.a sub/lib.o");
    has(&p, "recursive make: the other folder's targets are named under it", "\"sub/lib.a\"");
    has(&p, "recursive make: and run in it", "cd 'sub'");
    has(&p, "recursive make: the other Makefile is the source of the comment", "sub/Makefile:");
    scratch::expect_text("recursive make: nothing is reported", "", scratch::read(&p, "dump.err"));
}

// 13. What is outside the subset is reported by name, file and line, and the rest still translates.
export void test_make_what_is_outside_the_subset_is_reported(io::Io *io) {
    scratch::Project p = project(io, "make_13");
    printer(&p, 1);
    (void)run(&p, "echo other >other");
    expect_zero("reported: the translation still exits 0", translate(&p, "13"));
    const char *err = scratch::read(&p, "dump.err");
    scratch::expect_contains("reported: VPATH by line", err, "Makefile:1: not translated: VPATH is not supported");
    scratch::expect_contains("reported: .SECONDEXPANSION", err,
                             "Makefile:2: not translated: .SECONDEXPANSION is not supported");
    scratch::expect_contains("reported: a double-colon rule", err,
                             "Makefile:5: not translated: a double-colon rule is not supported");
    scratch::expect_contains("reported: a target-specific variable", err,
                             "Makefile:7: not translated: a target-specific variable is not supported");
    scratch::expect_contains("reported: $(shell) is frozen", err,
                             "Makefile:11: not translated: $(shell echo frozen) was run now and is frozen");
    scratch::expect_contains("reported: eval in a recipe", err,
                             "Makefile:10: not translated: $(eval) in a recipe is not supported");
    has(&p, "reported: the build.c says so too", "// NOT TRANSLATED");
    has(&p, "reported: with the line", "//   Makefile:1: VPATH is not supported");
    scratch::expect_text("reported: and the build.c builds", "0", run(&p, "smith build >/dev/null 2>&1; echo $?").out);
}

// 14. The same commands as make for a small project with a flags variable and a pattern rule.
export void test_make_the_same_commands_as_make(io::Io *io) {
    scratch::Project p = project(io, "make_14");
    printer(&p, 1);
    (void)run(&p, "cp main.c second.c; sed -i.bak 's/int main(void) {/int second_main(void) {/' second.c");
    (void)translate(&p, "14");
    (void)run(&p, "smith build >/dev/null 2>&1");
    same_commands(&p, "commands", "prog");
    has(&p, "readable: a flags variable is an array with the Makefile's name", "const char *const *build_warn =");
    has(&p, "readable: and the other uses it", "smith_cat(b, build_warn, ");
    has(&p, "readable: the compiler is smith-cc", ".compiler = \"smith-cc\"");
    has(&p, "readable: the header names the Makefile", "// build.c, translated from Makefile");
}

// 15. A rule under a test of the platform is a step that build.c declares only there; two that differ are reported.
export void test_make_a_rule_under_a_test_of_the_platform(io::Io *io) {
    scratch::Project p = project(io, "make_15");
    (void)translate(&p, "15");
    has(&p, "guarded rule: the step is declared under the test", "if ((strcmp(b->os, \"NotAnOs\") != 0)) {");
    scratch::expect_contains("guarded rule: two recipes under different tests are reported",
                             scratch::read(&p, "dump.err"), "other.txt has recipes under different tests");
    (void)run(&p, "smith build >/dev/null 2>&1");
    scratch::expect_text("guarded rule: and the build.c builds it", "here", scratch::read(&p, "here.txt"));
}

// A wildcard of a command-line variable is read at its default, and said so.
export void test_make_a_wildcard_of_an_option_is_read_at_its_default(io::Io *io) {
    scratch::Project p = project(io, "make_16");
    (void)run(&p, "echo font >font.bdf");
    (void)translate(&p, "16");
    scratch::expect_contains("wildcard of an option: reported", scratch::read(&p, "dump.err"),
                             "$(wildcard $(FONT)) was read now, with the option at its default (font.bdf)");
    has(&p, "wildcard of an option: its default is the file", "\"font.bdf\"");
    (void)run(&p, "smith build >/dev/null 2>&1");
    scratch::expect_text("wildcard of an option: the build uses the file", "font", scratch::read(&p, "out.txt"));
}

// 16. Which Makefile, and when.
export void test_make_which_makefile_and_when(io::Io *io) {
    scratch::Project p = project(io, "make_17");
    (void)translate(&p, "17");
    has(&p, "files: GNUmakefile comes first", "\"b\"");
    lacks(&p, "files: and Makefile is left", "\"a\"");
    (void)run(&p, "rm GNUmakefile");
    (void)translate(&p, "17b");
    has(&p, "files: otherwise Makefile", "\"a\"");
    scratch::write(&p, "build.c", "#include <smith/build.h>\nvoid build(SmithBuild *b) { (void)b; }\n");
    (void)run(&p, "smith build --dump-config >dumped.txt 2>&1");
    scratch::expect_lacks("files: a folder with a build.c is not translated", scratch::read(&p, "dumped.txt"),
                          "translated from");
}

// 17. A Makefile and a main, and no build file: --dump-config translates the Makefile, and nothing builds by
// convention.
export void test_make_a_makefile_and_a_main_and_no_build_file(io::Io *io) {
    scratch::Project p = project(io, "make_18");
    scratch::write(&p, "main.c", "int main(void) { return 0; }\n");
    scratch::Run dump = run(&p, "smith build --dump-config");
    scratch::expect_status("makefile and main: --dump-config exits 0", 0, &dump);
    scratch::expect_contains("makefile and main: it translates the Makefile", dump.out, "translated from Makefile");
    scratch::Run build = run(&p, "smith build");
    scratch::expect_status("makefile and main: smith build stops", 2, &build);
    scratch::expect_contains("makefile and main: and says to translate it", build.err,
                             "smith build --dump-config > build.c");
    scratch::expect_contains("makefile and main: or to delete it", build.err, "delete it to build by convention");
    scratch::Run verb = run(&p, "smith run");
    scratch::expect_status("makefile and main: a verb stops too", 2, &verb);
    scratch::expect_contains("makefile and main: with the same message", verb.err,
                             "smith build --dump-config > build.c");
    scratch::expect_text("makefile and main: nothing was built", "", run(&p, "ls prog build .smith 2>/dev/null").out);
    (void)run(&p, "rm Makefile");
    scratch::Run conventions = run(&p, "smith build --dump-config");
    scratch::expect_contains("no Makefile: the conventions are dumped", conventions.out, "smith_app");
}

static void empty_build_file_is_none(io::Io *io, const char *file) {
    scratch::Project p = project(io, nullptr);
    char text[256];
    char label[256];
    scratch::write(&p, "main.c", "int main(void) { return 0; }\n");
    scratch::write(&p, "Makefile", "prog: main.c\n\tcc main.c -o prog\n");
    scratch::write(&p, file, "");
    scratch::Run dump = run(&p, "smith build --dump-config");
    __builtin_snprintf(label, sizeof label, "empty %s: the Makefile is translated", file);
    scratch::expect_status(label, 0, &dump);
    __builtin_snprintf(label, sizeof label, "empty %s: the output is the translation", file);
    scratch::expect_contains(label, dump.out, "translated from Makefile");
    scratch::Run build = run(&p, "smith build");
    __builtin_snprintf(label, sizeof label, "empty %s: smith build still sees the Makefile", file);
    scratch::expect_contains(label, build.err, "smith build --dump-config > build.c");
    (void)run(&p, "rm Makefile");
    scratch::Run again = run(&p, "smith build --dump-config");
    __builtin_snprintf(label, sizeof label, "empty %s: and with no Makefile the conventions are dumped", file);
    scratch::expect_contains(label, again.out, "smith_app");
    (void)text;
}

// 18. An empty build file is none, for build.c and for build.smith, in the translator and in the conventions.
export void test_make_an_empty_build_c_is_none(io::Io *io) {
    empty_build_file_is_none(io, "build.c");
}

export void test_make_an_empty_build_smith_is_none(io::Io *io) {
    empty_build_file_is_none(io, "build.smith");
}

// 19. A Makefile too big for one function of 70 lines: build.c is a function for each run of targets, the variables are
// statics, and it still passes lint and fmt (translate checks) and builds.
export void test_make_a_makefile_too_big_for_one_function(io::Io *io) {
    scratch::Project p = project(io, nullptr);
    (void)run(&p, "i=1; while [ \"$i\" -le 45 ]; do : >\"src$i.dat\"; i=$((i + 1)); done; "
                  "{ echo 'DATA := $(sort $(wildcard src*.dat))'; echo 'PREFIX ?= out'; i=1; "
                  "while [ \"$i\" -le 30 ]; do printf 'step%s: $(DATA)\\n\\t@touch $(PREFIX)%s.txt $(DATA)\\n' \"$i\" "
                  "\"$i\"; i=$((i + 1)); done; "
                  "echo '.PHONY: all'; echo 'all: step1 step30'; } >Makefile");
    expect_zero("split: the Makefile is translated", translate(&p, "19"));
    has(&p, "split: the variables are statics", "static const char *const *build_data;");
    has(&p, "split: a long list is written in pieces", "build_data = smith_cat(b, build_data,");
    has(&p, "split: a function for each run of targets", "static void part_2(SmithBuild *b) {");
    has(&p, "split: build() calls them", "    part_1(b);");
    scratch::Run built = run(&p, "smith build -DPREFIX=pre");
    scratch::expect_status("split: smith build builds it", 0, &built);
    scratch::expect_text("split: the option reaches a recipe", "pre1.txt", run(&p, "ls pre1.txt 2>/dev/null").out);
}
