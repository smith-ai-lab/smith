// End-to-end tests for `smith dbg --crash` and `smith dbg --at` (runtime/explain.c, shim/lldb_explain.cpp; from
// tests/dbg_crash.sh): a program run under lldb whose state is printed at a crash or a line, in C and in .smith. They
// launch real processes under a debugger, so they need Developer mode and the Developer Tools permission of the
// terminal running them (knowledge/debugger.md); a smith without clang or lldb inside (the stage0), or an account that
// may not debug, has nothing to test, and the tests do nothing. The C program is tests/build_fixtures/dbg_crash/prog.c.
// A test makes its project, then sets its own memory as the current allocator: what scratch returns to it (a Run's
// texts, a file it reads) is given back with that memory, and scratch::clean frees what make holds.
module dbg_crash_test;

import std::format;
import std::arena;
import std::mem;
import std::test;
import scratch;
import target;

constexpr usize memory_size = (usize)16 << 20; // 16 MiB

// What the tests debug is built once for each smith under test and set of sources, in $SMITH_TEST_CACHE/dbgcrash-<key>
// (a lock folder makes one test the builder and the others wait, as runner.smith's shared build does) and copied into
// each test's project (the C program, plain and under AddressSanitizer) or run in place (the `smith new` app): they
// cost 2.5 s and 6 s of CPU in each of the tests that used them (#638). The debug information names the shared folder,
// where prog.c and main.smith are too, so the source lines are found and shown relative to it: the debugger runs from
// the shared folder (`.dir-c`, `.dir-app` name it) and writes its output into the project. ONE is "c" or "app".
constexpr char shared_script[_] =
    "if [ \"$(uname -s)\" = Darwin ]; then sf='-f %N_%m_%z'; else sf='-c %n_%Y_%s'; fi; "
    "key=$( { stat $sf \"$SMITH_SELF\"; cat \"$SMITH_REPO\"/tests/build_fixtures/dbg_crash/*; } | shasum -a "
    "256 | "
    "cut -c1-20 ); c=$SMITH_TEST_CACHE/dbgcrash-$key; "
    "if [ ! -e \"$c/$ONE.done\" ]; then "
    "if mkdir \"$c.lock-$ONE\" 2>/dev/null; then "
    "mkdir -p \"$c/$ONE\" && cp -R \"$SMITH_REPO\"/tests/build_fixtures/dbg_crash/. \"$c/$ONE\" && cd \"$c/$ONE\" && "
    "{ if [ $ONE = c ]; then "
    "smith cc -g -O0 -c prog.c -o prog.o && smith cc prog.o -o prog && smith cc -g -O0 -fsanitize=address -c prog.c "
    "-o prog_asan.o && smith cc -fsanitize=address prog_asan.o -o prog_asan && "
    "{ smith dbg --crash ./prog n 2>&1 | grep -q 'not debugged' || : >debuggable; }; "
    "else mkdir w && cd w && smith new app >/dev/null 2>&1 && cd app && cp ../../app_main.smith main.smith && "
    "rm -f primes.smith && smith build >build.txt 2>&1; fi; }; r=$?; "
    "[ $r = 0 ] && : >\"$c/$ONE.done\"; rmdir \"$c.lock-$ONE\"; [ $r = 0 ] || exit 1; "
    "else n=0; until [ -e \"$c/$ONE.done\" ]; do "
    "[ -d \"$c.lock-$ONE\" ] || { echo \"the build did not finish\"; exit 1; }; "
    "n=$((n + 1)); [ $n -lt 6000 ] || { echo \"timed out waiting for the build\"; exit 1; }; "
    "perl -e 'select(undef, undef, undef, 0.2)'; done; fi; fi; echo \"$c/$ONE\" >\"$here/.dir-$ONE\"; "
    "if [ $ONE = c ]; then cp -Rp \"$c/c/.\" \"$here\"; else mkdir -p \"$here/w/app\"; fi";

// prog.c built plain and under AddressSanitizer in the project. False when this smith cannot debug here.
static bool ready(const scratch::Project *p) {
    scratch::Run usable = scratch::sh(
        p, "[ \"$(smith cc --smith-which -c a.c | head -n 1 | cut -d ' ' -f 1,2)\" = 'clang in-process' ] && "
           "smith dbg --version >/dev/null 2>&1");
    if (usable.status != 0) {
        return false;
    }
    scratch::Run built = scratch::sh(p, format::push("ONE=c; here=$PWD; ", shared_script).data);
    scratch::expect_status("prog.c builds", 0, &built);
    return scratch::exists(p, "debuggable");
}

// The program's standard error after `smith dbg ARGUMENTS`, which the checks read; the status is the run's.
static void note_output(const scratch::Project *p, const char *folder);

static scratch::Run crash(const scratch::Project *p, const char *arguments) {
    scratch::Run run = scratch::sh(p, format::push("here=$PWD; cd \"$(cat .dir-c)\" && smith dbg ", arguments,
                                                   " >\"$here/out.txt\" 2>\"$here/err.txt\"")
                                          .data);
    note_output(p, "");
    return run;
}

// A failure shows the debugger's whole output, standard output and error, so that the cause is named.
static void note_output(const scratch::Project *p, const char *folder) {
    const char *out = scratch::read(p, format::push(folder, "out.txt").data);
    const char *err = scratch::read(p, format::push(folder, "err.txt").data);
    test::note("smith dbg standard output:\n%s\nsmith dbg standard error:\n%s", out, err);
}

// smith dbg --crash on the .smith app, with the arguments of the program.
static scratch::Run crash_app(const scratch::Project *p, const char *arguments) {
    scratch::Run run =
        scratch::sh(p, format::push("here=$PWD; cd \"$(cat .dir-app)/w/app\" && smith dbg --crash build/debug/app ",
                                    arguments, " >\"$here/w/app/out.txt\" 2>\"$here/w/app/err.txt\"")
                           .data);
    note_output(p, "w/app/");
    return run;
}

// 1. A C program that writes past an array: ASan's report as the program printed it, then the frames with their values.
export void test_macos_dbg_crash_asan_report_then_frames() {
    scratch::Project p = scratch::make("dbg", "dbg_crash");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&p)) {
        return;
    }
    scratch::Run run = crash(&p, "--crash ./prog_asan h");
    const char *err = scratch::read(&p, "err.txt");
    scratch::expect_status("asan: the status is 1", 1, &run);
    scratch::expect_contains("asan: the report is the program's own", err,
                             "ERROR: AddressSanitizer: heap-buffer-overflow");
    scratch::expect_contains("asan: the stop reason", err, "smith dbg: stopped: Heap buffer overflow");
    scratch::expect_contains("asan: the frame of main", err, "smith dbg: prog.c:23: main");
    scratch::expect_contains("asan: the source line", err, "return heap[pick(p, 1) + 8];");
    scratch::expect_contains("asan: a struct local", err, "@ p     = (x = 3, y = 4)");
    // The frames smith dbg shows are its own "smith dbg:" lines; the report the program printed names compiler-rt's
    // sources in malloc's frame (the path of the LLVM build), and that is the program's text, not a frame shown.
    scratch::expect_text("asan: no frame of the sanitizer's runtime", "0",
                         scratch::capture(&p, "grep '^smith dbg: ' err.txt | grep -c compiler-rt"));
}

// 2. A signal: the stop reason, the status 128 + 11, and the standard output and error as they are.
export void test_macos_dbg_crash_signal() {
    scratch::Project p = scratch::make("dbg", "dbg_crash");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&p)) {
        return;
    }
    scratch::Run run = crash(&p, "--crash ./prog n");
    const char *err = scratch::read(&p, "err.txt");
    scratch::expect_status("signal: the status is 128 + SIGSEGV", 139, &run);
    // The stop reason is the platform's own text: a Mach exception on macOS, the signal on Linux.
    if constexpr (target::os == target::macos) {
        scratch::expect_contains("signal: the stop reason", err, "smith dbg: stopped: EXC_BAD_ACCESS");
    } else {
        scratch::expect_contains("signal: the stop reason", err, "smith dbg: stopped: signal SIGSEGV");
    }
    scratch::expect_contains("signal: the failing line", err, "smith dbg: prog.c:19: main");
    scratch::expect_contains("signal: a local as @", err, "@ argc  = 2");
    scratch::expect_contains("signal: the program's standard error passes through", err, "err");
    scratch::expect_text("signal: the program's standard output is not smith's", "0",
                         scratch::capture(&p, "grep -c 'smith dbg' out.txt"));
}

// 3. abort and --frames.
export void test_macos_dbg_crash_abort_and_frames() {
    scratch::Project p = scratch::make("dbg", "dbg_crash");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&p)) {
        return;
    }
    scratch::Run run = crash(&p, "--crash --frames 1 ./prog a");
    scratch::expect_status("abort: the status is 128 + SIGABRT", 134, &run);
    scratch::expect_contains("abort: the stop reason", scratch::read(&p, "err.txt"),
                             "smith dbg: stopped: signal SIGABRT");
    scratch::expect_text("abort: --frames 1 shows one frame", "1",
                         scratch::capture(&p, "grep -c '^smith dbg: prog.c:' err.txt"));
}

// 4. A program that exits: its output as it was, exited N, and its status.
export void test_macos_dbg_crash_a_program_that_exits() {
    scratch::Project p = scratch::make("dbg", "dbg_crash");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&p)) {
        return;
    }
    scratch::Run run = crash(&p, "--crash ./prog e");
    scratch::expect_status("exit: the status is the program's", 7, &run);
    scratch::expect_contains("exit: the program's output", scratch::read(&p, "out.txt"), "out");
    scratch::expect_contains("exit: exited 7", scratch::read(&p, "err.txt"), "smith dbg: exited 7");
}

// 5. --at: the locals at the line for the first N hits, then the program is ended.
export void test_macos_dbg_at_the_locals_at_a_line() {
    scratch::Project p = scratch::make("dbg", "dbg_crash");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&p)) {
        return;
    }
    scratch::Run run = crash(&p, "--at prog.c:11 --count 2 ./prog");
    const char *err = scratch::read(&p, "err.txt");
    scratch::expect_status("at: the status is 0", 0, &run);
    scratch::expect_text("at: two hits", "2", scratch::capture(&p, "grep -c 'smith dbg: at prog.c:11, hit' err.txt"));
    scratch::expect_contains("at: the first hit's argument", err, "@ i = 0");
    scratch::expect_contains("at: the second hit's argument", err, "@ i = 1");
    scratch::expect_text("at: the program was ended before it printed its total", "0",
                         scratch::capture(&p, "grep -c 'exited' err.txt"));
}

// 6. A .smith program, in the project smith new writes: a slice out of range and a failed contract in debug.
static bool ready_app(const scratch::Project *p) {
    if (!ready(p)) {
        return false;
    }
    scratch::Run made = scratch::sh(p, format::push("ONE=app; here=$PWD; ", shared_script).data);
    if (made.status != 0) {
        test::note("the .smith program does not build: %s", made.out);
    }
    scratch::expect_status("the .smith program builds", 0, &made);
    return made.status == 0;
}

export void test_macos_dbg_crash_a_slice_out_of_range_in_smith() {
    scratch::Project p = scratch::make("dbg", "dbg_crash");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready_app(&p)) {
        return;
    }
    scratch::Run run = crash_app(&p, "x");
    const char *err = scratch::read(&p, "w/app/err.txt");
    scratch::expect_status("smith slice: the status is 128 + SIGABRT", 134, &run);
    scratch::expect_contains("smith slice: the frame as written", err, "smith dbg: main.smith:6: main::total");
    scratch::expect_contains("smith slice: the index", err, "@ i  = 7");
    scratch::expect_contains("smith slice: the slice", err, "@ xs = count=4");
    scratch::expect_contains("smith slice: the caller", err, "smith dbg: main.smith:20: main");
}

export void test_macos_dbg_crash_a_failed_contract_in_smith() {
    scratch::Project p = scratch::make("dbg", "dbg_crash");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready_app(&p)) {
        return;
    }
    crash_app(&p, "x y");
    const char *err = scratch::read(&p, "w/app/err.txt");
    scratch::expect_contains("contract: the failing call's frame", err, "smith dbg: main.smith:11: main::positive");
    scratch::expect_contains("contract: its argument", err, "@ n = -1");
    scratch::expect_contains("contract: the caller's frame", err, "smith dbg: main.smith:19: main");
}

export void test_macos_dbg_crash_a_smith_program_that_exits() {
    scratch::Project p = scratch::make("dbg", "dbg_crash");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready_app(&p)) {
        return;
    }
    crash_app(&p, "");
    scratch::expect_contains("smith: a program that exits", scratch::read(&p, "w/app/err.txt"), "smith dbg: exited");
}

// 7. A program that cannot be debugged is run plainly after one line.
export void test_macos_dbg_crash_a_program_that_cannot_be_debugged() {
    scratch::Project p = scratch::make("dbg", "dbg_crash");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!ready(&p)) {
        return;
    }
    crash(&p, "--crash ./does-not-exist");
    scratch::expect_contains("refusal: one line saying why", scratch::read(&p, "err.txt"), "smith dbg: not debugged:");
}
