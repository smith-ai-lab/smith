// Tests of the fixer on the type forms of lib/std (#2106, piece 3 of #2093, part of #2053 and #1631): a struct that
// holds a function pointer next to `//` comments ends with the fields, not with `};` (the `#` comments the first pass
// wrote hid the old forms left from the second), a type function's `Type T` parameter, a parameter named `type`
// (reserved like `i32`, #1901) and a pointer to a slice `auto (*xs)[:]`.
module front_fix_decl_forms_test;

import front::fix;
import std::arena;
import std::mem;
import std::test;

static void expect_fixed(Str before, Str want) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed first = fix::fix_text("t.smith", before);
    test::check_equal(first.text, want);
    fix::Fixed second = fix::fix_text("t.smith", first.text);
    test::check_equal(second.applied, (Usize)0);
}

export void test_front_fix_struct_with_a_function_pointer_and_comments() {
    expect_fixed("module m;\nstruct Task {\n    Task *next; // the link\n    void (*entry)(void *context);\n"
                 "    Bool done; // set\n};\n",
                 "struct Task:\n    next: *Task # the link\n    entry: fn(*mut void)\n    done: bool # set\n");
}

export void test_front_fix_type_parameter_of_a_type_function() {
    expect_fixed("module m;\nexport Type Wrap(Type T) {\n    return T;\n}\n",
                 "pub fn Wrap(T: type) -> type:\n    return T\n");
}

export void test_front_fix_parameter_named_type() {
    expect_fixed("module m;\nvoid f(const char *type, Usize n) {\n    g(type, n);\n}\n",
                 "fn f(ty: *char, n: usize):\n    g(ty, n)\n");
}

export void test_front_fix_local_named_in() {
    expect_fixed("module m;\nvoid f(I32 n) {\n    I32 in = n;\n    g(in);\n    for (I32 i = 0; i < in; i++) g(i);\n}\n",
                 "fn f(n: i32):\n    in_: i32 = n\n    g(in_)\n    for i in range(0, in_):\n        g(i)\n");
}

export void test_front_fix_pointer_to_a_slice_of_auto() {
    expect_fixed("module m;\nvoid f(auto (*xs)[:]) {\n    g(xs);\n}\n", "fn f(xs: *[]auto):\n    g(xs)\n");
}

export void test_front_fix_struct_fields_with_several_names() {
    expect_fixed("module m;\ntypedef struct {\n    F32 low, high;\n} Range;\n",
                 "struct Range:\n    low: f32\n    high: f32\n");
    expect_fixed("module m;\ntypedef struct {\n    U32 a, b, c;\n} Three;\n",
                 "struct Three:\n    a: u32\n    b: u32\n    c: u32\n");
}

export void test_front_fix_static_assert_with_joined_strings() {
    expect_fixed("module m;\nstatic_assert(1, \"one \"\n                  \"two\");\n",
                 "static_assert(1 != 0, \"one \"\n                  \"two\")\n");
}

export void test_front_fix_bit_int_type_parses() {
    expect_fixed("module m;\ntypedef unsigned _BitInt(128) Wide;\n", "Wide := u128\n");
}

export void test_front_fix_field_and_local_named_type() {
    expect_fixed(
        "module m;\nstruct Node {\n    I32 type;\n};\nI32 f(Node *n) {\n    I32 type = n->type;\n    return type;\n}\n",
        "struct Node:\n    ty: i32\nfn f(n: *Node) -> i32:\n    ty: i32 = n.ty\n    return ty\n");
}

// A type function's `return enum { T some; none; };` is the unnamed `enum:` block as its last line, and `struct` the
// same (#2251).
export void test_front_fix_type_function_returns_an_unnamed_enum() {
    expect_fixed(
        "module m;\nexport Type Option(Type T) {\n    return enum {\n        T some;\n        none;\n    };\n}\n",
        "pub fn Option(T: type) -> type:\n    enum:\n        some: T\n        none\n");
}

export void test_front_fix_type_function_returns_an_unnamed_struct() {
    expect_fixed(
        "module m;\nexport Type Pair(Type T) {\n    return struct {\n        T first;\n        T second;\n    };\n}\n",
        "pub fn Pair(T: type) -> type:\n    struct:\n        first: T\n        second: T\n");
}

export void test_front_fix_typedef_of_a_pointer_is_a_pointer_type() {
    expect_fixed("module m;\ntypedef U32 Wide;\ntypedef Node *NodeRef;\ntypedef const char *Name;\ntypedef "
                 "typeof(U8[:]) Bytes;\n",
                 "Wide := u32\nNodeRef := *mut Node\nName := *char\nBytes := []mut u8\n");
}

export void test_front_fix_a_function_hands_out_a_writable_pointer() {
    expect_fixed("module m;\nNode *make(void) {\n    return g();\n}\nconst Node *peek(void) {\n    return g();\n}\n",
                 "fn make() -> *mut Node:\n    return g()\nfn peek() -> *Node:\n    return g()\n");
}

export void test_front_fix_wide_integer_typedef() {
    expect_fixed("module m;\ntypedef __uint128_t Wide;\n", "Wide := u128\n");
}

export void test_front_fix_indexed_for_each_with_a_const_pointer() {
    expect_fixed("module m;\nvoid f(const char *const argv[:]) {\n    for (Usize i, const char *argument : argv) {\n"
                 "        g(i, argument);\n    }\n}\n",
                 "fn f(argv: []*char):\n    for (i, argument) in enumerate(argv):\n        g(i, argument)\n");
}

export void test_front_fix_store_through_a_field_index_after_an_indexed_for_each() {
    expect_fixed("module m;\nVector f(const char *const argv[:]) {\n    Vector result = {};\n"
                 "    for (Usize i, const char *argument : argv) {\n        result.items[i] = argument;\n    }\n"
                 "    result.items[countof(argv)] = nullptr;\n    return result;\n}\n",
                 "fn f(argv: []*char) -> Vector:\n    result: Vector = {}\n    for (i, argument) in enumerate(argv):\n"
                 "        result.items[i] = argument\n    result.items[countof(argv)] = nullptr\n    return result\n");
}

// `restrict` on a slice parameter goes when the function states its slices apart in a `requires` (#2463): the prover
// checks that at each call, as it did `restrict`.
export void test_front_fix_restrict_slice_goes_with_an_apart_precondition() {
    expect_fixed("module m;\nimport std::contract;\nvoid copy(U8 dst[restrict :], const U8 src[restrict :]) {\n"
                 "    contract::requires(countof(dst) == 0 || &dst[0] + countof(dst) <= &src[0] || "
                 "&src[0] + countof(src) <= &dst[0]);\n    g(dst, src);\n}\n",
                 "import std.contract\nfn copy(dst: []u8, src: []u8):\n"
                 "    contract.requires(countof(dst) == 0 or &dst[0] + countof(dst) <= &src[0] or "
                 "&src[0] + countof(src) <= &dst[0])\n    g(dst, src)\n");
}

// Without that precondition the guarantee would be lost: the fixer leaves the function and reports it.
export void test_front_fix_restrict_slice_without_a_precondition_is_left_alone() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str before = "module m;\nvoid copy(U8 dst[restrict :], const U8 src[restrict :]) {\n    g(dst, src);\n}\n";
    fix::Fixed first = fix::fix_text("t.smith", before);
    Str word = "restrict";
    Bool kept = false;
    for (Usize i = 0; i + 8 <= countof(first.text); i += 1) {
        if (mem::equal(first.text[i:i + 8], word)) kept = true;
    }
    test::check_condition(kept);
}

// A prototype C defines is an `extern fn`, and `export` keeps it `pub`; the ownership attributes follow (#2469, decided
// on #1406): the fixer wrote `pub *c.FILE open(*char path);`, a C head with `char` as a type of smith's own.
export void test_front_fix_exported_prototype_is_a_pub_extern_fn() {
    expect_fixed("module m;\nexport c::FILE *open(const char *path);\n",
                 "pub extern fn open(path: *char) -> *mut c.FILE\n");
    expect_fixed("module m;\nexport [[std::returns_owned(free)]] char *dup(const char *text);\n",
                 "pub @returns_owned(free) extern fn dup(text: *char) -> *mut char\n");
}

export void test_front_fix_private_prototype_with_an_ownership_attribute() {
    expect_fixed("module m;\n[[std::returns_internal]] const char *message(I32 code);\n",
                 "@returns_internal extern fn message(code: i32) -> *char\n");
}

// #2648: a `Result` declared in today's form and tested at once is `ok := try ...`, not the guard `if .error(error)
// := e:` the checker wrote in the same pass, which left `ok` unreachable in big files (lex.smith's `exponent`).
export void test_front_fix_old_result_declaration_is_a_try() {
    expect_fixed("module m;\nstatic Result(Usize, Usize) f(Usize a) {\n    return {.ok = a};\n}\n"
                 "static Result(Usize, Usize) g(Usize a) {\n    Result(Usize, Usize) e = f(a);\n"
                 "    if (e == .error) return {.error = e.error};\n    Usize after = e.ok;\n"
                 "    return {.ok = after + 1};\n}\n",
                 "fn f(a: usize) -> Result(usize, usize):\n    return .ok(a)\n"
                 "fn g(a: usize) -> Result(usize, usize):\n    ok := try f(a)\n"
                 "    after: usize = ok\n    return .ok(after + 1)\n");
}

// #3027: a read `e.ok` inside `countof(...)` is `ok` inside the parentheses: the parentheses are the query's, and the
// operand's span covered them (`countofok`).
export void test_front_fix_try_read_in_countof_keeps_the_parentheses() {
    expect_fixed("module m;\nstatic Result(Str, Usize) f(Usize a) {\n    return {.error = a};\n}\n"
                 "static Result(Str, Usize) g(Usize a) {\n    Result(Str, Usize) e = f(a);\n"
                 "    if (e == .error) return {.error = e.error};\n    Usize n = countof(e.ok);\n"
                 "    return {.ok = e.ok[0:n]};\n}\n",
                 "fn f(a: usize) -> Result(str, usize):\n    return .error(a)\n"
                 "fn g(a: usize) -> Result(str, usize):\n    ok := try f(a)\n"
                 "    n: usize = countof(ok)\n    return .ok(ok[0:n])\n");
}

// #2648: holding the `try` guard back in the first pass must not hold back the other guards: a file with old forms
// still gets `.v(v) := k else:` for a test that leaves (front/fix_opaque.smith, fix_typeof.smith).
export void test_front_fix_leaving_variant_test_is_a_binding_in_a_file_with_old_forms() {
    expect_fixed("module m;\nexport struct Func { Usize params; };\nexport typedef enum {\n    Func function;\n    "
                 "leaf;\n} Kind;\n"
                 "static Usize c(Kind k) {\n    if (k != .function) return 0;\n    return k.function.params;\n}\n",
                 "pub struct Func:\n    pub params: usize\npub enum Kind:\n    function: Func\n    leaf\n"
                 "fn c(k: Kind) -> usize:\n    .function(function) := k else:\n        return 0\n"
                 "    return function.params\n");
}

// #2648: the reads after `k != .v || k.v.f` all name the binding (`member.name`), whatever else the file mends first.
export void test_front_fix_leaving_or_chain_binds_every_later_read() {
    expect_fixed(
        "module m;\nexport struct Mem { Bool arrow; Usize name; };\nexport typedef enum {\n    Mem member;\n    "
        "leaf;\n} Kind;\n"
        "static Bool a(Kind k) {\n    if (k != .member || k.member.arrow) return false;\n"
        "    if (k.member.name == 3) return false;\n    return true;\n}\n",
        "pub struct Mem:\n    pub arrow: bool\n    pub name: usize\npub enum Kind:\n    member: Mem\n    leaf\n"
        "fn a(k: Kind) -> bool:\n    .member(member) := k else:\n        return false\n    \n"
        "    if member.arrow:\n        return false\n    if member.name == 3:\n        return false\n    return "
        "true\n");
}

// #2647: a second test on a nested field, after the first one became a binding, is a binding too: the rest of the
// block after `.v(x) := k else:` is a block of no span, and its statements still know where it ends.
export void test_front_fix_leaving_variant_tests_one_after_the_other_are_each_a_binding() {
    expect_fixed("module m;\nexport struct Holder;\nexport struct Pair { Holder *left; };\n"
                 "export struct Holder { Kind kind; };\nexport typedef enum {\n    Pair pair;\n    Usize integer;\n"
                 "    leaf;\n} Kind;\n"
                 "static Usize f(Holder *h) {\n    if (h->kind != .pair) return 0;\n"
                 "    if (h->kind.pair.left->kind != .integer) return 0;\n"
                 "    return h->kind.pair.left->kind.integer;\n}\n",
                 "pub struct Holder\npub struct Pair:\n    pub left: *Holder\npub struct Holder:\n    pub kind: Kind\n"
                 "pub enum Kind:\n    pair: Pair\n    integer: usize\n    leaf\n"
                 "fn f(h: *Holder) -> usize:\n    .pair(pair) := h.kind else:\n        return 0\n"
                 "    .integer(integer) := pair.left.kind else:\n        return 0\n    return integer\n");
}

// A field named `type` is `ty` even when the text has a `ty` of its own, as the uses of it from another file are
// (#2648): `Signature.type` was `ty_` while `sig->type` was `ty`.
export void test_front_fix_field_named_type_is_ty_beside_a_ty_of_the_texts_own() {
    expect_fixed(
        "module m;\nexport struct Sig {\n    Usize function;\n    Usize type;\n};\n"
        "static Usize f(Sig *sig, Usize ty) {\n    sig->type = ty;\n    return sig->type;\n}\n",
        "pub struct Sig:\n    pub function: usize\n    pub ty: usize\nfn f(sig: *mut Sig, ty: usize) -> usize:\n"
        "    sig.ty = ty\n    return sig.ty\n");
}

// `f(x)->type = v` is a field written through a call's result, not the `-> type` of a function head (#2648).
export void test_front_fix_field_named_type_after_a_call_is_ty() {
    expect_fixed("module m;\nstruct S {\n    Usize type;\n};\nS *find(Usize n) {\n    return nullptr;\n}\n"
                 "static void f(Usize n, Usize type) {\n    find(n)->type = type;\n}\n",
                 "struct S:\n    ty: usize\nfn find(n: usize) -> *mut S:\n    return nullptr\nfn f(n: usize, ty: "
                 "usize):\n    find(n).ty = ty\n");
}

// A type compared with `==` is the C type itself: `char *` is `*mut char`, `const char *` is `*char` (#3027).
export void test_front_fix_a_compared_pointer_type_keeps_its_mut() {
    expect_fixed("module m;\nvoid f(auto x) {\n    if constexpr (typeof(x) == char * || typeof(x) == const char *) {\n"
                 "        g(x);\n    }\n}\n",
                 "fn f(x: auto):\n    if typeof(x) == *mut char or typeof(x) == *char:\n        g(x)\n");
}

// Two local type values in a row are both written `const` (#3027): the fix of each held an empty insertion at 0 for a
// `constexpr` it had not recorded, the second collided with the first, and a later pass left `constexpr const b: type`.
export void test_front_fix_two_local_type_values_in_a_row() {
    expect_fixed(
        "module m;\nI32 f() {\n    constexpr Type a = I32;\n    constexpr Type b = typeof(f);\n    return 0;\n}\n",
        "fn f() -> i32:\n    const a = i32\n    const b = typeof(f)\n    return 0\n");
}

// A slice of a local type value is the slice type, `[]wide` (#3027, generic-slice-type-argument).
export void test_front_fix_a_slice_of_a_type_value_is_a_slice_type() {
    expect_fixed(
        "module m;\nI32 f() {\n    constexpr Type wide = U16;\n    constexpr Type other = wide[:];\n    return 0;\n}\n",
        "fn f() -> i32:\n    const wide = u16\n    const other = []wide\n    return 0\n");
}

// A field that holds a type, `constexpr Type of;`, is `of: type`; a struct with one is a compile-time value (the lead,
// #3027; tests/smith-lang/cases/type-value).
export void test_front_fix_a_field_that_holds_a_type() {
    expect_fixed("module m;\ntypedef struct {\n    char name[16];\n    constexpr Type of;\n} Field;\n",
                 "struct Field:\n    name: [16]char\n    of: type\n");
}

// A generic function's pointer parameter with no `const` is `*mut T`: its body is checked only in an instance, so the
// checker's `*mut` fix never reaches its own file (#3027: std.arena's `push` handed `arena` on to `push_raw`).
export void test_front_fix_a_generic_pointer_parameter_is_writable() {
    expect_fixed("module m;\nexport T *push(Arena *arena, const Arena *seen, constexpr Type T) {\n"
                 "    return (T *)raw(arena);\n}\n",
                 "pub fn push(arena: *mut Arena, seen: *Arena, T: type) -> *mut T:\n"
                 "    return raw(arena).cast(*mut T)\n");
}

// A pointer type as an argument keeps its stars in front, built-in or named (#3027, type-function-pointee): read as
// dereferences in the next pass, `F64 *` became `f64.*` and `Pair **` became `*Pair.*`.
export void test_front_fix_a_pointer_type_argument_is_a_type() {
    expect_fixed("module m;\nstruct Pair { I32 a; };\nconstexpr Type id(constexpr Type T) { return T; }\n"
                 "Usize f(void) { return sizeof(id(F64 *)) + sizeof(id(Pair **)) + sizeof(id(Pair *)); }\n",
                 "struct Pair:\n    a: i32\nfn id(T: type) -> type:\n    return T\n"
                 "fn f() -> usize:\n    return sizeof(id(*f64)) + sizeof(id(**Pair)) + sizeof(id(*Pair))\n");
}

// `return {.some = v}` in a generic function whose result is an option is `.some(v)` (#3027, generic-option-slice-of):
// the checker's fix comes from an instance in an importer, which the function's own file never sees.
export void test_front_fix_an_option_list_in_a_generic_is_the_variant() {
    expect_fixed(
        "module m;\nexport Option(T *) first(constexpr Type T, T *xs, Usize n) {\n    if (n == 0) return .none;\n"
        "    return {.some = xs};\n}\n",
        "pub fn first(T: type, xs: *mut T, n: usize) -> Option(*T):\n    if n == 0:\n        return .none\n"
        "    return .some(xs)\n");
}

// An array whose length comes from its list (#3316): `I32 xs[] = {..}` is `xs: [3]i32 = [..]`, the count of the items
// written into the type (the same fix as `xs[_]`). A string initializer (`char s[] = "..."`), a `constexpr` one and a
// two-dimension one keep the warning: the type of a string array is not settled.
export void test_front_fix_unsized_array_local() {
    expect_fixed("module m;\nI32 f() {\n    I32 xs[] = {4, 8, 15};\n    return (I32)countof(xs);\n}\n",
                 "fn f() -> i32:\n    xs: [3]i32 = [4, 8, 15]\n    return (countof(xs)).to(i32)\n");
}

export void test_front_fix_unsized_array_global() {
    expect_fixed("module m;\nU8 table[] = {1, 2};\n", "mut table: [2]u8 = [1, 2]\n");
}

export void test_front_fix_unsized_array_of_structs() {
    expect_fixed("module m;\nstruct P {\n    I32 x;\n    I32 y;\n};\nvoid f() {\n    P ps[] = {{1, 2}, {3, 4}};\n}\n",
                 "struct P:\n    x: i32\n    y: i32\nfn f():\n    ps: [_]P = [P(1, 2), P(3, 4)]\n");
}
