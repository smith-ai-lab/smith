// Tests of the whole-tree variant rename (#2098, part of #2053): a variant declared in one file and used in another is
// lowercase in both, bare uses get the leading dot, a qualified use does not, and a name that is also a struct stays.
module front_fix_variants_test;

import front::fix_variants;
import std::arena;
import std::mem;
import std::test;

static fix_variants::Word word(Str text) {
    return (fix_variants::Word){.text = text};
}

static void expect_snake(Str name, Str want) {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    test::check_equal(fix_variants::snake(name), want);
}

export void test_front_fix_variants_snake_case() {
    expect_snake("NotFound", "not_found");
    expect_snake("Other", "other");
    expect_snake("IOError", "io_error");
    expect_snake("Default", "default_");
}

export void test_front_fix_variants_declaration_and_uses_in_two_files() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str one = "enum Error {\n    NotFound\n    Refused\n}\n\nfn find() -> Error {\n    return NotFound\n}\n";
    Str two = "fn same(e: files.Error) -> bool {\n    return e == files.NotFound\n}\n";
    fix_variants::Word sources[2] = {word(one), word(two)};
    fix_variants::Words out = fix_variants::rename_all(sources);
    Str want_one = "enum Error {\n    not_found\n    refused\n}\n\nfn find() -> Error {\n    return .not_found\n}\n";
    Str want_two = "fn same(e: files.Error) -> bool {\n    return e == files.not_found\n}\n";
    test::check_equal(out[0].text, want_one);
    test::check_equal(out[1].text, want_two);
}

export void test_front_fix_variants_colon_body_and_attribute() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str one = "enum Mode:\n    @c_name(\"X\") Replace\n    Append\n\nfn m() -> Mode:\n    return Append\n";
    fix_variants::Word sources[1] = {word(one)};
    fix_variants::Words out = fix_variants::rename_all(sources);
    Str want = "enum Mode:\n    @c_name(\"X\") replace\n    append\n\nfn m() -> Mode:\n    return .append\n";
    test::check_equal(out[0].text, want);
}

export void test_front_fix_variants_a_name_that_is_a_struct_stays() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str one = "struct Point {\n    x: i32\n}\nenum Kind {\n    Point\n    Line\n}\n";
    fix_variants::Word sources[1] = {word(one)};
    fix_variants::Words out = fix_variants::rename_all(sources);
    Str want = "struct Point {\n    x: i32\n}\nenum Kind {\n    Point\n    line\n}\n";
    test::check_equal(out[0].text, want);
}

// `T some;` names the payload type first: the type `T` is no variant, so a use of `T` is not renamed (#2224).
export void test_front_fix_variants_payload_type_is_no_variant() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str one = "fn Option(T: type) -> type {\n    return enum {\n        T some;\n        none;\n    };\n}\n";
    fix_variants::Word sources[1] = {word(one)};
    fix_variants::Words out = fix_variants::rename_all(sources);
    Str want = one;
    test::check_equal(out[0].text, want);
}

export void test_front_fix_variants_qualified_payload_type_is_no_variant() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    // The last payload of an enum is a qualified type that ends the text (#2400).
    Str one = "enum Node:\n    decl: *ast.Decl\n    ty: *ast.TypeExpr\n";
    fix_variants::Word sources[1] = {word(one)};
    fix_variants::Words out = fix_variants::rename_all(sources);
    test::check_equal(out[0].text, one);
    Str two = "enum Node {\n    ast::Decl *decl;\n    ast::TypeExpr *type;\n}\n";
    fix_variants::Word more[1] = {word(two)};
    test::check_equal(fix_variants::rename_all(more)[0].text, two);
}

// #2648: `enum:` with a payload variant `some: T` on the line below has two colons, like `enum End : u8:`, and the type
// `T` was taken for a variant and written `.t` (lib/std/option.smith).
export void test_front_fix_variants_payload_type_below_enum_colon_is_no_variant() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "pub fn Option(T: type) -> type:\n    enum:\n        some: T\n        none\n";
    fix_variants::Found found = fix_variants::collect(source);
    test::check_equal(countof(found.names), (Usize)0);
}

// A file fixed alone (the count fixes each by itself) names the variants of a module it imports, still in today's
// syntax: `.Closed` is `.closed`, as the module declares it once fixed, and the module's text is not written (#3027).
export void test_front_fix_variants_of_an_imported_module_in_todays_syntax() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str console = "// Why the console failed.\nexport typedef enum {\n    Closed, // gone\n    Full,\n} Error;\n";
    Str user = "fn f() -> bool:\n    return is_error(console.print(\"x\"), .Closed)\n";
    fix_variants::Word sources[1] = {word(user)};
    fix_variants::Word imported[1] = {word(console)};
    fix_variants::Words out = fix_variants::rename_all_with(sources, imported);
    test::check_equal(countof(out), (Usize)1);
    Str want = "fn f() -> bool:\n    return is_error(console.print(\"x\"), .closed)\n";
    test::check_equal(out[0].text, want);
}

// One imported module names a type as another names a variant: process's `typedef struct {...} Output;` and console's
// `Stream` variant `Output`. Used as a type (a declaration, a pointer, a compound literal, a type argument) the name
// stays; used as a value, even as a call's one argument, it is the variant (#3027:
// tests/build_fixtures/runner_checked/tests/test_checked_process.smith became `output: process.output`).
export void test_front_fix_variants_a_type_named_like_an_imported_variant_stays() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str console = "export typedef enum {\n    Input,\n    Output,\n} Stream;\n";
    Str user = "void f(void) {\n    process::Output output = done.ok;\n    Output *o = &output;\n"
               "    Result(Output, Error) r = (Output){};\n    g(console::is_terminal(console::Output));\n}\n";
    fix_variants::Word sources[1] = {word(user)};
    fix_variants::Word imported[1] = {word(console)};
    fix_variants::Words out = fix_variants::rename_all_with(sources, imported);
    Str want = "void f(void) {\n    process::Output output = done.ok;\n    Output *o = &output;\n"
               "    Result(Output, Error) r = (Output){};\n    g(console::is_terminal(console::output));\n}\n";
    test::check_equal(out[0].text, want);
}

// The same in the new syntax, which the rename reads once a file is mended: a declared name's type, a parameter, a
// field, a result and an element type stay; a value after `if c:`, after `=` or in a ternary of today's syntax is the
// variant.
export void test_front_fix_variants_a_type_named_like_an_imported_variant_stays_in_new_syntax() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str console = "export typedef enum {\n    Input,\n    Output,\n} Stream;\n";
    Str user = "struct Run:\n    out: process.Output\n\nfn f(mut a: process.Output, b: []Output) -> Output:\n"
               "    output: process.Output = ok\n    s: console.Stream = if c: console.Output else: console.Input\n"
               "    t: console.Stream = console.Output\n    return a\n";
    Str ternary = "I32 g(void) {\n    return k(c ? console::Output : console::Input);\n}\n";
    fix_variants::Word sources[2] = {word(user), word(ternary)};
    fix_variants::Word imported[1] = {word(console)};
    fix_variants::Words out = fix_variants::rename_all_with(sources, imported);
    Str want = "struct Run:\n    out: process.Output\n\nfn f(mut a: process.Output, b: []Output) -> Output:\n"
               "    output: process.Output = ok\n    s: console.Stream = if c: console.output else: console.input\n"
               "    t: console.Stream = console.output\n    return a\n";
    test::check_equal(out[0].text, want);
    Str want_ternary = "I32 g(void) {\n    return k(c ? console::output : console::input);\n}\n";
    test::check_equal(out[1].text, want_ternary);
}

// A file fixed alone spells an enumerator of an imported module as that module's enum declares it (#3084): `Replace` is
// `replace` in a call and in a `switch` arm (the arm still names a variant of the enumeration, so the match stays
// exhaustive), and a C enumerator the file reads through `c::` keeps its C spelling.
export void test_front_fix_variants_a_switch_arm_and_a_call_of_an_imported_enum() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str files = "export typedef enum {\n    Replace, // creates the file\n    Read,\n    Append,\n} Mode;\n";
    Str user = "fn f(mode: files.Mode) -> i32:\n    match mode:\n        files.Replace: return 1\n"
               "        .Read: return 2\n        _: return c.O_RDONLY\n"
               "fn g():\n    write(files.Append, c.O_RDONLY)\n";
    fix_variants::Word sources[1] = {word(user)};
    fix_variants::Word imported[1] = {word(files)};
    fix_variants::Words out = fix_variants::rename_all_with(sources, imported);
    Str want = "fn f(mode: files.Mode) -> i32:\n    match mode:\n        files.replace: return 1\n"
               "        .read: return 2\n        _: return c.O_RDONLY\n"
               "fn g():\n    write(files.append, c.O_RDONLY)\n";
    test::check_equal(out[0].text, want);
}
