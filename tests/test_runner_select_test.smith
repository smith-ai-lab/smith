// `--test` of the test runner and of `smith test` (#1156): a test file's path, a bare file name exactly, `file::test`,
// a comma list, `*` for a substring, and the closest test files when nothing matches. The fixture
// tests/build_fixtures/runner_shard has the test files shard::alpha_test (3 tests), beta_test, gamma_test, delta_test.
module test_runner_select_test;

import std::arena;
import std::mem;
import std::test;
import runner;
import scratch;

static const char *listed(const scratch::Project *p, const char *selector) {
    return scratch::capture(p, selector);
}

export void test_runner_select_a_name_is_a_file_exactly() {
    scratch::Project p = runner::built_project("runner_base", "runner_shard", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::expect_text("select: a file name", "3",
                         listed(&p, "build/tests --list --test alpha_test | wc -l | tr -d ' '"));
    scratch::expect_text("select: not a substring of it", "0",
                         listed(&p, "build/tests --list --test alpha | wc -l | tr -d ' '"));
    scratch::expect_text("select: a * is a substring", "3",
                         listed(&p, "build/tests --list --test 'alph*' | wc -l | tr -d ' '"));
    scratch::expect_text("select: file::test is one test", "shard::gamma_test::gamma_1",
                         listed(&p, "build/tests --list --test gamma_test::gamma_1"));
    scratch::expect_text("select: a list adds up", "5",
                         listed(&p, "build/tests --list --test alpha_test,beta_test | wc -l | tr -d ' '"));
    scratch::expect_text("select: repeated --test adds up", "5",
                         listed(&p, "build/tests --list --test alpha_test --test beta_test | wc -l | tr -d ' '"));
}

export void test_runner_select_a_path_is_a_file() {
    scratch::Project p = runner::built_project("runner_base", "runner_shard", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::expect_text("select: a path", "3",
                         listed(&p, "smith test --test tests/shard/alpha_test.smith --list 2>/dev/null | grep -c "
                                    "'^shard::alpha_test::alpha_[0-9]$'"));
    scratch::expect_text("select: a path with ./ and a name", "3",
                         listed(&p, "smith test --test ./tests/shard/beta_test.smith,gamma_test --list 2>/dev/null | "
                                    "grep -Ec '^shard::(beta|gamma)_test::[a-z]+_[12]$'"));
}

export void test_runner_select_no_match_lists_the_closest_files() {
    scratch::Project p = runner::built_project("runner_base", "runner_shard", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = runner::tests(&p, "", "--test alpha_tes");
    scratch::expect_contains("select: the message", run.out, "no test matches \"alpha_tes\"");
    scratch::expect_contains("select: the closest file", run.out, "closest test files: alpha_test");
    scratch::expect_contains("select: what works", run.out, "a test file's path");
}
