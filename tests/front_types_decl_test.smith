// Tests of front::types_decl (#1220, J1d): declarations, statements, calls and `Fn` values, checked over source text
// read by front::parser. Each scenario builds in an arena it sets as the current allocator. One test per error
// message, each checking that the message names the expected type and what to write; goldens of the typed dump for the
// five use cases of the ticket are in tests/front/types/ (rewritten with the runner's `--update`).
module front_types_decl_test;

import front::ast;
import front::lex;
import front::parse;
import front::parse_decl;
import front::parse_expr;
import front::parse_stmt;
import front::parse_type;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::ascii;
import std::files;
import std::format;
import std::mem;
import std::test;

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        Bool same = true;
        for (Usize k = 0; k < countof(needle); k++) {
            if (text[i + k] != needle[k]) {
                same = false;
                break;
            }
        }
        if (same) return true;
    }
    return false;
}

static Str join(Str a, Str b) {
    char out[:] = mem::alloc_slice(char, countof(a) + countof(b));
    for (Usize i = 0; i < countof(a); i++) {
        out[i] = a[i];
    }
    for (Usize i = 0; i < countof(b); i++) {
        out[countof(a) + i] = b[i];
    }
    return out;
}

// Whether `check_text` reads smith's own syntax (the tests of #1510 set it).
static Bool reading_new = false;

static types::Checked check_text(Str source) {
    parser::Parsed p = reading_new ? parser::parse_new("t.smith", source) : parser::parse("t.smith", source);
    test::check_equal(countof(p.errors), (Usize)0);
    return types_decl::check_module(&p.module, types::lp64());
}

// The errors, one per line.
static Str errors_of(const types::Checked *r) {
    Str text = "";
    for (Usize i = 0; i < r->error_count; i++) {
        text = join(text, join(r->errors[i].message, "\n"));
    }
    return text;
}

// `source` checks with no error.
static void clean(Str source) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_text(source);
    Str errors = errors_of(&r);
    test::check_equal(r.error_count, (Usize)0);
    test::check_condition(has(errors, ""));
}

// `source` gives exactly one error, which says `first` and `second`.
static void fails(Str source, Str first, Str second) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_text(source);
    Str errors = errors_of(&r);
    test::check_equal(r.error_count, (Usize)1);
    test::check_condition(has(errors, first));
    test::check_condition(has(errors, second));
}

// The golden: the module's names, the locals and the errors.
static void golden(Str path, Str source) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_text(source);
    test::golden(path, join(types_decl::locals_dump(), types::dump(&r)));
}

// How many casts of the module the checker marked for a run-time check, through `types::cast_checked`.
static Usize checked_casts(const types::Checked *r) {
    Usize n = 0;
    for (Usize i = 0; i < countof(r->nodes); i++) {
        if (r->nodes[i].node == nullptr) continue;
        types::CastCheck cc = types::cast_checked(r, r->nodes[i].node);
        if (cc.needed) {
            test::check_condition(cc.from != nullptr);
            test::check_condition(cc.to == r->nodes[i].type);
            n += 1;
        }
    }
    return n;
}

static void casts(Str source, Usize want) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_text(source);
    test::check_equal(r.error_count, (Usize)0);
    test::check_equal(checked_casts(&r), want);
}

// `to`, `wrap` and `cast` (#1811): `to` traps on a narrowing, `wrap` keeps the low bits and never traps, `cast` is for
// pointers.
export void test_front_types_decl_to_is_checked_wrap_is_not_and_cast_takes_a_pointer() {
    casts("U8 a(I32 x) { return x.to(U8); }", 1);
    casts("U8 a(I32 x) { return x.wrap(U8); }", 0);
    casts("I64 a(I32 x) { return x.to(I64); }", 0);
    casts("I64 a(I32 x) { return x.wrap(I64); }", 0);
    casts("F64 a(I32 x) { return x.to(F64); }", 0);
    casts("U8 *a(I32 *p) { return p.cast(U8 *); }", 0);
    casts("Usize a(I32 *p) { return p.to(Usize); }", 0);
    fails("F64 a(I32 x) { return x.wrap(F64); }", "`wrap`", "integer");
    fails("I32 a(F64 x) { return x.wrap(I32); }", "`wrap`", "integer");
    fails("I32 a(I64 x) { return x.cast(I32); }", "`cast`", "pointer");
}

export void test_front_types_decl_casts_that_can_lose_a_value_are_marked_checked() {
    casts("U8 a(I32 x) { return (U8)x; }", 1);
    casts("U32 a(I32 x) { return (U32)x; }", 1);
    casts("I32 a(F64 x) { return (I32)x; }", 1);
    casts("I32 a(I64 x, I64 y) { return (I32)x + (I32)y; }", 2);
    casts("I64 a(I32 x) { return (I64)x; }", 0);
    casts("U8 a() { return (U8)200; }", 0);
    casts("F64 a(I32 x) { return (F64)x; }", 0);
    casts("U32 a(U8 x) { return (U32)x; }", 0);
    casts("F32 a(I64 x) { return (F32)x; }", 0);
    casts("F64 a(I32 x) { return x; }", 0);
    casts("Str a(U8 xs[:]) { return (Str)xs; }", 0);
}

export void test_front_types_decl_a_refused_cast_and_the_decided_implicit_rules_report() {
    fails("I32 f(I32 *p) { return (I32)p; }", "expected I32", "cast through Usize");
    fails("F64 x = 1;\nF32 y = 16777217;", "16777217 is not exactly an F32", "write a conversion");
    clean("F64 x = 0;");
    fails("F32 a(I32 x) { return x; }", "found I32", "write a conversion: x.to(F32)");
    fails("Str a(U8 xs[:]) { return xs; }", "found U8[:]", "xs.to(Str)");
    fails("U8 a() { return (U8)300; }", "300 does not fit U8", "wrapping::to(U8, x)");
    fails("U32 a() { return (U32)-1; }", "-1 does not fit U32", "wrapping::to(U32, x)");
    fails("I32 a() { return (I32)1e30; }", "does not fit I32", "wrapping::to(I32, x)");
    clean("U8 a() { return (U8)200.5; }");
    fails("I32 xs[3];\nI32 *p = xs;", "expected I32 *", "&xs[0]");
}

// ---------------------------------------------------------------------------------------------------------------
// The five use cases

// lib/std/ascii.smith spelled as the new checker reads it: a copy in memory with the word `char` written `Char`
// (the N1 rewrite does this to the file itself; until then the checker accepts only `Char`).
static Str use_ascii() {
    files::BytesResult read = files::read_file("lib/std/ascii.smith");
    if (read == .error) return "";
    format::Chars text = mem::view(read.ok, char);
    Str source = text;
    Str copy = "";
    Usize start = 0;
    for (Usize i = 0; i + 4 <= countof(source); i++) {
        Bool word = source[i] == 'c' && source[i + 1] == 'h' && source[i + 2] == 'a' && source[i + 3] == 'r';
        Bool alone =
            (i == 0 || !ascii::alpha(source[i - 1])) && (i + 4 == countof(source) || !ascii::alpha(source[i + 4]));
        if (word && alone) {
            copy = join(join(copy, source[start:i]), "Char");
            start = i + 4;
        }
    }
    return join(copy, source[start:countof(source)]);
}

export void test_front_types_decl_char_and_bool_are_errors_naming_the_smith_type() {
    fails("char c = 'a';", "`char` is a C type", "write `Char`");
    fails("bool b = true;", "`bool` is a C type", "write `Bool`");
    clean("Char c = 'a';");
    fails("Str s = \"a\";\nconst Char xs[:] = s;\nChar *p = xs;", "expected Char *", "found const Char[:]");
}

export void test_front_types_decl_a_character_literal_has_type_char() {
    clean("Char c = 'a';\nU32 wide = 'a';\nChar d = c;");
}

export void test_front_types_decl_the_ascii_module_checks_clean() {
    Str source = use_ascii();
    test::check_condition(countof(source) > 0);
    clean(source);
}

export void test_front_types_decl_a_function_returns_its_result_type() {
    clean("I32 f(I32 a) { return a + 1; }");
}

export void test_front_types_decl_a_return_of_the_wrong_type_names_both() {
    fails("I32 f(Str s) { return s; }", "expected I32", "found Str");
}

export void test_front_types_decl_a_literal_that_does_not_fit_is_refused() {
    fails("U8 big = 300;", "300 does not fit U8", "wider type");
}

export void test_front_types_decl_a_lambda_takes_its_parameter_types_from_fn() {
    clean("Bool apply(Fn(Bool (I32, I32)) cmp) { return cmp(1, 2); }\n"
          "Bool run() { return apply([](I32 a, I32 b) { return a < b; }); }");
}

export void test_front_types_decl_a_value_converts_to_some_but_option_is_not_a_value() {
    clean("Option(I32) x = 3;");
    fails("Option(I32) x = 3;\nI32 y = x;", "expected I32", "Option(I32)");
}

export void test_front_types_decl_golden_of_the_use_cases() {
    golden("tests/front/types/decl_returns.txt",
           "I32 f(I32 a) { I32 b = a + 1; return b; }\nI32 g(Str s) { return s; }\nU8 big = 300;");
    golden("tests/front/types/decl_lambda.txt", "Bool apply(Fn(Bool (I32, I32)) cmp) { return cmp(1, 2); }\n"
                                                "Bool run() { return apply([](I32 a, I32 b) { return a < b; }); }");
    golden("tests/front/types/decl_option.txt", "Option(I32) x = 3;\nI32 f() { I32 y = x; return y; }");
    golden("tests/front/types/decl_ascii.txt", use_ascii());
}

// ---------------------------------------------------------------------------------------------------------------
// Statements and locals

export void test_front_types_decl_locals_scopes_and_loops_check() {
    clean("I32 sum(const I32 *xs, I32 n) {\n"
          "    I32 total = 0;\n"
          "    for (I32 i = 0; i < n; i++) { total += xs[i]; }\n"
          "    while (total > 100) { total -= 100; }\n"
          "    if (total == 0) { return 1; } else { return total; }\n"
          "}\n"
          "Void g() { Auto n = 5; { I32 n = 2; } return; }");
}

export void test_front_types_decl_a_condition_that_is_not_bool_says_to_compare() {
    fails("Void f(I32 n) { if (n) { return; } }", "expected Bool", "found I32");
}

export void test_front_types_decl_a_bare_return_in_a_function_with_a_result() {
    fails("I32 f() { return; }", "expected `I32`, found `Void`", "return value;");
}

export void test_front_types_decl_a_value_returned_from_a_void_function() {
    fails("Void f() { return 1; }", "returns `Void`", "result type");
}

export void test_front_types_decl_auto_without_a_value() {
    fails("Void f() { Auto x; }", "`x` needs a value", "= undefined");
}

export void test_front_types_decl_auto_from_null() {
    fails("Void f() { Auto p = nullptr; }", "`nullptr` has no type of its own", "U8 *p = nullptr;");
}

export void test_front_types_decl_a_name_declared_twice_in_a_scope() {
    fails("Void f() { I32 a = 1; I32 a = 2; }", "`a` is already declared", "another name");
}

export void test_front_types_decl_a_parameter_declared_twice() {
    fails("Void f(I32 a, I32 a) { }", "`a` is already declared in `f`", "another name");
}

export void test_front_types_decl_a_lambda_parameter_declared_twice() {
    fails("Void f() { Fn(Void (I32, I32)) g = [](I32 a, I32 a) { }; }", "`a` is already declared in this lambda",
          "another name");
}

export void test_front_types_decl_a_c_name_is_not_yet_typed() {
    fails("Void f() { c::exit(1); }", "not yet typed: c:: name `c::exit`", "");
}

export void test_front_types_decl_static_assert_in_a_body_checks_its_condition() {
    clean("Void f() { static_assert(true); }");
    fails("Void f() { static_assert(1); }", "", "");
}

export void test_front_types_decl_if_constexpr_in_a_body_is_not_yet_typed() {
    fails("Void f() { if constexpr (true) { return; } }", "not yet typed: if constexpr in a body", "");
}

export void test_front_types_decl_for_constexpr_is_not_yet_typed() {
    fails("Void f() { for constexpr (I32 i = 0; i < 2; i++) { } }", "not yet typed: for constexpr", "");
}

export void test_front_types_decl_a_range_for_is_not_yet_typed() {
    fails("Void f(I32 xs[:]) { for (I32 x : xs) { } }", "not yet typed: a range for", "");
}

export void test_front_types_decl_a_type_declared_in_a_function_is_not_yet_typed() {
    fails("Void f() { struct P { I32 x; }; }", "not yet typed: a type or function declared inside a function", "");
}

export void test_front_types_decl_show_keeps_const_on_slice_and_array_elements() {
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Table t = types::start(types::lp64());
    types::TypeRef byte = types::builtin(&t, "U8");
    test::check_condition(has(types::show(types::slice_of(&t, byte, true)), "const U8[:]"));
    test::check_condition(has(types::show(types::array_of(&t, byte, 3, true)), "const U8[3]"));
}

// #1510 (C1, part 1): a `const` is known at compile time (spec "Modules and declarations"). The bindings of smith's own
// syntax are module-level: the statement parser does not read `:=` in a body yet.
export void test_front_types_decl_const_of_constants_is_accepted() {
    reading_new = true;
    clean("const a = 3\nconst b = a\nconst f = 2.5\n");
    reading_new = false;
}

export void test_front_types_decl_const_of_a_variable_is_refused() {
    reading_new = true;
    fails("let mut n = 3\nconst a = n\n", "`const a` is known at compile time", "without `const`");
    reading_new = false;
}

export void test_front_types_decl_local_constexpr_of_a_variable_is_refused() {
    fails("Void g() { I32 n = 3; constexpr auto a = n + 1; }", "`const a` is known at compile time", "");
    clean("Void g() { constexpr auto a = 3; constexpr auto b = a * 2; }");
}

// #1510 (C1, part 2): in smith's own syntax a name may not shadow another, `let _ = f()` discards a result, and an
// unused result of a call is an error. Bodies are read by the statement parser of #1527.
export void test_front_types_decl_shadowing_is_refused() {
    reading_new = true;
    fails("fn g():\n    let a = 1\n    if true:\n        let a = 2\n", "`a` hides the `a` declared at byte",
          "choose another name");
    fails("fn g(x: i32):\n    let x = 2\n", "`x` hides", "shadowing is an error");
    clean("fn g():\n    if true:\n        let a = 1\n    if true:\n        let a = 2\n");
    reading_new = false;
}

export void test_front_types_decl_an_old_local_may_shadow() {
    clean("Void g() { I32 a = 1; { I32 a = 2; } }");
}

// (A parameter in `f`, so that its result `i32` is read in smith's own syntax: a function with none is read in
// today's.)
export void test_front_types_decl_a_discard_is_accepted() {
    reading_new = true;
    clean("fn f(x: i32) -> i32:\n    return x\nfn g(x: i32):\n    let _ = f(x)\n");
    clean("fn g(x: i32):\n    let _ = x\n    let _ = x\n");
    reading_new = false;
}

export void test_front_types_decl_an_unused_result_is_refused() {
    reading_new = true;
    fails("fn f(x: i32) -> i32:\n    return x\nfn g(x: i32):\n    f(x)\n", "is not used", "write `let _ = ...`");
    clean("fn f(x: i32):\nfn g(x: i32):\n    f(x)\n");
    reading_new = false;
}

// The last line of a function is its value (#1428), so a call there is used; one before it is not.
export void test_front_types_decl_a_call_on_the_last_line_is_the_result() {
    reading_new = true;
    clean("fn f(x: i32) -> i32:\n    return x\nfn g(x: i32) -> i32:\n    f(x)\n");
    fails("fn f(x: i32) -> i32:\n    return x\nfn g(x: i32) -> i32:\n    f(x)\n    return x\n", "is not used",
          "write `let _ = ...`");
    fails("fn f(x: i32) -> i32:\n    return x\nfn g(x: i32):\n    f(x)\n", "is not used", "write `let _ = ...`");
    reading_new = false;
}

// #1558: `let (q, r) = f()` splits a tuple.
export void test_front_types_decl_destructuring_splits_a_tuple() {
    reading_new = true;
    Str head = "fn divmod(a: i32, b: i32) -> (i32, i32):\n    return (a / b, a % b)\n";
    clean(join(head, "fn g():\n    let (q, r) = divmod(7, 2)\n    let _ = q + r\n"));
    clean(join(head, "fn g():\n    let (q, _) = divmod(7, 2)\n    let _ = q\n"));
    clean(join(head, "fn g():\n    let (mut q, mut r) = divmod(7, 2)\n    q = r\n"));
    clean(join(head, "fn g():\n    let (q, mut r) = divmod(7, 2)\n    r = q\n"));
    fails(join(head, "fn g():\n    let (q, mut r) = divmod(7, 2)\n    q = r\n"), "cannot", "declare it `mut q`");
    fails(join(head, "fn g():\n    let (a, b, c) = divmod(7, 2)\n"), "3 names", "2 elements");
    fails(join(head, "fn g():\n    let (q, r) = divmod(7, 2)\n    q = 1\n"), "cannot", "declare it `mut q`");
    reading_new = false;
}

// #1916: a `switch` over an enumeration is typed (its case bodies in a scope each), `countof` of an `Auto` parameter is
// accepted, and a type passed as a value is `Auto`.
export void test_front_types_decl_a_switch_over_an_enumeration_is_typed() {
    reading_new = false;
    clean("typedef enum { red; green; } Color;\nI32 f(Color c) {\n    switch (c) {\n    case .red: return 1;\n    "
          "default: return 0;\n    }\n}\n");
    clean("I32 g(I32 n) {\n    switch (n) {\n    case 1: { I32 x = 2; return x; }\n    case 2: { I32 x = 3; return x; "
          "}\n    default: return 0;\n    }\n}\n");
    fails("I32 g(I32 n) {\n    switch (n) {\n    case 1: return missing;\n    default: return 0;\n    }\n}\n",
          "missing", "declare");
}

export void test_front_types_decl_a_switch_over_a_payload_enumeration_is_typed() {
    reading_new = false;
    clean("typedef struct { F64 r; } Circle;\ntypedef enum { Circle circle; empty; } Shape;\nF64 area(Shape s) {\n    "
          "switch (s) {\n    case .circle: return 1.0;\n    case .empty: return 0.0;\n    }\n}\n");
}

export void test_front_types_decl_countof_of_an_auto_parameter_is_accepted() {
    reading_new = false;
    clean("Usize count(auto xs[:]) {\n    return countof(xs);\n}\n");
}

// #2227: a bare `_ = x` is an error that says to write `let _ = x`.
export void test_front_types_decl_a_bare_underscore_assignment_is_refused() {
    reading_new = true;
    fails("fn g(x: i32):\n    _ = x\n", "`_`", "write `let _ = x`");
    reading_new = false;
}
