// Tests of the types the checker makes from type expressions (#1918, part of #1902): the applied type `Result(T, E)`.
// Each scenario is source text in smith's own syntax, read by front::parser's hooks and checked by front::types_decl,
// and builds in an arena it sets as the current allocator.
module front_check_types_test;

import front::ast;
import front::lex;
import front::parse;
import front::parse_decl;
import front::parse_expr;
import front::parse_stmt;
import front::parse_type;
import front::parser;
import front::types;
import front::types_convert;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        Bool same = true;
        for (Usize k = 0; k < countof(needle); k++) {
            if (text[i + k] != needle[k]) {
                same = false;
                break;
            }
        }
        if (same) return true;
    }
    return false;
}

static Str join(Str a, Str b) {
    char out[:] = mem::alloc_slice(char, countof(a) + countof(b));
    for (Usize i = 0; i < countof(a); i++) {
        out[i] = a[i];
    }
    for (Usize i = 0; i < countof(b); i++) {
        out[countof(a) + i] = b[i];
    }
    return out;
}

static types::Checked check_text(Str source) {
    parser::Parsed p = parser::parse_new("t.smith", source);
    test::check_equal(countof(p.errors), (Usize)0);
    return types_decl::check_module(&p.module, types::lp64());
}

// The errors, one per line.
static Str errors_of(const types::Checked *r) {
    Str text = "";
    for (Usize i = 0; i < r->error_count; i++) {
        text = join(text, join(r->errors[i].message, "\n"));
    }
    return text;
}

// `source` checks with no error.
static void clean(Str source) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_text(source);
    Str errors = errors_of(&r);
    test::check_equal(r.error_count, (Usize)0);
    test::check_condition(has(errors, ""));
}

// `source` gives exactly one error, which says `first` and `second`.
static void fails(Str source, Str first, Str second) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_text(source);
    Str errors = errors_of(&r);
    test::check_equal(r.error_count, (Usize)1);
    test::check_condition(has(errors, first));
    test::check_condition(has(errors, second));
}
export void test_front_check_types_result_is_an_applied_type() {
    clean("fn f(r: Result(i32, u8)) -> Result(i32, u8):\n    r\n");
}

export void test_front_check_types_result_converts_to_its_value_type() {
    fails("fn f(r: Result(i32, u8)):\n    let n: str = r\n", "Result", "Str");
}

// ---------------------------------------------------------------------------------------------------------------
// Array lengths

// A function whose body declares `let mut buffer: [<length>]u8`, after the constants in `before`.
static Str with_length(Str before, Str length) {
    return join(before, join("fn run():\n    let mut buffer: [", join(length, "]u8 = undefined\n    buffer[0] = 1\n")));
}

export void test_front_check_types_array_length_literal() {
    clean(with_length("", "4"));
}

export void test_front_check_types_array_length_named_constant() {
    clean(with_length("const N = 4\n\n", "N"));
}

export void test_front_check_types_array_length_arithmetic() {
    clean(with_length("const n = 8\n\n", "n + 1"));
    clean(with_length("const n = 8\n\n", "n - 1"));
    clean(with_length("", "1 << 3"));
}

export void test_front_check_types_array_length_in_a_struct_and_a_parameter() {
    clean("const N = 4\n\nstruct Block:\n    bytes: [N]u8\n\nfn first(xs: [N]u8) -> u8:\n    return xs[0]\n");
}

// The fixer writes `.to(usize)` into a constant of another integer type (#2506); that must stay a length (#2579).
export void test_front_check_types_array_length_through_a_to_conversion() {
    clean(with_length("const n: u32 = 8\nconst m: usize = n.to(usize)\n\n", "m"));
    clean(with_length("const n: u32 = 8\n\n", "n.to(usize) + 1"));
}

export void test_front_check_types_array_length_variable_is_refused() {
    fails(with_length("let mut n = 4\n\n", "n"), "an array length must be known at compile time", "`n` is a variable");
}

export void test_front_check_types_array_length_negative_is_refused() {
    fails(with_length("const n = 2\n\n", "n - 3"), "an array length cannot be `-1`", "");
}

export void test_front_check_types_array_length_division_by_zero_is_refused() {
    fails(with_length("", "4 / 0"), "divides by zero at compile time", "");
}

// ---------------------------------------------------------------------------------------------------------------
// typeof of an expression

export void test_front_check_types_typeof_expression_arithmetic() {
    clean("fn f(a: i32, b: i32):\n    let c: typeof(a + b) = a\n    c\n");
}

export void test_front_check_types_typeof_expression_result_type() {
    clean("fn f(a: i64, b: i64) -> typeof(a * b):\n    return a * b\n");
}

export void test_front_check_types_typeof_expression_mismatch_is_reported() {
    fails("fn f(a: i32, b: i32):\n    let c: typeof(a + b) = \"x\"\n    c\n", "I32", "Str");
}

// Anonymous struct and union types (a payload variant): written in today's C-like spelling, which is the only one the
// parser reads for them.

static types::Checked check_c_text(Str source) {
    parser::Parsed p = parser::parse_file("t.smith", source);
    test::check_equal(countof(p.errors), (Usize)0);
    return types_decl::check_module(&p.module, types::lp64());
}

static void c_clean(Str source) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_c_text(source);
    test::check_equal(r.error_count, (Usize)0);
}

static void c_fails(Str source, Str first) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_c_text(source);
    test::check_equal(r.error_count, (Usize)1);
    test::check_condition(has(errors_of(&r), first));
}

export void test_front_check_types_anonymous_struct_as_a_payload() {
    c_clean("typedef enum { struct { i32 a; u8 b; } one; empty } Shape;\n");
}

export void test_front_check_types_anonymous_union_as_a_payload() {
    c_clean("typedef enum { union { u32 word; f32 real; } bits; empty } Shape;\n");
}

export void test_front_check_types_anonymous_struct_repeats_a_field_name() {
    c_fails("typedef enum { struct { i32 a; u8 a; } one; empty } Shape;\n", "the field `a` is declared twice");
}

// ---------------------------------------------------------------------------------------------------------------
// Concepts in today's spelling: `Int` is the concept `int`, so both spellings are one type.

export void test_front_check_types_capitalized_concepts_are_typed() {
    clean("fn f(a: Int, b: Num, c: Signed, d: Unsigned, e: Float, g: Pointer):\n    return\n");
}

export void test_front_check_types_capitalized_concept_is_the_lowercase_one() {
    clean("fn f(a: Int):\n    return\n\nfn g(a: int):\n    return\n");
}

export void test_front_check_types_capitalized_concept_is_no_field_type() {
    fails("struct S:\n    n: Int\n", "concept", "int");
}

export void test_front_check_types_struct_concept_is_not_yet_typed() {
    fails("fn f(a: Struct):\n    return\n", "not yet typed: the concept `Struct`", "");
}

