// Slice aliases and negated float literals (#2186)

export void test_front_check_types_slice_type_alias_parses_and_is_used() {
    clean("let Numbers = []i32\n\nfn first(xs: Numbers) -> i32:\n    xs[0]\n");
}

export void test_front_check_types_array_type_alias_parses() {
    clean("let Four = [4]u8\n\nfn first(xs: Four) -> u8:\n    xs[0]\n");
}

export void test_front_check_types_negative_float_literal_takes_the_type() {
    clean("fn f() -> f32:\n    let x: f32 = -2.0\n    x\n");
}

export void test_front_check_types_negative_float_literal_in_f64() {
    clean("fn f() -> f64:\n    let x: f64 = -2.5\n    x\n");
}

export void test_front_check_types_lambda_parameter_is_a_function_value() {
    c_clean("module m;\nI32 apply(Lambda(I32 (I32)) f, I32 x) {\n    return f(x);\n}\n");
}

export void test_front_check_types_lambda_takes_a_function_type() {
    c_fails("module m;\nI32 apply(Lambda(I32) f) {\n    return 0;\n}\n", "`Lambda` takes a function type");
}

// ---------------------------------------------------------------------------------------------------------------
// type functions

export void test_front_check_types_type_function_ends_in_an_unnamed_enum() {
    clean("pub fn Option(T: type) -> type:\n    enum:\n        some: T\n        none\n");
}

export void test_front_check_types_type_function_ends_in_an_unnamed_struct() {
    clean("pub fn Pair(T: type) -> type:\n    struct:\n        first: T\n        second: T\n");
}

// #3229: a call whose callee is the result of a type function builds a value of that type.
export void test_front_check_types_calling_a_type_function_result_builds_an_enum_value() {
    clean("pub fn Maybe(T: type) -> type:\n    enum:\n        some: T\n        none\n\n"
          "fn wrap(v: usize) -> Maybe(usize):\n    Maybe(usize)(some = v)\n");
}

export void test_front_check_types_calling_a_type_function_result_builds_a_struct_value() {
    clean("pub fn Pair(T: type) -> type:\n    struct:\n        first: T\n        second: T\n\n"
          "fn both(a: i32, b: i32) -> Pair(i32):\n    Pair(i32)(first = a, second = b)\n\n"
          "fn again(a: i32) -> Pair(i32):\n    Pair(i32)(a, a)\n");
}

export void test_front_check_types_a_type_function_applied_twice_gives_one_type() {
    clean("pub fn Pair(T: type) -> type:\n    struct:\n        first: T\n        second: T\n\n"
          "fn one(a: i32) -> Pair(i32):\n    Pair(i32)(a, a)\n\n"
          "fn two(a: i32) -> Pair(i32):\n    p: Pair(i32) = Pair(i32)(a, a)\n    p\n");
}

export void test_front_check_types_a_built_value_checks_its_arguments_against_the_fields() {
    fails("pub fn Pair(T: type) -> type:\n    struct:\n        first: T\n        second: T\n\n"
          "fn bad(a: i32) -> Pair(i32):\n    Pair(i32)(first = a, second = a, third = a)\n",
          "no field `third`", "");
}

export void test_front_check_types_other_declaration_in_a_function_is_not_yet_typed() {
    fails("fn f():\n    enum:\n        a\n        b\n", "not yet typed: a type or function declared inside a function",
          "");
}

// ---------------------------------------------------------------------------------------------------------------
// Ordering on plain enumerations and leading-dot operands (#2480, owner 2026-11-05)

export void test_front_check_types_plain_enum_is_ordered_in_declaration_order() {
    clean("enum Level:\n    low\n    mid\n    high\n\n"
          "fn above(a: Level, b: Level) -> bool:\n    a < b or a <= b or a > b or a >= b\n");
}

export void test_front_check_types_leading_dot_takes_the_type_of_the_other_operand() {
    clean("enum Level:\n    low\n    mid\n    high\n\n"
          "fn in_range(a: Level) -> bool:\n    a >= .mid and a != .high and .low <= a\n");
}

export void test_front_check_types_payload_enum_is_not_ordered() {
    fails("struct Circle:\n    radius: f32\nenum Shape:\n    circle: Circle\n    empty\n\n"
          "fn before(a: Shape, b: Shape) -> bool:\n    a < b\n",
          "<", "number");
}

export void test_front_check_types_tag_test_on_a_payload_enum_with_a_leading_dot() {
    clean("struct Circle:\n    radius: f32\nenum Shape:\n    circle: Circle\n    empty\n\n"
          "fn is_circle(s: Shape) -> bool:\n    s == .circle\n");
}

export void test_front_check_types_a_shifted_literal_takes_the_expected_type() {
    clean("const window: usize = 64 << 10\nfn wide() -> u64:\n    return 1 << 40\n");
}

export void test_front_check_types_a_global_built_from_a_record_has_its_type() {
    clean("struct Format:\n    bits: u32\n\nconst single = Format(24)\n\n"
          "fn width(f: *Format) -> u32:\n    return f.bits\n\nfn single_width() -> u32:\n    return width(&single)\n");
}

export void test_front_check_types_a_member_of_a_cast_pointer_needs_no_arrow() {
    clean("struct Box:\n    size: usize\n\nfn size_of(raw: *u8) -> usize:\n    return (raw.cast(*Box)).size\n");
}

// `&x.inner` of a local handed where a `*mut Inner` is wanted: the error carries the fix that writes `mut x`.
export void test_front_check_types_the_address_of_a_field_of_a_constant_local_has_a_mut_fix() {
    types_convert::set_fixing(true); // the fixer's checker run (#3250)
    defer types_convert::set_fixing(false);
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "pub struct Inner:\n    pub n: i32\n\npub struct Outer:\n    pub inner: Inner\n\n"
                 "fn take(m: *mut Inner):\n    m.n = 1\n\nfn run(o: Outer):\n    x := o\n    take(&x.inner)\n";
    types::Checked r = check_text(source);
    test::check_equal(r.error_count, (Usize)1);
    parse::Edits fix = r.errors[0].fix;
    test::check_equal(countof(fix), (Usize)1);
}

// ---------------------------------------------------------------------------------------------------------------
// `is` and `is not` (#3225): the test is a `bool`, and the tested name gets the narrower type.

static Str kinds() {
    return "struct Unary:\n    op: i32\nstruct Binary:\n    left: i32\nenum Kind:\n    unary: Unary\n    binary: "
           "Binary\n"
           "    name: i32\n\n";
}

static Str with_kinds(Str body) {
    return join(kinds(), body);
}

export void test_front_check_types_is_is_a_bool() {
    clean(with_kinds("fn f(x: Kind) -> bool:\n    return x is .unary\n"));
    clean(with_kinds("fn f(x: Kind) -> bool:\n    return x is not .unary\n"));
    clean(with_kinds("fn f(x: Kind) -> bool:\n    return x is Unary\n"));
    clean("fn f(x: ?i32) -> bool:\n    return x is not .none\n");
    clean("fn f(x: ?i32) -> bool:\n    return x is i32\n");
}

export void test_front_check_types_is_needs_a_value_that_can_be_it() {
    fails("fn f(x: i32) -> bool:\n    return x is .none\n", "`x` is `I32`", "never `.none`");
    fails(with_kinds("fn f(x: Kind) -> bool:\n    return x is Circle\n"), "Circle", "");
    fails(with_kinds("fn f(x: Kind) -> bool:\n    return x is u8\n"), "`x` is `Kind`", "never a `U8`");
    fails(with_kinds("fn f(x: Kind) -> bool:\n    return x is .circle\n"), "`x` is `Kind`", "never `.circle`");
}

export void test_front_check_types_an_early_return_after_is_not_narrows_the_rest() {
    clean(with_kinds("fn f(x: Kind) -> i32:\n    if x is not .unary:\n        return 0\n    x.op\n"));
}

export void test_front_check_types_is_narrows_the_then_side() {
    clean(with_kinds("fn f(x: Kind) -> i32:\n    if x is .unary:\n        return x.op\n    0\n"));
    clean(with_kinds("fn f(x: Kind) -> i32:\n    if x is Unary:\n        return x.op\n    0\n"));
}

export void test_front_check_types_a_chain_narrows_the_last_else_to_what_is_left() {
    clean(with_kinds("fn f(x: Kind) -> i32:\n    if x is .unary:\n        return x.op\n    else if x is .binary:\n"
                     "        return x.left\n    else:\n        return x\n"));
}

export void test_front_check_types_and_or_and_not_narrow() {
    clean(with_kinds("fn f(x: Kind) -> bool:\n    return x is .unary and x.op > 0\n"));
    clean(with_kinds("fn f(x: Kind) -> bool:\n    return x is not .unary or x.op > 0\n"));
    clean(with_kinds("fn f(x: Kind) -> i32:\n    if not (x is .unary):\n        return 0\n    x.op\n"));
    clean(with_kinds("fn f(x: Kind) -> i32:\n    if x is not .unary and x is not .binary:\n        return x\n    0\n"));
}

export void test_front_check_types_equality_with_a_symbol_narrows_an_option() {
    clean("fn f(o: ?i32) -> i32:\n    if o != .none:\n        return o\n    0\n");
    clean("fn f(o: ?i32) -> i32:\n    if o == .none:\n        return 0\n    o\n");
    clean("fn f(o: ?i32) -> i32:\n    if o is .none:\n        return 0\n    o + 1\n");
    clean("fn f(o: ?i32) -> i32:\n    if o is not .none:\n        return o\n    0\n");
    clean("fn f(o: ?i32) -> i32:\n    if o is .none:\n        return 0\n    else:\n        return o\n");
    clean("fn f(o: ?i32) -> i32:\n    if o is i32:\n        return o\n    0\n");
}

// Item 55 of #3284 (#3438): narrowing works the same on a `mut` name; a field is still not narrowed.
export void test_front_check_types_a_mut_name_is_narrowed_by_is_and_a_field_is_not() {
    clean(with_kinds("fn f(k: Kind) -> i32:\n    mut x := k\n    if x is not .unary:\n        return 0\n    x.op\n"));
    clean("fn f(o: ?i32) -> i32:\n    mut x := o\n    if x == .none:\n        return 0\n    x + 1\n");
    fails(with_kinds("pub struct Holder:\n    pub kind: Kind\n\nfn f(h: Holder) -> i32:\n"
                     "    if h.kind is not .unary:\n        return 0\n    h.kind.op\n"),
          "payload enumeration", "name the value first");
}

// An assignment to the name, or to a part of it, drops what the test proved (exclusive access, item 41).
export void test_front_check_types_an_assignment_to_a_mut_name_drops_its_narrowing() {
    clean("fn f(o: ?i32) -> i32:\n    mut x := o\n    if x == .none:\n        return 0\n    x = x + 1\n    x = .none\n    0\n");
    fails("fn f(o: ?i32) -> i32:\n    mut x := o\n    if x == .none:\n        return 0\n    x = .none\n    x + 1\n",
          "", "");
    fails(with_kinds("fn f(k: Kind) -> i32:\n    mut x := k\n    if x is not .unary:\n        return 0\n"
                     "    x = Kind(name = 1)\n    x.op\n"),
          "payload enumeration", "");
}

// The address of the name lets a pointer write it.
export void test_front_check_types_the_address_of_a_mut_name_drops_its_narrowing() {
    fails("fn take(p: *mut ?i32):\n    p.* = .none\n\nfn f(o: ?i32) -> i32:\n    mut x := o\n    if x == .none:\n"
          "        return 0\n    take(&x)\n    x + 1\n",
          "", "");
}

// Both forms of reading a payload agree on a `mut` name.
export void test_front_check_types_a_binding_and_a_test_agree_on_a_mut_name() {
    clean("fn f(o: ?i32) -> i32:\n    mut x := o\n    v := x else:\n        return 0\n    v\n");
    clean("fn f(o: ?i32) -> i32:\n    mut x := o\n    if x == .none:\n        return 0\n    x\n");
}

// A narrowing made before a loop is dropped when the body assigns the name: the next turn reads the new value.
export void test_front_check_types_a_loop_that_assigns_a_mut_name_drops_its_narrowing() {
    clean("fn g(o: ?i32) -> i32:\n    mut x := o\n    if x == .none:\n        return 0\n    mut n := 0\n"
          "    while n < 3:\n        n += x\n        n += 1\n    n\n");
    fails("fn f(o: ?i32) -> i32:\n    mut x := o\n    if x == .none:\n        return 0\n    mut n := 0\n"
          "    while n < 3:\n        n += x\n        x = .none\n    n\n",
          "", "");
}

// ---------------------------------------------------------------------------------------------------------------
// static_assert of a call whose argument is a function (#3236)

// A C-variadic function takes a function name past its parameters: the extra arguments are not run, so the call is
// known at compile time.
export void test_front_check_types_static_assert_runs_a_variadic_call_with_a_function_argument() {
    clean("fn within(set: u32, ...) -> bool:\n    true\n\nfn leaf() -> i32:\n    0\n\nstatic_assert(within(1, leaf, "
          "2))\n");
}

// A function with a pack parameter still passes its arguments in a way that is not run at compile time.
export void test_front_check_types_static_assert_refuses_a_pack_parameter() {
    fails("fn all(xs...) -> bool:\n    true\n\nstatic_assert(all(1, 2))\n",
          "static_assert needs a condition known at compile time", "not run at compile time");
}

// ---------------------------------------------------------------------------------------------------------------
// Bracketed generics with a pack (#3257): the generics are bound from the other parameters, the pack takes the rest.

export void test_front_check_types_a_pack_after_bracketed_generics_takes_none_one_or_three() {
    Str f = "fn sum[T](first: T, nums: T...) -> T:\n    first\n\n";
    clean(join(f, "fn g(a: i32) -> i32:\n    sum(a)\n"));
    clean(join(f, "fn g(a: i32) -> i32:\n    sum(a, a)\n"));
    clean(join(f, "fn g(a: i32) -> i32:\n    sum(a, a, a, a)\n"));
}

export void test_front_check_types_a_pack_of_the_generic_type_refuses_another_type() {
    fails("fn sum[T](first: T, nums: T...) -> T:\n    first\n\nfn g(a: i32) -> i32:\n    sum(a, a, \"x\")\n",
          "argument 3 is", "collects `I32`");
}

export void test_front_check_types_countof_of_a_pack_is_a_count() {
    clean("fn many[T](first: T, rest...) -> usize:\n    countof(rest)\n\nfn g(a: i32) -> usize:\n    many(a, 1, "
          "\"x\")\n");
}

// ---------------------------------------------------------------------------------------------------------------
// Array and record shapes (#3255). `[n, m]T` is `[n][m]T`, `[,]T` a block with sizes known at run time.

static Str shapes() {
    return "struct Point:\n    x: i32\n    y: i32\n\nstruct Spot:\n    y: i32\n    x: i32\n\n"
           "struct Padded:\n    x: i32\n    y: i32\n    flag: bool = false\n\nstruct Wide:\n    x: i32\n    y: i32\n   "
           " z: i32\n\nstruct Odd:\n    x: i32\n    y: str\n\n";
}

// A sized array passes where a block or a list of fixed-width rows is wanted.
export void test_front_check_types_a_sized_array_passes_where_a_block_is_wanted() {
    clean("fn f(m: [,]i32) -> i32:\n    0\n\nfn g(a: [4, 2]i32) -> i32:\n    f(a)\n");
    clean("fn f(m: [, 2]i32) -> i32:\n    0\n\nfn g(a: [4, 2]i32) -> i32:\n    f(a)\n");
}

// A block does not go where a sized array is wanted, and an array of another size says so.
export void test_front_check_types_a_block_does_not_pass_where_a_sized_array_is_wanted() {
    fails("fn f(m: [4, 2]i32) -> i32:\n    0\n\nfn g(a: [,]i32) -> i32:\n    f(a)\n", "known at run time",
          "check the sizes");
    fails("fn f(m: [4]i32) -> i32:\n    0\n\nfn g(a: [5]i32) -> i32:\n    f(a)\n", "the sizes differ",
          "the value has 5, the array wants 4");
}

// A list of lists and a block are different types, in both directions.
export void test_front_check_types_a_list_of_lists_and_a_block_are_different_types() {
    fails("fn f(m: [,]i32) -> i32:\n    0\n\nfn g(a: [][]i32) -> i32:\n    f(a)\n", "different types",
          "its own length and memory");
}

// An array of arrays passes where a list of lists is wanted, one level down at a time; const is no part of the
// comparison of the elements (#3256).
export void test_front_check_types_an_array_of_arrays_passes_where_a_list_of_lists_is_wanted() {
    clean("fn f(m: [][]f32) -> i32:\n    0\n\nfn g(a: [2][2]f32) -> i32:\n    f(a)\n");
    clean("fn f(m: [][][]i32) -> i32:\n    0\n\nfn g(a: [2][3][4]i32) -> i32:\n    f(a)\n");
}

// An array of arrays of another element is refused, and the message says the elements differ.
export void test_front_check_types_an_array_of_arrays_of_other_elements_is_refused() {
    fails("fn f(m: [][]f32) -> i32:\n    0\n\nfn g(a: [2][2]i32) -> i32:\n    f(a)\n", "elements are different types",
          "");
}

// A block of one element type does not go where a block of another is wanted.
export void test_front_check_types_a_block_of_other_elements_is_refused() {
    fails("fn f(m: [,]i64) -> i32:\n    0\n\nfn g(a: [4, 2]i32) -> i32:\n    f(a)\n", "elements", "");
}

// Records are structural: the same set of field names, in any order, each field converting.
export void test_front_check_types_a_record_goes_where_a_record_of_the_same_fields_is_wanted() {
    clean(join(shapes(), "fn f(p: Point) -> i32:\n    p.x\n\nfn g(s: Spot) -> i32:\n    f(s)\n"));
    clean(join(shapes(), "fn f(p: Point) -> i32:\n    p.x\n\nfn g() -> i32:\n    f((y = 2, x = 1))\n"));
}

// A field left out of the value is the record's default.
export void test_front_check_types_a_field_with_a_default_may_be_left_out() {
    clean(join(shapes(), "fn f(p: Padded) -> i32:\n    p.x\n\nfn g(s: Point) -> i32:\n    f(s)\n"));
}

export void test_front_check_types_a_record_with_a_missing_field_is_refused() {
    fails(join(shapes(), "fn f(w: Wide) -> i32:\n    w.x\n\nfn g(p: Point) -> i32:\n    f(p)\n"),
          "the field `z` of `Wide` is not in the value", "");
}

export void test_front_check_types_a_record_with_an_extra_field_is_refused() {
    fails(join(shapes(), "fn f(p: Point) -> i32:\n    p.x\n\nfn g(w: Wide) -> i32:\n    f(w)\n"),
          "the value has a field `z` that `Point` does not have", "");
}

export void test_front_check_types_a_record_whose_field_does_not_convert_is_refused() {
    fails(join(shapes(), "fn f(o: Odd) -> i32:\n    o.x\n\nfn g(p: Point) -> i32:\n    f(p)\n"),
          "the field `y` of `Odd`", "does not convert");
}

// The checker reads an `errdefer` body as it reads a `defer` body: an error inside it is reported (#3314).
export void test_front_check_types_an_errdefer_body_is_checked() {
    fails("fn f() -> i32:\n    errdefer nosuch_fn()\n    return 0\n", "nosuch_fn", "");
}

// A function held in an option field is named first, then tested and called (#3230); a tested name is called as is.
export void test_front_check_types_a_call_of_an_option_field_asks_to_name_it_first() {
    Str holder = "struct E:\n    hook: ?fn(i32) -> i32 = .none\n";
    fails(join(holder, "fn run(e: E, x: i32) -> i32:\n    if e.hook != .none:\n        return e.hook(x)\n    0\n"),
          "may be `.none`: name it first (`hook := ...`", "then call it");
    clean("fn run(hook: ?fn(i32) -> i32, x: i32) -> i32:\n    if hook != .none:\n        return hook(x)\n    0\n");
}

// A function that only reads (`*P`) goes where `fn(*mut P)` or `?fn(*mut P)` is wanted; nothing else is relaxed
// (#3326).
static Str hooks() {
    return "struct P:\n    n: i32\n\nstruct Hooks:\n    on_done: ?fn(*mut P) -> i32 = .none\n\n"
           "fn reads(p: *P) -> i32:\n    p.n\n\n";
}

export void test_front_check_types_a_reading_function_goes_where_an_optional_writing_one_is_wanted() {
    clean(join(hooks(), "fn g() -> Hooks:\n    Hooks(on_done = reads)\n"));
    clean(join(hooks(), "fn h(f: fn(*mut P) -> i32) -> i32:\n    0\n\nfn g() -> i32:\n    h(reads)\n"));
}

export void test_front_check_types_an_optional_function_of_another_arity_is_refused() {
    fails(join(hooks(), "fn two(p: *P, q: *P) -> i32:\n    p.n\n\nfn g() -> Hooks:\n    Hooks(on_done = two)\n"),
          "there is no conversion", "");
}

export void test_front_check_types_an_optional_function_of_another_parameter_type_is_refused() {
    fails(join(hooks(), "fn other(p: *i32) -> i32:\n    0\n\nfn g() -> Hooks:\n    Hooks(on_done = other)\n"),
          "there is no conversion", "");
}
