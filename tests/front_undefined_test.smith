// Tests of `= undefined` (K3b, #1334 of #1112; no zero values, #1810 of #1428): the checker takes `undefined` only as a
// local's whole initializer, with the declared type, and the emitter gives the local its slot and no zero store; with
// `Options.fill_undefined` (a debug build) the slot holds the byte 0xAA. A declaration with no value is an error.
module front_undefined_test;

import front::ast;
import front::emit;
import front::emit_jit;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;
import <llvm-c/Core.h>;
import <string.h>;

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        Bool same = true;
        for (Usize k = 0; k < countof(needle); k++) {
            if (text[i + k] != needle[k]) {
                same = false;
                break;
            }
        }
        if (same) return true;
    }
    return false;
}

// `source` gives `count` errors, the first of which says `needle`.
static void errors(Str source, Usize count, Str needle) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed p = parser::parse("t.smith", source);
    test::check_equal(countof(p.errors), (Usize)0);
    types::Checked r = types_decl::check_module(&p.module, types::lp64());
    test::check_equal(r.error_count, count);
    if (count > 0 && r.error_count > 0) test::check_condition(has(r.errors[0].message, needle));
}

export void test_front_undefined_a_local_takes_the_declared_type() {
    errors("I32 f() { I32 x = undefined; x = 1; return x; }", 0, "");
    errors("U8 f() { U8 x[4] = undefined; x[0] = 1; return x[0]; }", 0, "");
}

export void test_front_undefined_auto_has_no_type_to_take() {
    errors("I32 f() { Auto x = undefined; return 0; }", 1, "has no type to take");
}

export void test_front_undefined_is_only_a_whole_initializer() {
    errors("I32 f() { return undefined; }", 1, "only valid as a whole initializer");
    errors("I32 f() { I32 x = undefined + 1; return x; }", 1, "only valid as a whole initializer");
    errors("I32 f() { I32 x = 0; x = undefined; return x; }", 1, "only valid as a whole initializer");
}

// `source` (smith's own syntax) gives `count` errors, the first of which says `needle`.
static void new_errors(Str source, Usize count, Str needle) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed p = parser::parse_new("t.smith", source);
    test::check_equal(countof(p.errors), (Usize)0);
    types::Checked r = types_decl::check_module(&p.module, types::lp64());
    test::check_equal(r.error_count, count);
    if (count > 0 && r.error_count > 0) test::check_condition(has(r.errors[0].message, needle));
}

export void test_front_undefined_a_read_before_any_write_is_an_error() {
    new_errors("fn f() -> i32:\n    let mut a: i32 = undefined\n    return a\n", 1,
               "`a` is read before it is written");
    new_errors("fn f() -> i32:\n    let mut a: i32 = undefined\n    a = a + 1\n    return a\n", 1, "read before");
    new_errors("fn f() -> i32:\n    let mut a: i32 = undefined\n    a += 1\n    return a\n", 1, "read before");
}

export void test_front_undefined_a_read_the_checker_cannot_order_is_allowed() {
    new_errors(
        "fn g(c: bool) -> i32:\n    let mut a: i32 = undefined\n    if c:\n        a = 1\n    return a\n",
        0, "");
    new_errors("fn f() -> i32:\n    let mut a: i32 = undefined\n    a = 1\n    return a\n", 0, "");
    new_errors("fn f() -> i32:\n    let mut a: i32 = undefined\n    let mut i: i32 = 0\n    while i < 3:\n        a "
               "= i\n        i = i + 1\n    return a\n",
               0, "");
    new_errors(
        "fn fill(p: *mut i32):\nfn f() -> i32:\n    let mut a: i32 = undefined\n    fill(&a)\n    return a\n",
        0, "");
}

typedef I32 (*Nullary)();

static Bool has_fill(Bool fill) {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    parser::Parsed p =
        parser::parse_new("t.smith", "pub fn f() -> i32:\n    let mut t: i32 = undefined\n    t = 1\n    t\n");
    test::check_equal(countof(p.errors), (Usize)0);
    types::Checked checked = types_decl::check_module(&p.module, types::lp64());
    test::check_equal(checked.error_count, (Usize)0);
    mem::set_allocator(outside);
    emit_jit::JitResult started = emit_jit::start();
    test::check_equal(started == .ok, true);
    Bool found = false;
    if (started == .ok) {
        emit_jit::Jit host = started.ok;
        c::LLVMContextRef context = c::LLVMContextCreate();
        emit::Options options = {};
        options.target = host.target;
        options.checked = &checked;
        options.fill_undefined = fill;
        emit::ModuleResult emitted = emit::module(context, &p.module, options);
        test::check_equal(emitted == .ok, true);
        if (emitted == .ok) {
            char *text = c::LLVMPrintModuleToString(emitted.ok);
            test::check_equal(c::strstr(text, "alloca i32") != nullptr, true);
            test::check_equal(c::strstr(text, "store i32 0, ptr %t") == nullptr, true);
            found = c::strstr(text, "memset") != nullptr;
            c::LLVMDisposeMessage(text);
            c::LLVMDisposeModule(emitted.ok);
        }
        c::LLVMContextDispose(context);
        emit_jit::stop(&host);
    }
    return found;
}

export void test_front_undefined_the_slot_has_no_zero_store_and_a_debug_build_fills_it() {
    test::check_equal(has_fill(false), false);
    test::check_equal(has_fill(true), true);
}

// A read through a pointer, which the checker does not follow, sees the byte 0xAA of a debug build.
export void test_front_undefined_a_debug_build_reads_0xaa() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    parser::Parsed p = parser::parse_new(
        "t.smith", "pub fn peek() -> i32:\n    let mut b: i32 = undefined\n    let p = &b\n    p.*\n");
    test::check_equal(countof(p.errors), (Usize)0);
    types::Checked checked = types_decl::check_module(&p.module, types::lp64());
    test::check_equal(checked.error_count, (Usize)0);
    mem::set_allocator(outside);
    emit_jit::JitResult started = emit_jit::start();
    test::check_equal(started == .ok, true);
    if (started == .ok) {
        emit_jit::Jit host = started.ok;
        c::LLVMContextRef context = c::LLVMContextCreate();
        emit::Options options = {};
        options.target = host.target;
        options.checked = &checked;
        options.fill_undefined = true;
        emit::ModuleResult emitted = emit::module(context, &p.module, options);
        test::check_equal(emitted == .ok, true);
        if (emitted == .ok) {
            test::check_equal(emit_jit::add(&host, context, emitted.ok) == .ok, true);
            emit_jit::AddressResult found = emit_jit::lookup(&host, "peek");
            test::check_equal(found == .ok, true);
            if (found == .ok) test::check_equal(((Nullary)found.ok)(), (I32)0xAAAAAAAA);
        }
        emit_jit::stop(&host);
    }
}

export void test_front_undefined_a_declaration_with_no_value_is_an_error() {
    errors("I32 f() { I32 x; return 0; }", 1, "needs a value");
}
