// Fix-its and emitted code for plain C numbers (#2488): an integer literal next to a float is written as a float, a
// compound assignment widens a narrower right side, literals under `c ? 5 : 2` take the target's type, a left-out enum
// field takes the variant of value 0, and the emitter reads a literal's type from the checker and folds an integer
// operation in a global's initializer.
module front_fix_numeric_test;

import front::compile;
import front::fix;
import front::parser;
import front::roots;
import std::arena;
import std::files;
import std::format;
import std::mem;
import std::process;
import std::slice;
import std::test;
import <stdio.h>;
import <sys/stat.h>;
import <unistd.h>;

static Str as_str(char chars[:]) {
    return chars;
}

static Usize errors_in(Str source) {
    parser::Parsed parsed = fix::parse_for_fix("t.smith", source);
    return countof(parsed.errors);
}

static void expect_fixed(Str before, Str want) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed first = fix::fix_text("t.smith", before);
    test::check_equal(first.text, want);
    test::check_equal(errors_in(first.text), (Usize)0);
}

// The variants are renamed by a later pass: the text is compared when no pass changes it.
static void expect_fixed_settled(Str before, Str want) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed last = fix::fix_text("t.smith", before);
    for (Usize pass = 0; pass < 6 && last.applied > 0; pass++)
        last = fix::fix_text("t.smith", last.text);
    test::check_equal(last.text, want);
    test::check_equal(errors_in(last.text), (Usize)0);
}

export void test_front_fix_numeric_an_integer_literal_next_to_a_float_is_a_float() {
    expect_fixed("module m;\nF64 f(F64 v) {\n    if (v < 0) return -v;\n    return v;\n}\n",
                 "fn f(v: f64) -> f64:\n    if v < 0.0:\n        return -v\n    return v\n");
}

export void test_front_fix_numeric_an_enumeration_given_to_an_integer_is_converted() {
    expect_fixed("module m;\nenum Mode { fast, slow };\nI32 f() {\n    enum Mode m = fast;\n    I32 code = m;\n    "
                 "return code;\n}\n",
                 "enum Mode:\n    fast\n    slow\nfn f() -> i32:\n    m: Mode = .fast\n    code: i32 = m.to(i32)\n    "
                 "return code\n");
}

export void test_front_fix_numeric_a_bare_enumerator_given_to_an_integer_is_written_with_its_enumeration() {
    expect_fixed_settled(
        "module m;\nenum Color { Red, Green };\nstruct Pair {\n    int first;\n    int second;\n};\nstruct "
        "Pair make() {\n    return (struct Pair){.first = 4, .second = Green};\n}\n",
        "enum Color:\n    Red\n    Green\nstruct Pair:\n    first: i32\n    second: i32\nfn make() -> Pair:\n "
        "   return Pair(first = 4, second = Color.Green.to(i32))\n");
}

export void test_front_fix_numeric_a_cast_enumerator_is_written_with_its_enumeration() {
    expect_fixed_settled("module m;\nenum Color { Red, Green };\nint f() {\n    return (int)Green;\n}\n",
                         "enum Color:\n    Red\n    Green\nfn f() -> i32:\n    return Color.Green.to(i32)\n");
}

export void test_front_fix_numeric_a_count_or_size_given_to_a_fixed_width_is_converted() {
    expect_fixed(
        "module m;\nU64 lanes_of(U64 n) { return n; }\nU64 g(I32 xs[4]) {\n    return lanes_of(countof(xs));\n}\nU32 "
        "h(I32 flag) {\n    U32 n = sizeof(U64);\n    return n;\n}\n",
        "fn lanes_of(n: u64) -> u64:\n    return n\nfn g(mut xs: [4]i32) -> u64:\n    return "
        "lanes_of((countof(xs)).to(u64))\nfn h(flag: i32) -> u32:\n    n: u32 = (sizeof(u64)).to(u32)\n    return n\n");
}

export void test_front_fix_numeric_a_compound_assignment_widens_a_narrower_right_side() {
    expect_fixed("module m;\nvoid f(U64 *a, U32 b) {\n    *a /= b;\n}\n",
                 "fn f(a: *mut u64, b: u32):\n    a.* /= b.to(u64)\n");
}

export void test_front_fix_numeric_a_compound_assignment_converts_a_same_width_type_with_no_common_one() {
    expect_fixed("module m;\nvoid f(U64 *a, Usize b) {\n    *a *= b;\n}\n",
                 "fn f(a: *mut u64, b: usize):\n    a.* *= b.to(u64)\n");
}

export void test_front_fix_numeric_literals_in_a_conditional_take_the_targets_type() {
    expect_fixed("module m;\nU32 f(I32 e) {\n    U32 k = 1;\n    k *= e < 0 ? 5 : 2;\n    return k;\n}\n",
                 "fn f(e: i32) -> u32:\n    mut k: u32 = 1\n    k *= if e < 0: 5 else: 2\n    return k\n");
}

export void test_front_fix_numeric_a_left_out_enum_field_is_the_variant_of_value_zero() {
    expect_fixed_settled(
        "module m;\ntypedef enum {\n    Empty,\n    Invalid,\n} Error;\ntypedef struct {\n    int v;\n"
        "    Error e;\n} S;\nS f(int x) { return (S){.v = x}; }\n",
        "enum Error:\n    Empty\n    Invalid\nstruct S:\n    v: i32\n    e: Error\nfn f(x: i32) -> S:\n"
        "    return S(v = x, e = .Empty)\n");
}

// ---------------------------------------------------------------------------------------------------------------
// The emitter

static void write_text(Str path, Str text) {
    c::FILE *file = c::fopen(path.data, "w");
    test::check_equal(file != nullptr, true);
    if (file == nullptr) return;
    c::fwrite(text.data, 1, countof(text), file);
    c::fclose(file);
}

static Str read_text(Str path) {
    files::BytesResult loaded = files::read_file(path);
    test::check_equal(loaded == .ok, true);
    if (loaded == .error) return "";
    format::Chars chars = mem::view(loaded.ok, char);
    Str text = chars;
    return text;
}

static void remove_all(Str folder) {
    const char *const argv[4] = {"rm", "-rf", folder.data, nullptr};
    process::OutputResult done = process::run(argv[0:3]);
    test::check_equal(done == .ok, true);
}

// A literal next to a `u32` in a comparison has no expected type: the checker's type is the `u32`. A global's
// initializer may shift a converted literal.
export void test_front_fix_numeric_emit_literal_types_and_a_global_shift() {
    Str folder = as_str(format::push("/tmp/front_fix_numeric_", (I64)c::getpid()));
    c::mkdir(folder.data, 0o700);
    c::mkdir(as_str(format::push(folder, "/src")).data, 0o700);
    write_text(as_str(format::push(folder, "/src/a.smith")), "const limit: u64 = 1.to(u64) << 63\n"
                                                             "pub fn f(hx: u32) -> bool:\n"
                                                             "    return (0x000fffff & (2 + hx)) < 3\n"
                                                             "pub fn g() -> u64:\n"
                                                             "    return limit\n");
    roots::Roots where = {.source = as_str(format::push(folder, "/src")),
                          .library = as_str(format::push(folder, "/lib"))};
    compile::Report report =
        compile::file(as_str(format::push(folder, "/src/a.smith")), as_str(format::push(folder, "/a.o")), "", where);
    test::check_equal(report.ok, true);
    remove_all(folder);
}

// One run of the fixer settles a file: a variant of another module written `kinds::minus` inside a `for` that becomes
// a `while` is `.minus` at the end of the one run, so a second run changes nothing (#2449).
export void test_front_fix_numeric_one_run_settles_a_qualified_variant() {
    Str folder = as_str(format::push("/tmp/front_fix_settle_", (I64)c::getpid()));
    c::mkdir(folder.data, 0o700);
    c::mkdir(as_str(format::push(folder, "/src")).data, 0o700);
    write_text(as_str(format::push(folder, "/src/kinds.smith")),
               "module kinds;\nexport typedef enum {\n    Plus,\n    Minus,\n} Kind;\nexport typedef struct {\n    "
               "Kind kind;\n} "
               "Tok;\n");
    write_text(
        as_str(format::push(folder, "/src/use.smith")),
        "module use;\nimport kinds;\nstatic int at(kinds::Tok *t, kinds::Kind k) {\n    return t->kind == k;\n}\n"
        "static int f(kinds::Tok *t) {\n    int total = 0;\n    for (int i = 0; i < 9 && at(t, kinds::Minus); i += 1) "
        "{\n"
        "        total += i;\n    }\n    return total;\n}\n");
    char before[4096];
    (void)c::getcwd(before, sizeof before);
    test::check_equal(c::chdir(folder.data), 0);
    const char *const paths[2] = {"src/kinds.smith", "src/use.smith"};
    test::check_equal(fix::fix_run(paths, 2), 0);
    Str once = read_text("src/use.smith");
    test::check_equal(fix::fix_run(paths, 2), 0);
    Str twice = read_text("src/use.smith");
    (void)c::chdir(before);
    Str left = "at(t, kinds.minus)";
    Str want = "at(t, .minus)";
    test::check_equal(slice::find_slice(once, left) == .some, false);
    test::check_equal(slice::find_slice(once, want) == .some, true);
    test::check_equal(once, twice);
    remove_all(folder);
}
