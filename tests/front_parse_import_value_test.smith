// Tests of modules as values (#1676 of #1428): `build := import std.build` reads as a module bound to a name, `.` is
// the only separator, and the old forms (`import a::b;`, `a::b`, `@serial::rename`) read as before and record a
// warning whose fix writes the new form, so `smith lint --fix` mends them and a second run changes nothing.
module front_parse_import_value_test;

import front::ast;
import front::fix;
import front::parser;
import std::arena;
import std::mem;
import std::test;

static Str dump_of(Str source) {
    parser::Parsed parsed = parser::parse_new("x.smith", source);
    if (countof(parsed.errors) > 0) {
        Str expected = "no error";
        test::check_equal(parsed.errors[0].message, expected);
    }
    test::check_equal(countof(parsed.warnings), (Usize)0);
    return ast::dump(&parsed.module);
}

static Str mended(Str source) {
    fix::Fixed first = fix::fix_text("m.smith", source);
    fix::Fixed second = fix::fix_text("m.smith", first.text);
    test::check_equal(second.applied, (Usize)0);
    return first.text;
}

export void test_a_module_is_bound_to_a_name() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str want = "(module \n  (import a::b::c as x))\n";
    test::check_equal(dump_of("x := import a.b.c\n"), want);
}

export void test_a_public_module_binding() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str want = "(module \n  (import std::math as m pub))\n";
    test::check_equal(dump_of("pub m := import std.math\n"), want);
}

export void test_import_fix_binds_the_last_name() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str want = "build := import std.build\n";
    test::check_equal(mended("import std::build;\n"), want);
}

export void test_import_fix_binds_the_alias() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str want = "m := import std.math\n";
    test::check_equal(mended("import std::math as m;\n"), want);
}

export void test_a_path_in_an_expression_and_a_type_is_mended() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "fn f(b: *mut build::Build) {\n    c::printf(1)\n}\n";
    Str want = "fn f(b: *mut build.Build) {\n    c.printf(1)\n}\n";
    test::check_equal(mended(source), want);
}

export void test_a_dotted_type_path_reads() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed parsed = parser::parse_new("x.smith", "fn f(b: *mut build.Build) {\n}\n");
    test::check_equal(countof(parsed.errors), (Usize)0);
    test::check_equal(countof(parsed.warnings), (Usize)0);
}

export void test_an_attribute_path_is_mended() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "@serial::rename(\"a\")\nfn f() {\n}\n";
    Str want = "@serial.rename(\"a\")\nfn f() {\n}\n";
    test::check_equal(mended(source), want);
}
