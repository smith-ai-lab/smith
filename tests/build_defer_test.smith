// smith_defer and smith_lines (tests/build.sh section 9c, the monad3 shape: a step makes a list, and each name in it
// becomes a step), and the parallel build of 80 sources that share Clang modules (section 11c).
module build_defer_test;

import smith::io;
import smith::test;
import scratch;

static scratch::Project defer_project(io::Io *io) {
    return scratch::project(io, "p", "defer");
}

// The sorted names in a file, on one line, as the shell's `sort file | tr '\n' ' '` gives them.
static const char *sorted(const scratch::Project *p, const char *file) {
    char command[256];
    __builtin_snprintf(command, sizeof command, "sort %s | tr '\\n' ' ' | sed 's| *$||'", file);
    return scratch::capture(p, command);
}

static const char *status_and(const scratch::Run *run, const char *text) {
    static char buffer[1024];
    __builtin_snprintf(buffer, sizeof buffer, "%d %s", run->status, text);
    return buffer;
}

export void test_build_defer_a_fresh_tree_builds_every_output_in_one_build(io::Io *io) {
    scratch::Project p = defer_project(io);
    scratch::Run first = scratch::build(&p, "");
    scratch::expect_text(
        "defer: a fresh tree builds every output in one smith build", "0 a.out b.out",
        status_and(&first, scratch::capture(&p, "ls ./*.out | tr '\\n' ' ' | sed 's|\\./||g; s| *$||'")));
    scratch::Run second = scratch::build(&p, "");
    scratch::expect_contains("defer: the second run has no work", second.out, "no work to do");
    scratch::write(&p, "source", "a\nb\nc\n");
    scratch::Run added = scratch::build(&p, "");
    scratch::expect_text("defer: a new name builds one new output", "0 a b c", status_and(&added, sorted(&p, "ran")));
    scratch::expect_count("defer: no other output step reran", 3, scratch::lines(&p, "ran"));
    scratch::Run settled = scratch::build(&p, "");
    scratch::expect_contains("defer: and the next run has no work", settled.out, "no work to do");
}

export void test_build_defer_a_stage_2_target_can_be_named_on_a_fresh_tree(io::Io *io) {
    scratch::Project p = defer_project(io);
    scratch::Run run = scratch::build(&p, "b.out");
    scratch::expect_text("defer: a stage 2 target can be named on a fresh tree", "0 b.out",
                         status_and(&run, scratch::capture(&p, "ls ./*.out | sed 's|\\./||'")));
}

export void test_build_defer_a_d_option_reaches_stage_2(io::Io *io) {
    scratch::Project p = defer_project(io);
    (void)scratch::build(&p, "-Dsuffix=x");
    scratch::expect_text("defer: a -D option reaches stage 2", "bx", scratch::read(&p, "b.out"));
}

export void test_build_defer_clean_then_build_works(io::Io *io) {
    scratch::Project p = defer_project(io);
    (void)scratch::build(&p, "-t clean");
    scratch::Run built = scratch::build(&p, "");
    scratch::expect_text("defer: clean, then smith build, works", "0 a b", status_and(&built, sorted(&p, "ran")));
    (void)scratch::build(&p, "-t clean");
    scratch::expect_text("defer: clean keeps the manifest", "present",
                         scratch::exists(&p, ".smith/build.ninja") ? "present" : "");
    scratch::Run again = scratch::build(&p, "");
    char both[64];
    __builtin_snprintf(both, sizeof both, "%d %s %s", again.status, scratch::exists(&p, "a.out") ? "present" : "",
                       scratch::exists(&p, "list") ? "present" : "");
    scratch::expect_text("defer: and builds again", "0 present present", both);
}

// A chained defer: more defers on an output of a step it added.
export void test_build_defer_a_chained_defer_builds_the_whole_chain(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "defer_chain");
    scratch::Run built = scratch::build(&p, "");
    scratch::expect_text("defer: a chained defer builds the whole chain in one smith build", "0 a",
                         status_and(&built, scratch::read(&p, "final")));
    scratch::Run again = scratch::build(&p, "");
    scratch::expect_contains("defer: the chain has no work next", again.out, "no work to do");
}

export void test_build_lines_three_lines_a_final_newline_and_an_empty_one(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "lines_three");
    scratch::Run three = scratch::build(&p, "");
    scratch::expect_text("lines: three lines, a final newline and an empty one between", "0 3[one][][three]",
                         status_and(&three, scratch::read(&p, "result")));
}

export void test_build_lines_no_final_newline_still_gives_the_line(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "lines_one");
    scratch::Run one = scratch::build(&p, "");
    scratch::expect_text("lines: no final newline still gives the line", "0 x",
                         status_and(&one, scratch::read(&p, "result")));
}

export void test_build_lines_an_empty_file_is_an_empty_list_and_a_missing_one_exits_2(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "lines_empty");
    scratch::Run empty = scratch::build(&p, "");
    scratch::expect_text("lines: an empty file is an empty list", "0 empty",
                         status_and(&empty, scratch::read(&p, "result")));
    (void)scratch::sh(&p, "rm data");
    scratch::Run missing = scratch::build(&p, "");
    scratch::expect_status("lines: a missing file exits 2", 2, &missing);
    scratch::expect_contains("lines: the missing file message", missing.err,
                             "smith: build.c: cannot read data; if a step makes it, read it inside smith_defer");
}

// 11c. Modules: the parallel build, ten clean builds in a row, 80 sources sharing the modules.
export void test_build_modules_clean_parallel_builds_with_a_cold_cache_succeed(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "modules_parallel");
    scratch::own_cache(&p);
    (void)scratch::sh(
        &p,
        "mkdir inc; for n in 1 2 3 4 5 6 7 8; do "
        "printf '#pragma once\\n#include <stddef.h>\\n#include <stdio.h>\\nint h%s(int x);\\n' \"$n\" >\"inc/h$n.h\"; "
        "done; "
        "printf '#pragma once\\n#include \"h1.h\"\\n#include \"h2.h\"\\n#include \"h3.h\"\\nint top(void);\\n' "
        ">inc/top.h; "
        "for n in $(seq 1 80); do printf '#include \"inc/top.h\"\\n#include \"inc/h%s.h\"\\n#include \"inc/h%s.h\"\\n"
        "int f%s(void) { return top() + h%s(%s); }\\n' $((n % 8 + 1)) $(((n + 3) % 8 + 1)) \"$n\" $((n % 8 + 1)) "
        "\"$n\" >\"s$n.c\"; done");
    usize ok = 0;
    usize rounds = test::full() ? 10 : 3; // ten with --full
    for (usize round = 1; round <= rounds; round++) {
        (void)scratch::sh(&p, "rm -rf build \"$XDG_CACHE_HOME/smith/modules\"");
        scratch::Run built = scratch::build(&p, "-j 16");
        ok += built.status == 0 ? 1U : 0U;
    }
    scratch::expect_count("modules: clean parallel builds with a cold cache succeed (three; ten with --full)", rounds,
                          ok);
}
