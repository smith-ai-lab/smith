// smith_defer and smith_lines (tests/build.sh section 9c, the monad3 shape: a step makes a list, and each name in it
// becomes a step), and the parallel build of 80 sources that share Clang modules (section 11c).
module build_defer_test;

import smith::arena;
import smith::mem;
import smith::test;
import scratch;

static scratch::Project defer_project() {
    return scratch::make("p", "defer");
}

// The sorted names in a file, on one line, as the shell's `sort file | tr '\n' ' '` gives them.
static const char *sorted(const scratch::Project *p, const char *file) {
    char command[256];
    __builtin_snprintf(command, sizeof command, "sort %s | tr '\\n' ' ' | sed 's| *$||'", file);
    return scratch::capture(p, command);
}

static const char *status_and(const scratch::Run *run, const char *text) {
    static char buffer[1024];
    __builtin_snprintf(buffer, sizeof buffer, "%d %s", run->status, text);
    return buffer;
}

// Back to a fresh tree: no output, no list, no record of the steps that ran, no manifest and no source but the
// fixture's; the compiled build program stays, which is the same for every tree of this build.c.
static void fresh_tree(const scratch::Project *p) {
    (void)scratch::sh(p, "rm -rf ./*.out list ran && cd .smith && "
                         "rm -rf build.ninja build.info .smith_log effects compile_commands.json");
    scratch::write(p, "source", "a\nb\n");
}

// Four tests of one project: each used to make a project of its own, and each of those spent about 2 CPU-s building
// the build program. Each step starts from a fresh tree. The assertions are the same.
export void test_build_defer_stage_2_on_a_fresh_tree_a_d_option_and_clean() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = defer_project();
    defer scratch::clean(&p);
    scratch::Run first = scratch::build(&p, "");
    scratch::expect_text(
        "defer: a fresh tree builds every output in one smith build", "0 a.out b.out",
        status_and(&first, scratch::capture(&p, "ls ./*.out | tr '\\n' ' ' | sed 's|\\./||g; s| *$||'")));
    scratch::Run second = scratch::build(&p, "");
    scratch::expect_contains("defer: the second run has no work", second.out, "no work to do");
    scratch::write(&p, "source", "a\nb\nc\n");
    scratch::Run added = scratch::build(&p, "");
    scratch::expect_text("defer: a new name builds one new output", "0 a b c", status_and(&added, sorted(&p, "ran")));
    scratch::expect_count("defer: no other output step reran", 3, scratch::lines(&p, "ran"));
    scratch::Run settled = scratch::build(&p, "");
    scratch::expect_contains("defer: and the next run has no work", settled.out, "no work to do");
    fresh_tree(&p);
    scratch::Run run = scratch::build(&p, "b.out");
    scratch::expect_text("defer: a stage 2 target can be named on a fresh tree", "0 b.out",
                         status_and(&run, scratch::capture(&p, "ls ./*.out | sed 's|\\./||'")));
    fresh_tree(&p);
    (void)scratch::build(&p, "-Dsuffix=x");
    scratch::expect_text("defer: a -D option reaches stage 2", "bx", scratch::read(&p, "b.out"));
    fresh_tree(&p);
    (void)scratch::build(&p, "-t clean");
    scratch::Run built = scratch::build(&p, "");
    scratch::expect_text("defer: clean, then smith build, works", "0 a b", status_and(&built, sorted(&p, "ran")));
    (void)scratch::build(&p, "-t clean");
    scratch::expect_text("defer: clean keeps the manifest", "present",
                         scratch::exists(&p, ".smith/build.ninja") ? "present" : "");
    scratch::Run again = scratch::build(&p, "");
    char both[64];
    __builtin_snprintf(both, sizeof both, "%d %s %s", again.status, scratch::exists(&p, "a.out") ? "present" : "",
                       scratch::exists(&p, "list") ? "present" : "");
    scratch::expect_text("defer: and builds again", "0 present present", both);
}

// A compile in a project with a deferred step: the regenerated manifest keeps the compile's effects outputs (#271).
//
// Then the regeneration rule's command, run without SMITH_EFFECTS and SMITH_SELF (as ninja or a hand run would),
// writes the manifest `smith build` wrote, byte for byte: the decision is an argument of the program, not the
// environment. Two tests of one project: each used to make a project of its own, and each of those spent about 2 CPU-s
// building the build program. The assertions are the same.
export void test_build_defer_with_a_compile_settles_and_the_regeneration_writes_the_same_manifest() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "defer_compile");
    defer scratch::clean(&p);
    scratch::Run first = scratch::build(&p, "");
    scratch::expect_text("defer compile: the first build passes", "0 ok", status_and(&first, "ok"));
    scratch::Run second = scratch::build(&p, "");
    scratch::expect_contains("defer compile: the second run has no work", second.out, "no work to do");
    scratch::Run built = scratch::build(&p, "");
    scratch::expect_text("defer regenerate: the build passes", "0 ok", status_and(&built, "ok"));
    scratch::Run same = scratch::sh(
        &p, "cp .smith/build.ninja before; "
            "command=$(sed -n 's/^  command = \\(.smith\\/program --regenerate .*\\)$/\\1/p' .smith/build.ninja); "
            "test -n \"$command\" && env -u SMITH_EFFECTS -u SMITH_SELF sh -c \"$command\" && cmp before "
            ".smith/build.ninja");
    scratch::expect_text("defer regenerate: the same manifest without the environment", "0 ok",
                         status_and(&same, "ok"));
}

// A ThinLTO compile writes its effect summary like any other (the manifest names it as an output, and a step whose
// output is never written is never up to date), so the second run has no work: the release profile of every project
// compiles with -flto=thin (#271).
export void test_build_a_thin_lto_compile_settles() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "lto_compile");
    defer scratch::clean(&p);
    scratch::Run first = scratch::build(&p, "");
    scratch::expect_text("lto: the first build passes", "0 ok", status_and(&first, "ok"));
    scratch::Run second = scratch::build(&p, "");
    scratch::expect_contains("lto: the second run has no work", second.out, "no work to do");
}

// A manifest that never settles stops after its tries and says what was out of date, so the cause is not a guess: here
// the step that should make `list` does not (#271).
export void test_build_defer_an_unsettled_manifest_names_what_is_out_of_date() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "defer_unsettled");
    defer scratch::clean(&p);
    scratch::Run run = scratch::build(&p, "");
    scratch::expect_contains("unsettled: the build stops", run.err, "is still out of date after");
    scratch::expect_contains("unsettled: and names the output that does not exist", run.err,
                             "output list doesn't exist");
}

// A chained defer: more defers on an output of a step it added.
export void test_build_defer_a_chained_defer_builds_the_whole_chain() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "defer_chain");
    defer scratch::clean(&p);
    scratch::Run built = scratch::build(&p, "");
    scratch::expect_text("defer: a chained defer builds the whole chain in one smith build", "0 a",
                         status_and(&built, scratch::read(&p, "final")));
    scratch::Run again = scratch::build(&p, "");
    scratch::expect_contains("defer: the chain has no work next", again.out, "no work to do");
}

export void test_build_lines_three_lines_a_final_newline_and_an_empty_one() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "lines_three");
    defer scratch::clean(&p);
    scratch::Run three = scratch::build(&p, "");
    scratch::expect_text("lines: three lines, a final newline and an empty one between", "0 3[one][][three]",
                         status_and(&three, scratch::read(&p, "result")));
}

export void test_build_lines_no_final_newline_still_gives_the_line() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "lines_one");
    defer scratch::clean(&p);
    scratch::Run one = scratch::build(&p, "");
    scratch::expect_text("lines: no final newline still gives the line", "0 x",
                         status_and(&one, scratch::read(&p, "result")));
}

// An empty file, a missing one and one over 16 MiB: three builds of one project, which used to be two tests with a
// project each (each spent about 2 CPU-s building the build program). The assertions are the same.
export void test_build_lines_an_empty_file_a_missing_one_and_one_over_16_mib() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "lines_empty");
    defer scratch::clean(&p);
    scratch::Run empty = scratch::build(&p, "");
    scratch::expect_text("lines: an empty file is an empty list", "0 empty",
                         status_and(&empty, scratch::read(&p, "result")));
    (void)scratch::sh(&p, "rm data");
    scratch::Run missing = scratch::build(&p, "");
    scratch::expect_text("lines: a missing file is the result's error, which the build file handles", "0 missing",
                         status_and(&missing, scratch::read(&p, "result")));
    (void)scratch::sh(&p, "head -c 17825792 /dev/zero > data");
    scratch::Run big = scratch::build(&p, "");
    scratch::expect_status("lines: a file over 16 MiB exits 2", 2, &big);
    scratch::expect_contains("lines: the message", big.err, "data is larger than 16 MiB");
}

// 11c. Modules: the parallel build, ten clean builds in a row, 80 sources sharing the modules.
export void test_build_modules_clean_parallel_builds_with_a_cold_cache_succeed() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = scratch::make("p", "modules_parallel");
    defer scratch::clean(&p);
    scratch::own_cache(&p);
    (void)scratch::sh(
        &p,
        "mkdir inc; for n in 1 2 3 4 5 6 7 8; do "
        "printf '#pragma once\\n#include <stddef.h>\\n#include <stdio.h>\\nint h%s(int x);\\n' \"$n\" >\"inc/h$n.h\"; "
        "done; "
        "printf '#pragma once\\n#include \"h1.h\"\\n#include \"h2.h\"\\n#include \"h3.h\"\\nint top(void);\\n' "
        ">inc/top.h; "
        "for n in $(seq 1 80); do printf '#include \"inc/top.h\"\\n#include \"inc/h%s.h\"\\n#include \"inc/h%s.h\"\\n"
        "int f%s(void) { return top() + h%s(%s); }\\n' $((n % 8 + 1)) $(((n + 3) % 8 + 1)) \"$n\" $((n % 8 + 1)) "
        "\"$n\" >\"s$n.c\"; done");
    usize ok = 0;
    usize rounds = test::full() ? 10 : 3; // ten with --full
    for (usize round = 1; round <= rounds; round++) {
        (void)scratch::sh(&p, "rm -rf build \"$XDG_CACHE_HOME/smith/modules\"");
        scratch::Run built = scratch::build(&p, "-j 16");
        ok += built.status == 0 ? 1U : 0U;
    }
    scratch::expect_count("modules: clean parallel builds with a cold cache succeed (three; ten with --full)", rounds,
                          ok);
}
