// Tests of payload enumerations in the checker (#1774, part of #1428, spec "Structs, enums and building values"):
// `enum Shape { circle: Circle  rect: Rect  empty }` declares, `.circle(Circle(radius = 1))` builds, and a `match` arm
// `.circle(c)` binds what the enumerator carries. Each scenario is source text in smith's own syntax; one test per
// rule, an accepted case and a refused one with its message.
module front_types_payload_test;

import front::ast;
import front::lex;
import front::parse;
import front::parse_decl;
import front::parse_expr;
import front::parse_stmt;
import front::parse_type;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        Bool same = true;
        for (Usize k = 0; k < countof(needle); k++) {
            if (text[i + k] != needle[k]) {
                same = false;
                break;
            }
        }
        if (same) return true;
    }
    return false;
}

static Str join(Str a, Str b) {
    char out[:] = mem::alloc_slice(char, countof(a) + countof(b));
    for (Usize i = 0; i < countof(a); i++) {
        out[i] = a[i];
    }
    for (Usize i = 0; i < countof(b); i++) {
        out[countof(a) + i] = b[i];
    }
    return out;
}

static types::Checked check_text(Str source) {
    parser::Parsed p = parser::parse_new("t.smith", source);
    test::check_equal(countof(p.errors), (Usize)0);
    return types_decl::check_module(&p.module, types::lp64());
}

// The errors, one per line.
static Str errors_of(const types::Checked *r) {
    Str text = "";
    for (Usize i = 0; i < r->error_count; i++) {
        text = join(text, join(r->errors[i].message, "\n"));
    }
    return text;
}

// `source` checks with no error.
static void clean(Str source) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_text(source);
    Str errors = errors_of(&r);
    Str none = "";
    test::check_equal(errors, none);
}

// `source` gives exactly one error, which says `first` and `second`.
static void fails(Str source, Str first, Str second) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_text(source);
    Str errors = errors_of(&r);
    test::check_equal(r.error_count, (Usize)1);
    test::check_condition(has(errors, first));
    test::check_condition(has(errors, second));
}

// ---------------------------------------------------------------------------------------------------------------
// Payload enumerations

static Str shapes(Str rest) {
    return join("struct Circle:\n    radius: f32\nstruct Rect:\n    w: f32\n    h: f32\nenum Shape:\n    "
                "circle: Circle\n    rect: Rect\n    empty\n",
                rest);
}

export void test_front_types_payload_enumeration_declares() {
    clean(shapes(""));
}

export void test_front_types_payload_variant_builds_with_its_payload() {
    clean(shapes("fn make() -> Shape:\n    let s: Shape = .circle(Circle(radius = 1))\n    return s\n"));
}

export void test_front_types_payload_variant_without_payload_builds() {
    clean(shapes("fn make() -> Shape:\n    let s: Shape = .empty\n    return s\n"));
}

export void test_front_types_payload_variant_checks_its_payload_type() {
    fails(shapes("fn make() -> Shape:\n    let s: Shape = .circle(Rect(w = 1, h = 2))\n    return s\n"), "Circle", "");
}

export void test_front_types_payload_variant_needs_its_payload() {
    fails(shapes("fn make() -> Shape:\n    let s: Shape = .circle\n    return s\n"), "`.circle` carries a `Circle`",
          "`.circle(value)`");
}

export void test_front_types_payload_variant_that_carries_nothing_takes_none() {
    fails(shapes("fn make() -> Shape:\n    let s: Shape = .empty(1)\n    return s\n"), "`.empty` carries no value",
          "`.empty` alone");
}

export void test_front_types_payload_match_binds_what_the_variant_carries() {
    clean(shapes("fn area(s: Shape) -> f32:\n    return match s:\n        .circle(c): c.radius * c.radius\n        "
                 ".rect(r): r.w * r.h\n        .empty: 0\n"));
}

export void test_front_types_payload_match_must_cover_every_variant() {
    fails(shapes("fn area(s: Shape) -> f32:\n    return match s:\n        .circle(c): c.radius\n        "
                 ".rect(r): r.w\n"),
          "does not cover `.empty`", "");
}

export void test_front_types_payload_match_binding_has_the_payload_type() {
    fails(shapes("fn area(s: Shape) -> f32:\n    return match s:\n        .circle(c): c.w\n        .rect(r)"
                 ": r.w\n"
                 "        .empty: 0\n"),
          "w", "");
}

export void test_front_types_payload_match_binding_on_a_bare_variant_is_refused() {
    fails(shapes("fn area(s: Shape) -> f32:\n    return match s:\n        .circle(c): 1\n        .rect(r): 2\n"
                 "        .empty(e): 0\n"),
          "`.empty` carries no value to bind", "");
}

export void test_front_types_payload_read_without_testing_the_variant_suggests_if_let_or_match() {
    fails(shapes("fn area(s: Shape) -> f32:\n    return s.circle.radius\n"), "payload enumeration",
          "`if .variant(v) := x:`");
}

// ---------------------------------------------------------------------------------------------------------------
// A pattern starts an `&&` chain (D12): the bound name is in scope in the rest of the chain and the body, not in `else`

export void test_front_types_payload_pattern_chain_binds_in_the_rest_of_the_chain_and_the_body() {
    clean(shapes("fn big(s: Shape) -> f32:\n    if .circle(c) := s and c.radius > 1.0:\n        return c.radius\n"
                 "    return 0.0\n"));
}

export void test_front_types_payload_pattern_chain_reads_the_payload_in_every_conjunct() {
    clean(shapes("fn wide(s: Shape) -> bool:\n    if .rect(r) := s and r.w > 1.0 and r.h < r.w:\n        return true\n"
                 "    return false\n"));
}

export void test_front_types_payload_pattern_chain_leads_a_while() {
    clean(
        shapes("fn spin(s: Shape) -> f32:\n    mut total: f32 = 0.0\n    while .circle(c) := s and total < c.radius:\n"
               "        total += 1.0\n    return total\n"));
}

export void test_front_types_payload_pattern_chain_name_is_not_in_the_else() {
    fails(shapes("fn big(s: Shape) -> f32:\n    if .circle(c) := s and c.radius > 1.0:\n        return 1.0\n"
                 "    else:\n        return c.radius\n"),
          "`c`", "");
}

export void test_front_types_payload_pattern_chain_may_bind_again_to_the_right() {
    clean(shapes("struct Holder:\n    shape: Shape\nenum Slot:\n    held: Holder\n    free\n"
                 "fn width(s: Slot) -> f32:\n    if .held(h) := s and .rect(r) := h.shape and r.w > 1.0:\n"
                 "        return r.w + r.h\n    return 0.0\n"));
}

export void test_front_types_payload_pattern_chain_binds_after_a_test() {
    clean(shapes("fn big(s: Shape, t: Shape) -> f32:\n    if .circle(c) := s and c.radius > 1.0 and .rect(r) := t"
                 " and r.w > c.radius:\n        return r.w\n    return 0.0\n"));
}

export void test_front_types_payload_pattern_chain_binds_again_in_a_while() {
    clean(shapes("fn spin(s: Shape, t: Shape) -> f32:\n    mut total: f32 = 0.0\n"
                 "    while .circle(c) := s and .rect(r) := t and total < c.radius + r.w:\n        total += 1.0\n"
                 "    return total\n"));
}

// A `Result` can fail like an option: `.ok(v) := r else: return` is not "always matches" (the fixer writes this form
// for `if (r != .ok) return`).
export void test_front_types_payload_result_binding_takes_an_else() {
    clean(shapes("fn first(r: Result(i32, i32)) -> i32:\n    .ok(v) := r else:\n        return 0\n    return v\n"));
}

// The `else` is checked once for each pattern of the chain (the checker sees nested `if`s), so the error may come more
// than once: it is the name that matters.
export void test_front_types_payload_pattern_chain_second_name_is_not_in_the_else() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r =
        check_text(shapes("fn big(s: Shape, t: Shape) -> f32:\n    if .circle(c) := s and .rect(r) := t:\n"
                          "        return r.w\n    else:\n        r\n        return 0.0\n"));
    test::check_condition(r.error_count > 0);
    test::check_condition(has(errors_of(&r), "`r`"));
}

export void test_front_types_payload_pattern_chain_ends_with_a_call_and_a_statement_follows() {
    clean(shapes("fn near(x: f32) -> bool:\n    return x < 1.0\nfn big(s: Shape) -> f32:\n"
                 "    if .circle(c) := s and not near(c.radius):\n        return c.radius\n    if near(1.0):\n"
                 "        return 2.0\n    return 0.0\n"));
}

// A pattern after a plain test (D12): `ok && .v(x) := k`, the name is in the rest of the chain and the body.
export void test_front_types_payload_pattern_chain_may_follow_a_plain_test() {
    clean(shapes("fn big(s: Shape, ok: bool) -> f32:\n    if ok and .circle(c) := s and c.radius > 1.0:\n"
                 "        return c.radius\n    return 0.0\n"));
}

export void test_front_types_payload_pattern_chain_after_a_test_does_not_leak_into_the_else() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_text(shapes("fn big(s: Shape, ok: bool) -> f32:\n    if ok and .circle(c) := s:\n"
                                         "        return 1.0\n    else:\n        return c.radius\n"));
    test::check_condition(r.error_count > 0); // `c` is not in the else (once per path the else is run by)
}

// A function with no result has no value line (#2669): the last line after a refutable binding stays a statement.
export void test_front_types_payload_binding_in_a_function_without_a_result_ends_with_a_call() {
    clean(shapes("fn note(x: f32):\n    return\nfn run(s: Shape):\n    .circle(c) := s else:\n        return\n"
                 "    note(c.radius)\n"));
}

export void test_front_types_payload_binding_in_a_function_with_a_result_returns_its_last_line() {
    clean(shapes("fn area(s: Shape) -> f32:\n    .circle(c) := s else:\n        return 0.0\n    c.radius * 2.0\n"));
}

// A path a test narrowed to its payload is still a payload enumeration to the next test of its tag (#3664):
// `if s.shape != .circle: return` and then `s.shape != .circle` again checks, as in C where the tag is read twice.
export void test_front_types_payload_tag_test_again_on_a_narrowed_path() {
    clean(shapes("struct Slot:\n    shape: Shape\nfn area(s: *Slot) -> f32:\n    if s.shape != .circle:\n"
                 "        return 0.0\n    if s.shape != .circle:\n        return 1.0\n    return s.shape.radius\n"));
}
