// `smith dbg` launches without a shell (#388): lldb's `run` expands the arguments through a shell that globs what the
// user quoted and gives up after ~10 s of wall time. smith's `run` passes them as they are; `process launch -X true`
// still expands. smith dbg is in the full smith only, so a smith without it skips these.
// A test makes its project, then sets its own memory as the current allocator: what scratch returns to it (a Run's
// texts, a file it reads) is given back with that memory, and scratch::clean frees what make holds.
module dbg_launch_test;

import scratch;
import std::arena;
import std::mem;
import std::test;
import target;

constexpr usize memory_size = (usize)16 << 20; // 16 MiB

constexpr char program[_] = "#include <stdio.h>\n"
                            "int main(int count, char **arguments) {\n"
                            "    for (int i = 1; i < count; i++) printf(\"<%s>\\n\", arguments[i]);\n"
                            "    return 0;\n"
                            "}\n";

static bool made(scratch::Project *p) {
    if (scratch::sh(p, "smith dbg --version").status != 0) return false;
    scratch::write(p, "args.c", program);
    scratch::write(p, "one.txt", "");
    scratch::write(p, "two.txt", "");
    scratch::Run built = scratch::sh(p, "smith cc -g -O0 args.c -o args 2>&1");
    scratch::expect_status("the program builds", 0, &built);
    return true;
}

export void test_macos_dbg_launch_run_passes_arguments_as_they_are() {
    scratch::Project p = scratch::make("dbg_run", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!made(&p)) return;
    scratch::Run run = scratch::sh(&p, "smith dbg -b -o 'settings set plugin.process.gdb-remote.packet-timeout 600' "
                                       "-o run args -- 'a b' '*.txt' 2>&1");
    scratch::expect_contains("run: an argument with a space stays one", run.out, "<a b>");
    scratch::expect_contains("run: a glob character stays", run.out, "<*.txt>");
    scratch::expect_lacks("run: nothing is expanded", run.out, "<one.txt>");
}

export void test_macos_dbg_launch_process_launch_with_x_true_expands() {
    scratch::Project p = scratch::make("dbg_expand", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!made(&p)) return;
    scratch::Run run = scratch::sh(&p, "smith dbg -b -o 'settings set plugin.process.gdb-remote.packet-timeout 600' "
                                       "-o 'process launch -X true' args -- '*.txt' 2>&1");
    if constexpr (target::os == target::macos) {
        scratch::expect_contains("-X true: the glob expands", run.out, "<one.txt>");
        scratch::expect_contains("-X true: ... every match", run.out, "<two.txt>");
    } else {
        // lldb-server launches without a shell and lldb's own expansion is macOS's (Host::ShellExpandArguments is
        // "unimplemented" on Linux), so the flag changes nothing there.
        scratch::expect_contains("-X true on Linux: the glob stays", run.out, "<*.txt>");
        scratch::expect_lacks("-X true on Linux: nothing is expanded", run.out, "<one.txt>");
    }
}
