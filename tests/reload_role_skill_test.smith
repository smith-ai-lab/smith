// scripts/reload_role_skill.c (issue #3383), the SessionStart hook that puts the role skill back after a compaction:
// fed a transcript that loaded `smith-dev-lead` it prints that skill, the same for `smith-dev-runner`, and fed one that
// loaded neither, or no transcript at all, it prints nothing and exits 0. Built with the system's compiler as CI builds
// the other scripts.
// smith-covers: scripts/reload_role_skill.c
module reload_role_skill_test;

import std::arena;
import std::mem;
import std::test;
import scratch;

constexpr const char *build =
    "set -e; "
    "if [ \"$(uname -s)\" = Darwin ]; then c='clang -std=c23'; else c='cc -std=gnu2x'; fi; "
    "$c -x c reload_role_skill.c -o reload_role_skill; "
    "mkdir -p skills/smith-dev-lead skills/smith-dev-runner; "
    "printf 'LEAD RULES\\nsecond line\\n' > skills/smith-dev-lead/SKILL.md; "
    "printf 'RUNNER RULES\\n' > skills/smith-dev-runner/SKILL.md; "
    "printf '%s\\n' '{\"type\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"name\":\"Skill\",\"input\":{\"skill\":\"smith-dev-lead\"}}]}' > lead.jsonl; "
    "printf '%s\\n' '{\"type\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"name\":\"Skill\",\"input\":{\"skill\":\"smith-dev-runner\"}}]}' > runner.jsonl; "
    "printf '%s\\n' '{\"type\":\"user\",\"text\":\"about smith-dev-lead and \\\"skill\\\":\\\"smith-dev-runner\\\"\"}' > neither.jsonl";

static scratch::Run hook(const scratch::Project *p, const char *transcript) {
    char command[512];
    __builtin_snprintf(command, sizeof command,
                       "printf '{\"transcript_path\":\"%s\",\"source\":\"compact\"}' | ./reload_role_skill skills", transcript);
    return scratch::sh(p, command);
}

static scratch::Project made() {
    scratch::Project p = scratch::make("p", nullptr);
    scratch::copy_tree(&p, "scripts/reload_role_skill.c", "reload_role_skill.c");
    scratch::Run run = scratch::sh(&p, build);
    scratch::expect_status("reload_role_skill: the scratch folder is made", 0, &run);
    return p;
}

export void test_reload_role_skill_prints_the_lead_skill() {
    scratch::Project p = made();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = hook(&p, "lead.jsonl");
    scratch::expect_status("reload_role_skill: exits 0", 0, &run);
    scratch::expect_text("reload_role_skill: the lead skill whole, under the line",
                         "Your role skill, reloaded after compaction:\nLEAD RULES\nsecond line\n", run.out);
}

export void test_reload_role_skill_prints_the_runner_skill() {
    scratch::Project p = made();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = hook(&p, "runner.jsonl");
    scratch::expect_text("reload_role_skill: the runner skill", "Your role skill, reloaded after compaction:\nRUNNER RULES\n",
                         run.out);
}

export void test_reload_role_skill_prints_nothing_without_a_role_skill() {
    scratch::Project p = made();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run neither = hook(&p, "neither.jsonl");
    scratch::expect_status("reload_role_skill: neither exits 0", 0, &neither);
    scratch::expect_text("reload_role_skill: neither prints nothing", "", neither.out);
    scratch::Run missing = hook(&p, "no-such-file.jsonl");
    scratch::expect_status("reload_role_skill: a missing transcript exits 0", 0, &missing);
    scratch::expect_text("reload_role_skill: and prints nothing", "", missing.out);
}
