module affine_borrow_escape_store;

export [[smith::affine]] typedef struct {
    u64 bits;
} Key;
export typedef struct {
    Key key;
    u64 n;
} Holder;
export u64 draw(Key key) {
    return key.bits;
}
export u64 peek(const Key *key) {
    return key->bits;
}
export void bump(Key *key) {
    key->bits += 1;
}

Key *saved;
export void keep(Key *key) {
    saved = key;
}
