module enum_narrowed;

typedef struct {
    F32 radius;
} Circle;
typedef struct {
    F32 w;
    F32 h;
} Rect;
typedef enum {
    Circle circle;
    Rect rect;
    empty;
} Shape;
void reset(Shape *p) {
    Shape none = .empty;
    *p = none;
}

F32 if_test(Shape s) {
    if (s == .circle) return s.circle.radius;
    return 0;
}
F32 chain(Shape s) {
    if (s == .circle) {
        return s.circle.radius;
    } else if (s == .rect) {
        return s.rect.w * s.rect.h;
    } else {
        return 0;
    }
}
F32 early_return(Shape s) {
    if (s != .circle) return 0;
    return s.circle.radius * 2;
}
F32 negated(Shape s) {
    if (!(s == .circle)) return 0;
    return s.circle.radius;
}
bool and_test(Shape s) {
    return s == .circle && s.circle.radius > 1;
}
bool or_test(Shape s) {
    return s != .circle || s.circle.radius > 1;
}
F32 conditional(Shape s) {
    return s == .rect ? s.rect.w : 0;
}
F32 area(Shape s) {
    switch (s) {
    case .circle:
        return s.circle.radius * s.circle.radius * 3;
    case .rect:
        return s.rect.w * s.rect.h;
    case .empty:
        return 0;
    }
    return -1;
}
void grow(Shape *p) {
    switch (*p) {
    case .circle:
        p->circle.radius *= 2;
        break;
    case .rect:
        p->rect.w *= 2;
        p->rect.h *= 2;
        break;
    case .empty:
        break;
    }
}
F32 pointer_if(Shape *p) {
    if (*p == .circle) {
        p->circle.radius = 1;
        return p->circle.radius;
    }
    return 0;
}
F32 loop_body(Shape *list, I32 n) {
    F32 sum = 0;
    for (I32 i = 0; i < n; i++) {
        if (list[i] == .circle) sum += 1;
    }
    Shape first = list[0];
    for (I32 i = 0; i < n; i++) {
        if (first == .rect) sum += first.rect.w;
    }
    return sum;
}
F32 while_test(Shape s, I32 n) {
    F32 sum = 0;
    while (s == .circle && n > 0) {
        sum += s.circle.radius;
        n--;
    }
    return sum;
}
F32 shared_case(Shape s) {
    switch (s) {
    case .circle:
    case .rect:
        return 1;
    case .empty:
        return 0;
    }
    return 0;
}
F32 member_of_a_struct(Shape *list) {
    if (list[0] == .circle) return 1;
    return 0;
}
F32 reread_after_payload_write(Shape *p) {
    if (*p != .circle) return 0;
    p->circle.radius = 2;
    F32 r = p->circle.radius;
    return r + p->circle.radius;
}
