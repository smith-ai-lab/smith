module affine_second_use;

export [[std::affine]] typedef struct {
    u64 bits;
} Key;
export typedef struct {
    Key key;
    u64 n;
} Holder;
export u64 draw(Key key) {
    return key.bits;
}
export void split(Key key, Key keys[3]) {
    (void)key;
    (void)keys;
}
export void split_all(Key key, Key keys[:]) {
    (void)key;
    (void)keys;
}
export u64 take(Key *key) {
    return key->bits;
}

u64 twice(Key key) {
    u64 a = draw(key);
    u64 b = draw(key);
    return a + b;
}
