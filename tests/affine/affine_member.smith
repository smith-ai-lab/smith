module affine_member;

export [[smith::affine]] typedef struct {
    u64 bits;
} Key;
export typedef struct {
    Key key;
    u64 n;
} Holder;
export u64 draw(Key key) {
    return key.bits;
}
export void split(Key key, Key keys[3]) {
    (void)key;
    (void)keys;
}
export void split_all(Key key, Key keys[:]) {
    (void)key;
    (void)keys;
}
export u64 take(Key *key) {
    return key->bits;
}

u64 member(Holder h) {
    u64 a = draw(h.key);
    return a + draw(h.key) + h.n;
}
u64 other(Holder h) {
    return draw(h.key) + h.n;
}
