module affine_member;

export [[std::affine]] typedef struct {
    U64 bits;
} Key;
export typedef struct {
    Key key;
    U64 n;
} Holder;
export U64 draw(Key key) {
    return key.bits;
}
export void split(Key key, Key keys[3]) {
    (void)key;
    (void)keys;
}
export void split_all(Key key, Key keys[:]) {
    (void)key;
    (void)keys;
}
export U64 take(Key *key) {
    return key->bits;
}

U64 member(Holder h) {
    U64 a = draw(h.key);
    return a + draw(h.key) + h.n;
}
U64 other(Holder h) {
    return draw(h.key) + h.n;
}
