module affine_issue_reassign;

export [[std::affine]] typedef struct {
    U64 bits;
} Key;
export typedef struct {
    Key key;
    U64 n;
} Holder;
export U64 draw(Key key) {
    return key.bits;
}
export void split(Key key, Key keys[3]) {
    (void)key;
    (void)keys;
}
export void split_all(Key key, Key keys[:]) {
    (void)key;
    (void)keys;
}
export U64 take(Key *key) {
    return key->bits;
}

U64 stream(Key key, Usize count) {
    U64 total = 0;
    for (Usize i = 0; i < count; i++) {
        Key next[3];
        split(key, next);
        key = next[0];
        total += draw(next[1]);
    }
    return total;
}
