module affine_plain_loop;

export [[std::affine]] typedef struct {
    U64 bits;
} Key;
export typedef struct {
    Key key;
    U64 n;
} Holder;
export U64 draw(Key key) {
    return key.bits;
}
export void split(Key key, Key keys[3]) {
    (void)key;
    (void)keys;
}
export void split_all(Key key, Key keys[:]) {
    (void)key;
    (void)keys;
}
export U64 take(Key *key) {
    return key->bits;
}

U64 plain(Key key) {
    Key keys[3];
    split(key, keys);
    U64 total = 0;
    for (Usize i = 0; i < 3; i++)
        total += draw(keys[i]);
    return total;
}
