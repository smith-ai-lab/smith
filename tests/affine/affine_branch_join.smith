module affine_branch_join;

export [[std::affine]] typedef struct {
    U64 bits;
} Key;
export typedef struct {
    Key key;
    U64 n;
} Holder;
export U64 draw(Key key) {
    return key.bits;
}
export void split(Key key, Key keys[3]) {
    (void)key;
    (void)keys;
}
export void split_all(Key key, Key keys[:]) {
    (void)key;
    (void)keys;
}
export U64 take(Key *key) {
    return key->bits;
}

U64 join(Key key, int c) {
    U64 a = 0;
    if (c) a = draw(key);
    return a + draw(key);
}
U64 branches(Key key, int c) {
    if (c) return draw(key);
    return draw(key) + 1;
}
