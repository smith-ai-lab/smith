module affine_branch_join;

export [[smith::affine]] typedef struct { u64 bits; } Key;
export typedef struct { Key key; u64 n; } Holder;
export u64 draw(Key key) { return key.bits; }
export void split(Key key, Key keys[3]) { (void)key; (void)keys; }
export void split_all(Key key, Key keys[:]) { (void)key; (void)keys; }
export u64 take(Key *key) { return key->bits; }

u64 join(Key key, int c) {
    u64 a = 0;
    if (c) a = draw(key);
    return a + draw(key);
}
u64 branches(Key key, int c) {
    if (c) return draw(key);
    return draw(key) + 1;
}
