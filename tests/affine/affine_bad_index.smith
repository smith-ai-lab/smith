module affine_bad_index;

export [[std::affine]] typedef struct {
    U64 bits;
} Key;
export typedef struct {
    Key key;
    U64 n;
} Holder;
export U64 draw(Key key) {
    return key.bits;
}
export void split(Key key, Key keys[3]) {
    (void)key;
    (void)keys;
}
export void split_all(Key key, Key keys[:]) {
    (void)key;
    (void)keys;
}
export U64 take(Key *key) {
    return key->bits;
}

U64 bad(Key key, Usize j) {
    Key keys[3];
    split(key, keys);
    return draw(keys[j]);
}
U64 shifted(Key key) {
    Key keys[3];
    split(key, keys);
    U64 total = 0;
    for (Usize i = 0; i < 2; i++)
        total += draw(keys[i + 1]);
    return total;
}
