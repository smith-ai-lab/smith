module affine_random_plain_loop;

import smith::random;

export void fixed_array(random::Key key, f64 xs[3]) {
    random::Key per_item[3];
    random::split(key, per_item);
    random::UniformDouble uniform = {.low = 0, .high = 1};
    for (usize i = 0; i < 3; i++)
        xs[i] = random::uniform_double_sample(per_item[i], uniform);
}

export void slice(random::Key key, random::Key per_item[:], f64 xs[:]) {
    random::split(key, per_item);
    random::UniformDouble uniform = {.low = 0, .high = 1};
    for (usize i = 0; i < countof(per_item); i++)
        xs[i] = random::uniform_double_sample(per_item[i], uniform);
}

export void reassign(random::Key key, f64 xs[:]) {
    random::UniformDouble uniform = {.low = 0, .high = 1};
    for (usize i = 0; i < countof(xs); i++) {
        random::Key next[2];
        random::split(key, next);
        key = next[0];
        xs[i] = random::uniform_double_sample(next[1], uniform);
    }
}
