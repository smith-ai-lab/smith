module enum_read_unchecked;

typedef struct {
    F32 radius;
} Circle;
typedef struct {
    F32 w;
    F32 h;
} Rect;
typedef enum {
    Circle circle;
    Rect rect;
    empty;
} Shape;
void reset(Shape *p) {
    Shape none = .empty;
    *p = none;
}

F32 bare(Shape s) {
    return s.circle.radius;
}
F32 through_pointer(Shape *p) {
    return p->circle.radius;
}
F32 wrong_variant(Shape s) {
    if (s == .rect) return s.circle.radius;
    return 0;
}
F32 else_branch(Shape s) {
    if (s == .circle) return 0;
    return s.circle.radius;
}
F32 one_path(Shape s, bool b) {
    if (b) {
        if (s != .circle) return 0;
    }
    return s.circle.radius;
}
F32 or_branch(Shape s) {
    if (s == .circle || s.circle.radius > 1) return 1;
    return 0;
}
void write_without_tag(Shape *p) {
    p->rect.w = 1;
}
F32 loop_changes(Shape s, I32 n) {
    Shape none = .empty;
    F32 sum = 0;
    if (s != .circle) return 0;
    for (I32 i = 0; i < n; i++) {
        sum += s.circle.radius;
        s = none;
    }
    return sum;
}
