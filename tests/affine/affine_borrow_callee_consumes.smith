module affine_borrow_callee_consumes;

export [[smith::affine]] typedef struct {
    u64 bits;
} Key;
export typedef struct {
    Key key;
    u64 n;
} Holder;
export u64 draw(Key key) {
    return key.bits;
}
export u64 peek(const Key *key) {
    return key->bits;
}
export void bump(Key *key) {
    key->bits += 1;
}

export u64 grab(const Key *key) {
    return draw(*key);
}
export void copy(const Key *key) {
    Key y = *key;
    (void)y;
}
