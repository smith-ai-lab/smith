module affine_loop_outer;

export [[std::affine]] typedef struct {
    U64 bits;
} Key;
export typedef struct {
    Key key;
    U64 n;
} Holder;
export U64 draw(Key key) {
    return key.bits;
}
export void split(Key key, Key keys[3]) {
    (void)key;
    (void)keys;
}
export void split_all(Key key, Key keys[:]) {
    (void)key;
    (void)keys;
}
export U64 take(Key *key) {
    return key->bits;
}

U64 loop(Key key, Usize n) {
    U64 total = 0;
    for (Usize i = 0; i < n; i++)
        total += draw(key);
    return total;
}
