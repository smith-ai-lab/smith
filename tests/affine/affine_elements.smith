module affine_elements;

export [[std::affine]] typedef struct {
    U64 bits;
} Key;
export typedef struct {
    Key key;
    U64 n;
} Holder;
export U64 draw(Key key) {
    return key.bits;
}
export void split(Key key, Key keys[3]) {
    (void)key;
    (void)keys;
}
export void split_all(Key key, Key keys[:]) {
    (void)key;
    (void)keys;
}
export U64 take(Key *key) {
    return key->bits;
}

U64 elements(Key key) {
    Key keys[3];
    split(key, keys);
    U64 a = draw(keys[0]);
    U64 b = draw(keys[1]);
    U64 c = draw(keys[0]);
    return a + b + c;
}
