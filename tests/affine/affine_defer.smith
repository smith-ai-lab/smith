module affine_defer;

export [[std::affine]] typedef struct {
    U64 bits;
} Key;
export U64 draw(Key key) {
    return key.bits;
}
export void sink(U64 value) {
    (void)value;
}

// A use inside a deferred statement is a use, and a block with defers does not stop the analysis (issue #210).
U64 once(Key key) {
    U64 n = 1;
    defer sink(n);
    return draw(key);
}

U64 twice(Key key) {
    U64 a = 0;
    defer a = draw(key);
    return draw(key) + a;
}
