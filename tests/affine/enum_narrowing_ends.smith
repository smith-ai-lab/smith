module enum_narrowing_ends;

typedef struct {
    F32 radius;
} Circle;
typedef struct {
    F32 w;
    F32 h;
} Rect;
typedef enum {
    Circle circle;
    Rect rect;
    empty;
} Shape;
void reset(Shape *p) {
    Shape none = .empty;
    *p = none;
}

F32 assigned(Shape s) {
    Shape none = .empty;
    if (s == .circle) {
        s = none;
        return s.circle.radius;
    }
    return 0;
}
F32 address_taken(Shape s) {
    if (s != .circle) return 0;
    Shape *p = &s;
    reset(p);
    return s.circle.radius;
}
F32 call_with_pointer(Shape *p) {
    if (*p != .circle) return 0;
    reset(p);
    return p->circle.radius;
}
F32 pointer_assigned(Shape *p, Shape *q) {
    if (*p == .circle) {
        p = q;
        return p->circle.radius;
    }
    return 0;
}
F32 whole_value_through_pointer(Shape *p) {
    Shape none = .empty;
    switch (*p) {
    case .circle:
        *p = none;
        return p->circle.radius;
    case .rect:
    case .empty:
        break;
    }
    return 0;
}
F32 new_variable_each_turn(Shape *list, I32 n) {
    F32 sum = 0;
    for (I32 i = 0; i < n; i++) {
        Shape s = list[i];
        sum += s.circle.radius;
    }
    return sum;
}
