module affine_range_for;

export [[std::affine]] typedef struct {
    u64 bits;
} Key;
export u64 draw(Key key) {
    return key.bits;
}

// A range `for` hands each element once, so a key drawn from in the body is used once per turn.
u64 once(Key keys[:]) {
    u64 total = 0;
    for (Key k : keys) {
        total += draw(k);
    }
    return total;
}

u64 twice(Key keys[:]) {
    u64 total = 0;
    for (Key k : keys) {
        total += draw(k);
        total += draw(k);
    }
    return total;
}
