module affine_range_for;

export [[std::affine]] typedef struct {
    U64 bits;
} Key;
export U64 draw(Key key) {
    return key.bits;
}

// A range `for` hands each element once, so a key drawn from in the body is used once per turn.
U64 once(Key keys[:]) {
    U64 total = 0;
    for (Key k : keys) {
        total += draw(k);
    }
    return total;
}

U64 twice(Key keys[:]) {
    U64 total = 0;
    for (Key k : keys) {
        total += draw(k);
        total += draw(k);
    }
    return total;
}
