module affine_random_split;

import std::random;

export F64 two_draws(random::Key key) {
    random::Key keys[3];
    random::split(key, keys);
    random::NormalDouble normal = {.mean = 0, .deviation = 1};
    F64 a = random::normal_double_sample(keys[0], normal);
    F64 b = random::normal_double_sample(keys[0], normal);
    return a + b;
}

export F64 three_draws(random::Key key) {
    random::Key keys[3];
    random::split(key, keys);
    random::NormalDouble normal = {.mean = 0, .deviation = 1};
    return random::normal_double_sample(keys[0], normal) + random::normal_double_sample(keys[1], normal) +
           random::normal_double_sample(keys[2], normal);
}
