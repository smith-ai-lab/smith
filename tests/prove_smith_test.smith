// `smith prove` on a real move generator, on a run with nothing to prove, on `--function`, and on modules and projects
// written in .smith, from sections 8 to 11f of tests/prove.sh (issue #292): functions named as written
// (geometry::box::clamp), array and slice parameters, counts, a project of .smith sources (primes, libs, slices, clamp
// in tests/build_fixtures/prove_cases) and the note about memory a callee may write. The programs are tests/prove/*.c
// and tests/prove/geometry/*.smith ($c); the helpers are in tests/prove_cases.smith. See
// tests/prove_test.smith for the proofs' cache and budget.
module prove_smith_test;

import smith::format;
import smith::io;
import smith::test;
import scratch;
import prove_cases;

static scratch::Project fresh(io::Io *io) {
    return scratch::project(io, "p", "prove_cases");
}

// `smith prove args -- -I include`, both streams together.
static scratch::Run prove(const scratch::Project *p, const char *args) {
    return prove_cases::prove(p, args);
}

static scratch::Run proved(const scratch::Project *p, const char *name, const char *args) {
    scratch::Run run = prove(p, args);
    scratch::expect_status(name, 0, &run);
    return run;
}

static scratch::Run refuted(const scratch::Project *p, const char *name, const char *args) {
    scratch::Run run = prove(p, args);
    scratch::expect_status(name, 1, &run);
    return run;
}

static void has(const char *name, const scratch::Run *run, const char *needle) {
    scratch::expect_contains(name, run->out, needle);
}

// A command in a project folder of the fixture (`cd folder && smith prove ...`), both streams together.
static scratch::Run in_folder(const scratch::Project *p, const char *folder, const char *arguments) {
    return scratch::sh(p, format::push(&p->io->arena, "cd ", folder, " && smith prove ", arguments, " 2>&1").data);
}

// 8. checkers' move generator, with the contracts of the issue: the fixed one is proved within the budget, and the one
// before the fixes (else-if, col > 1) fails with a counterexample.
export void test_prove_checkers_the_fixed_get_valid_diagonals_is_proved_in_the_budget(io::Io *io) {
    scratch::Project p = fresh(io);
    proved(&p, "checkers: the fixed get_valid_diagonals is proved in the budget",
           "--function=get_valid_diagonals \"$c/diagonals.c\"");
}

export void test_prove_checkers_the_append_the_move_generator_uses_is_proved(io::Io *io) {
    scratch::Project p = fresh(io);
    proved(&p, "checkers: the append the move generator uses is proved, so its contract can be used",
           "--function=push_move \"$c/diagonals_prefix.c\"");
}

export void test_prove_checkers_the_one_before_its_fixes_fails_on_the_legal_moves_it_misses(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = refuted(&p, "checkers: the one before its fixes fails",
                               "--function=get_valid_diagonals \"$c/diagonals_prefix.c\"");
    has("checkers: ... on the legal moves it misses", &run, "added_every_legal_step");
    has("checkers: ... with a counterexample", &run, "counterexample: ");
}

// 9. Nothing to prove, and the counts of a run.
export void test_prove_no_contract_nothing_is_proved_and_that_is_a_success(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::write(&p, "plain.c", "int main(void) { return 0; }\n");
    scratch::Run run = proved(&p, "no contract: and that is a success", "plain.c");
    has("no contract: nothing is proved, and it says so", &run, "nothing to prove: no function with smith_requires");
}

export void test_prove_function_that_matches_nothing_says_so_and_fails(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::write(&p, "plain.c", "int main(void) { return 0; }\n");
    scratch::Run run = refuted(&p, "--function that matches nothing fails", "--function=nothing plain.c");
    has("--function that matches nothing says so", &run, "by that name");
}

// 10. A --function that names no function the prover read is an error, never a skip.
export void test_prove_function_of_an_unemitted_static_fails_with_the_cause_and_the_fix(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = refuted(&p, "--function of an unemitted static: fails",
                               "--function=harness_kept --function=harness_dropped \"$c/static_harness.c\"");
    has("... and names it", &run, "--function=harness_dropped: no function by that name");
    has("... with the likely cause", &run, "static function that nothing calls");
    has("... and the fix", &run, "[[gnu::used]]");
}

export void test_prove_function_of_a_kept_static_is_proved(io::Io *io) {
    scratch::Project p = fresh(io);
    proved(&p, "--function of a kept static: proved", "--function=harness_kept \"$c/static_harness.c\"");
}

export void test_prove_function_of_a_function_with_no_contract_fails_saying_there_is_nothing_to_prove(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = refuted(&p, "--function of a function with no contract: fails",
                               "--function=no_contract \"$c/static_harness.c\"");
    has("... says there is nothing to prove", &run, "so there is nothing to prove");
}

// 11. A module written in .smith is compiled as `smith cc` compiles it, and its functions are named as written
// (geometry::box::clamp, never geometry_box_clamp), in the report, in -v and in --function.
export void test_prove_smith_module_a_contract_in_a_smith_function_is_proved_and_named_as_written(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = proved(&p, "smith module: a contract in a .smith function is proved",
                              "-v --function=geometry::box::clamp \"$c/geometry/box.smith\"");
    has("smith module: ... named as written, with its line", &run, "ok    geometry::box::clamp  (");
    has("smith module: ... with its line", &run, "geometry/box.smith:5)");
}

export void test_prove_smith_module_a_contract_that_is_false_fails_at_the_smith_line_with_the_values(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = refuted(&p, "smith module: a contract that is false fails",
                               "--function=geometry::box::clamp_wrong \"$c/geometry/box.smith\"");
    has("smith module: ... named as written", &run, "FAIL  geometry::box::clamp_wrong");
    has("smith module: ... at the .smith line", &run,
        "geometry/box.smith:15: smith_ensures(result < high) may be false");
    has("smith module: ... with the values", &run, "counterexample: high = ");
}

export void test_prove_smith_module_undefined_behaviour_is_at_the_smith_line(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = prove(&p, "--function=geometry::box::add_unchecked \"$c/geometry/box.smith\"");
    has("smith module: undefined behaviour is at the .smith line", &run,
        "geometry/box.smith:21: undefined behaviour: signed integer addition overflow");
}

export void test_prove_smith_module_a_caller_that_breaks_a_contract_names_the_callee_as_written(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = prove(&p, "--function=geometry::box::caller \"$c/geometry/box.smith\"");
    has("smith module: a caller that breaks a contract names the callee as written", &run,
        "the call of geometry::box::clamp may break smith_requires(low <= high)");
    has("smith module: ... and the values by their written names", &run,
        "geometry::box::clamp.low = 10 geometry::box::clamp.high = 5");
}

export void test_prove_smith_module_all_of_them(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = prove(&p, "\"$c/geometry/box.smith\"");
    has("smith module: all of them", &run, "1 proved, 3 failed");
}

// 11a. A parameter written as an array in a module is N objects (#81): an index in range needs no other contract.
export void test_prove_smith_module_xs_i_of_an_array_parameter_is_proved_with_only_i_below_4(io::Io *io) {
    scratch::Project p = fresh(io);
    proved(&p, "smith module: xs[i] of an array parameter xs[4] is proved with only i < 4",
           "--function=geometry::rows::pick \"$c/geometry/rows.smith\"");
}

export void test_prove_smith_module_m_row_1_of_an_array_parameter_is_proved_with_only_row_below_3(io::Io *io) {
    scratch::Project p = fresh(io);
    proved(&p, "smith module: m[row][1] of an array parameter m[3][2] is proved with only row < 3",
           "--function=geometry::rows::corner \"$c/geometry/rows.smith\"");
}

export void test_prove_smith_module_an_index_that_may_be_past_the_array_is_refused(io::Io *io) {
    scratch::Project p = fresh(io);
    refuted(&p, "smith module: an index that may be past the array is refused",
            "--function=geometry::rows::unchecked \"$c/geometry/rows.smith\"");
}

// 11a2. A `T xs[:]` parameter points at countof(xs) elements (#106): an index in range needs no contract, one that may
// be out of range fails at the index, a loop over it is bounded by a requires on countof, and a view of a pointer is
// held to what the pointer is known to point at.
export void test_prove_smith_slice_indexes_in_range_are_proved(io::Io *io) {
    scratch::Project p = fresh(io);
    prove_cases::each_proved(&p, "smith slice: at total last_of_tail first_of_one of_four are proved",
                             "\"$c/geometry/slices.smith\"",
                             "geometry::slices::", "at total last_of_tail first_of_one of_four");
}

export void test_prove_smith_slice_an_index_that_may_be_past_the_count_is_refused_at_its_line(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = refuted(&p, "smith slice: an index that may be past the count is refused",
                               "--function=geometry::slices::unchecked \"$c/geometry/slices.smith\"");
    has("smith slice: ... as an index out of range, at its line", &run,
        "slices.smith:14: assert(an index or a slice is in range) may fail");
}

export void test_prove_smith_slice_a_view_of_two_elements_of_a_pointer_to_one_is_refused(io::Io *io) {
    scratch::Project p = fresh(io);
    refuted(&p, "smith slice: a view of two elements of a pointer to one is refused",
            "--function=geometry::slices::second_of_one \"$c/geometry/slices.smith\"");
}

// 11a3. A count of what a caller's memory holds, under a requires on its bound, is proved (#187), and a false bound
// still fails.
export void test_prove_smith_counting_a_count_under_a_requires_on_its_bound_is_proved(io::Io *io) {
    scratch::Project p = fresh(io);
    prove_cases::each_proved(&p, "smith counting: positives positives_of_slice are proved",
                             "\"$c/geometry/counting.smith\"", "geometry::counting::", "positives positives_of_slice");
}

export void test_prove_smith_counting_a_bound_that_is_too_small_fails_at_its_line(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = refuted(&p, "smith counting: a bound that is too small fails",
                               "--function=geometry::counting::positives_wrong \"$c/geometry/counting.smith\"");
    has("smith counting: ... at its line", &run, "counting.smith:33: smith_ensures(hits <= 3) may be false");
}

// 11b. The project verb proves .smith sources too (issue #42): a convention project, no build file, with a contract in
// a module and a trusted function written with c::smith_trusted().
export void test_prove_project_a_smith_projects_contracts_are_proved_as_written(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = in_folder(&p, "primes", "-v --emit-ir=../project-ir.ll");
    scratch::expect_status("project: a .smith project's contracts are proved", 0, &run);
    has("project: ... as written", &run, "ok    primes::sum  (primes.smith:14)");
    has("project: ... through a trusted function's contract", &run, "ok    primes::shown_sum  (");
    has("project: ... the trusted function is listed", &run, "trusted  primes::show  (primes.smith:6)");
    has("project: ... with the counts", &run, "2 proved, 0 failed, 1 trusted");
    scratch::expect_lacks("project: a .smith project is not nothing to prove", run.out, "nothing to prove");
    const char *ir = scratch::read(&p, "project-ir.ll");
    scratch::expect_contains("project: --emit-ir writes the IR of every function", ir, "; primes::shown_sum (");
    scratch::expect_contains("project: ... and of the first", ir, "; primes::sum (");
}

export void test_prove_project_a_wrong_contract_in_a_smith_module_is_refuted_at_the_smith_line(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run edited = scratch::sh(&p, "sed -i.bak 's/total <= 28/total <= 27/' primes/primes.smith");
    scratch::expect_status("project: the contract is made wrong", 0, &edited);
    scratch::Run run = in_folder(&p, "primes", "");
    scratch::expect_status("project: a wrong contract in a .smith module is refuted", 1, &run);
    has("project: ... at the .smith line, with the values", &run,
        "primes.smith:21: smith_ensures(total >= 0 && total <= 27) may be false");
    has("project: ... counterexample", &run, "counterexample: count = 5");
}

export void test_prove_project_the_provers_options_are_the_projects_too(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = in_folder(&p, "primes", "--budget=30 -v");
    has("project: the prover's options are the project's too (-v, --budget=)", &run, "ok    primes::shown_sum");
}

// 11c. A project's proof reads smith's libraries for their contracts (issue #66): a proved function may call a library
// export, whatever the library marks it with, and is proved against the library's contract. The library's own functions
// are not proved there.
export void test_prove_libraries_a_call_of_a_library_export_is_proved_against_its_contract(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = in_folder(&p, "libs", "-v");
    scratch::expect_status("libraries: a proved function that calls a library export is proved", 0, &run);
    has("libraries: ... against the library's contract", &run, "ok    libs::pick  (");
    has("libraries: ... and only the project's functions are counted", &run, "1 proved, 0 failed");
    scratch::expect_lacks("libraries: no 'neither a body nor a contract' for a library function", run.out,
                          "neither a body nor a contract");
    scratch::expect_lacks("libraries: the library's own functions are not proved or listed", run.out, "random::");
}

// 11d. A slice in a project links the trace library, whose smith_failure has a body: the check's failure is still the
// proof point (issue #151), a guarded index is proved and an unguarded one is refuted, never "a call of pthread_self".
export void test_prove_slices_in_a_project_the_unguarded_index_is_refuted_and_the_guarded_one_proved(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = in_folder(&p, "slices", "-v");
    scratch::expect_status("slices in a project: the unguarded index is refuted", 1, &run);
    has("slices in a project: a guarded index is proved", &run, "ok    stats::first  (");
    has("slices in a project: the unguarded index fails at its check", &run,
        "assert(an index or a slice is in range) may fail");
    scratch::expect_lacks("slices in a project: the trace library's body is not read (pthread_self)", run.out,
                          "pthread_self");
    scratch::expect_lacks("slices in a project: ... nor a call with neither a body nor a contract", run.out,
                          "neither a body nor a contract");
}

// 11e. The messages (issue #155): an instance is named as written in smith (clamp<i32>), and the note that a callee
// "may write memory it was not given" is only for a function that does, never a pure generic.
export void test_prove_messages_an_instance_is_named_as_written(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = in_folder(&p, "clamp", "-v");
    scratch::expect_status("messages: a call that breaks a requires fails", 1, &run);
    has("messages: the failure names the instance as written", &run,
        "the call of stats::clamp<i32> may break smith_requires(low <= high)");
    has("messages: -v names it the same way", &run, "ok    stats::clamp<i32>  (");
    scratch::expect_lacks("messages: no C type in an instance's name", run.out, "<int>");
    scratch::expect_lacks("messages: a pure generic is not said to write memory", run.out, "may write memory");
}

// 11f. The note about memory a callee may write (issue #155) names what LLVM found in the body.
export void test_prove_write_note_a_callee_that_stores_to_a_global_says_so(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = prove(&p, "-v \"$c/global_writer.c\"");
    has("write note: a callee that stores to a global is said to write memory it was not given", &run,
        "bump may write memory it was not given (LLVM found a store to the global counter at line 8 in the body)");
}

// 11g. A program that prints through console::print and a module with contracts (issue #508): the snapshot of a
// modular function drops the branches to a trap, and a phi in the trap block (the file name a failure reports) must
// lose its entry for the dropped edge, or the linked module does not verify.
constexpr char printing_stats[_] = "module stats;\n"
                                   "\n"
                                   "import smith::contract;\n"
                                   "\n"
                                   "export i32 largest(i32 xs[:]) {\n"
                                   "    contract::requires(countof(xs) > 0);\n"
                                   "    i32 best = xs[0];\n"
                                   "    for (usize i = 1; i < countof(xs); i++) {\n"
                                   "        contract::invariant(1 <= i && i <= countof(xs));\n"
                                   "        best = xs[i] > best ? xs[i] : best;\n"
                                   "    }\n"
                                   "    return best;\n"
                                   "}\n";

constexpr char printing_main[_] = "module main;\n"
                                  "\n"
                                  "import smith::console;\n"
                                  "import stats;\n"
                                  "\n"
                                  "i32 main() {\n"
                                  "    i32 raw[_] = {-3, 1, 9, 4};\n"
                                  "    i32 readings[:] = raw;\n"
                                  "    console::print(\"largest \", stats::largest(readings[1:]), \"\\n\");\n"
                                  "    return 0;\n"
                                  "}\n";

export void test_prove_a_program_that_prints_proves_a_module_with_contracts(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::write(&p, "stats.smith", printing_stats);
    scratch::write(&p, "main.smith", printing_main);
    scratch::Run run = scratch::sh(&p, "smith prove 2>&1");
    scratch::expect_status("a program that prints, with a module with contracts, proves", 0, &run);
    scratch::expect_lacks("the linked module verifies", run.out, "does not verify");
}
