// Tests of <smith/json.h>, in smith's own test library; tests/json.sh builds them in a scratch project as
// tests/json_test.smith. The checks are: known tokens, trees, errors with their offsets and reasons, and the writer's
// exact text; property tests on keys (any document written then read gives the same events, and every f64 and
// integer comes back exactly); fuzzing (damaged documents never crash, hang or read outside the input, and the pull
// parser and the tree agree on which are valid); and JSONTestSuite's cases when tests/json.sh gives their folder.
module json_test;

import smith::arena;
import smith::format;
import smith::io;
import smith::math;
import smith::random;
import smith::test;
import smith::text;
import <smith/json.h>;
import <stdio.h>;
import <stdlib.h>;
import <string.h>;

// The bytes of a buffer, for the calls of io that take a slice.
static typeof(const u8[:]) test_io_bytes(const void *data, usize size) {
    const u8 *bytes = data;
    return bytes[0:size];
}

// The C headers write these as macros (DBL_MAX, INT64_MIN), which a .smith file does not use.
constexpr i64 i64_max = 9223372036854775807;
constexpr i64 i64_min = -9223372036854775807 - 1;
constexpr f64 f64_max = 0x1.fffffffffffffp+1023;

constexpr c::SmithJsonLimits test_json_wide = {.depth = 64, .string_length = 1 << 16, .count = 1 << 16};

static typeof(const char[:]) test_json_text(const char *string) {
    return text::make(string);
}

// The next key of a stream: `stream` moves on (the reassignment pattern) and the key returned is for one use.
static random::Key take(random::Key *stream) {
    random::Key next[2];
    random::split(*stream, next);
    *stream = next[0];
    return next[1];
}

static i64 test_json_uniform(random::Key key, i64 low, i64 high) {
    return random::uniform_int64_sample(key, (random::UniformInt64){.low = low, .high = high});
}

// ---------------------------------------------------------------------------------------------------------------
// The pull parser

typedef struct {
    c::SmithJsonToken token;
    usize offset;
} TestJsonStep;

export void test_json_reader_tokens_of_a_document() {
    const char input[:] = test_json_text("{\"a\": [1, true, null, \"x\"],\n \"b\": {}}");
    c::SmithJsonReader reader = c::smith_json_reader_make(input, test_json_wide);
    const TestJsonStep expected[] = {
        {c::SmithJsonToken_ObjectBegin, 0},  {c::SmithJsonToken_Key, 1},        {c::SmithJsonToken_ArrayBegin, 6},
        {c::SmithJsonToken_Number, 7},       {c::SmithJsonToken_True, 10},      {c::SmithJsonToken_Null, 16},
        {c::SmithJsonToken_String, 22},      {c::SmithJsonToken_ArrayEnd, 25},  {c::SmithJsonToken_Key, 29},
        {c::SmithJsonToken_ObjectBegin, 34}, {c::SmithJsonToken_ObjectEnd, 35}, {c::SmithJsonToken_ObjectEnd, 36},
        {c::SmithJsonToken_End, 37},
    };
    for (usize i = 0; i < _Countof expected; i++) {
        c::SmithJsonToken token = c::smith_json_read(&reader);
        test::note("step %zu", i);
        test::check(token == expected[i].token);
        test::check_equal(reader.offset, expected[i].offset);
    }
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_End); // End stays End
}

export void test_json_reader_keys_and_numbers() {
    c::SmithJsonReader reader = c::smith_json_reader_make(test_json_text("{\"k\\u00e9y\": -12.5e+3}"), test_json_wide);
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_ObjectBegin);
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_Key);
    test::check(reader.escaped);
    test::check_equal(reader.length, 4); // k, the two bytes of e-acute, y
    test::check(c::smith_json_is(&reader, "k\xc3\xa9y"));
    test::check(!c::smith_json_is(&reader, "k\xc3\xa9"));
    test::check(!c::smith_json_is(&reader, "k\xc3\xa9yz"));
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_Number);
    test::check(text::is(reader.text, "-12.5e+3"));
    f64 value = 0;
    test::check(text::parse_f64(reader.text, &value));
    test::check_same_bits(value, -12500.0);
    i64 integer = 0;
    test::check(!text::parse_i64(reader.text, &integer)); // not an integer as written
}

export void test_json_reader_skips_values() {
    c::SmithJsonReader reader = c::smith_json_reader_make(
        test_json_text("{\"skip\": {\"x\": [1, [2, {\"y\": 3}]]}, \"keep\": 7, \"more\": [1]}"), test_json_wide);
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_ObjectBegin);
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_Key);
    test::check(c::smith_json_is(&reader, "skip"));
    test::check(c::smith_json_skip(&reader)); // a key skips its value
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_Key);
    test::check(c::smith_json_is(&reader, "keep"));
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_Number);
    test::check(c::smith_json_skip(&reader)); // a scalar skips nothing
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_Key);
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_ArrayBegin);
    test::check(c::smith_json_skip(&reader));
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_ObjectEnd);
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_End);
    c::SmithJsonReader broken = c::smith_json_reader_make(test_json_text("[1, [2, }]"), test_json_wide);
    test::check(c::smith_json_read(&broken) == c::SmithJsonToken_ArrayBegin);
    test::check(!c::smith_json_skip(&broken));
    test::check(broken.error.reason == c::SmithJsonReason_UnexpectedCharacter);
    test::check_equal(broken.error.offset, 8);
}

export void test_json_reader_an_error_is_final() {
    c::SmithJsonReader reader = c::smith_json_reader_make(test_json_text("[1, x]"), test_json_wide);
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_ArrayBegin);
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_Number);
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_Error);
    c::SmithJsonError first = reader.error;
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_Error);
    test::check_equal(reader.error.offset, first.offset);
    test::check(first.reason == c::SmithJsonReason_UnexpectedCharacter);
    test::check_equal(first.offset, 4);
}

// ---------------------------------------------------------------------------------------------------------------
// Errors: the offset and the reason

typedef struct {
    const char *input;
    c::SmithJsonReason reason;
    usize offset;
} TestJsonError;

static void test_json_check_errors(const TestJsonError *cases, usize count) {
    arena::Arena arena = test::memory(1 << 16);
    for (usize i = 0; i < count; i++) {
        test::note("input \"%s\"", cases[i].input);
        const c::SmithJsonValue *root = nullptr;
        c::SmithJsonError error = {};
        const char input[:] = cases[i].input[0:c::strlen(cases[i].input)];
        test::check(!c::smith_json_parse(&arena, input, test_json_wide, &root, &error));
        test::check(error.reason == cases[i].reason);
        test::check_equal(error.offset, cases[i].offset);
        test::check_equal(arena.used, 0);
        c::SmithJsonReader reader = c::smith_json_reader_make(input, test_json_wide);
        c::SmithJsonToken token = c::SmithJsonToken_Null;
        for (usize step = 0;
             step <= countof(input) + 1 && token != c::SmithJsonToken_Error && token != c::SmithJsonToken_End; step++) {
            token = c::smith_json_read(&reader);
        }
        test::check(token == c::SmithJsonToken_Error);
        test::check_equal(reader.error.offset, cases[i].offset);
    }
}

export void test_json_structure_errors() {
    const TestJsonError cases[] = {
        {"", c::SmithJsonReason_UnexpectedEnd, 0},
        {"   ", c::SmithJsonReason_UnexpectedEnd, 3},
        {"[", c::SmithJsonReason_UnexpectedEnd, 1},
        {"[1,", c::SmithJsonReason_UnexpectedEnd, 3},
        {"[1,]", c::SmithJsonReason_UnexpectedCharacter, 3},
        {"[,1]", c::SmithJsonReason_UnexpectedCharacter, 1},
        {"[1 2]", c::SmithJsonReason_UnexpectedCharacter, 3},
        {"[1}", c::SmithJsonReason_UnexpectedCharacter, 2},
        {"{\"a\":1]", c::SmithJsonReason_UnexpectedCharacter, 6},
        {"{\"a\" 1}", c::SmithJsonReason_UnexpectedCharacter, 5},
        {"{\"a\":}", c::SmithJsonReason_UnexpectedCharacter, 5},
        {"{\"a\":1,}", c::SmithJsonReason_UnexpectedCharacter, 7},
        {"{,}", c::SmithJsonReason_UnexpectedCharacter, 1},
        {"{1:2}", c::SmithJsonReason_UnexpectedCharacter, 1},
        {"{\"a\"", c::SmithJsonReason_UnexpectedEnd, 4},
        {"1 2", c::SmithJsonReason_TrailingContent, 2},
        {"[1]]", c::SmithJsonReason_TrailingContent, 3},
        {"{} x", c::SmithJsonReason_TrailingContent, 3},
        {"tru", c::SmithJsonReason_UnexpectedEnd, 3},
        {"nul!", c::SmithJsonReason_UnexpectedCharacter, 3},
        {"True", c::SmithJsonReason_UnexpectedCharacter, 0},
        {"truee", c::SmithJsonReason_TrailingContent, 4},
        {"'a'", c::SmithJsonReason_UnexpectedCharacter, 0},
        {"\xef\xbb\xbf{}", c::SmithJsonReason_UnexpectedCharacter, 0}, // a byte order mark is refused
        {"[1]\x01", c::SmithJsonReason_TrailingContent, 3},
        {"[\"a\"\n\"b\"]", c::SmithJsonReason_UnexpectedCharacter, 5},
    };
    test_json_check_errors(cases, _Countof cases);
}

export void test_json_string_errors() {
    const TestJsonError cases[] = {
        {"\"abc", c::SmithJsonReason_UnexpectedEnd, 4},
        {"\"a\nb\"", c::SmithJsonReason_ControlCharacter, 2},
        {"\"a\tb\"", c::SmithJsonReason_ControlCharacter, 2},
        {"\"\\x\"", c::SmithJsonReason_BadEscape, 1},
        {"\"\\", c::SmithJsonReason_UnexpectedEnd, 1},
        {"\"\\u12\"", c::SmithJsonReason_BadEscape, 1},
        {"\"\\u12G4\"", c::SmithJsonReason_BadEscape, 1},
        {"\"\\ud800\"", c::SmithJsonReason_BadSurrogate, 1},
        {"\"\\ud800\\u0041\"", c::SmithJsonReason_BadSurrogate, 1},
        {"\"\\ud800x\"", c::SmithJsonReason_BadSurrogate, 1},
        {"\"\\udc00\"", c::SmithJsonReason_BadSurrogate, 1},
        {"\"\\udd1e\\ud834\"", c::SmithJsonReason_BadSurrogate, 1},
        {"\"\xc0\x80\"", c::SmithJsonReason_BadUtf8, 1},         // overlong
        {"\"\xc1\xbf\"", c::SmithJsonReason_BadUtf8, 1},         // overlong
        {"\"\xe0\x80\x80\"", c::SmithJsonReason_BadUtf8, 1},     // overlong
        {"\"\xf0\x80\x80\x80\"", c::SmithJsonReason_BadUtf8, 1}, // overlong
        {"\"\xed\xa0\x80\"", c::SmithJsonReason_BadUtf8, 1},     // a surrogate
        {"\"\xf4\x90\x80\x80\"", c::SmithJsonReason_BadUtf8, 1}, // past U+10FFFF
        {"\"\xf5\x80\x80\x80\"", c::SmithJsonReason_BadUtf8, 1}, // never a lead byte
        {"\"\xff\"", c::SmithJsonReason_BadUtf8, 1},
        {"\"\x80\"", c::SmithJsonReason_BadUtf8, 1},              // a lone continuation byte
        {"\"a\xe2\x82\"", c::SmithJsonReason_BadUtf8, 2},         // truncated
        {"\"\xe2\x82", c::SmithJsonReason_BadUtf8, 1},            // truncated by the end of the input
        {"{\"\\ud800\": 1}", c::SmithJsonReason_BadSurrogate, 2}, // a key is a string
    };
    test_json_check_errors(cases, _Countof cases);
}

export void test_json_number_errors() {
    const TestJsonError cases[] = {
        {"-", c::SmithJsonReason_BadNumber, 1},
        {"-a", c::SmithJsonReason_BadNumber, 1},
        {"+1", c::SmithJsonReason_UnexpectedCharacter, 0},
        {".5", c::SmithJsonReason_UnexpectedCharacter, 0},
        {"1.", c::SmithJsonReason_BadNumber, 2},
        {"1.e5", c::SmithJsonReason_BadNumber, 2},
        {"-.5", c::SmithJsonReason_BadNumber, 1},
        {"1e", c::SmithJsonReason_BadNumber, 2},
        {"1e+", c::SmithJsonReason_BadNumber, 3},
        {"1e-x", c::SmithJsonReason_BadNumber, 3},
        {"01", c::SmithJsonReason_TrailingContent, 1},
        {"-01", c::SmithJsonReason_TrailingContent, 2},
        {"[00]", c::SmithJsonReason_UnexpectedCharacter, 2},
        {"1.5.5", c::SmithJsonReason_TrailingContent, 3},
        {"0x10", c::SmithJsonReason_TrailingContent, 1},
        {"NaN", c::SmithJsonReason_UnexpectedCharacter, 0},
        {"-Infinity", c::SmithJsonReason_BadNumber, 1},
        {"[1,2,3,0.5e]", c::SmithJsonReason_BadNumber, 11},
    };
    test_json_check_errors(cases, _Countof cases);
}

export void test_json_accepts_the_grammar() {
    const char *good[] = {
        "0",
        "-0",
        "1",
        "-1",
        "10",
        "0.5",
        "-0.5",
        "1e5",
        "1E5",
        "1e+5",
        "1e-5",
        "1.5e10",
        "0e0",
        "0.0e-0",
        "123456789012345678901234567890",
        "1.7976931348623157e308",
        "\"\"",
        "\"a\"",
        "\"\\u0000\"",
        "\"\\/\"",
        "\"\xe2\x82\xac\"",
        "\"\xf4\x8f\xbf\xbf\"",
        "\"\xed\x9f\xbf\"",
        "\"\xee\x80\x80\"",
        "\"\xef\xbf\xbf\"",
        "\"\\ud834\\udd1e\"",
        "\"\x7f\"",
        "true",
        "false",
        "null",
        "[]",
        "{}",
        " \t\r\n[ ] ",
        "[[]]",
        "[{}]",
        "{\"a\":{}}",
        "[1,2,3]",
        "{\"a\":1,\"a\":2}",
        "{\"\":\"\"}",
        "[null,true,false]",
        "\n\n{ \"k\" : [ 1 , 2 ] }\n",
    };
    arena::Arena arena = test::memory(1 << 16);
    for (usize i = 0; i < _Countof good; i++) {
        test::note("input \"%s\"", good[i]);
        const c::SmithJsonValue *root = nullptr;
        c::SmithJsonError error = {};
        test::check(c::smith_json_parse(&arena, test_json_text(good[i]), test_json_wide, &root, &error));
        test::check(root != nullptr);
    }
}

// ---------------------------------------------------------------------------------------------------------------
// Strings

static typeof(const char[:]) test_json_only_string(arena::Arena *arena, const char *document) {
    const c::SmithJsonValue *root = nullptr;
    c::SmithJsonError error = {};
    test::check(c::smith_json_parse(arena, test_json_text(document), test_json_wide, &root, &error));
    test::check(root->kind == c::SmithJsonKind_String);
    return root->text;
}

static void test_json_check_string(arena::Arena *arena, const char *document, const char *bytes, usize length) {
    test::note("document %s", document);
    const char string[:] = test_json_only_string(arena, document);
    test::check_equal(countof(string), length);
    test::check_equal(c::memcmp(string.data, bytes, length), 0);
}

export void test_json_decodes_strings() {
    arena::Arena arena = test::memory(1 << 16);
    test_json_check_string(&arena, "\"\"", "", 0);
    test_json_check_string(&arena, "\"plain\"", "plain", 5);
    test_json_check_string(&arena, "\"a\\\"b\\\\c\\/d\"", "a\"b\\c/d", 7);
    test_json_check_string(&arena, "\"\\b\\f\\n\\r\\t\"", "\b\f\n\r\t", 5);
    test_json_check_string(&arena, "\"\\u0041\\u00e9\\u20AC\"", "A\xc3\xa9\xe2\x82\xac", 6);
    test_json_check_string(&arena, "\"\\ud834\\udd1e\"", "\xf0\x9d\x84\x9e", 4);
    test_json_check_string(&arena, "\"\\uD834\\uDD1E!\"", "\xf0\x9d\x84\x9e!", 5);
    test_json_check_string(&arena, "\"\\ud83d\\ude00 \xf0\x9f\x98\x80\"", "\xf0\x9f\x98\x80 \xf0\x9f\x98\x80", 9);
    test_json_check_string(&arena, "\"\\u0000x\"", "\0x", 2); // a zero byte inside
    test_json_check_string(&arena, "\"\\u001f\\u007f\"", "\x1f\x7f", 2);
    test_json_check_string(&arena, "\"\xef\xbf\xbf\xf4\x8f\xbf\xbf\"", "\xef\xbf\xbf\xf4\x8f\xbf\xbf", 7);
}

export void test_json_decoded_strings_are_terminated_and_cheap() {
    arena::Arena arena = test::memory(1 << 16);
    const char *plain_document = "\"no escapes here\"";
    const char plain[:] = test_json_only_string(&arena, plain_document);
    test::check(plain.data == plain_document + 1); // no copy: a slice of the input
    const char escaped[:] = test_json_only_string(&arena, "\"a\\nb\"");
    test::check_equal(escaped.data[countof(escaped)], '\0');
}

export void test_json_reader_decodes_into_the_arena() {
    arena::Arena arena = test::memory(1 << 12);
    c::SmithJsonReader reader = c::smith_json_reader_make(test_json_text("[\"x\\ty\", \"plain\"]"), test_json_wide);
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_ArrayBegin);
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_String);
    usize before = arena.used;
    const char first[:] = c::smith_json_decode(&reader, &arena);
    test::check_greater(arena.used, before);
    test::check_equal(countof(first), 3);
    test::check_equal(c::memcmp(first.data, "x\ty", 3), 0);
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_String);
    before = arena.used;
    const char second[:] = c::smith_json_decode(&reader, &arena);
    test::check_equal(arena.used, before); // nothing to decode: nothing pushed
    test::check(text::is(second, "plain"));
}

// ---------------------------------------------------------------------------------------------------------------
// Numbers

static const c::SmithJsonValue *test_json_parse_ok(arena::Arena *arena, const char *document) {
    const c::SmithJsonValue *root = nullptr;
    c::SmithJsonError error = {};
    test::note("document %s", document);
    test::check(c::smith_json_parse(arena, test_json_text(document), test_json_wide, &root, &error));
    return root;
}

export void test_json_numbers_are_exact() {
    arena::Arena arena = test::memory(1 << 16);
    const c::SmithJsonValue *root = test_json_parse_ok(
        &arena, "[0, -0, 9223372036854775807, -9223372036854775808, 18446744073709551615, 18446744073709551616, "
                "-9223372036854775809, 1e2, 2.5, 1E400, -1e400, 1e-400]");
    test::check_equal(root->count, 12);
    i64 i = 7;
    u64 u = 7;
    f64 d = 7;
    test::check(text::parse_i64(root->items[0]->text, &i) && i == 0);
    test::check(text::parse_i64(root->items[1]->text, &i) && i == 0);
    test::check(text::parse_i64(root->items[2]->text, &i) && i == i64_max);
    test::check(text::parse_i64(root->items[3]->text, &i) && i == i64_min);
    test::check(text::parse_u64(root->items[4]->text, &u) && u == math::max(u64));
    test::check(!text::parse_u64(root->items[5]->text, &u));
    test::check(!text::parse_i64(root->items[5]->text, &i));
    test::check(!text::parse_i64(root->items[6]->text, &i));
    test::check(!text::parse_i64(root->items[7]->text, &i)); // 1e2 is a f64, not an integer
    test::check(text::parse_f64(root->items[7]->text, &d));
    test::check_same_bits(d, 100.0);
    test::check(text::parse_f64(root->items[5]->text, &d)); // an integer too big for u64 is still a f64
    test::check_same_bits(d, 18446744073709551616.0);
    test::check(!text::parse_f64(root->items[9]->text, &d)); // out of range as a f64: refused
    test::check(!text::parse_f64(root->items[10]->text, &d));
    test::check(text::parse_f64(root->items[11]->text, &d));
    test::check_same_bits(d, 0.0);
}

// ---------------------------------------------------------------------------------------------------------------
// Limits

static bool test_json_parses(const char *document, c::SmithJsonLimits limits, c::SmithJsonError *error) {
    arena::Arena arena = test::memory(1 << 16);
    const c::SmithJsonValue *root = nullptr;
    return c::smith_json_parse(&arena, test_json_text(document), limits, &root, error);
}

export void test_json_depth_limit() {
    c::SmithJsonError error = {};
    c::SmithJsonLimits limits = {.depth = 3, .string_length = 100, .count = 100};
    test::check(test_json_parses("[[[]]]", limits, &error));
    test::check(test_json_parses("[[{\"a\":1}]]", limits, &error));
    test::check(!test_json_parses("[[[[]]]]", limits, &error));
    test::check(error.reason == c::SmithJsonReason_TooDeep);
    test::check_equal(error.offset, 3); // the fourth bracket
    test::check(!test_json_parses("{\"a\":{\"b\":{\"c\":{}}}}", limits, &error));
    test::check(error.reason == c::SmithJsonReason_TooDeep);
    c::SmithJsonLimits scalars = {.depth = 0, .string_length = 100, .count = 100};
    test::check(test_json_parses("12", scalars, &error));
    test::check(!test_json_parses("[]", scalars, &error));
    test::check(error.reason == c::SmithJsonReason_TooDeep);
    test::check_equal(error.offset, 0);
    c::SmithJsonLimits deepest = {.depth = c::smith_json_depth_max, .string_length = 10, .count = 2000};
    char many[c::smith_json_depth_max * 2 + 1];
    __builtin_memset(many, '[', c::smith_json_depth_max);
    __builtin_memset(many + c::smith_json_depth_max, ']', c::smith_json_depth_max);
    many[c::smith_json_depth_max * 2] = '\0';
    test::check(test_json_parses(many, deepest, &error));
}

export void test_json_string_length_limit() {
    c::SmithJsonError error = {};
    c::SmithJsonLimits limits = {.depth = 4, .string_length = 4, .count = 100};
    test::check(test_json_parses("\"abcd\"", limits, &error));
    test::check(!test_json_parses("\"abcde\"", limits, &error));
    test::check(error.reason == c::SmithJsonReason_StringTooLong);
    test::check_equal(error.offset, 5);
    test::check(test_json_parses("\"\\n\\n\\n\\n\"", limits, &error));   // 8 bytes written, 4 decoded
    test::check(test_json_parses("\"\\u00e9\\u00e9\"", limits, &error)); // two bytes each
    test::check(!test_json_parses("\"\\u00e9\\u00e9x\"", limits, &error));
    test::check(test_json_parses("\"\\ud834\\udd1e\"", limits, &error)); // four bytes
    test::check(!test_json_parses("\"a\\ud834\\udd1e\"", limits, &error));
    test::check(!test_json_parses("{\"abcde\": 1}", limits, &error)); // keys are strings
    test::check(error.reason == c::SmithJsonReason_StringTooLong);
    c::SmithJsonLimits none = {.depth = 4, .string_length = 0, .count = 100};
    test::check(test_json_parses("[\"\", {\"\": \"\"}]", none, &error));
    test::check(!test_json_parses("\"a\"", none, &error));
}

export void test_json_count_limit() {
    c::SmithJsonError error = {};
    c::SmithJsonLimits limits = {.depth = 4, .string_length = 10, .count = 4};
    test::check(test_json_parses("[1,2,3]", limits, &error)); // the array and three numbers
    test::check(!test_json_parses("[1,2,3,4]", limits, &error));
    test::check(error.reason == c::SmithJsonReason_TooMany);
    test::check_equal(error.offset, 7);
    test::check(test_json_parses("{\"a\":1,\"b\":2,\"c\":3}", limits, &error)); // keys are not values
    test::check(!test_json_parses("{\"a\":1,\"b\":2,\"c\":3,\"d\":4}", limits, &error));
    test::check(error.reason == c::SmithJsonReason_TooMany);
    c::SmithJsonLimits nothing = {.depth = 4, .string_length = 10, .count = 0};
    test::check(!test_json_parses("0", nothing, &error));
    test::check(error.reason == c::SmithJsonReason_TooMany);
}

// ---------------------------------------------------------------------------------------------------------------
// The tree

export void test_json_tree_of_a_document() {
    arena::Arena arena = test::memory(1 << 16);
    const c::SmithJsonValue *root = test_json_parse_ok(
        &arena, "{\"name\": \"smith\", \"tags\": [\"c\", \"json\"], \"n\": 42, \"ok\": true, \"no\": false, "
                "\"none\": null, \"nested\": {\"a\": {\"b\": [] }}, \"n\": 43, \"esc\\u0041\": 1}");
    test::check(root->kind == c::SmithJsonKind_Object);
    test::check_equal(root->count, 9);
    test::check_equal(root->offset, 0);
    test::check_equal(root->span, 14);
    const c::SmithJsonValue *name = c::smith_json_member(root, "name");
    test::check(name != nullptr && name->kind == c::SmithJsonKind_String && text::is(name->text, "smith"));
    test::check(text::is(name->key, "name"));
    const c::SmithJsonValue *tags = c::smith_json_member(root, "tags");
    test::check(tags != nullptr && tags->kind == c::SmithJsonKind_Array && tags->count == 2);
    test::check(text::is(tags->items[1]->text, "json"));
    const char tag_key[:] = tags->items[1]->key;
    test::check_equal(countof(tag_key), 0);
    test::check(c::smith_json_member(root, "ok")->kind == c::SmithJsonKind_True);
    test::check(c::smith_json_member(root, "no")->kind == c::SmithJsonKind_False);
    test::check(c::smith_json_member(root, "none")->kind == c::SmithJsonKind_Null);
    test::check(text::is(c::smith_json_member(root, "n")->text, "43")); // the last of a repeated key
    test::check(c::smith_json_member(root, "missing") == nullptr);
    test::check(c::smith_json_member(root, "escA") != nullptr); // keys are decoded
    test::check(c::smith_json_member(tags, "x") == nullptr);    // not an object
    const c::SmithJsonValue *b =
        c::smith_json_member(c::smith_json_member(c::smith_json_member(root, "nested"), "a"), "b");
    test::check(b != nullptr && b->kind == c::SmithJsonKind_Array && b->count == 0);
}

export void test_json_tree_does_not_touch_the_arena_on_failure() {
    arena::Arena arena = test::memory(1 << 16);
    (void)arena::push(&arena, u64);
    usize used = arena.used;
    const c::SmithJsonValue *root = nullptr;
    c::SmithJsonError error = {};
    test::check(!c::smith_json_parse(&arena, test_json_text("[1, 2, \"a\\n\", ]"), test_json_wide, &root, &error));
    test::check_equal(arena.used, used);
    test::check(root == nullptr);
}

export void test_json_tree_that_does_not_fit_is_an_error() {
    alignas(arena::align_max) u8 memory[1024];
    arena::Arena arena = arena::make(memory, sizeof memory);
    char big[2048];
    usize used = 0;
    big[used++] = '[';
    for (i32 i = 0; i < 400; i++) {
        big[used++] = '1';
        big[used++] = ',';
    }
    big[used - 1] = ']';
    const c::SmithJsonValue *root = nullptr;
    c::SmithJsonError error = {};
    test::check(!c::smith_json_parse(&arena, big[0:used], test_json_wide, &root, &error));
    test::check(error.reason == c::SmithJsonReason_OutOfMemory);
    test::check_equal(arena.used, 0);
    test::check(c::smith_json_parse(&arena, test_json_text("[1,2,3]"), test_json_wide, &root, &error)); // still usable
}

export void test_json_a_large_array_keeps_its_order() {
    arena::Arena arena = test::memory(1 << 20);
    char digits[8192];
    usize used = 0;
    digits[used++] = '[';
    for (usize i = 0; i < 1000; i++) {
        if (i > 0) digits[used++] = ',';
        used += text::write_u64(digits[used:sizeof digits], i * i);
    }
    digits[used++] = ']';
    const c::SmithJsonValue *root = nullptr;
    c::SmithJsonError error = {};
    c::SmithJsonLimits limits = {.depth = 2, .string_length = 1, .count = 1001};
    test::check(c::smith_json_parse(&arena, digits[0:used], limits, &root, &error));
    test::check_equal(root->count, 1000);
    for (usize i = 0; i < 1000; i++) {
        u64 value = 0;
        test::check(text::parse_u64(root->items[i]->text, &value));
        u64 square = i;
        test::check_equal(value, square * square);
    }
}

// ---------------------------------------------------------------------------------------------------------------
// The writer

static bool test_json_writer_is(c::SmithJsonWriter *writer, const char *expected) {
    const char output[:] = {};
    if (!c::smith_json_writer_finish(writer, &output)) return false;
    return countof(output) == c::strlen(expected) && c::memcmp(output.data, expected, countof(output)) == 0;
}

export void test_json_writer_compact() {
    char buffer[256];
    c::SmithJsonWriter writer = c::smith_json_writer_make(buffer, sizeof buffer, 0);
    c::smith_json_write_object_begin(&writer);
    c::smith_json_write_key(&writer, test_json_text("a"));
    c::smith_json_write_array_begin(&writer);
    c::smith_json_write_u64(&writer, 1);
    c::smith_json_write_i64(&writer, -2);
    c::smith_json_write_f64(&writer, 0.5);
    c::smith_json_write_bool(&writer, true);
    c::smith_json_write_bool(&writer, false);
    c::smith_json_write_null(&writer);
    c::smith_json_write_string(&writer, test_json_text("s"));
    c::smith_json_write_array_end(&writer);
    c::smith_json_write_key(&writer, test_json_text("e"));
    c::smith_json_write_object_begin(&writer);
    c::smith_json_write_object_end(&writer);
    c::smith_json_write_key(&writer, test_json_text("f"));
    c::smith_json_write_array_begin(&writer);
    c::smith_json_write_array_end(&writer);
    c::smith_json_write_object_end(&writer);
    test::check(test_json_writer_is(&writer, "{\"a\":[1,-2,0.5,true,false,null,\"s\"],\"e\":{},\"f\":[]}"));
}

export void test_json_writer_indents() {
    char buffer[256];
    c::SmithJsonWriter writer = c::smith_json_writer_make(buffer, sizeof buffer, 2);
    c::smith_json_write_object_begin(&writer);
    c::smith_json_write_key(&writer, test_json_text("a"));
    c::smith_json_write_array_begin(&writer);
    c::smith_json_write_u64(&writer, 1);
    c::smith_json_write_object_begin(&writer);
    c::smith_json_write_key(&writer, test_json_text("b"));
    c::smith_json_write_null(&writer);
    c::smith_json_write_object_end(&writer);
    c::smith_json_write_array_end(&writer);
    c::smith_json_write_key(&writer, test_json_text("c"));
    c::smith_json_write_array_begin(&writer);
    c::smith_json_write_array_end(&writer);
    c::smith_json_write_object_end(&writer);
    const char *expected = "{\n  \"a\": [\n    1,\n    {\n      \"b\": null\n    }\n  ],\n  \"c\": []\n}";
    test::check(test_json_writer_is(&writer, expected));
    c::SmithJsonWriter scalar = c::smith_json_writer_make(buffer, sizeof buffer, 4);
    c::smith_json_write_u64(&scalar, 7);
    test::check(test_json_writer_is(&scalar, "7"));
}

static bool test_json_string_writes(const char *bytes, usize length, const char *expected) {
    char buffer[128];
    c::SmithJsonWriter writer = c::smith_json_writer_make(buffer, sizeof buffer, 0);
    c::smith_json_write_string(&writer, bytes[0:length]);
    return test_json_writer_is(&writer, expected);
}

export void test_json_writer_escapes() {
    test::check(test_json_string_writes("", 0, "\"\""));
    test::check(test_json_string_writes("a\"b\\c/d", 7, "\"a\\\"b\\\\c/d\""));
    test::check(test_json_string_writes("\b\f\n\r\t", 5, "\"\\b\\f\\n\\r\\t\""));
    test::check(test_json_string_writes("\x01\x1f", 2, "\"\\u0001\\u001f\""));
    test::check(test_json_string_writes("\0x", 2, "\"\\u0000x\""));
    test::check(test_json_string_writes("\x7f", 1, "\"\x7f\""));
    test::check(test_json_string_writes("\xc3\xa9\xf0\x9d\x84\x9e", 6, "\"\xc3\xa9\xf0\x9d\x84\x9e\""));
    test::check(test_json_string_writes("\xe2\x80\xa8", 3, "\"\xe2\x80\xa8\""));
}

export void test_json_writer_refuses_invalid_utf8() {
    const char *bad[] = {"\xff", "\xc0\x80", "\xed\xa0\x80", "\xe2\x82", "ok\x80"};
    for (usize i = 0; i < _Countof bad; i++) {
        char buffer[64];
        c::SmithJsonWriter writer = c::smith_json_writer_make(buffer, sizeof buffer, 0);
        c::smith_json_write_string(&writer, test_json_text(bad[i]));
        const char output[:] = {};
        test::check(!c::smith_json_writer_finish(&writer, &output));
        test::check(writer.error.reason == c::SmithJsonReason_BadUtf8);
    }
}

export void test_json_writer_numbers() {
    char buffer[512];
    c::SmithJsonWriter writer = c::smith_json_writer_make(buffer, sizeof buffer, 0);
    c::smith_json_write_array_begin(&writer);
    c::smith_json_write_u64(&writer, math::max(u64));
    c::smith_json_write_i64(&writer, i64_min);
    c::smith_json_write_i64(&writer, i64_max);
    c::smith_json_write_f64(&writer, -0.0);
    c::smith_json_write_f64(&writer, 0.1);
    c::smith_json_write_f64(&writer, 1e300);
    c::smith_json_write_f64(&writer, 5e-324);
    c::smith_json_write_array_end(&writer);
    test::check(test_json_writer_is(
        &writer, "[18446744073709551615,-9223372036854775808,9223372036854775807,-0,0.1,1e300,5e-324]"));
}

export void test_json_writer_refuses_nan_and_infinity() {
    f64 values[] = {__builtin_inf(), -__builtin_inf(), __builtin_nan("")};
    for (usize i = 0; i < _Countof values; i++) {
        char buffer[64];
        c::SmithJsonWriter writer = c::smith_json_writer_make(buffer, sizeof buffer, 0);
        c::smith_json_write_array_begin(&writer);
        c::smith_json_write_f64(&writer, values[i]);
        test::check(writer.error.reason == c::SmithJsonReason_NotFinite);
        c::smith_json_write_f64(&writer, 1.0);
        c::smith_json_write_array_end(&writer);
        const char output[:] = {};
        test::check(!c::smith_json_writer_finish(&writer, &output));
        test::check(writer.error.reason == c::SmithJsonReason_NotFinite); // the first mistake is kept
    }
}

static c::SmithJsonError test_json_misuse(i32 which) {
    char buffer[64];
    c::SmithJsonWriter writer = c::smith_json_writer_make(buffer, sizeof buffer, 0);
    const char output[:] = {};
    switch (which) {
    case 0:
        c::smith_json_write_key(&writer, test_json_text("a"));
        break; // a key outside an object
    case 1:
        c::smith_json_write_object_end(&writer);
        break; // an end that closes nothing
    case 2:
        c::smith_json_write_array_begin(&writer);
        c::smith_json_write_object_end(&writer);
        break; // the wrong end
    case 3:
        c::smith_json_write_object_begin(&writer);
        c::smith_json_write_u64(&writer, 1);
        break; // a value for a key
    case 4:
        c::smith_json_write_object_begin(&writer);
        c::smith_json_write_key(&writer, test_json_text("a"));
        c::smith_json_write_object_end(&writer);
        break; // an end after a key
    case 5:
        c::smith_json_write_u64(&writer, 1);
        c::smith_json_write_u64(&writer, 2);
        break; // two documents
    case 6:
        c::smith_json_write_array_begin(&writer);
        c::smith_json_write_key(&writer, test_json_text("a"));
        break;
    case 7:
        c::smith_json_write_object_begin(&writer);
        c::smith_json_write_key(&writer, test_json_text("a"));
        c::smith_json_write_key(&writer, test_json_text("b"));
        break; // two keys in a row
    case 8:
        c::smith_json_write_array_begin(&writer);
        break; // never finished
    default:
        break; // 9: nothing written
    }
    test::check(!c::smith_json_writer_finish(&writer, &output));
    return writer.error;
}

export void test_json_writer_refuses_misplaced_calls() {
    for (i32 which = 0; which < 10; which++) {
        test::note("case %d", which);
        c::SmithJsonError error = test_json_misuse(which);
        test::check(error.reason == c::SmithJsonReason_Misplaced);
    }
}

export void test_json_writer_full_buffer() {
    char buffer[8];
    c::SmithJsonWriter writer = c::smith_json_writer_make(buffer, sizeof buffer, 0);
    c::smith_json_write_array_begin(&writer);
    c::smith_json_write_string(&writer, test_json_text("abcdef")); // 8 characters with its quotes: one too many
    test::check(writer.error.reason == c::SmithJsonReason_Full);
    const char output[:] = {};
    test::check(!c::smith_json_writer_finish(&writer, &output));
    test::check_less_equal(writer.length, sizeof buffer);
    char exact[7];
    c::SmithJsonWriter fits = c::smith_json_writer_make(exact, sizeof exact, 0);
    c::smith_json_write_array_begin(&fits);
    c::smith_json_write_string(&fits, test_json_text("abcde"));
    c::smith_json_write_array_end(&fits);
    test::check(!c::smith_json_writer_finish(&fits, &output)); // "[" + 7 + "]" is 9
    char sized[9];
    c::SmithJsonWriter enough = c::smith_json_writer_make(sized, sizeof sized, 0);
    c::smith_json_write_array_begin(&enough);
    c::smith_json_write_string(&enough, test_json_text("abcde"));
    c::smith_json_write_array_end(&enough);
    test::check(c::smith_json_writer_finish(&enough, &output));
    test::check_equal(countof(output), 9);
}

export void test_json_writer_depth() {
    constexpr usize size = c::smith_json_depth_max * 2 + 8;
    arena::Arena arena = test::memory(size);
    char *buffer = arena::push_slice(&arena, char, size).data;
    c::SmithJsonWriter writer = c::smith_json_writer_make(buffer, size, 0);
    for (usize i = 0; i < c::smith_json_depth_max; i++) {
        c::smith_json_write_array_begin(&writer);
    }
    test::check(writer.error.reason == c::SmithJsonReason_None);
    c::smith_json_write_array_begin(&writer);
    test::check(writer.error.reason == c::SmithJsonReason_TooDeep);
}

// ---------------------------------------------------------------------------------------------------------------
// Property tests: a random document, written, then read

constexpr usize test_json_events_max = 160;
constexpr usize test_json_string_max = 24;

typedef enum { TestJsonNumber_U64, TestJsonNumber_I64, TestJsonNumber_F64 } TestJsonNumber;

typedef struct {
    c::SmithJsonToken token;
    char string[test_json_string_max * 4 + 1]; // a Key or String, as UTF-8
    usize length;
    TestJsonNumber number;
    u64 bits; // a number's value: the integer, or the f64's bits
} TestJsonEvent;

typedef struct {
    TestJsonEvent events[test_json_events_max];
    usize count;
} TestJsonDocument;

// A random code point that is not a surrogate and, optionally, not zero.
static u32 test_json_code_point(random::Key key) {
    random::Key *key_stream = &key;
    i64 band = test_json_uniform(take(key_stream), 0, 9);
    random::Key pick = take(key_stream);
    if (band <= 3) return (u32)test_json_uniform(pick, 0x20, 0x7e);
    if (band == 4) return (u32)test_json_uniform(pick, 1, 0x1f);
    if (band == 5) return (u32)(u8) "\"\\/\x7f"[test_json_uniform(pick, 0, 3)];
    if (band == 6) return (u32)test_json_uniform(pick, 0x80, 0x7ff);
    if (band == 7) {
        u32 code = (u32)test_json_uniform(pick, 0x800, 0xffff - 0x800);
        return code >= 0xd800 && code <= 0xdfff ? code + 0x800 : code;
    }
    return (u32)test_json_uniform(pick, 0x10000, 0x10ffff);
}

static usize test_json_utf8(u32 code, char *out) {
    if (code < 0x80) {
        out[0] = (char)code;
        return 1;
    }
    if (code < 0x800) {
        out[0] = (char)(0xc0 | (code >> 6));
        out[1] = (char)(0x80 | (code & 0x3f));
        return 2;
    }
    if (code < 0x10000) {
        out[0] = (char)(0xe0 | (code >> 12));
        out[1] = (char)(0x80 | ((code >> 6) & 0x3f));
        out[2] = (char)(0x80 | (code & 0x3f));
        return 3;
    }
    out[0] = (char)(0xf0 | (code >> 18));
    out[1] = (char)(0x80 | ((code >> 12) & 0x3f));
    out[2] = (char)(0x80 | ((code >> 6) & 0x3f));
    out[3] = (char)(0x80 | (code & 0x3f));
    return 4;
}

static void test_json_random_string(random::Key key, TestJsonEvent *event) {
    random::Key *stream = &key;
    usize length = (usize)test_json_uniform(take(stream), 0, test_json_string_max);
    event->length = 0;
    for (usize i = 0; i < length; i++) {
        event->length += test_json_utf8(test_json_code_point(take(stream)), event->string + event->length);
    }
    event->string[event->length] = '\0';
}

static u64 test_json_random_double_bits(random::Key key) {
    random::Key *key_stream = &key;
    i64 kind = test_json_uniform(take(key_stream), 0, 5);
    if (kind == 0) { // a short decimal, the common case
        f64 d = (f64)test_json_uniform(take(key_stream), -100000, 100000) / 100.0;
        return __builtin_bit_cast(u64, d);
    }
    u64 bits = random::key_bits(take(key_stream));
    if (kind == 1) bits &= ~((u64)0x7ff << 52); // subnormal
    f64 d = __builtin_bit_cast(f64, bits);
    if (d != d || d > f64_max || d < -f64_max) bits &= ~((u64)0x400 << 52); // finite: clear an exponent bit
    return bits;
}

// Writes the event to the writer, and appends it to the document.
static void test_json_emit(c::SmithJsonWriter *writer, TestJsonDocument *document, const TestJsonEvent *event) {
    document->events[document->count++] = *event;
    const char piece[:] = event->string[0:event->length];
    switch (event->token) {
    case c::SmithJsonToken_ObjectBegin:
        c::smith_json_write_object_begin(writer);
        break;
    case c::SmithJsonToken_ObjectEnd:
        c::smith_json_write_object_end(writer);
        break;
    case c::SmithJsonToken_ArrayBegin:
        c::smith_json_write_array_begin(writer);
        break;
    case c::SmithJsonToken_ArrayEnd:
        c::smith_json_write_array_end(writer);
        break;
    case c::SmithJsonToken_Key:
        c::smith_json_write_key(writer, piece);
        break;
    case c::SmithJsonToken_String:
        c::smith_json_write_string(writer, piece);
        break;
    case c::SmithJsonToken_True:
        c::smith_json_write_bool(writer, true);
        break;
    case c::SmithJsonToken_False:
        c::smith_json_write_bool(writer, false);
        break;
    case c::SmithJsonToken_Null:
        c::smith_json_write_null(writer);
        break;
    case c::SmithJsonToken_Number:
        if (event->number == TestJsonNumber_U64) c::smith_json_write_u64(writer, event->bits);
        if (event->number == TestJsonNumber_I64) c::smith_json_write_i64(writer, (i64)event->bits);
        if (event->number == TestJsonNumber_F64) c::smith_json_write_f64(writer, __builtin_bit_cast(f64, event->bits));
        break;
    case c::SmithJsonToken_Error:
    case c::SmithJsonToken_End:
        break;
    }
}

typedef struct {
    bool object;
    usize remaining;
} TestJsonFrame;

// A random value, as events, with an explicit stack of the containers it is inside.
static void test_json_random_value(c::SmithJsonWriter *writer, TestJsonDocument *document, random::Key key,
                                   usize depth_max) {
    TestJsonFrame stack[16];
    usize depth = 0;
    bool started = false;
    random::Key *key_stream = &key;
    for (usize step = 0; document->count + 16 < test_json_events_max; step++) {
        random::Key here = take(key_stream);
        random::Key *here_stream = &here;
        TestJsonEvent event = {};
        if (started && depth == 0) break;
        if (depth > 0 && stack[depth - 1].remaining == 0) {
            event.token = stack[depth - 1].object ? c::SmithJsonToken_ObjectEnd : c::SmithJsonToken_ArrayEnd;
            depth -= 1;
            test_json_emit(writer, document, &event);
            continue;
        }
        if (depth > 0) {
            stack[depth - 1].remaining -= 1;
            if (stack[depth - 1].object) {
                event.token = c::SmithJsonToken_Key;
                test_json_random_string(take(here_stream), &event);
                test_json_emit(writer, document, &event);
                event = (TestJsonEvent){};
            }
        }
        started = true;
        i64 kind = test_json_uniform(take(here_stream), 0, 9);
        bool room = depth < depth_max && document->count + 24 < test_json_events_max;
        if (kind <= 1 && room) {
            bool object = kind == 1;
            event.token = object ? c::SmithJsonToken_ObjectBegin : c::SmithJsonToken_ArrayBegin;
            stack[depth++] = (TestJsonFrame){object, (usize)test_json_uniform(take(here_stream), 0, 4)};
        } else if (kind == 2) {
            event.token = c::SmithJsonToken_String;
            test_json_random_string(take(here_stream), &event);
        } else if (kind == 3) {
            event.token = (c::SmithJsonToken)(c::SmithJsonToken_True + test_json_uniform(take(here_stream), 0, 2));
        } else {
            event.token = c::SmithJsonToken_Number;
            event.number = (TestJsonNumber)test_json_uniform(take(here_stream), 0, 2);
            u64 bits = random::key_bits(take(here_stream));
            bits >>= random::key_bits(take(here_stream)) % 64; // every length of integer
            event.bits = event.number == TestJsonNumber_F64 ? test_json_random_double_bits(take(here_stream)) : bits;
        }
        test_json_emit(writer, document, &event);
    }
    while (depth > 0) { // out of budget: close what is open (an object with a pending key never occurs here)
        TestJsonEvent event = {.token =
                                   stack[depth - 1].object ? c::SmithJsonToken_ObjectEnd : c::SmithJsonToken_ArrayEnd};
        depth -= 1;
        test_json_emit(writer, document, &event);
    }
}

static bool test_json_number_matches(const char word[:], const TestJsonEvent *event) {
    if (event->number == TestJsonNumber_U64) {
        u64 value = 0;
        return text::parse_u64(word, &value) && value == event->bits;
    }
    if (event->number == TestJsonNumber_I64) {
        i64 value = 0;
        return text::parse_i64(word, &value) && (u64)value == event->bits;
    }
    f64 value = 0;
    return text::parse_f64(word, &value) && __builtin_bit_cast(u64, value) == event->bits;
}

// The pull parser sees exactly the events.
static void test_json_check_reader(const char input[:], const TestJsonDocument *document, arena::Arena *arena) {
    c::SmithJsonReader reader = c::smith_json_reader_make(input, test_json_wide);
    for (usize i = 0; i < document->count; i++) {
        const TestJsonEvent *event = &document->events[i];
        test::note("event %zu of %zu in %.*s", i, document->count,
                   (i32)countof(input) > 600 ? 600 : (i32)countof(input), input.data);
        test::check(c::smith_json_read(&reader) == event->token);
        if (event->token == c::SmithJsonToken_Key || event->token == c::SmithJsonToken_String) {
            const char decoded[:] = c::smith_json_decode(&reader, arena);
            test::check_equal(countof(decoded), event->length);
            test::check_equal(c::memcmp(decoded.data, event->string, event->length), 0);
            if (reader.escaped) {
                test::check(decoded.data[countof(decoded)] == '\0');
            }
            test::check_equal(reader.length, event->length);
        }
        if (event->token == c::SmithJsonToken_Number) test::check(test_json_number_matches(reader.text, event));
    }
    test::check(c::smith_json_read(&reader) == c::SmithJsonToken_End);
}

// The tree holds exactly the events, in order: walked with a stack of (container, next child).
static void test_json_check_tree(const c::SmithJsonValue *root, const TestJsonDocument *document) {
    const c::SmithJsonValue *containers[32];
    usize next_child[32];
    usize depth = 0;
    const c::SmithJsonValue *value = root;
    bool pending_key = false;
    for (usize i = 0; i < document->count; i++) {
        const TestJsonEvent *event = &document->events[i];
        if (event->token == c::SmithJsonToken_ObjectEnd || event->token == c::SmithJsonToken_ArrayEnd) {
            test::check(depth > 0 && next_child[depth - 1] == containers[depth - 1]->count);
            depth -= 1;
            continue;
        }
        if (event->token == c::SmithJsonToken_Key) {
            test::check(depth > 0 && next_child[depth - 1] < containers[depth - 1]->count);
            value = containers[depth - 1]->items[next_child[depth - 1]];
            const char member_key[:] = value->key;
            test::check_equal(countof(member_key), event->length);
            test::check_equal(c::memcmp(value->key.data, event->string, event->length), 0);
            pending_key = true;
            continue;
        }
        if (!pending_key && depth > 0) {
            test::check(next_child[depth - 1] < containers[depth - 1]->count);
            value = containers[depth - 1]->items[next_child[depth - 1]];
        }
        if (depth > 0) next_child[depth - 1] += 1;
        pending_key = false;
        switch (event->token) {
        case c::SmithJsonToken_ObjectBegin:
        case c::SmithJsonToken_ArrayBegin:
            test::check(value->kind == (event->token == c::SmithJsonToken_ObjectBegin ? c::SmithJsonKind_Object
                                                                                      : c::SmithJsonKind_Array));
            containers[depth] = value;
            next_child[depth] = 0;
            depth += 1;
            break;
        case c::SmithJsonToken_String:
            test::check(value->kind == c::SmithJsonKind_String);
            const char member_text[:] = value->text;
            test::check_equal(countof(member_text), event->length);
            test::check_equal(c::memcmp(value->text.data, event->string, event->length), 0);
            break;
        case c::SmithJsonToken_Number:
            test::check(value->kind == c::SmithJsonKind_Number);
            test::check(test_json_number_matches(value->text, event));
            break;
        case c::SmithJsonToken_True:
            test::check(value->kind == c::SmithJsonKind_True);
            break;
        case c::SmithJsonToken_False:
            test::check(value->kind == c::SmithJsonKind_False);
            break;
        case c::SmithJsonToken_Null:
            test::check(value->kind == c::SmithJsonKind_Null);
            break;
        default:
            test::check(false);
            break;
        }
    }
    test::check_equal(depth, 0);
}

export void test_json_any_value_written_then_read_is_the_same(random::Key key) {
    random::Key *key_stream = &key;
    arena::Arena arena = test::memory(1 << 20);
    constexpr usize size = 1 << 16;
    char *buffer = arena::push_slice(&arena, char, size).data;
    usize indent = (usize)test_json_uniform(take(key_stream), 0, 1) * 2;
    c::SmithJsonWriter writer = c::smith_json_writer_make(buffer, size, indent);
    TestJsonDocument *document = arena::push(&arena, TestJsonDocument);
    test_json_random_value(&writer, document, take(key_stream), (usize)test_json_uniform(take(key_stream), 0, 6));
    const char output[:] = {};
    test::check(c::smith_json_writer_finish(&writer, &output));
    test_json_check_reader(output, document, &arena);
    const c::SmithJsonValue *root = nullptr;
    c::SmithJsonError error = {};
    test::check(c::smith_json_parse(&arena, output, test_json_wide, &root, &error));
    test_json_check_tree(root, document);
    c::SmithJsonReader counter = c::smith_json_reader_make(output, test_json_wide);
    while (c::smith_json_read(&counter) != c::SmithJsonToken_End) {
    }
    test::check_equal(root->span, counter.values);
}

export void test_json_write_value_puts_a_tree_back_as_it_was_written(random::Key key) {
    random::Key *key_stream = &key;
    arena::Arena arena = test::memory(1 << 20);
    constexpr usize size = 1 << 16;
    char *first = arena::push_slice(&arena, char, size).data;
    char *second = arena::push_slice(&arena, char, size).data;
    usize indent = (usize)test_json_uniform(take(key_stream), 0, 1) * 2;
    c::SmithJsonWriter writer = c::smith_json_writer_make(first, size, indent);
    TestJsonDocument *document = arena::push(&arena, TestJsonDocument);
    test_json_random_value(&writer, document, take(key_stream), (usize)test_json_uniform(take(key_stream), 0, 6));
    const char output[:] = {};
    test::check(c::smith_json_writer_finish(&writer, &output));
    const c::SmithJsonValue *root = nullptr;
    c::SmithJsonError error = {};
    test::check(c::smith_json_parse(&arena, output, test_json_wide, &root, &error));
    c::SmithJsonWriter again = c::smith_json_writer_make(second, size, indent);
    c::smith_json_write_value(&again, root);
    const char copy[:] = {};
    test::check(c::smith_json_writer_finish(&again, &copy));
    test::check_equal(countof(copy), countof(output));
    test::check(c::memcmp(copy.data, output.data, countof(output)) == 0);
}

export void test_json_write_value_keeps_numbers_and_duplicate_keys() {
    arena::Arena arena = test::memory(1 << 14);
    const c::SmithJsonValue *root = nullptr;
    c::SmithJsonError error = {};
    const char input[:] = test_json_text("{\"a\":1.50,\"a\":[],\"b\\u00e9\":[1e2,{},\"x\\ny\"],\"c\":null}");
    test::check(c::smith_json_parse(&arena, input, test_json_wide, &root, &error));
    char buffer[256];
    c::SmithJsonWriter writer = c::smith_json_writer_make(buffer, sizeof buffer, 0);
    c::smith_json_write_value(&writer, root);
    const char out[:] = {};
    test::check(c::smith_json_writer_finish(&writer, &out));
    test::check(text::is(out, "{\"a\":1.50,\"a\":[],\"b\xc3\xa9\":[1e2,{},\"x\\ny\"],\"c\":null}"));
    c::SmithJsonWriter scalar = c::smith_json_writer_make(buffer, sizeof buffer, 0);
    c::smith_json_write_value(&scalar, root->items[0]);
    test::check(c::smith_json_writer_finish(&scalar, &out));
    test::check(text::is(out, "1.50"));
    c::SmithJsonWriter tiny = c::smith_json_writer_make(buffer, 5, 0);
    c::smith_json_write_value(&tiny, root);
    test::check(!c::smith_json_writer_finish(&tiny, &out));
    test::check(tiny.error.reason == c::SmithJsonReason_Full);
}

export void test_json_any_double_round_trips_bit_for_bit(random::Key key) {
    random::Key *key_stream = &key;
    u64 bits = test_json_random_double_bits(take(key_stream));
    if (random::bernoulli_sample(take(key_stream), (random::Bernoulli){.probability = 0.5}))
        bits = random::key_bits(take(key_stream));
    f64 d = __builtin_bit_cast(f64, bits);
    if (d != d || d > f64_max || d < -f64_max) return;
    char buffer[64];
    c::SmithJsonWriter writer = c::smith_json_writer_make(buffer, sizeof buffer, 0);
    c::smith_json_write_f64(&writer, d);
    const char output[:] = {};
    test::check(c::smith_json_writer_finish(&writer, &output));
    arena::Arena arena = test::memory(1 << 12);
    const c::SmithJsonValue *root = nullptr;
    c::SmithJsonError error = {};
    test::check(c::smith_json_parse(&arena, output, test_json_wide, &root, &error));
    f64 back = 0;
    test::check(text::parse_f64(root->text, &back));
    test::check_same_bits(back, d);
}

export void test_json_any_integer_round_trips_exactly(random::Key key) {
    random::Key *key_stream = &key;
    u64 bits = random::key_bits(take(key_stream)) >> (random::key_bits(take(key_stream)) % 64);
    char buffer[64];
    c::SmithJsonWriter writer = c::smith_json_writer_make(buffer, sizeof buffer, 0);
    c::smith_json_write_array_begin(&writer);
    c::smith_json_write_u64(&writer, bits);
    c::smith_json_write_i64(&writer, (i64)bits);
    c::smith_json_write_array_end(&writer);
    const char output[:] = {};
    test::check(c::smith_json_writer_finish(&writer, &output));
    arena::Arena arena = test::memory(1 << 12);
    const c::SmithJsonValue *root = nullptr;
    c::SmithJsonError error = {};
    test::check(c::smith_json_parse(&arena, output, test_json_wide, &root, &error));
    u64 u = 0;
    i64 i = 0;
    test::check(text::parse_u64(root->items[0]->text, &u));
    test::check(text::parse_i64(root->items[1]->text, &i));
    test::check_equal(u, bits);
    test::check_equal((u64)i, bits);
}

// ---------------------------------------------------------------------------------------------------------------
// Fuzzing: damaged documents

// Damages the bytes in place and returns the new length; every byte comes from the key.
static usize test_json_damage(random::Key key, char *bytes, usize length, usize capacity) {
    random::Key *stream = &key;
    static const char interesting[] = "[]{},:\"\\ \n-+.eE0123456789tfnu\xff\xc3\xed\xf4\x80";
    usize edits = (usize)test_json_uniform(take(stream), 1, 4);
    for (usize e = 0; e < edits && length > 0; e++) {
        random::Key edit = take(stream);
        random::Key *edit_stream = &edit;
        usize at = (usize)test_json_uniform(take(edit_stream), 0, (i64)length - 1);
        char byte = interesting[test_json_uniform(take(edit_stream), 0, (i64)sizeof interesting - 2)];
        switch (test_json_uniform(take(edit_stream), 0, 5)) {
        case 0:
            bytes[at] = byte;
            break;
        case 1:
            bytes[at] = (char)random::key_bits(take(edit_stream));
            break;
        case 2:
            length = at;
            break; // truncate
        case 3:    // delete one byte
            __builtin_memmove(bytes + at, bytes + at + 1, length - at - 1);
            length -= 1;
            break;
        case 4: // insert one
            if (length < capacity) {
                __builtin_memmove(bytes + at + 1, bytes + at, length - at);
                bytes[at] = byte;
                length += 1;
            }
            break;
        default:
            bytes[at] = (char)((u8)bytes[at] ^ (1U << (u32)test_json_uniform(take(edit_stream), 0, 7)));
            break;
        }
    }
    return length;
}

// The reader and the tree agree on whether the bytes are a document, report an offset inside the input, and read
// nothing outside it (the input sits exactly in its own arena push, so AddressSanitizer sees a stray read).
static void test_json_judge(arena::Arena *arena, const char *bytes, usize length, c::SmithJsonLimits limits) {
    char *exact = arena::push_slice(arena, char, length == 0 ? 1 : length).data;
    __builtin_memcpy(exact, bytes, length);
    const char input[:] = exact[0:length];
    c::SmithJsonReader reader = c::smith_json_reader_make(input, limits);
    c::SmithJsonToken token = c::SmithJsonToken_Null;
    usize steps = 0;
    while (token != c::SmithJsonToken_Error && token != c::SmithJsonToken_End) {
        token = c::smith_json_read(&reader);
        steps += 1;
        test::check_less_equal(steps, length + 2); // each token takes a byte: no hang
        if (token == c::SmithJsonToken_Key || token == c::SmithJsonToken_String) {
            arena::Scope decoding = arena::scope_begin(arena);
            const char decoded[:] = c::smith_json_decode(&reader, arena);
            test::check_equal(countof(decoded), reader.length);
            test::check_less_equal(countof(decoded), limits.string_length);
            arena::scope_end(decoding);
        }
    }
    const c::SmithJsonValue *root = nullptr;
    c::SmithJsonError error = {};
    arena::Scope scope = arena::scope_begin(arena);
    bool parsed = c::smith_json_parse(arena, input, limits, &root, &error);
    test::check(parsed == (token == c::SmithJsonToken_End));
    if (parsed) {
        test::check_equal(root->span, reader.values);
    } else {
        test::check(error.reason != c::SmithJsonReason_None);
        test::check_less_equal(error.offset, length);
        test::check_equal(error.offset, reader.error.offset);
        test::check(error.reason == reader.error.reason);
    }
    arena::scope_end(scope);
}

export void test_json_damaged_documents_never_misbehave(random::Key key) {
    random::Key *key_stream = &key;
    arena::Arena arena = test::memory(1 << 22);
    c::SmithJsonWriter writer;
    constexpr usize size = 1 << 14;
    char *buffer = arena::push_slice(&arena, char, size).data;
    writer = c::smith_json_writer_make(buffer, size, (usize)test_json_uniform(take(key_stream), 0, 1));
    TestJsonDocument *document = arena::push(&arena, TestJsonDocument);
    test_json_random_value(&writer, document, take(key_stream), 6);
    const char output[:] = {};
    test::check(c::smith_json_writer_finish(&writer, &output));
    char damaged[1 << 14];
    __builtin_memcpy(damaged, output.data, countof(output));
    usize length = test_json_damage(take(key_stream), damaged, countof(output), sizeof damaged);
    test::note("damaged %.*s", (i32)length > 400 ? 400 : (i32)length, damaged);
    test_json_judge(&arena, damaged, length, test_json_wide);
    c::SmithJsonLimits tight = {.depth = 3, .string_length = 6, .count = 12};
    test_json_judge(&arena, damaged, length, tight);
    test_json_judge(&arena, output.data, countof(output), tight); // and an undamaged one under tight limits
}

export void test_json_random_bytes_never_misbehave(random::Key key) {
    random::Key *key_stream = &key;
    arena::Arena arena = test::memory(1 << 20);
    usize length = (usize)test_json_uniform(take(key_stream), 0, 64);
    char bytes[64];
    for (usize i = 0; i < length; i++) {
        bytes[i] = (char)random::key_bits(take(key_stream));
        if (random::bernoulli_sample(take(key_stream), (random::Bernoulli){.probability = 0.6}))
            bytes[i] = "[]{}:,\" 0-1e.tfnu\\"[random::key_bits(take(key_stream)) % 19]; // mostly structure
    }
    test_json_judge(&arena, bytes, length, test_json_wide);
}

// ---------------------------------------------------------------------------------------------------------------
// JSONTestSuite

// What this library does with the suite's implementation-defined (i_) cases: true if it accepts the document. The
// reasons are in the comments; the document is the suite's file of that name. A change here is a change of behaviour.
typedef struct {
    const char *name;
    bool accepted;
} TestJsonImplementationDefined;

static const TestJsonImplementationDefined test_json_implementation_defined[] = {
    // Numbers are syntax only: the library keeps the text, and the conversion to a f64 refuses what is out of range.
    {"i_number_double_huge_neg_exp.json", true},
    {"i_number_huge_exp.json", true},
    {"i_number_neg_int_huge_exp.json", true},
    {"i_number_pos_double_huge_exp.json", true},
    {"i_number_real_neg_overflow.json", true},
    {"i_number_real_pos_overflow.json", true},
    {"i_number_real_underflow.json", true},
    {"i_number_too_big_neg_int.json", true},
    {"i_number_too_big_pos_int.json", true},
    {"i_number_very_big_negative_int.json", true},
    // A surrogate escape that is not half of a pair has no UTF-8 form: refused.
    {"i_object_key_lone_2nd_surrogate.json", false},
    {"i_string_1st_surrogate_but_2nd_missing.json", false},
    {"i_string_1st_valid_surrogate_2nd_invalid.json", false},
    {"i_string_incomplete_surrogate_and_escape_valid.json", false},
    {"i_string_incomplete_surrogate_pair.json", false},
    {"i_string_incomplete_surrogates_escape_valid.json", false},
    {"i_string_invalid_lonely_surrogate.json", false},
    {"i_string_invalid_surrogate.json", false},
    {"i_string_inverted_surrogates_U+1D11E.json", false},
    {"i_string_lone_second_surrogate.json", false},
    // Bytes that are not UTF-8, or not JSON's encoding at all: refused.
    {"i_string_UTF-16LE_with_BOM.json", false},
    {"i_string_UTF-8_invalid_sequence.json", false},
    {"i_string_UTF8_surrogate_U+D800.json", false},
    {"i_string_invalid_utf-8.json", false},
    {"i_string_iso_latin_1.json", false},
    {"i_string_lone_utf8_continuation_byte.json", false},
    {"i_string_not_in_unicode_range.json", false},
    {"i_string_overlong_sequence_2_bytes.json", false},
    {"i_string_overlong_sequence_6_bytes.json", false},
    {"i_string_overlong_sequence_6_bytes_null.json", false},
    {"i_string_truncated-utf-8.json", false},
    {"i_string_utf16BE_no_BOM.json", false},
    {"i_string_utf16LE_no_BOM.json", false},
    // 500 nested arrays: accepted while the caller's depth limit allows it (these tests ask for 512).
    {"i_structure_500_nested_arrays.json", true},
    // A byte order mark is refused.
    {"i_structure_UTF-8_BOM_empty_object.json", false},
};

typedef struct {
    usize y_total;
    usize y_accepted;
    usize n_total;
    usize n_refused;
    usize i_total;
    usize i_as_listed;
} TestJsonConformance;

static bool test_json_suite_accepts(arena::Arena *arena, const char bytes[:]) {
    c::SmithJsonLimits limits = {.depth = c::smith_json_depth_max, .string_length = 1 << 20, .count = 1 << 20};
    arena::Scope scope = arena::scope_begin(arena);
    const c::SmithJsonValue *root = nullptr;
    c::SmithJsonError error = {};
    bool accepted = c::smith_json_parse(arena, bytes, limits, &root, &error);
    c::SmithJsonReader reader = c::smith_json_reader_make(bytes, limits);
    c::SmithJsonToken token = c::SmithJsonToken_Null;
    while (token != c::SmithJsonToken_Error && token != c::SmithJsonToken_End) {
        token = c::smith_json_read(&reader);
    }
    test::check(accepted == (token == c::SmithJsonToken_End)); // the two layers agree
    arena::scope_end(scope);
    return accepted;
}

static const TestJsonImplementationDefined *test_json_find_listed(const char *name) {
    for (usize i = 0; i < _Countof test_json_implementation_defined; i++) {
        if (c::strcmp(test_json_implementation_defined[i].name, name) == 0) return &test_json_implementation_defined[i];
    }
    return nullptr;
}

constexpr usize test_json_listing_capacity = 1 << 17;

// Runs every file of the suite's test_parsing folder. The folder and where to list what was done with each case come
// from the environment of the io (tests/json.sh fetches the package and sets them); the files are read through the
// io's files. Prints nothing when it passes; a failure names the file.
export void test_json_conformance_with_jsontestsuite(io::Io *io) {
    const char *folder = io::args_env(&io->args, "SMITH_JSON_SUITE");
    if (folder == nullptr || folder[0] == '\0') return; // not fetched: tests/json.sh says so
    const char *listing_path = io::args_env(&io->args, "SMITH_JSON_LISTING");
    bool listing = listing_path != nullptr && listing_path[0] != '\0';
    char *report = arena::push_slice(&io->arena, char, test_json_listing_capacity).data;
    usize reported = 0;
    TestJsonConformance totals = {};
    io::FileList names = io::files_list(&io->files, &io->arena, folder);
    test::check_equal(names.error.code, 0);
    for (usize i = 0; i < names.count; i++) {
        const char *name = names.entries[i].name;
        usize name_length = c::strlen(name);
        if (name_length < 7 || c::strcmp(name + name_length - 5, ".json") != 0 || name[1] != '_') continue;
        char path[1024];
        (void)format::to(path, sizeof path, folder, "/", name);
        test::note("file %s", name);
        arena::Scope scope = arena::scope_begin(&io->arena);
        io::Read file = io::files_read(&io->files, &io->arena, path);
        test::check_equal(file.error.code, 0);
        const char contents[:] = ((const char *)file.data.data)[0:countof(file.data)];
        bool accepted = test_json_suite_accepts(&io->arena, contents);
        arena::scope_end(scope);
        if (name[0] == 'y') {
            totals.y_total += 1;
            totals.y_accepted += accepted ? 1 : 0;
            test::check(accepted);
        } else if (name[0] == 'n') {
            totals.n_total += 1;
            totals.n_refused += accepted ? 0 : 1;
            test::check(!accepted);
        } else if (name[0] == 'i') {
            const TestJsonImplementationDefined *listed = test_json_find_listed(name);
            totals.i_total += 1;
            if (listing)
                reported += format::to(report + reported, test_json_listing_capacity - reported,
                                       format::left(accepted ? "accepted" : "refused", 9), " ", name, "\n")
                                .length;
            test::check(listed != nullptr); // a new case must be listed
            totals.i_as_listed += listed != nullptr && listed->accepted == accepted ? 1 : 0;
            test::check(listed->accepted == accepted);
        }
    }
    if (listing) {
        reported += format::to(report + reported, test_json_listing_capacity - reported, "y_: ", totals.y_accepted,
                               " of ", totals.y_total, " accepted; n_: ", totals.n_refused, " of ", totals.n_total,
                               " refused; i_: ", totals.i_as_listed, " of ", totals.i_total, " as listed\n")
                        .length;
        test::check_equal(io::files_write(&io->files, listing_path, test_io_bytes(report, reported), io::Replace).code,
                          0);
    }
    test::note("y %zu/%zu accepted, n %zu/%zu refused, i %zu/%zu as listed", totals.y_accepted, totals.y_total,
               totals.n_refused, totals.n_total, totals.i_as_listed, totals.i_total);
    test::check_equal(totals.y_total, totals.y_accepted);
    test::check_equal(totals.n_total, totals.n_refused);
    usize listed_count = _Countof test_json_implementation_defined;
    test::check_equal(totals.i_total, listed_count);
    test::check_greater_equal(totals.y_total, 95);
    test::check_greater_equal(totals.n_total, 188);
}
