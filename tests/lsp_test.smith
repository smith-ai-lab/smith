export void test_lsp_query_diag_of_an_edit_made_outside_the_editor() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "q")) {
        return;
    }
    scratch::Run edited = scratch::sh(&p, "printf 'void f(void) { printf(\"x\"); }\\n' >>user.smith");
    scratch::expect_status("query diag: the edit", 0, &edited);
    const char *diag = query(&p, "diag user.smith");
    scratch::expect_contains("query diag: an edit made outside the editor is an error at its place", diag,
                             "user.smith:18:16: error: ");
    scratch::expect_contains("query diag: ... naming printf", diag, "printf");
    scratch::Run run = scratch::sh(&p, "smith lsp diag user.smith >/dev/null 2>&1");
    scratch::expect_status("query diag: and exit status 1", 1, &run);
}

