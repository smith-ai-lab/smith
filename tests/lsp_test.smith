export void test_lsp_query_a_c_only_folder() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, true)) {
        return;
    }
    scratch::Project p = folder(&root, "qc");
    scratch::Run written = scratch::sh(
        &p, "printf '[{\"directory\": \"%s\", \"file\": \"c_only.c\", \"command\": \"cc -c c_only.c\"}]\\n' "
            "\"$(pwd -P)\" >compile_commands.json");
    scratch::expect_status("query C-only: the compile database", 0, &written);
    scratch::expect_text(
        "query C-only: def, refs and symbols of C names",
        "c_only.c:1:5: function: twice: int twice(int x) {\n"
        "c_only.c:1:5: ref: int twice(int x) {\n"
        "c_only.c:6:12: ref: return twice(2) + twice(2);\n"
        "c_only.c:6:23: ref: return twice(2) + twice(2);\n"
        "c_only.c:1:1: function: twice\n"
        "c_only.c:5:1: function: four",
        scratch::capture(&p, "printf 'def twice\\nrefs twice\\nsymbols c_only.c\\n' | smith lsp - 2>/dev/null"));
}

// --- no project at all: folders with no build.c and no compile_commands.json --------------------------------------
// where clangd's fallback command amounts to `clang main.smith`. A .smith file gets what `smith cc` gives it (`-x c`,
// `-std=gnu2y`: smith_lang_command), so the editor reads it as the CLI does.

export void test_lsp_solo_a_single_file_with_no_database() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
