// Two modules with no build.c: `import foo` is found by its source, in the place the module name implies.
export void test_lsp_modules_build_and_open() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, true)) {
        return;
    }
    scratch::Project p = folder(&root, "modules");
    scratch::expect_text("modules: the same two files build and run with smith cc", "20",
                         scratch::capture(&p, "smith cc main.smith foo.smith -o demo 2>&1 && ./demo"));
    const char *log = session(&p, "open main.smith foo.smith");
    scratch::expect_count("modules: both files open", 2, count_prefix(log, "diagnostics "));
    expect_no_lines("modules: with no diagnostics", log, "diag ");
}

export void test_lsp_modules_a_typo_in_a_call() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, true)) {
        return;
    }
    scratch::Project p = folder(&root, "modules");
    const char *log = session(&p, "open main.smith foo.smith -- replace main.smith 'foo::f' 'foo::zzzzzz'");
    expect_line("modules: a typo in a call is one error, at the name, as written", log,
                "diag main.smith:6:18: Use of undeclared identifier 'foo::zzzzzz'");
    scratch::expect_count("modules: and the only one", 1, count_prefix(log, "diag "));
}

// A name close to a real one: the suggestion is as written, and the note is at the declaration in foo.smith (the module
// is read from its source, so there is no header; its interface keeps the module's lines and columns).
export void test_lsp_modules_a_name_close_to_a_real_one() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, true)) {
        return;
    }
    scratch::Project p = folder(&root, "modules");
    const char *log = session(&p, "open main.smith foo.smith -- replace main.smith 'foo::f' 'foo::g'");
    const char *dir = scratch::capture(&p, "pwd -P");
    expect_line("modules: a name close to a real one, the note in the module's source", log,
                join("diag main.smith:6:18: Use of undeclared identifier 'foo::g'; did you mean 'foo::f'? (fix "
                     "available) |  | ",
                     dir, "/foo.smith:3:12: | note: 'foo::f' declared here"));
}

export void test_lsp_modules_hover_definition_symbols_references() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, true)) {
        return;
    }
    scratch::Project p = folder(&root, "modules");
    const char *log =
        session(&p, "open main.smith foo.smith -- hover main.smith 6 18 -- definition main.smith 6 18 "
                    "foo.smith:3:12 -- hover foo.smith 3 12 -- hover foo.smith 7 41 -- symbols foo.smith -- "
                    "references foo.smith 3 12 -- highlight foo.smith 3 12");
    expect_line("modules: hover on a call into the other module, as written", log,
                "hover main.smith:6:18: function foo::f |  | provided by \"foo.smith\" |  | → int32_t (aka int) |  | "
                "Parameters: |  | - int32_t x (aka int) |  | pure |  | int32_t foo::f(int32_t x)");
    expect_line("modules: go-to-definition lands in the other module's source", log,
                "definition main.smith:6:18 -> foo.smith:3:12");
    expect_line("modules: hover at the function's definition", log,
                "hover foo.smith:3:12: function f |  | → i32 (aka int) |  | Parameters: |  | - i32 x (aka int) |  | "
                "pure |  | i32 f(i32 x)");
    expect_line("modules: hover at the type's definition", log,
                "hover foo.smith:7:41: type-alias Pair |  | Type: struct Pair |  | typedef struct Pair Pair");
    scratch::expect_text("modules: symbols, as written, each once",
                         "symbol foo.smith: f symbol foo.smith: (anonymous struct) symbol foo.smith: a symbol "
                         "foo.smith: b symbol foo.smith: Pair symbol foo.smith: sum",
                         joined(log, "symbol "));
    scratch::expect_text("modules: references of the function: its definition and its call",
                         "reference foo.smith:3:12 reference main.smith:6:18", joined(log, "reference "));
    scratch::expect_text("modules: highlights of it: the name once", "highlight 3:12", joined(log, "highlight "));
}

// A function with a declared set: the hover says so, and shows no "Annotation:" line for the attribute's own storage.
