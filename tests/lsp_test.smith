    expect_line("tuples: no diagnostics", log, "diagnostics tuples.smith");
    expect_no_lines("tuples: ... of any kind", log, "diag ");
}

// A `c::` name is a name of the file like another: hover and go-to-definition at it find the one declaration (not every
// declaration of the name, which is what the index answers by name: the SDK's and libc++'s `using`), and the hover of a
// module's name has no label of its symbol. In a .c file of the same project the same requests are as they were.
export void test_lsp_a_c_name_has_one_declaration() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log =
        session(&p, "open main.smith util.c -- hover main.smith 8 8 -- definitions main.smith 8 8 -- hover "
                    "main.smith 7 18 -- hover util.c 8 5 -- definitions util.c 8 5");
    scratch::expect_contains("c::printf: hover", log,
                             "hover main.smith:8:8: function printf |  | provided by <stdio.h>");
    scratch::expect_text("c::printf: exactly one definition", "definitions main.smith:8:8: 1",
                         joined(log, "definitions main.smith:8:8"));
    scratch::expect_lacks("box::area: a hover without the label of the symbol", joined(log, "hover main.smith:7:18"),
                          "asm(");
    scratch::expect_contains("c: fprintf in a .c file, hover", log,
                             "hover util.c:8:5: function fprintf |  | provided by <stdio.h>");
    scratch::expect_text("c: fprintf in a .c file, exactly one definition", "definitions util.c:8:5: 1",
                         joined(log, "definitions util.c:8:5"));
}

// The other requests at a definition: references, highlights and rename find the name once, at its place (the copy of
// the head that carries the symbol is no second declaration), and never go to the generated header.
export void test_lsp_references_highlights_and_rename_at_a_definition() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log =
        session(&p, "open main.smith geometry/box.smith -- references geometry/box.smith 5 12 -- highlight "
                    "geometry/box.smith 5 12 -- rename geometry/box.smith 9 5 thrice -- rename "
                    "geometry/box.smith 3 50 Square");
    scratch::expect_text("references: the definition and the call, nothing in .smith/include",
                         "reference geometry/box.smith:5:12 reference main.smith:7:18", joined(log, "reference "));
    scratch::expect_text("highlight: the name once", "highlight 5:12", joined(log, "highlight "));
    expect_line("rename: a private function, at its definition", log,
                "rename geometry/box.smith:9:5: geometry/box.smith:9:5 -> thrice");
    expect_line("rename: and at its use", log, "rename geometry/box.smith:9:5: geometry/box.smith:14:12 -> thrice");
    scratch::expect_lacks("rename: an edit is never in a generated header", joined(log, "rename "), ".smith/include");
}

// Completion of a name being typed. Anywhere it is offered as it is written, and inserted so (`box::area`, which the
// editor replaces the typed `geometry_box_ar` with).
export void test_lsp_completion_of_a_name_being_typed() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log = session(&p, "open complete.smith geometry/box.smith -- complete complete.smith 5 20");
    expect_line("complete: a module's function by its prefix, as written, with its edit", log,
                "complete complete.smith:5:20:  box::area(box::Box b) -> 5:5-5:20 box::area");
}

// After `box::` the module's exports are offered, as their members, and the text the editor has typed stays: the edit
// replaces only what comes after the `::`.
export void test_lsp_completion_after_a_module_name() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log = session(&p, "open qualified.smith geometry/box.smith -- complete qualified.smith 5 17 -- replace "
                                  "qualified.smith 'box::;' 'box::pe;' -- complete qualified.smith 5 19");
    expect_line("complete after box::: a function, inserted as foo::f would be written", log,
                "complete qualified.smith:5:17:  area(Box b) -> 5:17-5:17 area");
    expect_line("complete after box::: another", log,
                "complete qualified.smith:5:17:  perimeter(Box b) -> 5:17-5:17 perimeter");
    scratch::expect_count("complete after box::: and nothing else (no private function, no type, no C name)", 2,
                          count_prefix(log, "complete qualified.smith:5:17: "));
    scratch::expect_text("complete after box::pe: what was typed narrows it, and the edit covers it",
                         "complete qualified.smith:5:19:  perimeter(Box b) -> 5:17-5:19 perimeter",
                         joined(log, "complete qualified.smith:5:19: "));
}

// Plain C in a .c file of the same project is C: its error at its place, hover as ever.
export void test_lsp_plain_c_in_the_same_project() {
