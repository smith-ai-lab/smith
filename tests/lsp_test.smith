    defer mem::set_allocator(outside);
    if (!prepare(&root, true)) {
        return;
    }
    scratch::Project p = folder(&root, "solo");
    const char *log = session(&p, "open main.smith");
    expect_line("solo: a single file with no database is read", log, "diagnostics main.smith");
    expect_no_lines("solo: and has no diagnostics", log, "diag ");
}

// `i32 main(str args[:])` lowers to a head and the statements that make `args`; the editor's token buffer used to walk
// them for ever (issue #523), one core at 100%. The client gives the server 10 s of CPU time to answer.
export void test_lsp_main_with_args_ends() {
    scratch::Project root = scratch::make("lsp", "lsp");
