        return;
    }
    scratch::Project p = folder(&root, "mainargs");
    const char *log = session(&p, "open main.smith");
    expect_line("main with args: the file is read", log, "diagnostics main.smith");
    expect_no_lines("main with args: and has no diagnostics", log, "diag ");
}

