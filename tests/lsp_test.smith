// `if constexpr` outside a generic: the branch taken is ordinary code (hover works in it), the branch not taken is
// never given to the parser, so an undeclared name there is no diagnostic and hover there is empty (as in a generic's
// instance that was not made). A condition that is no constant is reported at the condition. The `target::` facts are
// literals to the compiler.
export void test_lsp_if_constexpr() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log = session(&p, "open choice.smith -- hover choice.smith 6 16 -- hover choice.smith 8 16");
    expect_line("if constexpr: the branch not taken has no diagnostics", log, "diagnostics choice.smith");
    expect_no_lines("if constexpr: ... of any kind, the undeclared name included", log, "diag choice.smith:8");
    expect_one_line("if constexpr: a name in the branch taken is hovered as in any code", log,
                    "hover choice.smith:6:16: param x");
    expect_line("if constexpr: a name in the branch not taken has no hover", log, "hover choice.smith:8:16: (nothing)");
    expect_one_line("if constexpr: a condition that is no constant is reported at the condition, as written", log,
                    "diag choice.smith:15:26: In `if constexpr`: `y` is not a constant");
}

// A tuple, `struct { i32, f32 }`, `t[0]` and `countof(t)`: no diagnostics, and a hover on the member finds its type.
export void test_lsp_tuples() {
    scratch::Project root = scratch::make("lsp", "lsp");
