    expect_line("modules: foo:: offers the module's function, inserted as written", log,
                "complete qualified.smith:5:17:  f(int32_t x) -> 5:17-5:17 f");
    expect_line("modules: and another", log, "complete qualified.smith:5:17:  sum(Pair p) -> 5:17-5:17 sum");
    scratch::expect_count("modules: and nothing else", 2, count_prefix(log, "complete "));
}

// `c::` names of every kind, in a folder with no database: a function, a function of a local header, a type, a macro
// for a variable, a function-like macro and a constant macro. Each hover finds the declaration it names, and
// go-to-definition has exactly one answer. The columns are those of the fixture's main.smith.
constexpr char cinterop_hovers[_] =
    "open main.smith -- hover main.smith 7 19 -- hover main.smith 9 8 -- hover main.smith 9 21 -- hover main.smith 10 "
    "8 "
    "-- hover main.smith 10 58 -- hover main.smith 10 104 -- hover main.smith 10 112 -- definitions main.smith 7 19 -- "
    "definitions main.smith 9 8 -- definitions main.smith 9 21 -- definitions main.smith 10 8 -- definitions "
    "main.smith 10 58 -- definitions main.smith 10 104 -- definitions main.smith 10 112";

export void test_lsp_cinterop_builds_and_runs() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, true)) {
        return;
    }
    scratch::Project p = folder(&root, "cinterop");
    scratch::expect_text("cinterop: it builds and runs", "9.0 1 3 eof=-1 99",
                         scratch::capture(&p, "smith cc main.smith -o demo -lm 2>&1 && ./demo"));
}

export void test_lsp_cinterop_hover() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, true)) {
        return;
    }
    scratch::Project p = folder(&root, "cinterop");
    const char *log = session(&p, cinterop_hovers);
    expect_no_lines("cinterop: no diagnostics", log, "diag ");
    expect_one_line("cinterop: hover on a function, c::sqrtf", log,
                    "hover main.smith:7:19: function sqrtf |  | provided by <math.h>");
    expect_one_line("cinterop: hover on a type, c::FILE", log,
                    "hover main.smith:9:8: type-alias FILE |  | provided by <stdio.h>");
    expect_one_line("cinterop: hover on a macro for a variable, c::stdin", log,
                    "hover main.smith:9:21: macro stdin |  | provided by <stdio.h>");
    expect_one_line("cinterop: hover on a variadic function, c::printf", log,
                    "hover main.smith:10:8: function printf |  | provided by <stdio.h>");
    expect_one_line("cinterop: hover on a function-like macro, c::WIFEXITED", log,
                    "hover main.smith:10:58: macro WIFEXITED |  | provided by <sys/wait.h>");
    expect_one_line("cinterop: hover on a constant macro, c::EOF", log,
                    "hover main.smith:10:104: macro EOF |  | provided by <stdio.h>");
    expect_one_line("cinterop: hover on a function of a local header, c::local_value", log,
                    "hover main.smith:10:112: function local_value |  | provided by \"local.h\"");
}

export void test_lsp_cinterop_exactly_one_definition() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, true)) {
        return;
    }
    scratch::Project p = folder(&root, "cinterop");
    const char *log = session(&p, cinterop_hovers);
    const char *places[7] = {"7:19", "9:8", "9:21", "10:8", "10:58", "10:104", "10:112"};
    for (usize i = 0; i < 7; i++) {
        const char *want = join("definitions main.smith:", places[i], ": 1");
        scratch::expect_text(join("cinterop: exactly one definition at ", places[i], ""), want,
                             joined(log, join("definitions main.smith:", places[i], ":")));
    }
    expect_line("cinterop: c::local_value is defined in its header, at its name", log, "  place local.h:1:19");
}

// A compile database that does not say what a .smith file is: written by hand without `-x c`, or naming only a .c file
// (the .smith files then get a command borrowed from it).
static void check_database_without_a_language(const char *name, const char *database) {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, true)) {
        return;
    }
    scratch::Project p = folder(&root, name);
    scratch::Run made =
        scratch::sh(&root, join(join("mkdir -p ", name, " && cd "), name,
                                join(" && cp ../modules/main.smith ../modules/foo.smith . && ", database, "")));
    scratch::expect_status("lsp: the folder is made", 0, &made);
    const char *log = session(&p, "open main.smith foo.smith -- definition main.smith 6 18 foo.smith:3:12 -- replace "
                                  "main.smith 'foo::f' 'foo::zzzzzz'");
    expect_line("database: the call is found in the other module", log, "definition main.smith:6:18 -> foo.smith:3:12");
    expect_line("database: a typo is one error, at the name", log,
                "diag main.smith:6:18: Use of undeclared identifier 'foo::zzzzzz'");
    scratch::expect_count("database: and the only one", 1, count_prefix(log, "diag "));
}

export void test_lsp_a_handwritten_database_without_x_c() {
    check_database_without_a_language(
        "handwritten",
        "d=$(pwd -P) && printf '[{\"directory\": \"%s\", "
        "\"command\": \"smith-cc -c main.smith -o main.o -std=gnu23\", \"file\": \"main.smith\"},\\n {\"directory\": "
        "\"%s\", \"command\": \"smith-cc -c foo.smith -o foo.o\", \"file\": \"foo.smith\"}]\\n' \"$d\" \"$d\" "
        ">compile_commands.json");
}

export void test_lsp_a_database_naming_only_a_c_file() {
    check_database_without_a_language("borrowed",
                                      "printf 'int util(int x) { return x; }\\n' >util.c && "
                                      "printf '[{\"directory\": \"%s\", \"command\": \"smith-cc -c util.c -o util.o "
                                      "-Wall\", \"file\": \"util.c\"}]\\n' "
                                      "\"$(pwd -P)\" >compile_commands.json");
}

// A project with only .smith/compile_commands.json (issue #43): clangd reads that one, so the define its command has
// reaches the source; a root compile_commands.json, when there is one, is clangd's own choice and wins.
constexpr char needs_database[_] =
    "mkdir -p .smith && printf '[{\"directory\": \"%s\", \"command\": \"smith-cc -c needs.c -o needs.o -DNEEDED=1\", "
    "\"file\": \"needs.c\"}]\\n' \"$(pwd -P)\" >.smith/compile_commands.json";

export void test_lsp_the_smith_folder_database_is_the_projects() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, true)) {
        return;
    }
    scratch::Project p = folder(&root, "smithdir");
    scratch::Run made = scratch::sh(&p, needs_database);
    scratch::expect_status("smith dir: the database", 0, &made);
    const char *log = session(&p, "open needs.c");
    expect_line("smith dir: .smith/compile_commands.json is the project's compile commands (no #error)", log,
                "diagnostics needs.c");
    expect_no_lines("smith dir: ... and nothing is reported", log, "diag ");
}

export void test_lsp_a_root_database_wins_over_the_smith_folder() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, true)) {
        return;
    }
    scratch::Project p = folder(&root, "rootwins");
    scratch::Run made =
        scratch::sh(&p, join(needs_database,
                             " && printf '[{\"directory\": \"%s\", \"command\": \"smith-cc -c needs.c -o needs.o\", "
                             "\"file\": \"needs.c\"}]\\n' \"$(pwd -P)\" >compile_commands.json",
                             ""));
    scratch::expect_status("smith dir: the databases", 0, &made);
    const char *log = session(&p, "open needs.c");
    expect_one_line("smith dir: a root compile_commands.json wins (the #error is reported)", log,
                    "diag needs.c:2:2: Needed");
}

// --- smith's defaults in the editor (issue #43) --------------------------------------------------------------------
// A project with no .clang-format is formatted in smith's style, and one with no .clang-tidy is checked by smith's
// checks; a project's own file replaces smith's whole. The edits are small ones: the one that starts a line is a
// newline and the indent. No `.clang-tidy` above these folders, so smith's own is the default.

export void test_lsp_editor_with_no_clang_format_or_tidy_has_smiths() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, false)) {
        return;
    }
    scratch::Project p = folder(&root, "editor-none");
    const char *log = session(&p, "open f.c -- format f.c");
    scratch::expect_count("editor: with no .clang-format, smith's style (an indent of 4)", 1,
                          count_line(log, "format-edit \\n    "));
    expect_one_line("editor: with no .clang-tidy, smith's checks report (misc-no-recursion)", log,
                    "diag f.c:1:5: Function 'f' is within a recursive call chain");
}

export void test_lsp_editor_a_projects_own_files_replace_smiths() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, false)) {
        return;
    }
    scratch::Project p = folder(&root, "editor-own");
    const char *log = session(&p, "open f.c -- format f.c");
    scratch::expect_count("editor: a project's .clang-format replaces smith's (an indent of 3)", 1,
                          count_line(log, "format-edit \\n   "));
    scratch::expect_count("editor: ... and none of smith's indent", 0, count_line(log, "format-edit \\n    "));
    scratch::expect_lacks("editor: a project's .clang-tidy replaces smith's (no recursion finding)", log, "recursive");
}

// smith's naming check judges a .smith file's names as written (`Box`, not `m_Box`), in the editor as in `smith lint`:
// a well-named typedef and enum are quiet, a badly named typedef is flagged at the written name.
export void test_lsp_editor_a_smith_typedef_is_judged_as_written() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, false)) {
        return;
    }
    scratch::Project p = folder(&root, "editor-smith");
    const char *log = session(&p, "open m.smith");
    scratch::expect_text("editor: a .smith typedef is judged as written (only bad_type is flagged)",
                         "diag m.smith:14:3: Invalid case style for typedef 'bad_type' (fix available)",
                         joined(log, "diag "));
}

// A payload enum (issue #198): clangd's token buffer must account for every token the lowering writes for it, or it
// spins forever building the buffer (#205). The file is read, and an error of the dot rule is reported where it was
// written.
export void test_lsp_editor_a_payload_enum_is_read() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, false)) {
        return;
    }
    scratch::Project p = folder(&root, "editor-enum");
    const char *log = session(&p, "open shapes.smith");
    expect_line("editor: a file with a payload enum is read, and the dot rule's error is at the written place", log,
                "diag shapes.smith:13:12: `Shape` has no variant `nothing`");
    scratch::expect_lacks(
        "editor: and the names the lowering writes for the enum (its tag and constants) are not judged", log,
        "Invalid case style");
}

// --- effects across files, in the editor (issue #246) ---------------------------------------------------------------
// a.c's pure function calls noisy, which b.c defines and prints in. The summary of b.c is the build's (made here by the
// compile), the editor reads it, and a.c shows the link's error with the chain. Saving b.c without the print rewrites
// its summary and a.c's diagnostics are published again without the error, with a.c untouched.
constexpr char effects_database[_] =
    "mkdir -p .smith && d=$(pwd -P) && printf "
    "'[{\"directory\":\"%s\",\"file\":\"a.c\",\"output\":\"a.o\",\"arguments\":"
    "[\"smith-cc\",\"-std=gnu2y\",\"-c\",\"a.c\",\"-o\",\"a.o\"]},\\n "
    "{\"directory\":\"%s\",\"file\":\"b.c\",\"output\":"
    "\"b.o\",\"arguments\":[\"smith-cc\",\"-std=gnu2y\",\"-c\",\"b.c\",\"-o\",\"b.o\"]}]\\n' \"$d\" \"$d\" "
    ">.smith/compile_commands.json && cp .smith/compile_commands.json compile_commands.json && "
    "smith cc -std=gnu2y -c b.c -o b.o";

export void test_lsp_effects_across_files_show_the_chain_and_clear_on_save() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, true)) {
        return;
    }
    scratch::Project p = folder(&root, "fx");
    scratch::Run made = scratch::sh(&p, effects_database);
    scratch::expect_status("effects: the database and the summary of b.c", 0, &made);
    const char *log = session(&p, "open a.c b.c -- replace b.c '    printf(\"%d\\n\", x);\n' '' -- save b.c");
    expect_line(
        "effects: a.c shows the error through b.c, with the chain", log,
        "diag a.c:2:41: Smith-effect: `bad` is [[smith::pure]], but it has the effects console, globals: bad -> noisy "
        "(a.c:2) -> printf (b.c:4)");
    scratch::expect_count("effects: after b.c is saved without the print, a.c has no diagnostics again", 1,
                          count_prefix(log, "diag a.c"));
}

// Hover on a call into another file shows what the summaries say of the callee (the same solve that judged the file),
// with only a.c open: it does not depend on b.c having been parsed first in the session.
export void test_lsp_effects_hover_on_a_call_into_another_file() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, true)) {
        return;
    }
    scratch::Project p = folder(&root, "fx");
    scratch::Run made = scratch::sh(&p, effects_database);
    scratch::expect_status("effects: the database and the summary of b.c", 0, &made);
    const char *log = session(&p, "open a.c -- hover a.c 2 41");
    expect_line("effects: hover on a call into b.c shows the callee's effects, with b.c closed", log,
                "hover a.c:2:41: function noisy |  | → int |  | Parameters: |  | - int x |  | effects: console, "
                "globals |  | int "
                "noisy(int x)");
}

// A proved index is no failure point in the editor either (issue #325): the hover of a function whose index `smith
// prove` proved does not say `effects: fails`, and the same function before the proof does.
static const char *state_dump = "echo '--- ls -l .smith/effects'; ls -l .smith/effects 2>&1; "
                                "for f in .smith/effects/*.fx; do echo \"--- $f\"; cat \"$f\"; done 2>&1; "
                                "echo '--- .smith/compile_commands.json'; cat .smith/compile_commands.json 2>&1";

export void test_lsp_hover_has_no_fails_for_a_proved_index() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!prepare(&root, true)) {
        return;
    }
    scratch::sh(&root, "mkdir -p proof");
    scratch::Project p = folder(&root, "proof");
    scratch::write(&p, "pick.smith",
                   "module pick;\nimport bounds;\nimport smith::contract;\n"
                   "export i32 at(usize i) {\n"
                   "    i32 buffer[8] = {1, 2, 3, 4, 5, 6, 7, 8};\n"
                   "    i32 window[:] = buffer;\n"
                   "    usize j = bounds::clamp(i);\n"
                   "    contract::ensures(true);\n"
                   "    return window[j];\n"
                   "}\n");
    scratch::write(&p, "bounds.smith",
                   "module bounds;\nimport smith::contract;\n"
                   "export usize clamp(usize n) {\n"
                   "    usize r = n < 8 ? n : 7;\n"
                   "    contract::ensures(r < 8);\n"
                   "    return r;\n"
                   "}\n");
    scratch::write(&p, "main.smith", "module main;\nimport pick;\ni32 main() { return pick::at(1) - 2; }\n");
    scratch::Run built = scratch::build(&p, "");
    scratch::expect_status("the project builds", 0, &built);
    scratch::sh(&p, "rm -rf .smith/effects"); // #813: the editor starts with no summary, as on a loaded runner
    const char *before = session(&p, "open pick.smith -- hover pick.smith 4 12");
    if (!scratch::contains(before, "effects: fails") || scratch::contains(before, "effects: unknown, fails")) { // #813
        scratch::Run state = scratch::sh(&p, state_dump);
        test::note("the hover before the proof is not `effects: fails`.\nhover: %s\nstate of the project:\n%s", before,
                   state.out);
    }
    scratch::expect_contains("before the proof the hover says fails", before, "effects: fails");
    scratch::expect_lacks("before the proof the hover does not say unknown (a summary not yet written)", before,
                          "effects: unknown, fails");
    scratch::Run proved = scratch::sh(&p, "smith prove 2>&1");
    scratch::expect_status("the index is proved", 0, &proved);
    scratch::Run rebuilt = scratch::build(&p, ""); // the editor reads the summaries a build writes
    scratch::expect_status("the project builds again", 0, &rebuilt);
    const char *after = session(&p, "open pick.smith -- hover pick.smith 4 12");
    scratch::expect_contains("the hover is of the function", after, "function at");
    if (scratch::contains(after, "effects: fails")) { // #813: flaky in CI; say what the editor could have read
        scratch::Run state = scratch::sh(&p, state_dump);
        test::note("the hover still says fails after the proof.\nhover: %s\nstate of the project:\n%s", after,
                   state.out);
    }
    scratch::expect_lacks("after the proof it does not", after, "effects: fails");
}
