// Tests of `smith lsp` on .smith and C files (issue #26, from tests/lsp.sh): a real `smith lsp` session driven by
// tests/lsp_client.c, which writes the JSON-RPC and prints one line for each thing the server answered. The project is
// the fixture tests/build_fixtures/lsp (a folder for each case: p, q, solo, modules, ...), copied into the test's
// scratch folder. Diagnostics, including the lowering's own, are checked at the lines and columns of the .smith text,
// so are hover, go-to-definition across modules, symbols and completion; so is a C file of the same project, which
// must behave as it always has. A smith without clang inside (the stage0), without clangd or without the token hook
// has nothing to test, and the tests do nothing.
module lsp_test;

import smith::arena;
import smith::format;
import smith::test;
import scratch;
import <string.h>;
import smith::mem;

// The pieces one after another, in the current allocator (the test's arena).
static const char *join(const char *a, const char *b, const char *c) {
    usize length = format::length(a, b, c);
    char *out = mem::alloc_slice(char, length + 1).data;
    (void)format::to(out, length + 1, a, b, c);
    return out;
}

// The project is smith's lsp fixture; its folders hold what each test opens.
static scratch::Project folder(const scratch::Project *root, const char *name) {
    scratch::Project f = *root;
    f.dir = join(root->dir, "/", name);
    return f;
}

// Whether this smith can run the tests: clang inside, clangd inside, the token hook.
constexpr char probe_script[_] =
    "[ \"$(smith cc --smith-which -c a.c | head -n 1 | cut -d ' ' -f 1,2)\" = 'clang in-process' ] && "
    "smith lsp --version >/dev/null 2>&1 && printf 'int main(void) { return 0; }\\n' >probe.smith && "
    "! smith cc --smith-lower probe.smith 2>&1 | grep -q 'token hook'";

// The fixture (scratch::make("lsp", "lsp")), the client built, and (checks off, as the original's) smith's default
// clang-tidy replaced by one that reports nothing, since these tests are about the lowering's and the compiler's
// diagnostics. False when the smith under test has no editor support.
static bool prepare(const scratch::Project *root, bool tidy_off) {
    if (scratch::sh(root, probe_script).status != 0) {
        return false;
    }
    if (tidy_off) {
        scratch::write(root, ".clang-tidy", "Checks: \"-*\"\n");
    }
    scratch::copy_tree(root, "tests/lsp_client.c", "tests/lsp_client.c");
    scratch::copy_tree(root, "tests/cpu_wait.h", "tests/cpu_wait.h");
    scratch::Run built = scratch::sh(root, "smith cc -std=gnu23 tests/lsp_client.c -o ../lsp_client");
    scratch::expect_status("lsp: tests/lsp_client.c builds", 0, &built);
    return true;
}

// A project that builds: the folder, built with smith build. The built folder is made once for each smith under test
// and each name, in the tests' cache ($SMITH_TEST_CACHE/lsp-<smith's size and time>/<name>, the way new_test.smith's
// `generate` does), and a test copies it and runs `smith build` there, which writes the paths of the copy again (a
// no-op build: 0.2 s of CPU against 1.5 s for the first build, for 28 tests that each built the same folder).
constexpr char built_script[_] =
    "key=$(stat -c %Y-%s \"$SMITH_SELF\" 2>/dev/null || stat -f %m-%z \"$SMITH_SELF\"); "
    "base=$SMITH_TEST_CACHE/lsp-$key; c=$base/$name; lock=$base.lock-$name; "
    "if [ ! -d \"$c\" ] && mkdir \"$lock\" 2>/dev/null; then "
    "find \"$SMITH_TEST_CACHE\" -maxdepth 1 -name 'lsp-*' -mtime +1 -exec rm -rf {} + 2>/dev/null; "
    "tmp=$base.$$; mkdir -p \"$tmp\" && cp -Rp \"$name\" \"$tmp/$name\" && (cd \"$tmp/$name\" && smith build "
    ">/dev/null "
    "2>&1) && mkdir -p \"$base\" && mv \"$tmp/$name\" \"$c\"; rm -rf \"$tmp\"; rmdir \"$lock\"; "
    "else i=0; while [ ! -d \"$c\" ] && [ -d \"$lock\" ] && [ $i -lt 3000 ]; do sleep 0.2; i=$((i + 1)); done; fi; "
    "[ ! -d \"$c\" ] || cp -Rp \"$c/.\" \"$name\"";

static bool make_built(const scratch::Project *root, scratch::Project *p, const char *name) {
    if (!prepare(root, true)) {
        return false;
    }
    scratch::Run copied = scratch::sh(root, join("name=", name, join("; ", built_script, "")));
    scratch::expect_status("lsp: the built folder is copied", 0, &copied);
    *p = folder(root, name);
    scratch::Run built = scratch::build(p, "");
    scratch::expect_status("lsp: the project builds", 0, &built);
    return true;
}

// The lines the client printed for the commands: `smith lsp` from the folder, with its root, and stderr too. The client
// is in the folder scratch::make made, beside the project.
static const char *session(const scratch::Project *p, const char *commands) {
    const char *client = join("\"", p->root, "/lsp_client\" \"$(command -v smith)\" \"$(pwd -P)\" ");
    return scratch::sh(p, join(client, commands, " 2>&1")).out;
}

// The log has the whole line.
static bool has_line(const char *log, const char *line) {
    return scratch::contains(join("\n", log, "\n"), join("\n", line, "\n"));
}

static void expect_line(const char *name, const char *log, const char *line) {
    if (!has_line(log, line)) {
        test::note("%s: expected the line: %s\nactual: %s", name, line, log);
    }
    test::check_condition(has_line(log, line));
}

// How many lines of the log start with the prefix.
static usize count_prefix(const char *log, const char *prefix) {
    const char *haystack = join("\n", log, "");
    const char *needle = join("\n", prefix, "");
    usize count = 0;
    for (const char *at = c::strstr(haystack, needle); at != nullptr; at = c::strstr(at + 1, needle)) {
        count++;
    }
    return count;
}

// The lines that start with the prefix, joined by a space.
static const char *joined(const char *log, const char *prefix) {
    usize length = c::strlen(log);
    usize prefix_length = c::strlen(prefix);
    char *out = mem::alloc_slice(char, length + 2).data;
    usize used = 0;
    for (const char *line = log; *line != '\0';) {
        usize size = c::strcspn(line, "\n");
        if (size >= prefix_length && c::strncmp(line, prefix, prefix_length) == 0) {
            if (used > 0) {
                out[used++] = ' ';
            }
            mem::copy(out[used:used + size], line[0:size]);
            used += size;
        }
        line += size + (line[size] == '\n' ? 1U : 0U);
    }
    out[used] = '\0';
    return out;
}

// How many lines of the log are the line.
static usize count_line(const char *log, const char *line) {
    const char *haystack = join("\n", log, "\n");
    const char *needle = join("\n", line, "\n");
    usize count = 0;
    for (const char *at = c::strstr(haystack, needle); at != nullptr; at = c::strstr(at + 1, needle)) {
        count++;
    }
    return count;
}

static void expect_no_lines(const char *name, const char *log, const char *prefix) {
    scratch::expect_count(name, 0, count_prefix(log, prefix));
}

static void expect_one_line(const char *name, const char *log, const char *prefix) {
    scratch::expect_count(name, 1, count_prefix(log, prefix));
}

// --- the project p: .smith modules and C files built by `smith build` -------------------------------------------

export void test_lsp_the_project_builds_runs_and_has_compile_commands() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    scratch::expect_text("lsp: the program runs", "area 6.000000", scratch::capture(&p, "build/demo 2>&1"));
    scratch::expect_text("lsp: compile_commands.json tells clangd the language of a .smith file", "7",
                         scratch::capture(&p, "grep -c '\"-x\"' compile_commands.json"));
}

// The three .smith files open together (their lowerings take turns), with nothing wrong in two of them and the
// lowering's own error and clang's in the third, at the lines and columns of the text as written, and naming things as
// they are written: `box::missing`, never the compiler's `geometry_box_missing`.
export void test_lsp_open_reports_diagnostics_as_written() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log = session(&p, "open main.smith geometry/box.smith bad.smith");
    expect_line("open: the clean module has no diagnostics", log, "diagnostics main.smith");
    expect_no_lines("open: and nothing else is reported for it", log, "diag main.smith");
    expect_no_lines("open: the other module has none", log, "diag geometry/box.smith");
    expect_line("open: the lowering's error is at the name", log,
                "diag bad.smith:7:5: `printf` is a C name; write `c::printf`");
    expect_line("open: an unknown member of a module is clang's, at the member, named as written", log,
                "diag bad.smith:8:10: Use of undeclared identifier 'box::missing'");
    expect_line("open: a field that is not there, in a type named as written", log,
                "diag bad.smith:9:14: No member named 'nothing' in 'box::Box'");
    scratch::expect_count("open: and nothing more in it", 3, count_prefix(log, "diag bad.smith"));
}

// A name close to a real one: "did you mean" says it as written, and the note is at the declaration in the module's
// .smith, not in the header that `smith build` wrote for it (.smith/include/geometry/box.h).
export void test_lsp_a_close_name_is_suggested_as_written() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log = session(&p, "open typo.smith geometry/box.smith");
    expect_line("typo: the suggestion and its note are as written, the note is in the module", log,
                "diag typo.smith:5:17: Use of undeclared identifier 'box::aera'; did you mean 'box::area'? (fix "
                "available) |  | geometry/box.smith:5:12: | note: 'box::area' declared here");
}

// An edit in the editor moves the diagnostic with the text.
export void test_lsp_an_edit_moves_the_diagnostic() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log = session(&p, "open main.smith -- replace main.smith 'box::area(b)' 'box::aria(b)'");
    expect_line("replace: the new error is at the changed name, as written", log,
                "diag main.smith:7:18: Use of undeclared identifier 'box::aria'; did you mean 'box::area'? (fix "
                "available) |  | geometry/box.smith:5:12: | note: 'box::area' declared here");
}

// Hover, go-to-definition across modules (the answer is the .smith file, not the generated header), symbols: the names
// as the file writes them, `box::area` where it is imported and `area` in the module itself.
export void test_lsp_hover_definition_and_symbols_across_modules() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log = session(
        &p,
        "open main.smith geometry/box.smith -- hover main.smith 7 18 -- hover main.smith 6 10 -- "
        "definition main.smith 7 18 geometry/box.smith:5:12 -- definition main.smith 6 10 geometry/box.smith:3:50 -- "
        "symbols main.smith -- hover geometry/box.smith 5 12 -- hover geometry/box.smith 3 50 -- "
        "symbols geometry/box.smith");
    expect_line("hover: a call, the function as written", log,
                "hover main.smith:7:18: function box::area |  | provided by \"geometry/box.h\" |  | → float |  | "
                "Parameters: |  | - box::Box b |  | pure |  | float box::area(box::Box b)");
    expect_line("hover: a type, as written", log,
                "hover main.smith:6:10: type-alias box::Box |  | provided by \"geometry/box.h\" |  | Type: struct "
                "box::Box |  | typedef struct box::Box box::Box");
    expect_line("definition: the function is in the other module's .smith, at its name", log,
                "definition main.smith:7:18 -> geometry/box.smith:5:12");
    expect_line("definition: so is the type", log, "definition main.smith:6:10 -> geometry/box.smith:3:50");
    expect_line("symbols: main", log, "symbol main.smith: main");
    expect_line("hover at the definition: the function's name, in the module itself", log,
                "hover geometry/box.smith:5:12: function area |  | → f32 (aka float) |  | Parameters: |  | - Box b "
                "|  | pure |  | f32 area(Box b)");
    expect_line("hover at the definition: and the type's", log,
                "hover geometry/box.smith:3:50: type-alias Box |  | Type: struct Box |  | typedef struct Box Box");
    scratch::expect_text(
        "symbols: a module's names, as written, each once",
        "symbol geometry/box.smith: (anonymous struct) symbol geometry/box.smith: width symbol geometry/box.smith: "
        "height symbol geometry/box.smith: Box symbol geometry/box.smith: area symbol geometry/box.smith: twice "
        "symbol geometry/box.smith: perimeter",
        joined(log, "symbol geometry/box.smith"));
}

// A run-time array `T xs[:]` (issue #106) is shown as the source writes it, `f32[:]`, never as the struct the lowering
// made (`struct smith_array_f32_n`): in the hover of the function, of the parameter and of its use, and in the outline.
export void test_lsp_a_slice_is_shown_as_the_source_writes_it() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log = session(&p, "open geometry/slices.smith -- hover geometry/slices.smith 3 12 -- hover "
                                  "geometry/slices.smith 3 21 -- hover geometry/slices.smith 4 12 -- symbols "
                                  "geometry/slices.smith");
    expect_line("slice: the hover of a function shows its slice parameter as f32[:]", log,
                "hover geometry/slices.smith:3:12: function pick |  | → f32 (aka float) |  | Parameters: |  | - "
                "f32[:] xs | - usize i (aka unsigned long) |  | effects: fails |  | f32 pick(f32[:] xs, usize i)");
    expect_line("slice: the hover of the parameter shows its type as f32[:]", log,
                "hover geometry/slices.smith:3:21: param xs |  | Type: f32[:] |  | // In pick | f32[:] xs");
}

// A function after one with a slice parameter (issue #133): the end of the first function's body (its `}` is read while
// the lowering reads the second head) was the slice parameter's, so hover, references and highlights found nothing in
// the second function. Hover, go-to-definition (from a module that calls it) and the outline work on both, on a
// parameter named like the module too.
export void test_lsp_a_function_after_a_slice_parameter() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log =
        session(&p, "open m.smith users.smith -- hover m.smith 2 12 -- hover m.smith 3 12 -- hover m.smith "
                    "3 18 -- references m.smith 3 12 -- definition users.smith 5 15 m.smith:3:12 -- "
                    "symbols m.smith");
    expect_line("after a slice: hover on the first function", log,
                "hover m.smith:2:12: function a |  | → i32 (aka int) |  | Parameters: |  | - f32[:] g |  | pure |  | "
                "i32 a(f32[:] g)");
    expect_line("after a slice: hover on the second function", log,
                "hover m.smith:3:12: function b |  | → i32 (aka int) |  | Parameters: |  | - i32[:] m |  | pure |  | "
                "i32 b(i32[:] m)");
    expect_one_line("after a slice: hover on its parameter", log, "hover m.smith:3:18: param m");
    expect_one_line("after a slice: references of the second function find it", log, "reference m.smith:3:12");
    expect_line("after a slice: go-to-definition of the second function, from a call", log,
                "definition users.smith:5:15 -> m.smith:3:12");
    scratch::expect_text("after a slice: the outline has both functions", "symbol m.smith: a symbol m.smith: b",
                         joined(log, "symbol m.smith"));
}

// Go-to-definition inside one module (issue #154): a call of an exported function, and a parameter used in countof(m)
// and in m[i], go to the function's name and to the parameter.
export void test_lsp_definition_inside_one_module() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log = session(&p, "open same.smith -- definition same.smith 3 33 same.smith:2:12 -- definition "
                                  "same.smith 3 48 same.smith:3:18 -- definition same.smith 3 54 same.smith:3:18");
    expect_line("same module: go-to-definition of a call of an exported function", log,
                "definition same.smith:3:33 -> same.smith:2:12");
    expect_line("same module: a parameter inside countof(m)", log, "definition same.smith:3:48 -> same.smith:3:18");
    expect_line("same module: a parameter in m[i]", log, "definition same.smith:3:54 -> same.smith:3:18");
}

// The many-dimensional forms and the qualifier tags are written as the language writes them (the tags of `restrict` and
// `const` slices are declared by hand in the fixture: their lowering is the compiler's).
export void test_lsp_many_dimensions_and_qualifier_tags_as_written() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log = session(&p, "open geometry/dims.smith -- hover geometry/dims.smith 6 12 -- hover "
                                  "geometry/dims.smith 10 14 -- symbols geometry/dims.smith");
    expect_line("dims: the hover of a function shows an f32[:][2] parameter as written", log,
                "hover geometry/dims.smith:6:12: function rows |  | → f32 (aka float) |  | Parameters: |  | - "
                "f32[:][2] m | - usize i (aka unsigned long) |  | effects: fails |  | f32 rows(f32[:][2] m, usize i)");
    expect_line("dims: the hover shows the tags of qualified slices as written", log,
                "hover geometry/dims.smith:10:14: function tags |  | → usize (aka unsigned long) |  | Parameters: "
                "|  | - u8[const restrict :] a | - const char[:] b |  | pure |  | usize tags(u8[const restrict :] a, "
                "const char[:] b)");
    log = session(&p, "open geometry/grid.smith -- hover geometry/grid.smith 3 12");
    expect_line("dims: the hover of a function shows an f32[:][:] parameter as written", log,
                "hover geometry/grid.smith:3:12: function grid |  | → f32 (aka float) |  | Parameters: |  | - "
                "f32[:][:] g | - usize i (aka unsigned long) |  | effects: fails |  | f32 grid(f32[:][:] g, usize i)");
}

// A slice element in a generic call's argument: the editor answers (it used to loop in the token collector, #264).
export void test_lsp_a_slice_element_in_a_generic_call() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log = session(&p, "open sliced.smith pick.smith -- hover sliced.smith 5 24");
    expect_line("slice in a generic call: no diagnostics, and the editor answers", log, "diagnostics sliced.smith");
}

// A call to a generic: the compiler sees an instance there, so the layer answers for the lowering: the hover shows the
// generic as its module wrote it and the instance asked for, and go-to-definition goes to the generic's name.
export void test_lsp_a_call_to_a_generic() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log =
        session(&p, "open genuse.smith pick.smith -- hover genuse.smith 7 26 -- definition genuse.smith 7 "
                    "26 pick.smith:4:18 -- hover genuse.smith 8 26 -- definition genuse.smith 8 26 "
                    "pick.smith:4:18");
    expect_line("generic call: no diagnostics", log, "diagnostics genuse.smith");
    expect_no_lines("generic call: and nothing else is reported", log, "diag genuse.smith");
    expect_line("generic call: hover shows the generic as written and the instance, with the type told from the "
                "argument",
                log,
                "hover genuse.smith:7:26: generic function pick::larger |  | typeof(a) pick::larger(auto a, "
                "typeof(a) b) |  | instance pick::larger(i32)");
    expect_line("generic call: go-to-definition is the generic's name in its module", log,
                "definition genuse.smith:7:26 -> pick.smith:4:18");
    expect_line("generic call: hover, the second instance", log,
                "hover genuse.smith:8:26: generic function pick::larger |  | typeof(a) pick::larger(auto a, "
                "typeof(a) b) |  | instance pick::larger(f64)");
}

// A function passed to `constexpr auto f`: the hover shows the head as written, and the instance names the function.
export void test_lsp_a_function_passed_to_a_generic() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log =
        session(&p, "open genuse.smith pick.smith -- hover genuse.smith 17 20 -- definition genuse.smith 17 "
                    "20 pick.smith:9:18");
    expect_line("generic function parameter: hover shows the head as written and the function in the instance", log,
                "hover genuse.smith:17:20: generic function pick::apply_twice |  | typeof(x) "
                "pick::apply_twice(constexpr auto f, auto x) |  | instance pick::apply_twice(inc, int)");
    expect_line("generic function parameter: go-to-definition is the generic's name", log,
                "definition genuse.smith:17:20 -> pick.smith:9:18");
    expect_no_lines("generic function parameter: no diagnostics", log, "diag genuse.smith");
}

// `auto... rest`: the head as written, and the instance lists the type of each argument.
export void test_lsp_a_generic_argument_list() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "p")) {
        return;
    }
    const char *log =
        session(&p, "open genuse.smith pick.smith -- hover genuse.smith 21 20 -- definition genuse.smith 21 "
                    "20 pick.smith:14:14");
    expect_line("generic argument list: hover shows the head as written and every type in the instance", log,
                "hover genuse.smith:21:20: generic function pick::count_args |  | usize pick::count_args(auto x, "
                "auto... rest) |  | instance pick::count_args(int, f64, int)");
    expect_line("generic argument list: go-to-definition is the generic's name", log,
                "definition genuse.smith:21:20 -> pick.smith:14:14");
    expect_no_lines("generic argument list: no diagnostics", log, "diag genuse.smith");
}

// The argument list and `for constexpr` in the generic: the head as written, the instance's types, and no diagnostic in
