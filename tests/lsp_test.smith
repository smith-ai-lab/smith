}

// --- queries from the shell (issue #248): `smith lsp def|refs|hover|diag|symbols` and `smith lsp -`
// ------------------- answered from the same server and index as the editor, one `path:line:col: kind: text` line for
// each fact. The folder q: two modules, an alias, a generic, a C file that calls a module by its C name.

// What `smith lsp ARGUMENTS` prints on its standard output, in the folder.
static const char *query(const scratch::Project *p, const char *arguments) {
    return scratch::sh(p, join("smith lsp ", arguments, " 2>/dev/null")).out;
}

constexpr char dot_definition[_] = "geom/vec.smith:8:12: function: geom::vec::dot: export f32 dot(Vec a, Vec b) {";

export void test_lsp_query_the_first_query_says_it_waits_for_the_index() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "q")) {
        return;
    }
    scratch::expect_text("query: the first query waits for the index and says so on stderr (never an answer from an "
                         "unfinished index)",
                         "smith lsp: bringing the index up to date",
                         scratch::capture(&p, "smith lsp def vec::dot 2>&1 >/dev/null | head -n 1"));
}

export void test_lsp_query_def() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "q")) {
        return;
    }
    scratch::expect_text("query def: a module's function, as written, with its declaration", dot_definition,
                         query(&p, "def vec::dot"));
    scratch::expect_text("query def: a bare name is every module's, and each line says which", dot_definition,
                         query(&p, "def dot"));
    scratch::expect_text("query def: a C name",
                         "geom/vec.smith:8:12: function: geom_vec_dot: export f32 dot(Vec a, Vec b) {",
                         query(&p, "def geom_vec_dot"));
}

export void test_lsp_query_refs() {
    scratch::Project root = scratch::make("lsp", "lsp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p;
    if (!make_built(&root, &p, "q")) {
        return;
    }
    scratch::expect_text(
        "query refs: every spelling (an alias, the module's own name, the C name in a C file) of a function",
        "c_use.c:4:12: ref: return geom_vec_dot(a, a);\n"
        "geom/vec.smith:8:12: ref: export f32 dot(Vec a, Vec b) {\n"
        "user.smith:7:17: ref: auto n = v::dot(a, a);\n"
        "user.smith:12:29: ref: return vec::larger(vec::dot(a, a), vec::dot(b, b));\n"
        "user.smith:12:45: ref: return vec::larger(vec::dot(a, a), vec::dot(b, b));",
        query(&p, "refs vec::dot"));
    scratch::expect_text("query refs: a call of a generic is a reference to the generic",
                         "user.smith:12:17: ref: return vec::larger(vec::dot(a, a), vec::dot(b, b));",
                         query(&p, "refs vec::larger"));
    // A function with a C name is in the index under it: the written name finds it all the same (issue #248, the
    // review).
    scratch::expect_text(
        "query refs: a function with a c_name, asked by its written name",
        "geom/vec.smith:16:50: ref: [[smith::c_name(\"geom_vec_squared\")]] export f32 length2(Vec a) {\n"
        "user.smith:16:17: ref: return vec::length2(a);",
        query(&p, "refs vec::length2"));
}

