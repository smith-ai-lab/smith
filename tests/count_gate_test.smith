// The count's alarm (the step `Gate` of the job `frontend-coverage` in .github/workflows/ci.yml, #3052): the count runs
// on the push to main, after the merge, and compares itself with main's last count. The test cuts the step's script out
// of the workflow, with gh_retry out of the api-budget action as the job has it, and runs it with a fake `gh` (main's
// count is the artifact of the second commit, or none), `git` and `unzip`. It fails when it finds no count on main to
// compare with (it passed on nothing for a day while every download was corrupt); it compares like with like when files
// leave the total (#3037: the passes of the files both tables have); a fall fails and names the merges since that count
// and the files lost, unless a merge's PR body says `Count drop:`. Each case writes the line
// `frontend-coverage-change:` and the lists after it to change.txt, which the table publishes.
//
// smith-reads-tree
// smith-covers: .github/workflows/ci.yml
module count_gate_test;

import std::arena;
import std::mem;
import std::test;
import scratch;

constexpr const char *fake_gh = "#!/bin/sh\n"
                                "[ \"$1\" = api ] && shift\n"
                                "case \"$1\" in\n"
                                "  *artifacts\\?name=frontend-coverage-c2*) [ -n \"${HAS:-}\" ] && echo 11:22 ;;\n"
                                "  *artifacts\\?name=*) ;;\n"
                                "  */runs/22/jobs*) echo 1 ;;\n"
                                "  */artifacts/11/zip) printf 'zip\\0' ;;\n"
                                "  */pulls/41) echo \"${BODY41:-}\" ;;\n"
                                "  */pulls/*) ;;\n"
                                "  *) echo \"unexpected gh $*\" >&2; exit 9 ;;\n"
                                "esac\n";

constexpr const char *script =
    "set -u; mkdir -p bin main; mv gh bin/gh; "
    "printf '#!/bin/sh\\ncase $1 in rev-list) echo c1; echo c2; echo c3 ;; "
    "log) echo \"a1 fix: one (#41)\"; echo \"a2 docs: two (#42)\" ;; esac\\n' > bin/git; "
    "printf '#!/bin/sh\\ncp main/output.txt main/results.tsv \"$5\"/\\n' > bin/unzip; chmod +x bin/*; "
    // main's count: 3 of 4 files pass (d fails)
    "printf 'frontend-coverage: 3 of 4 files pass\\n' > main/output.txt; "
    "printf 'a.smith\\tpass\\nb.smith\\tpass\\n\\tb.smith\\timport\\nc.smith\\tpass\\nd.smith\\tparse\\terr\\n' "
    "> main/results.tsv; "
    // the function and the step, as the job runs them
    "sed -n \"/<<'GH_RETRY'/,/^        GH_RETRY\\$/p\" action.yml | sed '1d;$d' | sed 's/^        //' > fn; "
    "sed -n '/^      - name: Gate$/,/^      - name: /p' ci.yml | sed -n '/^        run: |$/,$p' | sed '1d;$d' | "
    "sed 's/^          //' > gate; "
    "export PATH=\"$PWD/bin:$PATH\" GH_REPO=r BASE=c1 UNCACHED=false GITHUB_EVENT_NAME=push "
    "GITHUB_SHA=f00dfeed GITHUB_STEP_SUMMARY=/dev/null; "
    "gate() { rm -rf tmp; mkdir -p tmp/coverage; printf 'frontend-coverage: %s files pass\\n' \"$1\" > "
    "tmp/coverage/output.txt; printf \"$2\" > tmp/coverage/results.tsv; "
    "RUNNER_TEMP=$PWD/tmp bash -e -o pipefail -c '. ./fn; . ./gate' > out 2>&1; echo \"status $?\"; "
    "grep -E '^(::error::|::warning::|count: main)' out | cut -c1-80; echo '. change.txt:'; cat "
    "tmp/coverage/change.txt; }; "
    "echo '-- no count on main'; gate '3 of 4' 'a.smith\\tpass\\n'; "
    "export HAS=1; "
    "echo '-- c and d left the total'; gate '2 of 2' 'a.smith\\tpass\\nb.smith\\tpass\\n'; "
    "echo '-- b lost'; gate '2 of 4' 'a.smith\\tpass\\nb.smith\\tcheck\\nc.smith\\tpass\\nd.smith\\tparse\\n'; "
    "echo '-- b lost on purpose'; BODY41='Count drop: b moves' gate '2 of 4' "
    "'a.smith\\tpass\\nb.smith\\tcheck\\nc.smith\\tpass\\nd.smith\\tparse\\n'; "
    "echo '-- d gained'; gate '4 of 4' 'a.smith\\tpass\\nb.smith\\tpass\\nc.smith\\tpass\\nd.smith\\tpass\\n'";

export void test_count_alarm_fails_with_nothing_to_compare_and_compares_like_with_like() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, ".github/workflows/ci.yml", "ci.yml");
    scratch::copy_tree(&p, ".github/actions/api-budget/action.yml", "action.yml");
    scratch::write(&p, "gh", fake_gh);
    scratch::Run run = scratch::sh(&p, script);
    scratch::expect_status("count alarm: the script ran", 0, &run);
    scratch::expect_text(
        "count alarm: nothing to compare fails; a smaller total compares the files both counts have; a "
        "fall fails and names the merges and files; a merge that says Count drop warns",
        "-- no count on main\n"
        "status 1\n"
        "::error::no count on main's last 20 commits to compare with: the alarm cannot te\n"
        ". change.txt:\n"
        "frontend-coverage-change: f00dfeed no-base - 3 - -\n"
        "-- c and d left the total\n"
        "status 0\n"
        "count: main's last count 3 files pass at c2, this one 2; 2 against 2 on the 2 fi\n"
        ". change.txt:\n"
        "frontend-coverage-change: f00dfeed same 2 2 2 c2\n"
        "-- b lost\n"
        "status 1\n"
        "count: main's last count 3 files pass at c2, this one 2; 2 against 3 on the 4 fi\n"
        "::error::the count fell from 3 to 2 files pass on the 4 files both measured, sin\n"
        ". change.txt:\n"
        "frontend-coverage-change: f00dfeed fell 3 2 4 c2\n"
        "count: pass->fail b.smith\n"
        "count: merge since a1 fix: one (#41)\n"
        "count: merge since a2 docs: two (#42)\n"
        "-- b lost on purpose\n"
        "status 0\n"
        "count: main's last count 3 files pass at c2, this one 2; 2 against 3 on the 4 fi\n"
        "::warning::the count fell from 3 to 2 files on the 4 files both measured; the me\n"
        ". change.txt:\n"
        "frontend-coverage-change: f00dfeed fell-meant 3 2 4 c2\n"
        "count: pass->fail b.smith\n"
        "count: merge since a1 fix: one (#41)\n"
        "count: merge since a2 docs: two (#42)\n"
        "-- d gained\n"
        "status 0\n"
        "count: main's last count 3 files pass at c2, this one 4; 4 against 3 on the 4 fi\n"
        ". change.txt:\n"
        "frontend-coverage-change: f00dfeed up 3 4 4 c2\n"
        "count: fail->pass d.smith",
        run.out);
}
