// `--macos-only` and `--skip-macos` of the test runner (#754): CI runs the tests that need macOS on a Mac and all the
// others on Linux. A test is macOS-only when its shown name has the word `macos` (a `test_macos_...` function or a
// `..._macos_test` module). The fixture tests/build_fixtures/runner_platform has 5 tests, 3 of them macOS-only; the
// runner only lists here (--list), and runs once.
// smith-covers: smith.c runtime/build_runtime.c runtime/executor*.c runtime/slots.c runtime/lang*.c runtime/verbs.c
// smith-covers: runtime/cache.c runtime/sdk_cache.c runtime/platform_*.c runtime/quiet.c runtime/base.h
// smith-covers: runtime/symbolize.c runtime/explain.c shim/symbolize.cpp shim/lldb_explain.* shim/clang.cpp
// smith-covers: shim/hook.cpp shim/lld.cpp include/smith/ lib/trace.c lib/std/test.smith lib/std/arena.smith
// smith-covers: lib/std/random.smith lib/std/mem.smith lib/std/contract.smith lib/std/clock.smith lib/std/console.smith
// smith-covers: lib/std/env.smith lib/std/files.smith lib/std/math.smith lib/std/failing.smith tests/runner.smith
// smith-covers: tests/build_fixtures/runner_*/
module test_runner_platform_test;

import std::arena;
import std::mem;
import std::test;
import runner;
import scratch;

export void test_runner_platform_the_only_flag_lists_the_marked_tests() {
    scratch::Project p = runner::built_project("runner_base", "runner_platform", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::expect_text("platform: --macos-only lists 3", "3",
                         scratch::capture(&p, "build/tests --list --macos-only | awk 'END { print NR }'"));
    scratch::expect_text("platform: ... the function named macos", "1",
                         scratch::capture(&p, "build/tests --list --macos-only | grep -c plain_kqueue"));
    scratch::expect_text("platform: ... and the module named macos", "2",
                         scratch::capture(&p, "build/tests --list --macos-only | grep -c network_macos_test"));
}

export void test_runner_platform_the_skip_flag_lists_the_others() {
    scratch::Project p = runner::built_project("runner_base", "runner_platform", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::expect_text("platform: --skip-macos lists the other 2", "2",
                         scratch::capture(&p, "build/tests --list --skip-macos | awk 'END { print NR }'"));
    scratch::expect_text("platform: ... macosx is not the word", "1",
                         scratch::capture(&p, "build/tests --list --skip-macos | grep -c macosx"));
}

export void test_runner_platform_the_two_halves_are_every_test_once() {
    scratch::Project p = runner::built_project("runner_base", "runner_platform", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::expect_text("platform: the halves are the whole list", "",
                         scratch::capture(&p, "{ build/tests --list; build/tests --list --macos-only; build/tests "
                                              "--list --skip-macos; } | sort | uniq -c | awk '$1 != 2'"));
}

export void test_runner_platform_a_run_runs_only_its_half() {
    scratch::Project p = runner::built_project("runner_base", "runner_platform", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = runner::tests(&p, "", "--macos-only");
    scratch::expect_contains("platform: --macos-only runs its 3", run.out, "3 passed, 0 failed");
    scratch::Run other = runner::tests(&p, "", "--skip-macos");
    scratch::expect_contains("platform: --skip-macos runs its 2", other.out, "2 passed, 0 failed");
}

// A filter that names only the other half's tests (a pull request's --changed selection on the Mac part) runs nothing
// and passes; a filter that names no test at all is still an error.
export void test_runner_platform_a_filter_of_only_the_other_half_runs_nothing_and_passes() {
    scratch::Project p = runner::built_project("runner_base", "runner_platform", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run other = runner::tests(&p, "", "--macos-only --test plain_1");
    scratch::expect_status("platform: only the other half's tests: exit 0", 0, &other);
    scratch::expect_contains("platform: ... and says so", other.out,
                             "no test of --macos-only matches \"plain_1\": nothing to run");
    scratch::Run none = runner::tests(&p, "", "--macos-only --test nothing_like_this");
    scratch::expect_status("platform: a filter that matches no test is still an error", 1, &none);
    scratch::expect_contains("platform: ... and says so", none.out, "no test matches \"nothing_like_this\"");
}

// `--partial` (#1154): the front runner is one of several runners that `smith test --changed` gives the same `--test`
// list, so a list with none of its tests runs nothing and passes; without `--partial` the same list is an error.
export void test_runner_partial_a_filter_of_another_runner_runs_nothing_and_passes() {
    scratch::Project p = runner::built_project("runner_base", "runner_platform", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run other = runner::tests(&p, "", "--partial --test belongs_to_another_runner");
    scratch::expect_status("partial: a filter that names none of this runner's tests: exit 0", 0, &other);
    scratch::expect_contains("partial: ... and says so", other.out,
                             "no test of this runner matches \"belongs_to_another_runner\": nothing to run");
    scratch::Run chosen = runner::tests(&p, "", "--partial --test plain_1");
    scratch::expect_contains("partial: a filter that names one of its tests runs it", chosen.out, "1 passed, 0 failed");
    scratch::Run strict = runner::tests(&p, "", "--test belongs_to_another_runner");
    scratch::expect_status("partial: without --partial the same filter is still an error", 1, &strict);
    scratch::expect_contains("partial: ... and says so", strict.out, "no test matches \"belongs_to_another_runner\"");
}

// `--others <runner>` (#1260): `smith test --test x*` runs the units runner and the front runner; a name only the other
// one has is its to run, so this runner passes, and a name neither has is an error that says where it looked.
export void test_runner_others_a_filter_the_other_runner_has_runs_nothing_and_passes() {
    scratch::Project p = runner::built_project("runner_base", "runner_platform", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::capture(&p, "printf '#!/bin/sh\\necho found::t\\n' > has && printf '#!/bin/sh\\nexit 0\\n' > hasnot && "
                         "chmod +x has hasnot");
    scratch::Run has = runner::tests(&p, "", "--others ./has --test belongs_to_another_runner");
    scratch::expect_status("others: the other runner has the name: exit 0", 0, &has);
    scratch::expect_contains("others: ... and says so", has.out, "the other runner has it, nothing to run");
    scratch::Run neither = runner::tests(&p, "", "--others ./hasnot --test belongs_to_another_runner");
    scratch::expect_status("others: neither runner has the name: exit 1", 1, &neither);
    scratch::expect_contains("others: ... and says where it looked", neither.out,
                             "no test matches \"belongs_to_another_runner\" in this runner or the other one");
}
