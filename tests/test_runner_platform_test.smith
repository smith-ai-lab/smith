// `--macos-only` and `--skip-macos` of the test runner (#754): CI runs the tests that need macOS on a Mac and all the
// others on Linux. A test is macOS-only when its shown name has the word `macos` (a `test_macos_...` function or a
// `..._macos_test` module). The fixture tests/build_fixtures/runner_platform has 5 tests, 3 of them macOS-only; the
// runner only lists here (--list), and runs once.
module test_runner_platform_test;

import std::arena;
import std::mem;
import std::test;
import runner;
import scratch;

export void test_runner_platform_the_only_flag_lists_the_marked_tests() {
    scratch::Project p = runner::built_project("runner_base", "runner_platform", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::expect_text("platform: --macos-only lists 3", "3",
                         scratch::capture(&p, "build/tests --list --macos-only | awk 'END { print NR }'"));
    scratch::expect_text("platform: ... the function named macos", "1",
                         scratch::capture(&p, "build/tests --list --macos-only | grep -c plain_kqueue"));
    scratch::expect_text("platform: ... and the module named macos", "2",
                         scratch::capture(&p, "build/tests --list --macos-only | grep -c network_macos_test"));
}

export void test_runner_platform_the_skip_flag_lists_the_others() {
    scratch::Project p = runner::built_project("runner_base", "runner_platform", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::expect_text("platform: --skip-macos lists the other 2", "2",
                         scratch::capture(&p, "build/tests --list --skip-macos | awk 'END { print NR }'"));
    scratch::expect_text("platform: ... macosx is not the word", "1",
                         scratch::capture(&p, "build/tests --list --skip-macos | grep -c macosx"));
}

export void test_runner_platform_the_two_halves_are_every_test_once() {
    scratch::Project p = runner::built_project("runner_base", "runner_platform", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::expect_text("platform: the halves are the whole list", "",
                         scratch::capture(&p, "{ build/tests --list; build/tests --list --macos-only; build/tests "
                                              "--list --skip-macos; } | sort | uniq -c | awk '$1 != 2'"));
}

export void test_runner_platform_a_run_runs_only_its_half() {
    scratch::Project p = runner::built_project("runner_base", "runner_platform", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = runner::tests(&p, "", "--macos-only");
    scratch::expect_contains("platform: --macos-only runs its 3", run.out, "3 passed, 0 failed");
    scratch::Run other = runner::tests(&p, "", "--skip-macos");
    scratch::expect_contains("platform: --skip-macos runs its 2", other.out, "2 passed, 0 failed");
}

// A filter that names only the other half's tests (a pull request's --changed selection on the Mac part) runs nothing
// and passes; a filter that names no test at all is still an error.
export void test_runner_platform_a_filter_of_only_the_other_half_runs_nothing_and_passes() {
    scratch::Project p = runner::built_project("runner_base", "runner_platform", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run other = runner::tests(&p, "", "--macos-only --test plain_1");
    scratch::expect_status("platform: only the other half's tests: exit 0", 0, &other);
    scratch::expect_contains("platform: ... and says so", other.out,
                             "no test of --macos-only matches \"plain_1\": nothing to run");
    scratch::Run none = runner::tests(&p, "", "--macos-only --test nothing_like_this");
    scratch::expect_status("platform: a filter that matches no test is still an error", 1, &none);
    scratch::expect_contains("platform: ... and says so", none.out, "no test matches \"nothing_like_this\"");
}
