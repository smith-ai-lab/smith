// Tests of front::compile's import cycles (#2130): two modules that import each other get one diagnostic each, at the
// `import` that closes the cycle, with the old compiler's wording; a chain of three, a self import and a project with
// no cycle behave the same way.
module front_compile_test;

import front::compile;
import front::roots;
import std::format;
import std::process;
import std::test;
import <stdio.h>;
import <sys/stat.h>;
import <unistd.h>;

static Str as_str(char chars[:]) {
    return chars;
}

static Str folder_for(Str name) {
    Str path = as_str(format::push("/tmp/front_compile_", (I64)c::getpid(), "_", name));
    c::mkdir(path.data, 0o700);
    c::mkdir(as_str(format::push(path, "/src")).data, 0o700);
    return path;
}

static void write_text(Str path, Str text) {
    c::FILE *file = c::fopen(path.data, "w");
    test::check_equal(file != nullptr, true);
    if (file == nullptr) return;
    c::fwrite(text.data, 1, countof(text), file);
    c::fclose(file);
}

static void remove_all(Str folder) {
    const char *const argv[4] = {"rm", "-rf", folder.data, nullptr};
    process::OutputResult done = process::run(argv[0:3]);
    test::check_equal(done == .ok, true);
}

static roots::Roots roots_of(Str folder) {
    return (roots::Roots){.source = as_str(format::push(folder, "/src")),
                          .library = as_str(format::push(folder, "/lib"))};
}

// The report of compiling `src/<name>.smith` of `folder`.
static compile::Report compile_one(Str folder, Str name) {
    return compile::file(as_str(format::push(folder, "/src/", name, ".smith")),
                         as_str(format::push(folder, "/", name, ".o")), "", roots_of(folder));
}

// Two modules that import each other: each file reports the cycle from its own side.
export void test_front_compile_two_modules_importing_each_other_are_a_cycle() {
    Str folder = folder_for("two");
    write_text(as_str(format::push(folder, "/src/a.smith")),
               "module a;\nimport b;\n\nexport I32 from_a() { return b::from_b(); }\n");
    write_text(as_str(format::push(folder, "/src/b.smith")),
               "module b;\nimport a;\n\nexport I32 from_b() { return a::from_a(); }\n");
    compile::Report first = compile_one(folder, "a");
    compile::Report second = compile_one(folder, "b");
    test::check_equal(first.ok, false);
    test::check_equal(second.ok, false);
    test::check_equal(first.text, as_str(format::push(folder, "/src/a.smith:2:8: error: import cycle: a -> b -> a\n")));
    test::check_equal(second.text,
                      as_str(format::push(folder, "/src/b.smith:2:8: error: import cycle: b -> a -> b\n")));
    remove_all(folder);
}

// A cycle through a third module is named whole.
export void test_front_compile_a_cycle_of_three_names_every_module() {
    Str folder = folder_for("three");
    write_text(as_str(format::push(folder, "/src/a.smith")), "module a;\nimport b;\n\nexport I32 f() { return 1; }\n");
    write_text(as_str(format::push(folder, "/src/b.smith")), "module b;\nimport c;\n\nexport I32 g() { return 2; }\n");
    write_text(as_str(format::push(folder, "/src/c.smith")), "module c;\nimport a;\n\nexport I32 h() { return 3; }\n");
    compile::Report report = compile_one(folder, "a");
    test::check_equal(report.ok, false);
    test::check_equal(report.text,
                      as_str(format::push(folder, "/src/a.smith:2:8: error: import cycle: a -> b -> c -> a\n")));
    remove_all(folder);
}

// A module that imports another one that does not import it back is no cycle.
export void test_front_compile_a_chain_of_imports_is_no_cycle() {
    Str folder = folder_for("chain");
    write_text(as_str(format::push(folder, "/src/a.smith")),
               "module a;\nimport b;\n\nexport I32 from_a() { return 2; }\n");
    write_text(as_str(format::push(folder, "/src/b.smith")), "module b;\n\nexport I32 from_b() { return 1; }\n");
    compile::Report report = compile_one(folder, "a");
    test::check_equal(report.ok, true);
    test::check_equal(countof(report.text), (Usize)0);
    remove_all(folder);
}

// An error in the body of an instance of an imported generic is reported at that module's file and line, not at the
// file that calls it (#2669): `1 - x` is `util.smith`'s.
export void test_front_compile_an_error_in_an_imported_instance_names_its_module() {
    Str folder = folder_for("instance");
    write_text(as_str(format::push(folder, "/src/util.smith")), "pub fn wrap(x: auto) -> f64:\n    return 1 - x\n");
    write_text(as_str(format::push(folder, "/src/main.smith")), "import util\n\npub fn f() -> f64: util.wrap(0.5)\n");
    compile::Report made = compile_one(folder, "main");
    test::check_equal(made.ok, false);
    Str want = as_str(format::push(folder, "/src/util.smith:2:12: error: "));
    Usize n = countof(want) < countof(made.text) ? countof(want) : countof(made.text);
    test::check_equal(made.text[0:n], want);
    remove_all(folder);
}

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        Bool same = true;
        for (Usize k = 0; same && k < countof(needle); k++)
            same = text[i + k] == needle[k];
        if (same) return true;
    }
    return false;
}

// The diagnostic carries the chain that led to it, innermost first (#2949): the instance and where it was asked for,
// then the module and where it was imported.
export void test_front_compile_an_error_in_an_imported_instance_carries_its_trace() {
    Str folder = folder_for("trace");
    write_text(as_str(format::push(folder, "/src/util.smith")), "pub fn wrap(x: auto) -> f64:\n    return 1 - x\n");
    write_text(as_str(format::push(folder, "/src/main.smith")), "import util\n\npub fn f() -> f64: util.wrap(0.5)\n");
    compile::Report made = compile_one(folder, "main");
    Str main_at = as_str(format::push(folder, "/src/main.smith"));
    test::check_equal(has(made.text, as_str(format::push("\n  in wrap[F64], instantiated at ", main_at, ":3:20\n"))),
                      true);
    test::check_equal(has(made.text, as_str(format::push("\n  in module util, imported by ", main_at, ":1:8\n"))),
                      true);
    remove_all(folder);
}

// A question about a type in an imported generic is the builtin one, whatever the importer declares (#3600): `main`
// has a function named `is_integer` of its own, and `util.kind` still picks a branch by the type of each of its
// three pieces (the pieces are a pack, as std.format's are), with no error from the branches it drops.
export void test_front_compile_a_callers_function_does_not_hide_a_question_in_an_imported_generic() {
    Str folder = folder_for("question");
    write_text(as_str(format::push(folder, "/src/util.smith")),
               "fn sink(x: i64) -> i64:\n    return x\n\n"
               "fn kind(piece: auto) -> i64:\n"
               "    if is_integer(typeof(piece)) and is_signed(typeof(piece)):\n"
               "        return sink(piece.to(i64))\n"
               "    else if typeof(piece) == bool:\n"
               "        return 2\n"
               "    else:\n"
               "        return 3\n\n"
               "pub fn total(pieces...) -> i64:\n"
               "    mut sum: i64 = 0\n"
               "    for (i, piece) in enumerate(pieces):\n"
               "        sum += kind(piece)\n"
               "    return sum\n");
    write_text(as_str(format::push(folder, "/src/main.smith")),
               "import util\n\nfn is_integer(e: u32) -> bool:\n    return e == 1\n\n"
               "pub fn f() -> i64:\n    return util.total(7, true, \"x\")\n");
    compile::Report made = compile_one(folder, "main");
    test::check_equal(made.ok, true);
    remove_all(folder);
}

// A function of the module named like a builtin is the module's own, in the emitter too (#3606): `is_integer` below is
// not the type question, and its call is lowered as a call (it used to push a value with no LLVM value, and `not`
// of it crashed the compiler).
export void test_front_compile_a_function_named_like_a_builtin_is_called_not_lowered_as_it() {
    Str folder = folder_for("shadowed_builtin");
    write_text(as_str(format::push(folder, "/src/main.smith")),
               "fn is_integer(t: i32) -> bool:\n    return t == 1\n\n"
               "pub fn f(l: i32) -> bool:\n    if not is_integer(l):\n        return false\n    return true\n");
    compile::Report made = compile_one(folder, "main");
    test::check_equal(made.ok, true);
    remove_all(folder);
}

// Two modules that each declare a type of one name (#3680): in the body of an imported generic, `Value` is the module's
// own, whoever calls it (it used to find the caller's, `no field n in Value`, and `argument 1 of ... is util::Value, the
// parameter is Value`).
export void test_front_compile_a_type_of_an_imported_generic_is_its_modules_not_the_callers_of_the_same_name() {
    Str folder = folder_for("same_name");
    write_text(as_str(format::push(folder, "/src/util.smith")),
               "pub struct Value:\n    pub n: i32\n\n"
               "fn read(v: Value) -> i32:\n    return v.n\n\n"
               "pub fn make(x: auto) -> Value:\n    v: Value = Value(n = 1)\n    return v\n\n"
               "pub fn total(x: auto) -> i32:\n    return read(make(x))\n");
    write_text(as_str(format::push(folder, "/src/main.smith")),
               "import util\n\nstruct Value:\n    k: i32\n\n"
               "pub fn f() -> i32:\n    mine: Value = Value(k = 2)\n    got := util.make(1)\n"
               "    return got.n + mine.k + util.total(3)\n");
    compile::Report made = compile_one(folder, "main");
    test::check_equal(countof(made.text), (Usize)0);
    test::check_equal(made.ok, true);
    remove_all(folder);
}
