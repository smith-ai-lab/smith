// Tests of front::eval (#3039, step 1): the value of an expression known at compile time. Each scenario checks a module
// in smith's own syntax, read by front::parser in an arena set as the current allocator, and asks for the value of the
// initializer of one of its globals.
module front_eval_test;

import front::ast;
import front::eval;
import front::parser;
import front::types;
import front::types_decl;
import front::when;
import std::arena;
import std::console;
import std::format;
import std::mem;
import std::test;

static Str text(char chars[:]) {
    return chars;
}

static Bool same(Str a, Str b) {
    return types::same_text(a, b);
}

// The initializer of the global `name` of the module, or null.
static const ast::Expr *initializer(const ast::Module *m, Str name) {
    for (Usize i = 0; i < countof(m->decls); i++) {
        const ast::Decl *d = m->decls[i];
        if (d->kind == .variable && same(d->kind.variable.name, name)) return d->kind.variable.init;
    }
    return nullptr;
}

// What `name`'s initializer is at compile time: the value as a message shows it, `unknown: <why>` or `failed: <why>`.
static Str valued(Str source, Str name) {
    parser::Parsed p = parser::parse_new("t.smith", source);
    test::check_equal(countof(p.errors), (Usize)0);
    types::Checked r = types_decl::check_module(&p.module, types::lp64());
    const ast::Expr *init = initializer(&p.module, name);
    test::check_condition(init != nullptr);
    eval::Outcome found = eval::value(&r, init);
    if (found.known) return eval::show(found.value);
    if (found.failed) return text(format::push("failed: ", found.why));
    return text(format::push("unknown: ", found.why));
}

// Checks that `name` of `source` is `want`.
static void expect(Str source, Str name, Str want) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str got = valued(source, name);
    if (!same(got, want)) console::print_error("GOT: ", got, "\n");
    test::check_equal(got, want);
}

export void test_front_eval_arithmetic_on_constants() {
    Str source = "page := 4096\n"
                 "slots := page / 8\n"
                 "mixed := (slots + 1) * 2 - 6 % 4\n"
                 "shifted := 1 << 10 >> 2\n"
                 "bits := (0xF0 | 0x0F) & ~0x18 ^ 1\n"
                 "small: i8 = -128\n"
                 "less := slots < page and not (page == 0)\n"
                 "either := false or slots >= 512\n";
    expect(source, "slots", "512");
    expect(source, "mixed", "1024");
    expect(source, "shifted", "256");
    expect(source, "bits", "230");
    expect(source, "small", "-128");
    expect(source, "less", "true");
    expect(source, "either", "true");
}

export void test_front_eval_and_or_read_the_right_side_only_when_needed() {
    Str source = "mut n: i32 = 0\n"
                 "a := false and n > 0\n"
                 "b := true or n > 0\n"
                 "c := true and n > 0\n";
    expect(source, "a", "false");
    expect(source, "b", "true");
    expect(source, "c", "unknown: `n` is a variable that can change");
}

export void test_front_eval_overflow_and_division_by_zero_are_errors() {
    Str source = "top: i32 = 2147483647\n"
                 "over: i32 = top + 1\n"
                 "zero: i32 = 0\n"
                 "split: i32 = top / zero\n"
                 "far: i32 = top << 40\n"
                 "tiny: u8 = 300\n"
                 "use := tiny\n"
                 "down: i32 = -top - 1\n";
    expect(source, "over", "failed: this overflows `I32` at compile time: 2147483647 + 1");
    expect(source, "split", "failed: this divides by zero at compile time");
    expect(source, "far", "failed: this shifts by 40 at compile time, which is not below the 32 bits of the value");
    expect(source, "use", "failed: `300` does not fit `U8` at compile time");
    expect(source, "down", "-2147483648");
}

export void test_front_eval_types_are_values() {
    Str source = "struct Entry:\n"
                 "    key: u64\n"
                 "    used: bool\n"
                 "size := sizeof(Entry)\n"
                 "align := alignof(Entry)\n"
                 "count := countof(fields(Entry))\n"
                 "word := sizeof(usize) * 8\n"
                 "same := typeof(size) == usize\n"
                 "other := u8 != i8\n"
                 "whole := is_integer(u8) and not is_float(u8)\n"
                 "number := num(f32) and not pointer(i16)\n";
    expect(source, "size", "16");
    expect(source, "align", "8");
    expect(source, "count", "2");
    expect(source, "word", "64");
    expect(source, "other", "true");
    expect(source, "whole", "true");
    expect(source, "number", "true");
}

export void test_front_eval_a_concept_function_is_answered_by_its_body() {
    Str source = "fn small(T: type) -> bool:\n"
                 "    sizeof(T) <= 4\n"
                 "fn tiny(T: type) -> bool:\n"
                 "    small(T) and sizeof(T) == 1\n"
                 "fn sq(x: i32) -> i32:\n"
                 "    x * x\n"
                 "a := small(u32)\n"
                 "b := small(u64)\n"
                 "c := tiny(u8) and not tiny(u16)\n"
                 "d := sq(3)\n";
    expect(source, "a", "true");
    expect(source, "b", "false");
    expect(source, "c", "true");
    expect(source, "d", "9");
}

// Step 2: a function runs where its value is asked for: recursion, locals that change, loops, `match`, `return` from
// inside a loop, and a parameter in brackets worked out from the argument.
export void test_front_eval_a_function_runs() {
    Str source = "fn fib(n: i32) -> i32:\n"
                 "    if n < 2: n else: fib(n - 1) + fib(n - 2)\n"
                 "fn sum(n: u32) -> u32:\n"
                 "    mut total: u32 = 0\n"
                 "    for i in range(0, n + 1):\n"
                 "        if i == 3:\n"
                 "            continue\n"
                 "        total += i\n"
                 "    total\n"
                 "fn first_over(limit: i32) -> i32:\n"
                 "    mut i := 0\n"
                 "    while i < 100:\n"
                 "        if i * i > limit:\n"
                 "            return i\n"
                 "        i += 1\n"
                 "    return -1\n"
                 "fn kind(T: type) -> i32:\n"
                 "    match sizeof(T):\n"
                 "        1: 10\n"
                 "        2, 4: 20\n"
                 "        _: 30\n"
                 "fn bits[T](x: T) -> usize:\n"
                 "    sizeof(T) * 8\n"
                 "fn scaled(x: i32, by: i32 = 3) -> i32:\n"
                 "    x * by\n"
                 "a := fib(10)\n"
                 "b := sum(4)\n"
                 "c := first_over(50)\n"
                 "d := kind(u8) + kind(u32) + kind(f64)\n"
                 "e := bits(a)\n"
                 "f := scaled(5) + scaled(5, 2)\n";
    expect(source, "a", "55");
    expect(source, "b", "7");
    expect(source, "c", "8");
    expect(source, "d", "60");
    expect(source, "e", "32");
    expect(source, "f", "25");
}

// A function that returns a type is run like any other: its value is the type.
export void test_front_eval_a_type_function_runs() {
    Str source = "fn slice_of(element: type, count: usize) -> type:\n"
                 "    mut t: type = element\n"
                 "    for i in range(0, count):\n"
                 "        t = []t\n"
                 "    return t\n"
                 "fn widen(T: type) -> type:\n"
                 "    if sizeof(T) < 4: i32 else: T\n"
                 "fn pair(T: type) -> type:\n"
                 "    struct:\n"
                 "        first: T\n"
                 "        second: T\n"
                 "a := slice_of(u8, 2) == [][]u8\n"
                 "b := widen(u8) == i32 and widen(u64) == u64\n"
                 "c := sizeof(pair(u16))\n"
                 "d := pair(u8) == pair(u8) and pair(u8) != pair(i8)\n"
                 "e := sizeof(slice_of(u8, 0))\n";
    expect(source, "a", "true");
    expect(source, "b", "true");
    expect(source, "c", "4");
    expect(source, "d", "true");
    expect(source, "e", "1");
}

// What a run refuses, each with the call it happened in: the limits, a failed contract, an overflow, a C function, a
// global that changes, a value with memory.
export void test_front_eval_a_run_that_stops_says_where() {
    Str source = "import c <string.h> as cstring\n"
                 "fn deep(n: i32) -> i32:\n"
                 "    deep(n + 1)\n"
                 "fn half(n: i32) -> i32:\n"
                 "    contract.requires(n % 2 == 0)\n"
                 "    n / 2\n"
                 "fn divide(n: i32) -> i32:\n"
                 "    100 / n\n"
                 "fn through(n: i32) -> i32:\n"
                 "    divide(n - 2)\n"
                 "mut count: i32 = 0\n"
                 "fn next() -> i32:\n"
                 "    count + 1\n"
                 "fn third(n: i32) -> i32:\n"
                 "    xs: [3]i32 = [n, n, n]\n"
                 "    xs[2]\n"
                 "fn nothing(n: i32):\n"
                 "    mut i := n\n"
                 "    i += 1\n"
                 "a := deep(0)\n"
                 "c := half(3)\n"
                 "d := half(4)\n"
                 "e := through(2)\n"
                 "f := next()\n"
                 "g := third(1)\n"
                 "h := nothing(1)\n";
    expect(source, "a", "failed: `deep(0)` is 512 calls deep at compile time; the recursion does not end");
    expect(source, "c", "failed: `contract.requires` fails at compile time (in `half(3)`)");
    expect(source, "d", "2");
    expect(source, "e", "failed: this divides by zero at compile time (in `divide(0)`, called from `through(2)`)");
    expect(source, "f", "unknown: `next()` cannot run at compile time: `count` is a variable that can change");
    expect(source, "g", "1");
    expect(source, "h", "unknown: this has no value");
}

// One source of its own: the run takes the whole step limit, and every `expect` compiles the whole source again.
export void test_front_eval_a_loop_that_does_not_end_says_so() {
    Str source = "fn spin(n: i32) -> i32:\n"
                 "    mut i := 0\n"
                 "    while i >= 0:\n"
                 "        i = n\n"
                 "    i\n"
                 "b := spin(1)\n";
    expect(source, "b",
           "failed: `spin(1)` ran 1048576 steps at compile time without finishing; a loop here does not end, or the "
           "work belongs at run time");
}

export void test_front_eval_target_facts() {
    Str os = when::host() == when::os_macos ? "true" : "false";
    Str source = "mantissa := target.f32_mantissa_bits\n"
                 "wide := target.f64_mantissa_bits == 53 and target.float_radix == 2\n"
                 "mac := target.os == .macos\n"
                 "other := .linux != target.os\n"
                 "known := target.os == .linux or target.os == .macos\n"
                 "arch := target.arch == .aarch64 or target.arch == .x86_64\n"
                 "number := target.os == 0 or target.os != 0\n"
                 "analyzer := target.static_analyzer\n"
                 "wrong := target.os == .windows\n"
                 "none := target.colour\n";
    expect(source, "mantissa", "24");
    expect(source, "wide", "true");
    expect(source, "mac", os);
    expect(source, "other", os);
    expect(source, "known", "true");
    expect(source, "arch", "true");
    expect(source, "number", "true"); // today's sources compare the fact with its number
    expect(source, "analyzer", "false");
    expect(source, "wrong", "unknown: `.windows` is not a name of `target.os`; write `.macos` or `.linux`");
    expect(source, "none", "unknown: `target` has no fact `colour`");
}

export void test_front_eval_conversions() {
    Str source = "n: i32 = 300\n"
                 "wide := n.to(i64) * 1000000000\n"
                 "low := n.wrap(u8)\n"
                 "narrow := n.to(u8)\n"
                 "real := n.to(f64) / 8.0\n"
                 "back := real.to(i32)\n";
    expect(source, "wide", "300000000000");
    expect(source, "low", "44");
    expect(source, "narrow", "failed: `300` does not fit `U8` at compile time");
    expect(source, "back", "37");
}

export void test_front_eval_if_as_a_value_and_enumerators() {
    Str source = "enum Color:\n"
                 "    red\n"
                 "    green\n"
                 "pick: Color = .green\n"
                 "is_green := pick == .green\n"
                 "page := if target.f32_mantissa_bits == 24: 4096 else: 16384\n"
                 "loop_a := loop_b\n"
                 "loop_b := loop_a\n";
    expect(source, "pick", ".green");
    expect(source, "is_green", "true");
    expect(source, "page", "4096");
    expect(source, "loop_a", "unknown: `loop_b` is defined by itself");
}
