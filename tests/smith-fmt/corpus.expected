==> slice-pointer-run/src/main.smith <==
module main;

import <stdio.h>;

// A pointer to a slice is C's pointer to an array (issue #148): `const char (*text)[:]` as `int (*p)[10]`. `*text` is
// the slice; `&s` passes to it, and a pointer to `char[:]` converts to a pointer to `const char[:]`, not the reverse.

typedef typeof(const char[:]) Text;

static bool take_line(const char (*text)[:], const char (*line)[:]) {
    if (countof(*text) == 0) return false;
    usize n = 0;
    while (n < countof(*text) && (*text)[n] != '\n')
        n++;
    *line = (*text)[0:n];
    *text = (*text)[n < countof(*text) ? n + 1 : n:];
    return true;
}

static usize length(Text *text) {
    return countof(*text);
}

static void upper_first(char (*xs)[:]) {
    (*xs)[0] = 'X';
}

static usize deep(const char (**pp)[:]) {
    return countof(**pp);
}

static usize rows(const f32 (*m)[:][2]) {
    return countof(*m) * 10 + countof((*m)[0]);
}

i32 main() {
    const char s[:] = "a\nbc\nd";
    const char line[:];
    while (take_line(&s, &line)) {
        c::printf("[%.*s]\n", (int)countof(line), line.data);
    }

    // The same through a typedef, as text and json write their API
    Text t = "one\ntwo";
    Text l;
    usize n = 0;
    while (take_line(&t, &l))
        n += length(&l);
    c::printf("%zu\n", n);

    // A pointer to `char[:]` is a pointer to `const char[:]`
    char buf[4] = {'a', 'b', 'c', 'd'};
    char w[:] = buf;
    char (*pw)[:] = &w;
    upper_first(pw);
    const char (*cw)[:] = pw;
    c::printf("%zu %zu %c\n", length(&w), length(pw), (*cw)[0]);

    f32 grid[3][2] = {{1, 2}, {3, 4}, {5, 6}};
    f32 g[:][2] = grid;
    const char (*pcs)[:] = &s;
    c::printf("%zu %zu\n", rows(&g), deep(&pcs));

    // A typedef of a slice type is the slice everywhere
    Text a = "abc";
    typeof(const char[:]) b = "defg";
    char raw[3] = {'x', 'y', 'z'};
    Text r = raw;
    a = "ab";
    r = r[1:];
    static Text fixed = "hello";
    c::printf("%zu %zu %zu %zu\n", countof(a), countof(b), countof(r), countof(fixed));
    return 0;
}
==> slice-qualifiers-lowering/src/qualifiers.smith <==
module qualifiers;

// The slice's qualifiers and the element's, as the lowering writes them: the element's go in the struct's data
// pointer's type (`const u8 *`), `[restrict :]` makes the data pointer `restrict` (a struct of its own), `[const :]`
// makes the variable const, and a string literal given to `const char[:]` is the literal itself, count 3, with no copy.

export typedef struct {
    const char name[:];
    u8 bytes[restrict :];
} Entry;

export usize total(const u8 xs[:]) {
    usize sum = 0;
    for (usize i = 0; i < countof(xs); i++) {
        sum += xs[i];
    }
    return sum;
}

export void copy(u8 dst[restrict :], u8 const src[const restrict :]) {
    for (usize i = 0; i < countof(dst) && i < countof(src); i++) {
        dst[i] = src[i];
    }
}

export usize greet() {
    const char word[:] = "abc";
    u8 bytes[3] = {1, 2, 3};
    u8 writable[const :] = bytes;
    const u8 view[:] = writable[1:];
    return countof(word) + total(view) + total(writable);
}
==> slice-qualifiers-run/src/main.smith <==
module main;

import <stdio.h>;

// A slice takes C's qualifiers as a pointer does (issue #126): the element's go with the element type, west or east,
// and the slice's own go inside the brackets, after C99's `int a[const 10]`.

static usize sum(const u8 xs[:]) {
    usize total = 0;
    for (usize i = 0; i < countof(xs); i++) {
        total += xs[i];
    }
    return total;
}

static usize east(u8 const xs[:]) {
    return countof(xs) + sum(xs);
}

static void copy(u8 dst[restrict :], const u8 src[const restrict :]) {
    for (usize i = 0; i < countof(dst) && i < countof(src); i++) {
        dst[i] = src[i];
    }
}

static usize fixed(u8 xs[const :]) {
    xs[0] = 9; // the elements are writable, the slice itself is fixed
    return countof(xs);
}

static typeof(u8[:]) keep(u8 xs[:]) {
    return xs;
}

static f32 corner(const f32 m[:][:]) {
    return m[countof(m) - 1][countof(m[0]) - 1];
}

static f32 rows(f32 m[const :][2]) {
    f32 row[:] = m[1];
    return row[0] + m[0][1];
}

i32 main() {
    u8 raw[6] = {1, 2, 3, 4, 5, 6};
    u8 all[:] = raw;
    const u8 read[:] = all;      // u8[:] to const u8[:] is implicit
    u8 const same[:] = read;     // east const is the same type
    const u8 cut[:] = read[1:4]; // a cut keeps const
    c::printf("%zu %zu %zu %zu\n", sum(all), sum(read), east(same), sum(cut));
    c::printf("%zu %zu\n", sum(raw), sum(all[2:]));

    u8 out[6] = {};
    copy(out, raw); // arrays and cuts become the slices the parameters want
    copy(out[4:6], read[0:2]);
    c::printf("%d %d %d %d %d\n", out[0], out[3], out[4], out[5], (int)fixed(all));

    u8 fixed_slice[const restrict :] = all;
    u8 *const first = &fixed_slice[0];
    c::printf("%d %zu %d\n", *first, countof(fixed_slice), keep(fixed_slice)[1]);

    f32 grid[3][2] = {{1, 2}, {3, 4}, {5, 6}};
    f32 g[:][:] = grid;
    const f32 cg[:][:] = g;
    f32 outer[const :][2] = grid;
    c::printf("%g %g %g\n", corner(g), corner(cg), rows(outer));
    const f32 part[:] = cg[1][0:1];
    c::printf("%zu %g\n", countof(part), part[0]);

    // A string literal is read-only data: const char[:] points into it, with no copy.
    const char word[:] = "abc";
    char const east_word[:] = "hello";
    c::printf("%zu %zu %.*s\n", countof(word), countof(east_word), (int)countof(word), word.data);
    return 0;
}
==> slice-run/src/main.smith <==
module main;

import <stdio.h>;
import <string.h>;

// Run-time arrays of one dimension: declared in a parameter, a result, a field and a local; counted, indexed, sliced
// and passed on; made from a fixed array, a string and a pointer; handed to C as a pointer.

struct Bag {
    i32 items[:];
    char name[:];
};

static i32 sum(i32 xs[:]) {
    i32 total = 0;
    for (usize i = 0; i < countof(xs); i++) {
        total += xs[i];
    }
    return total;
}

static typeof(i32[:]) inner(i32 xs[:]) {
    return xs[1:countof(xs) - 1];
}

static typeof(i32[:]) fixed() {
    static i32 data[3] = {7, 8, 9};
    return data;
}

static i32 once_calls = 0;

static typeof(i32[:]) once() {
    once_calls += 1;
    return fixed();
}

i32 main() {
    i32 raw[5] = {1, 2, 3, 4, 5};
    i32 all[:] = raw;
    i32 mid[:] = all[1:4];
    mid[0] = 40;
    i32 *p = raw;
    i32 view[:] = p[2:5];
    char word[:] = "abc";
    char with_zero[] = "abc";
    char zero[:] = with_zero;
    struct Bag bag = {};
    bag.items = all;
    bag.name = word;
    bag.items[4] += 100;
    c::printf("%zu %d %zu %d %d\n", countof(all), sum(all), countof(mid), raw[1], view[0]);
    c::printf("%zu %zu %zu %zu\n", countof(word), countof(zero), countof(bag.items), countof(all[:2]));
    c::printf("%d %d %d %zu\n", sum(inner(bag.items)), fixed()[2], all[3:][0], countof(fixed()));
    char copy[8] = {};
    c::memcpy(copy, bag.name, countof(bag.name));
    c::printf("%s %d\n", copy, sum(p[0:2]));
    i32 *none = nullptr;
    i32 empty[:] = none[0:0];
    c::printf("%zu %d\n", countof(empty), sum(empty));
    i32 first_of_call = once()[0];
    i32 part[:] = once()[1:3];
    c::printf("%d %zu %d\n", first_of_call, countof(part), once_calls); // a call indexed or sliced runs once each
    return 0;
}
==> slice-text-in-comment/src/hold.smith <==
module hold;

import smith::contract;

// The scan for slices skips comments and strings: neither this `xs[:]` nor the `a[1:2]` below puts the file in slice
// mode, where a head such as `T *reset(` of a generic is not read (issue #121).
/* a block comment: ys[:] */

export const char *note = "a string with zs[:] in it and a '['";

T *clear(constexpr type T, T *slot, usize count, i32 flags) {
    contract::assert(slot != nullptr);
    (void)flags;
    for (usize i = 0; i < count; i++) {
        slot[i] = (T){};
    }
    return slot;
}

export T *reset(constexpr type T, T *slot) {
    return clear(T, slot, 1, 0);
}

// A head with a format attribute and a variadic list, as the library modules have.
[[gnu::format(__printf__, 2, 3)]] i32 format_to(i32 level, const char *format, ...) {
    char buffer[64];
    __builtin_va_list arguments;
    __builtin_va_start(arguments, format);
    i32 written = __builtin_vsnprintf(buffer, sizeof buffer, format, arguments);
    __builtin_va_end(arguments);
    return written + level;
}

export i32 say(i32 level) {
    return format_to(level, "%d-%d", 12, 34);
}
