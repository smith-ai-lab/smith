==> constexpr-c-pedantic/src/main.smith <==
module main;
import <stdio.h>;

// A call of an ordinary C function where C requires a constant builds under -Wpedantic -Werror: folding it is no GNU
// extension in a .smith file (issue #166).
static i32 fib(i32 n) {
    return n < 2 ? n : fib(n - 1) + fib(n - 2);
}

static_assert(fib(10) == 55);

enum { Fib7 = fib(7) };

struct Flags {
    u32 low : fib(4) - 1;
    u32 high : 3;
};

static type wider(type a, type b) {
    return sizeof(a) >= sizeof(b) ? a : b;
}

static_assert(wider(u8, f64) == f64);

i32 main() {
    i32 n = 13;
    switch (n) {
    case fib(7):
        c::printf("seven %d\n", (i32)Fib7);
        break;
    default:
        c::printf("other %zu\n", sizeof(struct Flags));
        break;
    }
    return 0;
}
==> constexpr-c/src/main.smith <==
#include <stdio.h>

// An ordinary C function runs at compile time where C requires a constant.
static int fib(int n) {
    return n < 2 ? n : fib(n - 1) + fib(n - 2);
}
static int sum_to(int n) {
    int s = 0;
    for (int i = 1; i <= n; i++)
        s += i;
    return s;
}
static unsigned long width() {
    return sizeof(long);
}

struct Table {
    int v[8];
    int n;
};
static struct Table squares(int n) {
    struct Table t = {};
    for (int i = 0; i < n; i++) {
        t.v[i] = i * i;
        t.n += 1;
    }
    return t;
}

static_assert(sum_to(100) == 5050);
constexpr int x = fib(10);
constexpr struct Table table = squares(6);
constexpr unsigned long w = width();
enum { Fib7 = fib(7) };
struct Bits {
    unsigned a : fib(5);
};
static int cached = fib(12);

int main() {
    switch (x) {
    case fib(10):
        printf("%d %d %d %lu %d %d\n", x, table.v[5], table.n, w, Fib7, cached);
    }
    return 0;
}
