import pick;

int main() {
    u8 small = 5;
    i32 neg = -1;
    // The type of the first argument must be known.
    i32 q1 = pick::larger(neg++, neg);
    i32 q2 = pick::larger(missing, 1);
    // The type is passed where it stands, and no other argument may be left out.
    i32 *p1 = pick::alloc(4);
    i32 z1 = pick::zero();
    u8 pr = pick::pair(small, 1);
    i32 count = pick::larger(neg);
    i32 extra = pick::larger(neg, neg, neg);
    return q1 + q2 + *p1 + z1 + pr + count + extra;
}
==> generic-auto-arguments/src/pick.smith <==
module pick;

// The type is the first argument's; the second converts to it.
export typeof(a) larger(auto a, typeof(a) b) {
    return a > b ? a : b;
}

export usize size_of_value(auto value) {
    (void)value;
    return sizeof(typeof(value));
}

// A call to another generic inside a generic: the arguments are the instance's own parameters, so their type is known.
export typeof(value) twice(auto value) {
    return larger(value, value);
}

export typeof(a) zero_like(auto a) {
    (void)a;
    return (typeof(a)){0};
}

export T *alloc(i32 bytes, constexpr type T) {
    (void)bytes;
    return nullptr;
}

export T zero(constexpr type T) {
    return (T){0};
}

export typeof(a) pair(auto a, typeof(a) b, constexpr type T) {
    (void)b;
    return a;
}
