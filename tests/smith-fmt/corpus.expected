==> type-value-windows/src/wide.smith <==
module wide;

// The size of a type value is the target's: `long` is four bytes for Windows and eight elsewhere. A function over a
// type value runs in the compiler with the same answer.
constexpr type wide = long;

static bool long_is_four(type t) {
    return sizeof(t) == 4;
}

static_assert(!long_is_four(wide), "long is four bytes here");
static_assert(sizeof(wide) != 4, "sizeof of a type value is four bytes here");
static_assert(alignof(wide) != 4, "alignof of a type value is four here");
static_assert(sizeof(char *) == 8);

export i32 eight(void) {
    return 8;
}
==> type-value/src/main.smith <==
#include <stdint.h>
#include <stdio.h>

// A type is a value: a constexpr variable, a member of a struct, an element of an array, the argument or the result of
// an ordinary function.
typedef struct {
    char name[16];
    constexpr type of;
} Field;

typedef char *Text;
constexpr type count_type = u32;
constexpr type names[3] = {i32, f64, Text};
constexpr Field fields[2] = {{"length", usize}, {"ratio", f32}};

typedef i32 Meters;
constexpr type distance = Meters;

// Equal exactly when the types are the same, typedefs looked through.
static_assert(count_type == uint32_t);
static_assert(is_record(fields[0].of) == 0);
static_assert(count_type == u32);
static_assert(distance == i32);
static_assert(distance == int);
static_assert(names[0] != names[1]);
static_assert(fields[0].of == size_t);
static_assert(fields[1].of != fields[0].of);

// The questions an `if constexpr` asks of T, asked of a value.
static_assert(sizeof(names[2]) == 8 && alignof(names[1]) == 8);
static_assert(is_integer(count_type) && !is_signed(count_type) && is_signed(distance));
static_assert(is_float(names[1]) && !is_float(names[0]) && is_pointer(names[2]));

// An ordinary function takes and returns a type: it runs in the compiler.
static bool small(type t) {
    return sizeof(t) <= 4;
}

static type wider(type a, type b) {
    return sizeof(a) >= sizeof(b) ? a : b;
}

