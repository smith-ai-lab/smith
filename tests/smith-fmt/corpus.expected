==> generic-call/src/arena.smith <==
module arena;

export typedef struct {
    u8 *base;
    usize used;
    usize capacity;
} Arena;

export Arena make(u8 *memory, usize capacity) {
    return (Arena){memory, 0, capacity};
}

// Room for one value of any type, aligned for it.
export T *push(Arena *a, constexpr type T) {
    usize aligned = (a->used + alignof(T) - 1) & ~(alignof(T) - 1);
    T *result = (T *)(a->base + aligned);
    a->used = aligned + sizeof(T);
    return result;
}
==> generic-call/src/main.smith <==
import arena;
#include <stdio.h>

typedef struct {
    i32 x;
    i32 y;
} Point;

int main(void) {
    u8 storage[256];
    arena::Arena a = arena::make(storage, sizeof storage);
    Point *p = arena::push(&a, Point);
    p->x = 3;
    p->y = 4;
    u64 *n = arena::push(&a, u64);
    *n = 5;
    Point *q = arena::push(&a, Point);
    q->x = p->x + 10;
    printf("%d %d %llu %d used %zu\n", p->x, p->y, (unsigned long long)*n, q->x, a.used);
    return 0;
}
