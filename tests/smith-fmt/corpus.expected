==> defer-run/src/main.smith <==
module main;
import <stdio.h>;

// `defer` is C2y's defer TS in a module: the deferred statement runs when its block exits, last deferred first, on
// the end of the block, `return`, `break`, `continue` and a `goto` out (issue #210).
static i32 early(i32 n) {
    defer c::puts("leave early");
    if (n > 0) return 1;
    c::puts("not early");
    return 0;
}

static void jump() {
    {
        defer c::puts("cleanup before the jump");
        goto out;
    }
out:
    c::puts("after the jump");
}

i32 main() {
    {
        defer c::puts("first deferred, runs last");
        defer c::puts("second deferred, runs first");
        c::puts("body");
    }
    for (i32 i = 0; i < 3; i++) {
        defer c::printf("end of iteration %d\n", i);
        if (i == 0) continue;
        if (i == 2) break;
        c::puts("middle");
    }
    {
        defer {
            c::puts("block a");
            c::puts("block b");
        }
        c::puts("in block");
    }
    {
        defer c::puts("outer");
        {
            defer c::puts("inner");
            c::puts("nested body");
        }
        c::puts("outer body");
    }
    early(1);
    early(0);
    jump();
    return 0;
}
==> enum-c-rule/src/main.smith <==
// No `module` line: plain C enums mean what they mean in C. A `;` in the braces is what makes an enum one with
// payloads.
#include <stdio.h>

enum Color { Red, Green = 5, Blue };

typedef enum { Low = 1, High } Level;

struct Pair {
    int first;
    int second;
};

static int pick(enum Color color) {
    switch (color) {
    case Red:
        return 1;
    case Green:
        return 2;
    default:
        return 3;
    }
}

static struct Pair make() {
    return (struct Pair){.first = 4, .second = High};
}

int main() {
    struct Pair p = make();
    Level level = Low;
    printf("%d %d %d %d %d\n", pick(Red), pick(Blue), p.first, p.second, level == Low);
    return 0;
}
==> enum-generic-return/src/find.smith <==
module find;

// A generic returns a payload enum: `return .none;` and `return {.some = i};` are the function's own enum's, written in
// each instance (the compiler has read nothing of the instance's body when they are lowered).

export typedef enum {
    usize some;
    none;
} Position;

export Position position(auto xs, auto v) {
    for (usize i = 0; i < countof(xs); i++)
        if (xs[i] == v) return {.some = i};
    return .none;
}

export Position first_or_none(auto xs) {
    if (countof(xs) == 0) return .none;
    return {.some = 0};
}
==> enum-generic-return/src/main.smith <==
module main;

import <stdio.h>;
import find;

i32 main(void) {
    u8 raw[5] = {1, 2, 3, 4, 5};
    u8 bytes[:] = raw;
    i32 numbers[3] = {10, 20, 30};
    i32 ints[:] = numbers;
    find::Position a = find::position(bytes, 3);
    find::Position b = find::position(bytes, 9);
    find::Position c = find::position(ints, 30);
    find::Position none = find::first_or_none(bytes[5:]);
    switch (a) {
    case .some:
        c::printf("a %zu\n", a.some);
        break;
    case .none:
        c::printf("a none\n");
        break;
    }
    c::printf("%s %zu %s\n", b == .none ? "b none" : "b some", c == .some ? c.some : 99,
              none == .none ? "empty" : "full");
    return 0;
}
==> enum-payload-lowering/src/shapes.smith <==
module shapes;

// An enum with payloads lowers to a struct that holds a tag and a union (issue #198); variants are written like
// the members of a union, and a variant with nothing to carry is a name alone.

export typedef struct {
    f32 radius;
} Circle;

export typedef struct {
    f32 w;
    f32 h;
} Rect;

export typedef enum {
    Circle circle;
    Rect rect;
    struct {
        i32 a;
    } inline_one;
    empty;
} Shape;

export typedef enum {
    none;
    some;
} Mark;

export f32 area(Shape s) {
    switch (s) {
    case .circle:
        return s.circle.radius * s.circle.radius * 3;
    case .rect:
        return s.rect.w * s.rect.h;
    case .inline_one:
        return (f32)s.inline_one.a;
    case .empty:
        return 0;
    }
    return -1;
}

export Shape unit() {
    return {.circle = {.radius = 1}};
}

export bool is_empty(Shape s) {
    return s == .empty;
}
==> enum-payload-module/src/main.smith <==
module main;

import <stdio.h>;
import shapes;

static shapes::Shape grown(shapes::Shape s) {
    if (s == .circle) return {.circle = {.radius = s.circle.radius * 2}};
    return s;
}

i32 main() {
    shapes::Shape a = shapes::unit();
    shapes::Shape b = .empty;
    shapes::Shape c = {.rect = {.w = 2, .h = 5}};
    b = .empty;
    a = grown(a);
    c::printf("%g %g %g\n", shapes::area(a), shapes::area(b), shapes::area(c));
    c::printf("%d %d %g\n", shapes::is_empty(b), b == .empty, shapes::area(grown(.empty)));
    return 0;
}
