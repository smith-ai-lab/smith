==> c-name/src/smith/arena.smith <==
module smith::arena;

// A C API that keeps its names: the module's prefix would make smith_arena_Arena of these.
[[smith::c_name("SmithArena")]] export typedef struct {
    u64 used;
    u64 capacity;
} Arena;

[[smith::c_name("smith_arena_create")]] export Arena make(u64 capacity) {
    return (Arena){.used = 0, .capacity = capacity};
}

// No C name: the module's prefix, as before.
export u64 take(Arena *arena, u64 size) {
    if (arena->used + size > arena->capacity) return 0;
    arena->used += size;
    return arena->used;
}

[[smith::c_name("smith_arena_limit")]] export u64 limit = 4096;

// Defined in C, by its C name.
[[smith::c_name("smith_arena_checksum")]] export u64 checksum(const u8 *data, usize size);
==> c-name/src/smith/text.smith <==
module smith::text;
import smith::arena;

// A .smith importer writes the module's names, and gets the C names.
export u64 fill(u64 capacity) {
    arena::Arena a = arena::make(capacity);
    arena::take(&a, 10);
    const u8 bytes[3] = {1, 2, 3};
    return arena::take(&a, 5) + arena::checksum(bytes, 3) + arena::limit;
}
