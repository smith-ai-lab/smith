export Plain plain(void) {
    Private private_twice = twice;
    return private_twice;
}

export uint64_t call(Hook fn, uint64_t bits) {
    return fn(bits);
}

export uint64_t chosen_value(uint64_t bits) {
    return chosen(bits);
}
