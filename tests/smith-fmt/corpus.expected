==> error-main-io-make/src/smith/io.smith <==
// A stand-in for smith::io, which the language knows by its name: an io that counts its arguments and says when it is
// closed.
module smith::io;
import <stdio.h>;

[[smith::c_name("SmithIo")]] export typedef struct {
    i32 count;
} Io;

[[smith::c_name("smith_io_make")]] export Io make(i32 argc, char **argv) {
    (void)argv;
    return (Io){.count = argc};
}

[[smith::c_name("smith_io_close")]] export void close(Io *io) {
    c::printf("closed after %d argument\n", io->count);
}
