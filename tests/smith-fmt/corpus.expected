==> keyword-names-fine/src/main.smith <==
#include <stdio.h>

// Keywords that legitimately follow a type, and a sized type name used as a type in every other place.
u32 const first = 1;
u32 static second = 2;
unsigned long third = 3;
long double fourth = 4;
f64 *restrict pointer = nullptr;
u8 alignas(4) aligned = 5;

i32 main() {
    i32 sum = (i32)first + (i32)second + (i32)third + (i32)fourth + sizeof(u8) + sizeof(u16);
    printf("%d %d\n", sum, aligned);
    return 0;
}
==> library-smith-text/src/main.smith <==
// smith::text from .smith: its generated header (include/smith/text.h) is the interface, and the names are written as
// the module's, text::make, though C calls them smith_text_make.
import <stdio.h>;
import smith::text;

i32 main(void) {
    text::Text input = text::make("move 3 4 # go\nturn -90.5\n\nhash 00ff\n");
    text::Text line;
    text::Text word;
    u32 lines = 0;
    while (text::take_line(&input, &line)) {
        if (!text::take_word(&line, &word)) continue;
        lines += 1;
        if (text::is(word, "move")) {
            u64 x = 0;
            u64 y = 0;
            if (text::take_word(&line, &word) && text::parse_u64(word, &x) && text::take_word(&line, &word) &&
                text::parse_u64(word, &y))
                c::printf("move %llu %llu\n", x, y);
        } else if (text::is(word, "turn")) {
            f64 degrees = 0;
            if (text::take_word(&line, &word) && text::parse_f64(word, &degrees)) {
                char out[text::f64_capacity];
                usize n = text::write_f64(out, degrees);
                c::printf("turn %.*s\n", (i32)n, out);
            }
        } else if (text::is(word, "hash")) {
            u64 h = 0;
            if (text::take_word(&line, &word) && text::parse_hex(word, &h)) {
                char out[text::number_capacity];
                usize n = text::write_hex(out, h);
                c::printf("hash %.*s\n", (i32)n, out);
            }
        }
    }
    c::printf("%u lines\n", lines);
    return 0;
}
==> lowered-directives/src/demo/dir.smith <==
module demo::dir;

#pragma STDC FP_CONTRACT OFF
#include <string.h>

#ifdef __FAST_MATH__
#error "no -ffast-math"
#endif

// Kept as written, in place: the compiler that builds the lowered C decides each one.
#define PAIR(a, b) (((a) << 8) | (b))
#undef UNUSED_NAME

#if 0
static int not_read = 0; // not read, and nothing of it is kept
#elif defined(__aarch64__)
static const char *machine = "arm64";
#else
static const char *machine = "other";
#endif

// A branch the machine does not take is lowered like the rest: sized types need no parser's answer.
#if defined(__x86_64__)
export u32 width(u32 x) {
    u64 wide = x;
    return (u32)(wide + 1);
}
#elif defined(__aarch64__)
export u32 width(u32 x) {
    u64 wide = x;
    return (u32)(wide + 2);
}
#else
#error "unsupported machine"
#endif

// An exported variable's definition has no declaration before it in the module's own compile.
#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Wmissing-variable-declarations"
export u32 counter = 7;
#pragma clang diagnostic pop

export u32 pair(u32 a, u32 b) {
    return PAIR(a, b);
}

export usize name_length(void) {
    return strlen(machine);
}
==> member-after-dot-is-not-a-macro/src/main.smith <==
import "lens.h";
#include <stdio.h>

typedef struct {
    i32 vector_length;
} Lens;

int main(void) {
    Lens lens = {.vector_length = 3};
    Lens *p = &lens;
    // A member after `.` or `->` is a field, never a use of the macro of the same name.
    printf("%d %d\n", lens.vector_length, p->vector_length);
    return 0;
}
