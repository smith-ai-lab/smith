==> error-value-query/src/main.smith <==
module main;

static i32 forever(i32 n) {
    while (n >= 0)
        n += 1;
    return n;
}

i32 broken(constexpr type T) {
    if constexpr (forever(sizeof(T)) > 1) return 1;
    return 0;
}

export i32 call(void) {
    return broken(i32);
}
==> export-inline-attributes/src/hint.smith <==
module hint;

// Attributes after `export` stay before `static inline` in the module and in the header, beside [[smith::c_name]]: an
// inline function nothing calls is not an unused function, and always_inline needs no __attribute__ spelling.
[[smith::c_name("hint_first")]] export [[gnu::always_inline, maybe_unused]] inline void first(bool condition) {
    (void)condition;
}

export [[maybe_unused]] inline i32 second(i32 x) {
    return x + 1;
}

export [[nodiscard]] inline i32 third(i32 x) {
    return x + 2;
}

export i32 used(i32 x) {
    return third(x);
}
==> export-inline/src/math/small.smith <==
module math::small;

import <stdint.h>;

// Defined in the header, as `static inline`: the includer compiles it, so it has no symbol of the module's.
export inline u32 twice(u32 x) {
    return x * 2; // the body is the header's too
}

export inline u32 clamp(u32 x, u32 low, u32 high) {
    if (x < low) return low;
    if (x > high) return high;
    return x;
}

// Inline functions call each other, and the module's other exports.
export inline u32 clamp_twice(u32 x) {
    return clamp(twice(x), 10, 100);
}

export u32 regular(u32 x) {
    return twice(x) + 1;
}
==> exported-variable-declared/src/counter/state.smith <==
module counter::state;

// An exported variable is declared before its definition in the module's own compile, as a C file that includes its own
// header would, so -Wmissing-variable-declarations -Werror (the flags of this case) has nothing to say.
export u32 total = 3;
export u32 spare;
export const char *const names[2] = {"low", "high"};
[[smith::c_name("counter_state_chosen")]] export u64 chosen = 9;
export constexpr u32 limit = 4;
u32 hidden = 2;

export u32 sum(void) {
    return total + spare + limit + hidden;
}
