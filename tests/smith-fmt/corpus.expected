==> generic-rest/src/arguments.smith <==
module arguments;

import <stdio.h>;

// `auto... rest` is the tuple of the arguments that remain, each with its own type. `for constexpr` is C's own `for`,
// run at compile time and written out turn by turn: `i` is a number in each turn, so `rest[i]` is the `i`th argument.
// A body that is one statement is the same.
export i32 total(auto... rest) {
    i32 sum = 0;
    for constexpr (usize i = 0; i < countof(rest); i++)
        sum += (i32)rest[i];
    return sum;
}

// `rest[i]` mixes with ordinary run-time values; the weights are an ordinary array.
export i32 weighted(auto... rest) {
    i32 weights[] = {1, 2, 3, 4};
    static_assert(sizeof weights / sizeof weights[0] == 4);
    i32 sum = 0;
    for constexpr (usize i = 0; i < countof(rest); i++) {
        sum += (i32)rest[i] * weights[i];
    }
    return sum;
}

// `rest...` spreads the arguments into a call's arguments or an initializer, and `countof(rest)` is a constant.
export i32 spread(auto... rest) {
    static_assert(countof(rest) <= 4);
    i32 table[] = {100, rest..., 7};
    if constexpr (countof(rest) == 2) {
        char text[64];
        c::snprintf(text, sizeof text, "%d %d", rest...);
        c::printf("[%s]\n", text);
    }
    return table[countof(rest) + 1] + (i32)(sizeof table / sizeof table[0]);
}

// A loop counts down, steps by two, or runs no turn at all.
export i32 shapes(auto... rest) {
    i32 sum = 0;
    for constexpr (usize i = countof(rest); i > 0; i--)
        sum += (i32)rest[i - 1] * (i32)i;
    for constexpr (usize i = 0; i < countof(rest); i += 2)
        sum += 1000;
    for constexpr (usize i = 0; i < 0; i++)
        sum += 1;
    return sum;
}

// An argument of a different type for each element, a loop in a loop, and `if constexpr` on the loop's variable.
export i32 mixed(auto... rest) {
    i32 sum = 0;
    for constexpr (usize i = 0; i < countof(rest); i++) {
        for constexpr (usize j = 0; j < 2; j++) {
            if constexpr (i == 0 && j == 1) {
                sum += 100;
            }
            sum += (i32)rest[i];
        }
    }
    return sum;
}
