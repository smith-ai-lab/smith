==> generic-pack-expand-typed/src/typed.smith <==
module typed;

static i32 sq(i32 x) {
    return x * x;
}

// A generic that gives each argument back, and one that counts and adds what it is given.
export typeof(x) same(auto x, usize k) {
    (void)k;
    return x;
}

export i32 total(auto p, auto... rest) {
    i32 sum = (i32)(*p) + (i32)countof(rest) * 100;
    for constexpr (usize i = 0; i < countof(rest); i++) {
        sum += (i32)rest[i];
    }
    return sum;
}

// An expansion among the arguments of a call to a generic: the other arguments are expressions of the parameters, the
// pattern calls a generic, and a plain function.
export i32 with_generic(auto p, auto... rest) {
    return total(p + 0, same(rest, 1)...);
}

export i32 with_function(auto p, auto... rest) {
    return total(&p[0], 1000, sq(rest)..., 7);
}

// A call of a generic with `rest[k]` in an argument that is itself a call of a generic.
export i32 nested(auto p, auto... rest) {
    return total(&p[0], 1, same(rest[0], 2));
}

export i32 mixed(auto p, auto... rest) {
    return total(p + 0, rest...) + total(p, same(rest, 0)...);
}

// A local of the instance as an argument of a call of a generic inside the pattern, and in a call inside a call.
export i32 with_local(auto p, auto... rest) {
    i32 sum = 0;
    for (usize k = 0; k < 2; k++) {
        sum += total(p + k, same(rest, k)...) + total(p, same(*p, k));
    }
    return sum;
}
==> generic-pack-expand/src/expand.smith <==
module expand;

static i32 sq(i32 x) {
    return x * x;
}

static i32 plus(i32 a, i32 b) {
    return a + b;
}

// The sum of the `count` numbers after it, so that a call's arguments can be any number.
static i32 vsum(i32 count, ...) {
    __builtin_va_list list;
    __builtin_va_start(list, count);
    i32 sum = 0;
    for (i32 i = 0; i < count; i++)
        sum = sum * 10 + __builtin_va_arg(list, i32);
    __builtin_va_end(list);
    return sum;
}

// A pattern that names the pack is written once for each element: `plus(rest, off)...` is `plus(rest_0, off),
// plus(rest_1, off), ...`.
export i32 shifted(i32 off, auto... rest) {
    return vsum((i32)countof(rest), plus(rest, off)...);
}

// An expansion among other arguments: before it, after it, and both.
export i32 around(auto... rest) {
    return vsum(2 + (i32)countof(rest), 1, sq(rest)..., 3);
}

// An empty pack takes the comma before it, or after it when it comes first.
export i32 rest_empty(auto... rest) {
    i32 first = vsum(1 + (i32)countof(rest), 7, sq(rest)...);
    i32 last = vsum(1 + (i32)countof(rest), sq(rest)..., 8);
    i32 only = vsum((i32)countof(rest), sq(rest)...);
    return first * 10000 + last * 100 + only;
}

// A braced initializer, the pack named several times in the pattern, and the bare `rest...` as it was.
export i32 table(auto... rest) {
    i32 xs[] = {sq(rest)..., 0};
    i32 ys[] = {plus(rest, sq(rest))..., 1, rest...};
    i32 sum = 0;
    constexpr usize nx = sizeof xs / sizeof xs[0];
    constexpr usize ny = sizeof ys / sizeof ys[0];
    for (usize i = 0; i < nx; i++)
        sum += xs[i];
    for (usize i = 0; i < ny; i++)
        sum += ys[i];
    return sum * 1000 + (i32)nx * 10 + (i32)ny;
}

export i32 first_of(auto x) {
    return (i32)x;
}

// A call to a generic in the pattern.
export i32 over_generic(auto... rest) {
    return vsum((i32)countof(rest), expand::first_of(rest)...);
}

export typedef struct {
    i32 a;
    i32 b;
} Pair;

// A field of each argument, by a Field value: `rest->[f]...` is `rest_0->a, rest_1->a, ...`.
export i32 fields_of(constexpr type T, auto... rest) {
    i32 sum = 0;
    for constexpr (usize i = 0; i < 2; i++) {
        constexpr Field f = fields(T)[i];
        sum = sum * 1000 + vsum((i32)countof(rest), rest->[f]...);
    }
    return sum;
}
