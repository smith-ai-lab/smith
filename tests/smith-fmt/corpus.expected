module pointers;

// A pointer to a slice lowers to a pointer to the slice's struct (issue #148).

export typedef typeof(const char[:]) Text;

export bool take_line(const char (*text)[:], const char (*line)[:]) {
    *line = (*text)[0:1];
    *text = (*text)[1:];
    return countof(*text) > 0;
}

export usize length(Text *text) {
