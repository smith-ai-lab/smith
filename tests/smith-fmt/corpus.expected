module geo::a;

export typedef f64 Meters;
export typedef struct { Meters, f32 } Reach;

export struct { i32, f32 } make(i32 a, f32 b) {
    return {a, b};
}

export i32 sum(struct { i32, f32 } t) {
    return t[0] + (i32)t[1];
}

export Reach reach(Meters m) {
    Reach r = {m, 1.0f};
    return r;
}

export struct { Meters, f32 } reach2(Meters m) {
    return {m, 2.0f};
}

export void scale(struct { Meters, f32 } *t, f64 by) {
    (*t)[0] *= by;
}
==> tuple-modules/src/geo/b.smith <==
module geo::b;

import geo::a;

// The same shape in another module is the same type: a tuple made here is passed to a function there.
export i32 twice(struct { i32, f32 } t) {
    return a::sum(t) * 2;
}

// `a::Meters` written here and `Meters` in geo::a are one spelling, so these are one type.
export struct { a::Meters, f32 } mk() {
    return a::reach2(5.0);
}

export a::Reach longer(a::Reach r) {
    struct { a::Meters, f32 } copy = r;
    a::scale(&copy, 2.0);
    return copy;
}
