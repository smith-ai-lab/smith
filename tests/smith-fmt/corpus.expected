import pick;

constexpr i32 limit = 300;

int main(void) {
    u8 small = 5;
    u32 big = 7;
    i32 neg = -1;
    f32 fl = 1.5f;
    // A later argument that converts with a change of value is an error at the call.
    u8 r1 = pick::larger(small, 300);
    u8 r2 = pick::larger(small, limit);
    u8 r3 = pick::larger(small, big);
    u8 r4 = pick::larger(small, -1);
    f32 r5 = pick::larger(fl, 0.1);
    f32 r6 = pick::larger(fl, 16777217);
    f32 r7 = pick::larger(fl, neg);
    u32 r8 = pick::larger(big, neg);
    u8 r9 = pick::larger(small, big + 1);
    u8 r10 = pick::larger(small, limit + 1);
    // These keep the value.
    u8 ok1 = pick::larger(small, 200);
    f32 ok2 = pick::larger(fl, 0.5);
    f32 ok3 = pick::larger(fl, 0.1f);
    f32 ok4 = pick::larger(fl, small);
    u32 ok5 = pick::larger(big, small);
    u32 ok6 = pick::larger(big, 1 << 3);
    u8 ok8 = pick::larger(small, limit - 200);
    u8 ok7 = pick::larger(small, (u8)neg);
    return r1 + r2 + r3 + r4 + r5 + r6 + r7 + r8 + r9 + r10 + ok8 + ok1 + ok2 + ok3 + ok4 + ok5 + ok6 + ok7;
}
