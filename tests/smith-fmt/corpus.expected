==> slice-export-sanitize/src/r.smith <==
module r;

// An exported function with a slice parameter, compiled under -fsanitize=function (issue #152): the prototype and the
// definition share one struct, defined at file scope; clang overflowed its stack mangling two in the parameter lists.
export i32 first(i32 xs[:]) {
    return xs[0];
}

export i32 total(i32 xs[:], i32 ys[:]) {
    i32 sum = 0;
    for (usize i = 0; i < countof(xs); i++) {
        sum += xs[i];
    }
    for (usize i = 0; i < countof(ys); i++) {
        sum += ys[i];
    }
    return sum;
}
==> slice-initializer-run/src/main.smith <==
module main;

import <stdio.h>;

// A slice member takes a slice expression in an initializer list as it does in an assignment (issue #173): a string
// literal, an array or another slice, by designator, by position, nested, as a typedef'd `str`, in a compound literal.

typedef const char str[:];

struct Pair {
    const char key[:];
    const char value[:];
};

struct Named {
    str name;
    i32 id;
};

struct Outer {
    i32 first;
    struct Pair pair;
    str tag;
};

static usize total(struct Pair p) {
    return countof(p.key) * 10 + countof(p.value);
}

i32 main() {
    struct Pair a = {.key = "k", .value = "xyz"};
    struct Pair b = {"kk", "v"};
    char raw[3] = {'a', 'b', 'c'};
    char word[:] = raw;
    struct Pair c = {.value = word, .key = raw};
    c::printf("%zu %zu %zu\n", total(a), total(b), total(c));

    struct Named n = {.id = 7, .name = "five5"};
    struct Outer o = {1, {.value = "ab", .key = "c"}, .tag = "tag"};
    struct Outer o2 = {.pair = {"x", "yz"}};
    c::printf("%zu %zu %zu %zu %zu\n", countof(n.name), countof(o.pair.value), countof(o.tag), countof(o2.pair.key),
              countof(o2.pair.value));

    c::printf("%zu %zu\n", total((struct Pair){.value = "x"}), total((struct Pair){"ab", "c"}));
    struct Pair e = {};
    c::printf("%zu %c\n", countof(e.key), a.value[2]);
    return 0;
}
==> slice-lowering/src/slices.smith <==
module slices;

// A slice in every place a declaration goes: a parameter, a result, a field, a typedef and a local. The struct is
// defined where it is written, once in the header, and the same shape is one type.

export typedef struct {
    f32 weights[:];
    char name[:];
} Layer;

export typedef i32 Numbers[:];

export usize total(i32 xs[:], usize skip) {
    usize sum = 0;
    for (usize i = skip; i < countof(xs); i++) {
        sum += (usize)xs[i];
    }
    return sum;
}

export typeof(i32[:]) middle(i32 xs[:]) {
    return xs[1:countof(xs) - 1];
}

export typeof(char[:]) label(Layer *layer) {
    return layer->name;
}

export Numbers first_two(Numbers all) {
    Numbers two = all[:2];
    return two;
}
