module leaves;

// The type a pointer points to, and a scalar's own: a function over `type` that reads the pointee of a type value in
// C's own way (issue #143).
static type leaf_of(type t) {
    if (is_pointer(t)) return typeof(*(t) nullptr);
    return t;
}

export leaf_of(T) first(constexpr type T, T x) {
    if constexpr (is_pointer(T)) {
        return *x;
    } else {
        return x;
    }
}
