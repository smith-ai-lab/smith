module main;

import <stdio.h>;
import <stdlib.h>;
import shapes;

// The headers are on the include path here (the body file is written beside them); slices and tuples in a function's
// body are what its own compile wrote: the importer runs them.
static_assert(shapes::dot(1) == 1 + 4 + 9 + 16);
static_assert(shapes::second(3) == 6);
constexpr i32 chosen = shapes::second(shapes::dot(1) - 28);

// What a failed check of an index calls (the library's, in a real program).
[[smith::c_name("smith_failure")]] export void failure(u8 code) {
    c::exit(code);
}

int main() {
    c::printf("%d %d\n", chosen, shapes::dot(2));
    return 0;
}
==> constexpr-import-header/src/shapes.smith <==
module shapes;

export i32 dot(i32 n) {
    i32 buf[4] = {n, n + 1, n + 2, n + 3};
    i32 xs[:] = buf;
    i32 total = 0;
    for (usize i = 0; i < countof(xs); i++)
        total += xs[i] * xs[i];
    return total;
}

export struct { i32, i32 } pair(i32 a) {
    return {a, a * 2};
}

export i32 second(i32 a) {
    struct { i32, i32 } p = pair(a);
    return p[1];
}
