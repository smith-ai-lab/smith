}
==> generic-pack/src/args.smith <==
module args;

// `auto... rest` is the arguments that remain, each with its own type: `countof(rest)` is how many there are.
export usize count(auto x, auto... rest) {
    (void)x;
    return countof(rest);
}

// `rest...` expands them, in order, wherever a list of expressions goes: here a call's arguments.
export typeof(x) call_all(constexpr auto f, auto x, auto... rest) {
    (void)sizeof(f(x, rest...));
    return f(x, rest...);
}

// `rest[i]` is the `i`th, with its own type, `i` a compile-time constant; the branch not taken may name what is not
// there.
export f64 second_or(auto x, auto... rest) {
    (void)x;
    if constexpr (countof(rest) > 1) {
        return (f64)rest[1];
    } else {
        return -1.0;
    }
}

// The size of each element's own type.
export usize size_of_first(auto... rest) {
    if constexpr (countof(rest) == 0) {
        return 0;
    } else {
        return sizeof(rest[0]);
    }
}

// A generic hands its list on to another: the elements keep their types.
export typeof(x) forward(constexpr auto f, auto x, auto... rest) {
    return call_all(f, x, rest...);
}

// An expansion after other arguments, and a count passed on.
export usize forward_count(auto x, auto... rest) {
    return count(x, rest...) + 100;
}

// The list's size is a constant: a static_assert and an array length use it.
export usize at_least_two(auto... rest) {
    static_assert(countof(rest) >= 2, "at_least_two needs two arguments");
    u8 bytes[countof(rest)];
    return sizeof bytes;
}
==> generic-pack/src/main.smith <==
module main;

import args;
import <stdio.h>;

static i32 add1(i32 a) {
    return a + 1;
}

static i32 plus(i32 a, i32 b) {
    return a + b;
}

static i32 add3(i32 a, i32 b, i32 c) {
    return a + b + c;
}

int main() {
    usize n0 = args::count(1);
    usize n1 = args::count(1, 2.5);
    usize n3 = args::count(1, 2.5, (u8)3, "four");
    i32 r1 = args::call_all(add1, 5);
    i32 r2 = args::call_all(plus, 5, 6);
    i32 r3 = args::call_all(add3, 5, 6, 7);
    f64 s0 = args::second_or(1);
    f64 s1 = args::second_or(1, 2);
    f64 s2 = args::second_or(1, 2, 3.5f);
    usize z0 = args::size_of_first();
    usize z1 = args::size_of_first((u16)1, 2.0);
    usize z2 = args::size_of_first(2.0, (u16)1);
    i32 f1 = args::forward(add3, 1, 2, 3);
    i32 f2 = args::forward(add1, 1);
    usize c1 = args::forward_count(1);
    usize c2 = args::forward_count(1, 2, 3);
    usize b = args::at_least_two(1, 2, 3);
    c::printf("%zu %zu %zu | %d %d %d | %.1f %.1f %.1f | %zu %zu %zu | %d %d | %zu %zu | %zu\n", n0, n1, n3, r1, r2, r3,
              s0, s1, s2, z0, z1, z2, f1, f2, c1, c2, b);
    return 0;
}
==> generic-print-error/src/fmt.smith <==
module fmt;

import <stdio.h>;

// A type-checked `print`: one `for constexpr` over the arguments, and each one is formatted by its own type, chosen
// when the instance is written. A type with no format is a `static_assert` in the final `else`, at the call that asked
// for it.
export void print(auto... args) {
    for constexpr (usize i = 0; i < countof(args); i++) {
        if constexpr (i > 0) {
            c::putchar(' ');
        }
        if constexpr (is_bool(typeof(args[i]))) {
            c::fputs(args[i] ? "true" : "false", c::stdout);
        } else if constexpr (is_integer(typeof(args[i])) && is_signed(typeof(args[i]))) {
            c::printf("%lld", (long long)args[i]);
        } else if constexpr (is_integer(typeof(args[i]))) {
            c::printf("%llu", (unsigned long long)args[i]);
        } else if constexpr (is_float(typeof(args[i]))) {
            c::printf("%g", (double)args[i]);
        } else if constexpr (typeof(args[i]) == char *) {
            c::fputs(args[i], c::stdout);
        } else {
            static_assert(false, "fmt::print: no format for this type");
        }
    }
    c::putchar('\n');
