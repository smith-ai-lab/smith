==> module-enum-c-names/src/mix/modes.smith <==
module mix::modes;

// An exported enum's constants are `<CType>_<Value>` in C, the type's C name and the constant: `MixMode_Fast`.
[[smith::c_name("MixMode")]] export typedef enum {
    Fast,
    Slow,
} Mode;

// A tagged enum has its tag's C name: `mix_modes_Level_High`.
export enum Level {
    Low,
    High,
};

export i32 score(Mode mode, enum Level level) {
    return (mode == Slow ? 10 : 1) + (level == High ? 100 : 0);
}
