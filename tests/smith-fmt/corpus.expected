==> if-constexpr/src/kind.smith <==
module kind;

import target;

constexpr i32 wide = 8;
constexpr bool both = wide == 8 && target::float_radix == 2;

// A chain: the branches not taken are never given to the parser, so they may be anything.
export i32 arch_name(void) {
    if constexpr (target::arch == target::aarch64) {
        return 1;
    } else if constexpr (target::arch == target::x86_64) {
        undeclared_function();
    } else {
        return 3;
    }
}

// The constraint for another architecture would not compile here.
export i32 opaque(i32 value) {
    if constexpr (target::arch == target::aarch64) {
        __asm__("" : "+w"(value));
    } else {
        __asm__("" : "+nonsense"(value));
    }
    return value;
}

// Nested blocks, constants of the file and of the function, and a condition of literals.
export i32 nested(i32 x) {
    constexpr i32 local = 3;
    i32 result = 0;
    if constexpr (wide == 8) {
        if constexpr (target::os == target::macos) {
            result = 10;
        } else {
            undeclared_function();
        }
        if constexpr (both) {
            result += 1;
        }
        if constexpr (wide < 4) {
            undeclared_function();
        } else {
            result += x;
        }
        if constexpr (local == 3 && !(1 > 2) || false) {
            result += 100;
        }
    }
    if constexpr (0 == 1) {
        undeclared_function();
    }
    return result;
}

// A generic's `if constexpr` still chooses the branch for each instance.
export i32 describe(constexpr type T, T value) {
    (void)value;
    if constexpr (T == f32) {
        return 1;
    } else if constexpr (sizeof(T) == 8) {
        return 2;
    } else {
        return 3;
    }
}
==> if-constexpr/src/main.smith <==
import kind;
import target;
import <stdio.h>;

constexpr bool fast = target::assertions == false;

int main(void) {
    i32 answer = 0;
    // In a file with no module line the branches flow the same.
    if constexpr (target::os == target::macos) {
        answer = 7;
    } else {
        undeclared_function();
    }
    if constexpr (fast) {
        c::printf("assertions are off\n");
    } else if constexpr (target::arch == target::aarch64) {
        c::printf("answer is seven\n");
    } else {
        c::printf("neither\n");
    }
    c::printf("%d %d %d\n", kind::arch_name(), kind::opaque(5), kind::nested(20));
    c::printf("%d %d %d\n", kind::describe(f32, 1.5f), kind::describe(u64, 9), kind::describe(u8, 1));
    return answer == 7 ? 0 : 1;
}
