    struct { const char *, c::int8_t } h = g;
    struct { Meters, f32 } m = {1.0, 2.0f};
    c::printf("%d %d %d\n", take(d), take(c), take(b));
    c::printf("%lld %llu %zu %s %d %f\n", f[0], f[1], f[2], h[0], h[1], m[0]);
