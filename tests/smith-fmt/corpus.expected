==> export-inline/src/math/small.smith <==
module math::small;

import <stdint.h>;

// Defined in the header, as `static inline`: the includer compiles it, so it has no symbol of the module's.
export inline u32 twice(u32 x) {
    return x * 2; // the body is the header's too
}

export inline u32 clamp(u32 x, u32 low, u32 high) {
    if (x < low) return low;
    if (x > high) return high;
    return x;
}

// Inline functions call each other, and the module's other exports.
export inline u32 clamp_twice(u32 x) {
    return clamp(twice(x), 10, 100);
}

export u32 regular(u32 x) {
    return twice(x) + 1;
}
==> foreign-extern/src/sys/world.smith <==
module sys::world;

import <string.h>;

// `extern` without `export` declares a symbol that C defines: it keeps its C name (no sys_world_ prefix, no label).
extern char **environ;
extern u32 foreign_counter;
extern u32 foreign_triple(u32 x);

export u32 env_count(void) {
    u32 count = 0;
    for (char **entry = environ; *entry != nullptr; entry++)
        count += 1;
    return count;
}

export u32 counter_times_three(void) {
    return foreign_triple(foreign_counter);
}

// An exported extern is still the module's own symbol, defined in C by its C name.
export extern u32 owned;
