module game::replay;
import lib::text as tx;

export typedef struct {
    u64 frames;
    tx::Text name;
} Replay;
export constexpr u32 version = 3;
export u32 counter = 7;

export typedef struct Handle {
    i32 fd;
} Handle;
export enum Mode { Fast, Slow };

u32 helper(void) {
    return version + counter;
}

export Replay open(Handle *handle, const char *path) {
    Replay replay = {0};
    replay.frames = helper() + (u64)handle->fd;
    replay.name = tx::make(path);
    counter += 1;
    return replay;
}

export u64 checksum(const u8 *data, usize size);
