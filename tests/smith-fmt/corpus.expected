module guard;

import target;

// A fact of the target in a generic's `if constexpr`, with a fact of T: asked of the compiler when an instance is made.
export T pick_one(constexpr type T, T a, T b) {
    if constexpr (target::static_analyzer) {
        return a;
    } else if constexpr (target::arch == target::aarch64 && sizeof(T) == 4) {
        return b;
