    Point p = {10, 20};
    printf("%d %d %d %d %d\n", kind::describe(f32, f), kind::describe(u64, big), kind::describe(i32 *, &small),
           kind::describe(u8, byte), kind::describe(Point, p));
    printf("%d %d %d\n", kind::describe(i32, small), kind::floats_only(f32, f), kind::floats_only(i32, small));
    printf("%d %d %d\n", kind::bytes(u8), kind::bytes(u64), kind::bytes(Point));
    return 0;
}
==> generic-nested/src/arena.smith <==
module arena;

export typedef struct {
    u8 *base;
    usize used;
    usize capacity;
} Arena;

export Arena make(u8 *memory, usize capacity) {
    return (Arena){memory, 0, capacity};
}

// Room for one value of any type, aligned for it.
export T *push(Arena *a, constexpr type T) {
    usize aligned = (a->used + alignof(T) - 1) & ~(alignof(T) - 1);
    T *result = (T *)(a->base + aligned);
    a->used = aligned + sizeof(T);
    return result;
}
==> generic-nested/src/list.smith <==
module list;

import arena;

// A generic that asks for another module's generic, and for one of its own: the instances nest.
export T *make(arena::Arena *a, constexpr type T) {
    return arena::push(a, T);
}

export T *make_two(arena::Arena *a, constexpr type T) {
    make(a, T);
    return make(a, T);
}

// An ordinary function of the module, called from a generic's body.
export usize bytes(arena::Arena *a) {
    return a->used;
}

export usize measure(arena::Arena *a, constexpr type T) {
    T *value = make(a, T);
    (void)value;
    return bytes(a);
}
