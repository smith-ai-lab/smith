==> generic-auto-typeof/src/num.smith <==
module num;

export typedef struct {
    i32 x;
    i32 y;
} Pair;

// `typeof(x)` is the parameter's type in later parameters, in the body and in the return type written before the name.
export typeof(a) add(auto a, typeof(a) b) {
    typeof(a) sum = a + b;
    return sum;
}

// `if constexpr` tests `typeof(x)` as it tests a `T`.
export u32 kind(auto v) {
    if constexpr (typeof(v) == f32) {
        return 1;
    } else if constexpr (is_integer(typeof(v)) && sizeof(typeof(v)) == 8) {
        return 2;
    } else if constexpr (is_pointer(typeof(v))) {
        return 4;
    } else {
        return 3;
    }
}

// Two `auto` parameters make one instance for each pair of types.
export f64 mix(auto a, auto b) {
    f64 sum = (f64)a + (f64)b;
    return sum;
}

// An `auto` beside a `constexpr type`: the type is passed, and the other is told from its argument.
export typeof(a) *make(auto a, constexpr type T, usize count) {
    (void)a;
    (void)count;
    return (typeof(a) *)(T *)nullptr;
}

// `typeof` of a parameter that is no `auto` is plain C.
export i32 first(const Pair *p, typeof(p) other) {
    return p != nullptr ? p->x : other->y;
}

export usize width(auto v) {
    (void)v;
    return sizeof(typeof(v));
}
