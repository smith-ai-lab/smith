==> foreign-extern/src/sys/world.smith <==
module sys::world;

import <string.h>;

// `extern` without `export` declares a symbol that C defines: it keeps its C name (no sys_world_ prefix, no label).
extern char **environ;
extern u32 foreign_counter;
extern u32 foreign_triple(u32 x);

export u32 env_count(void) {
    u32 count = 0;
    for (char **entry = environ; *entry != nullptr; entry++)
        count += 1;
    return count;
}

export u32 counter_times_three(void) {
    return foreign_triple(foreign_counter);
}

// An exported extern is still the module's own symbol, defined in C by its C name.
export extern u32 owned;
==> function-pointer-typedef-result/src/hook/table.smith <==
module hook::table;

#include <stdint.h>

// A function pointer whose result type is a typedef name: the name in `(*Name)` is the declaration, as with
// `unsigned long`.
[[smith::c_name("HookFn")]] export typedef uint64_t (*Hook)(uint64_t bits);
export typedef uint64_t (*Plain)(uint64_t bits);
export typedef u32 (*Sized)(u32 bits);
export typedef unsigned long (*Builtin)(uint64_t bits);
typedef uint64_t (*Private)(uint64_t bits);

export typedef struct {
    u32 v;
} Box;
export typedef Box (*Make)(u32 v);

static uint64_t twice(uint64_t bits) {
    return bits * 2;
}

uint64_t (*chosen)(uint64_t bits) = twice;
[[smith::c_name("hook_table_hook")]] export uint64_t (*hook)(uint64_t bits) = twice;

export Plain plain(void) {
    Private private_twice = twice;
    return private_twice;
}

export uint64_t call(Hook fn, uint64_t bits) {
    return fn(bits);
}

export uint64_t chosen_value(uint64_t bits) {
    return chosen(bits);
}
