==> generic-braceless/src/twice.smith <==
module twice;

import pick;

// Braceless statements in a generic: the instance keeps the lines of the generic, so the compiler's
// -Wmisleading-indentation (the case's flags make it an error) has nothing to say.
export typeof(a) bigger_twice(auto a, typeof(a) b) {
    typeof(a) r = a;
    if (a > b) r = pick::larger(a, b);
    if (a > b) r += 1;
    for (i32 i = 0; i < 2; i++)
        r += pick::larger(a, b);
    return r;
}
