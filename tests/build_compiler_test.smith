// `smith build` and the compiler it runs, from tests/build.sh sections 12 and 13: a change of compiler rebuilds every
// object it compiled and a build with the same compiler does nothing, smith routed to an external clang, a replaced
// smith, and the identity a smith reports. Each test is a project of its own (tests/build_fixtures), so they run side
// by side with the rest.
module build_compiler_test;

import std::io;
import std::test;
import scratch;

// 13. ninja sees the same command (`smith ...`) before and after, so the objects would look up to date. Each object and
// program depends on a file in .smith/compiler/ that says which compiler it is.
export void test_build_a_change_of_compiler_rebuilds_every_object(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "compiler_change");
    (void)scratch::build(&p, "");
    // two compiles, the link of the program and the link of the handlers runtime beside it
    scratch::expect_count("compiler change: the first build runs the compiler on both sources and links twice", 4,
                          scratch::lines(&p, "runs"));
    scratch::Run again = scratch::build(&p, "");
    scratch::expect_contains("compiler change: a build with the same compiler does nothing", again.out,
                             "no work to do");
    scratch::expect_count("compiler change: and ran nothing", 4, scratch::lines(&p, "runs"));
    (void)scratch::build(&p, "-DCOMPILER=bin/cc2");
    scratch::expect_count("compiler change: another compiler rebuilds both objects and links again", 7,
                          scratch::lines(&p, "runs"));
    scratch::expect_text("compiler change: the object is the new compiler's", "cc2", scratch::read(&p, "build/a.o"));
    scratch::Run second = scratch::build(&p, "-DCOMPILER=bin/cc2");
    scratch::expect_contains("compiler change: the new compiler's build does nothing too", second.out, "no work to do");
    (void)scratch::build(&p, "-DCOMPILER=bin/cc1");
    scratch::expect_count("compiler change: going back rebuilds as well", 10, scratch::lines(&p, "runs"));
    scratch::expect_text("compiler change: the object is the old compiler's again", "cc1",
                         scratch::read(&p, "build/a.o"));
    // The same compiler replaced by another file: a new version.
    scratch::write(&p, "bin/cc1.new",
                   "#!/bin/sh\nwhile [ $# -gt 0 ]; do\n    if [ \"$1\" = -o ]; then out=$2; fi\n    shift\ndone\n"
                   "echo cc1-new >\"$out\"\necho \"$0\" >>runs\n");
    (void)scratch::sh(&p, "chmod +x bin/cc1.new && mv bin/cc1.new bin/cc1");
    (void)scratch::build(&p, "");
    scratch::expect_count("compiler change: the same path with another compiler in it rebuilds both objects", 13,
                          scratch::lines(&p, "runs"));
    scratch::expect_text("compiler change: and the objects are the new one's", "cc1-new",
                         scratch::read(&p, "build/a.o"));
    scratch::Run settled = scratch::build(&p, "");
    scratch::expect_contains("compiler change: and then settles", settled.out, "no work to do");
}

// smith as the compiler: what it runs is part of what it is. The external clangs are wrappers that note their runs on
// a.c and run the real clang (smith build compiles build.c with them as well, which they let pass).
export void test_build_smith_routes_to_an_external_clang(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "external_clang");
    (void)scratch::sh(&p, "mkdir smith-bin && { cp -c \"$SMITH_SELF\" smith-bin/smith-cc 2>/dev/null || cp "
                          "\"$SMITH_SELF\" smith-bin/smith-cc; }");
    scratch::Run first = scratch::sh(&p, "env SMITH_CLANG=\"$PWD/bin/w2\" smith build");
    (void)first;
    scratch::expect_text("smith routes to an external clang: the first build runs it", "w2",
                         scratch::read(&p, "wrapped"));
    scratch::Run same = scratch::sh(&p, "env SMITH_CLANG=\"$PWD/bin/w2\" smith build");
    scratch::expect_contains("smith routes to an external clang: the same clang does nothing", same.out,
                             "no work to do");
    (void)scratch::sh(&p, "env SMITH_CLANG=\"$PWD/bin/w3\" smith build");
    scratch::expect_text("smith routes to an external clang: SMITH_CLANG changed to another clang rebuilds the object",
                         "w2\nw3", scratch::read(&p, "wrapped"));
    (void)scratch::sh(&p, "env SMITH_CLANG=\"$PWD/bin/w2\" smith build");
    scratch::expect_text("smith routes to an external clang: and back again", "w2\nw3\nw2",
                         scratch::read(&p, "wrapped"));
    scratch::write(&p, "bin/w2.new",
                   "#!/bin/sh\ncase \" $* \" in *\" a.c \"*) echo w2new >>wrapped ;; esac\nexec cc \"$@\"\n");
    (void)scratch::sh(&p, "chmod +x bin/w2.new && mv bin/w2.new bin/w2");
    (void)scratch::sh(&p, "env SMITH_CLANG=\"$PWD/bin/w2\" smith build");
    scratch::expect_text("smith routes to an external clang: a clang replaced by another in the same place rebuilds",
                         "w2\nw3\nw2\nw2new", scratch::read(&p, "wrapped"));
}

// The compiler is the clang smith runs, not smith's file: a smith replaced by a copy (a rebuilt smith) compiles the
// same.
export void test_build_a_replaced_smith_with_the_same_clang_rebuilds_nothing(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "external_clang");
    (void)scratch::sh(&p, "mkdir smith-bin && { cp -c \"$SMITH_SELF\" smith-bin/smith-cc 2>/dev/null || cp "
                          "\"$SMITH_SELF\" smith-bin/smith-cc; }");
    scratch::Run upgrade = scratch::sh(&p, "env -u SMITH_CLANG smith build");
    scratch::expect_contains("smith upgrade: the first build compiles the object", upgrade.out, "a.c");
    scratch::expect_status("smith upgrade: with the real compiler", 0, &upgrade);
    scratch::Run second = scratch::build(&p, "");
    scratch::expect_contains("smith upgrade: the second build does nothing", second.out, "no work to do");
    (void)scratch::sh(&p, "cp \"$SMITH_SELF\" smith-bin/smith-cc.new && mv smith-bin/smith-cc.new smith-bin/smith-cc");
    scratch::Run replaced = scratch::build(&p, "");
    scratch::expect_contains("smith upgrade: a replaced smith with the same clang rebuilds nothing", replaced.out,
                             "no work to do");
    scratch::Run external = scratch::sh(&p, "env SMITH_CLANG=\"$PWD/bin/w3\" smith build");
    scratch::expect_contains("smith upgrade: the same smith switched to an external clang rebuilds the object",
                             external.out, "a.c");
    scratch::Run inside = scratch::sh(&p, "env -u SMITH_CLANG smith build");
    scratch::expect_contains("smith upgrade: and back to the clang inside rebuilds it again", inside.out, "a.c");
    scratch::Run settled = scratch::sh(&p, "env -u SMITH_CLANG smith build");
    scratch::expect_contains("smith upgrade: and then settles", settled.out, "no work to do");
}

// What a smith with clang inside says about its clang is its identity: a rebuilt smith reports the same, a rebuilt LLVM
// another. A stand-in smith that prints the two lines shows both.
export void test_build_a_smith_with_another_llvm_rebuilds_the_object(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "compiler_identity");
    (void)scratch::build(&p, "");
    scratch::expect_count("identity: the first build compiles", 1, scratch::lines(&p, "runs"));
    (void)scratch::sh(&p, "cp fake/smith-cc fake/smith-cc.new && mv fake/smith-cc.new fake/smith-cc");
    scratch::Run same = scratch::build(&p, "");
    scratch::expect_contains("identity: a smith rebuilt with the same LLVM rebuilds nothing", same.out,
                             "no work to do");
    scratch::write(&p, "fake/smith-cc.id", "llvm-23.1.3 bbbb\n");
    (void)scratch::build(&p, "");
    scratch::expect_count("identity: a smith linked against another LLVM rebuilds the object", 2,
                          scratch::lines(&p, "runs"));
    scratch::Run settled = scratch::build(&p, "");
    scratch::expect_contains("identity: and then settles", settled.out, "no work to do");
}
