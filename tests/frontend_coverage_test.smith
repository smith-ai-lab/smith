// scripts/frontend_coverage/main.smith (#1730), the tool of `smith build frontend-coverage`: its grouping and summary
// on a small fixed table of five files (one passes, three fail at the check stage, one of them with
// more errors that the first would have hidden (#1922), one fails at the parse stage; the causes rank by the files
// they stop first, #2247). The tool is a
// project of its own in a scratch folder, run by the smith under test; no real file is read or changed.
// The smith the tool is given is a launcher of two lines that starts the smith under test (#3076): outside a build
// folder the tool keys its caches by the bytes of the smith it is given, and built as these tests build it
// (unoptimized, with the sanitizers) it read the 437 MB of smith for 19 s in each of its eleven runs, 178 of the file's
// 195 CPU s. Each test has a scratch folder and so caches of its own; no test is about that key.
// smith-covers: scripts/frontend_coverage/main.smith
module frontend_coverage_test;

import std::arena;
import std::mem;
import std::test;
import scratch;

constexpr const char *table = "a.smith\tpass\t\n"
                              "b.smith\tcheck\texpected 2 arguments, found 3\t2:1\n"
                              "b.smith\tcheck\tunknown name `x`\t3:7\n"
                              "b.smith\tcheck\tunknown name `y`\t4:7\n"
                              "b.smith\tcheck\tunknown name `w`\t5:7\n"
                              "c.smith\tparse\texpected `;`, found `y`\t4:2\n"
                              "d.smith\tcheck\texpected 2 arguments, found 3\t6:1\n"
                              "e.smith\tcheck\tunknown name `z`\t5:5\n";

export void test_frontend_coverage_groups_failures_and_counts_the_passes() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, "scripts/frontend_coverage/main.smith", "main.smith");
    scratch::write(&p, "table.tsv", table);
    scratch::Run run = scratch::sh(&p, "smith run -- summarize table.tsv");
    scratch::expect_status("frontend_coverage: the summary is made", 0, &run);
    scratch::expect_contains("frontend_coverage: a passing file is one line", run.out, "pass  a.smith\n");
    scratch::expect_contains("frontend_coverage: a failure has its place, stage and message", run.out,
                             "FAIL  c.smith:4:2 [parse] expected `;`, found `y`\n");
    scratch::expect_contains("frontend_coverage: a second error of a file is a line of its own", run.out,
                             "FAIL  b.smith:4:7 [check] unknown name `y`\n");
    scratch::expect_contains("frontend_coverage: the files passed out of the total", run.out,
                             "frontend-coverage: 1 of 5 files pass\n");
    scratch::expect_contains("frontend_coverage: the failed files of a stage", run.out, "failed at check  3\n");
    scratch::expect_contains("frontend_coverage: and of another", run.out, "failed at parse  1\n");
    scratch::expect_contains("frontend_coverage: three causes of seven diagnostics", run.out,
                             "failures by cause (3 causes, 7 diagnostics):\n  first  count  files  cause\n");
    scratch::expect_contains(
        "frontend_coverage: the cause that stops most files first ranks above one with more occurrences", run.out,
        "      2      2      2  expected <n> arguments, found <n>\n                e.g. b.smith:2:1\n"
        "                e.g. d.smith:6:1\n"
        "      1      4      2  unknown name `<name>`\n                e.g. b.smith:3:7\n"
        "                e.g. b.smith:4:7\n"
        "                e.g. b.smith:5:7\n"
        "      1      1      1  expected `<name>`, found `<name>`\n                e.g. c.smith:4:2\n");
    scratch::expect_contains("frontend_coverage: one fixed line per cause for the log, in the same order", run.out,
                             "frontend-cause: 1 2 2 2 expected <n> arguments, found <n>\n"
                             "frontend-cause: 1 1 2 4 unknown name `<name>`\n"
                             "frontend-cause: 1 1 1 1 expected `<name>`, found `<name>`\n");
    scratch::expect_contains("frontend_coverage: the errors and the failed files for the CI summary", run.out,
                             "frontend-errors: 7 4\n");
    scratch::expect_contains("frontend_coverage: a file with two causes is a pair, for the log", run.out,
                             "frontend-pair: 1 expected <n> arguments, found <n> | unknown name `<name>`\n");
    scratch::release(run.out);
    scratch::release(run.err);
}

// #2309: `run ... FILES` measures the files named and what they import, and a row it makes is the row of a full run;
// `chain` names the import that blocks a file.
export void test_frontend_coverage_filtered_run_equals_the_full_run_and_names_the_chain() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, "scripts/frontend_coverage/main.smith", "main.smith");
    scratch::Run made = scratch::sh(&p, "mkdir repo");
    scratch::expect_status("frontend_coverage: the repository is made", 0, &made);
    scratch::release(made.out);
    scratch::release(made.err);
    scratch::write(&p, "repo/a.smith", "import b\n\nfn main() -> i32:\n    return b.one()\n");
    scratch::write(&p, "repo/b.smith", "import c\n\npub fn one() -> i32:\n    return c.two() - 1\n");
    scratch::write(&p, "repo/c.smith", "pub fn two() -> i32:\n    return nothing_here\n");
    scratch::write(&p, "repo/d.smith", "pub fn four() -> i32:\n    return 4\n");
    scratch::Run run = scratch::sh(
        &p, "S=$PWD/smith-launcher && printf '#!/bin/sh\\nexec \"%s\" \"$@\"\\n' \"$(command -v smith)\" > $S && "
            "chmod +x $S && git -C repo init -q && git -C repo add -A && "
            "smith run -- run \"$S\" \"$PWD/repo\" \"$PWD/all\" > all.tsv && "
            "smith run -- run \"$S\" \"$PWD/repo\" \"$PWD/some\" a.smith > some.tsv; "
            "for f in a b c; do grep \"^$f.smith\" all.tsv > all_$f.tsv; grep \"^$f.smith\" some.tsv > some_$f.tsv; "
            "cmp all_$f.tsv some_$f.tsv || echo \"DIFFERENT $f\"; done; "
            "grep -c '^d.smith' some.tsv; "
            "smith run -- chain some.tsv \"$PWD/repo\" a.smith");
    scratch::expect_lacks("frontend_coverage: a filtered row is the row of the full run", run.out, "DIFFERENT");
    scratch::expect_contains("frontend_coverage: a file that is not imported is not measured", run.out, "0\na.smith: ");
    scratch::expect_contains("frontend_coverage: the chain names the file that fails, with its first error", run.out,
                             "c.smith: [check] 2:12 unknown name `nothing_here`");
    scratch::expect_contains("frontend_coverage: the files named and what they import are counted", run.out,
                             "2 of 3 files pass (the files named and what they import)");
    scratch::release(run.out);
    scratch::release(run.err);
}

// #2697: the shards of `run ... shard:K/N` own every .smith file once, a shard writes the rows of its own files only
// (the modules it imports are fixed, not reported), and `merge` joins the tables into the rows of a single run, in the
// order of the files; a file in no table is an error.
export void test_frontend_coverage_shards_cover_every_file_once_and_merge_into_the_full_run() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, "scripts/frontend_coverage/main.smith", "main.smith");
    scratch::Run made = scratch::sh(&p, "mkdir repo");
    scratch::release(made.out);
    scratch::release(made.err);
    scratch::write(&p, "repo/a.smith", "import b\n\nfn main() -> i32:\n    return b.one()\n");
    scratch::write(&p, "repo/b.smith", "import c\n\npub fn one() -> i32:\n    return c.two() - 1\n");
    scratch::write(&p, "repo/c.smith", "pub fn two() -> i32:\n    return nothing_here\n");
    scratch::write(&p, "repo/d.smith", "pub fn four() -> i32:\n    return 4\n");
    scratch::Run run = scratch::sh(
        &p, "S=$PWD/smith-launcher && printf '#!/bin/sh\\nexec \"%s\" \"$@\"\\n' \"$(command -v smith)\" > $S && "
            "chmod +x $S && git -C repo init -q && git -C repo add -A && "
            "smith run -- run \"$S\" \"$PWD/repo\" \"$PWD/all\" > all.tsv && "
            "for k in 1 2 3; do smith run -- run \"$S\" \"$PWD/repo\" \"$PWD/s$k\" shard:$k/3 > s$k.tsv; done; "
            "cat s1.tsv s2.tsv s3.tsv | cut -f1 | uniq | sort | uniq -c | awk '$1 != 1' | wc -l; "
            "cat s1.tsv s2.tsv s3.tsv | cut -f1 | sort -u | wc -l; "
            "smith run -- merge \"$PWD/repo\" \"$PWD/s3.tsv,$PWD/s1.tsv,$PWD/s2.tsv\" > merged.tsv; "
            "grep -v '^\\[' all.tsv > all_rows.tsv; grep -v '^\\[' merged.tsv > merged_rows.tsv; "
            "cmp all_rows.tsv merged_rows.tsv && echo SAME; "
            "smith run -- merge \"$PWD/repo\" \"$PWD/s1.tsv\" 2>&1 >/dev/null | grep -c 'is in no shard'");
    scratch::expect_contains("frontend_coverage: no file is in two shards, and the shards have all four", run.out,
                             "0\n4\nSAME\n");
    scratch::expect_contains("frontend_coverage: a file in no table is an error", run.out, "\n1\n");
    scratch::release(run.out);
    scratch::release(run.err);
}

// #2924: a fix the checker finds in an instance of a generic belongs to the module that holds it, keyed by the text the
// importer's fixer read (#2669). That text was read from the scratch tree, where the module's own fixer may already
// have rewritten it or not, so the same files passed or failed with the order and timing of the fixers (one fixer at a
// time fixed `main` before `same` and `conv` before `main`). A file is fixed once its imports are. The files sit in
// the `src` folder of a case, as in the tree: beside the root, `import conv` finds them through the pristine link.
export void test_frontend_coverage_a_generics_fix_does_not_depend_on_the_order_of_the_fixers() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, "scripts/frontend_coverage/main.smith", "main.smith");
    scratch::Run made = scratch::sh(&p, "mkdir -p repo/local/src repo/derived/src");
    scratch::release(made.out);
    scratch::release(made.err);
    scratch::copy_tree(&p, "tests/smith-lang/cases/generic-slice-local/src/conv.smith", "repo/local/src/conv.smith");
    scratch::copy_tree(&p, "tests/smith-lang/cases/generic-slice-local/src/main.smith", "repo/local/src/main.smith");
    scratch::copy_tree(&p, "tests/smith-lang/cases/generic-slice-derived/src/same.smith",
                       "repo/derived/src/same.smith");
    scratch::copy_tree(&p, "tests/smith-lang/cases/generic-slice-derived/src/main.smith",
                       "repo/derived/src/main.smith");
    scratch::Run run = scratch::sh(
        &p, "S=$PWD/smith-launcher && printf '#!/bin/sh\\nexec \"%s\" \"$@\"\\n' \"$(command -v smith)\" > $S && "
            "chmod +x $S && git -C repo init -q && git -C repo add -A && "
            "for j in 1 2 4; do SMITH_COVERAGE_JOBS=$j smith run -- run \"$S\" \"$PWD/repo\" \"$PWD/j$j\" > j$j.tsv; "
            "echo \"jobs $j: $(grep -c 'main.smith.pass' j$j.tsv) of 2, $(grep -c 'main.smith.check' j$j.tsv) "
            "failed\"; done");
    scratch::expect_contains("frontend_coverage: one fixer at a time fixes both generics", run.out,
                             "jobs 1: 2 of 2, 0 failed\n");
    scratch::expect_contains("frontend_coverage: two at once", run.out, "jobs 2: 2 of 2, 0 failed\n");
    scratch::expect_contains("frontend_coverage: and four", run.out, "jobs 4: 2 of 2, 0 failed\n");
    scratch::release(run.out);
    scratch::release(run.err);
}

// #3214: a file of lib/std/ that says `import scratch` finds tests/scratch.smith, as the files beside it do. The link
// is in the scratch tree only: the repository's own lib/ is not touched.
export void test_frontend_coverage_a_file_of_lib_std_finds_the_scratch_module() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, "scripts/frontend_coverage/main.smith", "main.smith");
    scratch::Run made = scratch::sh(&p, "mkdir -p repo/tests repo/lib/std");
    scratch::release(made.out);
    scratch::release(made.err);
    scratch::write(&p, "repo/tests/scratch.smith", "pub fn made() -> i32:\n    return 1\n");
    scratch::write(&p, "repo/lib/std/x_test.smith",
                   "import scratch\n\npub fn one() -> i32:\n    return scratch.made()\n");
    scratch::Run run = scratch::sh(
        &p, "S=$PWD/smith-launcher && printf '#!/bin/sh\\nexec \"%s\" \"$@\"\\n' \"$(command -v smith)\" > $S && "
            "chmod +x $S && git -C repo init -q && git -C repo add -A && "
            "smith run -- run \"$S\" \"$PWD/repo\" \"$PWD/all\" > all.tsv; "
            "grep -c 'x_test.smith.pass' all.tsv; grep -c 'cannot find the module' all.tsv; "
            "test ! -e repo/lib/scratch.smith && echo REPO_UNCHANGED");
    scratch::expect_contains("frontend_coverage: the file compiles the import, the repository is as it was", run.out,
                             "1\n0\nREPO_UNCHANGED\n");
    scratch::release(run.out);
    scratch::release(run.err);
}

// #3037: the files of the excluded list leave the denominator, and the list cannot hide progress or rot.
export void test_frontend_coverage_excluded_files_leave_the_total() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, "scripts/frontend_coverage/main.smith", "main.smith");
    scratch::write(&p, "table.tsv", table);
    scratch::write(&p, "excluded.txt", "# a comment\n\nc.smith\told-form: #pragma\nd.smith\terror-fixture\n");
    scratch::Run run = scratch::sh(&p, "env SMITH_COVERAGE_EXCLUDED=excluded.txt smith run -- summarize table.tsv");
    scratch::expect_status("frontend_coverage: the summary is made", 0, &run);
    scratch::expect_contains("frontend_coverage: the total leaves out the listed files, the numerator is the same",
                             run.out, "frontend-coverage: 1 of 3 files pass\n");
    scratch::expect_contains("frontend_coverage: the count of listed files, to rebuild the old total", run.out,
                             "frontend-excluded: 2\n");
    scratch::expect_contains("frontend_coverage: a listed file is one line with its reason", run.out,
                             "excluded  c.smith [old-form: #pragma]\n");
    scratch::expect_lacks("frontend_coverage: a listed file is not a failure", run.out, "FAIL  c.smith");
    scratch::expect_contains("frontend_coverage: its cause is not counted", run.out, "frontend-errors: 5 2\n");
    scratch::expect_lacks("frontend_coverage: a listed file has no frontend-fail line", run.out,
                          "frontend-fail: c.smith");
    scratch::expect_contains("frontend_coverage: a file with two causes is one line with both (#3271)", run.out,
                             "frontend-fail: b.smith check 4 expected <n> arguments, found <n>; unknown name `<name>`\n"
                             "frontend-fail: e.smith check 1 unknown name `<name>`\n");
    scratch::expect_lacks("frontend_coverage: a passing file has no frontend-fail line", run.out,
                          "frontend-fail: a.smith");
    scratch::release(run.out);
    scratch::release(run.err);
}

// #3037: a listed fixture that compiles is a failure that stays in the total (#3207); a listed fixture whose compile
// crashed and a bad line are errors of the job.
export void test_frontend_coverage_excluded_list_errors_fail_the_job() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, "scripts/frontend_coverage/main.smith", "main.smith");
    scratch::write(&p, "table.tsv", table);
    scratch::write(&p, "crash.tsv", "x.smith\tcheck\tcompile ended with status 139 (signal)\t\n");
    scratch::write(&p, "passes.txt", "a.smith\terror-fixture\n");
    scratch::write(&p, "crash.txt", "x.smith\terror-fixture\n");
    scratch::write(&p, "old.txt", "a.smith\told-form: #pragma\n");
    scratch::write(&p, "bad.txt", "b.smith\tbecause\n");
    scratch::write(&p, "twice.txt", "b.smith\terror-fixture\nb.smith\terror-fixture\n");
    scratch::Run passes = scratch::sh(&p, "env SMITH_COVERAGE_EXCLUDED=passes.txt smith run -- summarize table.tsv");
    scratch::expect_status("frontend_coverage: a listed fixture that compiles does not stop the count", 0, &passes);
    scratch::expect_contains("frontend_coverage: one line names it", passes.out,
                             "frontend-excluded-compiles: a.smith\n");
    scratch::expect_contains("frontend_coverage: it is a failure, not a pass", passes.out, "FAIL  a.smith");
    scratch::expect_lacks("frontend_coverage: never a pass", passes.out, "pass  a.smith");
    scratch::Run crash = scratch::sh(&p, "env SMITH_COVERAGE_EXCLUDED=crash.txt smith run -- summarize crash.tsv");
    scratch::expect_failure("frontend_coverage: an error fixture that crashed fails the job", &crash);
    scratch::expect_contains("frontend_coverage: and says it had no diagnostic", crash.err,
                             "ended without a diagnostic");
    scratch::Run old = scratch::sh(&p, "env SMITH_COVERAGE_EXCLUDED=old.txt smith run -- summarize table.tsv");
    scratch::expect_status("frontend_coverage: an old form that compiles is a warning, not a failure", 0, &old);
    scratch::expect_contains("frontend_coverage: the warning names the line to delete", old.err,
                             "a.smith compiles but is on the excluded list (old-form: #pragma): delete its line");
    scratch::expect_contains("frontend_coverage: and the file stays in the total as a pass", old.out, "pass  a.smith");
    scratch::Run bad = scratch::sh(&p, "env SMITH_COVERAGE_EXCLUDED=bad.txt smith run -- summarize table.tsv");
    scratch::expect_failure("frontend_coverage: a reason outside the fixed set fails the job", &bad);
    scratch::Run twice = scratch::sh(&p, "env SMITH_COVERAGE_EXCLUDED=twice.txt smith run -- summarize table.tsv");
    scratch::expect_failure("frontend_coverage: a path listed twice fails the job", &twice);
    scratch::release(passes.out);
    scratch::release(passes.err);
    scratch::release(crash.out);
    scratch::release(crash.err);
    scratch::release(old.out);
    scratch::release(old.err);
    scratch::release(bad.out);
    scratch::release(bad.err);
    scratch::release(twice.out);
    scratch::release(twice.err);
}

// #3037: `import game.util` in `game/main.smith` is the file `game/util.smith` of the folder above, so a row of main
// has util in its closure: its key covers util, and a run that names main alone measures util too (a row made without
// it once failed and was reused when util was named).
export void test_frontend_coverage_import_resolves_from_the_folder_above_the_file() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, "scripts/frontend_coverage/main.smith", "main.smith");
    scratch::Run made = scratch::sh(&p, "mkdir -p repo/game");
    scratch::release(made.out);
    scratch::release(made.err);
    scratch::write(&p, "repo/game/main.smith", "import game.util\n\nfn main() -> i32:\n    return util.one() - 1\n");
    scratch::write(&p, "repo/game/util.smith", "pub fn one() -> i32:\n    return 1\n");
    scratch::Run run =
        scratch::sh(&p, "S=$(command -v smith) && git -C repo init -q && git -C repo add -A && "
                        "smith run -- run \"$S\" \"$PWD/repo\" \"$PWD/some\" game/main.smith > some.tsv; "
                        "smith run -- chain some.tsv \"$PWD/repo\" game/main.smith");
    scratch::expect_contains("frontend_coverage: the file main imports is in its closure", run.out,
                             " of 2 files pass (the files named and what they import)");
    scratch::release(run.out);
    scratch::release(run.err);
}
