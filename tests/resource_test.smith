// End-to-end tests for the files a smith with clang inside carries and writes on first use (tests/resource.sh): clang's
// builtin headers, the compiler-rt runtimes, libLTO.dylib (macOS), and the bin/clang the driver runs again for -cc1.
// Every test uses a data folder of its own (XDG_DATA_HOME, in the test's scratch folder, with a cache of its own where
// the test removes or cleans it), so the real ones are never read or changed. A smith without clang inside (the stage0)
// has none of this, and the tests do nothing. The shell helpers below branch on `uname` where macOS and Linux differ
// (the header and runtime names, the ld's mark, the way a copy gets another identity); a check with no meaning on Linux
// (frameworks, ARC, libLTO) runs on macOS only, with a comment where it is. Each test makes its project with
// scratch::make and has a test::memory arena as the current allocator, so what scratch returns goes back with the
// arena.
module resource_test;

import smith::arena;
import smith::format;
import smith::mem;
import smith::test;
import scratch;
import target;

// Every command: the data folder, the smith under test, and the shell functions the checks use. A program of the
// programs folder is a clone of the smith that made it: the same bytes in a file of its own, never a hard link (macOS's
// policy daemon kills a process when another name of its file is removed; issue #48). `variant` is a copy of smith with
// another LC_UUID (on Linux another build-id), as a rebuild has. On Linux a program may also be a hard
// link, the fallback where the file system cannot clone: no policy daemon names a file there.
constexpr char prelude[_] =
    "export XDG_DATA_HOME=\"$(cd .. && pwd)/data\"\n"
    "smith=$SMITH_SELF\n"
    "os=$(uname)\n"
    "triple=$(uname -m)-unknown-linux-gnu\n"
    "case $(uname -m) in x86_64) arch_header=immintrin.h;; *) arch_header=arm_neon.h;; esac\n"
    "if [ \"$os\" = Darwin ]; then seven=\"objc2.m -framework Foundation\"; else seven=seven.c; fi\n"
    "if [ \"$os\" = Darwin ]; then\n"
    "    sanitize=-fsanitize=address,undefined; shared_libsan=; runtimes=lib/darwin\n"
    "    asan_runtime=libclang_rt.asan_osx_dynamic.dylib\n"
    "else\n"
    "    shared_libsan='-shared-libsan -frtlib-add-rpath'; sanitize=\"-fsanitize=address,undefined $shared_libsan\"\n"
    "    runtimes=lib/$triple; asan_runtime=libclang_rt.asan.so\n"
    "fi\n"
    "rpath_of() {\n"
    "    if [ \"$os\" = Darwin ]; then otool -l \"$1\" | sed -n 's/^ *path \\(.*clang.*\\) (offset.*/\\1/p'\n"
    "    else readelf -d \"$1\" | sed -n 's/.*runpath: \\[\\(.*clang.*\\)\\]/\\1/p'; fi\n"
    "}\n"
    "clang_folders=$XDG_DATA_HOME/smith/clang\n"
    "program_folders=$XDG_DATA_HOME/smith/programs\n"
    "is_copy() { cmp -s \"$1\" \"$2\" && { [ \"$os\" != Darwin ] || [ ! \"$1\" -ef \"$2\" ]; }; }\n"
    "ago_hours() { if [ \"$os\" = Darwin ]; then date -v-\"$1\"H +%Y%m%d%H%M; else date -d \"$1 hours ago\" "
    "+%Y%m%d%H%M; fi; }\n"
    "ago_minutes() { if [ \"$os\" = Darwin ]; then date -v-\"$1\"M +%Y%m%d%H%M; else date -d \"$1 minutes ago\" "
    "+%Y%m%d%H%M; fi; }\n"
    "lld_mark() { if [ \"$os\" = Darwin ]; then otool -l \"$1\" | sed -n '/LC_BUILD_VERSION/,/version/p' | sed -n 's/^ "
    "*tool \\(.*\\)/\\1/p'; else readelf -p .comment \"$1\" | grep -c 'Linker: LLD'; fi; }\n"
    "yn() { [ -e \"$1\" ] && echo yes || echo no; }\n"
    "variant() { cp \"$smith\" \"../$1\"; if [ \"$os\" = Darwin ]; then perl -0777 -pi -e "
    "'s/(\\x1b\\0\\0\\0\\x18\\0\\0\\0)(.{16})/$1 . (\"\\x'\"$2\"'\" x 16)/se' \"../$1\"; "
    "codesign -f -s - \"../$1\" >/dev/null 2>&1; else perl -0777 -pi -e "
    "'s/(\\x04\\0\\0\\0\\x10\\0\\0\\0\\x03\\0\\0\\0GNU\\0)(.{16})/$1 . (\"\\x'\"$2\"'\" x 16)/se' \"../$1\"; fi; }\n"
    "folder_of() { for f in \"$program_folders\"/*; do is_copy \"$f/bin/ld\" \"$1\" && echo \"$f\"; done; }\n";

// Where the files are, once a compile has written them.
constexpr char where[_] = "out=$(\"$smith\" cc -print-resource-dir)\n"
                          "major=${out##*/}\n"
                          "folder=${out%/lib/clang/*}\n"
                          "programs=$(\"$smith\" cc --smith-which -c hello.c | head -n 1 | cut -d ' ' -f 3)\n"
                          "programs=${programs%/bin/clang}\n";

// Eight workers of two smiths, five rounds each, on the one runtime folder: the number of failures.
constexpr char workers[_] = "for n in 1 2 3 4 5 6 7 8; do\n"
                            "    (for round in 1 2 3 4 5; do\n"
                            "        \"$smith\" cc $seven -o \"objc_a$n\" 2>>\"../mix$n\" && [ "
                            "\"$(./objc_a$n)\" = 7 ] || echo bad >>\"../mix$n.bad\"\n"
                            "        \"../smith_b\" cc $seven -o \"objc_c$n\" 2>>\"../mix$n\" && "
                            "[ \"$(./objc_c$n)\" = 7 ] || echo bad >>\"../mix$n.bad\"\n"
                            "    done) &\n"
                            "done\n"
                            "wait\n"
                            "cat ../mix*.bad 2>/dev/null | wc -l | tr -d ' '\n";

// A programs folder whose smith is running, or whose binary exists, stays: what each folder does after a prune.
constexpr char lock_script[_] =
    "two_hours_ago=$(ago_hours 2)\n"
    "variant smith_d 11\n"
    "variant smith_e 22\n"
    "../smith_d cc -fsyntax-only hello.c\n"
    "../smith_e cc -fsyntax-only hello.c\n"
    "folder_d=$(folder_of ../smith_d)\n"
    "folder_e=$(folder_of ../smith_e)\n"
    "(sleep 20 | ../smith_d lsp >/dev/null 2>&1) </dev/null >/dev/null 2>&1 &\n"
    "holder=$!\n"
    "tries=0\n"
    "while [ $tries -lt 100 ] && ! [ -f \"$folder_d/.in-use\" ]; do sleep 0.1; tries=$((tries + 1)); done\n"
    "sleep 1\n"
    "rm ../smith_d\n"
    "touch -t \"$two_hours_ago\" \"$folder_d\" \"$folder_e\"\n"
    "variant smith_f 33\n"
    "../smith_f cc -fsyntax-only hello.c\n"
    "echo \"running=$(yn \"$folder_d\")\"\n"
    "echo \"binary_exists=$(yn \"$folder_e\")\"\n"
    "kill $holder 2>/dev/null\n"
    "wait $holder 2>/dev/null\n"
    "for p in $(lsof -t \"$folder_d/.in-use\" 2>/dev/null); do kill \"$p\" 2>/dev/null; done\n"
    "for _ in $(seq 1 300); do\n"
    "    [ -z \"$(lsof -t \"$folder_d/.in-use\" 2>/dev/null)\" ] && break\n"
    "    sleep 0.1\n"
    "done\n"
    "touch -t \"$two_hours_ago\" \"$folder_d\"\n"
    "variant smith_g 44\n"
    "../smith_g cc -fsyntax-only hello.c\n"
    "echo \"died=$(yn \"$folder_d\")\"\n"
    "echo \"binary_exists_still=$(yn \"$folder_e\")\"\n";

// False when this smith has no clang inside (the stage0), whose tests do nothing.
static bool begin(arena::Arena *arena, const scratch::Project *p) {
    const char *which = scratch::capture(
        p, format::push(arena, prelude, "smith cc --smith-which -c a.c | head -n 1 | cut -d ' ' -f 1,2").data);
    return scratch::same(which, "clang in-process");
}

static scratch::Run run(arena::Arena *arena, const scratch::Project *p, const char *commands) {
    return scratch::sh(p, format::push(arena, prelude, commands).data);
}

static scratch::Run run_after(arena::Arena *arena, const scratch::Project *p, const char *commands) {
    return scratch::sh(p, format::push(arena, prelude, where, commands).data);
}

static const char *text(arena::Arena *arena, const scratch::Project *p, const char *commands) {
    return scratch::capture(p, format::push(arena, prelude, commands).data);
}

static const char *text_after(arena::Arena *arena, const scratch::Project *p, const char *commands) {
    return scratch::capture(p, format::push(arena, prelude, where, commands).data);
}

// The first compile, which writes the folders.
static void first_compile(arena::Arena *arena, const scratch::Project *p) {
    scratch::Run compiled = run(arena, p, "\"$smith\" cc -fsyntax-only hello.c");
    scratch::expect_status("resource: a first compile", 0, &compiled);
}

// A compile of `source` and the run of its program: "<status> <output>", and what the compiler printed.
static const char *built(arena::Arena *arena, const scratch::Project *p, const char *compile, const char *program) {
    return text_after(arena, p, format::push(arena, compile, " 2>../err; echo \"$? $(", program, ")\"").data);
}

static const char *printed(arena::Arena *arena, const scratch::Project *p) {
    return text(arena, p, "cat ../err");
}

export void test_resource_which_names_a_programs_folder_and_writes_nothing() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    scratch::expect_text("resource: which names a bin/clang in a folder of the programs folder",
                         text(&memory, &p, "echo \"$program_folders/\""),
                         text(&memory, &p,
                              "p=$(\"$smith\" cc --smith-which -c hello.c | head -n 1 | cut -d ' ' -f 3); "
                              "p=${p%/bin/clang}; echo \"${p%/*}/\""));
    scratch::expect_text("resource: which writes nothing", "no", text(&memory, &p, "yn \"$XDG_DATA_HOME\""));
}

export void test_resource_the_first_compile_writes_the_folders() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    scratch::Run compiled = run(&memory, &p, "\"$smith\" cc -fsyntax-only hello.c");
    scratch::expect_status("resource: the first compile works", 0, &compiled);
    scratch::expect_text("resource: the resource directory is in a folder of the runtime folders",
                         text(&memory, &p, "echo \"$clang_folders/\""),
                         text_after(&memory, &p, "echo \"${folder%/*}/\""));
    scratch::expect_text("resource: and the first compile writes the folder", "yes",
                         text_after(&memory, &p, "yn \"$folder\""));
    scratch::expect_text("resource: and the programs folder", "yes", text_after(&memory, &p, "yn \"$programs\""));
    scratch::expect_text("resource: the runtime folder holds no program", "no",
                         text_after(&memory, &p, "yn \"$folder/bin\""));
    scratch::expect_text("resource: the programs folder's lib is the runtime folder's",
                         text_after(&memory, &p, "echo \"$folder/lib\""),
                         text_after(&memory, &p, "readlink \"$programs/lib\""));
    scratch::expect_text("resource: iOS's runtimes are not carried", "no",
                         text_after(&memory, &p, "yn \"$folder/lib/clang/$major/lib/darwin/libclang_rt.ios.a\""));
    scratch::expect_text("resource: no half-written folder is left", "",
                         text(&memory, &p, "{ ls \"$clang_folders\"; ls \"$program_folders\"; } | grep tmp"));
}

static void holds(arena::Arena *arena, const scratch::Project *p, const char *file) {
    char name[256];
    char command[256];
    (void)format::to(name, sizeof name, "resource: the folder holds ", file);
    (void)format::to(command, sizeof command, "yn \"$folder/lib/clang/$major/", file, "\"");
    scratch::expect_text(name, "yes", text_after(arena, p, command));
}

export void test_resource_the_runtime_folder_holds_the_files() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    // lib/clang/<major>/ is under the folder; libLTO is beside it
    holds(&memory, &p, "include/stddef.h");
    holds(&memory, &p, "share/asan_ignorelist.txt");
    if constexpr (target::os == target::macos) {
        holds(&memory, &p, "include/arm_neon.h");
        holds(&memory, &p, "lib/darwin/libclang_rt.asan_osx_dynamic.dylib");
        holds(&memory, &p, "lib/darwin/libclang_rt.ubsan_osx_dynamic.dylib");
        holds(&memory, &p, "lib/darwin/libclang_rt.osx.a");
        holds(&memory, &p, "lib/darwin/libclang_rt.profile_osx.a");
        scratch::expect_text("resource: the folder holds lib/libLTO.dylib", "yes",
                             text_after(&memory, &p, "yn \"$folder/lib/libLTO.dylib\""));
    } else {
        // the target's own header (immintrin.h, or arm_neon.h on arm64) and the runtimes of its triple; no libLTO
        holds(&memory, &p, "include/$arch_header");
        holds(&memory, &p, "lib/$triple/libclang_rt.asan.so");
        holds(&memory, &p, "lib/$triple/libclang_rt.ubsan_standalone.so");
        holds(&memory, &p, "lib/$triple/libclang_rt.builtins.a");
        holds(&memory, &p, "lib/$triple/libclang_rt.profile.a");
    }
}

static void is_a_copy(arena::Arena *arena, const scratch::Project *p, const char *program) {
    char name[256];
    char command[256];
    (void)format::to(name, sizeof name, "resource: bin/", program,
                     " is a copy of the smith that ran, with a file of its own");
    (void)format::to(command, sizeof command, "is_copy \"$programs/bin/", program,
                     "\" \"$smith\" && echo yes || echo no");
    scratch::expect_text(name, "yes", text_after(arena, p, command));
}

export void test_resource_the_programs_are_copies_of_the_smith() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    is_a_copy(&memory, &p, "clang");
    is_a_copy(&memory, &p, "clang++");
    is_a_copy(&memory, &p, "ld");
}

export void test_resource_the_builtin_headers_come_from_the_folder() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    scratch::expect_contains("resource: the builtin headers come from the folder",
                             text_after(&memory, &p, "\"$smith\" cc -M hello.c"),
                             text_after(&memory, &p, "echo \"$folder/lib/clang/$major/include/stddef.h\""));
    scratch::expect_text("resource: nothing names an LLVM install", "",
                         text(&memory, &p, "\"$smith\" cc -### -c hello.c 2>&1 | grep -F 'smith/llvm' | head -n 1"));
}

// A second compile reads the folder and writes nothing.
export void test_resource_a_second_compile_rewrites_no_file() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    // libLTO.dylib is the system ld's on macOS; Linux has none
    constexpr char files[_] = "ls -l \"$folder/lib/clang/$major/include/stddef.h\" $([ \"$os\" = Darwin ] && echo "
                              "\"$folder/lib/libLTO.dylib\")";
    scratch::Run stamped = run_after(&memory, &p, format::push(&memory, files, " >../stamp").data);
    scratch::expect_status("resource: the stamps", 0, &stamped);
    scratch::sleep(&p, 1000);
    scratch::Run second = run(&memory, &p, "\"$smith\" cc -fsyntax-only hello.c");
    scratch::expect_status("resource: a second compile works", 0, &second);
    scratch::expect_text("resource: and rewrites no file", text(&memory, &p, "cat ../stamp"),
                         text_after(&memory, &p, files));
}

// smith lint and smith lsp read the same folder for the builtin headers, not the LLVM install.
export void test_resource_lint_and_lsp_read_clangs_folder() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    scratch::Run linted =
        run(&memory, &p,
            "\"$smith\" lint --quiet --checks='-*,bugprone-sizeof-expression' --extra-arg=-v hello.c -- >../lint 2>&1");
    scratch::expect_status("resource: smith lint parses a file that includes a builtin header", 0, &linted);
    scratch::expect_contains("resource: and its builtin headers come from clang's folder",
                             text(&memory, &p, "cat ../lint"),
                             text(&memory, &p, "echo \"$XDG_DATA_HOME/smith/programs/\""));
    scratch::expect_text("resource: and no LLVM install is named", "",
                         text(&memory, &p, "grep -F 'smith/llvm' ../lint | head -n 1"));
    scratch::Run set_up = run(&memory, &p,
                              "printf '[{\"directory\": \"%s\", \"file\": \"hello.c\", \"arguments\": [\"smith-cc\", "
                              "\"-c\", \"hello.c\"]}]\\n' "
                              "\"$PWD\" >compile_commands.json; printf 'Checks: \"-*\"\\n' >.clang-tidy");
    scratch::expect_status("resource: the compile database", 0, &set_up);
    scratch::Run checked = run(&memory, &p, "\"$smith\" lsp --check=hello.c >../lsp 2>&1");
    scratch::expect_status("resource: smith lsp --check works", 0, &checked);
    scratch::expect_text("resource: and logs no error", "0", text(&memory, &p, "grep -c 'E\\[' ../lsp"));
    scratch::expect_contains(
        "resource: and its resource directory is in this smith's programs folder, which links clang's",
        text(&memory, &p, "cat ../lsp"), text(&memory, &p, "echo \"-resource-dir=$XDG_DATA_HOME/smith/programs/\""));
    scratch::expect_contains("resource: and it is lib/clang/<major>", text(&memory, &p, "cat ../lsp"),
                             text_after(&memory, &p, "echo \"/lib/clang/$major\""));
}

// -flto links with lld, which has LLVM inside it and so needs no libLTO.dylib; the driver still names the one in the
// folder for a linker that does, and SMITH_LINKER=/usr/bin/ld loads it.
export void test_resource_an_flto_link_needs_no_lib_lto() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    scratch::expect_text("resource: an -flto link works", "0 hi",
                         built(&memory, &p, "\"$smith\" cc -flto hello.c -o lto", "./lto"));
    scratch::expect_text("resource: and the linker prints nothing about libLTO", "", printed(&memory, &p));
    // The system ld loads libLTO.dylib for -flto; Linux's ld needs LLVM's gold plugin instead, which smith does not
    // carry, so there is no such link to check there.
    if constexpr (target::os == target::macos) {
        scratch::expect_text(
            "resource: an -flto link with the system ld works", "0 hi",
            built(&memory, &p, "SMITH_LINKER=/usr/bin/ld \"$smith\" cc -flto hello.c -o lto_ld", "./lto_ld"));
        scratch::expect_text("resource: and it prints nothing", "", printed(&memory, &p));
    }
}

// The program the driver runs as `ld` is smith, and the link is lld's, in that process. An lld binary says so in its
// LC_BUILD_VERSION: tool 4 (ld64's LD is 3), with LLVM's version; on Linux in its .comment, "Linker: LLD" (lld_mark
// prints the tool, or the count of those lines).
export void test_resource_the_link_is_lld_in_smiths_process() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    scratch::expect_text("resource: a link works", "0 hi",
                         built(&memory, &p, "\"$smith\" cc hello.c -o linked", "./linked"));
    if constexpr (target::os == target::macos) {
        scratch::expect_text("resource: and is lld's", "4", text(&memory, &p, "lld_mark linked"));
        scratch::expect_text("resource: and is signed, with no codesign step", "0",
                             text(&memory, &p, "codesign --verify linked >/dev/null 2>&1; echo $?"));
        scratch::expect_text("resource: and is signed ad hoc by the linker", "1",
                             text(&memory, &p, "codesign -dv linked 2>&1 | grep -c 'linker-signed'"));
    } else {
        scratch::expect_text("resource: and is lld's", "1",
                             text(&memory, &p, "lld_mark linked")); // no signing on Linux
    }
    const char *linked_by_ld = "0 hi 0"; // the count of lld's marks; macOS prints ld64's tool, 3
    if constexpr (target::os == target::macos) {
        linked_by_ld = "0 hi 3";
    }
    scratch::expect_text("resource: SMITH_LINKER=/usr/bin/ld links with ld", linked_by_ld,
                         text_after(&memory, &p,
                                    "SMITH_LINKER=/usr/bin/ld \"$smith\" cc hello.c -o linked_ld 2>../err; "
                                    "echo \"$? $(./linked_ld) $(lld_mark linked_ld)\""));
}

export void test_resource_a_missing_linker_and_an_undefined_symbol_fail() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    scratch::Run none = run(&memory, &p, "SMITH_LINKER=/nonexistent/ld \"$smith\" cc hello.c -o linked_none");
    scratch::expect_status("resource: a SMITH_LINKER that is not there is an error", 1, &none);
    scratch::expect_contains("resource: and says what it is", none.err, "SMITH_LINKER");
    scratch::Run undefined = run(&memory, &p, "\"$smith\" cc undefined.c -o undefined");
    scratch::expect_status("resource: an undefined symbol fails", 1, &undefined);
    scratch::expect_contains("resource: with lld's message", undefined.err, "undefined symbol: missing");
    scratch::expect_text("resource: and leaves no output", "no", text(&memory, &p, "yn undefined"));
}

// What ld links today, lld links: frameworks, a dynamic library, -dead_strip, an Objective-C selector stub, a dSYM.
export void test_macos_resource_lld_links_frameworks_arc_and_dead_strip() {
    // Frameworks, ARC (Objective-C), -dead_strip and a dSYM are Mach-O and Apple's: Linux has no such feature to check.
    if constexpr (target::os != target::macos) {
        return;
    }
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    scratch::expect_text(
        "resource: a program with frameworks, ARC and -dead_strip", "0 7",
        built(&memory, &p,
              "\"$smith\" cc -fobjc-arc -g objc.m -framework Foundation -framework AppKit -framework Metal "
              "-Wl,-dead_strip -o objc",
              "./objc 2>/dev/null"));
    scratch::expect_text("resource: and its dSYM has the debug info", "yes",
                         text(&memory, &p, "[ -f objc.dSYM/Contents/Resources/DWARF/objc ] && echo yes || echo no"));
}

export void test_resource_lld_links_a_dynamic_library_and_a_program_against_it() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    // A shared library is a .dylib on macOS (-dynamiclib, @loader_path) and a .so on Linux (-shared -fPIC, $ORIGIN).
    if constexpr (target::os == target::macos) {
        scratch::Run linked = run(&memory, &p, "\"$smith\" cc -dynamiclib hello.c -o libhello.dylib");
        scratch::expect_status("resource: a dynamic library links", 0, &linked);
        scratch::Run library = run(&memory, &p, "\"$smith\" cc -dynamiclib lib.c -o liblib.dylib");
        scratch::expect_status("resource: the library to link against", 0, &library);
        scratch::expect_text(
            "resource: and a program links against it", "0 lib",
            built(&memory, &p, "\"$smith\" cc uselib.c -L. -llib -Wl,-rpath,@loader_path -o uselib", "./uselib"));
    } else {
        scratch::Run linked = run(&memory, &p, "\"$smith\" cc -shared -fPIC hello.c -o libhello.so");
        scratch::expect_status("resource: a dynamic library links", 0, &linked);
        scratch::Run library = run(&memory, &p, "\"$smith\" cc -shared -fPIC lib.c -o liblib.so");
        scratch::expect_status("resource: the library to link against", 0, &library);
        scratch::expect_text(
            "resource: and a program links against it", "0 lib",
            built(&memory, &p, "\"$smith\" cc uselib.c -L. -llib '-Wl,-rpath,$ORIGIN' -o uselib", "./uselib"));
    }
}

// Compiling and linking in one command runs the driver again with -cc1: bin/clang is smith. A copy of smith is the same
// smith (the same LC_UUID), so it uses the same programs, and the links outlive the smith they were made from.
export void test_resource_a_copy_of_smith_uses_the_same_programs() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    scratch::expect_text("resource: a compile and a link with a copy of smith", "0 hi",
                         built(&memory, &p, "cp \"$smith\" ../smith2; ../smith2 cc hello.c -o prog", "./prog"));
    scratch::expect_text("resource: a copy of smith makes no programs of its own", "1",
                         text(&memory, &p, "ls \"$program_folders\" | wc -l | tr -d ' '"));
    scratch::Run removed = run(&memory, &p, "rm ../smith2");
    scratch::expect_status("resource: the copy is removed", 0, &removed);
    scratch::expect_text("resource: after the copy is removed, a compile and a link still work", "0 hi",
                         built(&memory, &p, "\"$smith\" cc hello.c -o prog", "./prog"));
}

// Two different smiths (another LC_UUID, as a rebuild has) never share or remake each other's programs, and keep
// working at once on the one runtime folder: each compiles and links an Objective-C program, many times, together.
export void test_resource_two_smiths_keep_their_own_programs() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    scratch::Run made = run(&memory, &p, "variant smith_b ab");
    scratch::expect_status("resource: a second smith is made", 0, &made);
    scratch::expect_text("resource: a second smith (another LC_UUID) works", "0 7",
                         built(&memory, &p, "../smith_b cc $seven -o objc_b", "./objc_b"));
    scratch::expect_text("resource: and has programs folder of its own", "2",
                         text(&memory, &p, "ls \"$program_folders\" | wc -l | tr -d ' '"));
    scratch::expect_text(
        "resource: that hold its own copies", "yes",
        text(&memory, &p,
             "for f in \"$program_folders\"/*; do is_copy \"$f/bin/ld\" ../smith_b && echo yes; done | head -n 1"));
    scratch::expect_text("resource: and the first smith's copies are still the first", "yes",
                         text_after(&memory, &p, "is_copy \"$programs/bin/ld\" \"$smith\" && echo yes || echo no"));
}

export void test_resource_eight_workers_of_two_smiths_all_link_and_run() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    scratch::Run made = run(&memory, &p, "variant smith_b ab");
    scratch::expect_status("resource: a second smith is made", 0, &made);
    scratch::expect_text("resource: eight workers of two smiths, five rounds each, all link and run", "0",
                         text(&memory, &p, workers));
    scratch::expect_text("resource: and the programs are still each its own", "yes",
                         text_after(&memory, &p,
                                    "is_copy \"$programs/bin/clang\" \"$smith\" && is_copy \"$programs/bin/ld\" "
                                    "\"$smith\" && echo yes || echo no"));
    scratch::expect_text("resource: and no half-made folder is left", "",
                         text(&memory, &p, "ls \"$program_folders\" | grep tmp"));
}

// A programs folder idle for more than 31 days is removed when a new one is made; a recent one, and the runtime folder,
// stay.
export void test_resource_an_idle_programs_folder_is_removed() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    scratch::Run staged = run_after(
        &memory, &p,
        "variant smith_b ab; variant smith_c cd; ../smith_b cc -fsyntax-only hello.c; old=$(folder_of ../smith_b); "
        "echo \"$old\" >../old; touch -t 202001010000 \"$old\"; mkdir \"$program_folders/stale.99.tmp\"; "
        "touch -t 202001010000 \"$program_folders/stale.99.tmp\"; ../smith_c cc -fsyntax-only hello.c; "
        "echo \"$programs\" >../recent; echo \"$folder\" >../runtime");
    scratch::expect_status("resource: a new programs folder is made", 0, &staged);
    scratch::expect_text("resource: an idle programs folder is removed when a new one is made", "no",
                         text(&memory, &p, "yn \"$(cat ../old)\""));
    scratch::expect_text("resource: so is an old half-made one", "no",
                         text(&memory, &p, "yn \"$program_folders/stale.99.tmp\""));
    scratch::expect_text("resource: a recent one stays", "yes", text(&memory, &p, "yn \"$(cat ../recent)\""));
    scratch::expect_text("resource: and the runtime folder", "yes", text(&memory, &p, "yn \"$(cat ../runtime)\""));
}

// A programs folder records its binary (LC_UUID and path). When a new one is made, the folder of a binary that is gone
// is removed, unless a running smith holds its lock (a long-running `smith lsp` of a deleted worktree) or it is younger
// than an hour; one whose binary exists stays.
export void test_resource_a_programs_folder_records_its_binary() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    scratch::Run made = run(&memory, &p, "variant smith_d 11; ../smith_d cc -fsyntax-only hello.c");
    scratch::expect_status("resource: a smith with a programs folder", 0, &made);
    scratch::expect_text("resource: a programs folder records its binary", "smith_d",
                         text(&memory, &p, "sed -n 2p \"$(folder_of ../smith_d)/binary\" | sed 's,.*/,,'"));
}

export void test_resource_a_folder_whose_smith_is_running_stays() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    scratch::Run staged = run_after(&memory, &p, lock_script);
    scratch::expect_status("resource: the lock script", 0, &staged);
    scratch::expect_contains("resource: a folder whose smith is running stays when its binary is gone", staged.out,
                             "running=yes");
    scratch::expect_contains("resource: and one whose binary exists is never touched", staged.out, "binary_exists=yes");
    scratch::expect_contains("resource: once that smith has died the next prune removes its folder", staged.out,
                             "died=no");
    scratch::expect_contains("resource: and a folder whose binary exists still stays", staged.out,
                             "binary_exists_still=yes");
}

export void test_resource_a_folder_younger_than_an_hour_stays() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    scratch::Run staged =
        run(&memory, &p,
            "variant smith_e 22; ../smith_e cc -fsyntax-only hello.c; folder_e=$(folder_of ../smith_e); "
            "echo \"$folder_e\" >../young; rm ../smith_e; "
            "touch -t \"$(ago_minutes 30)\" \"$folder_e\"; variant smith_h 55; "
            "../smith_h cc -fsyntax-only hello.c");
    scratch::expect_status("resource: a young folder whose binary is gone, and a new one", 0, &staged);
    scratch::expect_text("resource: a folder younger than an hour stays even when its binary is gone", "yes",
                         text(&memory, &p, "yn \"$(cat ../young)\""));
}

