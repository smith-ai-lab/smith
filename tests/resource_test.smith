// A sanitized program loads its runtime from the folder, which neither smith cache clean nor pruning nor a removed
// cache touches.
export void test_resource_a_sanitized_program_loads_its_runtime_from_the_folder() {
    scratch::Project p = scratch::make("p", "resource");
    scratch::own_cache(&p); // before the arena: clean frees it
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    scratch::expect_text("resource: a sanitized program builds and runs", "0 hi",
                         built(&memory, &p, "\"$smith\" cc $sanitize -g hello.c -o asan", "./asan"));
    scratch::expect_text("resource: its rpath is the folder's runtime",
                         text_after(&memory, &p, "echo \"$folder/lib/clang/$major/$runtimes\""),
                         text(&memory, &p, "rpath_of asan"));
    scratch::Run cleaned = run(&memory, &p, "\"$smith\" cache clean");
    scratch::expect_status("resource: smith cache clean works", 0, &cleaned);
    scratch::expect_text("resource: the folder is still there", "yes",
                         text_after(&memory, &p, "yn \"$folder/lib/clang/$major/$runtimes/$asan_runtime\""));
    scratch::expect_text("resource: the sanitized program still runs", "hi", text(&memory, &p, "./asan"));
    scratch::Run removed = run(&memory, &p, "rm -rf \"$XDG_CACHE_HOME\"");
    scratch::expect_status("resource: the whole cache is removed", 0, &removed);
    scratch::expect_text("resource: with the whole cache removed it still runs", "hi", text(&memory, &p, "./asan"));
    scratch::Run bad = run(&memory, &p, "\"$smith\" cc -fsanitize=address ${shared_libsan:-} -g bad.c -o bad");
    scratch::expect_status("resource: a program that reads out of bounds is built", 0, &bad);
    scratch::expect_text("resource: and still finds the runtime to report an error", "AddressSanitizer",
                         text(&memory, &p, "./bad 2>&1 | grep -o AddressSanitizer | head -n 1"));
}

// Processes that start together on a new data folder all work, and leave one folder.
export void test_resource_eight_first_compiles_at_once_leave_one_folder() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    first_compile(&memory, &p);
    scratch::Run raced = run(&memory, &p,
                             "before=$(ls \"$clang_folders\"); rm -rf \"$XDG_DATA_HOME\"; "
                             "for n in 1 2 3 4 5 6 7 8; do (\"$smith\" cc -fsyntax-only hello.c 2>\"../race$n\" && "
                             "echo ok >\"../race$n.ok\") & done; "
                             "wait; echo \"ok=$(ls ../race*.ok | wc -l | tr -d ' ')\"; "
                             "[ \"$before\" = \"$(ls \"$clang_folders\")\" ] && echo same=yes; "
                             "echo \"programs=$(ls \"$program_folders\" | wc -l | tr -d ' ')\"");
    scratch::expect_contains("resource: eight first compiles at once all work", raced.out, "ok=8");
    scratch::expect_contains("resource: and leave the one folder, with the same name", raced.out, "same=yes");
    scratch::expect_contains("resource: and one programs folder", raced.out, "programs=1");
}

export void test_resource_an_unusable_data_folder_is_a_message_and_status_2() {
    scratch::Project p = scratch::make("p", "resource");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!begin(&memory, &p)) {
        return;
    }
    scratch::Run relative = run(&memory, &p, "env -u XDG_DATA_HOME HOME=relative \"$smith\" cc -fsyntax-only hello.c");
    scratch::expect_status("resource: no usable data folder: status 2", 2, &relative);
    scratch::expect_contains("resource: and a message that names the variables", relative.err,
                             "set HOME or XDG_DATA_HOME");
    scratch::Run unwritable = run(&memory, &p, "XDG_DATA_HOME=/dev/null/data \"$smith\" cc -fsyntax-only hello.c");
    scratch::expect_status("resource: an unwritable data folder: status 2", 2, &unwritable);
    scratch::expect_contains("resource: and a message that names it", unwritable.err, "cannot create");
}
