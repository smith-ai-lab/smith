// The verbs in `smith build`, from tests/build.sh section 13b (issue #40): no task or alias is named after one, .test
// marks a project's tests, and every run of build.c writes what the verbs read, .smith/build.info and
// .smith/compile_commands.json (knowledge/build-execution.md).
module build_verbs_test;

import std::arena;
import std::format;
import std::mem;
import std::test;
import scratch;
import corpus;
import <smith_core_verbs.h>;
import <string.h>;

constexpr Usize memory_size = 1U << 25; // a test's memory: what scratch returns goes back with it

// What smith_task and smith_alias say about a name, in process (runtime/build_runtime.c compiled with
// -DSMITH_BUILD_CORE, include/smith_core_verbs.h): all seven verbs for each, and names that are no verb's.
export void test_build_verbs_the_seven_verbs_are_refused_as_task_and_alias_names() {
    arena::Arena memory = test::memory(1U << 20);
    const char *differing = "";
    char actual[16384] = "";
    const char *names[_] = {"fmt", "lint", "docs", "prove", "check", "run", "test", "tests", "other", "Test"};
    const char *kinds[_] = {"task", "alias"};
    for (Usize k = 0; k < 2; k++) {
        for (Usize n = 0; n < countof(names); n++) {
            char message[512];
            bool refused = c::smith_core_verb_name_refused(kinds[k], names[n], message, sizeof message);
            Usize used = c::strlen(actual);
            (void)format::to(actual + used, sizeof actual - used, kinds[k], " ", names[n],
                             refused ? ": refused: " : ": allowed", message, "\n");
        }
    }
    corpus::golden(&memory, &differing, "tests/build-verbs/refusals.txt", actual);
    corpus::finish(differing);
}

// Calling again starts from nothing: a refusal does not remember the one before it.
export void test_build_verbs_a_refusal_does_not_remember_the_last() {
    char message[512];
    test::check_condition(c::smith_core_verb_name_refused("task", "fmt", message, sizeof message));
    char first[512];
    c::strcpy(first, message);
    test::check_condition(!c::smith_core_verb_name_refused("task", "other", message, sizeof message));
    test::check_condition(message[0] == '\0');
    test::check_condition(c::smith_core_verb_name_refused("task", "fmt", message, sizeof message));
    test::check_condition(c::strcmp(first, message) == 0);
}

static void refuses_a_task_and_an_alias_named(const char *verb) {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    char text[1024];
    char name[256];
    (void)format::to(text, sizeof text,
                     "#include <smith/build.h>\n\nvoid build(SmithBuild *b) {\n"
                     "    SmithStep step = {.command = (const char *[]){\"true\", nullptr}};\n"
                     "    smith_task(b, \"",
                     verb, "\", &step);\n    smith_default(b, step.outputs);\n}\n");
    scratch::write(&p, "build.c", text);
    scratch::Run task = scratch::build(&p, "");
    (void)format::to(name, sizeof name, "verbs: a task named ", verb, " is refused");
    scratch::expect_status(name, 2, &task);
    (void)format::to(name, sizeof name, "verbs: ... ", verb, " names the verb");
    (void)format::to(text, sizeof text, "task '", verb, "' is named after a verb; `smith ", verb,
                     "` does the same thing in every project");
    scratch::expect_contains(name, task.err, text);
    (void)format::to(text, sizeof text,
                     "#include <smith/build.h>\n\nvoid build(SmithBuild *b) {\n"
                     "    SmithStep step = {.command = (const char *[]){\"true\", nullptr}};\n"
                     "    smith_task(b, \"other\", &step);\n    smith_alias(b, \"",
                     verb, "\", step.outputs);\n    smith_default(b, step.outputs);\n}\n");
    scratch::write(&p, "build.c", text);
    scratch::Run alias = scratch::build(&p, "");
    (void)format::to(name, sizeof name, "verbs: an alias named ", verb, " is refused");
    scratch::expect_status(name, 2, &alias);
    (void)format::to(name, sizeof name, "verbs: ... and says alias (", verb, ")");
    (void)format::to(text, sizeof text, "alias '", verb, "' is named after a verb");
    scratch::expect_contains(name, alias.err, text);
}

// The one end-to-end case of the refusal, with a real build.c run by `smith build`: the build program prints it and
// ends with status 2, for a task and an alias alike. The text for every verb is the in-process test above.
export void test_build_verbs_a_verb_name_stops_the_build_program() {
    refuses_a_task_and_an_alias_named("lint");
}

export void test_build_verbs_a_test_step_is_built_incrementally_by_smith_tests() {
    scratch::Project p = scratch::make("p", "verbs_step");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run first = scratch::build(&p, "smith_tests");
    scratch::expect_status("verbs: .test on a step: smith_tests builds it", 0, &first);
    scratch::expect_count("verbs: ... it ran once", 1, scratch::lines(&p, "runs"));
    scratch::expect_text(
        "verbs: ... smith_tests names its output", "yes",
        scratch::sh(&p, "grep -q '^build smith_tests: phony build/checked$' .smith/build.ninja && echo yes || echo no")
            .out);
    (void)scratch::build(&p, "smith_tests");
    scratch::expect_count("verbs: ... a second run is incremental (a task would rerun)", 1, scratch::lines(&p, "runs"));
    scratch::sleep(&p, 50);
    scratch::write(&p, "in.txt", "y\n");
    (void)scratch::build(&p, "smith_tests");
    scratch::expect_count("verbs: ... and an edited input reruns it", 2, scratch::lines(&p, "runs"));
}

// How many lines of a file match a pattern, as grep -c counts them ("0" when none).
static const char *matches(const scratch::Project *p, const char *file, const char *pattern) {
    char command[1024];
    (void)format::to(command, sizeof command, "grep -c ", pattern, " ", file);
    return scratch::capture(p, command);
}

export void test_build_verbs_build_info_and_the_compile_database_say_what_the_verbs_read() {
    scratch::Project p = scratch::make("p", "verbs_info");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = scratch::build(&p, "build/main.o");
    scratch::expect_status("verbs: build.c runs with a task test made by smith_tests", 0, &run);
    const char *info = ".smith/build.info";
    scratch::expect_text("verbs: build.info has the first compile of main.c, once, with its flags", "1",
                         matches(&p, info, "'^compile\tmain.c\t-DFIRST\t-MD'"));
    scratch::expect_text("verbs: ... not its second compile", "0", matches(&p, info, "-e -DSECOND"));
    scratch::expect_text("verbs: ... helper.c, which reads a generated file", "1",
                         matches(&p, info, "'^compile\thelper.c\t'"));
    scratch::expect_text("verbs: ... other.c, which smith_compile_command declares", "1",
                         matches(&p, info, "'^compile\tother.c\t.*-DOTHER'"));
    scratch::expect_text("verbs: ... the tests' source", "1", matches(&p, info, "'^compile\ttests/test_one.c\t'"));
    scratch::expect_text("verbs: ... build.c itself", "1", matches(&p, info, "'^compile\tbuild.c\t'"));
    scratch::expect_text("verbs: ... no generated source", "0", matches(&p, info, "'^compile.*made.c'"));
    scratch::expect_text("verbs: ... but helper.c's need line names the one it waits for", "1",
                         matches(&p, info, "'^need\thelper.c\tbuild/made.c$'"));
    scratch::expect_text("verbs: ... and other.c's, which smith_compile_needs declares", "1",
                         matches(&p, info, "'^need\tother.c\tbuild/made.c$'"));
    scratch::expect_text("verbs: ... no source under .smith/", "0", matches(&p, info, "'^compile\t.smith/'"));
    scratch::expect_text("verbs: ... the task of smith_tests is a test", "1", matches(&p, info, "'^test\ttest$'"));
    scratch::expect_text("verbs: ... the programs", "1", matches(&p, info, "'^program\tbuild/program$'"));
    scratch::expect_text("verbs: ... the runner smith_tests makes, named as the runner", "1",
                         matches(&p, info, "'^runner\tbuild/tests$'"));
    scratch::expect_text("verbs: ... the runner is also a program, with no unit line of its own", "1",
                         matches(&p, info, "'^program\tbuild/tests$'"));
    scratch::expect_text("verbs: ... the default, its alias opened", "1",
                         matches(&p, info, "'^default\tbuild/program$'"));
    const char *database = ".smith/compile_commands.json";
    scratch::expect_text("verbs: the compile database lists main.c once", "1",
                         matches(&p, database, "'\"file\": \"main.c\"'"));
    scratch::expect_text("verbs: ... with the first compile's flags", "1", matches(&p, database, "-e -DFIRST"));
    scratch::expect_text("verbs: ... not the second's", "0", matches(&p, database, "-e -DSECOND"));
    scratch::expect_text(
        "verbs: smith_needs is the generated files the compiles read", "yes",
        scratch::sh(&p, "grep -q '^build smith_needs: phony build/made.c' .smith/build.ninja && echo yes || echo no")
            .out);
    scratch::expect_text(
        "verbs: smith_tests is the test tasks", "yes",
        scratch::sh(&p, "grep -q '^build smith_tests: phony test$' .smith/build.ninja && echo yes || echo no").out);
    (void)scratch::build(&p, "smith_needs");
    scratch::expect_text("verbs: building smith_needs makes the generated file", "yes",
                         scratch::exists(&p, "build/made.c") ? "yes" : "no");
}

// `smith test <flag>` (#1113) prints the usage and exits 0 without building: the folder has no build file, so a build
// would fail, and nothing is made under .smith/.
static void prints_the_test_usage(const char *command) {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = scratch::sh(&p, command);
    defer scratch::release(run.out);
    defer scratch::release(run.err);
    scratch::expect_status("verbs: smith test help exits 0", 0, &run);
    scratch::expect_contains("verbs: ... and prints the usage", run.out, "usage: smith test");
    scratch::expect_contains("verbs: ... naming --test", run.out, "--test <names>");
    scratch::expect_contains("verbs: ... and --changed", run.out, "--changed");
    scratch::expect_text("verbs: ... and builds nothing", "no", scratch::exists(&p, ".smith") ? "yes" : "no");
}

export void test_build_verbs_test_help_prints_the_usage_and_builds_nothing() {
    prints_the_test_usage("smith test --help");
}

export void test_build_verbs_test_dash_h_prints_the_usage_and_builds_nothing() {
    prints_the_test_usage("smith test -h");
}

// `smith --version`, `--help`, `-h` and `help [<verb>]` (#1138) work at the top level and exit 0; any other flag is
// still the bare-argument error.
static scratch::Run runs_in_a_bare_folder(const char *command) {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    return scratch::sh(&p, command);
}

export void test_build_verbs_top_level_version_prints_what_the_version_verb_prints() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run flag = runs_in_a_bare_folder("smith --version");
    scratch::Run verb = runs_in_a_bare_folder("smith version");
    scratch::expect_status("verbs: smith --version exits 0", 0, &flag);
    scratch::expect_contains("verbs: ... and prints the version", flag.out, "smith 0.0");
    scratch::expect_text("verbs: ... the same as smith version", verb.out, flag.out);
}

static void lists_the_verbs(const char *command) {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = runs_in_a_bare_folder(command);
    scratch::expect_status("verbs: the verb list exits 0", 0, &run);
    scratch::expect_contains("verbs: ... and lists the verbs", run.out, "usage: smith <command>");
    scratch::expect_contains("verbs: ... test among them", run.out, "run, test, check");
}

export void test_build_verbs_top_level_help_lists_the_verbs() {
    lists_the_verbs("smith --help");
    lists_the_verbs("smith -h");
    lists_the_verbs("smith help");
}

export void test_build_verbs_help_test_prints_the_same_as_test_help() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run help = runs_in_a_bare_folder("smith help test");
    scratch::Run flag = runs_in_a_bare_folder("smith test --help");
    scratch::expect_status("verbs: smith help test exits 0", 0, &help);
    scratch::expect_text("verbs: ... the same as smith test --help", flag.out, help.out);
}

static void says_there_is_no_detailed_help(const char *verb) {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    char command[128];
    (void)format::to(command, sizeof command, "smith help ", verb);
    scratch::Run help = runs_in_a_bare_folder(command);
    (void)format::to(command, sizeof command, "smith ", verb, " --help");
    scratch::Run flag = runs_in_a_bare_folder(command);
    scratch::expect_status("verbs: smith help <verb> exits 0", 0, &help);
    scratch::expect_status("verbs: smith <verb> --help exits 0", 0, &flag);
    scratch::expect_contains("verbs: ... names the verb", help.out, "smith ");
    scratch::expect_contains("verbs: ... and says there is no detailed help", help.out, "no detailed help yet");
    scratch::expect_text("verbs: ... the same for both forms", help.out, flag.out);
    (void)format::to(command, sizeof command, "smith ", verb, " -h");
    scratch::Run dash = runs_in_a_bare_folder(command);
    scratch::expect_status("verbs: smith <verb> -h exits 0", 0, &dash);
    scratch::expect_text("verbs: ... and prints the same", help.out, dash.out);
}

// `smith run --help` and the others would build, run or fail: they print their line and run nothing.
export void test_build_verbs_help_of_a_verb_without_usage_says_so_and_runs_nothing() {
    says_there_is_no_detailed_help("run");
    says_there_is_no_detailed_help("build");
    says_there_is_no_detailed_help("check");
    says_there_is_no_detailed_help("prove");
    says_there_is_no_detailed_help("fetch");
    says_there_is_no_detailed_help("cache");
    says_there_is_no_detailed_help("docs");
}

export void test_build_verbs_help_of_a_tool_verb_is_the_tools_usage() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run help = runs_in_a_bare_folder("smith help fmt");
    scratch::expect_status("verbs: smith help fmt exits 0", 0, &help);
    scratch::expect_contains("verbs: ... is clang-format's usage", help.out, "OVERVIEW: A tool to format");
    scratch::Run unknown = runs_in_a_bare_folder("smith help frobnicate");
    scratch::expect_status("verbs: help of an unknown verb exits 2", 2, &unknown);
}

export void test_build_verbs_any_other_top_level_flag_is_still_an_error() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = runs_in_a_bare_folder("smith --frobnicate");
    scratch::expect_status("verbs: smith --frobnicate exits 2", 2, &run);
    scratch::expect_contains("verbs: ... with today's message", run.err,
                             "smith: --frobnicate is not a smith command; to compile, run `smith cc --frobnicate`");
}
