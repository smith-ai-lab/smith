    hostile(io, "a symlink far above", link_of("pkg-1.0/far", '2', "../../../../../x"), "points outside the package");
}

export void test_untar_refuses_a_file_written_through_a_symlink(io::Io *io) {
    Entry entries[3] = {folder_of("pkg-1.0/"), link_of("pkg-1.0/self", '2', "."), file_of("pkg-1.0/self/under", "x\n")};
    refuses(io, "a file written through a symlink", tar_of(io, entries, 3), "through a symlink");
