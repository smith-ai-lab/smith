    hostile(io, "an absolute symlink", link_of("pkg-1.0/absolute", '2', "/etc/passwd"), "absolute path");
}

export void test_untar_refuses_a_symlink_that_goes_up_after_going_down(io::Io *io) {
    hostile(io, "a symlink that goes up after going down", link_of("pkg-1.0/dotdot", '2', "a/../b"),
            "goes up after going down");
