// A .gz of one file that is no tar (a release binary, as tree-sitter's): the package is a folder holding that file,
// named after the URL without ".gz", with the bytes as they were and mode 0644. The mtime is the time of writing.
static void single_gz_extracts(io::Io *io, const char *name, Bytes content, const char *url, const char *file) {
    const char *label = join(io, "single gz ", name);
    Extracted r = extract_from(io, "single", gzip_stored(io, content), url);
    scratch::expect_text(join(io, label, ": extracts"), "", r.ok ? "" : r.error);
    scratch::expect_text(join(io, label, ": the package is the extraction folder"), folder_for_name(io, "single"),
                         r.contents);
    const char *line = format::push(&io->arena, file, " f 0644 ", countof(content), " ",
                                    format::hex(inflate::crc32(0, content.data, countof(content)), 8), " ")
                           .data;
    scratch::expect_contains(join(io, label, ": one file, named without .gz, mode 0644, the same bytes"), r.tree, line);
    scratch::expect_text(join(io, label, ": and nothing else"), "", c::strchr(r.tree, '\n') + 1);
}

export void test_untar_single_gz_tool_bin(io::Io *io) {
    single_gz_extracts(io, "tool-bin", noise(io, 100000), "file:///releases/tool-bin.gz", "tool-bin");
}

export void test_untar_single_gz_text(io::Io *io) {
    single_gz_extracts(io, "text", text_bytes("line 1 of a text that repeats\n"), "https://h/p/text.gz", "text");
}

export void test_untar_single_gz_tiny(io::Io *io) {
    single_gz_extracts(io, "tiny", text_bytes("tiny\n"), "https://h/p/tiny.gz", "tiny");
}

export void test_untar_single_gz_nothing(io::Io *io) {
    single_gz_extracts(io, "nothing", text_bytes(""), "https://h/p/nothing.gz", "nothing");
}

export void test_untar_single_gz_with_no_gz_in_its_name_keeps_the_name(io::Io *io) {
    single_gz_extracts(io, "noext", text_bytes("abc\n"), "https://h/p/noext", "noext");
}

export void test_untar_single_gz_name_ends_before_the_query_and_the_fragment(io::Io *io) {
    single_gz_extracts(io, "query", text_bytes("abc\n"), "https://h/p/tool.gz?token=1#top", "tool");
}

static Bytes tool_bin_gz(io::Io *io) {
    return gzip_stored(io, noise(io, 100000));
}

export void test_untar_refuses_a_truncated_single_gz(io::Io *io) {
    Bytes gz = tool_bin_gz(io);
    refuses(io, "a truncated single gz", part(gz, 0, countof(gz) / 2), "gzip:");
}

export void test_untar_refuses_a_single_gz_without_its_trailer(io::Io *io) {
    Bytes gz = tool_bin_gz(io);
    refuses(io, "a single gz without its trailer", part(gz, 0, countof(gz) - 4), "the data is cut off");
}

export void test_untar_refuses_a_single_gz_with_a_wrong_crc(io::Io *io) {
    Bytes gz = tool_bin_gz(io);
    Buffer bad = buffer(io);
    put_bytes(&bad, part(gz, 0, countof(gz) - 8));
    const u8 four[4] = {1, 2, 3, 4};
    put(&bad, four, 4);
    put_bytes(&bad, part(gz, countof(gz) - 4, countof(gz)));
    refuses(io, "a single gz with a wrong CRC", bytes_of(&bad), "checksum of the data does not match");
}

export void test_untar_refuses_a_single_gz_with_a_wrong_size(io::Io *io) {
    Bytes gz = tool_bin_gz(io);
    Buffer bad = buffer(io);
    put_bytes(&bad, part(gz, 0, countof(gz) - 4));
    const u8 four[4] = {1, 2, 3, 4};
    put(&bad, four, 4);
    refuses(io, "a single gz with a wrong size", bytes_of(&bad), "size of the data");
}

// A byte changed at a place that only a check can notice: gzip's CRC-32 and size, and xz's check of each kind. Random
// data is stored, so a changed byte in the middle is still well-formed LZMA2 or DEFLATE.
export void test_untar_refuses_a_gzip_with_a_wrong_crc32(io::Io *io) {
    refuses(io, "a gzip with a wrong CRC-32", flip(io, fixture(io, "a.tar.gz"), -8),
            "checksum of the data does not match");
}

export void test_untar_refuses_a_gzip_with_a_wrong_size(io::Io *io) {
    refuses(io, "a gzip with a wrong size", flip(io, fixture(io, "a.tar.gz"), -4), "size of the data does not match");
}

export void test_untar_refuses_a_gzip_with_a_changed_byte_in_a_stored_block(io::Io *io) {
    Bytes data = noise(io, 200000);
    Entry entries[2] = {folder_of("pkg-1.0/"), random_file(data)};
    refuses(io, "a gzip with a changed byte in a stored block",
            flip(io, gzip_stored(io, tar_of(io, entries, 2)), 100000), "checksum of the data does not match");
}

// A one-block xz ends with the block's check, an index of 12 bytes and the footer of 12: the check is flipped at its
// first byte. (Real xz compresses these tars, so there is no stored chunk to change; the next test has one.)
static void xz_check_changed(io::Io *io, const char *check, isize from_end) {
    Bytes xz = fixture(io, join(io, join(io, "rand-", check), ".tar.xz"));
    refuses(io, join(io, "an xz with a changed check under ", check), flip(io, xz, from_end),
            "check does not match its data");
}

export void test_untar_refuses_an_xz_with_a_changed_check_under_crc32(io::Io *io) {
    xz_check_changed(io, "crc32", -28);
}

export void test_untar_refuses_an_xz_with_a_changed_check_under_crc64(io::Io *io) {
    xz_check_changed(io, "crc64", -32);
}

export void test_untar_refuses_an_xz_with_a_changed_check_under_sha256(io::Io *io) {
    xz_check_changed(io, "sha256", -56);
}

// A changed byte in an uncompressed LZMA2 chunk is still well-formed LZMA2: only the check notices.
export void test_untar_refuses_an_xz_with_a_changed_byte_in_an_uncompressed_chunk(io::Io *io) {
    Bytes data = noise(io, 100000);
    Entry entries[2] = {folder_of("pkg-1.0/"), random_file(data)};
    refuses(io, "an xz with a changed byte in an uncompressed chunk",
            flip(io, xz_stored(io, tar_of(io, entries, 2), 1), 70000), "check does not match its data");
}

export void test_untar_refuses_an_xz_with_a_damaged_stream_header(io::Io *io) {
    refuses(io, "an xz with a damaged stream header", flip(io, fixture(io, "a.tar.xz"), 7), "stream header");
}

export void test_untar_refuses_an_xz_with_a_damaged_block_header(io::Io *io) {
    refuses(io, "an xz with a damaged block header", flip(io, fixture(io, "a.tar.xz"), 13), "block header");
}

export void test_untar_refuses_an_xz_with_a_damaged_index(io::Io *io) {
    refuses(io, "an xz with a damaged index", flip(io, fixture(io, "a.tar.xz"), -14), "index");
}

export void test_untar_refuses_a_tar_with_a_damaged_header(io::Io *io) {
    // In the second header, since the first decides that this is a tar.
    refuses(io, "a tar with a damaged header", flip(io, fixture(io, "a.tar"), 522), "checksum does not match");
}

// ---- The readers keep no state from one extraction to the next (include/smith_core.h)

export void test_an_extraction_does_not_remember_the_last(io::Io *io) {
    Bytes xz = fixture(io, "blocks.tar.xz");
    Extracted first = extract(io, "again-1", xz);
    Extracted refused = extract(io, "again-2", flip(io, xz, -14));
    Extracted gz = extract(io, "again-3", fixture(io, "a.tar.gz"));
    Extracted second = extract(io, "again-4", xz);
    test::check_equal(refused.ok, false);
    is_tree(io, "an extraction after another", &first, source_tree);
    is_tree(io, "an extraction after a refusal", &second, source_tree);
    is_tree(io, "a gzip between them", &gz, source_tree);
}
