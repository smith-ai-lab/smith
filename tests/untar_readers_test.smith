// smith's archive readers (runtime/gzip.c on lib/smith/inflate.smith, runtime/xz.c, runtime/untar.c) as functions, in
// process (issue #646): the bytes of an archive in, a folder of files or the refusal out, through `smith_core_extract`
// and `smith_core_tree` (include/smith_core.h, smith.c compiled as a library by tests/units/build.c). No process
// starts. They replace the checks of tests/untar_formats_test.smith and tests/untar_refuse_test.smith that went
// through `smith fetch`; those two files keep one case of each wiring (a fetch extracts, a refusal names the archive
// and leaves no package), and tests/untar_sanitizers_test.smith keeps the readers under real sanitizers.
//
// Where the bytes come from: tars are written by `tar_add` below (the hostile ones, which no tar program writes, and
// the others), a gzip of any bytes by `gzip_stored` (stored blocks, CRC-32 and size), and the formats only a compressor
// makes are the files of tests/fixtures/untar, made once with GNU tar 1.35, gzip 1.12 and xz 5.4 from this tree (all
// files at mtime 1000000000, owner 0): pkg-1.0/{hello.txt, bin/tool 0755, empty, lib/secret 0640, lib/readonly 0444,
// lib/text.txt (300 lines), lib/deep/random.bin (3000 random bytes), the symlinks lib/hello-link, libs and
// lib/deep/up-two, empty-folder/}. `source_tree` is that tree's listing, written by a Python script that walks the
// folder (the same format as `smith_core_tree`), so the golden does not come from the code under test.
module untar_readers_test;

import smith::arena;
import smith::contract;
import smith::format;
import smith::inflate;
import smith::io;
import smith::mem;
import smith::test;
import scratch;
import <smith_core.h>;
import <string.h>;

typedef typeof(const u8[:]) Bytes;

constexpr usize text_capacity = 1U << 16;
constexpr usize path_capacity = 4096;
constexpr usize buffer_capacity = 1U << 19;
constexpr u64 mtime = 1000000000;

// The listing of the tree the fixtures hold.
constexpr char source_tree[_] = "bin d\n"
                                "bin/tool f 0755 24 3b195907 1000000000\n"
                                "empty f 0644 0 00000000 1000000000\n"
                                "empty-folder d\n"
                                "hello.txt f 0644 14 7f26afeb 1000000000\n"
                                "lib d\n"
                                "lib/deep d\n"
                                "lib/deep/random.bin f 0644 3000 023c6bc2 1000000000\n"
                                "lib/deep/up-two l -> ../../hello.txt\n"
                                "lib/hello-link l -> ../hello.txt\n"
                                "lib/readonly f 0444 10 fca84d94 1000000000\n"
                                "lib/secret f 0640 8 c3d1e210 1000000000\n"
                                "lib/text.txt f 0644 14520 2e89baef 1000000000\n"
                                "libs l -> lib\n";

constexpr char random_tree[_] = "random.bin f 0644 4000 e144e5c0 1000000000\n";

// ---- Bytes: the fixtures, a buffer to write archives into, and damage

static const char *join(io::Io *io, const char *a, const char *b) {
    return format::push(&io->arena, a, b).data;
}

[[std::returns_borrowed(1)]] static Bytes fixture(io::Io *io, const char *name) {
    const char *path =
        format::push(&io->arena, io::args_env(&io->args, "SMITH_REPO"), "/tests/fixtures/untar/", name).data;
    io::Read file = io::files_read(&io->files, &io->arena, path);
    test::check_equal(file.error.code, 0);
    return file.data;
}

typedef struct {
    u8 *data;
    usize used;
} Buffer;

static Buffer buffer(io::Io *io) {
    return (Buffer){.data = arena::push_slice(&io->arena, u8, buffer_capacity).data, .used = 0};
}

static void put(Buffer *b, const u8 *bytes, usize size) {
    test::check_less_equal(b->used + size, buffer_capacity);
    if (size > 0) mem::copy(b->data[b->used:b->used + size], bytes[0:size]);
    b->used += size;
}

static void put_bytes(Buffer *b, Bytes bytes) {
    put(b, bytes.data, countof(bytes));
}

static void put_zeros(Buffer *b, usize count) {
    test::check_less_equal(b->used + count, buffer_capacity);
    for (usize i = 0; i < count; i++)
        b->data[b->used + i] = 0;
    b->used += count;
}

static Bytes text_bytes(const char *text) {
    const u8 *bytes = (const u8 *)text;
    return bytes[0:c::strlen(text)];
}

static Bytes bytes_of(const Buffer *b) {
    contract::trusted(); // the bytes are in the arena the buffer was made in, the caller's context, which no attribute says
    return b->data[0:b->used];
}

// The bytes of `from` from `start` to the end of the first `count` of them.
static Bytes part(Bytes from, usize start, usize end) {
    return from[start:end];
}

// A copy with the byte at `at` (from the end when negative) changed, so that only a check can notice.
[[std::returns_borrowed(1)]] static Bytes flip(io::Io *io, Bytes bytes, isize at) {
    usize size = countof(bytes);
    usize where = at < 0 ? size - (usize)(-at) : (usize)at;
    test::check_less(where, size);
    Buffer b = buffer(io);
    put_bytes(&b, bytes);
    b.data[where] = (u8)(b.data[where] + 1);
    return bytes_of(&b);
}

[[std::returns_borrowed(1)]] static Bytes concat(io::Io *io, Bytes a, Bytes b) {
    Buffer joined = buffer(io);
    put_bytes(&joined, a);
    put_bytes(&joined, b);
    return bytes_of(&joined);
}

// Bytes that do not compress, the same on every run.
static Bytes noise(io::Io *io, usize size) {
    u8 *data = arena::push_slice(&io->arena, u8, size).data;
    u32 state = 646;
    for (usize i = 0; i < size; i++) {
        state ^= state << 13;
        state ^= state >> 17;
        state ^= state << 5;
        data[i] = (u8)(state >> 11);
    }
    return data[0:size];
}

// ---- tar

typedef struct {
    const char *name;
    char type;        // '0' file, '5' folder, '2' symlink, '1' hard link, '6' FIFO, '3' device
    const char *link; // the target of a link
    const u8 *data;   // the bytes of a file
    usize size;
    u32 mode;
} Entry;

static Entry file_of(const char *name, const char *text) {
    return (Entry){.name = name, .type = '0', .data = (const u8 *)text, .size = c::strlen(text), .mode = 0o644};
}

static Entry folder_of(const char *name) {
    return (Entry){.name = name, .type = '5', .mode = 0o755};
}

static Entry link_of(const char *name, char type, const char *target) {
    return (Entry){.name = name, .type = type, .link = target, .mode = 0o777};
}

static void octal(u8 *field, usize width, u64 value) {
    for (usize i = 0; i < width - 1; i++) {
        field[width - 2 - i] = (u8)('0' + (value & 7));
        value >>= 3;
    }
    field[width - 1] = 0;
}

static void set_text(u8 *field, usize width, const char *text) {
    usize length = c::strlen(text);
    test::check_less_equal(length, width);
    const u8 *bytes = (const u8 *)text;
    if (length > 0) mem::copy(field[0:length], bytes[0:length]);
}

// One entry of a ustar archive: its header, its bytes and the padding to a block.
static void tar_add(Buffer *tar, Entry entry) {
    u8 header[512] = {};
    set_text(header, 100, entry.name);
    octal(header + 100, 8, entry.mode);
    octal(header + 108, 8, 0);
    octal(header + 116, 8, 0);
    octal(header + 124, 12, entry.size);
    octal(header + 136, 12, mtime);
    for (usize i = 148; i < 156; i++)
        header[i] = ' ';
    header[156] = (u8)entry.type;
    if (entry.link != nullptr) set_text(header + 157, 100, entry.link);
    set_text(header + 257, 6, "ustar");
    header[263] = '0';
    header[264] = '0';
    u64 sum = 0;
    for (usize i = 0; i < 512; i++)
        sum += header[i];
    octal(header + 148, 7, sum);
    header[155] = ' ';
    put(tar, header, 512);
    put(tar, entry.data, entry.size);
    put_zeros(tar, (512 - entry.size % 512) % 512);
}

[[std::returns_borrowed(1)]] static Bytes tar_of(io::Io *io, const Entry *entries, usize count) {
    Buffer tar = buffer(io);
    for (usize i = 0; i < count; i++)
        tar_add(&tar, entries[i]);
    put_zeros(&tar, 1024);
    return bytes_of(&tar);
}

// ---- gzip: stored blocks, which is what gzip makes of data that does not compress

static void put_le32(Buffer *b, u32 value) {
    u8 four[4] = {(u8)value, (u8)(value >> 8), (u8)(value >> 16), (u8)(value >> 24)};
    put(b, four, 4);
}

[[std::returns_borrowed(1)]] static Bytes gzip_stored(io::Io *io, Bytes data) {
    Buffer gz = buffer(io);
    const u8 header[10] = {0x1F, 0x8B, 8, 0, 0, 0, 0, 0, 0, 3};
    put(&gz, header, 10);
    usize size = countof(data);
    usize at = 0;
    for (usize block = 0; block < 1000; block++) {
        usize take = size - at < 65535 ? size - at : 65535;
        bool last = at + take == size;
        u8 head[5] = {last ? 1 : 0, (u8)take, (u8)(take >> 8), (u8)~take, (u8)(~take >> 8)};
        put(&gz, head, 5);
        put(&gz, data.data + at, take);
        at += take;
        if (last) break;
    }
    put_le32(&gz, inflate::crc32(0, data.data, size));
    put_le32(&gz, (u32)size);
    return bytes_of(&gz);
}

// ---- xz: LZMA2's uncompressed chunks, which is what xz makes of data that does not compress; one block, with CRC-32
// (check 1) or no check (check 0)

static void put_vli(Buffer *b, u64 value) {
    for (usize i = 0; i < 9; i++) {
        u8 byte = (u8)(value & 0x7F);
        value >>= 7;
        if (value == 0) {
            put(b, &byte, 1);
            return;
        }
        byte |= 0x80;
        put(b, &byte, 1);
    }
}

[[std::returns_borrowed(1)]] static Bytes xz_stored(io::Io *io, Bytes data, u8 check) {
    usize size = countof(data);
    Buffer xz = buffer(io);
    const u8 flags[2] = {0, check};
    const u8 magic[6] = {0xFD, '7', 'z', 'X', 'Z', 0};
    put(&xz, magic, 6);
    put(&xz, flags, 2);
    put_le32(&xz, inflate::crc32(0, flags, 2));
    // The block header: 12 bytes, one LZMA2 filter with a dictionary of 256 KiB and no sizes.
    u8 header[12] = {2, 0, 0x21, 1, 0x0C, 0, 0, 0};
    u32 header_crc = inflate::crc32(0, header, 8);
    for (usize i = 0; i < 4; i++)
        header[8 + i] = (u8)(header_crc >> (8 * i));
    put(&xz, header, 12);
    usize start = xz.used;
    for (usize at = 0, chunk = 0; at < size || chunk == 0; chunk++) {
        usize take = size - at < 65536 ? size - at : 65536;
        u8 head[3] = {chunk == 0 ? 1 : 2, (u8)((take - 1) >> 8), (u8)(take - 1)};
        if (take > 0) put(&xz, head, 3);
        put(&xz, data.data + at, take);
        at += take;
        if (take == 0) break;
    }
    put_zeros(&xz, 1); // the end of the LZMA2 data
    usize compressed = xz.used - start;
    put_zeros(&xz, (4 - (12 + compressed) % 4) % 4);
    usize check_size = check == 1 ? 4 : 0;
    if (check == 1) put_le32(&xz, inflate::crc32(0, data.data, size));
    // The index: one record (the block's size without padding, then the size of its data), padded, with its CRC-32.
    usize index_start = xz.used;
    put_zeros(&xz, 1);
    put_vli(&xz, 1);
    put_vli(&xz, 12 + compressed + check_size);
    put_vli(&xz, size);
    put_zeros(&xz, (4 - (xz.used - index_start) % 4) % 4);
    put_le32(&xz, inflate::crc32(0, xz.data + index_start, xz.used - index_start));
    usize index_size = xz.used - index_start;
    u8 footer[6] = {(u8)(index_size / 4 - 1), (u8)((index_size / 4 - 1) >> 8), 0, 0, 0, check};
    put_le32(&xz, inflate::crc32(0, footer, 6));
    put(&xz, footer, 6);
    put(&xz, (const u8 *)"YZ", 2);
    return bytes_of(&xz);
}

// ---- Extraction

typedef struct {
    bool ok;
    const char *contents; // the package's folder
    const char *error;
    const char *tree; // the listing of the package
} Extracted;

static const char *folder_for_name(io::Io *io, const char *name) {
    return join(io, join(io, test::scratch(io), "/"), name);
}

static const char *folder_for(io::Io *io, const char *name) {
    const char *folder = folder_for_name(io, name);
    io::Error made = io::files_make_folder(&io->files, folder);
    test::check_equal(made.code, 0);
    return folder;
}

// The archive extracted into a new folder of the test's scratch folder, named `name`.
static Extracted extract_from(io::Io *io, const char *name, Bytes archive, const char *url) {
    const char *folder = folder_for(io, name);
    char *contents = arena::push_slice(&io->arena, char, path_capacity).data;
    char *error = arena::push_slice(&io->arena, char, text_capacity).data;
    char *tree = arena::push_slice(&io->arena, char, text_capacity).data;
    bool ok = c::smith_core_extract(archive.data, countof(archive), url, folder, contents, path_capacity, error,
                                    text_capacity);
    if (ok) {
        bool listed = c::smith_core_tree(contents, tree, text_capacity);
        test::check_equal(listed, true);
    }
    return (Extracted){.ok = ok, .contents = contents, .error = error, .tree = tree};
}

static Extracted extract(io::Io *io, const char *name, Bytes archive) {
    return extract_from(io, name, archive, "file:///package.tar");
}

// The archive extracts to the listing.
static void is_tree(io::Io *io, const char *name, const Extracted *r, const char *listing) {
    scratch::expect_text(join(io, name, ": extracts"), "", r->ok ? "" : r->error);
    scratch::expect_text(join(io, name, ": the tree, modes and bytes"), listing, r->tree);
}

// The archive is refused with the reason, and its URL begins the message.
static void is_refused(io::Io *io, const char *name, const Extracted *r, const char *url, const char *reason) {
    scratch::expect_text(join(io, name, ": is refused"), "refused", r->ok ? "extracted" : "refused");
    scratch::expect_contains(join(io, name, ": says why"), r->error, reason);
    scratch::expect_contains(join(io, name, ": names the archive"), r->error,
                             format::push(&io->arena, "cannot extract ", url).data);
}

static void refuses(io::Io *io, const char *name, Bytes archive, const char *reason) {
    Extracted r = extract(io, "refused", archive);
    is_refused(io, name, &r, "file:///package.tar", reason);
}

static void same_tree(io::Io *io, const char *name, const char *archive, const char *listing) {
    Extracted r = extract(io, "same", fixture(io, archive));
    is_tree(io, name, &r, listing);
}

// ---- 1. The source tree and each format of its archive

export void test_untar_tar_ustar(io::Io *io) {
    same_tree(io, "tar (ustar)", "a.tar", source_tree);
}

export void test_untar_tar_pax(io::Io *io) {
    same_tree(io, "tar (pax)", "pax.tar", source_tree);
}

export void test_untar_tar_gnu(io::Io *io) {
    same_tree(io, "tar (gnu)", "gnu.tar", source_tree);
}

export void test_untar_tar_gz(io::Io *io) {
    same_tree(io, "tar.gz", "a.tar.gz", source_tree);
}

export void test_untar_tar_gz_gzip_1(io::Io *io) {
    same_tree(io, "tar.gz (gzip -1)", "fast.tar.gz", source_tree);
}

export void test_untar_tar_gz_gzip_9(io::Io *io) {
    same_tree(io, "tar.gz (gzip -9)", "best.tar.gz", source_tree);
}

export void test_untar_tgz_with_the_file_name_in_its_header(io::Io *io) {
    same_tree(io, "tgz with the file name in its header", "named.tgz", source_tree);
}

// xz makes CRC-64 by default.
export void test_untar_tar_xz_crc64(io::Io *io) {
    same_tree(io, "tar.xz (CRC-64)", "a.tar.xz", source_tree);
}

export void test_untar_tar_xz_crc32(io::Io *io) {
    same_tree(io, "tar.xz (CRC-32)", "crc32.tar.xz", source_tree);
}

export void test_untar_tar_xz_sha256(io::Io *io) {
    same_tree(io, "tar.xz (SHA-256)", "sha256.tar.xz", source_tree);
}

export void test_untar_tar_xz_no_check(io::Io *io) {
    same_tree(io, "tar.xz (no check)", "none.tar.xz", source_tree);
}

// 8 blocks of 4096 bytes (xz -T2 --block-size=4096).
export void test_untar_tar_xz_many_blocks(io::Io *io) {
    same_tree(io, "tar.xz (many blocks)", "blocks.tar.xz", source_tree);
}

// A gzip of a tar is still a tar, and a tar split anywhere in a gzip is read as one.
export void test_untar_a_gz_of_a_tar_is_still_a_tar(io::Io *io) {
    Extracted r = extract(io, "stored", gzip_stored(io, fixture(io, "a.tar")));
    is_tree(io, "a gz of a tar", &r, source_tree);
}

// Members and streams one after the other: cat a.gz b.gz, and xz streams with the padding xz allows between them.
export void test_untar_tar_gz_of_two_members(io::Io *io) {
    Bytes tar = fixture(io, "a.tar");
    Bytes two = concat(io, gzip_stored(io, part(tar, 0, 10240)), gzip_stored(io, part(tar, 10240, countof(tar))));
    Extracted r = extract(io, "two", two);
    is_tree(io, "tar.gz of two members", &r, source_tree);
}

export void test_untar_tar_xz_of_two_streams_with_padding(io::Io *io) {
    Buffer joined = buffer(io);
    put_bytes(&joined, fixture(io, "part1.xz"));
    put_zeros(&joined, 4);
    put_bytes(&joined, fixture(io, "part2.xz"));
    Extracted r = extract(io, "two", bytes_of(&joined));
    is_tree(io, "tar.xz of two streams with padding", &r, source_tree);
}

export void test_untar_tar_gz_with_zero_padding_after_it(io::Io *io) {
    Buffer padded = buffer(io);
    put_bytes(&padded, fixture(io, "a.tar.gz"));
    put_zeros(&padded, 7);
    Extracted r = extract(io, "padded", bytes_of(&padded));
    is_tree(io, "tar.gz with zero padding after it", &r, source_tree);
}

export void test_untar_tar_xz_with_zero_padding_after_it(io::Io *io) {
    Buffer padded = buffer(io);
    put_bytes(&padded, fixture(io, "a.tar.xz"));
    put_zeros(&padded, 8);
    Extracted r = extract(io, "padded", bytes_of(&padded));
    is_tree(io, "tar.xz with zero padding after it", &r, source_tree);
}

// Data that does not compress is stored: gzip's stored blocks (more than one: 65535 bytes at most), and LZMA2's
// uncompressed chunks (70000 bytes of random data, from a real xz).
static Entry random_file(Bytes data) {
    return (Entry){.name = "pkg-1.0/random.bin", .type = '0', .data = data.data, .size = countof(data), .mode = 0o644};
}

static const char *random_listing(io::Io *io, Bytes data) {
    return format::push(&io->arena, "random.bin f 0644 ", countof(data), " ",
                        format::hex(inflate::crc32(0, data.data, countof(data)), 8), " 1000000000\n")
        .data;
}

export void test_untar_tar_gz_of_random_data_stored_blocks(io::Io *io) {
    Bytes data = noise(io, 150000); // three blocks
    Entry entries[2] = {folder_of("pkg-1.0/"), random_file(data)};
    Extracted r = extract(io, "stored", gzip_stored(io, tar_of(io, entries, 2)));
    is_tree(io, "random data in stored blocks", &r, random_listing(io, data));
}

// The unchanged archives of the cases below, so that a refusal there is the changed byte's.
export void test_untar_tar_xz_of_random_data_under_each_check(io::Io *io) {
    same_tree(io, "tar.xz of random data (CRC-32)", "rand-crc32.tar.xz", random_tree);
    same_tree(io, "tar.xz of random data (CRC-64)", "rand-crc64.tar.xz", random_tree);
    same_tree(io, "tar.xz of random data (SHA-256)", "rand-sha256.tar.xz", random_tree);
}

export void test_untar_tar_xz_of_random_data_uncompressed_chunks(io::Io *io) {
    Bytes data = noise(io, 150000); // three chunks
    Entry entries[2] = {folder_of("pkg-1.0/"), random_file(data)};
    for (u8 check = 0; check < 2; check++) {
        Extracted r = extract(io, "stored", xz_stored(io, tar_of(io, entries, 2), check));
        is_tree(io,
                check == 0 ? "random data in uncompressed chunks (no check)"
                           : "random data in uncompressed chunks (CRC-32)",
                &r, random_listing(io, data));
    }
}

// File times are kept, to the second.
export void test_untar_a_file_keeps_its_modification_time(io::Io *io) {
    Extracted r = extract(io, "times", fixture(io, "a.tar.gz"));
    scratch::expect_contains("times: a file keeps its modification time", r.tree,
                             "hello.txt f 0644 14 7f26afeb 1000000000\n");
}

// Several top-level entries: the package is the extraction folder, as it was with tar.
export void test_untar_several_top_level_folders_are_kept_under_their_names(io::Io *io) {
    Entry entries[4] = {folder_of("one/"), file_of("one/a", "1\n"), folder_of("two/"), file_of("two/b", "2\n")};
    Extracted r = extract(io, "multi", gzip_stored(io, tar_of(io, entries, 4)));
    scratch::expect_text("several top-level folders: the package is the extraction folder",
                         folder_for_name(io, "multi"), r.contents);
    is_tree(io, "several top-level folders: both are kept under their names", &r,
            "one d\none/a f 0644 2 6751fc53 1000000000\ntwo d\ntwo/b f 0644 2 4c7caf90 1000000000\n");
}

// ---- 2. Long names: a ustar name split over its prefix and name fields, a pax path, a GNU long name, and non-ASCII
// names

static const char *repeat(io::Io *io, char letter, usize count) {
    char *text = arena::push_slice(&io->arena, char, count + 1).data;
    for (usize i = 0; i < count; i++)
        text[i] = letter;
    text[count] = '\0';
    return text;
}

// The listing of the long tree (pkg-1.0/aaaa.../bbbb.../cccc.../file.txt and pkg-1.0/ü/é.txt).
static const char *long_tree(io::Io *io) {
    const char *first = repeat(io, 'a', 80);
    const char *second = repeat(io, 'b', 80);
    const char *third = repeat(io, 'c', 80);
    return format::push(&io->arena, first, " d\n", first, "/", second, " d\n", first, "/", second, "/", third, " d\n",
                        first, "/", second, "/", third,
                        "/file.txt f 0644 5 279eb882 1000000000\n\xc3\xbc d\n\xc3\xbc/\xc3\xa9.txt f 0644 7 05685cb1 "
                        "1000000000\n")
        .data;
}

export void test_untar_long_names_pax(io::Io *io) {
    Extracted r = extract(io, "long", fixture(io, "long-pax.tar"));
    is_tree(io, "long names (pax)", &r, long_tree(io));
}

export void test_untar_long_names_gnu(io::Io *io) {
