static bool exists(io::Io *io, const char *path) {
    io::FileInfo info = io::files_info(&io->files, path);
    return info.error.code == 0;
}

// Nothing is written beside the extraction folder, whichever of them is extracted: not above it, not at an absolute
// path, and not through a symlink.
export void test_untar_hostile_archives_write_nothing_beside_the_extraction_folder(io::Io *io) {
    const char *scratch_folder = test::scratch(io);
    const char *absolute =
        "/tmp/smith-untar-abs-evil"; // a name field holds 100 bytes, which the scratch folder's is not
    Entry up[1] = {file_of("../evil", "x\n")};
    Entry deep[1] = {file_of("pkg-1.0/x/../../../evil", "x\n")};
    Entry away[1] = {file_of(absolute, "x\n")};
    Entry through[3] = {folder_of("pkg-1.0/"), link_of("pkg-1.0/self", '2', "."), file_of("pkg-1.0/self/under", "x\n")};
    test::check_equal(extract(io, "h-up", tar_of(io, up, 1)).ok, false);
    test::check_equal(extract(io, "h-deep", tar_of(io, deep, 1)).ok, false);
    test::check_equal(extract(io, "h-away", tar_of(io, away, 1)).ok, false);
    test::check_equal(extract(io, "h-through", tar_of(io, through, 3)).ok, false);
    test::check_equal(exists(io, join(io, scratch_folder, "/evil")), false);
    test::check_equal(exists(io, join(io, scratch_folder, "/h-deep/evil")), false);
    test::check_equal(exists(io, absolute), false);
    test::check_equal(exists(io, join(io, folder_for_name(io, "h-through"), "/pkg-1.0/under")), false);
}

// A symlink that stays in its top-level folder is fine, and one that reaches the folder above it is refused only when
// the package is that one folder, since it then leaves the package.
export void test_untar_symlinks_one_inside_the_package_is_kept(io::Io *io) {
    Entry entries[4] = {folder_of("pkg-1.0/a/"), folder_of("pkg-1.0/a/b/"), file_of("pkg-1.0/a/data", "data\n"),
                        link_of("pkg-1.0/a/b/inside", '2', "../data")};
    Extracted r = extract(io, "inside", tar_of(io, entries, 4));
    scratch::expect_text("symlinks: the archive extracts", "", r.ok ? "" : r.error);
    scratch::expect_contains("symlinks: one inside the package is kept", r.tree, "a/b/inside l -> ../data\n");
}

export void test_untar_symlinks_one_that_leaves_the_single_top_level_folder_is_refused(io::Io *io) {
    Entry entries[4] = {folder_of("pkg-1.0/a/"), folder_of("pkg-1.0/a/b/"), file_of("pkg-1.0/a/data", "data\n"),
                        link_of("pkg-1.0/a/b/sibling", '2', "../../../other")};
    refuses(io, "symlinks: one that leaves the single top-level folder", tar_of(io, entries, 4),
            "points outside the package folder");
}

export void test_untar_symlinks_the_same_link_beside_a_second_top_level_entry_is_kept(io::Io *io) {
    Entry entries[5] = {folder_of("pkg-1.0/a/"), folder_of("pkg-1.0/a/b/"),
                        link_of("pkg-1.0/a/b/sibling", '2', "../../../other"), folder_of("other/"),
                        file_of("other/x", "x\n")};
    Extracted r = extract(io, "second", tar_of(io, entries, 5));
    scratch::expect_text("symlinks: the archive extracts", "", r.ok ? "" : r.error);
    scratch::expect_contains("symlinks: the same link beside a second top-level entry is kept", r.tree,
                             "pkg-1.0/a/b/sibling l -> ../../../other\n");
}

// Hard links to an earlier entry.
export void test_untar_hard_links_both_names_have_the_bytes(io::Io *io) {
    Entry entries[3] = {folder_of("pkg-1.0/"), file_of("pkg-1.0/one", "shared\n"),
                        link_of("pkg-1.0/two", '1', "pkg-1.0/one")};
    Extracted r = extract(io, "hard", tar_of(io, entries, 3));
    scratch::expect_text("hard links: both names have the bytes",
                         "one f 0644 7 6e77e063 1000000000\n"
                         "two f 0644 7 6e77e063 1000000000\n",
                         r.tree);
}

// macOS tar writes extended attributes as "._name" entries in the AppleDouble format and bsdtar turns them back into
// attributes, so they never become files, and the package is still one folder. smith drops them too, by the format's
// magic number; a "._" file of anything else is a file like any other.
static Bytes apple_tar(io::Io *io) {
    const u8 magic[26] = {0x00, 0x05, 0x16, 0x07, 0x00, 0x02, 0x00, 0x00}; // the AppleDouble header, 26 bytes
    Entry entries[7] = {folder_of("pkg-1.0/"),
                        file_of("pkg-1.0/a", "first\n"),
                        {.name = "pkg-1.0/._a", .type = '0', .data = magic, .size = 26, .mode = 0o644},
                        file_of("pkg-1.0/b", "second\n"),
                        {.name = "pkg-1.0/._b", .type = '0', .data = magic, .size = 26, .mode = 0o644},
                        file_of("pkg-1.0/._plain", "a plain file that only has a name like metadata\n"),
                        file_of("pkg-1.0/._tiny", "tiny\n")};
    return tar_of(io, entries, 7);
}

static const char *apple_listing(io::Io *io) {
    const char *plain = "a plain file that only has a name like metadata\n";
    return format::push(&io->arena, "._plain f 0644 ", c::strlen(plain), " ",
                        format::hex(inflate::crc32(0, (const u8 *)plain, c::strlen(plain)), 8),
                        " 1000000000\n._tiny f 0644 5 ", format::hex(inflate::crc32(0, (const u8 *)"tiny\n", 5), 8),
                        " 1000000000\na f 0644 6 ", format::hex(inflate::crc32(0, (const u8 *)"first\n", 6), 8),
                        " 1000000000\nb f 0644 7 ", format::hex(inflate::crc32(0, (const u8 *)"second\n", 7), 8),
                        " 1000000000\n")
        .data;
}

export void test_untar_appledouble_entries_become_no_files(io::Io *io) {
    Extracted r = extract(io, "apple", apple_tar(io));
    is_tree(io, "AppleDouble entries become no files, and the package is still one folder", &r, apple_listing(io));
}

export void test_untar_appledouble_entries_in_a_tar_gz(io::Io *io) {
    Extracted r = extract(io, "apple", gzip_stored(io, apple_tar(io)));
    is_tree(io, "AppleDouble entries in a tar.gz: the same tree, modes and bytes", &r, apple_listing(io));
}

