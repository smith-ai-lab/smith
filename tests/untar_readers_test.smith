    is_tree(
        io, "long names (ustar prefix field)", &r,
        format::push(&io->arena, p, " d\n", p, "/", q, " d\n", p, "/", q, "/file f 0644 9 6a0d1daa 1000000000\n").data);
}

// ---- 3. Hostile archives, which no tar program writes: each is refused with the reason, and nothing is written
// outside the extraction folder.

static void hostile(io::Io *io, const char *name, Entry entry, const char *reason) {
    Entry entries[2] = {folder_of("pkg-1.0/"), entry};
    refuses(io, name, tar_of(io, entries, 2), reason);
}

export void test_untar_refuses_traversal(io::Io *io) {
    hostile(io, "traversal", file_of("../evil", "x\n"), "goes up out of the package");
}

export void test_untar_refuses_traversal_inside_a_path(io::Io *io) {
    hostile(io, "traversal inside a path", file_of("pkg-1.0/x/../../../evil", "x\n"), "goes up out of the package");
}

export void test_untar_refuses_a_name_that_is_dotdot(io::Io *io) {
    hostile(io, "a name that is ..", file_of("..", "x\n"), "goes up out of the package");
}

export void test_untar_refuses_an_absolute_path(io::Io *io) {
    hostile(io, "an absolute path", file_of("/tmp/smith-abs-evil", "x\n"), "absolute path");
}

export void test_untar_refuses_a_symlink_out_of_the_package(io::Io *io) {
    hostile(io, "a symlink out of the package", link_of("pkg-1.0/escape", '2', "../../outside"),
            "points outside the package");
}

