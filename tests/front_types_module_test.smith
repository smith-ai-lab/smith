// Tests of modules as compile-time values in the checker (#1677 of #1428): `import a.b as m` binds a module, `m.name`
// is a public declaration of it, `let sin = m.sin` is a name for the same function, and a module cannot be a run-time
// value. Each scenario is source text in smith's own syntax; the imported modules are the `modules` table, read by
// the loader the checker is given.
module front_types_module_test;

import front::ast;
import front::lex;
import front::parse;
import front::parse_decl;
import front::parse_expr;
import front::parse_stmt;
import front::parse_type;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;
import <string.h>;

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        Bool same = true;
        for (Usize k = 0; k < countof(needle); k++) {
            if (text[i + k] != needle[k]) {
                same = false;
                break;
            }
        }
        if (same) return true;
    }
    return false;
}

static Bool same(Str a, Str b) {
    return countof(a) == countof(b) && has(a, b);
}

static Str join(Str a, Str b) {
    char out[:] = mem::alloc_slice(char, countof(a) + countof(b));
    for (Usize i = 0; i < countof(a); i++) {
        out[i] = a[i];
    }
    for (Usize i = 0; i < countof(b); i++) {
        out[countof(a) + i] = b[i];
    }
    return out;
}

// The modules a scenario can import, by dotted path.
static Str math_source() {
    return "pub fn sin(x: f64) -> f64 {\n    x\n}\n\n"
           "pub fn twice(x: f64) -> f64 {\n    x + x\n}\n\n"
           "fn hidden() -> i32 {\n    1\n}\n\n"
           "pub let tau = 6.28\n\n"
           "pub struct Point {\n    pub x: f64\n    pub y: f64\n}\n\n"
           "pub struct Handle {\n    pub len: i32\n    items: i32\n}\n\n"
           "pub fn handle() -> Handle {\n    return Handle(len = 1, items = 2)\n}\n\n"
           "pub fn origin() -> Point {\n    return Point(x = 0.0, y = 0.0)\n}\n";
}

static Str re_source() {
    return "pub import lib.math\n\npub fn one() -> i32 {\n    1\n}\n";
}

static Str cycle_source() {
    return "pub import lib.cycle as other\n\npub fn here() -> i32 {\n    1\n}\n";
}

static const ast::Module *load(const char *name) {
    Str path = name[0:c::strlen(name)];
    Str source = "";
    if (same(path, "lib.math"))
        source = math_source();
    else if (same(path, "lib.re"))
        source = re_source();
    else if (same(path, "lib.cycle"))
        source = cycle_source();
    else
        return nullptr;
    parser::Parsed p = parser::parse_new("t.smith", source);
    if (countof(p.errors) > 0) {
        Str expected = "no error";
        test::check_equal(p.errors[0].message, expected);
    }
    ast::Module *copy = mem::alloc(ast::Module);
    *copy = p.module;
    return copy;
}

static types::Checked check_text(Str source) {
    parser::Parsed p = parser::parse_new("t.smith", source);
    test::check_equal(countof(p.errors), (Usize)0);
    return types_decl::check_module_with(&p.module, types::lp64(), load);
}

static Str errors_of(const types::Checked *r) {
    Str text = "";
    for (Usize i = 0; i < r->error_count; i++) {
        text = join(text, join(r->errors[i].message, "\n"));
    }
    return text;
}

static void clean(Str source) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_text(source);
    Str none = "";
    if (r.error_count > 0) test::check_equal(errors_of(&r), none);
    test::check_equal(r.error_count, (Usize)0);
}

static void fails(Str source, Str first, Str second) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    types::Checked r = check_text(source);
    Str errors = errors_of(&r);
    Str one = "one error";
    if (r.error_count != 1) test::check_equal(errors, one);
    test::check_equal(r.error_count, (Usize)1);
    test::check_condition(has(errors, first));
    test::check_condition(has(errors, second));
}

export void test_front_types_module_function_through_the_module() {
    clean("import lib.math as m\n\nfn run() -> f64 {\n    m.sin(1.0)\n}\n");
}

export void test_front_types_module_call_checks_arguments() {
    fails("import lib.math as m\n\nfn run() -> f64 {\n    m.sin(true)\n}\n", "found Bool", "expected F64");
}

export void test_front_types_module_constant_and_result_type() {
    clean("import lib.math as m\n\nfn run() -> f64 {\n    m.tau + m.twice(1.0)\n}\n");
    fails("import lib.math as m\n\nfn run() -> str {\n    return m.tau\n}\n", "F64", "Str");
}

export void test_front_types_module_type_through_the_module() {
    clean("import lib.math as m\n\nfn run(p: m.Point) -> f64 {\n    p.x\n}\n");
    clean("import lib.math as m\n\nfn run() -> m.Point {\n    m.origin()\n}\n");
}

export void test_front_types_module_function_alias_is_a_constant() {
    clean("import lib.math as m\nlet sin = m.sin\n\nfn run() -> f64 {\n    sin(1.0)\n}\n");
    fails("import lib.math as m\nlet sin = m.sin\n\nfn run() -> f64 {\n    sin(true)\n}\n", "Bool", "F64");
}

export void test_front_types_module_type_alias_is_the_same_type() {
    clean("import lib.math as m\nlet Point = m.Point\n\nfn run(p: Point) -> f64 {\n    p.x\n}\n\n"
          "fn make() -> m.Point {\n    m.origin()\n}\n\nfn go() -> f64 {\n    run(make())\n}\n");
}

export void test_front_types_module_reexport_is_a_module_too() {
    clean("import lib.re as r\n\nfn run() -> f64 {\n    r.math.sin(1.0)\n}\n\nfn other() -> i32 {\n    r.one()\n}\n");
}

export void test_front_types_module_a_cycle_ends() {
    clean("import lib.cycle as c\n\nfn run() -> i32 {\n    c.other.here()\n}\n");
}

export void test_front_types_module_missing_name_names_the_module() {
    fails("import lib.math as m\n\nfn run() -> f64 {\n    m.sinn(1.0)\n}\n", "`lib.math` has no public `sinn`",
          "did you mean `sin`?");
}

export void test_front_types_module_private_name_is_missing() {
    fails("import lib.math as m\n\nfn run() -> i32 {\n    m.hidden()\n}\n", "`lib.math` has no public `hidden`", "");
}

export void test_front_types_module_missing_module_is_reported() {
    fails("import lib.nothing as m\n", "cannot find the module `lib.nothing`", "");
}

export void test_front_types_module_is_not_a_run_time_value() {
    fails("import lib.math as m\n\nfn run() {\n    let mut x = m\n}\n", "known only at compile time", "`m`");
    fails("import lib.math as m\n\nfn take(x: i32) {}\n\nfn run() {\n    take(m)\n}\n", "known only at compile time",
          "`m`");
}

export void test_front_types_module_local_cannot_shadow_it() {
    fails("import lib.math as m\n\nfn run() -> i32 {\n    let m = 1\n    return 1\n}\n", "hides the module `m`",
          "shadowing is an error");
}

export void test_front_types_module_pub_field_is_visible_outside() {
    clean("import lib.math as m\n\nfn run(h: m.Handle) -> i32 {\n    h.len\n}\n");
    clean("import lib.math as m\n\nfn run() -> i32 {\n    let mut h: m.Handle = undefined\n    return "
          "m.handle().len\n}\n");
}

export void test_front_types_module_private_field_is_an_error_outside() {
    fails("import lib.math as m\n\nfn run(h: m.Handle) -> i32 {\n    h.items\n}\n", "items is private to lib.math",
          "mark it pub or call a function of lib.math");
}

export void test_front_types_module_a_struct_with_a_private_field_is_built_only_by_its_module() {
    // named or positional, with the private field or without it: only a function of the module builds it
    fails("import lib.math as m\nlet Handle = m.Handle\n\nfn run() -> m.Handle {\n    return Handle(len = 1, items = "
          "2)\n}\n",
          "`lib::math::Handle` has private fields; build it with a function of `lib.math`: `handle`", "");
    fails("import lib.math as m\nlet Handle = m.Handle\n\nfn run() -> m.Handle {\n    return Handle(len = 1)\n}\n",
          "has private fields; build it with a function of `lib.math`: `handle`", "");
    fails("import lib.math as m\nlet Handle = m.Handle\n\nfn run() -> m.Handle {\n    return Handle()\n}\n",
          "has private fields; build it with a function of `lib.math`: `handle`", "");
    fails("import lib.math as m\nlet Handle = m.Handle\n\nfn run() -> m.Handle {\n    return Handle(1, 2)\n}\n",
          "has private fields; build it with a function of `lib.math`: `handle`", "");
    clean("import lib.math as m\n\nfn run() -> m.Handle {\n    return m.handle()\n}\n");
}

export void test_front_types_module_a_struct_of_pub_fields_is_built_anywhere() {
    clean(
        "import lib.math as m\nlet Point = m.Point\n\nfn run() -> m.Point {\n    return Point(x = 1.0, y = 2.0)\n}\n");
    clean("import lib.math as m\nlet Point = m.Point\n\nfn run() -> m.Point {\n    return Point(1.0, 2.0)\n}\n");
    clean("import lib.math as m\nlet Point = m.Point\n\nfn run() -> m.Point {\n    return Point(1.0, y = 2.0)\n}\n");
}

export void test_front_types_module_own_fields_are_all_visible() {
    clean("pub struct List {\n    pub len: i32\n    items: i32\n}\n\npub fn make() -> i32 {\n"
          "    let l = List(len = 1, items = 2)\n    return l.items\n}\n");
}

export void test_front_types_module_pub_field_of_a_private_struct_is_an_error() {
    fails("struct List {\n    pub len: i32\n}\n", "the field `len` is `pub`, but `List` is not",
          "mark the struct `pub`");
}

export void test_from_makes_a_name_callable_bare() {
    clean("from lib.math import sin, twice\n\nfn run() -> f64 {\n    sin(1.0) + twice(2.0)\n}\n");
}

export void test_from_makes_a_type_usable_bare() {
    clean("from lib.math import Point\n\nfn run(p: Point) -> f64 {\n    p.x\n}\n");
}

export void test_from_names_a_missing_or_private_name() {
    fails("from lib.math import sinn\n", "`lib.math` has no public `sinn`", "");
    fails("from lib.math import hidden\n", "`lib.math` has no public `hidden`", "");
}

export void test_from_shadowing_a_declared_name_is_an_error() {
    fails("from lib.math import sin\n\nfn sin(x: f64) -> f64 {\n    x\n}\n", "`sin` is declared twice", "");
}

export void test_two_imports_binding_one_name_are_an_error() {
    fails("import lib.math\nimport lib.re as math\n", "`math` is declared twice", "");
}

// Defaults (#1847): a field's and a parameter's, constant, in order, and what a construction or a call may leave out.
export void test_front_types_module_defaults_fill_what_a_construction_or_a_call_leaves_out() {
    clean("struct Config {\n    port: i32 = 80\n    debug: bool = false\n}\n\nfn run() -> Config {\n    return "
          "Config()\n}\n");
    clean("struct Config {\n    port: i32 = 80\n    debug: bool = false\n}\n\nfn run() -> Config {\n    "
          "return Config(debug = true)\n}\n");
    clean("fn connect(host: i32, port: i32 = 443) -> i32 {\n    host + port\n}\n\nfn run() -> i32 {\n    "
          "connect(1) + connect(1, 2) + connect(1, port = 3)\n}\n");
}

export void test_front_types_module_a_missing_field_without_a_default_is_an_error() {
    fails("struct Config {\n    host: i32\n    port: i32 = 80\n}\n\nfn run() -> Config {\n    return Config()\n}\n",
          "the field `host` of `Config` is left out and has no default", "");
}

export void test_front_types_module_a_default_must_be_a_constant_in_order() {
    fails("fn size() -> i32 {\n    3\n}\n\nstruct Box {\n    n: i32 = size()\n}\n",
          "a default must be a compile-time constant", "");
    fails("fn f(a: i32, b: i32 = a) -> i32 {\n    b\n}\n", "a default must be a compile-time constant", "");
    fails("fn f(a: i32 = 1, b: i32) -> i32 {\n    b\n}\n", "has no default but follows one that has", "");
}
