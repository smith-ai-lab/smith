module front_emit_toplevel_test;

import front::ast;
import front::emit;
import front::emit_jit;
import front::emit_state;
import front::lex;
import front::parse;
import front::parse_decl;
import front::parse_expr;
import front::parse_stmt;
import front::parse_type;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;
import <llvm-c/Core.h>;

typedef I32 (*Narrow)(I32);
typedef U32 (*Byte)(U8);
typedef I64 (*Unsigned)(U32);
typedef I64 (*Wide)(I32);

typedef U64 (*Mask)();
typedef Usize (*Count)(Usize);
typedef I64 (*Gap)(const U32 *, const U32 *);

struct Scenario {
    arena::Arena memory;
    arena::ArenaAllocator allocator;
    parser::Parsed parsed;
    types::Checked checked;
    Bool has_checked;
};

static void begin(Scenario *s, Str source, Bool with_checker) {
    s->memory = test::memory(1U << 22);
    s->allocator = arena::allocator(&s->memory);
    mem::Allocator *outside = mem::set_allocator(&s->allocator.base);
    s->parsed = parser::parse_new("t.smith", source);
    test::check_equal(countof(s->parsed.errors), (Usize)0);
    if (with_checker) {
        s->checked = types_decl::check_module(&s->parsed.module, types::lp64());
        s->has_checked = true;
        test::check_equal(s->checked.error_count, (Usize)0);
    }
    mem::set_allocator(outside);
}

static emit::Options options_for(emit::Target target, const Scenario *s) {
    emit::Options options = {};
    options.target = target;
    if (s->has_checked) options.checked = &s->checked;
    return options;
}

static emit_jit::Jit start_jit() {
    emit_jit::JitResult started = emit_jit::start();
    test::check_equal(started == .ok, true);
    emit_jit::Jit host = {};
    if (started == .ok) host = started.ok;
    return host;
}

static Usize symbol_of(emit_jit::Jit *host, Str symbol) {
    emit_jit::AddressResult found = emit_jit::lookup(host, symbol);
    test::check_equal(found == .ok, true);
    Usize address = 0;
    if (found == .ok) address = found.ok;
    return address;
}

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        Bool same = true;
        for (Usize k = 0; k < countof(needle); k++) {
            if (text[i + k] != needle[k]) {
                same = false;
                break;
            }
        }
        if (same) return true;
    }
    return false;
}

// Emits `source` and JITs it into `host`; on an error its message must contain `want`.
static Bool emits(Str source, emit_jit::Jit *host, Scenario *s, Str want) {
    begin(s, source, true);
    c::LLVMContextRef context = c::LLVMContextCreate();
    emit::ModuleResult emitted = emit::module(context, &s->parsed.module, options_for(host->target, s));
    Bool ok = emitted == .ok;
    if (emitted == .ok) {
        emit_jit::BoolResult added = emit_jit::add(host, context, emitted.ok);
        test::check_equal(added == .ok, true);
    } else {
        test::check_equal(has(emitted.error.message, want), true);
        emit::free_error(emitted.error);
        c::LLVMContextDispose(context);
    }
    return ok;
}

// #2510: a module-level `static_assert` folds over `const` names and `sizeof`; a global's initializer may be built
// from them (`~0.to(u64)`); `++`/`--` and the difference of two pointers emit.
export void test_front_emit_toplevel_static_assert_consts_increments_and_pointer_difference() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    Bool ok = emits("struct Pair:\n"
                    "    low: u32\n"
                    "    high: u32\n"
                    "const word: usize = 8\n"
                    "const mask: u64 = ~0.to(u64)\n"
                    "static_assert(word == sizeof(Pair), \"a word\");\n"
                    "static_assert((word & (word - 1)) == 0);\n"
                    "pub fn mask_low() -> u64:\n"
                    "    mask >> 56\n"
                    "pub fn countdown(n: usize) -> usize:\n"
                    "    mut left: usize = n\n"
                    "    mut steps: usize = 0\n"
                    "    while left-- > 0:\n"
                    "        steps += 1\n"
                    "    steps\n"
                    "pub fn gap(a: *u32, b: *u32) -> isize:\n"
                    "    a - b\n",
                    &host, &s, "");
    test::check_equal(ok, true);
    if (ok) {
        U32 words[4] = {};
        test::check_equal(((Mask)symbol_of(&host, "mask_low"))(), (U64)255);
        test::check_equal(((Count)symbol_of(&host, "countdown"))(5), (Usize)5);
        test::check_equal(((Gap)symbol_of(&host, "gap"))(&words[3], &words[1]), (I64)2);
    }
    emit_jit::stop(&host);
}

// #2643: a module-level `static_assert` over `target` numbers and `&&`/`||` folds.
export void test_front_emit_toplevel_static_assert_folds_target_facts_and_logic() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    Bool ok = emits("static_assert(target.float_radix == 2 && target.f32_mantissa_bits == 24, \"floats\");\n"
                    "static_assert(target.float_eval_method == 0 || false, \"f32\");\n"
                    "pub fn one() -> u32:\n"
                    "    1\n",
                    &host, &s, "");
    test::check_equal(ok, true);
    emit_jit::stop(&host);
}

export void test_front_emit_toplevel_a_false_static_assert_stops_with_its_message() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    Bool ok = emits("const n: usize = 3\n"
                    "static_assert(n == 4, \"n is four\");\n",
                    &host, &s, "n is four");
    test::check_equal(ok, false);
    emit_jit::stop(&host);
}

// #2643: a function's name given to a `fn` parameter is wrapped (a `fn` value's code takes a context first), a `fn`
// value compares with `nullptr`, a `?*T` name narrowed by `!= .none` reads its fields through the pointer, and a
// struct may point to one declared below it.
export void test_front_emit_toplevel_function_names_fn_nullptr_option_fields_and_forward_pointers() {
    Scenario s = {};
    emit_jit::Jit host = start_jit();
    Bool ok = emits("struct Head:\n"
                    "    first: ?*Cell\n"
                    "struct Cell:\n"
                    "    value: i32\n"
                    "fn add_one(x: i32) -> i32:\n"
                    "    x + 1\n"
                    "fn apply(f: fn(i32) -> i32, x: i32) -> i32:\n"
                    "    f(x)\n"
                    "pub fn through(x: i32) -> i32:\n"
                    "    apply(add_one, x)\n"
                    "pub fn present(f: fn(i32) -> i32) -> bool:\n"
                    "    f != nullptr\n"
                    "pub fn value_of(head: *Head) -> i32:\n"
                    "    cell := head.first\n"
                    "    if cell != .none:\n"
                    "        return cell.value\n"
                    "    -1\n",
                    &host, &s, "");
    test::check_equal(ok, true);
    if (ok) test::check_equal(((Narrow)symbol_of(&host, "through"))(41), (I32)42);
    emit_jit::stop(&host);
}
