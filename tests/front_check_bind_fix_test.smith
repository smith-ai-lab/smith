// The fix for a payload read after a variant test (#2494): `if k == .v:` with `k.v` is `if .v(v) := k:` with `v`, a
// `match` arm `.v:` that reads `k.v` is `.v(v):`; a variable of that name in scope leaves the site as it is.
module front_check_bind_fix_test;

import front::fix;
import std::arena;
import std::format;
import std::mem;
import std::test;

static void expect(Str before, Str after) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed first = fix::fix_text("t.smith", before);
    test::check_equal(first.text, after);
    fix::Fixed again = fix::fix_text("t.smith", first.text);
    test::check_equal(again.text, after);
}

static Str shape_text() {
    return "enum Shape:\n    circle: i32\n    square: i32\n    empty\n";
}

export void test_front_check_bind_fix_an_equality_test_binds_the_payload() {
    char before[:] = format::push(
        shape_text(), "fn area(s: Shape) -> i32:\n    if s == .circle:\n        return s.circle * 2\n    0\n");
    char after[:] = format::push(
        shape_text(), "fn area(s: Shape) -> i32:\n    if .circle(circle) := s:\n        return circle * 2\n    0\n");
    expect(before, after);
}

export void test_front_check_bind_fix_a_match_arm_binds_the_payload() {
    char before[:] = format::push(shape_text(), "fn area(s: Shape) -> i32:\n    match s:\n        .circle: s.circle\n  "
                                                "      .square: s.square\n        .empty: 0\n");
    char after[:] = format::push(shape_text(), "fn area(s: Shape) -> i32:\n    match s:\n        .circle(circle): "
                                               "circle\n        .square(square): square\n        .empty: 0\n");
    expect(before, after);
}

export void test_front_check_bind_fix_a_name_in_scope_does_not_matter_for_is() {
    char site[:] = format::push(
        shape_text(),
        "fn area(s: Shape, circle: i32) -> i32:\n    if s == .circle:\n        return s.circle * 2\n    circle\n");
    char after[:] = format::push(
        shape_text(),
        "fn area(s: Shape, circle: i32) -> i32:\n    if s is .circle:\n        return s * 2\n    circle\n");
    expect(site, after);
}

// `if k != .v: return` binds the rest of the block (#2503).
export void test_front_check_bind_fix_a_guard_that_returns_binds_the_rest() {
    char before[:] = format::push(
        shape_text(), "fn area(s: Shape) -> i32:\n    if s != .circle:\n        return 0\n    s.circle * 2\n");
    char after[:] = format::push(
        shape_text(), "fn area(s: Shape) -> i32:\n    .circle(circle) := s else:\n        return 0\n    circle * 2\n");
    expect(before, after);
}

// `if !(k == .v): return X` is the same guard as `if k != .v: return X`.
export void test_front_check_bind_fix_a_negated_equality_guard_binds_the_rest() {
    char before[:] = format::push(
        shape_text(), "fn area(s: Shape) -> i32:\n    if not (s == .circle):\n        return 0\n    s.circle * 2\n");
    char after[:] = format::push(
        shape_text(), "fn area(s: Shape) -> i32:\n    .circle(circle) := s else:\n        return 0\n    circle * 2\n");
    expect(before, after);
}

// In a chain `a || k != .v || b` the test stands alone, between `if a:` and `if b:`, which may read the payload.
export void test_front_check_bind_fix_a_guard_in_a_chain_stands_alone() {
    char before[:] = format::push(shape_text(), "fn area(s: Shape, n: i32) -> i32:\n    if n < 0 or s != .circle or ",
                                  "s.circle == 0: return 0\n    s.circle * n\n");
    char after[:] = format::push(shape_text(), "fn area(s: Shape, n: i32) -> i32:\n    if n < 0: return 0\n    ",
                                 ".circle(circle) := s else: return 0\n    if circle == 0: return 0\n    circle * n\n");
    expect(before, after);
}

// A guard inside a loop binds to the end of the loop's body; `continue` leaves.
export void test_front_check_bind_fix_a_guard_in_a_loop_binds_its_body() {
    char before[:] = format::push(shape_text(), "fn total(xs: []Shape) -> i32:\n    mut sum := 0\n    for s in xs:\n  ",
                                  "      if s != .square: continue\n        sum += s.square\n    sum\n");
    char after[:] = format::push(shape_text(), "fn total(xs: []Shape) -> i32:\n    mut sum := 0\n    for s in xs:\n  ",
                                 "      .square(square) := s else: continue\n        sum += square\n    sum\n");
    expect(before, after);
}

// A local of the binding's name declared later leaves the site as it is: the binding would hide it.
export void test_front_check_bind_fix_a_later_local_leaves_the_guard() {
    char site[:] = format::push(shape_text(), "fn area(s: Shape) -> i32:\n    if s != .circle: return 0\n    ",
                                "circle := s.circle\n    circle * 2\n");
    expect(site, site);
}

// A C `switch` whose last case ends without a `break`, and whose `break` is a loop's, is a `match` (#2503).
export void test_front_check_bind_fix_a_switch_whose_last_case_falls_off_is_a_match() {
    Str before =
        "module t;\n\nenum Color {\n    red,\n    green,\n};\n\nI32 f(Color c, I32 n) {\n    switch (c) {\n"
        "    case .red:\n        return 1;\n    case .green:\n        I32 k = n;\n"
        "        for (I32 i = 0; i < n; i++) {\n            if (i == k) break;\n        }\n        return k + n;\n"
        "    }\n}\n";
    Str after =
        "\nenum Color:\n    red\n    green\n\nfn f(c: Color, n: i32) -> i32:\n    match c:\n        .red: return 1\n"
        "        .green:\n            k: i32 = n\n            for i in range(0, n):\n                if i == k:\n"
        "                    break\n            return k + n\n        _: ()\n";
    expect(before, after);
}

// The propagate idiom on a Result is `try` (#2506): `r: Result(T, E) = f()` and `if r == .error: return {.error =
// r.error}` are `ok := try f()`, each `r.ok` is `ok`; a one-line cleanup becomes an `errdefer`.
static Str head_text() {
    return "fn step(n: i32) -> Result(i32, i32):\n    if n < 0:\n        return {.error = n}\n    {.ok = n}\n";
}

// What the fixer leaves of `head_text`: a returned `{.error = n}` is `.error(n)` (#2563), and so is the tail value
// `{.ok = n}` (#2575).
static Str head_after() {
    return "fn step(n: i32) -> Result(i32, i32):\n    if n < 0:\n        return .error(n)\n    .ok(n)\n";
}

export void test_front_check_bind_fix_try_the_propagate_idiom_is_try() {
    char before[:] =
        format::push(head_text(), "fn twice(n: i32) -> Result(i32, i32):\n    r: Result(i32, i32) = step(n)\n"
                                  "    if r == .error:\n        return {.error = r.error}\n"
                                  "    {.ok = r.ok * 2}\n");
    char after[:] = format::push(head_after(), "fn twice(n: i32) -> Result(i32, i32):\n    ok := try step(n)\n"
                                               "    .ok(ok * 2)\n");
    expect(before, after);
}

export void test_front_check_bind_fix_try_a_cleanup_becomes_an_errdefer() {
    char before[:] =
        format::push(head_text(), "fn twice(n: i32, log: *mut i32) -> Result(i32, i32):\n"
                                  "    r: Result(i32, i32) = step(n)\n"
                                  "    if r == .error:\n        log.* = 1\n        return {.error = r.error}\n"
                                  "    {.ok = r.ok * 2}\n");
    char after[:] = format::push(head_after(), "fn twice(n: i32, log: *mut i32) -> Result(i32, i32):\n"
                                               "    errdefer log.* = 1\n    ok := try step(n)\n"
                                               "    .ok(ok * 2)\n");
    expect(before, after);
}

// A guard that changes the error is not `try`: it is a binding with an else (fix_guard).
export void test_front_check_bind_fix_try_an_error_changed_on_the_way_stays() {
    char site[:] =
        format::push(head_text(), "fn twice(n: i32) -> Result(i32, i32):\n    r: Result(i32, i32) = step(n)\n"
                                  "    if r == .error:\n        return {.error = 0}\n"
                                  "    {.ok = r.ok * 2}\n");
    char kept[:] =
        format::push(head_after(), "fn twice(n: i32) -> Result(i32, i32):\n    r: Result(i32, i32) = step(n)\n"
                                   "    .ok(ok) := r else:\n        return .error(0)\n"
                                   "    .ok(ok * 2)\n");
    expect(site, kept);
}

// An `else if` chain of tests is one guard each: every `then` binds its own payload.
export void test_front_check_bind_fix_an_else_if_chain_binds_each_payload() {
    char before[:] = format::push(shape_text(), "fn area(s: Shape) -> i32:\n    if s == .circle:\n        s.circle\n  ",
                                  "  else if s == .square:\n        s.square\n    else:\n        0\n");
    char after[:] = format::push(shape_text(), "fn area(s: Shape) -> i32:\n    if .circle(circle) := s:\n        ",
                                 "circle\n    else if .square(square) := s:\n        square\n    else:\n        0\n");
    expect(before, after);
}

// A `match p.*:` reads the payload through the pointer, `p.v`: the arm binds it all the same.
export void test_front_check_bind_fix_a_match_on_a_pointer_binds_the_payload() {
    char before[:] = format::push(shape_text(), "fn area(p: *Shape) -> i32:\n    match p.*:\n        .circle: ",
                                  "p.circle\n        .square: p.square\n        .empty: 0\n");
    char after[:] = format::push(shape_text(), "fn area(p: *Shape) -> i32:\n    match p.*:\n        .circle(circle): ",
                                 "circle\n        .square(square): square\n        .empty: 0\n");
    expect(before, after);
}

// `if p.* == .v:` with `p.v` is `if .v(v) := p.*:` with `v`.
export void test_front_check_bind_fix_a_test_through_a_pointer_binds_the_payload() {
    char before[:] = format::push(
        shape_text(), "fn area(p: *Shape) -> i32:\n    if p.* == .circle:\n        return p.circle * 2\n    0\n");
    char after[:] = format::push(
        shape_text(), "fn area(p: *Shape) -> i32:\n    if .circle(circle) := p.*:\n        return circle * 2\n    0\n");
    expect(before, after);
}

// A write through the pointer, `p.* = x`, changes what the test read: the site stays as it is.
export void test_front_check_bind_fix_a_write_through_the_pointer_leaves_the_site() {
    char site[:] = format::push(shape_text(), "fn area(p: *mut Shape) -> i32:\n    if p.* == .circle:\n        p.* = ",
                                ".empty\n        return p.circle * 2\n    0\n");
    expect(site, site);
}

// A tail value that follows a nested block stays on a line of its own: the variant `.ok(n)` is not a call chain
// (#2575).
export void test_front_check_bind_fix_a_tail_variant_after_a_block_is_its_own_line() {
    expect("fn f(n: i32) -> Result(i32, i32):\n    if n < 0:\n        return {.error = n}\n    {.ok = n}\n",
           "fn f(n: i32) -> Result(i32, i32):\n    if n < 0:\n        return .error(n)\n    .ok(n)\n");
}

// A Result whose value is never read (#2552): `started` only guards, so the fix is a bare `try` statement.
export void test_front_check_bind_fix_try_an_unread_result_is_a_bare_try() {
    char before[:] =
        format::push(head_text(), "fn twice(n: i32, log: *mut i32) -> Result(i32, i32):\n    if n > 1:\n"
                                  "        r: Result(i32, i32) = step(n)\n        if r == .error:\n"
                                  "            log.* = 1\n            return {.error = r.error}\n    {.ok = n}\n");
    char after[:] = format::push(head_after(), "fn twice(n: i32, log: *mut i32) -> Result(i32, i32):\n"
                                               "    if n > 1:\n        errdefer log.* = 1\n        try step(n)\n"
                                               "    .ok(n)\n");
    expect(before, after);
}

// A test that starts an `&&` chain binds the payload for the rest of the chain and the body (D12).
export void test_front_check_bind_fix_a_test_that_starts_an_and_chain_binds_the_payload() {
    char before[:] = format::push(
        shape_text(),
        "fn big(s: Shape) -> i32:\n    if s == .circle and s.circle > 1:\n        return s.circle * 2\n    0\n");
    char after[:] = format::push(
        shape_text(),
        "fn big(s: Shape) -> i32:\n    if .circle(circle) := s and circle > 1:\n        return circle * 2\n    0\n");
    expect(before, after);
}

export void test_front_check_bind_fix_a_test_that_starts_an_and_chain_binds_a_while() {
    char before[:] = format::push(shape_text(), "fn count(s: Shape) -> i32:\n    mut n: i32 = 0\n    while s == "
                                                ".circle and n < s.circle:\n        n += 1\n    n\n");
    char after[:] = format::push(shape_text(), "fn count(s: Shape) -> i32:\n    mut n: i32 = 0\n    while "
                                               ".circle(circle) := s and n < circle:\n        n += 1\n    n\n");
    expect(before, after);
}

// A test that does not start the chain is written `is` where it stands (#3083, #3227): the conjuncts before it still
// run first. One with an `or` in the chain stays.
export void test_front_check_bind_fix_a_test_inside_an_and_chain_is_a_pattern() {
    char before[:] = format::push(
        shape_text(),
        "fn big(s: Shape, ok: bool) -> i32:\n    if ok and s == .circle and s.circle > 1:\n        return 1\n    0\n");
    char after[:] = format::push(shape_text(), "fn big(s: Shape, ok: bool) -> i32:\n"
                                               "    if ok and s is .circle and s > 1:\n        return 1\n    0\n");
    expect(before, after);
    char site[:] = format::push(shape_text(), "fn big(s: Shape, ok: bool) -> i32:\n"
                                              "    if ok or s == .circle and s.circle > 1:\n        return 1\n    0\n");
    expect(site, site);
}

// A Result read after a guard that leaves, in a function that already has the name `ok` (#3205): the binding is
// `ok_value`, for a guard written `!= .ok`, a guard written `== .error`, the `then` of a test and an `if` used as a
// value.
static Str steps_text() {
    return "fn step(n: i32) -> Result(i32, i32):\n    if n < 0:\n        return .error(n)\n    .ok(n)\n";
}

export void test_front_check_bind_fix_a_guard_binds_ok_value_where_ok_is_a_name() {
    char before[:] = format::push(steps_text(), "fn f(n: i32) -> i32:\n    ok := 1\n    r: Result(i32, i32) = step(n)\n"
                                                "    if r != .ok:\n        return 0\n    ok + r.ok\n");
    char after[:] = format::push(steps_text(), "fn f(n: i32) -> i32:\n    ok := 1\n    r: Result(i32, i32) = step(n)\n"
                                               "    .ok(ok_value) := r else:\n        return 0\n    ok + ok_value\n");
    expect(before, after);
}

export void test_front_check_bind_fix_a_guard_binds_ok_value_where_ok_is_declared_below() {
    char before[:] = format::push(steps_text(), "fn f(n: i32) -> i32:\n    r: Result(i32, i32) = step(n)\n"
                                                "    if r != .ok:\n        return 0\n    ok := 1\n    ok + r.ok\n");
    char after[:] =
        format::push(steps_text(), "fn f(n: i32) -> i32:\n    r: Result(i32, i32) = step(n)\n"
                                   "    .ok(ok_value) := r else:\n        return 0\n    ok := 1\n    ok + ok_value\n");
    expect(before, after);
}

export void test_front_check_bind_fix_the_then_of_a_test_binds_ok_value_where_ok_is_a_name() {
    char before[:] = format::push(steps_text(), "fn f(n: i32) -> i32:\n    ok := 1\n    r: Result(i32, i32) = step(n)\n"
                                                "    if r == .ok:\n        return ok + r.ok\n    0\n");
    char after[:] = format::push(steps_text(), "fn f(n: i32) -> i32:\n    ok := 1\n    r: Result(i32, i32) = step(n)\n"
                                               "    if .ok(ok_value) := r:\n        return ok + ok_value\n    0\n");
    expect(before, after);
}

export void test_front_check_bind_fix_an_if_used_as_a_value_binds_the_payload() {
    char before[:] = format::push(steps_text(), "fn f(n: i32) -> i32:\n    r: Result(i32, i32) = step(n)\n"
                                                "    if r == .ok: r.ok else: -1\n");
    char after[:] = format::push(steps_text(), "fn f(n: i32) -> i32:\n    r: Result(i32, i32) = step(n)\n"
                                               "    if .ok(ok) := r: ok else: -1\n");
    expect(before, after);
}

export void test_front_check_bind_fix_a_match_whose_error_arm_leaves_is_a_binding() {
    char before[:] =
        format::push(steps_text(), "fn f(n: i32) -> i32:\n    r: Result(i32, i32) = step(n)\n"
                                   "    match r:\n        .error:\n            use(1)\n            return 0\n"
                                   "        .ok: ()\n    r.ok\n");
    char after[:] = format::push(steps_text(), "fn f(n: i32) -> i32:\n    r: Result(i32, i32) = step(n)\n"
                                               "    .ok(ok) := r else:\n        use(1)\n        return 0\n    ok\n");
    expect(before, after);
}

// A test of a Result's error whose body is longer than a line (#3205): the arm is the block, one level deeper, and
// the value is read below it. Where `ok` or `value` is a name of the function, the value is `ok_value`.
export void test_front_check_bind_fix_a_longer_error_body_is_the_arm_block() {
    char before[:] =
        format::push(steps_text(), "fn f(n: i32) -> i32:\n    r: Result(i32, i32) = step(n)\n"
                                   "    if .error(error) := r:\n        use(error)\n        return 0\n    r.ok + 1\n");
    char after[:] = format::push(steps_text(), "fn f(n: i32) -> i32:\n    r: Result(i32, i32) = step(n)\n"
                                               "    ok := match r:\n        .ok(value): value\n        .error(error):\n"
                                               "            use(error)\n            return 0\n    ok + 1\n");
    expect(before, after);
    char taken[:] =
        format::push(steps_text(), "fn f(n: i32, ok: i32) -> i32:\n    r: Result(i32, i32) = step(n)\n"
                                   "    if .error(error) := r:\n        use(error)\n        return 0\n    r.ok + ok\n");
    char moved[:] =
        format::push(steps_text(), "fn f(n: i32, ok: i32) -> i32:\n    r: Result(i32, i32) = step(n)\n"
                                   "    ok_value := match r:\n        .ok(value): value\n        .error(error):\n"
                                   "            use(error)\n            return 0\n    ok_value + ok\n");
    expect(taken, moved);
}

// The name of the result in a string is not a mention of it (#3205).
export void test_front_check_bind_fix_a_string_that_says_the_name_is_not_a_mention() {
    char before[:] = format::push(
        steps_text(), "fn f(n: i32) -> i32:\n    back: Result(i32, i32) = step(n)\n"
                      "    if back == .error:\n        use(\"cannot read back\")\n        return 0\n    back.ok\n");
    char after[:] = format::push(
        steps_text(), "fn f(n: i32) -> i32:\n    back: Result(i32, i32) = step(n)\n"
                      "    .ok(ok) := back else:\n        use(\"cannot read back\")\n        return 0\n    ok\n");
    expect(before, after);
}
