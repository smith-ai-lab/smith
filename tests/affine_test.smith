// `[[smith::affine]]` (shim/affine.cpp; skill smith-lang-affine): a value of an affine type is used at most once, a
// compile error at the second use naming the first. Each tests/affine/*.c and *.smith is compiled with `smith cc -c`
// and what it prints (the status, then each error and note, the path left off) is the golden file beside it,
// `<file>.expected`: the rules (a second use, an unused value, `&key`, a join, an assignment, an element of an array, a
// member, the plain loop, any other loop or index, a call that fills an array) and the issue's use cases, in C and in
// `.smith` (and the slices, which are `.smith` only). The editor's case: `smith lsp --check` of one C and one `.smith`
// file shows the error. The enum_* files are the narrowing of a payload enum (#198): a read of `x.circle` is an error
// unless every path tested `x == .circle` or switched on x; an assignment, `&x` or a call with the pointer ends it;
// plain C is left alone. A file added to tests/affine needs a test here: `test_every_file_has_a_test` says which. A
// test makes its project, then sets its own memory as the current allocator: what scratch returns to it (a Run's texts)
// is given back with that memory, and scratch::clean frees what make holds.
module affine_test;

import smith::arena;
import smith::format;
import smith::mem;
import smith::test;
import <string.h>;
import scratch;

static typeof(const char[:]) slice_of(const char *text) {
    return text[0:c::strlen(text)];
}

constexpr usize memory_size = (usize)16 << 20; // 16 MiB

// What a compile of the file prints, as tests/affine/<file>.expected holds it.
static void affine_case(const char *file) {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, "tests/affine", "tests/affine");
    const char *command =
        format::push("cd tests/affine && { smith cc -std=gnu2y -I \"$SMITH_REPO/.smith/include\" -c ", file,
                     " -o /dev/null >../../compile.out 2>&1; echo \"status $?\"; grep -E '^[^ ]+:[0-9]+:[0-9]+: "
                     "(error|note|warning):' ../../compile.out; }")
            .data;
    scratch::Run run = scratch::sh(&p, command);
    test::golden(slice_of(format::push("tests/affine/", file, ".expected").data), slice_of(run.out));
}

// The editor: clangd shows the error, for C and for `.smith`.
static void affine_editor(const char *file, const char *message) {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, "tests/affine", "tests/affine");
    scratch::Run run =
        scratch::sh(&p, format::push("timeout -s KILL 120 smith lsp --check=tests/affine/", file, " 2>&1").data);
    scratch::expect_contains(file, run.out, message);
}

export void test_every_file_has_a_test() {
    const char *untested =
        scratch::untested_names("tests/affine", "tests/affine_test.smith", "affine_case(", ".c", ".smith");
    defer scratch::release(untested);
    scratch::expect_text("files of tests/affine with no test", "", untested);
}

export void test_lsp_second_use_c() {
    affine_editor("affine_second_use.c", "smith-affine: 'key' is used again");
}

export void test_lsp_second_use_smith() {
    affine_editor("affine_second_use.smith", "smith-affine: 'key' is used again");
}

// The narrowing of a payload enum (#198) shows in the editor too, for C and for `.smith` (clangd hung on the latter
// until #227).
export void test_lsp_enum_tagged_c() {
    affine_editor("enum_tagged.c", "smith-enum: 's.circle' is read where");
}

export void test_lsp_enum_read_unchecked_smith() {
    affine_editor("enum_read_unchecked.smith", "smith-enum: 's.circle' is read where");
}

