// Tests of front::parser (#1219, A6 of track A of #1112): the whole parser on the language corpus. Every `.smith` file
// of every case folder of tests/smith-lang/cases (the corpus is the specification) is read with `parser::parse`, and
// each has one outcome. The golden is one file a case, tests/front/parser/cases/<case>.txt, holding that case's lines
// (`path: outcome`, the path relative to the case's `src`) and nothing else, so two changes to different cases never
// touch the same file (#1352):
//
//   ok                  parsed with no error; its dump is not empty and a second parse gives the same dump
//   error: <message> (line:column) [class]
//                       the parser's first error; the class tag names why the file is rejected (below)
//   C, out of scope     no `module` line, or a `#` line: C under the C rule, reported and not parsed
//   skipped: <reason>   only for a decision not yet made; the reason names the issue
//
// The classes of a rejected file, written on its line: gap_a1 and gap_a2 (a gap in the parsers of A3 to A5, reported
// to the track A orchestrator), removed_b (a construct the plan removed that the corpus still spells: the corpus
// stays, today's lowering reads it), undecided_c (a construct the plan has not decided, reported to the lead) and
// must_fail_d (a case that is meant to fail to parse). A rejected file with no class, a class on a file that parses
// or is C, and a class that is not one of the five fail the test; a change to the parsers shows in the goldens.
//
// FRONT_UPDATE=1 rewrites only the case files whose text changed and removes the file of a case that is gone. It keeps
// each class from the file on disk; a newly rejected file gets none, so the test fails until a human adds one. There is
// no total in any file: the test prints the totals. (`smith test --update` is not available for test-front yet.) Cases
// that mix a `.smith` file with other files: only the `.smith` files are read.
module front_parser_test;

import front::ast;
import front::parser;
import std::arena;
import std::console;
import std::env;
import std::files;
import std::format;
import std::mem;
import std::slice;
import std::test;

// Whether the text is one of the five classes of a rejected file.
static Bool known_class(Str tag) {
    Str a1 = "gap_a1";
    Str a2 = "gap_a2";
    Str removed = "removed_b";
    Str undecided = "undecided_c";
    Str must_fail = "must_fail_d";
    return slice::equal(tag, a1) || slice::equal(tag, a2) || slice::equal(tag, removed) ||
           slice::equal(tag, undecided) || slice::equal(tag, must_fail);
}

// The class written at the end of the path's line in the text of a case file (`... (3:5) [gap_a1]`), or nothing.
static Str class_tag(Str old, Str name) {
    Usize line = 0;
    while (line < countof(old)) {
        Usize end = line;
        while (end < countof(old) && old[end] != '\n')
            end += 1;
        Str text = old[line:end];
        Bool mine =
            countof(text) > countof(name) && slice::equal(text[0:countof(name)], name) && text[countof(name)] == ':';
        if (mine && text[countof(text) - 1] == ']') {
            Usize open = countof(text) - 1;
            while (open > 0 && text[open] != '[')
                open -= 1;
            return text[open + 1:countof(text) - 1];
        }
        if (mine) break;
        line = end + 1;
    }
    Str none = "";
    return none;
}

// A file's text, or nothing when it cannot be read.
static format::Chars read_text(Str path) {
    files::BytesResult read = files::read_file(path);
    format::Chars nothing = {};
    if (read == .error) return nothing;
    format::Chars text = mem::view(read.ok, char);
    return text;
}

// Whether a line of the text starts (after blanks) with the prefix.
static Bool has_line_starting(Str text, Str prefix) {
    Usize i = 0;
    while (i < countof(text)) {
        while (i < countof(text) && (text[i] == ' ' || text[i] == '\t'))
            i += 1;
        Bool match = i + countof(prefix) <= countof(text) && slice::equal(text[i:i + countof(prefix)], prefix);
        if (match) return true;
        while (i < countof(text) && text[i] != '\n')
            i += 1;
        i += 1;
    }
    return false;
}

// A folder of a case still to read.
struct Folder {
    Str path;
};

struct Tally {
    Usize total;
    Usize ok;
    Usize error;
    Usize c;
    Usize skipped;
    Usize tagged;   // errors with a class
    Usize untagged; // errors with no class, or one that is not a class
    Usize stale;    // a class on a line whose file now parses or is C
    Usize unstable; // `ok` files that dump nothing or dump differently the second time
    Usize changed;  // case files rewritten (FRONT_UPDATE) or removed
    Usize orphans;  // case files of a case with no `.smith` file or no case folder
};

// The text of the case file being built.
struct Report {
    arena::Arena *work; // the memory of one file's parse, reset after each file
    mem::Allocator *work_base;
    char text[:];
    Usize used;
    Str previous; // the case file on disk, from which the classes are kept
};

static void append(Report *report, Str piece) {
    Usize room = countof(report->text) - report->used;
    test::check_condition(countof(piece) <= room);
    if (countof(piece) > room) return;
    for (Usize i = 0; i < countof(piece); i++) {
        report->text[report->used + i] = piece[i];
    }
    report->used += countof(piece);
}

// The row and column of a byte of the source, counted from 1.
static Usize row_of(Str source, U32 where) {
    Usize row = 1;
    for (Usize i = 0; i < where && i < countof(source); i++)
        row += source[i] == '\n' ? 1 : 0;
    return row;
}

static Usize column_of(Str source, U32 where) {
    Usize column = 1;
    for (Usize i = 0; i < where && i < countof(source); i++)
        column = source[i] == '\n' ? 1 : column + 1;
    return column;
}

// Writes the line of a rejected file: the message, the place, and the class kept from the file on disk.
static void error_line(Report *report, Tally *tally, Str name, Str source, Str message, U32 where) {
    tally->error += 1;
    Str tag = class_tag(report->previous, name);
    char line[:] = format::push(": error: ", message, " (", row_of(source, where), ":", column_of(source, where), ")");
    append(report, line);
    if (known_class(tag)) {
        tally->tagged += 1;
        char marked[:] = format::push(" [", tag, "]");
        append(report, marked);
    } else {
        tally->untagged += 1;
    }
    append(report, "\n");
}

// Reads one corpus file and writes its line.
static void read_file_in(Report *report, Tally *tally, Str name, Str path) {
    tally->total += 1;
    Str source = read_text(path);
    append(report, name);
    Bool classed = countof(class_tag(report->previous, name)) > 0;
    if (!has_line_starting(source, "module ") || has_line_starting(source, "#")) {
        tally->c += 1;
        tally->stale += classed ? 1 : 0;
        append(report, ": C, out of scope\n");
        return;
    }
    parser::Parsed first = parser::parse(name, source);
    if (countof(first.errors) > 0) {
        error_line(report, tally, name, source, first.errors[0].message, first.errors[0].span.start);
        return;
    }
    Str one = ast::dump(&first.module);
    parser::Parsed second = parser::parse(name, source);
    Str two = ast::dump(&second.module);
    if (countof(one) == 0 || !slice::equal(one, two) || countof(second.errors) > 0) tally->unstable += 1;
    tally->ok += 1;
    tally->stale += classed ? 1 : 0;
    append(report, ": ok\n");
}

// Reads one corpus file with the memory of the file's own arena, given back when it is done.
static void read_file(Report *report, Tally *tally, Str name, Str path) {
    mem::Allocator *outside = mem::set_allocator(report->work_base);
    read_file_in(report, tally, name, path);
    mem::set_allocator(outside);
    arena::reset(report->work);
}

// The `.smith` files of a case: a stack of folders still to read (a case has folders inside `src`).
static void read_case(Report *report, Tally *tally, Str corpus_case) {
    char root[:] = format::push("tests/smith-lang/cases/", corpus_case, "/src");
    Folder pending[64];
    Usize count = 0;
    pending[count].path = root;
    count += 1;
    Str suffix = ".smith";
    while (count > 0) {
        count -= 1;
        Str folder = pending[count].path;
        files::EntriesResult listing = files::list(folder);
        if (listing == .error) continue;
        for (files::Entry entry : listing.ok) {
            char path[:] = format::push(folder, "/", entry.name);
            if (entry.folder) {
                test::check_condition(count < 64);
                if (count < 64) {
                    pending[count].path = path;
                    count += 1;
                }
            } else if (slice::ends_with(entry.name, suffix)) {
                char name[:] = format::push(corpus_case, path[countof(root):countof(path)]);
                read_file(report, tally, name, path);
            }
        }
    }
}

// Whether the list has a line that is the text.
static Bool has_line(Str list, Str wanted) {
    Usize line = 0;
    while (line < countof(list)) {
        Usize end = line;
        while (end < countof(list) && list[end] != '\n')
            end += 1;
        if (slice::equal(list[line:end], wanted)) return true;
        line = end + 1;
    }
    return false;
}

// Replaces a file with the text.
static void write_text(Str path, Str text) {
    U8 bytes[:] = mem::alloc_slice(U8, countof(text));
    for (Usize i = 0; i < countof(text); i++) {
        bytes[i] = (U8)text[i];
    }
    files::CountResult done = files::write_file(path, bytes, files::Replace);
    Bool wrote = done == .ok;
    test::check_condition(wrote);
}

// Reads a case and compares its lines with the case's file, or rewrites the file when `update`; a case with no
// `.smith` file has no file. The case's name is added to `kept`.
static void check_case(Report *report, Report *kept, Tally *tally, Str corpus_case, Bool update) {
    char path[:] = format::push("tests/front/parser/cases/", corpus_case, ".txt");
    report->used = 0;
    char previous[:] = read_text(path);
    Str before = previous;
    report->previous = before;
    read_case(report, tally, corpus_case);
    if (report->used == 0) return;
    append(kept, corpus_case);
    append(kept, "\n");
    char text[:] = report->text[0:report->used];
    Str written = text;
    if (!update) {
        test::golden(path, written);
    } else if (!slice::equal(written, before)) {
        write_text(path, written);
        tally->changed += 1;
    }
}

// The case files of a case that is gone or has no `.smith` file: removed when `update`, else counted.
static void sweep_orphans(Report *kept, Tally *tally, Bool update) {
    files::EntriesResult listing = files::list("tests/front/parser/cases");
    if (listing == .error) return;
    Str suffix = ".txt";
    for (files::Entry entry : listing.ok) {
        if (!slice::ends_with(entry.name, suffix)) continue;
        Str stem = entry.name[0:countof(entry.name) - countof(suffix)];
        if (has_line(kept->text[0:kept->used], stem)) continue;
        if (!update) {
            tally->orphans += 1;
            continue;
        }
        char path[:] = format::push("tests/front/parser/cases/", entry.name);
        files::DoneResult gone = files::remove(path);
        Bool removed = gone == .ok;
        test::check_condition(removed);
        tally->changed += 1;
    }
}

export void test_parser_every_corpus_file_has_an_outcome_and_matches_the_golden() {
    arena::Arena memory = test::memory(1U << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    files::EntriesResult cases = files::list("tests/smith-lang/cases");
    test::check_condition(cases == .ok);
    if (cases == .error) {
        return;
    }
    arena::Arena work = test::memory(1U << 27);
    arena::ArenaAllocator work_allocator = arena::allocator(&work);
    Report report = {.work = &work, .work_base = &work_allocator.base, .text = mem::alloc_slice(char, 1U << 20)};
    Report kept = {.work = &work, .work_base = &work_allocator.base, .text = mem::alloc_slice(char, 1U << 16)};
    Tally tally = {};
    Bool update = env::get("FRONT_UPDATE") == .some;
    if (update) {
        files::DoneResult made = files::make_folder("tests/front/parser/cases");
        Bool exists = made == .ok || files::info("tests/front/parser/cases") == .ok;
        test::check_condition(exists);
    }
    for (files::Entry corpus_case : cases.ok) {
        check_case(&report, &kept, &tally, corpus_case.name, update);
    }
    sweep_orphans(&kept, &tally, update);
    console::print("total ", tally.total, ", ok ", tally.ok, ", error ", tally.error, ", C ", tally.c, ", skipped ",
                   tally.skipped, ", classed ", tally.tagged, "\n");
    test::check_equal(tally.untagged, 0);
    test::check_equal(tally.stale, 0);
    test::check_equal(tally.orphans, 0);
    test::check_equal(tally.unstable, 0);
    test::check_condition(tally.total > 500);
}
