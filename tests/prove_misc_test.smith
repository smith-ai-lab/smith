    proved(&p,
           "trusted: a caller of a trusted function with no contract is proved, reading the function with no "
           "contract",
           "--function=after_announce \"$c/trusted.c\"");
}

export void test_prove_trusted_function_of_a_trusted_function_is_refused(io::Io *io) {
    fails_at(io, "trusted: --function of a trusted function is refused", "--function=sensor_percent \"$c/trusted.c\"",
             "the function is marked smith_trusted(), so its contract is assumed and nothing of it is proved");
}

export void test_prove_default_set_function_of_a_function_with_no_contract_is_refused(io::Io *io) {
    fails_at(io, "default set: --function of a function with no contract is refused",
             "--function=helper \"$c/trusted.c\"", "a function with no contract is not proved");
}

export void test_prove_boundary_a_library_call_in_a_proved_function_names_the_helper(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = refuted(&p, "boundary: a proved function that reaches a library call fails", "\"$c/edge.c\"");
    has("boundary: ... naming the call", &run,
        "edge.c:9: cannot be proved: a call of printf, which has neither a body nor a contract");
    has("boundary: ... and the function to mark, the helper that makes the call", &run,
        "put smith_trusted() as the first statement of show, so that its callers use its smith_requires and "
        "smith_ensures");
}

export void test_prove_boundary_marking_the_helper_trusted_cuts_it(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = refuted(&p, "boundary: marking the helper trusted cuts it", "\"$c/edge_trusted.c\"");
    has("boundary: ... the one that passes what the contract refuses fails at the call", &run,
        "edge_trusted.c:25: the call of show may break smith_requires(value >= 0)");
    has("boundary: ... the other is proved, the helper is trusted", &run, "1 proved, 1 failed, 1 trusted");
}

export void test_prove_boundary_shown_twice_alone_is_proved(io::Io *io) {
    scratch::Project p = fresh(io);
    proved(&p, "boundary: ... shown_twice alone is proved", "--function=shown_twice \"$c/edge_trusted.c\"");
}

// 13. An error at its cause (issue #42): a smith_requires after a write names the write and the read, each with its
// line.
export void test_prove_cause_a_requires_after_a_write_names_the_write_and_the_read(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = refuted(&p, "cause: callers of a contract that reads after a write fail", "\"$c/cause.c\"");
    has("cause: ... the error is at the call", &run,
        "cause.c:22: cannot be proved: cannot use the contract of swap_halves: its smith_requires reads memory at ");
    has("cause: ... names the read, with its line and instruction", &run, "cause.c:15: `");
    has("cause: ... and the write, with its line and instruction", &run, "after the function has written, at ");
    has("cause: ... the store", &run, "cause.c:14: `store i32");
    has("cause: ... and what to do", &run, "put every smith_requires before the first write");
}

export void test_prove_cause_a_struct_zero_initialized_first_is_a_write_of_a_local(io::Io *io) {
    scratch::Project p = fresh(io);
    proved(&p, "cause: a struct zero-initialized first is a write of a local, not of the caller's memory",
           "\"$c/zero_init.c\"");
}

// 14. --emit-ir writes the IR the prover checks, with the proof points listed.
export void test_prove_emit_ir_writes_the_ir_with_the_proof_points_listed(io::Io *io) {
    scratch::Project p = fresh(io);
    proved(&p, "emit-ir: the proof still runs", "--emit-ir=ir.ll --function=draw_health \"$c/clamp.c\"");
    const char *ir = scratch::read(&p, "ir.ll");
    scratch::expect_contains("emit-ir: names the function", ir, "; draw_health (");
    scratch::expect_contains("emit-ir: lists the proof points", ir,
                             ";   point 0: smith_requires, assumed: 0 <= max_health && max_health <= 1000");
    scratch::expect_contains("emit-ir: ... the one that proves a callee's smith_requires at the call", ir,
                             "smith_requires of a callee, proved at the call: low <= high");
    scratch::expect_contains("emit-ir: ... and the promise", ir,
                             "smith_ensures, proved: 0 <= pixels && pixels <= 4 * max_health");
    scratch::expect_contains("emit-ir: has the function", ir, "define ");
    scratch::expect_contains("emit-ir: ... with the contracts as points", ir, "call void @smith_point(i32 ");
}

// 15. -v lists every function, and a function proved before is cached, with the time it took then. The cache is the
// case's own: the first run proves.
export void test_prove_cached_a_function_proved_before_is_cached_with_the_time_it_took_then(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::own_cache(&p);
    scratch::Run first = proved(&p, "cached: the first run proves", "-v \"$c/clamp.c\"");
    has("cached: the first run proves clamp", &first, "ok    clamp  (");
    lacks("cached: the first run is not cached", &first, "cached");
    scratch::Run second = proved(&p, "cached: the second run proves", "-v \"$c/clamp.c\"");
    has("cached: the second run lists clamp, marked cached", &second, "ok    clamp  (");
    has("cached: ... with the time it took when it was proved", &second, "cached: proved before in ");
    has("cached: ... and draw_health, which uses its contract", &second, "ok    draw_health  (");
    has("cached: ... and the count", &second, "2 proved, 0 failed, 2 cached");
    scratch::Run again = proved(&p, "cached: --no-cache runs", "-v --no-cache \"$c/clamp.c\"");
    lacks("cached: --no-cache proves again", &again, "cached");
}

export void test_prove_cached_a_function_that_fails_is_never_cached(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::own_cache(&p);
    scratch::Run run = prove(&p, "\"$c/bad_caller.c\" \"$c/clamp.c\"");
    has("cached: a function that fails is never cached", &run,
        "bad_caller.c:10: the call of clamp may break smith_requires(low <= high)");
}

// 16. A function with a smith_assert is in the default set (issue #53), as one with requires, ensures or invariant is:
// main included. A program with nothing of the four has nothing to prove, and is not flattened for it.
export void test_prove_asserts_only_a_function_with_only_an_assert_is_a_unit(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = refuted(&p, "asserts only: the function whose assert follows is proved, the other one fails",
                               "-v \"$c/asserts_only.c\"");
    has("asserts only: a function with only an assert is a unit", &run, "ok    masked  (");
    has("asserts only: ... one whose assert is not given fails, with its line", &run,
        "asserts_only.c:14: assert(x < 1000) may fail");
    lacks("asserts only: main has no assert of its own and is not proved (ok)", &run, "ok    main");
    lacks("asserts only: main has no assert of its own and is not proved (FAIL)", &run, "FAIL  main");
}

export void test_prove_asserts_only_function_masked_proves_it(io::Io *io) {
    scratch::Project p = fresh(io);
    proved(&p, "asserts only: --function=masked proves it", "\"$c/asserts_only.c\" --function=masked");
}

export void test_prove_gate_no_contract_and_no_assert_is_nothing_to_prove_and_is_not_flattened(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::write(&p, "nothing.c", "int main(void) { return 0; }\n");
    scratch::Run run = proved(&p, "gate: no contract and no assert is nothing to prove", "-v nothing.c");
    has("gate: nothing to prove", &run, "smith: prove: nothing to prove: no function with smith_requires");
    has("gate: -v counts the functions", &run,
        "phase gate: 0 functions with a contract of their own, 0 trusted; skipped flattening");
    lacks("gate: no flattening", &run, "phase flatten");
}

export void test_prove_gate_the_default_output_is_the_same_without_v_and_has_no_phase_lines(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::write(&p, "nothing.c", "int main(void) { return 0; }\n");
    scratch::Run run = prove(&p, "nothing.c");
    has("gate: the default output is the same without -v", &run, "smith: prove: nothing to prove");
    lacks("gate: no phase lines without -v", &run, "phase");
}

// 16b. An assert in a function that calls the program's edge: the edge is a declaration marked smith::edge.
export void test_prove_edge_an_assert_is_proved_across_a_call_of_a_smith_edge_function(io::Io *io) {
    scratch::Project p = fresh(io);
    proved(&p, "edge: an assert is proved across a call of a smith::edge function",
           "\"$c/main_edge.c\" --function=run_proved");
}

export void test_prove_edge_an_assert_the_contract_does_not_give_fails_with_its_line(io::Io *io) {
    fails_at(io, "edge: ... and one the contract does not give fails", "\"$c/main_edge.c\" --function=run_unproved",
             "main_edge.c:33: assert(total <= 24) may fail");
}

export void test_prove_gate_a_contract_is_flattened_and_a_failing_assert_is_still_refuted(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = prove(&p, "-v \"$c/assertion.c\"");
    has("gate: a contract is flattened", &run, "phase flatten: ");
    has("gate: ... and the module's size before and after", &run, " instructions before, ");
    has("gate: ... counting its functions", &run, "phase gate: 2 functions with a contract of their own");
    has("gate: ... a failing assert is still refuted", &run, "assertion.c:16: assert(x < 50) may fail");
}

// 16c. The library that defines the contract functions (lib/smith/contract.smith) in the program is no reason to inline
// them: the contracts stay points, and the function is still a unit. Only what a unit reaches is flattened.
export void test_prove_contract_library_in_the_program_the_contracts_are_still_proved(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = proved(&p, "contract.c in the program: the contracts are still proved",
                              "\"$c/clamp.c\" \"$SMITH_REPO/lib/smith/contract.smith\"");
    has("contract.c in the program: ... as before", &run, "proved, 0 failed");
}

// 16d. A loop with a smith_invariant is proved by induction (issue #56): the invariant on entry, then one pass of the
// body from an arbitrary state that satisfies it. A bound of 4096 costs one pass (unrolled, it runs out of its budget),
// and a loop with no bound proves.
export void test_prove_induction_a_bound_of_4096_with_an_inductive_invariant_proves(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = proved(&p, "induction: n <= 4096 with an inductive invariant proves",
                              "-v --no-cache \"$c/induction.c\" --function=triple");
    has("induction: ... and the cost report says which mode the loop used", &run,
        "a loop proved by induction: one pass of its body");
}

export void test_prove_induction_unroll_pays_for_4096_passes_and_runs_out(io::Io *io) {
    scratch::Project p = fresh(io);
    refuted(&p, "induction: --unroll pays for 4096 passes, and runs out",
            "--unroll --budget=3 \"$c/induction.c\" --function=triple");
}

export void test_prove_induction_a_loop_with_no_bound_proves_from_its_invariant(io::Io *io) {
    scratch::Project p = fresh(io);
    proved(&p, "induction: a loop with no bound proves from its invariant", "\"$c/induction.c\" --function=countdown");
}

export void test_prove_induction_a_local_array_the_loop_writes_is_arbitrary_at_the_start_of_a_pass(io::Io *io) {
    scratch::Project p = fresh(io);
    proved(&p, "induction: a local array the loop writes is arbitrary at the start of a pass, and the loop proves",
           "\"$c/induction.c\" --function=filled");
}

export void test_prove_induction_an_invariant_that_is_not_inductive_is_refuted_after_a_pass(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = refuted(&p, "induction: an invariant that is not inductive is refuted",
                               "\"$c/induction.c\" --function=too_small");
    has("induction: ... at the line of the invariant, after a pass", &run,
        "induction.c:39: smith_invariant(total <= 10) may be false after a pass of the loop");
    has("induction: ... saying it may be too weak and what the body writes", &run,
        "the invariant may be too weak: the body writes");
    has("induction: ... with the values of the pass", &run, "counterexample:");
}

export void test_prove_induction_an_invariant_that_is_false_on_entry_is_refuted_when_the_loop_is_entered(io::Io *io) {
    fails_at(io, "induction: an invariant that is false on entry is refuted",
             "\"$c/induction.c\" --function=not_on_entry",
             "induction.c:50: smith_invariant(total == 3 * i) may be false when the loop is entered");
}

export void test_prove_induction_a_loop_without_an_invariant_is_unrolled_as_before_whatever_the_mode(io::Io *io) {
    scratch::Project p = fresh(io);
    proved(&p, "induction: a loop without an invariant is unrolled as before, whatever the mode",
           "-v --induction \"$c/loop_count.c\" --function=sum_bounded");
}

export void test_prove_induction_an_invariant_too_weak_to_be_inductive_still_proves_by_unrolling(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = proved(&p,
                              "induction: an invariant too weak to be inductive still proves by unrolling when the "
                              "loop has a count",
                              "-v \"$c/board.c\" --function=occupied");
    has("induction: ... and -v says it was unrolled", &run, "so it was proved by unrolling its loops");
}

export void test_prove_induction_induction_from_only_moves_the_threshold(io::Io *io) {
    scratch::Project p = fresh(io);
    proved(&p, "induction: --induction-from only moves the threshold",
           "-v --induction-from=2 \"$c/induction.c\" --function=countdown");
}

