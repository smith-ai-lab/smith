                             "geometry::ranges::", "set_two keeps_the_tail whole middle keeps_the_ends");
}

export void test_prove_modifies_slice_a_write_one_element_past_the_range_is_refuted(io::Io *io) {
    fails_at(io, "modifies (slice): a write one element past the slice range is refuted",
             "\"$c/geometry/ranges.smith\" --function=geometry::ranges::writes_past",
             "ranges.smith:34: the function writes here, outside the ranges its smith_modifies names");
}

export void test_prove_modifies_slice_a_write_to_another_slice_is_refuted(io::Io *io) {
    fails_at(io, "modifies (slice): a write to another slice is refuted",
             "\"$c/geometry/ranges.smith\" --function=geometry::ranges::other_slice",
             "ranges.smith:49: the function writes here");
}

export void test_prove_modifies_slice_a_caller_relying_on_an_element_the_range_names_is_refuted(io::Io *io) {
    fails_at(io, "modifies (slice): a caller relying on an element the range names is refuted",
             "\"$c/geometry/ranges.smith\" --function=geometry::ranges::relies_on_the_head",
             "ranges.smith:27: assert(xs[0] == first) may fail");
}

// 18. Coverage (issue #51): how many of the project's functions have a contract of their own, in every form of the
// output. Nothing fails on a low one.
export void test_prove_coverage_the_count_of_functions_with_a_contract_and_the_ones_without(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run plain = prove(&p, "\"$c/static_harness.c\"");
    has("coverage: the count of functions with a contract", &plain,
        "1 of 2 functions have contracts; smith prove -v lists the 1 without");
    scratch::Run verbose = prove(&p, "-v \"$c/static_harness.c\"");
    has("coverage: -v names the functions without, with their file and line", &verbose, "without  no_contract  (");
    has("coverage: ... at the line", &verbose, "static_harness.c:19)");
}

export void test_prove_coverage_nothing_to_prove_still_counts_the_functions_and_succeeds(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::write(&p, "nothing.c", "int main(void) { return 0; }\n");
    scratch::Run run = proved(&p, "coverage: ... and succeeds", "nothing.c");
    has("coverage: nothing to prove still counts the functions", &run,
        "0 of 1 functions have contracts; smith prove -v lists the 1 without");
}

export void test_prove_coverage_smith_prove_says_it_on_a_second_line_after_the_verdict(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = scratch::sh(&p, "cd coverage && env -u SMITH_OUTPUT smith prove 2>&1");
    has("coverage: smith prove says it on a second line", &run,
        "1 of 4 functions have contracts; smith prove -v lists the 3 without");
    has("coverage: ... after the verdict", &run, "smith prove: ok (");
}

export void test_prove_coverage_smith_prove_v_lists_them_by_file_and_line(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = scratch::sh(&p, "cd coverage && smith prove -v 2>&1");
    has("coverage: smith prove -v lists them by file and line", &run, "without  h  (main.c:10)");
    has("coverage: ... main too", &run, "without  main  (main.c:4)");
}

// A git repository, or smith fmt has no list of files.
export void test_prove_coverage_smith_check_carries_it_into_its_prove_line(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = scratch::sh(&p, "cd coverage && git init -q . && env -u SMITH_OUTPUT smith check 2>&1");
    has("coverage: smith check carries it into its prove line", &run, "smith check: prove ok (1 of 4 functions)");
}

export void test_prove_coverage_smith_check_with_nothing_to_prove_says_0_of_n(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = scratch::sh(
        &p, "cd coverage && git init -q . && printf 'int main(void) { return 0; }\\n' >main.c && env -u SMITH_OUTPUT "
            "smith check 2>&1");
    has("coverage: nothing to prove is a success that says 0 of N", &run, "smith check: prove ok (0 of 1 functions)");
}

// 17. The cache key is the prover's identity (LLVM's version and a version kept in prove.cpp), never the build time: a
// rebuild of smith with the same prover keeps the proofs.
export void test_prove_cache_key_has_no_build_time_in_it(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::expect_text("cache key: no build time in it", "0",
                         scratch::capture(&p, "grep -c '__DATE__\\|__TIME__' \"$SMITH_REPO/shim/prove.cpp\""));
}
