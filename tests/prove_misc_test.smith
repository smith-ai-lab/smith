// 16e. smith_modifies (issue #54): the ranges a function writes; its callers keep everything else it knew.
static void modifies_proves(io::Io *io, const char *name, const char *function) {
    scratch::Project p = fresh(io);
    proved(&p, name, format::push(&io->arena, "\"$c/modifies.c\" --function=", function).data);
}

export void test_prove_modifies_a_function_that_writes_only_what_it_names_proves(io::Io *io) {
    modifies_proves(io, "modifies: a function that writes only what it names proves", "push_a");
}

export void test_prove_modifies_a_caller_relying_on_fields_the_callee_never_named_proves(io::Io *io) {
    modifies_proves(io, "modifies: a caller relying on fields the callee never named proves", "keeps_the_rest");
}

export void test_prove_modifies_but_not_on_one_it_named(io::Io *io) {
    scratch::Project p = fresh(io);
    refuted(&p, "modifies: ... but not on one it named", "\"$c/modifies.c\" --function=relies_on_a_named_field");
}

