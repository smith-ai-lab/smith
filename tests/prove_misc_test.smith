// `smith prove`'s boundaries, reports and loops, from sections 12 to 18 of tests/prove.sh (issue #292): trusted
// functions and the default set, an error at its cause, --emit-ir, the cache of proofs (with a cache of its own: the
// cache key is the prover's identity), functions with only an assert, the gate that skips flattening, a contract
// library in the program, loops with an invariant (induction), a requires that bounded an unrolling, smith_modifies and
// the coverage line. The programs are tests/prove/*.c and tests/prove/geometry/*.smith ($c); the helpers are in
// tests/prove_cases.smith. See tests/prove_test.smith for the proofs' cache and budget.
module prove_misc_test;

import smith::format;
import smith::io;
import smith::test;
import scratch;
import prove_cases;

static scratch::Project fresh(io::Io *io) {
    return scratch::project(io, "p", "prove_cases");
}

// `smith prove args -- -I include`, both streams together.
static scratch::Run prove(const scratch::Project *p, const char *args) {
    return prove_cases::prove(p, args);
}

static scratch::Run proved(const scratch::Project *p, const char *name, const char *args) {
    scratch::Run run = prove(p, args);
    scratch::expect_status(name, 0, &run);
    return run;
}

static scratch::Run refuted(const scratch::Project *p, const char *name, const char *args) {
    scratch::Run run = prove(p, args);
    scratch::expect_status(name, 1, &run);
    return run;
}

static void has(const char *name, const scratch::Run *run, const char *needle) {
    scratch::expect_contains(name, run->out, needle);
}

static void lacks(const char *name, const scratch::Run *run, const char *needle) {
    scratch::expect_lacks(name, run->out, needle);
}

// A function that fails: `--function=F file` on a file of tests/prove, status 1, the needle in the output.
static void fails_at(io::Io *io, const char *name, const char *args, const char *needle) {
    scratch::Project p = fresh(io);
    scratch::Run run = refuted(&p, name, args);
    has(name, &run, needle);
}

// 12. Trusted boundaries (issue #42): a function marked smith_trusted() is assumed by its callers and not proved, and
// the report lists it as trusted. The default set is every function with a contract, minus the trusted ones: main and a
// function with no contract are not proved.
export void test_prove_trusted_the_report_lists_edge_functions_and_proves_callers(io::Io *io) {
    scratch::Project p = fresh(io);
    scratch::Run run = refuted(&p, "trusted: a proved function that is wrong still fails", "-v \"$c/trusted.c\"");
    has("trusted: ... the edge function is listed as trusted", &run, "trusted  sensor_percent  (");
    has("trusted: ... with the contract it gives callers", &run,
        "not proved; callers prove its 0 smith_requires and assume its 1 smith_ensures");
    has("trusted: ... one with no contract at all too", &run, "trusted  announce  (");
    has("trusted: ... the callers are proved from its contract", &run, "ok    scaled  (");
    has("trusted: ... the one that wants more than the contract gives fails", &run, "FAIL  scaled_too_far  (");
    has("trusted: ... with the value the contract allows", &run, "percent = ");
    has("trusted: ... and the counts say so", &run, "3 proved, 1 failed, 2 trusted");
    lacks("trusted: the body of a trusted function is not read", &run, "inline assembly");
    lacks("trusted: a trusted function is never listed as proved (sensor_percent)", &run, "ok    sensor_percent");
    lacks("trusted: a trusted function is never listed as proved (announce)", &run, "ok    announce");
    lacks("default set: main is not proved (ok)", &run, "ok    main");
    lacks("default set: main is not proved (FAIL)", &run, "FAIL  main");
    lacks("default set: a function with no contract is not proved (ok)", &run, "ok    helper");
    lacks("default set: a function with no contract is not proved (FAIL)", &run, "FAIL  helper");
}

export void test_prove_trusted_a_caller_may_branch_on_the_result(io::Io *io) {
    scratch::Project p = fresh(io);
    proved(&p, "trusted: a caller may branch on the result", "--function=branches_on_trusted \"$c/trusted.c\"");
}

export void test_prove_trusted_a_caller_of_a_trusted_function_with_no_contract_is_proved(io::Io *io) {
