// Tests of the driver path of the new front end (#1578): files in smith's own syntax through `compile::file`, the
// corpus tests/front/e2e/, and the checks the driver turns on. A case is `<name>.smith` (a module in smith's own
// syntax) plus either nothing (it runs: `pub fn check() -> i32` returns 0 when every step worked) or `<name>.error`
// (compiling fails with exactly those diagnostics, the scratch folder written `<dir>`). Add a case by adding files.
module front_e2e_test;

import front::compile;
import front::roots;
import std::console;
import std::files;
import std::format;
import std::mem;
import std::process;
import std::test;
import <stdio.h>;
import <stdlib.h>;
import <sys/stat.h>;
import <unistd.h>;

static Str as_str(char chars[:]) {
    return chars;
}

static const char *smith_path() {
    const char *self = c::getenv("SMITH_SELF");
    return self != nullptr ? self : "smith";
}

static Str folder_for(Str name) {
    Str path = as_str(format::push("/tmp/front_e2e_", (I64)c::getpid(), "_", name));
    c::mkdir(path.data, 0o700);
    return path;
}

static void write_text(Str path, Str text) {
    c::FILE *file = c::fopen(path.data, "w");
    test::check_equal(file != nullptr, true);
    if (file == nullptr) return;
    c::fwrite(text.data, 1, countof(text), file);
    c::fclose(file);
}

static void remove_all(Str folder) {
    const char *const argv[4] = {"rm", "-rf", folder.data, nullptr};
    process::OutputResult done = process::run(argv[0:3]);
    test::check_equal(done == .ok, true);
}

static I32 sh_status(Str command) {
    const char *const argv[4] = {"sh", "-c", command.data, nullptr};
    process::OutputResult done = process::run(argv[0:3]);
    if (done != .ok || done.ok.exit.signal != 0) return -1;
    return done.ok.exit.status;
}

static Str text_of(Str path) {
    files::BytesResult loaded = files::read_file(path);
    if (loaded == .error) return "";
    format::Chars chars = mem::view(loaded.ok, char);
    return chars;
}

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        if (roots::same(text[i:i + countof(needle)], needle)) return true;
    }
    return false;
}

static Str replace(Str text, Str from, Str to) {
    Str result = "";
    Usize i = 0;
    while (i < countof(text)) {
        if (i + countof(from) <= countof(text) && roots::same(text[i:i + countof(from)], from)) {
            result = as_str(format::push(result, to));
            i += countof(from);
        } else {
            result = as_str(format::push(result, text[i:i + 1]));
            i += 1;
        }
    }
    return result;
}

static Str prefix() {
    return c::access("/System/Library/CoreServices", 0) == 0 ? "_" : "";
}

// Compiles `source` as module `name` under <folder>/src into <folder>/<name>.o.
static compile::Report compile_module(Str folder, Str name, Str source) {
    Str src = as_str(format::push(folder, "/src"));
    c::mkdir(src.data, 0o700);
    Str path = as_str(format::push(src, "/", name, ".smith"));
    write_text(path, source);
    const char *repo = c::getenv("SMITH_REPO"); // the standard library a case imports (`import std.array`)
    Str library = repo != nullptr ? as_str(format::push(repo, "/lib")) : as_str(format::push(folder, "/lib"));
    roots::Roots folders = {.source = src, .library = library};
    return compile::file(path, as_str(format::push(folder, "/", name, ".o")), "", folders);
}

// Links <folder>/<name>.o with <folder>/main.c as a user's program is linked (`smith cc --front-end=new` adds the real
// std.contract) and runs the program, its errors in <folder>/stderr: its exit status, -1 when the link failed.
static I32 link_and_run(Str folder, Str name, Str main_c) {
    write_text(as_str(format::push(folder, "/main.c")), main_c);
    // The runtime a recursive case needs, smith_recurse_call, is in lib/handlers.c (#2710).
    const char *repo = c::getenv("SMITH_REPO");
    Str runtime = repo != nullptr ? as_str(format::push(repo, "/lib/handlers.c -I ", repo, "/include"))
                                  : as_str(format::push(""));
    I32 linked = sh_status(as_str(format::push(smith_path(), " cc --front-end=new -std=gnu23 ", folder, "/main.c ",
                                               folder, "/", name, ".o ", runtime, " -o ", folder, "/prog")));
    test::check_equal(linked, 0);
    if (linked != 0) return -1;
    return sh_status(as_str(format::push(folder, "/prog 2>", folder, "/stderr")));
}

// One case of the corpus. A failure is one check with the text "<name>: <what went wrong>" printed under it ("" is a
// pass), so the case's name and the compiler's error are in the output, never a bare `false, true`.
static Str case_failure(Str name, Str folder, compile::Report report, Str errors_path) {
    if (files::exists(errors_path)) {
        if (report.ok) {
            return as_str(format::push(name, ": compiled, but ", name, ".error expects an error"));
        }
        Str want = text_of(errors_path);
        Str got = replace(report.text, folder, "<dir>");
        if (roots::same(want, got)) return "";
        return as_str(format::push(name, ": wrong error, got:\n", got, "\nwant (", name, ".error):\n", want));
    }
    if (!report.ok) return as_str(format::push(name, ": ", report.text));
    Str main_c = as_str(format::push("int check(void) __asm__(\"", prefix(), name, "::check\");\n",
                                     "int main(void) { return check(); }\n"));
    I32 status = link_and_run(folder, name, main_c);
    if (status != 0) return as_str(format::push(name, ": exit ", (I64)status));
    return "";
}

// Failures are collected so that every case runs: each prints at once and the test fails at the end, once, with the
// number of failed cases (a failed check ends the test, so it is the last call).
static Usize failed_cases = 0;

static void fail_with(Str text) {
    if (countof(text) == 0) return;
    failed_cases += 1;
    (void)console::print_error("FAILED CASE ", text, "\n");
}

static void run_case(Str name) {
    Str dir = "tests/front/e2e/";
    Str source = text_of(as_str(format::push(dir, name, ".smith")));
    Str folder = folder_for(name);
    compile::Report report = compile_module(folder, name, source);
    Str failure = case_failure(name, folder, report, as_str(format::push(dir, name, ".error")));
    fail_with(failure);
    remove_all(folder);
}

// Every case of tests/front/e2e/, one check each (a failure's text starts with the case's name and shows the compiler's
// error).
export void test_front_e2e_every_case_of_the_corpus() {
    files::EntriesResult listing = files::list("tests/front/e2e");
    test::check_equal(listing == .ok, true);
    if (listing != .ok) return;
    for (files::Entry entry : listing.ok) {
        Str file = entry.name;
        Str suffix = ".smith";
        if (countof(file) <= countof(suffix) || !roots::same(file[countof(file) - countof(suffix):], suffix)) continue;
        Str name = file[0:countof(file) - countof(suffix)];
        run_case(name);
    }
    test::check_equal(failed_cases, 0);
}

// One case of tests/front/eval/ that imports std.slice, compiled against a library folder holding only the declaration
// of `with_dims` (the real std.slice imports std.contract, which this path does not read yet).
static Str with_dims_case(Str name) {
    Str dir = "tests/front/eval/";
    Str folder = folder_for(name);
    Str src = as_str(format::push(folder, "/src"));
    c::mkdir(src.data, 0o700);
    c::mkdir(as_str(format::push(folder, "/lib")).data, 0o700);
    c::mkdir(as_str(format::push(folder, "/lib/std")).data, 0o700);
    write_text(as_str(format::push(folder, "/lib/std/slice.smith")),
               "pub fn with_dims(element: type, count: usize) -> type:\n    element\n");
    Str path = as_str(format::push(src, "/", name, ".smith"));
    write_text(path, text_of(as_str(format::push(dir, name, ".smith"))));
    roots::Roots folders = {.source = src, .library = as_str(format::push(folder, "/lib"))};
    compile::Report report = compile::file(path, as_str(format::push(folder, "/", name, ".o")), "", folders);
    Str failure = case_failure(name, folder, report, as_str(format::push(dir, name, ".error")));
    remove_all(folder);
    return failure;
}

// `slice.with_dims(T, k)` is the type written with k empty sizes, as a parameter's, a result's and an alias's type; a
// count of 0, or one not known at compile time, is an error that says so (#3039). Types are values of the evaluator:
// `==` between two, and `t[:]` in a function over types (#3239).
export void test_front_e2e_slice_with_dims_is_built_in() {
    Str built = with_dims_case("with_dims");
    Str refused = with_dims_case("with_dims_count");
    Str typed = with_dims_case("type_values");
    fail_with(built);
    fail_with(refused);
    fail_with(typed);
    test::check_equal(countof(built) + countof(refused) + countof(typed), 0);
}

// A cast to a narrower type is checked on the driver path (today's syntax, which has a `module` line): the object
// calls std.contract's `smith_contract_fail_cast`, which stops the program with smith's report.
export void test_front_e2e_a_narrowing_cast_calls_the_check() {
    Str folder = folder_for("cast");
    compile::Report report =
        compile_module(folder, "casts", "module casts;\n\nexport I32 narrow(I64 x) {\n    return (I32)x;\n}\n");
    test::check_equal(report.ok, true);
    if (report.ok) {
        Str main_c = as_str(format::push("int narrow(long) __asm__(\"", prefix(), "casts::narrow\");\n",
                                         "int main(void) { return narrow(1L << 40) == 0 ? 0 : 1; }\n"));
        test::check_equal(link_and_run(folder, "casts", main_c) != 0, true);
        test::check_equal(has(text_of(as_str(format::push(folder, "/stderr"))), "cast of 1099511627776 does not fit"),
                          true);
    }
    remove_all(folder);
}

// A function defined with `...` is a C variadic: C calls it with extra arguments (and a .smith caller does, in the
// corpus case variadic_definition).
export void test_front_e2e_a_variadic_definition_is_called_from_c() {
    Str folder = folder_for("variadics");
    Str source = text_of("tests/front/e2e/variadic_definition.smith");
    compile::Report report = compile_module(folder, "variadics", source);
    test::check_equal(report.ok, true);
    if (report.ok) {
        Str main_c =
            as_str(format::push("int total(int, ...) __asm__(\"", prefix(), "variadics::total\");\n",
                                "int main(void) { return total(2, 7, 9) == 3 && total(2, 100, 20) == 6 ? 0 : 1; }\n"));
        test::check_equal(link_and_run(folder, "variadics", main_c), 0);
    }
    remove_all(folder);
}

// The run path: today's std::ascii fixture (as tests/front_join_test.smith has it) through the same helper.
export void test_front_e2e_the_run_path_links_and_runs() {
    Str folder = folder_for("ascii");
    c::mkdir(as_str(format::push(folder, "/lib")).data, 0o700);
    c::mkdir(as_str(format::push(folder, "/lib/std")).data, 0o700);
    Str path = as_str(format::push(folder, "/lib/std/ascii.smith"));
    write_text(path, "module std::ascii;\n\n"
                     "export Bool digit(U8 c) {\n    return c >= 48 && c <= 57;\n}\n");
    roots::Roots folders = {.source = as_str(format::push(folder, "/src")),
                            .library = as_str(format::push(folder, "/lib"))};
    compile::Report report = compile::file(path, as_str(format::push(folder, "/ascii.o")), "", folders);
    test::check_equal(report.ok, true);
    if (report.ok) {
        Str main_c = as_str(format::push("_Bool digit(char) __asm__(\"", prefix(), "std::ascii::digit\");\n",
                                         "int main(void) { return digit('7') && !digit('x') ? 0 : 1; }\n"));
        test::check_equal(link_and_run(folder, "ascii", main_c), 0);
    }
    remove_all(folder);
}

// A warning is a line `file:line:column: warning: message` (the severity is the helper's argument).
export void test_front_e2e_a_warning_line_says_warning() {
    Str line = compile::diagnostic_for_test("f.smith", "a\nbc", 3, "warning", "old form");
    Str expected = "f.smith:2:2: warning: old form\n";
    test::check_equal(line, expected);
    test::check_equal(has(line, "error"), false);
}

// Two files (#1714): `app` calls `m.scale` and `let mul = m.scale` of the module `mathlib` (a file under the library
// root), the two objects link, and the program runs. The importer's object leaves `mathlib::scale` undefined and
// the importer's object defines it.
export void test_front_e2e_a_call_through_a_module_value_links_and_runs() {
    Str folder = folder_for("modules");
    c::mkdir(as_str(format::push(folder, "/lib")).data, 0o700);
    c::mkdir(as_str(format::push(folder, "/src")).data, 0o700);
    Str library = as_str(format::push(folder, "/lib/mathlib.smith"));
    write_text(library, "pub fn scale(x: f64, k: f64) -> f64:\n    x * k\n");
    Str app = as_str(format::push(folder, "/src/app.smith"));
    write_text(app, "import mathlib as m\nlet mul = m.scale\n\n"
                    "pub fn check() -> i32:\n    let a = m.scale(2.0, 3.0)\n    let b = mul(k = 3.0, x = 2.0)\n"
                    "    if a != 6.0:\n        return 1\n    if b != a:\n        return 2\n    0\n");
    roots::Roots folders = {.source = as_str(format::push(folder, "/src")),
                            .library = as_str(format::push(folder, "/lib"))};
    compile::Report imported = compile::file(library, as_str(format::push(folder, "/mathlib.o")), "", folders);
    test::check_equal(imported.ok, true);
    compile::Report report = compile::file(app, as_str(format::push(folder, "/app.o")), "", folders);
    Str none = "";
    if (!report.ok) test::check_equal(report.text, none);
    test::check_equal(report.ok, true);
    if (report.ok && imported.ok) {
        test::check_equal(sh_status(as_str(format::push("nm ", folder, "/app.o | grep -q ' U .*mathlib::scale'"))), 0);
        test::check_equal(sh_status(as_str(format::push("nm ", folder, "/mathlib.o | grep -q ' T .*mathlib::scale'"))),
                          0);
        write_text(as_str(format::push(folder, "/main.c")),
                   as_str(format::push("int check(void) __asm__(\"", prefix(), "app::check\");\n",
                                       "int main(void) { return check(); }\n")));
        I32 linked = sh_status(as_str(format::push(smith_path(), " cc ", folder, "/main.c ", folder, "/app.o ", folder,
                                                   "/mathlib.o -o ", folder, "/prog")));
        test::check_equal(linked, 0);
        if (linked == 0) test::check_equal(sh_status(as_str(format::push(folder, "/prog"))), 0);
    }
    remove_all(folder);
}

// A function with no result across modules (#2172): `barrier.wait(&x)` is a call to a `Void` prototype, and the
// library's object defines it.
export void test_front_e2e_a_call_to_a_function_without_a_result_links_and_runs() {
    Str folder = folder_for("void_call");
    c::mkdir(as_str(format::push(folder, "/lib")).data, 0o700);
    c::mkdir(as_str(format::push(folder, "/src")).data, 0o700);
    Str library = as_str(format::push(folder, "/lib/barrier.smith"));
    write_text(library, "pub fn wait(t: *mut i32):\n    t.* = 4\n");
    Str app = as_str(format::push(folder, "/src/app.smith"));
    write_text(app, "import barrier\n\npub fn check() -> i32:\n    let mut x = 0\n    barrier.wait(&x)\n"
                    "    if x != 4:\n        return 1\n    0\n");
    roots::Roots folders = {.source = as_str(format::push(folder, "/src")),
                            .library = as_str(format::push(folder, "/lib"))};
    compile::Report imported = compile::file(library, as_str(format::push(folder, "/barrier.o")), "", folders);
    test::check_equal(imported.ok, true);
    compile::Report report = compile::file(app, as_str(format::push(folder, "/app.o")), "", folders);
    Str none = "";
    if (!report.ok) test::check_equal(report.text, none);
    test::check_equal(report.ok, true);
    if (report.ok && imported.ok) {
        write_text(as_str(format::push(folder, "/main.c")),
                   as_str(format::push("int check(void) __asm__(\"", prefix(), "app::check\");\n",
                                       "int main(void) { return check(); }\n")));
        I32 linked = sh_status(as_str(format::push(smith_path(), " cc ", folder, "/main.c ", folder, "/app.o ", folder,
                                                   "/barrier.o -o ", folder, "/prog")));
        test::check_equal(linked, 0);
        if (linked == 0) test::check_equal(sh_status(as_str(format::push(folder, "/prog"))), 0);
    }
    remove_all(folder);
}

// A generic function's instance is emitted in the object of the module that uses it, and calls a private function of
// its own module (#2853: `console.print`, instantiated in the program, calls console's `emit_long`): the private
// function is external and hidden in its module's object, so the link finds it.
export void test_front_e2e_an_instance_calls_a_private_function_of_its_module() {
    Str folder = folder_for("private_call");
    c::mkdir(as_str(format::push(folder, "/lib")).data, 0o700);
    c::mkdir(as_str(format::push(folder, "/src")).data, 0o700);
    Str library = as_str(format::push(folder, "/lib/sizes.smith"));
    write_text(library,
               "fn inc(n: i32) -> i32:\n    n + 1\n\npub fn sized(T: type) -> i32:\n    inc(sizeof(T).to(i32))\n");
    Str app = as_str(format::push(folder, "/src/app.smith"));
    write_text(app, "import sizes\n\npub fn check() -> i32:\n    if sizes.sized(i32) != 5:\n        return 1\n    0\n");
    roots::Roots folders = {.source = as_str(format::push(folder, "/src")),
                            .library = as_str(format::push(folder, "/lib"))};
    compile::Report imported = compile::file(library, as_str(format::push(folder, "/sizes.o")), "", folders);
    test::check_equal(imported.ok, true);
    compile::Report report = compile::file(app, as_str(format::push(folder, "/app.o")), "", folders);
    Str none = "";
    if (!report.ok) test::check_equal(report.text, none);
    test::check_equal(report.ok, true);
    if (report.ok && imported.ok) {
        test::check_equal(sh_status(as_str(format::push("nm ", folder, "/sizes.o | grep -q ' T sizes::inc$'"))), 0);
        write_text(as_str(format::push(folder, "/main.c")),
                   as_str(format::push("int check(void) __asm__(\"", prefix(), "app::check\");\n",
                                       "int main(void) { return check(); }\n")));
        I32 linked = sh_status(as_str(format::push(smith_path(), " cc --front-end=new ", folder, "/main.c ", folder,
                                                   "/app.o ", folder, "/sizes.o -o ", folder, "/prog")));
        test::check_equal(linked, 0);
        if (linked == 0) test::check_equal(sh_status(as_str(format::push(folder, "/prog"))), 0);
    }
    remove_all(folder);
}

// A qualified type (#1935): `app` takes a `v.Vec` of the module `vecs` as a parameter and passes it to `v.dot`; the
// record is declared in the importer's object under the module's path, and a C program passes a struct by value.
export void test_front_e2e_a_qualified_type_names_the_record_of_an_imported_module() {
    Str folder = folder_for("qualified");
    c::mkdir(as_str(format::push(folder, "/lib")).data, 0o700);
    c::mkdir(as_str(format::push(folder, "/src")).data, 0o700);
    Str library = as_str(format::push(folder, "/lib/vecs.smith"));
    write_text(library, "pub struct Vec:\n    pub x: f64\n    pub y: f64\n\n"
                        "pub fn dot(a: Vec, b: Vec) -> f64:\n    a.x * b.x + a.y * b.y\n");
    Str app = as_str(format::push(folder, "/src/app.smith"));
    write_text(app, "import vecs as v\n\npub fn norm(a: v.Vec) -> f64:\n    v.dot(a, a)\n");
    roots::Roots folders = {.source = as_str(format::push(folder, "/src")),
                            .library = as_str(format::push(folder, "/lib"))};
    compile::Report imported = compile::file(library, as_str(format::push(folder, "/vecs.o")), "", folders);
    test::check_equal(imported.ok, true);
    compile::Report report = compile::file(app, as_str(format::push(folder, "/app.o")), "", folders);
    Str none = "";
    if (!report.ok) test::check_equal(report.text, none);
    test::check_equal(report.ok, true);
    if (report.ok && imported.ok) {
        write_text(
            as_str(format::push(folder, "/main.c")),
            as_str(format::push("struct V { double x; double y; };\n", "double norm(struct V) __asm__(\"", prefix(),
                                "app::norm\");\n",
                                "int main(void) { struct V v = {3.0, 4.0}; return norm(v) == 25.0 ? 0 : 1; }\n")));
        I32 linked = sh_status(as_str(format::push(smith_path(), " cc ", folder, "/main.c ", folder, "/app.o ", folder,
                                                   "/vecs.o -o ", folder, "/prog")));
        test::check_equal(linked, 0);
        if (linked == 0) test::check_equal(sh_status(as_str(format::push(folder, "/prog"))), 0);
    }
    remove_all(folder);
}

// Names from C headers (#1762): `import <h>;` declares what the header has as `c::name`, and the checker and the
// emitter use them. The flags clang reads a header with are smith's own (the resource directory, the SDK), as `smith
// cc` passes them in $SMITH_FRONT_CIMPORT_FLAGS.
static Str line_of(const char *const argv[:]) {
    process::OutputResult done = process::run(argv);
    if (done != .ok) return "";
    Usize n = countof(done.ok.output);
    while (n > 0 && done.ok.output[n - 1] == '\n')
        n -= 1;
    return as_str(format::push(format::bytes((const char *)done.ok.output.data, n)));
}

static void use_header_flags() {
    const char *const resource_argv[3] = {smith_path(), "cc", "-print-resource-dir"};
    Str flags = as_str(format::push("-resource-dir\n", line_of(resource_argv[0:3]), "\n"));
    const char *const sdk_argv[3] = {"xcrun", "--show-sdk-path", nullptr};
    Str sdk = line_of(sdk_argv[0:2]);
    if (countof(sdk) > 0) flags = as_str(format::push(flags, "-isysroot\n", sdk, "\n"));
    c::setenv("SMITH_FRONT_CIMPORT_FLAGS", flags.data, 1);
}

static Str c_header() {
    return "enum color { red, green = 5, blue };\n"
           "struct point { int x; int y; };\n"
           "typedef struct point point_t;\n"
           "#define SCALE 3\n"
           "static const int answer = 42;\n"
           "int sum(point_t *p);\n"
           "unsigned __int128 wide_add(unsigned __int128 a, unsigned __int128 b);\n";
}

// `body` is the body of `check`, in a module that imports the header above and <stdio.h> and <stdlib.h>. Its exit
// status, -1 when it did not compile or link.
static I32 run_with_header(Str name, Str body) {
    use_header_flags();
    Str folder = folder_for(name);
    c::mkdir(as_str(format::push(folder, "/src")).data, 0o700);
    write_text(as_str(format::push(folder, "/src/kinds.h")), c_header());
    Str source = as_str(format::push("import \"kinds.h\";\nimport <stdio.h>;\nimport <stdlib.h>;\n\n",
                                     "pub fn check() -> i32:\n", body));
    compile::Report report = compile_module(folder, name, source);
    I32 status = -1;
    if (!report.ok) test::check_equal(report.text, as_str(format::push("")));
    if (report.ok) {
        Str main_c = as_str(
            format::push("int check(void) __asm__(\"", prefix(), name, "::check\");\n",
                         "struct point { int x; int y; };\n"
                         "int sum(struct point *p) { return p->x + p->y; }\n"
                         "unsigned __int128 wide_add(unsigned __int128 a, unsigned __int128 b) { return a + b; }\n"
                         "int main(void) { return check(); }\n"));
        status = link_and_run(folder, name, main_c);
    }
    remove_all(folder);
    return status;
}

export void test_front_e2e_c_u128_to_and_from_a_c_function() {
    Str body =
        "    let low: u64 = 0xffffffffffffffff\n    let r: u128 = c::wide_add(low.to(u128), 2)\n"
        "    if r.wrap(u64) != 1:\n        return 1\n    if (r >> 64).wrap(u64) != 1:\n        return 2\n    0\n";
    test::check_equal(run_with_header("c_u128", body), 0);
}

export void test_front_e2e_c_function_and_constant_macro() {
    Str body = "    if c::abs(-5) != 5:\n        return 1\n    if c::SCALE != 3:\n        return 2\n    0\n";
    test::check_equal(run_with_header("c_function", body), 0);
}

export void test_front_e2e_c_struct_typedef_and_constant() {
    Str body = "    let mut p: c::point_t = c::point(x = 3, y = 4)\n    if c::sum(&p) != 7:\n        return 1\n"
               "    if c::answer != 42:\n        return 2\n    0\n";
    test::check_equal(run_with_header("c_struct", body), 0);
}

export void test_front_e2e_c_enum() {
    Str body = "    let k: c::color = c::blue\n    if k != c::blue:\n        return 1\n"
               "    if c::green == c::blue:\n        return 2\n    0\n";
    test::check_equal(run_with_header("c_enum", body), 0);
}

// The call is variadic: `printf` gets its arguments after C's promotions and the text reaches stdout.
export void test_front_e2e_c_printf_prints() {
    use_header_flags();
    Str folder = folder_for("c_print");
    Str source = "import <stdio.h>;\n\npub fn main() -> i32:\n"
                 "    let _ = c::printf(\"hello %d %s\\n\", 42, \"world\")\n    0\n";
    compile::Report report = compile_module(folder, "hello", source);
    if (!report.ok) test::check_equal(report.text, as_str(format::push("")));
    if (report.ok) {
        test::check_equal(
            sh_status(as_str(format::push(smith_path(), " cc ", folder, "/hello.o -o ", folder, "/prog"))), 0);
        test::check_equal(sh_status(as_str(format::push(folder, "/prog | grep -q '^hello 42 world$'"))), 0);
    }
    remove_all(folder);
}

// `import c <stdlib.h>` binds `stdlib` (#1678): `stdlib.abs(...)` is the header's `abs`, and there is no global `c`.
export void test_front_e2e_import_c_names_are_read_through_the_binding() {
    use_header_flags();
    Str folder = folder_for("c_dot");
    Str source =
        "import c <stdlib.h>\n\npub fn check() -> i32:\n    if stdlib.abs(-5) != 5:\n        return 1\n    0\n";
    compile::Report report = compile_module(folder, "dot", source);
    if (!report.ok) test::check_equal(report.text, as_str(format::push("")));
    test::check_equal(report.ok, true);
    remove_all(folder);
}

// A variable and a type of a header through the header's name (#3339): `unistd.optind` written and read, and
// `sizeof(stdint.uint32_t)`; the emitter once said "unknown name" for both, as it took the header's name for a value.
export void test_front_e2e_a_header_variable_and_type_are_named_through_the_header() {
    use_header_flags();
    Str folder = folder_for("c_variable");
    Str source = "import c <unistd.h>\nimport c <stdint.h>\n\npub fn check() -> i32:\n"
                 "    unistd.optind = 7\n    h := unistd.optind\n    if h != 7:\n        return 1\n"
                 "    if (sizeof(stdint.uint32_t)).to(i32) != 4:\n        return 2\n    0\n";
    compile::Report report = compile_module(folder, "variable", source);
    if (!report.ok) test::check_equal(report.text, as_str(format::push("")));
    test::check_equal(report.ok, true);
    remove_all(folder);
}

// `let Word = stdint.uint32_t` names a type of the header (#2224): a parameter, a pointer to it and a use compile.
export void test_front_e2e_a_let_names_a_type_of_a_header() {
    use_header_flags();
    Str folder = folder_for("c_alias");
    Str source = "import c <stdint.h>\n\nlet Word = stdint.uint32_t\n\n"
                 "fn bump(w: *mut Word) -> i32:\n    0\n\n"
                 "pub fn check() -> i32:\n    let mut w: Word = 3\n    bump(&w)\n";
    compile::Report report = compile_module(folder, "alias", source);
    if (!report.ok) test::check_equal(report.text, as_str(format::push("")));
    test::check_equal(report.ok, true);
    remove_all(folder);
}

// The same with a capitalized name of a struct (`mem::Allocator`), which the parser reads as a qualified name.
export void test_front_e2e_a_let_names_a_struct_of_a_header() {
    use_header_flags();
    Str folder = folder_for("c_alias_struct");
    c::mkdir(as_str(format::push(folder, "/src")).data, 0o700);
    write_text(as_str(format::push(folder, "/src/big.h")), "typedef struct Big { int x; } Big;\n");
    Str source = "import c \"big.h\"\n\npub let Thing = big.Big\n\n"
                 "pub fn same(a: *Thing) -> *Thing:\n    a\n\n"
                 "pub fn check() -> i32:\n    0\n";
    compile::Report report = compile_module(folder, "alias_struct", source);
    if (!report.ok) test::check_equal(report.text, as_str(format::push("")));
    test::check_equal(report.ok, true);
    remove_all(folder);
}

// `c.abs` with no binding named `c` is an error that says which binding to write.
export void test_front_e2e_a_bare_c_is_an_error_naming_the_binding() {
    use_header_flags();
    Str folder = folder_for("c_bare");
    Str source = "import c <stdlib.h>\n\npub fn check() -> i32:\n    c.abs(-5)\n    0\n";
    compile::Report report = compile_module(folder, "bare", source);
    test::check_equal(report.ok, false);
    test::check_equal(has(report.text, "there is no global `c`: write `stdlib.abs`"), true);
    remove_all(folder);
}

// A name the binding's header does not declare is an error.
export void test_front_e2e_a_name_the_binding_lacks_is_an_error() {
    use_header_flags();
    Str folder = folder_for("c_lacks");
    Str source = "import c <stdlib.h>\n\npub fn check() -> i32:\n    stdlib.not_a_c_function(1)\n    0\n";
    compile::Report report = compile_module(folder, "lacks", source);
    test::check_equal(report.ok, false);
    test::check_equal(has(report.text, "`stdlib.not_a_c_function` is not declared by that header"), true);
    remove_all(folder);
}

// Two bindings: a `size_t` from `string` goes to a `stdlib` function, and `as` picks another binding name.
export void test_front_e2e_two_bindings_share_the_entities_they_reach() {
    use_header_flags();
    Str folder = folder_for("c_two");
    Str source = "import c <stdio.h>\nimport c <stdlib.h>\nimport c <string.h> as str\n\n"
                 "pub fn check(f: *stdio.FILE) -> i32:\n    let p = stdlib.calloc(str.strlen(\"abc\"), 1)\n"
                 "    stdlib.free(p)\n    0\n";
    compile::Report report = compile_module(folder, "two", source);
    if (!report.ok) test::check_equal(report.text, as_str(format::push("")));
    test::check_equal(report.ok, true);
    remove_all(folder);
}

// A name no imported header declares is an error that names it.
export void test_front_e2e_a_c_name_no_header_declares_is_an_error() {
    use_header_flags();
    Str folder = folder_for("c_missing");
    Str source = "import <stdio.h>;\n\npub fn check() -> i32:\n    c::missing_function_name()\n    0\n";
    compile::Report report = compile_module(folder, "missing", source);
    test::check_equal(report.ok, false);
    test::check_equal(has(report.text, "`c::missing_function_name` is not declared by any C header"), true);
    remove_all(folder);
}

// A quoted header next to the source is found in the new spelling, as a binding and by name (point 4 of #2145).
export void test_front_e2e_a_local_header_next_to_the_source_is_found() {
    use_header_flags();
    Str folder = folder_for("c_local");
    c::mkdir(as_str(format::push(folder, "/src")).data, 0o700);
    write_text(as_str(format::push(folder, "/src/kinds.h")), c_header());
    Str source = "import c \"kinds.h\"\nfrom c \"kinds.h\" import sum\n\n"
                 "pub fn check(p: *mut kinds.point_t) -> i32:\n    if sum(p) != 7:\n        return 1\n    0\n";
    compile::Report report = compile_module(folder, "local", source);
    if (!report.ok) test::check_equal(report.text, as_str(format::push("")));
    test::check_equal(report.ok, true);
    remove_all(folder);
}

// An `if` on a constant emits only the branch it takes (#2853): std.mem's `if sanitized:` calls ASan's functions, which
// a program built without ASan does not link. Here the other branch calls `absent`, which no object defines, through a
// constant, its negation and a literal; the object must not name it.
export void test_front_e2e_an_if_on_a_constant_emits_only_its_branch() {
    use_header_flags();
    Str folder = folder_for("constant_if");
    c::mkdir(as_str(format::push(folder, "/src")).data, 0o700);
    write_text(as_str(format::push(folder, "/src/absent.h")), "int absent(void);\n");
    Str source = "import c \"absent.h\"\n\nconst linked: bool = false\n\n"
                 "pub fn check() -> i32:\n    mut n := 0\n    if linked:\n        n = absent.absent()\n"
                 "    if not linked:\n        n += 1\n    else:\n        n = absent.absent()\n"
                 "    if false:\n        n = absent.absent()\n    n - 1\n";
    compile::Report report = compile_module(folder, "constant_if", source);
    if (!report.ok) test::check_equal(report.text, as_str(format::push("")));
    test::check_equal(report.ok, true);
    if (report.ok) {
        Str object = as_str(format::push(folder, "/constant_if.o"));
        test::check_equal(sh_status(as_str(format::push("nm ", object, " | grep -q absent"))), 1);
        Str main_c = as_str(format::push("int check(void) __asm__(\"", prefix(), "constant_if::check\");\n",
                                         "int main(void) { return check(); }\n"));
        test::check_equal(link_and_run(folder, "constant_if", main_c), 0);
    }
    remove_all(folder);
}

// A `str` is the read-only `[]char` of `typeof(x) == []char` (#2853): std.format's rule for a string piece, written
// `const char[:]` in today's syntax and `[]char` once fixed, takes `console.print("hello world\n")`.
export void test_front_e2e_a_str_is_the_char_slice_of_a_type_test() {
    Str folder = folder_for("str_type");
    Str source = "fn kind(args...) -> i32:\n    mut found := 0\n    for arg in args:\n"
                 "        if typeof(arg) == []char:\n            found += 1\n    found\n\n"
                 "pub fn check() -> i32:\n    s: str = \"hi\"\n    if kind(s, 1) != 1:\n        return 1\n    0\n";
    compile::Report report = compile_module(folder, "str_type", source);
    if (!report.ok) test::check_equal(report.text, as_str(format::push("")));
    test::check_equal(report.ok, true);
    if (report.ok) {
        Str main_c = as_str(format::push("int check(void) __asm__(\"", prefix(), "str_type::check\");\n",
                                         "int main(void) { return check(); }\n"));
        test::check_equal(link_and_run(folder, "str_type", main_c), 0);
    }
    remove_all(folder);
}

// `array.filled` at file scope is data in the object, not code (#2339): a module of globals only has no function, the
// zero arrays are in .bss and the others in .data.
export void test_front_e2e_a_filled_global_is_data_and_runs_no_code() {
    Str folder = folder_for("filled_data");
    Str source =
        "import std.array\n\nconst named: usize = 1024\n\npub mut zeros: [named]u8 = array.filled(u8, named, 0)\n"
        "pub mut sevens: [256]u32 = array.filled(u32, 256, 7)\n";
    compile::Report report = compile_module(folder, "filled_data", source);
    if (!report.ok) test::check_equal(report.text, as_str(format::push("")));
    test::check_equal(report.ok, true);
    if (report.ok) {
        Str object = as_str(format::push(folder, "/filled_data.o"));
        test::check_equal(sh_status(as_str(format::push("nm ", object, " | grep -q -i ' t '"))), 1);
        test::check_equal(sh_status(as_str(format::push("nm ", object, " | grep -q ' b .*zeros'"))), 0);
        test::check_equal(sh_status(as_str(format::push("nm ", object, " | grep -q ' [dD] .*sevens'"))), 0);
        test::check_equal(sh_status(as_str(format::push("nm ", object, " | grep -q 'init'"))), 1);
    }
    remove_all(folder);
}

// A struct tag and a function of one name (#2610): `stat.stat` is the struct in a type and the function in a call, and
// the struct that `stat()` fills holds three `struct timespec` by value.
export void test_front_e2e_a_c_tag_and_function_of_one_name_are_told_apart_by_position() {
    use_header_flags();
    Str folder = folder_for("c_tag_fn");
    Str source = "import c <sys/stat.h>\n\npub fn size_of(path: *char) -> i64:\n    mut info: stat.stat = undefined\n"
                 "    if stat.stat(path, &info) != 0:\n        return -1\n    info.st_size\n";
    compile::Report report = compile_module(folder, "tag_fn", source);
    if (!report.ok) test::check_equal(report.text, as_str(format::push("")));
    test::check_equal(report.ok, true);
    remove_all(folder);
}

// `struct sigaction` and `sigaction()`: the struct holds a union, which is sized and aligned like C's.
export void test_front_e2e_sigaction_is_a_struct_in_a_type_and_a_function_in_a_call() {
    use_header_flags();
    Str folder = folder_for("c_sigaction");
    Str source =
        "import c <signal.h>\n\npub fn install(signo: i32) -> i32:\n    mut action: signal.sigaction = undefined\n"
        "    signal.sigaction(signo, &action, nullptr)\n";
    compile::Report report = compile_module(folder, "sigaction", source);
    if (!report.ok) test::check_equal(report.text, as_str(format::push("")));
    test::check_equal(report.ok, true);
    remove_all(folder);
}
