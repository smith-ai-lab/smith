// A typedef of a function pointer (#2384, part of #1631): `typedef const ast::Stmt *(*Choose)(const ast::Stmt *s);`
// goes through `smith lint --fix` to an alias `Choose := fn(*ast.Stmt) -> *ast.Stmt`, and the text it ends with
// parses with no error. Before, the new parser read the alias as a lambda: "expected a parameter name, found `*`".
module front_fix_fn_alias_test;

import front::fix;
import front::parser;
import std::arena;
import std::mem;
import std::test;

static Bool contains(Str contents, Str piece) {
    if (countof(piece) > countof(contents)) return false;
    for (Usize i = 0; i + countof(piece) <= countof(contents); i += 1) {
        if (mem::equal(contents[i:i + countof(piece)], piece)) return true;
    }
    return false;
}

export void test_front_fix_fn_alias_parses() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str before = "module m;\nimport front::ast;\nexport typedef const ast::Stmt *(*Choose)(const ast::Stmt *s);\n\n"
                 "typedef enum {\n    ast::Decl *decl;\n    ast::Stmt *stmt;\n} Node;\n";
    fix::Fixed first = fix::fix_text("t.smith", before);
    parser::Parsed parsed = fix::parse_for_fix("t.smith", first.text);
    test::check_equal(countof(parsed.errors), (Usize)0);
    fix::Fixed second = fix::fix_text("t.smith", first.text);
    test::check_equal(second.applied, (Usize)0);
}

// A typedef in a block is an alias too (from #2668): `typedef I32 (*Flag)(I32);` inside a function is `Flag := fn(i32)
// -> i32`, and the text parses.
export void test_front_fix_fn_alias_in_a_block() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str before = "module m;\nexport I32 run(void *address) {\n    typedef I32 (*Flag)(I32);\n"
                 "    Flag typed = (Flag)address;\n    return typed(1);\n}\n";
    fix::Fixed first = fix::fix_text("t.smith", before);
    test::check_condition(contains(first.text, "    Flag := fn(i32) -> i32\n"));
    parser::Parsed parsed = fix::parse_for_fix("t.smith", first.text);
    test::check_equal(countof(parsed.errors), (Usize)0);
}

// Two function-pointer locals set to lambdas in a row (from the lambda-two case of tests/smith-lang): a pass that wrote
// the type and the body but not the header left `Fn(I32 (I32)) add = [](I32 a): a;`, and a type written first
// (`fn(i32) -> i32 mul = fn(a: i32): a`) read as a function with no name. Both go to `name: type = value`.
export void test_front_fix_function_pointer_locals_set_to_lambdas() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str before = "module m;\nI32 run() {\n    I32 (*add)(I32) = [](I32 a) { return a; };\n"
                 "    I32 (*mul)(I32) = [](I32 a) { return a; };\n    return add(1) + mul(2);\n}\n";
    fix::Fixed fixed = fix::fix_text("t.smith", before);
    test::check_condition(contains(fixed.text, "    add: fn(i32) -> i32 = fn(a: i32): a"));
    test::check_condition(contains(fixed.text, "    mul: fn(i32) -> i32 = fn(a: i32): a"));
    test::check_condition(!contains(fixed.text, "[]("));
    test::check_condition(!contains(fixed.text, "Fn("));
}

// A typedef of a tag declared elsewhere is an alias of the tag (#3318): `typedef enum Color Paint;` is `Paint :=
// Color`, `typedef struct Opaque Hidden;` stays the opaque `struct Hidden` (its tag may be declared nowhere), and a
// function pointer that returns a tag, `typedef struct BigC (*Make)(U8);`, is `Make := fn(u8) -> BigC`.
export void test_front_fix_typedef_of_a_tag_is_an_alias() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str before = "module m;\nstruct BigC { U8 data; };\nstruct Opaque;\n"
                 "typedef enum Color Paint;\ntypedef struct Opaque Hidden;\ntypedef struct BigC (*Make)(U8);\n";
    fix::Fixed first = fix::fix_text("t.smith", before);
    fix::Fixed second = fix::fix_text("t.smith", first.text);
    test::check_condition(contains(second.text, "Paint := Color\n"));
    test::check_condition(contains(second.text, "struct Hidden\n"));
    test::check_condition(contains(second.text, "Make := fn(u8) -> BigC\n"));
    test::check_condition(!contains(second.text, "typedef"));
}

// `constexpr Type Handler = Response (*)(Request *, I32);` is the alias `Handler := fn(*mut Request, i32) -> Response`
// (#3318): the first round writes the function type and the word `type`, and the second reads that declaration again.
export void test_front_fix_type_value_of_a_function_pointer_is_an_alias() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str before = "module m;\nstruct Request { I32 id; };\nstruct Response { I32 code; };\n"
                 "constexpr Type Handler = Response (*)(Request *, I32);\nconstexpr Type Callback = void (*)(void);\n";
    fix::Fixed text = fix::fix_text("t.smith", before);
    for (Usize round = 0; round < 3; round += 1)
        text = fix::fix_text("t.smith", text.text);
    test::check_condition(contains(text.text, "Handler := fn("));
    test::check_condition(contains(text.text, "Callback := fn()"));
    test::check_condition(!contains(text.text, "constexpr"));
    parser::Parsed parsed = fix::parse_for_fix("t.smith", text.text);
    test::check_equal(countof(parsed.errors), (Usize)0);
}
