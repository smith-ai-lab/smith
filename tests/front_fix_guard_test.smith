// Tests of the fix-it for a Result read after a guard that leaves (#2648): `if r == .error:` becomes the binding
// `.ok(ok) := r else:` and the reads `r.ok` become `ok`.
module front_fix_guard_test;

import front::fix;
import front::fix_guard;
import front::parse as core;
import std::arena;
import std::format;
import std::mem;
import std::test;

static Str as_str(char chars[:]) {
    return chars;
}

// Applies the fixes of `fix_guard::edits(source)` from the back, so the offsets hold.
static Str applied(Str source) {
    core::Errors found = fix_guard::edits(source);
    Str text = source;
    for (Usize k = 0; k < countof(found); k++) {
        Usize best = k;
        for (Usize j = k + 1; j < countof(found); j++)
            if (found[j].fix[0].span.start > found[best].fix[0].span.start) best = j;
        core::ParseError pick = found[best];
        found[best] = found[k];
        found[k] = pick;
    }
    for (Usize k = 0; k < countof(found); k++) {
        core::Edit edit = found[k].fix[0];
        Str before = text[0:edit.span.start];
        Str after = text[edit.span.end:countof(text)];
        text = as_str(format::push(before, edit.text, after));
    }
    return text;
}

static void expect(Str before, Str want) {
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    test::check_equal(applied(before), want);
}

export void test_front_fix_guard_a_return_after_the_error_test_is_a_binding_with_an_else() {
    expect("fn f(s: Str) -> Str:\n    lexed: Lexed = tokenize(s)\n    if lexed == .error:\n        return s\n"
           "    tokens: Tokens = lexed.ok\n    return s\n",
           "fn f(s: Str) -> Str:\n    lexed: Lexed = tokenize(s)\n    .ok(ok) := lexed else:\n        return s\n"
           "    tokens: Tokens = ok\n    return s\n");
}

export void test_front_fix_guard_a_one_line_body_stays_on_the_line() {
    expect("fn f(s: Str):\n    r := g(s)\n    if r == .error: return\n    use(r.ok)\n",
           "fn f(s: Str):\n    r := g(s)\n    .ok(ok) := r else: return\n    use(ok)\n");
}

export void test_front_fix_guard_a_body_that_mentions_the_result_is_left() {
    expect("fn f(s: Str):\n    r := g(s)\n    if r == .error:\n        return r.error\n    use(r.ok)\n",
           "fn f(s: Str):\n    r := g(s)\n    if r == .error:\n        return r.error\n    use(r.ok)\n");
}

export void test_front_fix_guard_a_body_that_uses_the_result_as_a_value_is_a_binding_with_an_else() {
    expect("fn f(s: Str):\n    r := g(s)\n    if r == .error:\n        out = r\n        break\n    use(r.ok)\n",
           "fn f(s: Str):\n    r := g(s)\n    .ok(ok) := r else:\n        out = r\n        break\n    use(ok)\n");
}

export void test_front_fix_guard_returning_a_mut_result_is_a_binding_with_an_else() {
    expect("fn f(s: Str):\n    mut r := g(s)\n    if r == .error: return r\n    use(r.ok)\n",
           "fn f(s: Str):\n    mut r := g(s)\n    .ok(ok) := r else: return r\n    use(ok)\n");
}

export void test_front_fix_guard_a_value_that_leaves_binds_the_error_of_the_rest() {
    expect("fn f(s: Str):\n    r := g(s)\n    if r == .ok:\n        return r\n    use(r.error)\n",
           "fn f(s: Str):\n    r := g(s)\n    .error(error) := r else:\n        return r\n    use(error)\n");
    expect("fn f(s: Str):\n    r := g(s)\n    if r != .error: return r\n    mut error: Error = r.error\n",
           "fn f(s: Str):\n    r := g(s)\n    .error(error_value) := r else: return r\n    mut error: Error = error_value\n");
}

export void test_front_fix_guard_a_body_that_does_not_leave_is_left() {
    expect("fn f(s: Str):\n    r := g(s)\n    if r == .error:\n        log(s)\n    use(r.ok)\n",
           "fn f(s: Str):\n    r := g(s)\n    if r == .error:\n        log(s)\n    use(r.ok)\n");
}

export void test_front_fix_guard_a_name_ok_in_the_function_makes_the_binding_ok_value() {
    expect("fn f(s: Str):\n    ok := 1\n    r := g(s)\n    if r == .error: return\n    use(r.ok)\n",
           "fn f(s: Str):\n    ok := 1\n    r := g(s)\n    .ok(ok_value) := r else: return\n    use(ok_value)\n");
    expect("fn f(s: Str):\n    ok := 1\n    ok_value := 2\n    r := g(s)\n    if r == .error: return\n    use(r.ok)\n",
           "fn f(s: Str):\n    ok := 1\n    ok_value := 2\n    r := g(s)\n    if r == .error: return\n    use(r.ok)\n");
}

export void test_front_fix_guard_a_call_named_like_return_is_not_a_leave() {
    expect("fn f(s: Str):\n    r := g(s)\n    if r == .error: returned(s)\n    use(r.ok)\n",
           "fn f(s: Str):\n    r := g(s)\n    if r == .error: returned(s)\n    use(r.ok)\n");
}

// The whole fixer on `before` gives `after`, and a second run changes nothing.
static void expect_fixed(Str before, Str after) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed first = fix::fix_text("t.smith", before);
    test::check_equal(first.text, after);
    fix::Fixed again = fix::fix_text("t.smith", first.text);
    test::check_equal(again.text, after);
}

static Str half_text() {
    return "fn half(n: i32) -> Result(i32, i32):\n    if n < 0:\n        return .error(n)\n    .ok(n / 2)\n";
}

static Str with_half(Str rest) {
    return as_str(format::push(half_text(), rest));
}

// `R == .error` is `R != .ok` where `R.ok` is read after it (#3083): the checker then binds the guard of an `or` chain.
// The blank line is the chain's own split (`types_decl::note_rest_guard`).
export void test_front_fix_guard_an_error_test_in_an_or_chain_is_a_guard() {
    expect_fixed(with_half("fn small(n: i32) -> i32:\n    r := half(n)\n    if r == .error or r.ok > 100:\n"
                           "        return 0\n    r.ok\n"),
                 with_half("fn small(n: i32) -> i32:\n    r := half(n)\n    .ok(ok) := r else:\n        return 0\n"
                           "    \n    if ok > 100:\n        return 0\n    ok\n"));
}

// `R != .error` is `R == .ok`, which starts an `and` chain that binds the payload.
export void test_front_fix_guard_a_not_error_test_starts_an_and_chain() {
    expect_fixed(with_half("fn big(n: i32) -> i32:\n    r := half(n)\n    if r != .error and r.ok > 3:\n"
                           "        return r.ok\n    -1\n"),
                 with_half("fn big(n: i32) -> i32:\n    r := half(n)\n    if .ok(ok) := r and ok > 3:\n"
                           "        return ok\n    -1\n"));
}

// The `else` of a Result's test reads the other variant: `else if .ok(ok) := r:`, and the same the other way round.
export void test_front_fix_guard_the_else_binds_the_other_variant() {
    expect_fixed(with_half("fn either(n: i32) -> i32:\n    r := half(n)\n    mut total := 0\n    if r == .error:\n"
                           "        total = r.error\n    else:\n        total = r.ok + 1\n    total\n"),
                 with_half("fn either(n: i32) -> i32:\n    r := half(n)\n    mut total := 0\n"
                           "    if .error(error) := r:\n        total = error\n    else if .ok(ok) := r:\n"
                           "        total = ok + 1\n    total\n"));
    expect_fixed(with_half("fn either(n: i32) -> i32:\n    r := half(n)\n    mut total := 0\n    if r == .ok:\n"
                           "        total = r.ok\n    else:\n        total = r.error - 1\n    total\n"),
                 with_half("fn either(n: i32) -> i32:\n    r := half(n)\n    mut total := 0\n"
                           "    if .ok(ok) := r:\n        total = ok\n    else if .error(error) := r:\n"
                           "        total = error - 1\n    total\n"));
}

// A name the earlier test bound in the function is not reused: the `else` binds `error_value` (#3211).
export void test_front_fix_guard_the_else_binds_error_value_where_error_is_bound_above() {
    expect_fixed(
        with_half("fn either(n: i32) -> i32:\n    r := half(n)\n    mut total := 0\n"
                  "    if .error(error) := r:\n        total = error\n"
                  "    if .ok(ok) := r:\n        total = ok\n    else:\n        total = r.error - 1\n    total\n"),
        with_half("fn either(n: i32) -> i32:\n    r := half(n)\n    mut total := 0\n"
                  "    if .error(error) := r:\n        total = error\n"
                  "    if .ok(ok) := r:\n        total = ok\n    else if .error(error_value) := r:\n"
                  "        total = error_value - 1\n    total\n"));
}

// A generic function's Result is read the same way.
export void test_front_fix_guard_a_generic_result_is_bound() {
    Str wrap = "fn wrap(T: type, value: T) -> Result(T, i32):\n    .ok(value)\n";
    expect_fixed(
        as_str(format::push(wrap, "fn read() -> i64:\n    w := wrap(i64, 9)\n    if w != .error and w.ok == 9:\n"
                                  "        return w.ok\n    0\n")),
        as_str(format::push(wrap, "fn read() -> i64:\n    w := wrap(i64, 9)\n    if .ok(ok) := w and ok == 9:\n"
                                  "        return ok\n    0\n")));
}

// A guard that passes the result up is `try`'s, a `match` binds its arms, and a name `ok` leaves the tests alone.
export void test_front_fix_guard_try_match_and_a_taken_name_keep_their_forms() {
    expect_fixed(with_half("fn quarter(n: i32) -> Result(i32, i32):\n    r := half(n)\n    if r == .error:\n"
                           "        return r\n    half(r.ok)\n"),
                 with_half("fn quarter(n: i32) -> Result(i32, i32):\n    ok := try half(n)\n    half(ok)\n"));
    expect_fixed(with_half("fn arms(n: i32) -> i32:\n    r := half(n)\n    match r:\n        .ok: r.ok\n"
                           "        .error: r.error\n"),
                 with_half("fn arms(n: i32) -> i32:\n    r := half(n)\n    match r:\n        .ok(ok): ok\n"
                           "        .error(error): error\n"));
    Str taken = with_half("fn taken(n: i32) -> i32:\n    ok := 3\n    r := half(n)\n    if r == .error or r.ok > 9:\n"
                          "        return ok\n    r.ok\n");
    // `ok` is a name of the function, so the binding is `ok_value` (#3205)
    expect_fixed(taken, with_half("fn taken(n: i32) -> i32:\n    ok := 3\n    r := half(n)\n"
                                  "    .ok(ok_value) := r else:\n        return ok\n    \n"
                                  "    if ok_value > 9:\n        return ok\n    ok_value\n"));
}

// A variant test after the first conjunct of an `and` chain is a pattern where it stands (#3083; the lead, Q1 (b)): the
// conjuncts before it still run first, and a name of the variant already in the function is spelled `<variant>_value`.
export void test_front_fix_guard_a_test_inside_an_and_chain_is_a_pattern() {
    expect_fixed(with_half("fn later(n: i32) -> i32:\n    r := half(n)\n    if n > 2 and r == .ok:\n"
                           "        return r.ok\n    -1\n"),
                 with_half("fn later(n: i32) -> i32:\n    r := half(n)\n    if n > 2 and .ok(ok) := r:\n"
                           "        return ok\n    -1\n"));
    expect_fixed(with_half("fn inner(n: i32) -> i32:\n    first := half(n)\n    second := half(n + 2)\n"
                           "    if .ok(ok) := first:\n        if ok > 1 and second != .error:\n"
                           "            return ok + second.ok\n    -1\n"),
                 with_half("fn inner(n: i32) -> i32:\n    first := half(n)\n    second := half(n + 2)\n"
                           "    if .ok(ok) := first:\n        if ok > 1 and .ok(ok_value) := second:\n"
                           "            return ok + ok_value\n    -1\n"));
    Str shape = "enum Shape:\n    circle: i32\n    empty\n";
    expect_fixed(as_str(format::push(shape, "fn radius(s: Shape, n: i32) -> i32:\n    if n > 0 and s == .circle:\n"
                                            "        return s.circle\n    0\n")),
                 as_str(format::push(shape, "fn radius(s: Shape, n: i32) -> i32:\n"
                                            "    if n > 0 and s is .circle:\n        return s\n    0\n")));
}

// The same test of a payload enumeration is `is` and the name narrows (#3227); a `mut` name keeps the pattern.
export void test_front_fix_guard_a_payload_test_in_an_and_chain_is_written_with_is() {
    Str shape = "struct Circle:\n    r: i32\n\nenum Shape:\n    circle: Circle\n    empty\n\n";
    expect_fixed(as_str(format::push(shape, "fn big(s: Shape, n: i32) -> i32:\n    if n > 0 and s == .circle and "
                                            "s.circle.r > 1:\n        return s.circle.r\n    0\n")),
                 as_str(format::push(shape, "fn big(s: Shape, n: i32) -> i32:\n    if n > 0 and s is .circle and "
                                            "s.r > 1:\n        return s.r\n    0\n")));
}

// A chain with an `or`, and a body that writes the result, stay as they are.
export void test_front_fix_guard_an_or_chain_and_a_write_keep_the_test() {
    Str written = with_half("fn written(n: i32) -> i32:\n    mut r := half(n)\n    if n > 2 and r == .ok:\n"
                            "        r = half(1)\n        return r.ok\n    -1\n");
    expect_fixed(written, written);
}

// The test of a Result's error whose body leaves, with the value read below it, is a `match` (#3083; the lead, Q2 (b)).
export void test_front_fix_guard_an_error_body_that_returns_is_a_match_arm() {
    expect_fixed(
        with_half("fn handled(n: i32) -> i32:\n    r := half(n)\n    if r == .error:\n"
                  "        return r.error * 2\n    r.ok + 1\n"),
        with_half("fn handled(n: i32) -> i32:\n    r := half(n)\n    ok := match r:\n        .ok(value): value\n"
                  "        .error(error): return error * 2\n    ok + 1\n"));
}

// Two such tests in one function do not both declare `ok`: the second is `ok_value`, which shadowing would refuse
// (#3478).
export void test_front_fix_guard_a_second_match_in_a_function_does_not_hide_the_first() {
    expect_fixed(with_half("fn twice(n: i32) -> i32:\n    r := half(n)\n    if r == .error:\n        return r.error\n"
                           "    s := half(r.ok)\n    if s == .error:\n        return s.error\n    s.ok\n"),
                 with_half("fn twice(n: i32) -> i32:\n    r := half(n)\n    ok := match r:\n        .ok(value): value\n"
                           "        .error(error): return error\n    s := half(ok)\n"
                           "    ok_value := match s:\n        .ok(value): value\n        .error(error): return error\n"
                           "    ok_value\n"));
}

// A body that does not leave keeps the test, and the read below it stays for the next fix.
export void test_front_fix_guard_an_error_body_that_does_not_leave_is_left() {
    expect_fixed(with_half("fn kept(n: i32) -> i32:\n    r := half(n)\n    mut total := 0\n    if r == .error:\n"
                           "        total = r.error\n    total + r.ok\n"),
                 with_half("fn kept(n: i32) -> i32:\n    r := half(n)\n    mut total := 0\n"
                           "    if .error(error) := r:\n        total = error\n    total + r.ok\n"));
}

static Str node_text() {
    return "struct Node:\n    kind: Kind\n\nenum Kind:\n    next: *Node\n    leaf\n\n";
}

// A write of the tested name whose right side reads the payload binds it: the binding is a copy taken at the test
// (#3210).
export void test_front_fix_guard_a_payload_read_that_moves_the_name_is_a_binding() {
    expect_fixed(as_str(format::push(node_text(), "fn last(mut n: *Node) -> bool:\n    while n != nullptr:\n"
                                                  "        if n.kind == .next:\n            n = n.kind.next\n"
                                                  "        else:\n            return false\n    true\n")),
                 as_str(format::push(node_text(), "fn last(mut n: *Node) -> bool:\n    while n != nullptr:\n"
                                                  "        if .next(next) := n.kind:\n            n = next\n"
                                                  "        else:\n            return false\n    true\n")));
}

// The same write followed by a read of the payload stays: the read would see the new name.
export void test_front_fix_guard_a_payload_read_after_the_name_moves_is_left() {
    Str stale = as_str(format::push(node_text(), "fn twice(mut n: *Node) -> *Node:\n    if n.kind == .next:\n"
                                                 "        n = n.kind.next\n        return n.kind.next\n    n\n"));
    expect_fixed(stale, stale);
}

static Str pair_text() {
    return "struct Node:\n    kind: Kind\n\nenum Kind:\n    pair: i32\n    leaf\n\n";
}

// A test of a field path stays as written and the read after it drops the variant (#3598): `n.kind` is the payload
// where the test narrowed it, whichever test it was (`==`, `!=` with an early `return`).
export void test_front_fix_guard_a_field_test_is_left_and_the_payload_is_read_direct() {
    expect_fixed(as_str(format::push(pair_text(), "fn size(n: *Node) -> i32:\n    if n.kind == .pair:\n"
                                                  "        return n.kind.pair + 1\n    return 0\n")),
                 as_str(format::push(pair_text(), "fn size(n: *Node) -> i32:\n    if n.kind == .pair:\n"
                                                  "        return n.kind + 1\n    return 0\n")));
    expect_fixed(as_str(format::push(pair_text(), "fn other(n: *Node) -> i32:\n    if n.kind != .pair:\n"
                                                  "        return 0\n    return n.kind.pair\n")),
                 as_str(format::push(pair_text(), "fn other(n: *Node) -> i32:\n    if n.kind != .pair:\n"
                                                  "        return 0\n    return n.kind\n")));
}
