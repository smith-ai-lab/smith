// Tests of front::parse_decl (#1147, A5 of track A of #1112): declarations and whole files, read with small stubs of
// the three hooks of the other tickets (types, expressions, statements), dumped with `ast::dump` against the golden
// files of tests/front/parse_decl (`smith test --update` writes a changed one), and one test for each error, which
// checks that the message names the fix. Each test gives the current allocator an arena.
module front_parse_decl_test;

import front::ast;
import front::lex;
import front::parse;
import front::parse_decl;
import std::arena;
import std::mem;
import std::test;

typedef ast::TypeRef TypeRefList[:];
typedef ast::StmtRef StmtRefList[:];

static Bool same(Str a, Str b) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

// The name of a variable declaration, or empty.
static Str variable_name(const ast::Decl *d) {
    if (d->kind == .variable) return d->kind.variable.name;
    return "";
}

// Two texts are the same.
static void expect_text(Str actual, Str expected) {
    test::check_equal(actual, expected);
}

// ---------------------------------------------------------------------------------------------------------------
// The stubs: just enough of a type, an expression and a statement for the declarations to hold.

// `a::b::C` read from the tokens, as a path.
static ast::Path stub_path(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    U32 end = start;
    while (parse::at(p, lex::name) || parse::at(p, lex::type_name)) {
        end = parse::advance(p).span.end;
        if (!parse::accept(p, lex::colon_colon)) break;
    }
    return ast::path(p->source[start:end]);
}

static TypeRefList stub_params(parse::Parser *p) {
    ast::TypeRef *block = (ast::TypeRef *)mem::alloc_array_raw(sizeof(ast::TypeRef), 8, alignof(ast::TypeRef));
    Usize count = 0;
    parse::expect(p, lex::left_paren, "`(`");
    while (!parse::at(p, lex::right_paren) && !parse::at(p, lex::end_of_file) && count < 8) {
        block[count] = parse::type(p);
        count += 1;
        if (!parse::accept(p, lex::comma)) break;
    }
    parse::expect(p, lex::right_paren, "`)`");
    TypeRefList params = block[0:count];
    return params;
}

// `I32`, `c::size_t`, `const T` and `T *`.
static ast::TypeExpr *stub_base(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    Bool is_const = parse::accept(p, lex::kw_const);
    Bool is_path =
        parse::at(p, lex::type_name) || (parse::at(p, lex::name) && parse::peek_at(p, 1).kind == lex::colon_colon);
    if (!is_path) {
        parse::error(p, parse::peek(p).span, "the type stub reads a type name");
        return nullptr;
    }
    ast::Path path = stub_path(p);
    ast::TypeKind kind = {.named = {.path = path}};
    ast::TypeExpr *type = ast::new_type((ast::TypeExpr){.kind = kind});
    while (parse::accept(p, lex::star)) {
        ast::TypeKind pointer = {.pointer = {.pointee = type}};
        type = ast::new_type((ast::TypeExpr){.kind = pointer});
    }
    type->qualifiers.is_const = is_const;
    type->span = parse::span_from(p, start);
    return type;
}

// A base type, or `Fn(R (P, Q))`.
static ast::TypeExpr *stub_type(parse::Parser *p) {
    U32 start = parse::peek(p).span.start;
    Bool is_fn = parse::at(p, lex::type_name) && same(parse::text(p, parse::peek(p)), "Fn") &&
                 parse::peek_at(p, 1).kind == lex::left_paren;
    if (!is_fn) return stub_base(p);
    ast::Path path = stub_path(p);
    parse::advance(p);
    ast::TypeExpr *result = stub_base(p);
    TypeRefList params = stub_params(p);
    parse::expect(p, lex::right_paren, "`)`");
    ast::TypeKind function = {.function = {.params = params, .result = result}};
    ast::TypeArg args[:] = mem::alloc_slice(ast::TypeArg, 1);
    ast::TypeArg arg = {.type = {.type = ast::new_type((ast::TypeExpr){.kind = function})}};
    args[0] = arg;
    ast::TypeKind applied = {.applied = {.name = path, .args = args}};
    ast::TypeExpr *type = ast::new_type((ast::TypeExpr){.kind = applied});
    type->span = parse::span_from(p, start);
    return type;
}

// An integer, a string or a name.
static ast::Expr *stub_expression(parse::Parser *p) {
    lex::Token token = parse::peek(p);
    if (token.kind == lex::integer) {
        parse::advance(p);
        U64 value = 0;
        for (char digit : parse::text(p, token)) {
            value = value * 10 + (U64)(digit - '0');
        }
        return ast::integer(value);
    }
    if (token.kind == lex::string) {
        Str text = parse::text(p, parse::advance(p));
        return ast::string(text[1:countof(text) - 1]);
    }
    if (token.kind == lex::name || token.kind == lex::type_name) {
        ast::Path path = stub_path(p);
        ast::ExprKind kind = {.name = {.path = path}};
        return ast::expr(kind);
    }
    parse::error(p, token.span, "the expression stub reads an integer, a string or a name");
    return nullptr;
}

// `{ return e; ... }`: the returns of the block, and every other token skipped.
static ast::Stmt *stub_statement(parse::Parser *p) {
    parse::expect(p, lex::left_brace, "`{`");
    ast::StmtRef *block = (ast::StmtRef *)mem::alloc_array_raw(sizeof(ast::StmtRef), 8, alignof(ast::StmtRef));
    Usize count = 0;
    while (!parse::at(p, lex::right_brace) && !parse::at(p, lex::end_of_file)) {
        if (parse::accept(p, lex::kw_return) && count < 8) {
            block[count] = ast::return_value(parse::expression(p));
            count += 1;
        } else {
            parse::advance(p);
        }
    }
    parse::expect(p, lex::right_brace, "`}`");
    StmtRefList items = block[0:count];
    return ast::block(items);
}

// ---------------------------------------------------------------------------------------------------------------
// Helpers

// A parser over the tokens of source with the stubs and the declaration parser installed; a lexing error fails the
// test.
static parse::Parser parser_of(Str source) {
    lex::Lexed lexed = lex::tokenize(source);
    lex::Tokens tokens = {};
    switch (lexed) {
    case .ok:
        tokens = lexed.ok;
        break;
    case .error:
        Str expected = "no error";
        test::check_equal(lexed.error.message, expected);
    }
    parse::Parser p = parse::make(tokens, source);
    p.hooks.expression = stub_expression;
    p.hooks.type = stub_type;
    p.hooks.statement = stub_statement;
    p.hooks.declaration = parse_decl::declaration;
    return p;
}

// The dump of a whole file; an error recorded while parsing fails the test.
static Str dump_of(Str source) {
    parse::Parser p = parser_of(source);
    ast::Module m = parse_decl::file(&p, "test.smith");
    if (countof(p.errors) > 0) {
        Str expected = "no error";
        test::check_equal(p.errors[0].message, expected);
    }
    return ast::dump(&m);
}

// The first error recorded for a whole file, or `no error`.
static Str first_error(Str source) {
    parse::Parser p = parser_of(source);
    ast::Module m = parse_decl::file(&p, "test.smith");
    if (countof(p.errors) == 0) return "no error";
    return p.errors[0].message;
}

// ---------------------------------------------------------------------------------------------------------------
// Golden dumps

export void test_parse_decl_variables() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "I32 a;\n"
                 "export I32 b = 3;\n"
                 "static I32 c;\n"
                 "extern I32 d;\n"
                 "constexpr I32 e = 4;\n"
                 "thread_local I32 f;\n"
                 "static inline I32 g;\n"
                 "[[std::pure]] I32 h;\n"
                 "[[std::c_name(\"i\")]] export I32 i;\n"
                 "const I32 j = 1;\n"
                 "c::size_t k;\n"
                 "I32 *l = 0;\n"
                 "auto m = 5;\n"
                 "I32 xs[4];\n"
                 "I32 ys[:];\n"
                 "I32 grid[:][2];\n"
                 "I32 cube[2][3][4];\n"
                 "Fn(I32 (I32)) callback;\n";
    test::golden("tests/front/parse_decl/variables.txt", dump_of(source));
}

export void test_parse_decl_functions() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str source = "export I32 first(I32 a, I32 b) { return a; }\n"
                 "Void proto(I32, I32 b);\n"
                 "I32 count(void);\n"
                 "I32 none();\n"
                 "I32 sum(I32 xs[4], I32 ys[:], I32 m[:][2]);\n"
                 "Void generic(constexpr Type T, T x, auto... rest);\n"
                 "I32 printf_like(Str format, ...);\n"
                 "Void tagged([[std::maybe_unused]] I32 x, I32 y [[std::maybe_unused]]);\n"
                 "static inline I32 twice(I32 x) { return x; }\n"
                 "[[std::pure]] I32 pure(I32 x);\n"
                 "Fn(I32 (I32)) pick(Fn(I32 (I32)) f);\n";
    test::golden("tests/front/parse_decl/functions.txt", dump_of(source));
}

