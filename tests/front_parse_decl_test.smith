                 "import std::arena;\n"
                 "import geometry::box;\n"
                 "import <stdio.h>;\n"
                 "import <sys/stat.h>;\n"
                 "import \"x.h\";\n"
                 "static_assert(1, \"one\");\n"
                 "static_assert(2);\n"
                 "if constexpr (flag) { import <unistd.h>; I32 posix; } else { I32 other; }\n"
                 "if constexpr (a) { if constexpr (b) { I32 both; } else { I32 only_a; } }\n"
                 "if constexpr (a) { I32 x; } else if constexpr (b) { I32 y; } else { I32 z; }\n"
                 "if constexpr (c) { }\n"
                 "[[std::pure]] I32 attributed(I32 x);\n";
    test::golden("tests/front/parse_decl/file_level.txt", dump_of(source));
}

