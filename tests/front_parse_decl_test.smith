                 "typedef struct { F32 radius; } Circle;\n"
                 "typedef union { U32 word; U8 byte; } Word;\n"
                 "typedef struct Pair { I32 a; I32 b; } Pair;\n"
                 "enum Color { red, green = 2, blue };\n"
                 "enum Small : U8 { low, high = 255, };\n"
                 "typedef enum { Circle circle; Rect rect; empty; } Shape;\n"
                 "typedef enum : U8 { Circle circle; empty; } Tagged;\n"
                 "export typedef I32 Index;\n"
                 "typedef I32 Row[4];\n"
                 "typedef Fn(I32 (I32)) Handler;\n";
    test::golden("tests/front/parse_decl/types.txt", dump_of(source));
}

export void test_parse_decl_file_level() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
