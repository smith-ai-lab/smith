// Workers, --in-process and --explain, ported from tests/test.sh (sections 8c, 12 and 12b): tests run one after another
// in a pool of long-lived processes, and --isolate gives each its own; --stats prints the forks the run made, which
// tells the two apart. A group is chosen with --test <prefix> and runs on one worker (--jobs 1), its tests in the order
// written. Each case runs as workers and with --isolate unless it is about one of them. Fixtures:
// tests/build_fixtures/runner_workers, _many, _inproc and _explain.
module test_runner_workers_test;

import smith::format;
import smith::io;
import smith::test;
import runner;
import scratch;

static scratch::Project workers_project(io::Io *io) {
    return runner::built_project(io, "runner_base", "runner_workers", "");
}

// The same, for a test that runs `smith test` in it (a copy of the built project, so that build has nothing to do).
static scratch::Project workers_copy(io::Io *io) {
    return runner::built_copy(io, "runner_base", "runner_workers", "");
}

// The forks a run is expected to make: the value of the workers, and of --isolate.
static usize by_mode(usize mode, usize workers, usize isolated) {
    return mode == 0 ? workers : isolated;
}

export void test_runner_workers_a_crash_midway_fails_its_test_and_costs_a_fresh_worker(io::Io *io) {
    scratch::Project p = workers_project(io);
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = runner::tests(&p, iso, "--test crash_ --jobs 1 --stats");
        runner::expect_has(io, iso, "workers: a crash midway fails its test", &run,
                           "FAIL crash_2_dies: killed by SIGABRT");
        runner::expect_has(io, iso, "workers: ... with its note", &run, "    note: about to abort");
        runner::expect_has(io, iso, "workers: ... and the tests after it still run", &run, "3 passed, 1 failed");
        scratch::expect_count(
            runner::label(io, iso, "workers: ... the crash cost a fresh worker (forks: 2 against one per test)"),
            by_mode(mode, 2, 4), runner::forks_of(&run));
    }
}

export void test_runner_workers_a_hang_fails_its_test_and_replaces_the_worker(io::Io *io) {
    scratch::Project p = workers_project(io);
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        // wall time on purpose: a test of the backstop
        scratch::Run run = runner::tests(&p, iso, "--test late_ --jobs 1 --wall-timeout 1 --stats");
        runner::expect_has(io, iso, "workers: a hang fails its test", &run, "FAIL late_2_sleeps: hung after 1.");
        runner::expect_has(io, iso, "workers: ... and the tests around it pass", &run, "2 passed, 1 failed");
        scratch::expect_count(runner::label(io, iso, "workers: ... it replaced the worker"), by_mode(mode, 2, 3),
                              runner::forks_of(&run));
    }
}

export void test_runner_workers_a_sanitizer_report_fails_its_test_and_a_printed_one_does_not(io::Io *io) {
    scratch::Project p = workers_project(io);
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = runner::tests(&p, iso, "--test report_ --jobs 1 --stats");
        runner::expect_has(io, iso, "workers: a sanitizer report fails its test", &run,
                           "FAIL report_2_overflows: killed by SIGABRT");
        runner::expect_has(io, iso, "workers: ... with the report", &run, "AddressSanitizer: heap-buffer-overflow");
        runner::expect_has(io, iso, "workers: ... and a test that only prints a report passes", &run,
                           "3 passed, 1 failed");
        scratch::expect_count(
            runner::label(io, iso, "workers: ... the crash and the printed report each replaced the worker"),
            by_mode(mode, 3, 4), runner::forks_of(&run));
    }
}

export void test_runner_workers_expected_aborts_end_their_worker_so_it_is_one_fork_a_test(io::Io *io) {
    scratch::Project p = workers_project(io);
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = runner::tests(&p, iso, "--test aborts_ --jobs 1 --stats --verbose");
        runner::expect_has(io, iso, "workers: an expected abort passes", &run, "PASS aborts_1_assert");
        runner::expect_has(io, iso, "workers: ... and another", &run, "PASS aborts_2_quiet");
        runner::expect_lacks(io, iso, "workers: ... hiding the test's output", &run, "hidden-by-the-check");
        runner::expect_has(io, iso, "workers: ... a sanitizer report fails the test", &run, "FAIL aborts_3_reads");
        runner::expect_has(io, iso, "workers: ... saying so", &run,
                           "expected an abort; it was stopped by a sanitizer report");
        runner::expect_has(io, iso, "workers: ... with the report", &run, "AddressSanitizer: heap-buffer-overflow");
        runner::expect_has(io, iso, "workers: ... and shows what the test printed", &run, "before the read");
        runner::expect_has(io, iso, "workers: ... a later check passes", &run, "PASS aborts_4_after");
        scratch::expect_count(
            runner::label(io, iso, "workers: a test that expected an abort ends its worker, so one fork a test"), 4,
            runner::forks_of(&run));
        scratch::Run jobs = runner::tests(&p, iso, "--test aborts_ --jobs 4");
        runner::expect_has(io, iso, "workers: ... with several jobs, the sanitizer report still fails its test", &jobs,
                           "FAIL aborts_3_reads");
        runner::expect_has(io, iso, "workers: ... and the other three pass", &jobs, "3 passed, 1 failed");
    }
}

export void test_runner_workers_a_failed_test_ends_its_worker(io::Io *io) {
    scratch::Project p = workers_project(io);
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = runner::tests(&p, iso, "--test unwind_ --jobs 1 --stats");
        runner::expect_has(io, iso, "workers: failed checks fail their tests", &run, "1 passed, 2 failed");
        scratch::expect_count(
            runner::label(io, iso, "workers: ... and a failed test ends its worker, so each test here has its own"), 3,
            runner::forks_of(&run));
    }
}

// The first seed of 1 to 20 for which the run of the test fails; 0 when none does.
static usize failing_seed(const scratch::Project *p, const char *iso, const char *test_name) {
    for (usize number = 1; number <= 20; number++) {
        scratch::Run run = runner::tests(
            p, iso, format::push(&p->io->arena, "--test ", test_name, " --seed ", number, " --shrink 0").data);
        if (scratch::contains(run.out, "FAIL shrink_leaky")) return number;
    }
    return 0;
}

export void test_runner_workers_a_shrunk_case_that_fails_only_on_leaked_state_is_not_reported_as_shrunk(io::Io *io) {
    scratch::Project p = workers_project(io);
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        usize seed = failing_seed(&p, iso, "shrink_leaky");
        scratch::expect_count(runner::label(io, iso, "leaky: some seed fails the first run"), 1, (usize)(seed != 0));
        if (seed == 0) seed = 1;
        scratch::Run run = runner::tests(&p, iso, format::push(&io->arena, "--test shrink_leaky --seed ", seed).data);
        if (mode == 1) {
            runner::expect_has(io, iso, "leaky: with a process per attempt nothing leaks, and it shrinks to 500", &run,
                               "shrunk in");
            runner::expect_lacks(io, iso, "leaky: ... with no leak line", &run, "did not reproduce");
        } else {
            runner::expect_has(io, iso,
                               "leaky: a shrunk case that fails only on leaked state is not reported as shrunk", &run,
                               "the shrunk case did not reproduce in a fresh process, so state leaked between the "
                               "shrinking attempts");
            runner::expect_lacks(io, iso, "leaky: ... the failure is shown as it was", &run, "shrunk in");
            runner::expect_has(io, iso, "leaky: ... and still names the seed", &run,
                               format::push(&io->arena, "rerun: smith test --test shrink_leaky --seed ", seed).data);
        }
    }
}

export void test_runner_workers_a_test_after_an_expected_abort_or_a_failure_sees_clean_globals(io::Io *io) {
    scratch::Project p = workers_project(io);
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = runner::tests(&p, iso, "--test dirty_ --jobs 1 --stats");
        runner::expect_has(io, iso,
                           "dirty: a test after an expected abort sees clean globals, and after a failed test too",
                           &run, "3 passed, 1 failed");
        runner::expect_has(io, iso, "dirty: ... only the failing test failed", &run, "FAIL dirty_3_fails");
        scratch::expect_count(
            runner::label(io, iso, "dirty: ... the expected abort and the failure each ended a worker"),
            by_mode(mode, 3, 4), runner::forks_of(&run));
    }
}

// The text from the line that starts `from` up to the line that starts `to` (to the end when `to` is empty).
static const char *between(const scratch::Project *p, const char *text, const char *from, const char *to) {
    scratch::write(p, "between.txt", text);
    const char *command = format::push(&p->io->arena, "sed -n '/^", from, "/,", to[0] != '\0' ? "/^" : "$", to,
                                       to[0] != '\0' ? "/" : "", "p' between.txt")
                              .data;
    return scratch::capture(p, command);
}

export void test_runner_workers_a_test_sees_only_its_own_output(io::Io *io) {
    scratch::Project p = workers_project(io);
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = runner::tests(&p, iso, "--test out_ --jobs 1 --stats");
        const char *first = between(&p, run.out, "FAIL out_1_fails", "FAIL out_3_fails");
        const char *third = between(&p, run.out, "FAIL out_3_fails", "FAIL out_5_fails");
        const char *fifth = between(&p, run.out, "FAIL out_5_fails", "");
        scratch::expect_contains(runner::label(io, iso, "output: a failing test shows its own output"), first,
                                 "from-1");
        scratch::expect_contains(runner::label(io, iso, "output: ... and its stderr"), first, "err-from-1");
        scratch::expect_lacks(
            runner::label(io, iso, "output: ... a passing test's output stays out of the next failure"), third,
            "from-2");
        scratch::expect_lacks(runner::label(io, iso, "output: ... and the next one's"), third, "err-from-2");
        scratch::expect_contains(runner::label(io, iso, "output: ... the next failure shows its own"), third, "from-3");
        scratch::expect_lacks(
            runner::label(io, iso, "output: ... a test's output still in its own buffer does not reach the next test"),
            fifth, "from-4");
        scratch::expect_lacks(runner::label(io, iso, "output: ... nor does an earlier one"), fifth, "from-3");
        scratch::expect_lacks(runner::label(io, iso, "output: ... the last failure has no output at all"), fifth,
                              "    note");
    }
}

export void test_runner_workers_the_arena_and_the_note_start_empty_for_every_test(io::Io *io) {
    scratch::Project p = workers_project(io);
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = runner::tests(&p, iso, "--test fresh_ --jobs 1 --stats");
        runner::expect_has(io, iso, "fresh: the arena and the note start empty (the second test's failure is its own)",
                           &run, "FAIL fresh_2_sees");
        runner::expect_lacks(io, iso, "fresh: ... no note from the earlier test", &run, "note from 1");
        runner::expect_has(io, iso, "fresh: ... and arenas of 200 MiB are given back between tests", &run,
                           "3 passed, 1 failed");
    }
}

export void test_runner_workers_with_a_process_per_test_an_order_dependent_pair_fails_even_in_order(io::Io *io) {
    scratch::Project p = workers_project(io);
    scratch::Run run = runner::tests(&p, "--isolate", "--test order_ --jobs 1 --verbose");
    runner::expect_has(io, "--isolate", "shuffle: with a process per test an order-dependent pair fails even in order",
                       &run, "FAIL order_b");
}

export void test_runner_workers_shuffle_runs_the_tests_in_another_order_from_a_seed(io::Io *io) {
    scratch::Project p = workers_copy(io);
    scratch::Run table = runner::tests(&p, "", "--test order_ --jobs 1 --verbose");
    scratch::expect_contains("shuffle: in table order the order-dependent pair passes", table.out,
                             "2 passed, 0 failed");
    usize found = 0;
    for (usize number = 1; number <= 20 && found == 0; number++) {
        scratch::Run run = runner::tests(
            &p, "", format::push(&io->arena, "--test order_ --jobs 1 --shuffle ", number, " --verbose").data);
        if (scratch::contains(run.out, "FAIL order_b")) found = number;
    }
    scratch::expect_count("shuffle: some seed runs order_b before order_a, and the test fails", 1, (usize)(found != 0));
    if (found == 0) found = 1;
    // the trace's addresses differ per run
    const char *same = format::push(&io->arena, "build/tests --test order_ --jobs 1 --shuffle ", found,
                                    " --verbose 2>&1 | sed -e '/^slowest:/,/^$/d' -e 's/ in [0-9.]* s$//' | grep -v "
                                    "'smith-trace \\(image\\|frame\\)'")
                           .data;
    const char *first = scratch::capture(&p, same);
    const char *second = scratch::capture(&p, same);
    scratch::expect_text("shuffle: the same seed gives the same results (the trace's addresses differ per run)", first,
                         second);
    scratch::expect_contains("shuffle: ... reported in table order", first, "PASS order_a\nFAIL order_b");
    scratch::Run task =
        runner::smith_test(&p, "", format::push(&io->arena, "--test order_ --jobs 1 --shuffle ", found).data);
    scratch::expect_contains("shuffle: --shuffle reaches the runner", task.out, "FAIL order_b");
}

// Many jobs under a low descriptor limit: every job's worker holds two descriptors in the runner, which raises the
// limit.
export void test_runner_workers_ninety_jobs_under_a_limit_of_a_hundred_descriptors_all_run(io::Io *io) {
    scratch::Project p = runner::project(io, "runner_base", "runner_many");
    scratch::Run built = runner::build(&p, "-DSAN=0");
    scratch::expect_status("many: the runner builds", 0, &built);
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = scratch::sh(
            &p, format::push(&io->arena, "sh -c \"ulimit -S -n 100; build/tests ", iso, " --jobs 90\" 2>&1").data);
        runner::expect_has(io, iso, "many: 90 jobs under a limit of 100 descriptors all run", &run,
                           "90 passed, 0 failed");
    }
}

// Section 12. --in-process: every test in the runner's own process, no fork, so a debugger that does not follow forks
// (lldb on macOS) stops inside a test. smith dbg is in the full smith only. lldb's `run` expands the arguments through
// a shell it waits 10 s of wall time for ("shell expansion failed (timed out)" on a loaded machine, #344), so the
// debugger test launches with `process launch -X false`.
static scratch::Project inprocess_project(io::Io *io) {
    return runner::built_project(io, "runner_base", "runner_inproc", "");
}

export void test_runner_workers_in_process_reports_a_failure_and_prints_as_written(io::Io *io) {
    scratch::Project p = inprocess_project(io);
    scratch::Run run = scratch::sh(&p, "build/tests --in-process --test inproc_ 2>&1");
    scratch::expect_contains("in-process: a failed check is reported", run.out, "FAIL inproc_fail");
    scratch::expect_contains("in-process: ... with its values", run.out, "41");
    scratch::expect_contains("in-process: the other tests ran around it", run.out, "3 passed, 1 failed");
    scratch::expect_contains("in-process: output goes to the terminal as written", run.out, "in-process output");
}

export void test_runner_workers_in_process_an_expected_abort_passes_and_nothing_forks(io::Io *io) {
    scratch::Project p = inprocess_project(io);
    scratch::Run run = scratch::sh(&p, "build/tests --in-process --test inabort_ --verbose --stats 2>&1");
    scratch::expect_contains("in-process: an expected abort passes", run.out, "PASS inabort_abort");
    scratch::expect_contains("in-process: ... a trap too", run.out, "PASS inabort_trap");
    scratch::expect_contains("in-process: ... returning fails", run.out, "FAIL inabort_returns");
    scratch::expect_contains("in-process: ... saying so", run.out, "expected an abort; the test returned");
    scratch::expect_contains("in-process: ... a failed check after the call fails", run.out,
                             "expected an abort; a check failed, which is not an abort");
    scratch::expect_contains("in-process: ... and nothing forked", run.out, "forks: 0");
    scratch::Run one = scratch::sh(&p, "build/tests --in-process --test inproc_pass --stats 2>&1");
    scratch::expect_contains("in-process: no fork", one.out, "forks: 0");
    scratch::Run forked = scratch::sh(&p, "build/tests --test inproc_pass --stats 2>&1");
    scratch::expect_contains("in-process: without the flag the runner forks a worker", forked.out, "forks: 1");
}

export void test_runner_workers_in_process_smith_dbg_stops_at_a_breakpoint_inside_a_test(io::Io *io) {
    scratch::Project p = inprocess_project(io);
    if (scratch::sh(&p, "smith dbg --version").status != 0) return;
    usize line = runner::line_of(&p, "tests/test_inproc.smith", "test::check_equal(answer, 42);");
    const char *command =
        format::push(
            &io->arena,
            "smith dbg -b -o 'settings set plugin.process.gdb-remote.packet-timeout 600' -o \"b test_inproc.smith:",
            line,
            "\" -o 'process launch -X false' -o 'frame variable answer' -o kill -- build/tests --test "
            "inproc_local --in-process 2>&1")
            .data;
    scratch::Run run = scratch::sh(&p, command);
    scratch::expect_contains("in-process: smith dbg stops at a breakpoint inside a test", run.out,
                             "stop reason = breakpoint 1.1");
    scratch::expect_contains("in-process: ... and shows its local", run.out, "(i32) answer = 42");
}

// Section 12b. A failed check or contract shows the variables of its line, read from the stopped test by lldb
// (--explain <smith>: `smith test` passes it): `check(a == b)` prints a and b, a member chain, an array element, an
// enum and a pointer print too, a crash reports as before, and a machine that refuses to debug (or a smith with no
// debugger) gets the report and one note saying why.
static bool explain_available(const scratch::Project *p) {
    return scratch::sh(p, "smith --smith-explain --available").status == 0;
}

static scratch::Project explain_project(io::Io *io) {
    return runner::built_project(io, "runner_base", "runner_explain", "");
}

static scratch::Project explain_copy(io::Io *io) {
    return runner::built_copy(io, "runner_base", "runner_explain", "");
}

// The report smith test prints, with the values read from the stopped test.
static const char *explained(const scratch::Project *p, const char *iso, const char *arguments) {
    const char *command =
        format::push(&p->io->arena, "build/tests ", iso, " --trace --explain \"$SMITH_SELF\" ", arguments,
                     " 2>&1 | smith symbolize 2>&1 | ", runner::plain_pipe(), " | tr -s ' '")
            .data;
    return scratch::capture(p, command);
}

// Whether the machine let the values be read (it may refuse to debug).
static bool values_shown(const char *text) {
    return !scratch::contains(text, "values not shown");
}

export void test_runner_workers_explain_prints_the_variables_of_a_failed_checks_line(io::Io *io) {
    scratch::Project p = explain_project(io);
    if (!explain_available(&p)) return;
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        const char *member = explained(&p, iso, "--test ex_member");
        if (!values_shown(member)) {
            scratch::expect_contains(
                runner::label(io, iso, "explain: a machine that may not debug gets a note and the report"), member,
                "check failed at tests/test_explain.smith:");
            continue;
        }
        scratch::expect_contains(runner::label(io, iso, "explain: check(a == b) prints the member chain"), member,
                                 "moves.count = 7");
        scratch::expect_contains(runner::label(io, iso, "explain: ... and the other variable"), member, "expected = 8");
        scratch::expect_lacks(runner::label(io, iso, "explain: ... and not the sentence the values replace"), member,
                              "the condition is false");
        const char *board = explained(&p, iso, "--test ex_board");
        scratch::expect_contains(runner::label(io, iso, "explain: an array element, an index read from a variable"),
                                 board, "b->cells[row][col] = 6");
        scratch::expect_contains(runner::label(io, iso, "explain: an enum prints its name"), board, "b->color = ");
        scratch::expect_contains(runner::label(io, iso, "explain: ... Green"), board, "Green");
        scratch::expect_contains(runner::label(io, iso, "explain: a pointer prints its address and what it points to"),
                                 board, "b->moves = 0x");
        scratch::expect_contains(runner::label(io, iso, "explain: ... and the pointee"), board,
                                 "-> (count = 7, capacity = 9)");
    }
}

export void test_runner_workers_explain_reads_a_contract_c_code_and_keeps_check_equal_as_it_was(io::Io *io) {
    scratch::Project p = explain_project(io);
    if (!explain_available(&p)) return;
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        if (!values_shown(explained(&p, iso, "--test ex_member"))) continue;
        const char *contract = explained(&p, iso, "--test ex_contract");
        scratch::expect_contains(runner::label(io, iso, "explain: a failed contract prints the variable of its line"),
                                 contract, "count = 6");
        scratch::expect_lacks(runner::label(io, iso, "explain: ... without repeating the heading"), contract,
                              "requires failed\n");
        const char *c_code = explained(&p, iso, "--test exc_member");
        scratch::expect_contains(runner::label(io, iso, "explain: the same in C"), c_code, "moves.count = 7");
        scratch::expect_contains(runner::label(io, iso, "explain: ... both variables"), c_code, "expected = 8");
        const char *equal = explained(&p, iso, "--test ex_equal");
        scratch::expect_contains(runner::label(io, iso, "explain: check_equal keeps its own two values"), equal,
                                 "count = 3, 4 (u64)");
        scratch::expect_lacks(runner::label(io, iso, "explain: ... and reads nothing"), equal, "@");
        const char *filter =
            format::push(&io->arena, " 2>&1 | ", runner::plain_pipe(), " | grep -v 'smith-trace'").data;
        const char *plain_crash =
            scratch::capture(&p, format::push(&io->arena, "build/tests ", iso, " --test ex_crash", filter).data);
        const char *read_crash = scratch::capture(
            &p,
            format::push(&io->arena, "build/tests ", iso, " --explain \"$SMITH_SELF\" --test ex_crash", filter).data);
        scratch::expect_text(runner::label(io, iso, "explain: a crash reports as it did"), plain_crash, read_crash);
    }
}

export void test_runner_workers_explain_reads_at_most_explain_max_and_no_explain_turns_it_off(io::Io *io) {
    scratch::Project p = explain_project(io);
    if (!explain_available(&p)) return;
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        if (!values_shown(explained(&p, iso, "--test ex_member"))) continue;
        const char *limited = explained(&p, iso, "--test ex_ --jobs 1 --explain-max 1");
        scratch::expect_contains(runner::label(io, iso, "explain: a run reads at most --explain-max failures"), limited,
                                 "more failures were not read in the debugger (--explain-max 1)");
        const char *off = scratch::capture(
            &p,
            format::push(&io->arena, "build/tests ", iso,
                         " --trace --test ex_member --explain \"$SMITH_SELF\" --no-explain 2>&1 | smith symbolize 2>&1")
                .data);
        scratch::expect_contains(runner::label(io, iso, "explain: --no-explain gives the report as before"), off,
                                 "the condition is false");
        scratch::expect_lacks(runner::label(io, iso, "explain: ... without the values"), off, "moves.count = 7");
    }
}

export void test_runner_workers_smith_test_reads_the_values_without_being_asked(io::Io *io) {
    scratch::Project p = explain_copy(io);
    if (!explain_available(&p)) return;
    if (!values_shown(explained(&p, "", "--test ex_member"))) return;
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = runner::smith_test(&p, iso, "--test ex_member");
        runner::expect_has(io, iso, "explain: smith test reads the values without being asked", &run,
                           "expected    = 8");
    }
}

// --stats ends with one line for each test, `cpu<TAB>seconds<TAB>name`: the CPU time it took (the train publishes
// them).
export void test_runner_workers_stats_lists_the_cpu_time_of_each_test(io::Io *io) {
    scratch::Project p = workers_project(io);
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = runner::tests(&p, iso, "--test report_ --jobs 1 --stats");
        runner::expect_has(io, iso, "stats: a line for a test", &run, "cpu\t0.");
        runner::expect_has(io, iso, "stats: ... with its name", &run, "\treport_1_before\n");
    }
}

export void test_runner_workers_costs_start_the_unknown_then_the_heaviest_first(io::Io *io) {
    scratch::Project p = workers_project(io);
    scratch::Run made =
        scratch::sh(&p, "printf 'cpu\\t0.500\\tcrash_1_before\\ncpu\\t0.100\\tcrash_3_after\\n' > costs.tsv");
    scratch::expect_status("costs: the file", 0, &made);
    scratch::Run run = runner::tests(&p, "", "--test crash_ --list --costs costs.tsv");
    runner::expect_has(io, "", "costs: unknown first, then the heaviest (the longest test last is a tail, #754)", &run,
                       "crash_2_dies\ncrash_4_after\ncrash_1_before\ncrash_3_after\n");
    scratch::Run cheapest = runner::tests(&p, "", "--test crash_ --list --costs costs.tsv --cheapest");
    runner::expect_has(io, "", "costs: --cheapest starts the cheapest first", &cheapest,
                       "crash_2_dies\ncrash_4_after\ncrash_3_after\ncrash_1_before\n");
}

export void test_runner_workers_fail_fast_starts_no_test_after_the_first_failure(io::Io *io) {
    scratch::Project p = workers_project(io);
    scratch::Run run = runner::tests(&p, "", "--test crash_ --jobs 1 --fail-fast");
    runner::expect_has(io, "", "fail-fast: the failure is reported", &run, "FAIL crash_2_dies: killed by SIGABRT");
    runner::expect_has(io, "", "fail-fast: the rest is not started", &run, "1 passed, 1 failed");
    runner::expect_has(io, "", "fail-fast: and counted", &run, "2 not run (--fail-fast)");
}

// The cores a test held go back to the pool when it ends (#754). The runner forks its workers after it took the cores
// of the jobs running, and a worker that kept a copy of a core's descriptor held it for as long as it lived, so after
// its first jobs ended the pool looked empty and the runner ran one test at a time. Three tests end at once; the next
// two wait for each other's mark, so they pass only if both start, which needs a core for the second.
export void test_runner_workers_the_cores_of_ended_tests_go_back_to_the_pool(io::Io *io) {
    scratch::Project p = runner::built_project(io, "runner_base", "runner_tokens", "-DSAN=0");
    scratch::Run run = scratch::sh(
        &p, "mkdir -p marks pool; env -u SMITH_SLOTS SMITH_SLOT_HELD=$$ SMITH_SLOTS_DIR=$PWD/pool SMITH_CORES=3 "
            "build/tests --jobs 3 --wall-timeout 100 2>&1");
    runner::expect_has(io, "", "pool: all five tests pass", &run, "5 passed, 0 failed");
}

// A test that waits without using CPU time fails after --idle-timeout seconds and says what it waited for; one that
// computes does not (#754). Wall time on purpose: a test of the idle limit, 2 s here (180 by default).
export void test_runner_workers_a_test_that_waits_without_cpu_time_fails_and_names_what_it_waited_for(io::Io *io) {
    scratch::Project p = runner::built_project(io, "runner_base", "runner_idle", "-DSAN=0");
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = runner::tests(&p, iso, "--idle-timeout 2 --jobs 3");
        runner::expect_has(io, iso, "idle: a test waiting for a child fails", &run,
                           "FAIL idle_1_waits_for_a_child: used no CPU time for 2 s");
        runner::expect_has(io, iso, "idle: ... naming the process it waited for", &run, "waiting for: sleep 31");
        runner::expect_has(io, iso, "idle: a test that sleeps itself fails", &run,
                           "FAIL idle_2_sleeps_itself: used no CPU time for 2 s");
        runner::expect_has(io, iso, "idle: ... saying there was no process of its own", &run,
                           "waiting for: the test itself");
        runner::expect_has(io, iso, "idle: a test that computes passes", &run, "1 passed, 2 failed");
    }
}

// A signal to a test's process group, and the runner's own end of an idle test, reach only the test's own processes:
// the runner and the shell that started it (which share a group here, as the runner and `smith build` do) get none, and
// the runner reports the failures and ends as it should. Before, the runner shared its group with its workers, and a
// group signal from a test ended it and `smith build` with "interrupted by user" and status 129 (#754). Wall time on
// purpose: the idle limit, 2 s.
export void test_runner_workers_a_signal_to_a_tests_group_never_reaches_the_runner_or_its_parent(io::Io *io) {
    scratch::Project p = runner::built_project(io, "runner_base", "runner_group", "-DSAN=0");
    for (usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = scratch::sh(
            &p, format::push(&io->arena,
                             "rm -f parent.sig runner.status; sh -c 'trap \"echo HUP >>parent.sig\" HUP; "
                             "trap \"echo INT >>parent.sig\" INT; trap \"echo TERM >>parent.sig\" TERM; "
                             "build/tests ",
                             iso,
                             " --idle-timeout 2 --jobs 3 2>&1; echo $? >runner.status'; "
                             "echo \"runner status $(cat runner.status)\"; echo \"parent signals: $(cat parent.sig "
                             "2>/dev/null)\"")
                    .data);
        runner::expect_has(io, iso, "group: the test that hung up its group is reported", &run,
                           "FAIL group_1_hangs_up_its_group: killed by");
        runner::expect_has(io, iso, "group: the idle test is ended", &run,
                           "FAIL group_2_waits_for_a_child: used no CPU time for 2 s");
        runner::expect_has(io, iso, "group: ... and the third test runs", &run, "1 passed, 2 failed");
        runner::expect_has(io, iso, "group: the runner ended by itself, reporting failures", &run, "runner status 1");
        runner::expect_has(io, iso, "group: its parent was sent no signal", &run, "parent signals: \n");
    }
}

// An io test sets TMPDIR (and three more variables) to its scratch folder, which is removed when it passed; the next
// test in the same worker must see the environment the runner had (#841).
export void test_runner_workers_an_io_test_leaves_the_environment_as_it_found_it(io::Io *io) {
    scratch::Project p = runner::built_project(io, "runner_base", "runner_env", "");
    scratch::Run run = scratch::sh(
        &p, "mkdir -p tmp && env -u SMITH_TEST_SCRATCH -u SMITH_SLOTS_DIR -u SMITH_CORES TMPDIR=\"$PWD/tmp\" "
            "EXPECT_TMPDIR=\"$PWD/tmp\" build/tests --test test_env_ --jobs 1 --stats 2>&1");
    runner::expect_has(io, "", "env: both tests pass", &run, "2 passed, 0 failed");
    scratch::expect_count("env: they ran in one worker (one fork)", 1, runner::forks_of(&run));
}
