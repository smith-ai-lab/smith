    scratch::Project p = untar_project(io);
    setup(&p, "make_a_tar; xz -c \"$arc/a.tar\" >\"$arc/a.tar.xz\"");
    same(&p, "tar.xz (CRC-64)", "a", "arc/a.tar.xz", "src/pkg-1.0");
}

