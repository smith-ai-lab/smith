// smith's own archive extraction (runtime/gzip.c on lib/smith/inflate.smith, runtime/xz.c, runtime/untar.c), the part
// of `smith_package` that used to run tar: the formats it reads, from tests/untar.sh sections 1 and 2 (issue #292).
// Archives are made with the system's tar and gzip and with tests/xz.py (the shell functions of
// tests/build_fixtures/untar/prelude), and read back by `smith fetch` into a cache of the case's own, so the real
// ~/.cache/smith is never touched. Each must extract to the same tree, modes and bytes as its source folder.
module untar_formats_test;

import smith::arena;
import smith::format;
import smith::io;
import smith::test;
import scratch;
import <string.h>;

static scratch::Project untar_project(io::Io *io) {
    return scratch::project(io, "p", "untar");
}

static scratch::Run run(const scratch::Project *p, const char *body) {
    return scratch::sh(p, format::push(&p->io->arena, ". ./prelude; ", body).data);
}

static const char *text(const scratch::Project *p, const char *body) {
    return scratch::capture(p, format::push(&p->io->arena, ". ./prelude; ", body).data);
}

// A setup command that must succeed.
static void setup(const scratch::Project *p, const char *body) {
    scratch::Run made = run(p, body);
    scratch::expect_status("the setup of the case", 0, &made);
}

static const char *join(const scratch::Project *p, const char *a, const char *b) {
    return format::push(&p->io->arena, a, b).data;
}

// Fetches an archive (a path in the project) into a cache of its own; the package folder is in *package, or
// "/nonexistent" when it failed.
static scratch::Run fetch(const scratch::Project *p, const char *cache, const char *archive, const char **package) {
    scratch::Run fetched = run(p, format::push(&p->io->arena, "XDG_CACHE_HOME=\"$PWD/cache-", cache,
                                               "\" smith fetch \"file://$PWD/", archive, "\"")
                                      .data);
    *package = "/nonexistent";
    const char *start = fetched.status == 0 ? c::strstr(fetched.out, "\"sha256:") : nullptr;
    if (start != nullptr) {
        char *hash = arena::push_slice(&p->io->arena, char, 65).data;
        __builtin_memcpy(hash, start + 8, 64);
        hash[64] = '\0';
        *package = format::push(&p->io->arena, p->dir, "/cache-", cache, "/smith/packages/", hash).data;
    }
    return fetched;
}

// An archive that must extract to the same tree as the source folder.
static void same(const scratch::Project *p, const char *name, const char *cache, const char *archive,
                 const char *folder) {
    const char *package = nullptr;
    scratch::Run fetched = fetch(p, cache, archive, &package);
    scratch::expect_status(join(p, name, ": extracts"), 0, &fetched);
    scratch::expect_text(join(p, name, ": the same tree, modes and bytes"),
                         text(p, format::push(&p->io->arena, "listing \"", folder, "\"").data),
                         text(p, format::push(&p->io->arena, "listing \"", package, "\" 2>/dev/null").data));
}

// 1. The source tree and each format of its archive.
export void test_untar_tar_ustar(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_a_tar");
    same(&p, "tar (ustar)", "a", "arc/a.tar", "src/pkg-1.0");
}

export void test_untar_tar_pax(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_src; (cd src && tar --format pax -cf \"$arc/pax.tar\" pkg-1.0)");
    same(&p, "tar (pax)", "a", "arc/pax.tar", "src/pkg-1.0");
}

export void test_untar_tar_gnu(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_src; (cd src && tar --format gnutar -cf \"$arc/gnu.tar\" pkg-1.0)");
    same(&p, "tar (gnu)", "a", "arc/gnu.tar", "src/pkg-1.0");
}

export void test_untar_tar_gz(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_a_tar; gzip -c \"$arc/a.tar\" >\"$arc/a.tar.gz\"");
    same(&p, "tar.gz", "a", "arc/a.tar.gz", "src/pkg-1.0");
}

export void test_untar_tar_gz_gzip_1(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_a_tar; gzip -1 -c \"$arc/a.tar\" >\"$arc/fast.tar.gz\"");
    same(&p, "tar.gz (gzip -1)", "a", "arc/fast.tar.gz", "src/pkg-1.0");
}

export void test_untar_tar_gz_gzip_9(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_a_tar; gzip -9 -c \"$arc/a.tar\" >\"$arc/best.tar.gz\"");
    same(&p, "tar.gz (gzip -9)", "a", "arc/best.tar.gz", "src/pkg-1.0");
}

export void test_untar_tgz_with_the_file_name_in_its_header(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_a_tar; cp \"$arc/a.tar\" \"$arc/named.tar\" && gzip -c \"$arc/named.tar\" >\"$arc/named.tgz\"");
    same(&p, "tgz with the file name in its header", "a", "arc/named.tgz", "src/pkg-1.0");
}

