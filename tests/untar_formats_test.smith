export void test_untar_tar_xz_many_blocks(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_a_tar; xz -T2 --block-size=8192 -c \"$arc/a.tar\" >\"$arc/blocks.tar.xz\"");
    same(&p, "tar.xz (many blocks)", "a", "arc/blocks.tar.xz", "src/pkg-1.0");
}

// Members and streams one after the other: cat a.gz b.gz, and xz streams with the padding xz allows between them.
constexpr char split_a_tar[] =
    "make_a_tar; head -c 40960 \"$arc/a.tar\" >\"$arc/first\"; tail -c +40961 \"$arc/a.tar\" >\"$arc/second\"; ";

export void test_untar_tar_gz_of_two_members(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, split_a_tar,
                   "gzip -c \"$arc/first\" >\"$arc/two.tar.gz\" && "
                   "gzip -c \"$arc/second\" >>\"$arc/two.tar.gz\""));
    same(&p, "tar.gz of two members", "a", "arc/two.tar.gz", "src/pkg-1.0");
}

export void test_untar_tar_xz_of_two_streams_with_padding(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, split_a_tar,
                   "xz -c \"$arc/first\" >\"$arc/two.tar.xz\" && printf '\\0\\0\\0\\0' >>\"$arc/two.tar.xz\" "
                   "&& xz -c \"$arc/second\" >>\"$arc/two.tar.xz\""));
    same(&p, "tar.xz of two streams with padding", "a", "arc/two.tar.xz", "src/pkg-1.0");
}

export void test_untar_tar_gz_with_zero_padding_after_it(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_a_tar; gzip -c \"$arc/a.tar\" >\"$arc/a.tar.gz\"; cp \"$arc/a.tar.gz\" \"$arc/padded.tar.gz\" && "
              "printf '\\0\\0\\0\\0\\0\\0\\0' >>\"$arc/padded.tar.gz\"");
    same(&p, "tar.gz with zero padding after it", "a", "arc/padded.tar.gz", "src/pkg-1.0");
}

export void test_untar_tar_xz_with_zero_padding_after_it(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_a_tar; xz -c \"$arc/a.tar\" >\"$arc/a.tar.xz\"; cp \"$arc/a.tar.xz\" \"$arc/padded.tar.xz\" && "
              "printf '\\0\\0\\0\\0\\0\\0\\0\\0' >>\"$arc/padded.tar.xz\"");
    same(&p, "tar.xz with zero padding after it", "a", "arc/padded.tar.xz", "src/pkg-1.0");
}

// Data that does not compress is stored: gzip's stored blocks, and LZMA2's uncompressed chunks.
export void test_untar_tar_gz_of_random_data_stored_blocks(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_rand; gzip -c \"$arc/rand.tar\" >\"$arc/rand.tar.gz\"");
    same(&p, "tar.gz of random data (stored blocks)", "a", "arc/rand.tar.gz", "rand/pkg-1.0");
}

export void test_untar_tar_xz_of_random_data_uncompressed_chunks(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_rand; xz -c \"$arc/rand.tar\" >\"$arc/rand.tar.xz\"");
    same(&p, "tar.xz of random data (uncompressed chunks)", "a", "arc/rand.tar.xz", "rand/pkg-1.0");
}

// File times are kept, to the second.
export void test_untar_a_file_keeps_its_modification_time(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "make_a_tar; gzip -c \"$arc/a.tar\" >\"$arc/a.tar.gz\"");
    const char *package = nullptr;
    scratch::Run fetched = fetch(&p, "a", "arc/a.tar.gz", &package);
    scratch::expect_status("times: the archive extracts", 0, &fetched);
    scratch::expect_text("times: a file keeps its modification time", text(&p, "stat -f %m src/pkg-1.0/hello.txt"),
                         text(&p, join(&p, "stat -f %m ", join(&p, package, "/hello.txt"))));
}

// Several top-level entries: the package is the extraction folder, as it was with tar.
export void test_untar_several_top_level_folders_are_kept_under_their_names(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "mkdir -p multi/one multi/two && echo 1 >multi/one/a && echo 2 >multi/two/b && "
              "(cd multi && tar -czf \"$arc/multi.tar.gz\" one two)");
    const char *package = nullptr;
    scratch::Run fetched = fetch(&p, "a", "arc/multi.tar.gz", &package);
    scratch::expect_status("several top-level folders: the archive extracts", 0, &fetched);
    scratch::expect_text("several top-level folders: the first is kept under its name", "1",
                         text(&p, join(&p, "cat 2>/dev/null ", join(&p, package, "/one/a"))));
    scratch::expect_text("several top-level folders: so is the second", "2",
                         text(&p, join(&p, "cat 2>/dev/null ", join(&p, package, "/two/b"))));
}

// 2. Long names: a ustar name split over its prefix and name fields, a pax path, a GNU long name, and non-ASCII names.
constexpr char make_long[] =
    "d=pkg-1.0/$(printf 'a%.0s' $(seq 80))/$(printf 'b%.0s' $(seq 80))/$(printf 'c%.0s' $(seq 80)); "
    "mkdir -p \"long/$d\" long/pkg-1.0/ü; echo deep >\"long/$d/file.txt\"; echo accent >long/pkg-1.0/ü/é.txt; ";

export void test_untar_long_names_pax(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_long, "(cd long && tar --format pax -cf \"$arc/long-pax.tar\" pkg-1.0)"));
    same(&p, "long names (pax)", "a", "arc/long-pax.tar", "long/pkg-1.0");
}

export void test_untar_long_names_gnu(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_long, "(cd long && tar --format gnutar -cf \"$arc/long-gnu.tar\" pkg-1.0)"));
    same(&p, "long names (gnu)", "a", "arc/long-gnu.tar", "long/pkg-1.0");
}

export void test_untar_long_names_pax_gzip(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_long,
                   "(cd long && tar --format pax -cf \"$arc/long-pax.tar\" pkg-1.0) && "
                   "gzip -c \"$arc/long-pax.tar\" >\"$arc/long-pax.tar.gz\""));
    same(&p, "long names (pax, gzip)", "a", "arc/long-pax.tar.gz", "long/pkg-1.0");
}

export void test_untar_long_names_gnu_xz(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, join(&p, make_long,
                   "(cd long && tar --format gnutar -cf \"$arc/long-gnu.tar\" pkg-1.0) && "
                   "xz -c \"$arc/long-gnu.tar\" >\"$arc/long-gnu.tar.xz\""));
    same(&p, "long names (gnu, xz)", "a", "arc/long-gnu.tar.xz", "long/pkg-1.0");
}

export void test_untar_long_names_ustar_prefix_field(io::Io *io) {
    scratch::Project p = untar_project(io);
    setup(&p, "p90=$(printf 'p%.0s' $(seq 90)); q90=$(printf 'q%.0s' $(seq 90)); "
              "mkdir -p \"prefix/top/$p90/$q90\" && echo prefixed >\"prefix/top/$p90/$q90/file\" && "
              "(cd prefix && tar --format ustar -cf \"$arc/prefix.tar\" top)");
    const char *package = nullptr;
    scratch::Run fetched = fetch(&p, "a", "arc/prefix.tar", &package);
    scratch::expect_status("long names (ustar prefix field): the archive extracts", 0, &fetched);
    scratch::expect_text(
        "long names (ustar prefix field)", "prefixed",
        text(&p, join(&p, "p90=$(printf 'p%.0s' $(seq 90)); q90=$(printf 'q%.0s' $(seq 90)); cat 2>/dev/null ",
                      join(&p, package, "/$p90/$q90/file"))));
}
