// Tests of the fixer where C headers are met through a library (#2627, area B2): a file that imports a library which
// imports a header reads that library's C types, so `&b.base` handed to a `*mut` parameter makes `b` `mut`. The
// library is `lib.boxes`, read from text.
module front_fix_c_headers_test;

import front::ast;
import front::fix;
import front::parser;
import front::types;
import front::types_decl;
import std::arena;
import std::mem;
import std::test;
import <string.h>;

static Str boxes_source() {
    return "import c \"tests/fixtures/c_headers/slot.h\"\n\npub struct Box:\n    pub base: slot.FixtureSlot\n    pub "
           "n: i32\n\n"
           "pub fn fill(p: *mut slot.FixtureSlot):\n    p.* = p.*\n\npub fn make() -> Box:\n    Box(n = 0)\n";
}

static Bool same(Str a, Str b) {
    if (countof(a) != countof(b)) return false;
    for (Usize i = 0; i < countof(a); i++) {
        if (a[i] != b[i]) return false;
    }
    return true;
}

static const ast::Module *load(const char *name) {
    Str path = name[0:c::strlen(name)];
    if (!same(path, "lib.boxes")) return nullptr;
    parser::Parsed p = fix::parse_for_fix("lib/boxes.smith", boxes_source());
    test::check_equal(countof(p.errors), (Usize)0);
    ast::Module *copy = mem::alloc(ast::Module);
    *copy = p.module;
    return copy;
}

static void expect(Str before, Str after) {
    arena::Arena memory = test::memory(1U << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::set_loader(load);
    defer fix::set_loader(nullptr);
    fix::Fixed first = fix::fix_text("t.smith", before);
    test::check_equal(first.text, after);
    fix::Fixed again = fix::fix_text("t.smith", first.text);
    test::check_equal(again.applied, (Usize)0);
}

export void test_front_fix_c_headers_address_of_a_c_field_of_a_library_struct_makes_the_local_mut() {
    expect(types::message_of(
               "import lib.boxes\n\npub fn run():\n    b: boxes.Box = boxes.make()\n    boxes.fill(&b.base)\n"),
           types::message_of(
               "import lib.boxes\n\npub fn run():\n    mut b: boxes.Box = boxes.make()\n    boxes.fill(&b.base)\n"));
}
