// `.smith` modules in `smith build`, from tests/build.sh section 15: smith_object writes each module's header first,
// then compiles with -I .smith/include (knowledge/smith-language.md). A project of three modules and a C file that
// includes a module's header (the corpus case module-three), its edits, an import cycle, a module whose name does not
// match its path, a plain `.smith` file, and the compiler's helpers. The shell keeps the checks of a smith with no
// token hook.
// The verbs it starts (smith build, cc) are dispatched in smith.c, so smith.c is declared. The lowering is
// runtime/lang*.c and the token hook is in shim/.
// smith-covers: smith.c runtime/build_runtime.c runtime/executor*.c runtime/slots.c runtime/lang*.c runtime/verbs.c
// smith-covers: runtime/cache.c runtime/sdk_cache.c runtime/platform_*.c runtime/quiet.c runtime/base.h
// smith-covers: runtime/package.c include/smith/ tests/build_fixtures/ lib/ shim/
module build_lang_test;

import std::arena;
import std::mem;
import std::format;
import std::test;
import scratch;

constexpr char expected_output[_] =
    "frames=15 name=last.replay length=11 version=3 mode=1 root=4.0 eof=-1\ncounter=8\nchecksum=1026";

// What a -v build ran: the objects it compiled, as a sorted list of the sources.
constexpr char compiled_command[_] =
    "smith build -v 2>&1 | sed -n 's/.* -c \\(src\\/[^ ]*\\) -o .*/\\1/p' | sort | tr '\\n' ' '";

// Copies the corpus case's sources and the program that builds them, with a smith-cc of its own next to them.
static scratch::Project lang_project(const char *source) {
    scratch::Project p = scratch::make("p", "lang_project");
    (void)scratch::sh(
        &p, "mkdir bin && { cp -c \"$SMITH_SELF\" bin/smith-cc 2>/dev/null || cp \"$SMITH_SELF\" bin/smith-cc; }");
    char cases[256];
    (void)format::to(cases, sizeof cases, "tests/smith-lang/cases/", source, "/src");
    scratch::copy_tree(&p, cases, "src");
    return p;
}

export void test_build_lang_a_project_of_three_modules_and_a_c_file() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = lang_project("module-three");
    defer scratch::clean(&p);
    scratch::Run built = scratch::build(&p, "");
    scratch::expect_status("modules: a project of three modules and a C file builds", 0, &built);
    scratch::expect_text("modules: and runs", expected_output, scratch::sh(&p, "./build/app 2>&1").out);
    scratch::expect_text("modules: each module has its header in .smith/include", "yes yes",
                         scratch::sh(&p, "[ -f .smith/include/lib/text.h ] && printf yes; printf ' '; [ -f "
                                         ".smith/include/game/replay.h ] && printf yes")
                             .out);
    scratch::expect_contains("modules: a header lists the modules it imports",
                             scratch::read(&p, ".smith/include/game/replay.h"), "// smith-imports: lib::text");
    scratch::expect_contains("modules: compile_commands.json lists a .smith source with -I .smith/include",
                             scratch::read(&p, "compile_commands.json"), "\"file\": \"src/game/replay.smith\"");
    scratch::expect_contains("modules: with its flags, and the language clangd is told",
                             scratch::sh(&p, "tr -d ' \\n' <compile_commands.json").out,
                             "\"arguments\":[\"bin/smith-cc\",\"-x\",\"c\",\"-I\",\".smith/include\",\"-std=gnu23\"");
    scratch::Run second = scratch::build(&p, "");
    scratch::expect_contains("modules: the second build does nothing", second.out, "no work to do");
    // A C object that reads a module's header waits for every header, as a .smith compile does: its header may include
    // another that its inputs do not name, and one written after the compile started would make the next build compile
    // it again (found under load: the second build recompiled src/checksum.c and relinked).
    scratch::expect_text("modules: a C object that reads a module's header waits for all the headers", "yes",
                         scratch::sh(&p, "grep -A3 '^build build/src/checksum.c.o' .smith/build.ninja | grep -q '|| "
                                         ".smith/imports.stamp' && echo yes")
                             .out);

    const char *header_time_command =
        "stat -c %Y .smith/include/lib/text.h 2>/dev/null || stat -f %m .smith/include/lib/text.h";
    const char *header_time = scratch::sh(&p, header_time_command).out;
    scratch::sleep(&p, 1000);
    (void)scratch::sh(&p, "printf '\\nUsize other_helper(void) {\\n    return 5;\\n}\\n' >>src/lib/text.smith");
    scratch::expect_text("modules: an edit to a module's body recompiles that module alone", "src/lib/text.smith ",
                         scratch::sh(&p, compiled_command).out);
    scratch::expect_text("modules: and leaves its header's time alone", header_time,
                         scratch::sh(&p, header_time_command).out);
    scratch::expect_text("modules: and the program still runs", expected_output,
                         scratch::sh(&p, "./build/app 2>&1").out);

    scratch::sleep(&p, 1000);
    (void)scratch::sh(&p, "printf '\\nexport Usize extra(void) {\\n    return 2;\\n}\\n' >>src/game/replay.smith");
    scratch::expect_text("modules: an edit to a module's exports recompiles it and its importers, and the C file that "
                         "includes the header",
                         "src/checksum.c src/game/replay.smith src/main.smith ", scratch::sh(&p, compiled_command).out);
    scratch::expect_text("modules: and the program still runs after an export is added", expected_output,
                         scratch::sh(&p, "./build/app 2>&1").out);
    scratch::Run settled = scratch::build(&p, "");
    scratch::expect_contains("modules: then it settles", settled.out, "no work to do");

    scratch::sleep(&p, 1000);
    (void)scratch::sh(&p, "printf '\\n// a comment\\n' >>src/main.smith");
    scratch::expect_text("modules: an edit to an importer's body recompiles it alone", "src/main.smith ",
                         scratch::sh(&p, compiled_command).out);
    scratch::expect_contains("modules: the header steps are in the manifest", scratch::read(&p, ".smith/build.ninja"),
                             "bin/smith-cc --smith-header src/lib/text.smith -o .smith/include/lib/text.h");
}

// An import cycle is found from the headers, before any compile starts, and named.
export void test_build_lang_an_import_cycle_fails_the_build() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = lang_project("module-three");
    defer scratch::clean(&p);
    (void)scratch::sh(&p, "rm -rf src");
    scratch::copy_tree(&p, "tests/smith-lang/cases/error-import-cycle/src/cycle", "src/cycle");
    scratch::Run run = scratch::build(&p, "");
    scratch::expect_failure("modules: an import cycle fails the build", &run);
    char both[8192];
    __builtin_snprintf(both, sizeof both, "%s%s", run.out, run.err);
    scratch::expect_contains("modules: and names the cycle", both, "import cycle: cycle::a -> cycle::b -> cycle::a");
    scratch::expect_text("modules: before any compile runs", "", scratch::sh(&p, "ls build/src/cycle 2>/dev/null").out);
}

// A module whose name does not match its path is found once, when build.c runs.
export void test_build_lang_a_module_that_does_not_match_its_path_fails_the_build() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = lang_project("module-three");
    defer scratch::clean(&p);
    scratch::write(&p, "src/wrong.smith", "module right::name;\n\nexport int f(void) { return 1; }\n");
    scratch::Run run = scratch::build(&p, "");
    scratch::expect_failure("modules: a module that does not match its path fails the build", &run);
    scratch::expect_contains("modules: and says where it must be", run.err,
                             "src/wrong.smith declares module right::name, so its path must end in right/name.smith");
}

// A plain .smith file (no module line) compiles with the same flags and needs no header.
export void test_build_lang_a_plain_smith_file_builds_with_no_header() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = lang_project("module-three");
    defer scratch::clean(&p);
    (void)scratch::sh(&p, "rm -rf src");
    scratch::copy_tree(&p, "tests/smith-lang/cases/sized-types/src/main.smith", "src/main.smith");
    scratch::Run run = scratch::build(&p, "");
    char status[32];
    __builtin_snprintf(status, sizeof status, "%d %s", run.status,
                       scratch::exists(&p, ".smith/include/main.h") ? "yes" : "no");
    scratch::expect_text("modules: a plain .smith file builds, with no header", "0 no", status);
}

// An importer that runs a function of an import at compile time reads that module's .body, and the bodies of what the
// module imports: under -MMD the depfile names them (the copies are a system buffer, and what is included from a
// system file is a system header), so an edit that changes a body rebuilds the importer (issue #621).
constexpr char body_calc[_] = "module calc;\n\nimport other;\n\n"
                              "export I32 fib(I32 n) {\n    return other::twice(n) + 1;\n}\n";
constexpr char body_other[_] = "module other;\n\nexport I32 twice(I32 n) {\n    return n * 2;\n}\n";
constexpr char body_main[_] = "module main;\n\nimport calc;\n\nstatic_assert(calc::fib(5) == 11);\n\n"
                              "I32 main(void) {\n    return calc::fib(3) - 7;\n}\n";

static scratch::Project body_project() {
    scratch::Project p = lang_project("module-three");
    // A link, as the installed smith-cc is: a copy named smith-cc would run its bodies' compiles as a C compiler.
    (void)scratch::sh(&p, "rm -rf src bin/smith-cc && mkdir src && ln -s \"$SMITH_SELF\" bin/smith-cc");
    scratch::write(&p, "src/calc.smith", body_calc);
    scratch::write(&p, "src/other.smith", body_other);
    scratch::write(&p, "src/main.smith", body_main);
    return p;
}

export void test_build_lang_a_depfile_names_the_body_files_a_compile_read() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = body_project();
    defer scratch::clean(&p);
    (void)scratch::sh(&p,
                      "mkdir -p .smith/include && smith cc --smith-header src/other.smith -o .smith/include/other.h "
                      "&& smith cc --smith-header src/calc.smith -I .smith/include -o .smith/include/calc.h");
    scratch::Run compiled =
        scratch::sh(&p, "smith cc -std=gnu23 -I .smith/include -MMD -MF main.d -c src/main.smith -o main.o");
    scratch::expect_status("body files: the importer compiles", 0, &compiled);
    const char *depfile = scratch::read(&p, "main.d");
    scratch::expect_contains("body files: -MMD names calc.body", depfile, ".smith/include/calc.body");
    scratch::expect_contains("body files: and the body of what calc imports", depfile, ".smith/include/other.body");
    scratch::expect_contains("body files: and the source of that module", depfile, "src/other.smith");
}

export void test_build_lang_an_edit_to_what_a_body_imports_rebuilds_the_importer() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = body_project();
    defer scratch::clean(&p);
    scratch::Run first = scratch::build(&p, "");
    scratch::expect_status("body files: the project builds", 0, &first);
    // The compile that made the body files started before them, so (ninja's rule) the next build runs it once more.
    scratch::Run again = scratch::build(&p, "");
    scratch::expect_status("body files: the build after it", 0, &again);
    scratch::Run settled = scratch::build(&p, "");
    scratch::expect_contains("body files: then it settles", settled.out, "no work to do");
    scratch::sleep(&p, 1000);
    scratch::write(&p, "src/other.smith", "module other;\n\nexport I32 twice(I32 n) {\n    return n * 3;\n}\n");
    scratch::Run broken = scratch::build(&p, "");
    scratch::expect_failure("body files: an edit to a module a body imports rebuilds the importer, whose assert fails",
                            &broken);
    char both[8192];
    __builtin_snprintf(both, sizeof both, "%s%s", broken.out, broken.err);
    scratch::expect_contains("body files: and it is the static_assert that says so", both, "static assertion failed");
}

// A module's header names the types of the modules it imports, so its header step waits for their headers and runs
// again when one changes (#781: it ran only for an edit to its own source, so a rebuild after main moved left a header
// naming `smith_random_Key`): game::replay holds a lib::text type, which only lib::text's edit renames in C.
export void test_build_lang_a_header_is_written_again_when_a_module_it_imports_renames_a_type() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = lang_project("module-three");
    defer scratch::clean(&p);
    (void)scratch::build(&p, "");
    scratch::expect_contains("headers: the importer's header names the type as lib::text first wrote it",
                             scratch::read(&p, ".smith/include/game/replay.h"), "lib_text_Text name;");
    scratch::sleep(&p, 1000);
    (void)scratch::sh(&p,
                      "sed -i.bak 's/^export typedef/[[std::c_name(\"Words\")]] export typedef/' src/lib/text.smith");
    (void)scratch::build(&p, "");
    scratch::expect_contains("headers: lib::text's header has the new name",
                             scratch::read(&p, ".smith/include/lib/text.h"), "} Words;");
    scratch::expect_contains("headers: and the importer's header is written again with it",
                             scratch::read(&p, ".smith/include/game/replay.h"), "Words name;");
}

// A module that imports one of smith's own (`import std::arena;`) has the header of std::arena, smith/arena.h, as an
// input of its header step: the name std::arena is the file .smith/include/smith/arena.h, not std/arena.h (#1254: the
// step had no such input, so io.h was sometimes written before arena.h and smith.c's compile died on
// `unknown type name 'smith_arena_Arena'`).
export void test_build_lang_a_header_step_waits_for_the_header_of_a_std_module_it_imports() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = lang_project("module-three");
    defer scratch::clean(&p);
    scratch::write(&p, "src/lib/pool.smith",
                   "module lib::pool;\n\nimport std::arena;\n\nexport arena::Arena *pool_of(arena::Arena *a) { "
                   "return a; }\n");
    (void)scratch::build(&p, "");
    scratch::expect_contains("headers: the importer's header names the std type",
                             scratch::read(&p, ".smith/include/lib/pool.h"), "smith_arena_Arena");
    scratch::expect_text("headers: and its step lists smith/arena.h as an input", "1",
                         scratch::sh(&p, "grep '^build .smith/include/lib/pool.h:' .smith/build.ninja | "
                                         "grep -c ' .smith/include/smith/arena.h'")
                             .out);
}

// A folder of headers (SMITH_HEADERS_FROM) stamped by this smith is copied, not generated: the marked copy of arena.h
// shows which. Unset, the project generates its own, as before.
constexpr char headers_marked[_] = "rm -rf marked && cp -R \"$SMITH_HEADERS_FROM\" marked && "
                                   "printf '// marker\\n' >>marked/arena.h && ";

export void test_build_lang_headers_from_a_folder_are_copied() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = lang_project("module-three");
    defer scratch::clean(&p);
    char command[512];
    __builtin_snprintf(command, sizeof command,
                       "%sSMITH_HEADERS_FROM=$PWD/marked smith build >/dev/null 2>&1; "
                       "grep -c marker .smith/include/smith/arena.h",
                       headers_marked);
    scratch::expect_text("headers: copied from the folder", "1", scratch::sh(&p, command).out);
}

export void test_build_lang_headers_are_generated_without_the_folder() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = lang_project("module-three");
    defer scratch::clean(&p);
    char command[512];
    __builtin_snprintf(command, sizeof command,
                       "%sunset SMITH_HEADERS_FROM; smith build >/dev/null 2>&1; "
                       "grep -c marker .smith/include/smith/arena.h",
                       headers_marked);
    scratch::expect_text("headers: generated without it", "0", scratch::sh(&p, command).out);
}

// The helpers are under the compiler; the top level is only verbs.
export void test_build_lang_the_helpers_are_under_the_compiler() {
    arena::Arena memory = test::memory(1 << 26);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project p = lang_project("module-three");
    defer scratch::clean(&p);
    scratch::Run header =
        scratch::sh(&p, "smith cc --smith-header src/lib/text.smith -o header.h; echo \"$? $(sed -n 3p header.h)\"");
    scratch::expect_text("modules: smith cc --smith-header writes a header", "0 // smith-module: lib::text",
                         header.out);
    (void)scratch::sh(&p, "smith cc --smith-header src/lib/text.smith -o header.h; cp header.h header.copy; touch -t "
                          "200001010000 header.h");
    (void)scratch::sh(&p, "smith cc --smith-header src/lib/text.smith -o header.h");
    scratch::expect_text(
        "modules: an unchanged header is not written again", "200001010000",
        scratch::sh(&p, "date -r header.h +%Y%m%d%H%M 2>/dev/null || stat -f %Sm -t %Y%m%d%H%M header.h").out);
    scratch::Run gone = scratch::sh(&p, "smith --smith-header src/lib/text.smith -o header.h");
    scratch::expect_failure("modules: the top-level --smith-header is gone", &gone);
    scratch::expect_contains("modules: with the way to run it", gone.err, "smith cc --smith-header");
    scratch::Run lower_gone = scratch::sh(&p, "smith --smith-lower src/lib/text.smith");
    scratch::expect_failure("modules: the top-level --smith-lower is gone", &lower_gone);
    scratch::Run lowered = scratch::sh(&p, "smith cc --smith-lower src/lib/text.smith");
    scratch::expect_contains("modules: smith cc --smith-lower prints the lowering", lowered.out, "lib_text_make");
}
