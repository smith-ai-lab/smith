// scripts/batch_wait.c (issue #2851) against a made-up merge queue: a fake `git ls-remote` reads one line of a state
// file per call, so each case says what the queue's branches are at each poll. Main is M; entry 1's group (branch
// pr-1-M) has head A, entry 2's (pr-2-A) head B, entry 3's (pr-3-B). The tool is built with the system's compiler, as
// CI builds it: clang on macOS, cc (GCC) as gnu2x on Linux. Never reads a real repository.
// smith-covers: scripts/batch_wait.c
module batch_wait_test;

import std::arena;
import std::mem;
import std::test;
import scratch;

constexpr const char *setup =
    "set -e; "
    "if [ \"$(uname -s)\" = Darwin ]; then c='clang -std=c23'; else c='cc -std=gnu2x'; fi; "
    "$c -x c batch_wait.c -o batch_wait; "
    "printf '%s\\n' 'n=$(cat \"$Q.n\" 2>/dev/null || echo 1); line=$(sed -n \"${n}p\" \"$Q\"); "
    "[ -z \"$line\" ] && line=$(tail -n 1 \"$Q\"); echo $((n + 1)) > \"$Q.n\"; [ \"$line\" = FAIL ] && exit 1; "
    "for r in $line; do [ \"$r\" = - ] || printf \"0\\t%s\\n\" \"$r\"; done; exit 0' > fake_ls";

// Runs batch_wait as entry 1 (own branch pr-1-M, group head A) with the queue states `states` (one line per poll,
// `-` for no branch, FAIL for a failed read), polling every 0 s and capped at `cap` polls.
static scratch::Run wait(const scratch::Project *p, const char *states, const char *cap) {
    char command[1024];
    __builtin_snprintf(command, sizeof command,
                       "printf '%%b' '%s' > q && rm -f q.n && "
                       "Q=$PWD/q BATCH_WAIT_LS_REMOTE=\"sh $PWD/fake_ls\" BATCH_WAIT_POLL=0 BATCH_WAIT_MISS_SLEEP=0 "
                       "BATCH_WAIT_CAP=%s ./batch_wait refs/heads/gh-readonly-queue/main/pr-1-M A url",
                       states, cap);
    return scratch::sh(p, command);
}

static void queue(const scratch::Project *p) {
    scratch::copy_tree(p, "scripts/batch_wait.c", "batch_wait.c");
    scratch::Run made = scratch::sh(p, setup);
    scratch::expect_status("batch_wait: the tool and the fake queue are made", 0, &made);
}

// own branch, entry 2's (built on A) and entry 3's (built on B)
constexpr const char *own = "refs/heads/gh-readonly-queue/main/pr-1-M";
constexpr const char *two = " refs/heads/gh-readonly-queue/main/pr-2-A";
constexpr const char *three = " refs/heads/gh-readonly-queue/main/pr-3-B";

static void expect(const scratch::Project *p, const char *name, const char *states, const char *out, I32 status) {
    scratch::Run run = wait(p, states, "60");
    scratch::expect_status(name, status, &run);
    scratch::expect_text(name, out, run.out);
}

export void test_batch_wait_alone_builds_at_once_and_a_merged_entry_cancels() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    queue(&p);
    char states[512];
    // use case 3: one PR alone in the queue builds at once, as today
    expect(&p, "batch_wait: alone, it builds at once", own, "batch=alone\n", 0);
    // use case 1: later groups build on it, then the last one merges it and its branch goes: exit 3, the run cancels
    __builtin_snprintf(states, sizeof states, "%s%s%s\\n%s%s%s\\n-\\n-", own, two, three, own, two, three);
    scratch::Run merged = wait(&p, states, "60");
    scratch::expect_status("batch_wait: merged with a later group, it cancels", 3, &merged);
    scratch::expect_text("batch_wait: and prints no batch", "", merged.out);
    scratch::expect_contains("batch_wait: it logged the wait", merged.err,
                             "waiting on refs/heads/gh-readonly-queue/main/pr-2-A");
    scratch::expect_contains("batch_wait: and the branch gone", merged.err, "pr-1-M is gone (merged or dropped)");
    // a group further back (pr-3 on B) is not built on entry 1
    __builtin_snprintf(states, sizeof states, "%s%s", own, three);
    expect(&p, "batch_wait: a group further back does not make it wait", states, "batch=alone\n", 0);
}

export void test_batch_wait_builds_its_own_tree_once_it_is_last() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    queue(&p);
    char states[512];
    // use case 2: the later entry failed and left the queue: entry 1 is last and runs the full checks
    __builtin_snprintf(states, sizeof states, "%s%s\\n%s%s\\n%s", own, two, own, two, own);
    scratch::Run last = wait(&p, states, "60");
    scratch::expect_status("batch_wait: now last, it builds", 0, &last);
    scratch::expect_text("batch_wait: after waiting", "batch=waited\n", last.out);
    scratch::expect_contains("batch_wait: it logs the change", last.err, "now last; running full checks");
    // a failed read builds: it costs runners, never safety
    __builtin_snprintf(states, sizeof states, "%s%s\\nFAIL", own, two);
    expect(&p, "batch_wait: a failed read builds", states, "batch=waited\n", 0);
    // the wait is capped
    __builtin_snprintf(states, sizeof states, "%s%s", own, two);
    scratch::Run capped = wait(&p, states, "2");
    scratch::expect_status("batch_wait: capped, it builds anyway", 0, &capped);
    scratch::expect_text("batch_wait: as capped", "batch=capped\n", capped.out);
}

export void test_batch_wait_reads_the_group_head_and_survives_a_jump() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    queue(&p);
    char states[512];
    // a branch built on the PR's head P is not built on the group's head A
    __builtin_snprintf(states, sizeof states, "%s refs/heads/gh-readonly-queue/main/pr-2-P", own);
    expect(&p, "batch_wait: only the group's own head names a later group", states, "batch=alone\n", 0);
    // a jump recreates every group branch: this run's branch is gone twice, so it cancels; the new groups have their
    // own branches and their own runs
    __builtin_snprintf(states, sizeof states,
                       "%s%s\\nrefs/heads/gh-readonly-queue/main/pr-9-M refs/heads/gh-readonly-queue/main/pr-1-J", own,
                       two);
    scratch::Run jumped = wait(&p, states, "60");
    scratch::expect_status("batch_wait: after a jump, the old run cancels", 3, &jumped);
    // one read that misses its own branch is not a removal
    __builtin_snprintf(states, sizeof states, "-\\n%s", own);
    expect(&p, "batch_wait: one miss is not a removal", states, "batch=alone\n", 0);
}
