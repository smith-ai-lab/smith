// scripts/batch_wait.c (issue #2851) against a made-up merge queue: a fake `git ls-remote` reads one line of a state
// file per call, so each case says what the queue's branches are at each poll. Main is M; entry 1's group (branch
// pr-1-M) has head A, entry 2's (pr-2-A) head B, entry 3's (pr-3-B). The tool is built with the system's compiler, as
// CI builds it: clang on macOS, cc (GCC) as gnu2x on Linux. Never reads a real repository.
// smith-covers: scripts/batch_wait.c
module batch_wait_test;

import std::arena;
import std::mem;
import std::test;
import scratch;

constexpr const char *setup =
    "set -e; "
    "if [ \"$(uname -s)\" = Darwin ]; then c='clang -std=c23'; else c='cc -std=gnu2x'; fi; "
    "$c -x c batch_wait.c -o batch_wait; "
    "printf '%s\\n' 'n=$(cat \"$Q.n\" 2>/dev/null || echo 1); line=$(sed -n \"${n}p\" \"$Q\"); "
    "[ -z \"$line\" ] && line=$(tail -n 1 \"$Q\"); echo $((n + 1)) > \"$Q.n\"; [ \"$line\" = FAIL ] && exit 1; "
    "for r in $line; do case $r in -) ;; *@*) printf \"%s\\t%s\\n\" \"${r#*@}\" \"${r%@*}\";; *) printf \"0\\t%s\\n\" "
    "\"$r\";; esac; done; exit 0' > fake_ls; "
    "cat > fake_gh <<'EOF'\n"
    "a=\"$*\"\n"
    "case \"$a\" in\n"
    // the runs API filters by `branch`; it ignores `head_branch` and would answer with the newest run of any group
    "*head_branch=*) exit 1;;\n"
    "*rules/branches*) cat \"$G.entries\" 2>/dev/null; exit 0;;\n"
    "*created_at*) for f in \"$G\".at.*; do [ -f \"$f\" ] || continue; b=${f##*.at.}; "
    "case \"$a\" in *\"$b\"*) cat \"$f\"; exit 0;; esac; done; exit 1;;\n"
    "*changes*) i=$(echo \"$a\" | sed 's|.*actions/runs/\\([0-9]*\\)/jobs.*|\\1|'); "
    "cat \"$G.b.$i\" 2>/dev/null; exit 0;;\n"
    "*jobs*) cat \"$G.jobs\" 2>/dev/null; exit 0;;\n"
    "*runs*) cat \"$G.run\" 2>/dev/null; exit 0;;\n"
    "esac\n"
    "exit 1\n"
    "EOF\n";

static scratch::Run wait_as(const scratch::Project *p, const char *states, const char *cap, const char *window,
                            const char *branch, const char *head);

// Runs batch_wait as entry 1 (own branch pr-1-M, group head A) with the queue states `states` (one line per poll,
// `-` for no branch, FAIL for a failed read), polling every 0 s and capped at `cap` polls.
static scratch::Run wait_window(const scratch::Project *p, const char *states, const char *cap, const char *window) {
    return wait_as(p, states, cap, window, "pr-1-M", "A");
}

// the same as the entry whose group branch is `gh-readonly-queue/main/<branch>` and whose group head is `head`
static scratch::Run wait_as(const scratch::Project *p, const char *states, const char *cap, const char *window,
                            const char *branch, const char *head) {
    char command[1024];
    __builtin_snprintf(
        command, sizeof command,
        "printf '%%b' '%s' > q && rm -f q.n && "
        "Q=$PWD/q G=$PWD/g BATCH_WAIT_GH=\"sh $PWD/fake_gh\" BATCH_WAIT_LS_REMOTE=\"sh $PWD/fake_ls\" "
        "BATCH_WAIT_POLL=0 BATCH_WAIT_MISS_SLEEP=0 BATCH_WAIT_NOW=1000000 BATCH_WAIT_TICK=1 BATCH_WAIT_SETTLE=2 "
        "BATCH_WAIT_CAP=%s BATCH_WAIT_WINDOW=%s ./batch_wait refs/heads/gh-readonly-queue/main/%s %s url",
        states, cap, window, branch, head);
    return scratch::sh(p, command);
}

// the same with no batching window
static scratch::Run wait(const scratch::Project *p, const char *states, const char *cap) {
    return wait_window(p, states, cap, "0");
}

static void queue(const scratch::Project *p) {
    scratch::copy_tree(p, "scripts/batch_wait.c", "batch_wait.c");
    scratch::Run made = scratch::sh(p, setup);
    scratch::expect_status("batch_wait: the tool and the fake queue are made", 0, &made);
}

// own branch, entry 2's (built on A) and entry 3's (built on B)
constexpr const char *own = "refs/heads/gh-readonly-queue/main/pr-1-M";
constexpr const char *two = " refs/heads/gh-readonly-queue/main/pr-2-A";
constexpr const char *three = " refs/heads/gh-readonly-queue/main/pr-3-B";

static void expect(const scratch::Project *p, const char *name, const char *states, const char *out, I32 status) {
    scratch::Run run = wait(p, states, "60");
    scratch::expect_status(name, status, &run);
    scratch::expect_text(name, out, run.out);
}

export void test_batch_wait_alone_builds_at_once_and_a_merged_entry_cancels() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    queue(&p);
    char states[512];
    // use case 3: one PR alone in the queue builds at once, as today
    expect(&p, "batch_wait: alone, it builds at once", own, "batch=alone\n", 0);
    // use case 1: later groups build on it, then the last one merges it and its branch goes: exit 3, the run cancels
    __builtin_snprintf(states, sizeof states, "%s%s%s\\n%s%s%s\\n-\\n-", own, two, three, own, two, three);
    scratch::Run merged = wait(&p, states, "60");
    scratch::expect_status("batch_wait: merged with a later group, it cancels", 3, &merged);
    scratch::expect_text("batch_wait: and prints no batch", "", merged.out);
    scratch::expect_contains("batch_wait: it logged the wait", merged.err,
                             "waiting on refs/heads/gh-readonly-queue/main/pr-2-A");
    scratch::expect_contains("batch_wait: and the branch gone", merged.err, "pr-1-M is gone (merged or dropped)");
    // a group further back (pr-3 on B) is not built on entry 1
    __builtin_snprintf(states, sizeof states, "%s%s", own, three);
    expect(&p, "batch_wait: a group further back does not make it wait", states, "batch=alone\n", 0);
}

export void test_batch_wait_builds_its_own_tree_once_it_is_last() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    queue(&p);
    char states[512];
    // use case 2: the later entry failed and left the queue: entry 1 is last and runs the full checks
    __builtin_snprintf(states, sizeof states, "%s%s\\n%s%s\\n%s", own, two, own, two, own);
    scratch::Run last = wait(&p, states, "60");
    scratch::expect_status("batch_wait: now last, it builds", 0, &last);
    scratch::expect_text("batch_wait: after waiting", "batch=waited\n", last.out);
    scratch::expect_contains("batch_wait: it logs the change", last.err, "now last; running full checks");
    // a failed read builds: it costs runners, never safety
    __builtin_snprintf(states, sizeof states, "%s%s\\nFAIL", own, two);
    expect(&p, "batch_wait: a failed read builds", states, "batch=waited\n", 0);
    // the wait is capped
    __builtin_snprintf(states, sizeof states, "%s%s", own, two);
    scratch::Run capped = wait(&p, states, "2");
    scratch::expect_status("batch_wait: capped, it builds anyway", 0, &capped);
    scratch::expect_text("batch_wait: as capped", "batch=capped\n", capped.out);
}

export void test_batch_wait_reads_the_group_head_and_survives_a_jump() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    queue(&p);
    char states[512];
    // a branch built on the PR's head P is not built on the group's head A
    __builtin_snprintf(states, sizeof states, "%s refs/heads/gh-readonly-queue/main/pr-2-P", own);
    expect(&p, "batch_wait: only the group's own head names a later group", states, "batch=alone\n", 0);
    // a jump recreates every group branch: this run's branch is gone twice, so it cancels; the new groups have their
    // own branches and their own runs
    __builtin_snprintf(states, sizeof states,
                       "%s%s\\nrefs/heads/gh-readonly-queue/main/pr-9-M refs/heads/gh-readonly-queue/main/pr-1-J", own,
                       two);
    scratch::Run jumped = wait(&p, states, "60");
    scratch::expect_status("batch_wait: after a jump, the old run cancels", 3, &jumped);
    // one read that misses its own branch is not a removal
    __builtin_snprintf(states, sizeof states, "-\\n%s", own);
    expect(&p, "batch_wait: one miss is not a removal", states, "batch=alone\n", 0);
}

export void test_batch_wait_waits_the_window_for_a_later_group_of_a_burst() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    queue(&p);
    char states[512];
    // last at first, entry 2's group appears inside the window: it waits on it, and cancels when its branch goes
    __builtin_snprintf(states, sizeof states, "%s\\n%s%s\\n-\\n-", own, own, two);
    scratch::Run burst = wait_window(&p, states, "60", "3");
    scratch::expect_status("batch_wait: a group of the burst inside the window makes it wait", 3, &burst);
    scratch::expect_contains("batch_wait: it logged the window", burst.err,
                             "last for now; waiting 3 s for later groups");
    scratch::expect_contains("batch_wait: then the wait", burst.err,
                             "waiting on refs/heads/gh-readonly-queue/main/pr-2-A");
    // no later group within the window: alone, after the window
    scratch::Run alone = wait_window(&p, own, "60", "3");
    scratch::expect_status("batch_wait: alone after the window", 0, &alone);
    scratch::expect_text("batch_wait: as alone", "batch=alone\n", alone.out);
}

export void test_batch_wait_builds_at_once_when_a_later_group_has_a_failed_job() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    queue(&p);
    char states[512];
    __builtin_snprintf(states, sizeof states, "%s%s", own, two);
    // the later group's run is known and still has no failed job: it keeps waiting, to the cap (#2903)
    scratch::Run made = scratch::sh(&p, "echo 4242 > g.run; : > g.jobs");
    scratch::expect_status("batch_wait: the fake run is made", 0, &made);
    scratch::Run running = wait(&p, states, "2");
    scratch::expect_text("batch_wait: a later group with no failed job is waited on", "batch=capped\n", running.out);
    // a failed job in the later group's run: it stops waiting and builds at once, and names the group and the job
    made = scratch::sh(&p, "echo 'test-linux (3, 6)' > g.jobs");
    scratch::expect_status("batch_wait: the failed job is made", 0, &made);
    scratch::Run failed = wait(&p, states, "60");
    scratch::expect_status("batch_wait: a failed later group, it builds", 0, &failed);
    scratch::expect_text("batch_wait: as a split", "batch=split\n", failed.out);
    scratch::expect_contains(
        "batch_wait: it names the group and the job", failed.err,
        "later group refs/heads/gh-readonly-queue/main/pr-2-A failed (job test-linux (3, 6)), building now");
    // the later group has no failed job but its split step ran (a group behind it failed, #3057): this one splits too
    made = scratch::sh(&p, "echo split > g.jobs");
    scratch::Run split = wait(&p, states, "60");
    scratch::expect_text("batch_wait: a later group that splits, it splits too", "batch=split\n", split.out);
    scratch::expect_contains(
        "batch_wait: it says why", split.err,
        "later group refs/heads/gh-readonly-queue/main/pr-2-A is splitting (a group behind it failed), building now");
    // a run that cannot be read is no failure
    made = scratch::sh(&p, "rm g.run");
    scratch::Run unread = wait(&p, states, "2");
    scratch::expect_text("batch_wait: an unreadable run is no failure", "batch=capped\n", unread.out);
}

export void test_batch_wait_skips_the_window_when_the_queue_builds_one_entry() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    queue(&p);
    char states[512];
    __builtin_snprintf(states, sizeof states, "%s%s", own, two);
    // build entries 1 (#2925): no later group can be built, so it returns at once, with no window and no polling,
    // even where the queue shows a later group and the window is long
    scratch::Run made = scratch::sh(&p, "echo 1 > g.entries");
    scratch::expect_status("batch_wait: the ruleset is made", 0, &made);
    scratch::Run one = wait_window(&p, states, "60", "99");
    scratch::expect_status("batch_wait: build entries 1, it builds at once", 0, &one);
    scratch::expect_text("batch_wait: as alone", "batch=alone\n", one.out);
    scratch::expect_contains("batch_wait: it logs why", one.err, "batch: alone (build entries 1)");
    // build entries 4: it waits as before, with the window
    made = scratch::sh(&p, "echo 4 > g.entries");
    scratch::Run four = wait_window(&p, own, "60", "3");
    scratch::expect_status("batch_wait: build entries 4, alone after the window", 0, &four);
    scratch::expect_contains("batch_wait: it waited the window", four.err,
                             "last for now; waiting 3 s for later groups");
    // a ruleset that cannot be read counts as 2 or more: it waits, never skips
    made = scratch::sh(&p, "rm g.entries");
    scratch::Run unread = wait_window(&p, own, "60", "3");
    scratch::expect_contains("batch_wait: an unreadable ruleset waits the window", unread.err,
                             "last for now; waiting 3 s for later groups");
}

export void test_batch_wait_has_one_deadline_per_batch_that_never_restarts() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    queue(&p);
    // entry 3 (branch pr-3-B, head C) on groups pr-1-M (head A) and pr-2-A (head B); the clock starts at 1000000 and
    // advances 1 s per pass; the window is 30 s
    const char *chain = "refs/heads/gh-readonly-queue/main/pr-1-M@A refs/heads/gh-readonly-queue/main/pr-2-A@B "
                        "refs/heads/gh-readonly-queue/main/pr-3-B@C";
    scratch::Run made = scratch::sh(&p, "printf '11\\t999990\\n' > g.at.pr-1-M; printf '12\\t999995\\n' > g.at.pr-2-A; "
                                        "echo 0 > g.b.11; echo 0 > g.b.12");
    scratch::expect_status("batch_wait: the fake runs are made", 0, &made);
    // the deadline is the first run's creation plus the window: 999990 + 30, so 20 s after this run started
    scratch::Run first = wait_as(&p, chain, "60", "30", "pr-3-B", "C");
    scratch::expect_status("batch_wait: last in the batch, it builds at the deadline", 0, &first);
    scratch::expect_text("batch_wait: as alone", "batch=alone\n", first.out);
    scratch::expect_contains("batch_wait: the deadline is the batch's first run plus the window", first.err,
                             "batch: deadline 13:47:00Z (batch from refs/heads/gh-readonly-queue/main/pr-1-M)");
    scratch::expect_contains("batch_wait: it waited for it", first.err, "last for now; waiting 20 s for later groups");
    scratch::expect_contains("batch_wait: and built at it", first.err, "batch: deadline reached, building");
    // a group ahead whose full build started is not in the batch: the batch starts after it, at pr-2-A (999995), and
    // this group waits for that build to end (#3057); here it never ends, so the wait is capped
    made = scratch::sh(&p, "echo 2 > g.b.11");
    scratch::Run later = wait_as(&p, chain, "3", "30", "pr-3-B", "C");
    scratch::expect_contains("batch_wait: the batch starts after a group that is building", later.err,
                             "batch: deadline 13:47:05Z (batch from refs/heads/gh-readonly-queue/main/pr-2-A)");
    scratch::expect_contains("batch_wait: and it waits for that build", later.err,
                             "group ahead refs/heads/gh-readonly-queue/main/pr-1-M is building; waiting for it");
    scratch::expect_text("batch_wait: to the cap", "batch=capped\n", later.out);
    // a deadline already past builds at once, with no wait
    made = scratch::sh(&p, "printf '11\\t999000\\n' > g.at.pr-1-M; echo 0 > g.b.11");
    scratch::Run past = wait_as(&p, chain, "60", "30", "pr-3-B", "C");
    scratch::expect_status("batch_wait: a past deadline, it builds at once", 0, &past);
    scratch::expect_text("batch_wait: as alone", "batch=alone\n", past.out);
    // a later group that appears and leaves does not restart the deadline: built at 999990 + 30 as before
    const char *busy = "refs/heads/gh-readonly-queue/main/pr-1-M@A refs/heads/gh-readonly-queue/main/pr-2-A@B "
                       "refs/heads/gh-readonly-queue/main/pr-3-B@C";
    char states[1024];
    made = scratch::sh(&p, "printf '11\\t999990\\n' > g.at.pr-1-M");
    __builtin_snprintf(states, sizeof states, "%s\n%s refs/heads/gh-readonly-queue/main/pr-4-C@D\n%s", busy, busy,
                       busy);
    scratch::Run kept = wait_as(&p, states, "60", "30", "pr-3-B", "C");
    scratch::expect_status("batch_wait: a group that came and went, it still builds", 0, &kept);
    scratch::expect_text("batch_wait: as waited", "batch=waited\n", kept.out);
    scratch::expect_contains("batch_wait: at the same deadline", kept.err, "batch: deadline 13:47:00Z");
}

export void test_batch_wait_waits_for_the_full_build_ahead_then_holds_every_waiting_entry() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    queue(&p);
    // #3057: entry 1's group (pr-1-M, head A, run 11) is in its full build; entries 2 and 3 queued behind it minutes
    // apart (pr-2-A head B run 12, pr-3-B head C). Entry 3 is last: it waits while pr-1-M is there, and when that
    // group merges (its branch goes) it builds after the settle time, with entry 2 in its tree.
    const char *one = "refs/heads/gh-readonly-queue/main/pr-1-M@A";
    const char *rest = "refs/heads/gh-readonly-queue/main/pr-2-A@B refs/heads/gh-readonly-queue/main/pr-3-B@C";
    scratch::Run made = scratch::sh(&p, "printf '11\\t999000\\n' > g.at.pr-1-M; printf '12\\t999500\\n' > g.at.pr-2-A; "
                                        "echo 2 > g.b.11; echo 0 > g.b.12");
    scratch::expect_status("batch_wait: the fake runs are made", 0, &made);
    char states[1024];
    __builtin_snprintf(states, sizeof states, "%s %s\n%s %s\n%s %s\n%s", one, rest, one, rest, one, rest, rest);
    scratch::Run train = wait_as(&p, states, "60", "30", "pr-3-B", "C");
    scratch::expect_status("batch_wait: the build ahead ended, it builds", 0, &train);
    scratch::expect_text("batch_wait: as waited", "batch=waited\n", train.out);
    scratch::expect_contains("batch_wait: it waited for the build ahead", train.err,
                             "group ahead refs/heads/gh-readonly-queue/main/pr-1-M is building; waiting for it");
    scratch::expect_contains("batch_wait: until its branch went", train.err,
                             "refs/heads/gh-readonly-queue/main/pr-1-M is gone; no group ahead is building");
    scratch::expect_contains("batch_wait: then the settle time", train.err,
                             "last for now; waiting 2 s for later groups");
    // entry 2 has a later group, so it waits on it whatever is ahead, and is merged by it (its branch goes)
    __builtin_snprintf(states, sizeof states, "%s %s\n%s\n-\n-", one, rest, rest);
    scratch::Run second = wait_as(&p, states, "60", "30", "pr-2-A", "B");
    scratch::expect_status("batch_wait: the entry in the middle is merged by the last one", 3, &second);
    // a split does not wait for the build ahead: entry 2's later group failed while pr-1-M builds
    made = scratch::sh(&p, "echo 4242 > g.run; echo 'test-linux (3, 6)' > g.jobs");
    __builtin_snprintf(states, sizeof states, "%s %s", one, rest);
    scratch::Run split = wait_as(&p, states, "60", "30", "pr-2-A", "B");
    scratch::expect_text("batch_wait: a split builds beside the build ahead", "batch=split\n", split.out);
    // nothing ahead is building: entry 3 builds at its batch's deadline, as before
    made = scratch::sh(&p, "echo 0 > g.b.11");
    __builtin_snprintf(states, sizeof states, "%s %s", one, rest);
    scratch::Run none = wait_as(&p, states, "60", "30", "pr-3-B", "C");
    scratch::expect_text("batch_wait: no build ahead, no wait", "batch=alone\n", none.out);
}
