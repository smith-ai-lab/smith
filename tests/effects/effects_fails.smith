module effects_fails;

import smith::effects;

// A checked index is a failure point.
export [[smith::effects(fails)]] i32 at(i32 values[:], usize index) {
    return values[index];
}

// Inferred: the index brings `fails`, and a ceiling without it rejects the function.
export [[smith::pure]] i32 pure_at(i32 values[:], usize index) {
    return values[index];
}

export [[smith::effects(alloc)]] i32 alloc_at(i32 values[:], usize index) {
    return values[index];
}

static i32 first(i32 values[:]) {
    return values[0];
}

// No failure point: pure holds.
export [[smith::pure]] i32 safe(i32 x) {
    return x + 1;
}

// The generic asks for no `fails` of the function it is given.
export i32 run(constexpr auto f, auto x) {
    static_assert(effects::within(f, effects::none), "run: f may not fail");
    return f(x);
}

export i32 good(i32 x) {
    return run(safe, x);
}

export i32 bad(i32 values[:]) {
    return run(first, values);
}
