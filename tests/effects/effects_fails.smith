module effects_fails;

import std::effects;

// A checked index is a failure point.
export [[std::effects(fails)]] I32 at(I32 values[:], Usize index) {
    return values[index];
}

// Inferred: the index brings `fails`, and a ceiling without it rejects the function.
export [[std::pure]] I32 pure_at(I32 values[:], Usize index) {
    return values[index];
}

export [[std::effects(alloc)]] I32 alloc_at(I32 values[:], Usize index) {
    return values[index];
}

static U32 first(U32 values[:]) {
    return values[0];
}

// No failure point: pure holds.
export [[std::pure]] U32 safe(U32 x) {
    return x + 1U;
}

// The generic asks for no `fails` of the function it is given.
export U32 run(constexpr auto f, auto x) {
    static_assert(effects::within(f, effects::none), "run: f may not fail");
    return f(x);
}

export U32 good(U32 x) {
    return run(safe, x);
}

export U32 bad(U32 values[:]) {
    return run(first, values);
}
