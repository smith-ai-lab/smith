module proof_only;

// Functions reached only from proved checks are proof code (issue #1055): no effects, and no recursion error. A
// proved check is written as the lowering writes it, `contract::kept_assert(...)`.

import <stdio.h>;
import std::contract;

// Only a proved check calls it: it recurses and says it is pure, which holds because it runs nowhere.
static u64 odd_sum(u64 n) {
    return n == 0 ? 0 : odd_sum(n - 1) + 2 * n - 1;
}

export [[std::pure]] u64 square(u64 n) {
    contract::kept_assert(odd_sum(n) == n * n);
    return n * n;
}

// A function the proof code calls is proof code too, and a cycle of them is no error.
static bool even_proof(u64 n);

static bool odd_proof(u64 n) {
    return n != 0 && even_proof(n - 1);
}

static bool even_proof(u64 n) {
    return n == 0 || odd_proof(n - 1);
}

export u64 half(u64 n) {
    contract::kept_assert(even_proof(n * 2));
    return n;
}

// Its effects do not reach the caller either.
static u64 noisy(u64 n) {
    c::printf("%lu\n", n);
    return n;
}

export [[std::pure]] u64 quiet(u64 n) {
    contract::kept_assert(noisy(n) == n);
    return n;
}

// Running code that calls it makes it running: the error is the existing one.
static u64 loud(u64 n) {
    return n == 0 ? 0 : loud(n - 1) + 1;
}

export u64 both(u64 n) {
    contract::kept_assert(loud(n) == n);
    return loud(n);
}

// A check that is not proved runs, so its function does too.
static u64 checked(u64 n) {
    return n == 0 ? 0 : checked(n - 1) + 1;
}

export u64 unproved(u64 n) {
    contract::assert(checked(n) == n);
    return n;
}
