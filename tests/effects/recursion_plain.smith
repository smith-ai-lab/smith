

// The same functions as recursion.smith in a .smith file with no `module` line: nothing is said (the strictness
// ladder).

U64 sum_to(U64 n, U64 total) {
    if (n == 0) return total;
    [[clang::musttail]] return sum_to(n - 1, total + n);
}

U64 ping(U64 n);

U64 pong(U64 n) {
    if (n == 0) return 0;
    [[clang::musttail]] return ping(n - 1);
}

U64 ping(U64 n) {
    if (n == 0) return 1;
    [[clang::musttail]] return pong(n - 1);
}

// A call through a pointer is not followed, and nor is a call into code with no source.
U32 apply(U32 (*step)(U32), U32 n) {
    return step(n);
}

U32 not_recursive(U32 n) {
    return apply(not_recursive, n);
}
