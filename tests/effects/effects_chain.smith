module effects_chain;

import <stdio.h>;
import <stdlib.h>;
import <string.h>;

static void log_it(const char *text) {
    c::printf("%s\n", text);
}

export [[std::pure]] I32 length(const char *text) {
    return (I32)c::strlen(text);
}

export [[std::pure]] I32 bad(const char *text) {
    log_it(text);
    return 0;
}

export [[std::effects(alloc)]] void *grab(U32 size) {
    return c::malloc(size);
}

export [[std::effects(alloc)]] I32 too_much(const char *path) {
    return c::fopen(path, "r") != nullptr;
}

// A checked slice index is `fails`, which a ceiling lists.
export [[std::effects(fails)]] I32 at(I32 values[:], Usize index) {
    return values[index];
}
