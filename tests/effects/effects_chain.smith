module effects_chain;

import <stdio.h>;
import <stdlib.h>;
import <string.h>;

static void log_it(const char *text) {
    c::printf("%s\n", text);
}

export [[smith::pure]] i32 length(const char *text) {
    return (i32)c::strlen(text);
}

export [[smith::pure]] i32 bad(const char *text) {
    log_it(text);
    return 0;
}

export [[smith::effects(alloc)]] void *grab(u32 size) {
    return c::malloc(size);
}

export [[smith::effects(alloc)]] i32 too_much(const char *path) {
    return c::fopen(path, "r") != nullptr;
}

// A checked slice index is `fails`, which a ceiling lists.
export [[smith::effects(fails)]] i32 at(i32 values[:], usize index) {
    return values[index];
}
