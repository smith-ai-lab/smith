// The fix for the propagate idiom on a Result (#2506): `r: Result(T, E) = f()` and `if r == .error: return {.error =
// r.error}` is `ok := try f()`, each `r.ok` is `ok`; a cleanup before the return is an `errdefer`. Any other use of `r`
// or an `ok` in scope leaves the site as it is.
module front_check_result_try_fix_test;

import front::fix;
import std::arena;
import std::format;
import std::mem;
import std::test;

static void expect(Str before, Str after) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed first = fix::fix_text("t.smith", before);
    test::check_equal(first.text, after);
    fix::Fixed again = fix::fix_text("t.smith", first.text);
    test::check_equal(again.text, after);
}

static Str head_text() {
    return "fn step(n: i32) -> Result(i32, i32):\n    if n < 0:\n        return {.error = n}\n    {.ok = n}\n";
}

export void test_front_check_result_try_fix_the_propagate_idiom_is_try() {
    char before[:] =
        format::push(head_text(), "fn twice(n: i32) -> Result(i32, i32):\n    r: Result(i32, i32) = step(n)\n"
                                  "    if r == .error:\n        return {.error = r.error}\n"
                                  "    {.ok = r.ok * 2}\n");
    char after[:] = format::push(head_text(), "fn twice(n: i32) -> Result(i32, i32):\n    ok := try step(n)\n"
                                              "    {.ok = ok * 2}\n");
    expect(before, after);
}

export void test_front_check_result_try_fix_a_cleanup_becomes_an_errdefer() {
    char before[:] =
        format::push(head_text(), "fn twice(n: i32, log: *mut i32) -> Result(i32, i32):\n"
                                  "    r: Result(i32, i32) = step(n)\n"
                                  "    if r == .error:\n        log.* = 1\n        return {.error = r.error}\n"
                                  "    {.ok = r.ok * 2}\n");
    char after[:] = format::push(head_text(), "fn twice(n: i32, log: *mut i32) -> Result(i32, i32):\n"
                                              "    errdefer log.* = 1\n    ok := try step(n)\n"
                                              "    {.ok = ok * 2}\n");
    expect(before, after);
}

export void test_front_check_result_try_fix_an_error_changed_on_the_way_stays() {
    char site[:] =
        format::push(head_text(), "fn twice(n: i32) -> Result(i32, i32):\n    r: Result(i32, i32) = step(n)\n"
                                  "    if r == .error:\n        return {.error = 0}\n"
                                  "    {.ok = r.ok * 2}\n");
    expect(site, site);
}
