// The shared cache of compile steps (#621): a compile whose command and inputs another build has seen is not run, its
// outputs are cloned from <cache>/smith/steps. Each test has a cache of its own, shared by its projects. The projects
// are built `release`: a debug object holds the folder it was compiled in (its debug info), so a debug build is served
// only to a build in that folder.
module build_step_cache_test;

import smith::format;
import smith::io;
import smith::test;
import scratch;

static scratch::Project made(io::Io *io, const char *name) {
    scratch::Project p = scratch::project(io, name, "step_cache");
    scratch::own_cache(&p);
    return p;
}

// `smith build release` with its progress lines kept: the compiles it ran, and how many of them the cache served.
static const char *built(const scratch::Project *p, const char *before) {
    return format::push(&p->io->arena, "env SMITH_STEP_CACHE=1 ", before, "smith build release 2>&1").data;
}

static const char *count(const scratch::Project *p, const char *build, const char *pattern) {
    return scratch::capture(p, format::push(&p->io->arena, build, " | grep -c '", pattern, "'; true").data);
}

// 1. The second folder runs no compile, and its objects are the first's, byte for byte.
export void test_build_step_cache_a_second_folder_runs_no_compile(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::Project b = made(io, "b");
    scratch::expect_text("cache: the first folder compiles all three", "3",
                         count(&a, built(&a, ""), "^\\[[0-9/]*\\] compile [a-z]*[.]c$"));
    const char *second = built(&b, "");
    scratch::expect_text("cache: the second folder is served all three", "3", count(&b, second, "[.]c (cached)$"));
    scratch::Run same =
        scratch::sh(&b, "for f in main other util; do cmp build/release/$f.o ../a/build/release/$f.o || exit 1; done");
    scratch::expect_status("cache: its objects are the first's", 0, &same);
    scratch::expect_status("cache: and the program built from them runs", 0,
                           &(scratch::Run){.status = scratch::sh(&b, "build/release/b").status});
}

// 2. A header changed: the files that include it compile again, the others are up to date.
export void test_build_step_cache_a_changed_header_recompiles_its_includers(io::Io *io) {
    scratch::Project a = made(io, "a");
    (void)scratch::sh(&a, built(&a, ""));
    scratch::write(&a, "util.h", "int util(void);\nint more(void);\n");
    const char *again = built(&a, "");
    scratch::Run run = scratch::sh(&a, again);
    scratch::expect_contains("header: main.c, which includes it, compiles again", run.out, "compile main.c");
    scratch::expect_contains("header: and so does util.c", run.out, "compile util.c");
    scratch::expect_lacks("header: other.c does not", run.out, "other.c");
    scratch::expect_lacks("header: and neither is served, for the header is new", run.out, "(cached)");
    scratch::write(&a, "util.h", "int util(void);\n");
    scratch::Run back = scratch::sh(&a, built(&a, ""));
    scratch::expect_contains("header: the old header's compiles are served again", back.out, "compile util.c (cached)");
}

// 3. A hit is what a rebuild makes.
export void test_build_step_cache_a_hit_equals_a_rebuild(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::Project b = made(io, "b");
    (void)scratch::sh(&a, built(&a, ""));
    (void)scratch::sh(&b, built(&b, ""));
    (void)scratch::sh(&b,
                      "mkdir -p hit && cp build/release/*.o hit/ && rm -rf build .smith/.smith_log .smith/.smith_deps");
    scratch::Run forced = scratch::sh(&b, "SMITH_STEP_CACHE=0 smith build release 2>&1");
    scratch::expect_lacks("rebuild: the forced build uses no cache", forced.out, "(cached)");
    scratch::Run same = scratch::sh(&b, "for f in main other util; do cmp build/release/$f.o hit/$f.o || exit 1; done");
    scratch::expect_status("rebuild: a hit equals a rebuild", 0, &same);
}

// 3b. A file the cache holds keeps the time of the build that stored it when the platform clones it (macOS's
// clonefile does): a hit is new all the same, or the next build takes it for older than the sources, makes it again
// and everything after it, for ever (a project with a deferred step never settled). The cache's files are made old
// here, as a clone would leave them.
export void test_build_step_cache_a_hit_is_newer_than_the_sources_even_from_an_old_entry(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::Project b = made(io, "b");
    (void)scratch::sh(&a, built(&a, ""));
    (void)scratch::sh(&b, "find \"$XDG_CACHE_HOME/smith/steps/r\" -type f -exec touch -t 200101010000 {} +");
    scratch::Run served = scratch::sh(&b, built(&b, ""));
    scratch::expect_contains("old entry: the second folder is served", served.out, "(cached)");
    // Not older, rather than newer: macOS's sh compares whole seconds, and the sources and the hit share one.
    scratch::Run newer =
        scratch::sh(&b, "for f in main other util; do [ $f.c -nt build/release/$f.o ] && exit 1; done; exit 0");
    scratch::expect_status("old entry: its objects are not older than the sources", 0, &newer);
    scratch::Run again = scratch::sh(&b, built(&b, ""));
    scratch::expect_contains("old entry: and the next build has no work", again.out, "no work to do");
}

// 4. The folder is a token in what is kept: the second folder's depfile log names its own files.
export void test_build_step_cache_the_second_folders_log_names_its_own_paths(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::Project b = made(io, "b");
    (void)scratch::sh(&a, built(&a, ""));
    scratch::Run second = scratch::sh(&b, built(&b, ""));
    scratch::expect_contains("paths: the second folder is served", second.out, "(cached)");
    scratch::expect_text(
        "paths: its depfile log holds nothing of the first folder", "0",
        scratch::capture(&b, format::push(&io->arena, "grep -c '", a.dir, "' .smith/.smith_deps; true").data));
    scratch::expect_text("paths: and it names the headers", "yes",
                         scratch::capture(&b, "grep -q '^util[.]h$' .smith/.smith_deps && echo yes"));
}

// 5. SMITH_STEP_CACHE=0 turns the cache off.
export void test_build_step_cache_can_be_turned_off(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::Project b = made(io, "b");
    (void)scratch::sh(&a, built(&a, ""));
    scratch::Run second = scratch::sh(&b, built(&b, "SMITH_STEP_CACHE=0 "));
    scratch::expect_lacks("off: nothing is served", second.out, "(cached)");
    scratch::expect_contains("off: the compiles run", second.out, "compile main.c");
}

// 6. The cap of the caches (SMITH_CACHE_MAX, #618) applies: over it, the least recently used results go at the next
// build's start, once an hour.
export void test_build_step_cache_results_over_the_cap_are_removed(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::Project b = made(io, "b");
    (void)scratch::sh(&a, built(&a, ""));
    // an old time in the form both touches read (GNU's -d '2 hours ago' is an error on macOS)
    (void)scratch::sh(&a, "touch -t 200001010000 \"$XDG_CACHE_HOME/smith/steps/prune.timestamp\"");
    scratch::Run capped = scratch::sh(&b, built(&b, "SMITH_CACHE_MAX=1 "));
    scratch::expect_lacks("cap: nothing is left to serve", capped.out, "(cached)");
    scratch::expect_contains("cap: the compiles run", capped.out, "compile main.c");
}

// 7. A precompiled header is never served: it records the time of each file it read, so one served after a checkout
// rewrote its header with the same text (a new time) is rejected by every compile that includes it (#728).
constexpr char pch_build[_] =
    "#include <smith/build.h>\n"
    "void build(SmithBuild *b) {\n"
    "    SmithObject header = {.compiler = \"smith-cc\", .source = \"other.h\", .output = \"build/other.pch\",\n"
    "                          .flags = smith_list(b, \"-x\", \"c-header\", nullptr)};\n"
    "    smith_object(b, &header);\n"
    "    smith_default(b, header.step.outputs);\n"
    "}\n";

export void test_build_step_cache_a_precompiled_header_is_compiled_again(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::write(&a, "build.c", pch_build);
    const char *build = "env SMITH_STEP_CACHE=1 smith build 2>&1";
    scratch::Run first = scratch::sh(&a, build);
    scratch::expect_status("pch: the header compiles", 0, &first);
    // the header's text is the same and its time is newer than the header's output, both in the past
    (void)scratch::sh(&a, "touch -t 200101010000 other.h && touch -t 200001010000 build/other.pch");
    scratch::Run again = scratch::sh(&a, build);
    scratch::expect_contains("pch: it compiles again", again.out, "compile other.h");
    scratch::expect_lacks("pch: and is not served", again.out, "(cached)");
    scratch::Run used = scratch::sh(&a, "smith-cc -include-pch build/other.pch -fsyntax-only other.c 2>&1");
    scratch::expect_status("pch: a compile that includes it accepts it", 0, &used);
}

// 8. The build program (.smith/program, which a fresh project compiles from build.c and the embedded runtime) is
// served too: its compiles are -MD and its debug info names no folder, so a second folder with the same build file
// stores no result of its own. (SMITH_VERBOSE would show the compiles, but a compile that prints is never stored.)
constexpr char results[_] = "find \"$XDG_CACHE_HOME/smith/steps/r\" -mindepth 2 -maxdepth 2 | wc -l | tr -d ' '";

export void test_build_step_cache_serves_the_build_program_to_a_second_folder(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::Project b = made(io, "b");
    (void)scratch::sh(&a, built(&a, ""));
    const char *first = scratch::capture(&a, results);
    scratch::expect_text("program: the first folder stores the program's compiles and the project's", "yes",
                         scratch::capture(&a, format::push(&io->arena, "[ ", first, " -ge 10 ] && echo yes").data));
    (void)scratch::sh(&b, built(&b, ""));
    scratch::expect_text("program: the second folder stores nothing of its own", first, scratch::capture(&b, results));
    scratch::Run same = scratch::sh(&b, "cmp .smith/build-program/runtime.o ../a/.smith/build-program/runtime.o");
    scratch::expect_status("program: and its objects are the first's", 0, &same);
}

// 9. A built project copied with its times (`cp -Rp`) to another path is up to date there: what the build keeps (the
// effects summaries' names, the module maps, the logs) is relative to the project, so nothing runs (#638).
static const char *moved(const scratch::Project *p, const char *command) {
    return scratch::capture(p, format::push(&p->io->arena, "mkdir ../moved && cp -Rp . ../moved/a && cd ../moved/a && ",
                                            command, " 2>&1; true")
                                   .data);
}

export void test_build_step_cache_a_copied_project_builds_nothing(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::Run first = scratch::sh(&a, "env SMITH_STEP_CACHE=0 smith build -d explain 2>&1");
    scratch::expect_status("copy: the project builds", 0, &first);
    const char *copy = moved(&a, "env SMITH_STEP_CACHE=0 smith build -d explain");
    scratch::expect_text("copy: nothing is dirty", "smith: no work to do.", copy);
    scratch::expect_lacks("copy: no compile runs", copy, "compile");
    scratch::expect_text("copy: and no summary is named by a folder", "0",
                         scratch::capture(&a, "ls ../moved/a/.smith/effects | grep -c '^%'; true"));
}

// 10. In the copy a changed source rebuilds its object and what links it, and nothing else.
export void test_build_step_cache_a_copied_project_rebuilds_only_what_changed(io::Io *io) {
    scratch::Project a = made(io, "a");
    (void)scratch::sh(&a, "env SMITH_STEP_CACHE=0 smith build");
    const char *copy = moved(&a, "echo '/* changed */' >> util.c && env SMITH_STEP_CACHE=0 smith build");
    scratch::expect_contains("changed: util.c compiles", copy, "compile util.c");
    scratch::expect_contains("changed: and the program links", copy, "link build/debug/a");
    scratch::expect_lacks("changed: main.c does not", copy, "main.c");
    scratch::expect_lacks("changed: and other.c does not", copy, "other.c");
}

// 11. SMITH_STEP_CACHE=program serves the build program and nothing else: the second folder stores no result of its
// own, and the three compiles of its project run (the tests' runs use it, so that a test that counts compiles sees
// them).
export void test_build_step_cache_program_mode_serves_only_the_build_program(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::Project b = made(io, "b");
    const char *build = "env SMITH_STEP_CACHE=program smith build release 2>&1";
    (void)scratch::sh(&a, build);
    const char *first = scratch::capture(&a, results);
    scratch::expect_text("program mode: the first folder stores the program's compiles", "yes",
                         scratch::capture(&a, format::push(&io->arena, "[ ", first, " -ge 1 ] && echo yes").data));
    scratch::expect_text("program mode: the second folder's project compiles run", "3",
                         count(&b, build, "^\\[[0-9/]*\\] compile [a-z]*[.]c$"));
    scratch::expect_text("program mode: ... and it stores nothing of its own", first, scratch::capture(&b, results));
}
