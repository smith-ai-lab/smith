// The shared cache of compile steps (#621): a compile whose command and inputs another build has seen is not run, its
// outputs are cloned from <cache>/smith/steps. Whether a compile is served is a function of its command, the content of
// its inputs (the headers its depfile names included) and the cache folder, so it is checked in process through
// `smith_core_step_cache` (include/smith_core_step_cache.h, issue #646): a manifest the test writes, a fake command
// that makes the outputs, and the lines `ran <output>` / `served <output>` of a build. Each test has a cache of its
// own, shared by its folders (a second folder is a second call in the same process). What needs the real compiler stays
// a scratch project: a hit equals a real compile's bytes, and the build program is served to a second folder.
// smith-covers: smith.c runtime/build_runtime.c runtime/executor*.c runtime/slots.c runtime/lang*.c runtime/verbs.c
// smith-covers: runtime/cache.c runtime/sdk_cache.c runtime/platform_*.c runtime/quiet.c runtime/base.h
// smith-covers: include/smith/ include/smith_core*.h lib/std/test.smith tests/build_fixtures/
module build_step_cache_test;

import std::arena;
import std::format;
import std::env;
import std::mem;
import std::test;
import scratch;
import corpus;
import <smith_core_step_cache.h>;
import <time.h>;

constexpr Usize memory_size = (Usize)4 << 20; // 4 MiB
constexpr Usize output_capacity = 1U << 14;

// ---------------------------------------------------------------- in process

// A build.ninja of three objects, as `smith build` writes compiles: the command has -MD and -MF (its program is any
// program on PATH, for the fake never runs it) and the rule has a depfile.
constexpr const char *manifest_text =
    "ninja_required_version = 1.10\nbuilddir = .smith\nrule cc\n  command = $cmd\n"
    "build main.o: cc main.c\n  cmd = sh -MD -MF main.o.d -c main.c -o main.o\n  depfile = main.o.d\n  deps = gcc\n"
    "build util.o: cc util.c\n  cmd = sh -MD -MF util.o.d -c util.c -o util.o\n  depfile = util.o.d\n  deps = gcc\n"
    "build other.o: cc other.c\n  cmd = sh -MD -MF other.o.d -c other.c -o other.o\n  depfile = other.o.d\n  deps = "
    "gcc\n"
    "default main.o util.o other.o\n";

// What a build did: its explanations and `ran` / `served` lines, and how many of each.
typedef struct {
    const char *text;
    Usize ran;
    Usize served;
} Build;

static void put(const scratch::Project p, const char *name, const char *text, I64 time) {
    test::check_condition(c::smith_core_plan_write(p.dir, name, text, time));
}

// A project folder with the manifest and the sources, all written at the time 100 (seconds).
static scratch::Project project(const char *name) {
    scratch::Project p = scratch::make(name, nullptr);
    test::check_condition(c::smith_core_plan_write(p.dir, ".smith/build.ninja", manifest_text, 100));
    put(p, "main.c", "#include \"other.h\"\n#include \"util.h\"\nint main(void) { return 0; }\n", 100);
    put(p, "util.c", "#include \"util.h\"\nint util(void) { return 1; }\n", 100);
    put(p, "other.c", "#include \"other.h\"\nint other(void) { return 2; }\n", 100);
    put(p, "util.h", "int util(void);\n", 100);
    put(p, "other.h", "int other(void);\n", 100);
    return p;
}

// One `smith build` of the folder with the cache in `cache` (nullptr: the cache turned off), whose commands run at
// `time`. The depfiles name the headers `directory` + "util.h" and "other.h" (a folder's own absolute paths when it is
// given, else relative ones).
static Build build_in(const scratch::Project p, const char *cache, I64 time, const char *directory) {
    const char *util = format::push(directory, "util.h").data;
    const char *other = format::push(directory, "other.h").data;
    const char *const depends[_] = {format::push("main.o: main.c ", other, " ", util).data,
                                    format::push("util.o: util.c ", util).data,
                                    format::push("other.o: other.c ", other).data, nullptr};
    c::SmithCoreStepCache step = {.plan = {.folder = p.dir,
                                           .manifest = ".smith/build.ninja",
                                           .targets = nullptr,
                                           .unchanged = nullptr,
                                           .depends = depends,
                                           .time = time},
                                  .cache = cache};
    char *text = mem::alloc_slice(char, output_capacity).data;
    Usize ran = 0;
    Usize served = 0;
    test::check_equal(c::smith_core_step_cache(&step, text, output_capacity, &ran, &served), true);
    Build done = {text, ran, served};
    return done;
}

static Build build(const scratch::Project p, const char *cache, I64 time) {
    return build_in(p, cache, time, "");
}

static void expect_counts(const char *name, Usize ran, Usize served, const Build *done) {
    scratch::expect_count(format::push(name, ": commands run").data, ran, done->ran);
    scratch::expect_count(format::push(name, ": results served").data, served, done->served);
}

// 1. The second folder runs no compile.
export void test_build_step_cache_a_second_folder_runs_no_compile() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project a = project("a");
    defer scratch::clean(&a);
    scratch::Project b = project("b");
    defer scratch::clean(&b);
    scratch::own_cache(&a);
    Build first = build(a, a.cache, 1000);
    expect_counts("cache: the first folder compiles all three", 3, 0, &first);
    Build second = build(b, a.cache, 1000);
    expect_counts("cache: the second folder is served all three", 0, 3, &second);
    scratch::expect_contains("cache: and says so", second.text, "main.o restored from the step cache");
    scratch::expect_contains("cache: for each object", second.text, "served other.o");
}

// 2. A header changed: the files that include it compile again, the others are up to date.
export void test_build_step_cache_a_changed_header_recompiles_its_includers() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project a = project("a");
    defer scratch::clean(&a);
    scratch::own_cache(&a);
    (void)build(a, a.cache, 1000);
    put(a, "util.h", "int util(void);\nint more(void);\n", 2000);
    Build again = build(a, a.cache, 3000);
    expect_counts("header: its includers compile again and are not served, for the header is new", 2, 0, &again);
    scratch::expect_contains("header: main.c, which includes it, compiles again", again.text, "ran main.o");
    scratch::expect_contains("header: and so does util.c", again.text, "ran util.o");
    scratch::expect_lacks("header: other.c does not", again.text, "other.o");
    put(a, "util.h", "int util(void);\n", 4000);
    Build back = build(a, a.cache, 5000);
    expect_counts("header: the old header's compiles are served again", 0, 2, &back);
    scratch::expect_contains("header: util.c among them", back.text, "served util.o");
}

// 3. The folder is a token in what is kept: the second folder's depfile log names its own files, so a change to its
// own header (an absolute path, as clang writes it) recompiles, and the first folder's header is not its input.
export void test_build_step_cache_the_second_folders_log_names_its_own_paths() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project a = project("a");
    defer scratch::clean(&a);
    scratch::Project b = project("b");
    defer scratch::clean(&b);
    scratch::own_cache(&a);
    const char *in_a = format::push(scratch::capture(&a, "pwd -P"), "/").data;
    const char *in_b = format::push(scratch::capture(&b, "pwd -P"), "/").data;
    (void)build_in(a, a.cache, 1000, in_a);
    Build second = build_in(b, a.cache, 1000, in_b);
    expect_counts("paths: the second folder is served", 0, 3, &second);
    // the second folder's objects are restored, so they have the time of now: later edits are later than that
    I64 now = (I64)c::time(nullptr);
    put(a, "util.h", "int util(void);\nint more(void);\n", now + 1000);
    Build untouched = build_in(b, a.cache, now + 2000, in_b);
    scratch::expect_contains("paths: a change in the first folder is no work for the second", untouched.text,
                             "no work to do");
    put(b, "util.h", "int util(void);\nint other_more(void);\n", now + 3000);
    Build changed = build_in(b, a.cache, now + 4000, in_b);
    expect_counts("paths: a change in its own header recompiles its includers", 2, 0, &changed);
}

// 4. The cache turned off serves nothing.
export void test_build_step_cache_can_be_turned_off() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project a = project("a");
    defer scratch::clean(&a);
    scratch::Project b = project("b");
    defer scratch::clean(&b);
    scratch::own_cache(&a);
    (void)build(a, a.cache, 1000);
    Build second = build(b, nullptr, 1000);
    expect_counts("off: nothing is served, the compiles run", 3, 0, &second);
    scratch::expect_lacks("off: nothing is restored", second.text, "restored");
}

// 5. The cap of the caches (SMITH_CACHE_MAX, #618) applies: over it, the least recently used results go at the next
// build's start, once an hour. The prune takes the cap and the time; the environment variable is read by the verb.
export void test_build_step_cache_results_over_the_cap_are_removed() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project a = project("a");
    defer scratch::clean(&a);
    scratch::Project b = project("b");
    defer scratch::clean(&b);
    scratch::Project third = project("c");
    defer scratch::clean(&third);
    scratch::own_cache(&a);
    (void)build(a, a.cache, 1000);
    I64 now = (I64)c::time(nullptr);
    test::check_equal(c::smith_core_step_cache_prune(a.cache, (U64)1 << 30, now), true);
    Build kept = build(b, a.cache, 1000);
    expect_counts("cap: results within the cap stay", 0, 3, &kept);
    // the stamp of the first prune is under an hour old: a second one does nothing, a later one removes
    test::check_equal(c::smith_core_step_cache_prune(a.cache, 1, now), true);
    Build same_hour = build(third, a.cache, 1000);
    expect_counts("cap: a prune within the hour does nothing", 0, 3, &same_hour);
    test::check_equal(c::smith_core_step_cache_prune(a.cache, 1, now + 7200), true);
    scratch::Project d = project("d");
    defer scratch::clean(&d);
    Build capped = build(d, a.cache, 1000);
    expect_counts("cap: over the cap nothing is left to serve", 3, 0, &capped);
}

// 6. A precompiled header is served only when it is made and read with -fvalidate-ast-input-files-content: it records
// the time of each file it read, so one served after a checkout rewrote its header with the same text (a new time)
// is rejected by every compile that includes it (#728) unless the hash of each input is stored (#1415).
constexpr const char *pch_manifest =
    "ninja_required_version = 1.10\nbuilddir = .smith\nrule cc\n  command = $cmd\n"
    "build other.pch: cc other.h\n  cmd = sh -x c-header -MD -MF other.pch.d -c other.h -o other.pch\n"
    "  depfile = other.pch.d\n  deps = gcc\ndefault other.pch\n";
constexpr const char *pch_validated_manifest =
    "ninja_required_version = 1.10\nbuilddir = .smith\nrule cc\n  command = $cmd\n"
    "build other.pch: cc other.h\n  cmd = sh -x c-header -Xclang -fvalidate-ast-input-files-content -MD -MF other.pch.d"
    " -c other.h -o other.pch\n  depfile = other.pch.d\n  deps = gcc\ndefault other.pch\n";

export void test_build_step_cache_a_precompiled_header_is_compiled_again() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project a = project("a");
    defer scratch::clean(&a);
    scratch::Project b = project("b");
    defer scratch::clean(&b);
    scratch::own_cache(&a);
    test::check_condition(c::smith_core_plan_write(a.dir, ".smith/build.ninja", pch_manifest, 100));
    test::check_condition(c::smith_core_plan_write(b.dir, ".smith/build.ninja", pch_manifest, 100));
    const char *const depends[_] = {"other.pch: other.h", nullptr};
    c::SmithCoreStepCache step = {.plan = {.folder = a.dir, .manifest = ".smith/build.ninja", .depends = depends},
                                  .cache = a.cache};
    char *text = mem::alloc_slice(char, output_capacity).data;
    Usize ran = 0;
    Usize served = 0;
    step.plan.time = 1000;
    test::check_equal(c::smith_core_step_cache(&step, text, output_capacity, &ran, &served), true);
    scratch::expect_count("pch: the header compiles", 1, ran);
    step.plan.folder = b.dir; // the same header in another folder: a program that is served would be a hit
    test::check_equal(c::smith_core_step_cache(&step, text, output_capacity, &ran, &served), true);
    scratch::expect_count("pch: and compiles again in another folder", 1, ran);
    scratch::expect_count("pch: for it is not served", 0, served);
    put(a, "other.h", "int other(void);\n", 3000); // the same text, a new time
    step.plan.folder = a.dir;
    step.plan.time = 4000;
    test::check_equal(c::smith_core_step_cache(&step, text, output_capacity, &ran, &served), true);
    scratch::expect_count("pch: it compiles again after its header was rewritten", 1, ran);
    scratch::expect_count("pch: and is not served", 0, served);
}

export void test_build_step_cache_a_validated_precompiled_header_is_served() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project a = project("a");
    defer scratch::clean(&a);
    scratch::Project b = project("b");
    defer scratch::clean(&b);
    scratch::own_cache(&a);
    test::check_condition(c::smith_core_plan_write(a.dir, ".smith/build.ninja", pch_validated_manifest, 100));
    test::check_condition(c::smith_core_plan_write(b.dir, ".smith/build.ninja", pch_validated_manifest, 100));
    const char *const depends[_] = {"other.pch: other.h", nullptr};
    c::SmithCoreStepCache step = {.plan = {.folder = a.dir, .manifest = ".smith/build.ninja", .depends = depends},
                                  .cache = a.cache};
    char *text = mem::alloc_slice(char, output_capacity).data;
    Usize ran = 0;
    Usize served = 0;
    step.plan.time = 1000;
    test::check_equal(c::smith_core_step_cache(&step, text, output_capacity, &ran, &served), true);
    scratch::expect_count("pch: the header compiles", 1, ran);
    step.plan.folder = b.dir; // the same header in another folder: a program that is served would be a hit
    test::check_equal(c::smith_core_step_cache(&step, text, output_capacity, &ran, &served), true);
    scratch::expect_count("pch: and is served in another folder", 0, ran);
    scratch::expect_count("pch: for its inputs are hashed", 1, served);
    put(a, "other.h", "int other(void);\n", 3000); // the same text, a new time
    step.plan.folder = a.dir;
    step.plan.time = 4000;
    test::check_equal(c::smith_core_step_cache(&step, text, output_capacity, &ran, &served), true);
    scratch::expect_count("pch: it is served after its header was rewritten with the same text", 0, ran);
    scratch::expect_count("pch: from the cache", 1, served);
}

// 7. Objects restored from the cache are not older than their inputs: the next build has nothing to do (#816). The
// second folder's sources are newer than the results in the cache.
export void test_build_step_cache_a_restored_build_settles() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project a = project("a");
    defer scratch::clean(&a);
    scratch::Project b = project("b");
    defer scratch::clean(&b);
    scratch::own_cache(&a);
    Build first = build(a, a.cache, 1000);
    expect_counts("settle: the first folder compiles all three", 3, 0, &first);
    const char *names[5] = {"main.c", "util.c", "other.c", "util.h", "other.h"};
    const char *texts[5] = {"#include \"other.h\"\n#include \"util.h\"\nint main(void) { return 0; }\n",
                            "#include \"util.h\"\nint util(void) { return 1; }\n",
                            "#include \"other.h\"\nint other(void) { return 2; }\n", "int util(void);\n",
                            "int other(void);\n"};
    for (Usize i = 0; i < 5; i++) {
        put(b, names[i], texts[i], 2000);
    }
    Build second = build(b, a.cache, 3000);
    expect_counts("settle: the second folder is served all three", 0, 3, &second);
    Build third = build(b, a.cache, 4000);
    scratch::expect_contains("settle: and its next build has no work to do", third.text, "no work to do");
}

// 8. The cache's state is a set of file-scope buffers and a memo: a call leaves nothing for the next, so the same
// folder built again, and then another with a different cache, behave as in a process of their own.
export void test_build_step_cache_runs_twice_in_one_process() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project a = project("a");
    defer scratch::clean(&a);
    scratch::Project b = project("b");
    defer scratch::clean(&b);
    scratch::own_cache(&a);
    Build first = build(a, a.cache, 1000);
    expect_counts("twice: the first call compiles all three", 3, 0, &first);
    Build again = build(a, a.cache, 2000);
    scratch::expect_contains("twice: the second call finds the folder settled", again.text, "no work to do");
    const char *other_cache = format::push(a.root, "/second-cache").data;
    Build elsewhere = build(b, other_cache, 3000);
    expect_counts("twice: another cache holds nothing of the first", 3, 0, &elsewhere);
}

// ---------------------------------------------------------------- end to end

// A project with a cache of its own, which `sibling` projects share.
static scratch::Project made(const char *name) {
    scratch::Project p = scratch::make(name, "step_cache");
    scratch::own_cache(&p);
    return p;
}

// Another folder of the same fixture next to `a`, with a's cache; `a` removes both folders and frees the cache.
static scratch::Project sibling(const scratch::Project *a, const char *name) {
    scratch::Project p = *a;
    p.root = nullptr;
    p.dir = format::push(a->root, "/", name).data;
    scratch::copy_tree(&p, "tests/build_fixtures/step_cache", "");
    return p;
}

// `smith build release` with its progress lines kept.
static const char *built(const char *before) {
    return format::push("env SMITH_STEP_CACHE=1 ", before, "smith build release 2>&1").data;
}

// A hit is what a rebuild makes. This stays end to end: what a real compile writes is the real compiler's.
export void test_build_step_cache_a_hit_equals_a_rebuild() {
    scratch::Project a = made("a");
    defer scratch::clean(&a);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project b = sibling(&a, "b");
    (void)scratch::sh(&a, built(""));
    (void)scratch::sh(&b, built(""));
    (void)scratch::sh(&b,
                      "mkdir -p hit && cp build/release/*.o hit/ && rm -rf build .smith/.smith_log .smith/.smith_deps");
    scratch::Run forced = scratch::sh(&b, "SMITH_STEP_CACHE=0 smith build release 2>&1");
    scratch::expect_lacks("rebuild: the forced build uses no cache", forced.out, "(cached)");
    scratch::Run same = scratch::sh(&b, "for f in main other util; do cmp build/release/$f.o hit/$f.o || exit 1; done");
    scratch::expect_status("rebuild: a hit equals a rebuild", 0, &same);
}

// The build program (.smith/program, which a fresh project compiles from build.c and the embedded runtime) is served
// too: its compiles are -MD and its debug info names no folder, so a second folder with the same build file stores no
// result of its own. This stays end to end: the program is built by the verb from the embedded runtime, and
// SMITH_VERBOSE would show the compiles, but a compile that prints is never stored.
constexpr char results[_] = "find \"$XDG_CACHE_HOME/smith/steps/r\" -mindepth 2 -maxdepth 2 | wc -l | tr -d ' '";

export void test_build_step_cache_serves_the_build_program_to_a_second_folder() {
    scratch::Project a = made("a");
    defer scratch::clean(&a);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project b = sibling(&a, "b");
    (void)scratch::sh(&a, built(""));
    const char *first = scratch::capture(&a, results);
    scratch::expect_text("program: the first folder stores the program's compiles and the project's", "yes",
                         scratch::capture(&a, format::push("[ ", first, " -ge 10 ] && echo yes").data));
    (void)scratch::sh(&b, built(""));
    scratch::expect_text("program: the second folder stores nothing of its own", first, scratch::capture(&b, results));
    scratch::Run same = scratch::sh(&b, "cmp .smith/build-program/runtime.o ../a/.smith/build-program/runtime.o");
    scratch::expect_status("program: and its objects are the first's", 0, &same);
}

// A debug object holds no folder (the build gives its compiles -ffile-prefix-map=<folder>=., #1351), so the debug
// profile is shared by folders like release: the second folder's first build compiles nothing, and only the link runs.
// `smith dbg` still stops by file and line in an object the cache served and shows its source from any folder, because
// it maps `.` back to the project. This stays end to end: the flag and the debug info are the real compiler's.
export void test_build_step_cache_a_debug_build_is_shared_by_a_second_folder() {
    scratch::Project a = made("a");
    defer scratch::clean(&a);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Project b = sibling(&a, "b");
    (void)scratch::sh(&a, "env SMITH_STEP_CACHE=1 smith build -v >log.txt 2>&1");
    scratch::Run second = scratch::sh(&b, "env SMITH_STEP_CACHE=1 smith build -v >log.txt 2>&1");
    scratch::expect_status("debug: the second folder builds", 0, &second);
    scratch::expect_text("debug: its three compiles are served", "3",
                         scratch::capture(&b, "grep -c '(cached)' log.txt"));
    scratch::expect_contains("debug: and the link runs", scratch::read(&b, "log.txt"), "-o build/debug/b");
    scratch::expect_text("debug: the object holds no folder", "0",
                         scratch::capture(&b, "grep -c \"$PWD\" build/debug/main.o || true"));
    scratch::Run usable = scratch::sh(&b, "smith dbg --version >/dev/null 2>&1");
    if (usable.status != 0) {
        return; // a smith without lldb inside (the stage0) has nothing to debug with
    }
    scratch::Run stopped = scratch::sh(&b, "B=$PWD; cd / && smith dbg -b -o 'breakpoint set -f main.c -l 5' -o run -o "
                                           "'source list' \"$B/build/debug/b\" 2>&1");
    scratch::expect_contains("debug: stops at main.c:5 in a served object", stopped.out, "main.c:5");
    scratch::expect_contains("debug: and shows its source from another folder", stopped.out, "return util() + other()");
}

// A file that spells a time macro is never cached (its compile may differ at each run), so smith.o would be rebuilt in
// every worktree if a file smith.c includes spelled one (#1414). The cache's own scan therefore writes the names in
// pieces. The names are written in pieces here too, so this file passes its own rule.
export void test_build_step_cache_a_file_smith_c_includes_names_no_time_macro() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    env::Value repo = env::get("SMITH_REPO");
    const char *base = repo == .some ? repo.some.data : ".";
    const char *files[_] = {"smith.c", "runtime/executor_cache.c", "runtime/executor.c"};
    const char *names[_] = {"__TI"
                            "ME__",
                            "__DA"
                            "TE__",
                            "__TIMES"
                            "TAMP__"};
    for (Usize i = 0; i < countof(files); i++) {
        const char *text = corpus::read_file(&memory, format::push(base, "/", files[i]).data);
        test::check(text != nullptr);
        for (Usize k = 0; k < countof(names); k++)
            test::check(c::strstr(text, names[k]) == nullptr);
    }
}
