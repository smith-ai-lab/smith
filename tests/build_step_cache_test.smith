// The shared cache of compile steps (#621): a compile whose command and inputs another build has seen is not run, its
// outputs are cloned from <cache>/smith/steps. Each test has a cache of its own, shared by its projects. The projects
// are built `release`, but the one that builds the debug profile: a debug object names no folder (its debug info says
// `.` where it would say the folder, issue #621), so the second folder is served it too.
module build_step_cache_test;

import smith::format;
import smith::io;
import smith::test;
import scratch;

static scratch::Project made_from(io::Io *io, const char *name, const char *fixture) {
    scratch::Project p = scratch::project(io, name, fixture);
    scratch::own_cache(&p);
    return p;
}

static scratch::Project made(io::Io *io, const char *name) {
    return made_from(io, name, "step_cache");
}

// `smith build release` with its progress lines kept: the compiles it ran, and how many of them the cache served.
static const char *built(const scratch::Project *p, const char *before) {
    return format::push(&p->io->arena, "env SMITH_STEP_CACHE=1 ", before, "smith build release 2>&1").data;
}

static const char *count(const scratch::Project *p, const char *build, const char *pattern) {
    return scratch::capture(p, format::push(&p->io->arena, build, " | grep -c '", pattern, "'; true").data);
}

// 1. The second folder runs no compile, and its objects are the first's, byte for byte.
export void test_build_step_cache_a_second_folder_runs_no_compile(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::Project b = made(io, "b");
    scratch::expect_text("cache: the first folder compiles all three", "3",
                         count(&a, built(&a, ""), "^\\[[0-9/]*\\] compile [a-z]*[.]c$"));
    const char *second = built(&b, "");
    scratch::expect_text("cache: the second folder is served all three", "3", count(&b, second, "[.]c (cached)$"));
    scratch::Run same =
        scratch::sh(&b, "for f in main other util; do cmp build/release/$f.o ../a/build/release/$f.o || exit 1; done");
    scratch::expect_status("cache: its objects are the first's", 0, &same);
    scratch::expect_status("cache: and the program built from them runs", 0,
                           &(scratch::Run){.status = scratch::sh(&b, "build/release/b").status});
}

// 1b. The same for the debug profile: no folder is in the objects, so the second folder is served them too.
export void test_build_step_cache_a_debug_build_is_served_to_a_second_folder(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::Project b = made(io, "b");
    (void)scratch::sh(&a, "env SMITH_STEP_CACHE=1 smith build 2>&1");
    scratch::expect_text(
        "debug: the first folder's objects do not name it", "",
        scratch::capture(
            &a, format::push(&io->arena, "grep -c -a '", a.dir, "' build/debug/*.o | grep -v ':0$'; true").data));
    scratch::Run second = scratch::sh(&b, "env SMITH_STEP_CACHE=1 smith build 2>&1");
    scratch::expect_contains("debug: the second folder is served", second.out, "compile util.c (cached)");
    scratch::expect_lacks("debug: and compiles nothing", second.out, "compile main.c\n");
    scratch::Run same =
        scratch::sh(&b, "for f in main other util; do cmp build/debug/$f.o ../a/build/debug/$f.o || exit 1; done");
    scratch::expect_status("debug: its objects are the first's", 0, &same);
}

// 2. A header changed: the files that include it compile again, the others are up to date.
export void test_build_step_cache_a_changed_header_recompiles_its_includers(io::Io *io) {
    scratch::Project a = made(io, "a");
    (void)scratch::sh(&a, built(&a, ""));
    scratch::write(&a, "util.h", "int util(void);\nint more(void);\n");
    const char *again = built(&a, "");
    scratch::Run run = scratch::sh(&a, again);
    scratch::expect_contains("header: main.c, which includes it, compiles again", run.out, "compile main.c");
    scratch::expect_contains("header: and so does util.c", run.out, "compile util.c");
    scratch::expect_lacks("header: other.c does not", run.out, "other.c");
    scratch::expect_lacks("header: and neither is served, for the header is new", run.out, "(cached)");
    scratch::write(&a, "util.h", "int util(void);\n");
    scratch::Run back = scratch::sh(&a, built(&a, ""));
    scratch::expect_contains("header: the old header's compiles are served again", back.out, "compile util.c (cached)");
}

// 3. A hit is what a rebuild makes.
export void test_build_step_cache_a_hit_equals_a_rebuild(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::Project b = made(io, "b");
    (void)scratch::sh(&a, built(&a, ""));
    (void)scratch::sh(&b, built(&b, ""));
    (void)scratch::sh(&b,
                      "mkdir -p hit && cp build/release/*.o hit/ && rm -rf build .smith/.smith_log .smith/.smith_deps");
    scratch::Run forced = scratch::sh(&b, "SMITH_STEP_CACHE=0 smith build release 2>&1");
    scratch::expect_lacks("rebuild: the forced build uses no cache", forced.out, "(cached)");
    scratch::Run same = scratch::sh(&b, "for f in main other util; do cmp build/release/$f.o hit/$f.o || exit 1; done");
    scratch::expect_status("rebuild: a hit equals a rebuild", 0, &same);
}

// 4. The folder is a token in what is kept: the second folder's depfile log names its own files.
export void test_build_step_cache_the_second_folders_log_names_its_own_paths(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::Project b = made(io, "b");
    (void)scratch::sh(&a, built(&a, ""));
    scratch::Run second = scratch::sh(&b, built(&b, ""));
    scratch::expect_contains("paths: the second folder is served", second.out, "(cached)");
    scratch::expect_text(
        "paths: its depfile log holds nothing of the first folder", "0",
        scratch::capture(&b, format::push(&io->arena, "grep -c '", a.dir, "' .smith/.smith_deps; true").data));
    scratch::expect_text("paths: and it names the headers", "yes",
                         scratch::capture(&b, "grep -q '^util[.]h$' .smith/.smith_deps && echo yes"));
}

// 5. SMITH_STEP_CACHE=0 turns the cache off.
export void test_build_step_cache_can_be_turned_off(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::Project b = made(io, "b");
    (void)scratch::sh(&a, built(&a, ""));
    scratch::Run second = scratch::sh(&b, built(&b, "SMITH_STEP_CACHE=0 "));
    scratch::expect_lacks("off: nothing is served", second.out, "(cached)");
    scratch::expect_contains("off: the compiles run", second.out, "compile main.c");
}

// 6. The cap of the caches (SMITH_CACHE_MAX, #618) applies: over it, the least recently used results go at the next
// build's start, once an hour.
export void test_build_step_cache_results_over_the_cap_are_removed(io::Io *io) {
    scratch::Project a = made(io, "a");
    scratch::Project b = made(io, "b");
    (void)scratch::sh(&a, built(&a, ""));
    (void)scratch::sh(&a, "touch -d '2 hours ago' \"$XDG_CACHE_HOME/smith/steps/prune.timestamp\"");
    scratch::Run capped = scratch::sh(&b, built(&b, "SMITH_CACHE_MAX=1 "));
    scratch::expect_lacks("cap: nothing is left to serve", capped.out, "(cached)");
    scratch::expect_contains("cap: the compiles run", capped.out, "compile main.c");
}

// 7. A module project: the header of a module is a step of its own, keyed by the files the header pass read (its source
// and the sources of the modules it imports), so the second folder runs no header step and no compile, and the program
// it builds is the first's.
export void test_build_step_cache_a_second_folder_of_modules_runs_no_header_and_no_compile(io::Io *io) {
    scratch::Project a = made_from(io, "a", "step_cache_smith");
    scratch::Project b = made_from(io, "b", "step_cache_smith");
    const char *ran = "^\\[[0-9/]*\\] \\(header\\|compile\\) [^ ]*$";
    scratch::expect_text("modules: the first folder runs a header and three compiles", "4",
                         count(&a, built(&a, ""), ran));
    (void)scratch::sh(&b, "env SMITH_STEP_CACHE=1 smith build release >log 2>&1");
    scratch::expect_text("modules: the second folder runs neither", "0",
                         scratch::capture(&b, format::push(&io->arena, "grep -c '", ran, "' log; true").data));
    scratch::expect_text("modules: it is served the module's header", "1",
                         scratch::capture(&b, "grep -c 'header util[.]smith (cached)$' log; true"));
    scratch::expect_text("modules: and the compiles of both modules and of the handlers", "3",
                         scratch::capture(&b, "grep -c 'compile [^ ]* (cached)$' log; true"));
    scratch::expect_status(
        "modules: its header is the first's", 0,
        &(scratch::Run){.status = scratch::sh(&b, "cmp .smith/include/util.h ../a/.smith/include/util.h").status});
    scratch::expect_text("modules: and the program runs", "42", scratch::capture(&b, "build/release/b"));
}

// 8. A header served by the cache is a header written only when its bytes change: an edit to a module's body runs its
// header step (the source is a file it read) and leaves the header alone, so the importer is not compiled; the edit
// undone is served, and again nothing else runs.
export void test_build_step_cache_a_header_served_is_not_rewritten_when_it_is_the_same(io::Io *io) {
    scratch::Project a = made_from(io, "a", "step_cache_smith");
    (void)scratch::sh(&a, built(&a, ""));
    const char *stamp = "stat -c %y .smith/include/util.h 2>/dev/null || stat -f %m .smith/include/util.h";
    const char *before = scratch::capture(&a, stamp);
    scratch::sleep(&a, 1100);
    scratch::write(&a, "util.smith", "module util;\n\nexport int answer(void) {\n    return 43;\n}\n");
    scratch::Run edited = scratch::sh(&a, built(&a, ""));
    scratch::expect_contains("restat: the module's header step runs, for its source changed", edited.out,
                             "header util.smith\n");
    scratch::expect_lacks("restat: and its importer is not compiled", edited.out, "compile main.smith");
    scratch::expect_text("restat: the header is left alone", before, scratch::capture(&a, stamp));
    scratch::sleep(&a, 1100);
    scratch::write(&a, "util.smith", "module util;\n\nexport int answer(void) {\n    return 42;\n}\n");
    scratch::Run undone = scratch::sh(&a, built(&a, ""));
    scratch::expect_contains("restat: the first source's header is served", undone.out, "header util.smith (cached)");
    scratch::expect_lacks("restat: and the importer is still not compiled", undone.out, "compile main.smith");
    scratch::expect_text("restat: the header is left alone again", before, scratch::capture(&a, stamp));
}

// 9. -d explain says why a step is not served or not stored.
export void test_build_step_cache_explain_says_why_a_step_is_not_served(io::Io *io) {
    scratch::Project a = made_from(io, "a", "step_cache_smith");
    scratch::Run first = scratch::sh(&a, "env SMITH_STEP_CACHE=1 smith build release -d explain 2>&1");
    scratch::expect_contains("explain: a step with no manifest says so", first.out,
                             "util.h is not in the step cache: no manifest for this command and these inputs");
    scratch::expect_contains("explain: a step the cache does not cover says what is missing", first.out,
                             "is not cached: it has no depfile");
}
