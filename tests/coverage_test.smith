// Tests of coverage-based test selection (issue #456, runtime/coverage.c, knowledge/coverage-selection.md): the record
// of a test (`smith test --coverage merge`), the table (`join`), the report of changed lines no test ran (`report`),
// and `smith test --changed` reading records. The first and the verb's cases run a program built with
// `-fprofile-instr-generate -fcoverage-mapping` under the profile reader inside smith; the selection tests write the
// records by hand, in process, in a scratch folder (never this checkout).
// A test makes its project, then sets its own memory as the current allocator: what scratch returns to it (a Run's
// texts, a file it reads) is given back with that memory, and scratch::clean frees what make holds.
// smith-covers: smith.c runtime/build_runtime.c runtime/executor*.c runtime/slots.c runtime/lang*.c runtime/verbs.c
// smith-covers: runtime/cache.c runtime/sdk_cache.c runtime/platform_*.c runtime/quiet.c runtime/base.h
// smith-covers: runtime/changed.c runtime/coverage.c runtime/record.c runtime/symbolize.c shim/coverage.cpp
// smith-covers: shim/symbolize.cpp shim/clang.cpp shim/hook.cpp shim/lld.cpp include/smith/
// smith-covers: include/smith_core_changed.h include/smith_core_coverage.h
// smith.c is the core the in-process cases link and holds smith cc.
module coverage_test;

import std::files;
import std::format;
import std::arena;
import std::mem;
import std::test;
import scratch;
import <smith_core_changed.h>;
import <smith_core_coverage.h>;
import <string.h>;

constexpr Usize memory_size = (Usize)16 << 20; // 16 MiB
constexpr Usize report_capacity = 1U << 16;

// Exit status 77 (the test is skipped) for a smith with no LLVM inside (the stage0), which cannot read profiles.
constexpr char find_tools[_] = "smith symbolize --available || exit 77; ";

// A program with three functions on known lines; `prog` runs `first`, and `prog x` runs `second`. A repository when
// `commit` is true.
constexpr char program[_] =
    "static int first(int x) {\\n    return x + 1;\\n}\\nstatic int second(int x) {\\n    return x * 2;\\n}\\n"
    "int main(int argc, char **argv) {\\n    (void)argv;\\n    return (argc > 1 ? second(argc) : first(argc)) > "
    "100;\\n}\\n";

// Compiles the program with coverage and merges one record for each run named in `runs` ("one" runs first, "two"
// runs second), then joins them into cov/table.tsv.
static const char *make_table(const char *runs) {
    return format::push("set -e; r=$(pwd -P); printf '", program, "' > prog.c; ", find_tools,
                        "smith cc -fprofile-instr-generate -fcoverage-mapping \"$r/prog.c\" -o prog; "
                        "export SMITH_COVERAGE_DIR=$r/cov SMITH_COVERAGE_BINARY=$r/prog "
                        "SMITH_REPO=$r; mkdir -p cov/raw/t__one cov/raw/t__two; ",
                        runs,
                        "smith test --coverage join cov abc123 cov/table.tsv; "
                        "echo \"raw: $(find cov -name '*.profraw' | wc -l | tr -d ' ')\"; cat cov/table.tsv")
        .data;
}

constexpr char run_one[_] =
    "LLVM_PROFILE_FILE=$r/cov/raw/t__one/%p.profraw ./prog; smith test --coverage merge t::one; ";
constexpr char run_two[_] =
    "LLVM_PROFILE_FILE=$r/cov/raw/t__two/%p.profraw ./prog x; smith test --coverage merge t::two; ";

// Each test's record holds the functions it ran; the table lists the functions, the lines, and a bit for each; the raw
// profiles are gone.
export void test_a_record_is_the_functions_a_test_ran() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = scratch::sh(&p, make_table(format::push(run_one, run_two).data));
    if (run.status == 77) {
        test::note("coverage: skipped, this smith has no LLVM inside");
        return;
    }
    scratch::expect_status("the run", 0, &run);
    scratch::expect_contains("the profiles are deleted", run.out, "raw: 0");
    scratch::expect_contains("a function", run.out, "fn\tprog.c\t1\t3\tprog.c:first");
    scratch::expect_contains("main", run.out, "fn\tprog.c\t7\t10\tmain");
    scratch::expect_contains("the lines", run.out, "inst\tprog.c\t1-10");
    scratch::expect_contains("the first test ran first and main", run.out, "test\tt::one\t05");
    scratch::expect_contains("the second ran second and main", run.out, "test\tt::two\t06");
    scratch::expect_contains("the commit", run.out, "commit\tabc123");
}

// A changed line no test ran is reported, with the function it is in, and the totals are. In process
// (`smith_core_coverage_report`, include/smith_core_coverage.h): the table is the one the first test's record makes of
// the program above (a test that ran `first` and main), written by hand, and the added lines are given, so no compiler
// and no git start. The verb's wiring (`smith test --coverage report` reading git's diff) is the end to end case that
// follows.
export void test_the_report_names_the_changed_lines_no_test_ran() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *table = "smith-coverage 1\ncommit\tabc123\nfn\tprog.c\t1\t3\tprog.c:first\n"
                        "fn\tprog.c\t4\t6\tprog.c:second\nfn\tprog.c\t7\t10\tmain\n"
                        "inst\tprog.c\t1-10\ncov\tprog.c\t1-3,7-10\ntest\tt::one\t05\n";
    const c::SmithCoreChanged changed[_] = {{"prog.c", 5, 1}, {"prog.c", 2, 1}, {"other.c", 1, 3}};
    char *report = mem::alloc_slice(char, report_capacity).data;
    Bool done = c::smith_core_coverage_report(table, changed, countof(changed), report, report_capacity);
    test::check_equal(done, true);
    scratch::expect_contains("the totals", report, "coverage\tabc123\tlines\t7\t10\tfunctions\t2\t3");
    scratch::expect_contains("the uncovered line", report, "uncovered\tprog.c\t5\tprog.c:second");
    scratch::expect_lacks("a line a test ran", report, "uncovered\tprog.c\t2");
    scratch::expect_contains("the count", report, "changed\t2\t1");
    // Called again in the same process, the tables start empty.
    done = c::smith_core_coverage_report("smith-coverage 1\ncommit\tdef456\n", changed, countof(changed), report,
                                         report_capacity);
    test::check_equal(done, true);
    scratch::expect_contains("an empty table", report, "coverage\tdef456\tlines\t0\t0\tfunctions\t0\t0");
    scratch::expect_contains("nothing counted", report, "changed\t0\t0");
    done = c::smith_core_coverage_report("not a table", changed, countof(changed), report, report_capacity);
    test::check_equal(done, false);
}

// A table with more tests than the 6144 it keeps is refused (and says so on stderr), not read as its first 6144: the
// totals and the uncovered lines would be wrong with no sign (#604, audit E).
export void test_a_table_past_the_test_limit_is_refused() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    constexpr Usize head = 17; // "smith-coverage 1\n"
    constexpr Usize row = 10;  // "test\tt\t00\n"
    constexpr Usize rows = 6145;
    char *table = mem::alloc_slice(char, head + rows * row + 2).data;
    const char *first = "smith-coverage 1\n";
    mem::copy(table[0:head], first[0:head]);
    const char *one = "test\tt\t00\n";
    for (Usize i = 0; i < rows; i++)
        mem::copy(table[head + i * row:head + (i + 1) * row], one[0:row]);
    table[head + rows * row] = '\0';
    const c::SmithCoreChanged changed[_] = {{"prog.c", 5, 1}};
    char *report = mem::alloc_slice(char, report_capacity).data;
    Bool done = c::smith_core_coverage_report(table, changed, countof(changed), report, report_capacity);
    test::check_equal(done, false);
}

// The verb's wiring: `smith test --coverage report` reads git's diff from a base to HEAD and writes the file. A real
// repository and a program built with coverage are what a unit test cannot show.
export void test_the_report_verb_reads_git_diff() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *edit =
        "; git init -q -b main . && git add prog.c && git -c user.name=t -c user.email=t@t commit -q -m a "
        "&& sed 's/x \\* 2/x * 3/' prog.c > next.c && mv next.c prog.c && "
        "git -c user.name=t -c user.email=t@t commit -q -am b && "
        "smith test --coverage report cov/table.tsv HEAD~1 cov/report.txt; cat cov/report.txt";
    scratch::Run run = scratch::sh(&p, format::push(make_table(run_one), edit).data);
    if (run.status == 77) return;
    scratch::expect_status("the run", 0, &run);
    scratch::expect_contains("the totals", run.out, "coverage\tabc123\tlines\t");
    scratch::expect_contains("the uncovered line", run.out, "uncovered\tprog.c\t5\tprog.c:second");
    scratch::expect_contains("the count", run.out, "changed\t1\t1");
}

// ---- Selection by records
//
// In process (issue #646): `smith_core_coverage_record` writes the records a run under coverage would make and
// `smith_core_changed_select` selects, both on a scratch folder, so no compiler, no `merge`, no `smith test --changed`
// and no git start; the repository's file list and the changes are texts.

typedef struct {
    const char *path;
    const char *text;
} Source;

// A program of two functions (lines 2 to 4 and 5 to 7) and main (8 to 11), which includes a header.
constexpr char program_text[_] =
    "#include \"helper.h\"\nstatic int first(int x) {\n    return x + 1;\n}\nstatic int second(int x) {\n    return x "
    "* 2;\n}\nint main(int argc, char **argv) {\n    (void)argv;\n    return (argc > 1 ? second(argc) : first(argc)) "
    "> 100;\n}\n";

// The repository: a module of three tests that run smith, a pure test, and runtime/prog.c with its header.
// `runs_test::a` ran the first function and main and `runs_test::b` the second and main, each recorded; `runs_test::c`
// has no record.
constexpr Source repository[_] = {
    {".gitignore", ".smith\n"},
    {"build.c", "// a build with its own test task\n"},
    {"tests/runs_test.smith", "module runs_test;\nimport scratch;\nexport void test_a() { scratch::sh(); }\n"
                              "export void test_b() { scratch::sh(); }\nexport void test_c() { scratch::sh(); }\n"},
    {"tests/scratch.smith", "module scratch;\n"},
    {"lib/pure_test.smith", "module pure_test;\nexport void test_p() {}\n"},
    {"runtime/prog.c", program_text},
    {"runtime/helper.h", "#define K 1\n"},
};

static void write(const char *folder, Source file) {
    const char *path = format::push(folder, "/", file.path).data;
    const char *slash = c::strrchr(path, '/');
    files::DoneResult made = files::make_folder(path[0:(Usize)(slash - path)]);
    test::check_condition(made == .ok);
    const U8 *bytes = (const U8 *)file.text;
    files::CountResult written =
        files::write_file(path[0:c::strlen(path)], bytes[0:c::strlen(file.text)], files::Replace);
    test::check_condition(written == .ok);
}

static void record(const char *folder, const char *test, Bool pass, const c::SmithCoreFunction *ran, Usize count) {
    test::check_equal(c::smith_core_coverage_record(folder, test, pass, ran, count), true);
}

// What `smith test --changed --base HEAD --dry-run` prints after the files `edits` are written over the repository
// (and `changes` happened: `A`, `M` or `D`, a tab and a path a line). `records` makes the records of a and b first;
// `result` is what a's run was.
static const char *selected(Bool records, const char *result, const Source *edits, Usize count, const char *changes) {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    const char *names = "";
    for (Usize i = 0; i < countof(repository); i++) {
        write(p.dir, repository[i]);
        names = format::push(names, repository[i].path, "\n").data;
    }
    if (records) {
        const c::SmithCoreFunction first_run[_] = {{"runtime/prog.c", "first", 2, 4},
                                                   {"runtime/prog.c", "main", 8, 11}};
        const c::SmithCoreFunction second_run[_] = {{"runtime/prog.c", "second", 5, 7},
                                                    {"runtime/prog.c", "main", 8, 11}};
        record(p.dir, "runs_test::a", c::strcmp(result, "pass") == 0, first_run, countof(first_run));
        record(p.dir, "runs_test::b", true, second_run, countof(second_run));
    }
    for (Usize i = 0; i < count; i++) {
        write(p.dir, edits[i]);
        Bool known = false;
        for (Usize j = 0; j < countof(repository); j++)
            known = known || c::strcmp(repository[j].path, edits[i].path) == 0;
        if (!known) names = format::push(names, edits[i].path, "\n").data;
    }
    char *out = mem::alloc_slice(char, report_capacity).data;
    test::check_equal(c::smith_core_changed_select(p.dir, names, changes, out, report_capacity), true);
    return out;
}

static const char *changed_program(const char *result, const char *text) {
    const Source edit[_] = {{"runtime/prog.c", text}};
    return selected(true, result, edit, countof(edit), "M\truntime/prog.c");
}

// A change inside a function selects the tests that ran it, and the test with no record, and not the others.
export void test_a_change_selects_the_tests_that_ran_it() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *out = changed_program(
        "pass", "#include \"helper.h\"\nstatic int first(int x) {\n    return x + 1;\n}\nstatic int second(int x) {\n"
                "    return x * 3;\n}\nint main(int argc, char **argv) {\n    (void)argv;\n    return (argc > 1 ? "
                "second(argc) : first(argc)) > 100;\n}\n");
    scratch::expect_contains("the test that ran it", out, "its record is stale: runs_test::b");
    scratch::expect_contains("the filter", out, "runs_test::b,runs_test::c");
    scratch::expect_lacks("the other", out, "runs_test::a");
    scratch::expect_lacks("a test that does not run smith", out, "pure_test");
}

// A function that moved but did not change is the same function, and a comment outside the functions changes nothing.
export void test_a_moved_function_and_a_comment_change_nothing() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *out = changed_program("pass", format::push("// a comment\n\n", program_text, "// the end\n").data);
    scratch::expect_lacks("a", out, "runs_test::a");
    scratch::expect_lacks("b", out, "runs_test::b");
    scratch::expect_contains("only the test with no record", out, "no record of runs_test::c");
}

// Code outside the functions (a global) reruns every test that ran the file.
export void test_a_global_reruns_the_tests_that_ran_the_file() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *out = changed_program("pass", format::push(program_text, "int g = 1;\n").data);
    scratch::expect_contains("a", out, "code outside functions changed");
    scratch::expect_contains("a", out, "runs_test::a");
    scratch::expect_contains("b", out, "runs_test::b");
    scratch::expect_contains("c", out, "runs_test::c");
}

// A test that failed last time reruns whatever changed.
export void test_a_failed_test_reruns() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *out = changed_program("fail", format::push(program_text, "// x\n").data);
    scratch::expect_contains("it failed", out, "it failed last time");
    scratch::expect_contains("the filter", out, "runs_test::a");
}

// A changed file that no record names and no file imports is unknown: every test runs.
export void test_a_file_nothing_places_selects_every_test() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const Source added[_] = {{"runtime/new.c", "int z(void);\n"}};
    const char *out = selected(true, "pass", added, countof(added), "A\truntime/new.c");
    scratch::expect_contains("the message", out, "runtime/new.c is named by no record and no file imports it");
    scratch::expect_contains("every test", out, "every test runs");
}

// A changed header an executed file includes is a record of its own (#638): its code outside functions moved, so the
// tests that ran the program are stale.
export void test_a_file_the_graph_places_selects_the_tests_built_from_it() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const Source header[_] = {{"runtime/helper.h", "#define K 2\n"}};
    const char *out = selected(true, "pass", header, countof(header), "M\truntime/helper.h");
    scratch::expect_contains("the reason", out, "code outside functions changed");
    scratch::expect_contains("a", out, "runs_test::a");
    scratch::expect_contains("b", out, "runs_test::b");
    scratch::expect_contains("c", out, "runs_test::c");
}

// Without records the graph decides, and the message says so.
export void test_no_records_means_the_graph_decides() {
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const Source edit[_] = {{"runtime/prog.c", "int g;\n"}};
    const char *out = selected(false, "pass", edit, countof(edit), "M\truntime/prog.c");
    scratch::expect_contains("the reason", out, "no records of tests");
    scratch::expect_contains("the graph's choice", out, "tests/runs_test.smith: it runs smith");
}

// A file that imports std::arena and then declares a variable with an initializer compiles with the record build's
// coverage flags (#845): the import's unused function over types is in the buffer `<smith-types>`, and a buffer with
// no place in the main file left the coverage mapping of that function looping for good.
export void test_a_file_with_an_import_and_a_variable_compiles_with_coverage() {
    scratch::Project p = scratch::make("p", "coverage_types");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run =
        scratch::sh(&p, "smith build >/dev/null 2>&1; smith cc -fprofile-instr-generate -fcoverage-mapping -std=gnu2y "
                        "-I .smith/include -I . -c main.smith -o main.o");
    scratch::expect_status("coverage: the compile finishes", 0, &run);
}

// An indexed for-each over a slice (`for (Usize i, T x : xs)`) once made its object's coverage map malformed, so a
// test that linked it made no record (issue #1008, std::process's vector_make). A program with one runs, and its
// record is made.
export void test_an_indexed_for_each_makes_a_record() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = scratch::sh(
        &p, format::push(
                "set -e; r=$(pwd -P); ", find_tools,
                "printf 'module main;\\nI32 sum(I32 xs[:]) {\\n    I32 total = 0;\\n    for (Usize i, I32 x : xs) {\\n"
                "        total += (I32)i + x;\\n    }\\n    return total;\\n}\\n"
                "I32 main() {\\n    I32 xs[3] = {1, 2, 3};\\n    return sum(xs) > 100;\\n}\\n' > main.smith; "
                "smith cc -fprofile-instr-generate -fcoverage-mapping -c main.smith -o prog.o; "
                "smith cc -fprofile-instr-generate -fcoverage-mapping prog.o -o prog; "
                "export SMITH_COVERAGE_DIR=$r/cov SMITH_COVERAGE_BINARY=$r/prog.o SMITH_REPO=$r; "
                "mkdir -p cov/raw/t__one; ",
                run_one, "echo \"raw: $(find cov -name '*.profraw' | wc -l | tr -d ' ')\"")
                .data);
    if (run.status == 77) {
        test::note("coverage: skipped, this smith has no LLVM inside");
        return;
    }
    scratch::expect_status("the run", 0, &run);
    scratch::expect_lacks("no malformed data", run.err, "malformed");
    scratch::expect_contains("the profile is merged and deleted", run.out, "raw: 0");
}

// A second merge of a test finds its raw profiles deleted by the first: it says so, naming the folder it looked in,
// and keeps the record (issue #1161).
export void test_a_repeated_merge_says_no_raw_profile_was_found() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = scratch::sh(
        &p, format::push(make_table(run_one), "; smith test --coverage merge t::one 2>&1; ls cov/rec").data);
    if (run.status == 77) {
        test::note("coverage: skipped, this smith has no LLVM inside");
        return;
    }
    scratch::expect_status("the run", 0, &run);
    scratch::expect_contains("it names the folder", run.out, "no raw profile for t::one in ");
    scratch::expect_contains("it names the folder", run.out, "cov/raw/t__one");
    scratch::expect_contains("the record stays", run.out, "t__one.rec");
}
