// `smith prove` across calls and pointers, from sections 7c to 7f of tests/prove.sh (issue #292): what a caller assumes
// of the memory a callee wrote, a const pointer, a returned pointer, sources of different -O, the smith_requires of an
// inlined function, `static` array parameters, aliasing and `restrict` (checked at the call, on arrays and on slices
// and grids in .smith), structs by value and through sret, a file that does not compile and a variable argument list.
// The programs are tests/prove/*.c and tests/prove/geometry/*.smith ($c); the helpers are in tests/prove_cases.smith.
// See tests/prove_test.smith for the proofs' cache and budget.
module prove_memory_test;

import std::arena;
import std::format;
import std::mem;
import std::test;
import scratch;
import prove_cases;

// The fixture with tests/prove copied in, made before the test's arena is the current allocator: scratch::clean,
// deferred first, runs after the allocator is put back and frees what make holds (issue #240).
static scratch::Project fresh() {
    scratch::Project p = scratch::make("p", "prove_cases");
    scratch::copy_tree(&p, "tests/prove", "cases");
    return p;
}

// `smith prove args -- -I include`, both streams together.
static scratch::Run prove(const scratch::Project *p, const char *args) {
    return prove_cases::prove(p, args);
}

static scratch::Run proved(const scratch::Project *p, const char *name, const char *args) {
    scratch::Run run = prove(p, args);
    scratch::expect_status(name, 0, &run);
    return run;
}

static scratch::Run refuted(const scratch::Project *p, const char *name, const char *args) {
    scratch::Run run = prove(p, args);
    scratch::expect_status(name, 1, &run);
    return run;
}

static void has(const char *name, const scratch::Run *run, const char *needle) {
    scratch::expect_contains(name, run->out, needle);
}

// A function that fails at a line of a file: `--function=F file`, status 1, the needle in the output.
static void fails_at(const char *name, const char *args, const char *needle) {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = refuted(&p, name, args);
    has(name, &run, needle);
}

// 7c. A caller assumes the callee's smith_ensures about the memory the callee wrote (issue #41), and nothing else.
export void test_prove_memory_what_the_callee_promises_is_assumed() {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    prove_cases::each_proved(&p, "memory: the callee's promises are assumed", "\"$c/memory.c\"", "",
                             "five set_five three_then_bump bump two push two_through_a_pointer "
                             "uses_bump_twice_read bump_twice_read");
}

export void test_prove_memory_a_caller_that_wants_more_than_the_callee_promises_fails() {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = refuted(&p, "memory: a caller that wants more than the callee promises fails",
                               "--function=too_much \"$c/memory.c\"");
    has("memory: ... at its own smith_ensures", &run, "memory.c:47: smith_ensures(value == 4) may be false");
    has("memory: ... with a value the callee allows", &run, "counterexample: value = ");
}

export void test_prove_memory_relying_on_what_the_callee_does_not_promise_fails_with_a_value() {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *names = "relies_on_the_body clobbered_local clobbered_parameter";
    prove_cases::each_refuted(&p, "memory: they fail with a counterexample", "\"$c/memory.c\"", "", "may be false",
                              names);
    prove_cases::each_refuted(&p, "memory: ... that is a value", "\"$c/memory.c\"", "", "first = ", names);
    prove_cases::each_value_counterexample(&p, "memory: ... not poison and not undefined behaviour", "\"$c/memory.c\"",
                                           names);
}

