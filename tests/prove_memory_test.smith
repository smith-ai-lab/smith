export void test_prove_by_value_a_wrong_promise_about_the_fields_fails_and_is_not_poison() {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run =
        refuted(&p, "by value: a wrong promise about the fields fails", "--function=same_row \"$c/by_value.c\"");
    has("by value: ... as a promise that may be false", &run,
        "by_value.c:30: smith_ensures(move.row == move.dest_row) may be false");
    scratch::expect_lacks("by value: the counterexample is not poison", run.out, "poison");
    scratch::expect_lacks("by value: ... and not undefined behaviour", run.out, "undefined behaviour");
}

// 7d2. A struct returned through sret is translated (issue #74): the function, its caller, and a wrong promise.
export void test_prove_sret_the_function_its_caller_and_its_reader_are_proved() {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    prove_cases::each_proved(&p, "sret: make_wide use_wide wide_from are proved", "\"$c/sret.c\"", "",
                             "make_wide use_wide wide_from");
}

export void test_prove_sret_a_wrong_promise_about_the_result_fails() {
    fails_at("sret: a wrong promise about the result fails", "--function=wrong_wide \"$c/sret.c\"",
             "sret.c:34: smith_ensures(wide.b == 1) may be false");
}

// 7e. A file that does not compile is an error with clang's message, never "nothing to prove".
export void test_prove_compile_error_fails_with_clangs_message_and_is_not_nothing_to_prove() {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write(&p, "syntax_error.c", "#include <smith/contract.h>\nint f(int x) { return x +; }\n");
    scratch::Run run = refuted(&p, "compile error: fails", "syntax_error.c");
    has("compile error: ... with clang's message", &run, "syntax_error.c:2:26: error: expected expression");
    scratch::expect_lacks("compile error: is not nothing to prove", run.out, "nothing to prove");
}

export void test_prove_compile_error_in_the_second_file_fails() {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write(&p, "syntax_error.c", "#include <smith/contract.h>\nint f(int x) { return x +; }\n");
    refuted(&p, "compile error: in the second file fails", "\"$c/memory.c\" syntax_error.c");
}

export void test_prove_missing_file_fails_and_names_it() {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = refuted(&p, "missing file: fails", "does-not-exist.c");
    has("missing file: ... and names it", &run, "does-not-exist.c");
}

// 7f. A function with a variable argument list does not stop the others; calling it is an error that says so.
export void test_prove_varargs_another_function_is_proved() {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    proved(&p, "varargs: another function is proved", "--function=twice \"$c/varargs.c\"");
}

export void test_prove_varargs_calling_one_is_an_error_that_names_the_call() {
    fails_at("varargs: calling one is an error", "--function=uses_sum \"$c/varargs.c\"",
             "varargs.c:25: cannot be proved: a call of sum, which takes a variable argument list");
}
