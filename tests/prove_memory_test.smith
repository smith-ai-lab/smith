    defer mem::set_allocator(outside);
    prove_cases::each_refuted(
        &p, "alias: same_type signed_unsigned member other_struct fail, since their pointers may overlap, on the claim",
        "\"$c/alias.c\"", "", "smith_ensures(", "same_type signed_unsigned member other_struct");
}

