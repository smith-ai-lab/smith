// 7c2d. A program whose sources compile with different optimization levels is proved as one unit (#74: learner's hot
// sources have -O2, the others none, and a caller could not see the body of a callee in the other group).
export void test_prove_levels_a_caller_of_a_source_with_another_o_is_proved_against_its_body() {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = scratch::sh(&p, "cd levels && smith prove -v 2>&1");
    scratch::expect_status("levels: a caller of a source with another -O is proved", 0, &run);
    has("levels: ... against the other source's body", &run, "ok    twice  (");
}

