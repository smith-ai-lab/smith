    defer mem::set_allocator(outside);
    prove_cases::each_proved(&p, "restrict slice: apart apart_arrays apart_slices reads pointer_apart are proved",
                             "\"$c/geometry/restrict_slices.smith\"",
                             "geometry::restrict_slices::", "apart apart_arrays apart_slices reads pointer_apart");
}

static void restrict_slice_fails(const char *function, const char *line, const char *callee) {
    scratch::Project p = fresh();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *name = format::push("restrict slice: ", function, " fails").data;
    scratch::Run run = refuted(
        &p, name,
        format::push("--function=geometry::restrict_slices::", function, " \"$c/geometry/restrict_slices.smith\"")
            .data);
    has(format::push(name, " at the call, naming both").data, &run,
        format::push("restrict_slices.smith:", line, ": the call of geometry::restrict_slices::", callee, " passes `")
            .data);
}

