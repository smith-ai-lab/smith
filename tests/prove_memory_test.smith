        refuted(&p, name, format::push("--function=geometry::grids::", function, " \"$c/geometry/grids.smith\"").data);
    has(format::push(name, " at the line of the index").data, &run,
        format::push("grids.smith:", line, ": assert(an index or a slice is in range) may fail").data);
}

