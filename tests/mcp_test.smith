// Tests of `smith mcp` (issue #22, knowledge/mcp-server.md; from tests/mcp.sh), in two halves.
//
// 1. The server on the fake io (tests/mcp_fake.c, a fixture program): a scripted client on the console and a scripted
//    `smith dap` child, in one process, built in three ways (-O0 under AddressSanitizer and UBSan, -O2, and -O2
//    -DNDEBUG). This half needs only a C compiler and runs for the stage0 too.
// 2. The server as `smith mcp`, a real adapter and real programs (the folders of tests/build_fixtures/mcp), driven by
//    lines on its standard input: a C program, a .smith program (its names as written), and a test of a project
//    launched by its name. It launches processes under a debugger, so it needs a smith with lldb inside and the
//    Developer Tools permission (knowledge/debugger.md); without them these tests do nothing.
module mcp_test;

import std::arena;
import std::format;
import std::mem;
import std::test;
import scratch;

// The pieces one after another, from the current allocator (the test's arena).
const char *concatenated(auto... pieces) {
    Usize length = format::length(pieces...);
    char *text = mem::alloc_slice(char, length + 1).data;
    (void)format::to(text, length + 1, pieces...);
    return text;
}

// A folder of the project as a project of its own; the root's `clean` removes it.
static scratch::Project folder(const scratch::Project *root, const char *name) {
    scratch::Project f = *root;
    f.dir = concatenated(root->dir, "/", name);
    return f;
}

// --- the server on the fake io ---------------------------------------------------------------------------------------

constexpr char fake_sources[_] =
    "tests/mcp_fake.c lib/std/text.smith lib/std/arena.smith lib/std/contract.smith runtime/io.smith "
    "lib/std/random.smith lib/std/math.smith lib/std/mem.smith lib/handlers.c";

// The generated protocol code (.smith/protocol/dap.c and mcp.c, 6 s of CPU at -O2, more than half of the file's
// compile) does not depend on NDEBUG (it holds no assertion), so the two optimized builds link the same two objects.
// They are compiled once for each smith under test and each version of the files, in the tests' cache
// ($SMITH_TEST_CACHE/mcp-proto-<key>, locked the way `build_project` below is): the first test to need them compiles
// them, the other waits. The sanitized build compiles all of it in its own translation unit, as the file is without
// -DMCP_FAKE_PROTOCOL_LINKED.
constexpr char proto_flags[_] = "-std=gnu23 -O2 -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Werror";

constexpr char proto_script[_] =
    "inc=\"-I $SMITH_REPO/.smith/include -I $SMITH_REPO/.smith/protocol -I runtime/protocol\"; "
    "if [ \"$(uname -s)\" = Darwin ]; then sf='-f %m-%z'; else sf='-c %Y-%s'; fi; "
    "key=$( { echo \"$flags $inc\" | cksum; stat $sf \"$SMITH_SELF\" \"$SMITH_REPO\"/.smith/protocol/dap.[ch] "
    "\"$SMITH_REPO\"/.smith/protocol/mcp.[ch] \"$SMITH_REPO\"/runtime/protocol/protocol.h; } | tr '\\n ' --); "
    "base=$SMITH_TEST_CACHE/mcp-proto-$key; "
    "if [ ! -e \"$base/done\" ] && mkdir \"$base.lock\" 2>/dev/null; then "
    "find \"$SMITH_TEST_CACHE\" -maxdepth 1 -name 'mcp-proto-*' -mtime +1 -exec rm -rf {} + 2>/dev/null; "
    "tmp=$base.$$; mkdir -p \"$tmp\" && smith cc $flags $inc -c \"$SMITH_REPO/.smith/protocol/dap.c\" -o "
    "\"$tmp/dap.o\" "
    "&& smith cc $flags $inc -c \"$SMITH_REPO/.smith/protocol/mcp.c\" -o \"$tmp/mcp.o\" && mkdir -p \"$base\" && "
    "mv \"$tmp/dap.o\" \"$tmp/mcp.o\" \"$base/\" && : >\"$base/done\"; rm -rf \"$tmp\"; rmdir \"$base.lock\"; "
    "else i=0; while [ ! -e \"$base/done\" ] && [ -d \"$base.lock\" ] && [ $i -lt 3000 ]; do sleep 0.2; "
    "i=$((i + 1)); done; fi; "
    "[ -e \"$base/done\" ] && cp \"$base/dap.o\" \"$base/mcp.o\" .";

static void check_fake(const char *mode, const char *flags, bool linked) {
    scratch::Project p = scratch::make("fake", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, "lib", "lib");
    scratch::copy_tree(&p, "tests/mcp_fake.c", "tests/mcp_fake.c");
    scratch::copy_tree(&p, "runtime", "runtime");
    if (linked) {
        scratch::Run objects = scratch::sh(&p, concatenated("flags='", proto_flags, "'; ", proto_script, " 2>&1"));
        if (objects.status != 0) {
            test::note("%s", objects.out);
        }
        scratch::expect_status(concatenated("fake io, ", mode, ": the protocol objects build"), 0, &objects);
    }
    scratch::Run built =
        scratch::sh(&p, concatenated("smith cc -std=gnu23 -Wall -Wextra -Wpedantic -Wshadow -Wconversion -Werror ",
                                     flags, linked ? " -DMCP_FAKE_PROTOCOL_LINKED dap.o mcp.o" : "",
                                     " -I \"$SMITH_REPO/.smith/include\" -I \"$SMITH_REPO/.smith/protocol\" -I "
                                     "runtime/protocol ",
                                     fake_sources, " -o mcp_fake 2>build.log"));
    if (built.status != 0) {
        test::note("%s", scratch::read(&p, "build.log"));
    }
    scratch::expect_status(concatenated("fake io, ", mode, ": tests/mcp_fake.c builds"), 0, &built);
    scratch::Run ran = scratch::sh(&p, "./mcp_fake 2>&1");
    scratch::expect_status(concatenated("fake io, ", mode, ": the fake io's checks pass"), 0, &ran);
    scratch::expect_contains(concatenated("fake io, ", mode, ": the last line"), ran.out, " checks, 0 failed");
}

export void test_mcp_fake_io_under_the_sanitizers() {
    check_fake("asan", "-g -O0 -fsanitize=address,undefined -fno-sanitize-recover=all", false);
}

export void test_mcp_fake_io_optimized() {
    check_fake("fast", "-O2", true);
}

export void test_mcp_fake_io_optimized_without_assertions() {
    check_fake("ndebug", "-O2 -DNDEBUG", true);
}

// --- the stage0 -----------------------------------------------------------------------------------------------------

constexpr char clang_inside[_] =
    "[ \"$(smith cc --smith-which -c a.c | head -n 1 | cut -d ' ' -f 1,2)\" = 'clang in-process' ]";

export void test_mcp_the_stage0_says_smith_mcp_needs_the_full_smith() {
    scratch::Project p = scratch::make("stage0", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (scratch::sh(&p, clang_inside).status == 0) {
        return;
    }
    scratch::Run run = scratch::sh(&p, "smith mcp </dev/null 2>&1");
    scratch::expect_contains("the stage0 says smith mcp needs the full smith", run.out, "mcp needs the full smith");
    scratch::expect_failure("the stage0 exits with a failure", &run);
}

// --- the connection, with the real binary
// -----------------------------------------------------------------------------

export void test_macos_mcp_the_connection_discover_initialize_and_tools() {
    scratch::Project root = scratch::make("mcp", "mcp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (scratch::sh(&root, clang_inside).status != 0) {
        return;
    }
    scratch::Run run = scratch::sh(&root, "smith mcp <hello.jsonl >hello.out 2>hello.err");
    scratch::expect_status("smith mcp exits 0 when its input ends", 0, &run);
    scratch::expect_text("smith mcp writes nothing to stderr", "", scratch::read(&root, "hello.err"));
    scratch::expect_text("every line of stdout is a JSON message", "0",
                         scratch::capture(&root, "grep -vc '^{\"' hello.out"));
    scratch::expect_text("three answers for three requests", "3",
                         scratch::capture(&root, "wc -l <hello.out | tr -d ' '"));
    scratch::expect_contains("server/discover supports 2026-07-28",
                             scratch::capture(&root, "grep '^{\"id\":1,' hello.out"),
                             "\"supportedVersions\":[\"2026-07-28\"]");
    scratch::expect_contains("initialize gives the version asked",
                             scratch::capture(&root, "grep '^{\"id\":2,' hello.out"),
                             "\"protocolVersion\":\"2025-11-25\"");
    const char *tools = scratch::capture(&root, "grep '^{\"id\":3,' hello.out");
    const char *names[11] = {"launch", "breakpoint", "continue",  "step_over", "step_in", "step_out",
                             "pause",  "stack",      "variables", "evaluate",  "stop"};
    for (Usize i = 0; i < 11; i++) {
        scratch::expect_contains(concatenated("tools/list has ", names[i]), tools,
                                 concatenated("\"name\":\"", names[i], "\""));
    }
}

// --- can this account debug?
// ------------------------------------------------------------------------------------------

// The C program of the fixture built. False when this smith has no clang or lldb inside, or the account may not debug.
static bool can_debug(const scratch::Project *root) {
    if (scratch::sh(root, clang_inside).status != 0 ||
        scratch::sh(root, "smith dbg --version >/dev/null 2>&1").status != 0) {
        return false;
    }
    scratch::Project c = folder(root, "c");
    scratch::Run built = scratch::sh(&c, "smith cc -g -O0 prog.c -o prog");
    scratch::expect_status("prog.c builds", 0, &built);
    const char *probe = scratch::sh(&c, "smith dbg -b -o 'b prog.c:10' -o run -o 'frame variable sum' prog 2>&1").out;
    return !scratch::contains(probe, "Developer Tools") && !scratch::contains(probe, "not allowed") &&
           !scratch::contains(probe, "timed out") && !scratch::contains(probe, "unable to attach");
}

// One line of calls: a request of the tool `tool` with the JSON `arguments`, as id `id`.
static const char *call(const char *jsonl, const char *id, const char *tool, const char *arguments) {
    return concatenated(jsonl, "{\"jsonrpc\":\"2.0\",\"id\":", id, ",\"method\":\"tools/call\",\"params\":{\"name\":\"",
                        tool, "\",\"arguments\":", arguments, "}}\n");
}

// Writes the calls, runs `smith mcp` on them and leaves the text of each answer in r<id>.txt (for the ids 1 to
// `count`).
static scratch::Run serve(const scratch::Project *p, const char *calls, const char *count) {
    scratch::write(p, "in.jsonl", calls);
    scratch::Run run = scratch::sh(p, "smith mcp <in.jsonl >out.jsonl 2>err.txt");
    scratch::Run replies = scratch::sh(p, concatenated(". ../reply; i=1; while [ $i -le ", count,
                                                       " ]; do reply out.jsonl $i >r$i.txt; i=$((i + 1)); done"));
    scratch::expect_status("the answers are read", 0, &replies);
    return run;
}

static const char *answer(const scratch::Project *p, const char *id) {
    return scratch::read(p, concatenated("r", id, ".txt"));
}

// --- a C program
// ------------------------------------------------------------------------------------------------------

export void test_macos_mcp_a_c_program_session() {
    scratch::Project root = scratch::make("mcp", "mcp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!can_debug(&root)) {
        return;
    }
    scratch::Project p = folder(&root, "c");
    const char *calls = "";
    calls = call(calls, "1", "launch", "{\"program\":\"prog\",\"breakpoints\":[{\"file\":\"prog.c\",\"line\":10}]}");
    calls = call(calls, "2", "stack", "{}");
    calls = call(calls, "3", "variables", "{\"frame\":1,\"depth\":2}");
    calls = call(calls, "4", "evaluate", "{\"expression\":\"p.x + p.y\"}");
    calls = call(calls, "5", "evaluate", "{\"expression\":\"sum = 9\"}");
    calls = call(calls, "6", "breakpoint", "{\"file\":\"prog.c\",\"line\":17,\"condition\":\"r == 7\"}");
    calls = call(calls, "7", "step_out", "{}");
    calls = call(calls, "8", "step_over", "{}");
    calls = call(calls, "9", "continue", "{}");
    calls = call(calls, "10", "stack", "{}");
    calls = call(calls, "11", "continue", "{}");
    calls = call(calls, "12", "continue", "{}");
    calls = call(calls, "13", "stop", "{}");
    calls = call(calls, "14", "stack", "{}");
    serve(&p, calls, "14");
    scratch::expect_text("a C session: nothing on stderr", "", scratch::read(&p, "err.txt"));
    scratch::expect_text("a C session: every line of stdout is a JSON message", "0",
                         scratch::capture(&p, "grep -vc '^{\"' out.jsonl"));
    scratch::expect_text(
        "launch runs to the breakpoint",
        "session s1: DIR/c/prog\nbreakpoint 1: prog.c:10 (verified)\nstopped: breakpoint (breakpoint 1)\n"
        "  #0 add prog.c:10\n  > 10:     return sum;",
        answer(&p, "1"));
    scratch::expect_contains("stack has the caller", answer(&p, "2"), "#0 add prog.c:10\n#1 main prog.c:15");
    scratch::expect_text("variables of the caller's frame, with the struct opened",
                         "frame #1, scope locals\np (Point)\n  x = 3 (int)\n  y = 4 (int)\nr = 1 (int)",
                         scratch::capture(&p, "sed 's/^r = [0-9-]* (int)/r = 1 (int)/' r3.txt"));
    scratch::expect_text("evaluate reads", "p.x + p.y = 7 (int)", answer(&p, "4"));
    scratch::expect_contains("an assignment is refused", answer(&p, "5"),
                             "refused: the expression may change the program");
    scratch::expect_text("a conditional breakpoint", "breakpoint 2: prog.c:17 if r == 7 (verified)", answer(&p, "6"));
    scratch::expect_text("step_out returns to the caller's line",
                         "stopped: step\n  #0 main prog.c:15\n  > 15:     int r = add(p);", answer(&p, "7"));
    scratch::expect_contains("step_over moves to the next line", answer(&p, "8"), "stopped: step\n  #0 main prog.c:16");
    scratch::expect_contains("continue runs to the breakpoint, with the program's output", answer(&p, "9"),
                             "[stdout]\n7\nstopped: breakpoint (breakpoint 2)\n  #0 main prog.c:17");
    scratch::expect_contains("the stack at the second breakpoint", answer(&p, "10"), "#0 main prog.c:17");
    scratch::expect_contains("continue ends the program", answer(&p, "11"), "exited: the program exited with code 0");
    scratch::expect_contains("a continue after the end", answer(&p, "12"), "the program has exited");
    scratch::expect_text("stop", "session s1 stopped (the program had exited with code 0)", answer(&p, "13"));
    scratch::expect_text("the session is gone", "no debug session: call launch first", answer(&p, "14"));
}

// A client that goes away while the program is stopped takes the program with it.
export void test_macos_mcp_a_client_that_goes_away_takes_the_program_with_it() {
    scratch::Project root = scratch::make("mcp", "mcp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!can_debug(&root)) {
        return;
    }
    scratch::Project p = folder(&root, "c");
    scratch::Run built = scratch::sh(&p, "smith cc -g -O0 spin.c -o spin");
    scratch::expect_status("spin.c builds", 0, &built);
    const char *calls =
        call("", "1", "launch", "{\"program\":\"spin\",\"breakpoints\":[{\"file\":\"spin.c\",\"line\":9}]}");
    serve(&p, calls, "1");
    scratch::expect_contains("a launch stopped before sleep", answer(&p, "1"), "stopped: breakpoint");
    // The server ends the program when the input ends: wait for that (order, not a number of seconds), well inside
    // the 60 s the program sleeps. Not killed here: the program is no child of this test, so its pid may already be
    // another process's; it ends by itself when its sleep does.
    scratch::expect_text(
        "the program is gone when the client's input ends", "gone",
        scratch::capture(&p, "pid=$(cat spin.pid 2>/dev/null || echo 0); i=0; while [ $i -lt 500 ] && "
                             "kill -0 \"$pid\" 2>/dev/null; do sleep 0.1; i=$((i + 1)); done; "
                             "if kill -0 \"$pid\" 2>/dev/null; then echo still running; else echo gone; fi"));
}

// --- a .smith program (names as written)
// ---------------------------------------------------------------------------------

export void test_macos_mcp_a_smith_program_session_has_names_as_written() {
    scratch::Project root = scratch::make("mcp", "mcp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!can_debug(&root) ||
        scratch::sh(&root, "smith cc --smith-which -x c 2>/dev/null | grep -q 'token-hook yes'").status != 0) {
        return;
    }
    scratch::Project p = folder(&root, "lang");
    scratch::Run built = scratch::sh(
        &p,
        "mkdir -p include && smith cc --smith-header geometry/box.smith -o include/box.h && smith cc -g -O0 -I include "
        "-c geometry/box.smith -o box.o && smith cc -g -O0 -I include -c main.smith -o main.o && smith cc -g box.o "
        "main.o -o lang");
    scratch::expect_status("the .smith program builds", 0, &built);
    const char *calls = "";
    calls = call(calls, "1", "launch",
                 "{\"program\":\"lang\",\"breakpoints\":[{\"file\":\"geometry/box.smith\",\"line\":4}]}");
    calls = call(calls, "2", "stack", "{}");
    calls = call(calls, "3", "variables", "{\"depth\":1}");
    calls = call(calls, "4", "evaluate", "{\"expression\":\"b.w * b.h\"}");
    calls = call(calls, "5", "continue", "{}");
    serve(&p, calls, "5");
    scratch::expect_text("a .smith session: nothing on stderr", "", scratch::read(&p, "err.txt"));
    scratch::expect_text(
        "launch stops in the module's function, named as written",
        "session s1: DIR/lang/lang\nbreakpoint 1: geometry/box.smith:4 (verified)\nstopped: breakpoint "
        "(breakpoint 1)\n  #0 geometry::box::area geometry/box.smith:4\n  > 4:   F32 r = b.w * b.h;",
        answer(&p, "1"));
    scratch::expect_contains("the stack goes through main.smith", answer(&p, "2"), "#1 main main.smith:5");
    scratch::expect_text("the type is named as written",
                         "frame #0, scope locals\nb (geometry::box::Box)\n  w = 2 (F32)\n  h = 3 (F32)\nr = 0 (F32)",
                         scratch::capture(&p, "sed 's/^r = [0-9.e-]* (F32)/r = 0 (F32)/' r3.txt"));
    scratch::expect_text("evaluate in a module", "b.w * b.h = 6 (F32)", answer(&p, "4"));
    scratch::expect_lacks("the C spelling does not show in the results", scratch::read(&p, "out.jsonl"),
                          "geometry_box");
}

// --- a test of a project, launched by its name
// ------------------------------------------------------------------------

// The scratch project, built. Both tests that launch it need the same build (3 s of CPU each), so it is built once for
// each smith under test in the tests' cache ($SMITH_TEST_CACHE/mcp-<smith's size and time>/project, the way
// tests/lsp_test.smith's `built_script` does) and copied; `smith build` in the copy is then a no-op that writes the
// copy's paths again. The first test to need it takes a lock (a folder) and builds, the other waits for the result.
constexpr char build_project[_] =
    "key=$(stat -c %Y-%s \"$SMITH_SELF\" 2>/dev/null || stat -f %m-%z \"$SMITH_SELF\"); "
    "base=$SMITH_TEST_CACHE/mcp-$key; c=$base/project; lock=$base.lock-project; "
    "if [ ! -d \"$c\" ] && mkdir \"$lock\" 2>/dev/null; then "
    "find \"$SMITH_TEST_CACHE\" -maxdepth 1 -name 'mcp-*' -mtime +1 -exec rm -rf {} + 2>/dev/null; "
    "tmp=$base.$$; mkdir -p \"$tmp\" && cp -Rp . \"$tmp/project\" && (cd \"$tmp/project\" && "
    "env CC=smith-cc CXX=smith-c++ smith build >\"$tmp/build.log\" 2>&1 || { cat \"$tmp/build.log\" >&2; false; }) && "
    "mkdir -p \"$base\" && mv \"$tmp/project\" \"$c\"; rm -rf \"$tmp\"; rmdir \"$lock\"; "
    "else i=0; while [ ! -d \"$c\" ] && [ -d \"$lock\" ] && [ $i -lt 3000 ]; do sleep 0.2; i=$((i + 1)); done; fi; "
    "[ -d \"$c\" ] && cp -Rp \"$c/.\" . && env CC=smith-cc CXX=smith-c++ smith build >build.log 2>&1";

static const char *project_calls() {
    const char *calls = "";
    calls = call(calls, "1", "launch",
                 "{\"test\":\"twice_doubles\",\"breakpoints\":[{\"file\":\"tests/test_a.c\",\"line\":5}]}");
    calls = call(calls, "2", "variables", "{}");
    calls = call(calls, "3", "stack", "{\"levels\":2}");
    calls = call(calls, "4", "step_out", "{}");
    calls = call(calls, "5", "continue", "{}");
    return call(calls, "6", "launch", "{\"test\":\"twice_doubles\",\"runner\":\"build/nonesuch\"}");
}

export void test_macos_mcp_a_test_of_a_project_launched_by_its_name() {
    scratch::Project root = scratch::make("mcp", "mcp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!can_debug(&root)) {
        return;
    }
    scratch::Project p = folder(&root, "project");
    scratch::Run built = scratch::sh(&p, build_project);
    if (built.status != 0) {
        test::note("%s%s", built.err, scratch::read(&p, "build.log"));
    }
    scratch::expect_status("the scratch project builds", 0, &built);
    serve(&p, project_calls(), "6");
    scratch::expect_text("a test session: nothing on stderr", "", scratch::read(&p, "err.txt"));
    scratch::expect_text(
        "launch by the name of a test stops in the test",
        "session s1: DIR/project/build/tests --test twice_doubles --in-process\nbreakpoint 1: "
        "tests/test_a.c:5 (verified)\nstopped: breakpoint (breakpoint 1)\n  #0 twice tests/test_a.c:5\n  "
        "> 5:     return doubled;",
        answer(&p, "1"));
    scratch::expect_text("the test's variables", "frame #0, scope locals\nx = 21 (int)\ndoubled = 42 (int)",
                         answer(&p, "2"));
    scratch::expect_contains("the stack of the test", answer(&p, "3"),
                             "#0 twice tests/test_a.c:5\n#1 test_twice_doubles tests/test_a.c:9");
    scratch::expect_contains("step_out returns to the test", answer(&p, "4"), "#0 test_twice_doubles tests/test_a.c:9");
    scratch::expect_contains("the test passes", answer(&p, "5"), "1 passed, 0 failed");
    scratch::expect_contains("the program ends with code 0", answer(&p, "5"), "exited: the program exited with code 0");
    scratch::expect_contains("a runner that is not there", answer(&p, "6"), "build/nonesuch is not a file");
    scratch::expect_text("build.info names the runner", "runner\tbuild/tests",
                         scratch::capture(&p, "grep \"^runner$(printf '\\t')\" .smith/build.info"));
}

// The runner is the one build.info names, wherever it is: moved, with the line changed, no guess finds it.
export void test_macos_mcp_the_runner_build_info_names_is_launched() {
    scratch::Project root = scratch::make("mcp", "mcp");
    defer scratch::clean(&root);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!can_debug(&root)) {
        return;
    }
    scratch::Project p = folder(&root, "project");
    scratch::Run built = scratch::sh(&p, build_project);
    scratch::expect_status("the scratch project builds", 0, &built);
    scratch::Run moved = scratch::sh(
        &p, "mv build/tests build/runner-elsewhere && sed \"s|^runner$(printf '\\t').*|runner$(printf "
            "'\\t')build/runner-elsewhere|\" .smith/build.info >build.info.new && mv build.info.new .smith/build.info");
    scratch::expect_status("the runner is moved", 0, &moved);
    const char *calls = call("", "1", "launch",
                             "{\"test\":\"twice_doubles\",\"breakpoints\":[{\"file\":\"tests/test_a.c\",\"line\":5}]}");
    serve(&p, calls, "1");
    scratch::expect_contains("the runner build.info names is launched", answer(&p, "1"),
                             "DIR/project/build/runner-elsewhere --test twice_doubles --in-process");
}
