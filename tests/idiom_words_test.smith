// Tests of the words and tables of the idiom checks (runtime/idiom.smith): the sized type of a C spelling, the text of
// each finding, the reading of a module's generated header and the module a path implies. What `smith lint` prints with
// them is checked by tests/lint_smith_test.smith and its golden files.
module idiom_words_test;

import smith::test;
import runtime::idiom;

typedef typeof(const char[:]) Text;

// Whether what a call wrote, of `length` characters, is the text.
static bool wrote(const char *buffer, usize length, usize capacity, Text expected) {
    if (length != countof(expected) || length > capacity) return false;
    for (usize i = 0; i < length; i++) {
        if (buffer[i] != expected[i]) return false;
    }
    return true;
}

static bool sized_is(Text spelled, Text expected) {
    char out[32];
    usize n = idiom::sized_type(spelled.data, countof(spelled), out, 32);
    return wrote(out, n, 32, expected);
}

static bool integer_is(Text run, Text expected) {
    char out[32];
    usize n = idiom::sized_integer(run.data, countof(run), out, 32);
    return wrote(out, n, 32, expected);
}

export void test_idiom_words_sized_type_of_a_standard_name() {
    test::check_condition(sized_is("uint8_t", "u8"));
    test::check_condition(sized_is("int64_t", "i64"));
    test::check_condition(sized_is("size_t", "usize"));
    test::check_condition(sized_is("ptrdiff_t", "isize"));
    test::check_condition(sized_is("uint", ""));
    test::check_condition(sized_is("", ""));
}

export void test_idiom_words_sized_integer_of_a_run_of_keywords() {
    test::check_condition(integer_is("unsigned long long", "u64"));
    test::check_condition(integer_is("long", "i64"));
    test::check_condition(integer_is("unsigned", "u32"));
    test::check_condition(integer_is("int", "i32"));
    test::check_condition(integer_is("short", "i16"));
    test::check_condition(integer_is("unsigned short", "u16"));
    test::check_condition(integer_is("unsigned char", "u8"));
    test::check_condition(integer_is("signed char", "i8"));
    test::check_condition(integer_is("char", ""));
    test::check_condition(integer_is("long double", "f64"));
    test::check_condition(integer_is("float", "f32"));
}

export void test_idiom_words_say_a_c_type_and_its_sized_type() {
    char out[256];
    Text spelled = "unsigned long";
    Text sized = "u64";
    usize n = idiom::sized_message(spelled.data, countof(spelled), sized.data, countof(sized), out, 256);
    test::check_condition(wrote(out, n, 256,
                                "`unsigned long` is a C type, and a .smith file has the sized types: write "
                                "`u64` (u8 u16 u32 u64, i8 i16 i32 i64, usize, isize, f32, f64)"));
}

export void test_idiom_words_give_the_whole_length_when_the_buffer_is_small() {
    char out[4];
    Text spelled = "int";
    Text sized = "i32";
    usize n = idiom::sized_message(spelled.data, countof(spelled), sized.data, countof(sized), out, 4);
    test::check_condition(n > 4);
    test::check_condition(out[0] == '`' && out[1] == 'i');
}

constexpr char arena_header[_] = "// clang-format off\n"
                                 "// Generated by smith from lib/smith/arena.smith. Do not edit.\n"
                                 "// smith-module: smith::arena\n"
                                 "// smith-imports: smith::mem\n"
                                 "// smith-names: push_raw=smith_arena_push make=smith_arena_make\n"
                                 "// smith-generic: smith::arena push\n"
                                 "// smith-generic: smith::arena check_equal\n"
                                 "#pragma once\n";

static Text header_text() {
    return arena_header[0:countof(arena_header) - 1];
}

export void test_idiom_words_read_a_module_header() {
    char out[64];
    Text header = header_text();
    usize n = idiom::header_module(header.data, countof(header), out, 64);
    test::check_condition(wrote(out, n, 64, "smith::arena"));
    Text plain = "#pragma once\nint f(void);\n";
    n = idiom::header_module(plain.data, countof(plain), out, 64);
    test::check_equal(n, 0);
}

export void test_idiom_words_say_an_import_through_the_c_header() {
    char out[512];
    Text header = header_text();
    Text written = "smith/arena.h";
    usize n = idiom::library_import_message(header.data, countof(header), written.data, countof(written), out, 512);
    test::check_condition(wrote(out, n, 512,
                                "`import <smith/arena.h>;` reads smith::arena, a module, through its C header: write "
                                "`import smith::arena;` and call it as `arena::name(...)` (a typed push is "
                                "`arena::push(&a, T)`)"));
}

export void test_idiom_words_say_a_c_name_of_a_module() {
    char out[512];
    Text header = header_text();
    Text spelled = "smith_arena_push";
    usize n = idiom::library_name_message(header.data, countof(header), spelled.data, countof(spelled), out, 512);
    test::check_condition(wrote(out, n, 512,
                                "`c::smith_arena_push` is `arena::push_raw` of the module smith::arena, reached "
                                "through its C header: write `import smith::arena;` and `arena::push_raw` (a typed "
                                "push is `arena::push(&a, T)`)"));
    Text other = "strlen";
    n = idiom::library_name_message(header.data, countof(header), other.data, countof(other), out, 512);
    test::check_equal(n, 0);
}

static bool c23_is(Text name, bool period, bool condition, Text expected) {
    char out[256];
    usize n = idiom::c23_message(name.data, countof(name), period, condition, out, 256);
    return wrote(out, n, 256, expected);
}

export void test_idiom_words_say_the_older_spelling_of_c() {
    test::check_condition(c23_is("NULL", false, false, "`NULL` is a macro: write `nullptr`"));
    test::check_condition(c23_is("NULL", false, true, ""));
    test::check_condition(c23_is("_Bool", false, false, "`_Bool` is C99's spelling: write `bool`, a keyword in C23"));
    test::check_condition(c23_is("_Static_assert", false, false,
                                 "`_Static_assert` is C11's spelling: write `static_assert`, a keyword in C23"));
    test::check_condition(
        c23_is("_Alignof", false, false, "`_Alignof` is C11's spelling: write `alignof`, a keyword in C23"));
    test::check_condition(c23_is("_Noreturn", false, false, "`_Noreturn` is C11's spelling: write `[[noreturn]]`"));
    test::check_condition(
        c23_is("stdbool", true, false, "`<stdbool.h>` is not needed: `bool`, `true` and `false` are keywords in C23"));
    test::check_condition(c23_is("stdbool", false, false, ""));
    test::check_condition(c23_is("int", false, false, ""));
}

static bool attribute_is(Text name, Text expected) {
    char out[256];
    usize n = idiom::attribute_message(name.data, countof(name), out, 256);
    return wrote(out, n, 256, expected);
}

export void test_idiom_words_say_the_standard_spelling_of_an_attribute() {
    test::check_condition(attribute_is("noreturn", "`__attribute__((noreturn))` has a standard spelling: write "
                                                   "`[[noreturn]]`"));
    test::check_condition(attribute_is("__unused__", "`__attribute__((__unused__))` has a standard spelling: write "
                                                     "`[[maybe_unused]]`"));
    test::check_condition(attribute_is("warn_unused_result", "`__attribute__((warn_unused_result))` has a standard "
                                                             "spelling: write `[[nodiscard]]`"));
    test::check_condition(attribute_is("aligned", ""));
}

static bool void_list(Text before, Text word, char punctuation) {
    return idiom::void_parameter_list(before.data, countof(before), word.data, countof(word), punctuation);
}

export void test_idiom_words_tell_a_parameter_list_from_a_cast() {
    test::check_condition(void_list("", "", ';'));
    test::check_condition(void_list("main", "", '{'));
    test::check_condition(void_list("", "__attribute__", 0));
    test::check_condition(!void_list("sizeof", "", ';'));
    test::check_condition(!void_list("return", "", ';'));
    test::check_condition(!void_list("", "x", 0));
    test::check_condition(!void_list("", "", 0));
    Text if_name = "ifdef";
    test::check_condition(idiom::conditional_directive(if_name.data, countof(if_name)));
    Text define = "define";
    test::check_condition(!idiom::conditional_directive(define.data, countof(define)));
}

static bool module_is(Text path, Text root, Text expected) {
    char out[128];
    usize n = idiom::module_of(path.data, countof(path), root.data, countof(root), out, 128);
    return wrote(out, n, 128, expected);
}

export void test_idiom_words_name_the_module_a_path_implies() {
    test::check_condition(module_is("/work/p/geometry/box.smith", "/work/p", "geometry::box"));
    test::check_condition(module_is("/work/p/tests/primes_test.smith", "/work/p", "primes_test"));
    test::check_condition(module_is("./main.smith", "", "main"));
    test::check_condition(module_is("/elsewhere/x/main.smith", "/work/p", "main"));
    test::check_condition(module_is("../up/main.smith", "/work/p", "main"));
    char out[256];
    Text path = "/work/p/a/b.smith";
    Text root = "/work/p";
    usize n = idiom::module_message(path.data, countof(path), root.data, countof(root), out, 256);
    test::check_condition(wrote(out, n, 256,
                                "this file has no `module` line, and every .smith file is a module: write `module "
                                "a::b;` at the top (its path from the project's root, `tests/` being a root of its "
                                "own), and `export` what other files use"));
}

export void test_idiom_words_say_the_names_the_lowering_made() {
    Text tuple = "smith_tuple_i32__f32";
    test::check_condition(idiom::lowering_name(tuple.data, countof(tuple)));
    Text field = "smith_field";
    test::check_condition(idiom::lowering_name(field.data, countof(field)));
    Text mine = "smith_fields";
    test::check_condition(!idiom::lowering_name(mine.data, countof(mine)));
    Text generic = "push_array<f64>";
    test::check_equal(idiom::judged_name_length(generic.data, countof(generic)), 10);
    Text plain = "push";
    test::check_equal(idiom::judged_name_length(plain.data, countof(plain)), 4);
}

export void test_idiom_words_say_a_loop_a_constexpr_and_a_designated_initializer() {
    char out[256];
    usize n = idiom::loop_message(0, out, 256);
    test::check_condition(wrote(out, n, 256,
                                "`for (;;)` never ends on its own: bound the loop by a count (`for (usize i = 0; i < "
                                "limit; i++)`); only `main` runs forever"));
    Text name = "table";
    n = idiom::constexpr_message(true, name.data, countof(name), out, 256);
    test::check_condition(wrote(out, n, 256, "`const` array `table` has a constant initializer: write `constexpr`"));
    n = idiom::constexpr_message(false, name.data, countof(name), out, 256);
    test::check_condition(wrote(out, n, 256, "`const` object `table` has a constant initializer: write `constexpr`"));
    n = idiom::designated_message(name.data, countof(name), out, 256);
    test::check_condition(wrote(out, n, 256,
                                "this initializes `table`, which another file defines, by position: name the fields "
                                "(`{.field = value, ...}`), so that a field added to it cannot shift the values"));
}
