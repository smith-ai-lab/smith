module main;

import <stdio.h>;

typedef struct {
    I32 id;
    F64 weight;
} Inner;

typedef struct {
    Inner in;
    Inner *link;
    I32 count;
} Outer;

// `fields(typeof(*p))` and `fields(typeof(p->f))` read like `fields(T)`.
void show_pointee(auto p) {
    if constexpr (is_record(typeof(*p))) c::printf("record: ");
    for constexpr (Usize i = 0; i < countof(fields(typeof(*p))); i++) {
        c::printf("%s ", fields(typeof(*p))[i].name);
    }
    c::printf("\n");
}

void show_member(auto p) {
    for constexpr (Usize i = 0; i < countof(fields(typeof(p->in))); i++) {
        c::printf("%s ", fields(typeof(p->in))[i].name);
    }
    c::printf("\n");
}

I32 main() {
    Outer o = {};
    show_pointee(&o);
    show_member(&o);
    show_pointee(o.link);
    return 0;
}
