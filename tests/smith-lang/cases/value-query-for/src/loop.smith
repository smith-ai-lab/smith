module loop;

struct Config {
    Usize count;
    I32 step;
};
constexpr struct Config config = {.count = 4, .step = 3};

// The bound is a field of a `constexpr` struct: only the compiler can read it.
I32 total(constexpr Type T) {
    I32 sum = 0;
    for constexpr (Usize i = 0; i < config.count; i++) {
        sum += config.step + sizeof(T);
    }
    return sum;
}

export I32 bytes() {
    return total(U8);
}
export I32 words() {
    return total(U64);
}
