import pick;

int main() {
    I32 a = 3;
    // The argument is quoted as written, a nested call to a generic included; a nested call has its result's type.
    I32 r = pick::larger(a, pick::larger(a, 3) + 1 + __builtin_abs(a));
    I32 s = pick::larger(pick::zero_like(a), 2);
    U16 x = 1;
    U32 y = 2;
    I32 t = pick::larger(x, y);
    I32 u = pick::larger(++a, 1);
    return r + s + t + u;
}
