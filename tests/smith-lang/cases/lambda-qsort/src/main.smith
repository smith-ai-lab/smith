module main;

import <stdio.h>;
import <stdlib.h>;

i32 main() {
    i32 values[5] = {3, 1, 4, 1, 5};
    c::qsort(values, 5, sizeof(i32), [](const void *a, const void *b) -> int {
        const i32 *left = (const i32 *)a;
        const i32 *right = (const i32 *)b;
        return *left - *right;
    });
    for (i32 i = 0; i < 5; i++) {
        c::printf("%d ", values[i]);
    }
    c::printf("\n");
    return 0;
}
