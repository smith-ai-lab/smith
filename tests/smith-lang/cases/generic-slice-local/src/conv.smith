module conv;

// A slice local in a generic's body (issue #135): declared from a parameter, counted, indexed, cut, passed to a
// function, and the cut of a cut. The replay writes the declaration as an ordinary function's is lowered.

static Usize read_sum(const U8 xs[:]) {
    Usize total = 0;
    for (Usize i = 0; i < countof(xs); i++) {
        total += xs[i];
    }
    return total;
}

static Usize plain_sum(U8 xs[:]) {
    return read_sum(xs);
}

export Usize total(auto xs) {
    U8 v[:] = xs;
    Usize t = 0;
    for (Usize i = 0; i < countof(v); i++) {
        t += v[i];
    }
    return t;
}

export Usize from_cut(auto xs) {
    U8 v[:] = xs[1:];
    U8 w[:] = v[1:3];
    return countof(v) * 100 + countof(w) * 10 + w[0];
}

export Usize passed(auto xs) {
    U8 v[:] = xs;
    return plain_sum(v);
}

export Usize fixed() {
    U8 raw[3] = {7, 8, 9};
    U8 v[:] = raw;
    return plain_sum(v) + countof(v);
}

export Usize read_only(auto xs) {
    const U8 v[:] = xs;
    return read_sum(v);
}

export Usize restricted(auto xs) {
    U8 v[restrict :] = xs;
    return countof(v);
}

export Usize twice(auto xs, auto ys) {
    Usize t = 0;
    {
        U8 v[:] = xs;
        t += countof(v);
    }
    {
        U8 v[:] = ys;
        t += v[0];
    }
    return t;
}
