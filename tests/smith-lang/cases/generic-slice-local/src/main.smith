module main;

import conv;
import <stdio.h>;

I32 main() {
    U8 raw[5] = {1, 2, 3, 4, 5};
    U8 xs[:] = raw;
    U8 big[:] = raw;
    U8 res[restrict :] = raw;
    c::printf("%zu %zu\n", conv::total(xs), conv::from_cut(xs));
    c::printf("%zu %zu\n", conv::passed(xs), conv::fixed());
    c::printf("%zu\n", conv::twice(xs, big));
    const U8 read[:] = xs;
    c::printf("%zu %zu\n", conv::read_only(read), conv::restricted(res));
    return 0;
}
