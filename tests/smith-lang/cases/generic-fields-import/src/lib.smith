module lib;

import <stdio.h>;

// A library generic that keeps a field in a variable and asks its type: no helper, so the file that calls it needs
// nothing of its own.
export void show(constexpr Type T, T *x) {
    for constexpr (Usize i = 0; i < countof(fields(T)); i++) {
        constexpr auto f = fields(T)[i];
        if constexpr (Float(f.type)) {
            c::printf("%s=%g ", fields(T)[i].name, (F64)x->[f]);
        } else if constexpr (Int(f.type)) {
            c::printf("%s=%lld ", fields(T)[i].name, (long long)x->[f]);
        }
    }
    c::printf("\n");
}
