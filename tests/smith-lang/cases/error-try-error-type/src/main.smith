module main;

// `try` returns the error as it is, so the function's error type is the call's; a change is written out (issue #211).
static Result(I32, I32) step(I32 n) {
    return {.ok = n};
}

static Result(I32, I64) other_error(void) {
    I32 a = try step(1);
    return {.ok = a};
}

I32 main() {
    return other_error() == .ok ? 0 : 1;
}
