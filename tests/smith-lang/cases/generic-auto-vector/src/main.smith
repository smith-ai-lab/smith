import pick;
import "v2.h";
#include <stdio.h>

int main() {
    c::F4 v = {1, 2, 3, 4};
    c::F2 w = {5, 6};
    // The lanes of an ext-vector: one lane is its element, several are a vector.
    printf("%g %g\n", pick::larger(v.x, v.w), pick::larger(v.r, 0.5f));
    c::F2 both = pick::larger(v.yx, w);
    printf("%g %g\n", both.x, both.y);
    return 0;
}
