module main;

import order;

i32 main() {
    i32 ints[4] = {3, 1, 2, 5};
    i32 a[:] = ints;
    f64 reals[3] = {0.5, 1.5, 1.0};
    f64 b[:] = reals;
    order::adjacent(a, [](arithmetic *x, arithmetic *y) -> bool { return *x < *y; });
    order::adjacent(a, [](auto x, auto y) -> bool { return *x > *y; });
    order::adjacent(b, [](arithmetic *x, arithmetic *y) -> bool { return *x < *y; });
    return 0;
}
