module main;

import order;

I32 main() {
    I32 ints[4] = {3, 1, 2, 5};
    I32 a[:] = ints;
    F64 reals[3] = {0.5, 1.5, 1.0};
    F64 b[:] = reals;
    order::adjacent(a, [](Num *x, Num *y) -> Bool { return *x < *y; });
    order::adjacent(a, [](auto x, auto y) -> Bool { return *x > *y; });
    order::adjacent(b, [](Num *x, Num *y) -> Bool { return *x < *y; });
    return 0;
}
