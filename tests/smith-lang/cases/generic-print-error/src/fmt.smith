module fmt;

import <stdio.h>;

// A type-checked `print`: one `for constexpr` over the arguments, and each one is formatted by its own type, chosen when
// the instance is written. A type with no format is a `static_assert` in the final `else`, at the call that asked for it.
export void print(auto... args) {
    for constexpr (Usize i = 0; i < countof(args); i++) {
        if constexpr (i > 0) {
            c::putchar(' ');
        }
        if constexpr (typeof(args[i]) == Bool) {
            c::fputs(args[i] ? "true" : "false", c::stdout);
        } else if constexpr (Int(typeof(args[i])) && Signed(typeof(args[i]))) {
            c::printf("%lld", (long long)args[i]);
        } else if constexpr (Int(typeof(args[i]))) {
            c::printf("%llu", (unsigned long long)args[i]);
        } else if constexpr (Float(typeof(args[i]))) {
            c::printf("%g", (double)args[i]);
        } else if constexpr (typeof(args[i]) == char *) {
            c::fputs(args[i], c::stdout);
        } else {
            static_assert(false, "fmt::print: no format for this type");
        }
    }
    c::putchar('\n');
}
