module kinds;

// `kind(T)` is the one question of a type's kind (issue #193); a concept is a function over it.
Bool Scalar(constexpr Type T) {
    return kind(T) == Kind::integer || kind(T) == Kind::floating || kind(T) == Kind::boolean;
}

export usize bytes(Scalar x) {
    return sizeof(x);
}

export i32 code(Any x) {
    if constexpr (kind(typeof(x)) == Kind::pointer) {
        return 1;
    } else if constexpr (kind(typeof(x)) == Kind::structure) {
        return 2;
    } else if constexpr (kind(typeof(x)) == Kind::floating) {
        return 3;
    } else {
        return 0;
    }
}
