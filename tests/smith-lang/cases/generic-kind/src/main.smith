module main;

import <stdio.h>;
import kinds;

typedef struct {
    i32 a;
} Pair;

i32 main(void) {
    f32 f = 1.5f;
    u8 b = 1;
    bool flag = true;
    Pair pair = {1};
    c::printf("%zu %zu %zu\n", kinds::bytes(f), kinds::bytes(b), kinds::bytes(flag));
    c::printf("%d %d %d %d\n", kinds::code(&pair), kinds::code(pair), kinds::code(f), kinds::code(b));
    return 0;
}
