module main;
import <stdio.h>;

typedef const char Text[:];
typedef Option(Text) MaybeText; // names the struct once, as the first mention of `.none` needs

static Usize first_len(Text word, Bool b) {
    Option(Text) found = .none;
    if (b) found = word[0:1];
    if (found == .none) return 9;
    return countof(found.some);
}

static Usize typeof_len(Text word) {
    Option(typeof(const char[:])) found = word[0:2];
    if (found == .none) return 0;
    return countof(found.some);
}

I32 main(void) {
    const char s[4] = {'a', 'b', 'c', 'd'};
    Text w = s[0:4];
    c::printf("%d %d %d\n", (I32)first_len(w, true), (I32)first_len(w, false), (I32)typeof_len(w));
    return 0;
}
