module loops;

// In a generic's body `xs` has the type of each instance; the loop is the same for a slice of i32 and of f64. The
// element is named by `auto`, or by a concept that the instance's element must be.
export F64 sum(auto xs) {
    F64 total = 0;
    for (auto x : xs) {
        total += (F64)x;
    }
    return total;
}

export I32 weighted(auto xs) {
    I32 total = 0;
    for (Usize i, Num x : xs) {
        total += (I32)x * (I32)i;
    }
    return total;
}

export I32 scaled_total(auto xs, I32 scale) {
    I32 total = 0;
    for (auto x : xs) {
        defer total += 1;
        if (x == 2) continue;
        total += (I32)x * scale;
    }
    return total;
}

// `T *p` points at the element, as outside a generic.
export void bump(auto xs) {
    for (typeof(xs[0]) *p : xs) {
        *p += 10;
    }
}
