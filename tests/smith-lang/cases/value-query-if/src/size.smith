module size;

// An ordinary function: the compiler evaluates the condition, the small evaluator cannot. The instances are written in
// this file, where the function is defined.
static Usize table_size(Usize bytes) {
    Usize total = 0;
    for (Usize i = 0; i < bytes; i++)
        total += i % 3 == 0 ? 2 : 1;
    return total;
}

typedef struct {
    U8 bytes[80];
} Big;

I32 choose(constexpr Type T) {
    if constexpr (table_size(sizeof(T)) > 64) {
        return 1;
    } else {
        return 2;
    }
}

I32 mixed(constexpr Type T) {
    if constexpr (table_size(sizeof(T)) > 64 && sizeof(T) < 1000) return 10;
    if constexpr (sizeof(T) == 4) return 20;
    return 30;
}

export I32 small() {
    return choose(U8);
}
export I32 big() {
    return choose(Big);
}
export I32 all() {
    return mixed(Big) * 10000 + mixed(U32) * 100 + mixed(U8);
}
