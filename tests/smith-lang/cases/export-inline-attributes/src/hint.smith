module hint;

// Attributes after `export` stay before `static inline` in the module and in the header, beside [[std::c_name]]: an
// inline function nothing calls is not an unused function, and always_inline needs no __attribute__ spelling.
[[std::c_name("hint_first")]] export [[gnu::always_inline, maybe_unused]] inline void first(Bool condition) {
    (void)condition;
}

export [[maybe_unused]] inline I32 second(I32 x) {
    return x + 1;
}

export [[nodiscard]] inline I32 third(I32 x) {
    return x + 2;
}

export I32 used(I32 x) {
    return third(x);
}
