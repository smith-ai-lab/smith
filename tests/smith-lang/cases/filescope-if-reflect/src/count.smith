// A taken file-scope `if constexpr` that holds imports, more imports after it, and a generic that reflects (issue
// #335): `Field` is defined after the last import, not at the branch's `}`.
module count;

import target;
if constexpr (target::os == target::macos || target::os == target::linux) {
    import <stdint.h>;
}
import <stddef.h>;
import <stdio.h>;

export usize count_of(constexpr type T) {
    return countof(fields(T));
}

export void show(constexpr type T) {
    c::printf("%zu %s\n", countof(fields(T)), fields(T)[0].name);
}
