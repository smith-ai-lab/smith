module shapes;

// An enum with payloads lowers to a struct that holds a tag and a union (issue #198); variants are written like
// the members of a union, and a variant with nothing to carry is a name alone.

export typedef struct {
    F32 radius;
} Circle;

export typedef struct {
    F32 w;
    F32 h;
} Rect;

export typedef enum {
    Circle circle;
    Rect rect;
    struct { I32 a; } inline_one;
    empty;
} Shape;

export typedef enum {
    none;
    some;
} Mark;

export F32 area(Shape s) {
    switch (s) {
    case .circle: return s.circle.radius * s.circle.radius * 3;
    case .rect: return s.rect.w * s.rect.h;
    case .inline_one: return (F32)s.inline_one.a;
    case .empty: return 0;
    }
    return -1;
}

export Shape unit() {
    return {.circle = {.radius = 1}};
}

export Bool is_empty(Shape s) {
    return s == .empty;
}
