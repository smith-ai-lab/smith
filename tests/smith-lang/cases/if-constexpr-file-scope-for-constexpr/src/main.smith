module main;

import <stdio.h>;
import target;

// A generic with a `for constexpr` loop inside a file-scope `if constexpr` (issue #602): the loop's braces are not the
// block's, so the block ends at its own last brace.
if constexpr (target::os == target::macos || target::os != target::macos) {
    export I32 sum_fields(constexpr Type T, T *x) {
        I32 sum = 0;
        for constexpr (Usize i = 0; i < countof(fields(T)); i++) {
            sum += 1;
        }
        return sum;
    }

    struct Pair {
        I32 a;
        I32 b;
    };

    I32 after(Pair *p) {
        return sum_fields(Pair, p);
    }
}

I32 main() {
    Pair p = {1, 2};
    c::printf("%d\n", after(&p));
    return 0;
}
