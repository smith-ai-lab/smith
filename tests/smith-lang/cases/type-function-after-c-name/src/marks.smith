module marks;

// A declaration with a C name, then a function over `type`: the attribute must not leave the file inside brackets.
[[std::c_name("marks_const")]] export extern I32 marker;

static Type leaf_of(Type t) {
    if (is_pointer(t)) return typeof(*(t)nullptr);
    return t;
}

export leaf_of(typeof(x)) at(auto x) {
    if constexpr (is_pointer(typeof(x))) {
        return x[0];
    } else {
        return x;
    }
}
