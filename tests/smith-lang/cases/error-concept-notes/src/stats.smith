module stats;

export typeof(xs[0]) sum(const Num xs[:]) {
    return xs[0];
}

export typeof(x) twice(Num x) {
    return x + x;
}

export typeof(*p) read(const Int *p) {
    return *p;
}

export Usize count(const auto xs[:]) {
    return countof(xs);
}

export Bool same_kind(Pointer p, typeof(p) q) {
    return p == q;
}
