module main;

import shape;
import <stdio.h>;

static f64 loss(const shape::Params *p, const shape::Batch *batch) {
    return (p->a + p->b) * batch->scale;
}

static f64 plain(const shape::Params *p) {
    return p->a * 2;
}

int main() {
    shape::Params p = {1.0, 2.0};
    shape::Batch batch = {3.0};
    shape::Params g = shape::gradient(loss, &p, &batch);
    shape::Params h = shape::gradient(plain, &p);
    c::printf("%.1f %.1f\n", g.a, h.a);
    return 0;
}
