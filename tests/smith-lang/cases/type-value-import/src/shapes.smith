module shapes;

// A function over `type` is a compile-time function: an importing module runs it, wherever a type is computed, from the
// record in this module's header (it has no symbol and no declaration for C).
static bool is_wide(type t) {
    return sizeof(t) > 4;
}

export bool small(type t) {
    return !is_wide(t);
}

export type wider(type a, type b) {
    return sizeof(a) >= sizeof(b) ? a : b;
}

// `t[:]` once for each size: `slice_of(f32, 2)` is `f32[:][:]`.
export type slice_of(type element, usize count) {
    type t = element;
    for (usize i = 0; i < count; i++)
        t = t[:];
    return t;
}

// A function over types may call another, exported or not.
export type slice_if_small(type t) {
    return small(t) ? slice_of(t, 1) : t;
}
