module main;

import <stdio.h>;
import finder;

// `option(usize)` is first named inside a function body, with no file-scope typedef: the struct is defined there.

I32 main(void) {
    Option(Usize) i = finder::find("key=value", '=');
    Option(Usize) j = .none;
    j = finder::find("a,b", ',');
    if (i == .some && j == .some) c::printf("%zu %zu\n", i.some, j.some);
    return 0;
}
