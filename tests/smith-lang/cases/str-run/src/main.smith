module main;

import <stdio.h>;

// `Str` is a type of every module, `const char[:]` (issue #85), as `U8` is a type: no typedef, no import.

struct Named {
    Str name;
    I32 id;
};

static Usize length(Str xs) {
    return countof(xs);
}

static Str tail(Str xs) {
    return xs[1:];
}

static Bool next(Str *p) {
    if (countof(*p) == 0) return false;
    *p = (*p)[1:];
    return true;
}

static void poke(char (*b)[:]) {
    (*b)[0] = 'Z';
}

I32 main() {
    Str s = "abc";
    c::printf("%zu %c %zu %zu\n", countof(s), s[1], length(s), length(s[1:]));
    Str cut = s[0:2];
    Str *p = &s;
    Usize steps = 0;
    while (next(p)) steps++;
    c::printf("%zu %zu %zu\n", countof(cut), steps, countof(s));

    char raw[4] = {'a', 'b', 'c', 'd'};
    char w[:] = raw;
    Str r = w;               // const is added implicitly
    Str *pr = &w;            // a pointer to char[:] is a pointer to str (C23, N2607)
    poke(&w);
    c::printf("%zu %c %zu %c\n", length(w), (*pr)[0], countof(tail(r)), tail(w)[0]);

    struct Named n = {.name = "field", .id = 3};
    typeof(s) same = n.name;
    c::printf("%zu %zu %d\n", countof(n.name), countof(same), n.id);
    const Str k = "k";
    static Str fixed = "hello";
    c::printf("%zu %zu %zu\n", countof(k), countof(fixed), (Usize)sizeof(Str));
    return 0;
}
