module main;

import <stdio.h>;

struct Request {
    i32 id;
};

struct Response {
    i32 code;
};

// A type value written as a full C type, in the abstract-declarator form of a cast: a function pointer, an array, a
// pointer to an array, an array of pointers.
constexpr type Handler = Response (*)(Request *, i32);
constexpr type Callback = void (*)(void);
constexpr type Block = u8[16];
constexpr type Grid = f32[2][3];
constexpr type Row = i32 (*)[4];
constexpr type Pointers = Request *[4];

static_assert(is_pointer(Handler) && is_pointer(Callback) && is_pointer(Row));
static_assert(is_array(Block) && is_array(Grid) && is_array(Pointers));
static_assert(sizeof(Block) == 16 && sizeof(Grid) == 24 && sizeof(Pointers) == 32 && sizeof(Row) == 8);
static_assert(Handler != Callback && Block != Grid);

Response answer(Request *request, i32 extra) {
    return (Response){request->id + extra};
}

void nothing(void) {}

i32 main() {
    Handler handler = answer; // `t x;` declares a variable of the type the value holds
    Callback callback = nothing;
    Block block = {1, 2, 3};
    Grid grid = {{1, 2, 3}, {4, 5, 6}};
    i32 numbers[4] = {10, 20, 30, 40};
    Row row = &numbers;
    Request request = {5};
    Pointers pointers = {&request};
    callback();
    c::printf("%d %d %d %d %d %d\n", handler(&request, 2).code, (i32)sizeof(block), block[2], (i32)grid[1][2],
              (*row)[3], pointers[0]->id);
    return 0;
}
