// A file-scope `if constexpr` around declarations (issue #335): the branch taken is at file scope, its braces open no
// scope, and the branch not taken is never read, so it may name what does not exist here.
module shape;

import target;

constexpr bool wide = true;

if constexpr (wide) {
    constexpr i32 columns = 80;

    export i32 width([[maybe_unused]] i32 n) {
        return columns;
    }
} else {
    export i32 width([[maybe_unused]] i32 n) {
        return undeclared_function();
    }
}

if constexpr (target::os == target::macos || target::os == target::linux) {
    export i32 platform([[maybe_unused]] i32 n) {
        return 1;
    }
} else if constexpr (target::arch == target::aarch64) {
    export i32 platform([[maybe_unused]] i32 n) {
        return 2;
    }
} else {
    export i32 platform([[maybe_unused]] i32 n) {
        return undeclared_function();
    }
}

// The same export, with its C name, in each branch: the header has both, between the `#if` lines.
if constexpr (target::os == target::macos) {
    [[smith::c_name("shape_sides")]] export i32 sides([[maybe_unused]] i32 n) {
        return 4;
    }
} else {
    [[smith::c_name("shape_sides")]] export i32 sides([[maybe_unused]] i32 n) {
        return 4;
    }
}

// A function's own `if constexpr` still keeps its braces.
export i32 both(void) {
    i32 sum = 0;
    if constexpr (wide) {
        i32 extra = 1;
        sum = width(0) + extra;
    }
    return sum + platform(0);
}
