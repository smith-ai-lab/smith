import pool;
#include <stdio.h>

typedef char *Text;
constexpr type element = f64;
constexpr type kinds[3] = {u16, i64, Text};

typedef struct {
    constexpr type of;
    i32 count;
} Column;
constexpr Column column = {.of = u8, .count = 3};

int main() {
    constexpr type t = i32;
    t a = 7;                    // `t x;` declares a variable of the type t holds
    element b = 2.5;            // a file-scope type value
    constexpr type second = kinds[1];
    constexpr type of = column.of;
    second c = 1;               // an element of an array of types
    of d = 200;                 // a member of a struct
    t *p = &a;
    (void)p;
    printf("%d %g %lld %d\n", a, b, (long long)c, d);
    printf("%zu %zu %zu\n", pool::width(t), pool::width(kinds[0]), pool::width(column.of));
    printf("%d\n", (int)(second)1);
    return 0;
}
