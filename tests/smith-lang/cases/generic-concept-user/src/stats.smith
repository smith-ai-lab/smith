module stats;

// A concept the program writes: an ordinary function over a type, named where a parameter's type goes (issue #193).
Bool Ordered(constexpr Type T) {
    return Int(T) || Float(T);
}

export Bool Narrow(constexpr Type T) {
    return Int(T) && sizeof(T) <= 2;
}

export typeof(x) twice(Ordered x) {
    return x + x;
}

export typeof(a) smaller(Narrow a, typeof(a) b) {
    return a < b ? a : b;
}

export Bool Sized(constexpr Type T) {
    return sizeof(T) == 8;
}

export usize bytes(Sized x) {
    return sizeof(x);
}
