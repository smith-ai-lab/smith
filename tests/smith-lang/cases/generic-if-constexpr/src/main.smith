import kind;
#include <stdio.h>

typedef struct {
    I32 x;
    I32 y;
} Point;

int main() {
    F32 f = 1.5f;
    U64 big = 9;
    I32 small = -3;
    U8 byte = 7;
    Point p = {10, 20};
    printf("%d %d %d %d %d\n", kind::describe(F32, f), kind::describe(U64, big), kind::describe(I32 *, &small),
           kind::describe(U8, byte), kind::describe(Point, p));
    printf("%d %d %d\n", kind::describe(I32, small), kind::floats_only(F32, f), kind::floats_only(I32, small));
    printf("%d %d %d\n", kind::bytes(U8), kind::bytes(U64), kind::bytes(Point));
    return 0;
}
