module kind;

// What a value is, chosen when the instance is written: the branches that are not taken are never given to the parser.
export I32 describe(constexpr Type T, T value) {
    if constexpr (T == F32) {
        return 1;
    } else if constexpr (is_integer(T) && sizeof(T) == 8) {
        return 2;
    } else if constexpr (is_pointer(T)) {
        return 3;
    } else if constexpr (is_integer(T)) {
        if constexpr (is_signed(T)) return 4;
        return 5;
    } else {
        return value.x + value.y;
    }
}

export I32 floats_only(constexpr Type T, T value) {
    if constexpr (is_float(T)) {
        return (I32)(value * 2) + sizeof(T);
    }
    return 0;
}

export I32 bytes(constexpr Type T) {
    if constexpr (alignof(T) > 4 || sizeof(T) >= 16) return 1;
    if constexpr (T == U8) return 2;
    return 3 + (sizeof(T) != 8);
}
