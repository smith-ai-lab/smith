module stats;

// A concept stands for a type where `auto` does: the argument's type, which must be of the concept (issue #193).
export typeof(x) twice(Num x) {
    return x + x;
}

export typeof(a) larger(Int a, typeof(a) b) {
    return a > b ? a : b;
}

export Usize width(Pointer p) {
    return sizeof(*p);
}

export I32 sign_of(Signed n) {
    return n < 0 ? -1 : 1;
}

export typeof(x) shifted(Num x) {
    typeof(x) one = 1;
    typeof(x) y = x + one;
    return y;
}

export I32 plain(I32 q) {
    I32 r = q * 2;
    return r;
}
