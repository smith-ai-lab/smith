module main;
import finder;
import <stdio.h>;

// A braceless for body holding a generic call, in a module whose import brings option's enum (#462).
void show(constexpr Type T, T value) {
    c::printf("%d\n", (I32)value);
}

I32 main() {
    for (I32 i = 0; i < 3; i++)
        show(I32, i);
    return 0;
}
