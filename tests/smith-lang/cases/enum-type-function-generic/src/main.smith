module main;

import <stdio.h>;

Type Maybe(Type T) {
    return enum {
        T some;
        none;
    };
}

typedef Maybe(Usize) Slot;
typedef Maybe(F64) MaybeF;

// A type function used with a generic's own parameters: each instance writes the struct a written `maybe(Usize)` is.
Maybe(T) first(constexpr Type T, T *xs, Usize n) {
    if (n == 0) return .none;
    return {.some = xs[0]};
}

Maybe(typeof(x)) wrap(auto x) {
    Maybe(typeof(x)) out = {.some = x};
    return out;
}

Maybe(T) pass(constexpr Type T, Maybe(T) o) {
    Maybe(T) copy = o;
    return copy;
}

static Usize or_else(Slot m, Usize otherwise) {
    if (m == .some) return m.some;
    return otherwise;
}

static F64 or_zero(MaybeF m) {
    if (m == .some) return m.some;
    return 0;
}

I32 main(void) {
    Usize xs[2] = {7, 8};
    Slot a = first(Usize, xs, 2);
    Slot none = first(Usize, xs, 0);
    MaybeF w = wrap(2.5);
    Slot p = pass(Usize, a);
    c::printf("%zu %zu %g %zu\n", or_else(a, 0), or_else(none, 99), or_zero(w), or_else(p, 0));
    return 0;
}
