module geo::shapes;

export struct Point {
    F32 x;
    F32 y;
};

export struct Node {
    Node *next;
    I32 value;
};

export enum Color { red, green };

export enum Shape {
    Point circle;
    empty;
};

struct Hidden {
    I32 secret;
};

export Point make(F32 x, F32 y) {
    Hidden h = {.secret = 1};
    return (Point){.x = x + (F32)h.secret - 1, .y = y};
}

export I32 sum(Node *list) {
    I32 total = 0;
    for (Node *n = list; n != nullptr; n = n->next)
        total += n->value;
    return total;
}

export Shape round_at(Point p) {
    return {.circle = p};
}

export Color next(Color c) {
    return c == red ? green : red;
}
