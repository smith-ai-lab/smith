module main;

import stats;

typedef struct {
    i32 a;
} Pair;

i32 main(void) {
    const char *name = "x";
    Pair pair = {1};
    char *names[2] = {"a", "b"};
    char *ns[:] = names;
    Pair *pairs = &pair;
    stats::twice(name);
    stats::twice(pair);
    stats::first(ns);
    stats::width(pairs);
    return 0;
}
