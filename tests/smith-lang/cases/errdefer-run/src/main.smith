module main;
import <stdio.h>;

// `errdefer` runs like `defer`, but only when the function returns its failing variant: from a `try`, from a
// written `return {.error = e};` and from `return r;` where `r` holds an error (issue #211).
static Result(I32, I32) step(I32 n) {
    if (n < 0) return {.error = n};
    return {.ok = n};
}

static Option(I32) pick(I32 n) {
    if (n < 0) return .none;
    return {.some = n};
}

static Result(I32, I32) chain(I32 a, I32 b) {
    defer c::puts("  defer");
    errdefer c::puts("  errdefer 1");
    I32 x = try step(a);
    errdefer c::printf("  errdefer 2 (x=%d)\n", x);
    I32 y = try step(b);
    return {.ok = x + y};
}

static Result(I32, I32) by_hand(I32 n) {
    errdefer c::puts("  hand errdefer");
    if (n == 0) return {.error = 100};
    Result(I32, I32) r = step(n);
    return r;
}

static Option(I32) options(I32 a) {
    errdefer c::puts("  option errdefer");
    I32 v = try pick(a);
    return {.some = v * 2};
}

static Result(I32, I32) payload(I32 a) {
    errdefer c::puts("  payload errdefer");
    return {.ok = try step(a)};
}

static Result(I32, I32) block_scope(I32 a) {
    {
        errdefer c::puts("  inner block errdefer");
        I32 v = try step(a);
        c::printf("  inner ok %d\n", v);
    }
    errdefer c::puts("  after the block");
    return {.ok = 1};
}

static void show(const char *what, Result(I32, I32) r) {
    c::puts(what);
    switch (r) {
    case .ok: c::printf("ok %d\n", r.ok); break;
    case .error: c::printf("error %d\n", r.error); break;
    }
}

I32 main() {
    show("chain ok", chain(1, 2));
    show("chain, first fails", chain(-1, 2));
    show("chain, second fails", chain(1, -2));
    show("by hand, written error", by_hand(0));
    show("by hand, ok", by_hand(5));
    show("by hand, return r", by_hand(-5));
    c::puts("option ok");
    Option(I32) good = options(3);
    c::printf("%d\n", good == .some ? good.some : -1);
    c::puts("option fails");
    Option(I32) bad = options(-3);
    c::printf("%d\n", bad == .none);
    show("payload ok", payload(6));
    show("payload fails", payload(-6));
    show("block ok", block_scope(2));
    show("block fails", block_scope(-2));
    return 0;
}
