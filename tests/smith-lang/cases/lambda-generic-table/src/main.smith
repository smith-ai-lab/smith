module main;

import <stdio.h>;

typedef struct {
    const char *path;
    I32 (*call)(I32);
} Route;

static I32 add_one(I32 x) {
    return x + 1;
}

static I32 triple(I32 x) {
    return x * 3;
}

// The `http::get` shape: routes with different handlers in one table, each a function pointer that knows its instance.
Route route(const char *path, constexpr auto handler) {
    Route r = {path, [](I32 x) -> I32 { return handler(x); }};
    return r;
}

I32 main() {
    Route table[2] = {route("/a", add_one), route("/b", triple)};
    for (Usize i = 0; i < 2; i++) {
        c::printf("%s %d\n", table[i].path, table[i].call(5));
    }
    return 0;
}
