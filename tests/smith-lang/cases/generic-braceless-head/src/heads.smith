module heads;

import <math.h>;
import same;

// The file names `option`, so the lowering reads each statement ahead for it. A name declared in the head of a
// braceless `for`, `if` or `while` is still declared when the call in the body is typed (issue #475).

static Option(Usize) first_odd(Usize *xs, Usize n) {
    for (Usize i = 0; i < n; i++)
        if (xs[i] % 2 == 1) return {.some = xs[i]};
    return .none;
}

static Bool fifth(Option(Usize) at) {
    if (at == .some) return at.some == 5;
    return false;
}

export I32 run(void) {
    Usize xs[4] = {2, 4, 5, 6};
    Usize total = 0;
    for (Usize i = 0; i < 4; i++)
        if (same::equal(i, xs[i] - 4)) total += i;
    for (Usize i = 0; i < 4; i++)
        total += same::equal(xs[i], xs[i]) ? 1u : 0u;
    for (Usize i = 0; i < 4; i++) total += same::equal(i, i) ? 1u : 0u;
    for (Usize i = 0; i < 2; i++)
        for (Usize j = 0; j < 2; j++)
            if (same::equal(i, j)) total += 10;
    // A variable named like a C function: the clauses of the head are lowered after the parser declared it.
    for (I32 log = 0; log < 3; log++) {
        total += (Usize)log;
    }
    Usize n = 3;
    while (same::equal(n, 3))
        n = 4;
    return fifth(first_odd(xs, 4)) && total == 31 && n == 4 ? 0 : 1;
}
