module main;

import stats;
import <stdio.h>;

struct Point {
    I32 x;
    I32 y;
};

I32 main() {
    I32 raw[4] = {1, 2, 3, 4};
    I32 xs[:] = raw;
    const F64 fs[:] = (F64[3]){1.5, 2.5, 3.5};
    c::printf("%zu %zu %zu\n", stats::count(xs), stats::count(fs), stats::find(xs, 3));
    c::printf("%zu %zu\n", stats::find(fs, 2.5), stats::find(fs, 9.0));
    F32 grid[2][2] = {{1, 2}, {3, 4}};
    F32 g[:][:] = grid;
    c::printf("%zu %g\n", stats::rows(g), (double)stats::zero(g));
    I32 n = 5;
    stats::bump(&n, 2);
    U8 small = 7;
    stats::bump(&small, 1);
    c::printf("%d %d %d\n", n, small, stats::read(&n));
    c::printf("%d %d %d\n", stats::third(raw), stats::second(raw), stats::read(&raw[0]));
    struct Point points[2] = {{1, 2}, {3, 4}};
    struct Point ps[:] = points;
    c::printf("%d %d\n", stats::count(ps) == 2, stats::second(points).y);
    return 0;
}
