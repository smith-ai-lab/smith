module main;

import same;
import <stdio.h>;

I32 main() {
    const char name[:] = "main";
    c::printf("%d %d\n", same::equal(name, "main"), same::equal(name, "mai"));
    U8 from_raw[3] = {1, 2, 3};
    U8 to_raw[3] = {};
    U8 to[:] = to_raw;
    same::copy(to, from_raw);
    U8 from[:] = from_raw;
    same::copy(to[0:2], from[1:3]);
    c::printf("%d %d %d\n", to[0], to[1], to[2]);
    return 0;
}
