module main;
import <stdio.h>;
// `typeof(expr)` in a function over `type` is the type of the expression, as it is anywhere (issue #143).
static Type element(Type t) {
    I32 *p = nullptr;
    if (sizeof(t) > 4) return typeof(*p);
    return t;
}
int main() {
    constexpr Type once = element(F64);
    constexpr Type small = element(U8);
    once x = 1.5;
    small y = 7;
    c::printf("%zu %zu\n", sizeof(x), sizeof(y));
    return 0;
}
