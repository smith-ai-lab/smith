module main;

// `try` inside a larger expression is an error: the order of evaluation would be unclear when it fails (issue #211).
static Result(I32, I32) step(I32 n) {
    return {.ok = n};
}

static I32 twice(I32 n) {
    return n * 2;
}

static Result(I32, I32) call(void) {
    I32 a = twice(try step(1));
    I32 b = 1 + try step(2);
    return {.ok = a + b};
}

I32 main() {
    return call() == .ok ? 0 : 1;
}
