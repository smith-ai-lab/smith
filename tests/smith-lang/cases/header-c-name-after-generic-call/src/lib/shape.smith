module lib::shape;

import lib::gen;

[[std::c_name("ShapeBox")]] export typedef struct {
    Usize size;
} Box;

// A call of a generic on a variable in a body: an importer's header must still name Box by its C name.
export Usize doubled(Box *box, Usize count) {
    return gen::twice(count) + box->size;
}
