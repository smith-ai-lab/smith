module main;

import <stdio.h>;

i32 twice_call(lambda(i32 (i32)) f, i32 x) {
    return f(f(x));
}

i32 main() {
    // two different lambdas are two instances, the same lambda written twice is one
    c::printf("%d\n", twice_call([](i32 a) -> i32 { return a + 1; }, 1));
    c::printf("%d\n", twice_call([](i32 a) -> i32 { return a * 3; }, 1));
    c::printf("%d\n", twice_call([](i32 a) -> i32 { return a + 1; }, 10));
    return 0;
}
