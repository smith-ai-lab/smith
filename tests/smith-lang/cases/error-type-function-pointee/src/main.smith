module main;

import <stdio.h>;

// A pointer's pointee is known one level deep: `T **` cannot be walked twice.
static Type Twice(Type t) {
    if (Pointer(t)) return typeof(*(t)nullptr);
    return t;
}

int main() {
    constexpr Type Once = Twice(I32 *);
    constexpr Type Deep = Twice(Twice(I32 **));
    Once x = 1;
    Deep y = 2;
    c::printf("%d %d\n", x, y);
    return 0;
}
