module main;

// const u8[:] converts to u8[:] only by a cast of the data: the implicit way discards qualifiers, as in C.

static U8 first(U8 xs[:]) {
    return xs[0];
}

static typeof(U8[:]) give(const U8 xs[:]) {
    return xs;
}

I32 main() {
    U8 raw[4] = {1, 2, 3, 4};
    const U8 read[:] = raw;
    U8 same[:] = read;
    U8 other[:] = raw;
    other = read;
    U8 part[:] = read[1:3];
    return first(read);
}
