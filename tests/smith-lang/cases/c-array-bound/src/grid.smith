module grid;
import "k.h";

struct Plain { U8 cells[c::SIDE]; };
typedef struct { U8 cells[c::SIDE][c::depth]; U32 n; } Typed;
struct Nested { struct { U8 x[c::SIDE * 2]; } in; U8 y[c::SIDE + 1]; };
U8 table[c::SIDE];

export struct Board { U8 cells[c::SIDE * c::SIDE]; U32 n; };

export Usize board_size() {
    return sizeof(struct Board);
}

export Usize other_sizes() {
    return sizeof(struct Plain) + sizeof(Typed) + sizeof(struct Nested) + sizeof table;
}
