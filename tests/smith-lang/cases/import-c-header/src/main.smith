import <math.h>;
import <sys/wait.h>;
import <stdio.h>;
import "local.h";

int main() {
    f32 root = c::sqrtf(81.0f);
    int status = 256 * 3;
    c::printf("%.1f %d %d eof=%d %d\n", (double)root, c::WIFEXITED(status), c::WEXITSTATUS(status), c::EOF,
             c::local_value());
    return 0;
}
