module order;

Bool ascending(Num a, typeof(a) b) {
    return a < b;
}

export Usize smallest(constexpr auto less, const auto xs[:]) {
    Usize best = 0;
    for (Usize i = 1; i < countof(xs); i++) {
        if (less(xs[i], xs[best])) best = i;
    }
    return best;
}

export Usize smallest_of(auto xs[:]) {
    return smallest(ascending, xs);
}

export void take(auto x) {
    (void)x;
}

export void take_use() {
    take(ascending);
}

// In an instance the parameter is only called: a generic function has no address.
export Usize address_of(constexpr auto f, auto x) {
    (void)x;
    return (void *)f == nullptr ? 0 : 1;
}

export Usize address_use() {
    return address_of(ascending, 1);
}
