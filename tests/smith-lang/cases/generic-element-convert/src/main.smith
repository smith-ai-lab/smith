module main;

import stats;
import <stdio.h>;

I32 main() {
    U8 raw[3] = {1, 2, 3};
    U8 bytes[:] = raw;
    F32 reals[2] = {1.5f, 2.5f};
    F32 rs[:] = reals;
    U8 small = 3;
    stats::fill(rs, 0.5);
    stats::bump(&small, 1);
    c::printf("%zu %zu %zu\n", stats::find(bytes, 3), stats::find(bytes, small), stats::position(bytes, 2));
    c::printf("%g %d\n", (double)reals[1], small);
    return 0;
}
