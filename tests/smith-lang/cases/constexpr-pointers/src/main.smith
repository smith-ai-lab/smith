// A constexpr object may hold a pointer into a string literal or into another constexpr object (C23 requires null).
import <stdio.h>;

typedef struct {
    const char *ptr;
    I32 len;
} Text;

constexpr char hello[] = "hello world";
constexpr I32 nums[4] = {10, 20, 30, 40};
constexpr const char *word = "abc";
constexpr const char *inside = &hello[1];
constexpr const I32 *third = nums + 2;
constexpr Text small = {"xy", 2};
constexpr Text prefix = {hello, 5};

static I32 length(const char *p) {
    I32 n = 0;
    while (p[n])
        n++;
    return n;
}

static_assert(word[1] == 'b');
static_assert(inside[0] == 'e');
static_assert(*third == 30);
static_assert(small.ptr[1] == 'y' && small.len == 2);
static_assert(prefix.ptr[4] == 'o');
static_assert(length(prefix.ptr) == 11);

I32 main() {
    static constexpr const I32 *kept = nums;
    c::printf("%c %d %s %d\n", word[0], *kept, small.ptr, length(inside));
    return 0;
}
