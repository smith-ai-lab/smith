module main;

import <stdio.h>;
import <stdlib.h>;

typedef struct {
    I32 v;
} Node;

// `for (T x : xs)` loops over a slice or a fixed array with no bounds written by hand. A slice is evaluated once, before
// the loop, and read through its pointer, so the elements need no check.
static I32 sum(const I32 xs[:]) {
    I32 total = 0;
    for (I32 x : xs) {
        total += x;
    }
    return total;
}

// A fixed array and an array parameter that keeps its size; the index comes first, a `Usize` counted from 0.
static I32 weighted(I32 xs[4]) {
    I32 total = 0;
    for (Usize i, I32 x : xs) {
        total += x * (I32)i;
    }
    return total;
}

// A cut loops over its elements: the index runs 0, 1, 2 over `xs[2:5]`.
static I32 cut(I32 xs[:]) {
    I32 total = 0;
    for (Usize i, I32 x : xs[2:5]) {
        total += (I32)i * 100 + x;
    }
    return total;
}

// `T *p` points at each element, so writing through it changes the slice; `T x` is a copy.
static void double_all(I32 xs[:]) {
    for (I32 *p : xs) {
        *p *= 2;
    }
    for (I32 x : xs) {
        x = 0;
    }
}

// A slice of pointers: `Node *n` copies each pointer, `Node **pn` points at each slot.
static I32 nodes(Node *ns[:]) {
    I32 total = 0;
    for (Node *n : ns) {
        total += n->v;
    }
    for (Node **pn : ns) {
        *pn = nullptr;
    }
    return total;
}

// `auto` takes the element's type, and a concept (`arithmetic`) works where `auto` does.
static F64 mean(const F64 xs[:]) {
    F64 total = 0;
    for (auto x : xs) {
        total += x;
    }
    for (Num y : xs) {
        total += y;
    }
    return total / (F64)(2 * countof(xs));
}

// `break`, `continue` and `defer`: a deferred statement runs at the end of each turn.
static I32 control(const I32 xs[:]) {
    I32 total = 0;
    for (I32 x : xs) {
        defer total += 1000;
        if (x == 2) continue;
        if (x == 4) break;
        total += x;
    }
    return total;
}

// `try` returns from the function; loops nest; a body may name the index of an outer loop.
static Result(I32, U8) checked(const I32 xs[:]) {
    I32 total = 0;
    for (I32 x : xs) {
        if (x < 0) return {.error = 1};
        total += x;
    }
    return {.ok = total};
}

static I32 pairs(const I32 a[:], const I32 b[:]) {
    I32 total = 0;
    for (Usize i, I32 x : a) {
        for (Usize j, I32 y : b) {
            total += x * y * (I32)(i + j + 1);
        }
    }
    return total;
}

// What a failed check of a cut or of an index in a generic's body calls.
[[std::c_name("smith_failure")]] export void failure(U8 code) {
    c::exit(code);
}

I32 main() {
    I32 raw[4] = {1, 2, 3, 4};
    I32 more[6] = {10, 20, 30, 40, 50, 60};
    I32 all[:] = raw;
    c::printf("%d %d %d\n", sum(all), weighted(raw), cut(more));
    double_all(all);
    c::printf("%d %d %d %d\n", raw[0], raw[1], raw[2], raw[3]);
    Node a = {5};
    Node b = {6};
    Node *ptrs[2] = {&a, &b};
    Node *pointers[:] = ptrs;
    I32 node_total = nodes(pointers);
    c::printf("%d %d\n", node_total, ptrs[0] == nullptr);
    F64 values[3] = {1.0, 2.0, 6.0};
    F64 view[:] = values;
    I32 five[5] = {1, 2, 3, 4, 5};
    c::printf("%g %d\n", mean(view), control(five));
    I32 odd[4] = {1, 2, 3, 4};
    Result(I32, U8) good = checked(odd);
    I32 negative[2] = {1, -1};
    Result(I32, U8) bad = checked(negative);
    c::printf("%d %d %d\n", good == .ok, bad == .error, pairs(all, odd));
    return 0;
}
