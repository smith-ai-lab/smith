module main;

import repro;
import <stdio.h>;

I32 main() {
    I32 xs[4] = {1, 2, 3, 4};
    I32 w[:] = repro::window(I32, &xs[0], 1, 3);
    c::printf("%zu %d\n", countof(w), w[0]);
    I32 v[:] = repro::plain(&xs[0], 0, 4);
    c::printf("%zu %d\n", countof(v), v[3]);
    F32 fs[3] = {0.5f, 1.5f, 2.5f};
    F32 u[:] = repro::window(F32, &fs[0], 1, 3);
    c::printf("%zu %.1f\n", countof(u), u[1]);
    return 0;
}
