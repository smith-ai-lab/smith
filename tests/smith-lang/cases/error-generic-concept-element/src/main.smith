module main;

import stats;

i32 main() {
    i32 n = 5;
    char *names[2] = {"a", "b"};
    char *ns[:] = names;
    i32 ints[2][2] = {{1, 2}, {3, 4}};
    i32 is[:][:] = ints;
    f32 f = 1.5f;
    stats::count(ns);
    stats::count(n);
    stats::rows(is);
    stats::read(&f);
    stats::third(names);
    return 0;
}
