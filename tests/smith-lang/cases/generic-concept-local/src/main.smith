module main;

import <stdio.h>;

struct Pair {
    i32 a;
};

i32 scaled(i32 k) {
    return k * 3;
}

i32 main(void) {
    Int n = 3;
    Float ratio = 0.5;
    Num total = n + scaled(2);
    Signed delta = -4;
    Unsigned bits = 12u;
    Pointer where = &n;
    Struct pair = (Pair){7};
    c::printf("%d %g %d %d %u %d %d\n", n, ratio, total, delta, bits, *(i32 *)where, pair.a);
    return 0;
}
