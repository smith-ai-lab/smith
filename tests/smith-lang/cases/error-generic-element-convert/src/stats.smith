module stats;
export Usize find(const auto xs[:], typeof(xs[0]) v) { for (Usize i = 0; i < countof(xs); i++) if (xs[i] == v) return i; return countof(xs); }
export void fill(auto xs[:], typeof(xs[0]) v) { for (Usize i = 0; i < countof(xs); i++) xs[i] = v; }
export void bump(auto *p, typeof(*p) by) { *p += by; }
export Usize cmax(const Num xs[:], typeof(xs[0]) v) { return countof(xs) + (Usize)v; }
