import pick;
import "k.h";

int main() {
    U32 count = 7;
    U8 small = 1;
    U32 a = pick::larger(count, 4294967296);
    U32 b = pick::larger(count, -1);
    U8 r3 = pick::larger(small, 256);
    U8 d = pick::larger(small, c::failed);
    U8 e = pick::larger(small, c::Style_Count + 254);
    return a + b + r3 + d + e;
}
