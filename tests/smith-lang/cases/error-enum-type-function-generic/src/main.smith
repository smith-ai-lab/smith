module main;

Type maybe(Type T) {
    return enum {
        T some;
        none;
    };
}

maybe(T) first(constexpr Type T, T *xs, Usize n) {
    if (n == 0) return .none;
    return {.some = xs[0]};
}

I32 main(void) {
    Usize xs[1] = {1};
    // the struct of `maybe(Usize)` is named nowhere at file scope before this call
    first(Usize, xs, 1);
    return 0;
}
