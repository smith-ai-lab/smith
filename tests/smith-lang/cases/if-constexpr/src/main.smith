import kind;
import target;
import <stdio.h>;

constexpr bool fast = target::assertions == false;

int main() {
    i32 answer = 0;
    // In a file with no module line the branches flow the same.
    if constexpr (target::os == 0) {
        undeclared_function();
    } else {
        answer = 7;
    }
    if constexpr (fast) {
        c::printf("assertions are off\n");
    } else if constexpr (target::arch == target::aarch64 || target::arch == target::x86_64) {
        c::printf("answer is seven\n");
    } else {
        c::printf("neither\n");
    }
    c::printf("%d %d %d\n", kind::arch_name(), kind::opaque(5), kind::nested(20));
    c::printf("%d %d %d\n", kind::describe(f32, 1.5f), kind::describe(u64, 9), kind::describe(u8, 1));
    return answer == 7 ? 0 : 1;
}
