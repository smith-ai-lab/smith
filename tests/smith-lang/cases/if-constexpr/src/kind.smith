module kind;

import target;

constexpr I32 wide = 8;
constexpr Bool both = wide == 8 && target::float_radix == 2;

// A chain: the branches not taken are never given to the parser, so they may be anything.
export I32 arch_name() {
    if constexpr (target::arch == target::aarch64) {
        return 1;
    } else if constexpr (target::arch == target::x86_64) {
        return 1;
    } else {
        undeclared_function();
    }
}

// The constraint for another architecture would not compile here.
export I32 opaque(I32 value) {
    if constexpr (target::arch == target::aarch64) {
        __asm__("" : "+w"(value));
    } else if constexpr (target::arch == target::x86_64) {
        __asm__("" : "+r"(value));
    } else {
        __asm__("" : "+nonsense"(value));
    }
    return value;
}

// Nested blocks, constants of the file and of the function, and a condition of literals.
export I32 nested(I32 x) {
    constexpr I32 local = 3;
    I32 result = 0;
    if constexpr (wide == 8) {
        if constexpr (target::os == target::macos) {
            result = 10;
        } else if constexpr (target::os == 0) { // the unknown system: never the one this runs on
            undeclared_function();
        } else {
            result = 10;
        }
        if constexpr (both) {
            result += 1;
        }
        if constexpr (wide < 4) {
            undeclared_function();
        } else {
            result += x;
        }
        if constexpr (local == 3 && !(1 > 2) || false) {
            result += 100;
        }
    }
    if constexpr (0 == 1) {
        undeclared_function();
    }
    return result;
}

// A generic's `if constexpr` still chooses the branch for each instance.
export I32 describe(constexpr Type T, T value) {
    (void)value;
    if constexpr (T == F32) {
        return 1;
    } else if constexpr (sizeof(T) == 8) {
        return 2;
    } else {
        return 3;
    }
}
