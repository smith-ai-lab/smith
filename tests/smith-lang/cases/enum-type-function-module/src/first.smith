module first;

// `maybe(Usize)` written in a module and exported: its struct is in the module's header, guarded, so that the other
// module that writes it, and the importer that writes it too, share one type.

Type maybe(constexpr Type T) {
    return enum {
        T some;
        none;
    };
}

export maybe(Usize) head(Usize v) {
    if (v == 0) return .none;
    return {.some = v};
}
