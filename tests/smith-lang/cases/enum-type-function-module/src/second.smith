module second;

Type maybe(Type T) {
    return enum {
        T some;
        none;
    };
}

// A generic whose outcome is `maybe(usize)`: the instance is written in the importer, against the struct the header
// defines.
export maybe(Usize) position(auto xs, auto v) {
    for (Usize i = 0; i < countof(xs); i++)
        if (xs[i] == v) return {.some = i};
    return .none;
}

export maybe(Usize) last(Usize v) {
    if (v < 2) return .none;
    return {.some = v - 1};
}
