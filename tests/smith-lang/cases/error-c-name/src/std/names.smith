module std::names;

[[std::c_name("smith_names_one")]] export int first() { return 1; }

// the same C name twice
[[std::c_name("smith_names_one")]] export int second() { return 2; }

// the name the prefix makes of an export with no C name
[[std::c_name("smith_names_plain")]] export int third() { return 3; }
export int plain() { return 4; }

// the name the prefix makes of a private one, declared first
int hidden() { return 5; }
[[std::c_name("smith_names_hidden")]] export int fourth() { return 6; }

// a chosen name that a later declaration would also get
[[std::c_name("smith_names_later")]] export int fifth() { return 7; }
int later() { return 8; }

// not an export
[[std::c_name("smith_names_private")]] int sixth() { return 9; }

// not a C identifier, not a keyword, not a string, nor the only thing in the attribute
[[std::c_name("not an identifier")]] export int seventh() { return 10; }
[[std::c_name("int")]] export int eighth() { return 11; }
[[std::c_name(ninth)]] export int ninth() { return 12; }
[[std::c_name("a"), gnu::unused]] export int tenth() { return 13; }

// two on one export
[[std::c_name("smith_names_a")]] [[std::c_name("smith_names_b")]] export int eleventh() { return 14; }

// an export that declares nothing a C name could name
[[std::c_name("smith_names_k")]] export enum { Alpha, Beta };
