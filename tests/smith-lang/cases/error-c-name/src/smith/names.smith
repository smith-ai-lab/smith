module smith::names;

[[smith::c_name("smith_names_one")]] export int first([[maybe_unused]] i32 n) { return 1; }

// the same C name twice
[[smith::c_name("smith_names_one")]] export int second([[maybe_unused]] i32 n) { return 2; }

// the name the prefix makes of an export with no C name
[[smith::c_name("smith_names_plain")]] export int third([[maybe_unused]] i32 n) { return 3; }
export int plain([[maybe_unused]] i32 n) { return 4; }

// the name the prefix makes of a private one, declared first
int hidden() { return 5; }
[[smith::c_name("smith_names_hidden")]] export int fourth([[maybe_unused]] i32 n) { return 6; }

// a chosen name that a later declaration would also get
[[smith::c_name("smith_names_later")]] export int fifth([[maybe_unused]] i32 n) { return 7; }
int later() { return 8; }

// not an export
[[smith::c_name("smith_names_private")]] int sixth() { return 9; }

// not a C identifier, not a keyword, not a string, nor the only thing in the attribute
[[smith::c_name("not an identifier")]] export int seventh([[maybe_unused]] i32 n) { return 10; }
[[smith::c_name("int")]] export int eighth([[maybe_unused]] i32 n) { return 11; }
[[smith::c_name(ninth)]] export int ninth([[maybe_unused]] i32 n) { return 12; }
[[smith::c_name("a"), gnu::unused]] export int tenth([[maybe_unused]] i32 n) { return 13; }

// two on one export
[[smith::c_name("smith_names_a")]] [[smith::c_name("smith_names_b")]] export int eleventh([[maybe_unused]] i32 n) { return 14; }

// an export that declares nothing a C name could name
[[smith::c_name("smith_names_k")]] export enum { Alpha, Beta };
