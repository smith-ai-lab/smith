module pairs;

// An exported type function that returns a struct: the header carries its shape, and an importer's `pairs::Pair(usize)`
// is the same struct as this module's.
export type Pair(type T) {
    return struct {
        T first;
        T second;
        usize count;
    };
}

export Pair(usize) both(usize a, usize b) {
    Pair(usize) both = {.first = a, .second = b, .count = 2};
    return both;
}
