module rows;

export Type slice_of(Type element, Usize count) {
    Type t = element;
    for (Usize i = 0; i < count; i++)
        t = t[:];
    return t;
}

// The result is an option over a slice type that a function computes: the argument of `option` is a call.
export Option(slice_of(T, 1)) view(constexpr Type T, T *xs, Usize n) {
    if (n == 0) return .none;
    return {.some = (struct smith_array_T_n){.data = xs, .count = {n}}};
}
