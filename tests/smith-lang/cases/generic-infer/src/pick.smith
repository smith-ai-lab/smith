module pick;

// T is written at none of the calls in main.smith: the compiler tells it from the arguments.
export T larger(constexpr type T, T a, T b) {
    return a > b ? a : b;
}

export T first_of(constexpr type T, const T *values, usize count) {
    return count > 0 ? values[0] : (T){0};
}

export void set(constexpr type T, T *out, T value) {
    *out = value;
}

export usize size_of_value(constexpr type T, T value) {
    (void)value;
    return sizeof(T);
}

// A call to another generic inside a generic, with the type written (inside a body the compiler does not see a local's
// type, so a call there says it).
export T twice(constexpr type T, T value) {
    return larger(T, value, value);
}
