module parser;

export option(usize) position(const char *text, char wanted) {
    for (usize i = 0; text[i] != 0; i++)
        if (text[i] == wanted) return {.some = i};
    return .none;
}

export result(f64, i32) divide(f64 a, f64 b) {
    if (b == 0) return {.error = 7};
    return {.ok = a / b};
}
