module main;

import reflect;

typedef union {
    I32 a;
    F32 b;
} Either;

typedef struct {
    I32 a;
    struct {
        I32 b;
        I32 c;
    };
} Anonymous;

typedef struct {
    I32 a;
} One;

I32 main() {
    I32 total = 0;
    total += reflect::count_int(I32);
    total += reflect::count_union(Either);
    total += reflect::count_anonymous(Anonymous);
    One one = {1};
    total += reflect::out_of_range(One, &one);
    total += reflect::not_constant(One, &one, 0);
    reflect::odd_name(One);
    return total;
}
