module main;

import stats;

typedef struct {
    i32 a;
} Pair;

i32 main(void) {
    const char *name = "x";
    Pair pair = {1};
    u32 unsigned_value = 4;
    f64 real = 2.0;
    stats::twice(name);
    stats::twice(pair);
    stats::larger(real, 1.0);
    stats::sign_of(unsigned_value);
    stats::width(real);
    return 0;
}
