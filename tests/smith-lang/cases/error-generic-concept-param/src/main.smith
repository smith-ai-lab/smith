module main;

import stats;

typedef struct {
    I32 a;
} Pair;

I32 main(void) {
    const char *name = "x";
    Pair pair = {1};
    U32 unsigned_value = 4;
    F64 real = 2.0;
    stats::twice(name);
    stats::twice(pair);
    stats::larger(real, 1.0);
    stats::sign_of(unsigned_value);
    stats::width(real);
    return 0;
}
