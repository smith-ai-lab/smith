module main;

import <stdio.h>;

// Run-time arrays of more dimensions: `f32 xs[:][2]` (rows of 2) and `xs[:][:]`, any mix. Built by hand from a fixed
// array, indexed `xs[i][j]`, a row `xs[i]` (a `[:]`), counted, sliced within a row, passed on and returned.

struct Grid {
    f32 cells[:][:];
};

static f32 total(f32 rows[:][2]) {
    f32 sum = 0;
    for (usize i = 0; i < countof(rows); i++) {
        for (usize j = 0; j < countof(rows[i]); j++) {
            sum += rows[i][j];
        }
    }
    return sum;
}

static f32 row_sum(f32 row[:]) {
    f32 sum = 0;
    for (usize i = 0; i < countof(row); i++) {
        sum += row[i];
    }
    return sum;
}

static typeof(f32[:][2]) lower(f32 rows[:][2]) {
    return rows[1:countof(rows)];
}

i32 main() {
    f32 raw[4][2] = {{1, 2}, {3, 4}, {5, 6}, {7, 8}};
    f32 pairs[:][2] = raw;
    f32 grid[:][:] = raw;
    c::printf("%zu %zu %zu %zu\n", countof(pairs), countof(pairs[0]), countof(grid), countof(grid[3]));
    c::printf("%g %g %g\n", pairs[2][1], grid[3][0], total(pairs));
    pairs[1][0] = 30;
    f32 row[:] = pairs[1];
    row[1] += 100;
    c::printf("%g %g %g %g\n", raw[1][0], raw[1][1], row_sum(pairs[2]), row_sum(pairs[3][1:2]));
    typeof(f32[:][2]) rest = lower(pairs);
    c::printf("%zu %g %g\n", countof(rest), rest[0][0], total(pairs[1:3]));
    struct Grid held = {.cells = grid};
    held.cells[0][1] = -2;
    c::printf("%zu %g %zu\n", countof(held.cells[2]), raw[0][1], countof(held.cells[1:3]));

    // Three dimensions, 2 by 3 by 4 numbers, the last one fixed: one block, row-major.
    i32 cube[2][3][4] = {};
    for (i32 n = 0; n < 24; n++) {
        cube[n / 12][n / 4 % 3][n % 4] = n;
    }
    i32 deep[:][:][4] = cube;
    i32 plane[:][4] = deep[1];
    i32 line[:] = deep[1][2];
    c::printf("%zu %zu %zu %zu\n", countof(deep), countof(deep[0]), countof(deep[0][0]), countof(plane));
    c::printf("%d %d %d %d\n", deep[0][0][0], deep[1][2][3], plane[1][2], line[1]);
    deep[1][1][1] = 99;
    c::printf("%d %d %d\n", cube[1][1][1], deep[0][2][3], plane[1][1]);
    i32 cut[:] = deep[1][0][1:3];
    c::printf("%zu %d %d\n", countof(cut), cut[0], cut[1]);
    return 0;
}
