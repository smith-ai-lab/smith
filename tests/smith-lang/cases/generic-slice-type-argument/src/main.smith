module main;

import probe;
import <stdio.h>;

I32 main() {
    U8 raw[4] = {1, 2, 3, 4};
    U8 plain[:] = raw;
    constexpr Type PlainType = typeof(plain);
    constexpr Type Wide = U16;
    constexpr Type OtherType = Wide[:];
    c::printf("%d %d %d\n", probe::same_size(plain, PlainType), probe::same_size(plain, OtherType),
              probe::same_size(raw[0], PlainType));
    return 0;
}
