module main;

import <stdio.h>;
import <stdlib.h>;

typedef struct {
    char *names[:];
    i32 n;
} Table;

// What a failed check of an index calls.
[[std::c_name("smith_failure")]] export void failure(u8 code) {
    c::exit(code);
}

// A field `char *names[:]` is a slice of `char *`: the star is kept in `f.type` and in the element's type.
void show(constexpr type T, T *x) {
    for constexpr (usize i = 0; i < countof(fields(T)); i++) {
        constexpr Field f = fields(T)[i];
        if constexpr (is_slice(f.type)) {
            if constexpr (is_pointer(typeof(x->[f][0])) && typeof(x->[f][0]) == char *) {
                c::printf("%.*s: slice of char *\n", (i32)countof(f.name), f.name.data);
            } else {
                c::printf("%.*s: slice of something else\n", (i32)countof(f.name), f.name.data);
            }
        } else {
            c::printf("%.*s: plain\n", (i32)countof(f.name), f.name.data);
        }
    }
}

i32 main() {
    char *words[2] = {"one", "two"};
    Table t = {.names = words[0:2], .n = 2};
    show(Table, &t);
    return 0;
}
