module lone;

// A module that imports nothing still has `option` and `result` in scope, in a plain declaration, in a typedef and in
// a generic.

option(usize) nothing(void) {
    return .none;
}

typedef option(usize) Index;
typedef result(f64, i32) Quotient;

static Index something(usize at) {
    return {.some = at};
}

static Quotient failed(void) {
    return {.error = 7};
}

option(T) first(constexpr type T, T *xs, usize n) {
    if (n == 0) return .none;
    return {.some = xs[0]};
}

static usize or_else(Index at, usize otherwise) {
    if (at == .some) return at.some;
    return otherwise;
}

static usize use_first(void) {
    usize xs[1] = {5};
    return or_else(first(usize, xs, 1), 0);
}
