#include <stddef.h>
#include <stdio.h>

int main() {
    printf("%zu %zu %zu %zu\n", sizeof(U8), sizeof(U16), sizeof(U32), sizeof(U64));
    printf("%zu %zu %zu %zu\n", sizeof(I8), sizeof(I16), sizeof(I32), sizeof(I64));
    printf("%zu %zu\n", sizeof(Usize), sizeof(Isize));
    printf("%zu %zu %zu\n", sizeof(F16), sizeof(F32), sizeof(F64));
    I8 minus = -1;
    U8 wrap = (U8)minus;
    printf("%d %u\n", minus, wrap);
    F32 half = 0.5f;
    F64 wide = half;
    printf("%.2f %.2f\n", (double)half, wide);
    static_assert(_Generic((U64)0, unsigned long long: 1, unsigned long: 1, default: 0), "U64 is an unsigned type");
    static_assert(_Generic((Usize)0, size_t: 1, default: 0), "Usize is size_t");
    static_assert(_Generic((Isize)0, ptrdiff_t: 1, default: 0), "Isize is ptrdiff_t");
    Bool flag = true;
    printf("%d\n", flag);
    return 0;
}
