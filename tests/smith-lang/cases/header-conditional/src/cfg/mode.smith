module cfg::mode;

// Kept verbatim: the includer's flags choose the branch.
#ifdef WIDE
export typedef struct {
    U64 value;
} Cell;
#else
export typedef struct {
    U32 value;
} Cell;
#endif

#if defined(WIDE) && WIDE > 1
export U32 width() {
    return 128;
}
#elif defined(WIDE)
export U32 width() {
    return 64;
}
#else
export U32 width() {
    return 32;
}
#endif

// A branch that holds no export is dropped from the header.
#ifdef UNUSED
static U32 hidden = 1;
#endif

#if 0
export U32 never() {
    return 0;
}
#else
export U32 always() {
    return 1;
}
#endif

#ifdef OUTER
#ifdef INNER
export U32 nested() {
    return 3;
}
#endif
#endif

export U32 plain() {
    return 5;
}
