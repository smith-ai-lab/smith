#include <stdio.h>

// `type` is the keyword only where a declaration begins and C means nothing else; as a variable, a parameter or a
// member it is C's identifier, and `type * n` is a product.
typedef struct {
    int type;
    int size;
} Item;

constexpr type wide = i64;

static int scaled(int type, int n) {
    return (type * n + 1) * 2;
}

static int total(const Item *item, int n) {
    int type = item->type;
    int sum = type * n;
    sum += item->type * item->size;
    return sum;
}

int main(void) {
    Item item = {3, 4};
    wide big = 5;                  // the keyword again, once `type` is out of scope
    printf("%d %d %lld\n", scaled(2, 5), total(&item, 2), (long long)big);
    return 0;
}
