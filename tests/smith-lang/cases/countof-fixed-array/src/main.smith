module main;
import <stdio.h>;

// `countof` of a fixed array is C's own: the outer count, in a plain function and in a generic's instance (issue #167).
struct Grid {
    U32 cells[6];
};

U32 plain() {
    U32 xs[_] = {1, 2, 3};
    return (U32)countof(xs);
}

U32 outer() {
    F32 m[3][5] = {};
    return (U32)countof(m) * 10 + (U32)countof(m[0]);
}

U32 shaped(U32 xs[4]) {
    return (U32)countof(xs);
}

export U32 pack(auto... args) {
    U32 xs[_] = {(U32)args...};
    return (U32)countof(xs);
}

export U32 member(auto g) {
    return (U32)countof(g.cells);
}

I32 main() {
    U32 four[4] = {};
    struct Grid g = {};
    c::printf("%u %u %u %u %u\n", plain(), outer(), shaped(four), pack(1, 2), member(g));
    return 0;
}
