module leaves;

// The type a pointer points to, and a scalar's own: a function over `type` that reads the pointee of a type value in
// C's own way (issue #143).
static Type LeafOf(Type t) {
    if (Pointer(t)) return typeof(*(t)nullptr);
    return t;
}

export LeafOf(T) first(constexpr Type T, T x) {
    if constexpr (Pointer(T)) {
        return *x;
    } else {
        return x;
    }
}
