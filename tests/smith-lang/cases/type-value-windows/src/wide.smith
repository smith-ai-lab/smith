module wide;

// The size of a type value is the target's: `long` is four bytes for Windows and eight elsewhere. A function over a
// type value runs in the compiler with the same answer.
constexpr Type Wide = long;

static Bool long_is_four(Type t) {
    return sizeof(t) == 4;
}

static_assert(!long_is_four(Wide), "long is four bytes here");
static_assert(sizeof(Wide) != 4, "sizeof of a type value is four bytes here");
static_assert(alignof(Wide) != 4, "alignof of a type value is four here");
static_assert(sizeof(char *) == 8);

export I32 eight() {
    return 8;
}
