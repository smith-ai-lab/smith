module main;

typedef struct {
    F32 rows[:][2];
} Grid;

// Part of the rows of a slice member is not written by a generic yet.
F32 one(constexpr Type T, T *x) {
    constexpr Field f = fields(T)[0];
    return x->[f][1][0:1][0];
}

I32 main() {
    F32 r[3][2] = {};
    F32 rows[:][2] = r;
    Grid g = {.rows = rows};
    return (I32)one(Grid, &g);
}
