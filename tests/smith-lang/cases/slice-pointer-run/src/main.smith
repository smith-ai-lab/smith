module main;

import <stdio.h>;

// A pointer to a slice is C's pointer to an array (issue #148): `const char (*text)[:]` as `int (*p)[10]`. `*text` is
// the slice; `&s` passes to it, and a pointer to `char[:]` converts to a pointer to `const char[:]`, not the reverse.

typedef typeof(const char[:]) Text;

static bool take_line(const char (*text)[:], const char (*line)[:]) {
    if (countof(*text) == 0) return false;
    usize n = 0;
    while (n < countof(*text) && (*text)[n] != '\n') n++;
    *line = (*text)[0:n];
    *text = (*text)[n < countof(*text) ? n + 1 : n:];
    return true;
}

static usize length(Text *text) {
    return countof(*text);
}

static void upper_first(char (*xs)[:]) {
    (*xs)[0] = 'X';
}

static usize deep(const char (**pp)[:]) {
    return countof(**pp);
}

static usize rows(const f32 (*m)[:][2]) {
    return countof(*m) * 10 + countof((*m)[0]);
}

i32 main() {
    const char s[:] = "a\nbc\nd";
    const char line[:];
    while (take_line(&s, &line)) {
        c::printf("[%.*s]\n", (int)countof(line), line.data);
    }

    // The same through a typedef, as text and json write their API
    Text t = "one\ntwo";
    Text l;
    usize n = 0;
    while (take_line(&t, &l)) n += length(&l);
    c::printf("%zu\n", n);

    // A pointer to `char[:]` is a pointer to `const char[:]`
    char buf[4] = {'a', 'b', 'c', 'd'};
    char w[:] = buf;
    char (*pw)[:] = &w;
    upper_first(pw);
    const char (*cw)[:] = pw;
    c::printf("%zu %zu %c\n", length(&w), length(pw), (*cw)[0]);

    f32 grid[3][2] = {{1, 2}, {3, 4}, {5, 6}};
    f32 g[:][2] = grid;
    const char (*pcs)[:] = &s;
    c::printf("%zu %zu\n", rows(&g), deep(&pcs));

    // A typedef of a slice type is the slice everywhere
    Text a = "abc";
    typeof(const char[:]) b = "defg";
    char raw[3] = {'x', 'y', 'z'};
    Text r = raw;
    a = "ab";
    r = r[1:];
    static Text fixed = "hello";
    c::printf("%zu %zu %zu %zu\n", countof(a), countof(b), countof(r), countof(fixed));
    return 0;
}
