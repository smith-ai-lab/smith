module main;

import <stdio.h>;
import counts;
import kinds;

// The result type is a function over types applied to the result of another module's ordinary function.
export kinds::SliceOf(T, counts::dims(2, 3)) make(constexpr Type T, Usize rows, Usize columns) {
    struct smith_array_T_n result = {};
    result.count[0] = rows;
    result.count[1] = columns;
    return result;
}

int main() {
    F32 grid[:][:];
    grid = make(F32, 4, 5);
    c::printf("%zu %zu\n", countof(grid), countof(grid[0]));
    return 0;
}
