module inc::chain;

// The header keeps the conditionals around the includes, so the includer's flags choose a spelling.
#include <stdint.h>
#if defined(INC_FIRST)
#include <stdio.h>
#elif defined(INC_SECOND)
#include <stdlib.h>
#if defined(INC_DEEP)
#include <ctype.h>
#endif
#else
#include <string.h>
#endif
#if 0
#include <never.h>
#endif
#ifdef UNRELATED
#define NOTHING 1
#endif
import <math.h>;
#if __has_include("chain_extra.h")
#include "chain_extra.h"
#endif

export u32 length(const char *text) {
    return (u32)strlen(text);
}

export f64 root(f64 value) {
    return c::sqrt(value);
}
