module walk;

import <stdio.h>;

typedef struct {
    I32 id;
    F32 weight;
    F64 scale;
    U8 flag;
} Sample;

typedef struct {
    I32,
    F32
} Pair;

// `fields(T)` is an array of `Field`, a struct with a `name` (a `char[:]`) and a `type`. A field is an ordinary value:
// it can be stored, passed to an ordinary function (which runs in the compiler), returned and compared.
Usize name_length(Field f) {
    return countof(f.name);
}

Bool is_floating(Field f) {
    return Float(f.type);
}

Field first_float(Field a, Field b) {
    return is_floating(a) ? a : b;
}

void show(constexpr Type T, T *x) {
    for constexpr (Usize i = 0; i < countof(fields(T)); i++) {
        constexpr Field f = fields(T)[i];
        c::printf("%.*s(%zu)", (I32)name_length(f), f.name.data, name_length(f));
        if constexpr (is_floating(f)) {
            c::printf("=%g", (F64)x->[f]);
        }
        c::printf(" ");
    }
    c::printf("\n");
}

Usize total_length(constexpr Type T) {
    Usize total = 0;
    for constexpr (Usize i = 0; i < countof(fields(T)); i++) {
        constexpr auto f = fields(T)[i];
        total += name_length(f);
    }
    return total;
}

F64 sum_floats(constexpr Type T, T *x) {
    F64 total = 0;
    for constexpr (Usize i = 0; i < countof(fields(T)); i++) {
        constexpr Field f = fields(T)[i];
        if constexpr (Float(f.type)) {
            typeof(x->[f]) copy = x->[f];
            total += (F64)copy;
        }
    }
    return total;
}

Usize count_integers(constexpr Type T) {
    Usize n = 0;
    for constexpr (Usize i = 0; i < countof(fields(T)); i++) {
        constexpr Field f = fields(T)[i];
        if constexpr (Int(typeof(T.[f]))) {
            n += 1;
        }
    }
    return n;
}

const char *float_name(constexpr Type T) {
    constexpr Field f = first_float(fields(T)[0], fields(T)[1]);
    return f.name.data;
}

Usize second_length(constexpr Type T) {
    const Field *all = fields(T);
    return all[1].name.count[0];
}

export void run() {
    Sample s = {1, 2.5f, 3.0, 4};
    Pair p = {7, 1.5f};
    show(Sample, &s);
    show(Pair, &p);
    c::printf("%zu %zu\n", total_length(Sample), total_length(Pair));
    c::printf("%g %g %zu %zu\n", sum_floats(Sample, &s), sum_floats(Pair, &p), count_integers(Sample),
              count_integers(Pair));
    c::printf("%s %s %zu\n", float_name(Sample), float_name(Pair), second_length(Sample));
}
