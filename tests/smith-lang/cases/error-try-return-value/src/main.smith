module main;

// `try` gives the success value, so returning it as it is returns a `T` where a result is expected, as `return v;`
// does: the fix is `return {.ok = try f()};` (issue #211).
static result(i32, i32) step(i32 n) {
    return {.ok = n};
}

static result(i32, i32) forward(i32 n) {
    return try step(n);
}

i32 main() {
    return forward(1) == .ok ? 0 : 1;
}
