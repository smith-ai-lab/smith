module main;

// `option` and `result` are built in: a module cannot declare its own.

Type Option(constexpr Type T) {
    return enum {
        T some;
        none;
    };
}

Type Result(constexpr Type T, constexpr Type E) {
    return enum {
        T ok;
        E error;
    };
}

I32 main(void) {
    return 0;
}
