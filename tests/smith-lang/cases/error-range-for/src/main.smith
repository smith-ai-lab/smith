module main;

// Each header is wrong in its own way; the loop is replaced by an empty one, so that only the error is reported.
static I32 errors(const I32 xs[:], I32 *p, I32 n, I32 grid[:][2]) {
    I32 t = 0;
    for (I32 x : p) { t += 1; }
    for (I32 x : n) { t += 1; }
    for (I32 x : grid) { t += 1; }
    for (I32 x : xs) t += 1;
    for (I32 i, I32 x : xs) { t += 1; }
    for (Usize i, Usize j, I32 x : xs) { t += 1; }
    for (auto *p : xs) { t += 1; }
    for (Float x : xs) { t += 1; }
    return t;
}
