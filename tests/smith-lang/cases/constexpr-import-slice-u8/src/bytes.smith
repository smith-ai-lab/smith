module bytes;

// The copy below makes the struct of a `const u8[:]` in the body of `fill`, which an importer that runs `fill` at
// compile time reads from this module's `.body`: the file keeps the compiler's name of the type, not `u8`.
export void copy_bytes(auto destination, auto source) {
    for (Usize i = 0; i < countof(destination); i++) destination[i] = source[i];
}

export Usize fill(Usize n) {
    U8 target[4] = {};
    const U8 source[4] = {};
    if (n > 4) {
        U8 destination[:] = target[0:n];
        const U8 from[:] = source[0:n];
        copy_bytes(destination, from);
    }
    return n;
}
