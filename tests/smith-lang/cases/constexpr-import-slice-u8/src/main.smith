module main;

import <stdio.h>;
import <stdlib.h>;
import bytes;

static_assert(bytes::fill(3) == 3);

// What a failed check of an index calls (the library's, in a real program).
[[std::c_name("smith_failure")]] export void failure(u8 code) {
    c::exit(code);
}

int main() {
    c::printf("%zu\n", bytes::fill(2));
    return 0;
}
