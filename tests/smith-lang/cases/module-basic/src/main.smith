import shapes.area as area;
#include <stdio.h>

int main(void) {
    area.Rect r = {3.0, 4.0};
    struct area.Circle c = {2.0};
    printf("%.1f %.1f %.1f\n", area.rect(r), area.circle(c), area.triangle(r));
    printf("%u %u %d %d %d\n", area.calls, area.private_count(), area.Square, area.Round, area.Other);
    printf("%d %u\n", area.kind_of(4) == area.Square, area.sides);
    return 0;
}
