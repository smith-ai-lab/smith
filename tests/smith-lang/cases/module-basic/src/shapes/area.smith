module shapes::area;

export typedef struct { F64 width; F64 height; } Rect;
export struct Circle { F64 radius; };
export enum Kind { Square, Round = 5, Other };
export constexpr U32 sides = 4;
export U32 calls = 0;
export F64 pi = 3.0;

U32 private_calls = 0;

static_assert(sizeof(Rect) == 16);

F64 half(F64 value) {
    private_calls += 1;
    return value / 2;
}

export F64 rect(Rect shape) {
    calls += 1;
    return shape.width * shape.height;
}

export F64 circle(struct Circle shape) {
    calls += 1;
    return pi * shape.radius * shape.radius;
}

export F64 triangle(Rect shape) {
    return half(rect(shape));
}

export U32 private_count() {
    return private_calls;
}

export enum Kind kind_of(U32 side_count) {
    return side_count == sides ? Square : Other;
}
