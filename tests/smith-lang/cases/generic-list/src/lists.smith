module lists;

import <stdio.h>;

// `for constexpr` is C's own `for`, run at compile time and written out turn by turn: `i` is a number in each turn, so
// `rest[i]` is the `i`th argument with its own type. A body that is one statement is the same.
export i32 total(auto... rest) {
    i32 sum = 0;
    for constexpr (usize i = 0; i < countof(rest); i++)
        sum += (i32)rest[i];
    return sum;
}

// `auto name = {...}` is a list: its shape (how many, of which types) is known at compile time, and its elements are
// ordinary run-time values. `weights[i]` is the element, with its own type.
export i32 weighted(auto... rest) {
    auto weights = {1, 2, 3, 4};
    static_assert(countof(weights) == 4);
    i32 sum = 0;
    for constexpr (usize i = 0; i < countof(rest); i++) {
        sum += (i32)rest[i] * weights[i];
    }
    return sum;
}

// Assigning a list in compile-time code makes a new binding (`args_1_...`, `args_2_...`): no variable changes type. The
// loop's body has no braces of its own where it assigns a list declared outside it, so the new variables outlive a turn.
// `args...` expands the elements into the arguments of a call.
export i32 interleaved(auto... rest) {
    auto args = {100};
    for constexpr (usize i = 0; i < countof(rest); i++) {
        args = {args..., (i32)i, rest[i]};
    }
    static_assert(countof(args) == 1 + 2 * countof(rest));
    if constexpr (countof(rest) == 2) {
        char text[64];
        c::snprintf(text, sizeof text, "%d %d %d %d %d", args...);
        c::printf("[%s]\n", text);
    }
    return args[countof(args) - 1];
}

// Lists nest: `args...` is an element expansion in another list, and a list may be empty. A loop counts down, steps by
// two, or runs no turn at all.
export i32 shapes(auto... rest) {
    auto none = {};
    auto both = {none..., rest..., 7};
    i32 sum = 0;
    for constexpr (usize i = countof(both); i > 0; i--)
        sum += (i32)both[i - 1] * (i32)i;
    for constexpr (usize i = 0; i < countof(both); i += 2)
        sum += 1000;
    for constexpr (usize i = 0; i < 0; i++)
        sum += 1;
    return sum + (i32)countof(none);
}

// A list of a different type for each element, a loop in a loop, and `if constexpr` on the loop's variable.
export i32 mixed(auto... rest) {
    auto things = {rest..., 2.5, 'x'};
    i32 sum = 0;
    for constexpr (usize i = 0; i < countof(things); i++) {
        for constexpr (usize j = 0; j < 2; j++) {
            if constexpr (i == 0 && j == 1) {
                sum += 100;
            }
            sum += (i32)things[i];
        }
    }
    return sum;
}
