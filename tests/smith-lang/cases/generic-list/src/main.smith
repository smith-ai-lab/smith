module main;

import lists;
import <stdio.h>;

int main(void) {
    i32 a = lists::total(1, 2, 3);
    i32 b = lists::total();
    i32 c = lists::total((u8)200, (i64)5, 2.5);
    i32 d = lists::weighted(10, 20);
    i32 e = lists::interleaved(5, 6);
    i32 f = lists::interleaved(5);
    i32 g = lists::shapes(1, 2);
    i32 h = lists::shapes();
    i32 k = lists::mixed(1, (u16)2);
    c::printf("%d %d %d | %d | %d %d | %d %d | %d\n", a, b, c, d, e, f, g, h, k);
    return 0;
}
