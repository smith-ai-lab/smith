module main;

// A type has no elements to pick: `t[:]` is the only subscript it takes.
static Type bad(Type T) {
    Type t = T;
    t = t[1:2];
    return t;
}

static Type worse(Type T) {
    return T[:3];
}

int main() {
    constexpr Type q = bad(F32);
    constexpr Type r = worse(F32);
    return 0;
}
