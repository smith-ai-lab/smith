module main;

import order;
import <stdio.h>;
import <stdlib.h>;

// What a failed check of an index calls.
[[std::c_name("smith_failure")]] export void failure(U8 code) {
    c::exit(code);
}

// From a function that is not generic: the generic is named at the call.
static Usize ints_from_main(I32 xs[:]) {
    return order::smallest(order::ascending, xs);
}

int main() {
    I32 ints[3] = {5, 2, 9};
    F64 reals[3] = {2.5, 9.5, 1.5};
    Usize a = ints_from_main(ints[0:3]);
    Usize b = order::smallest(order::ascending, reals[0:3]);
    Usize c = order::smallest_of(ints[0:3]);
    Usize d = order::smallest_of(reals[0:3]);
    c::printf("%zu %zu %zu %zu\n", a, b, c, d);
    return 0;
}
