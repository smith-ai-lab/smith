module cfg::mode;

// Kept verbatim: the includer's flags choose the branch.
#ifdef WIDE
export typedef struct {
    u64 value;
} Cell;
#else
export typedef struct {
    u32 value;
} Cell;
#endif

#if defined(WIDE) && WIDE > 1
export u32 width() {
    return 128;
}
#elif defined(WIDE)
export u32 width() {
    return 64;
}
#else
export u32 width() {
    return 32;
}
#endif

// A branch that holds no export is dropped from the header.
#ifdef UNUSED
static u32 hidden = 1;
#endif

#if 0
export u32 never() {
    return 0;
}
#else
export u32 always() {
    return 1;
}
#endif

#ifdef OUTER
#ifdef INNER
export u32 nested() {
    return 3;
}
#endif
#endif

export u32 plain() {
    return 5;
}
