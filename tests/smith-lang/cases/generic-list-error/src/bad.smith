module bad;

// The bound of a `for constexpr` is a compile-time constant: a parameter is not one.
export i32 run_time_bound(auto x, auto... rest) {
    i32 sum = 0;
    for constexpr (i32 i = 0; i < x; i++) {
        sum += 1;
    }
    return sum;
}

// A list is not a run-time value whose shape could change: it is expanded, indexed or counted.
export i32 bare(auto... rest) {
    auto args = {1, 2};
    return (i32)args;
}

// The shape of a list changes only where the list is declared, not in a branch run at run time, nor in a block.
export i32 shape_changes(auto x, auto... rest) {
    auto args = {1, 2};
    if (x > 0) {
        args = {args..., 3};
    }
    return (i32)countof(args);
}

export i32 shape_changes_in_block(auto... rest) {
    auto args = {1, 2};
    {
        args = {args..., 3};
    }
    return (i32)countof(args);
}

export i32 shape_changes_in_statement(auto x, auto... rest) {
    auto args = {1, 2};
    if (x > 0) args = {args..., 3};
    return (i32)countof(args);
}

// A list is a list of expressions, with an index in range.
export i32 out_of_range(auto... rest) {
    auto args = {1, 2};
    return args[2];
}

export i32 runtime_index(auto x, auto... rest) {
    auto args = {1, 2};
    return args[x];
}

// A loop that never ends, and a step that is none.
export i32 forever(auto... rest) {
    i32 sum = 0;
    for constexpr (usize i = 0; i < 10; i += 0) {
        sum += 1;
    }
    return sum;
}
