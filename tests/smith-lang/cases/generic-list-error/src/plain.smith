module plain;

// `for constexpr` runs once for each instance of a generic: a plain function has none.
export i32 not_generic(i32 x) {
    for constexpr (usize i = 0; i < 2; i++) {
        x += 1;
    }
    return x;
}

// A list literal is `auto name = {...}` in a generic's body and nowhere else.
export i32 not_a_list(i32 x) {
    auto pair = {x, 1};
    return pair;
}
