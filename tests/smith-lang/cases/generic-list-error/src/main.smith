module main;

import bad;
import plain;

int main(void) {
    i32 a = bad::run_time_bound(3);
    i32 b = bad::bare(1);
    i32 c = bad::shape_changes(1);
    i32 d = bad::shape_changes_in_block();
    i32 e = bad::shape_changes_in_statement(1);
    i32 f = bad::out_of_range();
    i32 g = bad::runtime_index(1);
    i32 h = bad::forever();
    i32 p = plain::not_generic(1) + plain::not_a_list(1);
    return a + b + c + d + e + f + g + h + p;
}
