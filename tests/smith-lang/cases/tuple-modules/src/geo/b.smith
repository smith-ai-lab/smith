module geo::b;

import geo::a;

// The same shape in another module is the same type: a tuple made here is passed to a function there.
export I32 twice(struct { I32, F32 } t) {
    return a::sum(t) * 2;
}

// `a::Meters` written here and `Meters` in geo::a are one spelling, so these are one type.
export struct { a::Meters, F32 } mk() {
    return a::reach2(5.0);
}

export a::Reach longer(a::Reach r) {
    struct { a::Meters, F32 } copy = r;
    a::scale(&copy, 2.0);
    return copy;
}
