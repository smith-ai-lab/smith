module main;

typedef Result(I32, I32) Out;

static Option(I32) pick(I32 n) {
    if (n < 0) return .none;
    return {.some = n};
}

// The kind is checked per instance: a function returning result(T, i32) cannot `try` an option.
Result(T, I32) wrong(constexpr Type T, T x) {
    I32 v = try pick(1);
    return {.ok = x};
}

I32 main() {
    Out r = wrong(I32, 1);
    return (I32)sizeof r - (I32)sizeof r;
}
