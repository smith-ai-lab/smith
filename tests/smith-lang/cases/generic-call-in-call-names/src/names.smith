module names;
static I32 sq(I32 x) { return x * x; }
export typeof(x) same(auto x, Usize k) { (void)k; return x; }
export I32 inner(auto p, auto... rest) { return (I32)p + (I32)countof(rest) * 100; }
export I32 a(auto p, auto... rest) { return inner(p, same(sq(rest[0]), 0)); }
export I32 b(auto p, auto... rest) { return inner(p, same(sq(rest[0]) + 1, 0)); }
export I32 c(auto p, auto... rest) { return inner(sq(p), same(sq(rest[0]), 1)); }
