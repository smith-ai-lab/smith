module pairs;

// A function returns a fixed-size array: `T[3]`, written bare. It lowers to a function that returns a struct wrapping
// the array (`struct smith_array_i32_3 { i32 data[3]; }`), and an array is initialized from the call.

export struct Pair {
    i32 left;
    i32 right;
};

export Pair[2] twin(Pair p) {
    return {p, {p.right, p.left}};
}

export i32[3] count_from(i32 start) {
    i32 out[3] = {start, start + 1, start + 2};
    return out;
}

export i32[3] counted(i32 start) {
    return count_from(start);
}

export i32[:] tail(i32 xs[:]) {
    return xs[1:];
}
