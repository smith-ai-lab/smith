module geo::a;

export typedef struct { I32, F32 } Pair;

export struct { I32, F32 } make(I32 a, F32 b) {
    return {a, b};
}

export I32 sum(struct { I32, F32 } t) {
    return t[0] + (I32)t[1];
}

export Pair swap(Pair p, struct { F32, I32 } *other) {
    (*other)[0] = (F32)p[0];
    (*other)[1] = (I32)p[1];
    return {(I32)p[1], (F32)p[0]};
}
