module main;
import <stdio.h>;

// `try` returns the failure of a result or an option at once and gives the success value otherwise (issue #211). It
// is a declaration's initializer, an assignment, a statement of its own, or the payload of a returned variant
// (`return {.ok = try f()};`); the `defer`s already set run on the way out.
static Result(I32, I32) step(I32 n) {
    if (n < 0) return {.error = n};
    return {.ok = n};
}

static Option(I32) pick(I32 n) {
    if (n < 0) return .none;
    return {.some = n};
}

static Result(I32, I32) declared(I32 a, I32 b) {
    defer c::puts("  declared leaves");
    I32 x = try step(a);
    defer c::puts("  second defer");
    I32 y = try step(b);
    return {.ok = x + y};
}

static Result(I32, I32) assigned(I32 a) {
    I32 x = 0;
    x = try step(a);
    try step(a - 1);
    return {.ok = x};
}

static Result(I32, I32) returned(I32 a) {
    return {.ok = try step(a)};
}

static Option(I32) options(I32 a) {
    I32 v = try pick(a);
    return {.some = v * 2};
}

static Option(I32) payload_option(I32 a) {
    return {.some = try pick(a)};
}

static void show(Result(I32, I32) r) {
    switch (r) {
    case .ok: c::printf("ok %d\n", r.ok); break;
    case .error: c::printf("error %d\n", r.error); break;
    }
}

I32 main() {
    show(declared(1, 2));
    show(declared(-1, 2));
    show(declared(1, -2));
    show(assigned(5));
    show(assigned(0));
    show(returned(4));
    show(returned(-4));
    Option(I32) good = options(3);
    Option(I32) bad = options(-3);
    c::printf("%d %d\n", good == .some ? good.some : -1, bad == .none);
    Option(I32) viaPayload = payload_option(7);
    c::printf("%d\n", viaPayload == .some ? viaPayload.some : -1);
    return 0;
}
