module main;

// A number is no type.
static I32 three(Type T) {
    return 3;
}

// A division by zero is no constant.
static Type Divided(Type T, Usize k) {
    return k / (k - k) == 0 ? T : I64;
}

export three(T) not_a_type(constexpr Type T, auto x) {
    return x;
}

export Divided(T, countof(rest)) not_computable(constexpr Type T, auto... rest) {
    return 0;
}

export missing(T) not_declared(constexpr Type T) {
    return 0;
}

int main() {
    not_a_type(U8, (U8)1);
    not_computable(U8, (U8)1);
    not_declared(U8);
    return 0;
}
