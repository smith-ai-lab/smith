module std::arena;

// A C API that keeps its names: the module's prefix would make smith_arena_Arena of these.
[[std::c_name("SmithArena")]] export typedef struct {
    U64 used;
    U64 capacity;
} Arena;

[[std::c_name("smith_arena_create")]] export Arena make(U64 capacity) {
    return (Arena){.used = 0, .capacity = capacity};
}

// No C name: the module's prefix, as before.
export U64 take(Arena *arena, U64 size) {
    if (arena->used + size > arena->capacity) return 0;
    arena->used += size;
    return arena->used;
}

[[std::c_name("smith_arena_limit")]] export U64 limit = 4096;

// Defined in C, by its C name.
[[std::c_name("smith_arena_checksum")]] export U64 checksum(const U8 *data, Usize size);
