module main;

import nouns;
import <stdio.h>;

// The questions of a type are the standard concepts, ordinary functions in scope with no import (issue #193). The is_
// names stay until a release has the new ones.
struct Pair {
    i32 a;
};

enum Color { red, green };
typedef i32 Three[3];
typedef char *Text;

constexpr Type kinds[10] = {I32, U8, F64, Pair, Bool, Text, Color, Three, I32, Usize};
static Type to_slice(Type T) {
    return T[:];
}

constexpr Type sliced = to_slice(I32);

static_assert(Int(kinds[0]) && Int(kinds[1]) && !Int(kinds[2]) && !Int(kinds[4]) && !Int(kinds[6]));
static_assert(Float(kinds[2]) && !Float(kinds[0]));
static_assert(Signed(kinds[0]) && !Signed(kinds[1]) && !Signed(kinds[2]));
static_assert(Unsigned(kinds[1]) && Unsigned(kinds[9]) && !Unsigned(kinds[0]) && !Unsigned(kinds[2]));
static_assert(Num(kinds[0]) && Num(kinds[2]) && !Num(kinds[3]) && !Num(kinds[5]));
static_assert(kinds[4] == Bool && kinds[0] != Bool);
static_assert(Pointer(kinds[5]) && !Pointer(kinds[0]));
static_assert(Enum(kinds[6]) && !Enum(kinds[0]));
static_assert(Struct(kinds[3]) && !Struct(kinds[0]));
static_assert(Array(kinds[7]) && !Array(kinds[0]));
static_assert(Slice(sliced) && !Slice(kinds[5]));
static_assert(Int(kinds[0]) == is_integer(kinds[0]) && Num(kinds[2]) == (is_integer(kinds[2]) || is_float(kinds[2])));

I32 main(void) {
    c::printf("%d %d %d %d\n", (I32)Int(kinds[0]), (I32)Num(kinds[2]), (I32)Unsigned(kinds[2]),
              (I32)Signed(kinds[2]));
    I32 a = 1;
    U8 b = 2;
    F64 c = 3;
    Pair p = {4};
    c::printf("%d %d %d %d %d\n", nouns::kind_of(I32, a), nouns::kind_of(U8, b), nouns::kind_of(F64, c),
              nouns::kind_of(char *, nullptr), nouns::kind_of(Pair, p));
    return 0;
}
