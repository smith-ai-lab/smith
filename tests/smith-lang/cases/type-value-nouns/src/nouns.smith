module nouns;

// The standard concepts are functions of a type, in a generic's `if constexpr` (issue #193).
export I32 kind_of(constexpr Type T, T value) {
    if constexpr (Signed(T)) {
        return 1;
    } else if constexpr (Unsigned(T)) {
        return 2;
    } else if constexpr (Float(T)) {
        return 3;
    } else if constexpr (Pointer(T)) {
        return 4;
    } else if constexpr (Struct(T)) {
        return 5;
    } else if constexpr (Num(T) || Enum(T) || Array(T) || Slice(T)) {
        return 6;
    } else {
        return 0;
    }
}
