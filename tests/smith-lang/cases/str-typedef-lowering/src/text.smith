module text;

export typedef const char Str[:];

export struct Pair {
    Str key;
    Str value;
};

export Usize total(Str xs) {
    return countof(xs);
}

export Str first_word(Str xs) {
    Usize n = 0;
    while (n < countof(xs) && xs[n] != ' ') n++;
    return xs[0:n];
}

export Bool pop(Str *p) {
    if (countof(*p) == 0) return false;
    *p = (*p)[1:];
    return true;
}

export Usize count_of(auto x) {
    if constexpr (Slice(typeof(x))) return countof(x);
    return 0;
}
