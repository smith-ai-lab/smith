module main;

import <stdio.h>;
import geo::units;

extern I32 user(void); // C names the same aliases (user.c)

I32 main() {
    units::Meters m = units::add(1.5, 2.5);
    units::Handler h = units::handler();
    units::Block b = {1, 2};
    units::Request r = {7};
    units::Pointers p = {&r};
    units::Feet f = 0.5f;
    c::printf("%g %d %d %d %g\n", m, h(&r), b[1], p[0]->id, (F64)f);
    return user();
}
