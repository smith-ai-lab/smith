module main;

import <stdio.h>;

struct Pair {
    const char written[:];
    const char sized[:];
};

static const Pair table[2] = {{"unsigned", "u32"}, {"signed", "i32"}};
typedef const char Text[:];
static const Text names[3] = {"a", "bb", "ccc"};

static void put(const char text[:]) {
    c::printf("%.*s\n", (int)countof(text), text.data);
}

i32 main() {
    bool flag = true;
    for (usize i = 0; i < 2; i++) {
        put(table[i].written);
        put(table[i].sized);
    }
    for (usize i = 0; i < 3; i++) put(names[i]);
    str words[2] = {"x", "yz"};
    for (usize i = 0; i < 2; i++) put(words[i]);
    put(flag ? "yes" : "no");
    put(!flag ? "yes" : "no");
    i32 plain[4] = {1, 2, 3, 4};
    c::printf("%d\n", (int)countof(plain));
    return 0;
}
