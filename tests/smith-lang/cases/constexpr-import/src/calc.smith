module calc;

// A function of another module runs at compile time: the importer defines it from this module's `.body` (issue #107).
typedef struct {
    i32 a;
    i32 b;
} Pair;

static i32 twice(i32 n) {
    return n * 2;
}

static i32 sum(Pair p) {
    return twice(p.a) + p.b;
}

export i32 fib(i32 n) {
    i32 a = 0;
    i32 b = 1;
    for (i32 i = 0; i < n; i++) { // a loop: a module has no recursion
        i32 next = twice(a + b) / 2;
        a = b;
        b = next;
    }
    return twice(a) / 2;
}

export i32 combine(i32 a, i32 b) {
    Pair p = {a, b};
    return sum(p);
}

export usize widen(usize n) {
    return n + 1;
}
