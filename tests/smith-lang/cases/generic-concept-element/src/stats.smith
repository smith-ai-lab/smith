module stats;

export Usize count(const Num xs[:]) {
    return countof(xs);
}

export Usize find(const Num xs[:], typeof(xs[0]) v) {
    for (Usize i = 0; i < countof(xs); i++)
        if (xs[i] == v) return i;
    return countof(xs);
}

export Usize rows(Float grid[:][:]) {
    return countof(grid);
}

export typeof(*p) read(const integer *p) {
    return *p;
}

export void bump(arithmetic *p, typeof(*p) by) {
    *p += by;
}

export typeof(xs[0]) third(Num xs[4]) {
    return xs[2];
}

export Usize pair(const Num a[:], const Int b[:]) {
    return countof(a) + countof(b);
}
