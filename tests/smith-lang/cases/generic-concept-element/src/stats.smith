module stats;

export usize count(const arithmetic xs[:]) {
    return countof(xs);
}

export usize find(const arithmetic xs[:], typeof(xs[0]) v) {
    for (usize i = 0; i < countof(xs); i++)
        if (xs[i] == v) return i;
    return countof(xs);
}

export usize rows(floating grid[:][:]) {
    return countof(grid);
}

export typeof(*p) read(const integer *p) {
    return *p;
}

export void bump(arithmetic *p, typeof(*p) by) {
    *p += by;
}

export typeof(xs[0]) third(arithmetic xs[4]) {
    return xs[2];
}

export usize pair(const arithmetic a[:], const integer b[:]) {
    return countof(a) + countof(b);
}
