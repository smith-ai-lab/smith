module main;

import stats;
import <stdio.h>;

i32 main() {
    i32 raw[4] = {1, 2, 3, 4};
    i32 xs[:] = raw;
    const f64 fs[:] = (f64[3]){1.5, 2.5, 3.5};
    c::printf("%zu %zu %zu\n", stats::count(xs), stats::count(fs), stats::find(xs, 3));
    c::printf("%zu %zu\n", stats::find(fs, 2.5), stats::find(fs, 9.0));
    f32 grid[2][2] = {{1, 2}, {3, 4}};
    f32 g[:][:] = grid;
    c::printf("%zu\n", stats::rows(g));
    i32 n = 5;
    stats::bump(&n, 2);
    u8 small = 7;
    stats::bump(&small, 1);
    c::printf("%d %d %d\n", n, small, stats::read(&n));
    c::printf("%d\n", stats::third(raw));
    c::printf("%zu\n", stats::pair(fs, xs));
    return 0;
}
