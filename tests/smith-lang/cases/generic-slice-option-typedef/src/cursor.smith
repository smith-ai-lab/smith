module cursor;

// A generic's `option(slice)` result is named by a caller through a typedef of the slice.

export option(typeof((*xs)[0:0])) take_until(const auto (*xs)[:], typeof((*xs)[0]) stop) {
    for (usize i = 0; i < countof(*xs); i++) {
        if ((*xs)[i] == stop) {
            typeof((*xs)[0:0]) head = (*xs)[0:i];
            *xs = (*xs)[i + 1:];
            return {.some = head};
        }
    }
    return .none;
}
