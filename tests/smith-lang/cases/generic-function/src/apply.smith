module apply;

// A function known at compile time: each distinct function is an instance, and `f` in it is that function's name.
export typeof(x) twice(constexpr auto f, auto x) {
    return f(f(x));
}

// The function's address is what `(void *)f` and `&f` are, and a call through it is direct.
export Usize address_matches(constexpr auto f, auto x) {
    (void)x;
    return (void *)f == (void *)&f ? 1 : 0;
}

// An exported function of the module, the argument of a generic of this module.
export I32 triple(I32 x) {
    return x * 3;
}

// A generic passes its own function on to another generic.
export typeof(x) again(constexpr auto f, auto x) {
    return twice(f, x);
}

// The signature is checked at the instance, as the body calls it.
export F64 call_with_pair(constexpr auto f, auto x, typeof(x) y) {
    return (F64)f(x, y);
}
