module main;

import apply;
import <stdio.h>;
import <stdlib.h>;

static I32 inc(I32 x) {
    return x + 1;
}

static F64 half(F64 x) {
    return x / 2;
}

static I32 plus(I32 a, I32 b) {
    return a + b;
}

int main() {
    I32 a = apply::twice(inc, 5);
    I32 b = apply::twice(apply::triple, 2);
    F64 c = apply::twice(half, 10.0);
    I32 d = apply::twice(c::abs, -3);
    I32 e = apply::again(inc, 0);
    Usize f = apply::address_matches(inc, 1);
    F64 g = apply::call_with_pair(plus, 3, 4);
    c::printf("%d %d %.2f %d %d %zu %.1f\n", a, b, c, d, e, f, g);
    return 0;
}
