module anything;

// `Any` accepts every type (issue #193): a parameter, a rest pack, an element.
export usize width(Any x) {
    return sizeof(x);
}

export typeof(a) pick(Any a, typeof(a) b) {
    return a > b ? a : b;
}

export usize count(Any... rest) {
    return countof(rest);
}

export usize size(const Any xs[:]) {
    return countof(xs);
}
