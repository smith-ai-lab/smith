module main;

import <stdio.h>;
import anything;

i32 main(void) {
    f64 d = 2.5;
    i16 s = 3;
    i32 xs[3] = {7, 8, 9};
    i32 ys[:] = xs;
    c::printf("%zu %zu %zu\n", anything::width(d), anything::width(s), anything::width(&d));
    c::printf("%d %g\n", anything::pick(4, 9), anything::pick(d, 1.5));
    c::printf("%zu %zu\n", anything::count(d, s, &d), anything::count());
    c::printf("%zu\n", anything::size(ys));
    return 0;
}
