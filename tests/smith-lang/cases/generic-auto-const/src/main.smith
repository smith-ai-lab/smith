module main;

import stats;
import <stdio.h>;

I32 main() {
    I32 raw[3] = {1, 2, 3};
    I32 xs[:] = raw;
    const I32 read[:] = xs;
    c::printf("%lld %lld\n", stats::total(xs), stats::total(read));
    stats::fill(xs, 5);
    c::printf("%lld %lld\n", stats::total(xs), stats::total(xs[1:3]));
    return 0;
}
