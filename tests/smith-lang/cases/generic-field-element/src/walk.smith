module walk;

// The element type of a `[:]` field or a fixed array, asked in an `if constexpr`: `typeof(x.[f][0])`.
export I32 describe(auto x) {
    I32 total = 0;
    for constexpr (Usize i = 0; i < countof(fields(typeof(x))); i++) {
        constexpr Field f = fields(typeof(x))[i];
        if constexpr (Slice(typeof(x.[f]))) {
            if constexpr (Float(typeof(x.[f][0]))) {
                total += 1; // a slice of floats
            } else if constexpr (Int(typeof(x.[f][0]))) {
                total += 10; // of integers
            } else if constexpr (Struct(typeof(x.[f][0]))) {
                total += 100; // of structs
            } else {
                total += 1000;
            }
        } else if constexpr (Array(typeof(x.[f]))) {
            if constexpr (Float(typeof(x.[f][0]))) total += 10000; // a fixed array of floats
        }
    }
    return total;
}
