module main;

import walk;
import <stdio.h>;

struct Floats { F64 xs[:]; };
struct Ints { I32 xs[:]; I32 n; };
struct Point { F32 x; F32 y; };
struct Mixed { F32 a[:]; U8 b[:]; F64 fixed[3]; struct Point points[:]; };

int main() {
    struct Floats floats = {};
    struct Ints ints = {};
    struct Mixed mixed = {};
    c::printf("%d %d %d\n", walk::describe(floats), walk::describe(ints), walk::describe(mixed));
    return 0;
}
