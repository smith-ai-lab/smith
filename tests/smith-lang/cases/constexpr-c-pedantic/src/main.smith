module main;
import <stdio.h>;

// A call of an ordinary C function where C requires a constant builds under -Wpedantic -Werror: folding it is no GNU
// extension in a .smith file (issue #166).
static I32 fib(I32 n) {
    I32 a = 0;
    I32 b = 1;
    for (I32 i = 0; i < n; i++) { // a loop: a module has no recursion
        I32 next = a + b;
        a = b;
        b = next;
    }
    return a;
}

static_assert(fib(10) == 55);

enum { Fib7 = fib(7) };

struct Flags {
    U32 low : fib(4) - 1;
    U32 high : 3;
};

static Type Wider(Type a, Type b) {
    return sizeof(a) >= sizeof(b) ? a : b;
}

static_assert(Wider(U8, F64) == F64);

I32 main() {
    I32 n = 13;
    switch (n) {
    case fib(7):
        c::printf("seven %d\n", (I32)Fib7);
        break;
    default:
        c::printf("other %zu\n", sizeof(struct Flags));
        break;
    }
    return 0;
}
