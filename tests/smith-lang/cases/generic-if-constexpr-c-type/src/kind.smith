module kind;

import "shape.h";

// The type of `value` names a struct and a vector of a C header, which `if constexpr` reads like any type.
export I32 of(auto value) {
    (void)value;
    if constexpr (typeof(value) == c::V2) {
        return 2;
    } else if constexpr (typeof(value) == c::F4) {
        return 4;
    } else if constexpr (typeof(value) == const c::V2 *) {
        return 20;
    } else {
        return 0;
    }
}
