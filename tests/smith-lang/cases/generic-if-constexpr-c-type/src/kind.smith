module kind;

import "shape.h";

// T names a struct and a vector of a C header, which `if constexpr` reads like any type.
export i32 of(constexpr type T, T value) {
    (void)value;
    if constexpr (T == c::V2) {
        return 2;
    } else if constexpr (T == c::F4) {
        return 4;
    } else if constexpr (T == const c::V2 *) {
        return 20;
    } else {
        return 0;
    }
}
