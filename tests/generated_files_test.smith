// The guard of AGENTS.md's rule: generated files are build outputs, never committed (issue #466). A tracked file fails
// when its first lines carry a generator's marker (smith's header writer, scripts/protocol.c, tree-sitter), when it
// is under .smith/, or when git would ignore its path (`git ls-files -ci`: .gitignore lists each output's path, so a
// generated file put back where a build writes it is caught even with its marker removed). The test expectations of
// tests/smith-lang/cases/*/expect and tests/smith-fmt hold generated text on purpose and are the exception (and the one
// input of the corpus that is a stale generated header, tests/smith-lang/cases/error-stale-header/src).
// The guard is a test, so `smith check` runs it on every tree the train checks. `pending` names the files of the
// steps of #466 that are not done yet (none: the headers, the protocol code and the parser are outputs).
module generated_files_test;

import std::arena;
import std::format;
import std::mem;
import std::test;
import scratch;

// The tracked files that break the rule, one a line; the repository is its first argument.
constexpr char guard_script[_] =
    "cd \"$1\" || exit 97; { git ls-files -ci --exclude-standard; git ls-files | grep '^[.]smith/'; "
    "git ls-files | grep -v -e '^tests/smith-lang/cases/[^/]*/expect/' -e '^tests/smith-fmt/' -e "
    "'^tests/smith-lang/cases/error-stale-header/src/' "
    "| while IFS= read -r f; do [ -f \"$f\" ] && head -n 5 \"$f\" | grep -qiE '^(//|/[*]|#).*(generated by smith|"
    "generated by scripts/protocol[.]c|@generated by tree-sitter)' && printf '%s\\n' \"$f\"; done; } "
    "| sort -u";

// The files the guard names in the repository at `root` (a shell word): the script is written beside the project, in
// the project's scratch folder, and run with the root as its argument. The text is the test's, in its arena.
static const char *offenders(const scratch::Project *p, const char *root) {
    scratch::write(p, "../guard.sh", guard_script);
    const char *command = format::push("sh ../guard.sh ", root).data;
    return scratch::capture(p, command);
}

// A repository in the project with a .gitignore and files, all added to the index (by force, as a careless `git add
// -f` would).
static void fill_repository(const scratch::Project *p, const char *ignored, const char *files) {
    scratch::Run made = scratch::sh(p, format::push("git init -q . && mkdir -p src include tests/smith-fmt "
                                                    "tests/smith-lang/cases/a/expect/header && ",
                                                    "printf '", ignored, "\\n' > .gitignore && ", files)
                                           .data);
    scratch::expect_status("the repository is made", 0, &made);
    scratch::Run added = scratch::sh(p, "git add -f -A");
    scratch::expect_status("its files are added", 0, &added);
}

export void test_no_tracked_file_of_smith_is_a_generated_one() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::expect_text("tracked generated files", "", offenders(&p, "\"$SMITH_REPO\""));
}

export void test_a_committed_file_with_a_generators_marker_fails() {
    scratch::Project p = scratch::make("repository", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fill_repository(&p, "build/",
                    "printf '// Generated by smith from lib/std/x.smith. Do not edit.\\n' > src/x.h && "
                    "printf '/* Automatically @generated by tree-sitter */\\n' > src/parser.c && "
                    "printf '// dap.c: generated by scripts/protocol.c from a schema.\\n' > src/dap.c && "
                    "printf 'int hand_written;\\n' > src/ok.c");
    scratch::expect_text("the files with a marker", "src/dap.c\nsrc/parser.c\nsrc/x.h\n", offenders(&p, "."));
}

export void test_a_committed_file_at_an_ignored_output_path_fails() {
    scratch::Project p = scratch::make("repository", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fill_repository(&p, "/include/out.h",
                    "printf 'no marker\\n' > include/out.h && "
                    "printf 'int hand_written;\\n' > src/ok.c");
    scratch::expect_text("the file at an ignored path", "include/out.h\n", offenders(&p, "."));
}

export void test_a_file_under_smith_fails() {
    scratch::Project p = scratch::make("repository", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fill_repository(&p, "build/", "mkdir -p .smith/include && printf 'x\\n' > .smith/include/a.h");
    scratch::expect_text("the file under .smith", ".smith/include/a.h\n", offenders(&p, "."));
}

export void test_the_test_expectations_may_hold_generated_text() {
    scratch::Project p = scratch::make("repository", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fill_repository(
        &p, "build/",
        "printf '// Generated by smith from m.smith. Do not edit.\\n' > tests/smith-lang/cases/a/expect/header/m.h && "
        "printf '// Generated by smith from m.smith. Do not edit.\\n' > tests/smith-fmt/corpus.expected");
    scratch::expect_text("the expectations", "", offenders(&p, "."));
}

// A profile a run under coverage leaves (default.profraw once got committed) is a generated file: a tracked one fails.
export void test_a_committed_profile_fails() {
    scratch::Project p = scratch::make("repository", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fill_repository(&p, "*.profraw\\n*.profdata",
                    "printf 'x\\n' > default.profraw && printf 'x\\n' > merged.profdata && "
                    "printf 'int hand_written;\\n' > src/ok.c");
    scratch::expect_text("the profiles", "default.profraw\nmerged.profdata\n", offenders(&p, "."));
}

// smith's own .gitignore lists both kinds, so a profile is never added by accident.
export void test_the_gitignore_of_smith_lists_the_profiles() {
    scratch::Project p = scratch::make("p", nullptr);
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::expect_text("the ignored profiles", "x.profraw\ny.profdata\n",
                         scratch::capture(&p, "cd \"$SMITH_REPO\" && git check-ignore x.profraw y.profdata"));
}
