// What `smith build` says when a build.c uses the high-level and the step calls wrongly, from tests/build.sh sections
// 9i, 9j (smith_compile_command), 9q (.stamp errors), 10 (ninja arguments) and 13a (name collisions): each case is a
// build.c in tests/build_fixtures that the test copies over build.c (the variants are `.txt` files).
module build_stamps_errors_test;

import smith::format;
import smith::io;
import smith::test;
import scratch;

// Copies the variant (`<name>.txt` of the fixture) over build.c and builds.
static scratch::Run build_variant(const scratch::Project *p, const char *name, const char *arguments) {
    scratch::Run copied = scratch::sh(p, format::push("cp ", name, ".txt build.c").data);
    test::check_equal(copied.status, 0);
    return scratch::build(p, arguments);
}

// 9i. High-level errors.
export void test_build_stamps_errors_a_missing_compiler_fails(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "stamp_high_errors");
    scratch::Run run = build_variant(&p, "missing_compiler", "");
    scratch::expect_status("errors: a missing .compiler fails", 2, &run);
    scratch::expect_contains("errors: the message names .compiler", run.err, ".compiler is required");
}

export void test_build_stamps_errors_an_unregistered_object_fails(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "stamp_high_errors");
    scratch::Run run = build_variant(&p, "unregistered", "");
    scratch::expect_status("errors: an unregistered object fails", 2, &run);
    scratch::expect_contains("errors: the message says it was never passed to smith_object", run.err,
                             "never passed to smith_object");
}

export void test_build_stamps_errors_compile_commands_twice_or_under_smith_fails(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "stamp_high_errors");
    scratch::Run twice = build_variant(&p, "twice", "");
    scratch::expect_status("errors: a second smith_compile_commands fails", 2, &twice);
    scratch::expect_contains("errors: the message says twice", twice.err, "twice");
    scratch::Run under = build_variant(&p, "under_smith", "");
    scratch::expect_status("errors: compile_commands under .smith fails", 2, &under);
}

// 9j. smith_compile_command: an entry with no step.
export void test_build_stamps_compile_command_writes_entries_without_a_step(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "stamp_compile_command");
    scratch::Run run = scratch::build(&p, "");
    scratch::expect_status("compile_command: the build succeeds", 0, &run);
    scratch::Run made = scratch::sh(&p, "sed \"s|@DIR@|$(pwd -P)|\" expected.json.in >expected.json");
    test::check_equal(made.status, 0);
    scratch::expect_text("compile_command: the entries, their order, and a covered file skipped",
                         scratch::read(&p, "expected.json"), scratch::read(&p, "compile_commands.json"));
}

export void test_build_stamps_compile_command_without_a_compiler_a_source_or_after_the_file_fails(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "stamp_compile_command");
    scratch::Run compiler = build_variant(&p, "missing_compiler", "");
    scratch::expect_status("errors: a missing compiler for smith_compile_command fails", 2, &compiler);
    scratch::expect_contains("errors: the message names compiler", compiler.err,
                             "smith_compile_command: .compiler is required");
    scratch::Run source = build_variant(&p, "missing_source", "");
    scratch::expect_status("errors: a missing source for smith_compile_command fails", 2, &source);
    scratch::expect_contains("errors: the message names source", source.err,
                             "smith_compile_command: .source is required");
    scratch::Run after = build_variant(&p, "after", "");
    scratch::expect_status("errors: smith_compile_command after smith_compile_commands fails", 2, &after);
    scratch::expect_contains("errors: the message says after", after.err, "after smith_compile_commands");
}

// 9q. .stamp errors: with .outputs, on a task, a different .stamp for an existing output.
export void test_build_stamps_errors_a_stamp_with_outputs_fails(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "stamp_errors");
    scratch::Run run = build_variant(&p, "outputs", "");
    scratch::expect_status("stamp errors: .stamp with .outputs fails", 2, &run);
    scratch::expect_contains("stamp errors: the message names both", run.err, ".stamp");
}

export void test_build_stamps_errors_a_stamp_on_a_task_fails(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "stamp_errors");
    scratch::Run run = build_variant(&p, "task", "");
    scratch::expect_status("stamp errors: .stamp on a task fails", 2, &run);
    scratch::expect_contains("stamp errors: the message says task", run.err, "task t");
}

export void test_build_stamps_errors_a_different_stamp_for_an_output_fails(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "stamp_errors");
    scratch::Run run = build_variant(&p, "differs", "");
    scratch::expect_status("stamp errors: a different .stamp for an output fails", 2, &run);
    scratch::expect_contains("stamp errors: the message names the field", run.err, "whose .stamp differs");
}

export void test_build_stamps_errors_a_run_step_and_a_command_step_both_stamp(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "stamp_errors");
    scratch::Run run = build_variant(&p, "run_and_command", "");
    char text[64];
    __builtin_snprintf(text, sizeof text, "%d %s %s", run.status,
                       scratch::exists(&p, "build/pass.stamp") ? "yes" : "no",
                       scratch::exists(&p, "build/true.stamp") ? "yes" : "no");
    scratch::expect_text("stamp: a .run step and a command step both stamp", "0 yes yes", text);
}

// 10. ninja arguments pass through (the copy project of case 1).
export void test_build_stamps_ninja_arguments_pass_through(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "copy");
    scratch::Run first = scratch::build(&p, "");
    test::check_equal(first.status, 0);
    scratch::Run targets = scratch::build(&p, "-t targets");
    scratch::expect_contains("ninja arguments: -t targets runs ninja's tool", targets.out, "output");
    (void)scratch::sh(&p, "rm output");
    (void)scratch::build(&p, "-n");
    scratch::expect_text("ninja arguments: -n does not build", "no", scratch::exists(&p, "output") ? "yes" : "no");
}

// 13a. Name collisions are all reported in one run, with the fix; two steps with no outputs and equal inputs say to
// give one a .stamp; a build by convention names no build.c (#47).
export void test_build_stamps_collisions_are_reported_in_one_run_with_the_fix(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "collisions");
    scratch::Run run = scratch::build(&p, "");
    scratch::expect_status("collisions: the build file fails", 2, &run);
    scratch::expect_contains("collisions: the task named after a verb", run.err,
                             "smith: build.c: task 'lint' is named after a verb");
    scratch::expect_contains("collisions: the alias that is a task's name, in the same run", run.err,
                             "smith: build.c: alias other: the name is already used by a task; name the alias another "
                             "way");
    scratch::expect_contains("collisions: the alias named after a verb, in the same run", run.err,
                             "alias 'docs' is named after a verb");
    scratch::expect_contains("collisions: two .run steps with equal inputs say what the step is", run.err,
                             "step first check: this step has no outputs");
    scratch::expect_contains("collisions: and the fix", run.err, "give one of them a distinct .stamp");
}

export void test_build_stamps_convention_an_unknown_option_names_no_build_file(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::write(&p, "main.c", "int main(void) { return 0; }\n");
    scratch::Run run = scratch::build(&p, "-Dnope");
    scratch::expect_contains("convention: an unknown option names no build file", run.err,
                             "smith: the build: unknown option -Dnope");
}
