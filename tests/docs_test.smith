}

// --- 4. the verb: with no arguments it checks the current folder, with the types and required fields that
// knowledge/index.md declares in its frontmatter, and the defaults when it declares none ------------------------------

export void test_docs_no_arguments_checks_the_current_folder(io::Io *io) {
    scratch::Project p = fixtures(io);
    scratch::Run run = scratch::sh(&p, "cd pass && smith docs");
    scratch::expect_contains("no arguments: checks the current folder", run.out, "smith docs: 2 concepts");
}

export void test_docs_no_arguments_the_default_types_apply(io::Io *io) {
    scratch::Project p = fixtures(io);
    scratch::Run run = scratch::sh(&p, "cd pass && smith docs");
    scratch::expect_contains("no arguments: the default types apply", run.err,
                             "type 'dataset' is not one of convention, architecture");
}

export void test_docs_no_arguments_problems_exit_1(io::Io *io) {
    scratch::Project p = fixtures(io);
    scratch::Run run = scratch::sh(&p, "cd links && smith docs");
    scratch::expect_status("no arguments: problems exit 1", 1, &run);
}

// The project's docs are in the nearest folder at or above the current one that has an AGENTS.md, stopping at the git
// root: a build.c in a subfolder (virtual-cell/learner) checks its repository's docs.
static scratch::Run in_subfolder(const scratch::Project *p) {
    return scratch::sh(p, "mkdir -p repo/sub/deep && cp -R declared/. repo/ && mkdir repo/.git && "
                          "cd repo/sub/deep && smith docs");
}

export void test_docs_subfolder_the_docs_of_the_folder_above_are_the_projects(io::Io *io) {
    scratch::Project p = fixtures(io);
    scratch::Run run = in_subfolder(&p);
    scratch::expect_status("subfolder: the docs of the folder above are the project's", 0, &run);
}

export void test_docs_subfolder_its_concepts_are_found(io::Io *io) {
    scratch::Project p = fixtures(io);
    scratch::Run run = in_subfolder(&p);
    scratch::expect_contains("subfolder: ... its concepts are found", run.out, "smith docs: 2 concepts, 0 problems");
}

export void test_docs_subfolder_the_search_stops_at_the_git_root(io::Io *io) {
    scratch::Project p = fixtures(io);
    scratch::Run run = scratch::sh(&p, "mkdir -p stray/inner && cp -R declared/. stray/ && "
                                       "mkdir stray/inner/.git stray/inner/sub && cd stray/inner/sub && smith docs");
    scratch::expect_contains("subfolder: the search stops at the git root", run.out, "smith docs: 0 concepts");
}

export void test_docs_declared_types_the_indexs_types_and_requirements_are_the_projects(io::Io *io) {
    scratch::Project p = fixtures(io);
    scratch::Run run = scratch::sh(&p, "cd declared && smith docs");
    scratch::expect_status("declared types: the index's types and requirements are the project's", 0, &run);
}

export void test_docs_declared_types_type_replaces_the_indexs_types(io::Io *io) {
    scratch::Project p = fixtures(io);
    scratch::Run run = scratch::sh(&p, "cd declared && smith docs --type dataset");
    scratch::expect_contains("declared types: --type replaces the index's types", run.err,
                             "type 'contract' is not one of dataset");
}

export void test_docs_declared_types_require_replaces_the_indexs_requirements(io::Io *io) {
    scratch::Project p = fixtures(io);
    scratch::Run run =
        scratch::sh(&p, "cd declared && smith docs --type contract --type dataset --require contract:owner");
    scratch::expect_contains("declared types: --require replaces the index's requirements", run.err,
                             "type 'contract' needs owner");
}

// A build.c changes nothing: the verb is the check whatever the build declares, and it needs no task.
constexpr char other_build[_] = "#include <smith/build.h>\n"
                                "\n"
                                "void build(SmithBuild *b) {\n"
                                "    SmithStep other = {.command = smith_list(b, \"true\", nullptr)};\n"
                                "    smith_task(b, \"other\", &other);\n"
                                "    smith_default(b, other.outputs);\n"
                                "}\n";

static scratch::Project with_build_file(io::Io *io) {
    scratch::Project p = fixtures(io);
    scratch::Run run = scratch::sh(&p, "mkdir verb && cp -R declared/. verb/");
    scratch::expect_status("verb: made", 0, &run);
    scratch::write(&p, "verb/build.c", other_build);
    return p;
}

export void test_docs_build_c_without_a_docs_task_the_verb_checks(io::Io *io) {
    scratch::Project p = with_build_file(io);
    scratch::Run run = scratch::sh(&p, "cd verb && smith docs");
    scratch::expect_status("build.c without a docs task: the verb checks", 0, &run);
}

export void test_docs_build_c_without_a_docs_task_the_check_ran(io::Io *io) {
    scratch::Project p = with_build_file(io);
    scratch::Run run = scratch::sh(&p, "cd verb && smith docs");
    scratch::expect_contains("build.c without a docs task: the check ran", run.out,
                             "smith docs: 2 concepts, 0 problems");
}

static scratch::Run with_a_poem(const scratch::Project *p) {
    scratch::write(p, "verb/knowledge/poem.md", "---\ntype: poem\ntitle: Poem\ndescription: A poem.\n---\n");
    return scratch::sh(p, "cd verb && smith docs");
}

export void test_docs_build_c_a_problem_is_the_verbs_failure(io::Io *io) {
    scratch::Project p = with_build_file(io);
    scratch::Run run = with_a_poem(&p);
    scratch::expect_status("build.c: a problem is the verb's failure", 1, &run);
}

export void test_docs_build_c_the_problem_is_reported(io::Io *io) {
    scratch::Project p = with_build_file(io);
    scratch::Run run = with_a_poem(&p);
    scratch::expect_contains("build.c: the problem is reported", run.err,
                             "knowledge/poem.md: type 'poem' is not one of contract, dataset");
}

export void test_docs_smith_build_docs_is_refused_it_is_a_verb(io::Io *io) {
    scratch::Project p = with_build_file(io);
    scratch::Run run = scratch::sh(&p, "cd verb && smith build docs");
    scratch::expect_status("smith build docs: refused, it is a verb", 2, &run);
}

export void test_docs_smith_build_docs_points_at_the_verb(io::Io *io) {
    scratch::Project p = with_build_file(io);
    scratch::Run run = scratch::sh(&p, "cd verb && smith build docs");
    scratch::expect_contains("smith build docs: points at the verb", run.err, "smith docs");
}

