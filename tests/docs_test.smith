// The project's docs are in the nearest folder at or above the current one that has a knowledge/ or an .agents/skills/,
// stopping at the git root: a build.c in a subfolder (virtual-cell/learner) checks its repository's docs.
static scratch::Run in_subfolder(const scratch::Project *p) {
    return scratch::sh(p, "mkdir -p repo/sub/deep && cp -R declared/. repo/ && mkdir repo/.git && "
                          "cd repo/sub/deep && smith docs");
}

