// Tests for `smith docs`: every rule on the small repositories of tests/docs/fixtures (each breaks one rule; its
// expect.txt is the exact output, stderr then stdout, and the check exits 1 exactly when there are problems), the
// depfile, the options, the verb in a folder, and the types an index declares. They need no compiler except for the
// tests of a build.c. A folder added to tests/docs/fixtures needs a test here: `test_every_fixture_has_a_test` says
// which.
module docs_test;

import smith::format;
import smith::io;
import smith::test;
import <string.h>;
import scratch;

static typeof(const char[:]) slice_of(const char *text) {
    return text[0:c::strlen(text)];
}

// A scratch folder holding a copy of the fixtures (the links in them stay links).
static scratch::Project fixtures(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run run = scratch::sh(&p, "cp -R \"$SMITH_REPO/tests/docs/fixtures/.\" .");
    scratch::expect_status("the fixtures are copied", 0, &run);
    return p;
}

// --- 1. the fixtures: checked, and the output compared whole ---------------------------------------------------------

static void fixture_case(io::Io *io, const char *name) {
    scratch::Project p = fixtures(io);
    scratch::Run run =
        scratch::sh(&p, format::push("args=; [ -f ", name, "/args ] && args=$(cat ", name, "/args); smith docs $args ",
                                     name, " >actual 2>&1; echo $? >status; cat actual")
                            .data);
    test::golden(io, slice_of(format::push("tests/docs/fixtures/", name, "/expect.txt").data), slice_of(run.out));
    // The check exits 1 exactly when there are problems.
    const char *want = scratch::capture(
        &p,
        format::push("case $(tail -n 1 ", name, "/expect.txt) in *\" 0 problems\") echo 0 ;; *) echo 1 ;; esac").data);
    scratch::expect_text(format::push("fixture ", name, ": exit status").data, want,
                         scratch::capture(&p, "cat status"));
}

export void test_every_fixture_has_a_test(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::Run run = scratch::sh(&p, "cd \"$SMITH_REPO/tests/docs/fixtures\" && for f in *; do "
                                       "grep -q \"fixture_case(io, \\\"$f\\\")\" ../../docs_test.smith || echo \"$f\"; "
                                       "done");
    scratch::expect_text("folders of tests/docs/fixtures with no test", "", run.out);
}

// --- 2. the depfile names every file read or found, once, escaped as a compiler's -MF writes it ---------------------

export void test_docs_depfile_the_documents_the_skills_and_what_the_links_point_at(io::Io *io) {
    scratch::Project p = fixtures(io);
    scratch::Run run = scratch::sh(&p, "smith docs --depfile pass.d --target docs.stamp $(cat pass/args) pass "
                                       ">/dev/null 2>&1; cat pass.d");
    test::golden(io, "tests/docs/fixtures/pass/expect.d", slice_of(run.out));
}

export void test_docs_depfile_is_written_when_there_are_problems_too(io::Io *io) {
    scratch::Project p = fixtures(io);
    (void)scratch::sh(&p, "smith docs --depfile bad.d --target docs.stamp $(cat links/args 2>/dev/null) links");
    scratch::expect_text("depfile: written when there are problems too", "yes",
                         scratch::capture(&p, "[ -f bad.d ] && echo yes || echo no"));
}

export void test_docs_depfile_a_links_target_that_is_not_there_is_not_named(io::Io *io) {
    scratch::Project p = fixtures(io);
    (void)scratch::sh(&p, "smith docs --depfile bad.d --target docs.stamp $(cat links/args 2>/dev/null) links");
    scratch::expect_text("depfile: a link's target that is not there is not named", "0",
                         scratch::capture(&p, "grep -c 'gone.md' bad.d"));
}

