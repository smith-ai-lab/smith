// A build.c changes nothing: the verb is the check whatever the build declares, and it needs no task.
constexpr char other_build[_] = "#include <smith/build.h>\n"
                                "\n"
                                "void build(SmithBuild *b) {\n"
                                "    SmithStep other = {.command = smith_list(b, \"true\", nullptr)};\n"
                                "    smith_task(b, \"other\", &other);\n"
                                "    smith_default(b, other.outputs);\n"
                                "}\n";

// The folder verb: the fixture declared with a build.c.
static void add_build_file(const scratch::Project *p) {
    scratch::Run run = scratch::sh(p, "mkdir verb && cp -R declared/. verb/");
    scratch::expect_status("verb: made", 0, &run);
    scratch::write(p, "verb/build.c", other_build);
}

