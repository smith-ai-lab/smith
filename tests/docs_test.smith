// Tests for `smith docs`: every rule on the small repositories of tests/docs/fixtures (each breaks one rule; its
// expect.txt is the exact output, stderr then stdout, and the check exits 1 exactly when there are problems), the
// depfile, the options, the verb in a folder, and the types an index declares. They need no compiler except for the
// tests of a build.c. A folder added to tests/docs/fixtures needs a test here: `test_every_fixture_has_a_test` says
// which.
module docs_test;

import std::arena;
import std::env;
import std::files;
import std::format;
import std::mem;
import std::test;
import <smith_core_docs.h>;
import <string.h>;
import scratch;

static typeof(const char[:]) slice_of(const char *text) {
    return text[0:c::strlen(text)];
}

constexpr Usize check_capacity = 1U << 16;

// The folder of the repository (`name`, relative to $SMITH_REPO) as a path, from the current allocator.
static const char *in_repo(const char *name) {
    env::Value repo = env::get("SMITH_REPO");
    return format::push(repo == .some ? repo.some.data : ".", "/", name).data;
}

// The check of a folder of the repository, in process (smith_core_docs_check): the problems and the summary line, as
// the verb prints them (standard error, then standard output).
static const char *check(const char *name) {
    char *out = mem::alloc_slice(char, check_capacity).data;
    test::check_condition(c::smith_core_docs_check(in_repo(name), out, check_capacity));
    return out;
}

// A scratch folder holding a copy of the fixtures (the links in them stay links); the caller cleans it.
static scratch::Project fixtures() {
    scratch::Project p = scratch::make("p", nullptr);
    scratch::copy_tree(&p, "tests/docs/fixtures", "");
    return p;
}

// --- 1. the fixtures: checked, and the output compared whole ---------------------------------------------------------

// A fixture whose `args` names options (--type, --require) can only be shown through the verb; the others are checked
// in process, and the output compared whole.
static void fixture_case(const char *name) {
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *folder = format::push("tests/docs/fixtures/", name).data;
    const char *args_file = in_repo(format::push(folder, "/args").data);
    files::BytesResult args = files::read_file(args_file[0:c::strlen(args_file)]);
    if (args == .error) {
        test::golden(slice_of(format::push(folder, "/expect.txt").data), slice_of(check(folder)));
        return;
    }
    scratch::Project p = fixtures();
    defer scratch::clean(&p);
    scratch::Run run = scratch::sh(
        &p,
        format::push("smith docs $(cat ", name, "/args) ", name, " >actual 2>&1; echo $? >status; cat actual").data);
    test::golden(slice_of(format::push(folder, "/expect.txt").data), slice_of(run.out));
    // The check exits 1 exactly when there are problems.
    const char *want = scratch::capture(
        &p,
        format::push("case $(tail -n 1 ", name, "/expect.txt) in *\" 0 problems\") echo 0 ;; *) echo 1 ;; esac").data);
    scratch::expect_text(format::push("fixture ", name, ": exit status").data, want,
                         scratch::capture(&p, "cat status"));
}

export void test_every_fixture_has_a_test() {
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::expect_text(
        "folders of tests/docs/fixtures with no test", "",
        scratch::untested_names("tests/docs/fixtures", "tests/docs_test.smith", "fixture_case(", nullptr, nullptr));
}

// --- 2. the depfile names every file read or found, once, escaped as a compiler's -MF writes it ---------------------

export void test_docs_depfile_the_documents_the_skills_and_what_the_links_point_at() {
    scratch::Project p = fixtures();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = scratch::sh(&p, "smith docs --depfile pass.d --target docs.stamp $(cat pass/args) pass "
                                       ">/dev/null 2>&1; cat pass.d");
    test::golden("tests/docs/fixtures/pass/expect.d", slice_of(run.out));
}

export void test_docs_depfile_is_written_when_there_are_problems_too() {
    scratch::Project p = fixtures();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    (void)scratch::sh(&p, "smith docs --depfile bad.d --target docs.stamp $(cat links/args 2>/dev/null) links");
    scratch::expect_text("depfile: written when there are problems too", "yes",
                         scratch::capture(&p, "[ -f bad.d ] && echo yes || echo no"));
}

export void test_docs_depfile_a_links_target_that_is_not_there_is_not_named() {
    scratch::Project p = fixtures();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    (void)scratch::sh(&p, "smith docs --depfile bad.d --target docs.stamp $(cat links/args 2>/dev/null) links");
    scratch::expect_text("depfile: a link's target that is not there is not named", "0",
                         scratch::capture(&p, "grep -c 'gone.md' bad.d"));
}

