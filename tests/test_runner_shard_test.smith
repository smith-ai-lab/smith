// `--shard i/n` of the test runner (#798): CI splits the suite across machines, each running part i of n. A file's
// tests stay together, every test is in exactly one part, and the split is balanced by the --costs file. The fixture
// tests/build_fixtures/runner_shard has four test files (alpha 3 tests, beta 2, gamma 1, delta 1); the runner only
// lists here (--list), so the processes are the runner's own.
// smith-covers: smith.c runtime/build_runtime.c runtime/executor*.c runtime/slots.c runtime/lang*.c runtime/verbs.c
// smith-covers: runtime/cache.c runtime/sdk_cache.c runtime/platform_*.c runtime/quiet.c runtime/base.h
// smith-covers: runtime/symbolize.c runtime/explain.c shim/symbolize.cpp shim/lldb_explain.* shim/clang.cpp
// smith-covers: shim/hook.cpp shim/lld.cpp include/smith/ lib/trace.c lib/std/test.smith lib/std/arena.smith
// smith-covers: lib/std/random.smith lib/std/mem.smith lib/std/contract.smith lib/std/clock.smith lib/std/console.smith
// smith-covers: lib/std/env.smith lib/std/files.smith lib/std/math.smith lib/std/failing.smith tests/runner.smith
// smith-covers: tests/build_fixtures/runner_*/
module test_runner_shard_test;

import std::arena;
import std::format;
import std::mem;
import std::test;
import runner;
import scratch;

// `first | second` as a shell command.
static const char *format_pipe(const char *first, const char *second) {
    return format::push(first, " | ", second).data;
}

// The runner's arguments for one --shard value.
static const char *format_flag(const char *value) {
    return format::push("--list --shard ", value).data;
}

export void test_runner_shard_the_parts_hold_every_test_once() {
    scratch::Project p = runner::built_project("runner_base", "runner_shard", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *every = "for i in 1 2 3; do build/tests --list --shard $i/3; done";
    scratch::expect_text("shard: the parts of 3 hold the 7 tests", "7",
                         scratch::capture(&p, format_pipe(every, "awk 'END { print NR }'")));
    scratch::expect_text("shard: ... none twice", "", scratch::capture(&p, format_pipe(every, "sort | uniq -d")));
    scratch::expect_text("shard: ... the same as the whole list", "",
                         scratch::capture(&p, "{ build/tests --list; for i in 1 2 3; do build/tests --list --shard "
                                              "$i/3; done; } | sort | uniq -c | awk '$1 != 2'"));
}

export void test_runner_shard_a_file_is_in_one_part() {
    scratch::Project p = runner::built_project("runner_base", "runner_shard", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *files = "for i in 1 2 3; do build/tests --list --shard $i/3 | sed 's/::[^:]*$//' | sort -u; done";
    scratch::expect_text("shard: no file is in two parts", "",
                         scratch::capture(&p, format_pipe(files, "sort | uniq -d")));
    scratch::expect_text("shard: ... and each of the 4 files is in a part", "4",
                         scratch::capture(&p, format_pipe(files, "awk 'END { print NR }'")));
}

export void test_runner_shard_the_split_is_balanced_by_the_costs_file() {
    scratch::Project p = runner::built_project("runner_base", "runner_shard", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write(&p, "costs.tsv", "cpu\t20\tshard::gamma_test::gamma_1\n");
    scratch::Run heavy = runner::tests(&p, "", "--list --shard 1/2 --costs costs.tsv");
    scratch::expect_text("shard: the costly file is alone in its part", "shard::gamma_test::gamma_1", heavy.out);
    scratch::expect_text(
        "shard: ... and the other three files share the second", "6",
        scratch::capture(&p, "build/tests --list --shard 2/2 --costs costs.tsv | awk 'END { print NR }'"));
}

export void test_runner_shard_a_run_prints_its_part_and_runs_only_it() {
    scratch::Project p = runner::built_project("runner_base", "runner_shard", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run run = runner::tests(&p, "", "--shard 1/1 --test gamma_test");
    scratch::expect_contains("shard: a run says which part it is", run.out, "shard 1 of 1: 1 tests");
    scratch::expect_contains("shard: ... and runs its tests", run.out, "1 passed, 0 failed");
}

export void test_runner_shard_a_bad_value_is_a_usage_error() {
    scratch::Project p = runner::built_project("runner_base", "runner_shard", "");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    const char *values[_] = {"0/2", "3/2", "2", "a/b", "1/0", "1/2000"};
    for (Usize i = 0; i < countof(values); i++) {
        scratch::Run run = runner::tests(&p, "", format_flag(values[i]));
        scratch::expect_contains(values[i], run.out, "usage:");
    }
}

// `smith test --shard` compiles only the files of its part (#1200): the parts built alone list what the same parts of a
// full build list, and part 3, with two of the four test files, has two test objects (and the test library's). The
// listing is the runner's, so the processes are smith's build and the runner's own.
export void test_runner_shard_a_part_built_alone_is_the_same_part_of_a_full_build() {
    scratch::Project p = runner::project("runner_base", "runner_shard");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write(&p, "costs.tsv", "cpu\t20\tshard::gamma_test::gamma_1\n");
    const char *full = scratch::capture(
        &p, "SMITH_OUTPUT=full smith build build/tests >/dev/null 2>&1; for i in 1 2 3; do build/tests --list --shard "
            "$i/3 --costs costs.tsv | sed \"s/^/$i /\"; done");
    const char *objects = scratch::capture(&p, "ls build/tests_objects | grep -c '_test.o$'");
    const char *alone = scratch::capture(
        &p,
        "rm -rf build; for i in 1 2 3; do SMITH_OUTPUT=full smith test --list --shard $i/3 --costs costs.tsv 2>&1 | "
        "grep '^shard::' | sed \"s/^/$i /\"; done");
    const char *part_objects = scratch::capture(
        &p, "rm -rf build; SMITH_OUTPUT=full smith test --list --shard 3/3 --costs costs.tsv >/dev/null 2>&1; ls "
            "build/tests_objects | grep -c '_test.o$'");
    scratch::expect_text("shard: the parts built alone list the tests of the parts of a full build", full, alone);
    scratch::expect_text("shard: a full build has the four test objects and the library's", "5", objects);
    scratch::expect_text("shard: ... and the part built alone has the two of its files and the library's", "3",
                         part_objects);
}
