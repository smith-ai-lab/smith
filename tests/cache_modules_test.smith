// The module cache shared by every project, from tests/cache.sh sections 5 and 6 (issue #292): SDK modules built
// once, and two worktrees with different headers at the same relative path that do not collide. Every case has a cache
// of its own (scratch::own_cache), so the real ~/.cache/smith is never touched. The functions of
// tests/build_fixtures/cache_modules/prelude count the cache's modules.
module cache_modules_test;

import smith::format;
import smith::io;
import smith::test;
import scratch;

static scratch::Project modules_project(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", "cache_modules");
    scratch::own_cache(&p);
    return p;
}

static const char *text(const scratch::Project *p, const char *body) {
    return scratch::capture(p, format::push(&p->io->arena, ". ./prelude; ", body).data);
}

// Builds a folder beside the project and says what its program prints.
static void builds_and_runs(const scratch::Project *p, const char *folder, const char *name, const char *output) {
    scratch::Run built = scratch::sh(p, format::push(&p->io->arena, "cd ../", folder, " && smith build").data);
    scratch::expect_status(name, 0, &built);
    scratch::expect_text(name, output,
                         scratch::capture(p, format::push(&p->io->arena, "cd ../", folder, " && ./build/app").data));
}

export void test_cache_modules_the_second_clone_does_not_rebuild_the_sdk_modules(io::Io *io) {
    scratch::Project p = modules_project(io);
    scratch::Run cloned = scratch::sh(&p, "cp -R . ../two");
    scratch::expect_status("the clone of the project", 0, &cloned);
    scratch::Run first = scratch::build(&p, "");
    scratch::expect_status("modules: the first project builds with a cold cache", 0, &first);
    scratch::expect_text("modules: the first project builds with a cold cache (it runs)", "7",
                         scratch::capture(&p, "./build/app"));
    scratch::expect_text("modules: the cache is the shared one and holds modules", "yes",
                         text(&p, "[ \"$(count_modules)\" -gt 0 ] && echo yes || echo no"));
    scratch::Run listed = scratch::sh(&p, "smith cache");
    scratch::expect_contains("modules: smith cache counts its entries", listed.out,
                             format::push(&io->arena, "modules: ", p.cache, "/smith/modules").data);
    const char *before = text(&p, "sdk_signature");
    builds_and_runs(&p, "two", "modules: the second clone builds", "7");
    scratch::expect_text("modules: clang keeps its pruning timestamp in the shared cache", "yes",
                         text(&p, "exists \"$(ls -d $modules/*/modules.timestamp | head -1)\""));
    scratch::expect_text("modules: the second clone's cold build did not rebuild the SDK modules (names and times "
                         "unchanged)",
                         before, text(&p, "sdk_signature"));
}

export void test_cache_modules_worktrees_with_different_headers_do_not_collide(io::Io *io) {
    scratch::Project p = modules_project(io);
    scratch::Run cloned = scratch::sh(&p, "cp -R . ../two && cp -R . ../three");
    scratch::expect_status("the clones of the project", 0, &cloned);
    scratch::Run first = scratch::build(&p, "");
    scratch::expect_status("the first project builds", 0, &first);
    scratch::Run changed =
        scratch::sh(&p, "cd ../three && printf '#include \"inc/v.h\"\\nint value(void) { return 9; }\\n' >value.c && "
                        "printf '#pragma once\\nint value(void);\\nint extra(void);\\n' >inc/v.h && "
                        "printf '#include \"inc/v.h\"\\nint extra(void) { return 1; }\\n' >extra.c");
    scratch::expect_status("the worktree with another header", 0, &changed);
    scratch::Run third = scratch::sh(&p, "cd ../three && smith build");
    scratch::expect_status("modules: a worktree with a different inc/v.h builds", 0, &third);
    scratch::expect_text("modules: and runs its own code", "9", scratch::capture(&p, "cd ../three && ./build/app"));
    scratch::Run again = scratch::build(&p, "");
    scratch::expect_status("modules: the first still builds after it", 0, &again);
    scratch::expect_text("modules: and still runs its own code", "7", scratch::capture(&p, "./build/app"));
    scratch::Run second = scratch::sh(&p, "cd ../two && rm -rf build && smith build");
    scratch::expect_status("modules: a clean build of the second still works", 0, &second);
    scratch::expect_text("modules: a clean build of the second still works (it runs)", "7",
                         scratch::capture(&p, "cd ../two && ./build/app"));
}

// Two smiths that share one cache (issue #575): the module cache is a folder of each smith's LC_UUID, so neither reads
// the modules the other built (a stddef.h of another resource folder is not this one's). The second smith is a copy of
// the first with its LC_UUID changed and the signature made again.
export void test_cache_modules_two_smiths_sharing_a_cache_use_a_folder_each(io::Io *io) {
    scratch::Project p = modules_project(io);
    scratch::Run second = scratch::sh(
        &p, "S=$(command -v smith) && mkdir -p ../other && cp -c \"$S\" ../other/smith 2>/dev/null || cp \"$S\" "
            "../other/smith; id=$(dwarfdump --uuid ../other/smith | sed -n '1s/UUID: \\([0-9A-F-]*\\).*/\\1/p' | tr -d "
            "- | tr A-F a-f); [ -n \"$id\" ] && head -c 16384 ../other/smith | xxd -p | tr -d '\\n' | sed "
            "\"s/$id/0123456789abcdef0123456789abcdef/\" | xxd -r -p | dd of=../other/smith conv=notrunc bs=1 "
            "2>/dev/null && codesign -f -s - ../other/smith 2>/dev/null; ln -sf smith ../other/smith-cc; echo done");
    scratch::expect_text("two smiths: the copy is made", "done\n", second.out);
    scratch::Run first_build = scratch::build(&p, "");
    scratch::expect_status("two smiths: the first smith builds", 0, &first_build);
    scratch::Run other_build = scratch::sh(&p, "rm -rf build .smith && ../other/smith build");
    scratch::expect_status("two smiths: the second smith builds into the same cache", 0, &other_build);
    scratch::expect_text("two smiths: and the program runs", "7", scratch::capture(&p, "./build/app"));
    scratch::expect_text("two smiths: one module folder each", "2",
                         text(&p, "ls -d \"$modules\"/*/ | wc -l | tr -d ' '"));
    scratch::expect_text("two smiths: each folder holds modules", "2",
                         text(&p, "for d in \"$modules\"/*/; do find \"$d\" -name '*.pcm' | head -1; done | wc -l | "
                                  "tr -d ' '"));
}

// Pruning on use (issue #575): of the folders of other smiths the three most recently used stay, the others go once
// idle for a day, and a folder a running smith holds stays whatever its age. Hours ago: r1 1, f1 30, f2 50, f3 70, f4
// 90, f5 110 (f5 held by a process that has its lock).
export void test_cache_modules_old_folders_of_other_smiths_are_pruned_on_use(io::Io *io) {
    scratch::Project p = modules_project(io);
    scratch::Run made = scratch::sh(
        &p, "m=$XDG_CACHE_HOME/smith/modules; mkdir -p $m; ago() { touch -t \"$(date -v-$1H +%Y%m%d%H%M 2>/dev/null "
            "|| date -d \"$1 hours ago\" +%Y%m%d%H%M)\" \"$2\"; }; for f in r1:1 f1:30 f2:50 f3:70 f4:90 f5:110; do "
            "mkdir -p $m/${f%:*}; : >$m/${f%:*}/.used; ago ${f#*:} $m/${f%:*}/.used; done; "
            "perl -MFcntl=:flock -e 'open F, \">>\", $ARGV[0]; flock F, LOCK_SH; sleep 40' $m/f5/.in-use & "
            "holder=$!; sleep 1; smith build >/dev/null 2>&1; echo \"built $?\"; kill $holder");
    scratch::expect_text("pruning: the build runs while the lock is held", "built 0\n", made.out);
    scratch::expect_text("pruning: the recent three and the held one stay, the rest go", "f1 f2 f5 r1",
                         scratch::capture(&p, "cd $XDG_CACHE_HOME/smith/modules && ls -d */ | tr -d "
                                              "/ | grep -v '^[0-9a-f]\\{32\\}$' | tr '\\n' ' ' | sed 's/ $//'"));
    scratch::expect_text(
        "pruning: this smith's folder is there", "1",
        scratch::capture(&p, "ls -d $XDG_CACHE_HOME/smith/modules/*/ | grep -c '/[0-9a-f]\\{32\\}/$'"));
}

// Stable hashes (issue #618): clang puts a module in a folder named by the hash of the compile's flags, so builds whose
// flags are the same share one folder, whatever folder the project is in. Two clones of one project, built from two
// folders of the scratch folder, leave one context-hash folder in this smith's folder, not one for each.
export void test_cache_modules_builds_in_different_folders_share_one_context_hash_folder(io::Io *io) {
    scratch::Project p = modules_project(io);
    scratch::Run cloned = scratch::sh(&p, "cp -R . ../two && cp -R . ../three");
    scratch::expect_status("the clones of the project", 0, &cloned);
    scratch::Run first = scratch::build(&p, "");
    scratch::expect_status("the first folder builds", 0, &first);
    builds_and_runs(&p, "two", "modules: the second folder builds", "7");
    builds_and_runs(&p, "three", "modules: the third folder builds", "7");
    scratch::expect_text("modules: one context-hash folder holds the modules of all three", "1",
                         text(&p, "ls -d \"$modules\"/*/*/ | wc -l | tr -d ' '"));
}

// The cap on the folders (issue #618): four folders of other smiths of 400 kB, the oldest (100 hours; held by a running
// smith too: 300) and a build with SMITH_CACHE_MAX=1000k. The least recently used goes, the one a process holds stays,
// and so do the younger.
export void test_cache_cap_the_least_recently_used_folder_goes_and_one_in_use_stays(io::Io *io) {
    scratch::Project p = modules_project(io);
    scratch::Run made = scratch::sh(
        &p, ". ./prelude; m=$modules; mkdir -p $m; for f in a:100 b:50 c:2 h:300; do mkdir -p $m/${f%:*}; "
            "head -c 400000 /dev/zero >$m/${f%:*}/x.pcm; : >$m/${f%:*}/.used; ago ${f#*:} $m/${f%:*}/.used; done; "
            "perl -MFcntl=:flock -e 'open F, \">>\", $ARGV[0]; flock F, LOCK_SH; sleep 40' $m/h/.in-use & "
            "holder=$!; sleep 1; SMITH_CACHE_MAX=1000k smith build >/dev/null 2>&1; echo \"built $?\"; kill $holder");
    scratch::expect_text("cap: the build runs while the lock is held", "built 0\n", made.out);
    scratch::expect_text("cap: the least recently used folder is gone, the held and the younger stay", "b c h",
                         scratch::capture(&p, "cd $XDG_CACHE_HOME/smith/modules && ls -d */ | tr -d / | "
                                              "grep -v '^[0-9a-f]\\{32\\}$' | tr '\\n' ' ' | sed 's/ $//'"));
}

// The cap on this smith's own folder: when the folders of others cannot make room, its module files go, least recently
// used first, but never one used in the last hour (a build's own).
export void test_cache_cap_this_smiths_old_module_files_go_when_the_cache_is_over_the_cap(io::Io *io) {
    scratch::Project p = modules_project(io);
    scratch::Run first = scratch::build(&p, "");
    scratch::expect_status("cap: the first build fills the folder", 0, &first);
    scratch::Run second = scratch::sh(
        &p, ". ./prelude; own=$(ls -d $modules/*/ | grep '/[0-9a-f]\\{32\\}/$' | head -1); mkdir -p $own/old; "
            "head -c 400000 /dev/zero >$own/old/a.pcm; head -c 400000 /dev/zero >$own/old/b.pcm; "
            "ago 100 $own/old/a.pcm; ago 50 $own/old/b.pcm; "
            "kb=$(du -sk $modules | cut -f1); SMITH_CACHE_MAX=$((kb * 1024 - 300000)) smith build >/dev/null 2>&1; "
            "echo \"built $? $(exists $own/old/a.pcm) $(exists $own/old/b.pcm)\"");
    scratch::expect_text("cap: the oldest module file goes, the younger stays", "built 0 no yes", second.out);
    scratch::expect_text("cap: the module files of the last build stay", "yes",
                         text(&p, "[ \"$(count_modules)\" -gt 1 ] && echo yes || echo no"));
}

// The cleaning after `smith build llvm` (issue #618, scripts/llvm_prune.c): every LLVM folder of the cache goes, with
// its Enzyme, but the one just built and the previous release's. The whole tree is in the test's scratch folder; the
// real
// ~/.cache/smith/llvm is never read.
constexpr char make_tree[_] =
    "mkdir -p c/smith/llvm c/smith/enzyme; for n in r8:none r9:bbb r10:aaa r11:ccc; do d=c/smith/llvm/23.1.3-${n%:*}; "
    "mkdir -p $d/install/lib $d/build; [ ${n#*:} = none ] || echo \"llvm-23.1.3 ${n#*:}\" "
    ">$d/install/lib/smith-clang.id; "
    "echo x >$d/build/big; mkdir -p c/smith/enzyme/0.0.303-23.1.3-${n%:*}/lib; done; "
    "smith cc -std=c23 scripts/llvm_prune.c -o prune && echo made";

export void test_llvm_prune_keeps_the_new_build_and_the_previous_releases_and_removes_the_rest(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::copy_tree(&p, "scripts/llvm_prune.c", "scripts/llvm_prune.c");
    scratch::own_cache(&p);
    scratch::Run made = scratch::sh(&p, make_tree);
    scratch::expect_text("prune: the tree and the tool are made", "made", made.out);
    scratch::Run pruned = scratch::sh(&p, "./prune $PWD/c/smith/llvm 23.1.3-r11 'llvm-23.1.3 aaa'");
    scratch::expect_status("prune: the tool runs", 0, &pruned);
    scratch::expect_contains("prune: it says what it removed", pruned.out, "23.1.3-r9");
    scratch::expect_text("prune: the new build, the previous release's and one with no id (in progress) stay",
                         "23.1.3-r10 23.1.3-r11 23.1.3-r8",
                         scratch::capture(&p, "ls c/smith/llvm | tr '\\n' ' ' | sed 's/ $//'"));
    scratch::expect_text("prune: Enzyme of a removed build goes, the others stay",
                         "0.0.303-23.1.3-r10 0.0.303-23.1.3-r11 0.0.303-23.1.3-r8",
                         scratch::capture(&p, "ls c/smith/enzyme | tr '\\n' ' ' | sed 's/ $//'"));
}

export void test_llvm_prune_without_a_previous_identity_keeps_only_the_new_build(io::Io *io) {
    scratch::Project p = scratch::project(io, "p", nullptr);
    scratch::copy_tree(&p, "scripts/llvm_prune.c", "scripts/llvm_prune.c");
    scratch::own_cache(&p);
    scratch::Run made = scratch::sh(&p, make_tree);
    scratch::expect_text("prune: the tree and the tool are made", "made", made.out);
    scratch::Run pruned = scratch::sh(&p, "./prune $PWD/c/smith/llvm 23.1.3-r11 ''");
    scratch::expect_status("prune: the tool runs", 0, &pruned);
    scratch::expect_text("prune: the new build and the one with no id stay", "23.1.3-r11 23.1.3-r8",
                         scratch::capture(&p, "ls c/smith/llvm | tr '\\n' ' ' | sed 's/ $//'"));
}
