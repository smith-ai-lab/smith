// Tests of the generated protocol code (knowledge/protocol-generation.md, from tests/protocol.sh):
// .smith/protocol/dap.[ch] and mcp.[ch], which the build writes with scripts/protocol.c from DAP's and MCP's schemas
// (schemas/), and the tests
// it writes with them (tests/protocol/test_protocol_*.c: a round trip for every type and a refusal for every missing
// required member). They are built in a scratch project with smith_tests (tests/build_fixtures/protocol/build.c), in
// two builds: -O0 under AddressSanitizer and UBSan, and -O2 -DNDEBUG (which also stands for -O2: the optimizer's own
// warnings and the code without its assertions), with the strictest warnings smith uses, and run on 100 keys each. The
// 500-key run under the sanitizers is by hand: `./build/tests --seeds 500` in the asan build.
// smith.c runs `smith build` of the scratch project.
// smith-covers: smith.c runtime/verbs.c runtime/quiet.c runtime/base.h runtime/platform_*.c runtime/slots.c
// smith-covers: runtime/build_runtime.c runtime/executor*.c runtime/cache.c runtime/sdk_cache.c runtime/lang*.c
// smith-covers: shim/hook.cpp scripts/protocol.c schemas/ tests/protocol/ tests/build_fixtures/protocol/
// smith-covers: lib/std/test.smith lib/std/random.smith lib/std/arena.smith lib/std/mem.smith include/smith/
module protocol_test;

import std::arena;
import std::format;
import std::mem;
import std::test;
import scratch;

// The scratch project: smith's libraries the protocol code needs (build.c), the protocol code, and the runner. The
// generated files (.smith/protocol) are copied beside it, and its tests go to tests/.
constexpr char setup[_] = "mkdir -p tests && cp generated/*.c generated/*.h protocol/ && rm protocol/test_protocol_*.c "
                          "&& cp generated/test_protocol_*.c tests/ && rm -rf generated";

// The generated code and its tests build in a mode and every test of them passes.
static void check_mode(const char *mode) {
    scratch::Project p = scratch::make("protocol", "protocol");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::copy_tree(&p, "runtime/protocol", "protocol");
    scratch::copy_tree(&p, "tests/protocol", "protocol");
    scratch::copy_tree(&p, ".smith/protocol", "generated");
    scratch::Run copied = scratch::sh(&p, setup);
    scratch::expect_status("protocol: the project is made", 0, &copied);
    scratch::Run built = scratch::build(&p, format::push("-DMODE=", mode).data);
    scratch::expect_status(format::push(mode, ": the generated code and its tests build").data, 0, &built);
    const char *count = scratch::capture(&p, "cat tests/test_protocol_*.c | grep -c '^void test_'");
    scratch::Run ran = scratch::sh(&p, "./build/tests 2>&1");
    scratch::expect_status(format::push(mode, ": the tests run").data, 0, &ran);
    scratch::expect_contains(format::push(mode, ": all ", count, " generated tests pass").data, ran.out,
                             format::push(count, " passed, 0 failed").data);
}

export void test_protocol_generated_code_passes_under_the_sanitizers() {
    check_mode("asan");
}

export void test_protocol_generated_code_passes_optimized_without_assertions() {
    check_mode("ndebug");
}
