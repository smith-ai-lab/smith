// Tests of the fix-it for `{}` of a struct (#2224, decided on #1406): every field given with its zero value, or
// `undefined` when the statements right after the declaration assign every field by name.
module front_fix_zero_test;

import front::fix;
import front::parser;
import std::files;
import std::arena;
import std::mem;
import std::test;

static void expect_fixed(Str before, Str want) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed first = fix::fix_text("t.smith", before);
    test::check_equal(first.text, want);
}

export void test_front_fix_zero_gives_every_field() {
    expect_fixed("module m;\nstruct P {\n    int a;\n    char *p;\n};\nvoid f(void) {\n    P x = {};\n    g(&x);\n}\n",
                 "struct P:\n    a: i32\n    p: *char\nfn f():\n    x: P = P(a = 0, p = nullptr)\n    g(&x)\n");
}

export void test_front_fix_zero_goes_one_struct_and_an_array_down() {
    expect_fixed("module m;\nstruct Q {\n    int a;\n};\nstruct R {\n    int n;\n    Q q;\n    int xs[3];\n};\n"
                 "void f(void) {\n    R r = {};\n    g(&r);\n}\n",
                 "struct Q:\n    a: i32\nstruct R:\n    n: i32\n    q: Q\n    xs: [3]i32\nfn f():\n"
                 "    r: R = R(n = 0, q = Q(a = 0), xs = [0, 0, 0])\n    g(&r)\n");
}

export void test_front_fix_zero_undefined_when_every_field_is_written_first() {
    expect_fixed("module m;\nstruct Q {\n    int a;\n    int b;\n};\nvoid f(void) {\n    Q y = {};\n    y.b = 2;\n"
                 "    y.a = 1;\n    g(&y);\n}\n",
                 "struct Q:\n    a: i32\n    b: i32\nfn f():\n    mut y: Q = undefined\n    y.b = 2\n    y.a = 1\n"
                 "    g(&y)\n");
}

export void test_front_fix_zero_partial_write_takes_the_default() {
    expect_fixed(
        "module m;\nstruct Q {\n    int a;\n    int b;\n};\nvoid f(void) {\n    Q z = {};\n    z.a = 1;\n"
        "    g(&z);\n}\n",
        "struct Q:\n    a: i32\n    b: i32\nfn f():\n    mut z: Q = Q(a = 0, b = 0)\n    z.a = 1\n    g(&z)\n");
}

export void test_front_fix_zero_a_read_between_the_writes_takes_the_default() {
    expect_fixed(
        "module m;\nstruct Q {\n    int a;\n    int b;\n};\nvoid f(void) {\n    Q z = {};\n    z.a = 1;\n"
        "    z.b = z.a;\n}\n",
        "struct Q:\n    a: i32\n    b: i32\nfn f():\n    mut z: Q = Q(a = 0, b = 0)\n    z.a = 1\n    z.b = z.a\n");
}

export void test_front_fix_zero_fills_the_fields_a_designated_list_leaves_out() {
    expect_fixed(
        "module m;\nstruct S {\n    int a;\n    int b;\n};\nstruct E {\n    int k;\n    S s;\n    char *p;\n};\n"
        "E make(int k) {\n    return (E){.k = k};\n}\n",
        "struct S:\n    a: i32 = 0\n    b: i32 = 0\nstruct E:\n    k: i32\n    s: S = S()\n    p: *char\n"
        "fn make(k: i32) -> E:\n    return E(k = k)\n");
}

// Slice 6 of #2224 (`std::arena` parses): an opaque type that ends the file keeps its `struct`, and a function's result
// that is a type function applied is read as a type whatever its case.
export void test_front_fix_an_opaque_struct_at_the_end_keeps_its_keyword() {
    expect_fixed("module m;\n// A chunk.\n[[std::c_name(\"T\")]] export typedef struct T Chunk;\n",
                 "# A chunk.\n@c_name(\"T\") pub struct Chunk\n");
}

export void test_front_fix_a_result_that_is_a_lowercase_type_function_parses() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text(
        "t.smith", "module m;\nexport slice_of(T, 1) take(constexpr Type T, auto... dims) {\n    return dims;\n}\n");
    parser::Parsed parsed = fix::parse_for_fix("t.smith", fixed.text);
    test::check_equal(countof(parsed.errors), (Usize)0);
}

export void test_front_fix_a_struct_tag_in_a_field_and_after_const_is_the_name() {
    expect_fixed("module m;\ntypedef struct R {\n    struct R *next;\n    int n;\n} R;\nvoid f(const struct R *q) {\n  "
                 "  g(q);\n}\n",
                 "struct R:\n    next: *R\n    n: i32\nfn f(q: *R):\n    g(q)\n");
}

export void test_front_fix_zero_fills_a_field_named_like_a_keyword() {
    expect_fixed("module m;\nstruct Q {\n    int in;\n};\nvoid f(void) {\n    Q z = {};\n    g(&z);\n}\n",
                 "struct Q:\n    in_: i32\nfn f():\n    z: Q = Q(in_ = 0)\n    g(&z)\n");
}

// #2385 (decided on #1406): `T xs[n] = {}` of a struct element is a `mut` array filled with the zero value of the
// element, three structs deep, and the file gets `import std.array` once.
export void test_front_fix_zero_fills_an_array_of_nested_structs() {
    expect_fixed(
        "module m;\nstruct In {\n    int f;\n};\nstruct Mid {\n    long a;\n    In flags;\n};\n"
        "void f(void) {\n    Mid xs[2] = {};\n    xs[0].a = 1;\n}\n",
        "import std.array\nstruct In:\n    f: i32\nstruct Mid:\n    a: i64\n    flags: In\n"
        "fn f():\n    mut xs: [2]Mid = array.filled(Mid, 2, Mid(a = 0, flags = In(f = 0)))\n    xs[0].a = 1\n");
}

export void test_front_fix_zero_array_fill_keeps_an_existing_import_of_std_array() {
    expect_fixed("module m;\nimport std::array;\nstruct P {\n    int a;\n};\nvoid f(void) {\n    P xs[2] = {};\n"
                 "    xs[0].a = 1;\n}\n",
                 "import std.array\nstruct P:\n    a: i32\nfn f():\n    mut xs: [2]P = array.filled(P, 2, P(a = 0))\n"
                 "    xs[0].a = 1\n");
}

// A C parameter named `fn` (a function pointer, called or passed on) is written `fn_`: `fn` is a keyword of smith's own
// syntax (#2412). A lambda's `fn` stays.
export void test_front_fix_a_parameter_named_fn_is_renamed() {
    expect_fixed("module m;\nint apply(int (*fn)(int), int x) {\n    return fn(x);\n}\n",
                 "fn apply(fn_: fn(i32) -> i32, x: i32) -> i32:\n    return fn_(x)\n");
}

export void test_front_fix_a_lambda_keeps_its_fn() {
    expect_fixed("module m;\nvoid f(void) {\n    g([](int a) -> int { return a; });\n}\n",
                 "fn f():\n    g(fn(a: i32) -> i32: a)\n");
}

// A C function named `yield` is written `yield_` at its declaration and at a call through its module (#2403): `yield`
// is a keyword of smith's own syntax. Its `@c_name` keeps the C symbol.
export void test_front_fix_a_function_named_yield_is_renamed() {
    expect_fixed("module m;\n[[std::c_name(\"m_yield\")]] export bool yield(int x) {\n    return x > 0;\n}\n",
                 "@c_name(\"m_yield\") pub fn yield_(x: i32) -> bool:\n    return x > 0\n");
}

export void test_front_fix_a_call_of_a_module_yield_is_renamed() {
    expect_fixed("module m;\nimport std::stream;\nbool f(Stream *s) {\n    return stream::yield(s);\n}\n",
                 "import std.stream\nfn f(s: *Stream) -> bool:\n    return stream.yield_(s)\n");
}

// A function type after a `:` keeps its `fn`, and so does the `fn` before a name that is a keyword (#2442).
export void test_front_fix_a_function_type_and_a_keyword_name_keep_their_fn() {
    Str keyword_name = "fn double(x: i32) -> i32:\n    return x * 2\n";
    expect_fixed(keyword_name, keyword_name);
}

export void test_front_fix_a_function_type_after_a_colon_keeps_its_fn() {
    Str source = "fn repeat(n: i32, body: fn()):\n    body()\n";
    expect_fixed(source, source);
}

// #1901: a `static` or file-level array of numbers with a named length (or longer than 64) is `array.filled(T, n, 0)`.
export void test_front_fix_zero_fills_a_static_array_of_a_named_length() {
    expect_fixed(
        "module m;\nconstexpr int size = 100;\nvoid f(void) {\n    static char buf[size];\n    buf[0] = 1;\n}\n",
        "import std.array\nconst size: i32 = 100\nfn f():\n    static mut buf: [size]char = array.filled(char, 100, "
        "0)\n"
        "    buf[0] = 1\n");
}

export void test_front_fix_zero_fills_a_long_global_array() {
    expect_fixed("module m;\nstatic int table[1000];\n",
                 "import std.array\nstatic mut table: [1000]i32 = array.filled(i32, 1000, 0)\n");
}

// #2496: C zeroes `static char names[5][8];`, which is the shape `array.filled(char, [5, 8], 0)`.
export void test_front_fix_zero_fills_a_two_dimension_static_array() {
    expect_fixed("module m;\nstatic char names[5][8];\n",
                 "import std.array\nstatic mut names: [5][8]char = array.filled(char, [5, 8], 0)\n");
}

// #2489 (the lead): a function-local `static const` table has no `static` in smith's own syntax; it is an ordinary
// local. A `static` that is written to keeps its word (it has no form yet).
export void test_front_fix_a_local_static_const_table_loses_its_static() {
    expect_fixed("module m;\nvoid f(void) {\n    static const double t[2] = {1.0, 2.0};\n    g(&t[0]);\n}\n",
                 "fn f():\n    t: [2]f64 = [1.0, 2.0]\n    g(&t[0])\n");
}

// #2530 (the owner, 2026-11-06): a field that a construction leaves out gets C's zero written as its default in the
// struct, and the construction stays as written. A number is `0` or `0.0`, a `bool` `false`, a `str` `""`, a slice
// `[]`, an option `.none`, an enumeration its variant of value 0, a fixed array `array.filled`, a struct of the module
// `S()` (its own fields get defaults too). A pointer gets none: it is left to become `?*T`.
export void test_front_fix_zero_left_out_fields_get_defaults_in_the_struct() {
    expect_fixed(
        "enum Mode:\n    off\n    on\nstruct In:\n    n: i32\nstruct W:\n    a: i32\n    f: f64\n    ok: bool\n"
        "    name: str\n    xs: []i32\n    maybe: ?i32\n    mode: Mode\n    grid: [3]i32\n    inner: In\n"
        "    p: *i32\nfn make() -> W:\n    return W(a = 1)\n",
        "import std.array\nenum Mode:\n    off\n    on\nstruct In:\n    n: i32 = 0\nstruct W:\n    a: i32\n"
        "    f: f64 = 0.0\n    ok: bool = false\n    name: str = \"\"\n    xs: []i32 = []\n    maybe: ?i32 = .none\n"
        "    mode: Mode = .off\n    grid: [3]i32 = array.filled(i32, 3, 0)\n    inner: In = In()\n    p: *i32\n"
        "fn make() -> W:\n    return W(a = 1)\n");
}

// Only the fields some construction leaves out get a default; a field every construction gives keeps none.
export void test_front_fix_zero_a_field_every_construction_gives_gets_no_default() {
    Str source = "struct P:\n    x: i32\n    y: i32\nfn make() -> P:\n    return P(x = 1, y = 2)\n";
    expect_fixed(source, source);
}

// A construction in another file of the folder (`a.P(x = 1)` after `import fixdef.a`) gives the struct its defaults.
export void test_front_fix_zero_a_construction_in_a_neighbouring_file_gives_the_default() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str folder = "/tmp/front_fix_zero_test_neighbour";
    (void)files::make_folder(folder);
    Str user = "import fixdef.a\nfn f() -> a.P:\n    return a.P(x = 1)\n";
    test::check(fix::store("/tmp/front_fix_zero_test_neighbour/b.smith", user));
    fix::Fixed fixed =
        fix::fix_text("/tmp/front_fix_zero_test_neighbour/a.smith", "pub struct P:\n    pub x: i32\n    pub y: i32\n");
    Str want = "pub struct P:\n    pub x: i32\n    pub y: i32 = 0\n";
    test::check_equal(fixed.text, want);
}
