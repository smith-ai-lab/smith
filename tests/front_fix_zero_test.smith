// Tests of the fix-it for `{}` of a struct (#2224, decided on #1406): every field given with its zero value, or
// `undefined` when the statements right after the declaration assign every field by name.
module front_fix_zero_test;

import front::fix;
import front::parser;
import std::files;
import std::arena;
import std::mem;
import std::test;
import <unistd.h>;

static void expect_fixed(Str before, Str want) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed first = fix::fix_text("t.smith", before);
    test::check_equal(first.text, want);
}

export void test_front_fix_zero_gives_every_field() {
    expect_fixed("module m;\nstruct P {\n    int a;\n    char *p;\n};\nvoid f(void) {\n    P x = {};\n    g(&x);\n}\n",
                 "struct P:\n    a: i32\n    p: *char\nfn f():\n    mut x: P = P(a = 0, p = nullptr)\n    g(&x)\n");
}

export void test_front_fix_zero_goes_one_struct_and_an_array_down() {
    expect_fixed("module m;\nstruct Q {\n    int a;\n};\nstruct R {\n    int n;\n    Q q;\n    int xs[3];\n};\n"
                 "void f(void) {\n    R r = {};\n    g(&r);\n}\n",
                 "struct Q:\n    a: i32\nstruct R:\n    n: i32\n    q: Q\n    xs: [3]i32\nfn f():\n"
                 "    mut r: R = R(n = 0, q = Q(a = 0), xs = [0, 0, 0])\n    g(&r)\n");
}

export void test_front_fix_zero_undefined_when_every_field_is_written_first() {
    expect_fixed("module m;\nstruct Q {\n    int a;\n    int b;\n};\nvoid f(void) {\n    Q y = {};\n    y.b = 2;\n"
                 "    y.a = 1;\n    g(&y);\n}\n",
                 "struct Q:\n    a: i32\n    b: i32\nfn f():\n    mut y: Q = undefined\n    y.b = 2\n    y.a = 1\n"
                 "    g(&y)\n");
}

export void test_front_fix_zero_partial_write_takes_the_default() {
    expect_fixed(
        "module m;\nstruct Q {\n    int a;\n    int b;\n};\nvoid f(void) {\n    Q z = {};\n    z.a = 1;\n"
        "    g(&z);\n}\n",
        "struct Q:\n    a: i32\n    b: i32\nfn f():\n    mut z: Q = Q(a = 0, b = 0)\n    z.a = 1\n    g(&z)\n");
}

export void test_front_fix_zero_a_read_between_the_writes_takes_the_default() {
    expect_fixed(
        "module m;\nstruct Q {\n    int a;\n    int b;\n};\nvoid f(void) {\n    Q z = {};\n    z.a = 1;\n"
        "    z.b = z.a;\n}\n",
        "struct Q:\n    a: i32\n    b: i32\nfn f():\n    mut z: Q = Q(a = 0, b = 0)\n    z.a = 1\n    z.b = z.a\n");
}

export void test_front_fix_zero_fills_the_fields_a_designated_list_leaves_out() {
    expect_fixed(
        "module m;\nstruct S {\n    int a;\n    int b;\n};\nstruct E {\n    int k;\n    S s;\n    char *p;\n};\n"
        "E make(int k) {\n    return (E){.k = k};\n}\n",
        "struct S:\n    a: i32 = 0\n    b: i32 = 0\nstruct E:\n    k: i32\n    s: S = S()\n    p: *char\n"
        "fn make(k: i32) -> E:\n    return E(k = k)\n");
}

// Slice 6 of #2224 (`std::arena` parses): an opaque type that ends the file keeps its `struct`, and a function's result
// that is a type function applied is read as a type whatever its case.
export void test_front_fix_an_opaque_struct_at_the_end_keeps_its_keyword() {
    expect_fixed("module m;\n// A chunk.\n[[std::c_name(\"T\")]] export typedef struct T Chunk;\n",
                 "# A chunk.\n@c_name(\"T\") pub struct Chunk\n");
}

export void test_front_fix_a_result_that_is_a_lowercase_type_function_parses() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text(
        "t.smith", "module m;\nexport slice_of(T, 1) take(constexpr Type T, auto... dims) {\n    return dims;\n}\n");
    parser::Parsed parsed = fix::parse_for_fix("t.smith", fixed.text);
    test::check_equal(countof(parsed.errors), (Usize)0);
}

export void test_front_fix_a_struct_tag_in_a_field_and_after_const_is_the_name() {
    expect_fixed("module m;\ntypedef struct R {\n    struct R *next;\n    int n;\n} R;\nvoid f(const struct R *q) {\n  "
                 "  g(q);\n}\n",
                 "struct R:\n    next: *R\n    n: i32\nfn f(q: *R):\n    g(q)\n");
}

export void test_front_fix_zero_fills_a_field_named_like_a_keyword() {
    expect_fixed("module m;\nstruct Q {\n    int in;\n};\nvoid f(void) {\n    Q z = {};\n    g(&z);\n}\n",
                 "struct Q:\n    in_: i32\nfn f():\n    mut z: Q = Q(in_ = 0)\n    g(&z)\n");
}

// #2385 (decided on #1406): `T xs[n] = {}` of a struct element is a `mut` array filled with the zero value of the
// element, three structs deep, and the file gets `import std.array` once.
export void test_front_fix_zero_fills_an_array_of_nested_structs() {
    expect_fixed(
        "module m;\nstruct In {\n    int f;\n};\nstruct Mid {\n    long a;\n    In flags;\n};\n"
        "void f(void) {\n    Mid xs[2] = {};\n    xs[0].a = 1;\n}\n",
        "import std.array\nstruct In:\n    f: i32\nstruct Mid:\n    a: i64\n    flags: In\n"
        "fn f():\n    mut xs: [2]Mid = array.filled(Mid, 2, Mid(a = 0, flags = In(f = 0)))\n    xs[0].a = 1\n");
}

export void test_front_fix_zero_array_fill_keeps_an_existing_import_of_std_array() {
    expect_fixed("module m;\nimport std::array;\nstruct P {\n    int a;\n};\nvoid f(void) {\n    P xs[2] = {};\n"
                 "    xs[0].a = 1;\n}\n",
                 "import std.array\nstruct P:\n    a: i32\nfn f():\n    mut xs: [2]P = array.filled(P, 2, P(a = 0))\n"
                 "    xs[0].a = 1\n");
}

// A C name spelled like a keyword of smith's own syntax is an error at that identifier, and the text is left alone
// (#2455): the fixer never invents a name such as `fn_`.
static void expect_clash(Str before, Str message) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed = fix::fix_text("t.smith", before);
    test::check_equal(fixed.clash, message);
}

export void test_front_fix_a_parameter_named_fn_is_an_error() {
    expect_clash("module m;\nint apply(int (*fn)(int), int x) {\n    return fn(x);\n}\n",
                 "2:17: `fn` is a keyword: rename it");
}

export void test_front_fix_a_lambda_keeps_its_fn() {
    expect_fixed("module m;\nvoid f(void) {\n    g([](int a) -> int { return a; });\n}\n",
                 "fn f():\n    g(fn(a: i32) -> i32: a)\n");
}

// A C function named `yield` is an error too, at its declaration (#2455).
export void test_front_fix_a_function_named_yield_is_an_error() {
    expect_clash("module m;\nexport bool yield(int x) {\n    return x > 0;\n}\n",
                 "2:13: `yield` is a keyword: rename it");
}

export void test_front_fix_a_call_of_stream_suspend_is_not_a_clash() {
    expect_fixed("module m;\nimport std::stream;\nbool f(Stream *s) {\n    return stream::suspend(s);\n}\n",
                 "import std.stream\nfn f(s: *Stream) -> bool:\n    return stream.suspend(s)\n");
}

// A function type after a `:` keeps its `fn`, and so does the `fn` before a name that is a keyword (#2442).
export void test_front_fix_a_function_type_and_a_keyword_name_keep_their_fn() {
    Str keyword_name = "fn double(x: i32) -> i32:\n    return x * 2\n";
    expect_fixed(keyword_name, keyword_name);
}

export void test_front_fix_a_function_type_after_a_colon_keeps_its_fn() {
    Str source = "fn repeat(n: i32, body: fn()):\n    body()\n";
    expect_fixed(source, source);
}

// #1901: a `static` or file-level array of numbers with a named length (or longer than 64) is `array.filled(T, n, 0)`.
export void test_front_fix_zero_fills_a_static_array_of_a_named_length() {
    expect_fixed(
        "module m;\nconstexpr int size = 100;\nvoid f(void) {\n    static char buf[size];\n    buf[0] = 1;\n}\n",
        "import std.array\nconst size: i32 = 100\nfn f():\n    static mut buf: [size]char = array.filled(char, 100, "
        "0)\n"
        "    buf[0] = 1\n");
}

export void test_front_fix_zero_fills_a_long_global_array() {
    expect_fixed("module m;\nstatic int table[1000];\n",
                 "import std.array\nstatic mut table: [1000]i32 = array.filled(i32, 1000, 0)\n");
}

// #2496: C zeroes `static char names[5][8];`, which is the shape `array.filled(char, [5, 8], 0)`.
export void test_front_fix_zero_fills_a_two_dimension_static_array() {
    expect_fixed("module m;\nstatic char names[5][8];\n",
                 "import std.array\nstatic mut names: [5][8]char = array.filled(char, [5, 8], 0)\n");
}

// #2489 (the lead): a function-local `static const` table has no `static` in smith's own syntax; it is an ordinary
// local. A `static` that is written to keeps its word (it has no form yet).
export void test_front_fix_a_local_static_const_table_loses_its_static() {
    expect_fixed("module m;\nvoid f(void) {\n    static const double t[2] = {1.0, 2.0};\n    g(&t[0]);\n}\n",
                 "fn f():\n    t: [2]f64 = [1.0, 2.0]\n    g(&t[0])\n");
}

// #2530 (the owner, 2026-11-06): a field that a construction leaves out gets C's zero written as its default in the
// struct, and the construction stays as written. A number is `0` or `0.0`, a `bool` `false`, a `str` `""`, a slice
// `[]`, an option `.none`, an enumeration its variant of value 0, a fixed array `array.filled`, a struct of the module
// `S()` (its own fields get defaults too). A pointer gets none: it is left to become `?*T`.
export void test_front_fix_zero_left_out_fields_get_defaults_in_the_struct() {
    expect_fixed(
        "enum Mode:\n    off\n    on\nstruct In:\n    n: i32\nstruct W:\n    a: i32\n    f: f64\n    ok: bool\n"
        "    name: str\n    xs: []i32\n    maybe: ?i32\n    mode: Mode\n    grid: [3]i32\n    inner: In\n"
        "    p: *i32\nfn make() -> W:\n    return W(a = 1)\n",
        "import std.array\nenum Mode:\n    off\n    on\nstruct In:\n    n: i32 = 0\nstruct W:\n    a: i32\n"
        "    f: f64 = 0.0\n    ok: bool = false\n    name: str = \"\"\n    xs: []i32 = []\n    maybe: ?i32 = .none\n"
        "    mode: Mode = .off\n    grid: [3]i32 = array.filled(i32, 3, 0)\n    inner: In = In()\n    p: *i32\n"
        "fn make() -> W:\n    return W(a = 1)\n");
}

// Only the fields some construction leaves out get a default; a field every construction gives keeps none.
export void test_front_fix_zero_a_field_every_construction_gives_gets_no_default() {
    Str source = "struct P:\n    x: i32\n    y: i32\nfn make() -> P:\n    return P(x = 1, y = 2)\n";
    expect_fixed(source, source);
}

// A construction in another file of the folder (`a.P(x = 1)` after `import fixdef.a`) gives the struct its defaults.
export void test_front_fix_zero_a_construction_in_a_neighbouring_file_gives_the_default() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str folder = "/tmp/front_fix_zero_test_neighbour";
    (void)files::make_folder(folder);
    Str user = "import fixdef.a\nfn f() -> a.P:\n    return a.P(x = 1)\n";
    test::check(fix::store("/tmp/front_fix_zero_test_neighbour/b.smith", user));
    fix::Fixed fixed =
        fix::fix_text("/tmp/front_fix_zero_test_neighbour/a.smith", "pub struct P:\n    pub x: i32\n    pub y: i32\n");
    Str want = "pub struct P:\n    pub x: i32\n    pub y: i32 = 0\n";
    test::check_equal(fixed.text, want);
}

// A construction in a file of another folder (`tests/b.smith` builds `lib/a.smith`'s `P`) gives the default too: the
// fixer reads every file under the working folder that imports the module (#2543).
export void test_front_fix_zero_a_construction_in_another_folder_gives_the_default() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    char home[4096];
    test::check(c::getcwd(home, sizeof home) != nullptr);
    (void)files::make_folder("/tmp/front_fix_zero_test_tree");
    (void)files::make_folder("/tmp/front_fix_zero_test_tree/lib");
    (void)files::make_folder("/tmp/front_fix_zero_test_tree/tests");
    Str user = "import lib.a\nfn f() -> a.P:\n    return a.P(x = 1)\n";
    test::check(fix::store("/tmp/front_fix_zero_test_tree/tests/b.smith", user));
    test::check_equal(c::chdir("/tmp/front_fix_zero_test_tree"), 0);
    fix::Fixed fixed = fix::fix_text("lib/a.smith", "pub struct P:\n    pub x: i32\n    pub y: i32\n");
    test::check_equal(c::chdir(home), 0);
    Str want = "pub struct P:\n    pub x: i32\n    pub y: i32 = 0\n";
    test::check_equal(fixed.text, want);
}

// A pointer field that a construction leaves null and a read tests is `?*T = .none` (#2557): a read after
// `!= nullptr` binds the field by its own name, `== nullptr: return` binds the rest of the block, `nullptr` is `.none`.
export void test_front_fix_zero_a_tested_pointer_is_an_option_and_its_tested_reads_bind() {
    expect_fixed("module m;\nstruct Node {\n    int value;\n    struct Node *next;\n};\n"
                 "typedef const Node *NodeRef;\nstruct Holder {\n    NodeRef head;\n"
                 "    int n;\n};\nNode make(int v) {\n    return (Node){.value = v};\n}\n"
                 "Holder hold(void) {\n    return (Holder){.n = 1};\n}\n"
                 "int first(const Node *n) {\n"
                 "    if (n->next != nullptr) return n->next->value;\n    return 0;\n}\n"
                 "int second(const Holder *h) {\n    if (h->head == nullptr) return 0;\n"
                 "    return h->head->value;\n}\nvoid clear(Node *n) {\n"
                 "    n->next = nullptr;\n}\n",
                 "struct Node:\n    value: i32\n    next: ?*Node = .none\nNodeRef := *Node\n"
                 "struct Holder:\n    head: ?NodeRef = .none\n    n: i32\n"
                 "fn make(v: i32) -> Node:\n    return Node(value = v)\n"
                 "fn hold() -> Holder:\n    return Holder(n = 1)\n"
                 "fn first(n: *Node) -> i32:\n    if next := n.next:\n"
                 "        return next.value\n    return 0\nfn second(h: *Holder) -> i32:\n"
                 "    head := h.head else:\n        return 0\n    return head.value\n"
                 "fn clear(n: *mut Node):\n    n.next = .none\n");
}

// A test of the field in a conditional expression binds the field on the line before the statement (#2647).
export void test_front_fix_zero_a_tested_pointer_in_a_conditional_expression_binds_before_the_statement() {
    expect_fixed("module m;\nstruct Node {\n    I32 value;\n    Node *next;\n};\n"
                 "Node make(I32 v) {\n    return (Node){.value = v};\n}\n"
                 "I32 first(const Node *n) {\n    return n->next != nullptr ? n->next->value : 0;\n}\n",
                 "struct Node:\n    value: i32\n    next: ?*Node = .none\n"
                 "fn make(v: i32) -> Node:\n    return Node(value = v)\n"
                 "fn first(n: *Node) -> i32:\n    next := n.next\n    return if next != .none: next.value else: 0\n");
}

// The test of a field in an `&&` or `||` chain of any statement binds the field before it too (#2647).
export void test_front_fix_zero_a_tested_pointer_in_an_and_chain_binds_before_the_statement() {
    expect_fixed("module m;\nstruct Node {\n    I32 value;\n    Node *next;\n};\n"
                 "Node make(I32 v) {\n    return (Node){.value = v};\n}\n"
                 "Bool both(const Node *n) {\n    return n->next != nullptr && n->next->value > 0;\n}\n"
                 "Bool either(const Node *n) {\n    Bool r = n->next == nullptr || n->next->value > 0;\n"
                 "    return r;\n}\n",
                 "struct Node:\n    value: i32\n    next: ?*Node = .none\n"
                 "fn make(v: i32) -> Node:\n    return Node(value = v)\n"
                 "fn both(n: *Node) -> bool:\n    next := n.next\n    return next != .none and next.value > 0\n"
                 "fn either(n: *Node) -> bool:\n    next := n.next\n"
                 "    r: bool = next == .none or next.value > 0\n    return r\n");
}

// A read of the option with no test before it is left as it is (#2557): it is an error to mend by hand.
export void test_front_fix_zero_a_read_with_no_test_is_not_unwrapped() {
    expect_fixed("module m;\nstruct Node {\n    I32 value;\n    Node *next;\n};\n"
                 "Node make(I32 v) {\n    return (Node){.value = v};\n}\n"
                 "I32 first(const Node *n) {\n"
                 "    if (n->next != nullptr) return n->next->value;\n    return 0;\n}\n"
                 "I32 unchecked(const Node *n) {\n    return n->next->value;\n}\n",
                 "struct Node:\n    value: i32\n    next: ?*Node = .none\n"
                 "fn make(v: i32) -> Node:\n    return Node(value = v)\n"
                 "fn first(n: *Node) -> i32:\n    if next := n.next:\n"
                 "        return next.value\n    return 0\nfn unchecked(n: *Node) -> i32:\n"
                 "    return n.next.value\n");
}

// A function pointer that C leaves null is `?F = .none` and a tested call binds it (lead on #2557).
export void test_front_fix_zero_a_tested_function_pointer_is_an_option() {
    expect_fixed("module m;\ntypedef void (*Handler)(I32 code);\nstruct Hooks {\n"
                 "    I32 count;\n    Handler on_exit;\n};\nHooks quiet(void) {\n"
                 "    return (Hooks){.count = 0};\n}\n"
                 "void leave(const Hooks *h, I32 code) {\n"
                 "    if (h->on_exit != nullptr) h->on_exit(code);\n}\n",
                 "Handler := fn(i32)\nstruct Hooks:\n    count: i32\n"
                 "    on_exit: ?Handler = .none\nfn quiet() -> Hooks:\n"
                 "    return Hooks(count = 0)\nfn leave(h: *Hooks, code: i32):\n"
                 "    if on_exit := h.on_exit:\n        on_exit(code)\n");
}

// A file that imports the struct reads it as the struct's own fix writes it (#2557): the module, read from its
// pristine text, has `next` as `?*Node = .none`, so the importer's tested reads bind it too.
export void test_front_fix_zero_an_importer_binds_the_reads_of_an_option_field() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str module_path = "/tmp/front_fix_zero_list.smith";
    Str user_path = "/tmp/front_fix_zero_user.smith";
    test::check_equal(fix::store(module_path, "module front_fix_zero_list;\nexport struct Node {\n    I32 value;\n"
                                              "    Node *next;\n};\nexport Node make(I32 v) {\n"
                                              "    return (Node){.value = v};\n}\n"),
                      true);
    test::check_equal(fix::store(user_path, "module front_fix_zero_user;\nimport front_fix_zero_list;\n"
                                            "I32 second(const front_fix_zero_list::Node *n) {\n"
                                            "    if (n->next == nullptr) return 0;\n    return n->next->value;\n}\n"),
                      true);
    const char *paths[1] = {user_path.data};
    (void)fix::fix_run(paths, 1);
    files::BytesResult back = files::read_file(user_path);
    (void)c::unlink(module_path.data);
    (void)c::unlink(user_path.data);
    switch (back) {
    case .error:
        test::check(false);
        return;
    case .ok:
        files::Bytes bytes = back.ok;
        char chars[:] = mem::view(bytes, char);
        Str got = chars;
        Str want = "import front_fix_zero_list\nfn second(n: *front_fix_zero_list.Node) -> i32:\n"
                   "    next := n.next else:\n        return 0\n    return next.value\n";
        test::check_equal(got, want);
    }
}

// A field the old text calls `type` is `ty` once the file is renamed (#2458): the importer, read as it is on disk,
// still finds it in the module, so its `== nullptr` test is `.none`.
export void test_front_fix_zero_an_importer_finds_a_field_renamed_from_type() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str module_path = "/tmp/front_fix_zero_kind.smith";
    Str user_path = "/tmp/front_fix_zero_kind_user.smith";
    test::check_equal(fix::store(module_path, "module front_fix_zero_kind;\nexport struct Sym {\n    I32 kind;\n"
                                              "    Sym *type;\n};\nexport Sym make(I32 k) {\n"
                                              "    return (Sym){.kind = k};\n}\n"),
                      true);
    test::check_equal(fix::store(user_path, "module front_fix_zero_kind_user;\nimport front_fix_zero_kind;\n"
                                            "I32 first(const front_fix_zero_kind::Sym *s) {\n"
                                            "    if (s->type == nullptr) return 0;\n    return 1;\n}\n"),
                      true);
    const char *paths[1] = {user_path.data};
    (void)fix::fix_run(paths, 1);
    files::BytesResult back = files::read_file(user_path);
    (void)c::unlink(module_path.data);
    (void)c::unlink(user_path.data);
    switch (back) {
    case .error:
        test::check(false);
        return;
    case .ok:
        files::Bytes bytes = back.ok;
        char chars[:] = mem::view(bytes, char);
        Str got = chars;
        Str want = "import front_fix_zero_kind\nfn first(s: *front_fix_zero_kind.Sym) -> i32:\n"
                   "    if s.ty == .none:\n        return 0\n    return 1\n";
        test::check_equal(got, want);
    }
}

// A struct that a C call fills (#2610): `struct stat info = {}` then `stat(path, &info)` reads nothing before the call,
// so no field is zeroed, and the tag `stat` in the type and the function `stat` in the call stay apart.
export void test_front_fix_zero_a_struct_a_c_call_fills_is_undefined() {
    expect_fixed("module m;\nimport <sys/stat.h>;\nint size_of(const char *path) {\n    struct c::stat info = {};\n"
                 "    if (c::stat(path, &info) != 0) return -1;\n    return (int)info.st_size;\n}\n",
                 "import c <sys/stat.h>\nfn size_of(path: *char) -> i32:\n    mut info: c.stat = undefined\n"
                 "    if stat.stat(path, &info) != 0:\n        return -1\n    return info.st_size.to(i32)\n");
}

// A struct read before the C call (D10, #2627): the zeroed construction `stat.stat(st_dev = 0, ...)` would read as the
// call, so the fix writes `mem.zeroed(stat.stat)` and the module imports `std.mem`.
export void test_front_fix_zero_a_tag_that_is_also_a_function_starts_with_mem_zeroed() {
    expect_fixed("module m;\nimport <sys/stat.h>;\nint size_of(const char *path) {\n    struct c::stat info = {};\n"
                 "    int before = (int)info.st_size;\n    if (c::stat(path, &info) != 0) return before;\n"
                 "    return (int)info.st_size;\n}\n",
                 "import std.mem\nimport c <sys/stat.h>\nfn size_of(path: *char) -> i32:\n"
                 "    mut info: c.stat = mem.zeroed(stat.stat)\n    before: i32 = info.st_size.to(i32)\n"
                 "    if stat.stat(path, &info) != 0:\n        return before\n    return info.st_size.to(i32)\n");
}

// A member that C zeroes, of a struct with a pointer and a function pointer nothing tests against null, is
// `undefined`: `Step()` would need a default for each pointer, and a pointer is never null in smith (lead, #2613).
export void test_front_fix_zero_a_member_with_plain_pointers_is_undefined() {
    expect_fixed("module m;\nstruct Step {\n    const char *name;\n    int (*run)(int);\n    int n;\n};\n"
                 "struct Owner {\n    int id;\n    Step step;\n};\n"
                 "void f(Owner *o) {\n    Owner x = {.id = 1};\n    g(&x);\n}\n",
                 "struct Step:\n    name: *char\n    run: fn(i32) -> i32\n    n: i32 = 0\n"
                 "struct Owner:\n    id: i32\n    step: Step = undefined\n"
                 "fn f(o: *Owner):\n    x := Owner(id = 1)\n    g(&x)\n");
}

// A local that holds a pointer field the file tests against null is an option, and the `?` goes at its new type, not
// before the whole declaration (#2648: `?e: *T = x`).
export void test_front_fix_zero_a_local_of_an_option_field_gets_the_question_mark_at_its_type() {
    expect_fixed("module m;\nstruct Node {\n    int value;\n    struct Node *next;\n};\n"
                 "Node make(int v) {\n    return (Node){.value = v};\n}\n"
                 "int first(const Node *n) {\n    if (n->next != nullptr) return n->next->value;\n    return 0;\n}\n"
                 "int second(const Node *n) {\n    const Node *e = n->next;\n    if (e == nullptr) return 0;\n"
                 "    return e->value;\n}\n",
                 "struct Node:\n    value: i32\n    next: ?*Node = .none\n"
                 "fn make(v: i32) -> Node:\n    return Node(value = v)\n"
                 "fn first(n: *Node) -> i32:\n    if next := n.next:\n        return next.value\n    return 0\n"
                 "fn second(n: *Node) -> i32:\n    e: ?*Node = n.next\n    if e == .none:\n        return 0\n"
                 "    return e.value\n");
}

// A pointer of a C-layout struct (`@c_name`) that a construction leaves out is `?*T = .none`, with no read to test it:
// C reads null as unset, and `?*T` is the same pointer (lead on #2631). A field that is set, and a list `?**char`, too.
export void test_front_fix_zero_a_c_layout_struct_leaves_its_pointers_unset() {
    expect_fixed("module m;\n[[std::c_name(\"SmithApp\")]] export typedef struct {\n    const char *entry;\n"
                 "    const char *const *flags;\n    I32 n;\n} App;\n"
                 "App plain(void) {\n    return (App){.n = 1};\n}\n"
                 "App set(void) {\n    return (App){.entry = \"main\", .flags = nullptr, .n = 2};\n}\n",
                 "@c_name(\"SmithApp\") pub struct App:\n    pub entry: ?*char = .none\n"
                 "    pub flags: ?**char = .none\n    pub n: i32\nfn plain() -> App:\n    return App(n = 1)\n"
                 "fn set() -> App:\n    return App(entry = \"main\", flags = .none, n = 2)\n");
}

export void test_front_fix_zero_a_zero_compound_literal_is_mem_zeroed() {
    expect_fixed("module m;\nexport typeof(a) zero_like(auto a) {\n    return (typeof(a)){0};\n}\n",
                 "import std.mem\npub fn zero_like[T](a: T) -> T:\n    return mem.zeroed(typeof(a))\n");
}

// A pointer field a construction leaves out is `?*T = .none` when its value goes to a local that is tested against
// null: `n = n->next; while (n != nullptr)` (#2648).
export void test_front_fix_zero_a_pointer_field_read_through_a_tested_local_is_optional() {
    expect_fixed(
        "module m;\nstruct Node {\n    int value;\n    Node *next;\n};\nint f(void) {\n"
        "    Node second = {.value = 2};\n    Node *n = &second;\n    while (n != nullptr) {\n"
        "        n = n->next;\n    }\n    return 0;\n}\n",
        "struct Node:\n    value: i32\n    next: ?*Node = .none\nfn f() -> i32:\n    second := Node(value = 2)\n"
        "    mut n: *Node = &second\n    while n != nullptr:\n        n = n.next\n    return 0\n");
}

// A test of a field counts for the struct it is on (D23): `o->next == nullptr` tests `Other.next`, and `Node.next`,
// which a construction leaves out, has the same name and stays as it is.
export void test_front_fix_zero_a_test_on_another_struct_does_not_make_a_field_optional() {
    expect_fixed(
        "module m;\nstruct Node {\n    int value;\n    Node *next;\n};\nstruct Other {\n    int value;\n"
        "    Other *next;\n};\nint f(Other *o) {\n    Node a = {.value = 1};\n    if (o->next == nullptr) return 0;\n"
        "    return a.value;\n}\n",
        "struct Node:\n    value: i32\n    next: *Node\nstruct Other:\n    value: i32\n    next: *Other\n"
        "fn f(o: *Other) -> i32:\n    a := Node(value = 1)\n    if o.next == nullptr:\n        return 0\n"
        "    return a.value\n");
}
