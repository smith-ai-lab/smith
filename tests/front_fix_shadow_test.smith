// Tests of the rename of a local or parameter named like an imported module (#3027, `fix_variants::rename_shadows`):
// the name gets the suffix `_value` in its function, the module's own uses (`arena::push`) stay, and so do fields and
// globals.
module front_fix_shadow_test;

import front::fix;
import front::fix_variants;
import std::arena;
import std::mem;
import std::test;

static void expect_renamed(Str source, Str want) {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    test::check_equal(fix_variants::rename_shadows(source), want);
}

export void test_front_fix_shadow_a_parameter_named_like_a_module() {
    expect_renamed("module m;\nimport std::arena;\nvoid f(arena::Arena *arena) {\n    arena::push(arena, 1);\n"
                   "    arena->used = 0;\n}\n",
                   "module m;\nimport std::arena;\nvoid f(arena::Arena *arena_value) {\n    arena::push(arena_value, 1);\n"
                   "    arena_value->used = 0;\n}\n");
}

export void test_front_fix_shadow_a_local_and_a_loop_name() {
    expect_renamed("module m;\nimport std::array;\nimport std::text;\nvoid f(Str s) {\n    Str text = s;\n"
                   "    for (Usize array = 0; array < 3; array++) {\n        g(text, array);\n    }\n}\n",
                   "module m;\nimport std::array;\nimport std::text;\nvoid f(Str s) {\n    Str text_value = s;\n"
                   "    for (Usize array_value = 0; array_value < 3; array_value++) {\n"
                   "        g(text_value, array_value);\n    }\n}\n");
}

// `text_value` is already a name in the file: the module's locals are left, and the checker reports the shadowing.
export void test_front_fix_shadow_a_taken_name_leaves_the_file_alone() {
    Str taken = "module m;\nimport std::text;\nvoid f(Str text, Str text_value) {\n    g(text, text_value);\n}\n";
    expect_renamed(taken, taken);
}

// Only the module whose new name is taken keeps its locals.
export void test_front_fix_shadow_a_taken_name_leaves_only_its_own_module() {
    expect_renamed("module m;\nimport std::array;\nimport std::text;\nvoid f(Str text, Usize array, Str text_value) {\n"
                   "    g(text, array, text_value);\n}\n",
                   "module m;\nimport std::array;\nimport std::text;\nvoid f(Str text, Usize array_value, Str text_value) {\n"
                   "    g(text, array_value, text_value);\n}\n");
}

// The suffix is `_value`: `json` is `json_value`, and a lambda's capture of it is renamed with it (#3084).
export void test_front_fix_shadow_a_lambda_capture_is_renamed() {
    expect_renamed("module m;\nimport std::json;\nvoid f(Str json) {\n    json::parse(json);\n"
                   "    auto g = [json](Usize n) { return json[n]; };\n}\n",
                   "module m;\nimport std::json;\nvoid f(Str json_value) {\n    json::parse(json_value);\n"
                   "    auto g = [json_value](Usize n) { return json_value[n]; };\n}\n");
}

// A field (`.arena`, `->arena`, its declaration in a struct), a global and an alias's own module are left.
export void test_front_fix_shadow_fields_and_globals_stay() {
    Str fields = "module m;\nimport std::arena;\nstruct S {\n    Usize arena;\n};\nUsize f(S *s, S t) {\n"
                 "    return s->arena + t.arena;\n}\n";
    expect_renamed(fields, fields);
    Str global = "module m;\nimport std::arena;\nstatic Usize arena = 0;\nUsize f() {\n    return arena;\n}\n";
    expect_renamed(global, global);
    expect_renamed("module m;\nimport std::format as fmt;\nvoid f(Str fmt) {\n    fmt::push(fmt);\n}\n",
                   "module m;\nimport std::format as fmt;\nvoid f(Str fmt_value) {\n    fmt::push(fmt_value);\n}\n");
}

// The whole fixer: `(const U8 *)text` with `import std::text` was `text.cast(u8.*)` (count A's reading of #3027).
export void test_front_fix_shadow_a_cast_of_a_parameter_named_like_a_module() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed =
        fix::fix_text("t.smith", "module m;\n\nimport std::text;\n"
                                 "const U8 *bytes_of(const char *text) {\n    return (const U8 *)text;\n}\n");
    Str want = "\nimport std.text\nfn bytes_of(text_value: *char) -> *u8:\n    return text_value.cast(*u8)\n";
    test::check_equal(fixed.text, want);
}

// The `in` -> `in_` rename (#2390) leaves the path of a header: `<netinet/in.h>` is a file, not a C name `in`.
export void test_front_fix_shadow_a_header_named_in_keeps_its_path() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed fixed =
        fix::fix_text("t.smith", "module m;\n\nimport <netinet/in.h>;\n\nI32 f(I32 in) {\n    return in;\n}\n");
    Str want = "\nimport c <netinet/in.h>\n\nfn f(in_: i32) -> i32:\n    return in_\n";
    test::check_equal(fixed.text, want);
}
