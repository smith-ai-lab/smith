// The steps of a build.c, ported from tests/build.sh sections 1 to 8 and 9b: a copy step, tasks and stamp steps, spaces
// and a literal $, a depfile, what build.c includes, options, glob/env/capture, restat and always, and where smith
// keeps its files. What is rebuilt and why (a changed input, a changed command, tasks and stamps, a depfile, restat,
// always) is checked in process through `smith_core_plan` (include/smith_core_plan.h, issue #646) on the manifest
// that build.c writes for each fixture (tests/build_fixtures/steps_<name>/build.c), with a fake command that makes the
// outputs its text names and times the test gives. What needs build.c compiled and run by the real smith (the verb's
// wiring, its options, the environment, the regeneration when build.c changes) is a scratch project of the fixture.
module build_steps_basic_test;

import std::arena;
import std::format;
import std::mem;
import std::test;
import scratch;
import <smith_core_plan.h>;

constexpr Usize memory_size = 1U << 25; // a test's memory: what scratch returns goes back with it
constexpr Usize output_capacity = 1U << 14;

// The manifest `smith build` writes for a build.c (.smith/build.ninja): a rule that runs $cmd, the steps, and the
// phony targets every build.c has.
constexpr const char *manifest_head = "ninja_required_version = 1.10\nbuilddir = .smith\nrule step\n  command = $cmd\n";
constexpr const char *manifest_tail = "build smith_needs: phony\nbuild smith_tests: phony\nbuild smith_info: phony\n";

// What a build did: its explanations and `ran <output>` lines, and how many commands ran.
typedef struct {
    const char *text;
    Usize ran;
} Build;

// The manifest of a project, as the head, `steps` and the tail make it.
static void manifest(const char *dir, const char *steps) {
    char text[2048];
    (void)format::to(text, sizeof text, manifest_head, steps, manifest_tail);
    test::check_condition(c::smith_core_plan_write(dir, ".smith/build.ninja", text, 1));
}

// A file of the project, with the time (in seconds) its last edit had.
static void put(const char *dir, const char *name, const char *text, I64 time) {
    test::check_condition(c::smith_core_plan_write(dir, name, text, time));
}

// One `smith build` of the targets (nullptr for the defaults), whose commands run at `time`: `unchanged` are the
// outputs a command leaves as they are, `depends` what the depfile of an output names.
static Build build(const char *dir, const char *const *targets, I64 time, const char *const *unchanged,
                   const char *const *depends) {
    c::SmithCorePlan plan = {.folder = dir,
                             .manifest = ".smith/build.ninja",
                             .targets = targets,
                             .unchanged = unchanged,
                             .depends = depends,
                             .time = time};
    char *text = mem::alloc_slice(char, output_capacity).data;
    Usize ran = 0;
    test::check_equal(c::smith_core_plan(&plan, text, output_capacity, &ran), true);
    Build done = {text, ran};
    return done;
}

static Build build_defaults(const char *dir, I64 time) {
    return build(dir, nullptr, time, nullptr, nullptr);
}

static void expect_ran(const char *name, Usize expected, const Build *done) {
    scratch::expect_count(name, expected, done->ran);
    if (expected == 0) scratch::expect_contains(name, done->text, "no work to do");
}

// The one end to end case of the verb's wiring: build.c compiled and run by the real smith, then its executor.
export void test_build_steps_a_copy_step_reruns_when_its_input_changes_end_to_end() {
    scratch::Project p = scratch::make("p", "steps_copy");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write(&p, "input", "one\n");
    scratch::Run first = scratch::build(&p, "");
    scratch::expect_status("copy: the first build exits 0", 0, &first);
    scratch::expect_text("copy: the first build makes the output", "one", scratch::capture(&p, "cat output"));
    scratch::Run second = scratch::build(&p, "");
    scratch::expect_contains("copy: the second build does nothing", second.out, "no work to do");
    scratch::write(&p, "input", "two\n");
    (void)scratch::build(&p, "");
    scratch::expect_text("copy: a changed input reruns the step", "two", scratch::capture(&p, "cat output"));
}

export void test_build_steps_a_copy_step_reruns_when_its_input_changes() {
    scratch::Project p = scratch::make("p", "steps_copy");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    constexpr const char *copy = "build output: step input\n  cmd = cp input output\n";
    manifest(p.dir, copy);
    put(p.dir, "input", "one\n", 100);
    Build first = build_defaults(p.dir, 200);
    expect_ran("copy: the first build makes the output", 1, &first);
    scratch::expect_contains("copy: ... because it is missing", first.text, "output output doesn't exist");
    Build second = build_defaults(p.dir, 300);
    expect_ran("copy: the second build does nothing", 0, &second);
    put(p.dir, "input", "two\n", 400);
    Build changed = build_defaults(p.dir, 500);
    expect_ran("copy: a changed input reruns the step", 1, &changed);
    scratch::expect_contains("copy: ... because the output is older", changed.text,
                             "older than most recent input input");
    manifest(p.dir, "build output: step input\n  cmd = cp input output && true\n");
    Build command = build_defaults(p.dir, 600);
    expect_ran("copy: a changed command reruns the step", 1, &command);
    scratch::expect_contains("copy: ... and says so", command.text, "command line changed for output");
}

export void test_build_steps_a_task_runs_every_time_and_a_stamp_step_once_per_input() {
    scratch::Project p = scratch::make("p", "steps_tasks");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    // A task's command makes nothing its step names; a stamp step touches its stamp.
    manifest(p.dir, "build .smith/task/hello: step\n  cmd = sh -c 'echo ran >> log'\n"
                    "build hello: phony .smith/task/hello\n"
                    "build .smith/stamp/f1: step watched\n"
                    "  cmd = sh -c 'echo ran >> stamped_log' && touch .smith/stamp/f1\n"
                    "default .smith/stamp/f1\n");
    put(p.dir, "watched", "a\n", 100);
    const char *const hello[_] = {"hello", nullptr};
    Build first = build(p.dir, hello, 200, nullptr, nullptr);
    expect_ran("task: runs on smith build <task>", 1, &first);
    Build again = build(p.dir, hello, 300, nullptr, nullptr);
    expect_ran("task: runs on every smith build <task>", 1, &again);
    Build stamped = build_defaults(p.dir, 400);
    expect_ran("stamp step: runs for a new input", 1, &stamped);
    Build unchanged = build_defaults(p.dir, 500);
    expect_ran("stamp step: runs once for an unchanged input", 0, &unchanged);
    put(p.dir, "watched", "b\n", 600);
    Build changed = build_defaults(p.dir, 700);
    expect_ran("stamp step: reruns when its input changes", 1, &changed);
}

// Two stamp steps with one command and different inputs get two stamps, so ninja accepts both.
export void test_build_steps_two_stamp_steps_with_one_command_both_run() {
    scratch::Project p = scratch::make("p", "steps_two_stamps");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    manifest(p.dir, "build .smith/stamp/s1: step one\n  cmd = sh -c 'echo ran >> log' && touch .smith/stamp/s1\n"
                    "build .smith/stamp/s2: step two\n  cmd = sh -c 'echo ran >> log' && touch .smith/stamp/s2\n"
                    "default .smith/stamp/s1 .smith/stamp/s2\n");
    put(p.dir, "one", "a\n", 100);
    put(p.dir, "two", "a\n", 100);
    Build run = build_defaults(p.dir, 200);
    expect_ran("stamp steps with one command: both run", 2, &run);
}

export void test_build_steps_a_changed_header_rebuilds_the_object_through_its_depfile() {
    scratch::Project p = scratch::make("p", "steps_depfile");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    manifest(p.dir, "build a.o: step a.c\n  cmd = sh -c 'cc -MMD -MF a.o.d -c a.c -o a.o && echo x >> count'\n"
                    "  depfile = a.o.d\n  deps = gcc\ndefault a.o\n");
    put(p.dir, "a.c", "#include \"a.h\"\n", 100);
    put(p.dir, "a.h", "#define VALUE 1\n", 100);
    const char *const depends[_] = {"a.o: a.c a.h", nullptr};
    Build first = build(p.dir, nullptr, 200, nullptr, depends);
    expect_ran("depfile: the first build compiles the object", 1, &first);
    Build second = build(p.dir, nullptr, 300, nullptr, depends);
    expect_ran("depfile: an unchanged tree compiles once", 0, &second);
    put(p.dir, "a.h", "#define VALUE 2\n", 400);
    Build changed = build(p.dir, nullptr, 500, nullptr, depends);
    expect_ran("depfile: a changed header rebuilds the object", 1, &changed);
    scratch::expect_contains("depfile: ... because of the header", changed.text, "most recent input a.h");
}

export void test_build_steps_restat_stops_what_depends_on_an_unchanged_output() {
    scratch::Project p = scratch::make("p", "steps_restat");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    manifest(p.dir, "build generated: step trigger\n  cmd = sh -c 'echo fixed > generated' generated\n  restat = 1\n"
                    "build copied: step generated\n  cmd = sh -c 'cp generated copied' generated copied\n"
                    "default copied\n");
    put(p.dir, "trigger", "1\n", 100);
    Build first = build_defaults(p.dir, 200);
    expect_ran("restat: the first build runs both steps", 2, &first);
    put(p.dir, "trigger", "2\n", 300);
    const char *const unchanged[_] = {"generated", nullptr};
    Build second = build(p.dir, nullptr, 400, unchanged, nullptr);
    expect_ran("restat: the generator reran and an unchanged output does not rerun what depends on it", 1, &second);
    scratch::expect_contains("restat: ... and it is the generator", second.text, "ran generated");
    Build third = build(p.dir, nullptr, 500, nullptr, nullptr);
    expect_ran("restat: the next build has nothing to do", 0, &third);
}

export void test_build_steps_always_reruns_the_step_every_build() {
    scratch::Project p = scratch::make("p", "steps_always");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    manifest(p.dir, "build smith_always: phony\nbuild tick: step | smith_always\n"
                    "  cmd = sh -c 'echo x >> ticks; touch \"$$0\"' tick\ndefault tick\n");
    Build first = build_defaults(p.dir, 200);
    expect_ran("always: runs the step", 1, &first);
    Build second = build_defaults(p.dir, 300);
    expect_ran("always: reruns the step every build", 1, &second);
}

export void test_build_steps_spaces_and_a_literal_dollar_survive() {
    scratch::Project p = scratch::make("p", "steps_spaces");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write(&p, "my input.txt", "spaced\n");
    (void)scratch::build(&p, "");
    scratch::expect_text("spaces: a file name with a space is copied", "spaced",
                         scratch::capture(&p, "cat 'my copy.txt'"));
    scratch::expect_text("dollar: a literal $ and quotes in a command word survive", "a$b 'q'",
                         scratch::capture(&p, "cat 'dollar file.txt'"));
}

// Only the real smith shows that a build.c (and what it includes) that changed is compiled and run again.
export void test_build_steps_editing_build_c_and_what_it_includes_reruns_the_step() {
    scratch::Project p = scratch::make("p", "steps_includes");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::write(&p, "config.h", "#define MESSAGE \"v1\"\n");
    (void)scratch::build(&p, "");
    scratch::expect_text("build.c: first output", "v1", scratch::capture(&p, "cat out"));
    (void)scratch::sh(&p, "sed 's/\"v1\"/\"v2\"/;' config.h >config.tmp && mv config.tmp config.h");
    (void)scratch::build(&p, "");
    scratch::expect_text("build.c: an edited header it includes rebuilds the program", "v2",
                         scratch::capture(&p, "cat out"));
    (void)scratch::sh(
        &p, "sed 's/MESSAGE, nullptr/MESSAGE, \"extra\", nullptr/' build.c >build.tmp && mv build.tmp build.c");
    scratch::Run changed = scratch::build(&p, "");
    scratch::expect_text("build.c: a changed command reruns the step", "v2", scratch::capture(&p, "cat out"));
    scratch::expect_status("build.c: the changed command ran", 0, &changed);
}

export void test_build_steps_options_reach_the_commands_and_bad_ones_fail() {
    scratch::Project p = scratch::make("p", "steps_options");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    (void)scratch::build(&p, "");
    scratch::expect_text("options: the fallback", "world quiet", scratch::capture(&p, "cat greeting"));
    (void)scratch::build(&p, "-Dname=Ada");
    scratch::expect_text("options: -Dname=value reaches the command", "Ada quiet",
                         scratch::capture(&p, "cat greeting"));
    (void)scratch::build(&p, "-Dname=Bob -Dloud");
    scratch::expect_text("options: a changed value and a flag rerun the step", "Bob loud",
                         scratch::capture(&p, "cat greeting"));
    (void)scratch::build(&p, "-Dname=");
    scratch::expect_text("options: -Dname= is the empty string", " quiet", scratch::capture(&p, "cat greeting"));
    scratch::Run nope = scratch::build(&p, "-Dnope");
    scratch::expect_status("options: an undeclared -D fails", 2, &nope);
    scratch::expect_contains("options: the error lists the declared options", nope.err, "-Dname=value  who to greet");
    scratch::expect_contains("options: the error names the unknown one", nope.err, "unknown option -Dnope");
    scratch::Run flag = scratch::build(&p, "-Dloud=1");
    scratch::expect_status("options: a value for a flag fails", 2, &flag);
    scratch::Run bare = scratch::build(&p, "-Dname");
    scratch::expect_status("options: a bare -D for a valued option fails", 2, &bare);
}

export void test_build_steps_glob_env_and_capture_feed_the_commands() {
    scratch::Project p = scratch::make("p", "steps_glob_env");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    (void)scratch::sh(&p, "mkdir src && echo a >src/a.txt");
    (void)scratch::build(&p, "");
    scratch::expect_text("glob: the first file", "a", scratch::capture(&p, "cat joined"));
    (void)scratch::sh(&p, "echo b >src/b.txt");
    (void)scratch::build(&p, "");
    scratch::expect_text("glob: a new file is picked up with no edit to build.c", "a\nb",
                         scratch::capture(&p, "cat joined"));
    scratch::expect_text("env: the fallback", "unset", scratch::capture(&p, "cat env.out"));
    (void)scratch::sh(&p, "env SMITH_TEST_VALUE=set smith build");
    scratch::expect_text("env: a changed variable reruns the step", "set", scratch::capture(&p, "cat env.out"));
    scratch::expect_text("capture: the value reaches a command", "from capture",
                         scratch::capture(&p, "cat capture.out"));
}

export void test_build_steps_smith_keeps_its_files_in_dot_smith_and_a_clean_task_works() {
    scratch::Project p = scratch::make("p", "steps_folder");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(memory_size);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run first = scratch::build(&p, "");
    scratch::expect_status("folder: a build whose steps write nothing under build/ leaves no build/", 0, &first);
    scratch::expect_text("folder: a build whose steps write nothing under build/ leaves no build/", "absent",
                         scratch::exists(&p, "build") ? "present" : "absent");
    scratch::expect_text("folder: smith keeps its files in .smith", "present present",
                         scratch::capture(&p, "echo $([ -f .smith/build.ninja ] && echo present) "
                                              "$([ -f .smith/include/smith/build.h ] && echo present)"));
    scratch::expect_text("folder: .smith/.gitignore holds *", "*", scratch::capture(&p, "cat .smith/.gitignore"));
    (void)scratch::sh(&p, "mkdir build && echo x >build/file");
    scratch::Run clean = scratch::build(&p, "clean");
    scratch::expect_status("clean: a task running rm -rf build exits 0", 0, &clean);
    scratch::expect_text("clean: a task running rm -rf build exits 0", "absent",
                         scratch::exists(&p, "build") ? "present" : "absent");
    (void)scratch::sh(&p, "rm -f out");
    scratch::Run next = scratch::build(&p, "");
    scratch::expect_status("clean: the next smith build works", 0, &next);
    scratch::expect_text("clean: the next smith build works", "present",
                         scratch::exists(&p, "out") ? "present" : "absent");
}
