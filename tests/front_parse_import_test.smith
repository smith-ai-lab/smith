// Tests of the import statements (#1809 of #1428): `import a.b`, `import a.b as n`, `from a.b import x, y` and the
// header forms `import c <h.h>`, `import cpp <h>`, `import objc <h>`, `from c <h.h> import x`; the redundant `as`, the
// header whose file name is not a name, and the old spellings, whose fix writes the new one.
module front_parse_import_test;

import front::ast;
import front::fix;
import front::parser;
import std::arena;
import std::mem;
import std::test;

static Str dump_of(Str source) {
    parser::Parsed parsed = parser::parse_new("x.smith", source);
    if (countof(parsed.errors) > 0) {
        Str expected = "no error";
        test::check_equal(parsed.errors[0].message, expected);
    }
    test::check_equal(countof(parsed.warnings), (Usize)0);
    return ast::dump(&parsed.module);
}

static Str error_of(Str source) {
    parser::Parsed parsed = parser::parse_new("x.smith", source);
    Str none = "";
    if (countof(parsed.errors) == 0) return none;
    return parsed.errors[0].message;
}

static Bool has(Str text, Str needle) {
    for (Usize i = 0; i + countof(needle) <= countof(text); i++) {
        Bool same = true;
        for (Usize k = 0; k < countof(needle); k++) {
            if (text[i + k] != needle[k]) {
                same = false;
                break;
            }
        }
        if (same) return true;
    }
    return false;
}

static Str mended(Str source) {
    fix::Fixed first = fix::fix_text("m.smith", source);
    fix::Fixed second = fix::fix_text("m.smith", first.text);
    test::check_equal(second.applied, (Usize)0);
    return first.text;
}

static void check_mended(Str source, Str want) {
    Str got = mended(source);
    test::check_equal(got, want);
}

export void test_a_module_import_binds_the_last_name() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str want = "(module \n  (import std::math))\n";
    test::check_equal(dump_of("import std.math\n"), want);
}

export void test_an_alias_and_pub() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str want = "(module \n  (import std::arena as a)\n  (import web::routes pub))\n";
    test::check_equal(dump_of("import std.arena as a\npub import web.routes\n"), want);
}

export void test_a_header_import_binds_the_file_name() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str want = "(module \n  (import_c angled stdio.h lang c)\n  (import_c angled sys/stat.h lang c as st)\n"
               "  (import_c angled vector lang cpp)\n  (import_c angled Foundation/Foundation.h lang objc))\n";
    Str source = "import c <stdio.h>\nimport c <sys/stat.h> as st\nimport cpp <vector>\n"
                 "import objc <Foundation/Foundation.h>\n";
    test::check_equal(dump_of(source), want);
}

export void test_a_header_that_is_not_a_name_needs_as() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    test::check_condition(has(error_of("import c <x-y.h>\n"), "as name"));
    Str want = "(module \n  (import_c angled x-y.h lang c as xy))\n";
    test::check_equal(dump_of("import c <x-y.h> as xy\n"), want);
}

export void test_from_imports_names() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str want = "(module \n  (from std::math import sin cos)\n  (from c stdlib.h import malloc free))\n";
    test::check_equal(dump_of("from std.math import sin, cos\nfrom c <stdlib.h> import malloc, free\n"), want);
}

export void test_an_as_that_repeats_the_name_is_mended() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    parser::Parsed parsed = parser::parse_new("x.smith", "import std.math as math\n");
    test::check_equal(countof(parsed.errors), (Usize)0);
    test::check_equal(countof(parsed.warnings), (Usize)1);
    check_mended("import std.math as math\n", "import std.math\n");
    check_mended("import c <stdio.h> as stdio\n", "import c <stdio.h>\n");
}

export void test_the_old_forms_are_mended() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    check_mended("import std::math;\n", "import std.math\n");
    check_mended("import std::math as m;\n", "import std.math as m\n");
    check_mended("import <stdio.h>;\n", "import c <stdio.h>\n");
}
