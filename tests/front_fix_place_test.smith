// Tests of the fix-it for a write through a payload (D21, #2648): `if k == .v:` becomes `if .v(v) := &k:` and the
// `k.v.f` of its body become `v.f`.
module front_fix_place_test;

import front::fix;
import front::fix_place;
import front::parse as core;
import std::arena;
import std::format;
import std::mem;
import std::test;

static Str as_str(char chars[:]) {
    return chars;
}

static Str applied(Str source) {
    core::Errors found = fix_place::edits(source);
    Str text = source;
    for (Usize k = 0; k < countof(found); k++) {
        core::Edits fix = found[k].fix;
        for (Usize m = 0; m < countof(fix); m++) {
            Usize best = m;
            for (Usize j = m + 1; j < countof(fix); j++)
                if (fix[j].span.start > fix[best].span.start) best = j;
            core::Edit pick = fix[best];
            fix[best] = fix[m];
            fix[m] = pick;
        }
        for (Usize m = 0; m < countof(fix); m++) {
            Str before = text[0:fix[m].span.start];
            Str after = text[fix[m].span.end:countof(text)];
            text = as_str(format::push(before, fix[m].text, after));
        }
    }
    return text;
}

static void expect(Str before, Str want) {
    arena::Arena memory = test::memory(1U << 20);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    test::check_equal(applied(before), want);
}

export void test_front_fix_place_a_write_through_the_payload_binds_a_pointer() {
    expect("fn f(one: mut E):\n    if one == .index:\n        one.index.index = take(one.index.index)\n",
           "fn f(one: mut E):\n    if .index(index) := &one:\n        index.index = take(index.index)\n");
}

export void test_front_fix_place_a_compound_write_counts() {
    expect("fn f(k: mut E):\n    if k == .count:\n        k.count.n += 1\n",
           "fn f(k: mut E):\n    if .count(count) := &k:\n        count.n += 1\n");
}

export void test_front_fix_place_reads_only_are_left() {
    expect("fn f(k: E):\n    if k == .count:\n        use(k.count.n)\n",
           "fn f(k: E):\n    if k == .count:\n        use(k.count.n)\n");
}

export void test_front_fix_place_a_payload_used_whole_is_left() {
    expect("fn f(k: mut E):\n    if k == .count:\n        k.count = 3\n",
           "fn f(k: mut E):\n    if k == .count:\n        k.count = 3\n");
}

export void test_front_fix_place_a_name_of_the_variant_in_the_function_is_left() {
    expect("fn f(k: mut E, count: i32):\n    if k == .count:\n        k.count.n = count\n",
           "fn f(k: mut E, count: i32):\n    if k == .count:\n        k.count.n = count\n");
}

export void test_front_fix_place_a_discard_is_written_with_a_colon() {
    expect("fn f():\n    _ = write(1, \"x\", 1)\n", "fn f():\n    _ := write(1, \"x\", 1)\n");
}

export void test_front_fix_place_a_discard_inside_a_block_keeps_its_indent() {
    expect("fn f(k: E):\n    if k == .a:\n        _ = take(k)\n",
           "fn f(k: E):\n    if k == .a:\n        _ := take(k)\n");
}

export void test_front_fix_place_a_comparison_with_underscore_and_a_name_ending_in_it_are_left() {
    expect("fn f(a_: i32):\n    a_ = 1\n    _x = 2\n    _ == 3\n",
           "fn f(a_: i32):\n    a_ = 1\n    _x = 2\n    _ == 3\n");
}

// A loop name or a `mut` name is changed in place, so `x.*` of it is `x` (#3251); the fixer is the whole pipeline.
static void expect_fixed(Str before, Str after) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed first = fix::fix_text("t.smith", before);
    test::check_equal(first.text, after);
    fix::Fixed again = fix::fix_text("t.smith", first.text);
    test::check_equal(again.text, after);
}

// (b): the loop name written through is `mut` and loses its star.
export void test_front_fix_place_a_loop_name_written_through_is_mut_and_loses_its_star() {
    expect_fixed("fn double_all(xs: []i32):\n    for p in xs:\n        p.* *= 2\n",
                 "fn double_all(xs: []i32):\n    for mut p in xs:\n        p *= 2\n");
}

// Every read and write of the name in the body, in the body of a generic that a call instantiates.
export void test_front_fix_place_every_star_of_the_loop_name_goes() {
    expect_fixed(
        "fn bump(xs: auto):\n    for p in xs:\n        p.* += 10\n        p.* *= 2\nfn run(xs: []i32):\n    bump(xs)\n",
        "fn bump(xs: auto):\n    for mut p in xs:\n        p += 10\n        p *= 2\nfn run(xs: []i32):\n    "
        "bump(xs)\n");
}

// (a): a `mut` parameter is changed in place, so only the `.*` goes.
export void test_front_fix_place_a_mut_parameter_loses_its_star() {
    expect_fixed("fn grow(mut n: i32):\n    n.* += 1\n", "fn grow(mut n: i32):\n    n += 1\n");
}

// A pointer keeps its star: the loop over `refs(xs)` names pointers.
export void test_front_fix_place_a_pointer_loop_name_keeps_its_star() {
    expect_fixed("fn f(xs: []i32):\n    for p in refs(xs):\n        p.* *= 2\n",
                 "fn f(xs: []i32):\n    for p in refs(xs):\n        p.* *= 2\n");
}

// A test with an `else` and a test written `else if` are the same fix (#3616): the else branch reads nothing of the
// payload, and each test of one enumeration binds its own variant.
export void test_front_fix_place_an_else_branch_and_an_else_if_test_are_fixed() {
    expect("fn f(k: mut E):\n    if k == .count:\n        k.count.n += 1\n    else:\n        use(k)\n",
           "fn f(k: mut E):\n    if .count(count) := &k:\n        count.n += 1\n    else:\n        use(k)\n");
    expect("fn g(k: mut E):\n    if k == .size and k.size.n > 0:\n        use(k)\n    else if k == .count:\n"
           "        k.count.n += 1\n",
           "fn g(k: mut E):\n    if k == .size and k.size.n > 0:\n        use(k)\n    else if .count(count) := &k:\n"
           "        count.n += 1\n");
}

// A word of the variant inside a string is no name that the binding would hide.
export void test_front_fix_place_the_variant_in_a_string_is_no_name() {
    expect("fn f(k: mut E):\n    note(\"the count\")\n    if k == .count:\n        k.count.n += 1\n",
           "fn f(k: mut E):\n    note(\"the count\")\n    if .count(count) := &k:\n        count.n += 1\n");
}
