// Failure reports, ported from tests/test.sh (sections 5 and 10): a failure is a stack of addresses, and smith turns it
// into the failing line and the call chain. The plain-function checks print no file and line themselves, so the runner
// on its own prints the raw trace; smith symbolize (and smith test, which pipes the runner through it) reads the
// source. Each case runs as workers and with --isolate. Fixtures: tests/build_fixtures/runner_reports, _segv, _objc,
// _contracts and _sanitized.
module test_runner_reports_test;

import std::arena;
import std::format;
import std::mem;
import std::test;
import target;
import runner;
import scratch;

// A copy of the shared build of the runner (runner::built_copy): its debug information names the sources relative to
// the project, so a report read in the copy prints `tests/test_reports.smith:N`, and no test builds a runner of its
// own.
static scratch::Project reports_project() {
    return runner::built_copy("runner_base", "runner_reports", "-DSAN=0");
}

// What smith test prints for one test of the project (its two streams in one).
static const char *sym(const scratch::Project *p, const char *iso, const char *name) {
    scratch::Run run = runner::smith_test(p, iso, format::push("-DSAN=0 --test ", name).data);
    return run.out;
}

static const char *at_line(const char *prefix, Usize line) {
    return format::push(prefix, line).data;
}

// Section 5. SIGSEGV without the sanitizers is named.
export void test_runner_reports_a_sigsegv_without_the_sanitizers_is_named() {
    scratch::Project p = runner::project("runner_base", "runner_segv");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    scratch::Run built = runner::build(&p, "-DSAN=0");
    scratch::expect_status("crash: the runner builds without sanitizers", 0, &built);
    for (Usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = runner::tests(&p, iso, "");
        runner::expect_has(iso, "crash: a SIGSEGV is named", &run, "FAIL crash: killed by SIGSEGV");
        runner::expect_has(iso, "crash: ... with the note", &run, "    note: about to crash");
        runner::expect_has(iso, "crash: ... and the other test passed", &run, "1 passed, 1 failed");
    }
}

// The runner is built with -fdebug-compilation-dir=. , which LLVM joins to the file name as `./tests/x`; the report
// names the source as the project does (shim/symbolize.cpp drops the `./`, #782).
export void test_runner_reports_a_source_is_named_relative_to_the_project_without_a_dot_slash() {
    scratch::Project p = reports_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!runner::can_symbolize(&p)) return;
    for (Usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        const char *traced = runner::symbolized(&p, iso, "--test check_fails");
        scratch::expect_contains(runner::label(iso, "path: the source is named from the project"), traced,
                                 " at tests/test_reports.smith:");
        scratch::expect_lacks(runner::label(iso, "path: ... never with a leading ./"), traced, "./tests/");
    }
}

export void test_runner_reports_the_plain_function_checks_print_a_raw_trace_with_the_values() {
    scratch::Project p = reports_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    for (Usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run passes = runner::tests(&p, iso, "--test passes --verbose");
        runner::expect_has(iso, "reports: the plain-function checks pass", &passes, "PASS passes");
        // Without smith in the pipe, a failure prints the trace and the values.
        scratch::Run check = runner::tests(&p, iso, "--test check_fails");
        runner::expect_has(iso, "raw: a failed smith_check prints a trace block", &check,
                           "  smith-trace begin check failed");
        runner::expect_has(iso, "raw: ... with frames", &check, "  smith-trace frame 0x");
        runner::expect_has(iso, "raw: ... and the image's UUID", &check, "  smith-trace image ");
        scratch::Run equal = runner::tests(&p, iso, "--test equal_fails");
        runner::expect_has(iso, "raw: a failed check_equal shows a", &equal, "    a = 3   (U64)");
        runner::expect_has(iso, "raw: ... and b", &equal, "    b = 4   (U64)");
        scratch::Run ordering = runner::tests(&p, iso, "--test ordering_fails");
        runner::expect_has(iso, "raw: a failed ordering check shows a", &ordering, "    a = 4   (I32)");
        runner::expect_has(iso, "raw: ... and b", &ordering, "    b = 3   (I32)");
        scratch::Run property = runner::tests(&p, iso, "--test prop_function --shrink-seconds 3600");
        runner::expect_has(iso, "raw: a property test's failed function check shrinks", &property, "shrunk in");
        runner::expect_has(iso, "raw: ... to the smallest case", &property, "    note: x = 500");
        scratch::Run near = runner::tests(&p, iso, "--test near_fails");
        runner::expect_has(iso, "raw: a failed check_near shows the distance", &near, "= 0.5 [0x1p-1]");
        scratch::Run bits = runner::tests(&p, iso, "--test same_bits_fails");
        runner::expect_has(iso, "raw: a failed check_same_bits shows the bits", &bits, "    a = 0 [0x0p+0]");
        scratch::Run list = scratch::sh(&p, "build/tests --list");
        runner::expect_has(iso, "reports: --list sees the new tests", &list, "segfault");
    }
}

export void test_runner_reports_a_failed_check_and_a_failed_equal_name_their_lines() {
    scratch::Project p = reports_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!runner::can_symbolize(&p)) return;
    Usize check_line = runner::line_of(&p, "tests/test_reports.smith", "test::check(moves > 0);");
    Usize equal_line = runner::line_of(&p, "tests/test_reports.smith", "test::check_equal(count, expected);");
    for (Usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        const char *check = sym(&p, iso, "check_fails");
        scratch::expect_contains(runner::label(iso, "report: a failed test::check names the line"), check,
                                 at_line("  check failed at tests/test_reports.smith:", check_line));
        scratch::expect_contains(runner::label(iso, "report: ... shows the source line"), check,
                                 format::push(check_line, " |     test::check(moves > 0);").data);
        scratch::expect_contains(runner::label(iso, "report: ... and the call chain"), check, "  called from");
        scratch::expect_contains(runner::label(iso, "report: ... whose first frame is the test"), check,
                                 at_line("tests/test_reports.smith:", check_line));
        scratch::expect_contains(runner::label(iso, "report: ... and whose last is the runner"), check,
                                 "smith_test_execute");
        scratch::expect_lacks(runner::label(iso, "report: ... without the check machinery of std::test"), check,
                              "std::test::");
        scratch::expect_lacks(runner::label(iso, "report: ... or the raw trace"), check, "smith-trace");

        const char *equal = sym(&p, iso, "equal_fails");
        scratch::expect_contains(runner::label(iso, "report: a failed check_equal names the line"), equal,
                                 at_line("  check failed at tests/test_reports.smith:", equal_line));
        scratch::expect_contains(
            runner::label(iso, "report: ... and prints both values under the source line, named by their text"), equal,
            format::push(equal_line,
                         " |     test::check_equal(count, expected);\n            count = 3, expected = 4   (U64)\n  "
                         "called from")
                .data);
    }
}

export void test_runner_reports_an_assert_a_segfault_and_an_inlined_check_name_their_lines() {
    scratch::Project p = reports_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!runner::can_symbolize(&p)) return;
    Usize assert_line = runner::line_of(&p, "tests/test_reports.smith", "c::assert(moves == 2);");
    Usize segv_line = runner::line_of(&p, "tests/test_reports.smith", "*nothing = 7;");
    Usize inline_line = runner::line_of(&p, "tests/test_reports.smith", "test::check(value > 0);");
    Usize caller_line = runner::line_of(&p, "tests/test_reports.smith", "check_positive(-1);");
    Usize order_line = runner::line_of(&p, "tests/test_reports.smith", "test::check_less_equal(total, 3);");
    // assert's own message is libc's: Apple's and glibc's differ
    const char *assert_message = "Assertion `moves == 2' failed.";
    if constexpr (target::os == target::macos) {
        assert_message = "Assertion failed: (moves == 2)";
    }
    for (Usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        const char *assert_report = sym(&p, iso, "assert_fails");
        scratch::expect_contains(runner::label(iso, "report: an assert names the line"), assert_report,
                                 at_line("  aborted at tests/test_reports.smith:", assert_line));
        scratch::expect_contains(runner::label(iso, "report: ... shows it"), assert_report,
                                 format::push(assert_line, " |     c::assert(moves == 2);").data);
        scratch::expect_contains(runner::label(iso, "report: ... and keeps assert's own message"), assert_report,
                                 assert_message);
        scratch::expect_lacks(runner::label(iso, "report: ... without libc's abort path"), assert_report,
                              "pthread_kill");

        const char *segv = sym(&p, iso, "segfault");
        scratch::expect_contains(runner::label(iso, "report: a segfault names the line"), segv,
                                 format::push("FAIL segfault: killed by SIGSEGV\n  crashed at "
                                              "tests/test_reports.smith:",
                                              segv_line)
                                     .data);
        scratch::expect_contains(runner::label(iso, "report: ... shows it"), segv,
                                 format::push(segv_line, " |     *nothing = 7;").data);

        const char *inlined = sym(&p, iso, "inlined");
        scratch::expect_contains(runner::label(iso, "report: an inlined check names the inlined line"), inlined,
                                 at_line("  check failed at tests/test_reports.smith:", inline_line));
        scratch::expect_contains(runner::label(iso, "report: ... and the chain has the inlined function"), inlined,
                                 "check_positive");
        scratch::expect_contains(runner::label(iso, "report: ... and the function it was inlined into"), inlined,
                                 at_line("tests/test_reports.smith:", caller_line));

        const char *ordering = sym(&p, iso, "ordering_fails");
        scratch::expect_contains(runner::label(iso, "report: an ordering check's failure has the same report"),
                                 ordering, at_line("  check failed at tests/test_reports.smith:", order_line));
        scratch::expect_contains(runner::label(iso, "report: ... and its values"), ordering,
                                 "    total = 4, 3   (I32)");
    }
}

// Objective-C frames and methods.
export void test_macos_runner_reports_a_check_inside_an_objective_c_method_names_the_method() {
    if constexpr (target::os != target::macos) {
        return; // Objective-C here needs Apple's Foundation
    }
    scratch::Project p = runner::project("runner_base", "runner_objc");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!runner::can_symbolize(&p)) return;
    Usize line = runner::line_of(&p, "tests/test_objc.m", "smith_check(value > 0);");
    for (Usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = runner::smith_test(&p, iso, "-DSAN=0");
        runner::expect_has(iso, "objc: a check inside a method names the line", &run,
                           at_line("  check failed at tests/test_objc.m:", line));
        runner::expect_has(iso, "objc: ... and the method is in the chain", &run, "-[Probe requirePositive:]");
        runner::expect_has(iso, "objc: ... called from the test", &run, "test_objc_fails");
    }
}

// The Apple linker, in place of lld: the same debug map.
export void test_macos_runner_reports_a_program_linked_by_apples_ld_has_lines_too() {
    scratch::Project p = reports_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!runner::can_symbolize(&p)) return;
    Usize line = runner::line_of(&p, "tests/test_reports.smith", "test::check(moves > 0);");
    (void)scratch::sh(&p, "rm -f build/tests");
    for (Usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = scratch::sh(&p, format::push("env SMITH_OUTPUT=full SMITH_LINKER=/usr/bin/ld smith test ",
                                                        iso, " -DSAN=0 --test check_fails 2>&1")
                                               .data);
        runner::expect_has(iso, "report: a program linked by Apple's ld has lines too", &run,
                           at_line("  check failed at tests/test_reports.smith:", line));
        (void)scratch::sh(&p, "rm -f build/tests");
    }
}

// A trace saved from a run is symbolized later, given the program.
static void check_saved_trace(const char *iso) {
    scratch::Project p = reports_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!runner::can_symbolize(&p)) return;
    Usize line = runner::line_of(&p, "tests/test_reports.smith", "test::check(moves > 0);");
    const char *wanted = at_line("  check failed at tests/test_reports.smith:", line);
    (void)scratch::sh(&p, format::push("build/tests ", iso, " --test check_fails --trace >trace.txt 2>&1").data);
    scratch::expect_contains(runner::label(iso, "symbolize: a saved trace becomes a report"),
                             scratch::sh(&p, "smith symbolize trace.txt 2>&1").out, wanted);
    scratch::expect_contains(runner::label(iso, "symbolize: ... from standard input too"),
                             scratch::sh(&p, "smith symbolize <trace.txt 2>&1").out, "called from");
    (void)scratch::sh(&p, "cp build/tests moved_tests && mv build/tests build/tests_gone");
    scratch::expect_contains(runner::label(iso, "symbolize: a program that is gone is said so"),
                             scratch::sh(&p, "smith symbolize trace.txt 2>&1").out, "note: cannot read");
    scratch::expect_contains(runner::label(iso, "symbolize: --binary names it, and its UUID is checked"),
                             scratch::sh(&p, "smith symbolize --binary moved_tests trace.txt 2>&1").out, wanted);
}

export void test_runner_reports_symbolize_reads_a_saved_trace_given_the_program() {
    check_saved_trace("");
}

export void test_runner_reports_symbolize_reads_a_saved_trace_of_a_process_per_test_runner() {
    check_saved_trace("--isolate");
}

// A source file newer than the program may have changed since; a trace of another program names no line.
static void check_changed_sources(const char *iso) {
    scratch::Project p = reports_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!runner::can_symbolize(&p)) return;
    Usize line = runner::line_of(&p, "tests/test_reports.smith", "test::check(moves > 0);");
    (void)scratch::sh(&p, format::push("build/tests ", iso, " --test check_fails --trace >trace.txt 2>&1").data);
    // a source newer than the program is noted
    scratch::sleep(&p, 1000);
    (void)scratch::sh(&p, "touch tests/test_reports.smith");
    const char *newer = runner::symbolized(&p, iso, "--test check_fails");
    scratch::expect_contains(
        runner::label(iso, "newer: a source newer than the program is noted"), newer,
        format::push("note: tests/test_reports.smith is newer than the program, so line ", line, " may have changed")
            .data);
    // A trace of another program: the UUID differs, and no line is made up.
    (void)scratch::sh(&p, "printf '\\n' >>tests/test_reports.smith");
    (void)scratch::sh(&p,
                      "printf 'void test_extra(void) {\\n    test::check(true);\\n}\\n' >>tests/test_reports.smith");
    scratch::Run rebuilt = runner::build(&p, "-DSAN=0");
    scratch::expect_status("symbolize: the changed program builds", 0, &rebuilt);
    const char *other = scratch::sh(&p, "smith symbolize trace.txt 2>&1").out;
    scratch::expect_contains(runner::label(iso, "symbolize: a program that is not the one that ran is noted"), other,
                             "is not the program that ran");
    scratch::expect_lacks(runner::label(iso, "symbolize: ... and no line is claimed"), other, "check failed at tests/");
}

export void test_runner_reports_a_source_newer_than_the_program_and_another_program_are_noted() {
    check_changed_sources("");
}

export void test_runner_reports_a_source_newer_than_the_program_is_noted_for_a_process_per_test_runner() {
    check_changed_sources("--isolate");
}

// smith as llvm-symbolizer: the sanitizers' protocol.
export void test_runner_reports_smith_as_llvm_symbolizer_answers_the_sanitizers_protocol() {
    scratch::Project p = reports_project();
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!runner::can_symbolize(&p)) return;
    scratch::Run linked = scratch::sh(&p, "ln -s \"$SMITH_SELF\" llvm-symbolizer");
    scratch::expect_status("protocol: the link is made", 0, &linked);
    // Mach-O symbols have a leading underscore and the request names the architecture
    const char *symbol = "test_check_fails";
    const char *arch = "x86_64";
    if constexpr (target::arch == target::aarch64) {
        arch = "aarch64";
    }
    if constexpr (target::os == target::macos) {
        symbol = "_test_check_fails";
        arch = "arm64";
    }
    const char *address =
        scratch::capture(&p, format::push("nm build/tests | awk '$3 == \"", symbol, "\" {print $1}'").data);
    const char *code =
        scratch::capture(&p, format::push("printf 'CODE \"%s:", arch, "\" 0x%s\\n' \"$PWD/build/tests\" '", address,
                                          "' | ./llvm-symbolizer --demangle --inlines")
                                 .data);
    scratch::expect_contains("protocol: a CODE request names the function", code, "test_check_fails");
    scratch::expect_contains("protocol: ... and the file, line and column", code, "tests/test_reports.smith:");
    const char *unknown = scratch::capture(&p, "printf '\"%s\" 0x1\\n' '/nonexistent' | ./llvm-symbolizer");
    scratch::expect_text("protocol: an unknown module gives ?? and an empty line", "??\n??:0:0", unknown);
}

// A failed contract is a failure like a failed check: smith_failure gives it the same report, and a test that called
// smith_test_expect_abort still passes on it, as it does on an assert.
export void test_runner_reports_a_failed_contract_has_the_report_of_a_failed_check() {
    scratch::Project p = runner::project("runner_base", "runner_contracts");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!runner::can_symbolize(&p)) return;
    Usize line = runner::line_of(&p, "tests/test_contracts.c", "smith_requires(value % 2 == 0);");
    Usize caller = runner::line_of(&p, "tests/test_contracts.c", "(void)halve(odd);");
    for (Usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run run = runner::smith_test(&p, iso, "-DSAN=0");
        runner::expect_has(iso, "contract: a failed smith_requires names its line", &run,
                           at_line("  requires failed at tests/test_contracts.c:", line));
        runner::expect_has(iso, "contract: ... shows the source", &run,
                           format::push(line, " |     smith_requires(value % 2 == 0);").data);
        runner::expect_has(iso, "contract: ... and the call chain, with the caller", &run,
                           at_line("tests/test_contracts.c:", caller));
        runner::expect_has(iso,
                           "contract: smith_test_expect_abort passes on a failed contract, and the true one passes",
                           &run, "2 passed, 1 failed");
        runner::expect_lacks(iso, "contract: ... with no smith_failure frame in the chain", &run, "smith_failure");
    }
}

// A sanitizer's report is symbolized by smith, through the llvm-symbolizer protocol, and AddressSanitizer's own stack
// is what the failure shows.
export void test_runner_reports_a_sanitizer_report_is_symbolized_by_smith() {
    scratch::Project p = runner::project("runner_base", "runner_sanitized");
    defer scratch::clean(&p);
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    if (!runner::can_symbolize(&p)) return;
    Usize read_line = runner::line_of(&p, "tests/test_overflow.c", "return values[count];");
    Usize signed_line = runner::line_of(&p, "tests/test_overflow.c", "volatile int more = big + 1;");
    for (Usize mode = 0; mode < 2; mode++) {
        const char *iso = runner::flag(mode);
        scratch::Run asan = runner::smith_test(&p, iso, "--test overflow");
        runner::expect_has(iso, "asan: the report's innermost user frame is named", &asan, "in read_past ");
        runner::expect_has(iso, "asan: ... with its line", &asan, at_line("tests/test_overflow.c:", read_line));
        runner::expect_has(iso, "asan: ... and the caller's", &asan, "in test_overflow ");
        runner::expect_lacks(iso, "asan: ... with no module offsets, which atos gives without a dSYM", &asan,
                             "tests:arm64+0x");
        scratch::Run ubsan = runner::smith_test(&p, iso, "--test signed_overflow");
        runner::expect_has(iso, "ubsan: the report names the line", &ubsan,
                           at_line("tests/test_overflow.c:", signed_line));
    }
}
