// scripts/ci-tree.sh (issue #110) with no network, from tests/ci_tree.sh: the tree of a scratch git repository, and
// both branches of the skip rule against a stub gh (tests/build_fixtures/ci_tree/gh) that answers from the environment.
module ci_tree_test;

import std::format;
import std::io;
import std::test;
import scratch;

// Every command: the stub gh first on PATH, the script, and the trees of the two commits.
constexpr char prelude[_] =
    "export PATH=\"$PWD/../bin:$PATH\" GITHUB_REPOSITORY=o/r; script=\"$SMITH_REPO/scripts/ci-tree.sh\"; "
    "tree1=$(git rev-parse HEAD~1^{tree}); tree2=$(git rev-parse HEAD^{tree}); ";

// A repository of two commits in a folder, the stub gh in ../bin.
static scratch::Project repository(io::Io *io) {
    scratch::Project p = scratch::project(io, "repo", nullptr);
    scratch::Run made = scratch::sh(
        &p, "mkdir ../bin && cp \"$SMITH_REPO/tests/build_fixtures/ci_tree/gh\" ../bin/gh && chmod +x ../bin/gh && "
            "git init -q . && git config user.email t@t && git config user.name t && echo a >f && git add f && "
            "git commit -qm one && echo b >f && git commit -qam two");
    scratch::expect_status("ci_tree: the repository is made", 0, &made);
    return p;
}

// The output of commands run after the prelude.
static const char *script(io::Io *io, const scratch::Project *p, const char *commands) {
    return scratch::capture(p, format::push(&io->arena, prelude, commands).data);
}

// The output of one call of the script with the stub answering `answer` for the first tree.
static const char *ask(io::Io *io, const scratch::Project *p, const char *answer, const char *call) {
    return script(io, p,
                  format::push(&io->arena, "export STUB_NAME=tree-$tree1 STUB_ANSWER='", answer, "'; ", call).data);
}

export void test_ci_tree_tree_is_the_tree(io::Io *io) {
    scratch::Project p = repository(io);
    scratch::expect_text("ci_tree: tree-is-the-tree", scratch::capture(&p, "git rev-parse 'HEAD^{tree}'"),
                         script(io, &p, "sh \"$script\" tree"));
}

export void test_ci_tree_same_files_same_tree(io::Io *io) {
    scratch::Project p = repository(io);
    // a rebase or amend that keeps the files keeps the tree
    scratch::Run amended = scratch::sh(&p, "git commit -q --amend -m reworded");
    scratch::expect_status("ci_tree: amend", 0, &amended);
    scratch::expect_text("ci_tree: same-files-same-tree", script(io, &p, "echo $tree2"),
                         script(io, &p, "sh \"$script\" tree"));
}

export void test_ci_tree_a_changed_file_changes_the_tree(io::Io *io) {
    scratch::Project p = repository(io);
    test::check_condition(!scratch::same(script(io, &p, "echo $tree1"), script(io, &p, "echo $tree2")));
}

export void test_ci_tree_a_checked_tree_is_found_and_skipped(io::Io *io) {
    scratch::Project p = repository(io);
    scratch::expect_text("ci_tree: found-checked", "yes", ask(io, &p, "4242", "sh \"$script\" checked \"$tree1\""));
    scratch::expect_text("ci_tree: push-same-tree-skips", "skip 4242",
                         ask(io, &p, "4242", "sh \"$script\" decide push \"$tree1\""));
    scratch::expect_text("ci_tree: pr-same-tree-never-skips", "run",
                         ask(io, &p, "4242", "sh \"$script\" decide pull_request \"$tree1\""));
    scratch::expect_text("ci_tree: different-tree-runs", "run",
                         ask(io, &p, "4242", "sh \"$script\" decide push \"$tree2\""));
    scratch::expect_text("ci_tree: different-tree-not-checked", "no",
                         ask(io, &p, "4242", "sh \"$script\" checked \"$tree2\""));
}

export void test_ci_tree_an_expired_or_missing_artifact_runs(io::Io *io) {
    scratch::Project p = repository(io);
    scratch::expect_text("ci_tree: expired-or-missing-runs", "run",
                         ask(io, &p, "", "sh \"$script\" decide push \"$tree1\""));
    scratch::expect_text("ci_tree: missing-not-checked", "no", ask(io, &p, "", "sh \"$script\" checked \"$tree1\""));
}

// fail safe: a malformed answer (not a single run id) is "not checked", so the full check runs
static void malformed_answer_runs(io::Io *io, const char *answer) {
    scratch::Project p = repository(io);
    char name[256];
    (void)format::to(name, sizeof name, "ci_tree: malformed-runs: ", answer);
    scratch::expect_text(name, "run", ask(io, &p, answer, "sh \"$script\" decide push \"$tree1\""));
    (void)format::to(name, sizeof name, "ci_tree: malformed-not-checked: ", answer);
    scratch::expect_text(name, "no", ask(io, &p, answer, "sh \"$script\" checked \"$tree1\""));
}

export void test_ci_tree_malformed_not_json(io::Io *io) {
    malformed_answer_runs(io, "not json");
}

export void test_ci_tree_malformed_null(io::Io *io) {
    malformed_answer_runs(io, "null");
}

export void test_ci_tree_malformed_html(io::Io *io) {
    malformed_answer_runs(io, "<html>502</html>");
}

export void test_ci_tree_malformed_two_ids(io::Io *io) {
    malformed_answer_runs(io, "4242 4243");
}

export void test_ci_tree_malformed_id_with_letters(io::Io *io) {
    malformed_answer_runs(io, "12abc");
}

export void test_ci_tree_malformed_empty_artifact_list(io::Io *io) {
    malformed_answer_runs(io, "{\"artifacts\":[]}");
}

export void test_ci_tree_a_failing_gh_runs(io::Io *io) {
    scratch::Project p = repository(io);
    scratch::expect_text("ci_tree: gh-fails-runs", "run",
                         ask(io, &p, "4242", "STUB_FAIL=1 sh \"$script\" decide push \"$tree1\""));
}

export void test_ci_tree_record_and_usage(io::Io *io) {
    scratch::Project p = repository(io);
    scratch::Run recorded = scratch::sh(
        &p, "GITHUB_RUN_ID=77 sh \"$SMITH_REPO/scripts/ci-tree.sh\" record \"$(git rev-parse HEAD~1^{tree})\" ../rec");
    scratch::expect_status("ci_tree: record runs", 0, &recorded);
    scratch::expect_text("ci_tree: record",
                         scratch::capture(&p, "printf 'tree %s\\nrun 77' \"$(git rev-parse HEAD~1^{tree})\""),
                         scratch::capture(&p, "cat ../rec/tree.txt"));
    scratch::expect_text("ci_tree: usage", "2",
                         scratch::capture(&p, "sh \"$SMITH_REPO/scripts/ci-tree.sh\" nonsense 2>/dev/null; echo $?"));
}
