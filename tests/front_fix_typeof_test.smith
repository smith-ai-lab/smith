// Tests of the fix-it for `typeof` of a slice parameter (#2340): `auto xs` that is read as a slice becomes an inferred
// parameter `[T](xs: []T)`, and `typeof(xs)`, `typeof(xs.data)` and `typeof(xs.data.*)` are `[]T`, `*T` and `T`.
module front_fix_typeof_test;

import front::fix;
import std::arena;
import std::mem;
import std::test;

static void expect_fixed(Str before, Str want) {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    fix::Fixed first = fix::fix_text("t.smith", before);
    test::check_equal(first.text, want);
}

export void test_front_fix_typeof_a_slice_that_is_built_is_mut() {
    expect_fixed("module m;\nexport typeof(xs) grow(auto xs, Usize n) {\n    typeof(xs) r = {};\n"
                 "    r.data = (typeof(xs.data))nullptr;\n    r.count[0] = n;\n    return r;\n}\n",
                 "pub fn grow[T](xs: []mut T, n: usize) -> []mut T:\n    r: []mut T = {}\n    r.data = "
                 "nullptr.to(*mut T)\n    r.count[0] = n\n    return r\n");
}

export void test_front_fix_typeof_a_slice_that_is_written_is_mut() {
    expect_fixed("module m;\nexport Usize first(auto xs) {\n    xs.data[0] = (typeof(*xs.data))1;\n"
                 "    return xs.count[0];\n}\n",
                 "pub fn first[T](xs: []mut T) -> usize:\n    xs.data[0] = 1.to(T)\n    return xs.count[0]\n");
}

export void test_front_fix_typeof_a_slice_that_is_only_read_is_not_mut() {
    expect_fixed(
        "module m;\nexport Usize size(auto xs) {\n    typeof(*xs.data) first = xs.data[0];\n"
        "    return xs.count[0] + sizeof(first);\n}\n",
        "pub fn size[T](xs: []T) -> usize:\n    first: T = xs.data[0]\n    return xs.count[0] + sizeof(first)\n");
}

export void test_front_fix_typeof_a_type_written_out_is_that_type() {
    expect_fixed("module m;\nstatic typeof(U8[:]) view(U8 *p) {\n    return p[0:1];\n}\n",
                 "static fn view(p: *u8) -> []u8:\n    return p[0:1]\n");
}

// A `typeof([` inside a string or a comment is text: the fixer leaves it (#2520).
export void test_front_fix_typeof_a_typeof_in_a_string_or_comment_is_unchanged() {
    expect_fixed("module m;\nstatic Bool f(Str s) {\n    return at(s, 0, \"typeof([\");\n}\n",
                 "static fn f(s: str) -> bool:\n    return at(s, 0, \"typeof([\")\n");
    expect_fixed("module m;\n// typeof([U8]) is U8\nstatic Bool g() {\n    return true;\n}\n",
                 "# typeof([U8]) is U8\nstatic fn g() -> bool:\n    return true\n");
}

export void test_front_fix_typeof_an_auto_the_body_tests_by_type_stays_auto() {
    expect_fixed("module m;\nexport Usize size_of(auto piece) {\n    if constexpr (typeof(piece) == U8) {\n"
                 "        return 1;\n    } else {\n        return countof(piece) + (Usize)piece.data[0];\n    }\n}\n",
                 "pub fn size_of(piece: auto) -> usize:\n    if typeof(piece) == u8:\n        return 1\n    else:\n"
                 "        return countof(piece) + piece.data[0].to(usize)\n");
}

// `typeof(x) == char *` is a test of a pointer type: `*mut char`, and `*char` for `const char *` (decided on #1406). The
// `*char` left to the parser would read as a dereference, `char.*`.
export void test_front_fix_typeof_a_pointer_type_a_typeof_is_compared_with() {
    expect_fixed("module m;\nexport Bool text(auto p) {\n    return typeof(p) == char * || typeof(p) != const char *;\n}\n",
                 "pub fn text(p: auto) -> bool:\n    return typeof(p) == *mut char || typeof(p) != *char\n");
}

// A slice struct written out is a slice type, `[]mut char` and `[]char`.
export void test_front_fix_typeof_a_slice_struct_a_typeof_is_compared_with() {
    expect_fixed("module m;\nexport Bool text(auto p) {\n    return typeof(p) == struct smith_array_char_n ||\n"
                 "           typeof(p) == struct smith_array_const_char_n;\n}\n",
                 "pub fn text(p: auto) -> bool:\n    return typeof(p) == []mut char ||\n           typeof(p) == []char\n");
}

// A pointer to a slice of any element type, `const auto (*xs)[:]`, is generic in the element: `[T]`, and `typeof((*xs)[0])`
// is `T` (`std.slice.take_until`).
export void test_front_fix_typeof_a_pointer_to_a_slice_of_auto_is_generic_in_its_element() {
    expect_fixed("module m;\nexport typeof((*xs)[0:0]) take_until(const auto (*xs)[:], typeof((*xs)[0]) v) {\n"
                 "    Usize n = 0;\n    while (n < countof(*xs) && (*xs)[n] != v) {\n        n += 1;\n    }\n"
                 "    return (*xs)[0:n];\n}\n",
                 "pub fn take_until[T](xs: *[]T, v: T) -> []T:\n    mut n: usize = 0\n"
                 "    while n < countof(xs.*) && (xs.*)[n] != v:\n        n += 1\n    return (xs.*)[0:n]\n");
}
