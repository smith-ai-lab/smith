// Tests of the declarations that name a type by its tag or a type value (#1266, track A of #1112): `struct Pair a =
// {...};` as a local, a field and a parameter, and `constexpr Type Meters = F64;`. They run the whole parser
// (front::parser); the dumps are goldens in tests/front/parse_local, and each error test checks that the message says
// what to write.
module front_parse_local_test;

import front::ast;
import front::parser;
import std::arena;
import std::test;

// The dump of a file, with no error allowed.
static Str dump_of(Str source) {
    parser::Parsed parsed = parser::parse("local.smith", source);
    test::check_equal(countof(parsed.errors), 0);
    return ast::dump(&parsed.module);
}

// The first error of a file.
static Str first_error(Str source) {
    parser::Parsed parsed = parser::parse("local.smith", source);
    test::check_condition(countof(parsed.errors) > 0);
    if (countof(parsed.errors) == 0) return "";
    return parsed.errors[0].message;
}

export void test_parse_local_struct_tag_as_a_local() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    Str source = "module m;\n"
                 "I32 f() {\n"
                 "    struct Pair a = {.x = 1, .y = 2};\n"
                 "    struct words::Pair b = a;\n"
                 "    struct c::timespec now = {};\n"
                 "    return a.x;\n"
                 "}\n";
    test::golden("tests/front/parse_local/local.txt", dump_of(source));
}

export void test_parse_local_struct_tag_as_a_field_and_a_parameter() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    Str source = "module m;\n"
                 "struct Line {\n"
                 "    struct Pair from;\n"
                 "    struct Pair *to;\n"
                 "};\n"
                 "constexpr struct Config config = {.count = 4};\n"
                 "I32 length(struct Pair a, struct Pair *b) { return 0; }\n";
    test::golden("tests/front/parse_local/field.txt", dump_of(source));
}

export void test_parse_local_the_type_by_itself_still_declares() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    Str source = "module m;\n"
                 "struct Pair { I32 x; I32 y; };\n"
                 "struct Opaque;\n"
                 "enum Small : U8 { a, b };\n";
    test::golden("tests/front/parse_local/by_itself.txt", dump_of(source));
}

export void test_parse_local_type_value_is_named_like_a_type() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    Str source = "module m;\n"
                 "export constexpr Type Meters = F64;\n";
    test::golden("tests/front/parse_local/type_value.txt", dump_of(source));
}

export void test_parse_local_error_c_tag_without_c() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    Str source = "module m;\n"
                 "I32 f() {\n"
                 "    struct stat info;\n"
                 "    return 0;\n"
                 "}\n";
    Str expected = "`struct stat` names a C tag; write `struct c::stat`";
    test::check_equal(first_error(source), expected);
}

export void test_parse_local_range_for() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    Str source = "module m;\n"
                 "I32 f(const I32 xs[:]) {\n"
                 "    I32 t = 0;\n"
                 "    for (I32 x : xs) { t += x; }\n"
                 "    for (auto x : xs[1:3]) { t += x; }\n"
                 "    for (Usize i, I32 x : xs) { t += x; }\n"
                 "    return t;\n"
                 "}\n";
    test::golden("tests/front/parse_local/range_for.txt", dump_of(source));
}

export void test_parse_local_error_range_for_needs_a_range() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    Str source = "module m;\n"
                 "void f(const I32 xs[:]) {\n"
                 "    for (I32 x : ) { }\n"
                 "}\n";
    test::check_condition(countof(first_error(source)) > 0);
}

export void test_parse_local_error_range_for_index_and_element_at_most() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    Str source = "module m;\n"
                 "void f(const I32 xs[:]) {\n"
                 "    for (Usize i, Usize j, I32 x : xs) { }\n"
                 "}\n";
    Str expected = "a range `for` declares an index and an element at most: `for (Usize i, T x : xs)`";
    test::check_equal(first_error(source), expected);
}
