// Scratch projects for the tests that start smith (tests/build_*_test.smith): a folder in the test's scratch folder
// (removed when the test passes), a fixture copied into it, and commands run there through the process module with the
// smith under test first on PATH. The smith under test is the one running the tests, `$SMITH_SELF` (set by
// `smith test`; set it to run a runner by hand). Each test is a process of its own, so the environment it sets is its.
// NOLINTBEGIN(smith-mem): #421: importing smith::mem breaks every test that imports scratch; convert to mem:: after it
module scratch;

import smith::arena;
import smith::clock;
import smith::env;
import smith::files;
import smith::format;
import smith::mem;
import smith::process;
import smith::test;
import <smith_core.h>;
import <string.h>;

// The bytes of a buffer, for the calls of files that take a slice.
static typeof(const u8[:]) bytes_of(const void *data, usize size) {
    const u8 *bytes = (const u8 *)data;
    return bytes[0:size];
}

export typedef struct {
    const char *root;   // the folder scratch::make made, which scratch::clean removes
    const char *dir;    // where commands run
    const char *tested; // a folder with smith, smith-cc and smith-c++ for PATH
    const char *cache;  // XDG_CACHE_HOME of the commands
} Project;

export typedef struct {
    i32 status; // the exit status; 128 and the signal when killed
    const char *out;
    const char *err;
} Run;

// ---------------------------------------------------------------- memory
// Returned memory is the caller's to free: what scratch::make holds for itself (the project's paths) is freed by
// scratch::clean, and the text a Run, scratch::read or scratch::capture returns to a test is malloc'd and belongs to
// the test, which frees it (`defer scratch::release(run.out);`). A test that does not fails with `memory leaked`, at
// the line that allocated it.

// Gives back a text that scratch returned (a Run's out and err, `read`, `capture`).
export void release(const char *text) {
    mem::free((void *)(usize)text);
}

// The bytes as a terminated text of its own.
static const char *bytes_text(process::Bytes bytes) {
    char *copy = mem::alloc_slice(char, countof(bytes) + 1).data;
    for (usize i = 0; i < countof(bytes); i++) {
        copy[i] = (char)bytes[i];
    }
    copy[countof(bytes)] = '\0';
    return copy;
}

// A text of its own: the pieces one after another.
static const char *join_free(const char *a, const char *b, const char *c) {
    usize length = format::length(a, b, c);
    char *text = mem::alloc_slice(char, length + 1).data;
    (void)format::to(text, length + 1, a, b, c);
    return text;
}

// The run of a command: the process module's output is copied into texts of the caller's and what the
// process module allocated is given back.
static Run run_free(const char *const argv[:]) {
    process::OutputResult done = process::run(argv);
    if (done == .ok) {
        process::Output output = done.ok;
        Run run = {
            .status = output.exit.signal != 0 ? 128 + output.exit.signal : output.exit.status,
            .out = bytes_text(output.output),
            .err = bytes_text(output.errors),
        };
        if (output.output.data != nullptr) mem::free(output.output.data);
        if (output.errors.data != nullptr) mem::free(output.errors.data);
        return run;
    }
    test::note("the command could not start");
    test::check_equal(0, 1);
    return (Run){};
}

// Runs `sh -c script arg0 arg1` and returns what it printed, to free; the status must be 0.
static const char *script_free(const char *script, const char *arg0, const char *arg1) {
    const char *const argv[_] = {"sh", "-c", script, arg0, arg1, nullptr};
    Run run = run_free(argv[0:5]);
    if (run.status != 0) {
        test::note("%s failed: %s", script, run.err);
    }
    test::check_equal(run.status, 0);
    release(run.err);
    return run.out;
}

// The cache of the commands ($3) is the project's own when it has one; else it is shared by every test of the run and
// of the runs before it (keyed by content, so what is cached is what a cold cache would make: the SDK's Clang modules,
// above all, which each project would build again): $SMITH_TEST_CACHE/xdg, else ~/.cache/smith-tests/xdg, never the
// real one. The data folder (the embedded files and the programs) is shared the same way, $SMITH_TEST_CACHE/data: a
// test's own folder cost, for every test, 20 MB of embedded files written and three new clones of smith (clang,
// clang++, ld) that macOS's XProtect scans before they run, about 30 s of a loaded host against 0.5 s with a folder
// that is already made (#442). The folder is keyed by the smith's LC_UUID, a running smith holds a lock on its programs
// folder, so a smith that another test rebuilds can never prune the programs this test runs; a test that is about the
// data folder sets its own XDG_DATA_HOME.
// A command with no shell feature in it is run in place of the shell that starts it. The smith a test starts takes no
// cores of the host's pool (SMITH_SLOTS=0): the test's own worker already holds one, and a test of the executor's
// concurrency must not wait for a core a busy host does not have; tests/slots_test.smith sets its own pool. The step
// cache is off (SMITH_STEP_CACHE=0): a test of what the executor rebuilds must run the compile it counts; tests/
// build_step_cache_test.smith turns it on, with a cache of its own.
constexpr char run_script[_] =
    "unset SMITH_ACCOUNT_FILE; export SMITH_SLOTS=0 SMITH_STEP_CACHE=0; here=$PWD; repo=${SMITH_REPO:-$PWD}; cd \"$0\" "
    "|| exit 97; "
    "cache=$3; [ -n \"$cache\" ] || cache=${SMITH_TEST_CACHE:-$HOME/.cache/smith-tests}/xdg; "
    "data=${SMITH_TEST_CACHE:-$HOME/.cache/smith-tests}/data; "
    "[ -d \"$cache\" ] && [ -d \"$data\" ] || mkdir -p \"$cache\" \"$data\"; "
    "export PATH=\"$2:$PATH\" XDG_CACHE_HOME=\"$cache\" XDG_DATA_HOME=\"$data\" SMITH_REPO=\"$repo\" "
    "SMITH_HEADERS_FROM=\"${SMITH_HEADERS_FROM:-$here/.smith/include/smith}\" "
    "SMITH_TEST_CACHE=\"${SMITH_TEST_CACHE:-$HOME/.cache/smith-tests}\"; "
    "case $1 in *[!A-Za-z0-9_./:=@%+,\\ -]*) eval \"$1\" ;; *) exec $1 ;; esac";
constexpr char setup_script[_] =
    "mkdir -p \"$0/tested\" \"$1\" && for n in smith smith-cc smith-c++; do ln -sf "
    "\"$SMITH_SELF\" \"$0/tested/$n\"; done; "
    "if [ \"$(uname -s)\" != Darwin ]; then printf '#!/bin/sh\\nunset SMITH_CLANG\\nexec smith-cc \"$@\"\\n' "
    ">\"$0/tested/cc\" && chmod +x \"$0/tested/cc\"; fi";

// Runs `sh -c command` in a folder and waits. The commands see the smith under test first on PATH, a cache of their own
// (never the real one) and the repository as $SMITH_REPO (where the runner was started). Nothing is set in this
// process: the environment is made by the shell that runs the command.
static Run run_in(const Project *p, const char *command) {
    const char *const argv[_] = {"sh", "-c", run_script, p->dir, command, p->tested, p->cache, nullptr};
    return run_free(argv[0:7]);
}

// The pieces as text on `arena`, which is the allocator while it is pushed: what a test builds in its arena goes back
// with the arena, so no text is freed one at a time.
export format::Chars push(arena::Arena *arena, auto... args) {
    arena::ArenaAllocator allocator = arena::allocator(arena);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    return format::push(args...);
}

static const char *path_in(const Project *p, const char *name) {
    return join_free(p->dir, "/", name); // the caller frees
}

// The copy: the source is a folder (its contents) or a file; a link stays a link.
constexpr char copy_script[_] =
    "src=\"${SMITH_REPO:-.}/$1\"; if [ -d \"$src\" ]; then mkdir -p \"$0\" && cp -PR \"$src/.\" \"$0\"; "
    "else mkdir -p \"$(dirname \"$0\")\" && cp -PR \"$src\" \"$0\"; fi";

// Copies a file or a folder of the repository (`source`, relative to $SMITH_REPO) into the project as `name`: a file
// becomes the file `name`, a folder's contents go into the folder `name` ("" is the project itself), like `cp -R
// source/. name`; a symbolic link in a folder stays a link. A test that hands a repository file to a process copies it
// first and gives the process the copy; no command reads the repository in place.
export void copy_tree(const Project *p, const char *source, const char *name) {
    const char *to = name[0] == '\0' ? join_free(p->dir, "", "") : path_in(p, name);
    const char *const argv[_] = {"sh", "-c", copy_script, to, source, nullptr};
    Run run = run_free(argv[0:5]);
    if (run.status != 0) {
        test::note("%s could not be copied: %s", source, run.err);
    }
    test::check_equal(run.status, 0);
    release(run.out);
    release(run.err);
    release(to);
}

static bool ends_with(const char *text, const char *suffix) {
    usize length = c::strlen(text);
    usize tail = c::strlen(suffix);
    return length >= tail && c::strcmp(text + length - tail, suffix) == 0;
}

// The names in a folder of the repository (`folder`, relative to $SMITH_REPO) that the source of a test file never
// calls as `<call>"<name>")`: the ones that end in `suffix_a` or `suffix_b` (every name when both are nullptr). A table
// of cases whose test file must name each of them uses it. The folder and the source are read through smith::files,
// and the text returned ("" when nothing is missing) belongs to the caller.
export const char *untested_names(const char *folder, const char *test_source, const char *call, const char *suffix_a,
                                  const char *suffix_b) {
    env::Value repo = env::get("SMITH_REPO");
    const char *base = repo == .some ? repo.some.data : ".";
    const char *source_path = join_free(base, "/", test_source);
    files::BytesResult source_read = files::read_file(source_path[0:c::strlen(source_path)]);
    release(source_path);
    files::Bytes source = {};
    switch (source_read) {
    case .ok:
        source = source_read.ok;
        break;
    case .error:
        test::check_condition(false);
    }
    const char *folder_path = join_free(base, "/", folder);
    files::EntriesResult listed = files::list(folder_path[0:c::strlen(folder_path)]);
    release(folder_path);
    files::Entries entries = {};
    switch (listed) {
    case .ok:
        entries = listed.ok;
        break;
    case .error:
        test::check_condition(false);
    }
    const char *text = bytes_text(source);
    const char *missing = join_free("", "", "");
    for (usize i = 0; i < countof(entries); i++) {
        const char *name = entries[i].name.data;
        bool wanted = (suffix_a == nullptr && suffix_b == nullptr) ||
                      (suffix_a != nullptr && ends_with(name, suffix_a)) ||
                      (suffix_b != nullptr && ends_with(name, suffix_b));
        if (wanted) {
            const char *needle = join_free(call, "\"", name);
            const char *full = join_free(needle, "\")", "");
            release(needle);
            bool found = c::strstr(text, full) != nullptr;
            release(full);
            if (!found) {
                const char *grown = join_free(missing, name, "\n");
                release(missing);
                missing = grown;
            }
        }
        release(name);
    }
    release(text);
    if (countof(entries) > 0) mem::free(entries.data);
    if (source.data != nullptr) mem::free(source.data);
    return missing;
}

// A project: a folder from `mktemp -d` under $TMPDIR, the files of the
// fixture in it, and the commands run through the process module. The project's paths are malloc'd; `scratch::clean`
// frees them and removes the folder (`defer scratch::clean(&p);` after the make). A test that fails keeps the folder.
// Links named smith, smith-cc and smith-c++ to the smith under test ($SMITH_SELF) are in a folder that is first on PATH
// for its commands; the fixtures' `cc` is a C23 clang, as macOS's is, and on Linux, where it is GCC, that folder has a
// `cc` that runs the smith-cc under test.
export Project make(const char *name, const char *fixture) {
    const char *made =
        script_free("d=${TMPDIR:-/tmp}; [ -d \"$d\" ] || d=/tmp; mktemp -d \"$d/smith-scratch-XXXXXX\"", "", "");
    usize length = c::strlen(made);
    while (length > 0 && made[length - 1] == '\n') {
        length--;
    }
    char *folder = mem::alloc_slice(char, length + 1).data;
    mem::copy(folder[0:length], made[0:length]);
    folder[length] = '\0';
    release(made);
    Project p = {
        .root = folder, .dir = join_free(folder, "/", name), .tested = join_free(folder, "/", "tested"), .cache = ""};
    const char *const argv[_] = {"sh", "-c", setup_script, folder, p.dir, nullptr};
    Run set_up = run_free(argv[0:5]);
    test::check_equal(set_up.status, 0);
    release(set_up.out);
    release(set_up.err);
    if (fixture != nullptr) {
        release(script_free("cp -R \"${SMITH_REPO:-.}/tests/build_fixtures/$1/.\" \"$0\"", p.dir, fixture));
    }
    return p;
}

// Removes the folder of a project made by `make` and frees the memory the project holds for itself.
export void clean(Project *p) {
    release(script_free("rm -rf \"$0\"", p->root, ""));
    release(p->root);
    release(p->dir);
    release(p->tested);
    if (p->cache[0] != '\0') release(p->cache);
    *p = (Project){};
}

// The project gets a cache of its own, empty, for a test of the cache or of what a cold one does.
export void own_cache(Project *p) {
    p->cache = join_free(p->root, "/", "xdg-cache"); // clean frees it
}

// Runs a shell command in the project: `smith build -v`, `./build/app`, `cp a b`. `smith` is the smith under test.
export Run sh(const Project *p, const char *command) {
    return run_in(p, command);
}

// `smith build` with the arguments in a string.
export Run build(const Project *p, const char *arguments) {
    const char *command = join_free("smith build ", arguments, "");
    Run run = run_in(p, command);
    release(command);
    return run;
}

export void write(const Project *p, const char *name, const char *text) {
    const char *path = path_in(p, name);
    release(script_free("printf %s \"$1\" > \"$0\"", path, text));
    release(path);
}

constexpr usize lowered_capacity = 1U << 23;
constexpr usize lowered_errors_capacity = 1U << 16;
static char lowered_text[lowered_capacity];
static char lowered_errors[lowered_errors_capacity];

// A file of the project, in a folder made for it.
static void write_in_new_folder(const Project *p, const char *name, const char *text) {
    // through smith::files: a lowered text is larger than one argument of a command may be
    const char *path = path_in(p, name);
    const char *slash = c::strrchr(path, '/');
    files::DoneResult made = files::make_folder(path[0:(usize)(slash - path)]);
    test::check_condition(made == .ok);
    files::CountResult written =
        files::write_file(path[0:c::strlen(path)], bytes_of(text, c::strlen(text)), files::Replace);
    test::check_condition(written == .ok);
    release(path);
}

// The in-process lowering reads its source in C: the file is read through smith::files first, so that a source that
// cannot be read fails the test with its path (the modules it imports are not named).
static void open_source(const char *folder, const char *source) {
    const char *path = join_free(folder, "/", source);
    files::BytesResult file = files::read_file(path[0:c::strlen(path)]);
    if (file == .error) {
        test::note("%s cannot be read", path);
    }
    release(path);
    test::check_condition(file == .ok);
    if (file == .ok && file.ok.data != nullptr) mem::free(file.ok.data);
}

// $SMITH_REPO, where the runner was started; "." when it is not set.
static const char *repo_of() {
    env::Value repo = env::get("SMITH_REPO");
    return repo == .some ? repo.some.data : ".";
}

// The raw lowering of `$SMITH_REPO/<source>` (what `smith cc --smith-lower` prints) written to `name` in the project,
// made in process (issue #646) where the test only needs the text. A lowering that reports an error fails the test.
export void write_lowered(const Project *p, const char *source, const char *name) {
    const char *repo = repo_of();
    open_source(repo, source);
    bool done = c::smith_core_lower(repo, source, nullptr, lowered_text, lowered_capacity, lowered_errors,
                                    lowered_errors_capacity);
    if (!done) {
        test::note("%s could not be lowered:\n%s", source, lowered_errors);
    }
    test::check_equal(done, true);
    write_in_new_folder(p, name, lowered_text);
}

static char header_buffer[1U << 21];

static void header_to(const Project *p, const char *folder, const char *source, const char *name) {
    open_source(folder, source);
    bool done = c::smith_core_header(folder, source, nullptr, header_buffer, sizeof header_buffer, lowered_errors,
                                     lowered_errors_capacity);
    if (!done) {
        test::note("%s has no header:\n%s", source, lowered_errors);
    }
    test::check_equal(done, true);
    write_in_new_folder(p, name, header_buffer);
}

// The header of the module `<module>.smith` of the project (`t/body` is t/body.smith) written to `include/<module>.h`,
// as `smith cc --smith-header` writes it, made in process. It is the text of the header pass, which does not ask the
// compiler which import declared a C name: a module with two C imports takes the command.
export void write_header(const Project *p, const char *module) {
    const char *source = join_free(module, ".smith", "");
    const char *name = join_free("include/", module, ".h");
    header_to(p, p->dir, source, name);
    release(source);
    release(name);
}

// The same for `$SMITH_REPO/<source>`, written to `name` in the project.
export void write_header_of(const Project *p, const char *source, const char *name) {
    header_to(p, repo_of(), source, name);
}

// The file's text, or "" when it is absent.
export const char *read(const Project *p, const char *name) {
    // always a text of its own, "" when the file is absent; the caller frees it
    const char *path = path_in(p, name);
    const char *const argv[_] = {"sh", "-c", "cat \"$0\" 2>/dev/null; exit 0", path, nullptr};
    Run run = run_free(argv[0:4]);
    release(run.err);
    release(path);
    return run.out;
}

export bool exists(const Project *p, const char *name) {
    const char *path = path_in(p, name);
    const char *const argv[_] = {"sh", "-c", "test -e \"$0\"", path, nullptr};
    Run run = run_free(argv[0:4]);
    release(run.out);
    release(run.err);
    release(path);
    return run.status == 0;
}

// The number of lines of a file, 0 when it is absent.
export usize lines(const Project *p, const char *name) {
    usize count = 0;
    const char *text = read(p, name); // freed here
    for (const char *c = text; *c != '\0'; c++)
        count += *c == '\n' ? 1U : 0U;
    release(text);
    return count;
}

// Through the clock handler of the thread: a fake clock advances and returns.
export void sleep(const Project *p, u64 milliseconds) {
    (void)p;
    clock::sleep(milliseconds * clock::millisecond);
}

export bool contains(const char *text, const char *needle) {
    return c::strstr(text, needle) != nullptr;
}

// Both texts as a shell's $(...) gives them: without trailing newlines.
static usize trimmed(const char *text) {
    usize length = c::strlen(text);
    while (length > 0 && text[length - 1] == '\n')
        length--;
    return length;
}

export bool same(const char *a, const char *b) {
    usize length = trimmed(a);
    return length == trimmed(b) && c::strncmp(a, b, length) == 0;
}

export void expect_contains(const char *name, const char *text, const char *needle) {
    if (!contains(text, needle)) {
        test::note("%s: expected to contain: %s\nactual: %s", name, needle, text);
    }
    test::check_condition(contains(text, needle));
}

export void expect_lacks(const char *name, const char *text, const char *needle) {
    if (contains(text, needle)) {
        test::note("%s: expected not to contain: %s\nactual: %s", name, needle, text);
    }
    test::check_condition(!contains(text, needle));
}

// Texts are equal, ignoring trailing newlines.
export void expect_text(const char *name, const char *expected, const char *actual) {
    if (!same(expected, actual)) {
        test::note("%s\nexpected: %s\nactual:   %s", name, expected, actual);
    }
    test::check_condition(same(expected, actual));
}

export void expect_status(const char *name, i32 expected, const Run *run) {
    if (run->status != expected) {
        test::note("%s: status %d\n%s\n%s", name, run->status, run->out, run->err);
    }
    test::check_equal(run->status, expected);
}

export void expect_failure(const char *name, const Run *run) {
    if (run->status == 0) {
        test::note("%s: expected a non-zero status\n%s\n%s", name, run->out, run->err);
    }
    test::check_not_equal(run->status, 0);
}

export void expect_count(const char *name, usize expected, usize actual) {
    if (expected != actual) {
        test::note("%s: expected %zu, got %zu", name, expected, actual);
    }
    test::check_equal(actual, expected);
}

// The output of a shell command as $(...) gives it: without trailing newlines.
export const char *capture(const Project *p, const char *command) {
    // a text of its own for the caller to free; the run's err is freed here
    Run run = sh(p, command);
    usize length = trimmed(run.out);
    char *copy = mem::alloc_slice(char, length + 1).data;
    mem::copy(copy[0:length], run.out[0:length]);
    copy[length] = '\0';
    release(run.out);
    release(run.err);
    return copy;
}
// NOLINTEND(smith-mem)
