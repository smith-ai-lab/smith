// Tests of three fixer rules (#2519, part of #1631): a module beside the file that imports it is found, `type` after
// the `:` of a C conditional is a value, and `target::macos` is written `.macos`.
module front_fix_loader_test;

import front::fix;
import front::types_convert;
import std::arena;
import std::files;
import std::format;
import std::mem;
import std::slice;
import std::test;
import <unistd.h>;

static Str as_str(char chars[:]) {
    return chars;
}

static void check_text(Str got, Str want) {
    test::check_equal(got, want);
}

static Str fixed_text(Str source) {
    fix::Fixed fixed = fix::fix_text("t.smith", source);
    return fixed.text;
}

export void test_front_fix_loader_type_after_a_conditional_is_a_value() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str got =
        fixed_text("module m;\nstatic Ref f(Ref *type) {\n    Ref self = type->kind == 1 ? type->element : type;\n"
                   "    return self;\n}\n");
    check_text(got, "fn f(ty: *Ref) -> Ref:\n    self: Ref = if ty.kind == 1: ty.element else: ty\n"
                    "    return self\n");
}

export void test_front_fix_loader_target_systems_are_variants() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str got =
        fixed_text("module m;\nstatic void f() {\n    if constexpr (target::os == target::macos) {\n        g();\n"
                   "    }\n}\n");
    check_text(got, "fn f():\n    if target.os == .macos:\n        g()\n");
}

// D14, #2647: clang's `__FINITE_MATH_ONLY__` is the fact `target.fast_math`.
export void test_front_fix_loader_finite_math_only_is_target_fast_math() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str got = fixed_text("module m;\nstatic void f() {\n    if (__FINITE_MATH_ONLY__) {\n        g();\n    }\n}\n");
    check_text(got, "fn f():\n    if target.fast_math:\n        g()\n");
}

export void test_front_fix_loader_finds_a_module_beside_the_file() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str module_path = "/tmp/front_fix_loader_scratch.smith";
    Str user_path = "/tmp/front_fix_loader_user.smith";
    test::check_equal(fix::store(module_path, "module front_fix_loader_scratch;\nexport struct Project { n: i32 }\n"
                                              "export void clean(Project *p) {\n    p->n = 0;\n}\n"),
                      true);
    test::check_equal(fix::store(user_path, "module front_fix_loader_user;\nimport front_fix_loader_scratch;\n"
                                            "static void f() {\n    front_fix_loader_scratch::Project p = {};\n"
                                            "    front_fix_loader_scratch::clean(&p);\n}\n"),
                      true);
    const char *paths[1] = {user_path.data};
    (void)fix::fix_run(paths, 1);
    files::BytesResult back = files::read_file(user_path);
    switch (back) {
    case .error:
        check_text("cannot read back", "the file");
        return;
    case .ok:
        files::Bytes bytes = back.ok;
        char chars[:] = mem::view(bytes, char);
        Str got = chars;
        check_text(got, "import front_fix_loader_scratch\nfn f():\n    mut p: front_fix_loader_scratch.Project = "
                        "front_fix_loader_scratch.Project(n = 0)\n    front_fix_loader_scratch.clean(&p)\n");
    }
}

// `fix_run` sets the loader for its own files only (#2560): after it, `fix_text` on an import reads no module, so a
// later test in the same worker does not parse smith's library and overflow its arena.
export void test_front_fix_loader_is_not_left_after_a_run() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str path = as_str(format::push("/tmp/front_fix_loader_left_", (I64)c::getpid(), ".smith"));
    test::check_equal(fix::store(path, "module front_fix_loader_left;\n"), true);
    const char *paths[1] = {path.data};
    test::check_equal(fix::fix_run(paths, 1), 0);
    (void)c::unlink(path.data);
    check_text(fixed_text("import std::build;\n"), "import std.build\n");
}

// An import still in today's syntax is read as that (#2561): `const char w[:]` and `F32 *out` leave its function in the
// module, so the importer's `&v` is passed to a writable pointer and `v` gets `mut`.
export void test_front_fix_loader_import_in_todays_syntax_asks_for_mut() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str module_path = "/tmp/front_fix_loader_reader.smith";
    Str user_path = "/tmp/front_fix_loader_reader_user.smith";
    test::check_equal(fix::store(module_path, "module front_fix_loader_reader;\nexport Bool read(const char w[:], "
                                              "F32 *out) {\n    *out = 1;\n    return true;\n}\n"),
                      true);
    test::check_equal(fix::store(user_path, "module front_fix_loader_reader_user;\nimport front_fix_loader_reader;\n"
                                            "static Bool f(const char w[:]) {\n    F32 v = 0;\n"
                                            "    return front_fix_loader_reader::read(w, &v);\n}\n"),
                      true);
    const char *paths[1] = {user_path.data};
    (void)fix::fix_run(paths, 1);
    files::BytesResult back = files::read_file(user_path);
    switch (back) {
    case .error:
        check_text("cannot read back", "the file");
        return;
    case .ok:
        files::Bytes bytes = back.ok;
        char chars[:] = mem::view(bytes, char);
        Str got = chars;
        check_text(got, "import front_fix_loader_reader\nfn f(w: []char) -> bool:\n    mut v: f32 = 0\n"
                        "    return front_fix_loader_reader.read(w, &v)\n");
    }
}

// A call of an import's `auto... pieces` function whose result is dropped gets `_ :=` too (#2566): the pack was
// untyped, so `console::print_error("...")` in a fixed file kept the error `is not used`.
export void test_front_fix_loader_a_rest_import_result_is_discarded() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str module_path = "/tmp/front_fix_loader_rest.smith";
    Str user_path = "/tmp/front_fix_loader_rest_user.smith";
    test::check_equal(fix::store(module_path, "module front_fix_loader_rest;\nexport U64 put(auto... pieces) {\n"
                                              "    return 1;\n}\n"),
                      true);
    test::check_equal(fix::store(user_path, "module front_fix_loader_rest_user;\nimport front_fix_loader_rest;\n"
                                            "static void f(U64 n) {\n    front_fix_loader_rest::put(\"x\", n);\n"
                                            "    U64 m = n;\n}\n"),
                      true);
    const char *paths[1] = {user_path.data};
    (void)fix::fix_run(paths, 1);
    files::BytesResult back = files::read_file(user_path);
    switch (back) {
    case .error:
        check_text("cannot read back", "the file");
        return;
    case .ok:
        files::Bytes bytes = back.ok;
        char chars[:] = mem::view(bytes, char);
        Str got = chars;
        check_text(got, "import front_fix_loader_rest\nfn f(n: u64):\n    _ := front_fix_loader_rest.put(\"x\", n)\n"
                        "    m: u64 = n\n");
    }
}

// #2648: a struct of another module that holds a `str` is zeroed field by field, `Place(file = "", line = 0)`, as
// the field's default in the struct that holds it (front/cimport.smith's `PlaceRow`).
export void test_front_fix_loader_str_struct_of_a_module_is_zeroed_by_fields() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str module_path = "/tmp/front_fix_zero_place.smith";
    Str user_path = "/tmp/front_fix_zero_row.smith";
    test::check_equal(fix::store(module_path, "module front_fix_zero_place;\nexport struct Place {\n    Str file;\n"
                                              "    U32 line;\n};\n"),
                      true);
    test::check_equal(fix::store(user_path, "module front_fix_zero_row;\nimport front_fix_zero_place;\n"
                                            "struct Row {\n    U32 kind;\n    front_fix_zero_place::Place place;\n};\n"
                                            "static U32 f() {\n    Row row = {.kind = 1};\n    return row.kind;\n}\n"),
                      true);
    const char *paths[1] = {user_path.data};
    (void)fix::fix_run(paths, 1);
    files::BytesResult back = files::read_file(user_path);
    switch (back) {
    case .error:
        check_text("cannot read back", "the file");
        return;
    case .ok:
        files::Bytes bytes = back.ok;
        char chars[:] = mem::view(bytes, char);
        Str got = chars;
        check_text(got, "import front_fix_zero_place\nstruct Row:\n    kind: u32\n    place: "
                        "front_fix_zero_place.Place\nfn f() -> u32:\n    "
                        "row := Row(kind = 1, place = front_fix_zero_place.Place(file = \"\", line = 0))\n"
                        "    return row.kind\n");
    }
}

// #3268's regression: a struct of another module that holds a member struct with a pointer (`build::App` and its
// `Step`) gets that member as `step: Step = undefined` in its own module, and the construction in another module
// leaves the member out and writes the rest (`tool = false`). `step = undefined` is not a value inside a construction.
export void test_front_fix_loader_a_member_with_a_pointer_of_a_module_is_left_to_its_default() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str module_path = "/tmp/front_fix_zero_app.smith";
    Str user_path = "/tmp/front_fix_zero_app_user.smith";
    test::check_equal(fix::store(module_path, "module front_fix_zero_app;\nexport struct Step {\n    const char *cmd;\n"
                                              "    Bool restat;\n};\nexport struct App {\n    const char *entry;\n"
                                              "    Bool tool;\n    Step step;\n};\n"),
                      true);
    test::check_equal(fix::store(user_path, "module front_fix_zero_app_user;\nimport front_fix_zero_app;\n"
                                            "static Bool f() {\n    front_fix_zero_app::App app = {.entry = \"x\"};\n"
                                            "    return app.tool;\n}\n"),
                      true);
    const char *paths[1] = {user_path.data};
    (void)fix::fix_run(paths, 1);
    files::BytesResult back = files::read_file(user_path);
    switch (back) {
    case .error:
        check_text("cannot read back", "the file");
        return;
    case .ok:
        files::Bytes bytes = back.ok;
        char chars[:] = mem::view(bytes, char);
        Str got = chars;
        check_text(got, "import front_fix_zero_app\nfn f() -> bool:\n    "
                        "app := front_fix_zero_app.App(entry = \"x\", tool = false)\n    return app.tool\n");
    }
}

// A mended import is read once its statements end at the line break, including one that ends in `p.*` (a `*p` in
// today's syntax): `out.* = s.*` then `out.n = 1` did not parse, the import was dropped, and the importer was fixed
// without its types (#2648). `mine` is the out-parameter the import's function fills, so it is `mut` and starts
// undefined (`{}` stays when the import is not read).
export void test_front_fix_loader_a_mended_import_with_a_deref_at_a_line_end_is_read() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str module_path = "/tmp/front_fix_loader_deref.smith";
    Str user_path = "/tmp/front_fix_loader_deref_user.smith";
    test::check_equal(fix::store(module_path, "module front_fix_loader_deref;\nexport struct Sym { Int n; };\n"
                                              "[[gnu::always_inline]] static Int twice(Int n) {\n    return n * 2;\n}\n"
                                              "export void copy(Sym *out, const Sym *s) {\n    if (s == nullptr) {\n"
                                              "        return;\n    }\n    *out = *s;\n    out->n = 1;\n}\n"),
                      true);
    test::check_equal(fix::store(user_path, "module front_fix_loader_deref_user;\nimport front_fix_loader_deref;\n"
                                            "static void f() {\n"
                                            "    front_fix_loader_deref::Sym mine = {};\n"
                                            "    front_fix_loader_deref::Sym other = {};\n"
                                            "    front_fix_loader_deref::copy(&mine, &other);\n}\n"),
                      true);
    const char *paths[1] = {user_path.data};
    test::check_equal(fix::fix_run(paths, 1), 0);
    files::BytesResult back = files::read_file(user_path);
    switch (back) {
    case .error:
        check_text("cannot read back", "the file");
        return;
    case .ok:
        files::Bytes bytes = back.ok;
        char chars[:] = mem::view(bytes, char);
        Str got = chars;
        check_text(got, "import front_fix_loader_deref\nfn f():\n    mut mine: front_fix_loader_deref.Sym = undefined\n"
                        "    mut other: front_fix_loader_deref.Sym = undefined\n"
                        "    front_fix_loader_deref.copy(&mine, &other)\n");
    }
}

// A mended import with an enum whose variants carry a trailing `//` comment after the comma reads (lib/std/test.smith's
// `End`, lib/std/build.smith's `Hash`: 399 files failed on them once an import that does not read fails the run).
export void test_front_fix_loader_a_mended_enum_with_comments_after_its_variants_is_read() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str module_path = "/tmp/front_fix_loader_enum.smith";
    Str user_path = "/tmp/front_fix_loader_enum_user.smith";
    test::check_equal(fix::store(module_path,
                                 "module front_fix_loader_enum;\n"
                                 "[[gnu::always_inline]] static Int twice(Int n) {\n    return n * 2;\n}\n"
                                 "typedef enum : U8 {\n    End_Passed,\n    End_Check,   // a check failed\n"
                                 "    End_Signal,  // killed by a signal\n} End;\n"
                                 "export End first(void) {\n    return End_Check;\n}\n"),
                      true);
    test::check_equal(fix::store(user_path, "module front_fix_loader_enum_user;\nimport front_fix_loader_enum;\n"
                                            "static void f() {\n"
                                            "    front_fix_loader_enum::End e = front_fix_loader_enum::first();\n"
                                            "    front_fix_loader_enum::first();\n}\n"),
                      true);
    const char *paths[1] = {user_path.data};
    test::check_equal(fix::fix_run(paths, 1), 0);
}

// An import that has a spelling the parser refuses (`[[gnu::always_inline]]`) is mended before the checker reads it,
// and is then in smith's own syntax: its `const Sym *` is `*Sym`, read-only. It was marked as today's syntax all the
// same, so the pointer was writable and the importer's `*Sym` parameter became `*mut` for a callee that never writes
// (#2648).
export void test_front_fix_loader_a_mended_import_keeps_its_read_only_pointer() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str module_path = "/tmp/front_fix_loader_mended.smith";
    Str user_path = "/tmp/front_fix_loader_mended_user.smith";
    test::check_equal(fix::store(module_path, "module front_fix_loader_mended;\nexport struct Sym { Bool exported; };\n"
                                              "[[gnu::always_inline]] static Int twice(Int n) {\n    return n * 2;\n}\n"
                                              "export Str doc(const Sym *s) {\n    if (s->exported) return \"\";\n"
                                              "    return \"x\";\n}\n"),
                      true);
    test::check_equal(fix::store(user_path, "module front_fix_loader_mended_user;\nimport front_fix_loader_mended;\n"
                                            "static Str f(const front_fix_loader_mended::Sym *s) {\n"
                                            "    return front_fix_loader_mended::doc(s);\n}\n"),
                      true);
    const char *paths[1] = {user_path.data};
    (void)fix::fix_run(paths, 1);
    files::BytesResult back = files::read_file(user_path);
    switch (back) {
    case .error:
        check_text("cannot read back", "the file");
        return;
    case .ok:
        files::Bytes bytes = back.ok;
        char chars[:] = mem::view(bytes, char);
        Str got = chars;
        check_text(got, "import front_fix_loader_mended\nfn f(s: *front_fix_loader_mended.Sym) -> str:\n"
                        "    return s.doc()\n");
    }
}

// Mending writes a `Sym *s` and a `const Sym *s` alike as `s: *Sym`; the module read back must still know which of
// them its function writes through, or a call that passes a read-only pointer asks for nothing (#2648).
export void test_front_fix_loader_a_mended_import_keeps_its_writable_pointer() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str module_path = "/tmp/front_fix_loader_writer.smith";
    Str user_path = "/tmp/front_fix_loader_writer_user.smith";
    test::check_equal(fix::store(module_path, "module front_fix_loader_writer;\nexport struct Sym { Bool exported; };\n"
                                              "[[gnu::always_inline]] static Int twice(Int n) {\n    return n * 2;\n}\n"
                                              "export void mark(Sym *s) {\n    s->exported = true;\n}\n"),
                      true);
    test::check_equal(fix::store(user_path, "module front_fix_loader_writer_user;\nimport front_fix_loader_writer;\n"
                                            "static void f(front_fix_loader_writer::Sym *s) {\n"
                                            "    front_fix_loader_writer::mark(s);\n}\n"),
                      true);
    const char *paths[1] = {user_path.data};
    (void)fix::fix_run(paths, 1);
    files::BytesResult back = files::read_file(user_path);
    switch (back) {
    case .error:
        check_text("cannot read back", "the file");
        return;
    case .ok:
        files::Bytes bytes = back.ok;
        char chars[:] = mem::view(bytes, char);
        Str got = chars;
        check_text(got, "import front_fix_loader_writer\nfn f(s: *mut front_fix_loader_writer.Sym):\n"
                        "    s.mark()\n");
    }
}

// A fix the checker finds in an instance of another module's generic belongs to that module (#2669): fixing the
// importer keeps it, and the fixer of the module applies it (the spans are offsets in the module's own text).
export void test_front_fix_loader_a_fix_in_an_imported_generic_reaches_its_module() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str module_path = "/tmp/front_fix_loader_foreign_util.smith";
    Str user_path = "/tmp/front_fix_loader_foreign_user.smith";
    test::check_equal(fix::store(module_path, "pub fn truthy(x: auto) -> bool: x\n"), true);
    test::check_equal(fix::store(user_path, "import front_fix_loader_foreign_util\n\n"
                                            "fn f() -> bool: front_fix_loader_foreign_util.truthy(3)\n"),
                      true);
    const char *paths[2] = {user_path.data, module_path.data};
    (void)fix::fix_run(paths, 2);
    files::BytesResult back = files::read_file(module_path);
    switch (back) {
    case .error:
        check_text("cannot read back", "the file");
        return;
    case .ok:
        files::Bytes bytes = back.ok;
        char chars[:] = mem::view(bytes, char);
        Str got = chars;
        check_text(got, "pub fn truthy(x: auto) -> bool: x != 0\n");
    }
}

// The zero value of another module's struct names a struct nested in it as the file reaches it, through the module it
// imports (`nest.Inner`, with `as nest`), not by the whole path the checker shows (#3027: `front.emit_state.Target`
// in a test that imports `front::emit`).
export void test_front_fix_loader_a_nested_struct_is_named_through_the_import() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str module_path = "/tmp/front_fix_loader_nest.smith";
    Str user_path = as_str(format::push("/tmp/front_fix_loader_nest_user_", (I64)c::getpid(), ".smith"));
    test::check_equal(fix::store(module_path, "module front_fix_loader_nest;\nexport struct Inner {\n    I32 n;\n};\n"
                                              "export struct Outer {\n    Inner inner;\n    I32 m;\n};\n"),
                      true);
    test::check_equal(fix::store(user_path,
                                 "module front_fix_loader_nest_user;\nimport front_fix_loader_nest as nest;\n"
                                 "static void f() {\n    nest::Outer o = {};\n"
                                 "    g(&o);\n}\n"),
                      true);
    const char *paths[1] = {user_path.data};
    (void)fix::fix_run(paths, 1);
    files::BytesResult back = files::read_file(user_path);
    (void)c::unlink(user_path.data);
    switch (back) {
    case .error:
        check_text("cannot read back", "the file");
        return;
    case .ok:
        files::Bytes bytes = back.ok;
        char chars[:] = mem::view(bytes, char);
        Str got = chars;
        check_text(got, "import front_fix_loader_nest as nest\nfn f():\n    mut o: nest.Outer = "
                        "nest.Outer(inner = nest.Inner(n = 0), m = 0)\n    g(&o)\n");
    }
}

// The method and tuple-index fixes read only this file's nodes, not the body of another module's generic function
// unrolled for this call (#3027): `rest[0]` of `args.first(1, 2)`, an index at an offset of the other file, read
// `source` past its end and failed an assert (`generic-argument-names` and four other corpus cases).
export void test_front_fix_loader_an_instance_of_an_imported_generic_is_not_fixed_here() {
    arena::Arena memory = test::memory(1U << 24);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    Str module_path = "/tmp/front_fix_loader_instance_args.smith";
    Str user_path = "/tmp/front_fix_loader_instance_user.smith";
    test::check_equal(fix::store(module_path, "module front_fix_loader_instance_args;\n"
                                              "// a comment that puts the body below past the end of the user's file\n"
                                              "export I32 first(auto p, auto... rest) {\n"
                                              "    return (I32)p + (I32)rest[0];\n}\n"),
                      true);
    test::check_equal(fix::store(user_path, "module u;\nimport front_fix_loader_instance_args;\n"
                                            "I32 f() {\n    return front_fix_loader_instance_args::first(1, 2);\n}\n"),
                      true);
    const char *paths[1] = {user_path.data};
    test::check_equal(fix::fix_run(paths, 1), 0);
    files::BytesResult back = files::read_file(user_path);
    switch (back) {
    case .error:
        check_text("cannot read back", "the file");
        return;
    case .ok:
        files::Bytes bytes = back.ok;
        char chars[:] = mem::view(bytes, char);
        Str got = chars;
        check_text(got, "import front_fix_loader_instance_args\nfn f() -> i32:\n"
                        "    return front_fix_loader_instance_args.first(1, 2)\n");
    }
}

// #3250: the fixer's mode ends with its run, so a later check does not inherit it.
export void test_front_fix_loader_the_fixing_mode_is_off_after_a_fixer_run() {
    arena::Arena memory = test::memory(1U << 22);
    arena::ArenaAllocator allocator = arena::allocator(&memory);
    mem::Allocator *outside = mem::set_allocator(&allocator.base);
    defer mem::set_allocator(outside);
    (void)fixed_text("module m;\nstatic void f() {\n    g();\n}\n");
    test::check_condition(!types_convert::is_fixing());
}
