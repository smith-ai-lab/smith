module sample;

import <string.h>;
import <stdlib.h>;
import smith::mem;
import smith::contract;

export typedef struct {
    i32 a;
    i32 b;
} Pair;

export void clear(Pair *p, u8 *buf, usize n) {
    c::memset(p, 0, sizeof *p);
    Pair q = {1, 2};
    c::memset(&q, 0, sizeof(q));
    c::memset(buf, 7, n);
    c::memcpy(buf, p, n);
    __builtin_memmove(buf, buf + 1, n);
    if (c::memcmp(buf, p, n) == 0) return;
}

export void wrapper(u8 *dst, const u8 *src, usize n) {
    contract::trusted();
    c::memcpy(dst, src, n);
}

export void allocate(usize n) {
    Pair *one = (Pair *)c::malloc(sizeof(Pair));
    Pair *many = (Pair *)c::calloc(n, sizeof(Pair));
    Pair *aligned = (Pair *)c::aligned_alloc(16, 16 * n);
    c::free(one);
    mem::free(many);
    mem::free(aligned);
}

export void release(void *block) {
    contract::trusted();
    c::free(block);
}
