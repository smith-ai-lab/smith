# Sourced by the archive tests (tests/untar_*_test.smith): $PWD is the project, where the archives are made.
# The xz archives are made by tests/xz.py, which writes the container and lets Python's lzma module compress the blocks
# (macOS has no xz, and Homebrew's is not relied on).
here=$PWD # the project holds copies of the repository files the archive tests use (scratch::copy_tree)
xz() { "${PYTHON:-/usr/bin/python3}" -I "$here/tests/xz.py" "$@"; }
export COPYFILE_DISABLE=1 # macOS tar would add AppleDouble ._ entries for extended attributes
work=$PWD
src=$PWD/src
arc=$PWD/arc
mkdir -p "$arc"

# The tests spell tar's options as bsdtar does (macOS, and what the archives were first made with); GNU tar (Linux)
# spells -n, -s and the format name differently, so there tar is a function that translates those.
case $(command tar --version 2>&1) in
*"GNU tar"*)
    tar() {
        n=$#
        while [ "$n" -gt 0 ]; do
            a=$1
            shift
            n=$((n - 1))
            case $a in
            -n) a=--no-recursion ;;
            gnutar) a=gnu ;;
            -s)
                a=--transform=s$1
                shift
                n=$((n - 1))
                ;;
            esac
            set -- "$@" "$a"
        done
        command tar "$@"
    }
    ;;
esac

# The files of a tree: type, permission bits and size, then the bytes by checksum. Equal listings are equal trees.
listing() {
    (cd "$1" && find . -type f -exec sh -c 'for f; do printf "%s %s %s " "$(stat -c "%A %s" "$f" 2>/dev/null || stat -f "%Sp %z" "$f")" "$f" "$(shasum -a 256 <"$f" | cut -c1-16)"; echo; done' sh {} + | sort
        find . -type l -exec sh -c 'for f; do echo "link $f -> $(readlink "$f")"; done' sh {} + | sort
        find . -type d | sort)
}

# The source tree: modes, an empty file, a big compressible file, a random file, relative symlinks.
make_src() {
    mkdir -p "$src/pkg-1.0/bin" "$src/pkg-1.0/lib/deep" "$src/pkg-1.0/empty-folder"
    printf 'hello package\n' >"$src/pkg-1.0/hello.txt"
    printf '#!/bin/sh\necho tool ran\n' >"$src/pkg-1.0/bin/tool"
    chmod 755 "$src/pkg-1.0/bin/tool"
    : >"$src/pkg-1.0/empty"
    printf 'private\n' >"$src/pkg-1.0/lib/secret"
    chmod 640 "$src/pkg-1.0/lib/secret"
    printf 'read only\n' >"$src/pkg-1.0/lib/readonly"
    chmod 444 "$src/pkg-1.0/lib/readonly"
    awk 'BEGIN { for (i = 0; i < 2000; i++) printf "line %d of text that repeats and compresses well\n", i % 17 }' >"$src/pkg-1.0/lib/text.txt"
    head -c 3000 /dev/urandom >"$src/pkg-1.0/lib/deep/random.bin"
    ln -s ../hello.txt "$src/pkg-1.0/lib/hello-link"
    ln -s lib "$src/pkg-1.0/libs"
    ln -s ../../hello.txt "$src/pkg-1.0/lib/deep/up-two"
}

# The source tree and its plain tar, a.tar (ustar).
make_a_tar() {
    make_src
    (cd "$src" && tar --format ustar -cf "$arc/a.tar" pkg-1.0)
}

# A tree of 200000 random bytes and its tar, rand.tar.
make_rand() {
    mkdir -p "$PWD/rand/pkg-1.0"
    head -c 200000 /dev/urandom >"$PWD/rand/pkg-1.0/random.bin"
    (cd "$PWD/rand" && tar -cf "$arc/rand.tar" pkg-1.0)
}

# The hostile tree, from which tar -P and -s write the names it would normally refuse.
hostile_tree() {
    h=$PWD/hostile
    mkdir -p "$h/pkg-1.0" "$PWD/target"
    echo hi >"$h/pkg-1.0/a.txt"
    ln -s ../../outside "$h/pkg-1.0/escape"
    ln -s /etc/passwd "$h/pkg-1.0/absolute"
    ln -s . "$h/pkg-1.0/self"
    ln -s a/../b "$h/pkg-1.0/dotdot"
    ln -s ../../../../../x "$h/pkg-1.0/far"
    mkfifo "$h/pkg-1.0/fifo"
    ln -s ../../../../.. "$h/pkg-1.0/to-root"
}

# Changes the byte at an offset (negative counts from the end) of a file into a copy, so that only a check can notice.
flip() { # file, offset, output
    size=$(wc -c <"$1" | tr -d ' ')
    at=$2
    [ "$at" -lt 0 ] && at=$((size + at))
    cp "$1" "$3"
    byte=$(dd if="$1" bs=1 skip="$at" count=1 2>/dev/null | od -An -tu1 | tr -d ' ')
    printf "$(printf '\\%03o' $(((byte + 1) % 256)))" | dd of="$3" bs=1 seek="$at" conv=notrunc 2>/dev/null
}

# tests/untar.c under AddressSanitizer and UndefinedBehaviorSanitizer, as ./untar.
build_untar() {
    # the handlers runtime (the libraries call its getters and setters) is built as the library is everywhere
    smith cc -std=gnu23 -O2 -fPIC -I "$SMITH_REPO/.smith/include" -c "$here/lib/handlers.c" -o "$PWD/handlers.o" || return 1
    smith cc -std=gnu23 -g -O1 -fsanitize=address,undefined -fno-sanitize-recover=undefined -Wall -Wextra -Werror \
        -Wno-unused-function -I "$SMITH_REPO/.smith/include" "$here/tests/untar.c" "$here/lib/smith/arena.smith" \
        "$here/lib/smith/contract.smith" "$here/lib/smith/env.smith" "$here/lib/smith/files.smith" \
        "$here/lib/smith/inflate.smith" "$here/lib/smith/mem.smith" \
        "$here/lib/smith/net.smith" "$here/lib/smith/random.smith" "$PWD/handlers.o" -o "$PWD/untar"
}

# The sanitized untar and the seeds, made once and shared by every test of the run and of the runs after it (#639: ten
# tests built the same program, which costs 14 s of CPU a test on a loaded host). They live in
# $SMITH_TEST_CACHE/untar/<key>, the key the checksum of what the program is made of and the identity of the smith that
# compiles it; the first test to need them takes a lock by making a folder and builds, the others wait for its mark
# (never a fixed sleep: up to the 600 s hang backstop, and a lock older than 20 minutes is a builder that died). The
# project gets `untar` and `seeds` as links, and the folders the cases write into.
shared_untar() {
    base=${SMITH_TEST_CACHE:-$HOME/.cache/smith-tests}/untar
    mkdir -p "$base"
    # the bytes of the files it is made of (the project's copies of them: their times are new in every test), and the
    # size and time of the smith that compiles it
    if [ "$(uname -s)" = Darwin ]; then statfmt='-f %N_%m_%z'; else statfmt='-c %n_%Y_%s'; fi
    key=$({ stat $statfmt "${SMITH_SELF:-$(command -v smith)}" 2>/dev/null
        cat "$here/tests/untar.c" "$here"/runtime/*.c "$here"/runtime/*.h "$here/lib/smith/arena.smith" \
            "$here/lib/smith/contract.smith" "$here/lib/smith/inflate.smith" \
            "$here/lib/smith/random.smith" "$here/lib/smith/env.smith" "$here/lib/smith/files.smith" \
            "$here/lib/smith/mem.smith" "$here/lib/smith/net.smith" "$here/lib/handlers.c" "$here/prelude"; } | shasum -a 256 | cut -c1-16)
    dir=$base/$key
    if [ ! -e "$dir/done" ]; then
        find "$base" -maxdepth 1 -name "lock-$key" -mmin +20 -exec rmdir {} + 2>/dev/null
        if mkdir "$base/lock-$key" 2>/dev/null; then
            mkdir -p "$dir"
            if (cd "$dir" && work=$PWD && build_untar && make_seeds); then
                : >"$dir/done"
            else
                rm -rf "$dir" "$base/lock-$key" # a failed build is not left for the others to wait on
                return 1
            fi
        else
            waited=0
            until [ -e "$dir/done" ]; do
                [ $waited -lt 3000 ] || { echo "shared_untar: timed out waiting for $dir" >&2; return 1; }
                [ -d "$base/lock-$key" ] || { echo "shared_untar: the build of $dir failed" >&2; return 1; }
                waited=$((waited + 1))
                perl -e 'select(undef, undef, undef, 0.2)'
            done
        fi
    fi
    ln -s "$dir/untar" "$work/untar"
    ln -s "$dir/seeds" "$work/seeds"
    mkdir -p "$work/scratch" "$work/untar-out"
}

# Smaller seeds, so that every prefix is quick: a few files and a short random one, in seeds/.
make_seeds() {
    mkdir -p "$PWD/seed/pkg-1.0/lib" "$PWD/seeds"
    printf 'hello\n' >"$PWD/seed/pkg-1.0/hello.txt"
    awk 'BEGIN { for (i = 0; i < 400; i++) printf "line %d of text that repeats\n", i % 7 }' >"$PWD/seed/pkg-1.0/lib/text.txt"
    head -c 1500 /dev/urandom >"$PWD/seed/pkg-1.0/lib/random.bin"
    ln -s ../hello.txt "$PWD/seed/pkg-1.0/lib/link"
    (cd "$PWD/seed" && tar --format pax -cf "$work/seeds/seed.tar" pkg-1.0)
    gzip -c "$PWD/seeds/seed.tar" >"$PWD/seeds/seed.tar.gz"
    head -c 3000 /dev/urandom | gzip -c >"$PWD/seeds/single.gz"
    xz --check=crc64 -c "$PWD/seeds/seed.tar" >"$PWD/seeds/seed.tar.xz"
    xz --check=sha256 -c "$PWD/seeds/seed.tar" >"$PWD/seeds/sha256.tar.xz"
    mkdir -p "$PWD/scratch" "$PWD/untar-out"
}

# Every prefix of a plain tar is extracted with the sanitizers on, which takes most of the time, so by default every 5th
# is, with all the ones near a block boundary and in the first two blocks; UNTAR_FULL=1 tries every one (issue #31).
prefix_step=5
[ -z "${UNTAR_FULL:-}" ] || prefix_step=1
