pool one
  depth = 1
rule step
  command = $cmd
rule single
  command = $cmd
  pool = one
build a: single
  cmd = echo start >> order; n=0; while [ $$(grep -c start order) -lt 2 ] && [ $$n -lt 20 ]; do n=$$((n+1)); sleep 0.05; done; echo end >> order
build b: single
  cmd = echo start >> order; n=0; while [ $$(grep -c start order) -lt 2 ] && [ $$n -lt 20 ]; do n=$$((n+1)); sleep 0.05; done; echo end >> order
default a b
