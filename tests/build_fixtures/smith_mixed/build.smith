import std::build;

void build(build::Build *b) {
    build::App app = {};
    build::app(b, &app);
    build::AppTests app_tests = {};
    build::app_tests(b, &app_tests);
    build::Step greet = {
        .command = build::list(b, "echo", build::fmt(b, "hello from %s", b->os), nullptr),
        .description = "greeting",
    };
    build::task(b, "greet", &greet);
}
