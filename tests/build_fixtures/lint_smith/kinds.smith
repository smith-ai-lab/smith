module kinds;

export typedef struct {
    U32 a;
} Good;

export typedef struct {
    U32 a;
} bad_type;

export struct Tag {
    U32 a;
};

export struct tag_bad {
    U32 a;
};

export typedef enum {
    Color_Red,
    Color_Green,
} Color;

export typedef enum {
    Shade_Light,
    bad_shade,
} Shade;

export constexpr U32 limit = 4;
export constexpr U32 BadLimit = 4;

export U32 f(U32 good_param, U32 BadParam) {
    return good_param + BadParam + limit + BadLimit;
}
