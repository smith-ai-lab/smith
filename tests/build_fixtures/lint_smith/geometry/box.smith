module geometry::box;

export typedef struct {
    F32 width;
    F32 height;
} Box;

export typedef struct {
    F32 w;
} bad_Type;

export F32 area(Box b) {
    F32 half = 1;
    return b.width * b.height * half;
}

export F32 Perimeter(Box b) {
    return 2 * (b.width + b.height);
}

static I32 bad_Helper(I32 x) {
    I32 Bad_Name = x;
    return Bad_Name;
}

export I32 use_helper(I32 x) {
    return bad_Helper(x);
}
