module tuples::pairs;

export typedef struct { I32, F32 } Pair;

export struct { I32, struct { F32, F32 } } nested() {
    return {1, {2.0f, 3.0f}};
}

export Pair make(I32 a, F32 b) {
    return {a, b};
}

export F32 total(struct { I32, F32 } t, Pair *p) {
    (*p)[0] += t[0];
    return t[1] + (F32)countof(t);
}
