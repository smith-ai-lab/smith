module pre::bad;

#include <stdio.h>
import <assert.h>;
import <math.h>;
import <stdint.h>;
#define LIMIT 4
#pragma STDC FP_CONTRACT OFF

#if 1
export i32 f(i32 x) {
    c::assert(x < c::SIZE_MAX);
    c::assert(c::isfinite(1.0));
    _Pragma("clang diagnostic push")
    return x + LIMIT;
}
#else
#endif
#error nope
