module clean::ok;

export typedef struct {
    U32 count;
    F64 total;
} Tally;

export typedef enum {
    Mode_Fast,
    Mode_Slow,
} Mode;

export constexpr U32 limit = 4;

export F64 mean(Tally t) {
    return t.total / (F64)t.count;
}

export Mode pick(I32 n) {
    return n > (I32)limit ? Mode_Slow : Mode_Fast;
}
