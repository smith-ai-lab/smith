module idiom::designated;

import "shape.h";

typedef struct {
    I32 x;
    I32 y;
} Mine;

export void use(void) {
    c::Shape by_position = {3, 4};
    c::Shape by_name = {.width = 3, .height = 4};
    c::Shape one = {3};
    c::Shape none = {};
    Mine own = {1, 2};
    c::Shape *made = &(c::Shape){5, 6};
    (void)by_position;
    (void)by_name;
    (void)one;
    (void)none;
    (void)own;
    (void)made;
}
