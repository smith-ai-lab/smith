module idiom::sized_ok;

export U64 wide(Usize n, U32 x, U64 y, F64 d, F32 f) {
    U8 byte = 1;
    I64 count = 2;
    I32 plain = 3;
    I16 half = 4;
    char letter = 'a';
    return n + x + y + (U64)d + (U64)f + byte + (U64)count + (U64)plain + (U64)half + (U64)letter;
}

I32 main(Str args[:]) {
    return (I32)countof(args);
}
