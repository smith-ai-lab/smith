module tuples;

export typedef struct { I32, F32 } Pair;

export struct { I32, F32 } make(I32 a, F32 b) {
    return {a, b};
}

export F32 total() {
    auto p = make(1, 2.0f);
    p[0] += 1;
    struct { I32, struct { F32, F32 } } n = {1, {2.0f, 3.0f}};
    return p[1] + n[1][0] + (F32)countof(p);
}
