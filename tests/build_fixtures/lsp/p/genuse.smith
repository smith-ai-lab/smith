module genuse;
import pick;

export int f() {
    I32 a = 3;
    I32 b = 8;
    I32 first = pick::larger(a, b);
    F64 second = pick::larger(1.5, 2.5);
    return first + (int)second;
}

static I32 inc(I32 x) {
    return x + 1;
}

export int g() {
    return pick::apply_twice(inc, 4);
}

export Usize h() {
    return pick::count_args(1, 2.5, 3);
}

export I32 k() {
    return pick::gathered(5, 6);
}
