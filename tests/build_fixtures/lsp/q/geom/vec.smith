module geom::vec;

export typedef struct {
    F32 x;
    F32 y;
} Vec;

export F32 dot(Vec a, Vec b) {
    return a.x * b.x + a.y * b.y;
}

export typeof(a) larger(auto a, typeof(a) b) {
    return a > b ? a : b;
}

[[std::c_name("geom_vec_squared")]] export F32 length2(Vec a) {
    return a.x * a.x;
}
