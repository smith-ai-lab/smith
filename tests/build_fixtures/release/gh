#!/bin/sh
# A stub gh that keeps its "releases" in the folder $GH_DIR and logs each call to $GH_LOG.
echo "gh $*" >>"$GH_LOG"
case "$1 $2" in
"release view") [ -d "$GH_DIR/$3" ] ;;
"release create")
    tag=$3
    [ -d "$GH_DIR/$tag" ] && exit 1 # as gh: the tag exists already
    mkdir -p "$GH_DIR/$tag"
    shift 3
    while [ $# -gt 0 ]; do case $1 in --draft) : >"$GH_DIR/$tag/.draft"; shift ;; --*) shift 2 ;; *) cp "$1" "$GH_DIR/$tag/"; shift ;; esac; done
    ;;
"release upload")
    tag=$3
    [ -d "$GH_DIR/$tag" ] || exit 1
    shift 3
    while [ $# -gt 0 ]; do case $1 in --*) shift ;; *) cp "$1" "$GH_DIR/$tag/"; shift ;; esac; done
    ;;
"release list")
    # what `gh release list --jq` prints for prune-old's filter: the published stage0-* releases as "tag date" lines, one
    # a line (the date is in $GH_DIR/<tag>/.date, else 2026-10-01); the stub ignores --jq, so it filters here (#3029)
    for d in "$GH_DIR"/stage0-*; do
        [ -d "$d" ] && [ ! -e "$d/.draft" ] || continue
        date=2026-10-01T00:00:00Z
        [ -f "$d/.date" ] && date=$(cat "$d/.date")
        printf '%s %s\n' "${d##*/}" "$date"
    done
    ;;
"release download")
    tag=$3
    shift 3
    while [ $# -gt 0 ]; do case $1 in --dir) dir=$2; shift 2 ;; --pattern) pat="$pat $2"; shift 2 ;; *) shift ;; esac; done
    for p in $pat; do cp "$GH_DIR/$tag/$p" "$dir/"; done
    ;;
"release edit")
    echo "$3 $4" >>"$GH_DIR/../published"
    rm -f "$GH_DIR/$3/.draft"
    ;;
"api "*)
    # the stale drafts `release prune-old` asks for (#2832): the ids in $GH_DIR/../drafts, one a line
    case "$*" in *fromdateiso8601*) [ -f "$GH_DIR/../drafts" ] && cat "$GH_DIR/../drafts" ;; esac
    ;;
"release delete")
    # as gh: a tag that is no release is "release not found"; $GH_DIR/../fail_delete lists tags whose delete fails
    [ -d "$GH_DIR/$3" ] || { echo "release not found" >&2; exit 1; }
    grep -qx -- "$3" "$GH_DIR/../fail_delete" 2>/dev/null && { echo "HTTP 500" >&2; exit 1; }
    rm -rf "$GH_DIR/$3"
    ;;
esac
