import std::test;

typedef struct {
    I32 x;
} Box;

Box *find(I32 key);
void missing(void);

static I32 checked(bool flag) {
    Box *p = nullptr;
    if (flag) p = find(1);
    test::check(p != nullptr);
    return p->x;
}

static I32 unchecked(bool flag) {
    Box *p = nullptr;
    if (flag) p = find(1);
    if (p == nullptr) missing();
    return p->x;
}

I32 analyzed(void) {
    return checked(true) + unchecked(true);
}
