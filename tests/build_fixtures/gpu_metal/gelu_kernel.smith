// The learner's elementwise_gelu_kernel (learner/src/kernels/elementwise.metal), written as a .smith function: one
// thread for each element, a bounds check against `count`, and the tanh form clamped as the handwritten one is.
module gelu_kernel;

import smith::gpu;
import <math.h>;

constexpr f32 tanh_limit = 20.0f;
constexpr f32 gelu_c = 0.7978845608028654f; // sqrt(2 / pi)
constexpr f32 gelu_k = 0.044715f;

export void gelu(gpu::Thread *t, u32 count, const f32 *a, f32 *out) {
    u32 i = t->index;
    if (i >= count) return;
    f32 x = a[i];
    f32 u = gelu_c * (x + gelu_k * x * x * x);
    out[i] = 0.5f * x * (1.0f + c::tanhf(c::fminf(c::fmaxf(u, -tanh_limit), tanh_limit)));
}
