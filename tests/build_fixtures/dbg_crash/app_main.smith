module main;

import std::contract;

i32 total(i32 xs[:], usize i) {
    i32 v = xs[i];
    return v;
}

i32 positive(i32 n) {
    contract::requires(n > 0);
    return n;
}

i32 main(str args[:]) {
    i32 data[4] = {1, 2, 3, 4};
    i32 xs[:] = data[0:4];
    usize at = 7;
    if (countof(args) > 2) return positive(-1);
    if (countof(args) > 1) return total(xs, at);
    return total(xs, 1);
}
