module main;

import std::contract;

I32 total(I32 xs[:], Usize i) {
    I32 v = xs[i];
    return v;
}

I32 positive(I32 n) {
    contract::requires(n > 0);
    return n;
}

I32 main(Str args[:]) {
    I32 data[4] = {1, 2, 3, 4};
    I32 xs[:] = data[0:4];
    Usize at = 7;
    if (countof(args) > 2) return positive(-1);
    if (countof(args) > 1) return total(xs, at);
    return total(xs, 1);
}
