// The standard library is std:: (issue #366): its modules and its attributes.
module main;

import <stdio.h>;
import std::arena;

[[std::pure]] I32 masked(I32 x) {
    return x & 0x7F;
}

[[std::effects(alloc, unknown, fails)]] I32 grow(arena::Arena *a) {
    I32 *p = arena::push(a, I32);
    *p = 3;
    return *p;
}

export [[std::alloc]] I32 reserve(void);

[[std::c_name("std_scope_doubled")]] export I32 doubled(I32 x) {
    return masked(x);
}

[[std::affine]] typedef struct {
    I32 id;
} Handle;

I32 main(void) {
    alignas(arena::align_max) static U8 memory[4096];
    arena::Arena a = arena::fixed(memory, sizeof memory);
    Handle h = {.id = masked(4)};
    c::printf("%d %d\n", grow(&a), h.id);
    return 0;
}
