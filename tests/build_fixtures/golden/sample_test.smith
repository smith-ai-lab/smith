module sample_test;

import std::io;
import std::test;

export void test_matches(io::Io *io) {
    test::golden(io, "expected/matches.txt", "alpha\nbeta\n");
}

// Two changes far apart in ten lines: one hunk each side of the unchanged middle.
export void test_differs(io::Io *io) {
    test::golden(io, "expected/differs.txt", "one\nTWO\nthree\nfour\nfive\nsix\nseven\neight\nnine\nten\nELEVEN\n");
}

// Every line of sixty differs: the diff is longer than the limit.
export void test_long(io::Io *io) {
    char text[1024] = "";
    Usize used = 0;
    for (Usize i = 1; i <= 60; i++)
        used += (Usize)__builtin_snprintf(text + used, sizeof text - used, "new %zu\n", i);
    test::golden(io, "expected/long.txt", text[0:used]);
}

export void test_missing(io::Io *io) {
    test::golden(io, "expected/made/new.txt", "fresh\n");
}

export void test_empty_file_and_text(io::Io *io) {
    test::golden(io, "expected/empty.txt", "");
}
