use std.bits (bit_or, u64)
use std.console (console, print)
use std.int (wrapping_shift_left)

fn sh(x: u64, by: Byte) -> u64
  requires by < 64
{
  wrapping_shift_left(x, by)
}

fn main() ! console, alloc {
  var n: u64 = 0
  loop i in 0..64 {
    j: Byte = i
    n = bit_or(n, sh(1, j))
  }
  print("{n}")
  var m: u64 = 0
  loop i in 0..64 {
    m = bit_or(m, sh(1, i))
  }
  print("{m}")
}
