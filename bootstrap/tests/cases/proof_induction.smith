use std.bits (u64)
use std.console (console, print)

fn twice(n: u64) -> r: u64 ! alloc
  requires n >= 0 and n <= 255
  ensures r == 2 * n
  decreases n
{
  if n == 0 { 0 } else { 2 + twice(n - 1) }
}

fn twice_is_sum(n: u64) -> twice(n) == n + n
  requires n >= 0 and n <= 255
  decreases n
{
  if n == 0 {
    same
  } else {
    earlier = twice_is_sum(n - 1)
    opened = unfold(twice(n))
    arith(earlier, opened)
  }
}

fn sum_to(n: u64) -> r: u64 ! alloc
  requires n >= 0 and n <= 255
  ensures r >= 0 and r <= 255 * n
  decreases n
{
  if n == 0 { 0 } else { n + sum_to(n - 1) }
}

fn gauss(n: u64) -> 2 * sum_to(n) == n * (n + 1)
  requires n >= 0 and n <= 255
  decreases n
{
  if n == 0 {
    same
  } else {
    earlier = gauss(n - 1)
    opened = unfold(sum_to(n))
    arith(earlier, opened)
  }
}

fn main() ! console, alloc { print("{sum_to(4)} {twice(3)}") }
