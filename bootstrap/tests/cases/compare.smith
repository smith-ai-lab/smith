use std.console (console, print)

struct Cat {
  name: str
}

fn word(same: bool) -> str {
  if same { "same" } else { "different" }
}

fn loud(text: str) -> bool ! console {
  print(text)
  true
}

fn main() ! console, alloc {
  tom = Cat(name: "tom")
  print(word(tom == Cat(name: "tom")))
  print(word((tom, "a") == (Cat(name: "tim"), "a")))
  print("{not true or tom != tom}")
  if false and loud("never") { print("no") }
  print("skipped")
}
