struct Cat {
  name: str
}

struct Bird {
  name: str
}

trait Named[T] {
  fn name_of(x: T) -> str
}

impl Named[Cat] {
  fn name_of(x: Cat) -> str { x.name }
}

fn show[T: Named](x: T) -> str { name_of(x) }

fn main() ! console {
  print(show(Cat(name: "Tom")))
  print(show(Bird(name: "Tweety")))
}
