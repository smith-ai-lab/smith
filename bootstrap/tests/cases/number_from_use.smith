use std.bits (i16)
use std.console (console, print)
use std.int (saturating_mul)

fn double(n: Byte) -> Byte { saturating_mul(n, 2) }

fn main() ! console, alloc {
  x = 10
  print("{double(x)}")
  y = 10
  print("hello {y} {20}")
  var total = 1
  total = double_i16(total)
  print("{total}")
}

fn double_i16(n: i16) -> i16 { saturating_mul(n, 2) }
