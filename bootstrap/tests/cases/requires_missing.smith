use std.console (console, print)

trait Pair[A, B] {
  fn join(a: A, b: B) -> str
}

impl Pair[Int, str] {
  fn join(a: Int, b: str) -> str { b }
}

fn one() -> Int { 1 }

fn show_both[A, B](a: A, b: B) -> str
  requires Pair[A, B]
{
  join(a, b)
}

fn main() ! console {
  print(show_both("a", one()))
}
