use std.console (console, print)

struct Box[T] {
  item: T
}

trait Named[T] {
  fn pass_on(x: T) -> T
}

impl Named[str] {
  fn pass_on(x: str) -> str {
    x
  }
}

fn main() ! console {
  print(f1("", Box(item: "")))
}

fn f1[T: str](a: T, b: Box[str]) -> T ! console {
  Box(item: pass_on(a)).item
}
