use std.console (console, print)
use std.int (wrapping_add)

trait Pair[A, B] {
  fn join(a: A, b: B) -> str
}

trait Plus[A, B, out C] {
  fn plus(a: A, b: B) -> C
}

impl Pair[Int, str] {
  fn join(a: Int, b: str) -> str { b }
}

impl Plus[Int, Int, Int] {
  fn plus(a: Int, b: Int) -> Int { wrapping_add(a, b) }
}

fn one() -> Int { 1 }

fn show_both[A, B](a: A, b: B) -> str
  requires Pair[A, B]
{
  join(a, b)
}

fn sum3[A, B: Discard](x: A, y: B, z: B) -> B
  requires Plus[A, B, B]
  requires Plus[B, B, B]
{
  plus(plus(x, y), z)
}

fn main() ! console, alloc {
  print(show_both(one(), "pair"))
  print("{sum3(one(), 2, 3)}")
}
