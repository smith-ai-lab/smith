use std.bits (bit_and, shift_right, u32, u64)
use std.console (console, print)
use std.int (narrow)

fn digit(n: u64) -> Byte
  requires n < 10
{
  narrow(n)
}

fn main() ! console, alloc {
  x: u32 = 0x12ab
  print("{bit_and(x, 0xff)}")
  print("{bit_and(shift_right(x, 12), 0xf)}")
  print("{digit(7)}")
}
