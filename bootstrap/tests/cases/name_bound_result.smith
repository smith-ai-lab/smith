use std.console (console, print)

fn last(n: 1..1000) -> 0..n { n - 1 }

fn takes(x: 0..999) -> Nat { x }

fn use_it(n: 1..1000) -> Nat { takes(last(n)) }

fn middle(xs: List[Nat]) -> Nat
  requires xs.size > 0
{
  n = xs.size
  i: 0..n = n - 1
  xs[i]
}

fn main() ! console, alloc {
  xs: List[Nat] = [4, 5, 6]
  print("{last(10)} {use_it(7)} {middle(xs)}")
}
