// @NAME@. `smith run` builds and runs it.
import primes;

import smith::contract;
import <smith/io.h>;

// main makes the program's io once, and only main may: it passes down the parts each function needs.
int main(int argc, char **argv) {
    c::SmithIo io = c::smith_io_make(argc, argv);
    i32 sum = primes::sum(5);
    contract::assert(sum == 28);
    primes::report(&io.console, sum);
    c::smith_io_close(&io);
    return 0;
}
