// @NAME@. `smith run` builds and runs it.
import primes;

import smith::contract;
import smith::io;

// smith makes the program's io before main and closes it after; main passes down the parts each function needs.
i32 main(io::Io *io) {
    i32 sum = primes::sum(5);
    contract::assert(sum == 28);
    primes::report(&io->console, sum);
    return 0;
}
