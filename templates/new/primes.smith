// The first primes, in their own module so that main and the tests both call them.
module primes;

import smith::contract;
import <smith/io.h>;

// The sum of the first `count` primes, which is at most five.
export i32 sum(usize count) {
    constexpr i32 first[] = {2, 3, 5, 7, 11};
    contract::assert(count <= _Countof(first));
    i32 total = 0;
    for (usize i = 0; i < count; i++) {
        total += first[i];
    }
    return total;
}

// A function takes only the capability it uses, so its signature says what it can do to the world.
// smith lint (smith-effects) reports a call like c::printf anywhere but in a capability's own module.
export void report(c::SmithConsole *console, i32 sum) {
    (void)c::smith_console_printf(console, "the first 5 primes add up to %d\n", sum);
    (void)c::smith_console_print(console, "hello from @NAME@\n");
}
