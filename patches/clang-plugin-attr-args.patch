diff -ru a/clang/lib/Basic/Attributes.cpp b/clang/lib/Basic/Attributes.cpp
--- a/clang/lib/Basic/Attributes.cpp	2026-10-24 15:12:51
+++ b/clang/lib/Basic/Attributes.cpp	2026-10-24 15:12:51
@@ -71,9 +71,19 @@
 
   if (CheckPlugins) {
     // Check if any plugin provides this attribute.
-    for (auto &Ptr : getAttributePluginInstances())
+    // smith: a plugin's spelling is its full name, `smith::effects`, so a
+    // scoped attribute is asked by scope and name together: the parser reads
+    // the arguments of an attribute only when it knows the attribute here.
+    std::string Scoped;
+    if (!ScopeName.empty() && (Syntax == AttributeCommonInfo::AS_CXX11 ||
+                               Syntax == AttributeCommonInfo::AS_C23))
+      Scoped = (ScopeName + "::" + Name).str();
+    for (auto &Ptr : getAttributePluginInstances()) {
       if (Ptr->hasSpelling(Syntax, Name))
         return 1;
+      if (!Scoped.empty() && Ptr->hasSpelling(Syntax, Scoped))
+        return 1;
+    }
   }
 
   return 0;
diff -ru a/clang/lib/Parse/ParseDecl.cpp b/clang/lib/Parse/ParseDecl.cpp
--- a/clang/lib/Parse/ParseDecl.cpp
+++ b/clang/lib/Parse/ParseDecl.cpp
@@ -317,10 +317,21 @@
                                               ParsedAttr::Syntax Syntax,
                                               IdentifierInfo *ScopeName) {
 #define CLANG_ATTR_VARIADIC_IDENTIFIER_ARG_LIST
-  return llvm::StringSwitch<bool>(normalizeAttrName(II.getName()))
+  bool Known = llvm::StringSwitch<bool>(normalizeAttrName(II.getName()))
 #include "clang/Parse/AttrParserStringSwitches.inc"
-      .Default(false);
+                   .Default(false);
 #undef CLANG_ATTR_VARIADIC_IDENTIFIER_ARG_LIST
+  if (Known)
+    return true;
+  // smith: a plugin's attribute that takes identifiers (`[[smith::effects(alloc,
+  // net)]]`), by its scope and name.
+  if (ScopeName == nullptr)
+    return false;
+  std::string Scoped = (ScopeName->getName() + "::" + II.getName()).str();
+  for (auto &Ptr : getAttributePluginInstances())
+    if (Ptr->HasVariadicIdentifierArg && Ptr->hasSpelling(Syntax, Scoped))
+      return true;
+  return false;
 }
 
