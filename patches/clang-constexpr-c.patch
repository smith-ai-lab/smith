+/// Expr::isEvaluatableQuery is a question ("can this be folded?"), not a context
+/// where C requires a constant: code generation asks it whether the arms of a
+/// `?:` are cheap enough to evaluate unconditionally, and running a C function
+/// there would run the call when C says it does not run. It sets this for its
+/// duration. (Expr::isEvaluatable stays a required context: a static
+/// initializer's isConstantInitializer asks it.)
+static thread_local bool SmithEvaluatableQuery = false;
+
+/// smith: a C function body runs in the constant evaluator, as C++14 constexpr
+/// functions do, when the front end is lowering a `.smith` file
+/// (LangOptions::SmithConstexprC) and C requires a constant here. The patch only
+/// turns an error into a value: the evaluation must be in a constant context
+/// (InConstantContext: a `constexpr` initializer, `static_assert`, a case label,
+/// an enum value, a bit-field width, ...) and not the quiet folding clang does
+/// to see whether an expression happens to be constant (ConstantFold mode: the
+/// operand of `__builtin_constant_p`, an automatic variable's initializer; or
+/// no constant context at all: code generation's folding), where a call that
+/// is not a constant expression must stay one.
+static bool SmithCEval(const EvalInfo &Info) {
+  const LangOptions &LO = Info.getLangOpts();
+  return LO.SmithConstexprC && !LO.CPlusPlus && Info.InConstantContext &&
+         !SmithEvaluatableQuery &&
+         Info.EvalMode != EvaluationMode::ConstantFold;
+}
+
+static bool SmithEvalCAssign(const Expr *E, LValue &Result, EvalInfo &Info);
+static bool SmithIsCAssign(EvalInfo &Info, const Expr *E) {
+  E = E->IgnoreParens();
+  if (!SmithCEval(Info))
+    return false;
+  if (auto *B = dyn_cast<BinaryOperator>(E))
+    return B->isAssignmentOp();
+  return false;
+}
+
+/// smith: a compile-time failure. A function annotated
+/// `[[clang::annotate("smith_compile_error")]]` is a failure path: evaluating a
+/// call to it stops the evaluation with a note that carries the call and its
+/// arguments (a string literal argument as its text, an enum as its enumerator),
+/// then clang's "in call to" notes name the stack of compile-time calls,
+/// innermost first. `annotate("smith_compile_check")` marks a check: its first
+/// argument is a condition, and the call is a no-op when it is true and the
+/// failure when it is false (a contract, whose body is in another translation
+/// unit). Both only count where SmithCEval holds, so the call is as non-constant
+/// as it was anywhere else.
+static unsigned SmithCompileKind(const FunctionDecl *FD) {
+  for (const FunctionDecl *D : FD->redecls())
+    for (const auto *A : D->specific_attrs<AnnotateAttr>()) {
+      if (A->getAnnotation() == "smith_compile_error")
+        return 1;
+      if (A->getAnnotation() == "smith_compile_check")
+        return 2;
+    }
+  return 0;
+}
+
+static void SmithPrintArgument(raw_ostream &Out, EvalInfo &Info,
+                               const APValue &V, QualType T) {
+  if (V.isLValue()) {
+    if (const auto *B = V.getLValueBase().dyn_cast<const Expr *>())
+      if (const auto *SL = dyn_cast<StringLiteral>(B);
+          SL && SL->isOrdinary()) {
+        uint64_t Skip = V.getLValueOffset().getQuantity();
+        StringRef S = SL->getString();
+        Out << '"' << (Skip <= S.size() ? S.substr(Skip) : StringRef()) << '"';
+        return;
+      }
+  } else if (V.isInt()) {
+    if (const auto *ET = T->getAsCanonical<EnumType>())
+      for (const EnumConstantDecl *EC : ET->getDecl()->enumerators())
+        if (llvm::APSInt::isSameValue(EC->getInitVal(), V.getInt())) {
+          Out << EC->getName();
+          return;
+        }
+  }
+  V.printPretty(Out, Info.Ctx, T);
+}
+
+/// Report the failure of call \p E to \p FD (arguments in \p Call): the
+/// first note is the call itself, so the notes read as the stack.
+static bool SmithCompileFailure(EvalInfo &Info, const CallExpr *E,
+                                const FunctionDecl *FD, CallRef Call) {
+  std::string Text;
+  llvm::raw_string_ostream Out(Text);
+  FD->getNameForDiagnostic(Out, Info.Ctx.getPrintingPolicy(),
+                           /*Qualified=*/false);
+  Out << '(';
+  llvm::ListSeparator Comma;
+  for (const ParmVarDecl *Param : FD->parameters()) {
+    Out << Comma;
+    if (const APValue *V = Info.getParamSlot(Call, Param))
+      SmithPrintArgument(Out, Info, *V, Param->getType());
+    else
+      Out << "<...>";
+  }
+  Out << ')';
+  Info.FFDiag(E->getExprLoc(), diag::note_constexpr_call_here) << Text;
+  return false;
+}
