@@ -264,10 +267,37 @@ TidyProvider provideClangdConfig() {
   };
 }
 
+const char *FallbackTidyConfigFile = nullptr;
+
+// The options of FallbackTidyConfigFile, read once; null when there are none.
+static const tidy::ClangTidyOptions *fallbackTidyOptions() {
+  static const tidy::ClangTidyOptions *Options =
+      []() -> const tidy::ClangTidyOptions * {
+    if (!FallbackTidyConfigFile)
+      return nullptr;
+    auto Data = llvm::MemoryBuffer::getFile(FallbackTidyConfigFile);
+    if (!Data) {
+      elog("Cannot read clang-tidy fallback configuration {0}: {1}",
+           FallbackTidyConfigFile, Data.getError().message());
+      return nullptr;
+    }
+    auto Parsed = tidy::parseConfiguration(llvm::MemoryBufferRef(**Data));
+    if (!Parsed) {
+      elog("Error parsing clang-tidy fallback configuration {0}: {1}",
+           FallbackTidyConfigFile, Parsed.getError().message());
+      return nullptr;
+    }
+    return new tidy::ClangTidyOptions(std::move(*Parsed));
+  }();
+  return Options;
+}
+
 TidyProvider provideClangTidyFiles(ThreadsafeFS &TFS) {
   return [Tree = std::make_unique<DotClangTidyTree>(TFS)](
              tidy::ClangTidyOptions &Opts, llvm::StringRef Filename) {
-    Tree->apply(Opts, Filename);
+    if (!Tree->apply(Opts, Filename))
+      if (const tidy::ClangTidyOptions *Fallback = fallbackTidyOptions())
+        Opts.mergeWith(*Fallback, 1u);
   };
 }
 
