+/// The path of a .clang-tidy file to use for sources that no .clang-tidy file
+/// governs. Null (the default) changes nothing.
+extern const char *FallbackTidyConfigFile;
+
 // Provider that uses clangd configuration files.
 TidyProvider provideClangdConfig();
 
