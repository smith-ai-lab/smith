+
 std::string formatDocumentation(const CodeCompletionString &CCS,
                                 llvm::StringRef DocComment) {
   // Things like __attribute__((nonnull(1,3))) and [[noreturn]]. Present this
   // information in the documentation field.
+  std::vector<llvm::StringRef> Annotations;
+  for (unsigned I = 0; I < CCS.getAnnotationCount(); ++I) {
+    llvm::StringRef Annotation = CCS.getAnnotation(I);
+    if (!llvm::any_of(hiddenAnnotationPrefixes(), [&](const char *Prefix) {
+          return Annotation.starts_with(Prefix);
+        }))
+      Annotations.push_back(Annotation);
+  }
