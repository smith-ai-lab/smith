+// Whether the tokens come from a .smith file: C, plus `module` and `import`
+// lines at file scope (issue #25).
+static bool isSmithFile(const SourceManager &SourceMgr,
+                        ArrayRef<FormatToken *> Tokens) {
+  return !Tokens.empty() &&
+         SourceMgr.getFilename(Tokens.front()->Tok.getLocation())
+             .ends_with(".smith");
+}
