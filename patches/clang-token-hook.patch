+/// A hook that rewrites the token stream after macro expansion and before the
+/// parser, for a language built on top of C by token rewriting. It is created
+/// by Preprocessor::TokenHookFactory when the main file is entered (the factory
+/// decides from the file whether the hook applies) and sees each token once:
+/// tokens replayed from the lookahead cache and ones it injected are not
+/// offered again.
+class TokenHook {
+public:
+  virtual ~TokenHook() = default;
+  /// Called with each token about to leave Preprocessor::Lex. It may read the
+  /// following tokens with PP.Lex (they are not offered to it) and put tokens
+  /// back with PP.EnterTokenStream(..., IsReinject = true). Returns true when
+  /// it consumed \p Tok (replacing it with whatever it entered, maybe nothing);
+  /// Lex then continues with the next token. Source locations are the hook's
+  /// to keep.
+  virtual bool transform(Preprocessor &PP, Token &Tok) = 0;
+  /// The Sema of this translation unit, for read-only questions about what the
+  /// parser has completed (the hook runs mid-parse, one token ahead of it).
+  virtual void semaCreated(Sema &) {}
+  virtual void semaDestroyed() {}
+};
+
