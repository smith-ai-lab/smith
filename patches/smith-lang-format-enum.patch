+
+// Whether the `enum` being read has a body with a `;` between its braces: its
+// members are declarations (a payload enum of a .smith file, issue #215).
+bool UnwrappedLineParser::isSmithPayloadEnum() {
+  assert(FormatTok->is(tok::kw_enum));
+  unsigned StoredPosition = Tokens->getPosition();
+  int Depth = 0;
+  bool IsPayload = false;
+  for (FormatToken *Tok = Tokens->getNextToken(); Tok->isNot(tok::eof);
+       Tok = Tokens->getNextToken()) {
+    if (Depth == 0 && Tok->is(tok::semi))
+      break; // `enum E;`, no body
+    if (Tok->is(tok::l_brace)) {
+      ++Depth;
+    } else if (Tok->is(tok::r_brace)) {
+      if (--Depth <= 0)
+        break;
+    } else if (Depth == 1 && Tok->is(tok::semi)) {
+      IsPayload = true;
+      break;
+    }
+  }
+  FormatTok = Tokens->setPosition(StoredPosition);
+  return IsPayload;
 }
 
