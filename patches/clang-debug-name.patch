+
+bool (*clang::CodeGen::DebugNameHook)(const NamedDecl *D, std::string &Scope,
+                                      std::string &Name) = nullptr;
+
+static bool hookedDebugName(const Decl *D, std::string &Scope,
+                            std::string &Name) {
+  const auto *ND = dyn_cast<NamedDecl>(D);
+  return ND && CodeGen::DebugNameHook &&
+         CodeGen::DebugNameHook(ND, Scope, Name);
 }
 
+/// The namespaces `a` then `b` of the scope "a::b", innermost.
+static llvm::DIScope *hookedScope(llvm::DIBuilder &DBuilder,
+                                  llvm::DIScope *Root, StringRef Scope) {
+  llvm::DIScope *Parent = Root;
+  while (!Scope.empty()) {
+    auto [Head, Tail] = Scope.split("::");
+    Parent = DBuilder.createNameSpace(Parent, Head, false);
+    Scope = Tail;
+  }
+  return Parent;
+}
