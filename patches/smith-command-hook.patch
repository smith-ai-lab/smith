diff --git a/clang/include/clang/Driver/CreateInvocationFromArgs.h b/clang/include/clang/Driver/CreateInvocationFromArgs.h
--- a/clang/include/clang/Driver/CreateInvocationFromArgs.h
+++ b/clang/include/clang/Driver/CreateInvocationFromArgs.h
@@ -49,6 +49,17 @@ struct CreateInvocationOptions {
   std::vector<std::string> *CC1Args = nullptr;
 };
 
+/// A front end for a language that is lowered to C may change a command before
+/// the tools below read it (a file extension the driver takes for a linker
+/// input is given a language, say). Called with the arguments of a command, the
+/// program first, by createInvocation and by the tooling library's
+/// getStripPluginsAdjuster; returns true and sets \param Out to the arguments
+/// that replace them (pointers into \param Args or static), or false to keep
+/// them. Null (the default) changes nothing.
+#define CLANG_HAS_COMMAND_HOOK 1
+extern bool (*CommandHook)(ArrayRef<const char *> Args,
+                           SmallVectorImpl<const char *> &Out);
+
 /// Interpret clang arguments in preparation to parse a file.
 ///
 /// This simulates a number of steps Clang takes when its driver is invoked:
diff --git a/clang/lib/Driver/CreateInvocationFromArgs.cpp b/clang/lib/Driver/CreateInvocationFromArgs.cpp
