+/// smith: whether an expression that folded to a constant holds what a .smith
+/// file adds to C's constants: a call of a function the evaluator ran, or an
+/// element of a `constexpr` array (a list of types). Any other folding is still
+/// the GNU extension C has it as (`int c[y + 1]` of a `static const int y`).
+static bool SmithFoldsLikeConstexpr(const Stmt *S) {
+  if (!S)
+    return false;
+  if (isa<CallExpr>(S))
+    return true;
+  if (const auto *A = dyn_cast<ArraySubscriptExpr>(S))
+    if (const auto *R =
+            dyn_cast<DeclRefExpr>(A->getBase()->IgnoreParenImpCasts()))
+      if (const auto *V = dyn_cast<VarDecl>(R->getDecl()))
+        if (V->isConstexpr())
+          return true;
+  for (const Stmt *Child : S->children())
+    if (SmithFoldsLikeConstexpr(Child))
+      return true;
+  return false;
 }
 
