+  // smith: in a .smith file a call of a C function that the evaluator ran
+  // (LangOptions::SmithConstexprC) is a constant expression where C requires
+  // one and allows folding (static_assert, an enum value, a case label, a
+  // bit-field width), and folding it is no GNU extension: no
+  // -Wgnu-folding-constant. A caller that forbids folding (an array bound at
+  // block scope, which C makes a VLA) is not here, and only an evaluation with
+  // no note at all counts (a real extension keeps its warning).
+  if (getLangOpts().SmithConstexprC && !getLangOpts().CPlusPlus &&
+      Notes.empty() && SmithFoldsLikeConstexpr(E)) {
+    if (Result)
+      *Result = EvalResult.Val.getInt();
+    return E;
+  }
