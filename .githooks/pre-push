#!/bin/sh
# The pre-push check (#3132): format, lint and the tests this push reaches, with the smith built from this tree.
# The logic is `smith build pre-push` in build.c; this file only finds a smith. `git push --no-verify` skips it.
root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 0
bin="build/$(uname -s)-$(uname -m)/smith"
if [ ! -x "$bin" ]; then
  echo "pre-push: no smith built from this tree yet; building one first"
  if [ -x .smith/stage0/bin/smith ]; then PATH="$root/.smith/stage0/bin:$PATH"; fi
  smith build || exit 1
else
  "$bin" build || exit 1
fi
exec "$bin" build pre-push -Dsmith="$bin"
